.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0003","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF2","text":"Ausschluss der Toten → Unterscheidung zwischen Herde und selbstgerichteten Gefährten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF3","text":"Herdenkritik → Freilegung der Verteidigung bestehender Wertetafeln.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0008","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF4","text":"Verteidigung bestehender Werte → Gegenfigur des Schaffenden als Brecher und Wertsetzer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF5","text":"Wertsetzung → Bildung einer Gemeinschaft von Mitschaffenden, Miterntenden und Mitfeiernden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF6","text":"Neue Gemeinschaft → Abschied vom ersten Gefährten, vom Volk und von der Hirtenfunktion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF7","text":"Abschied → selbstgesetzter Gang zum Ziel → Untergang der Zögernden als Folge der eigenen Bewegung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_8C_2:ME1","text":"Gefolgschaft wird von hierarchischer Unterordnung in selbstbestimmte Mitbewegung umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ME2","text":"Der Gegensatz zwischen Schöpfer und Vernichter wird aufgelöst, indem Zerstörung als Bedingung neuer Wertsetzung erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ME3","text":"Gemeinschaft wird von gemeinsamer Lehre auf gemeinsame schöpferische Praxis umgestellt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ME4","text":"Die Kategorien „gut“ und „böse“ werden als überkommene Tafeln in den Bereich des zu Überschreitenden verschoben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ME5","text":"Das Volk wird aus dem Adressatenkreis der Wahrheit entfernt und durch eine selektive Gefährtenschaft ersetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ME6","text":"Abschied, Trennung und Ausschluss werden nicht als Scheitern, sondern als konstitutive Operationen des neuen Weges kartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0014","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0015","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_8C_2:ALT1","text":"Surface — Der Text verwirft tote Gefährten, Herden und Hirten und bekennt sich zu lebendigen Gefährten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ALT2","text":"Structural — Der Text ordnet Gefolgschaft, Wertbewahrung und Werteschöpfung als miteinander unvereinbare soziale Formen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ALT3","text":"Metastrategic — Der Text verlagert die Strategie von der Ansprache des Volkes zur Auswahl und Bildung schöpferischer Gefährtenschaft.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ALT4","text":"Ontological/Temporal — Der Text setzt eine werdende Ordnung voraus, in der alte Werte zerbrochen, neue Werte geschrieben und Gegenwart auf ein kommendes Ziel ausgerichtet wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_8C_2:MRT1","text":"Die Axiome sind hinreichend, um den Übergang von toter Gefolgschaft zu lebendiger, selbstgerichteter Gefährtenschaft zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT2","text":"Sie reichen aus, um die Feindschaft zwischen bestehender Wertordnung und schöpferischer Überschreitung abzuleiten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT3","text":"Unterbestimmt bleibt, wie neue Tafeln konkret entstehen und nach welchen Kriterien Mitschaffende ausgewählt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT4","text":"Intern kohärent ist die Bewegung dort, wo Ausschluss, Wertbruch und neue Gemeinschaft aufeinander bezogen werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT5","text":"Eine Spannung bleibt zwischen der Ablehnung des Hirtenamts und der demonstrativen Führungskraft des eigenen Gangs bestehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT6","text":"Eine weitere Spannung liegt zwischen freiwilliger Selbstfolge und der angekündigten Untergangswirkung für Zögernde.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT7","text":"Die Rekonstruktion bewahrt die tatsächliche Argumentbewegung, sofern „Vernichtung“ als Umwertung und nicht als bloße physische Zerstörung gelesen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT8","text":"Die stärkste strukturelle Schließung entsteht aus der Verbindung von Wertbruch, selektiver Gefährtenschaft und zielgerichteter Selbstbewegung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261015T192527492789Z_0293c18a","language_code":"en","language_name":"English","title":"8.","source_sha256":"ddecbc3c80a9c499ac420effbe72a56d73bec0d7166ce41bfeadea120df132f9","sha256":"35d3e0df945341cb6022b658883546b9d0d5b6ebd7d0f33b4f29bafc5d182ebc","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-15T19:25:27.495745+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_8C_2:AS1","text":"A new truth arises from awakening to the incompatibility between one’s own movement and the dead one borne along with it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0003","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AS2","text":"Following is determined as valid when the companions wish to follow themselves and thereby voluntarily share the same direction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AS3","text":"People, herd, shepherds, good people, just people, and believers are identified as orders that defend existing tables of values against the creator.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0008","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AS4","text":"The creator needs no converts, but rather co-creators, co-harvesters, and co-celebrants who bring forth and complete new values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AS5","text":"The new truth compels the farewell to the first companion, to the people, and to the shepherd-function in favor of one’s own course over the hesitant ones.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AS6","text":"The movement proceeds from isolated self-examination through the negative determination of false community to the selective formation of creative companionship and to self-posited transcendence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_8C_2:A1","text":"Living companions are to be preferred to such companions as are carried along as dead bodies or corpses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:A2","text":"Valid companionship rests on each companion's wanting to follow himself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:A3","text":"A shared direction does not presuppose subordination to a shepherd.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:A4","text":"The people and the herd reproduce collective followership in place of self-determined companionship.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:A5","text":"The good, the just, and the faithful defend existing tablets of values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:A6","text":"The creator breaks existing tablets of values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:A7","text":"New values arise through co-creation and the writing of new tablets.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:A8","text":"Creative work requires at once harvesting, completing together, and the ability to sharpen the sickles.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0011","trace_type":"Composite","confidence":"low","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Composite","confidence":"low","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:A9","text":"The creator is designated by the defenders of what exists as a destroyer and despiser of good and evil.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:A10","text":"Zarathustra's goal demands a farewell to the role of shepherd and gravedigger.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:A11","text":"One's own course takes precedence over the hesitation and tardiness of others.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:A12","text":"The creator's companionship encompasses creating, harvesting, and celebrating together.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_8C_2:NX1","text":"Companionship is not the carrying along of corpses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:NX2","text":"Companionship is not membership in a herd.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:NX3","text":"Zarathustra is not the shepherd of people or herd.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:NX4","text":"Zarathustra is not the gravedigger of the past.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:NX5","text":"The creator is not the defender of existing tablets of values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:NX6","text":"The good, the just, and the faithful are not neutral bearers of values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0007","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0008","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:NX7","text":"Creative companionship is not mere faith or mere followership.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:NX8","text":"Those who harvest are not necessarily destroyers or despisers, although they are so called.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:NX9","text":"The new truth no longer addresses itself to the people.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:NX10","text":"Hesitation and tardiness constitute no legitimate standard for one's own course.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_8C_2:D1","text":"The rejection of dead companions produces a distinction between passive carrying-along and living self-movement.","refs":["CH_97E9_8C_2:A1","CH_97E9_8C_2:A2"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_8C_2:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:D2","text":"If valid companions follow themselves, a shared direction can exist without a shepherd hierarchy.","refs":["CH_97E9_8C_2:A2","CH_97E9_8C_2:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:D3","text":"Whoever breaks existing tablets of values is necessarily classified as a criminal or destroyer from the perspective of their defenders.","refs":["CH_97E9_8C_2:A5","CH_97E9_8C_2:A6","CH_97E9_8C_2:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:D4","text":"The turning away from the herd directs the creator's search toward co-creators who bring forth new tablets of values.","refs":["CH_97E9_8C_2:A4","CH_97E9_8C_2:A6","CH_97E9_8C_2:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0008","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:D5","text":"Creative community encompasses not only production but also harvesting and celebrating together.","refs":["CH_97E9_8C_2:A8","CH_97E9_8C_2:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:D6","text":"The decision against the shepherd's role makes farewell to the people a precondition of the new companionship.","refs":["CH_97E9_8C_2:A4","CH_97E9_8C_2:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:D7","text":"One's own course is determined, through the rejection of hesitation, as a selective and excluding movement.","refs":["CH_97E9_8C_2:A10","CH_97E9_8C_2:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_8C_2:P0016","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_8C_2:SD1","text":"The system replaces the model of vertical leadership with a horizontal alliance of self-directed creators of values.","refs":["CH_97E9_8C_2:A2","CH_97E9_8C_2:A3","CH_97E9_8C_2:A4","CH_97E9_8C_2:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:SD2","text":"Value-creation appears as a double operation: destruction of inherited tablets and collective institution of new tablets.","refs":["CH_97E9_8C_2:A5","CH_97E9_8C_2:A6","CH_97E9_8C_2:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:SD3","text":"Community is constituted not by shared conviction, but by shared participation in creation, harvest, and celebration.","refs":["CH_97E9_8C_2:A7","CH_97E9_8C_2:A8","CH_97E9_8C_2:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:SD4","text":"The break with the herd produces a new political and temporal order in which the coming goal selects present companionship.","refs":["CH_97E9_8C_2:A4","CH_97E9_8C_2:A10","CH_97E9_8C_2:A11","CH_97E9_8C_2:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"low","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"low","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0017","trace_type":"Structural","confidence":"low","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Structural","confidence":"low","alignment_provenance":"repaired-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_8C_2:DNX1","text":"The system presupposes that existing values possess no final or unavailable validity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:DNX2","text":"It excludes the possibility that community arises primarily through shared orthodoxy or shared subordination.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:DNX3","text":"It rejects the assumption that leadership must necessarily mediate between the people and truth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Negative","confidence":"low","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Negative","confidence":"low","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:DNX4","text":"It disqualifies the preservation of what has been handed down as a sufficient purpose of communal life.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:DNX5","text":"It excludes a lasting coexistence between value-creation and the defense of fixed tablets of values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:DNX6","text":"It does not treat the people as a still undecided resource that could be won through mere address.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_8C_2:SNX1","text":"Excluded is a community whose unity derives not from its own movement but from identity, obedience, or equality of faith.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:SNX2","text":"Excluded is an order of values that can immunize itself against its own overcoming.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:SNX3","text":"Absent is a common space in which creators and defenders of existing values permanently fulfill the same political function.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Negative","confidence":"low","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Negative","confidence":"low","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"low","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:SNX4","text":"A return to the shepherd's role is inadmissible once the creator has determined his companionship as collective value-production.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:SNX5","text":"Unavailable is a universal address; the new truth can become effective only through selection, separation, and exclusion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_8C_2:FGS1","text":"Awakening → inner examination → recognition of the dead one borne along.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:FGS2","text":"Dead one borne along → exclusion of corpse, herd, and people → definition of living companionship.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:FGS3","text":"Existing tables of values → defense by good people, just people, and believers → identification of the creator as breaker.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:FGS4","text":"Breaking existing tables → search for co-creators → joint production of new tables.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:FGS5","text":"Joint production → harvest and celebration → new form of companionship.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0011","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:FGS6","text":"New companionship → renunciation of the roles of shepherd and gravedigger → one’s own course over the hesitant ones.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_8C_2:AF1","text":"Awakening from isolation → recognition of the dead companions → exclusion of bearing them along.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0003","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF2","text":"Exclusion of the dead → distinction between herd and self-directed companions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF3","text":"Critique of the herd → uncovering of the defense of existing tables of values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0008","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF4","text":"Defense of existing values → counterfigure of the creator as breaker and value-setter.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF5","text":"Value-setting → formation of a community of co-creators, co-harvesters, and co-celebrants.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF6","text":"New community → farewell to the first companion, to the people, and to the shepherd-function.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:AF7","text":"Farewell → self-posited course toward the goal → downfall of the hesitant ones as a consequence of one’s own movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_8C_2:ME1","text":"Followership is remapped from hierarchical subordination into self-determined co-movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ME2","text":"The opposition between creator and destroyer is dissolved by destruction's appearing as the condition of new value-positing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ME3","text":"Community is shifted from shared doctrine to shared creative practice.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ME4","text":"The categories “good” and “evil” are displaced, as inherited tablets, into the domain of what is to be overcome.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ME5","text":"The people are removed from the circle of addressees of truth and replaced by a selective companionship.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ME6","text":"Farewell, separation, and exclusion are mapped not as failure but as constitutive operations of the new way.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0014","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0015","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_8C_2:ALT1","text":"Surface — The text rejects dead companions, herds, and shepherds and professes living companions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ALT2","text":"Structural — The text orders followership, value-preservation, and value-creation as mutually incompatible social forms.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ALT3","text":"Metastrategic — The text shifts the strategy from addressing the people to selecting and forming creative companionship.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:ALT4","text":"Ontological/Temporal — The text presupposes an order in becoming in which old values are broken, new values are written, and the present is oriented toward a coming goal.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_8C_2:MRT1","text":"The axioms are sufficient to reconstruct the transition from dead followership to living, self-directed companionship.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT2","text":"They suffice to derive the enmity between the existing order of values and creative overcoming.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT3","text":"It remains underdetermined how new tablets arise concretely and according to which criteria co-creators are selected.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT4","text":"The movement is internally coherent where exclusion, the breaking of values, and new community are related to one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT5","text":"A tension remains between the rejection of the shepherd's office and the demonstrative leadership force of one's own course.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0016","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT6","text":"A further tension lies between voluntary self-following and the announced effect of downfall for those who hesitate.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT7","text":"The reconstruction preserves the actual movement of argument insofar as “destruction” is read as revaluation and not as mere physical destruction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_8C_2:MRT8","text":"The strongest structural closure arises from the connection of the breaking of values, selective companionship, and goal-directed self-movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_8C_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_8C_2:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_97E9_8C_2@R001","source_variant_id":"canonical:CH_97E9_8C_2:v1","source_language_code":"de","source_title_context":"Zarathustra’s Prologue.","source_section_label":"8.","source_title_hierarchy":["Part One"],"reading_title":"Zarathustra’s Prologue · 8","reading_title_context":"Part One","reading_heading_titles":["Part One","Zarathustra’s Prologue.","8."],"original_title":"8."}],"source_title_context":"Zarathustra’s Vorrede.","source_section_label":"8.","source_title_hierarchy":["Erster Theil"],"reading_title":"Zarathustra’s Prologue · 8","reading_title_context":"Part One","reading_heading_titles":["Part One","Zarathustra’s Prologue.","8."],"identity":{"layer":"CH","kicker":"Chapter 09","title":"Zarathustra’s Prologue · 8","context":"Part One","original_context":"Erster Theil"},"title_language_code":"en","original_title":"Zarathustra’s Vorrede · 8"},{"id":"CH_97E9_10CH","layer":"CH","title":"Zarathustra’s Prologue · 10","order":10,"parents":["RAW_97E9_10CH"],"revision":"CH_97E9_10CH@R001","sha256":"e6e2d7bb2230c4440a490feac5a470fb4c5f83b4149cdc911d5ab907c455e194","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_10CH:AS1","text":"Zarathustras Fortleben wird durch das Erscheinen und die Kundschaft seiner Tiere problematisch.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:AS2","text":"Adler und Schlange verkörpern eine komplementäre Einheit aus Stolz und Klugheit, die Zarathustra orientieren soll.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:AS3","text":"Die menschliche Sphäre wird gegenüber der tierischen Sphäre als gefährlicher und der Weg Zarathustras als prekärer bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:AS4","text":"Die gewünschte Klugheit erweist sich als nicht dauerhaft verfügbar und wird durch den Stolz kompensatorisch begleitet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:AS5","text":"Der Stolz soll sowohl die Klugheit als auch deren mögliche Abwesenheit überdauern.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:AS6","text":"Die Konstruktion dieser Ersatzkontinuität markiert den Beginn von Zarathustras Untergang.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_10CH:A1","text":"Zarathustras Tiere sind ein Adler und eine Schlange.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A2","text":"Der Adler steht für Stolz, die Schlange für Klugheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A3","text":"Die Schlange hält sich als Freundin und nicht als Beute um den Hals des Adlers.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A4","text":"Die Tiere erkunden, ob Zarathustra noch lebt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A5","text":"Zarathustra erfährt den Weg unter Menschen als gefährlicher als den Weg unter Tieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A6","text":"Zarathustra begehrt Klugheit nicht nur situativ, sondern „von Grund aus“.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A7","text":"Zarathustras Klugheit kann ihn verlassen und davonfliegen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A8","text":"Zarathustras Stolz soll sowohl mit seiner Klugheit als auch mit seiner Torheit bestehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_10CH:NX1","text":"Das Verhältnis von Adler und Schlange ist nicht als Raub- oder Beuteverhältnis organisiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:NX2","text":"Zarathustras Gefährdung wird nicht primär der tierischen Welt zugeschrieben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:NX3","text":"Zarathustras Leben gilt nicht als selbstverständlich gesichert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:NX4","text":"Klugheit wird nicht als unverlierbarer Besitz behandelt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:NX5","text":"Stolz wird nicht auf die Begleitung gesicherter Klugheit beschränkt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:NX6","text":"Der Untergang erscheint nicht als späteres äußeres Ereignis, sondern beginnt innerhalb des ausgesprochenen Wunsches.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_10CH:D1","text":"Die Tiere fungieren als externe Prüfung von Zarathustras Lebensstatus.","refs":["CH_97E9_10CH:A1","CH_97E9_10CH:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:D2","text":"Die Freundschaft von Adler und Schlange bildet eine operative Verbindung von Stolz und Klugheit.","refs":["CH_97E9_10CH:A2","CH_97E9_10CH:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:D3","text":"Die menschliche Ordnung erzeugt für Zarathustra eine größere Gefahr als die nichtmenschliche Ordnung.","refs":["CH_97E9_10CH:A4","CH_97E9_10CH:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:D4","text":"Zarathustras Wunsch nach grundsätzlicher Klugheit setzt einen Mangel an gegenwärtiger oder verlässlicher Klugheit voraus.","refs":["CH_97E9_10CH:A6","CH_97E9_10CH:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:D5","text":"Der Stolz wird zur Kontinuitätsinstanz zwischen geistiger Klarheit und geistiger Verfehlung.","refs":["CH_97E9_10CH:A7","CH_97E9_10CH:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:D6","text":"Die Selbstsicherung durch Stolz wird zugleich als Untergangsbewegung lesbar.","refs":["CH_97E9_10CH:A6","CH_97E9_10CH:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_10CH:SD1","text":"Zarathustras Identität wird nicht durch stabile Selbsterkenntnis, sondern durch die rückgekoppelte Prüfung seiner Tiere stabilisiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SD2","text":"Die Verbindung von Stolz und Klugheit ist strukturell asymmetrisch: Die Klugheit kann entweichen, während der Stolz als verbleibende Trägerinstanz eingesetzt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SD3","text":"Der Versuch, den Verlust der Klugheit durch fortbestehenden Stolz aufzufangen, verwandelt eine epistemische Unsicherheit in eine existentielle Untergangsbewegung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SD4","text":"Die tierische Komplementarität liefert kein harmonisches Modell für Zarathustra, sondern legt die Instabilität seiner eigenen inneren Verfassung offen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SD5","text":"Der Text verschiebt die Frage nach dem Leben von einer biologischen Tatsache zu einer prekären, durch Orientierung und Selbstdeutung vermittelten Position.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_10CH:DNX1","text":"Das System setzt voraus, dass Selbstgewissheit nicht aus dem eigenen Bewusstsein allein gewonnen werden kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:DNX2","text":"Es wird ausgeschlossen, dass Klugheit eine dauerhaft verfügbare Substanz oder Eigenschaft des Subjekts ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:DNX3","text":"Es wird ausgeschlossen, dass Stolz lediglich Ausdruck bereits vorhandener Souveränität ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:DNX4","text":"Es wird ausgeschlossen, dass die Rückkehr zu den Tieren eine einfache Flucht aus der menschlichen Gefährdung ermöglicht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Negative","confidence":"low","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:DNX5","text":"Es wird ausgeschlossen, dass die Verbindung von Klugheit und Stolz eine spannungsfreie Einheit bildet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_10CH:SNX1","text":"Eine stabile, autonome und endgültig gesicherte Identität Zarathustras ist nicht verfügbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SNX2","text":"Eine Welt, in der Erkenntnis ohne Verlust, Gefahr oder Abhängigkeit besessen werden könnte, bleibt versperrt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SNX3","text":"Der Text verweigert eine abschließende Versöhnung von Stolz, Klugheit und Torheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SNX4","text":"Der Untergang wird nicht als Gegenpol zum Leben, sondern als Möglichkeit innerhalb seiner Selbstbehauptung organisiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_10CH:FGS1","text":"Externe tierische Erscheinung → Prüfung des Fortlebens → Infragestellung der Selbstgewissheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:FGS2","text":"Symbolische Tierkonstellation → Kopplung von Stolz und Klugheit → Modell innerer Orientierung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:FGS3","text":"Gefährliche Menschenwelt → Delegation der Führung an die Tiere → Abhängigkeit von nichtmenschlicher Vermittlung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:FGS4","text":"Wunsch nach grundsätzlicher Klugheit → Anerkennung ihrer möglichen Flucht → Einführung des Stolzes als Ersatzkontinuität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:FGS5","text":"Fortbestehen des Stolzes in Klugheit und Torheit → Überdehnung der Identitätsstütze → Beginn des Untergangs.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:FGS6","text":"Leben → Gefährdung → epistemischer Mangel → kompensatorische Selbstbehauptung → Untergang.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_10CH:AF1","text":"Fragliches Fortleben → tierische Kundschaft → symbolische Kopplung von Stolz und Klugheit → größere Gefahr unter Menschen → Wunsch nach grundsätzlicher Klugheit → mögliche Flucht der Klugheit → Übertragung der Kontinuität auf den Stolz → Beginn des Untergangs.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_10CH:ME1","text":"Tiere werden von Begleitwesen zu epistemischen Prüfinstanzen und Orientierungsmedien umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ME2","text":"Die Opposition Mensch/Tier wird von einer kulturellen Hierarchie in eine asymmetrische Gefahren- und Orientierungsordnung umgezeichnet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ME3","text":"Stolz wird nicht mehr nur als Haltung, sondern als zeitliche Ersatzstruktur für eine entweichende Klugheit sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ME4","text":"Untergang wird von einem zukünftigen Schicksal zu einer im Akt der Selbststabilisierung erzeugten Struktur.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ME5","text":"Leben wird als überprüfbare, relationale und gefährdete Position statt als bloßer Zustand kartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_10CH:ALT1","text":"Surface — Zarathustra begegnet seinem Adler und seiner Schlange, reflektiert seine Gefährdung und formuliert einen Wunsch nach Klugheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ALT2","text":"Structural — Die Tiere vermitteln zwischen existentieller Unsicherheit, symbolischer Orientierung und der instabilen Verbindung von Stolz und Klugheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ALT3","text":"Metastrategic — Zarathustra ersetzt die nicht dauerhaft verfügbare Klugheit durch eine Haltung, die auch deren Verlust überstehen soll.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ALT4","text":"Ontological/Temporal — Das Subjekt bleibt zwischen Leben und Untergang, Klugheit und Torheit, gegenwärtiger Selbstgewissheit und möglicher Auflösung eingespannt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_10CH:MRT1","text":"Die Axiome sind hinreichend, um die Bewegung von der tierischen Kundschaft zum Beginn des Untergangs zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:MRT2","text":"Unterbestimmt bleibt, ob Adler und Schlange primär psychische Symbole, reale Begleiter oder beide zugleich sind.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_10CH:MRT3","text":"Die Struktur ist intern kohärent, weil die mögliche Flucht der Klugheit die Funktion des Stolzes erklärt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:MRT4","text":"Die stärkste Verbindung liegt zwischen epistemischer Unsicherheit und kompensatorischer Selbstbehauptung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:MRT5","text":"Die zentrale Spannung besteht darin, dass Stolz den Verlust der Klugheit überdauern soll, aber gerade diese Ersatzfunktion den Untergang eröffnet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:MRT6","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung, sofern die tierische Freundschaft, die menschliche Gefährdung und die zeitliche Verschiebung zum Untergang nicht auf bloße Symbolik reduziert werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261015T184334751101Z_6a65527b","language_code":"en","language_name":"English","title":"10.","source_sha256":"e6e2d7bb2230c4440a490feac5a470fb4c5f83b4149cdc911d5ab907c455e194","sha256":"440e50fba8f5ed4238e7e0e2c708ae9368428a727d330635bb18e6928c0dcbce","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-15T18:43:34.753990+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_10CH:AS1","text":"Zarathustra's continued life becomes problematic through the appearance and the tidings of his animals.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:AS2","text":"The eagle and the serpent embody a complementary unity of pride and cleverness that is to orient Zarathustra.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:AS3","text":"The human sphere is determined as more dangerous than the animal sphere, and Zarathustra's path as more precarious.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:AS4","text":"The desired cleverness proves not to be permanently available and is accompanied compensatorily by pride.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:AS5","text":"Pride is to outlast both cleverness and its possible absence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:AS6","text":"The construction of this substitute continuity marks the beginning of Zarathustra's downfall.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_10CH:A1","text":"Zarathustra's animals are an eagle and a serpent.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A2","text":"The eagle stands for pride, the serpent for cleverness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A3","text":"The serpent hangs around the eagle's neck as a friend and not as prey.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A4","text":"The animals inquire whether Zarathustra is still alive.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A5","text":"Zarathustra experiences the path among humans as more dangerous than the path among animals.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A6","text":"Zarathustra desires cleverness not merely situationally, but “from the ground up”.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A7","text":"Zarathustra's cleverness can leave him and fly away.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:A8","text":"Zarathustra's pride is to endure both with his cleverness and with his folly.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_10CH:NX1","text":"The relation between eagle and serpent is not organized as a relation of predator and prey.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:NX2","text":"Zarathustra's endangerment is not attributed primarily to the animal world.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:NX3","text":"Zarathustra's life is not regarded as self-evidently secure.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:NX4","text":"Cleverness is not treated as an inalienable possession.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:NX5","text":"Pride is not restricted to accompanying secured cleverness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:NX6","text":"The downfall does not appear as a later external event, but begins within the expressed wish.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_10CH:D1","text":"The animals function as an external test of Zarathustra's vital status.","refs":["CH_97E9_10CH:A1","CH_97E9_10CH:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:D2","text":"The friendship of eagle and serpent constitutes an operative connection of pride and cleverness.","refs":["CH_97E9_10CH:A2","CH_97E9_10CH:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:D3","text":"The human order generates a greater danger for Zarathustra than the nonhuman order.","refs":["CH_97E9_10CH:A4","CH_97E9_10CH:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:D4","text":"Zarathustra's wish for fundamental cleverness presupposes a lack of present or reliable cleverness.","refs":["CH_97E9_10CH:A6","CH_97E9_10CH:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:D5","text":"Pride becomes the instance of continuity between intellectual clarity and intellectual failure.","refs":["CH_97E9_10CH:A7","CH_97E9_10CH:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:D6","text":"Self-securing through pride becomes legible at the same time as a movement of downfall.","refs":["CH_97E9_10CH:A6","CH_97E9_10CH:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_10CH:SD1","text":"Zarathustra's identity is stabilized not by stable self-knowledge, but by the feedback-based testing of his animals.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SD2","text":"The connection of pride and cleverness is structurally asymmetrical: cleverness can escape, whereas pride is deployed as the remaining sustaining instance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SD3","text":"The attempt to absorb the loss of cleverness through enduring pride transforms an epistemic uncertainty into an existential movement of downfall.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SD4","text":"Animal complementarity supplies no harmonious model for Zarathustra, but rather discloses the instability of his own inner constitution.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SD5","text":"The text shifts the question of life from a biological fact to a precarious position mediated by orientation and self-interpretation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_10CH:DNX1","text":"The system presupposes that self-certainty cannot be gained from one's own consciousness alone.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:DNX2","text":"It is excluded that cleverness is a permanently available substance or property of the subject.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:DNX3","text":"It is excluded that pride is merely the expression of an already existing sovereignty.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:DNX4","text":"It is excluded that the return to the animals enables a simple escape from human endangerment.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Negative","confidence":"low","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:DNX5","text":"It is excluded that the connection of cleverness and pride forms a tension-free unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_10CH:SNX1","text":"A stable, autonomous, and definitively secured identity of Zarathustra is not available.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SNX2","text":"A world in which knowledge could be possessed without loss, danger, or dependency remains barred.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SNX3","text":"The text refuses a final reconciliation of pride, cleverness, and folly.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:SNX4","text":"Downfall is organized not as the opposite pole of life, but as a possibility within its self-assertion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_10CH:FGS1","text":"External animal appearance → testing of continued life → questioning of self-certainty.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:FGS2","text":"Symbolic animal constellation → coupling of pride and cleverness → model of inner orientation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:FGS3","text":"Dangerous human world → delegation of guidance to the animals → dependence on nonhuman mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:FGS4","text":"Wish for fundamental cleverness → acknowledgment of its possible flight → introduction of pride as substitute continuity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:FGS5","text":"Persistence of pride in cleverness and folly → overextension of the support of identity → beginning of downfall.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:FGS6","text":"Life → endangerment → epistemic lack → compensatory self-assertion → downfall.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_10CH:AF1","text":"Questionable continued life → animal tidings → symbolic coupling of pride and cleverness → greater danger among humans → wish for fundamental cleverness → possible flight of cleverness → transfer of continuity to pride → beginning of downfall.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_10CH:ME1","text":"Animals are reclassified from companion beings into epistemic testing instances and media of orientation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ME2","text":"The human/animal opposition is redrawn from a cultural hierarchy into an asymmetrical order of danger and orientation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ME3","text":"Pride becomes visible no longer merely as an attitude, but as a temporal substitute structure for an escaping cleverness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ME4","text":"Downfall is transformed from a future fate into a structure produced in the act of self-stabilization.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ME5","text":"Life is mapped as a verifiable, relational, and endangered position rather than as a mere state.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_10CH:ALT1","text":"Surface — Zarathustra encounters his eagle and his serpent, reflects on his endangerment, and formulates a wish for cleverness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ALT2","text":"Structural — The animals mediate between existential uncertainty, symbolic orientation, and the unstable connection of pride and cleverness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ALT3","text":"Metastrategic — Zarathustra replaces the not permanently available cleverness with an attitude that is to survive even its loss.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:ALT4","text":"Ontological/Temporal — The subject remains suspended between life and downfall, cleverness and folly, present self-certainty and possible dissolution.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_10CH:MRT1","text":"The axioms are sufficient to reconstruct the movement from animal tidings to the beginning of downfall.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:MRT2","text":"It remains underdetermined whether eagle and serpent are primarily psychic symbols, real companions, or both at once.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_10CH:MRT3","text":"The structure is internally coherent because the possible flight of cleverness explains the function of pride.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:MRT4","text":"The strongest connection lies between epistemic uncertainty and compensatory self-assertion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:MRT5","text":"The central tension consists in the fact that pride is to outlast the loss of cleverness, but that precisely this substitute function opens the downfall.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_10CH:MRT6","text":"The reconstruction preserves the actual movement provided that animal friendship, human endangerment, and the temporal shift toward downfall are not reduced to mere symbolism.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_10CH:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_10CH:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_97E9_10CH@R001","source_variant_id":"canonical:CH_97E9_10CH:v1","source_language_code":"de","source_title_context":"Zarathustra’s Prologue.","source_section_label":"10.","source_title_hierarchy":["Part One"],"reading_title":"Zarathustra’s Prologue · 10","reading_title_context":"Part One","reading_heading_titles":["Part One","Zarathustra’s Prologue.","10."],"original_title":"10."}],"source_title_context":"Zarathustra’s Vorrede.","source_section_label":"10.","source_title_hierarchy":["Erster Theil"],"reading_title":"Zarathustra’s Prologue · 10","reading_title_context":"Part One","reading_heading_titles":["Part One","Zarathustra’s Prologue.","10."],"identity":{"layer":"CH","kicker":"Chapter 10","title":"Zarathustra’s Prologue · 10","context":"Part One","original_context":"Erster Theil"},"title_language_code":"en","original_title":"Zarathustra’s Vorrede · 10"},{"id":"CH_97E9_VDDV","layer":"CH","title":"On the Three Metamorphoses","order":11,"parents":["RAW_97E9_VDDV"],"revision":"CH_97E9_VDDV@R001","sha256":"c24dfb2cca34233bd4bdf867ffc7e6b5ca014027a74e67b045332dada424b2c4","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VDDV:AS1","text":"Der Text rekonstruiert die Bildung des Geistes als dreistufige Transformation von Lastfähigkeit über Befreiung zu schöpferischer Bejahung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:AS2","text":"Der Geist bestimmt seine Stärke zunächst durch die freiwillige Übernahme des Schwersten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:AS3","text":"Die getragene Last führt in die Wüste, in der sich der Geist gegen seinen letzten Herrn und Gott wendet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:AS4","text":"Der Löwe erringt die Freiheit vom „Du-sollst“, verfügt aber noch nicht über die Fähigkeit zur Wertschöpfung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:AS5","text":"Erst das Kind erzeugt durch Vergessen, Spiel und heiliges Ja-sagen die Voraussetzung eines neuen Schaffens.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:AS6","text":"Die Bewegungsform lautet: Lastübernahme → Befreiung durch Negation → schöpferischer Neubeginn.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VDDV:A1","text":"Der starke, ehrfürchtige Geist verlangt nach der Übernahme des Schwersten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A2","text":"Die Last des Geistes besteht in der freiwilligen Erniedrigung, Selbstprüfung, Wahrheitsentbehrung, Isolation und Annahme des Widrigen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A3","text":"Der tragende Geist bewegt sich beladen in seine Wüste.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A4","text":"Die einsamste Wüste ermöglicht die Verwandlung des Kamels in den Löwen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A5","text":"Der Löwe verlangt nach Freiheit und Herrschaft in seiner eigenen Wüste.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A6","text":"Der große Drache verkörpert das „Du-sollst“, die überlieferten Werte und den Anspruch, dass aller Wert bereits geschaffen sei.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A7","text":"Der Löwe antwortet dem „Du-sollst“ mit „Ich will“ und tritt gegen den Drachen in den Kampf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A8","text":"Der Löwe vermag Freiheit für ein neues Schaffen zu erringen, aber noch keine neuen Werte zu schaffen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A9","text":"Die Freiheit zu neuen Werten verlangt ein heiliges Nein vor der Pflicht und die Entheiligung des ehemals höchsten Gebots.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A10","text":"Das Kind ist durch Unschuld, Vergessen, Neubeginn, Spiel, erste Bewegung und heiliges Ja-sagen bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A11","text":"Das heilige Ja-sagen verwandelt den Willen des Geistes in schöpferisches Spiel und lässt ihn seine eigene Welt gewinnen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VDDV:NX1","text":"Der Geist wird nicht durch Vermeidung des Schwersten stark.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX2","text":"Die Wüste ist nicht bloß ein Ort der Last, sondern der Übergang aus der Lastordnung heraus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX3","text":"Das Kamel genügt nicht zur Schöpfung neuer Werte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX4","text":"Der Löwe genügt nicht zur Schöpfung neuer Werte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX5","text":"Das „Du-sollst“ ist kein weiterhin gültiger letzter Herr und Gott des Geistes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX6","text":"Die Freiheit des Löwen ist nicht bereits die positive Hervorbringung einer neuen Wertordnung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX7","text":"Das heilige Nein ist nicht die abschließende Form des Geistes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX8","text":"Die geschaffenen Werte der Vergangenheit bilden keine unüberschreitbare Totalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0017","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VDDV:D1","text":"Die freiwillige Übernahme des Schwersten konstituiert den Geist als Kamel.","refs":["CH_97E9_VDDV:A1","CH_97E9_VDDV:A2"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D2","text":"Die Lastfähigkeit führt nicht zur endgültigen Unterwerfung, sondern in eine Wüste, in der die bisherige Wertordnung konfrontiert wird.","refs":["CH_97E9_VDDV:A3","CH_97E9_VDDV:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D3","text":"Der Drache macht sichtbar, dass das „Du-sollst“ die Vergangenheit als vollständige und verbindliche Wertschöpfung monopolisiert.","refs":["CH_97E9_VDDV:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D4","text":"Das „Ich will“ des Löwen erzeugt die Möglichkeit der Ablösung vom überlieferten Wertgesetz.","refs":["CH_97E9_VDDV:A5","CH_97E9_VDDV:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D5","text":"Die Ablösung vom „Du-sollst“ erzeugt zunächst Freiheit, nicht unmittelbar neue Werte.","refs":["CH_97E9_VDDV:A7","CH_97E9_VDDV:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D6","text":"Die Entheiligung des alten Gebots ist eine notwendige Voraussetzung für das Recht auf neue Werte.","refs":["CH_97E9_VDDV:A8","CH_97E9_VDDV:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D7","text":"Weil der Löwe nur befreien und verneinen kann, muss eine weitere Verwandlung die positive Schöpfung ermöglichen.","refs":["CH_97E9_VDDV:A8","CH_97E9_VDDV:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D8","text":"Das Kind macht aus gewonnener Freiheit ein schöpferisches Verhältnis zu Wille und Welt.","refs":["CH_97E9_VDDV:A10","CH_97E9_VDDV:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VDDV:SD1","text":"Der Text ordnet die Entstehung neuer Werte als sequenzielle Verbindung von Selbstüberwindung, Negation und Affirmation.","refs":["CH_97E9_VDDV:A1","CH_97E9_VDDV:A8","CH_97E9_VDDV:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SD2","text":"Befreiung erscheint als notwendige, aber unzureichende Zwischenform der Schöpfung.","refs":["CH_97E9_VDDV:A7","CH_97E9_VDDV:A8","CH_97E9_VDDV:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SD3","text":"Die Schöpfung neuer Werte verlangt nicht nur den Bruch mit überlieferten Werten, sondern auch die Entlastung vom bloßen Kampf gegen sie.","refs":["CH_97E9_VDDV:A8","CH_97E9_VDDV:A9","CH_97E9_VDDV:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SD4","text":"Der Geist gewinnt eine eigene Welt erst, wenn sein Wille nicht mehr ausschließlich als Widerstand, sondern als schöpferische Bewegung funktioniert.","refs":["CH_97E9_VDDV:A7","CH_97E9_VDDV:A10","CH_97E9_VDDV:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SD5","text":"Stärke verändert ihre Funktion über drei Ebenen: Sie trägt Last, erkämpft Freiheit und erzeugt einen neuen Anfang.","refs":["CH_97E9_VDDV:A1","CH_97E9_VDDV:A7","CH_97E9_VDDV:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VDDV:DNX1","text":"Neue Werte können nicht aus der bloßen Verlängerung bereits geltender Werte hervorgehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:DNX2","text":"Freiheit kann nicht bestehen bleiben, solange das ehemals Heilige als unantastbare Quelle der Verpflichtung erhalten bleibt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0020","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:DNX3","text":"Die Negation des alten Gesetzes erzeugt für sich genommen noch keine positive Ordnung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:DNX4","text":"Schöpfung kann nicht allein durch angesammelte Erkenntnis, Last oder historische Wertbewahrung erfolgen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:DNX5","text":"Ein schöpferischer Anfang setzt eine Unterbrechung der bisherigen geistigen Kontinuität voraus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:DNX6","text":"Der Wille zur Freiheit reicht nicht aus, wenn er nicht in eine eigene Welt- und Wertbildung übergeht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VDDV:SNX1","text":"Die Behauptung, aller Wert sei bereits geschaffen, wird als unzulässige Schließung der Zukunft ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SNX2","text":"Keine überlieferte Norm kann als letzte Autorität für die Hervorbringung neuer Werte fungieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SNX3","text":"Ein Geist, der nur gehorcht oder nur opponiert, bleibt zur eigentlichen Schöpfung unfähig.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SNX4","text":"Die drei Verwandlungen schließen eine unmittelbare Kontinuität zwischen Gehorsam, Befreiung und Schöpfung aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SNX5","text":"Die Möglichkeit neuer Werte hängt von einer nicht aus dem alten Wertsystem ableitbaren Erstbewegung ab.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VDDV:FGS1","text":"Ehrfürchtige Stärke + Verlangen nach dem Schwersten → freiwillige Lastübernahme → Kamel.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:FGS2","text":"Lastübernahme + Wüstenbewegung → äußerste Einsamkeit → Freilegung des letzten Herrn.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:FGS3","text":"„Du-sollst“ als totalisierte Wertordnung + „Ich will“ → Kampf gegen den Drachen → Freiheit und heiliges Nein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:FGS4","text":"Freiheit vom alten Gebot − Fähigkeit zur Wertschöpfung → Unzulänglichkeit des Löwen → Erfordernis einer weiteren Verwandlung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:FGS5","text":"Unschuld + Vergessen + Spiel + erste Bewegung → heiliges Ja-sagen → schöpferischer Wille und eigene Welt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:FGS6","text":"Last → Wüste → Negation → Freiheit → Neubeginn → Wertschöpfung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VDDV:AF1","text":"Verlangen nach dem Schwersten → Verkörperung als Kamel → Wüste und Einsamkeit → Konfrontation mit dem „Du-sollst“ → Löwenkampf und heiliges Nein → erkannte Unfähigkeit zur Wertschöpfung → kindlicher Neubeginn → heiliges Ja-sagen und eigene Welt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VDDV:ME1","text":"Die Opposition von Unterwerfung und Freiheit wird in eine Entwicklungssequenz aus Last, Befreiung und Schöpfung überführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ME2","text":"Leid, Entsagung und Selbsterniedrigung werden als vorbereitende Operationen einer geistigen Transformation neu klassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ME3","text":"Überlieferte Werte werden nicht als neutrale Normen, sondern als drachenförmige Totalisierung mit prohibitivem Anspruch sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ME4","text":"Freiheit wird von Wertschöpfung unterschieden und dadurch als Zwischenstufe kartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ME5","text":"Negation wird vom Endpunkt zur Schwelle eines affirmativen Anfangs umcodiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ME6","text":"Das Verhältnis zur Welt verschiebt sich von Weltverlust über Selbstbehauptung zu eigener Weltgewinnung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VDDV:ALT1","text":"**Surface:** Der Geist durchläuft die Gestalten Kamel, Löwe und Kind.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ALT2","text":"**Structural:** Lastübernahme, Wüstenisolation, Drachenkampf und Neubeginn bilden die funktionalen Mechanismen der Transformation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ALT3","text":"**Metastrategic:** Der Text ersetzt die direkte Forderung nach neuen Werten durch eine Strategie aus Selbstüberwindung, Befreiung und anschließender Bejahung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ALT4","text":"**Ontological/Temporal:** Neue Werte verlangen eine Erstbewegung, die nicht aus der abgeschlossenen Vergangenheit stammt, sondern durch Vergessen und Neubeginn eine andere Zeitordnung eröffnet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0017","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VDDV:MRT1","text":"Die Axiome reichen aus, um die dreistufige Erzeugung von Lastfähigkeit, Freiheit und Schöpfung zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:MRT2","text":"Unterbestimmt bleibt, wie der Übergang vom Löwen zum Kind konkret vermittelt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VDDV:MRT3","text":"Unterbestimmt bleibt ebenfalls, nach welchen Kriterien die neuen Werte des Kindes gelten sollen.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VDDV:MRT4","text":"Die Struktur ist intern kohärent, sofern Kamel, Löwe und Kind als Funktionen des Geistes und nicht als bloße Zustände verstanden werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:MRT5","text":"Die stärkste Operation ist die Trennung von Befreiung und Wertschöpfung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:MRT6","text":"Eine ungelöste Spannung besteht zwischen dem notwendigen „Ich will“ des Löwen und dem später geforderten Vergessen des Kindes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:MRT7","text":"Eine weitere Spannung liegt darin, dass der Text die Geltung neuer Werte voraussetzt, ohne ihre positive Begründung auszuarbeiten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:MRT8","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung des Textes: Tragen → Befreien → Beginnen → Schaffen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261015T194028216081Z_72479fce","language_code":"en","language_name":"English","title":"On the Three Transformations","source_sha256":"c24dfb2cca34233bd4bdf867ffc7e6b5ca014027a74e67b045332dada424b2c4","sha256":"e37a072cb93667954f66c7a8234e803a7274b4b3e95d74075b55433c34c6bbe9","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-15T19:40:28.217817+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VDDV:AS1","text":"The text reconstructs the formation of the spirit as a three-stage transformation from the capacity to bear burdens through liberation to creative affirmation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:AS2","text":"The spirit initially determines its strength through the voluntary assumption of the heaviest burden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:AS3","text":"The burden borne leads into the desert, where the spirit turns against its final lord and god.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:AS4","text":"The lion wins freedom from the “Thou shalt,” but does not yet possess the capacity for value-creation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:AS5","text":"Only the child, through forgetting, play, and sacred saying-Yes, produces the condition for a new creation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:AS6","text":"The form of movement is: assumption of burden → liberation through negation → creative new beginning.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VDDV:A1","text":"The strong, reverent spirit demands the assumption of the heaviest burden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A2","text":"The burden of the spirit consists in voluntary humiliation, self-examination, deprivation of truth, isolation, and acceptance of adversity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A3","text":"The burden-bearing spirit moves, laden, into its desert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A4","text":"The loneliest desert makes possible the transformation of the camel into the lion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A5","text":"The lion demands freedom and lordship in its own desert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A6","text":"The great dragon embodies the “Thou shalt,” the inherited values, and the claim that all value has already been created.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A7","text":"The lion answers the “Thou shalt” with “I will” and enters into battle against the dragon.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A8","text":"The lion is able to win freedom for a new creation, but not yet to create new values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A9","text":"Freedom for new values demands a sacred No before duty and the desacralization of the formerly highest commandment.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A10","text":"The child is determined by innocence, forgetting, new beginning, play, first movement, and sacred saying-Yes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:A11","text":"Sacred saying-Yes transforms the will of the spirit into creative play and enables it to gain its own world.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VDDV:NX1","text":"The spirit does not become strong through avoidance of the heaviest burden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX2","text":"The desert is not merely a place of burden, but the transition out of the order of burden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX3","text":"The camel does not suffice for the creation of new values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX4","text":"The lion does not suffice for the creation of new values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX5","text":"The “Thou shalt” is no longer a valid final lord and god of the spirit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX6","text":"The freedom of the lion is not yet the positive production of a new order of values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX7","text":"The sacred No is not the final form of the spirit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:NX8","text":"The values created in the past do not form an insurmountable totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0017","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VDDV:D1","text":"The voluntary assumption of the heaviest burden constitutes the spirit as camel.","refs":["CH_97E9_VDDV:A1","CH_97E9_VDDV:A2"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D2","text":"The capacity to bear burdens leads not to final subjection, but into a desert in which the hitherto order of values is confronted.","refs":["CH_97E9_VDDV:A3","CH_97E9_VDDV:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D3","text":"The dragon makes visible that the “Thou shalt” monopolizes the past as complete and binding value-creation.","refs":["CH_97E9_VDDV:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D4","text":"The lion's “I will” generates the possibility of detachment from the inherited law of values.","refs":["CH_97E9_VDDV:A5","CH_97E9_VDDV:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D5","text":"Detachment from the “Thou shalt” initially generates freedom, not immediately new values.","refs":["CH_97E9_VDDV:A7","CH_97E9_VDDV:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D6","text":"The desacralization of the old commandment is a necessary precondition for the right to new values.","refs":["CH_97E9_VDDV:A8","CH_97E9_VDDV:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D7","text":"Because the lion can only liberate and negate, a further transformation must make positive creation possible.","refs":["CH_97E9_VDDV:A8","CH_97E9_VDDV:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:D8","text":"The child makes from won freedom a creative relation to will and world.","refs":["CH_97E9_VDDV:A10","CH_97E9_VDDV:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VDDV:SD1","text":"The text orders the emergence of new values as a sequential connection of self-overcoming, negation, and affirmation.","refs":["CH_97E9_VDDV:A1","CH_97E9_VDDV:A8","CH_97E9_VDDV:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SD2","text":"Liberation appears as a necessary but insufficient intermediate form of creation.","refs":["CH_97E9_VDDV:A7","CH_97E9_VDDV:A8","CH_97E9_VDDV:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SD3","text":"The creation of new values demands not only the break with inherited values, but also release from the mere struggle against them.","refs":["CH_97E9_VDDV:A8","CH_97E9_VDDV:A9","CH_97E9_VDDV:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SD4","text":"The spirit gains a world of its own only when its will no longer functions exclusively as resistance, but as creative movement.","refs":["CH_97E9_VDDV:A7","CH_97E9_VDDV:A10","CH_97E9_VDDV:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SD5","text":"Strength changes its function across three levels: it bears burden, fights for freedom, and produces a new beginning.","refs":["CH_97E9_VDDV:A1","CH_97E9_VDDV:A7","CH_97E9_VDDV:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VDDV:DNX1","text":"New values cannot emerge from the mere prolongation of values already in force.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:DNX2","text":"Freedom cannot persist so long as what was formerly sacred remains preserved as an inviolable source of obligation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0020","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:DNX3","text":"The negation of the old law does not in itself generate a positive order.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:DNX4","text":"Creation cannot take place solely through accumulated knowledge, burden, or historical preservation of values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:DNX5","text":"A creative beginning presupposes an interruption of prior spiritual continuity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:DNX6","text":"The will to freedom is insufficient if it does not pass over into a formation of one's own world and values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VDDV:SNX1","text":"The assertion that all value has already been created is excluded as an impermissible closure of the future.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SNX2","text":"No inherited norm can function as the final authority for the production of new values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SNX3","text":"A spirit that only obeys or only opposes remains incapable of genuine creation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SNX4","text":"The three transformations exclude an immediate continuity between obedience, liberation, and creation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:SNX5","text":"The possibility of new values depends on a first movement not derivable from the old system of values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VDDV:FGS1","text":"Reverent strength + desire for the heaviest burden → voluntary assumption of burden → camel.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:FGS2","text":"Assumption of burden + movement into the desert → utmost solitude → exposure of the final lord.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:FGS3","text":"“Thou shalt” as totalized order of values + “I will” → battle against the dragon → freedom and sacred No.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:FGS4","text":"Freedom from the old commandment − capacity for value-creation → insufficiency of the lion → necessity of a further transformation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:FGS5","text":"Innocence + forgetting + play + first movement → sacred saying-Yes → creative will and world of one's own.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:FGS6","text":"Burden → desert → negation → freedom → new beginning → value-creation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VDDV:AF1","text":"Desire for the heaviest burden → embodiment as camel → desert and solitude → confrontation with the “Thou shalt” → lion's battle and sacred No → recognized incapacity for value-creation → childlike new beginning → sacred saying-Yes and world of one's own.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VDDV:ME1","text":"The opposition of subjection and freedom is transferred into a developmental sequence of burden, liberation, and creation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ME2","text":"Suffering, renunciation, and self-humiliation are reclassified as preparatory operations of a spiritual transformation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ME3","text":"Inherited values become visible not as neutral norms, but as a dragon-shaped totalization with a prohibitive claim.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ME4","text":"Freedom is distinguished from value-creation and thereby mapped as an intermediate stage.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ME5","text":"Negation is recoded from endpoint into threshold of an affirmative beginning.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ME6","text":"The relation to the world shifts from loss of world through self-assertion to the gaining of one's own world.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VDDV:ALT1","text":"**Surface:** The spirit passes through the forms of camel, lion, and child.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ALT2","text":"**Structural:** Assumption of burden, desert isolation, battle with the dragon, and new beginning form the functional mechanisms of transformation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ALT3","text":"**Metastrategic:** The text replaces the direct demand for new values with a strategy of self-overcoming, liberation, and subsequent affirmation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:ALT4","text":"**Ontological/Temporal:** New values demand a first movement that does not originate from the completed past, but opens a different temporal order through forgetting and new beginning.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0017","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VDDV:MRT1","text":"The axioms suffice to reconstruct the three-stage generation of the capacity to bear burdens, freedom, and creation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:MRT2","text":"It remains underdetermined how the transition from lion to child is concretely mediated.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VDDV:MRT3","text":"It likewise remains underdetermined according to which criteria the child's new values are to be valid.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VDDV:MRT4","text":"The structure is internally coherent, provided that camel, lion, and child are understood as functions of the spirit and not as mere states.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:MRT5","text":"The strongest operation is the separation of liberation and value-creation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:MRT6","text":"An unresolved tension exists between the necessary “I will” of the lion and the subsequently required forgetting of the child.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0014","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:MRT7","text":"A further tension lies in the fact that the text presupposes the validity of new values without elaborating their positive grounding.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0019","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDDV:MRT8","text":"The reconstruction preserves the text's actual movement: Bearing → Liberating → Beginning → Creating.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDDV:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDDV:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_97E9_VDDV@R001","source_variant_id":"canonical:CH_97E9_VDDV:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 11","title":"On the Three Metamorphoses","context":"Chapter 11","original_title":"Von den drei Verwandlungen","original_context":"Chapter 11"},"original_title":"Von den drei Verwandlungen","title_language_code":"en"},{"id":"CH_97E9_VDLH","layer":"CH","title":"On the Teachers of Virtue","order":12,"parents":["RAW_97E9_VDLH"],"revision":"CH_97E9_VDLH@R001","sha256":"474c67116471334749c265b1f367f5c67ad716a4cb0f7e9f60d7a10f03dc42b2","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VDLH:AS1","text":"Die öffentliche Ehrung des Weisen etabliert den Lehrstuhl als Institution moralischer Autorität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AS2","text":"Der Weise bestimmt den guten Schlaf als praktisches Ziel und ordnet ihm die gesamte Tagesführung unter.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AS3","text":"Selbstüberwindung, Versöhnung, Wahrheit und Heiterkeit werden als gezählte Vorbedingungen des Schlafs organisiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AS4","text":"Die Lehre erweitert diese Schlafökonomie auf Frieden, Gehorsam, bescheidene Habe, kontrollierte Geselligkeit und Zustimmung zu bestehender Obrigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AS5","text":"Der ungerufene Schlaf erscheint als Herr der Tugenden, der nach der Tagesbilanz die Gedanken entwendet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AS6","text":"Zarathustra entschlüsselt die Tugendlehre genealogisch als historische Suche nach traumlosem Schlaf und erklärt ihre Zeit für abgelaufen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VDLH:A1","text":"Der Weise wird als Kenner des Schlafs und der Tugend geehrt, belohnt und von Jünglingen aufgesucht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A2","text":"Der Weise setzt guten Schlaf als maßgebliches Kriterium gelingender Lebensführung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A3","text":"Guter Schlaf verlangt, während des ganzen Tages wachsam auf ihn hinzuarbeiten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A4","text":"Zehnfache tägliche Selbstüberwindung erzeugt die für den Schlaf erforderliche Müdigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A5","text":"Zehnfache tägliche Versöhnung mit sich selbst neutralisiert die Bitterkeit der Überwindung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A6","text":"Zehn Wahrheiten und zehn heitere Akte sättigen Seele und Leib und verhindern nächtliche Unruhe.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A7","text":"Alle Tugenden gelten als notwendig, damit guter Schlaf möglich wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A8","text":"Die Tugenden müssen zur rechten Zeit zum Schweigen gebracht werden, damit sie einander nicht bekämpfen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A9","text":"Frieden mit Gott, Nachbar und Nachbars Teufel sowie Gehorsam gegenüber jeder Obrigkeit, auch der krummen, gelten als Schlafbedingungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A10","text":"Guter Schlaf verlangt weder große Ehren noch große Schätze, wohl aber guten Namen, kleinen Schatz und zeitlich begrenzte Gesellschaft.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A11","text":"Schlaf darf nicht gerufen werden, sondern erscheint nach der rückblickenden Bilanz der Tagesgedanken und Tageshandlungen ungerufen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A12","text":"Der Schlaf wird als Herr der Tugenden dargestellt, der die Gedanken des Schlafenden stiehlt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A13","text":"Zarathustra deutet die Weisheit der Lehrstuhlweisen als Wachen, um gut zu schlafen, und als Suche nach traumlosem Schlaf ohne besseren Lebenssinn.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VDLH:NX1","text":"Die Lehre weist schlechte Schläfer und nächtliche Wacher als zu meidende Existenzen zurück.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX2","text":"Falsches Zeugnis, Ehebruch und Begehren nach der Frau des Nächsten werden als mit gutem Schlaf unvereinbar ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX3","text":"Unversöhntheit und Streit zwischen den Tugenden werden als schlafzerstörende Zustände ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX4","text":"Unfrieden mit Gott, Nachbar oder Nachbars Teufel wird als unzulässige Störung ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX5","text":"Große Ehren und große Schätze werden ausgeschlossen, während ein guter Name und ein kleiner Schatz zugelassen bleiben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX6","text":"Böse oder zeitlich ungeordnete Gesellschaft wird ausgeschlossen, nicht jedoch kleine, geregelte Gesellschaft.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX7","text":"Widerstand gegen die Obrigkeit wird ausgeschlossen, selbst wenn die Obrigkeit als krumm erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX8","text":"Das direkte Herbeirufen des Schlafs wird ausgeschlossen; der Schlaf muss ungerufen eintreten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX9","text":"Eine Weisheit, die einen höheren Sinn als traumlosen Schlaf bereitstellt, wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VDLH:D1","text":"Tugenden erhalten ihren operativen Wert nicht aus einer autonomen Geltung, sondern aus ihrer schlaffördernden Wirkung.","refs":["CH_97E9_VDLH:A2","CH_97E9_VDLH:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D2","text":"Der Tag wird in eine kontrollierte Bilanz von Selbstüberwindungen, Versöhnungen, Wahrheiten und Gelächtern umgewandelt.","refs":["CH_97E9_VDLH:A4","CH_97E9_VDLH:A5","CH_97E9_VDLH:A6","CH_97E9_VDLH:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D3","text":"Selbstüberwindung ist kein abschließender Wert, sondern muss durch Versöhnung in Schlafverträglichkeit überführt werden.","refs":["CH_97E9_VDLH:A4","CH_97E9_VDLH:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D4","text":"Wahrheit und Heiterkeit fungieren als Mittel zur affektiven und körperlichen Stilllegung, nicht als offene Erkenntnisbewegung.","refs":["CH_97E9_VDLH:A6","CH_97E9_VDLH:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D5","text":"Die Tugendordnung verlangt zunächst vollständige Tugendfülle und anschließend deren zeitweilige Ausschaltung.","refs":["CH_97E9_VDLH:A7","CH_97E9_VDLH:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D6","text":"Gehorsam gegenüber einer fehlerhaften Obrigkeit wird durch seine schlaffördernde Funktion ethisch integriert.","refs":["CH_97E9_VDLH:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D7","text":"Ein mittleres Maß an Besitz, Anerkennung und Geselligkeit wird als hinreichende soziale Form der Schlafökonomie bestimmt.","refs":["CH_97E9_VDLH:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D8","text":"Schlaf wird indirekt erzeugt: Die Disziplin bereitet ihn vor, ohne ihn als unmittelbaren Willensakt zuzulassen.","refs":["CH_97E9_VDLH:A3","CH_97E9_VDLH:A4","CH_97E9_VDLH:A5","CH_97E9_VDLH:A6","CH_97E9_VDLH:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D9","text":"Der Lehrstuhl erzeugt eine übertragbare Form von Passivität, weil der Schlaf des Weisen als ansteckend und sein Sitz als verzaubert erscheint.","refs":["CH_97E9_VDLH:A1","CH_97E9_VDLH:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D10","text":"Zarathustras Lachen verwandelt die Predigt von einer verbindlichen Lehre in einen genealogisch lesbaren Ausdruck eines historischen Bedürfnisses.","refs":["CH_97E9_VDLH:A1","CH_97E9_VDLH:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0026","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VDLH:SD1","text":"Das gesamte Tugendsystem unterordnet Wahrheit, Selbstverhältnis, Geselligkeit und Moral dem Ziel körperlicher und geistiger Stilllegung.","refs":["CH_97E9_VDLH:A2","CH_97E9_VDLH:A6","CH_97E9_VDLH:A7","CH_97E9_VDLH:A8","CH_97E9_VDLH:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SD2","text":"Die Lehre stabilisiert soziale und politische Anpassung, indem Frieden, Gehorsam, bescheidener Besitz und begrenzte Geselligkeit als Bedingungen des guten Lebens erscheinen.","refs":["CH_97E9_VDLH:A9","CH_97E9_VDLH:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SD3","text":"Pädagogische Autorität reproduziert sich als ansteckende Reduktion von Wachheit, bis der Lehrstuhl selbst zum Bild des Erstarrens wird.","refs":["CH_97E9_VDLH:A1","CH_97E9_VDLH:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0029","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SD4","text":"Das System ist zeitlich selbstaufhebend: Sein Erfolg besteht darin, die Lehrenden und ihre Anhänger zum Liegen zu bringen.","refs":["CH_97E9_VDLH:A11","CH_97E9_VDLH:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SD5","text":"Wo dem Leben kein Sinn zugestanden wird, ersetzt die Lehre Sinn nicht durch Schöpfung, sondern durch den bevorzugten Unsinn des traumlosen Schlafs.","refs":["CH_97E9_VDLH:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VDLH:DNX1","text":"Das System schließt stillschweigend aus, dass Tugenden einen von ihrer schlaffördernden Funktion unabhängigen Wert besitzen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0009","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:DNX2","text":"Es schließt eine Wachheit aus, die dauerhaft offen, konflikthaft oder schöpferisch bleibt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0002","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0003","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0012","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:DNX3","text":"Es schließt aus, dass Selbstüberwindung in eine fortgesetzte Steigerung führt; sie muss in Versöhnung und Ermüdung enden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:DNX4","text":"Es schließt politische Kritik als eigenständige Tugend aus, weil selbst krumme Macht in die Schlafordnung integrierbar bleibt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:DNX5","text":"Es schließt einen zukünftigen oder überschreitenden Lebenssinn aus, der über Ruhe und Entlastung hinausweist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:DNX6","text":"Es schließt eine Weisheit aus, die Gedanken nicht sammelt, um sie schließlich zu verlieren, sondern sie dauerhaft erhält und erweitert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0022","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0024","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VDLH:SNX1","text":"Die tiefste Negation richtet sich gegen einen positiven Sinn des Lebens, der nicht durch Beruhigung ersetzt werden kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SNX2","text":"Die Möglichkeit eines Lebens in dauernder Wachheit wird unzugänglich, weil Wachen nur noch als Mittel des Einschlafens zählt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SNX3","text":"Die Möglichkeit einer konfliktfähigen Tugend wird blockiert, weil jeder Konflikt als schlafstörende Unversöhnlichkeit erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SNX4","text":"Die Möglichkeit einer nichtangepassten politischen Ethik wird blockiert, weil selbst die krumme Obrigkeit als schlafkompatibel gilt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SNX5","text":"Die Möglichkeit eines fortbestehenden Lehrers wird verneint; die letzte Gestalt der Weisheit ist das Aufhören des Stehens und das Liegen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VDLH:FGS1","text":"Öffentliche Ehrung und versammelte Jünglinge → institutionalisierte Autorität des Lehrstuhls.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:FGS2","text":"Schlaf als oberstes Kriterium → Umwandlung des Tages in eine Vorbereitungs- und Disziplinierungsphase.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:FGS3","text":"Selbstüberwindung + Versöhnung + Wahrheit + Lachen → gezählte Tagesbilanz und affektive Entlastung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:FGS4","text":"Frieden + Gehorsam + maßvoller Besitz + geregelte Gesellschaft → soziale Reibungsminimierung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:FGS5","text":"Vollständige Tugendfülle + zeitweilige Stillstellung → ungerufener Schlaf als indirekte Vollendung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:FGS6","text":"Ungerufener Schlaf + Gedankenverlust → Zarathustras Lachen und genealogische Umcodierung der Tugendlehre in traumlose Lebensverneinung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VDLH:AF1","text":"Öffentliche Ehrung des Tugendlehrers → Schlaf als Telos → Tagesdisziplin → soziale und politische Befriedung → gezählte Selbstbilanz → ungerufener Schlaf → Entzug der Gedanken → genealogische Entschlüsselung → Traumlosigkeit als historischer Lebenssinn → Ende der Lehrstuhlweisen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AF2","text":"Wachen → Ermüdung → Selbstüberwindung → Versöhnung → Tugendfülle → Stillstellung der Tugenden → Liegen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VDLH:ME1","text":"Tugenden werden von autonomen moralischen Werten zu Techniken der Schlafregulierung umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ME2","text":"Wachen wird nicht mehr als Gegenpol zum Schlaf, sondern als instrumentelle Vorstufe des Schlafs sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ME3","text":"Konflikte zwischen Tugenden werden als physiologische und affektive Schlafstörungen klassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ME4","text":"Gehorsam, bescheidener Besitz und soziale Begrenzung werden in dieselbe ethische Ordnung wie Wahrheit und Selbstüberwindung eingeordnet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ME5","text":"Der Lebenssinn wird von Weisheit und Erkenntnis auf traumlosen Schlaf verschoben; die moralischen Lehrer erscheinen dadurch als erschöpfte und überholte Figuren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VDLH:ALT1","text":"**Surface** — Der Weise lehrt eine Tagesordnung aus Überwindung, Versöhnung, Wahrheit, Heiterkeit, Gehorsam und maßvoller Lebensführung, die guten Schlaf hervorbringen soll.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ALT2","text":"**Structural** — Der Lehrstuhl verwandelt moralische Normen in ein Disziplinarsystem zur Reduktion innerer, sozialer und politischer Reibung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ALT3","text":"**Metastrategic** — Zarathustra verschiebt die Lesart von normativer Zustimmung zu genealogischer Diagnose, indem er die Weisheit des Lehrers als Schlafbedürfnis entlarvt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ALT4","text":"**Ontological/Temporal** — Schlaf fungiert als letzter Sinnhorizont, während das zeitliche Ende der Lehrer in der Bewegung vom Stehen zum Liegen erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VDLH:MRT1","text":"Die Axiome reichen aus, um die Erzeugung des guten Schlafs aus Tagesdisziplin, Tugendverwaltung und sozialer Befriedung zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:MRT2","text":"Unterbestimmt bleibt, ob Zarathustras Diagnose sämtliche Tugendlehren oder primär diesen Prediger und die ältere Lehrstuhltradition betrifft.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0027","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:MRT3","text":"Die Struktur ist operativ kohärent, enthält jedoch ungelöste Spannungen zwischen notwendigem Wachen und endgültigem Einschlafen sowie zwischen erforderlicher Tugendfülle und ihrer Stillstellung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0025","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:MRT4","text":"Eine weitere Spannung entsteht daraus, dass zehn Wahrheiten gesucht werden, ihr Endzweck aber ein traumloser Zustand ohne höheren Sinn ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0007","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:MRT5","text":"Die stärkste Operation ist die Umkehrung der Tugendlehre in eine Schlaftechnologie mit sozial stabilisierender Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:MRT6","text":"Die Rekonstruktion bewahrt die Bewegung von institutioneller Autorität über moralische Disziplin zur genealogischen Entwertung, lässt aber offen, ob der bevorzugte Unsinn des Schlafs ausschließlich Spott oder bereits eine Gegenposition bezeichnet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0026","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261015T194417333344Z_606c39e8","language_code":"en","language_name":"English","title":"On the Chairs of Virtue","source_sha256":"474c67116471334749c265b1f367f5c67ad716a4cb0f7e9f60d7a10f03dc42b2","sha256":"5221e366ee5088b612478a1b3a08d47c127a9fd9f2e26c93d50c14d8fa8dc3a0","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-15T19:44:17.339614+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VDLH:AS1","text":"The public honoring of the wise man establishes the chair as an institution of moral authority.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AS2","text":"The wise man defines good sleep as a practical goal and subordinates the entire conduct of the day to it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AS3","text":"Self-overcoming, reconciliation, truth, and cheerfulness are organized as enumerated preconditions of sleep.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AS4","text":"The teaching extends this economy of sleep to peace, obedience, modest possessions, controlled sociability, and assent to existing authority.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AS5","text":"Unbidden sleep appears as lord of the virtues, who steals away thoughts after the day's reckoning.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AS6","text":"Zarathustra genealogically deciphers the teaching of virtue as a historical search for dreamless sleep and declares its time to be over.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VDLH:A1","text":"The wise man is honored, rewarded, and visited by youths as a connoisseur of sleep and virtue.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A2","text":"The wise man establishes good sleep as the decisive criterion of a successful conduct of life.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A3","text":"Good sleep requires working vigilantly toward it throughout the entire day.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A4","text":"Tenfold daily self-overcoming produces the fatigue required for sleep.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A5","text":"Tenfold daily reconciliation with oneself neutralizes the bitterness of overcoming.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A6","text":"Ten truths and ten cheerful acts satiate soul and body and prevent nocturnal unrest.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A7","text":"All virtues count as necessary in order for good sleep to become possible.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A8","text":"The virtues must be silenced at the right time so that they do not fight one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A9","text":"Peace with God, neighbor, and the neighbor's devil, as well as obedience to every authority, even the crooked one, count as conditions of sleep.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A10","text":"Good sleep requires neither great honors nor great treasures, but indeed a good name, a small treasure, and temporally limited company.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A11","text":"Sleep must not be called, but appears unbidden after the retrospective reckoning of the day's thoughts and actions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A12","text":"Sleep is portrayed as lord of the virtues, who steals the thoughts of the sleeper.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:A13","text":"Zarathustra interprets the wisdom of the chair-wise as wakefulness in order to sleep well, and as a search for dreamless sleep without a better meaning of life.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VDLH:NX1","text":"The teaching rejects poor sleepers and those awake at night as existences to be avoided.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX2","text":"False witness, adultery, and desire for the neighbor's wife are excluded as incompatible with good sleep.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX3","text":"Irreconciliation and strife among the virtues are excluded as states that destroy sleep.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX4","text":"Discord with God, neighbor, or the neighbor's devil is excluded as an impermissible disturbance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX5","text":"Great honors and great treasures are excluded, while a good name and a small treasure remain permitted.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX6","text":"Evil or temporally disordered company is excluded, but not small, regulated company.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX7","text":"Resistance to authority is excluded, even when the authority appears crooked.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX8","text":"The direct summoning of sleep is excluded; sleep must arrive unbidden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:NX9","text":"A wisdom that provides a higher meaning than dreamless sleep is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VDLH:D1","text":"Virtues derive their operative value not from autonomous validity, but from their sleep-promoting effect.","refs":["CH_97E9_VDLH:A2","CH_97E9_VDLH:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D2","text":"The day is transformed into a controlled reckoning of self-overcomings, reconciliations, truths, and laughters.","refs":["CH_97E9_VDLH:A4","CH_97E9_VDLH:A5","CH_97E9_VDLH:A6","CH_97E9_VDLH:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D3","text":"Self-overcoming is not a final value, but must be transformed through reconciliation into compatibility with sleep.","refs":["CH_97E9_VDLH:A4","CH_97E9_VDLH:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D4","text":"Truth and cheerfulness function as means of affective and bodily deactivation, not as an open movement of knowledge.","refs":["CH_97E9_VDLH:A6","CH_97E9_VDLH:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D5","text":"The order of virtue first demands complete fullness of virtue and subsequently its temporary deactivation.","refs":["CH_97E9_VDLH:A7","CH_97E9_VDLH:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D6","text":"Obedience to a flawed authority is ethically integrated through its sleep-promoting function.","refs":["CH_97E9_VDLH:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D7","text":"A moderate measure of possession, recognition, and sociability is determined as the sufficient social form of the economy of sleep.","refs":["CH_97E9_VDLH:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D8","text":"Sleep is produced indirectly: discipline prepares it without permitting it as an immediate act of will.","refs":["CH_97E9_VDLH:A3","CH_97E9_VDLH:A4","CH_97E9_VDLH:A5","CH_97E9_VDLH:A6","CH_97E9_VDLH:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D9","text":"The chair produces a transmissible form of passivity, because the wise man's sleep appears contagious and his seat enchanted.","refs":["CH_97E9_VDLH:A1","CH_97E9_VDLH:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:D10","text":"Zarathustra's laughter transforms the sermon from a binding teaching into a genealogically readable expression of a historical need.","refs":["CH_97E9_VDLH:A1","CH_97E9_VDLH:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0026","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VDLH:SD1","text":"The entire system of virtue subordinates truth, the relation to oneself, sociability, and morality to the goal of bodily and mental deactivation.","refs":["CH_97E9_VDLH:A2","CH_97E9_VDLH:A6","CH_97E9_VDLH:A7","CH_97E9_VDLH:A8","CH_97E9_VDLH:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SD2","text":"The teaching stabilizes social and political adaptation by making peace, obedience, modest possession, and limited sociability appear as conditions of the good life.","refs":["CH_97E9_VDLH:A9","CH_97E9_VDLH:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SD3","text":"Pedagogical authority reproduces itself as a contagious reduction of wakefulness, until the chair itself becomes an image of rigidity.","refs":["CH_97E9_VDLH:A1","CH_97E9_VDLH:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0029","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SD4","text":"The system is temporally self-abolishing: its success consists in bringing the teachers and their followers to lie down.","refs":["CH_97E9_VDLH:A11","CH_97E9_VDLH:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SD5","text":"Where life is granted no meaning, the teaching replaces meaning not with creation but with the preferred nonsense of dreamless sleep.","refs":["CH_97E9_VDLH:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VDLH:DNX1","text":"The system tacitly excludes the possibility that virtues possess a value independent of their sleep-promoting function.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0009","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:DNX2","text":"It excludes a wakefulness that remains permanently open, conflictual, or creative.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0002","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0003","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0012","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:DNX3","text":"It excludes the possibility that self-overcoming leads to a continuing intensification; it must end in reconciliation and fatigue.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:DNX4","text":"It excludes political criticism as an autonomous virtue, because even crooked power remains integrable into the order of sleep.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:DNX5","text":"It excludes a future or transcendent meaning of life that points beyond rest and relief.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:DNX6","text":"It excludes a wisdom that does not gather thoughts in order ultimately to lose them, but instead preserves and enlarges them permanently.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0022","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0024","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VDLH:SNX1","text":"The deepest negation is directed against a positive meaning of life that cannot be replaced by calming.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SNX2","text":"The possibility of a life in permanent wakefulness becomes inaccessible because wakefulness now counts only as a means of falling asleep.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SNX3","text":"The possibility of a virtue capable of conflict is blocked because every conflict appears as sleep-disrupting irreconciliation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SNX4","text":"The possibility of a non-adapted political ethics is blocked because even crooked authority counts as compatible with sleep.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:SNX5","text":"The possibility of an enduring teacher is negated; the final figure of wisdom is the cessation of standing and lying down.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VDLH:FGS1","text":"Public honor and assembled youths → institutionalized authority of the chair.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:FGS2","text":"Sleep as the highest criterion → transformation of the day into a phase of preparation and disciplining.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:FGS3","text":"Self-overcoming + reconciliation + truth + laughter → enumerated daily reckoning and affective relief.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:FGS4","text":"Peace + obedience + moderate possession + regulated company → minimization of social friction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:FGS5","text":"Complete fullness of virtue + temporary deactivation → unbidden sleep as indirect completion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:FGS6","text":"Unbidden sleep + loss of thoughts → Zarathustra's laughter and genealogical recoding of the teaching of virtue into dreamless negation of life.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VDLH:AF1","text":"Public honoring of the teacher of virtue → sleep as telos → daily discipline → social and political pacification → enumerated self-reckoning → unbidden sleep → withdrawal of thoughts → genealogical decipherment → dreamlessness as historical meaning of life → end of the chair-wise.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:AF2","text":"Wakefulness → fatigue → self-overcoming → reconciliation → fullness of virtue → deactivation of the virtues → lying down.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VDLH:ME1","text":"Virtues are remapped from autonomous moral values into techniques of sleep regulation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ME2","text":"Wakefulness no longer becomes visible as the opposite pole of sleep, but as an instrumental preliminary stage of sleep.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ME3","text":"Conflicts among virtues are classified as physiological and affective sleep disturbances.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ME4","text":"Obedience, modest possession, and social limitation are assigned to the same ethical order as truth and self-overcoming.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ME5","text":"The meaning of life is shifted from wisdom and knowledge to dreamless sleep; the moral teachers thereby appear as exhausted and outdated figures.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VDLH:ALT1","text":"**Surface** — The wise man teaches a daily order of overcoming, reconciliation, truth, cheerfulness, obedience, and moderate conduct of life, which is meant to produce good sleep.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ALT2","text":"**Structural** — The chair transforms moral norms into a disciplinary system for reducing inner, social, and political friction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ALT3","text":"**Metastrategic** — Zarathustra shifts the mode of reading from normative assent to genealogical diagnosis by exposing the teacher's wisdom as a need for sleep.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:ALT4","text":"**Ontological/Temporal** — Sleep functions as the final horizon of meaning, while the temporal end of the teachers appears in the movement from standing to lying down.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VDLH:MRT1","text":"The axioms suffice to reconstruct the production of good sleep from daily discipline, administration of virtue, and social pacification.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:MRT2","text":"It remains underdetermined whether Zarathustra's diagnosis concerns all teachings of virtue or primarily this preacher and the older tradition of the chair.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0027","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:MRT3","text":"The structure is operationally coherent, yet contains unresolved tensions between necessary wakefulness and final falling asleep, as well as between the required fullness of virtue and its deactivation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0011","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0025","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:MRT4","text":"A further tension arises from the fact that ten truths are sought, while their final purpose is a dreamless state without higher meaning.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0007","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:MRT5","text":"The strongest operation is the reversal of the teaching of virtue into a technology of sleep with a socially stabilizing effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDLH:MRT6","text":"The reconstruction preserves the movement from institutional authority through moral discipline to genealogical devaluation, but leaves open whether the preferred nonsense of sleep signifies exclusively mockery or already a counter-position.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDLH:P0026","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0030","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0031","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0032","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDLH:P0033","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_97E9_VDLH@R001","source_variant_id":"canonical:CH_97E9_VDLH:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 12","title":"On the Teachers of Virtue","context":"Chapter 12","original_title":"Von den Lehrstühlen der Tugend","original_context":"Chapter 12"},"original_title":"Von den Lehrstühlen der Tugend","title_language_code":"en"},{"id":"CH_97E9_VDH0","layer":"CH","title":"On the Afterworldly","order":13,"parents":["RAW_97E9_VDH0"],"revision":"CH_97E9_VDH0@R001","sha256":"5963b8a2e2d7c25bc509acfe5d30bc4d28560429d9dcd0da69507e0e4f8cfb2a","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VDH0:AS1","text":"Das Argument setzt bei der früheren Projektion von Welt, Gott und Sinn in ein Jenseits des Menschen an.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS2","text":"Es bestimmt diese Projektion als Menschenwerk, das aus Leiden, Unvermögen, Müdigkeit und Selbstverlust hervorgeht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS3","text":"Die Hinterwelt wird dadurch von einer ontologischen Realität zu einem Symptom des verzweifelten Leibes umbestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS4","text":"Gegen die Transzendenz setzt der Text das widersprüchliche, schaffende, wollende und wertende Ich als redlichsten Zugang zum Sein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS5","text":"Die zunehmende Redlichkeit führt zur Aufwertung von Leib und Erde sowie zur Bejahung des menschlichen Weges.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS6","text":"Religiöse und dichterische Gegenpositionen werden als kranke Formen der Leibverneinung diagnostiziert, jedoch als mögliche Übergänge zur Genesung nicht schlechthin verworfen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS7","text":"Die Endposition ist die Stimme des gesunden Leibes, der den Sinn der Erde redlicher und reiner ausspricht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0033","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VDH0:A1","text":"Die Welt wurde zunächst als Werk, Traum und Dichtung eines leidenden Gottes verstanden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A2","text":"Der Gott, der diese Welt erklärt, ist Menschenwerk und Menschenwahnsinn und stammt nicht aus einem Jenseits.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A3","text":"Leiden und Unvermögen erzeugen die Hinterwelten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A4","text":"Müdigkeit erzeugt Götter und Hinterwelten, indem sie den letzten Sprung und das Ende des Wollens sucht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A5","text":"Der Leib, der an sich selbst und an der Erde verzweifelt, sucht eine Welt jenseits des Menschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A6","text":"Die jenseitige Welt ist als entmenschte Welt ein himmlisches Nichts verborgen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A7","text":"Das Sein spricht zum Menschen nicht unabhängig vom Menschen, sondern nur in menschlicher Gestalt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A8","text":"Das widersprüchliche, schaffende, wollende und wertende Ich ist der redlichste Beleg seines Seins.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A9","text":"Das Ich spricht vom Leib und will den Leib auch dann, wenn es dichtet, schwärmt oder transzendiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A10","text":"Wachsende Redlichkeit erzeugt zunehmend Worte und Anerkennung für Leib und Erde.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0020","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A11","text":"Das neue Denken soll den menschlichen Weg bejahen und der Erde durch schöpferische Tätigkeit Sinn geben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A12","text":"Kranke und Absterbende verachten Leib und Erde und erfinden himmlische Wege, Erlösung und ein anderes Sein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A13","text":"Die Mittel der vermeintlichen Entrückung stammen dennoch aus Leib und Erde.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A14","text":"Krankhafte Dichter und Gottsüchtige bekämpfen den Erkennenden und erklären Zweifel zur Sünde.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A15","text":"Auch diese Gegner glauben primär an ihren eigenen Leib, behandeln ihn jedoch als krankes Ding an sich und wollen aus ihm entfliehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0031","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A16","text":"Der gesunde Leib redet redlicher und reiner vom Sinn der Erde.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0033","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VDH0:NX1","text":"Die Welt ist nicht der unabhängige Schöpfungsakt eines transzendenten Gottes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX2","text":"Der Gott des Textes ist keine außer-menschliche Herkunft des Sinns.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX3","text":"Die Hinterwelt ist keine verfügbare oder beweiskräftige Wirklichkeit jenseits des Menschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX4","text":"Leiden, Unvermögen und Müdigkeit sind keine Beweise für Transzendenz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX5","text":"Das Sein besitzt keinen vom Menschen losgelösten sprechenden Zugang zum Menschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX6","text":"Der Geist kann den Leib und die Erde nicht als bloß niedere Durchgangsstufen hinter sich lassen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX7","text":"Zweifel ist keine Sünde und religiöse Gewissheit kein privilegierter Wahrheitsmodus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0029","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX8","text":"Die Verachtung des Leibes ist keine Befreiung vom Leib.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX9","text":"Religiöse Tröstung ist keine endgültige Genesung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX10","text":"Krankheit ist kein ausreichender Maßstab für Wahrheit, nur weil sie sich als Glaube artikuliert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0027","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0028","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VDH0:D1","text":"Die Bewegung ins Jenseits ist eine Projektion des leidenden Menschen und keine Entdeckung einer unabhängigen Welt.","refs":["CH_97E9_VDH0:A2","CH_97E9_VDH0:A3","CH_97E9_VDH0:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D2","text":"Hinterwelten verwandeln Leiden nicht, sondern dienen zunächst als Fluchtform vor dem Leiden.","refs":["CH_97E9_VDH0:A3","CH_97E9_VDH0:A4","CH_97E9_VDH0:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D3","text":"Die Verborgenheit der „jener Welt“ bezeichnet keine größere Tiefe, sondern ihre Bestimmung als himmlisches Nichts.","refs":["CH_97E9_VDH0:A6","CH_97E9_VDH0:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D4","text":"Die Erkenntnis des Seins verschiebt sich von einer jenseitigen Instanz auf die verkörperte Tätigkeit des Ichs.","refs":["CH_97E9_VDH0:A7","CH_97E9_VDH0:A8","CH_97E9_VDH0:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D5","text":"Selbst Dichtung, Schwärmerei und Erlösungsdenken bleiben in ihrer Herkunft und ihrem Vollzug an Leib und Erde gebunden.","refs":["CH_97E9_VDH0:A9","CH_97E9_VDH0:A12","CH_97E9_VDH0:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D6","text":"Zunehmende Redlichkeit erzeugt eine epistemische und normative Neuorientierung auf Leib, Erde und menschlichen Weg.","refs":["CH_97E9_VDH0:A8","CH_97E9_VDH0:A10","CH_97E9_VDH0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D7","text":"Die Verachtung der Erde ist selbstwiderlegend, weil ihre Erlösungsbilder und Erlösungsmittel aus Leib und Erde entnommen sind.","refs":["CH_97E9_VDH0:A12","CH_97E9_VDH0:A13","CH_97E9_VDH0:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0031","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D8","text":"Die Abwehr von Zweifel erscheint als Schutzreaktion eines kranken Leibes und nicht als Begründung der Wahrheit.","refs":["CH_97E9_VDH0:A14","CH_97E9_VDH0:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D9","text":"Das Ziel der Überwindung ist kein körperloses Jenseits, sondern die Hervorbringung eines höheren Leibes.","refs":["CH_97E9_VDH0:A11","CH_97E9_VDH0:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VDH0:SD1","text":"Ontologie wird in Genealogie überführt: Was als Jenseits erscheint, wird als Produktion eines leidenden und erschöpften Leibes lesbar.","refs":["CH_97E9_VDH0:A3","CH_97E9_VDH0:A4","CH_97E9_VDH0:A5","CH_97E9_VDH0:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SD2","text":"Die Verneinung des Leibes bleibt von dem Leib abhängig, den sie verneint; Transzendenz wird zur parasitären Form der Immanenz.","refs":["CH_97E9_VDH0:A9","CH_97E9_VDH0:A12","CH_97E9_VDH0:A13","CH_97E9_VDH0:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SD3","text":"Zarathustras Überwindung ist rekursiv: Eine frühere metaphysische Deutung wird selbst als Symptom diagnostiziert.","refs":["CH_97E9_VDH0:A1","CH_97E9_VDH0:A2","CH_97E9_VDH0:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SD4","text":"Wahrheit und Redlichkeit werden nicht primär durch abstrakte Geltung, sondern durch die Verfassung des sprechenden Leibes differenziert.","refs":["CH_97E9_VDH0:A8","CH_97E9_VDH0:A14","CH_97E9_VDH0:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SD5","text":"Die religiöse Gegenposition wird aus einem äußeren Gegner in eine fehlgeleitete Selbstbewegung des Leibes umklassifiziert.","refs":["CH_97E9_VDH0:A5","CH_97E9_VDH0:A12","CH_97E9_VDH0:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SD6","text":"Die Milde gegenüber den Kranken hebt die Diagnose nicht auf, sondern ordnet Krankheit als möglichen Übergang zu Genesung und höherem Leib ein.","refs":["CH_97E9_VDH0:A12","CH_97E9_VDH0:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VDH0:DNX1","text":"Es gibt keinen von menschlicher Projektion unabhängigen göttlichen Ursprung, auf den der Text zurückgreifen könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX2","text":"Es gibt keinen nicht-menschlichen Zugang zum Sein, der den menschlichen Leib und das Ich überbieten könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX3","text":"Es gibt keinen reinen Geist, der ohne körperliche Herkunft, körperliche Sprache oder körperliches Begehren operiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX4","text":"Es gibt keine Erlösung, die durch Flucht vor Leiden, Leib und Erde erreichbar wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0024","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX5","text":"Es gibt keine religiöse Bedeutung, die nicht aus den Bedingungen des Leibes entnommen wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX6","text":"Es gibt keinen abschließenden metaphysischen Beweis des Seins außerhalb der verkörperten Selbstrede.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0017","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX7","text":"Es gibt keine endgültige Rechtfertigung der Krankheit durch ihre Fähigkeit, Glauben oder Trost zu erzeugen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0028","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VDH0:SNX1","text":"Die Möglichkeit einer für den Menschen erreichbaren Welt jenseits des Menschen ist strukturell versperrt; sie bleibt als „himmlisches Nichts“ ohne operative Referenz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SNX2","text":"Die absolute Negation der Erde ist unmöglich, weil jede Negation ihre sprachlichen, affektiven und imaginativen Mittel aus der Erde bezieht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SNX3","text":"Eine stabile Trennung von Körper und Geist ist ausgeschlossen; der Geist erscheint als verzerrte Rede des Körpers über sich selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SNX4","text":"Ein vom Leib unabhängiger Wahrheitsmaßstab bleibt ausgeschlossen; die Norm der Redlichkeit entsteht aus der Stimme des Leibes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SNX5","text":"Als endgültige Geltung ist religiöse Tröstung ausgeschlossen; sie kann nur als Krankheit, Übergang oder unvollständige Genesung erscheinen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VDH0:FGS1","text":"Leiden + Unvermögen + Müdigkeit → Wunsch nach dem letzten Sprung → Projektion von Gott und Hinterwelt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS2","text":"Projektion → Rückführung auf ihren menschlichen Ursprung → Gott als Menschenwerk und Wahnsinn.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS3","text":"Rückführung → genealogische Diagnose → Hinterwelt als Symptom des am Leib und an der Erde verzweifelnden Leibes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS4","text":"Diagnose → epistemische Neurahmung → widersprüchliches, schaffendes und wertendes Ich als redlichster Zugang zum Sein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS5","text":"Verkörpertes Ich → zunehmende Redlichkeit → Worte und Ehren für Leib und Erde.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS6","text":"Redlichkeit → neuer Stolz + neuer Wille → Bejahung des menschlichen Weges und Schaffung von Erdsinn.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS7","text":"Gegenmodell der Hinterwelt → Pathologisierung seiner Träger → Unterscheidung zwischen Krankheit, möglicher Genesung und gesundem Leib.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS8","text":"Gesunder Leib → reinere Rede → Sinn der Erde als terminale Orientierung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0033","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VDH0:AF1","text":"Frühere Jenseitsprojektion → Selbstdiagnose des Gottes als Menschenwerk → Genealogie aus Leiden, Unvermögen, Müdigkeit und Leibverzweiflung → Hinterwelt als himmlisches Nichts → Ich und Leib als redlichster Seinszugang → Aufwertung von Erde und menschlichem Weg → Pathologisierung der religiösen Flucht → gesunder Leib als Träger des Erdsinns.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VDH0:ME1","text":"Der Ursprung metaphysischer Weltdeutung wird von der göttlichen Sphäre in die Physiologie des leidenden Leibes verlegt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME2","text":"Gott und Hinterwelt werden von ontologischen Instanzen zu menschlichen Produktionen und Symptomen umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME3","text":"Die epistemische Rangordnung wird umgekehrt: Das widersprüchliche verkörperte Ich erhält Vorrang vor der widerspruchsfreien Jenseitsbehauptung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME4","text":"Der Gegensatz von Körper und Geist bricht zusammen, weil religiöse Transzendenz auf körperliche Herkunft und körperliche Mittel angewiesen bleibt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME5","text":"Zweifel wird vom moralischen Vergehen zum diagnostischen Prüfstein der religiösen Pathologie.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0029","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME6","text":"Überwindung wird nicht mehr als Entkörperlichung, sondern als Herstellung eines höheren Leibes kartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME7","text":"Der religiöse Gegner erscheint nicht als Besitzer einer alternativen Welt, sondern als kranker Träger eines fehlgeleiteten Fluchtimpulses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0031","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VDH0:ALT1","text":"**Surface:** Welt, Gott, Hinterwelt, Leib, Erde, Krankheit, Genesung und gesunder Leib bilden die explizite Begriffsschicht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ALT2","text":"**Structural:** Körperliche Verzweiflung, Müdigkeit und Unvermögen erzeugen metaphysische Modelle; religiöse Gewissheit stabilisiert diese Modelle durch die Sanktionierung des Zweifels.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0029","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ALT3","text":"**Metastrategic:** Der Text ersetzt die Fluchtstrategie der Hinterwelt durch Selbstüberwindung, Erdbejahung, Schöpfung und eine neue Bewertung des menschlichen Weges.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ALT4","text":"**Ontological/Temporal:** Sein ist nur in verkörperter menschlicher Rede zugänglich; die zeitliche Struktur führt von früherer Projektion über Selbstüberwindung zu einer möglichen Genesung und einem höheren Leib.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VDH0:MRT1","text":"Die Axiome reichen aus, um die Bewegung von der früheren Jenseitsdeutung zur leib- und erdbezogenen Endposition zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT2","text":"Unterbestimmt bleibt, wie der „höhere Leib“ konkret beschaffen ist und wodurch sich ein gesunder Leib unabhängig von seiner eigenen Rede bestimmen lässt.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VDH0:MRT3","text":"Die Struktur ist intern kohärent, solange die Hinterwelt als körperlich erzeugte Flucht und der Leib als redlicherer Zugang zum Sein behandelt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT4","text":"Eine ungelöste Spannung entsteht daraus, dass das metaphysische Beweisen zurückgewiesen, der Leib jedoch als „redlichstes Sein“ und Maßstab privilegiert wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0017","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT5","text":"Eine zweite Bruchlinie liegt darin, dass Krankheit als Ursprung der Hinterwelten verworfen, zugleich aber als möglicher Übergang zur Genesung geduldet wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT6","text":"Die Bestimmung der Hinterwelt als zugleich verborgene Welt und himmlisches Nichts lässt ihren epistemischen Status ambivalent.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0015","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT7","text":"Die Rekonstruktion bewahrt die tatsächliche Argumentbewegung nur dann, wenn die zeitliche Selbstkorrektur Zarathustras und die verbleibende Krankheit der Genesenden erhalten bleiben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT8","text":"Die stärkste operative Einheit des Systems ist die Rückführung jeder Transzendenzbehauptung auf die körperliche Bedingung ihrer Erzeugung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261015T194328905393Z_52dbae0e","language_code":"en","language_name":"English","title":"Of the Hinterworldly","source_sha256":"5963b8a2e2d7c25bc509acfe5d30bc4d28560429d9dcd0da69507e0e4f8cfb2a","sha256":"51ea6588867bc6581d1cdd8ba8f8896ccd6c0dc471c5e12c591542f69e866647","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-15T19:43:28.907477+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VDH0:AS1","text":"The argument begins with the earlier projection of world, God, and meaning into an beyond of the human being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS2","text":"It determines this projection as a human work that arises from suffering, incapacity, weariness, and loss of self.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS3","text":"The hinterworld is thereby redefined from an ontological reality into a symptom of the despairing body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS4","text":"Against transcendence, the text sets the contradictory, creating, willing, and valuing I as the most honest access to being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS5","text":"Increasing honesty leads to the revaluation of body and earth, as well as to the affirmation of the human path.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS6","text":"Religious and poetic counterpositions are diagnosed as sick forms of body-negation, yet are not simply rejected as possible transitions to recovery.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:AS7","text":"The final position is the voice of the healthy body, which speaks the meaning of the earth more honestly and purely.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0033","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VDH0:A1","text":"The world was initially understood as the work, dream, and poetry of a suffering God.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A2","text":"The God who explains this world is human work and human madness and does not originate from an beyond.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A3","text":"Suffering and incapacity produce the hinterworlds.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A4","text":"Weariness produces gods and hinterworlds by seeking the final leap and the end of willing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A5","text":"The body that despairs of itself and of the earth seeks a world beyond the human being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A6","text":"The otherworldly world, as a dehumanized world, is concealed as a heavenly nothing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A7","text":"Being speaks to the human being not independently of the human being, but only in human form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A8","text":"The contradictory, creating, willing, and valuing I is the most honest evidence of its being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A9","text":"The I speaks of the body and wills the body even when it poetizes, enthuses, or transcends.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A10","text":"Growing honesty produces increasingly words and recognition for body and earth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0020","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A11","text":"The new thinking is to affirm the human path and give meaning to the earth through creative activity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A12","text":"The sick and the dying despise body and earth and invent heavenly paths, redemption, and another being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A13","text":"The means of supposed rapture nevertheless derive from body and earth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A14","text":"Pathological poets and God-addicts combat the knower and declare doubt to be sin.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A15","text":"These opponents too primarily believe in their own body, yet treat it as a sick thing-in-itself and wish to flee from it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0031","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:A16","text":"The healthy body speaks more honestly and purely of the meaning of the earth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0033","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VDH0:NX1","text":"The world is not the independent act of creation of a transcendent God.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX2","text":"The God of the text is not an extra-human origin of meaning.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX3","text":"The hinterworld is not an available or probative reality beyond the human being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX4","text":"Suffering, incapacity, and weariness are not proofs of transcendence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX5","text":"Being has no speaking access to the human being detached from the human being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX6","text":"Spirit cannot leave body and earth behind as merely lower transitional stages.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX7","text":"Doubt is not a sin, and religious certainty is not a privileged mode of truth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0029","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX8","text":"Contempt for the body is not liberation from the body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX9","text":"Religious consolation is not final recovery.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:NX10","text":"Illness is not a sufficient criterion of truth merely because it articulates itself as belief.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0027","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0028","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VDH0:D1","text":"The movement into the beyond is a projection of the suffering human being and not the discovery of an independent world.","refs":["CH_97E9_VDH0:A2","CH_97E9_VDH0:A3","CH_97E9_VDH0:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D2","text":"Hinterworlds do not transform suffering, but initially serve as a form of flight from suffering.","refs":["CH_97E9_VDH0:A3","CH_97E9_VDH0:A4","CH_97E9_VDH0:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D3","text":"The concealedness of the „jener Welt“ designates no greater depth, but rather its determination as a heavenly nothing.","refs":["CH_97E9_VDH0:A6","CH_97E9_VDH0:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D4","text":"Knowledge of being shifts from an otherworldly instance to the embodied activity of the I.","refs":["CH_97E9_VDH0:A7","CH_97E9_VDH0:A8","CH_97E9_VDH0:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D5","text":"Even poetry, enthusiasm, and thinking of redemption remain bound, in their origin and execution, to body and earth.","refs":["CH_97E9_VDH0:A9","CH_97E9_VDH0:A12","CH_97E9_VDH0:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D6","text":"Increasing honesty produces an epistemic and normative reorientation toward body, earth, and the human path.","refs":["CH_97E9_VDH0:A8","CH_97E9_VDH0:A10","CH_97E9_VDH0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D7","text":"Contempt for the earth is self-refuting because its images and means of redemption are taken from body and earth.","refs":["CH_97E9_VDH0:A12","CH_97E9_VDH0:A13","CH_97E9_VDH0:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0031","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D8","text":"The defense against doubt appears as a protective reaction of a sick body and not as a grounding of truth.","refs":["CH_97E9_VDH0:A14","CH_97E9_VDH0:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:D9","text":"The goal of overcoming is not a bodiless beyond, but the production of a higher body.","refs":["CH_97E9_VDH0:A11","CH_97E9_VDH0:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VDH0:SD1","text":"Ontology is transformed into genealogy: what appears as an beyond becomes legible as the production of a suffering and exhausted body.","refs":["CH_97E9_VDH0:A3","CH_97E9_VDH0:A4","CH_97E9_VDH0:A5","CH_97E9_VDH0:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SD2","text":"The negation of the body remains dependent on the body it negates; transcendence becomes a parasitic form of immanence.","refs":["CH_97E9_VDH0:A9","CH_97E9_VDH0:A12","CH_97E9_VDH0:A13","CH_97E9_VDH0:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SD3","text":"Zarathustra's overcoming is recursive: an earlier metaphysical interpretation is itself diagnosed as a symptom.","refs":["CH_97E9_VDH0:A1","CH_97E9_VDH0:A2","CH_97E9_VDH0:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SD4","text":"Truth and honesty are differentiated not primarily by abstract validity, but by the condition of the speaking body.","refs":["CH_97E9_VDH0:A8","CH_97E9_VDH0:A14","CH_97E9_VDH0:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SD5","text":"The religious counterposition is reclassified from an external opponent into a misguided self-movement of the body.","refs":["CH_97E9_VDH0:A5","CH_97E9_VDH0:A12","CH_97E9_VDH0:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SD6","text":"Mildness toward the sick does not cancel the diagnosis, but situates illness as a possible transition to recovery and a higher body.","refs":["CH_97E9_VDH0:A12","CH_97E9_VDH0:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VDH0:DNX1","text":"There is no divine origin independent of human projection to which the text could have recourse.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX2","text":"There is no non-human access to being that could surpass the human body and the I.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX3","text":"There is no pure spirit that operates without bodily origin, bodily language, or bodily desire.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX4","text":"There is no redemption attainable through flight from suffering, body, and earth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0024","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX5","text":"There is no religious meaning that has not been taken from the conditions of the body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX6","text":"There is no conclusive metaphysical proof of being outside embodied self-speech.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0017","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:DNX7","text":"There is no final justification of illness through its capacity to produce belief or consolation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0028","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VDH0:SNX1","text":"The possibility of a world beyond the human being attainable for the human being is structurally barred; it remains, as „himmlisches Nichts“, without operative reference.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SNX2","text":"The absolute negation of the earth is impossible because every negation draws its linguistic, affective, and imaginative means from the earth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SNX3","text":"A stable separation of body and spirit is excluded; spirit appears as the distorted speech of the body about itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SNX4","text":"A criterion of truth independent of the body remains excluded; the norm of honesty arises from the voice of the body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:SNX5","text":"As final validity, religious consolation is excluded; it can appear only as illness, transition, or incomplete recovery.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VDH0:FGS1","text":"Suffering + incapacity + weariness → desire for the final leap → projection of God and hinterworld.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS2","text":"Projection → reduction to its human origin → God as human work and madness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS3","text":"Reduction → genealogical diagnosis → hinterworld as symptom of the body despairing of body and earth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS4","text":"Diagnosis → epistemic reframing → contradictory, creating, and valuing I as the most honest access to being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS5","text":"Embodied I → increasing honesty → words and honors for body and earth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS6","text":"Honesty → new pride + new will → affirmation of the human path and creation of earth-meaning.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS7","text":"Countermodel of the hinterworld → pathologization of its bearers → distinction between illness, possible recovery, and healthy body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:FGS8","text":"Healthy body → purer speech → meaning of the earth as terminal orientation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0033","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VDH0:AF1","text":"Earlier projection into the beyond → self-diagnosis of God as human work → genealogy from suffering, incapacity, weariness, and bodily despair → hinterworld as heavenly nothing → I and body as most honest access to being → revaluation of earth and human path → pathologization of religious flight → healthy body as bearer of earth-meaning.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VDH0:ME1","text":"The origin of metaphysical world-interpretation is relocated from the divine sphere into the physiology of the suffering body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME2","text":"God and hinterworld are reclassified from ontological instances into human productions and symptoms.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME3","text":"The epistemic hierarchy is reversed: the contradictory embodied I takes precedence over the contradiction-free assertion of an beyond.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME4","text":"The opposition of body and spirit collapses because religious transcendence remains dependent on bodily origin and bodily means.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME5","text":"Doubt shifts from moral transgression to a diagnostic touchstone of religious pathology.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0029","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME6","text":"Overcoming is mapped no longer as disembodiment, but as the production of a higher body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ME7","text":"The religious opponent appears not as the possessor of an alternative world, but as a sick bearer of a misguided impulse of flight.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0031","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0032","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VDH0:ALT1","text":"**Surface:** World, God, hinterworld, body, earth, illness, recovery, and healthy body constitute the explicit conceptual layer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ALT2","text":"**Structural:** Bodily despair, weariness, and incapacity produce metaphysical models; religious certainty stabilizes these models through the sanctioning of doubt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0029","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ALT3","text":"**Metastrategic:** The text replaces the flight strategy of the hinterworld with self-overcoming, affirmation of the earth, creation, and a new evaluation of the human path.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:ALT4","text":"**Ontological/Temporal:** Being is accessible only in embodied human speech; the temporal structure leads from earlier projection through self-overcoming to a possible recovery and a higher body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VDH0:MRT1","text":"The axioms suffice to reconstruct the movement from the earlier interpretation of the beyond to the final position oriented toward body and earth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT2","text":"It remains underdetermined how the „höhere Leib“ is concretely constituted and by what a healthy body can be determined independently of its own speech.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VDH0:MRT3","text":"The structure is internally coherent so long as the hinterworld is treated as bodily produced flight and the body as a more honest access to being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT4","text":"An unresolved tension arises from the rejection of metaphysical proving while the body is privileged as „redlichstes Sein“ and criterion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0017","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0034","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT5","text":"A second line of fracture lies in the fact that illness is rejected as the origin of hinterworlds, while at the same time tolerated as a possible transition to recovery.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0026","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT6","text":"The determination of the hinterworld as both concealed world and heavenly nothing leaves its epistemic status ambivalent.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0015","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0016","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT7","text":"The reconstruction preserves the actual movement of the argument only if Zarathustra's temporal self-correction and the remaining illness of those recovering are retained.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0027","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDH0:MRT8","text":"The system's strongest operative unity is the reduction of every claim to transcendence to the bodily condition of its production.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDH0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDH0:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_97E9_VDH0@R001","source_variant_id":"canonical:CH_97E9_VDH0:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 13","title":"On the Afterworldly","context":"Chapter 13","original_title":"Von den Hinterweltlern","original_context":"Chapter 13"},"original_title":"Von den Hinterweltlern","title_language_code":"en"},{"id":"CH_97E9_VDVC","layer":"CH","title":"On the Despisers of the Body","order":14,"parents":["RAW_97E9_VDVC"],"revision":"CH_97E9_VDVC@R001","sha256":"ad69dd538efd0097149861a157124ede3264307a13bc4b79c545361f45e94599","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VDVC:AS1","text":"Der Text adressiert die Leibverächter, verweigert ihnen jedoch eine Umerziehung und führt ihre Haltung bis zum Abschied vom eigenen Leib und zum Verstummen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:AS2","text":"Die kindliche Trennung von Leib und Seele wird durch die Setzung des Leibes als vollständige Wirklichkeit und der Seele als leibliche Benennung ersetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:AS3","text":"Der Leib wird als große Vernunft bestimmt, während Sinn, Geist und Ich zu nachgeordneten Werkzeugen und Funktionen werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:AS4","text":"Hinter Gedanken, Gefühlen und dem Ich wird ein im Leib wirkendes Selbst als steuernde und schöpferische Instanz angesetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:AS5","text":"Denken, Wertung und Geist werden aus den leiblichen Anforderungen und der schöpferischen Bewegung des Selbst genealogisch abgeleitet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:AS6","text":"Leibverachtung erscheint als Symptom der blockierten Fähigkeit, über sich hinaus zu schaffen, und nicht als Weg zum Übermenschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VDVC:A1","text":"Die wissende Position setzt den Menschen ganz als Leib und die Seele als Wort für ein Etwas am Leib.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A2","text":"Der Leib ist eine große Vernunft, die Vielheit, Einheit, Streit, Frieden, Herde und Hirtenfunktion zugleich umfasst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A3","text":"Sinn und Geist sind Werk- und Spielzeuge der großen leiblichen Vernunft; der Geist ist eine kleine Vernunft.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A4","text":"Das Ich ist nicht die höchste Instanz, sondern eine vom Leib beziehungsweise von dessen großer Vernunft hervorgebrachte Funktion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A5","text":"Sinn und Geist haben ihr Ende nicht in sich, beanspruchen aber aus Eitelkeit, das Ende aller Dinge zu sein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A6","text":"Das Selbst steht hinter Gedanken und Gefühlen, sucht und hört durch Sinn und Geist und ist im Leib beziehungsweise der Leib selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A7","text":"Das Selbst vergleicht, bezwingt, erobert, zerstört und beherrscht sowohl die Weltbezüge des Ichs als auch das Ich selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A8","text":"Schmerz und Lust des Selbst bestimmen das Denken als Mittel zur Verringerung des Schmerzes und zur Wiederholung der Lust.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A9","text":"Das schöpferische Selbst erzeugt Achten, Verachten, Wert, Willen, Lust und Weh und schafft den Geist als Hand seines Willens.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A10","text":"Das Selbst will primär über sich hinaus schaffen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A11","text":"Wenn das Selbst nicht mehr über sich hinaus schaffen kann, wendet es sich vom Leben ab und will untergehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VDVC:NX1","text":"Leibverachtung wird nicht als ein Irrtum behandelt, der durch Umerziehung zu korrigieren wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX2","text":"Die Seele wird nicht als vom Leib unabhängige Substanz zugelassen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX3","text":"Der Geist wird nicht als selbstgenügsame oder letzte Vernunft anerkannt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX4","text":"Das Ich wird nicht als souveräner Ursprung von Gedanken, Gefühlen, Wert und Willen anerkannt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX5","text":"Sinn und Geist werden nicht als das Ende oder der letzte Horizont des Menschen zugelassen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX6","text":"Leibverachtung wird nicht als selbstständige, vom Selbst unabhängige Wertentscheidung anerkannt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX7","text":"Die Verächter des Leibes werden nicht als Brücken zum Übermenschen anerkannt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VDVC:D1","text":"Die Einheit des Menschen entsteht nicht durch die Ausschaltung von Vielheit und Konflikt, sondern durch deren leibliche Organisation in einer großen Vernunft.","refs":["CH_97E9_VDVC:A1","CH_97E9_VDVC:A2"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D2","text":"Geist, Sinn und Ich bilden keine konkurrierenden Subjekte neben dem Leib, sondern abgestufte Instrumente seiner Selbsttätigkeit.","refs":["CH_97E9_VDVC:A3","CH_97E9_VDVC:A4","CH_97E9_VDVC:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D3","text":"Gedanken und Gefühle besitzen keine autonome Finalität, weil sie durch die leibliche Selbstorganisation eingesetzt und gelenkt werden.","refs":["CH_97E9_VDVC:A5","CH_97E9_VDVC:A6","CH_97E9_VDVC:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D4","text":"Wertungen und Willensformen sind Erzeugnisse des schöpferischen Selbst und keine vorausliegenden, körperunabhängigen Maßstäbe.","refs":["CH_97E9_VDVC:A6","CH_97E9_VDVC:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D5","text":"Selbst im Irrtum und in der Leibverachtung bleibt der Verächter dem eigenen Selbst dienstbar.","refs":["CH_97E9_VDVC:A6","CH_97E9_VDVC:A7","CH_97E9_VDVC:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D6","text":"Leibverachtung entsteht dort, wo das Selbst seine Fähigkeit zum Übersichhinausschaffen verloren hat und deshalb gegen Leben und Erde ausschlägt.","refs":["CH_97E9_VDVC:A10","CH_97E9_VDVC:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D7","text":"Die Abkehr vom Leib ist keine Überschreitung des Selbst, sondern die Folge eines misslungenen oder verspäteten Selbstüberschreitens.","refs":["CH_97E9_VDVC:A10","CH_97E9_VDVC:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D8","text":"Der Weg der Leibverachtung kann nicht in die vom Text geforderte Richtung des Übermenschen führen.","refs":["CH_97E9_VDVC:A2","CH_97E9_VDVC:A10","CH_97E9_VDVC:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VDVC:SD1","text":"Die vermeintliche Opposition von Leib und Geist wird in eine funktionale Ordnung umgewandelt, in der der Leib zugleich ontologischer Grund, epistemische Instanz und Handlungsorganismus ist.","refs":["CH_97E9_VDVC:D1","CH_97E9_VDVC:D2","CH_97E9_VDVC:D3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SD2","text":"Die Behauptung geistiger Autonomie erscheint als sekundäre Eitelkeit eines Instruments, das seine eigene leibliche Bedingtheit verkennt.","refs":["CH_97E9_VDVC:D2","CH_97E9_VDVC:D3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SD3","text":"Erkenntnis, Wertung und Pathologie werden in derselben leiblichen Dynamik verankert: Das, was urteilt, erzeugt zugleich die Bedingungen seines Urteilens.","refs":["CH_97E9_VDVC:D3","CH_97E9_VDVC:D4","CH_97E9_VDVC:D6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0015","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SD4","text":"Die Entthronung des Ichs beseitigt Herrschaft nicht, sondern verlagert sie auf ein tiefer im Leib angesetztes und als Selbst gefasstes Herrschaftszentrum.","refs":["CH_97E9_VDVC:A4","CH_97E9_VDVC:A6","CH_97E9_VDVC:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SD5","text":"Selbstüberwindung wird als schöpferische Steigerung des Lebens bestimmt und dadurch von jeder bloß negierenden Abkehr vom Leib getrennt.","refs":["CH_97E9_VDVC:D6","CH_97E9_VDVC:D7","CH_97E9_VDVC:D8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VDVC:DNX1","text":"Ausgeschlossen wird ein immaterielles Subjekt, das dem Leib äußerlich gegenübersteht und ihn von außen beurteilen könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:DNX2","text":"Ausgeschlossen wird die Selbsttransparenz des Bewusstseins; das Ich kennt den bestimmenden Grund seiner Gedanken und Gefühle nicht unmittelbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0008","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:DNX3","text":"Ausgeschlossen wird eine Vernunft, deren Geltung nicht aus leiblicher Organisation, Bedürfnis und Selbsttätigkeit hervorgeht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:DNX4","text":"Ausgeschlossen wird ein Wertmaßstab, der vor oder außerhalb der schöpferischen Tätigkeit des Selbst besteht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:DNX5","text":"Ausgeschlossen wird die Möglichkeit, durch bloße Verneinung, Entsagung oder Leibflucht über sich hinauszugelangen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:DNX6","text":"Ausgeschlossen wird eine Trennung zwischen körperlicher Konstitution, Erkenntnis, Wertung und Lebensrichtung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VDVC:SNX1","text":"Unmöglich wird ein externer Standpunkt, von dem aus der Leib als bloßes Objekt einer unabhängigen Seele oder Vernunft beurteilt werden könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SNX2","text":"Unzulässig wird jede Transzendenz, die nicht aus leiblicher Schöpfung, sondern aus der Vernichtung oder Verwerfung des Leibes hervorgehen soll.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SNX3","text":"Versperrt ist die Möglichkeit, dass Leibverachtung eine positive Zukunft eröffnet; sie kann nur als Ausdruck einer bereits blockierten Zukunft des Selbst erscheinen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SNX4","text":"Der Diskurs ist um die Abwesenheit einer gelungenen Selbstüberschreitung organisiert, die in der Leibverachtung durch Todeswunsch, Lebensabkehr und Neid ersetzt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SNX5","text":"Nicht verfügbar ist ein Übermensch, der durch bloße Loslösung vom Leib erreichbar wäre; verfügbar bleibt nur die schöpferische Steigerung eines leiblich gebundenen Selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VDVC:FGS1","text":"Dualistische Selbstbeschreibung → Setzung einer falschen Trennung von Leib, Seele, Geist und Ich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS2","text":"Ontologische Rückführung → Leib als vollständige Wirklichkeit; Seele als leibliche Benennung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS3","text":"Funktionale Hierarchisierung → große leibliche Vernunft → Selbst → Sinn, Geist und Ich als Werkzeuge.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS4","text":"Steuerungsrelation → Schmerz und Lust des Selbst → Denken als Regulation und Instrument.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS5","text":"Genealogische Erzeugung → schöpferisches Selbst → Wert, Wille, Achten, Verachten, Geist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS6","text":"Pathologische Umkehrung → Unfähigkeit zum Übersichhinausschaffen → Todeswille, Lebensabkehr, Leibverachtung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS7","text":"Strategische Schließung → Leibverachtung als Symptom → Ausschluss der Verächter aus der Bewegung zum Übermenschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VDVC:AF1","text":"Leibverachtung und dualistische Selbstdeutung → Rückführung von Seele, Geist und Ich in Leib und Selbst → funktionale Unterordnung der kleinen Vernunft → Genealogie von Denken und Wert aus leiblicher Selbsttätigkeit → Diagnose der blockierten Selbstüberschreitung → Lebensfeindschaft und Neid als Folgen → Zurückweisung der Leibverächter als Nicht-Brücken zum Übermenschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VDVC:ME1","text":"Der Leib wird von der Stellung eines niedrigen oder bloß materiellen Gegenstands in die Stellung des organisierenden Subjekts versetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ME2","text":"Seele, Geist und Sinn werden nicht länger als getrennte Wesensbereiche, sondern als Benennungen und Funktionen leiblicher Tätigkeit kartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ME3","text":"Das Ich wird vom Ursprung zum Effekt und vom Herrscher zum Beherrschten umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ME4","text":"Die Opposition von Körper und Geist wird durch die Unterscheidung von großer und kleiner Vernunft ersetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ME5","text":"Leibverachtung wird von einer scheinbar selbstständigen Lehre zu einem Symptom der verhinderten schöpferischen Selbstüberschreitung umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ME6","text":"Der Weg zum Übermenschen wird von der Negation des Lebens auf die produktive Steigerung des leiblichen Selbst verschoben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VDVC:ALT1","text":"Surface — Der unmittelbare Streit betrifft die Verachtung des Leibes und die Zurückweisung der Verächter als möglicher Wegbereiter des Übermenschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ALT2","text":"Structural — Die Argumentation errichtet eine Hierarchie von Leib und großer Vernunft über Selbst, Sinn, Geist und Ich und ordnet Denken sowie Wertung in diese Hierarchie ein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ALT3","text":"Metastrategic — Der Text ersetzt Belehrung durch Demontage: Die Gegner sollen nicht umgelernt, sondern als an ihrer eigenen leiblichen Verfassung scheiternd sichtbar werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ALT4","text":"Ontological/Temporal — Realität wird als leiblich organisierte Vielheit mit innerer Herrschaft gefasst; die zeitliche Markierung des Zu-spät-Kommens erklärt Leibverachtung als verspätete Reaktion auf verlorene Schöpferkraft.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VDVC:MRT1","text":"Die Axiome reichen aus, um die Rückführung von Seele, Geist und Ich in den Leib sowie die funktionale Stellung der kleinen Vernunft zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT2","text":"Die Ableitung von Denken, Wertung und Geist aus Schmerz, Lust und schöpferischem Selbst ist strukturell hinreichend bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT3","text":"Unterbestimmt bleibt, ob das Selbst eine metaphorische Funktion des Leibes oder eine eigenständige, wenn auch leibimmanente Instanz bezeichnet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0008","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT4","text":"Eine Spannung entsteht zwischen der vollständigen Identifikation von Selbst und Leib und der Darstellung des Selbst als innerem Herrscher über Ich, Gedanken und Gefühle.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT5","text":"Eine weitere Spannung liegt im Übergang von der Unfähigkeit zum Übersichhinausschaffen zum Todeswillen; dieser Übergang wird behauptet, nicht eigens vermittelt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT6","text":"Die Rekonstruktion ist dort am stärksten, wo sie den Dualismus in eine funktionale Hierarchie und die Leibverachtung in eine Genealogie der verhinderten Schöpfung überführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT7","text":"Die tatsächliche Bewegungsrichtung des Textes bleibt erhalten, sofern der Übermensch als Ziel schöpferischer Selbststeigerung und nicht als bloße Gegenfigur zum Leib verstanden wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261015T194839019865Z_e5c7c54e","language_code":"en","language_name":"English","title":"On the Despisers of the Body","source_sha256":"ad69dd538efd0097149861a157124ede3264307a13bc4b79c545361f45e94599","sha256":"1cb7817caa19d535f1b419806b37b78759e55d230c0dee9092e451427c03dedd","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-15T19:48:39.023412+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VDVC:AS1","text":"The text addresses the despisers of the body, yet refuses them re-education and carries their attitude through to the farewell to their own body and to silence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:AS2","text":"The childish separation of body and soul is replaced by the positing of the body as complete reality and of the soul as a bodily designation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:AS3","text":"The body is determined as great reason, while sense, spirit, and I become subordinate tools and functions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:AS4","text":"Behind thoughts, feelings, and the I, a self active in the body is posited as a directing and creative instance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:AS5","text":"Thinking, valuation, and spirit are genealogically derived from bodily demands and the creative movement of the self.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:AS6","text":"Contempt for the body appears as a symptom of the blocked capacity to create beyond oneself, and not as a path to the Overman.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VDVC:A1","text":"The knowing position posits the human being wholly as body and the soul as a word for a something in the body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A2","text":"The body is a great reason that encompasses multiplicity, unity, conflict, peace, herd, and shepherding function at once.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A3","text":"Sense and spirit are tools and playthings of the great bodily reason; spirit is a small reason.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A4","text":"The I is not the highest instance, but a function produced by the body, or rather by its great reason.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A5","text":"Sense and spirit do not have their end in themselves, but out of vanity claim to be the end of all things.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A6","text":"The self stands behind thoughts and feelings, seeks and listens through sense and spirit, and is in the body, or rather is the body itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A7","text":"The self compares, subdues, conquers, destroys, and rules both the I's relations to the world and the I itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A8","text":"The self's pain and pleasure determine thinking as a means for diminishing pain and repeating pleasure.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A9","text":"The creative self produces esteem, contempt, value, will, pleasure, and woe, and creates spirit as the hand of its will.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A10","text":"The self primarily wills to create beyond itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:A11","text":"When the self can no longer create beyond itself, it turns away from life and wills to perish.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VDVC:NX1","text":"Contempt for the body is not treated as an error that could be corrected through re-education.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX2","text":"The soul is not admitted as a substance independent of the body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX3","text":"Spirit is not recognized as self-sufficient or ultimate reason.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX4","text":"The I is not recognized as the sovereign origin of thoughts, feelings, value, and will.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX5","text":"Sense and spirit are not admitted as the end or final horizon of the human being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX6","text":"Contempt for the body is not recognized as an independent value-decision autonomous from the self.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:NX7","text":"The despisers of the body are not recognized as bridges to the Overman.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VDVC:D1","text":"The unity of the human being arises not through the elimination of multiplicity and conflict, but through their bodily organization in a great reason.","refs":["CH_97E9_VDVC:A1","CH_97E9_VDVC:A2"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D2","text":"Spirit, sense, and I constitute no competing subjects alongside the body, but rather graduated instruments of its self-activity.","refs":["CH_97E9_VDVC:A3","CH_97E9_VDVC:A4","CH_97E9_VDVC:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D3","text":"Thoughts and feelings possess no autonomous finality, because they are deployed and directed by bodily self-organization.","refs":["CH_97E9_VDVC:A5","CH_97E9_VDVC:A6","CH_97E9_VDVC:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D4","text":"Valuations and forms of will are products of the creative self and not pre-existing, body-independent standards.","refs":["CH_97E9_VDVC:A6","CH_97E9_VDVC:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D5","text":"Even in error and in contempt for the body, the despiser remains serviceable to his own self.","refs":["CH_97E9_VDVC:A6","CH_97E9_VDVC:A7","CH_97E9_VDVC:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D6","text":"Contempt for the body arises where the self has lost its capacity to create beyond itself and therefore strikes out against life and earth.","refs":["CH_97E9_VDVC:A10","CH_97E9_VDVC:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D7","text":"The turning away from the body is not a transcendence of the self, but the consequence of a failed or belated self-transcendence.","refs":["CH_97E9_VDVC:A10","CH_97E9_VDVC:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:D8","text":"The path of contempt for the body cannot lead in the direction of the Overman demanded by the text.","refs":["CH_97E9_VDVC:A2","CH_97E9_VDVC:A10","CH_97E9_VDVC:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VDVC:SD1","text":"The supposed opposition of body and spirit is transformed into a functional order in which the body is at once ontological ground, epistemic instance, and organism of action.","refs":["CH_97E9_VDVC:D1","CH_97E9_VDVC:D2","CH_97E9_VDVC:D3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SD2","text":"The assertion of spiritual autonomy appears as the secondary vanity of an instrument that misconceives its own bodily conditionedness.","refs":["CH_97E9_VDVC:D2","CH_97E9_VDVC:D3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SD3","text":"Knowledge, valuation, and pathology are anchored in the same bodily dynamic: that which judges simultaneously produces the conditions of its judging.","refs":["CH_97E9_VDVC:D3","CH_97E9_VDVC:D4","CH_97E9_VDVC:D6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0015","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SD4","text":"The dethronement of the I does not eliminate domination, but shifts it to a center of domination posited more deeply in the body and conceived as self.","refs":["CH_97E9_VDVC:A4","CH_97E9_VDVC:A6","CH_97E9_VDVC:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SD5","text":"Self-overcoming is determined as a creative intensification of life and thereby separated from every merely negating turning away from the body.","refs":["CH_97E9_VDVC:D6","CH_97E9_VDVC:D7","CH_97E9_VDVC:D8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VDVC:DNX1","text":"Excluded is an immaterial subject that stands externally opposed to the body and could judge it from without.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:DNX2","text":"Excluded is the self-transparency of consciousness; the I does not immediately know the determining ground of its thoughts and feelings.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0008","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:DNX3","text":"Excluded is a reason whose validity does not arise from bodily organization, need, and self-activity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:DNX4","text":"Excluded is a standard of value that exists before or outside the creative activity of the self.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:DNX5","text":"Excluded is the possibility of getting beyond oneself through mere negation, renunciation, or flight from the body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:DNX6","text":"Excluded is a separation between bodily constitution, knowledge, valuation, and direction of life.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VDVC:SNX1","text":"Impossible is an external standpoint from which the body could be judged as a mere object of an independent soul or reason.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SNX2","text":"Inadmissible is every transcendence that is supposed to arise not from bodily creation, but from the destruction or rejection of the body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SNX3","text":"Barred is the possibility that contempt for the body opens a positive future; it can appear only as the expression of an already blocked future of the self.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SNX4","text":"The discourse is organized around the absence of successful self-transcendence, which in contempt for the body is replaced by the wish for death, turning away from life, and envy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:SNX5","text":"Unavailable is an Overman attainable through mere detachment from the body; what remains available is only the creative intensification of a bodily bound self.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VDVC:FGS1","text":"Dualistic self-description → positing of a false separation of body, soul, spirit, and I.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS2","text":"Ontological reduction → body as complete reality; soul as bodily designation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS3","text":"Functional hierarchization → great bodily reason → self → sense, spirit, and I as tools.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS4","text":"Relation of control → pain and pleasure of the self → thinking as regulation and instrument.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS5","text":"Genealogical production → creative self → value, will, esteem, contempt, spirit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS6","text":"Pathological reversal → incapacity to create beyond oneself → will to death, turning away from life, contempt for the body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:FGS7","text":"Strategic closure → contempt for the body as symptom → exclusion of the despisers from the movement toward the Overman.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VDVC:AF1","text":"Contempt for the body and dualistic self-interpretation → reduction of soul, spirit, and I to body and self → functional subordination of small reason → genealogy of thinking and value from bodily self-activity → diagnosis of blocked self-transcendence → hostility to life and envy as consequences → rejection of the despisers of the body as non-bridges to the Overman.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VDVC:ME1","text":"The body is moved from the position of a low or merely material object into the position of the organizing subject.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ME2","text":"Soul, spirit, and sense are no longer mapped as separate domains of being, but as designations and functions of bodily activity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ME3","text":"The I is reclassified from origin to effect and from ruler to ruled.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ME4","text":"The opposition of body and spirit is replaced by the distinction between great and small reason.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ME5","text":"Contempt for the body is remapped from an apparently independent doctrine into a symptom of thwarted creative self-transcendence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ME6","text":"The path to the Overman is shifted from the negation of life to the productive intensification of the bodily self.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VDVC:ALT1","text":"Surface — The immediate dispute concerns contempt for the body and the rejection of the despisers as possible pathfinders of the Overman.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ALT2","text":"Structural — The argument establishes a hierarchy of body and great reason over self, sense, spirit, and I, and orders thinking as well as valuation within this hierarchy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ALT3","text":"Metastrategic — The text replaces instruction with dismantling: the opponents are not to be re-educated, but made visible as failing on account of their own bodily constitution.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:ALT4","text":"Ontological/Temporal — Reality is conceived as bodily organized multiplicity with internal domination; the temporal marking of arriving-too-late explains contempt for the body as a belated reaction to lost creative power.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VDVC:MRT1","text":"The axioms suffice to reconstruct the reduction of soul, spirit, and I to the body as well as the functional position of small reason.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT2","text":"The derivation of thinking, valuation, and spirit from pain, pleasure, and creative self is structurally determined with sufficient precision.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT3","text":"It remains underdetermined whether the self denotes a metaphorical function of the body or an autonomous, albeit bodily immanent, instance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0008","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT4","text":"A tension arises between the complete identification of self and body and the presentation of the self as an inner ruler over I, thoughts, and feelings.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT5","text":"A further tension lies in the transition from the incapacity to create beyond oneself to the will to death; this transition is asserted, not specifically mediated.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT6","text":"The reconstruction is strongest where it transforms dualism into a functional hierarchy and contempt for the body into a genealogy of thwarted creation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VDVC:MRT7","text":"The text's actual direction of movement is preserved insofar as the Overman is understood as the goal of creative self-intensification and not as a mere counterfigure to the body.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDVC:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VDVC:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_97E9_VDVC@R001","source_variant_id":"canonical:CH_97E9_VDVC:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 14","title":"On the Despisers of the Body","context":"Chapter 14","original_title":"Von den Verächtern des Leibes","original_context":"Chapter 14"},"original_title":"Von den Verächtern des Leibes","title_language_code":"en"},{"id":"CH_97E9_VDFU","layer":"CH","title":"On the Joys and Passions","order":15,"parents":["RAW_97E9_VDFU"],"revision":"CH_97E9_VDFU@R001","sha256":"6065d2d3f807f406b86d6637d493df5cef54e95d6bd566a4654eba842792050c","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VDFU:AS1","text":"Das zentrale Problem ist, wie eine Tugend die eigene Singularität bewahren kann, ohne durch öffentliche Benennung zur gemeinsamen Norm zu werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS2","text":"Die Benennung der Tugend erzeugt Gemeinsamkeit, Herdenzugehörigkeit und den Verlust ihrer exklusiven Bezogenheit auf das eigene Leben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS3","text":"Die Tugend wird als irdische, leiblich-affektive und nicht universalisierbare Orientierung neu bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS4","text":"Der Text verfährt diagnostisch-genealogisch, indem er die Tugend aus der Umwandlung ehemals verworfener Leidenschaften erklärt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS5","text":"Die Einsetzung eines höchsten Ziels in die Leidenschaften verwandelt diese in Tugenden und verschiebt das Böse von der Leidenschaft auf den Konflikt zwischen Tugenden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS6","text":"Eine einzige Tugend erleichtert die Selbstüberschreitung, während mehrere Tugenden den Menschen in einen inneren Krieg aus Eifersucht und Selbstzerstörung verwickeln.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS7","text":"Die Tugend ist zugleich Medium der Formung und des Untergangs des Menschen, weil der Mensch selbst überwunden werden muss.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VDFU:A1","text":"Eine eigene Tugend ist mit niemandem gemeinsam.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A2","text":"Die öffentliche Benennung einer Tugend macht sie gemeinsam und verwandelt ihren Träger in Volk und Herde.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A3","text":"Die eigene Tugend entzieht sich der Vertraulichkeit fester Namen und kann nur stammelnd ausgesprochen werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A4","text":"Die geliebte Tugend ist irdisch und in leiblich-affektiver Bedürftigkeit verankert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A5","text":"Die Tugend ist kein Gesetz eines Gottes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A6","text":"Die Tugend ist keine Satzung und keine Notdurft der Menschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A7","text":"Die Tugend ist kein Wegweiser zu Über-Erden und Paradiesen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A8","text":"Die Geltung der Tugend beruht nicht auf der Vernunft Aller.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A9","text":"Eine Leidenschaft wird zur Tugend, wenn ihr ein höchstes Ziel an das Herz gelegt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A10","text":"Die Umwandlung der Leidenschaften verwandelt Gifte und Trübsal in Balsam und süße Nahrung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A11","text":"Nach der Umwandlung wächst aus dem Menschen kein Böses mehr außer dem Bösen, das aus dem Kampf seiner Tugenden entsteht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A12","text":"Eine einzige Tugend erleichtert den Übergang über die Brücke.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A13","text":"Mehrere Tugenden machen den Menschen zum Schlachtfeld ihrer eigenen Kämpfe.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A14","text":"Jede Tugend beansprucht das Höchste und die vollständige Verfügung über Geist und Kraft.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0021","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A15","text":"Die Tugenden sind untereinander eifersüchtig, und ihre Eifersucht kann sie zugrunde richten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A16","text":"Der Mensch muss überwunden werden, und die Tugenden sind zugleich Mittel und Ursache dieses Untergangs.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VDFU:NX1","text":"Die eigene Tugend ist keine gemeinsam besitzbare Tugend.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX2","text":"Die eigene Tugend ist keine durch öffentliche Benennung stabilisierbare Norm.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX3","text":"Die eigene Tugend ist keine Ausprägung der Vernunft Aller.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX4","text":"Die eigene Tugend ist kein göttliches Gebot.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX5","text":"Die eigene Tugend ist keine menschliche Satzung und keine soziale Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX6","text":"Die eigene Tugend weist nicht über die Erde auf ein Jenseits.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX7","text":"Leidenschaft ist nicht als solche endgültig böse.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX8","text":"Mehrere Tugenden bilden keine harmonische Einheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX9","text":"Die Tugend garantiert weder Selbsterhaltung noch innere Unversehrtheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX10","text":"Der Mensch ist kein endgültiger Träger der Tugenden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VDFU:D1","text":"Die Bewahrung der Singularität verlangt eine Redeform, die Benennung zurücknimmt und in Stammeln übergeht.","refs":["CH_97E9_VDFU:A1","CH_97E9_VDFU:A2","CH_97E9_VDFU:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D2","text":"Die positive Bestimmung der Tugend entsteht erst durch den Ausschluss göttlicher, menschlicher und transzendenter Begründungen.","refs":["CH_97E9_VDFU:A4","CH_97E9_VDFU:A5","CH_97E9_VDFU:A6","CH_97E9_VDFU:A7","CH_97E9_VDFU:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D3","text":"Die Tugend ist keine ursprüngliche moralische Substanz, sondern das Ergebnis einer gerichteten Umwertung von Leidenschaften.","refs":["CH_97E9_VDFU:A9","CH_97E9_VDFU:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D4","text":"Die moralische Klassifikation einer Leidenschaft hängt von ihrer Einordnung unter ein höchstes Ziel ab und nicht von ihrer früheren Benennung als böse.","refs":["CH_97E9_VDFU:A8","CH_97E9_VDFU:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D5","text":"Das nach der Umwertung verbleibende Böse liegt nicht mehr primär in einzelnen Leidenschaften, sondern in der Konkurrenz der Tugenden.","refs":["CH_97E9_VDFU:A10","CH_97E9_VDFU:A11","CH_97E9_VDFU:A14","CH_97E9_VDFU:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D6","text":"Die Vielheit der Tugenden erzeugt notwendig Krieg, weil jede Tugend dieselbe vollständige geistige und affektive Besetzung beansprucht.","refs":["CH_97E9_VDFU:A13","CH_97E9_VDFU:A14","CH_97E9_VDFU:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D7","text":"Die Empfehlung einer einzigen Tugend ist eine strategische Reduktion innerer Konkurrenz und keine Behauptung harmonischer Vollständigkeit.","refs":["CH_97E9_VDFU:A12","CH_97E9_VDFU:A13","CH_97E9_VDFU:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D8","text":"Die Tugend führt nicht zur Versöhnung des Menschen mit sich selbst, sondern zu einer Form seiner möglichen Überwindung.","refs":["CH_97E9_VDFU:A12","CH_97E9_VDFU:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VDFU:SD1","text":"Das System ersetzt die gemeinsame moralische Norm durch eine singuläre, leiblich-affektive Eigentümlichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SD2","text":"Tugend bezeichnet keine feste Qualität, sondern eine Transformationsfunktion zwischen Leidenschaft, höchstem Ziel und Verhalten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SD3","text":"Das Innere des Menschen wird als konkurrierende Vielheit von Anspruchszentren konstruiert, nicht als ursprünglich einheitliches Subjekt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SD4","text":"Das Böse wird dynamisch als Effekt einer inneren Rang- und Besitzkonkurrenz erzeugt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SD5","text":"Die Einzahl der Tugend fungiert als Durchgangsstrategie innerhalb eines nicht auf Dauer gestellten Subjekts.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SD6","text":"Die Tugend ist strukturell ambivalent: Sie bildet den Menschen, indem sie zugleich seine Überschreitung und seinen Untergang vorbereitet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VDFU:DNX1","text":"Das System setzt die Unwahrheit eines allgemein gültigen Kriteriums der Tugend voraus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX2","text":"Es setzt voraus, dass Leidenschaft und Tugend keine unveränderlichen Gegensätze sind.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX3","text":"Es schließt eine von außen garantierte Rangordnung der Werte aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX4","text":"Es schließt die Versöhnung mehrerer höchster Ansprüche in einer stabilen Einheit aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX5","text":"Es schließt eine moralische Ordnung aus, die unabhängig von leiblicher Bedürftigkeit und individueller Aneignung besteht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX6","text":"Es schließt einen endgültig integrierten und selbsterhaltenden Menschen aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX7","text":"Es schließt eine vollständig transparente begriffliche Mitteilbarkeit des eigenen höchsten Gutes aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VDFU:SNX1","text":"Die Architektur beruht auf der Abwesenheit einer gemeinsam bewohnbaren Sprache des Guten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SNX2","text":"Die Architektur beruht auf der versperrten Möglichkeit, die Tugenden in einer endgültigen Harmonie zusammenzuführen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SNX3","text":"Die Architektur beruht auf der Abwesenheit eines externen Richters, der zwischen konkurrierenden Tugenden entscheidet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0020","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SNX4","text":"Die Architektur behandelt den Menschen nicht als Zielpunkt, sondern als vorläufige Gestalt, die überschritten werden muss.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SNX5","text":"Die Architektur lässt als letzte Form nicht Integration, sondern Übergang, Kampf oder Selbstvernichtung bestehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VDFU:FGS1","text":"Eigene Tugend → öffentliche Benennung → Gemeinsamkeit → Volk und Herde → Verlust der Singularität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS2","text":"Verlust der Singularität → Rücknahme des Namens → stammelnde Rede → Schutz des nicht universalisierbaren Gutes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS3","text":"Leidenschaft → Einsetzung eines höchsten Ziels → Umwertung → Tugend → irdische affektive Orientierung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS4","text":"Umwertung der Leidenschaften → Aufhebung des ursprünglichen Bösen → Verlagerung des Bösen in den Tugendkampf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS5","text":"Mehrere Tugenden → konkurrierender Anspruch auf den ganzen Geist → Eifersucht → Krieg → Selbstzerstörung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS6","text":"Eine Tugend → reduzierte innere Konkurrenz → erleichterter Übergang → dennoch mögliche Überwindung des Menschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS7","text":"Tugend als Formung und Zerstörung → Mensch als Übergangsgestalt → Überschreitung des Menschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VDFU:AF1","text":"Eigene Tugend → Benennung → Gemeinsambesitz → Herdengestalt → Entzug des Namens → stammelnde Rede.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AF2","text":"Als böse bezeichnete Leidenschaften → Einsetzung des höchsten Ziels → Tugenden und Freudenschaften → Balsam und Süße → Restböses als Tugendkonflikt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AF3","text":"Eine Tugend → erleichterter Übergang; mehrere Tugenden → Eifersucht und Krieg → Selbstzerstörung → Überwindung des Menschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VDFU:ME1","text":"Tugend wird von einer öffentlichen oder universalen Norm zu einer singulären affektiven Besitzform umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ME2","text":"Die Opposition zwischen Leidenschaft und Tugend wird durch eine Transformationsbeziehung ersetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ME3","text":"Das Böse wird von der isolierten Leidenschaft auf die Konkurrenz mehrerer Tugenden verschoben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ME4","text":"Die Vielheit der Tugenden wird nicht als Reichtum, sondern als konflikthafte innere Topologie sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ME5","text":"Die Einzahl der Tugend wird als strategische Durchgangsbedingung und nicht als moralische Vollständigkeit klassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ME6","text":"Der Mensch wird aus der Position des Endzwecks in die Position eines zu überwindenden Übergangsträgers verschoben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VDFU:ALT1","text":"Surface — Die unmittelbare Behauptung betrifft die eigene Tugend, ihre Benennung, ihre affektive Herkunft und ihre mögliche Einzahl.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ALT2","text":"Structural — Die begriffliche Mechanik besteht aus Aneignung, Umwertung, Totalitätsanspruch, Rivalität und Selbstzerstörung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ALT3","text":"Metastrategic — Das Argument ersetzt öffentliche Lehrbarkeit durch singuläre Selbstformung und empfiehlt die Reduktion innerer Konkurrenz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ALT4","text":"Ontological/Temporal — Leidenschaften werden zeitlich in Tugenden umgebildet, während der Mensch als vorläufige und zu überschreitende Gestalt erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VDFU:MRT1","text":"Die Axiome reichen aus, um die Bewegung von singularer Tugend über Umwertung und Tugendkonflikt bis zur Überwindung des Menschen zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT2","text":"Unterbestimmt bleibt, wie ein höchstes Ziel bestimmt wird und wodurch seine Vorrangigkeit gegenüber anderen Zielen legitimiert ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"low","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT3","text":"Die Struktur ist intern kohärent, sofern Tugend als affektive Transformation und nicht als feste moralische Eigenschaft verstanden wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT4","text":"Ihre stärkste Verbindung liegt in der Kopplung von Leidenschaftsumwertung, innerer Rivalität und dynamischer Erzeugung des Bösen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT5","text":"Eine ungelöste Spannung besteht darin, dass die Tugend unaussprechlich und nicht gemeinsam sein soll, zugleich aber durch imperative Rede mitgeteilt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0007","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT6","text":"Eine weitere Spannung besteht zwischen der Behauptung einer einzigen Tugend und der Umwandlung sämtlicher Leidenschaften in Tugenden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0014","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT7","text":"Die Spannung zwischen der Liebe zur Tugend und ihrem zerstörerischen Ausgang wird als Übergangslogik behauptet, aber nicht weiter vermittelt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0008","trace_type":"Tension","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0018","trace_type":"Tension","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Tension","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT8","text":"Die Rekonstruktion bewahrt die tatsächliche Argumentbewegung, sofern der Text als Maschine der Umwertung und Selbstüberschreitung und nicht als Lehre allgemeiner Tugend verstanden wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261015T194206850693Z_692a1304","language_code":"en","language_name":"English","title":"Of Joys and Passions","source_sha256":"6065d2d3f807f406b86d6637d493df5cef54e95d6bd566a4654eba842792050c","sha256":"404c4b2c1d93765b76f88a1626c8a457df4cbb65a20b28ce6f168edbd3679e7d","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-15T19:42:06.852313+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VDFU:AS1","text":"The central problem is how a virtue can preserve its own singularity without becoming a common norm through public naming.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS2","text":"The naming of virtue produces commonality, herd membership, and the loss of its exclusive relation to one's own life.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS3","text":"Virtue is newly determined as an earthly, bodily-affective, and non-universalizable orientation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS4","text":"The text proceeds diagnostically-genealogically by explaining virtue from the transformation of formerly rejected passions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS5","text":"The installation of a highest goal in the passions transforms them into virtues and shifts evil from passion to the conflict between virtues.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS6","text":"A single virtue facilitates self-overcoming, whereas several virtues entangle the human being in an inner war of jealousy and self-destruction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AS7","text":"Virtue is at once the medium of the formation and the downfall of the human being, because the human being itself must be overcome.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VDFU:A1","text":"One's own virtue is shared with no one.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A2","text":"The public naming of a virtue makes it common and transforms its bearer into people and herd.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A3","text":"One's own virtue eludes the familiarity of fixed names and can be uttered only stammeringly.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A4","text":"The beloved virtue is earthly and rooted in bodily-affective needfulness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A5","text":"Virtue is not the law of a god.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A6","text":"Virtue is neither a statute nor a necessity of human beings.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A7","text":"Virtue is not a signpost to over-earths and paradises.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A8","text":"The validity of virtue does not rest upon the reason of all.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A9","text":"A passion becomes a virtue when a highest goal is laid upon its heart.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A10","text":"The transformation of passions transforms poisons and gloom into balm and sweet nourishment.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A11","text":"After the transformation, no evil grows out of the human being except the evil that arises from the struggle of its virtues.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A12","text":"A single virtue facilitates the passage over the bridge.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A13","text":"Several virtues make the human being the battlefield of their own struggles.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A14","text":"Each virtue lays claim to the highest and to complete disposal over spirit and strength.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0021","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A15","text":"The virtues are jealous of one another, and their jealousy can bring them to ruin.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:A16","text":"The human being must be overcome, and the virtues are at once means and cause of this downfall.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VDFU:NX1","text":"One's own virtue is not a virtue that can be jointly possessed.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX2","text":"One's own virtue is not a norm that can be stabilized through public naming.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX3","text":"One's own virtue is not a manifestation of the reason of all.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX4","text":"One's own virtue is not a divine commandment.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX5","text":"One's own virtue is neither a human statute nor a social necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX6","text":"One's own virtue does not point beyond the earth toward an afterlife.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX7","text":"Passion is not, as such, definitively evil.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX8","text":"Several virtues do not form a harmonious unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX9","text":"Virtue guarantees neither self-preservation nor inner intactness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:NX10","text":"The human being is not an ultimate bearer of the virtues.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VDFU:D1","text":"The preservation of singularity demands a form of speech that withdraws naming and passes into stammering.","refs":["CH_97E9_VDFU:A1","CH_97E9_VDFU:A2","CH_97E9_VDFU:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D2","text":"The positive determination of virtue arises only through the exclusion of divine, human, and transcendent grounds.","refs":["CH_97E9_VDFU:A4","CH_97E9_VDFU:A5","CH_97E9_VDFU:A6","CH_97E9_VDFU:A7","CH_97E9_VDFU:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D3","text":"Virtue is not an original moral substance, but the result of a directed revaluation of passions.","refs":["CH_97E9_VDFU:A9","CH_97E9_VDFU:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D4","text":"The moral classification of a passion depends on its subsumption under a highest goal and not on its earlier designation as evil.","refs":["CH_97E9_VDFU:A8","CH_97E9_VDFU:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D5","text":"The evil remaining after revaluation lies no longer primarily in individual passions, but in the rivalry of virtues.","refs":["CH_97E9_VDFU:A10","CH_97E9_VDFU:A11","CH_97E9_VDFU:A14","CH_97E9_VDFU:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D6","text":"The multiplicity of virtues necessarily produces war, because each virtue lays claim to the same complete occupation of spirit and affect.","refs":["CH_97E9_VDFU:A13","CH_97E9_VDFU:A14","CH_97E9_VDFU:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D7","text":"The recommendation of a single virtue is a strategic reduction of inner rivalry and not an assertion of harmonious completeness.","refs":["CH_97E9_VDFU:A12","CH_97E9_VDFU:A13","CH_97E9_VDFU:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:D8","text":"Virtue leads not to the reconciliation of the human being with itself, but to a form of its possible overcoming.","refs":["CH_97E9_VDFU:A12","CH_97E9_VDFU:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VDFU:SD1","text":"The system replaces the common moral norm with a singular bodily-affective peculiarity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SD2","text":"Virtue designates not a fixed quality, but a transformational function between passion, highest goal, and conduct.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SD3","text":"The interior of the human being is constructed as a competing multiplicity of centers of claim, not as an originally unified subject.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SD4","text":"Evil is dynamically generated as an effect of an inner competition of rank and possession.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SD5","text":"The singularity of virtue functions as a strategy of passage within a subject not posited as enduring.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SD6","text":"Virtue is structurally ambivalent: it forms the human being by at once preparing its overcoming and its downfall.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VDFU:DNX1","text":"The system presupposes the untruth of a universally valid criterion of virtue.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX2","text":"It presupposes that passion and virtue are not immutable opposites.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX3","text":"It excludes a hierarchy of values guaranteed from outside.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX4","text":"It excludes the reconciliation of several highest claims in a stable unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX5","text":"It excludes a moral order existing independently of bodily needfulness and individual appropriation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX6","text":"It excludes an ultimately integrated and self-preserving human being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:DNX7","text":"It excludes a fully transparent conceptual communicability of one's own highest good.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VDFU:SNX1","text":"The architecture rests on the absence of a language of the good that can be jointly inhabited.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SNX2","text":"The architecture rests on the blocked possibility of bringing the virtues together in a final harmony.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SNX3","text":"The architecture rests on the absence of an external judge who decides between competing virtues.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0020","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SNX4","text":"The architecture treats the human being not as an end point, but as a provisional form that must be overcome.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:SNX5","text":"The architecture leaves standing, as its final form, not integration but passage, struggle, or self-annihilation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VDFU:FGS1","text":"One's own virtue → public naming → commonality → people and herd → loss of singularity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS2","text":"Loss of singularity → withdrawal of the name → stammering speech → protection of the non-universalizable good.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS3","text":"Passion → installation of a highest goal → revaluation → virtue → earthly affective orientation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS4","text":"Revaluation of passions → abolition of original evil → displacement of evil into the struggle of virtues.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS5","text":"Several virtues → competing claim upon the entire spirit → jealousy → war → self-destruction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS6","text":"One virtue → reduced inner rivalry → facilitated passage → nevertheless possible overcoming of the human being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:FGS7","text":"Virtue as formation and destruction → human being as transitional form → overcoming of the human being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VDFU:AF1","text":"One's own virtue → naming → common possession → herd-form → withdrawal of the name → stammering speech.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AF2","text":"Passions designated as evil → installation of the highest goal → virtues and joy-passions → balm and sweetness → residual evil as conflict of virtues.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:AF3","text":"One virtue → facilitated passage; several virtues → jealousy and war → self-destruction → overcoming of the human being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VDFU:ME1","text":"Virtue is remapped from a public or universal norm to a singular affective form of possession.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ME2","text":"The opposition between passion and virtue is replaced by a transformational relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ME3","text":"Evil is shifted from isolated passion to the rivalry of several virtues.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ME4","text":"The multiplicity of virtues becomes visible not as wealth, but as a conflictual inner topology.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ME5","text":"The singularity of virtue is classified as a strategic condition of passage and not as moral completeness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ME6","text":"The human being is shifted from the position of final end to the position of a transitional bearer to be overcome.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VDFU:ALT1","text":"Surface — The immediate assertion concerns one's own virtue, its naming, its affective origin, and its possible singularity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ALT2","text":"Structural — The conceptual mechanics consist of appropriation, revaluation, claim to totality, rivalry, and self-destruction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ALT3","text":"Metastrategic — The argument replaces public teachability with singular self-formation and recommends the reduction of inner rivalry.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:ALT4","text":"Ontological/Temporal — Passions are temporally transformed into virtues, while the human being appears as a provisional form to be overcome.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VDFU:MRT1","text":"The axioms suffice to reconstruct the movement from singular virtue through revaluation and conflict of virtues to the overcoming of the human being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT2","text":"What remains underdetermined is how a highest goal is determined and what legitimates its priority over other goals.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"low","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT3","text":"The structure is internally coherent provided that virtue is understood as affective transformation and not as a fixed moral property.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT4","text":"Its strongest connection lies in the coupling of the revaluation of passions, inner rivalry, and the dynamic production of evil.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT5","text":"An unresolved tension consists in the fact that virtue is supposed to be unsayable and not shared, yet is communicated through imperative speech.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0007","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT6","text":"A further tension consists between the assertion of a single virtue and the transformation of all passions into virtues.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0014","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT7","text":"The tension between love of virtue and its destructive outcome is asserted as a logic of passage, but is not further mediated.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0008","trace_type":"Tension","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0018","trace_type":"Tension","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Tension","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDFU:MRT8","text":"The reconstruction preserves the actual movement of the argument, provided that the text is understood as a machine of revaluation and self-overcoming rather than as a doctrine of general virtue.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDFU:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDFU:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_97E9_VDFU@R001","source_variant_id":"canonical:CH_97E9_VDFU:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 15","title":"On the Joys and Passions","context":"Chapter 15","original_title":"Von den Freuden- und Leidenschaften","original_context":"Chapter 15"},"original_title":"Von den Freuden- und Leidenschaften","title_language_code":"en"},{"id":"CH_97E9_VBV0","layer":"CH","title":"On the Pale Criminal","order":16,"parents":["RAW_97E9_VBV0"],"revision":"CH_97E9_VBV0@R001","sha256":"ae0fcedadf9e7d5abbb1e0c5e95e830fd46abd6b62b700c6306c9a7d930a7414","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VBV0:AS1","text":"Die Rede problematisiert die Unvereinbarkeit von Tat, innerem Motiv, nachträglichem Selbstbild und äußerem Urteil.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS2","text":"Der Verbrecher wird nicht primär durch seine Tat, sondern durch Selbstverachtung und misslingende Selbstdeutung bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS3","text":"Der Selbstvollzug des Urteils wird gegenüber dem fremden Urteil als höherer Augenblick gesetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS4","text":"Die richterliche Tötung wird von Vergeltung auf Mitleid, Lebensrechtfertigung und eine höhere Zukunftsorientierung umgestellt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS5","text":"Die Rede zerlegt die Einheit von Gedanke, Tat und Bild der Tat und macht aus dieser Spaltung die Struktur des Wahnsinns.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS6","text":"Die vermeintliche Tatmotivation wird als nachträgliche Rationalisierung eines vorgängigen Blut- und Messerbegehrens rekonstruiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS7","text":"Aus der psychischen Vielheit des Menschen folgt eine Umwertung von Gut und Böse sowie eine Absage an lebensverlängernde Tugend als letzte Norm.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VBV0:A1","text":"Die Tötung durch Richter und Opferer setzt das Nicken des bleichen Verbrechers voraus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A2","text":"Das Ich des Menschen ist etwas, das überwunden werden soll, und erzeugt als nicht überwundenes Ich große Verachtung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A3","text":"Die Selbstverurteilung bildet den höchsten Augenblick des Verbrechers und darf nicht in eine Rückkehr zum Niederen umschlagen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A4","text":"Für denjenigen, der an sich selbst leidet, gibt es keine Erlösung außer dem schnellen Tod.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A5","text":"Tötung soll als Mitleid und nicht als Rache vollzogen werden; zugleich muss der Tötende sein eigenes Weiterleben rechtfertigen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A6","text":"Die Versöhnung mit dem Getöteten genügt nicht; erst die Liebe zum Übermenschen rechtfertigt das Noch-Leben der Richter.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A7","text":"Der Verbrecher soll als Feind, Kranker oder Tor bezeichnet werden, nicht als Bösewicht, Schuft oder Sünder.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A8","text":"Gedanke, Tat und Bild der Tat sind voneinander verschieden; zwischen ihnen besteht keine durchgehende Vermittlung des Grundes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A9","text":"Das Bild der vollbrachten Tat kann den Täter überwältigen, sodass sich eine Ausnahme in seinem Selbstbild zum Wesen verkehrt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A10","text":"Ein Wahnsinn kann der Tat vorausgehen und den Richtern verborgen bleiben, weil sie nicht tief genug in die Seele eindringen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A11","text":"Das ursprüngliche Begehren des Verbrechers richtet sich auf Blut und das Glück des Messers, nicht auf den Raub.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A12","text":"Die arme Vernunft versteht dieses Begehren nicht und versieht es nachträglich mit den Motiven Raub oder Rache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A13","text":"Der Mensch ist ein Haufen von Krankheiten und ein Knäuel widerstreitender Triebe, die sich nach außen wenden und dort Beute suchen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A14","text":"Gut und Böse verändern sich mit den geschichtlichen Bedingungen und besitzen keinen unveränderlichen Inhalt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A15","text":"Die gegenwärtig Kranken wollen mit dem, was ihnen weh tut, anderen weh tun; frühere Zeiten bewerteten Zweifel und Selbstwillen als böse.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A16","text":"Die gegenwärtige Tugend dient vielfach dem langen Leben und einem erbärmlichen Behagen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0026","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A17","text":"Eine höhere Tugend müsste als zerstörerischer Wahnsinn von Wahrheit, Treue oder Gerechtigkeit auftreten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A18","text":"Die Rede positioniert sich als Geländer am Strom, nicht als Krücke für diejenigen, die sich an ihr festhalten wollen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VBV0:NX1","text":"Tötung ohne das Nicken des Verbrechers wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX2","text":"Vergeltung als legitime Grundlage des Richters wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX3","text":"Die moralische Bezeichnung des Täters als Bösewicht, Schuft oder Sünder wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX4","text":"Die Gleichsetzung von Gedanke, Tat und Bild der Tat wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX5","text":"Die Reduktion des Mordmotivs auf Raub oder Rache wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX6","text":"Die Annahme, die einzelne Tat bilde unmittelbar das dauerhafte Wesen des Täters, wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX7","text":"Eine zeitlose Definition von Gut und Böse wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX8","text":"Die gegenwärtige Tugend des langen Lebens und des Behagens wird als letzter Wert ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX9","text":"Die bloße Versöhnung des Richters mit dem Getöteten wird als ausreichende Rechtfertigung ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX10","text":"Die Rede beansprucht nicht, als unterstützende Krücke für fremde Selbstrechtfertigung zu dienen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VBV0:D1","text":"Der selbstgerichtete Verbrecher wird vom Objekt fremder Bestrafung zum Träger eines eigenen Todesurteils umklassifiziert.","refs":["CH_97E9_VBV0:A1","CH_97E9_VBV0:A2","CH_97E9_VBV0:A3","CH_97E9_VBV0:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D2","text":"Die Hinrichtung wird als Mitleid interpretiert, dessen eigentliche Funktion in der Rechtfertigung des Weiterlebens der Richter liegt.","refs":["CH_97E9_VBV0:A5","CH_97E9_VBV0:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D3","text":"Das richterliche Urteil muss zwischen psychischer Krankheit, Feindschaft und moralischer Schuld unterscheiden, ohne den Täter in absolute Bosheit zu verwandeln.","refs":["CH_97E9_VBV0:A7","CH_97E9_VBV0:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D4","text":"Die nachträgliche Darstellung der Tat kann eine einzelne Ausnahme zur vermeintlichen Gesamtidentität des Täters erweitern.","refs":["CH_97E9_VBV0:A8","CH_97E9_VBV0:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D5","text":"Die Tat entsteht aus einer Differenz zwischen vorgängigem Begehren und nachträglicher rationaler Selbstbeschreibung.","refs":["CH_97E9_VBV0:A10","CH_97E9_VBV0:A11","CH_97E9_VBV0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D6","text":"Schuld erscheint als nachträgliche Versteinerung einer bereits gespaltenen inneren Bewegung.","refs":["CH_97E9_VBV0:A8","CH_97E9_VBV0:A9","CH_97E9_VBV0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D7","text":"Der einzelne Mensch kann nicht als einheitlicher Ursprung seiner Handlung behandelt werden, sondern als konflikthafte Vielheit von Krankheiten und Trieben.","refs":["CH_97E9_VBV0:A12","CH_97E9_VBV0:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D8","text":"Die Kritik der gegenwärtigen Guten richtet sich nicht gegen Tugend überhaupt, sondern gegen eine Tugend, deren Zweck in bloßer Selbsterhaltung liegt.","refs":["CH_97E9_VBV0:A14","CH_97E9_VBV0:A16","CH_97E9_VBV0:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VBV0:SD1","text":"Das Strafurteil wird von einer moralischen Vergeltungsinstanz zu einer psychologischen und zukunftsbezogenen Auswahloperation umgebaut.","refs":["CH_97E9_VBV0:A5","CH_97E9_VBV0:A6","CH_97E9_VBV0:A7","CH_97E9_VBV0:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SD2","text":"Die eigentliche Ursache der Tat liegt nicht in einem einzelnen Motiv, sondern in der Fehlkopplung von Trieb, Vernunft, Handlung, Bild und Schuld.","refs":["CH_97E9_VBV0:A8","CH_97E9_VBV0:A9","CH_97E9_VBV0:A10","CH_97E9_VBV0:A11","CH_97E9_VBV0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SD3","text":"Der Mensch wird als instabile Übergangsform gedacht, deren innere Vielheit eine höhere Form des Menschen als normativen Horizont eröffnet.","refs":["CH_97E9_VBV0:A2","CH_97E9_VBV0:A6","CH_97E9_VBV0:A13","CH_97E9_VBV0:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SD4","text":"Die Aufhebung moralischer Etiketten beseitigt Wertung nicht, sondern verschiebt sie von Schuldbegriffen auf Rangordnung, Selbstüberwindung und Zukunftsfähigkeit.","refs":["CH_97E9_VBV0:A2","CH_97E9_VBV0:A6","CH_97E9_VBV0:A7","CH_97E9_VBV0:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SD5","text":"Die Rechtfertigung des Lebens wird paradoxerweise durch eine Tötung organisiert, die zugleich als einzige Erlösung des Selbstleidenden erscheint.","refs":["CH_97E9_VBV0:A4","CH_97E9_VBV0:A5","CH_97E9_VBV0:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SD6","text":"Die historische Relativierung von Gut und Böse führt nicht zum Wertneutralismus, sondern zur Forderung nach einer zerstörerischen höheren Wertordnung.","refs":["CH_97E9_VBV0:A14","CH_97E9_VBV0:A16","CH_97E9_VBV0:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VBV0:DNX1","text":"Ein geschlossenes, einheitliches und sich selbst transparentes Subjekt wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX2","text":"Eine unmittelbare Identität von bewusstem Motiv und tatsächlichem Begehren wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0021","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX3","text":"Eine neutrale Vernunft, die den Ursprung der Tat vollständig erklären könnte, wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX4","text":"Eine universale und ahistorische Moralordnung wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX5","text":"Eine Strafordnung, deren Sinn in Vergeltung statt in Mitleid und höherer Rechtfertigung liegt, wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX6","text":"Eine Lebensbejahung, die sich mit Selbsterhaltung und Behagen erschöpft, wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX7","text":"Eine stabile Grenze zwischen Krankheit, Verbrechen und moralischer Schuld wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VBV0:SNX1","text":"Eine restorative Erlösung durch bloße Versöhnung, Reintegration oder Fortsetzung des bisherigen Lebens bleibt unzulässig.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SNX2","text":"Ein selbstgenügsames Weiterleben ohne Bezug auf Selbstüberwindung oder eine höhere Menschenform wird als nicht rechtfertigungsfähig behandelt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0006","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SNX3","text":"Eine Welt, in der Handlung, Motiv, Selbstbild und Urteil bruchlos zusammenfallen, ist strukturell versperrt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SNX4","text":"Eine wertfreie Auflösung der moralischen Ordnung ist nicht verfügbar; an die Stelle des alten Guten muss eine höhere, potenziell zerstörerische Wertung treten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SNX5","text":"Ein unvermitteltes menschliches Innenleben ohne Triebspaltung, nachträgliche Rationalisierung und Schuldversteinerung wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VBV0:FGS1","text":"Selbstverachtung → Selbstgericht → Erhabenheit des Selbsturteils → Tod als mögliche Erlösung.","refs":["CH_97E9_VBV0:A2","CH_97E9_VBV0:A3","CH_97E9_VBV0:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS2","text":"Zustimmung des Verbrechers → Tötung → Ausschluss der Rache → Mitleid → Rechtfertigung des Lebens der Richter.","refs":["CH_97E9_VBV0:A1","CH_97E9_VBV0:A5","CH_97E9_VBV0:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS3","text":"Differenz von Gedanke, Tat und Bild → nachträgliche Bildmacht → Verwandlung der Ausnahme in Wesen → Wahnsinn nach der Tat.","refs":["CH_97E9_VBV0:A8","CH_97E9_VBV0:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS4","text":"Vorgängiger Bluttrieb → unzureichende Vernunftdeutung → sekundäre Motive wie Raub oder Rache → Tat → Schuld als Blei.","refs":["CH_97E9_VBV0:A10","CH_97E9_VBV0:A11","CH_97E9_VBV0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS5","text":"Psychische Vielheit → äußere Beutesuche → Krankheit als Handlungsmechanismus → Relativierung des moralischen Täters.","refs":["CH_97E9_VBV0:A13","CH_97E9_VBV0:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS6","text":"Historische Veränderlichkeit von Gut und Böse → Kritik der gegenwärtigen Tugend → Forderung nach zerstörerischer Wahrheit, Treue oder Gerechtigkeit.","refs":["CH_97E9_VBV0:A14","CH_97E9_VBV0:A16","CH_97E9_VBV0:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS7","text":"Höhere Wertforderung → Ablehnung der Krückenfunktion → Positionierung der Rede als Geländer statt als Ersatzstütze.","refs":["CH_97E9_VBV0:A17","CH_97E9_VBV0:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0027","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VBV0:AF1","text":"Richterliche Tötung und moralische Etikettierung → Selbstnicken und Selbsturteil → Umstellung von Rache auf Mitleid → Rechtfertigung des Weiterlebens durch den Übermenschen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AF2","text":"Tat und Urteil → Spaltung von Motiv, Handlung und Tatbild → nachträglicher Wahnsinn und Schuld → Mensch als triebhafte Vielheit → historische Umwertung von Gut und Böse → Zurückweisung des bloßen Behagens.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VBV0:ME1","text":"Der Verbrecher wird von der Kategorie des bösen Täters in die Kategorien Krankheit, Feindschaft, Torheit und innere Vielheit umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ME2","text":"Die Tat wird nicht mehr als isolierte Handlung, sondern als zeitlich gestufte Konstellation von Vortrieb, Vollzug, Bild und Nachwirkung sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ME3","text":"Das Gegensatzpaar Schuldlosigkeit-Schuld wird durch die Unterscheidung von Trieb, Vernunftdeutung und nachträglicher Selbstfixierung destabilisiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ME4","text":"Das Gegensatzpaar Gut-Böse wird aus einer zeitlosen Moralordnung in eine historische und physiologische Wertordnung überführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ME5","text":"Gerechtigkeit wird von Vergeltung auf Mitleid, Selbstüberwindung und die Rechtfertigung des Lebens der Urteilenden umgezeichnet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ME6","text":"Tugend wird nicht mehr nach ihrer moralischen Benennung, sondern nach ihrer Funktion für Selbsterhaltung oder Selbstzerstörung klassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VBV0:ALT1","text":"**Surface:** Ein bleicher Verbrecher, ein roter Richter, die Tötung und die sprachliche Bezeichnung des Täters bilden die unmittelbare Handlungsebene.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ALT2","text":"**Structural:** Die Rede konstruiert ein System aus Trieben, Vernunft, Tatbild, Schuld, Krankheit und historischer Normbildung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ALT3","text":"**Metastrategic:** Richterliches Urteilen, Mitleid, Tugend und Weiterleben werden so neu gerahmt, dass jede Bewertung auf eine höhere Form des Menschen ausgerichtet werden muss.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0027","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ALT4","text":"**Ontological/Temporal:** Das Subjekt erscheint als konflikthafte Vielheit; Kausalität wird zwischen Vorher, Tat und Nachbild gebrochen, während Gut und Böse als geschichtlich wandelbare Zeitordnungen auftreten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VBV0:MRT1","text":"Die Axiome reichen aus, um die Bewegung von Selbstverachtung und Selbsturteil über die Neubestimmung der Tötung bis zur Kritik der gegenwärtigen Tugend zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:MRT2","text":"Unterbestimmt bleiben die genaue Bedeutung des Nickens, der Status des Übermenschen und das Kriterium, nach dem Mitleid von Rache unterschieden wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VBV0:MRT3","text":"Die Struktur ist intern kohärent, sofern psychische Vielheit, historische Wertung und Selbstüberwindung als gemeinsame Grundlage akzeptiert werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VBV0:MRT4","text":"Ihre stärkste Verbindung liegt in der Trennung von ursprünglichem Begehren, rationaler Motivierung und nachträglichem Tatbild.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:MRT5","text":"Ihre schwächste Stelle liegt in der gleichzeitigen Verweigerung einer durchgehenden Kausalität und der starken psychologischen Erklärung des Tatgeschehens.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0013","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:MRT6","text":"Eine weitere Spannung entsteht dadurch, dass moralische Etiketten verworfen, hierarchische Wertungen jedoch beibehalten werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:MRT7","text":"Die Rekonstruktion bewahrt die tatsächliche Argumentbewegung, sofern der paradoxe Zusammenhang von Tötung, Lebensrechtfertigung und höherer Wertordnung nicht geglättet wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261015T193911227050Z_d17f265d","language_code":"en","language_name":"English","title":"On the Pale Criminal","source_sha256":"ae0fcedadf9e7d5abbb1e0c5e95e830fd46abd6b62b700c6306c9a7d930a7414","sha256":"8c293ac44ba29a59545c212d191a7011dfb3713091b315e0b28133b4118ba65d","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-15T19:39:11.229184+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VBV0:AS1","text":"The discourse problematizes the incompatibility of deed, inner motive, retrospective self-image, and external judgment.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS2","text":"The criminal is determined not primarily by his deed, but by self-contempt and failed self-interpretation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS3","text":"The self-enactment of judgment is posited as a higher moment than the judgment of others.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS4","text":"Judicial killing is shifted away from retribution toward compassion, justification of life, and a higher orientation toward the future.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS5","text":"The discourse disassembles the unity of thought, deed, and image of the deed, and makes the structure of madness out of this division.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS6","text":"The supposed motivation for the deed is reconstructed as a retrospective rationalization of an antecedent desire for blood and the knife.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AS7","text":"From the psychic multiplicity of the human being follows a revaluation of good and evil, as well as a rejection of life-prolonging virtue as the final norm.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VBV0:A1","text":"Killing by judges and sacrificers presupposes the nod of the pale criminal.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A2","text":"The human I is something that ought to be overcome and, as an I not overcome, produces great contempt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A3","text":"Self-condemnation constitutes the criminal's highest moment and must not turn into a return to the lower.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A4","text":"For one who suffers from himself, there is no redemption except swift death.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A5","text":"Killing is to be carried out as compassion and not as revenge; at the same time, the killer must justify his own continued life.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A6","text":"Reconciliation with the killed person does not suffice; only love of the Übermensch justifies the judges' still being alive.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A7","text":"The criminal is to be called an enemy, sick person, or fool, not a villain, scoundrel, or sinner.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A8","text":"Thought, deed, and image of the deed differ from one another; between them there is no continuous mediation of the ground.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A9","text":"The image of the completed deed can overwhelm the perpetrator, such that an exception in his self-image is transformed into his essence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A10","text":"A madness may precede the deed and remain concealed from the judges because they do not penetrate deeply enough into the soul.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A11","text":"The criminal's original desire is directed toward blood and the happiness of the knife, not toward robbery.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A12","text":"Poor reason does not understand this desire and subsequently furnishes it with the motives of robbery or revenge.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A13","text":"The human being is a heap of diseases and a tangle of conflicting drives that turn outward and seek prey there.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A14","text":"Good and evil change with historical conditions and possess no unchanging content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A15","text":"Those presently sick wish, with what hurts them, to hurt others; earlier ages evaluated doubt and self-will as evil.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A16","text":"Present-day virtue often serves long life and miserable comfort.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0026","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A17","text":"A higher virtue would have to appear as destructive madness of truth, fidelity, or justice.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:A18","text":"The discourse positions itself as a railing by the stream, not as a crutch for those who wish to hold onto it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VBV0:NX1","text":"Killing without the criminal's nod is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX2","text":"Retribution as the judge's legitimate basis is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX3","text":"The moral designation of the perpetrator as villain, scoundrel, or sinner is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX4","text":"The equation of thought, deed, and image of the deed is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX5","text":"The reduction of the motive for murder to robbery or revenge is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX6","text":"The assumption that the individual deed directly constitutes the perpetrator's enduring essence is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX7","text":"A timeless definition of good and evil is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX8","text":"The present-day virtue of long life and comfort is excluded as the final value.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX9","text":"The judge's mere reconciliation with the killed person is excluded as sufficient justification.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:NX10","text":"The discourse does not claim to serve as a supportive crutch for the self-justification of others.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VBV0:D1","text":"The self-judging criminal is reclassified from an object of others' punishment into the bearer of his own death sentence.","refs":["CH_97E9_VBV0:A1","CH_97E9_VBV0:A2","CH_97E9_VBV0:A3","CH_97E9_VBV0:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D2","text":"Execution is interpreted as compassion, whose proper function lies in justifying the continued life of the judges.","refs":["CH_97E9_VBV0:A5","CH_97E9_VBV0:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D3","text":"Judicial judgment must distinguish among psychic illness, enmity, and moral guilt without transforming the perpetrator into absolute evil.","refs":["CH_97E9_VBV0:A7","CH_97E9_VBV0:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D4","text":"The retrospective representation of the deed can extend a single exception into the perpetrator's supposed overall identity.","refs":["CH_97E9_VBV0:A8","CH_97E9_VBV0:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D5","text":"The deed arises from a difference between antecedent desire and retrospective rational self-description.","refs":["CH_97E9_VBV0:A10","CH_97E9_VBV0:A11","CH_97E9_VBV0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D6","text":"Guilt appears as the retrospective petrification of an already divided inner movement.","refs":["CH_97E9_VBV0:A8","CH_97E9_VBV0:A9","CH_97E9_VBV0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D7","text":"The individual human being cannot be treated as the unified origin of his action, but rather as a conflictual multiplicity of diseases and drives.","refs":["CH_97E9_VBV0:A12","CH_97E9_VBV0:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:D8","text":"The critique of present-day good people is directed not against virtue as such, but against a virtue whose purpose lies in mere self-preservation.","refs":["CH_97E9_VBV0:A14","CH_97E9_VBV0:A16","CH_97E9_VBV0:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VBV0:SD1","text":"The penal judgment is rebuilt from an instance of moral retribution into a psychological and future-oriented operation of selection.","refs":["CH_97E9_VBV0:A5","CH_97E9_VBV0:A6","CH_97E9_VBV0:A7","CH_97E9_VBV0:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SD2","text":"The actual cause of the deed lies not in an individual motive, but in the faulty coupling of drive, reason, action, image, and guilt.","refs":["CH_97E9_VBV0:A8","CH_97E9_VBV0:A9","CH_97E9_VBV0:A10","CH_97E9_VBV0:A11","CH_97E9_VBV0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SD3","text":"The human being is conceived as an unstable transitional form whose inner multiplicity opens up a higher form of the human being as a normative horizon.","refs":["CH_97E9_VBV0:A2","CH_97E9_VBV0:A6","CH_97E9_VBV0:A13","CH_97E9_VBV0:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SD4","text":"The abolition of moral labels does not eliminate evaluation, but shifts it from concepts of guilt to rank order, self-overcoming, and capacity for the future.","refs":["CH_97E9_VBV0:A2","CH_97E9_VBV0:A6","CH_97E9_VBV0:A7","CH_97E9_VBV0:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SD5","text":"The justification of life is paradoxically organized through a killing that at once appears as the sole redemption of the one suffering from himself.","refs":["CH_97E9_VBV0:A4","CH_97E9_VBV0:A5","CH_97E9_VBV0:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SD6","text":"The historical relativization of good and evil leads not to value-neutralism, but to the demand for a destructive higher order of values.","refs":["CH_97E9_VBV0:A14","CH_97E9_VBV0:A16","CH_97E9_VBV0:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VBV0:DNX1","text":"A closed, unified, and self-transparent subject is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX2","text":"An immediate identity of conscious motive and actual desire is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0021","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX3","text":"A neutral reason capable of completely explaining the origin of the deed is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX4","text":"A universal and ahistorical moral order is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX5","text":"A penal order whose meaning lies in retribution rather than compassion and higher justification is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX6","text":"An affirmation of life that exhausts itself in self-preservation and comfort is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:DNX7","text":"A stable boundary between illness, crime, and moral guilt is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VBV0:SNX1","text":"A restorative redemption through mere reconciliation, reintegration, or continuation of previous life remains impermissible.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SNX2","text":"A self-sufficient continued life without reference to self-overcoming or a higher form of the human being is treated as incapable of justification.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0006","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SNX3","text":"A world in which action, motive, self-image, and judgment coincide without rupture is structurally barred.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SNX4","text":"A value-free dissolution of the moral order is unavailable; a higher, potentially destructive evaluation must take the place of the old good.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:SNX5","text":"An unmediated human inner life without division of drives, retrospective rationalization, and petrification of guilt is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VBV0:FGS1","text":"Self-contempt → self-judgment → sublimity of self-judgment → death as possible redemption.","refs":["CH_97E9_VBV0:A2","CH_97E9_VBV0:A3","CH_97E9_VBV0:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS2","text":"Criminal's consent → killing → exclusion of revenge → compassion → justification of the life of the judges.","refs":["CH_97E9_VBV0:A1","CH_97E9_VBV0:A5","CH_97E9_VBV0:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS3","text":"Difference of thought, deed, and image → retrospective power of the image → transformation of exception into essence → madness after the deed.","refs":["CH_97E9_VBV0:A8","CH_97E9_VBV0:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS4","text":"Antecedent drive for blood → inadequate interpretation by reason → secondary motives such as robbery or revenge → deed → guilt as lead.","refs":["CH_97E9_VBV0:A10","CH_97E9_VBV0:A11","CH_97E9_VBV0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS5","text":"Psychic multiplicity → external search for prey → illness as mechanism of action → relativization of the moral perpetrator.","refs":["CH_97E9_VBV0:A13","CH_97E9_VBV0:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS6","text":"Historical changeability of good and evil → critique of present-day virtue → demand for destructive truth, fidelity, or justice.","refs":["CH_97E9_VBV0:A14","CH_97E9_VBV0:A16","CH_97E9_VBV0:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:FGS7","text":"Higher demand for value → rejection of the crutch function → positioning of the discourse as railing rather than substitute support.","refs":["CH_97E9_VBV0:A17","CH_97E9_VBV0:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VBV0:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0027","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_VBV0:AF1","text":"Judicial killing and moral labeling → self-nod and self-judgment → shift from revenge to compassion → justification of continued life through the Übermensch.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:AF2","text":"Deed and judgment → division of motive, action, and image of the deed → retrospective madness and guilt → human being as driven multiplicity → historical revaluation of good and evil → rejection of mere comfort.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_97E9_VBV0:ME1","text":"The criminal is remapped from the category of the evil perpetrator into the categories of illness, enmity, folly, and inner multiplicity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ME2","text":"The deed becomes visible no longer as an isolated action, but as a temporally stratified constellation of prior drive, enactment, image, and aftereffect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ME3","text":"The opposition innocence-guilt is destabilized through the distinction among drive, interpretation by reason, and retrospective self-fixation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ME4","text":"The opposition good-evil is transferred from a timeless moral order into a historical and physiological order of values.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ME5","text":"Justice is redrawn from retribution toward compassion, self-overcoming, and the justification of the life of those who judge.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ME6","text":"Virtue is classified no longer according to its moral designation, but according to its function for self-preservation or self-destruction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_97E9_VBV0:ALT1","text":"**Surface:** A pale criminal, a red judge, killing, and the linguistic designation of the perpetrator constitute the immediate level of action.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ALT2","text":"**Structural:** The discourse constructs a system of drives, reason, image of the deed, guilt, illness, and historical norm formation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ALT3","text":"**Metastrategic:** Judicial judgment, compassion, virtue, and continued life are reframed such that every evaluation must be oriented toward a higher form of the human being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0027","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:ALT4","text":"**Ontological/Temporal:** The subject appears as a conflictual multiplicity; causality is broken between before, deed, and afterimage, while good and evil appear as historically mutable temporal orders.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_97E9_VBV0:MRT1","text":"The axioms suffice to reconstruct the movement from self-contempt and self-judgment, through the redefinition of killing, to the critique of present-day virtue.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:MRT2","text":"The precise meaning of the nod, the status of the Übermensch, and the criterion by which compassion is distinguished from revenge remain underdetermined.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VBV0:MRT3","text":"The structure is internally coherent provided that psychic multiplicity, historical evaluation, and self-overcoming are accepted as a common foundation.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VBV0:MRT4","text":"Its strongest connection lies in the separation of original desire, rational motivation, and retrospective image of the deed.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:MRT5","text":"Its weakest point lies in the simultaneous refusal of continuous causality and the strong psychological explanation of the event of the deed.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0009","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0013","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0014","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0015","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:MRT6","text":"A further tension arises from the fact that moral labels are rejected while hierarchical evaluations are retained.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0007","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_VBV0:MRT7","text":"The reconstruction preserves the actual movement of the argument provided that the paradoxical connection among killing, justification of life, and higher order of values is not smoothed over.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VBV0:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_VBV0:P0026","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_97E9_VBV0@R001","source_variant_id":"canonical:CH_97E9_VBV0:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 16","title":"On the Pale Criminal","context":"Chapter 16","original_title":"Vom bleichen Verbrecher","original_context":"Chapter 16"},"original_title":"Vom bleichen Verbrecher","title_language_code":"en"},{"id":"CH_97E9_VLUS","layer":"CH","title":"On Reading and Writing","order":17,"parents":["RAW_97E9_VLUS"],"revision":"CH_97E9_VLUS@R001","sha256":"f935ed000c2087f073bc212378eb44b636742ce32b155bae23c564a9c1b94f83","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_97E9_VLUS:AS1","text":"Das Problem ist die Entleerung von Schreiben und Denken durch allgemeine Lesbarkeit und lesende Passivität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:AS2","text":"Schreiben wird als körperlich riskante Blutinschrift neu bestimmt, die nicht dem Leser dient, sondern Erinnerung erzwingt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0001","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0006","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:AS3","text":"Der Spruch wird als Gipfel organisiert, dessen Verständnis Distanz, Höhe und einen privilegierten Adressaten voraussetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:AS4","text":"Erhebung erzeugt eine abwärts gerichtete Perspektive, aus der Trauer, Schwere und Ernst durch Lachen entwertet werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:AS5","text":"Lebensbejahung wird an die Verbindung von Lastfähigkeit, Liebe, Wahnsinn, Vernunft und Leichtigkeit gebunden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:AS6","text":"Die Bewegung endet in selbst erzeugtem Gehen, Fliegen und Tanzen als Tötung des Geistes der Schwere.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_97E9_VLUS:A1","text":"Schreiben mit Blut lässt Blut als Geist erfahren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A2","text":"Fremdes Blut ist nicht leicht zu verstehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A3","text":"Allgemeine Lesefähigkeit verdirbt auf Dauer Schreiben und Denken.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A4","text":"Blutgeschriebene Sprüche zielen auf Auswendiglernen, nicht auf bloßes Lesen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A5","text":"Sprüche sollen Gipfel sein und richten sich an Große und Hochwüchsige.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A6","text":"Erhebung erzeugt eine Perspektive des Hinabblickens.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A7","text":"Weisheit verlangt Mut, Unbekümmertheit, Spott und Gewalt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A8","text":"Die Schwere des Lebens wird durch Stolz und Ergebung getragen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A9","text":"Liebe enthält zugleich Wahnsinn und Vernunft.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A10","text":"Leichtigkeit, Beweglichkeit und törichte Zierlichkeit stehen dem Glück am nächsten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A11","text":"Der ernste, gründliche und feierliche Teufel ist der Geist der Schwere, durch den alle Dinge fallen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0023","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A12","text":"Lachen tötet den Geist der Schwere.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:A13","text":"Erlerntes Gehen und Fliegen ermöglichen Bewegung ohne äußeren Stoß.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_97E9_VLUS:NX1","text":"Das System setzt Verständnis nicht als unmittelbare Übertragbarkeit zwischen fremden Körpern voraus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:NX2","text":"Schreiben ist nicht Dienst am Leser.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:NX3","text":"Allgemeine Lesbarkeit ist keine neutrale oder fortschrittliche Bedingung des Denkens.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:NX4","text":"Der Geist bleibt nicht in der Gestalt Gottes, sondern kann zum Menschen und weiter zum Pöbel werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:NX5","text":"Der Spruch ist kein gewöhnlicher erklärender Text, sondern eine Gipfelform.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0007","trace_type":"Negative","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:NX6","text":"Erhebung besteht nicht im bloßen Aufblicken, sondern im Hinabblicken aus erhöhter Position.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:NX7","text":"Die Schwere des Lebens rechtfertigt keine zärtliche Behandlung des Lebens.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:NX8","text":"Liebe ist weder bloße Anhaftung noch reine Vernunft.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0018","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:NX9","text":"Ein gültiger Gott ist nicht durch Ernst, Tiefe und Feierlichkeit bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:NX10","text":"Der Geist der Schwere wird nicht durch Zorn überwunden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0024","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:NX11","text":"Selbstbewegung ist nicht das Ergebnis des Wartens auf einen äußeren Stoß.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_97E9_VLUS:D1","text":"Blut als Geist erzeugt eine prinzipielle Verständnisschwierigkeit zwischen Schreibendem und Lesendem.","refs":["CH_97E9_VLUS:A1","CH_97E9_VLUS:A2"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:D2","text":"Die Orientierung am allgemeinen Leser verstärkt genau jene Entleerung von Schreiben und Denken, die die Blutinschrift abwehrt.","refs":["CH_97E9_VLUS:A3","CH_97E9_VLUS:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0003","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0006","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:D3","text":"Die Unzugänglichkeit des Spruchs ist keine Schwäche, sondern die Bedingung seiner Gipfelstruktur.","refs":["CH_97E9_VLUS:A2","CH_97E9_VLUS:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:D4","text":"Erhebung verwandelt Trauer und Ernst in Gegenstände des Lachens und ordnet Weisheit einer kämpferischen Haltung zu.","refs":["CH_97E9_VLUS:A6","CH_97E9_VLUS:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:D5","text":"Tragfähigkeit des Lebens verlangt zugleich Selbstbehauptung und Hingabe.","refs":["CH_97E9_VLUS:A8","CH_97E9_VLUS:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:D6","text":"Die Verbindung von Wahnsinn und Vernunft ermöglicht eine nicht-schwere Form des Glücks.","refs":["CH_97E9_VLUS:A9","CH_97E9_VLUS:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0021","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:D7","text":"Ernst, Tiefe und Feierlichkeit werden als Erscheinungsweisen der fallenerzeugenden Schwere klassifiziert.","refs":["CH_97E9_VLUS:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0023","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:D8","text":"Lachen und selbst erzeugte Bewegung bilden zwei komplementäre Verfahren zur Aufhebung der Schwere.","refs":["CH_97E9_VLUS:A12","CH_97E9_VLUS:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_97E9_VLUS:SD1","text":"Das System ersetzt universale Mitteilung durch körperlich beglaubigte, selektive und erinnerungsorientierte Übertragung.","refs":["CH_97E9_VLUS:A1","CH_97E9_VLUS:A2","CH_97E9_VLUS:A3","CH_97E9_VLUS:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:SD2","text":"Höhe, geistige Qualität und soziale Adressierbarkeit werden zu einer hierarchischen Einheit verschmolzen.","refs":["CH_97E9_VLUS:A5","CH_97E9_VLUS:A6","CH_97E9_VLUS:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0011","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0014","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:SD3","text":"Lebensbejahung bedeutet nicht Entlastung, sondern die Umwandlung von Last in Stolz, Liebe und Beweglichkeit.","refs":["CH_97E9_VLUS:A8","CH_97E9_VLUS:A9","CH_97E9_VLUS:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0015","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0021","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:SD4","text":"Lachen fungiert nicht als Stimmung, sondern als operative Gegenmacht gegen Fall, Ernst, Passivität und Schwere.","refs":["CH_97E9_VLUS:A6","CH_97E9_VLUS:A11","CH_97E9_VLUS:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0023","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0024","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0025","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:SD5","text":"Die Wahrheit des Textes hängt an einer nicht-universalen Kommunikationsordnung, in der Verstehen durch Distanz und Auswahl erzeugt wird.","refs":["CH_97E9_VLUS:A2","CH_97E9_VLUS:A3","CH_97E9_VLUS:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:SD6","text":"Die höchste Form des Geistes wird als selbstbewegte, tanzende Existenz und nicht als kontemplative Tiefe bestimmt.","refs":["CH_97E9_VLUS:A10","CH_97E9_VLUS:A11","CH_97E9_VLUS:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_97E9_VLUS:P0022","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0023","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0025","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0026","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_97E9_VLUS:DNX1","text":"Das System schließt die Annahme aus, dass Wahrheit unabhängig von körperlicher Gefährdung und Verkörperung mitteilbar ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VLUS:DNX2","text":"Es schließt die Gleichrangigkeit von Schreibendem und Lesendem als kommunikative Ausgangslage aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0003","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:DNX3","text":"Es schließt eine unterschiedslose Öffentlichkeit des Verstehens aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:DNX4","text":"Es schließt Ernst und Tiefe als hinreichende Kriterien geistiger Wahrheit aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:DNX5","text":"Es schließt äußere Verursachung als angemessene Erklärung selbstbestimmter Bewegung aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:DNX6","text":"Es schließt eine stabile Trennung von Vernunft und Wahnsinn aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:DNX7","text":"Es schließt eine Lebensbejahung aus, die auf Schonung, Mitleid oder Empfindlichkeit beruht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0016","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_97E9_VLUS:SNX1","text":"Eine gemeinsame, unmittelbar zugängliche Verständigungsgemeinschaft bleibt strukturell ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:SNX2","text":"Eine nicht-hierarchische Ordnung allgemeiner Bildung wird als nicht verfügbar behandelt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:SNX3","text":"Die Möglichkeit, dass Erhebung und Gleichrangigkeit zusammenfallen, wird blockiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0007","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0011","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:SNX4","text":"Eine Versöhnung zwischen dem erhobenen Sprecher und den unter ihm gesehenen Anderen wird nicht hergestellt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VLUS:SNX5","text":"Eine kollektive Form der Überwindung der Schwere wird nicht formalisiert; verfügbar bleibt nur die individuelle Selbstbewegung.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_97E9_VLUS:SNX6","text":"Ein ernster, nicht-fallender und nicht-schwerer Geist wird als unmögliche Gestalt behandelt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0022","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VLUS:P0023","trace_type":"Composite","confidence":"medium","alignment_provenance":"repaired-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_97E9_VLUS:FGS1","text":"Körperliche Einschreibung → Geist wird als Blut bestimmt → fremdes Blut bleibt schwer verständlich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VLUS:P0001","trace_type":"Composite","confidence":"high","align