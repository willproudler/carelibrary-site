Überflusses → Beginn des Zarathustrischen Untergangs.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_1100:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_1100:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_1100:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_97E9_1100:AF1","text":"Geistige Überfülle → Überdruss an isoliertem Besitz → Bedürfnis nach Händen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_1100:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_1100:AF2","text":"Bedürfnis nach Empfängern → Sonnenanalogie → Legitimation des Abstiegs.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_1100:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_1100:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_1100:AF3","text":"Abstieg → Zugang zur menschlichen Welt → Selbstentäußerung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_1100:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_1100:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_1100:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_1100:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_1100:AF4","text":"Selbstentäußerung → Wiederwerdung zum Menschen → Zarathustras Untergang.","refs":[],"deep_refs":[],"trace_typ