race_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDD0:FGS5","text":"Ersatzwissen durch Volk, Natur und Gefühl → Projektion eines geheimen Zugangs → Götter und Übermenschen als Gleichnisse → Entstehung einer leichten Transzendenz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDD0:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDD0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDD0:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDD0:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDD0:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDD0:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDD0:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDD0:FGS6","text":"Anspruch auf Tiefe → Trübung des Gewässers → Vermittlung und Halbheit → Entlarvung dichterischer Eitelkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_VDD0:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDD0:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDD0:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDD0:P0041","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"},{"id":"RAW_97E9_VDD0:P0042","trace_type":"Composite","confidence":"high","alignment_provenance":"repaired-grounding"}]},{"id":"CH_97E9_VDD0:FGS7","text":"Ermüdung a