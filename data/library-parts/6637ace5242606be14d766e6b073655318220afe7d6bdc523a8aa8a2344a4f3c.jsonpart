ype":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_15_2:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_15_2:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_15_2:FGS2","text":"Überlagerung von Ferne, Tiefe, Zukunft, Höhe und Kraft → innere Kollision → Möglichkeit des Zerbrechens.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_15_2:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_15_2:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_15_2:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_15_2:FGS3","text":"Zerbrechlichkeit → Selbstlachen statt Selbstverurteilung → Erhaltung von Mut und Beweglichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_15_2:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_15_2:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_15_2:FGS4","text":"Vorhandene kleine Vollkommenheiten → äußere Anordnung um den höheren Menschen → Heilung des Herzens und Erzeugung von Hoffnung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_15_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_97E9_15_2:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_97E9_15_2:FGS5","text":"Keine Aufhebung der Spannung → lokale Stabilisierung durch Vollkommenheit → Offenhaltung der menschlichen Zukunft.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_97E9_15_2:P0006","trace_type":"Structural","confidence":"high","ali