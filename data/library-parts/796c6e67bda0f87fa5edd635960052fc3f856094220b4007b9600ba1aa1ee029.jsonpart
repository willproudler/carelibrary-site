ctural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_A_40:ME1","text":"Inneres und Äußeres werden von getrennten Bereichen zu gegenseitig vermittelten Bestimmungen derselben Totalität umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME2","text":"Das Innere wird nicht mehr als fertiger verborgener Grund, sondern als anfängliche und noch passive Bestimmung sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME3","text":"Das Äußere wird nicht mehr als unwesentliche Oberfläche, sondern als notwendige Äußerung des Wesens klassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME4","text":"Das Verhältnis von Ganzem und Teilen wird von einer statischen Aggregation zu einer unentwickelten Vorform vermittelter Totalität umgeordnet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME5","text":"Inhalt und Form werden als zirkulär ineinander übergehende Bestimmungen statt als getrennte Komponenten kartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME6","text":"Erscheinung und Wirklichkeit werden nicht als Gegensatz, sondern als Stufen derselben Selbstoffenbarungsbewegung bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME7","text":"Die theologische Landschaft wird entlang der Differenz zwischen unmittelbarer Natur und vermitteltem Geist neu geordnet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_A_40:ALT1","text":"Surface — Die Beziehung von Innerem und Äußerem wird als Übergang von unmittelbarer Identität zu Wirklichkeit bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ALT2","text":"Structural — Der Übergang wird durch negative Einheit, Entgegensetzung, Reflexion, Totalität und wechselseitige Vermittlung erzeugt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ALT3","text":"Metastrategic — Das Argument verschiebt den Maßstab von verborgener Innerlichkeit und unmittelbarer Identität auf vermittelte Selbstoffenbarung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ALT4","text":"Ontological/Temporal — Realität erscheint als Entwicklungsfolge von Unmittelbarkeit über Äußerung und Rückkehr zu Wirklichkeit; Geist ist die gesetzte und wieder aufgehobene Unmittelbarkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_A_40:MRT1","text":"Die Axiome reichen aus, um den Übergang von unmittelbarer Identität über Vermittlung und Totalität zur Wirklichkeit zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT2","text":"Unterbestimmt bleibt die genaue systematische Funktion des Verhältnisses der Kraft als Vermittlungsstufe.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_A_40:MRT3","text":"Intern kohärent ist das System, sofern unmittelbare Identität als notwendiger Anfang und nicht als vollendete Wirklichkeit gelesen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT4","text":"Seine stärkste Struktur liegt in der Ableitung der Äußerlichkeit aus dem Wesen und der Wirklichkeit aus der Identität von Erscheinung und Innerem.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT5","text":"Eine Spannung besteht darin, dass die Totalität in der anfänglichen Beziehung noch fehlt, den Bestimmungen aber zugleich bereits als ihre Totalität zugeschrieben wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT6","text":"Eine zweite Spannung besteht darin, dass Inneres und Äußeres durch ihre Einheit aufgehoben werden, aber weiterhin als notwendige Momente dieser Einheit fungieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT7","text":"Die theologische Bestimmung des unmittelbaren Gottes als Natur folgt der Entwicklungslogik des Systems, wird jedoch nicht unabhängig von ihr begründet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Direct","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT8","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung des Textes, sofern die unmittelbare Identität als defizienter Anfang und die Selbstoffenbarung als Resultat der Vermittlung erhalten bleiben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T112555511998Z_ca72c4c6","language_code":"en","language_name":"English","title":"Note.","source_sha256":"8a305f2c461b4a1611ec58b9451adaa32d55b27400d24aaa6e4e3e05f8e2d208","sha256":"e059eee615c7673a9cd460cc4fbcc7e966c3221ff91c89363b373e1eab9d40d6","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:25:55.513091+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_A_40:AS1","text":"The problem consists in the fact that the initial identity of inner and outer does not yet constitute a totality mediated in content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:AS2","text":"This initial identity is determined as immediate, passive, and therefore external determinate being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:AS3","text":"Development presupposes that the moments are opposed, mediated, and posited outwardly through activity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:AS4","text":"Through the reflection of form, inner and outer each become a totality of themselves and their other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:AS5","text":"Externality thereby becomes the expression of essence, while appearance is not merely reflection into an other, but reflection into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:AS6","text":"The identity of appearance and essence determines the essential relation to actuality; spirit remains therein the mediated return from posited immediacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_A_40:A1","text":"The movement of essence is a becoming of the concept.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A2","text":"Inner and outer are posited in negative unity in the essential relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A3","text":"In this negative unity, each determination is both its other and the totality of the relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A4","text":"Totality as the universal belongs to the concept and is not yet present in the initial mere relation of inner and outer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A5","text":"The immediate identity of form is an identity without the contentful movement of the matter itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A6","text":"The beginning of something real is immediate identity, because its moments are not yet opposed and developed.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A7","text":"The merely inner, as such, is immediate, passive determinate being and thus externality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A8","text":"Actual development presupposes opposition, mediation, and production through activity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A9","text":"The immediate sphere of being is the sphere of being immediacy and externality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A10","text":"Merely inner essence can appear as an external, systemless communality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A11","text":"The first identity of inner and outer is indifferent foundation and content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A12","text":"The second identity of inner and outer is their immediate inversion and pure form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A13","text":"Foundation and form are only different sides of one totality and pass over into one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A14","text":"Content is form insofar as it determines itself as difference and posits inner and outer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A15","text":"Inner and outer are each posited as the totality of themselves and their other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A16","text":"Each side is, through its other, what it is in itself, and is thereby mediated with it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A17","text":"The externality of a something is its totality and the expression of what it is in itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:A18","text":"The identity of content and form determines the essential relation to actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_A_40:NX1","text":"The immediate is not yet a developed concept.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:NX2","text":"The merely inner is not an independent, already actualized essence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:NX3","text":"The outer is not a layer independent of the inner.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:NX4","text":"Totality is not an external assemblage of indifferent parts.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:NX5","text":"The relation of whole and parts, in its immediate form, is not yet a mediated unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:NX6","text":"Appearance is not merely reflection into an other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:NX7","text":"Content and form are not determinations independent of one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:NX8","text":"Immediate God is not yet spirit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:NX9","text":"The abstract absolute of the first thinking is not absolute spirit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_A_40:D1","text":"What is initially merely inner is at once immediate and passive outer being.","refs":["CH_GB18_A_40:A5","CH_GB18_A_40:A6","CH_GB18_A_40:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:D2","text":"The initial relation of whole and parts possesses only an external subsistence, because its identity is not yet posited in them themselves.","refs":["CH_GB18_A_40:A6","CH_GB18_A_40:A8","CH_GB18_A_40:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_40:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:D3","text":"The sphere of being designates immediate externality, whereas the sphere of essence initially designates only the inner.","refs":["CH_GB18_A_40:A7","CH_GB18_A_40:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_40:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:D4","text":"The identity of foundation and form is not a double foundation, but the inversion of two sides of a totality.","refs":["CH_GB18_A_40:A11","CH_GB18_A_40:A12","CH_GB18_A_40:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_40:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:D5","text":"The inner, as reflected identity, is equally being and externality, whereas the outer, as determinate being, has returned into its ground and is thereby inner.","refs":["CH_GB18_A_40:A14","CH_GB18_A_40:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_40:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:D6","text":"Totality mediates itself with itself through form, whereas determinateness is mediated through its simple identity with itself.","refs":["CH_GB18_A_40:A15","CH_GB18_A_40:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_40:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:D7","text":"The externality of a something is not mere surface, but the posited appearance of its being-in-itself.","refs":["CH_GB18_A_40:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:D8","text":"Appearance reflects itself into itself because content and form have become absolutely identical.","refs":["CH_GB18_A_40:A14","CH_GB18_A_40:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:D9","text":"The essential relation determines itself as actuality as soon as appearance and essence are posited as an identical unity.","refs":["CH_GB18_A_40:A17","CH_GB18_A_40:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:D10","text":"God is, in the immediate concept, nature and, in the first thinking, pure being or abstract absolute, but not yet absolute spirit.","refs":["CH_GB18_A_40:A7","CH_GB18_A_40:A9","CH_GB18_A_40:NX8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_A_40:SD1","text":"Immediate identity is necessary as a beginning, but remains inadequate as such; actuality first arises through difference, mediation, and return.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:SD2","text":"Inner and outer are not independent ontological domains, but functional determinations within a self-mediating totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:SD3","text":"Development is not an external supplementation of an already finished essence, but the production of its determinateness through self-expression.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:SD4","text":"Actuality is determined not as a hidden ground behind appearance, but as the identity of essence and its self-revelation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:SD5","text":"Being, essence, concept, and actuality constitute an order of increasing mediation: immediate externality, inward determinateness, conceptual totality, and actual self-revelation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:SD6","text":"The determination of spirit rests on an immediacy that posits itself, leaves itself, and takes itself back into itself; an immediate spirit is therefore an excluded concept.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_A_40:DNX1","text":"It must be false that immediate identity already contains the developed unity of its opposed moments.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:DNX2","text":"It must be false that essence subsists as hidden inner independently of its expression.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:DNX3","text":"It must be false that the outer is merely a subsequent addition to a finished inner.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:DNX4","text":"It must be false that totality is given as a finished ground prior to its mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:DNX5","text":"It must be false that content and form are separate components of an object.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:DNX6","text":"It must be false that actuality can be attained without opposition, activity, and return from externality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:DNX7","text":"It must be false that the absolute, as immediate being, already possesses the truth of spirit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_A_40:SNX1","text":"Excluded is an actuality that persists in immediate identity and does not posit itself externally.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:SNX2","text":"Excluded is an essence whose truth remains hidden behind its appearance and does not emerge in it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:SNX3","text":"Excluded is a beginning that already contains totality without passing through difference, mediation, and development.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:SNX4","text":"Excluded is an absolute that does not return to itself through self-mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_A_40:FGS1","text":"Immediate identity of inner and outer → moments not yet developed → passive and external determinate being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:FGS2","text":"Positing of difference and opposition → activity and mediation → production of inner determination as externality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:FGS3","text":"Reflection of form upon its difference → form as content and content as differentiated form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:FGS4","text":"Each side contains the totality of itself and its other → reciprocal mediation of inner and outer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:FGS5","text":"Reciprocal mediation → externality as expression of being-in-itself → appearance as reflection into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:FGS6","text":"Identity of appearance and essence → determination of the essential relation to actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:FGS7","text":"Posited immediacy → return from externality into itself → spirit as mediated, not immediate unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_A_40:AF1","text":"Immediate identity without totality → passive inner and external determinate being → opposition and mediation → form-content reflection → reciprocal totality of inner and outer → externality as self-revelation → actuality as identity of appearance and essence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_A_40:ME1","text":"Inner and outer are remapped from separate domains into mutually mediated determinations of the same totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME2","text":"The inner is no longer visible as a finished hidden ground, but as an initial and still passive determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME3","text":"The outer is no longer classified as an inessential surface, but as a necessary expression of essence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME4","text":"The relation of whole and parts is reordered from a static aggregation into an undeveloped preliminary form of mediated totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME5","text":"Content and form are mapped as determinations that pass circularly into one another rather than as separate components.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME6","text":"Appearance and actuality are determined not as opposites, but as stages of the same movement of self-revelation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ME7","text":"The theological landscape is reordered along the difference between immediate nature and mediated spirit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_A_40:ALT1","text":"Surface — The relation of inner and outer is determined as a transition from immediate identity to actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ALT2","text":"Structural — The transition is produced through negative unity, opposition, reflection, totality, and reciprocal mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ALT3","text":"Metastrategic — The argument shifts the standard from hidden inwardness and immediate identity to mediated self-revelation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:ALT4","text":"Ontological/Temporal — Reality appears as a developmental sequence from immediacy, through expression and return, to actuality; spirit is posited and subsequently sublated immediacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_A_40:MRT1","text":"The axioms suffice to reconstruct the transition from immediate identity, through mediation and totality, to actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT2","text":"The precise systematic function of the relation of force as a stage of mediation remains underdetermined.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_A_40:MRT3","text":"The system is internally coherent insofar as immediate identity is read as a necessary beginning and not as completed actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT4","text":"Its strongest structure lies in the derivation of externality from essence and of actuality from the identity of appearance and inner.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT5","text":"A tension consists in the fact that totality is still absent in the initial relation, while at the same time being ascribed to the determinations already as their totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT6","text":"A second tension consists in the fact that inner and outer are sublated through their unity, but continue to function as necessary moments of this unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT7","text":"The theological determination of immediate God as nature follows from the developmental logic of the system, but is not grounded independently of it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0005","trace_type":"Direct","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_40:MRT8","text":"The reconstruction preserves the actual movement of the text insofar as immediate identity remains a deficient beginning and self-revelation remains the result of mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_40:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_40:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_A_40@R001","source_variant_id":"canonical:CH_GB18_A_40:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 153","title":"Remark.","context":"Chapter 153","original_title":"Anmerkung."},"original_title":"Anmerkung.","title_language_code":"en"},{"id":"CH_GB18_DADW","layer":"CH","title":"Third Section. Actuality.","order":154,"parents":["RAW_GB18_DADW"],"revision":"CH_GB18_DADW@R001","sha256":"718c4fbe1d2904c7f9a4f00fb619d165a0b9b16a7272616228df730880bbfb89","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_DADW:AS1","text":"Das Problem besteht darin, Wesen, Existenz, Erscheinung, Inneres und Äußeres nicht als isolierte Bestimmungen, sondern als Momente einer einheitlichen Wirklichkeitsstruktur zu bestimmen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:AS2","text":"Die Wirklichkeit wird als Einheit von Wesen und Existenz neu bestimmt, in der sowohl das gestaltlose Wesen als auch die haltlose Erscheinung ihre Wahrheit erhalten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:AS3","text":"Die aus dem Grunde hervorgegangene Existenz wird durch Formbestimmung zur Erscheinung und durch die Bewegung von Reflexion-in-Anderes zu Reflexion-in-sich zur gegliederten Totalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:AS4","text":"Die Trennung von Innerem und Äußerem wird auf ein und dieselbe Inhalts- und Formidentität zurückgeführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:AS5","text":"Aus der aufgehobenen Formverschiedenheit entsteht die absolute Wirklichkeit als Einheit des Absoluten und seiner Reflexion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:AS6","text":"Die weitere Bestimmung führt vom zunächst äußerlich betrachteten Absoluten über Wirklichkeit, Möglichkeit und Notwendigkeit zum absoluten Verhältnis des Absoluten zu sich selbst, der Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_DADW:A1","text":"Wirklichkeit ist die Einheit von Wesen und Existenz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A2","text":"Wesen ohne Gestalt und Erscheinung ohne Halt erhalten ihre Wahrheit erst in der Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A3","text":"Existenz ist die aus dem Grunde hervorgegangene Unmittelbarkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A4","text":"Existenz ist zunächst noch nicht als Form an sich selbst gesetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A5","text":"Die bestimmte und formierte Existenz ist Erscheinung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A6","text":"Die Reflexion-in-Anderes kann sich zur Reflexion-in-sich fortbilden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A7","text":"Die Fortbildung der Erscheinung erzeugt zwei Inhalts-Totalitäten, eine in sich und eine in Anderes reflektierte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A8","text":"Das wesentliche Verhältnis von Innerem und Äußerem beruht auf einer identischen Grundlage des Inhalts.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A9","text":"Das wesentliche Verhältnis von Innerem und Äußerem beruht ebenso auf einer Identität der Form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A10","text":"Die Identität von Inhalt und Form hebt die Formbestimmung ihrer Verschiedenheit auf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A11","text":"Die Einheit von Innerem und Äußerem ist absolute Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A12","text":"Das Absolute erscheint zunächst als eine Einheit, in der die Form aufgehoben und der Unterschied von Innerem und Äußerem äußerlich gesetzt ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A13","text":"Die äußerliche Reflexion betrachtet das Absolute zunächst, statt seine eigene Bewegung zu sein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A14","text":"Die äußerliche Reflexion ist wesentlich die negative Rückkehr des Absoluten in sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A15","text":"Wirklichkeit, Möglichkeit und Notwendigkeit sind formelle Momente des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A16","text":"Die Einheit des Absoluten und seiner Reflexion ist das absolute Verhältnis zu sich selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A17","text":"Das absolute Verhältnis des Absoluten zu sich selbst ist Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_DADW:NX1","text":"Wirklichkeit ist weder gestaltloses Wesen noch haltlose Erscheinung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX2","text":"Existenz ist nicht bereits als voll entwickelte Form bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX3","text":"Erscheinung ist nicht bloß unmittelbares Bestehen, sondern formierte Existenz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX4","text":"Inneres und Äußeres sind keine selbständigen Inhaltsbereiche.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX5","text":"Die Verschiedenheit von Innerem und Äußerem ist keine letztgültige Formbestimmung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX6","text":"Das Absolute ist nicht bloß eine äußerlich vorliegende Einheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX7","text":"Reflexion ist nicht ausschließlich äußerliche Betrachtung des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX8","text":"Wirklichkeit ist nicht auf einen einzigen formellen Modus des Absoluten reduzierbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX9","text":"Das absolute Verhältnis ist nicht ein Verhältnis zwischen äußerlich getrennten Termen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_DADW:D1","text":"Die Wahrheit von Wesen und Existenz entsteht durch ihre Einheit in der Wirklichkeit.","refs":["CH_GB18_DADW:A1","CH_GB18_DADW:A2"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D2","text":"Die Erscheinung bildet die Vermittlungsstufe zwischen unmittelbarer Existenz und reflektierter Wirklichkeit.","refs":["CH_GB18_DADW:A3","CH_GB18_DADW:A4","CH_GB18_DADW:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D3","text":"Die Bewegung von Reflexion-in-Anderes zu Reflexion-in-sich erzeugt die Differenz zweier Welten innerhalb einer gemeinsamen Struktur.","refs":["CH_GB18_DADW:A6","CH_GB18_DADW:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D4","text":"Die Differenz von Innerem und Äußerem bleibt inhaltlich und formal auf eine einzige Grundlage bezogen.","refs":["CH_GB18_DADW:A8","CH_GB18_DADW:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D5","text":"Die absolute Totalität entsteht, sobald die Formverschiedenheit von Innerem und Äußerem als aufgehoben gesetzt ist.","refs":["CH_GB18_DADW:A10","CH_GB18_DADW:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D6","text":"Das Absolute ist zunächst nur als Einheit bestimmt, deren eigene Formbewegung noch in äußerlichen Unterschied zerlegt erscheint.","refs":["CH_GB18_DADW:A12","CH_GB18_DADW:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D7","text":"Die äußerliche Reflexion gehört trotz ihrer scheinbaren Äußerlichkeit zur negativen Selbstbewegung des Absoluten.","refs":["CH_GB18_DADW:A13","CH_GB18_DADW:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D8","text":"Wirklichkeit, Möglichkeit und Notwendigkeit bestimmen das Absolute als gegliederte Reflexionsform.","refs":["CH_GB18_DADW:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D9","text":"Substanz bezeichnet das Absolute nicht mehr als bloße Einheit, sondern als Selbstverhältnis seiner Einheit und Reflexion.","refs":["CH_GB18_DADW:A16","CH_GB18_DADW:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_DADW:SD1","text":"Die Wirklichkeit ist keine statische Gegebenheit, sondern die resultierende Totalität einer Formbewegung, in der Unmittelbarkeit, Erscheinung und Reflexion ineinander übergehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SD2","text":"Die scheinbare Zweiheit von innerer und äußerer Welt ist eine systeminterne Differenzierung eines identischen Inhalts und einer identischen Form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SD3","text":"Die äußerliche Betrachtung des Absoluten wird in eine negative Selbstbewegung des Absoluten umgedeutet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SD4","text":"Die Bestimmungen Wirklichkeit, Möglichkeit und Notwendigkeit bilden eine gestufte Selbstbestimmung des Absoluten, die in der Substanz als Selbstverhältnis kulminiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SD5","text":"Die Einheit des Systems entsteht nicht durch Aufhebung aller Differenz, sondern durch die Aufhebung ihrer Selbständigkeit als Formdifferenz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_DADW:DNX1","text":"Das System schließt ein selbständiges Wesen aus, das unabhängig von Existenz und Erscheinung bestehen könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX2","text":"Das System schließt eine unmittelbare Existenz aus, die ihre Form bereits vollständig aus sich selbst besäße.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX3","text":"Das System schließt zwei ontologisch getrennte Welten aus, deren Inhalte nicht auf eine identische Grundlage zurückführbar wären.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX4","text":"Das System schließt eine Form aus, deren Identität nicht zugleich die Identität des Inneren und Äußeren wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX5","text":"Das System schließt eine Reflexion aus, die dem Absoluten dauerhaft äußerlich bleiben könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX6","text":"Das System schließt die Reduktion des Absoluten auf bloße Unmittelbarkeit, bloße Möglichkeit oder bloße Notwendigkeit aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX7","text":"Das System schließt ein absolutes Verhältnis aus, das durch externe Relata konstituiert wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_DADW:SNX1","text":"Ausgeschlossen ist eine Wirklichkeit, deren Wahrheit in einer endgültigen Trennung von Wesen und Existenz liegen würde.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SNX2","text":"Ausgeschlossen ist eine Weltordnung, in der Inneres und Äußeres voneinander unabhängige Totalitäten bilden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SNX3","text":"Ausgeschlossen ist ein Absolutes, das nur Gegenstand einer fremden Reflexion wäre und keine eigene negative Rückkehr in sich vollzöge.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SNX4","text":"Ausgeschlossen ist eine äußerliche Vielheit, die nicht als Moment einer einzigen absoluten Totalität begriffen werden kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SNX5","text":"Die versperrte Möglichkeit des Systems ist eine irreduzible, nicht vermittelte Differenz zwischen Absolutem und Reflexion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_DADW:FGS1","text":"Unbestimmtes Wesen + haltlose Erscheinung → Einheit von Wesen und Existenz → Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:FGS2","text":"Grundvermittelte Unmittelbarkeit → Formbestimmung → Erscheinung → Reflexion-in-Anderes → Reflexion-in-sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:FGS3","text":"Reflexion-in-sich → zwei Inhalts-Totalitäten → Inneres/Äußeres → identische Inhaltsgrundlage + identische Form → aufgehobene Formverschiedenheit → absolute Totalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:FGS4","text":"Absolute Totalität → zunächst äußerlich gesetzte Einheit → äußerliche Reflexion → negative Rückkehr in sich → Wirklichkeit/Möglichkeit/Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:FGS5","text":"Einheit des Absoluten und seiner Reflexion → absolutes Selbstverhältnis → Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_DADW:AF1","text":"Unbestimmtes Wesen und haltlose Erscheinung → Einheit von Wesen und Existenz → formierte Existenz als Erscheinung → Reflexion-in-Anderes und Reflexion-in-sich → zwei reflektierte Totalitäten → identische Grundlage und Form von Innerem und Äußerem → absolute Wirklichkeit → äußerliche Reflexion als negative Rückkehr → Wirklichkeit, Möglichkeit und Notwendigkeit → Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_DADW:ME1","text":"Die Karte der Wirklichkeit verschiebt sich von getrennten Bestimmungen zu einer Einheit, in der Wesen und Existenz gegenseitig wahrheitskonstitutiv sind.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ME2","text":"Die Opposition von Innerem und Äußerem wird von einer ontologischen Trennung zu einer formalen Differenz innerhalb identischer Grundlagen umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ME3","text":"Die Erscheinung wird von einer bloßen Oberfläche zu einer notwendigen Vermittlungsstufe der Wirklichkeitsbildung aufgewertet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ME4","text":"Die äußerliche Reflexion wird von einer fremden Betrachtungsweise zu einem Moment der Selbstbewegung des Absoluten umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ME5","text":"Möglichkeit, Wirklichkeit und Notwendigkeit werden als gestufte Formbestimmungen eines einzigen Absoluten statt als unabhängige Modalbegriffe angeordnet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ME6","text":"Substanz wird als Resultat der Identität von Absolutem und Reflexion klassifiziert, nicht als vorausgesetzter Träger hinter den Erscheinungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_DADW:ALT1","text":"Surface — Die Wirklichkeit wird als Einheit von Wesen und Existenz bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ALT2","text":"Structural — Die Wirklichkeit entsteht durch die Formierung der Existenz, die Reflexionsbewegung und die Identitätsbeziehung von Innerem und Äußerem.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ALT3","text":"Metastrategic — Äußerliche Differenzen werden als Momente einer immanenten Selbstbewegung neu gerahmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ALT4","text":"Ontological/Temporal — Realität wird als Prozess der Rückkehr von unmittelbarer Existenz über Erscheinung und Reflexion in ein absolutes Selbstverhältnis bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_DADW:MRT1","text":"Die Axiome sind hinreichend, um den Übergang von Wesen und Existenz zur Wirklichkeit sowie von Innerem und Äußerem zur absoluten Totalität zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT2","text":"Die Rekonstruktion bleibt hinsichtlich der genaueren Vermittlung zwischen Möglichkeit, Wirklichkeit und Notwendigkeit unterbestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT3","text":"Die Struktur ist intern kohärent, sofern die Identität von Inhalt und Form als tragende Bedingung akzeptiert wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT4","text":"Ihre stärkste Stelle ist die systematische Umwandlung äußerer Differenz in immanente Reflexionsbewegung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT5","text":"Ihre schwächste Stelle liegt in der Spannung zwischen der behaupteten äußerlichen Reflexion und ihrer gleichzeitigen Einordnung als negative Selbstbewegung des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT6","text":"Die Bestimmung der Substanz als absolutes Selbstverhältnis ist logisch vorbereitet, aber gegenüber den vorhergehenden Modalbestimmungen nur knapp vermittelt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT7","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung des Textes, sofern Wirklichkeit nicht als Endpunkt isoliert, sondern als Übergang zur Substanz gelesen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T114945363711Z_6c9adcd5","language_code":"en","language_name":"English","title":"Third Section. Actuality.","source_sha256":"718c4fbe1d2904c7f9a4f00fb619d165a0b9b16a7272616228df730880bbfb89","sha256":"927ba151efc31e8a07e92d6e042bcb88da8ed359f1c0f7170f8d8e991e6f7719","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:49:45.365690+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_DADW:AS1","text":"The problem consists in determining essence, existence, appearance, inner and outer not as isolated determinations, but as moments of a unified structure of actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:AS2","text":"Actuality is newly determined as the unity of essence and existence, in which both formless essence and unsubstantial appearance receive their truth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:AS3","text":"The existence that has emerged from the ground becomes appearance through determination of form, and becomes an articulated totality through the movement from reflection-into-another to reflection-into-itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:AS4","text":"The separation of inner and outer is traced back to one and the same identity of content and form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:AS5","text":"From the sublated difference of form arises absolute actuality as the unity of the Absolute and its reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:AS6","text":"The further determination leads from the Absolute initially considered externally, through actuality, possibility, and necessity, to the absolute relation of the Absolute to itself, substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_DADW:A1","text":"Actuality is the unity of essence and existence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A2","text":"Essence without form and appearance without stability receive their truth only in actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A3","text":"Existence is the immediacy that has emerged from the ground.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A4","text":"Existence is initially not yet posited as form in itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A5","text":"Determinate and formed existence is appearance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A6","text":"Reflection-into-another can develop into reflection-into-itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A7","text":"The development of appearance produces two totalities of content, one reflected into itself and one into another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A8","text":"The essential relation of inner and outer rests on an identical foundation of content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A9","text":"The essential relation of inner and outer likewise rests on an identity of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A10","text":"The identity of content and form sublates the determination of form of their difference.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A11","text":"The unity of inner and outer is absolute actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A12","text":"The Absolute initially appears as a unity in which form is sublated and the difference of inner and outer is posited externally.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A13","text":"External reflection initially considers the Absolute, instead of being its own movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A14","text":"External reflection is essentially the negative return of the Absolute into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A15","text":"Actuality, possibility, and necessity are formal moments of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A16","text":"The unity of the Absolute and its reflection is the absolute relation to itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:A17","text":"The absolute relation of the Absolute to itself is substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_DADW:NX1","text":"Actuality is neither formless essence nor unsubstantial appearance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX2","text":"Existence is not already determined as fully developed form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX3","text":"Appearance is not mere immediate subsistence, but formed existence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX4","text":"Inner and outer are not self-subsistent domains of content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX5","text":"The difference of inner and outer is not an ultimate determination of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX6","text":"The Absolute is not merely an externally given unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX7","text":"Reflection is not exclusively an external consideration of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX8","text":"Actuality cannot be reduced to a single formal mode of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:NX9","text":"The absolute relation is not a relation between externally separated terms.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_DADW:D1","text":"The truth of essence and existence arises through their unity in actuality.","refs":["CH_GB18_DADW:A1","CH_GB18_DADW:A2"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D2","text":"Appearance constitutes the mediating stage between immediate existence and reflected actuality.","refs":["CH_GB18_DADW:A3","CH_GB18_DADW:A4","CH_GB18_DADW:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D3","text":"The movement from reflection-into-another to reflection-into-itself produces the difference of two worlds within a common structure.","refs":["CH_GB18_DADW:A6","CH_GB18_DADW:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D4","text":"The difference of inner and outer remains related, in content and form, to a single foundation.","refs":["CH_GB18_DADW:A8","CH_GB18_DADW:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D5","text":"Absolute totality arises as soon as the difference of form of inner and outer is posited as sublated.","refs":["CH_GB18_DADW:A10","CH_GB18_DADW:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D6","text":"The Absolute is initially determined only as a unity whose own movement of form still appears dissected into external difference.","refs":["CH_GB18_DADW:A12","CH_GB18_DADW:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D7","text":"Despite its apparent externality, external reflection belongs to the negative self-movement of the Absolute.","refs":["CH_GB18_DADW:A13","CH_GB18_DADW:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D8","text":"Actuality, possibility, and necessity determine the Absolute as an articulated form of reflection.","refs":["CH_GB18_DADW:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:D9","text":"Substance designates the Absolute no longer as mere unity, but as the self-relation of its unity and reflection.","refs":["CH_GB18_DADW:A16","CH_GB18_DADW:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_DADW:SD1","text":"Actuality is not a static given, but the resultant totality of a movement of form in which immediacy, appearance, and reflection pass over into one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SD2","text":"The apparent duality of inner and outer world is a system-internal differentiation of an identical content and an identical form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SD3","text":"The external consideration of the Absolute is reinterpreted as a negative self-movement of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SD4","text":"The determinations actuality, possibility, and necessity form a graduated self-determination of the Absolute, culminating in substance as self-relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SD5","text":"The unity of the system arises not through the sublation of all difference, but through the sublation of its self-subsistence as difference of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_DADW:DNX1","text":"The system excludes a self-subsistent essence that could subsist independently of existence and appearance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX2","text":"The system excludes an immediate existence that already possessed its form completely from itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX3","text":"The system excludes two ontologically separate worlds whose contents could not be traced back to an identical foundation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX4","text":"The system excludes a form whose identity would not at the same time be the identity of inner and outer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX5","text":"The system excludes a reflection that could remain permanently external to the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX6","text":"The system excludes the reduction of the Absolute to mere immediacy, mere possibility, or mere necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:DNX7","text":"The system excludes an absolute relation that would be constituted by external relata.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_DADW:SNX1","text":"Excluded is an actuality whose truth would lie in a final separation of essence and existence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SNX2","text":"Excluded is a world order in which inner and outer form totalities independent of one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SNX3","text":"Excluded is an Absolute that would be only the object of an alien reflection and would perform no negative return into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SNX4","text":"Excluded is an external multiplicity that cannot be comprehended as a moment of a single absolute totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:SNX5","text":"The barred possibility of the system is an irreducible, unmediated difference between Absolute and reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_DADW:FGS1","text":"Indeterminate essence + unsubstantial appearance → unity of essence and existence → actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:FGS2","text":"Ground-mediated immediacy → determination of form → appearance → reflection-into-another → reflection-into-itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:FGS3","text":"Reflection-into-itself → two totalities of content → inner/outer → identical foundation of content + identical form → sublated difference of form → absolute totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:FGS4","text":"Absolute totality → unity initially posited externally → external reflection → negative return into itself → actuality/possibility/necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:FGS5","text":"Unity of the Absolute and its reflection → absolute self-relation → substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_DADW:AF1","text":"Indeterminate essence and unsubstantial appearance → unity of essence and existence → formed existence as appearance → reflection-into-another and reflection-into-itself → two reflected totalities → identical foundation and form of inner and outer → absolute actuality → external reflection as negative return → actuality, possibility, and necessity → substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_DADW:ME1","text":"The map of actuality shifts from separate determinations to a unity in which essence and existence are mutually constitutive of truth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ME2","text":"The opposition of inner and outer is reclassified from an ontological separation to a formal difference within identical foundations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ME3","text":"Appearance is elevated from a mere surface to a necessary mediating stage in the formation of actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ME4","text":"External reflection is remapped from an alien mode of consideration to a moment of the self-movement of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ME5","text":"Possibility, actuality, and necessity are arranged as graduated determinations of form of a single Absolute rather than as independent modal concepts.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ME6","text":"Substance is classified as the result of the identity of Absolute and reflection, not as a presupposed substrate behind appearances.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_DADW:ALT1","text":"Surface — Actuality is determined as the unity of essence and existence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ALT2","text":"Structural — Actuality arises through the formation of existence, the movement of reflection, and the relation of identity between inner and outer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ALT3","text":"Metastrategic — External differences are reframed as moments of an immanent self-movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:ALT4","text":"Ontological/Temporal — Reality is determined as the process of return from immediate existence through appearance and reflection into an absolute self-relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_DADW:MRT1","text":"The axioms are sufficient to reconstruct the transition from essence and existence to actuality, as well as from inner and outer to absolute totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT2","text":"The reconstruction remains underdetermined with respect to the more precise mediation between possibility, actuality, and necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT3","text":"The structure is internally coherent insofar as the identity of content and form is accepted as the supporting condition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT4","text":"Its strongest point is the systematic transformation of external difference into immanent movement of reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT5","text":"Its weakest point lies in the tension between the asserted external reflection and its simultaneous classification as negative self-movement of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT6","text":"The determination of substance as absolute self-relation is logically prepared, but only scantily mediated in relation to the preceding modal determinations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0003","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADW:MRT7","text":"The reconstruction preserves the actual movement of the text insofar as actuality is read not as an isolated endpoint, but as a transition to substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADW:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADW:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_DADW@R001","source_variant_id":"canonical:CH_GB18_DADW:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 154","title":"Third Section. Actuality.","context":"Chapter 154","original_title":"Dritter Abschnitt. Die Wirklichkeit."},"original_title":"Dritter Abschnitt. Die Wirklichkeit.","title_language_code":"en"},{"id":"CH_GB18_DADA","layer":"CH","title":"A. The Exposition of the Absolute.","order":155,"parents":["RAW_GB18_DADA"],"revision":"CH_GB18_DADA@R001","sha256":"be59f6255e66bcbcff14ee39edab93b885e65f6068c9d59f4b5ce292352e68c0","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_DADA:AS1","text":"Das Problem besteht darin, das Absolute darzustellen, ohne es durch äußerliche Bestimmung in endliche Prädikate aufzulösen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AS2","text":"Die negative Bestimmung des Absoluten als Aufhebung aller Bestimmungen erzeugt nur die abstrakte Leere und kann seine positive Wahrheit nicht tragen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AS3","text":"Das Absolute wird als Einheit von Seyn und Wesen beziehungsweise von Innerem und Äußerem bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AS4","text":"Die Auslegung des Absoluten muss als dessen eigene Selbstbewegung begriffen werden, in der die endlichen Bestimmungen aus ihrem eigenen Werden in ihren Grund zurückgehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AS5","text":"Das bloß als abstrakte Identität erreichte Absolute bleibt Produkt äußerer Reflexion und daher nur Attribut; erst die immanente Einheit von äußerer und innerer Reflexion macht es zum Absolut-Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_DADA:A1","text":"Das Absolute ist weder bloßes Seyn noch bloßes Wesen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A2","text":"Seyn und Wesen sind jeweils bestimmte Totalitäten und nicht das unbestimmte Absolute selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A3","text":"Das Absolute ist die absolute Einheit von Seyn und Wesen sowie von Innerem und Äußerem.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A4","text":"Das Absolute ist absolute Form, weil seine Momente jeweils selbst Totalität sind.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A5","text":"Das Absolute ist absoluter Inhalt, weil seine Mannigfaltigkeit durch negative Formbeziehung in einer gediegenen Identität besteht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A6","text":"Jede Bestimmtheit im Absoluten ist ein durchsichtiger Schein und kein selbständiger Unterschied.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A7","text":"Endliche und reflektierte Bestimmungen haben ihren Grund im Absoluten und bestehen nur als in ihm aufgehobene Momente.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A8","text":"Die negative Auslegung besteht in der Aufhebung der Reflexionsbewegung und ihrer Bestimmungen im Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A9","text":"Die positive Auslegung erkennt das Endliche als auf das Absolute bezogen, kann es aber nur als verschwindendes Medium halten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A10","text":"Ein Absolutes, das nur als abstrakte Identität erreicht wird, ist durch äußere Reflexion bestimmt und daher nur Attribut.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A11","text":"Weil das Absolute die Identität von Innerem und Äußerem ist, ist die ihm äußerliche Reflexion unmittelbar auch innerlich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_DADA:NX1","text":"Das Absolute ist nicht als Summe oder Träger endlicher Prädikate bestimmbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX2","text":"Das Absolute ist nicht die unreflektierte Unmittelbarkeit des Seyns.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX3","text":"Das Absolute ist nicht das reflektierte Wesen als solches.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX4","text":"Das Absolute ist nicht abstrakte, unterschiedslose Identität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX5","text":"Das Absolute enthält kein Werden als eigene Seinsweise.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX6","text":"Der Schein ist nicht Nichts, aber auch kein selbständiges Sein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX7","text":"Die positive Auslegung ist nicht die unmittelbare Selbstauslegung des Absoluten, sofern sie von äußerlichen Bestimmungen ausgeht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX8","text":"Das Attribut ist nicht das Absolut-Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_DADA:D1","text":"Die Prädikation des Absoluten ist nur möglich, wenn Prädikate nicht als äußerlich beigefügte Bestimmungen, sondern als in der absoluten Identität aufgehobene Momente gelten.","refs":["CH_GB18_DADA:A3","CH_GB18_DADA:A6","CH_GB18_DADA:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D2","text":"Die logische Bewegung von Seyn und Wesen besitzt ihren Wahrheitsstatus nur als Rückgang in den Grund des Absoluten.","refs":["CH_GB18_DADA:A1","CH_GB18_DADA:A3","CH_GB18_DADA:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D3","text":"Das Endliche zeigt das Absolute, indem es seine eigene Nichtselbständigkeit und seine Tendenz zum Verschwinden offenlegt.","refs":["CH_GB18_DADA:A6","CH_GB18_DADA:A7","CH_GB18_DADA:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D4","text":"Die positive Auslegung bleibt unzureichend, solange sie das Endliche als Ausdruck festhält, statt dessen vollständige Durchsichtigkeit zu vollziehen.","refs":["CH_GB18_DADA:A6","CH_GB18_DADA:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D5","text":"Die Opposition von immanenter und äußerer Reflexion kann nicht dauerhaft festgehalten werden, weil die absolute Einheit von Innerem und Äußerem ihre Trennung unterläuft.","refs":["CH_GB18_DADA:A3","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D6","text":"Das Attribut ist nicht ein äußerlicher Zusatz zum Absoluten, sondern die Weise, in der das Absolute durch seine eigene Form in sich erscheint.","refs":["CH_GB18_DADA:A4","CH_GB18_DADA:A10","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D7","text":"Die Selbstbestimmung des Absoluten ist keine Produktion eines neuen Inhalts, sondern die immanente Rücknahme der Differenz in ihre Identität.","refs":["CH_GB18_DADA:A4","CH_GB18_DADA:A5","CH_GB18_DADA:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_DADA:SD1","text":"Das Absolute fungiert zugleich als Grund, Abgrund und Aufhebungsort aller endlichen Bestimmungen; es begründet sie nur als nichtselbständige.","refs":["CH_GB18_DADA:A7","CH_GB18_DADA:A8","CH_GB18_DADA:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SD2","text":"Die Wahrheit der Endlichkeit besteht nicht in ihrem Bestand, sondern in ihrer transparenten Funktion als Selbsterscheinung des Absoluten.","refs":["CH_GB18_DADA:A6","CH_GB18_DADA:A9","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SD3","text":"Die logische Totalität wird als retrospektive Notwendigkeit organisiert: Was als selbständige Sphäre erschien, erweist sich nachträglich als Moment des absoluten Rückgangs.","refs":["CH_GB18_DADA:A2","CH_GB18_DADA:A7","CH_GB18_DADA:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SD4","text":"Die Differenz wird nicht einfach vernichtet, sondern als Form des Sich-Scheinens der absoluten Identität reklassifiziert.","refs":["CH_GB18_DADA:A4","CH_GB18_DADA:A6","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SD5","text":"Die Selbstauslegung des Absoluten verlangt eine Vermittlung, die zugleich als äußerlich erscheint und als immanente Operation zurückgenommen wird.","refs":["CH_GB18_DADA:A8","CH_GB18_DADA:A10","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_DADA:DNX1","text":"Ausgeschlossen ist ein Modell, in dem das Absolute vor oder außerhalb seiner Erscheinungen als fertig bestimmtes Substrat vorhanden wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:DNX2","text":"Ausgeschlossen ist ein Modell, in dem endliche Bestimmungen eigenständige ontologische Träger des Absoluten sein könnten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:DNX3","text":"Ausgeschlossen ist eine Erkenntnisform, die das Absolute durch äußere Zuschreibung oder empirische Sammlung von Bestimmungen erreichen könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:DNX4","text":"Ausgeschlossen ist eine bleibende Dualität von Inhalt und Form, von Grund und Erscheinung oder von Innerem und Äußerem.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_DADA:SNX1","text":"Unverfügbar ist ein absoluter Standpunkt außerhalb der Bewegung, von dem aus das Absolute als Gegenstand festgestellt werden könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SNX2","text":"Unzulässig ist die endgültige Selbständigkeit irgendeiner Differenz, weil jede Differenz als aufgehobener Schein der absoluten Identität bestimmt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SNX3","text":"Versperrt ist ein positives Absolutes ohne Negativität, weil das Absolute nur als Einheit gilt, die Reflexion und Bestimmung zugleich aufhebt und in sich erscheinen lässt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_DADA:FGS1","text":"Äußere Prädikation des Absoluten → Negation aller Prädikate → abstrakte Leere und formeller Widerspruch.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:FGS2","text":"Unterscheidung von Seyn und Wesen → Ausbildung von Innerem und Äußerem → Setzung ihrer absoluten Einheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:FGS3","text":"Absolute Einheit von Form und Inhalt → Transparenz aller Bestimmtheit → Degradierung der Differenz zum Schein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:FGS4","text":"Negative Auslegung der endlichen Bestimmungen → Rückgang ihrer Bewegung in den Grund → Nachweis ihrer Abhängigkeit vom Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:FGS5","text":"Unzulänglichkeit des bloß erreichten Identitätsabsoluten → Diagnose des Attributs → Immanentwerden der äußeren Reflexion → Selbstschein des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_DADA:AF1","text":"Die Unmöglichkeit äußerer Bestimmung → die negative Leere des prädikatlosen Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AF2","text":"Die negative Leere → die Bestimmung des Absoluten als Einheit von Seyn und Wesen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AF3","text":"Die Einheit von Seyn und Wesen → die Einheit von Innerem und Äußerem.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AF4","text":"Die absolute Einheit → die Umdeutung jeder Bestimmtheit in transparenten Schein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AF5","text":"Der Schein der Endlichkeit → die negative und positive Auslegung als Rückgang zum Grund.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AF6","text":"Das Defizit äußerer Auslegung → das Attribut → die immanente Selbstauslegung des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_DADA:ME1","text":"Die Unterscheidung zwischen Absolutem und Endlichem wird von einer Gegenüberstellung zweier Seiender in ein Grund-Schein-Verhältnis transformiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ME2","text":"Die Opposition von negativem und positivem Auslegen wird als asymmetrisch sichtbar: Das Positive besitzt keinen eigenen Inhalt neben dem Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ME3","text":"Die Kategorien Seyn, Wesen, Inneres, Äußeres, Ganzes, Teile und Kraft werden von selbständigen Bestimmungen zu untergehenden Reflexionsformen umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ME4","text":"Die Differenz zwischen äußerer und innerer Reflexion wird in eine selbstaufhebende Differenz überführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ME5","text":"Das Attribut wird von einer sekundären Bestimmung zu einer notwendigen Erscheinungsweise absoluter Form verschoben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_DADA:ALT1","text":"Surface — Das Absolute wird gegen Seyn, Wesen, endliche Bestimmung und äußerliche Prädikation abgegrenzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ALT2","text":"Structural — Alle bestimmten Kategorien erhalten ihren Status durch ihren Rückgang in einen Grund, der ihre Selbständigkeit aufhebt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ALT3","text":"Metastrategic — Die Auslegung wird von einer externen Erkenntnishandlung in die eigene Operation ihres Gegenstands transformiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ALT4","text":"Ontological/Temporal — Werden, Bewegung und Differenz gehören nicht dem Absoluten als unmittelbarem Sein zu, sondern erscheinen als aufgehobene Vermittlung seiner Selbsterscheinung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_DADA:MRT1","text":"Die Axiome reichen aus, um die Bewegung von negativer Prädikationskritik über absolute Einheit bis zur immanenten Reflexion zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT2","text":"Unterbestimmt bleibt, wie die absolute Form ihre Bestimmung zum Attribut vollzieht, ohne erneut eine unterscheidbare Bewegung im Absoluten einzuführen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT3","text":"Die Struktur ist kohärent, sofern äußere Reflexion nur vorläufig als äußerlich gilt und durch die Einheit von Innerem und Äußerem immanent wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT4","text":"Die stärkste Operation besteht in der Verbindung von Aufhebung endlicher Selbständigkeit und Erhaltung des Scheins als bezogener Erscheinung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT5","text":"Die zentrale Bruchlinie liegt zwischen der Behauptung, im Absoluten sei kein Werden, und der Behauptung, seine Auslegung sei eigenes, bei sich beginnendes und bei sich ankommendes Tun.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT6","text":"Eine zweite Bruchlinie liegt darin, dass positive Auslegung als äußerlich und nichtig verworfen wird, aber der Übergang zur Selbstauslegung weiterhin die Form des Auslegens benötigt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0013","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT7","text":"Die Rekonstruktion bewahrt die tatsächliche Argumentbewegung nur dann, wenn das Attribut nicht als Endresultat äußerer Reflexion, sondern als deren immanente Umkehr begriffen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T114901465444Z_3cf3e5c0","language_code":"en","language_name":"English","title":"A. The Exposition of the Absolute.","source_sha256":"be59f6255e66bcbcff14ee39edab93b885e65f6068c9d59f4b5ce292352e68c0","sha256":"1f9c93c2a6ad551ad6824cb2c5bb948284bdab057fa680e54f7432aa7661f80d","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:49:01.467504+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_DADA:AS1","text":"The problem consists in presenting the Absolute without dissolving it into finite predicates through external determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AS2","text":"The negative determination of the Absolute as the sublation of all determinations produces only abstract emptiness and cannot bear its positive truth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AS3","text":"The Absolute is determined as the unity of Being and Essence, or respectively of Inner and Outer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AS4","text":"The exposition of the Absolute must be conceived as its own self-movement, in which finite determinations return from their own becoming into their ground.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AS5","text":"The Absolute attained merely as abstract identity remains the product of external reflection and is therefore only attribute; only the immanent unity of external and internal reflection makes it the Absolute-Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_DADA:A1","text":"The Absolute is neither mere Being nor mere Essence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A2","text":"Being and Essence are each determinate totalities and not the indeterminate Absolute itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A3","text":"The Absolute is the absolute unity of Being and Essence, as well as of Inner and Outer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A4","text":"The Absolute is absolute form because its moments are each themselves totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A5","text":"The Absolute is absolute content because its multiplicity subsists through negative relation of form in a solid identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A6","text":"Every determinacy in the Absolute is a transparent semblance and not an independent difference.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A7","text":"Finite and reflected determinations have their ground in the Absolute and subsist only as moments sublated in it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A8","text":"The negative exposition consists in the sublation of the movement of reflection and its determinations in the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A9","text":"The positive exposition recognizes the finite as related to the Absolute, but can hold it only as a vanishing medium.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A10","text":"An Absolute attained only as abstract identity is determined by external reflection and is therefore only attribute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:A11","text":"Because the Absolute is the identity of Inner and Outer, the reflection external to it is immediately also internal.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_DADA:NX1","text":"The Absolute cannot be determined as a sum or bearer of finite predicates.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX2","text":"The Absolute is not the unreflected immediacy of Being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX3","text":"The Absolute is not reflected Essence as such.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX4","text":"The Absolute is not abstract, distinctionless identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX5","text":"The Absolute contains no becoming as its own mode of being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX6","text":"Semblance is not nothing, but neither is it independent being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX7","text":"The positive exposition is not the immediate self-exposition of the Absolute insofar as it proceeds from external determinations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:NX8","text":"The attribute is not the Absolute-Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_DADA:D1","text":"Predication of the Absolute is possible only if predicates are regarded not as externally appended determinations, but as moments sublated in absolute identity.","refs":["CH_GB18_DADA:A3","CH_GB18_DADA:A6","CH_GB18_DADA:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D2","text":"The logical movement of Being and Essence possesses its truth-status only as return into the ground of the Absolute.","refs":["CH_GB18_DADA:A1","CH_GB18_DADA:A3","CH_GB18_DADA:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D3","text":"The finite displays the Absolute by disclosing its own non-independence and its tendency to vanish.","refs":["CH_GB18_DADA:A6","CH_GB18_DADA:A7","CH_GB18_DADA:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D4","text":"The positive exposition remains inadequate so long as it holds fast to the finite as expression instead of carrying out its complete transparency.","refs":["CH_GB18_DADA:A6","CH_GB18_DADA:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D5","text":"The opposition of immanent and external reflection cannot be permanently maintained, because the absolute unity of Inner and Outer undermines their separation.","refs":["CH_GB18_DADA:A3","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D6","text":"The attribute is not an external addition to the Absolute, but the manner in which the Absolute appears in itself through its own form.","refs":["CH_GB18_DADA:A4","CH_GB18_DADA:A10","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:D7","text":"The self-determination of the Absolute is not a production of new content, but the immanent retraction of difference into its identity.","refs":["CH_GB18_DADA:A4","CH_GB18_DADA:A5","CH_GB18_DADA:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_DADA:SD1","text":"The Absolute functions at once as ground, abyss, and site of sublation of all finite determinations; it grounds them only as non-independent.","refs":["CH_GB18_DADA:A7","CH_GB18_DADA:A8","CH_GB18_DADA:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SD2","text":"The truth of finitude consists not in its subsistence, but in its transparent function as the self-appearance of the Absolute.","refs":["CH_GB18_DADA:A6","CH_GB18_DADA:A9","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SD3","text":"Logical totality is organized as retrospective necessity: what appeared as an independent sphere proves retrospectively to be a moment of absolute return.","refs":["CH_GB18_DADA:A2","CH_GB18_DADA:A7","CH_GB18_DADA:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SD4","text":"Difference is not simply annihilated, but reclassified as a form of the self-appearing of absolute identity.","refs":["CH_GB18_DADA:A4","CH_GB18_DADA:A6","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SD5","text":"The self-exposition of the Absolute requires a mediation that at once appears as external and is retracted as an immanent operation.","refs":["CH_GB18_DADA:A8","CH_GB18_DADA:A10","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_DADA:DNX1","text":"Excluded is a model in which the Absolute would be present before or outside its appearances as a fully determined substrate.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:DNX2","text":"Excluded is a model in which finite determinations could be autonomous ontological bearers of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:DNX3","text":"Excluded is a form of cognition that could attain the Absolute through external attribution or empirical collection of determinations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:DNX4","text":"Excluded is an enduring duality of content and form, of ground and appearance, or of Inner and Outer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_DADA:SNX1","text":"Unavailable is an absolute standpoint outside movement, from which the Absolute could be established as an object.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SNX2","text":"Inadmissible is the final independence of any difference, because every difference is determined as sublated semblance of absolute identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:SNX3","text":"Barred is a positive Absolute without negativity, because the Absolute counts only as a unity that at once sublates reflection and determination and lets them appear within itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_DADA:FGS1","text":"External predication of the Absolute → negation of all predicates → abstract emptiness and formal contradiction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:FGS2","text":"Distinction of Being and Essence → formation of Inner and Outer → positing of their absolute unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:FGS3","text":"Absolute unity of form and content → transparency of all determinacy → degradation of difference to semblance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:FGS4","text":"Negative exposition of finite determinations → return of their movement into the ground → demonstration of their dependence on the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:FGS5","text":"Inadequacy of the merely attained identity-Absolute → diagnosis of the attribute → external reflection becoming immanent → self-appearance of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_DADA:AF1","text":"The impossibility of external determination → the negative emptiness of the predicate-less Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AF2","text":"The negative emptiness → the determination of the Absolute as unity of Being and Essence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AF3","text":"The unity of Being and Essence → the unity of Inner and Outer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AF4","text":"Absolute unity → reinterpretation of every determinacy as transparent semblance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AF5","text":"The semblance of finitude → negative and positive exposition as return to the ground.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:AF6","text":"The deficit of external exposition → the attribute → the immanent self-exposition of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_DADA:ME1","text":"The distinction between Absolute and finite is transformed from an opposition of two beings into a ground-semblance relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ME2","text":"The opposition of negative and positive exposition becomes visible as asymmetrical: the positive possesses no content of its own alongside the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ME3","text":"The categories Being, Essence, Inner, Outer, Whole, Parts, and Force are reclassified from independent determinations into perishing forms of reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ME4","text":"The difference between external and internal reflection is transformed into a self-sublating difference.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ME5","text":"The attribute is shifted from a secondary determination to a necessary mode of appearance of absolute form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_DADA:ALT1","text":"Surface — The Absolute is delimited against Being, Essence, finite determination, and external predication.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ALT2","text":"Structural — All determinate categories receive their status through their return into a ground that sublates their independence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ALT3","text":"Metastrategic — Exposition is transformed from an external act of cognition into the operation of its own object.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:ALT4","text":"Ontological/Temporal — Becoming, movement, and difference do not belong to the Absolute as immediate being, but appear as sublated mediation of its self-appearance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_DADA:MRT1","text":"The axioms suffice to reconstruct the movement from negative critique of predication through absolute unity to immanent reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT2","text":"It remains underdetermined how absolute form carries out its determination into attribute without once again introducing a distinguishable movement in the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT3","text":"The structure is coherent insofar as external reflection counts as external only provisionally and becomes immanent through the unity of Inner and Outer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT4","text":"The strongest operation consists in conjoining the sublation of finite independence with the preservation of semblance as related appearance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT5","text":"The central fault line lies between the assertion that there is no becoming in the Absolute and the assertion that its exposition is an activity beginning with itself and arriving at itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT6","text":"A second fault line lies in the fact that positive exposition is rejected as external and null, yet the transition to self-exposition still requires the form of exposition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0013","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0014","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DADA:MRT7","text":"The reconstruction preserves the actual movement of argument only if the attribute is conceived not as the end-result of external reflection, but as its immanent reversal.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DADA:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DADA:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_DADA@R001","source_variant_id":"canonical:CH_GB18_DADA:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 155","title":"A. The Exposition of the Absolute.","context":"Chapter 155","original_title":"A. Die Auslegung des Absoluten."},"original_title":"A. Die Auslegung des Absoluten.","title_language_code":"en"},{"id":"CH_GB18_BDAA","layer":"CH","title":"B. The Absolute Attribute.","order":156,"parents":["RAW_GB18_BDAA"],"revision":"CH_GB18_BDAA@R001","sha256":"5f3872e2e9be740c1419debf2b19ae3fae8542b472f7f46e527a0f3d7224d9c5","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_BDAA:AS1","text":"Das Absolute wird als in seine Form zurückgekehrte Identität bestimmt, deren Form seinem Inhalt gleich ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS2","text":"Als Attribut erscheint das Absolute zunächst in einer Formbestimmung und ist dadurch nur das relative Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS3","text":"Weil die Form Form des Absoluten ist, umfasst das Attribut den gesamten Inhalt und die Totalität des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS4","text":"Im Absoluten verlieren die unterschiedenen unmittelbaren Seiten ihr selbständiges Bestehen und werden zum Schein herabgesetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS5","text":"Die Formbestimmung bleibt als unwesentliche Bestimmung bestehen, während die Totalität als einzig wahres Bestehen gesetzt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS6","text":"Die Reflexion hebt ihre Unterscheidung auf, erreicht dadurch jedoch nur abstrakte Identität und bleibt der Äußerlichkeit verhaftet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS7","text":"Sowohl äußere als auch innere Form erweisen sich daher als nichtige Form, äußerlicher Schein oder bloße Weise des Seins.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_BDAA:A1","text":"Das Absolute ist in seiner Form in sich zurückgekehrt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A2","text":"Im Absoluten ist die Form seinem Inhalt gleich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A3","text":"Das Attribut ist das Absolute in einer Formbestimmung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A4","text":"Die anfängliche Formbestimmung ist bestimmte Form oder Negation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A5","text":"Als Form des Absoluten enthält das Attribut den ganzen Inhalt des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A6","text":"Die Totalität des Attributs ist das wahre und einzige Bestehen des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A7","text":"Die unterschiedenen Unmittelbarkeiten des wesentlichen Verhältnisses besitzen im Absoluten kein selbständiges Bestehen mehr.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A8","text":"Die Bestimmung, in der das Absolute als Attribut erscheint, ist unwesentlich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A9","text":"Absolute Identität bedeutet sowohl die Aufhebung aller Bestimmungen als auch die Reflexion, die sich selbst aufgehoben hat.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A10","text":"Alle Bestimmungen sind im Absoluten als aufgehobene gesetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A11","text":"Die Formbestimmung des Attributs ist als bloßer Schein und das Negative als Negatives gesetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A12","text":"Die Auflösung des Endlichen in das Absolute hebt die attributive Form und die unterscheidende Tätigkeit selbst auf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A13","text":"Die Rückkehr der Reflexion zur Identität erzeugt nur unbestimmte, abstrakte Identität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A14","text":"Die innere Bestimmung durchdringt das Absolute nicht, sondern verschwindet als gesetzte Äußerung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A15","text":"Äußere und innere Form des Attributs sind an sich nichtig.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_BDAA:NX1","text":"Das Attribut ist kein selbständig neben dem Absoluten bestehendes Seiendes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX2","text":"Die unterschiedenen Seiten des Absoluten bestehen nicht als zwei eigenständige unmittelbare Welten fort.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX3","text":"Die Formbestimmung des Absoluten ist keine wesentliche Bestimmung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX4","text":"Das Endliche wird nicht als an und für sich seiend anerkannt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX5","text":"Die Bestimmungen des Absoluten bleiben nicht als unaufgehobene Bestimmungen bestehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX6","text":"Die Reflexion erreicht durch die Rückkehr zur Identität nicht das wahrhafte Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX7","text":"Die attributive Form ist weder als äußere noch als innere Form ein eigenständiger Seinsgrund.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX8","text":"Die Vielheit möglicher Attribute begründet keine Vielheit selbständiger absoluter Existenzen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_BDAA:D1","text":"Die Totalität, die zuvor als Welt oder als Seite eines wesentlichen Verhältnisses erschien, wird im Absoluten zur alleinigen Wirklichkeit der Bestimmung.","refs":["CH_GB18_BDAA:A5","CH_GB18_BDAA:A6","CH_GB18_BDAA:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:D2","text":"Mehrere Attribute können nur als weitere aufgehobene Formbestimmungen des einen absoluten Inhalts auftreten.","refs":["CH_GB18_BDAA:A9","CH_GB18_BDAA:A10","CH_GB18_BDAA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:D3","text":"Die Erweiterung des Endlichen zum Attribut beseitigt den selbständigen Status des Endlichen und zugleich den Status des Attributs.","refs":["CH_GB18_BDAA:A5","CH_GB18_BDAA:A11","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:D4","text":"Die Rückkehr der Reflexion zur absoluten Identität hebt die Unterscheidung auf, ohne die Äußerlichkeit der Reflexion zu überwinden.","refs":["CH_GB18_BDAA:A9","CH_GB18_BDAA:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:D5","text":"Die innere Form besitzt gegenüber der äußeren Form keine größere ontologische Selbständigkeit.","refs":["CH_GB18_BDAA:A14","CH_GB18_BDAA:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:D6","text":"Die attributive Bestimmung ist eine notwendige Erscheinungsweise des Absoluten, deren eigene Geltung im Vollzug ihrer Bestimmung verschwindet.","refs":["CH_GB18_BDAA:A3","CH_GB18_BDAA:A6","CH_GB18_BDAA:A11","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_BDAA:SD1","text":"Das System verwandelt das Attribut von einer positiven Bestimmung in eine selbstaufhebende Vermittlung zwischen absolutem Inhalt und nichtiger Form.","refs":["CH_GB18_BDAA:A3","CH_GB18_BDAA:A5","CH_GB18_BDAA:A11","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SD2","text":"Die frühere Gleichheit von Inhalt und Teilen wird im Absoluten in eine Einheit überführt, in der nur die Totalität besteht und die Teile ihre unmittelbare Eigenständigkeit verlieren.","refs":["CH_GB18_BDAA:A5","CH_GB18_BDAA:A6","CH_GB18_BDAA:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SD3","text":"Die Unterscheidung zwischen äußerer und innerer Form wird strukturell neutralisiert, weil beide Formen das Absolute nicht bestimmen können, ohne als Schein zu verschwinden.","refs":["CH_GB18_BDAA:A13","CH_GB18_BDAA:A14","CH_GB18_BDAA:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SD4","text":"Die Reflexion ist zugleich Erzeugungsbedingung der attributiven Bestimmung und unzureichend, um eine wahrhaft absolute Bestimmung hervorzubringen.","refs":["CH_GB18_BDAA:A3","CH_GB18_BDAA:A9","CH_GB18_BDAA:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SD5","text":"Absolute Identität wird als Totalisierung erzeugt, die jede bleibende Differenz nur in der Form ihres Aufgehobenseins zulässt.","refs":["CH_GB18_BDAA:A6","CH_GB18_BDAA:A9","CH_GB18_BDAA:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_BDAA:DNX1","text":"Ausgeschlossen ist ein Absolutes, dessen Attribute als mehrere voneinander unabhängige absolute Substanzen bestehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:DNX2","text":"Ausgeschlossen ist eine Identität, die durch bloße äußere Reflexion hergestellt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:DNX3","text":"Ausgeschlossen ist ein Endliches, dessen Grenze zugleich ein positiver eigener Seinsgrund bleibt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:DNX4","text":"Ausgeschlossen ist eine Form, die den absoluten Inhalt vermittelt, ohne selbst in bloßen Schein überzugehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:DNX5","text":"Ausgeschlossen ist eine dauerhafte ontologische Zweiteilung von Innerem und Äußerem bei identischem Inhalt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:DNX6","text":"Ausgeschlossen ist eine Differenz, die im Absoluten bestehen bleibt, ohne als aufgehobene Differenz bestimmt zu werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_BDAA:SNX1","text":"Unverfügbar bleibt eine positive Form des Absoluten, die zugleich bestimmt und nicht äußerlich wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SNX2","text":"Unmöglich bleibt ein Bestehen der Differenz, das nicht in die einfache Identität des Absoluten zurückgenommen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SNX3","text":"Der Diskurs ist um die Abwesenheit eines eigenständigen Seinsgrundes der Form organisiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SNX4","text":"Die Möglichkeit einer nicht selbstaufhebenden attributiven Bestimmung wird nicht entwickelt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Negative","confidence":"low","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_BDAA:FGS1","text":"Formbestimmung → bestimmte Form beziehungsweise Negation → Form des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:FGS2","text":"Form des Absoluten → Attribut als ganzer Inhalt → Totalität als wahres und einziges Bestehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:FGS3","text":"Totalität als einziges Bestehen → Aufhebung selbständiger Unmittelbarkeiten → Bestimmungen als aufgehobene.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:FGS4","text":"Aufgehobene Bestimmungen → attributive Form als bloßer Schein → Auflösung von Endlichem und Unterscheidung in das einfache Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:FGS5","text":"Rückkehr der Reflexion zur Identität → abstrakte Identität → Fortbestehen der Äußerlichkeit → Nichtigkeit äußerer und innerer Form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_BDAA:AF1","text":"Formgleichheit von Inhalt und Absolutem → Attribut als relatives Absolutes → Totalität als alleinige Existenz → Herabsetzung der Unterschiede zum Schein → Selbstaufhebung der attributiven Bestimmung → abstrakte Identität der Reflexion → Nichtigkeit jeder attributiven Form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_BDAA:ME1","text":"Das Attribut wird von einer möglichen Eigenschaft des Absoluten zu einer Form, in der der gesamte absolute Inhalt erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ME2","text":"Die Gegenüberstellung von erscheinender und an und für sich seiender Welt wird in die Einheit einer Totalität mit unwesentlicher Formbestimmung umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ME3","text":"Mehrere Attribute werden nicht mehr als mehrere absolute Zentren, sondern als aufgehobene Bestimmungen desselben Inhalts klassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ME4","text":"Die Unterscheidung zwischen äußerer und innerer Form verliert ihren Vorrang, weil beide als verschiedene Weisen desselben Scheins erscheinen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ME5","text":"Die Rückkehr zur Identität wird von einer vollendeten Absolutheit in eine bloß abstrakte Identität mit fortbestehender Äußerlichkeit umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_BDAA:ALT1","text":"Surface — Das Absolute erscheint als Attribut, sobald es in einer Formbestimmung gesetzt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ALT2","text":"Structural — Die Totalität erhält den Status des einzigen Bestehens, während Formbestimmung, Differenz und Unmittelbarkeit zu unwesentlichem Schein herabgesetzt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ALT3","text":"Metastrategic — Die Reflexion wird nicht als abschließende Erkenntnisbewegung anerkannt, sondern als Operation bestimmt, die ihre eigene Unterscheidung aufhebt und dennoch äußerlich bleibt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ALT4","text":"Ontological/Temporal — Sein wird der Totalität, nicht den einzelnen Bestimmungen, zugesprochen; die Form besitzt nur ein abgeleitetes und verschwindendes Bestehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_BDAA:MRT1","text":"Die Axiome reichen aus, um die Bewegung von der attributiven Formbestimmung über die Totalisierung bis zur Nichtigkeit der Form zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT2","text":"Unterbestimmt bleibt, wie die Möglichkeit mehrerer Attribute über ihre bloße formale Anknüpfbarkeit hinaus zu bestimmen wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT3","text":"Die interne Kohärenz beruht auf der konsequenten Unterscheidung zwischen absolutem Inhalt und unwesentlicher Formbestimmung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT4","text":"Die stärkste Operation des Systems ist die Selbstaufhebung der Form durch ihre Bestimmung als Form des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT5","text":"Eine strukturelle Spannung bleibt darin bestehen, dass das Attribut den ganzen Inhalt und das wahre Bestehen des Absoluten enthalten soll, zugleich aber nur relative und nichtige Form ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT6","text":"Eine weitere Spannung bleibt darin bestehen, dass die Reflexion zur Erzeugung der attributiven Bestimmung erforderlich ist, ihre Rückkehr zur Identität jedoch nicht über die Äußerlichkeit hinausführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT7","text":"Die Rekonstruktion bewahrt die tatsächliche Argumentbewegung, sofern die Aufhebung nicht als einfache Tilgung, sondern als Erzeugung einer Bestimmung verstanden wird, deren Geltung in ihrer eigenen Setzung verschwindet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T112706420007Z_d73d6d58","language_code":"en","language_name":"English","title":"B. The Absolute Attribute.","source_sha256":"5f3872e2e9be740c1419debf2b19ae3fae8542b472f7f46e527a0f3d7224d9c5","sha256":"f6011d188fb919a74703b09f139291e240f8f2941f4701332c13e66b7bea5b8c","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:27:06.422193+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_BDAA:AS1","text":"The Absolute is determined as identity returned into its form, whose form is equal to its content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS2","text":"As attribute, the Absolute initially appears in a determination of form and is thereby only the relative Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS3","text":"Because the form is form of the Absolute, the attribute encompasses the entire content and the totality of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS4","text":"In the Absolute, the distinguished immediate sides lose their independent subsistence and are reduced to semblance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS5","text":"The determination of form persists as an inessential determination, while totality is posited as the sole true subsistence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS6","text":"Reflection sublates its distinction, but thereby attains only abstract identity and remains bound to externality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:AS7","text":"Both external and internal form therefore prove to be null form, external semblance, or a mere mode of being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_BDAA:A1","text":"The Absolute has returned into itself in its form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A2","text":"In the Absolute, form is equal to its content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A3","text":"The attribute is the Absolute in a determination of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A4","text":"The initial determination of form is determinate form or negation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A5","text":"As form of the Absolute, the attribute contains the whole content of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A6","text":"The totality of the attribute is the true and sole subsistence of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A7","text":"The distinguished immediacies of the essential relation no longer possess independent subsistence in the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A8","text":"The determination in which the Absolute appears as attribute is inessential.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A9","text":"Absolute identity signifies both the sublation of all determinations and reflection that has sublated itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A10","text":"All determinations are posited in the Absolute as sublated.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A11","text":"The determination of form of the attribute is posited as mere semblance, and the negative as negative.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A12","text":"The dissolution of the finite into the Absolute sublates attributive form and the distinguishing activity itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A13","text":"The return of reflection to identity produces only indeterminate, abstract identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A14","text":"The internal determination does not penetrate the Absolute, but disappears as posited externalization.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:A15","text":"The external and internal forms of the attribute are null in themselves.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_BDAA:NX1","text":"The attribute is not an entity existing independently alongside the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX2","text":"The distinguished sides of the Absolute do not persist as two independent immediate worlds.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX3","text":"The determination of form of the Absolute is not an essential determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX4","text":"The finite is not recognized as being in and for itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX5","text":"The determinations of the Absolute do not persist as unsubated determinations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX6","text":"Through its return to identity, reflection does not attain the true Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX7","text":"Attributive form is, neither as external nor as internal form, an independent ground of being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:NX8","text":"The multiplicity of possible attributes does not establish a multiplicity of independent absolute existences.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_BDAA:D1","text":"The totality that previously appeared as world or as a side of an essential relation becomes, in the Absolute, the sole actuality of determination.","refs":["CH_GB18_BDAA:A5","CH_GB18_BDAA:A6","CH_GB18_BDAA:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:D2","text":"Several attributes can occur only as further sublated determinations of form of the one absolute content.","refs":["CH_GB18_BDAA:A9","CH_GB18_BDAA:A10","CH_GB18_BDAA:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:D3","text":"The expansion of the finite into the attribute abolishes the independent status of the finite and, at the same time, the status of the attribute.","refs":["CH_GB18_BDAA:A5","CH_GB18_BDAA:A11","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:D4","text":"The return of reflection to absolute identity sublates the distinction without overcoming the externality of reflection.","refs":["CH_GB18_BDAA:A9","CH_GB18_BDAA:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:D5","text":"Internal form possesses no greater ontological independence than external form.","refs":["CH_GB18_BDAA:A14","CH_GB18_BDAA:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:D6","text":"The attributive determination is a necessary mode of appearance of the Absolute, whose own validity disappears in the enactment of its determination.","refs":["CH_GB18_BDAA:A3","CH_GB18_BDAA:A6","CH_GB18_BDAA:A11","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_BDAA:SD1","text":"The system transforms the attribute from a positive determination into a self-sublating mediation between absolute content and null form.","refs":["CH_GB18_BDAA:A3","CH_GB18_BDAA:A5","CH_GB18_BDAA:A11","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SD2","text":"The earlier equality of content and parts is transferred, in the Absolute, into a unity in which only totality subsists and the parts lose their immediate independence.","refs":["CH_GB18_BDAA:A5","CH_GB18_BDAA:A6","CH_GB18_BDAA:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SD3","text":"The distinction between external and internal form is structurally neutralized because neither form can determine the Absolute without disappearing as semblance.","refs":["CH_GB18_BDAA:A13","CH_GB18_BDAA:A14","CH_GB18_BDAA:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SD4","text":"Reflection is at once the condition for the production of attributive determination and insufficient for bringing forth a genuinely absolute determination.","refs":["CH_GB18_BDAA:A3","CH_GB18_BDAA:A9","CH_GB18_BDAA:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SD5","text":"Absolute identity is produced as a totalization that permits every enduring difference only in the form of its sublatedness.","refs":["CH_GB18_BDAA:A6","CH_GB18_BDAA:A9","CH_GB18_BDAA:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_BDAA:DNX1","text":"Excluded is an Absolute whose attributes subsist as several mutually independent absolute substances.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:DNX2","text":"Excluded is an identity produced through mere external reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:DNX3","text":"Excluded is a finite whose limit simultaneously remains a positive ground of being of its own.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:DNX4","text":"Excluded is a form that mediates absolute content without itself passing over into mere semblance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:DNX5","text":"Excluded is a lasting ontological bifurcation of inner and outer with identical content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:DNX6","text":"Excluded is a difference that remains in the Absolute without being determined as a sublated difference.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_BDAA:SNX1","text":"Unavailable remains a positive form of the Absolute that would be both determinate and non-external.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SNX2","text":"Impossible remains a subsistence of difference that is not taken back into the simple identity of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SNX3","text":"The discourse is organized around the absence of an independent ground of being of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:SNX4","text":"The possibility of a non-self-sublating attributive determination is not developed.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Negative","confidence":"low","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_BDAA:FGS1","text":"Determination of form → determinate form or negation → form of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:FGS2","text":"Form of the Absolute → attribute as whole content → totality as true and sole subsistence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:FGS3","text":"Totality as sole subsistence → sublation of independent immediacies → determinations as sublated.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:FGS4","text":"Sublated determinations → attributive form as mere semblance → dissolution of the finite and distinction into the simple Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:FGS5","text":"Return of reflection to identity → abstract identity → persistence of externality → nullity of external and internal form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_BDAA:AF1","text":"Equality of form between content and the Absolute → attribute as relative Absolute → totality as sole existence → reduction of differences to semblance → self-sublation of attributive determination → abstract identity of reflection → nullity of every attributive form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_BDAA:ME1","text":"The attribute is transformed from a possible property of the Absolute into a form in which the entire absolute content appears.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ME2","text":"The opposition of the appearing world and the world that is in and for itself is remapped into the unity of a totality with inessential determination of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ME3","text":"Several attributes are no longer classified as several absolute centers, but as sublated determinations of the same content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ME4","text":"The distinction between external and internal form loses its primacy because both appear as different modes of the same semblance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ME5","text":"The return to identity is reclassified from a completed absoluteness into merely abstract identity with persisting externality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_BDAA:ALT1","text":"Surface — The Absolute appears as attribute as soon as it is posited in a determination of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ALT2","text":"Structural — Totality receives the status of the sole subsistence, while determination of form, difference, and immediacy are reduced to inessential semblance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ALT3","text":"Metastrategic — Reflection is not recognized as a conclusive movement of cognition, but determined as an operation that sublates its own distinction and yet remains external.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:ALT4","text":"Ontological/Temporal — Being is ascribed to totality, not to individual determinations; form possesses only a derivative and vanishing subsistence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_BDAA:MRT1","text":"The axioms suffice to reconstruct the movement from attributive determination of form, through totalization, to the nullity of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT2","text":"It remains underdetermined how the possibility of several attributes would be determined beyond their mere formal connectability.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Direct","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT3","text":"The internal coherence rests on the consistent distinction between absolute content and inessential determination of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT4","text":"The strongest operation of the system is the self-sublation of form through its determination as form of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT5","text":"A structural tension remains in that the attribute is supposed to contain the whole content and the true subsistence of the Absolute, while at the same time being only relative and null form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT6","text":"A further tension remains in that reflection is required for the production of attributive determination, yet its return to identity does not lead beyond externality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDAA:MRT7","text":"The reconstruction preserves the actual movement of the argument insofar as sublation is understood not as simple erasure, but as the production of a determination whose validity disappears in its own positing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDAA:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDAA:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_BDAA@R001","source_variant_id":"canonical:CH_GB18_BDAA:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 156","title":"B. The Absolute Attribute.","context":"Chapter 156","original_title":"B. Das absolute Attribut."},"original_title":"B. Das absolute Attribut.","title_language_code":"en"},{"id":"CH_GB18_CDMD","layer":"CH","title":"C. The Mode of the Absolute.","order":157,"parents":["RAW_GB18_CDMD"],"revision":"CH_GB18_CDMD@R001","sha256":"e6f1eef9de1439fde56d231630af7d1d2fabac9f782895f674952e2be874741e","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_CDMD:AS1","text":"Die Auslegung des Absoluten muss erklären, wie einfache Identität sich als Bestimmtheit und Äußerlichkeit setzt, ohne in ein anderes Sein überzugehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:AS2","text":"Das Argument ist rekonstruktiv: Es bestimmt Attribut und Modus als Momente der eigenen reflektierenden Bewegung des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:AS3","text":"Die Folge Identität → Attribut → Modus wird von einer scheinbar äußerlichen Abfolge in eine immanente Selbstbewegung umgedeutet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:AS4","text":"Der Modus ist nicht bloßer Verlust des Absoluten in Veränderlichkeit, sondern gesetzte Äußerlichkeit und damit Schein als Schein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:AS5","text":"Im Schein als Schein kehrt die Äußerlichkeit in die Reflexion-in-sich zurück und setzt die absolute Identität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:AS6","text":"Die selbsttragende Bewegung der Auslegung wird als absolute Manifestation, absoluter Inhalt und Wirklichkeit bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_CDMD:A1","text":"Das Absolute ist zunächst einfache Identität mit sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A2","text":"Die Negation des Absoluten ist formelle Reflexion-in-sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A3","text":"Das Attribut vermittelt zwischen dem Absoluten als Identität und dem Absoluten als Bestimmtheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A4","text":"Das Negative als Negatives ist dem Absoluten zunächst äußerliche Reflexion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A5","text":"Der Modus ist die Äußerlichkeit des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A6","text":"Der Modus ist die als Äußerlichkeit gesetzte Äußerlichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A7","text":"Schein als Schein ist Reflexion der Form in sich und damit Identität mit sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A8","text":"Die Bewegung von Identität über Attribut zum Modus ist die reflektierende Eigenbewegung des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A9","text":"Die erste indifferente Identität ist selbst bereits ein bestimmtes Absolutes und damit Attribut.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A10","text":"Das Bestimmen des Modus macht das Absolute nicht zu einem Anderen, sondern bestimmt nur, was es bereits ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A11","text":"Das Sein-nach-Außen des Absoluten ist ebenso sehr seine Innerlichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A12","text":"Die absolute Form ist als Entzweiung schlechthin identisch mit sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A13","text":"Der Inhalt des Absoluten ist seine eigene Auslegung beziehungsweise Manifestation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A14","text":"Die selbsttragende Bewegung des Absoluten ist Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_CDMD:NX1","text":"Der Modus ist nicht bloß Verlust des Absoluten in Veränderlichkeit und Zufälligkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX2","text":"Die Äußerlichkeit des Modus ist nicht die äußerste, vom Absoluten getrennte Äußerlichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX3","text":"Die Auslegung ist nicht bloß ein negatives Verhalten gegenüber vorgefundenen Bestimmungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX4","text":"Die reflektierende Bewegung führt die Bestimmungen nicht lediglich in eine indifferente Identität zurück.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX5","text":"Das Absolute ist nicht das sich lediglich Gleichbleibende, sondern das sich selbst Gleichsetzende.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX6","text":"Das Bestimmen des Absoluten setzt kein anderes Sein gegen das Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX7","text":"Das Absolute manifestiert nicht ein verborgenes Inneres gegenüber einem Anderen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX8","text":"Form und Inhalt sind im Absoluten nicht als selbstständige Gegensätze erhalten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_CDMD:D1","text":"Im Modus wird die absolute Identität erstmals ausdrücklich als absolute Identität gesetzt.","refs":["CH_GB18_CDMD:A5","CH_GB18_CDMD:A6","CH_GB18_CDMD:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D2","text":"Die scheinbare Abfolge von Identität, Attribut und Modus ist eine vollständige Bewegung der absoluten Reflexion.","refs":["CH_GB18_CDMD:A3","CH_GB18_CDMD:A8","CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D3","text":"Die Bestimmtheit des Absoluten ist keine äußerlich hinzutretende Bestimmung, sondern gehört der reflektierenden Bewegung selbst an.","refs":["CH_GB18_CDMD:A8","CH_GB18_CDMD:A9","CH_GB18_CDMD:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D4","text":"Die gesetzte Äußerlichkeit des Modus ist Rückkehr in sich und daher absolutes Sein.","refs":["CH_GB18_CDMD:A6","CH_GB18_CDMD:A7","CH_GB18_CDMD:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D5","text":"Die Identität des Absoluten ist eine sich hervorbringende Identität und keine vorausgesetzte statische Gleichheit.","refs":["CH_GB18_CDMD:A1","CH_GB18_CDMD:A8","CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D6","text":"Der Inhalt des Absoluten besteht nicht neben seiner Form, sondern in der Bewegung seiner eigenen Auslegung.","refs":["CH_GB18_CDMD:A12","CH_GB18_CDMD:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D7","text":"Wirklichkeit bezeichnet die Einheit von absoluter Identität, Selbstmanifestation und selbsttragender Bewegung.","refs":["CH_GB18_CDMD:A11","CH_GB18_CDMD:A13","CH_GB18_CDMD:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_CDMD:SD1","text":"Das Absolute ist kein ruhender Träger von Attributen und Modi, sondern die Bewegung, in der es sich als solcher Träger bestimmt.","refs":["CH_GB18_CDMD:A1","CH_GB18_CDMD:A8","CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SD2","text":"Äußerlichkeit besitzt keinen eigenständigen ontologischen Status außerhalb der absoluten Reflexion.","refs":["CH_GB18_CDMD:A5","CH_GB18_CDMD:A6","CH_GB18_CDMD:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SD3","text":"Die Unterscheidungen von Innerem und Äußerem sowie von Form und Inhalt werden in eine einzige Bewegung der Selbstmanifestation überführt.","refs":["CH_GB18_CDMD:A11","CH_GB18_CDMD:A12","CH_GB18_CDMD:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SD4","text":"Die Auslegung ist nicht äußerliche Erkenntnis des Absoluten, sondern die Weise, in der das Absolute sich selbst bestimmt und zeigt.","refs":["CH_GB18_CDMD:A8","CH_GB18_CDMD:A10","CH_GB18_CDMD:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SD5","text":"Wirklichkeit ist nicht ein Ergebnis jenseits der Bewegung, sondern die Bewegung des Absoluten in ihrer selbstmanifestierenden Form.","refs":["CH_GB18_CDMD:A11","CH_GB18_CDMD:A13","CH_GB18_CDMD:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_CDMD:DNX1","text":"Ausgeschlossen ist ein statisches Absolutes, dessen Identität ohne Reflexion und Selbstsetzung vollständig wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:DNX2","text":"Ausgeschlossen ist eine selbstständige Äußerlichkeit, die dem Absoluten unabhängig gegenübersteht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:DNX3","text":"Ausgeschlossen ist ein verborgenes Inneres, dessen Äußerung als Übergang in ein anderes verstanden werden müsste.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:DNX4","text":"Ausgeschlossen ist eine Bestimmtheit, die dem Absoluten äußerlich hinzugefügt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:DNX5","text":"Ausgeschlossen ist ein vom Vollzug der Auslegung unabhängiger Inhalt des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:DNX6","text":"Ausgeschlossen ist eine Wirklichkeit, die erst nach oder außerhalb der absoluten Selbstbewegung eintritt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_CDMD:SNX1","text":"Unmöglich wird ein Absolutes, dessen Manifestation von einem verborgenen Inneren oder einem gegenüberstehenden Anderen abhängt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SNX2","text":"Versperrt ist die Möglichkeit einer echten Außenposition gegenüber dem Absoluten, von der aus seine Bestimmungen aufgenommen und zurückgeführt werden könnten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SNX3","text":"Abwesend bleibt ein selbstständiger Inhalt jenseits der Auslegung; diese Abwesenheit strukturiert die Bestimmung des Absoluten als absolute Form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SNX4","text":"Nicht verfügbar ist eine Negation, die das Absolute endgültig in ein Anderes überführt und keine Rückkehr in sich zulässt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SNX5","text":"Unzulässig ist jede Trennung von Identität und Differenz, in der die Differenz außerhalb der Identität verbleibt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_CDMD:FGS1","text":"Einfache Identität plus Negation erzeugt das Absolute als Identität, die sich bestimmen muss.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS2","text":"Die sich bestimmende Identität erscheint als Attribut, weil die erste Identität selbst bereits Bestimmtheit enthält.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS3","text":"Die Bestimmtheit tritt als Äußerlichkeit hervor und wird zum Modus des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS4","text":"Die gesetzte Äußerlichkeit wird als Äußerlichkeit erkannt und dadurch zum Schein als Schein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS5","text":"Schein als Schein reflektiert die Form in sich, wodurch Äußerlichkeit zugleich Innerlichkeit und absolute Identität wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS6","text":"Die zurückkehrende Reflexion bestimmt nur das bereits Seiende und hebt die Trennung von Form und Inhalt auf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS7","text":"Die Auslegung wird zum einzigen Inhalt des Absoluten und als selbsttragende Manifestation zur Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_CDMD:AF1","text":"Einfache Identität → Negation und Bestimmtheit → Attribut als Mitte → Äußerlichkeit des Absoluten → gesetzte Äußerlichkeit als Schein → Rückkehr der Form in sich → Auflösung von Form und Inhalt → selbstmanifestierende Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_CDMD:ME1","text":"Der Modus wird von einem äußerlichen Verlustzustand zu einer immanenten Selbstbewegung des Absoluten umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ME2","text":"Attribut und Modus erscheinen nicht mehr als äußerlich vorgefundene Prädikate, sondern als Stufen der absoluten Selbstbestimmung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ME3","text":"Der Gegensatz von Erscheinung und absoluter Identität wird durch die Kategorie des Scheins als Schein reorganisiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ME4","text":"Der Gegensatz von Form und Inhalt zerfällt, weil die Auslegung selbst den Inhalt des Absoluten bildet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ME5","text":"Wirklichkeit wird nicht als von der Bewegung getrenntes Resultat, sondern als deren selbstmanifestierende Gestalt klassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_CDMD:ALT1","text":"**Surface:** Das Absolute wird in die Bestimmungen Identität, Attribut und Modus gegliedert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ALT2","text":"**Structural:** Äußerlichkeit wird als gesetzte und in sich zurückkehrende Reflexionsstruktur bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ALT3","text":"**Metastrategic:** Die Auslegung wird von einer äußerlichen Betrachtung in den Eigenvollzug des Absoluten umgerahmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ALT4","text":"**Ontological/Temporal:** Sein ist als selbstsetzende, sich äußernde und in sich zurückkehrende Bewegung organisiert; ein unabhängiger Übergang in ein Anderes wird ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_CDMD:MRT1","text":"Die Axiome reichen aus, um die Bewegung von einfacher Identität über Attribut und Modus zur Selbstmanifestation zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT2","text":"Unterbestimmt bleibt, wie die anfänglich äußerliche Negation und die spätere sich auf sich beziehende Negativität genau unterschieden oder vermittelt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT3","text":"Die Bestimmung des Modus als Verlust ohne Rückkehr und seine spätere Bestimmung als Rückkehr in sich werden durch begriffliche Umdeutung, nicht durch ein zusätzliches Vermittlungsglied, verbunden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT4","text":"Die Konstruktion bleibt intern kohärent, sofern Äußerlichkeit von Anfang an als Moment der absoluten Reflexion verstanden wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT5","text":"Ihre stärkste Stelle ist die Ableitung von Selbstidentität aus Selbstsetzung statt aus bloßer Gleichheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT6","text":"Ihre argumentative Geschlossenheit hängt von der Aufhebung der Gegensätze innerlich/äußerlich und Form/Inhalt ab, die eher gesetzt als unabhängig bewiesen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT7","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung: Identität → Bestimmtheit → Äußerlichkeit → Rückkehr → Manifestation → Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T114152581642Z_b46b3f9b","language_code":"en","language_name":"English","title":"C. The Mode of the Absolute.","source_sha256":"e6f1eef9de1439fde56d231630af7d1d2fabac9f782895f674952e2be874741e","sha256":"7758174cb0c886ef478aba9dc0bf5c44e4a0f2de9772bcefc98b4904ceb5348a","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:41:52.584445+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_CDMD:AS1","text":"The exposition of the Absolute must explain how simple identity posits itself as determinacy and externality without passing over into another being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:AS2","text":"The argument is reconstructive: it determines attribute and mode as moments of the Absolute's own reflective movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:AS3","text":"The sequence identity → attribute → mode is reinterpreted from an apparently external succession into an immanent self-movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:AS4","text":"The mode is not a mere loss of the Absolute in changeability, but posited externality and thus semblance as semblance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:AS5","text":"In semblance as semblance, externality returns into reflection-into-self and posits absolute identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:AS6","text":"The self-sustaining movement of exposition is determined as absolute manifestation, absolute content, and actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_CDMD:A1","text":"The Absolute is initially simple identity with itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A2","text":"The negation of the Absolute is formal reflection-into-self.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A3","text":"The attribute mediates between the Absolute as identity and the Absolute as determinacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A4","text":"The negative as negative is initially reflection external to the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A5","text":"The mode is the externality of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A6","text":"The mode is externality posited as externality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A7","text":"Semblance as semblance is the reflection of form into itself and thereby identity with itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A8","text":"The movement from identity through attribute to mode is the reflective self-movement of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A9","text":"The first indifferent identity is itself already a determinate Absolute and thereby attribute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A10","text":"The determining of the mode does not make the Absolute into an Other, but determines only what it already is.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A11","text":"The being-outward of the Absolute is equally its inwardness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A12","text":"Absolute form, as diremption, is simply identical with itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A13","text":"The content of the Absolute is its own exposition or manifestation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:A14","text":"The self-sustaining movement of the Absolute is actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_CDMD:NX1","text":"The mode is not merely the loss of the Absolute in changeability and contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX2","text":"The externality of the mode is not the utmost externality separated from the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX3","text":"The exposition is not merely a negative comportment toward determinations found at hand.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX4","text":"The reflective movement does not merely lead the determinations back into an indifferent identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX5","text":"The Absolute is not that which merely remains the same, but that which equates itself with itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX6","text":"The determining of the Absolute posits no other being over against the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX7","text":"The Absolute does not manifest a hidden inwardness over against an Other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:NX8","text":"Form and content are not preserved in the Absolute as self-subsistent opposites.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_CDMD:D1","text":"In the mode, absolute identity is for the first time explicitly posited as absolute identity.","refs":["CH_GB18_CDMD:A5","CH_GB18_CDMD:A6","CH_GB18_CDMD:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D2","text":"The apparent sequence of identity, attribute, and mode is a complete movement of absolute reflection.","refs":["CH_GB18_CDMD:A3","CH_GB18_CDMD:A8","CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D3","text":"The determinacy of the Absolute is not a determination externally added, but belongs to the reflective movement itself.","refs":["CH_GB18_CDMD:A8","CH_GB18_CDMD:A9","CH_GB18_CDMD:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D4","text":"The posited externality of the mode is return into itself and therefore absolute being.","refs":["CH_GB18_CDMD:A6","CH_GB18_CDMD:A7","CH_GB18_CDMD:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D5","text":"The identity of the Absolute is a self-producing identity and not a presupposed static equality.","refs":["CH_GB18_CDMD:A1","CH_GB18_CDMD:A8","CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D6","text":"The content of the Absolute does not subsist alongside its form, but in the movement of its own exposition.","refs":["CH_GB18_CDMD:A12","CH_GB18_CDMD:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:D7","text":"Actuality designates the unity of absolute identity, self-manifestation, and self-sustaining movement.","refs":["CH_GB18_CDMD:A11","CH_GB18_CDMD:A13","CH_GB18_CDMD:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_CDMD:SD1","text":"The Absolute is not a resting bearer of attributes and modes, but the movement in which it determines itself as such a bearer.","refs":["CH_GB18_CDMD:A1","CH_GB18_CDMD:A8","CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SD2","text":"Externality possesses no independent ontological status outside absolute reflection.","refs":["CH_GB18_CDMD:A5","CH_GB18_CDMD:A6","CH_GB18_CDMD:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SD3","text":"The distinctions of inward and outward, as well as of form and content, are transferred into a single movement of self-manifestation.","refs":["CH_GB18_CDMD:A11","CH_GB18_CDMD:A12","CH_GB18_CDMD:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SD4","text":"The exposition is not external cognition of the Absolute, but the manner in which the Absolute determines and shows itself.","refs":["CH_GB18_CDMD:A8","CH_GB18_CDMD:A10","CH_GB18_CDMD:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SD5","text":"Actuality is not a result beyond the movement, but the movement of the Absolute in its self-manifesting form.","refs":["CH_GB18_CDMD:A11","CH_GB18_CDMD:A13","CH_GB18_CDMD:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_CDMD:DNX1","text":"Excluded is a static Absolute whose identity would be complete without reflection and self-positing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:DNX2","text":"Excluded is an independent externality that stands over against the Absolute independently.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:DNX3","text":"Excluded is a hidden inwardness whose expression would have to be understood as a transition into an Other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:DNX4","text":"Excluded is a determinacy externally added to the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:DNX5","text":"Excluded is a content of the Absolute independent of the enactment of exposition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:DNX6","text":"Excluded is an actuality that occurs only after or outside absolute self-movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_CDMD:SNX1","text":"Impossible is an Absolute whose manifestation depends on a hidden inwardness or an Other standing over against it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SNX2","text":"Blocked is the possibility of a genuine external position over against the Absolute, from which its determinations could be taken up and led back.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SNX3","text":"Absent remains a self-subsistent content beyond exposition; this absence structures the determination of the Absolute as absolute form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SNX4","text":"Unavailable is a negation that definitively transfers the Absolute into an Other and permits no return into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:SNX5","text":"Impermissible is every separation of identity and difference in which difference remains outside identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_CDMD:FGS1","text":"Simple identity plus negation generates the Absolute as an identity that must determine itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS2","text":"The self-determining identity appears as attribute because the first identity itself already contains determinacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS3","text":"Determinacy emerges as externality and becomes the mode of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS4","text":"Posited externality is recognized as externality and thereby becomes semblance as semblance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS5","text":"Semblance as semblance reflects form into itself, whereby externality simultaneously becomes inwardness and absolute identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS6","text":"The returning reflection determines only that which already is and sublates the separation of form and content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:FGS7","text":"The exposition becomes the sole content of the Absolute and, as self-sustaining manifestation, becomes actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_CDMD:AF1","text":"Simple identity → negation and determinacy → attribute as middle → externality of the Absolute → posited externality as semblance → return of form into itself → dissolution of form and content → self-manifesting actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_CDMD:ME1","text":"The mode is reclassified from a state of external loss into an immanent self-movement of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ME2","text":"Attribute and mode no longer appear as externally found predicates, but as stages of absolute self-determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ME3","text":"The opposition between appearance and absolute identity is reorganized through the category of semblance as semblance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ME4","text":"The opposition of form and content collapses because exposition itself constitutes the content of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ME5","text":"Actuality is classified not as a result separated from movement, but as its self-manifesting shape.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_CDMD:ALT1","text":"**Surface:** The Absolute is divided into the determinations identity, attribute, and mode.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ALT2","text":"**Structural:** Externality is determined as a posited reflective structure returning into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ALT3","text":"**Metastrategic:** Exposition is reframed from an external consideration into the Absolute's own enactment.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:ALT4","text":"**Ontological/Temporal:** Being is organized as self-positing, self-externalizing, and self-returning movement; an independent transition into an Other is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_CDMD:MRT1","text":"The axioms suffice to reconstruct the movement from simple identity through attribute and mode to self-manifestation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT2","text":"What remains underdetermined is how the initially external negation and the later self-relating negativity are precisely distinguished or mediated.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT3","text":"The determination of the mode as loss without return and its later determination as return into itself are connected by conceptual reinterpretation, not by an additional mediating link.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT4","text":"The construction remains internally coherent insofar as externality is understood from the outset as a moment of absolute reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT5","text":"Its strongest point is the derivation of self-identity from self-positing rather than from mere equality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT6","text":"Its argumentative closure depends on the sublation of the oppositions inward/external and form/content, which is posited rather than independently proved.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CDMD:MRT7","text":"The reconstruction preserves the actual movement: identity → determinacy → externality → return → manifestation → actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CDMD:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CDMD:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_CDMD@R001","source_variant_id":"canonical:CH_GB18_CDMD:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 157","title":"C. The Mode of the Absolute.","context":"Chapter 157","original_title":"C. Der Modus des Absoluten."},"original_title":"C. Der Modus des Absoluten.","title_language_code":"en"},{"id":"CH_GB18_A_41","layer":"CH","title":"Remark.","order":158,"parents":["RAW_GB18_A_41"],"revision":"CH_GB18_A_41@R001","sha256":"de94a39768dbd19b5e11fc58425d2513375fea4ca37b34b71c7f278e8b7db8d1","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_A_41:AS1","text":"Der Begriff des Absoluten muß erklären, wie Einheit, Bestimmtheit und Erkenntnis aus einer immanenten Bewegung hervorgehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AS2","text":"Spinozas Substanz reduziert alle Bestimmtheit auf Gesetztsein, beläßt diese Reduktion aber in einer unbewegten Identität und überläßt ihre Artikulation einer äußerlichen Reflexion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AS3","text":"Das Absolute ist nicht als vorausgesetztes Erstes, sondern als Resultat seiner sich selbst negierenden Negativität zu begreifen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AS4","text":"Die Reihenfolge Substanz, Attribut und Modus ist nur dann begrifflich gültig, wenn ihre Übergänge als notwendige Selbstentfaltung des Absoluten hervorgehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AS5","text":"Emanation und Monade korrigieren je einen Mangel des Spinozismus, reproduzieren aber Externalität entweder als irreversiblen Verlust oder als äußerlich gesetzte Schranke und Harmonie.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AS6","text":"Die Zielgestalt ist eine Identität, die ihre Differenzen setzt, negiert, in sich zurücknimmt und dadurch sowohl Bestimmtheit als auch Erkenntnis immanent erzeugt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0015","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_A_41:A1","text":"Das Absolute ist wesentlich Resultat und nicht bloß unmittelbarer Anfang.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A2","text":"Bestimmtheit ist Negation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A3","text":"Absolute Negation ist Negation, die sich selbst negiert und sich auf sich selbst bezieht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A4","text":"Wahre Identität enthält das Werden ihrer Bestimmungen und deren Auflösung in sich selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A5","text":"Immanentes Erkennen leitet seine Bestimmungen aus dem Absoluten selbst ab.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A6","text":"Äußerliche Reflexion kann Bestimmungen auf das Absolute zurückführen, aber ihren Ursprung nicht aus ihm begründen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A7","text":"Eine unbewegte Einheit von Denken und Ausdehnung enthält Denken nicht als selbständiges Bestimmen und Formieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A8","text":"Attribute und Modi müssen aus einer notwendigen inneren Entwicklung hervorgehen, wenn sie Bestimmungen des Absoluten sein sollen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A9","text":"Ein Fortgang, der nur Entfernung, Verlust oder Verdunkelung erzeugt, besitzt keine immanente Rückkehr zur Einheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A10","text":"Selbstmanifestation ohne äußere Einwirkung realisiert das Prinzip der Reflexion in sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A11","text":"Eine absolute Grenze des Ansichseins bleibt äußerlich, wenn sie nicht durch die Selbstsetzung des Begrenzten erzeugt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A12","text":"Die Beziehung endlicher Individuen bedarf einer immanenten Begründung und darf nicht als prästabilierte äußere Harmonie vorausgesetzt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_A_41:NX1","text":"Das Absolute ist nicht ein voraussetzungsloses Erstes im Sinn einer bloß unmittelbar angesetzten Definition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX2","text":"Absolute Einheit ist nicht unbewegte Identität ohne Entgegensetzung, Selbstunterscheidung und Rückkehr.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX3","text":"Erkenntnis ist nicht äußerliche Reflexion, die gegebene Bestimmungen lediglich subsumiert oder zurückführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX4","text":"Das Denken ist nicht bloß ein Attribut neben der Ausdehnung, sofern ihm kein eigenes Bestimmen zukommt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX5","text":"Attribute sind nicht empirisch aufgenommene Formen, deren bestimmte Vielheit unbegründet bleibt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX6","text":"Der Modus ist nicht bloß ein gegebenes Drittes, dessen Nichtigkeit nicht als Selbstreflexion begriffen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX7","text":"Werden ist nicht ein linearer Verfall der Einheit in zunehmende Verdunkelung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX8","text":"Individualität ist nicht mit äußerer Prädestination oder von außen gestifteter Harmonie vereinbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_A_41:D1","text":"Eine Definition des Absoluten bleibt unzureichend, wenn sie dessen Begriff als bereits vorhandene Voraussetzung einsetzt statt seine Erzeugung auszuweisen.","refs":["CH_GB18_A_41:A1","CH_GB18_A_41:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D2","text":"Spinozas Substanz kann endliche Bestimmtheit als unselbständig auflösen, aber nicht deren immanentes Hervorgehen und Verschwinden erklären.","refs":["CH_GB18_A_41:A2","CH_GB18_A_41:A4","CH_GB18_A_41:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D3","text":"Die Einheit von Denken und Ausdehnung ist keine vollständige Absolutheit, wenn Denken darin nicht als selbstbewegte Form enthalten ist.","refs":["CH_GB18_A_41:A5","CH_GB18_A_41:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D4","text":"Die Reihenfolge Substanz, Attribut und Modus bleibt äußerliche Aufzählung, sofern der Modus nicht die rückkehrende Negation der ursprünglichen Identität bildet.","refs":["CH_GB18_A_41:A3","CH_GB18_A_41:A4","CH_GB18_A_41:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D5","text":"Die Reduktion unendlicher Attribute auf Denken und Ausdehnung bleibt empirisch, sofern diese Reduktion nicht aus dem Begriff des Absoluten folgt.","refs":["CH_GB18_A_41:A6","CH_GB18_A_41:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D6","text":"Die Emanationslehre beschreibt Anderswerden ohne die logische Form einer Rückkehr und kann daher Identität nicht als Resultat bewahren.","refs":["CH_GB18_A_41:A4","CH_GB18_A_41:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D7","text":"Die leibnizische Monade ersetzt äußere Einwirkung durch Selbstmanifestation, verlegt die Abhängigkeit aber in die absolute Schranke ihres Ansichseins.","refs":["CH_GB18_A_41:A10","CH_GB18_A_41:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D8","text":"Eine von außen prästabilierte Harmonie erklärt nicht, wie geschlossene Individuen sich notwendig aufeinander beziehen.","refs":["CH_GB18_A_41:A11","CH_GB18_A_41:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_A_41:SD1","text":"Die verglichenen Systeme verteilen die Momente des Absoluten einseitig: Spinoza bewahrt Einheit ohne Selbstbewegung, Emanation Andersheit ohne Rückkehr und Leibniz Selbstreflexion ohne immanente Entgrenzung.","refs":["CH_GB18_A_41:A4","CH_GB18_A_41:A7","CH_GB18_A_41:A9","CH_GB18_A_41:A10","CH_GB18_A_41:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SD2","text":"Die notwendige Vermittlung von Einheit und Vielheit liegt in einer Negativität, die Differenz nicht nur erleidet oder tilgt, sondern als eigenes Moment setzt und zurücknimmt.","refs":["CH_GB18_A_41:A2","CH_GB18_A_41:A3","CH_GB18_A_41:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SD3","text":"Die Unterscheidung zwischen immanentem und äußerlichem Erkennen entscheidet zugleich über die Ontologie des Absoluten: Ein äußerlich erkanntes Absolutes bleibt selbst begrifflich äußerlich.","refs":["CH_GB18_A_41:A5","CH_GB18_A_41:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SD4","text":"Individualität ist nur dann mit Absolutheit vereinbar, wenn Grenze, Unterschied und Relation aus der Selbstbewegung des Individuellen hervorgehen.","refs":["CH_GB18_A_41:A10","CH_GB18_A_41:A11","CH_GB18_A_41:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SD5","text":"Die Vollständigkeit eines Systems bemißt sich nicht an der Anwesenheit von Substanz, Attribut und Modus, sondern an der notwendigen Erzeugung ihres Zusammenhangs.","refs":["CH_GB18_A_41:A1","CH_GB18_A_41:A4","CH_GB18_A_41:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_A_41:DNX1","text":"Falsch sein muß, daß das Wahre als bloße unmittelbare Gegebenheit beginnen kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:DNX2","text":"Falsch sein muß, daß Identität ohne die Produktion und Aufhebung von Differenz vollständig sein kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:DNX3","text":"Falsch sein muß, daß ein äußerer Verstand die Wahrheit des Absoluten erfassen kann, ohne selbst aus dessen Bewegung begriffen zu werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:DNX4","text":"Falsch sein muß, daß Endlichkeit durch eine unvermittelte, im Ansichsein fixierte Grenze erklärt werden kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:DNX5","text":"Falsch sein muß, daß Vielheit, Relation und Ordnung als empirische oder göttlich gesetzte Tatsachen neben einer absoluten Einheit bestehen dürfen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_A_41:SNX1","text":"Ausgeschlossen ist ein Absolutes, das nur als ruhender Grund hinter seinen Bestimmungen steht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SNX2","text":"Ausgeschlossen ist eine Differenz, die endgültig aus der Einheit austritt und nicht als deren eigenes Moment zurückkehrt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SNX3","text":"Ausgeschlossen ist ein Subjekt, dessen Selbsttätigkeit mit einer von außen gesetzten Wesensgrenze vereinbar wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SNX4","text":"Ausgeschlossen ist eine Philosophie, deren Grundbegriffe durch Definition, Erfahrung oder dogmatische Voraussetzung gelten, ohne sich aus dem Begriff selbst zu legitimieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_A_41:FGS1","text":"Unmittelbares Absolutes → äußerliche Bestimmung → fehlende immanente Erkenntnis.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS2","text":"Bestimmtheit als Negation → Forderung selbstbezüglicher Negation → bewegte statt starre Identität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS3","text":"Substanz → Attribut → Modus → nur gültig bei notwendiger Selbstvermittlung und Rückkehr zur Identität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS4","text":"Einheit ohne Selbstunterscheidung → Spinozistische Unbewegtheit → Externalisierung von Denken und Erkenntnis.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS5","text":"Ausströmung ohne Rückkehr → fortschreitender Verlust → Unfähigkeit zur Wiederherstellung der Einheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS6","text":"Reflexion in sich → Selbstmanifestation → äußere Grenze und prästabilierte Relation → unvollendete Individualität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS7","text":"Selbstnegation → Selbstsetzung → Bestimmung → Aufhebung → resultierende konkrete Identität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0015","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_A_41:AF1","text":"Unmittelbar definierte Substanz → Kritik ihrer vorausgesetzten Absolutheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AF2","text":"Auflösung aller Bestimmtheit in Einheit → Diagnose einer nur äußerlichen Reflexion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AF3","text":"Attribut und Modus → Nachweis fehlender notwendiger Entwicklung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AF4","text":"Emanative Ausströmung → Nachweis von Werden als bloßem Verlust ohne Rückkehr.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AF5","text":"Monadenhafte Selbstreflexion → Nachweis äußerlich gesetzter Grenzen und Relationen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AF6","text":"Vergleich einseitiger Prinzipien → Forderung einer selbstnegativen, immanenten Bewegung des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_A_41:ME1","text":"Die Opposition von Einheit und Vielheit wird als unzureichend sichtbar, weil beide durch Selbstnegation vermittelt werden müssen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ME2","text":"Die Unterscheidung zwischen äußerlicher Rückführung und immanenter Ableitung trennt bloße Subsumtion von spekulativer Erkenntnis.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ME3","text":"Spinozismus erscheint nicht als Verneinung aller Differenz, sondern als System, das Differenz nur außer seiner Substanz artikulieren kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ME4","text":"Emanation erscheint nicht als produktive Genesis, sondern als zeitliche Figur irreversibler Entkräftung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ME5","text":"Leibnizsche Individualität erscheint nicht als vollendete Selbständigkeit, sondern als Selbsttätigkeit unter äußerlich bleibender Wesensbegrenzung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ME6","text":"Die Trias Substanz, Attribut und Modus wird von einer taxonomischen Folge in ein Kriterium notwendiger begrifflicher Vermittlung überführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_A_41:ALT1","text":"Surface — Der Text prüft die Begriffe der spinozistischen Substanz, der Emanation und der leibnizischen Monade.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ALT2","text":"Structural — Geprüft wird, ob Bestimmungen, Grenzen und Relationen aus dem Absoluten hervorgehen oder durch äußere Reflexion, Erfahrung oder Setzung eingeführt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ALT3","text":"Metastrategic — Philosophische Kritik wird als Nachweis geführt, daß ein System seine eigenen Übergänge nicht notwendig erzeugt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ALT4","text":"Ontological/Temporal — Realität ist als Selbstbewegung der Negativität bestimmt; lineare Ausströmung, starre Identität und äußerlich fixierte Grenze sind defizitäre Zeit- und Seinsformen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_A_41:MRT1","text":"Die Axiome reichen aus, um die Kritik an Spinozas unmittelbarer Substanz, äußerlicher Reflexion und unbegründeter Attribut-Modus-Folge zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT2","text":"Die Axiome reichen aus, um Emanation als Verlust ohne Rückkehr und Monadenlehre als Selbstreflexion unter äußerer Schranke zu bestimmen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT3","text":"Unterbestimmt bleibt die positive vollständige Deduktion, durch welche absolute Negativität die konkreten Formen von Attribut, Modus, Individuum und Beziehung erzeugt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT4","text":"Die stärkste Struktur liegt in der einheitlichen Anwendung des Kriteriums immanenter Selbstvermittlung auf drei verschiedene Systeme.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT5","text":"Die zentrale Bruchlinie liegt zwischen der Forderung, das Absolute müsse Resultat sein, und dem Ausbleiben einer ausgeführten Herleitung dieses Resultats innerhalb der Anmerkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0016","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT6","text":"Eine weitere Spannung liegt darin, daß das kritisierte äußere Verhältnis zur Substanz negativ bestimmt wird, während die positive Form der immanenten Erkenntnis nur als Forderung erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0015","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0016","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT7","text":"Die Rekonstruktion bewahrt die Argumentbewegung, sofern sie die historischen Systeme nicht als gleichartige Irrtümer, sondern als abgestufte Einseitigkeiten behandelt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T112619054981Z_3dbd5799","language_code":"en","language_name":"English","title":"Note.","source_sha256":"de94a39768dbd19b5e11fc58425d2513375fea4ca37b34b71c7f278e8b7db8d1","sha256":"397c3d2b7ba11c18177eaefa1a74a1bfd87de8aa6508ae6124849009330ad28c","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:26:19.059629+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_A_41:AS1","text":"The concept of the Absolute must explain how unity, determinacy, and cognition emerge from an immanent movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AS2","text":"Spinoza's substance reduces all determinacy to positedness, but leaves this reduction in an unmoved identity and entrusts its articulation to an external reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AS3","text":"The Absolute is to be conceived not as a presupposed first, but as the result of its self-negating negativity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AS4","text":"The sequence substance, attribute, and mode is conceptually valid only if its transitions emerge as the necessary self-unfolding of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AS5","text":"Emanation and the monad each correct a deficiency of Spinozism, but reproduce externality either as an irreversible loss or as an externally posited limitation and harmony.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AS6","text":"The intended form is an identity that posits its differences, negates them, takes them back into itself, and thereby immanently produces both determinacy and cognition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0015","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_A_41:A1","text":"The Absolute is essentially result and not merely immediate beginning.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A2","text":"Determinacy is negation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A3","text":"Absolute negation is negation that negates itself and relates to itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A4","text":"True identity contains within itself the becoming of its determinations and their dissolution.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A5","text":"Immanent cognition derives its determinations from the Absolute itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A6","text":"External reflection can lead determinations back to the Absolute, but cannot ground their origin in it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A7","text":"An unmoved unity of thought and extension does not contain thought as autonomous determining and forming.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A8","text":"Attributes and modes must emerge from a necessary inner development if they are to be determinations of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A9","text":"A progression that produces only removal, loss, or obscuration possesses no immanent return to unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A10","text":"Self-manifestation without external influence realizes the principle of reflection within itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A11","text":"An absolute limit of being-in-itself remains external if it is not produced through the self-positing of that which is limited.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:A12","text":"The relation of finite individuals requires an immanent grounding and must not be presupposed as a pre-established external harmony.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_A_41:NX1","text":"The Absolute is not a presuppositionless first in the sense of a definition merely posited immediately.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX2","text":"Absolute unity is not unmoved identity without opposition, self-differentiation, and return.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX3","text":"Cognition is not external reflection that merely subsumes or leads back given determinations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX4","text":"Thought is not merely an attribute alongside extension, insofar as no determination of its own belongs to it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX5","text":"Attributes are not empirically received forms whose determinate multiplicity remains ungrounded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX6","text":"The mode is not merely a given third whose nullity is not conceived as self-reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX7","text":"Becoming is not a linear decline of unity into increasing obscuration.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:NX8","text":"Individuality is not compatible with external predestination or harmony established from without.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_A_41:D1","text":"A definition of the Absolute remains insufficient if it posits its concept as an already existing presupposition instead of demonstrating its production.","refs":["CH_GB18_A_41:A1","CH_GB18_A_41:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D2","text":"Spinoza's substance can dissolve finite determinacy as non-self-subsistent, but cannot explain its immanent emergence and disappearance.","refs":["CH_GB18_A_41:A2","CH_GB18_A_41:A4","CH_GB18_A_41:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D3","text":"The unity of thought and extension is not complete absoluteness if thought is not contained therein as self-moving form.","refs":["CH_GB18_A_41:A5","CH_GB18_A_41:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D4","text":"The sequence substance, attribute, and mode remains an external enumeration insofar as the mode does not constitute the returning negation of the original identity.","refs":["CH_GB18_A_41:A3","CH_GB18_A_41:A4","CH_GB18_A_41:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D5","text":"The reduction of infinite attributes to thought and extension remains empirical insofar as this reduction does not follow from the concept of the Absolute.","refs":["CH_GB18_A_41:A6","CH_GB18_A_41:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D6","text":"The doctrine of emanation describes becoming-other without the logical form of a return and therefore cannot preserve identity as result.","refs":["CH_GB18_A_41:A4","CH_GB18_A_41:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D7","text":"The Leibnizian monad replaces external influence with self-manifestation, but relocates dependence into the absolute limitation of its being-in-itself.","refs":["CH_GB18_A_41:A10","CH_GB18_A_41:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:D8","text":"A harmony pre-established from without does not explain how closed individuals necessarily relate to one another.","refs":["CH_GB18_A_41:A11","CH_GB18_A_41:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_A_41:SD1","text":"The systems compared distribute the moments of the Absolute one-sidedly: Spinoza preserves unity without self-movement, emanation otherness without return, and Leibniz self-reflection without immanent de-limitation.","refs":["CH_GB18_A_41:A4","CH_GB18_A_41:A7","CH_GB18_A_41:A9","CH_GB18_A_41:A10","CH_GB18_A_41:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SD2","text":"The necessary mediation of unity and multiplicity lies in a negativity that does not merely suffer or annul difference, but posits and takes it back as its own moment.","refs":["CH_GB18_A_41:A2","CH_GB18_A_41:A3","CH_GB18_A_41:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SD3","text":"The distinction between immanent and external cognition simultaneously decides the ontology of the Absolute: an externally cognized Absolute remains itself conceptually external.","refs":["CH_GB18_A_41:A5","CH_GB18_A_41:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SD4","text":"Individuality is compatible with absoluteness only if limit, difference, and relation emerge from the self-movement of the individual.","refs":["CH_GB18_A_41:A10","CH_GB18_A_41:A11","CH_GB18_A_41:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SD5","text":"The completeness of a system is measured not by the presence of substance, attribute, and mode, but by the necessary production of their connection.","refs":["CH_GB18_A_41:A1","CH_GB18_A_41:A4","CH_GB18_A_41:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_A_41:DNX1","text":"It must be false that the true can begin as mere immediate givenness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:DNX2","text":"It must be false that identity can be complete without the production and sublation of difference.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:DNX3","text":"It must be false that an external understanding can grasp the truth of the Absolute without itself being conceived from its movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:DNX4","text":"It must be false that finitude can be explained through an unmediated limit fixed in being-in-itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:DNX5","text":"It must be false that multiplicity, relation, and order may subsist as empirical or divinely posited facts alongside an absolute unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_A_41:SNX1","text":"Excluded is an Absolute that stands merely as a resting ground behind its determinations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SNX2","text":"Excluded is a difference that finally exits unity and does not return as its own moment.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SNX3","text":"Excluded is a subject whose self-activity would be compatible with an externally posited essential limit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:SNX4","text":"Excluded is a philosophy whose fundamental concepts hold by definition, experience, or dogmatic presupposition without legitimating themselves from the concept itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_A_41:FGS1","text":"Immediate Absolute → external determination → absent immanent cognition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS2","text":"Determinacy as negation → demand for self-relating negation → moving rather than rigid identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS3","text":"Substance → attribute → mode → valid only with necessary self-mediation and return to identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS4","text":"Unity without self-differentiation → Spinozistic immobility → externalization of thought and cognition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS5","text":"Emanation without return → progressive loss → incapacity to restore unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS6","text":"Reflection into itself → self-manifestation → external limit and pre-established relation → uncompleted individuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:FGS7","text":"Self-negation → self-positing → determination → sublation → resulting concrete identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0015","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_A_41:AF1","text":"Immediately defined substance → critique of its presupposed absoluteness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AF2","text":"Dissolution of all determinacy into unity → diagnosis of merely external reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AF3","text":"Attribute and mode → demonstration of absent necessary development.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AF4","text":"Emanative outflow → demonstration of becoming as mere loss without return.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AF5","text":"Monad-like self-reflection → demonstration of externally posited limits and relations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:AF6","text":"Comparison of one-sided principles → demand for a self-negative, immanent movement of the Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_A_41:ME1","text":"The opposition of unity and multiplicity becomes visible as insufficient, because both must be mediated through self-negation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ME2","text":"The distinction between external reduction and immanent derivation separates mere subsumption from speculative cognition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ME3","text":"Spinozism appears not as the negation of all difference, but as a system that can articulate difference only outside its substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ME4","text":"Emanation appears not as productive genesis, but as a temporal figure of irreversible enfeeblement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ME5","text":"Leibnizian individuality appears not as completed self-subsistence, but as self-activity under an essential limitation that remains external.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ME6","text":"The triad substance, attribute, and mode is transformed from a taxonomic sequence into a criterion of necessary conceptual mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_A_41:ALT1","text":"Surface — The text examines the concepts of Spinozistic substance, emanation, and the Leibnizian monad.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ALT2","text":"Structural — What is examined is whether determinations, limits, and relations emerge from the Absolute or are introduced through external reflection, experience, or positing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ALT3","text":"Metastrategic — Philosophical critique proceeds as a demonstration that a system does not necessarily produce its own transitions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:ALT4","text":"Ontological/Temporal — Reality is determined as the self-movement of negativity; linear outflow, rigid identity, and externally fixed limit are deficient forms of time and being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_A_41:MRT1","text":"The axioms suffice to reconstruct the critique of Spinoza's immediate substance, external reflection, and ungrounded attribute-mode sequence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT2","text":"The axioms suffice to determine emanation as loss without return and the doctrine of monads as self-reflection under an external limitation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT3","text":"What remains underdetermined is the positive complete deduction through which absolute negativity produces the concrete forms of attribute, mode, individual, and relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT4","text":"The strongest structure lies in the uniform application of the criterion of immanent self-mediation to three different systems.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT5","text":"The central fault line lies between the demand that the Absolute must be result and the absence of an elaborated derivation of this result within the note.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0016","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT6","text":"A further tension lies in the fact that the criticized external relation to substance is determined negatively, while the positive form of immanent cognition appears only as a demand.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0002","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0003","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0015","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0016","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_A_41:MRT7","text":"The reconstruction preserves the movement of the argument insofar as it treats the historical systems not as errors of the same kind, but as graduated one-sidednesses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_A_41:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_A_41:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_A_41@R001","source_variant_id":"canonical:CH_GB18_A_41:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 158","title":"Remark.","context":"Chapter 158","original_title":"Anmerkung."},"original_title":"Anmerkung.","title_language_code":"en"},{"id":"CH_GB18_ZLOF","layer":"CH","title":"A. Contingency, or Formal Actuality, Possibility, and Necessity.","order":159,"parents":["RAW_GB18_ZLOF"],"revision":"CH_GB18_ZLOF@R001","sha256":"e6c0440e181890f96e74537395ec31695a74256cc51f1db64f6c463b4f3fd928","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_ZLOF:AS1","text":"Der Text bestimmt die Modalität als Selbstbestimmung der absoluten Einheit von Innerem und Äußerem, nicht als äußerlich hinzutretende Prädikation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AS2","text":"Die formelle Wirklichkeit wird als unmittelbares Sein bestimmt, das wegen seiner Formeinheit Möglichkeit bereits enthält, ohne deren Totalität zu realisieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AS3","text":"Die Möglichkeit wird aus bloßer Identität in eine mangelhafte, auf Wirklichkeit verwiesene Bestimmung überführt und erweist sich dadurch als widersprüchlich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AS4","text":"Die Selbstaufhebung des Widerspruchs der Möglichkeit erzeugt die reflektierte Einheit von Möglichkeit und Wirklichkeit als Zufälligkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AS5","text":"Die Zufälligkeit schlägt als wechselseitige Grundlosigkeit und Begründetheit ihrer Momente in die Notwendigkeit als deren Identität um.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_ZLOF:A1","text":"Das Absolute ist die Einheit des Inneren und Äußeren, die sich durch ihre eigene Reflexion manifestiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A2","text":"Die Wirklichkeit ist reflektierte Absolutheit als Einheit von Unmittelbarkeit und Reflexion-in-sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A3","text":"Die erste oder formelle Wirklichkeit ist unmittelbare und unreflektierte Wirklichkeit, somit bloßes Sein oder Existenz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A4","text":"Die formelle Wirklichkeit enthält als Einheit von Innerlichkeit und Äußerlichkeit unmittelbar die Möglichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A5","text":"Die Möglichkeit ist reflektierte Wirklichkeit, die als bloßes Ansichsein nur gesetztes Moment der absoluten Form ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A6","text":"Die Möglichkeit ist wesentlich mangelhaft, weil sie auf die Wirklichkeit verweist und ihre Wahrheit ohne Sein nicht hat.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A7","text":"Die formelle Möglichkeit erlaubt jedes nicht widersprüchliche Bestimmte, während jede bestimmte Mannigfaltigkeit durch ihre Negation in Widerspruch übergeht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A8","text":"Die Möglichkeit enthält als Reflexion der Totalität zugleich die Möglichkeit ihres Anderen oder Gegenteils.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A9","text":"Die Möglichkeit ist als gesetzter Widerspruch selbst Unmöglichkeit und hebt sich deshalb in Unmittelbarkeit oder Wirklichkeit auf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A10","text":"Die Einheit der Wirklichkeit mit ihrer aufgehobenen Möglichkeit ist Zufälligkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A11","text":"Das Zufällige ist zugleich grundlose unmittelbare Wirklichkeit und in einem Anderen begründetes Gesetztsein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A12","text":"Die Identität von Möglichkeit und Wirklichkeit im wechselseitigen Umschlagen ihrer Unterschiede ist Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_ZLOF:NX1","text":"Sein ist nicht schon Wirklichkeit, weil ihm die gesetzte Einheit von Unmittelbarkeit und Reflexion fehlt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX2","text":"Existenz ist nicht volle Wirklichkeit, weil ihre reale Reflexion noch nicht als Einheit mit ihrer Unmittelbarkeit gesetzt ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX3","text":"Wirklichkeit ist nicht bloß äußere Veränderung und nicht Scheinen in einem Anderen, sondern Selbstmanifestation in der Äußerlichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX4","text":"Möglichkeit ist nicht bloße Wesentlichkeit oder folgenlose Identität mit sich selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX5","text":"Der Satz, etwas sei möglich, ist nicht inhaltlich gehaltvoll, sofern er nur dessen formelle Identität behauptet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX6","text":"Zufälligkeit ist nicht reine Grundlosigkeit, weil das Zufällige ebenso wesentlich auf einen Grund verwiesen ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX7","text":"Notwendigkeit ist nicht eine dem Seienden äußerlich angeheftete Eigenschaft, sondern die aufgehobene Differenz seiner Wirklichkeit und Möglichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0031","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_ZLOF:D1","text":"Die formellen Modalitäten besitzen noch keinen selbständigen Inhalt, weil ihre Unterschiede zunächst nur der äußeren Reflexion angehören.","refs":["CH_GB18_ZLOF:A2","CH_GB18_ZLOF:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D2","text":"Jede nur formell mögliche Bestimmung eröffnet zugleich die Möglichkeit ihres Gegenteils und kann daher keine stabile Bestimmtheit sichern.","refs":["CH_GB18_ZLOF:A7","CH_GB18_ZLOF:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D3","text":"Möglichkeit enthält ein immanentes Sollen der Wirklichkeit, weil sie als bloß gesetztes Ansichsein ihrer eigenen Formtotalität nicht genügt.","refs":["CH_GB18_ZLOF:A5","CH_GB18_ZLOF:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D4","text":"Die Wirklichkeit ist als formelle Wirklichkeit selbst nur möglich, weil die Möglichkeit in ihr unmittelbar als aufgehobenes Moment enthalten ist.","refs":["CH_GB18_ZLOF:A4","CH_GB18_ZLOF:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D5","text":"Das Mögliche besitzt in der Sphäre der Zufälligkeit Existenz, jedoch nur den Wert einer zufälligen Wirklichkeit.","refs":["CH_GB18_ZLOF:A9","CH_GB18_ZLOF:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D6","text":"Grundlosigkeit und Begründetheit sind in der Zufälligkeit nicht alternative Beschreibungen, sondern ineinander übergehende Bestimmungen desselben Wirklichen.","refs":["CH_GB18_ZLOF:A10","CH_GB18_ZLOF:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D7","text":"Notwendigkeit entsteht nicht durch eine zusätzliche Ursache, sondern durch die Identität, die im Umschlag von Möglichkeit und Wirklichkeit hervortritt.","refs":["CH_GB18_ZLOF:A11","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_ZLOF:SD1","text":"Die Modalitäten bilden keine feste Klassifikation von Seiendem, sondern eine Sequenz von Selbstaufhebungen, in der jede Bestimmung ihre Gegenbestimmung erzeugt.","refs":["CH_GB18_ZLOF:A5","CH_GB18_ZLOF:A8","CH_GB18_ZLOF:A9","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:SD2","text":"Die Behauptung universeller formeller Möglichkeit schlägt in ihre eigene Begrenzung um, weil bestimmte Möglichkeit notwendig Negation, Gegensatz und Unmöglichkeit produziert.","refs":["CH_GB18_ZLOF:A7","CH_GB18_ZLOF:A8","CH_GB18_ZLOF:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:SD3","text":"Kontingenz fungiert als Übergangsform, in der die Trennung von Sein, Grund und Begründetem sichtbar wird, aber nicht stabil erhalten werden kann.","refs":["CH_GB18_ZLOF:A10","CH_GB18_ZLOF:A11","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:SD4","text":"Notwendigkeit ist die Form, in der das Absolute seine Äußerlichkeit nicht verliert, sondern als Reflexion seiner selbst in der Differenz besitzt.","refs":["CH_GB18_ZLOF:A1","CH_GB18_ZLOF:A2","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_ZLOF:DNX1","text":"Ausgeschlossen ist ein Inhalt, dessen Möglichkeit unabhängig von seiner immanenten Negation und Entwicklung festgestellt werden könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:DNX2","text":"Ausgeschlossen ist eine ursprüngliche Unmittelbarkeit, die als selbstgenügender Grund ihrer selbst bestehen könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0031","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:DNX3","text":"Ausgeschlossen ist ein äußerer Grund, der Wirklichkeit begründen könnte, ohne selbst als gesetztes Moment des Begründeten aufgehoben zu werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0031","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:DNX4","text":"Ausgeschlossen ist eine dauerhafte Trennung von Innerem und Äußerem, Möglichkeit und Wirklichkeit sowie Grund und Sein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0028","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_ZLOF:SNX1","text":"Unverfügbar ist ein erster, unvermischter Ausgangspunkt, weil jede anfängliche Unmittelbarkeit bereits nur Moment einer reflektierten Form ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:SNX2","text":"Unverfügbar ist ein statisches Reich möglicher Inhalte, weil Möglichkeit nur als Selbstwiderspruch und Übergang zur Wirklichkeit bestimmt ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:SNX3","text":"Unverfügbar ist eine letzte Kontingenz, weil ihre absolute Unruhe notwendig die Identität ihrer Momente und damit Notwendigkeit hervorbringt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_ZLOF:FGS1","text":"Absolute Einheit des Inneren und Äußeren → Reflexion-in-sich als Manifestation → Wirklichkeit als absolute Form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS2","text":"Formelle Wirklichkeit als unmittelbares Sein → eingeschlossene Möglichkeit als reflektiertes Ansichsein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS3","text":"Möglichkeit als bloß gesetztes Moment → Mangel an Wirklichkeit → Sollen der Formtotalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS4","text":"Bestimmte Möglichkeit → Möglichkeit des Gegenteils → Widerspruch der Möglichkeit → Selbstaufhebung in Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS5","text":"Wirklichkeit als nur möglich und Möglichkeit als nur wirklich → Einheit beider als Zufälligkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS6","text":"Zufälligkeit als gleichzeitige Grundlosigkeit und Begründetheit → Umschlagen von Sein und Ansichsein → Identität im Anderen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS7","text":"Identität des wechselseitigen Umschlags → Aufhebung der Möglichkeit als selbständiger Bestimmung → Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_ZLOF:AF1","text":"Absolute Manifestation → Wirklichkeit als Einheit von Reflexion und Unmittelbarkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AF2","text":"Formelle Wirklichkeit → Möglichkeit als enthaltenes Ansichsein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AF3","text":"Formelle Möglichkeit → Negation und Möglichkeit des Gegenteils → Widerspruch.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AF4","text":"Widerspruch der Möglichkeit → Selbstaufhebung → reflektierte Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AF5","text":"Einheit von möglicher Wirklichkeit und wirklicher Möglichkeit → Zufälligkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AF6","text":"Zufälligkeit als Umschlag von Grund und Grundlosigkeit → Identität der Modalitäten → Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_ZLOF:ME1","text":"Sein, Existenz, formelle Wirklichkeit, reflektierte Wirklichkeit und Notwendigkeit werden als gestufte Formen der Reflexion statt als synonyme Seinsprädikate unterscheidbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ME2","text":"Möglichkeit wird von einem neutralen Vorrat denkbarer Inhalte in eine defizitäre und selbstwidersprüchliche Modalform umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ME3","text":"Zufälligkeit wird von bloßer Willkür in die Doppelstruktur eines zugleich grundlosen und begründeten Gesetztseins überführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ME4","text":"Notwendigkeit wird von äußerem Zwang in die immanente Identität der sich aufhebenden Differenz von Möglichkeit und Wirklichkeit verschoben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_ZLOF:ALT1","text":"Surface — Der explizite Gegenstand ist die Bestimmung von formeller Wirklichkeit, Möglichkeit, Zufälligkeit und Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ALT2","text":"Structural — Die operative Struktur ist die Reflexion, durch welche unmittelbare Bestimmungen als gesetzte, aufgehobene und aufeinander bezogene Momente erscheinen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ALT3","text":"Metastrategic — Das Argument ersetzt äußere Zuschreibung modal-logischer Eigenschaften durch eine immanente Rekonstruktion ihrer gegenseitigen Erzeugung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ALT4","text":"Ontological/Temporal — Realität besitzt keine ruhende Anfangsform, sondern besteht als Bewegung, in der Unmittelbarkeit sich reflektiert, negiert und als Notwendigkeit zurückkehrt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_ZLOF:MRT1","text":"Die Axiome reichen aus, um die Sequenz von formeller Wirklichkeit über Möglichkeit und Zufälligkeit zur Notwendigkeit zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:MRT2","text":"Unterbestimmt bleibt, weshalb die Möglichkeit ihres Gegenteils notwendig in jedem bestimmten möglichen Inhalt enthalten sein muss und nicht nur als äußerer Vergleich hinzutritt.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_ZLOF:MRT3","text":"Die Struktur ist intern kohärent, sofern Reflexion, Gesetztsein und Aufhebung als Umformungsregeln der Modalitäten anerkannt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:MRT4","text":"Die stärkste Rekonstruktionsstelle liegt in der doppelten Bestimmung der Möglichkeit als positives Ansichsein und negatives Verweisen auf Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:MRT5","text":"Die stärkste Kompressionslast liegt auf den nicht weiter formalisierten Übergängen von Widerspruch zu Unmittelbarkeit und von Umschlag zu Identität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:MRT6","text":"Die Grundlosigkeit des Zufälligen und seine gleichzeitige Begründetheit bleiben als produktive Spannung erhalten, weil ihre Einheit erst durch den Übergang zur Notwendigkeit behauptet wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:MRT7","text":"Die Rekonstruktion bewahrt die gerichtete Bewegung nur dann, wenn Notwendigkeit als Resultat der Selbstaufhebung der Zufälligkeit und nicht als vorausgesetzter Ausgangspunkt behandelt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120315152663Z_8fd1ba94","language_code":"en","language_name":"English","title":"A. Contingency or Formal Actuality, Possibility and Necessity.","source_sha256":"e6c0440e181890f96e74537395ec31695a74256cc51f1db64f6c463b4f3fd928","sha256":"573dff9f38ee664c3e7769d6b0d753fcb0b78fe0de102515e8b9c1987240012f","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:03:15.153759+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_ZLOF:AS1","text":"The text determines modality as the self-determination of the absolute unity of inner and outer, not as predication externally added thereto.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AS2","text":"Formal actuality is determined as immediate being which, by virtue of its unity of form, already contains possibility without realizing its totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AS3","text":"Possibility is transferred from mere identity into a deficient determination referring to actuality, and thereby proves itself contradictory.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AS4","text":"The self-sublation of the contradiction of possibility produces the reflected unity of possibility and actuality as contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AS5","text":"Contingency, as the reciprocal groundlessness and groundedness of its moments, passes over into necessity as their identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_ZLOF:A1","text":"The Absolute is the unity of inner and outer, which manifests itself through its own reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A2","text":"Actuality is reflected absoluteness as the unity of immediacy and reflection-into-self.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A3","text":"The first or formal actuality is immediate and unreflected actuality, thus mere being or existence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A4","text":"As the unity of inwardness and outwardness, formal actuality immediately contains possibility.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A5","text":"Possibility is reflected actuality which, as mere being-in-itself, is only a posited moment of the absolute form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A6","text":"Possibility is essentially deficient because it refers to actuality and does not have its truth without being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A7","text":"Formal possibility permits every non-contradictory determinate, while every determinate multiplicity passes over into contradiction through its negation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A8","text":"As reflection of totality, possibility simultaneously contains the possibility of its other or opposite.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A9","text":"As posited contradiction, possibility is itself impossibility and therefore sublates itself into immediacy or actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A10","text":"The unity of actuality with its sublated possibility is contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A11","text":"The contingent is at once groundless immediate actuality and positedness grounded in an other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:A12","text":"The identity of possibility and actuality in the reciprocal passing-over of their differences is necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_ZLOF:NX1","text":"Being is not yet actuality, because it lacks the posited unity of immediacy and reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX2","text":"Existence is not full actuality, because its real reflection is not yet posited as unity with its immediacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX3","text":"Actuality is not mere external change and not semblance in an other, but self-manifestation in outwardness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX4","text":"Possibility is not mere essentiality or consequence-free identity with itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX5","text":"The proposition that something is possible is not substantively meaningful insofar as it asserts only its formal identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX6","text":"Contingency is not pure groundlessness, because the contingent is equally essentially referred to a ground.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:NX7","text":"Necessity is not a property externally affixed to what is, but the sublated difference of its actuality and possibility.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0031","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_ZLOF:D1","text":"The formal modalities do not yet possess independent content, because their differences initially belong only to external reflection.","refs":["CH_GB18_ZLOF:A2","CH_GB18_ZLOF:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D2","text":"Every merely formally possible determination simultaneously opens the possibility of its opposite and can therefore secure no stable determinacy.","refs":["CH_GB18_ZLOF:A7","CH_GB18_ZLOF:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D3","text":"Possibility contains an immanent ought of actuality, because as merely posited being-in-itself it does not suffice for its own totality of form.","refs":["CH_GB18_ZLOF:A5","CH_GB18_ZLOF:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D4","text":"As formal actuality, actuality itself is only possible, because possibility is immediately contained within it as a sublated moment.","refs":["CH_GB18_ZLOF:A4","CH_GB18_ZLOF:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D5","text":"In the sphere of contingency, the possible possesses existence, but only the value of a contingent actuality.","refs":["CH_GB18_ZLOF:A9","CH_GB18_ZLOF:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D6","text":"Groundlessness and groundedness are not alternative descriptions in contingency, but determinations of the same actual which pass over into one another.","refs":["CH_GB18_ZLOF:A10","CH_GB18_ZLOF:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:D7","text":"Necessity does not arise through an additional cause, but through the identity that emerges in the passing-over of possibility and actuality.","refs":["CH_GB18_ZLOF:A11","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_ZLOF:SD1","text":"The modalities form no fixed classification of what is, but a sequence of self-sublations in which each determination generates its counter-determination.","refs":["CH_GB18_ZLOF:A5","CH_GB18_ZLOF:A8","CH_GB18_ZLOF:A9","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:SD2","text":"The assertion of universal formal possibility passes over into its own limitation, because determinate possibility necessarily produces negation, opposition, and impossibility.","refs":["CH_GB18_ZLOF:A7","CH_GB18_ZLOF:A8","CH_GB18_ZLOF:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:SD3","text":"Contingency functions as a transitional form in which the separation of being, ground, and what is grounded becomes visible, but cannot be stably maintained.","refs":["CH_GB18_ZLOF:A10","CH_GB18_ZLOF:A11","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:SD4","text":"Necessity is the form in which the Absolute does not lose its outwardness, but possesses it as reflection of itself in difference.","refs":["CH_GB18_ZLOF:A1","CH_GB18_ZLOF:A2","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0005","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_ZLOF:DNX1","text":"Excluded is a content whose possibility could be established independently of its immanent negation and development.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:DNX2","text":"Excluded is an original immediacy that could subsist as the self-sufficient ground of itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0031","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:DNX3","text":"Excluded is an external ground that could ground actuality without itself being sublated as a posited moment of what is grounded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0031","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:DNX4","text":"Excluded is a lasting separation of inner and outer, possibility and actuality, as well as ground and being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0028","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_ZLOF:SNX1","text":"Unavailable is a first, unmixed point of departure, because every initial immediacy is already only a moment of a reflected form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:SNX2","text":"Unavailable is a static realm of possible contents, because possibility is determined only as self-contradiction and transition to actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:SNX3","text":"Unavailable is an ultimate contingency, because its absolute unrest necessarily brings forth the identity of its moments and thus necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_ZLOF:FGS1","text":"Absolute unity of inner and outer → reflection-into-self as manifestation → actuality as absolute form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS2","text":"Formal actuality as immediate being → enclosed possibility as reflected being-in-itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS3","text":"Possibility as merely posited moment → lack of actuality → ought of the totality of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS4","text":"Determinate possibility → possibility of the opposite → contradiction of possibility → self-sublation into actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS5","text":"Actuality as only possible and possibility as only actual → unity of both as contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS6","text":"Contingency as simultaneous groundlessness and groundedness → passing-over of being and being-in-itself → identity in the other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:FGS7","text":"Identity of reciprocal passing-over → sublation of possibility as an independent determination → necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_ZLOF:AF1","text":"Absolute manifestation → actuality as unity of reflection and immediacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AF2","text":"Formal actuality → possibility as contained being-in-itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AF3","text":"Formal possibility → negation and possibility of the opposite → contradiction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AF4","text":"Contradiction of possibility → self-sublation → reflected actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AF5","text":"Unity of possible actuality and actual possibility → contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:AF6","text":"Contingency as passing-over of ground and groundlessness → identity of the modalities → necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_ZLOF:ME1","text":"Being, existence, formal actuality, reflected actuality, and necessity become distinguishable as graduated forms of reflection rather than as synonymous predicates of being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ME2","text":"Possibility is reclassified from a neutral store of conceivable contents into a deficient and self-contradictory modal form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ME3","text":"Contingency is transferred from mere arbitrariness into the double structure of a positedness that is at once groundless and grounded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ME4","text":"Necessity is displaced from external compulsion into the immanent identity of the self-sublating difference of possibility and actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0031","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0032","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_ZLOF:ALT1","text":"Surface — The explicit subject is the determination of formal actuality, possibility, contingency, and necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ALT2","text":"Structural — The operative structure is reflection, through which immediate determinations appear as posited, sublated, and mutually related moments.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ALT3","text":"Metastrategic — The argument replaces the external attribution of modal-logical properties with an immanent reconstruction of their reciprocal generation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:ALT4","text":"Ontological/Temporal — Reality has no resting initial form, but consists as a movement in which immediacy reflects itself, negates itself, and returns as necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_ZLOF:MRT1","text":"The axioms suffice to reconstruct the sequence from formal actuality through possibility and contingency to necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:MRT2","text":"It remains underdetermined why the possibility of its opposite must necessarily be contained in every determinate possible content and does not merely enter as an external comparison.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_ZLOF:MRT3","text":"The structure is internally coherent insofar as reflection, positedness, and sublation are recognized as transformation rules of the modalities.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:MRT4","text":"The strongest point of reconstruction lies in the double determination of possibility as positive being-in-itself and negative reference to actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:MRT5","text":"The greatest burden of compression lies upon the transitions not further formalized from contradiction to immediacy and from passing-over to identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:MRT6","text":"The groundlessness of the contingent and its simultaneous groundedness remain preserved as a productive tension, because their unity is asserted only through the transition to necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0025","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0026","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0027","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_ZLOF:MRT7","text":"The reconstruction preserves the directed movement only if necessity is treated as the result of the self-sublation of contingency and not as a presupposed point of departure.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_ZLOF:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_ZLOF:P0030","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_ZLOF@R001","source_variant_id":"canonical:CH_GB18_ZLOF:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 159","title":"A. Contingency, or Formal Actuality, Possibility, and Necessity.","context":"Chapter 159","original_title":"A. Zufälligkeit oder formelle Wirklichkeit, Möglichkeit und Nothwendigkeit."},"original_title":"A. Zufälligkeit oder formelle Wirklichkeit, Möglichkeit und Nothwendigkeit.","title_language_code":"en"},{"id":"CH_GB18_BRNO","layer":"CH","title":"B. Relative Necessity or Actuality, Possibility, and Necessity.","order":160,"parents":["RAW_GB18_BRNO"],"revision":"CH_GB18_BRNO@R001","sha256":"b982c961f38596039f64aee968875fdb0caa3c484b49ba9945af12c3b18023fe","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_BRNO:AS1","text":"Die formelle Notwendigkeit bleibt eine unmittelbare Einheit formeller Bestimmungen und besitzt daher keine selbständige innere Gliederung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS2","text":"Die Gleichgültigkeit dieser Einheit gegen ihre Formunterschiede erzeugt reale Wirklichkeit als inhaltsvolle, mannigfaltige und sich in ihrer Äußerlichkeit erhaltende Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS3","text":"Die reale Möglichkeit bestimmt sich als vorhandene Mannigfaltigkeit von Umständen, die das Ansichsein eines Anderen bilden und deshalb ihre eigene Aufhebung enthalten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS4","text":"Die vollständige Selbstaufhebung des Bedingungszusammenhangs lässt Wirklichkeit und Möglichkeit wechselseitig ineinander hervorgehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS5","text":"Die Negation der realen Möglichkeit erzeugt reale Notwendigkeit als mit sich identische inhaltsvolle Beziehung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS6","text":"Die reale Notwendigkeit bleibt relativ, weil sie von zufälliger, äußerlicher und beschränkter Wirklichkeit ausgeht, statt ihre Voraussetzungen selbst hervorzubringen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS7","text":"Die noch nicht vollzogene Einheit von Notwendigkeit und Zufälligkeit bezeichnet die an sich vorhandene absolute Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_BRNO:A1","text":"Formelle Notwendigkeit ist unmittelbare Einheit abstrakter Formbestimmungen ohne selbständige Gestalt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A2","text":"Eine gegen ihre Formunterschiede gleichgültige Einheit besitzt Inhalt und ist reale Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A3","text":"Reale Wirklichkeit erhält sich in der Mannigfaltigkeit ihrer Existenz durch Reflexion in sich selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A4","text":"Reale Möglichkeit ist das inhaltsvolle Ansichsein realer Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A5","text":"Reale Möglichkeit existiert als Mannigfaltigkeit der auf eine Sache bezogenen Umstände.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A6","text":"Die Bedingungen einer Sache sind nicht deren eigene Möglichkeit, sondern das Ansichsein anderer Wirklichkeiten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A7","text":"Die mannigfaltige Existenz realer Möglichkeit enthält ihren Widerspruch und ihre Selbstaufhebung in sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A8","text":"Die Vollständigkeit der Bedingungen ist die inhaltliche Totalität, in der die Sache zugleich möglich und wirklich ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A9","text":"Die Selbstaufhebung realer Möglichkeit hebt zugleich ihre unmittelbare Wirklichkeit und ihr Ansichsein eines Anderen auf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A10","text":"Die Negation realer Möglichkeit ist reale Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A11","text":"Reale Notwendigkeit setzt eine nicht aus sich erzeugte Einheit von Möglichkeit und Wirklichkeit voraus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A12","text":"Das real Notwendige ist wegen seines bestimmten und beschränkten Inhalts zugleich in anderer Hinsicht zufällig.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_BRNO:NX1","text":"Formelle Notwendigkeit ist nicht selbständige Totalität, weil ihre Momente nur unmittelbare Formbestimmungen sind.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX2","text":"Reale Wirklichkeit ist nicht bloße Existenz, die sich in Erscheinungsverhältnisse auflöst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX3","text":"Das Wirken des Wirklichen ist weder bloßes Übergehen in ein Anderes noch bloßes Erscheinen in einem Anderen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX4","text":"Formelle Möglichkeit ist nicht reale Möglichkeit, weil bloße Widerspruchslosigkeit keine inhaltliche Bedingungsmannigfaltigkeit enthält.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX5","text":"Der Widerspruch realer Möglichkeit ist nicht ein äußerer Vergleichswiderspruch.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX6","text":"Die Bedingungen sind nicht durch eine ihnen äußerliche Reflexion erst zu Bedingungen bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX7","text":"Die Selbstaufhebung realer Möglichkeit ist nicht bloßes Übergehen in ein schlechthin Anderes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX8","text":"Reale Notwendigkeit ist nicht absolute Notwendigkeit, weil sie ihre Zufälligkeit nicht aus sich selbst bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_BRNO:D1","text":"Reale Wirklichkeit ist zugleich inhaltliche Selbstbeziehung und äußere Mannigfaltigkeit.","refs":["CH_GB18_BRNO:A2","CH_GB18_BRNO:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D2","text":"Wirklichkeit manifestiert ihre Bestimmtheit durch das Hervorbringen von Wirkungen, ohne ihre Selbständigkeit an das Andere abzutreten.","refs":["CH_GB18_BRNO:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D3","text":"Die reale Möglichkeit einer Sache liegt in einem vorhandenen Bedingungsfeld, nicht in einer bloßen Denkbestimmung.","refs":["CH_GB18_BRNO:A4","CH_GB18_BRNO:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D4","text":"Das Bedingungsfeld ist nur möglich, weil seine vorhandenen Wirklichkeiten zur Aufhebung und zum Rückgang in ein Ansichsein bestimmt sind.","refs":["CH_GB18_BRNO:A5","CH_GB18_BRNO:A6","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D5","text":"Sind alle Bedingungen vollständig, fällt die Differenz zwischen Möglichkeit und Wirklichkeit der Sache in ihre inhaltliche Totalität zurück.","refs":["CH_GB18_BRNO:A7","CH_GB18_BRNO:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D6","text":"Die Verwirklichung hebt die Asymmetrie auf, in der Wirklichkeit nur Möglichkeit eines Anderen und Möglichkeit nur fremde Wirklichkeit war.","refs":["CH_GB18_BRNO:A6","CH_GB18_BRNO:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D7","text":"Was unter bestimmten vollständigen Umständen real möglich ist, kann unter eben diesen Umständen nicht anders erfolgen.","refs":["CH_GB18_BRNO:A8","CH_GB18_BRNO:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D8","text":"Die reale Notwendigkeit enthält Zufälligkeit sowohl wegen der Beschränktheit ihres Inhalts als auch wegen der äußeren Form ihres Ausgangspunkts.","refs":["CH_GB18_BRNO:A11","CH_GB18_BRNO:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_BRNO:SD1","text":"Möglichkeit wird von einer abstrakten Modalitätskategorie in die immanente Instabilität eines realen Bedingungszusammenhangs überführt.","refs":["CH_GB18_BRNO:A4","CH_GB18_BRNO:A5","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SD2","text":"Notwendigkeit ist kein dem Geschehen äußerlich auferlegter Zwang, sondern die Selbstidentität des sich aufhebenden realen Bedingungsfeldes.","refs":["CH_GB18_BRNO:A7","CH_GB18_BRNO:A9","CH_GB18_BRNO:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SD3","text":"Relative Notwendigkeit macht jedes bestimmte Notwendige doppeldeutig: Es ist innerhalb seines Zusammenhangs unausweichlich und als begrenzter Inhalt zugleich kontingent.","refs":["CH_GB18_BRNO:A10","CH_GB18_BRNO:A11","CH_GB18_BRNO:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0015","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SD4","text":"Die Totalität der Bedingungen ist nur äußerlich total, solange ihre Einheit nicht ihre eigenen Voraussetzungen und ihre eigene Zufälligkeit hervorbringt.","refs":["CH_GB18_BRNO:A8","CH_GB18_BRNO:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SD5","text":"Absolute Wirklichkeit erscheint zunächst nur als an sich vorhandene Einheit, weil die reale Notwendigkeit die Differenz von Voraussetzung und Selbstbegründung nicht aufhebt.","refs":["CH_GB18_BRNO:A11","CH_GB18_BRNO:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_BRNO:DNX1","text":"Das System schließt aus, dass Möglichkeit ein isolierter Zustand vor Wirklichkeit sein könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:DNX2","text":"Das System schließt aus, dass Bedingungen als stabile und voneinander unabhängige Gegebenheiten bestehen können.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:DNX3","text":"Das System schließt aus, dass Notwendigkeit ohne einen Prozess der Negation und Selbstaufhebung begriffen werden kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:DNX4","text":"Das System schließt aus, dass relative Notwendigkeit ihre eigene Voraussetzungslosigkeit beanspruchen darf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_BRNO:SNX1","text":"Ausgeschlossen ist eine endgültige Ontologie fester Wirklichkeiten, deren Beziehungen ihre innere Bestimmtheit unberührt lassen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0007","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SNX2","text":"Ausgeschlossen ist eine Notwendigkeit, die Zufälligkeit definitiv aus ihrem Inhalt und ihrer Form eliminieren könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SNX3","text":"Versperrt bleibt die voll aktualisierte absolute Wirklichkeit, solange Voraussetzung und Rückkehr in sich getrennte Bewegungen bleiben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_BRNO:FGS1","text":"Unmittelbare Formeinheit → Gleichgültigkeit gegen Formdifferenz → inhaltsvolle reale Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:FGS2","text":"Reale Wirklichkeit → Ansichsein als unterschiedenes Moment → reale Möglichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:FGS3","text":"Reale Möglichkeit → existierende Bedingungsmannigfaltigkeit → immanenter Widerspruch.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:FGS4","text":"Immanenter Widerspruch → Selbstaufhebung der Bedingungen → wechselseitige Aktualisierung von Möglichkeit und Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:FGS5","text":"Aufgehobene Differenz von Wirklichkeit und Möglichkeit → Selbstidentität der Negation → reale Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:FGS6","text":"Vorausgesetzter Ausgangspunkt und beschränkter Inhalt → innere Zufälligkeit der Notwendigkeit → an sich absolute Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_BRNO:AF1","text":"Formelle Notwendigkeit ohne selbständige Momente → reale Wirklichkeit als gleichgültige Inhaltsidentität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AF2","text":"Reale Wirklichkeit als Selbstbeziehung → reale Möglichkeit als ihr inhaltsvolles Ansichsein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AF3","text":"Reale Möglichkeit als Bedingungsmannigfaltigkeit → Widerspruch und Selbstaufhebung der Bedingungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AF4","text":"Selbstaufhebung des Bedingungsfeldes → Zusammengehen von Möglichkeit und Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AF5","text":"Zusammengehen der Modalitätsmomente → reale Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AF6","text":"Reale Notwendigkeit mit äußerlicher Voraussetzung → Einheit von Notwendigkeit und Zufälligkeit als an sich absolute Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_BRNO:ME1","text":"Möglichkeit wird nicht mehr nach bloßer formeller Widerspruchslosigkeit, sondern nach der realen Konstellation ihrer Bedingungen kartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ME2","text":"Bedingungen werden von äußerlichen Voraussetzungen zu selbstaufhebenden Momenten der Sache umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ME3","text":"Wirklichkeit und Möglichkeit erscheinen nicht als getrennte Modalitäten, sondern als asymmetrische Momente eines einzigen realen Prozesses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ME4","text":"Notwendigkeit wird von der Alternative zur Zufälligkeit in deren reflexive Einheit überführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ME5","text":"Absolute Wirklichkeit wird nicht als gegebene höchste Wirklichkeit, sondern als noch unvollendete Einheit von Notwendigkeit und Zufälligkeit sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_BRNO:ALT1","text":"Surface — Der Text bestimmt das Verhältnis von Wirklichkeit, Möglichkeit, Bedingungen, Notwendigkeit und Zufälligkeit neu.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ALT2","text":"Structural — Reale Möglichkeit fungiert als zerstreutes Bedingungsfeld, dessen immanente Negativität die Verwirklichung hervorbringt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ALT3","text":"Metastrategic — Die Analyse ersetzt die Prüfung isolierter Möglichkeiten durch die Rekonstruktion der Selbstaufhebung ihrer vollständigen Umstände.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ALT4","text":"Ontological/Temporal — Wirklichkeit ist nicht bloß gegenwärtiges Dasein, sondern ein Prozess, in dem Voraussetzungen als fremde Wirklichkeiten auftreten, sich negieren und zur notwendigen Selbstbeziehung zurückkehren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_BRNO:MRT1","text":"Die Axiome reichen aus, um die Bewegung von formeller Notwendigkeit über reale Möglichkeit zur relativen Notwendigkeit zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:MRT2","text":"Unterbestimmt bleibt, wodurch die inhaltliche Bestimmtheit einer konkreten Sache und ihres Bedingungsfeldes selbst erzeugt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BRNO:MRT3","text":"Das System ist kohärent, sofern Selbstaufhebung als immanente Bestimmung der realen Bedingungsmannigfaltigkeit akzeptiert wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:MRT4","text":"Seine stärkste Operation liegt in der Umwandlung äußerlicher Bedingungen in Momente eines immanenten Modalitätsprozesses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:MRT5","text":"Seine zentrale Spannung liegt darin, dass reale Notwendigkeit als Identität bestimmt wird, aber von einer ihr äußerlichen Zufälligkeit ausgeht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0015","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:MRT6","text":"Die Berufung auf vollständige Bedingungen komprimiert die Vermittlung, durch welche Zerstreuung tatsächlich zur Totalität einer Sache wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:MRT7","text":"Die Rekonstruktion bewahrt die gerichtete Bewegung, wenn absolute Wirklichkeit als an sich erreichte, aber noch nicht selbstbegründete Endposition behandelt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T113646118058Z_1b7fcef4","language_code":"en","language_name":"English","title":"B. Relative Necessity or Real Actuality, Possibility, and Necessity.","source_sha256":"b982c961f38596039f64aee968875fdb0caa3c484b49ba9945af12c3b18023fe","sha256":"2723f81a216cc59e8017144168d579844e24d04f3ac2893f4ac89ea3f09bd312","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:36:46.119925+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_BRNO:AS1","text":"Formal necessity remains an immediate unity of formal determinations and therefore possesses no independent inner articulation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS2","text":"The indifference of this unity to its formal differences produces real actuality as actuality full of content, manifold, and preserving itself in its externality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS3","text":"Real possibility determines itself as the existent manifoldness of circumstances that constitute the being-in-itself of an other and therefore contain their own sublation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS4","text":"The complete self-sublation of the nexus of conditions allows actuality and possibility to pass over reciprocally into one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS5","text":"The negation of real possibility produces real necessity as a contentful relation identical with itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS6","text":"Real necessity remains relative because it proceeds from contingent, external, and limited actuality rather than producing its presuppositions itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AS7","text":"The unity of necessity and contingency not yet accomplished designates absolute actuality present in itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_BRNO:A1","text":"Formal necessity is the immediate unity of abstract determinations of form without independent shape.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A2","text":"A unity indifferent to its formal differences possesses content and is real actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A3","text":"Real actuality preserves itself in the manifoldness of its existence through reflection into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A4","text":"Real possibility is the contentful being-in-itself of real actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A5","text":"Real possibility exists as the manifoldness of circumstances relating to a thing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A6","text":"The conditions of a thing are not its own possibility, but the being-in-itself of other actualities.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A7","text":"The manifold existence of real possibility contains within itself its contradiction and its self-sublation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A8","text":"The completeness of the conditions is the contentual totality in which the thing is at once possible and actual.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A9","text":"The self-sublation of real possibility simultaneously sublates its immediate actuality and its being-in-itself of an other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A10","text":"The negation of real possibility is real necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A11","text":"Real necessity presupposes a unity of possibility and actuality not generated from itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:A12","text":"What is really necessary is, on account of its determinate and limited content, at the same time contingent in another respect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_BRNO:NX1","text":"Formal necessity is not an independent totality, because its moments are only immediate determinations of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX2","text":"Real actuality is not mere existence that dissolves into relations of appearance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX3","text":"The activity of the actual is neither a mere passing over into an other nor a mere appearing in an other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX4","text":"Formal possibility is not real possibility, because mere absence of contradiction contains no manifoldness of contentual conditions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX5","text":"The contradiction of real possibility is not an external contradiction of comparison.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX6","text":"The conditions are not first determined as conditions by a reflection external to them.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX7","text":"The self-sublation of real possibility is not a mere passing over into an absolutely other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:NX8","text":"Real necessity is not absolute necessity, because it does not determine its contingency from itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_BRNO:D1","text":"Real actuality is at once contentual self-relation and external manifoldness.","refs":["CH_GB18_BRNO:A2","CH_GB18_BRNO:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D2","text":"Actuality manifests its determinateness by producing effects, without surrendering its independence to the other.","refs":["CH_GB18_BRNO:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D3","text":"The real possibility of a thing lies in an existent field of conditions, not in a mere determination of thought.","refs":["CH_GB18_BRNO:A4","CH_GB18_BRNO:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D4","text":"The field of conditions is possible only because its existent actualities are determined toward sublation and regression into a being-in-itself.","refs":["CH_GB18_BRNO:A5","CH_GB18_BRNO:A6","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D5","text":"When all conditions are complete, the difference between the possibility and actuality of the thing falls back into its contentual totality.","refs":["CH_GB18_BRNO:A7","CH_GB18_BRNO:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D6","text":"Actualization sublates the asymmetry in which actuality was only the possibility of an other and possibility only alien actuality.","refs":["CH_GB18_BRNO:A6","CH_GB18_BRNO:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D7","text":"What is really possible under determinate complete circumstances cannot occur otherwise under precisely these circumstances.","refs":["CH_GB18_BRNO:A8","CH_GB18_BRNO:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:D8","text":"Real necessity contains contingency both because of the limitedness of its content and because of the external form of its point of departure.","refs":["CH_GB18_BRNO:A11","CH_GB18_BRNO:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_BRNO:SD1","text":"Possibility is transferred from an abstract modal category into the immanent instability of a real nexus of conditions.","refs":["CH_GB18_BRNO:A4","CH_GB18_BRNO:A5","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SD2","text":"Necessity is not a compulsion externally imposed upon events, but the self-identity of the self-sublating real field of conditions.","refs":["CH_GB18_BRNO:A7","CH_GB18_BRNO:A9","CH_GB18_BRNO:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SD3","text":"Relative necessity renders every determinate necessary thing ambiguous: within its nexus it is unavoidable and, as limited content, at the same time contingent.","refs":["CH_GB18_BRNO:A10","CH_GB18_BRNO:A11","CH_GB18_BRNO:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0015","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SD4","text":"The totality of conditions is only externally total so long as its unity does not produce its own presuppositions and its own contingency.","refs":["CH_GB18_BRNO:A8","CH_GB18_BRNO:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SD5","text":"Absolute actuality initially appears only as a unity present in itself, because real necessity does not sublate the difference between presupposition and self-grounding.","refs":["CH_GB18_BRNO:A11","CH_GB18_BRNO:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_BRNO:DNX1","text":"The system excludes the possibility that possibility could be an isolated state prior to actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:DNX2","text":"The system excludes the possibility that conditions can exist as stable and mutually independent givens.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:DNX3","text":"The system excludes the possibility that necessity can be comprehended without a process of negation and self-sublation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:DNX4","text":"The system excludes the possibility that relative necessity may claim its own presuppositionlessness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_BRNO:SNX1","text":"Excluded is a final ontology of fixed actualities whose relations leave their inner determinateness untouched.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0007","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SNX2","text":"Excluded is a necessity that could definitively eliminate contingency from its content and its form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:SNX3","text":"Fully actualized absolute actuality remains blocked so long as presupposition and return into itself remain separate movements.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_BRNO:FGS1","text":"Immediate unity of form → indifference to formal difference → contentful real actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:FGS2","text":"Real actuality → being-in-itself as a distinguished moment → real possibility.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:FGS3","text":"Real possibility → existing manifoldness of conditions → immanent contradiction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:FGS4","text":"Immanent contradiction → self-sublation of the conditions → reciprocal actualization of possibility and actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:FGS5","text":"Sublated difference of actuality and possibility → self-identity of negation → real necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:FGS6","text":"Presupposed point of departure and limited content → inner contingency of necessity → absolute actuality in itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_BRNO:AF1","text":"Formal necessity without independent moments → real actuality as indifferent identity of content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AF2","text":"Real actuality as self-relation → real possibility as its contentful being-in-itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AF3","text":"Real possibility as manifoldness of conditions → contradiction and self-sublation of the conditions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AF4","text":"Self-sublation of the field of conditions → convergence of possibility and actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AF5","text":"Convergence of the modal moments → real necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:AF6","text":"Real necessity with external presupposition → unity of necessity and contingency as absolute actuality in itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_BRNO:ME1","text":"Possibility is no longer mapped according to mere formal absence of contradiction, but according to the real constellation of its conditions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ME2","text":"Conditions are reclassified from external presuppositions into self-sublating moments of the thing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ME3","text":"Actuality and possibility appear not as separate modalities, but as asymmetric moments of a single real process.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ME4","text":"Necessity is transferred from being the alternative to contingency into its reflective unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ME5","text":"Absolute actuality becomes visible not as a given highest actuality, but as the still unfinished unity of necessity and contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_BRNO:ALT1","text":"Surface — The text newly determines the relation of actuality, possibility, conditions, necessity, and contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ALT2","text":"Structural — Real possibility functions as a dispersed field of conditions whose immanent negativity produces actualization.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ALT3","text":"Metastrategic — The analysis replaces the examination of isolated possibilities with the reconstruction of the self-sublation of their complete circumstances.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:ALT4","text":"Ontological/Temporal — Actuality is not merely present existence, but a process in which presuppositions emerge as alien actualities, negate themselves, and return to necessary self-relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_BRNO:MRT1","text":"The axioms suffice to reconstruct the movement from formal necessity through real possibility to relative necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:MRT2","text":"What remains underdetermined is how the contentual determinateness of a concrete thing and of its field of conditions is itself generated.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BRNO:MRT3","text":"The system is coherent insofar as self-sublation is accepted as an immanent determination of the real manifoldness of conditions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:MRT4","text":"Its strongest operation lies in the transformation of external conditions into moments of an immanent modal process.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:MRT5","text":"Its central tension lies in the fact that real necessity is determined as identity, yet proceeds from a contingency external to it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0015","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0020","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:MRT6","text":"The appeal to complete conditions compresses the mediation through which dispersion actually becomes the totality of a thing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0007","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0009","trace_type":"Tension","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BRNO:MRT7","text":"The reconstruction preserves the directed movement if absolute actuality is treated as an end-position attained in itself but not yet self-grounded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BRNO:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BRNO:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_BRNO@R001","source_variant_id":"canonical:CH_GB18_BRNO:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 160","title":"B. Relative Necessity or Actuality, Possibility, and Necessity.","context":"Chapter 160","original_title":"B. Relative Nothwendigkeit oder reale Wirklichkeit, Möglichkeit und Nothwendigkeit."},"original_title":"B. Relative Nothwendigkeit oder reale Wirklichkeit, Möglichkeit und Nothwendigkeit.","title_language_code":"en"},{"id":"CH_GB18_CAN0","layer":"CH","title":"C. Absolute Necessity.","order":161,"parents":["RAW_GB18_CAN0"],"revision":"CH_GB18_CAN0@R001","sha256":"6d0317b01004cf01e1b7ad1ae8e1434082f62730f2bd40fa84894d9417c1d9e0","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_CAN0:AS1","text":"Reale Notwendigkeit wird als bestimmte Notwendigkeit bestimmt, weil sie Zufälligkeit als ihre eigene Negation enthält.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AS2","text":"Die als absolut gesetzte Wirklichkeit schlägt wegen der Leere ihrer bloßen Absolutheit in Möglichkeit und Zufälligkeit um.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AS3","text":"Die reale Notwendigkeit erzeugt ihre Voraussetzung selbst, indem sie Wirklichkeit und Möglichkeit wechselseitig aufhebt und setzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AS4","text":"Absolute Notwendigkeit entsteht als Identität von Sein und Wesen, in der Möglichkeit, Wirklichkeit, formelle und reale Notwendigkeit zurückgehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AS5","text":"Die in scheinbar selbständigen Wirklichkeiten verborgene Notwendigkeit offenbart sich als deren blinder Untergang und wird als Substanz expliziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_CAN0:A1","text":"Reale Notwendigkeit ist bestimmte Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A2","text":"Die Bestimmtheit der Notwendigkeit besteht in der in ihr enthaltenen Zufälligkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A3","text":"Bestimmte Notwendigkeit ist unmittelbar wirkliche Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A4","text":"Absolut gesetzte Wirklichkeit ist als bloße Einheit von Wirklichkeit und Möglichkeit eine leere Bestimmung und daher Zufälligkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A5","text":"Reale Notwendigkeit ist das wechselseitige Aufgehobensein von Wirklichkeit in Möglichkeit und Möglichkeit in Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A6","text":"Die Voraussetzung der realen Notwendigkeit ist ihr eigenes Setzen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A7","text":"Notwendigkeit bestimmt sich selbst als Zufälligkeit, indem sie sich von sich abstößt und in diesem Abstoßen zu sich zurückkehrt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A8","text":"Absolute Notwendigkeit ist die Identität des Seins in seiner Negation mit sich selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A9","text":"Das schlechthin Notwendige hat keinen äußeren Grund und keine äußere Bedingung, sondern nur sich selbst zu Grund und Bedingung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A10","text":"Die absolute Identität der Notwendigkeit verkehrt Wirklichkeit in Möglichkeit und Möglichkeit in Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A11","text":"Die Zufälligkeit freier Wirklichkeiten ist das Wesen ihrer Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A12","text":"Die Identität des Seins in seiner Negation ist Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_CAN0:NX1","text":"Formelle Notwendigkeit genügt nicht, weil sie keinen Inhalt und keine Bestimmtheit besitzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:NX2","text":"Absolute Wirklichkeit ist nicht die stabile Ausschließung der Möglichkeit, weil ihre gesetzte Absolutheit selbst Möglichkeit freisetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:NX3","text":"Notwendigkeit ist nicht die bloße Negation der Zufälligkeit, weil Zufälligkeit ihre eigene Bestimmtheit und ihr eigenes Wesen bildet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:NX4","text":"Selbständige Wirklichkeiten sind nicht wahrhaft beziehungslose Einheiten, weil ihre äußere Berührung ihre innere absolute Identität manifestiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:NX5","text":"Der Untergang des Wirklichen ist nicht bloße Vernichtung, weil der Übergang des Seins in Nichts ein Zusammengehen mit sich selbst ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_CAN0:D1","text":"Wirklichkeit ist nur als notwendige Wirklichkeit bestimmt, sofern sie Notwendigkeit als ihr Ansichsein enthält.","refs":["CH_GB18_CAN0:A1","CH_GB18_CAN0:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:D2","text":"Die Möglichkeit der absoluten Wirklichkeit ist keine äußere Alternative, sondern die durch deren leere Selbstgleichheit erzeugte Bestimmung.","refs":["CH_GB18_CAN0:A4","CH_GB18_CAN0:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:D3","text":"Das negative Setzen der Momente von Wirklichkeit und Möglichkeit ist zugleich deren Voraussetzen als aufgehobener Unmittelbarkeit.","refs":["CH_GB18_CAN0:A5","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:D4","text":"Das Sein des Absoluten ist zugleich unmittelbares Sein und reine Reflexion-in-sich.","refs":["CH_GB18_CAN0:A8","CH_GB18_CAN0:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:D5","text":"Die scheinbare Freiheit der einzelnen Wirklichkeiten besteht in einer Unmittelbarkeit, deren negatives Wesen ihren Untergang bereits enthält.","refs":["CH_GB18_CAN0:A10","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_CAN0:SD1","text":"Das Absolute kann nur bestehen, indem es seine eigene Andersheit hervorbringt, durchdringt und als eigene Selbstbeziehung zurücknimmt.","refs":["CH_GB18_CAN0:A5","CH_GB18_CAN0:A6","CH_GB18_CAN0:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:SD2","text":"Zufälligkeit wird von einer Grenze der Notwendigkeit zu deren immanenter Erscheinungsweise transformiert.","refs":["CH_GB18_CAN0:A2","CH_GB18_CAN0:A7","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:SD3","text":"Die Unabhängigkeit endlicher Wirklichkeiten ist eine Gestalt der Selbstverhüllung des Absoluten, nicht eine ontologische Autonomie außerhalb desselben.","refs":["CH_GB18_CAN0:A9","CH_GB18_CAN0:A10","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:SD4","text":"Substanz ist keine ruhende Grundlage hinter den Dingen, sondern die Bewegung, in der die absolute Identität ihre Entäußerung als eigene Auslegung vollzieht.","refs":["CH_GB18_CAN0:A8","CH_GB18_CAN0:A11","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_CAN0:DNX1","text":"Ausgeschlossen ist ein Modell, in dem Notwendigkeit durch ein ihr äußerliches Gesetz, einen fremden Grund oder eine vorgängige Bedingung erklärt wird.","refs":["CH_GB18_CAN0:A6","CH_GB18_CAN0:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:DNX2","text":"Ausgeschlossen ist ein Modell stabiler endlicher Selbständigkeit, in dem Wirklichkeiten ohne immanente negative Beziehung fortbestehen könnten.","refs":["CH_GB18_CAN0:A10","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:DNX3","text":"Ausgeschlossen ist eine Trennung von Sein und Wesen, in der eines als ursprünglich und das andere als abgeleitet gelten könnte.","refs":["CH_GB18_CAN0:A8","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_CAN0:SNX1","text":"Unverfügbar ist eine letzte positive Bestimmung des Absoluten, die nicht zugleich Negativität, Entäußerung und Rückkehr zu sich wäre.","refs":["CH_GB18_CAN0:A7","CH_GB18_CAN0:A8","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0012","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:SNX2","text":"Unmöglich ist eine endgültige Gegenüberstellung von Notwendigkeit und Zufälligkeit, weil jede als die Wahrheit der anderen fungiert.","refs":["CH_GB18_CAN0:A2","CH_GB18_CAN0:A7","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_CAN0:FGS1","text":"Bestimmte Notwendigkeit → Enthaltensein der Zufälligkeit → unmittelbare notwendige Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:FGS2","text":"Absolute Wirklichkeit → leere Einheit mit Möglichkeit → Umschlag in Möglichkeit und Zufälligkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:FGS3","text":"Wechsel von Wirklichkeit und Möglichkeit → Selbstsetzung der Voraussetzung → Selbstbestimmung der Notwendigkeit als Zufälligkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:FGS4","text":"Selbstbezügliche Negativität → Identität von Sein und Wesen → absolute Notwendigkeit ohne äußeren Grund.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:FGS5","text":"Scheinbare Selbständigkeit → Hervorbrechen der Negativität → Untergang als Selbstmanifestation → Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_CAN0:AF1","text":"Formelle Leere der Notwendigkeit → Forderung nach bestimmter Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AF2","text":"Bestimmte Notwendigkeit → Zufälligkeit als immanente Negation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AF3","text":"Notwendige Wirklichkeit → leere Absolutheit → Möglichkeit und Zufälligkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AF4","text":"Gegenseitiger Umschlag von Wirklichkeit und Möglichkeit → Selbstsetzung → absolute Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AF5","text":"Blinde Notwendigkeit freier Wirklichkeiten → Offenbarung ihrer Negativität → Substanz als Selbst-Auslegung des Absoluten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_CAN0:ME1","text":"Zufälligkeit wird von einem bloß äußerlichen Gegenbegriff der Notwendigkeit zu deren innerem Bestimmungsprinzip umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ME2","text":"Möglichkeit und Wirklichkeit erscheinen nicht mehr als getrennte Modalitäten, sondern als ineinander umschlagende Momente einer Selbstvermittlung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ME3","text":"Die Differenz von Form und Inhalt wird als begrenzte Gestalt der realen Notwendigkeit sichtbar und in absoluter Notwendigkeit aufgehoben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ME4","text":"Endliche Selbständigkeit wird als erscheinende Form einer verborgenen Selbstnegation und nicht als letzte ontologische Einheit kartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_CAN0:ALT1","text":"Surface — Der Text bestimmt das Verhältnis von Wirklichkeit, Möglichkeit, Zufälligkeit und Notwendigkeit neu.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ALT2","text":"Structural — Notwendigkeit funktioniert als Selbstbewegung, die ihre Voraussetzungen setzt, ihre Momente aufhebt und sie als eigene Bestimmungen reproduziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ALT3","text":"Metastrategic — Die Erklärung eines scheinbar äußerlichen Übergangs wird durch seine Reklassifikation als immanente Selbstmanifestation ersetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ALT4","text":"Ontological/Temporal — Sein ist nur als in seiner Negation mit sich identische Bewegung bestimmt; Werden und Untergang sind Formen der Rückkehr zu sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_CAN0:MRT1","text":"Die Axiome reichen aus, um den Übergang von realer zu absoluter Notwendigkeit und von absoluter Notwendigkeit zu Substanz zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:MRT2","text":"Unterbestimmt bleibt, warum die leere Absolutheit notwendig in Zufälligkeit umschlagen muss und nicht bei abstrakter Selbstidentität stehen kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Direct","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:MRT3","text":"Die Struktur ist intern kohärent, sofern Negation nicht als äußerer Gegensatz, sondern als Selbstbestimmung der Notwendigkeit gelesen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:MRT4","text":"Die stärkste Stelle des Systems ist die Identifikation von Zufälligkeit als Erscheinungsweise und Wesen der absoluten Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0015","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0017","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:MRT5","text":"Die zentrale Bruchlinie liegt zwischen der behaupteten absoluten Identität und der fortbestehenden Erscheinung freier, scheinbar beziehungsloser Wirklichkeiten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0013","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:MRT6","text":"Die Rekonstruktion bewahrt die Bewegung nur, wenn Blindheit und Selbstoffenbarung nicht als Gegensätze, sondern als aufeinander folgende Gestalten derselben Notwendigkeit behandelt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0012","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0017","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T113757805052Z_6fa76eca","language_code":"en","language_name":"English","title":"C. Absolute Necessity.","source_sha256":"6d0317b01004cf01e1b7ad1ae8e1434082f62730f2bd40fa84894d9417c1d9e0","sha256":"152d60c3d0a74d550eb887a1eb49f81b83f314e283578114b3a706b28326010e","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:37:57.806349+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_CAN0:AS1","text":"Real necessity is determined as determinate necessity because it contains contingency as its own negation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AS2","text":"Actuality posited as absolute reverses into possibility and contingency because of the emptiness of its mere absoluteness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AS3","text":"Real necessity itself produces its presupposition by reciprocally sublating and positing actuality and possibility.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AS4","text":"Absolute necessity arises as the identity of being and essence, into which possibility, actuality, formal and real necessity regress.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AS5","text":"The necessity concealed in seemingly self-subsistent actualities reveals itself as their blind perishing and is explicated as substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_CAN0:A1","text":"Real necessity is determinate necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A2","text":"The determinacy of necessity consists in the contingency contained within it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A3","text":"Determinate necessity is immediately actual necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A4","text":"Actuality posited as absolute is, as a mere unity of actuality and possibility, an empty determination and therefore contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A5","text":"Real necessity is the reciprocal sublatedness of actuality in possibility and possibility in actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A6","text":"The presupposition of real necessity is its own positing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A7","text":"Necessity determines itself as contingency by repelling itself from itself and, in this repulsion, returning to itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A8","text":"Absolute necessity is the identity of being with itself in its negation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A9","text":"The absolutely necessary has no external ground and no external condition, but only itself as ground and condition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A10","text":"The absolute identity of necessity reverses actuality into possibility and possibility into actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A11","text":"The contingency of free actualities is the essence of their necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:A12","text":"The identity of being in its negation is substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_CAN0:NX1","text":"Formal necessity is insufficient because it possesses no content and no determinacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:NX2","text":"Absolute actuality is not the stable exclusion of possibility, because its posited absoluteness itself releases possibility.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:NX3","text":"Necessity is not the mere negation of contingency, because contingency constitutes its own determinacy and its own essence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:NX4","text":"Self-subsistent actualities are not truly relationless unities, because their external contact manifests their internal absolute identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:NX5","text":"The perishing of the actual is not mere annihilation, because the transition of being into nothing is a coming-together with itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_CAN0:D1","text":"Actuality is determined as necessary actuality only insofar as it contains necessity as its being-in-itself.","refs":["CH_GB18_CAN0:A1","CH_GB18_CAN0:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:D2","text":"The possibility of absolute actuality is not an external alternative, but the determination generated through its empty self-sameness.","refs":["CH_GB18_CAN0:A4","CH_GB18_CAN0:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:D3","text":"The negative positing of the moments of actuality and possibility is at the same time their presupposing as sublated immediacy.","refs":["CH_GB18_CAN0:A5","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:D4","text":"The being of the absolute is at once immediate being and pure reflection-into-itself.","refs":["CH_GB18_CAN0:A8","CH_GB18_CAN0:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:D5","text":"The apparent freedom of individual actualities consists in an immediacy whose negative essence already contains their perishing.","refs":["CH_GB18_CAN0:A10","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_CAN0:SD1","text":"The absolute can subsist only by producing, permeating, and taking back its own otherness as its own self-relation.","refs":["CH_GB18_CAN0:A5","CH_GB18_CAN0:A6","CH_GB18_CAN0:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:SD2","text":"Contingency is transformed from a limit of necessity into its immanent mode of appearance.","refs":["CH_GB18_CAN0:A2","CH_GB18_CAN0:A7","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:SD3","text":"The independence of finite actualities is a form of the absolute's self-concealment, not an ontological autonomy outside it.","refs":["CH_GB18_CAN0:A9","CH_GB18_CAN0:A10","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:SD4","text":"Substance is not a resting ground behind things, but the movement in which absolute identity accomplishes its externalization as its own exposition.","refs":["CH_GB18_CAN0:A8","CH_GB18_CAN0:A11","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_CAN0:DNX1","text":"Excluded is a model in which necessity is explained through a law external to it, an alien ground, or a prior condition.","refs":["CH_GB18_CAN0:A6","CH_GB18_CAN0:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:DNX2","text":"Excluded is a model of stable finite self-subsistence in which actualities could persist without an immanent negative relation.","refs":["CH_GB18_CAN0:A10","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:DNX3","text":"Excluded is a separation of being and essence in which one could count as original and the other as derived.","refs":["CH_GB18_CAN0:A8","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_CAN0:SNX1","text":"Unavailable is an ultimate positive determination of the absolute that would not at the same time be negativity, externalization, and return to itself.","refs":["CH_GB18_CAN0:A7","CH_GB18_CAN0:A8","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0012","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:SNX2","text":"Impossible is a final opposition of necessity and contingency, because each functions as the truth of the other.","refs":["CH_GB18_CAN0:A2","CH_GB18_CAN0:A7","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_CAN0:FGS1","text":"Determinate necessity → containment of contingency → immediate necessary actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:FGS2","text":"Absolute actuality → empty unity with possibility → reversal into possibility and contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:FGS3","text":"Alternation of actuality and possibility → self-positing of the presupposition → self-determination of necessity as contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:FGS4","text":"Self-relating negativity → identity of being and essence → absolute necessity without external ground.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:FGS5","text":"Apparent self-subsistence → eruption of negativity → perishing as self-manifestation → substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_CAN0:AF1","text":"Formal emptiness of necessity → demand for determinate necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AF2","text":"Determinate necessity → contingency as immanent negation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AF3","text":"Necessary actuality → empty absoluteness → possibility and contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AF4","text":"Reciprocal reversal of actuality and possibility → self-positing → absolute necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:AF5","text":"Blind necessity of free actualities → revelation of their negativity → substance as the absolute's self-exposition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_CAN0:ME1","text":"Contingency is reclassified from a merely external counter-concept of necessity into its internal principle of determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ME2","text":"Possibility and actuality no longer appear as separate modalities, but as moments of a self-mediation that reverse into one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ME3","text":"The difference between form and content becomes visible as a limited shape of real necessity and is sublated in absolute necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ME4","text":"Finite self-subsistence is mapped as the appearing form of a concealed self-negation and not as the ultimate ontological unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_CAN0:ALT1","text":"Surface — The text newly determines the relation of actuality, possibility, contingency, and necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ALT2","text":"Structural — Necessity functions as self-movement that posits its presuppositions, sublates its moments, and reproduces them as its own determinations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ALT3","text":"Metastrategic — The explanation of a seemingly external transition is replaced by its reclassification as immanent self-manifestation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:ALT4","text":"Ontological/Temporal — Being is determined only as movement identical with itself in its negation; becoming and perishing are forms of return to itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_CAN0:MRT1","text":"The axioms suffice to reconstruct the transition from real to absolute necessity and from absolute necessity to substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:MRT2","text":"It remains underdetermined why empty absoluteness must necessarily reverse into contingency and cannot remain at abstract self-identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0003","trace_type":"Direct","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:MRT3","text":"The structure is internally coherent insofar as negation is read not as an external opposition, but as the self-determination of necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:MRT4","text":"The strongest point of the system is the identification of contingency as the mode of appearance and essence of absolute necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0015","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0017","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:MRT5","text":"The central fault line lies between the asserted absolute identity and the persisting appearance of free, seemingly relationless actualities.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0013","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CAN0:MRT6","text":"The reconstruction preserves the movement only if blindness and self-revelation are treated not as opposites, but as successive shapes of the same necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CAN0:P0012","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0017","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CAN0:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_CAN0@R001","source_variant_id":"canonical:CH_GB18_CAN0:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 161","title":"C. Absolute Necessity.","context":"Chapter 161","original_title":"C. Absolute Nothwendigkeit."},"original_title":"C. Absolute Nothwendigkeit.","title_language_code":"en"},{"id":"CH_GB18_DV_2","layer":"CH","title":"A. The Relation of Substantiality.","order":162,"parents":["RAW_GB18_DV_2"],"revision":"CH_GB18_DV_2@R001","sha256":"195a009a8de26857f039f6b39c8ebafb5caade77e3d15cbe2b05ec44602f5485","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_DV_2:AS1","text":"Absolute Nothwendigkeit muß als sich selbst vermittelndes Seyn und nicht als einzelnes nothwendiges Seiendes bestimmt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:AS2","text":"Die Substanz ist die unmittelbare Wirklichkeit, insofern diese vollständig in sich reflektiert und daher nur als eigenes Scheinen besteht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:AS3","text":"Accidentalität ist nicht äußerlicher Wechsel an einer ruhenden Substanz, sondern deren eigenes Gesetztseyn als Werden, Möglichkeit und Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:AS4","text":"Die Substanz wirkt nur als immanente Macht: Sie erzeugt und vernichtet ihre Bestimmungen, indem Möglichkeit und Wirklichkeit ineinander übergehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:AS5","text":"Die unmittelbare Einheit von Substanz und Accidenzen läßt die Substanz zunächst nur als formelle, innere Macht erscheinen und setzt noch keinen realen Unterschied.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:AS6","text":"Indem Accidentalität als selbstbezügliche Negativität gesetzt wird, wird die Substanz als für sich seyende Macht bestimmt; dadurch schlägt Substantialität in Kausalität um.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_DV_2:A1","text":"Absolute Nothwendigkeit ist absolutes Verhältniß als die Vermittlung des Seyns mit sich selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A2","text":"Die Substanz ist die Einheit von Seyn und Reflexion als unmittelbare, in sich reflektierte Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A3","text":"Die Substanz besteht wesentlich nur als Scheinen und Gesetztseyn ihrer selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A4","text":"Accidentalität ist das mit sich identische Gesetztseyn des Seyns und damit die scheinende Totalität der Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A5","text":"Möglichkeit und Wirklichkeit bilden in der Accidentalität eine identische Form, deren unmittelbare Gestalt Werden und Zufälligkeit ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A6","text":"Die Bewegung der Accidentalität vermittelt die Kategorien des Seyns mit den Reflexionsbestimmungen des Wesens und erzeugt daraus nothwendige Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A7","text":"Die Aktuosität der Substanz ist ein gegenstandsloses Hervorgehen ihrer selbst in einem widerstandslosen Element.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A8","text":"Das Aufheben eines Vorausgesetzten setzt erst das Selbst, von dem dieses Aufheben ausgeht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A9","text":"Die Substanz umfaßt die Accidentalität als Totalität, und die Accidentalität ist ihrerseits die ganze Substanz in der Form des Scheins.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A10","text":"Die Substanz ist absolute Macht, weil sie Möglichkeit in Wirklichkeit übersetzt und Wirklichkeit in Möglichkeit zurückführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A11","text":"Schaffen und Zerstören sind identisch, weil Positives und Negatives sowie Möglichkeit und Wirklichkeit in substantieller Nothwendigkeit vereint sind.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A12","text":"Accidenzen besitzen keine eigenthümliche Macht; jede scheinbare Machtbeziehung zwischen ihnen ist die Macht der sie umfassenden Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A13","text":"Die erste Einheit von Substanz und Accidenzen setzt noch keinen realen Unterschied und offenbart die Substanz nur als formelle Macht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A14","text":"Als gesetzte selbstbezügliche Negativität wird Accidentalität für sich seyende Macht; dadurch geht das Substantialitäts-Verhältniß in das Kausalitäts-Verhältniß über.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_DV_2:NX1","text":"Absolute Nothwendigkeit ist weder ein nothwendiges Ding noch das abstrakte Prädikat eines Seienden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX2","text":"Die Substanz ist weder unreflektirte Unmittelbarkeit noch ein abstraktes Jenseits hinter Existenz und Erscheinung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX3","text":"Die Seiten des absoluten Verhältnisses sind keine Attribute, die eine äußere Reflexion an einem vorausgesetzten Absoluten auffindet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX4","text":"Das Wirken der Substanz ist keine Tätigkeit gegen ein fremdes Objekt oder einen widerständigen Stoff.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX5","text":"Die formlose, unbestimmte Identität einer hinter den Accidenzen stehenden Substanz besitzt keine Wahrheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX6","text":"Accidenzen sind keine selbstmächtigen Einheiten, deren gegenseitige Einwirkung aus eigener Selbständigkeit entspringt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX7","text":"Die erste Gegenwart der Substanz in den Accidenzen ist kein realer Unterschied zwischen einem beharrenden Träger und äußerlichen Eigenschaften.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX8","text":"Das Substantialitäts-Verhältniß ist nicht die vollendete Selbstmanifestation der Substanz als Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_DV_2:D1","text":"Die Manifestation des Absoluten ist keine nachträgliche Darstellung eines vorausliegenden Wesens, sondern dessen Wirklichkeit als Selbstsetzung.","refs":["CH_GB18_DV_2:A1","CH_GB18_DV_2:A2","CH_GB18_DV_2:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D2","text":"Zufälligkeit ist die unmittelbare Erscheinungsform einer Bewegung, deren immanente Reflexion sie als nothwendige Wirklichkeit bestimmt.","refs":["CH_GB18_DV_2:A5","CH_GB18_DV_2:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D3","text":"Jeder Übergang eines Bestimmten in ein Anderes ist zugleich Rückgang in den Grund seiner Möglichkeit und Hervorgang notwendiger Wirklichkeit.","refs":["CH_GB18_DV_2:A5","CH_GB18_DV_2:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D4","text":"Die Selbsttätigkeit der Substanz besteht darin, daß sie ihre Voraussetzung nur durch deren Aufhebung und damit als eigene Setzung hat.","refs":["CH_GB18_DV_2:A7","CH_GB18_DV_2:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D5","text":"Die Macht der Substanz verteilt Form- und Inhaltsdifferenzen innerhalb einer Totalität, ohne den Accidenzen selbständige Wirksamkeit zu überlassen.","refs":["CH_GB18_DV_2:A9","CH_GB18_DV_2:A10","CH_GB18_DV_2:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D6","text":"Das Verschwinden einer Accidenz und das Entstehen einer anderen sind ein einziger substantieller Prozeß der Umformung von Möglichkeit und Wirklichkeit.","refs":["CH_GB18_DV_2:A10","CH_GB18_DV_2:A11","CH_GB18_DV_2:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D7","text":"Kausalität entsteht nicht durch Hinzutreten einer äußeren Ursache, sondern durch die Setzung der bisher nur an sich substantiellen Accidentalität als für sich seyende Negativität.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_DV_2:SD1","text":"Das Absolute kann nicht von seiner Manifestation getrennt werden, weil sein Bestehen ausschließlich als reflexive Selbstsetzung bestimmt ist.","refs":["CH_GB18_DV_2:A1","CH_GB18_DV_2:A2","CH_GB18_DV_2:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SD2","text":"Kontingenz wird als notwendige Binnenform des Absoluten umklassifiziert: Ihr Wechsel ist nicht Gegeninstanz, sondern Vollzug substantieller Macht.","refs":["CH_GB18_DV_2:A5","CH_GB18_DV_2:A6","CH_GB18_DV_2:A9","CH_GB18_DV_2:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SD3","text":"Produktivität und Negativität bilden keine entgegengesetzten Prozesse, sondern dieselbe absolute Bewegung unter verschiedenen Formbestimmungen.","refs":["CH_GB18_DV_2:A10","CH_GB18_DV_2:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SD4","text":"Pluralität besitzt nur abgeleitete Realität: Die Mehrheit der Accidenzen artikuliert eine Macht, die ihre Unterschiede zugleich setzt und aufhebt.","refs":["CH_GB18_DV_2:A9","CH_GB18_DV_2:A10","CH_GB18_DV_2:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SD5","text":"Der Übergang zur Kausalität verlangt eine Differenz, die innerhalb der Substantialität zunächst ausgeschlossen ist; die Kausalität wird daher aus der Unzulänglichkeit ihrer ersten Gestalt erzeugt.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_DV_2:DNX1","text":"Ausgeschlossen ist ein Substratmodell, in dem die Substanz unverändert hinter ihren Erscheinungen ruht und von ihnen ontologisch getrennt bleibt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:DNX2","text":"Ausgeschlossen ist ein Modell äußerlicher Verursachung, in dem getrennte Dinge ihre Macht unabhängig besitzen und nachträglich aufeinander einwirken.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:DNX3","text":"Ausgeschlossen ist eine feste Trennung von Möglichkeit und Wirklichkeit, in der das Mögliche bloß vorwirklich und das Wirkliche bloß vollzogen wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:DNX4","text":"Ausgeschlossen ist eine irreversible Zeitordnung, in der Schaffen nur Hervorbringen und Zerstören nur Verlust bedeuten könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:DNX5","text":"Ausgeschlossen ist eine Kontingenz, die als selbständiger Bereich außerhalb der Nothwendigkeit bestehen könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_DV_2:SNX1","text":"Unverfügbar ist ein Absolutes, das seine Wahrheit außerhalb seines eigenen Scheins, seiner Accidenzen oder seiner Selbstmanifestation besäße.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SNX2","text":"Unverfügbar ist ein absoluter Anfang, der nicht schon Setzung eines Selbst und Aufhebung eines Vorausgesetzten wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SNX3","text":"Unverfügbar ist eine endgültige ruhende Einheit, weil die substanzielle Identität nur als fortgesetzte Entzweiung und Reinigung ihrer Formdifferenzen besteht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SNX4","text":"Unverfügbar ist ein vollständig autonomes Accidentelles, weil dessen Bestehen stets durch die Totalität begründet wird, die es zugleich übersteigt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_DV_2:FGS1","text":"Absolute Nothwendigkeit → Selbstvermittlung des Seyns → absolutes Verhältniß.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:FGS2","text":"Absolutes Verhältniß → Einheit von Seyn und Reflexion → Substanz als in sich reflektierte Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:FGS3","text":"Substanz als Scheinen → identisches Gesetztseyn → Accidentalität als scheinende Totalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:FGS4","text":"Accidentalität → Möglichkeit/Wirklichkeit → Werden und Zufälligkeit → notwendige Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:FGS5","text":"Notwendige Wirklichkeit → immanente Macht → identisches Schaffen und Zerstören → Umschlag der Accidenzen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:FGS6","text":"Formelle Macht ohne realen Unterschied → gesetzte selbstbezügliche Negativität → für sich seyende Macht → Kausalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_DV_2:AF1","text":"Abstraktes Nothwendiges **→** Nothwendigkeit als Selbstvermittlung **→** Substanz als reflektierte Wirklichkeit **→** Accidentalität als ihr Scheinen **→** Macht als Umschlag von Möglichkeit und Wirklichkeit **→** Unzulänglichkeit der bloß formellen Substantialität **→** Kausalitäts-Verhältniß.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_DV_2:ME1","text":"Die Gegenüberstellung von bleibender Substanz und wechselnden Accidenzen wird in eine Selbstunterscheidung einer einzigen Totalität überführt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ME2","text":"Möglichkeit, Wirklichkeit, Entstehen und Vergehen werden nicht als getrennte ontologische Bereiche, sondern als ineinander übergehende Bestimmungen substantieller Nothwendigkeit sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ME3","text":"Scheinbare Wechselwirkung selbständiger Dinge wird als abgeleitete Erscheinung einer sie umfassenden Macht neu klassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ME4","text":"Kontingenz verliert den Status eines Gegenbegriffs zur Nothwendigkeit und wird als deren unmittelbare Bewegungsform bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ME5","text":"Kausalität erscheint als immanente Explikation eines Defizits der Substantialität und nicht als äußerlich hinzutretende Relationsform.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_DV_2:ALT1","text":"Surface — Das Verhältnis von Substanz und Accidenzen wird als Verhältnis von Beharren, Wechsel, Entstehen und Vergehen bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0011","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ALT2","text":"Structural — Substanz organisiert alle Accidenzen als Totalität und macht ihre scheinbare Selbständigkeit zur Form ihres eigenen Gesetztseyns.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ALT3","text":"Metastrategic — Die Analyse ersetzt äußerliche Erklärung durch immanente Rekonstruktion: Was als vorausgesetzt erscheint, wird als Resultat von Selbstsetzung bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ALT4","text":"Ontological/Temporal — Sein ist nur als reflektiertes Scheinen wirklich; Zeitlichkeit erscheint als rekursive Bewegung von Hervorbringen, Aufheben und Rückkehr in Möglichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_DV_2:MRT1","text":"Die Axiome reichen aus, um die Bestimmung der Substanz als Einheit von Seyn, Reflexion, Scheinen und Accidentalität zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:MRT2","text":"Die Axiome reichen aus, um die Identität von produktiver und zerstörender Macht sowie die Abhängigkeit der Accidenzen zu erzeugen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:MRT3","text":"Der Übergang zur Kausalität bleibt hinsichtlich der genauen Notwendigkeit unterbestimmt, weil die Setzung selbstbezüglicher Negativität als neuer Bestimmungsstatus erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_DV_2:MRT4","text":"Die Struktur ist kohärent, sofern Realität, Reflexion, Schein und Gesetztseyn als verschiedene Artikulationen derselben absoluten Bewegung gelten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:MRT5","text":"Die stärkste Stelle des Systems ist die Umwandlung des Gegensatzes von Zufälligkeit und Nothwendigkeit in einen immanenten Übergangsmechanismus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:MRT6","text":"Die stärkste Bruchlinie liegt zwischen der Behauptung fehlenden realen Unterschieds und der Erfordernis einer Differenz, aus der Kausalität hervorgehen kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:MRT7","text":"Die Rekonstruktion bewahrt die Bewegung nur, wenn die Unzulänglichkeit der formellen Substantialität als produktiver Grund ihres Umschlags und nicht als äußerer Einwand behandelt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T115801466434Z_33ebe371","language_code":"en","language_name":"English","title":"A. The Relation of Substantiality.","source_sha256":"195a009a8de26857f039f6b39c8ebafb5caade77e3d15cbe2b05ec44602f5485","sha256":"2dddf14829dd0bcab3c6226a04e773d4bfa01272750a4de9b863e012f6c526d4","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:58:01.468713+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_DV_2:AS1","text":"Absolute Necessity must be determined as Being mediating itself with itself and not as an individual necessary being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:AS2","text":"Substance is immediate actuality, insofar as this is completely reflected into itself and therefore exists only as its own shine.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:AS3","text":"Accidentality is not an external change in a resting substance, but rather its own positedness as becoming, possibility, and actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:AS4","text":"Substance acts only as immanent power: it produces and annihilates its determinations by possibility and actuality passing over into one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:AS5","text":"The immediate unity of substance and accidents initially lets substance appear only as formal, inner power and does not yet posit any real difference.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:AS6","text":"In that accidentality is posited as self-related negativity, substance is determined as power being-for-self; thereby substantiality passes over into causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_DV_2:A1","text":"Absolute Necessity is absolute relation as the mediation of Being with itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A2","text":"Substance is the unity of Being and reflection as immediate actuality reflected into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A3","text":"Substance essentially exists only as shine and positedness of itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A4","text":"Accidentality is the positedness of Being identical with itself and hence the shining totality of substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A5","text":"Possibility and actuality constitute in accidentality an identical form, whose immediate shape is becoming and contingency.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A6","text":"The movement of accidentality mediates the categories of Being with the determinations of reflection of Essence and thereby produces necessary actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A7","text":"The actuosity of substance is an objectless emergence of itself in a resistanceless element.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A8","text":"The sublation of something presupposed first posits the self from which this sublation proceeds.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A9","text":"Substance encompasses accidentality as totality, and accidentality is in turn the whole substance in the form of shine.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A10","text":"Substance is absolute power because it translates possibility into actuality and leads actuality back into possibility.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A11","text":"Creation and destruction are identical because the positive and the negative, as well as possibility and actuality, are united in substantial Necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0013","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A12","text":"Accidents possess no peculiar power; every apparent power-relation between them is the power of the substance that encompasses them.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A13","text":"The first unity of substance and accidents does not yet posit any real difference and reveals substance only as formal power.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:A14","text":"As posited self-related negativity, accidentality becomes power being-for-self; thereby the relation of substantiality passes over into the relation of causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_DV_2:NX1","text":"Absolute Necessity is neither a necessary thing nor the abstract predicate of a being.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX2","text":"Substance is neither unreflected immediacy nor an abstract beyond behind existence and appearance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX3","text":"The sides of the absolute relation are not attributes that an external reflection discovers in a presupposed Absolute.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX4","text":"The action of substance is not an activity against an alien object or a resistant material.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX5","text":"The formless, indeterminate identity of a substance standing behind the accidents possesses no truth.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX6","text":"Accidents are not self-empowered unities whose reciprocal action springs from their own independence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX7","text":"The first presence of substance in the accidents is not a real difference between an enduring substrate and external properties.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:NX8","text":"The relation of substantiality is not the completed self-manifestation of substance as substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_DV_2:D1","text":"The manifestation of the Absolute is not a subsequent presentation of a preceding Essence, but its actuality as self-positing.","refs":["CH_GB18_DV_2:A1","CH_GB18_DV_2:A2","CH_GB18_DV_2:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D2","text":"Contingency is the immediate form of appearance of a movement whose immanent reflection determines it as necessary actuality.","refs":["CH_GB18_DV_2:A5","CH_GB18_DV_2:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D3","text":"Every transition of a determinate into another is at once a return into the ground of its possibility and an emergence of necessary actuality.","refs":["CH_GB18_DV_2:A5","CH_GB18_DV_2:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D4","text":"The self-activity of substance consists in its having its presupposition only through its sublation and thus as its own positing.","refs":["CH_GB18_DV_2:A7","CH_GB18_DV_2:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D5","text":"The power of substance distributes differences of form and content within a totality, without leaving independent efficacy to the accidents themselves.","refs":["CH_GB18_DV_2:A9","CH_GB18_DV_2:A10","CH_GB18_DV_2:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D6","text":"The disappearance of one accident and the emergence of another are a single substantial process of the transformation of possibility and actuality.","refs":["CH_GB18_DV_2:A10","CH_GB18_DV_2:A11","CH_GB18_DV_2:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:D7","text":"Causality does not arise through the addition of an external cause, but through the positing of the accidentality hitherto substantial only in itself as negativity being-for-self.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_DV_2:SD1","text":"The Absolute cannot be separated from its manifestation, because its subsistence is determined exclusively as reflexive self-positing.","refs":["CH_GB18_DV_2:A1","CH_GB18_DV_2:A2","CH_GB18_DV_2:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SD2","text":"Contingency is reclassified as a necessary internal form of the Absolute: its change is not a counter-instance, but the execution of substantial power.","refs":["CH_GB18_DV_2:A5","CH_GB18_DV_2:A6","CH_GB18_DV_2:A9","CH_GB18_DV_2:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SD3","text":"Productivity and negativity do not constitute opposed processes, but the same absolute movement under different determinations of form.","refs":["CH_GB18_DV_2:A10","CH_GB18_DV_2:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SD4","text":"Plurality possesses only derivative reality: the multiplicity of accidents articulates a power that at once posits and sublates their differences.","refs":["CH_GB18_DV_2:A9","CH_GB18_DV_2:A10","CH_GB18_DV_2:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SD5","text":"The transition to causality requires a difference that is initially excluded within substantiality; causality is therefore generated from the inadequacy of its first shape.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_DV_2:DNX1","text":"Excluded is a substrate model in which substance rests unchanged behind its appearances and remains ontologically separate from them.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:DNX2","text":"Excluded is a model of external causation in which separate things possess their power independently and subsequently act upon one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0014","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:DNX3","text":"Excluded is a fixed separation of possibility and actuality in which the possible would be merely pre-actual and the actual merely enacted.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:DNX4","text":"Excluded is an irreversible temporal order in which creation could mean only production and destruction only loss.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:DNX5","text":"Excluded is a contingency that could subsist as an independent sphere outside Necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_DV_2:SNX1","text":"Unavailable is an Absolute that would possess its truth outside its own shine, its accidents, or its self-manifestation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SNX2","text":"Unavailable is an absolute beginning that would not already be the positing of a self and the sublation of something presupposed.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SNX3","text":"Unavailable is a final resting unity, because substantial identity exists only as the continued diremption and purification of its differences of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0015","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:SNX4","text":"Unavailable is a fully autonomous accidental, because its subsistence is always grounded by the totality that at once transcends it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0016","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_DV_2:FGS1","text":"Absolute Necessity → self-mediation of Being → absolute relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:FGS2","text":"Absolute relation → unity of Being and reflection → substance as actuality reflected into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:FGS3","text":"Substance as shine → identical positedness → accidentality as shining totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:FGS4","text":"Accidentality → possibility/actuality → becoming and contingency → necessary actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:FGS5","text":"Necessary actuality → immanent power → identical creation and destruction → transition of the accidents.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:FGS6","text":"Formal power without real difference → posited self-related negativity → power being-for-self → causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_DV_2:AF1","text":"Abstract Necessary **→** Necessity as self-mediation **→** substance as reflected actuality **→** accidentality as its shine **→** power as transition of possibility and actuality **→** inadequacy of merely formal substantiality **→** relation of causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_DV_2:ME1","text":"The opposition of enduring substance and changing accidents is transformed into the self-differentiation of a single totality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ME2","text":"Possibility, actuality, arising, and passing away become visible not as separate ontological spheres, but as determinations of substantial Necessity passing over into one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ME3","text":"The apparent reciprocal action of independent things is reclassified as a derivative appearance of a power encompassing them.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ME4","text":"Contingency loses the status of a counter-concept to Necessity and is determined as its immediate form of movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ME5","text":"Causality appears as the immanent explication of a deficit of substantiality and not as a form of relation added externally.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_DV_2:ALT1","text":"Surface — The relation of substance and accidents is determined as the relation of endurance, change, arising, and passing away.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0011","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ALT2","text":"Structural — Substance organizes all accidents as totality and makes their apparent independence into the form of its own positedness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ALT3","text":"Metastrategic — The analysis replaces external explanation with immanent reconstruction: what appears as presupposed is determined as the result of self-positing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:ALT4","text":"Ontological/Temporal — Being is actual only as reflected shine; temporality appears as the recursive movement of producing, sublating, and returning into possibility.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_DV_2:MRT1","text":"The axioms suffice to reconstruct the determination of substance as the unity of Being, reflection, shine, and accidentality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:MRT2","text":"The axioms suffice to generate the identity of productive and destructive power as well as the dependence of the accidents.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:MRT3","text":"The transition to causality remains underdetermined with respect to its precise necessity, because the positing of self-related negativity appears as a new status of determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_DV_2:MRT4","text":"The structure is coherent insofar as reality, reflection, shine, and positedness count as different articulations of the same absolute movement.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0007","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0010","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:MRT5","text":"The strongest point of the system is the transformation of the opposition of contingency and Necessity into an immanent mechanism of transition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:MRT6","text":"The strongest line of fracture lies between the assertion of the absence of real difference and the requirement of a difference from which causality can emerge.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0016","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DV_2:MRT7","text":"The reconstruction preserves the movement only if the inadequacy of formal substantiality is treated as the productive ground of its transition and not as an external objection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DV_2:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DV_2:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_DV_2@R001","source_variant_id":"canonical:CH_GB18_DV_2:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 162","title":"A. The Relation of Substantiality.","context":"Chapter 162","original_title":"A. Das Verhältniß der Substantialität."},"original_title":"A. Das Verhältniß der Substantialität.","title_language_code":"en"},{"id":"CH_GB18_BDKT","layer":"CH","title":"B. The Causal Relation.","order":163,"parents":["RAW_GB18_BDKT"],"revision":"CH_GB18_BDKT@R001","sha256":"849d124520887553c9dafb3cacad1789f8bda07e189846adb5d8ec916294d78c","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_BDKT:AS1","text":"Das Problem ist, die Substantialität als bestimmende Macht und nicht als bloßes Übergehen zu bestimmen.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:AS2","text":"Die Substanz wird als in sich reflektierte Macht neu bestimmt, die Bestimmungen setzt und sich von ihnen unterscheidet.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:AS3","text":"Was die Substanz negativ setzt, erscheint als aufgehobene Substantialität und damit als bloß Gesetztes.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:AS4","text":"Die Unterscheidung zwischen der für sich seienden Substanz und dem bloß Gesetzten erzeugt die Bestimmung von Ursache und Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:AS5","text":"Das Kausalitätsverhältniß wird zunächst als formelles Verhältnis von Ursache und Wirkung fixiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_BDKT:A1","text":"Die Substanz ist Macht.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A2","text":"Die Substanz ist in sich reflektiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A3","text":"Die Substanz setzt Bestimmungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A4","text":"Die Substanz unterscheidet sich von den von ihr gesetzten Bestimmungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A5","text":"Die Substanz bezieht sich in ihrem Bestimmen auf sich selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A6","text":"Das von der Substanz negativ Gesetzte ist aufgehobene Substantialität.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A7","text":"Das aufgehobene und bloß Gesetzte ist Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A8","text":"Die für sich seiende Substanz ist Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A9","text":"Das zunächst bestimmte Kausalitätsverhältniß ist das formelle Verhältnis von Ursache und Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_BDKT:NX1","text":"Substanz ist nicht bloß übergehende Macht.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:NX2","text":"Die gesetzte Bestimmung ist nicht selbständige Substantialität.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:NX3","text":"Die Wirkung ist nicht für sich seiend.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:NX4","text":"Das Kausalitätsverhältniß ist zunächst nicht als vollständige Bestimmung der Substanz, sondern nur als formelles Verhältnis gegeben.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:NX5","text":"Die Ursache ist nicht mit dem bloß Gesetzten identisch.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:NX6","text":"Die Wirkung ist nicht ursprüngliche Macht, sondern resultierende Setzung.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_BDKT:D1","text":"Die Substanz wird zur Ursache, sobald ihre reflektierte Macht als sich selbst bestimmende Setzung gefasst wird.","refs":["CH_GB18_BDKT:A1","CH_GB18_BDKT:A2","CH_GB18_BDKT:A3","CH_GB18_BDKT:A5","CH_GB18_BDKT:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:D2","text":"Die Wirkung bezeichnet die ent-substantialisiert gesetzte Bestimmung der Ursache.","refs":["CH_GB18_BDKT:A4","CH_GB18_BDKT:A6","CH_GB18_BDKT:A7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:D3","text":"Ursache und Wirkung bilden eine asymmetrische Ordnung von für sich seiender Substanz und bloß Gesetztem.","refs":["CH_GB18_BDKT:A6","CH_GB18_BDKT:A7","CH_GB18_BDKT:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:D4","text":"Kausalität entsteht nicht durch äußerliche Verknüpfung, sondern durch die Selbstbeziehung der bestimmenden Substanz.","refs":["CH_GB18_BDKT:A3","CH_GB18_BDKT:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:D5","text":"Die formelle Kausalität abstrahiert zunächst von einer weitergehenden Bestimmung des Verhältnisses und hält die bloße Relation von Ursache und Wirkung fest.","refs":["CH_GB18_BDKT:A9"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_BDKT:SD1","text":"Die Kausalität transformiert die innere Negativität der Substanz in eine gerichtete Ordnung von Ursprung und Resultat.","refs":["CH_GB18_BDKT:A2","CH_GB18_BDKT:A4","CH_GB18_BDKT:A6","CH_GB18_BDKT:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:SD2","text":"Die Wirkung besitzt ihre Bestimmtheit nur als aufgehobene Selbständigkeit innerhalb der Macht der Ursache.","refs":["CH_GB18_BDKT:A1","CH_GB18_BDKT:A6","CH_GB18_BDKT:A7","CH_GB18_BDKT:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:SD3","text":"Das formelle Kausalitätsverhältnis macht eine substanzielle Einheit als Differenz von Ursache und Wirkung sichtbar, ohne diese Differenz bereits weiterzuvermitteln.","refs":["CH_GB18_BDKT:A2","CH_GB18_BDKT:A4","CH_GB18_BDKT:A9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:SD4","text":"Die begriffliche Bewegung verläuft von der Substanz als Macht über ihre negative Setzung zur formalen Kausalitätsrelation.","refs":["CH_GB18_BDKT:A1","CH_GB18_BDKT:A5","CH_GB18_BDKT:A6","CH_GB18_BDKT:A9"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_BDKT:DNX1","text":"Die Substanz darf nicht als passives, bestimmungsloses Sein vorausgesetzt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:DNX2","text":"Die Bestimmung darf nicht als von der Substanz unabhängige Realität gelten.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:DNX3","text":"Die Wirkung darf nicht als selbständiger Ursprung ihrer eigenen Bestimmtheit erscheinen.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:DNX4","text":"Kausalität darf nicht auf eine äußerliche Verbindung bereits fertiger Dinge reduziert werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:DNX5","text":"Die Macht der Substanz darf nicht von ihrer negativen Selbstunterscheidung abgelöst werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:DNX6","text":"Die formelle Fassung darf nicht mit der vollständigen inneren Wahrheit des Kausalitätsverhältnisses verwechselt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_BDKT:SNX1","text":"Ausgeschlossen ist eine Welt unabhängiger Substanzen, deren Beziehungen erst nachträglich hinzutreten.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:SNX2","text":"Ausgeschlossen ist die Gleichordnung von Ursache und Wirkung als zwei für sich bestehende Mächte.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:SNX3","text":"Ausgeschlossen ist eine Wirkung, die ihre Herkunft aus der setzenden Macht der Ursache tilgt.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:SNX4","text":"Ausgeschlossen ist eine Kausalität, deren Form nicht aus der Selbstbeziehung der Substanz hervorgeht.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:SNX5","text":"Versperrt bleibt zunächst eine vollständige Vermittlung der in der Kausalität gesetzten Einheit von Ursache und Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_BDKT:FGS1","text":"Macht → in sich reflektierte Bestimmung → Selbstbeziehung im Setzen.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:FGS2","text":"Selbstbeziehung → negative Setzung einer Bestimmung → Unterscheidung der Substanz von dem Gesetzten.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:FGS3","text":"Negativ gesetzte Bestimmung → aufgehobene Substantialität → bloß Gesetztes.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:FGS4","text":"Bloß Gesetztes → Wirkung; für sich seiende Substanz → Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:FGS5","text":"Ursache/Wirkung → zunächst formelles Kausalitätsverhältniß.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:FGS6","text":"Das formelle Verhältnis bewahrt die Differenz von Ursprung und Resultat, lässt ihre weitergehende Vermittlung jedoch offen.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_BDKT:AF1","text":"Substanz als Macht → reflektierte Selbstbeziehung → bestimmendes Setzen → negative Selbstunterscheidung → aufgehobene Substantialität als Wirkung → für sich seiende Substanz als Ursache → formelles Kausalitätsverhältniß.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_BDKT:ME1","text":"Substanz wird von einem ruhenden Träger zu einer sich selbst bestimmenden Macht umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ME2","text":"Die Bestimmung wird als erzeugte Differenz zwischen Ursache und Wirkung klassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ME3","text":"Wirkung wird nicht als eigenständiges Seiendes, sondern als aufgehobene Substantialität sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ME4","text":"Kausalität wird aus der inneren Negativität der Substanz und nicht aus äußerlicher Relation rekonstruiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ME5","text":"Die Differenz von Ursache und Wirkung wird als innerhalb einer substantiellen Einheit erzeugte Differenz kartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_BDKT:ALT1","text":"**Surface:** Das Kausalitätsverhältniß erscheint als Verhältnis von Ursache und Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ALT2","text":"**Structural:** Die Ursache ist für sich seiende Substanz; die Wirkung ist die von ihr gesetzte und aufgehobene Substantialität.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ALT3","text":"**Metastrategic:** Die Analyse verschiebt die Erklärung von äußerer Verknüpfung auf innere Setzung und Selbstunterscheidung.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ALT4","text":"**Ontological/Temporal:** Sein wird als Macht bestimmt, die ihre Bestimmungen hervorbringt; Ursache und Wirkung bilden dabei eine gerichtete Ordnung von Setzung und Gesetztsein.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_BDKT:MRT1","text":"Die Axiome sind hinreichend, um den Übergang von Substanz und Macht zum formellen Kausalitätsverhältniß zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:MRT2","text":"Unterbestimmt bleibt, wie die formelle Kausalität über die bloße Gegenüberstellung von Ursache und Wirkung hinaus weiterentwickelt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:MRT3","text":"Die Struktur ist intern kohärent, sofern Wirkung konsequent als aufgehobene Substantialität verstanden wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:MRT4","text":"Ihre stärkste Verbindung liegt in der Ableitung der Kausalität aus der Selbstbeziehung der Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:MRT5","text":"Eine Spannung bleibt zwischen der substantiellen Einheit von Ursache und Wirkung und ihrer formellen asymmetrischen Trennung bestehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:MRT6","text":"Die Rekonstruktion bewahrt die Bewegung des Textes, sofern die formelle Kausalität als vorläufige und nicht als abschließende Bestimmung behandelt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T112946700533Z_3d87b407","language_code":"en","language_name":"English","title":"B. The Causal Relation.","source_sha256":"849d124520887553c9dafb3cacad1789f8bda07e189846adb5d8ec916294d78c","sha256":"24556567ce0cfd957c2ac664bdcf2cad8a7e00c089ac23a345be791853ce88d9","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:29:46.702694+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_BDKT:AS1","text":"The problem is to determine substantiality as determining power and not as mere transition.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:AS2","text":"Substance is newly determined as power reflected into itself, which posits determinations and distinguishes itself from them.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:AS3","text":"What substance negatively posits appears as sublated substantiality and thereby as merely posited.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:AS4","text":"The distinction between substance being-for-self and the merely posited gives rise to the determination of cause and effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:AS5","text":"The causal relation is initially fixed as the formal relation of cause and effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_BDKT:A1","text":"Substance is power.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A2","text":"Substance is reflected into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A3","text":"Substance posits determinations.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A4","text":"Substance distinguishes itself from the determinations posited by it.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A5","text":"In its determining, substance relates to itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A6","text":"What is negatively posited by substance is sublated substantiality.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A7","text":"What is sublated and merely posited is effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A8","text":"Substance being-for-self is cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:A9","text":"The causality relation initially determined is the formal relation of cause and effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_BDKT:NX1","text":"Substance is not merely transitory power.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:NX2","text":"The posited determination is not independent substantiality.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:NX3","text":"The effect is not being-for-self.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:NX4","text":"The causal relation is initially given not as the complete determination of substance, but only as a formal relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:NX5","text":"The cause is not identical with the merely posited.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:NX6","text":"The effect is not original power, but resultant positing.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_BDKT:D1","text":"Substance becomes cause as soon as its reflected power is grasped as self-determining positing.","refs":["CH_GB18_BDKT:A1","CH_GB18_BDKT:A2","CH_GB18_BDKT:A3","CH_GB18_BDKT:A5","CH_GB18_BDKT:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:D2","text":"The effect designates the de-substantialized posited determination of the cause.","refs":["CH_GB18_BDKT:A4","CH_GB18_BDKT:A6","CH_GB18_BDKT:A7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:D3","text":"Cause and effect form an asymmetric order of substance being-for-self and the merely posited.","refs":["CH_GB18_BDKT:A6","CH_GB18_BDKT:A7","CH_GB18_BDKT:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:D4","text":"Causality arises not through external connection, but through the self-relation of determining substance.","refs":["CH_GB18_BDKT:A3","CH_GB18_BDKT:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:D5","text":"Formal causality initially abstracts from a more extensive determination of the relation and retains the mere relation of cause and effect.","refs":["CH_GB18_BDKT:A9"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_BDKT:SD1","text":"Causality transforms the inner negativity of substance into a directed order of origin and result.","refs":["CH_GB18_BDKT:A2","CH_GB18_BDKT:A4","CH_GB18_BDKT:A6","CH_GB18_BDKT:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:SD2","text":"The effect possesses its determinacy only as sublated independence within the power of the cause.","refs":["CH_GB18_BDKT:A1","CH_GB18_BDKT:A6","CH_GB18_BDKT:A7","CH_GB18_BDKT:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:SD3","text":"The formal causal relation makes visible a substantial unity as the difference of cause and effect, without yet further mediating this difference.","refs":["CH_GB18_BDKT:A2","CH_GB18_BDKT:A4","CH_GB18_BDKT:A9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CH_GB18_BDKT:SD4","text":"The conceptual movement proceeds from substance as power, through its negative positing, to the formal causal relation.","refs":["CH_GB18_BDKT:A1","CH_GB18_BDKT:A5","CH_GB18_BDKT:A6","CH_GB18_BDKT:A9"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_BDKT:DNX1","text":"Substance must not be presupposed as passive, determinationless being.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:DNX2","text":"The determination must not count as a reality independent of substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:DNX3","text":"The effect must not appear as the independent origin of its own determinacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:DNX4","text":"Causality must not be reduced to an external connection of already finished things.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:DNX5","text":"The power of substance must not be detached from its negative self-distinction.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:DNX6","text":"The formal conception must not be confused with the complete inner truth of the causal relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_BDKT:SNX1","text":"Excluded is a world of independent substances whose relations are added only subsequently.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:SNX2","text":"Excluded is the co-ordination of cause and effect as two powers existing for themselves.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:SNX3","text":"Excluded is an effect that effaces its derivation from the positing power of the cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:SNX4","text":"Excluded is a causality whose form does not proceed from the self-relation of substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:SNX5","text":"For the time being, a complete mediation of the unity of cause and effect posited in causality remains barred.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_BDKT:FGS1","text":"Power → determination reflected into itself → self-relation in positing.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:FGS2","text":"Self-relation → negative positing of a determination → distinction of substance from the posited.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:FGS3","text":"Negatively posited determination → sublated substantiality → merely posited.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:FGS4","text":"Merely posited → effect; substance being-for-self → cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:FGS5","text":"Cause/effect → initially formal causal relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:FGS6","text":"The formal relation preserves the difference of origin and result, but leaves their further mediation open.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_BDKT:AF1","text":"Substance as power → reflected self-relation → determining positing → negative self-distinction → sublated substantiality as effect → substance being-for-self as cause → formal causal relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_BDKT:ME1","text":"Substance is remapped from a resting bearer into a self-determining power.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ME2","text":"The determination is classified as a produced difference between cause and effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ME3","text":"Effect becomes visible not as an independent being, but as sublated substantiality.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ME4","text":"Causality is reconstructed from the inner negativity of substance and not from external relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ME5","text":"The difference of cause and effect is mapped as a difference produced within a substantial unity.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_BDKT:ALT1","text":"**Surface:** The causal relation appears as the relation of cause and effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ALT2","text":"**Structural:** The cause is substance being-for-self; the effect is the substantiality posited and sublated by it.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ALT3","text":"**Metastrategic:** The analysis shifts explanation from external connection to inner positing and self-distinction.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:ALT4","text":"**Ontological/Temporal:** Being is determined as power that brings forth its determinations; cause and effect thereby form a directed order of positing and being-posited.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_BDKT:MRT1","text":"The axioms are sufficient to reconstruct the transition from substance and power to the formal causal relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:MRT2","text":"What remains underdetermined is how formal causality is further developed beyond the mere juxtaposition of cause and effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:MRT3","text":"The structure is internally coherent, insofar as effect is consistently understood as sublated substantiality.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:MRT4","text":"Its strongest connection lies in the derivation of causality from the self-relation of substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:MRT5","text":"A tension remains between the substantial unity of cause and effect and their formal asymmetric separation.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_BDKT:MRT6","text":"The reconstruction preserves the movement of the text insofar as formal causality is treated as a provisional and not as a final determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_BDKT@R001","source_variant_id":"canonical:CH_GB18_BDKT:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 163","title":"B. The Causal Relation.","context":"Chapter 163","original_title":"B. Das Kausalitäts-Verhältniß."},"original_title":"B. Das Kausalitäts-Verhältniß.","title_language_code":"en"},{"id":"CH_GB18_DFKT","layer":"CH","title":"a. Formal Causality.","order":164,"parents":["RAW_GB18_DFKT"],"revision":"CH_GB18_DFKT@R001","sha256":"26593806e102b30231b1acfc1dd831478a47f5bc7c96f6631bd7a64cee59bc4c","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_DFKT:AS1","text":"Das Argument bestimmt, wie die Substanz ihre Accidentalität aus sich selbst hervorbringt, ohne von einem vorausgesetzten Anderen auszugehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:AS2","text":"Die Substanz wird als Macht gefasst, deren Selbstbestimmung zugleich Setzen, Aufheben des Gesetzten und Rückkehr in sich ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:AS3","text":"Diese einheitliche Selbstbewegung wird als absolute Actuosität und damit als Ursache bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:AS4","text":"Die Wirkung ist die von der Ursache gesetzte und in sich identische Bestimmtheit, in der die Ursache ihre Wirklichkeit gewinnt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:AS5","text":"Ursache und Wirkung werden als gegenseitig inhaltsgleich und voneinander untrennbar rekonstruiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:AS6","text":"Die formelle Differenz von Ursache und Wirkung hebt sich in ihrer Identität auf und geht in eine gleichgültige Unmittelbarkeit über.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_DFKT:A1","text":"Die Ursache ist das Ursprüngliche gegenüber der Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A2","text":"Die Substanz ist als Macht das Scheinen beziehungsweise die Accidentalität und in diesem Scheinen Reflexion-in-sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A3","text":"Die Substanz bestimmt sich selbst; dieses Bestimmen ist unmittelbar zugleich Aufheben des Bestimmens und Rückkehr in sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A4","text":"Die Rückkehr der Substanz ist als negative Beziehung auf sich ein Abstoßen ihrer von sich und setzt das Bestimmte als Gesetztsein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A5","text":"Die Einheit von Bestimmen und Rückkehr ist absolute Actuosität und Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A6","text":"Die Wirkung ist die Accidentalität der Substanz als gesetztes und mit sich identisches Gesetztsein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A7","text":"Die Substanz hat erst als Ursache Wirklichkeit, und diese Wirklichkeit besitzt sie nur in ihrer Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A8","text":"Die Ursache ist Notwendigkeit, weil sie ihre selbstbestimmte Wirklichkeit als Wirkung auslegt und setzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A9","text":"Ursache und Wirkung enthalten einander vollständig.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A10","text":"Die Ursache ist nur Ursache, insofern sie eine Wirkung hervorbringt, und die Wirkung ist nur Wirkung, insofern sie eine Ursache hat.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A11","text":"Die Ursache erlischt in ihrer Wirkung, weil die Wirkung ihre Bestimmtheit ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A12","text":"Mit der Aufhebung der formellen Differenz von Ursache und Wirkung wird die erloschene Kausalität zur gegen das Verhältnis gleichgültigen Unmittelbarkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_DFKT:NX1","text":"Die Substanz geht in ihrer Bestimmung nicht von einer vorausgesetzten Accidentalität als einem fremden Anderen aus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX2","text":"Die Substanz ist nicht bloß das noch ungesetzte Ansichsein ihrer Accidenz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX3","text":"Die Ursache wird nicht durch ein äußeres Anderes zur Tätigkeit veranlasst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX4","text":"Die Wirkung enthält keinen von der Ursache unabhängigen Inhalt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX5","text":"Eine Ursache ohne hervorgebrachte Wirkung ist keine Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX6","text":"Eine Wirkung, deren Ursache verschwunden ist, bleibt nicht Wirkung, sondern wird gleichgültige Wirklichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX7","text":"Ursache und Wirkung bilden keine äußerlich nebeneinander verbleibenden Bestimmungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX8","text":"Die formelle Unterscheidung von Ursache und Wirkung ist keine endgültige Bestimmung der Kausalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_DFKT:D1","text":"Die Accidentalität ist keine fremde Gegebenheit, sondern die von der Substanz selbst gesetzte Bestimmtheit.","refs":["CH_GB18_DFKT:A2","CH_GB18_DFKT:A3","CH_GB18_DFKT:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D2","text":"Das Bestimmen der Substanz erzeugt die Wirkung durch einen Vorgang, in dem Setzen und Rückkehr untrennbar zusammenfallen.","refs":["CH_GB18_DFKT:A3","CH_GB18_DFKT:A4","CH_GB18_DFKT:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D3","text":"Die Ursache wird in der Wirkung als ganze Substanz manifestiert, weil die Wirkung die gesetzte Wirklichkeit der Substanz ist.","refs":["CH_GB18_DFKT:A6","CH_GB18_DFKT:A7","CH_GB18_DFKT:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D4","text":"Die Wirkung ist notwendig, weil sie die Manifestation der Ursache und damit die Wirklichkeit der Ursache selbst ist.","refs":["CH_GB18_DFKT:A7","CH_GB18_DFKT:A8","CH_GB18_DFKT:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D5","text":"Ursache und Wirkung sind nicht zwei getrennte Inhalte, sondern zwei relationale Bestimmungen desselben vollständigen Inhalts.","refs":["CH_GB18_DFKT:A9","CH_GB18_DFKT:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D6","text":"Die Ursache ist in ihrer Wirkung nicht mehr als selbständige Ursache erhalten, sondern geht in der von ihr gesetzten Bestimmtheit unter.","refs":["CH_GB18_DFKT:A10","CH_GB18_DFKT:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D7","text":"Die Wirkung verliert mit dem Verschwinden der Ursache ihre kausale Bestimmung, ohne dadurch als Wirklichkeit schlechthin zu verschwinden.","refs":["CH_GB18_DFKT:A10","CH_GB18_DFKT:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_DFKT:SD1","text":"Selbstursprünglichkeit bedeutet keine isolierte Unabhängigkeit, sondern die Fähigkeit der Substanz, aus ihrer Rückkehr in sich die eigene Vermittlung und Wirkung hervorzubringen.","refs":["CH_GB18_DFKT:A3","CH_GB18_DFKT:A5","CH_GB18_DFKT:A8","CH_GB18_DFKT:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SD2","text":"Wirklichkeit ist nicht ein der Ursache vorausliegender Bestand, sondern entsteht als die mit sich identische Wirkung der Selbstbestimmung.","refs":["CH_GB18_DFKT:A6","CH_GB18_DFKT:A7","CH_GB18_DFKT:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SD3","text":"Die Kausalität erzeugt die Differenz von Ursache und Wirkung als Bedingung ihrer Erscheinung und hebt diese Differenz als Bedingung ihrer Wahrheit wieder auf.","refs":["CH_GB18_DFKT:A4","CH_GB18_DFKT:A9","CH_GB18_DFKT:A11","CH_GB18_DFKT:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SD4","text":"Der kausale Status ist an das Wirken gebunden: Vor dem Wirken ist die Ursache noch nicht Ursache, nach dem Verschwinden der Ursache ist die Wirkung nicht mehr Wirkung.","refs":["CH_GB18_DFKT:A10","CH_GB18_DFKT:A11","CH_GB18_DFKT:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SD5","text":"Die Ursache erscheint als ursprünglich und bleibt doch nur durch ihre Wirkung wirklich; ihre Ursprünglichkeit ist daher relational vermittelt.","refs":["CH_GB18_DFKT:A1","CH_GB18_DFKT:A7","CH_GB18_DFKT:A9","CH_GB18_DFKT:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_DFKT:DNX1","text":"Ausgeschlossen ist eine Accidentalität, die vor ihrer Setzung als selbständiges Sein vorliegt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX2","text":"Ausgeschlossen ist eine Substanz, deren Wirklichkeit außerhalb ihrer Manifestation als Wirkung vollständig bestimmt wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX3","text":"Ausgeschlossen ist ein äußerer Initiator, der die Ursache erst in Bewegung setzen müsste.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX4","text":"Ausgeschlossen ist eine Kausalität, in der die Ursache ihren Inhalt unabhängig von der Wirkung bewahrt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX5","text":"Ausgeschlossen ist eine stabile ontologische Zweiheit von Ursache und Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX6","text":"Ausgeschlossen ist eine Wirkung, die ihre kausale Identität unabhängig vom Fortbestehen der Ursache erhält.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX7","text":"Ausgeschlossen ist eine Notwendigkeit, die als äußerer Zwang und nicht als Selbstbestimmung der Substanz begriffen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_DFKT:SNX1","text":"Ein außerhalb der Substanz liegender Ursprung ist als Bedingung ihrer Notwendigkeit unzulässig.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SNX2","text":"Eine dauerhaft selbständige Kausalordnung ist unzulässig, weil die Kausalität in ihrer Wirkung erlischt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SNX3","text":"Eine Identität von Ursache und Wirkung, in der beide Pole als formell getrennte Wirklichkeiten erhalten bleiben, ist ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SNX4","text":"Eine endgültige Wirklichkeit der Ursache vor oder unabhängig von ihrem Wirken ist nicht verfügbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SNX5","text":"Eine kausale Ordnung, die nicht in gleichgültige Unmittelbarkeit übergehen kann, widerspricht der inneren Bewegung des Systems.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_DFKT:FGS1","text":"Macht der Substanz → Scheinen → Accidentalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS2","text":"Selbstbestimmung → Aufhebung des Bestimmens → Rückkehr-in-sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS3","text":"Rückkehr-in-sich → negative Beziehung auf sich → Abstoßen von sich → Setzen des Bestimmten als Gesetztsein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS4","text":"Einheit von Setzen und Rückkehr → absolute Actuosität → Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS5","text":"Ursache als selbstbestimmte Substanz → Auslegung des Ansichseins → Wirkung als identisches Gesetztsein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS6","text":"Wirkung als Manifestation → Wirklichkeit der Ursache → Notwendigkeit als selbsttätiges Hervorbringen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS7","text":"Gegenseitige Inhaltsidentität → Aufhebung der formellen Differenz → Erlöschen der Kausalität → gleichgültige Unmittelbarkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_DFKT:AF1","text":"Ursprüngliche Substanz als Macht → selbstbestimmendes Setzen → Aufhebung und Rückkehr → Abstoßen und Setzen des Bestimmten → Ursache als absolute Actuosität → Wirkung als identisches Gesetztsein → wechselseitige Enthaltenheit → Erlöschen der Ursache in der Wirkung → Aufhebung der Kausalform in gleichgültiger Unmittelbarkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_DFKT:ME1","text":"Das Verhältnis von Ursache und Wirkung wird von einer Zweiheit selbständiger Dinge auf eine einzige selbstbewegte Substanzaktivität umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ME2","text":"Die Unterscheidung von Ursprünglichem und Gesetztem wird als interne Differenz der Substanz statt als äußerer Gegensatz sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ME3","text":"Notwendigkeit wird als immanente Selbstbestimmung und nicht als äußerer Zwang klassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ME4","text":"Die Wirkung wird zugleich als hervorgebrachte Bestimmtheit, als Wirklichkeit der Ursache und als Übergang in gleichgültige Unmittelbarkeit bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ME5","text":"Ursache und Wirkung werden nicht mehr als feste Pole, sondern als wechselnde Funktionen innerhalb einer sich selbst aufhebenden Relation kartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_DFKT:ALT1","text":"Surface: Die unmittelbare Opposition von Ursache und Wirkung wird über die Bestimmungen von Substanz, Accidentalität und Gesetztsein entfaltet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ALT2","text":"Structural: Die Kausalität wird als Einheit von Selbstbestimmung, Setzen, Rückkehr und gegenseitiger Vermittlung organisiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ALT3","text":"Metastrategic: Das Argument ersetzt die Erklärung durch äußere Einwirkung durch eine immanente Rekonstruktion selbsttätigen Hervorbringens.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ALT4","text":"Ontological/Temporal: Ursache und Wirkung besitzen ihren jeweiligen Status nur im Vollzug des Wirkens; vor dem Wirken und nach dem Verschwinden der Ursache gelten andere Bestimmungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_DFKT:MRT1","text":"Die Axiome sind hinreichend, sofern Selbstbestimmung, Setzen, Rückkehr, Wirkung, gegenseitige Enthaltenheit und Erlöschen der Kausalform erhalten bleiben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:MRT2","text":"Unterbestimmt bleibt, ob die gleichgültige Unmittelbarkeit lediglich das Resultat der Kausalität oder zugleich der Anfang einer weiteren Bestimmungsform ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_DFKT:MRT3","text":"Die Struktur ist intern kohärent als Bewegung von immanenter Selbstbestimmung zu selbstaufhebender Kausalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:MRT4","text":"Die stärkste Stelle liegt in der Ableitung der Wirkung aus der Selbstbewegung der Substanz und in der Bestimmung der Ursache als nur wirkend wirklicher Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:MRT5","text":"Eine strukturelle Spannung bleibt zwischen der Vorrangigkeit des Ursprünglichen und der These bestehen, dass die Ursache nur in der Wirkung Wirklichkeit besitzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:MRT6","text":"Eine weitere Spannung liegt darin, dass die Wirkung als identische Bestimmtheit der Ursache bestimmt wird, zugleich aber nach dem Verschwinden der Ursache als gleichgültige Wirklichkeit fortbesteht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:MRT7","text":"Die Rekonstruktion bewahrt die tatsächliche Argumentbewegung, wenn sie die Kausalität nicht beim Verhältnis von Ursache und Wirkung beendet, sondern bis zu dessen Aufhebung in Unmittelbarkeit verfolgt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T115314542507Z_006e717b","language_code":"en","language_name":"English","title":"a. Formal Causality.","source_sha256":"26593806e102b30231b1acfc1dd831478a47f5bc7c96f6631bd7a64cee59bc4c","sha256":"02e1c00223b5376e26e5c3c06d77fa52d3f058b32739210d0cc938f1e353762d","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:53:14.544949+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_DFKT:AS1","text":"The argument determines how substance brings forth its accidentality from itself, without proceeding from a presupposed other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:AS2","text":"Substance is conceived as power, whose self-determination is at once positing, sublation of what is posited, and return into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:AS3","text":"This unified self-movement is determined as absolute actuosity and thus as cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:AS4","text":"The effect is the determinacy posited by the cause and identical within itself, in which the cause attains its actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:AS5","text":"Cause and effect are reconstructed as mutually identical in content and inseparable from one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:AS6","text":"The formal difference of cause and effect sublates itself in their identity and passes over into indifferent immediacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_DFKT:A1","text":"The cause is the original in contrast to the effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A2","text":"As power, substance is semblance, or accidentality, and in this semblance reflection-into-itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A3","text":"Substance determines itself; this determining is immediately at the same time sublation of the determining and return into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A4","text":"The return of substance, as negative relation to itself, is a repulsion of itself from itself and posits the determinate as positedness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A5","text":"The unity of determining and return is absolute actuosity and cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A6","text":"The effect is the accidentality of substance as positedness that is posited and identical with itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A7","text":"Substance has actuality only as cause, and it possesses this actuality only in its effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A8","text":"The cause is necessity because it explicates and posits its self-determined actuality as effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A9","text":"Cause and effect contain one another completely.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A10","text":"The cause is cause only insofar as it brings forth an effect, and the effect is effect only insofar as it has a cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A11","text":"The cause expires in its effect, because the effect is its determinacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:A12","text":"With the sublation of the formal difference of cause and effect, expired causality becomes immediacy indifferent to the relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_DFKT:NX1","text":"In its determination, substance does not proceed from a presupposed accidentality as a foreign other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX2","text":"Substance is not merely the as-yet-unposited in-itselfness of its accident.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX3","text":"The cause is not induced to activity by an external other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX4","text":"The effect contains no content independent of the cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX5","text":"A cause without a produced effect is no cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX6","text":"An effect whose cause has disappeared does not remain an effect, but becomes indifferent actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX7","text":"Cause and effect do not constitute determinations that remain externally alongside one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:NX8","text":"The formal distinction between cause and effect is not a final determination of causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_DFKT:D1","text":"Accidentality is not a foreign given, but the determinacy posited by substance itself.","refs":["CH_GB18_DFKT:A2","CH_GB18_DFKT:A3","CH_GB18_DFKT:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D2","text":"The determining of substance produces the effect through a process in which positing and return coincide inseparably.","refs":["CH_GB18_DFKT:A3","CH_GB18_DFKT:A4","CH_GB18_DFKT:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D3","text":"The cause is manifested in the effect as whole substance, because the effect is the posited actuality of substance.","refs":["CH_GB18_DFKT:A6","CH_GB18_DFKT:A7","CH_GB18_DFKT:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D4","text":"The effect is necessary because it is the manifestation of the cause and thus the actuality of the cause itself.","refs":["CH_GB18_DFKT:A7","CH_GB18_DFKT:A8","CH_GB18_DFKT:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D5","text":"Cause and effect are not two separate contents, but two relational determinations of the same complete content.","refs":["CH_GB18_DFKT:A9","CH_GB18_DFKT:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D6","text":"In its effect, the cause is no longer preserved as an independent cause, but perishes in the determinacy posited by it.","refs":["CH_GB18_DFKT:A10","CH_GB18_DFKT:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:D7","text":"With the disappearance of the cause, the effect loses its causal determination, without thereby disappearing as actuality as such.","refs":["CH_GB18_DFKT:A10","CH_GB18_DFKT:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_DFKT:SD1","text":"Self-origination does not mean isolated independence, but the capacity of substance to bring forth, from its return into itself, its own mediation and effect.","refs":["CH_GB18_DFKT:A3","CH_GB18_DFKT:A5","CH_GB18_DFKT:A8","CH_GB18_DFKT:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SD2","text":"Actuality is not a stock that precedes the cause, but arises as the self-identical effect of self-determination.","refs":["CH_GB18_DFKT:A6","CH_GB18_DFKT:A7","CH_GB18_DFKT:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SD3","text":"Causality produces the difference of cause and effect as the condition of its appearance and sublates this difference again as the condition of its truth.","refs":["CH_GB18_DFKT:A4","CH_GB18_DFKT:A9","CH_GB18_DFKT:A11","CH_GB18_DFKT:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SD4","text":"Causal status is bound to acting: before acting, the cause is not yet cause; after the disappearance of the cause, the effect is no longer effect.","refs":["CH_GB18_DFKT:A10","CH_GB18_DFKT:A11","CH_GB18_DFKT:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SD5","text":"The cause appears as original and yet remains actual only through its effect; its originality is therefore relationally mediated.","refs":["CH_GB18_DFKT:A1","CH_GB18_DFKT:A7","CH_GB18_DFKT:A9","CH_GB18_DFKT:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_DFKT:DNX1","text":"Excluded is an accidentality that exists as independent being prior to its positing.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX2","text":"Excluded is a substance whose actuality would be fully determined outside its manifestation as effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX3","text":"Excluded is an external initiator that would first have to set the cause in motion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX4","text":"Excluded is a causality in which the cause preserves its content independently of the effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX5","text":"Excluded is a stable ontological duality of cause and effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX6","text":"Excluded is an effect that retains its causal identity independently of the continued existence of the cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:DNX7","text":"Excluded is a necessity understood as external compulsion rather than as the self-determination of substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_DFKT:SNX1","text":"An origin lying outside substance is inadmissible as the condition of its necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SNX2","text":"A permanently independent causal order is inadmissible, because causality expires in its effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SNX3","text":"An identity of cause and effect in which both poles remain preserved as formally separate actualities is excluded.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SNX4","text":"A final actuality of the cause prior to or independently of its acting is unavailable.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:SNX5","text":"A causal order that cannot pass over into indifferent immediacy contradicts the inner movement of the system.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_DFKT:FGS1","text":"Power of substance → semblance → accidentality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS2","text":"Self-determination → sublation of determining → return-into-itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS3","text":"Return-into-itself → negative relation to itself → repulsion from itself → positing of the determinate as positedness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS4","text":"Unity of positing and return → absolute actuosity → cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS5","text":"Cause as self-determined substance → explication of in-itselfness → effect as identical positedness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS6","text":"Effect as manifestation → actuality of the cause → necessity as self-active production.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:FGS7","text":"Mutual identity of content → sublation of the formal difference → expiration of causality → indifferent immediacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_DFKT:AF1","text":"Original substance as power → self-determining positing → sublation and return → repulsion and positing of the determinate → cause as absolute actuosity → effect as identical positedness → mutual containment → expiration of the cause in the effect → sublation of the causal form in indifferent immediacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_DFKT:ME1","text":"The relation of cause and effect is remapped from a duality of independent things onto a single self-moving activity of substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ME2","text":"The distinction between the original and the posited becomes visible as an internal difference of substance rather than as an external opposition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ME3","text":"Necessity is classified as immanent self-determination and not as external compulsion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ME4","text":"The effect is determined at once as produced determinacy, as the actuality of the cause, and as transition into indifferent immediacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ME5","text":"Cause and effect are no longer mapped as fixed poles, but as shifting functions within a relation that sublates itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_DFKT:ALT1","text":"Surface: The immediate opposition of cause and effect is unfolded through the determinations of substance, accidentality, and positedness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ALT2","text":"Structural: Causality is organized as the unity of self-determination, positing, return, and mutual mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ALT3","text":"Metastrategic: The argument replaces explanation through external influence with an immanent reconstruction of self-active production.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:ALT4","text":"Ontological/Temporal: Cause and effect possess their respective status only in the enactment of acting; before acting and after the disappearance of the cause, other determinations apply.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_DFKT:MRT1","text":"The axioms are sufficient provided that self-determination, positing, return, effect, mutual containment, and the expiration of the causal form are preserved.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:MRT2","text":"It remains underdetermined whether indifferent immediacy is merely the result of causality or at the same time the beginning of a further form of determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_DFKT:MRT3","text":"The structure is internally coherent as a movement from immanent self-determination to self-sublating causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:MRT4","text":"The strongest point lies in the derivation of the effect from the self-movement of substance and in the determination of the cause as a cause that is actual only in acting.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:MRT5","text":"A structural tension remains between the priority of the original and the thesis that the cause possesses actuality only in the effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:MRT6","text":"A further tension lies in the fact that the effect is determined as the identical determinacy of the cause, yet after the disappearance of the cause persists as indifferent actuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0007","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_DFKT:MRT7","text":"The reconstruction preserves the actual movement of the argument if it does not terminate causality at the relation of cause and effect, but follows it through to its sublation in immediacy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_DFKT:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_DFKT:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_DFKT@R001","source_variant_id":"canonical:CH_GB18_DFKT:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 164","title":"a. Formal Causality.","context":"Chapter 164","original_title":"a. Die formelle Kausalität."},"original_title":"a. Die formelle Kausalität.","title_language_code":"en"},{"id":"CH_GB18_BDBK","layer":"CH","title":"b. The Determinate Causal Relation.","order":165,"parents":["RAW_GB18_BDBK"],"revision":"CH_GB18_BDBK@R001","sha256":"85b99a252fb467fc07b97691623b128a81c66d58a243b384d5404ccc543712a6","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_BDBK:AS1","text":"Das bestimmte Kausalitätsverhältniß soll erklären, wie Ursache und Wirkung inhaltlich identisch sein und dennoch als endliche, äußerlich verschiedene Bestimmungen auftreten können.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AS2","text":"Die inhaltliche Identität von Ursache und Wirkung entleert die endliche Kausalität zunächst zu einer analytischen Wiederholung desselben Inhalts unter zwei Formbestimmungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AS3","text":"Die Äußerlichkeit von Form und Inhalt macht Ursache und Wirkung zu Bestimmungen eines endlichen Substrats, dessen Ursächlichkeit von einer fremden Bestimmung ausgeht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AS4","text":"Weil jede bestimmte Ursache zugleich ein gesetztes, endliches Moment und damit selbst Wirkung ist, erzeugt die endliche Kausalität den unendlichen Regreß und Progreß.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AS5","text":"Die Bewegung hebt die äußerliche Sukzession auf, indem Ursache und Wirkung sich gegenseitig setzen, aufheben und als bedingende Kausalität voraussetzen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AS6","text":"Das Argument verfährt dialektisch von der tautologischen Inhaltsidentität über die Endlichkeit äußerlicher Kausalität zur Selbstvoraussetzung der Kausalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_BDBK:A1","text":"Die Identität der Ursache mit sich in ihrer Wirkung hebt ihre Macht und Negativität auf und lässt den Inhalt als gegen die Formunterschiede gleichgültige Einheit hervortreten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A2","text":"In der endlichen Kausalität sind Inhalt und Kausalform verschieden, sodass die Kausalität dem bestimmten Inhalt äußerlich und zufällig ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A3","text":"Ursache und Wirkung enthalten als endliche Kausalbestimmungen denselben Inhalt, der einmal als eigenthümliches Bestehen und einmal als Gesetztseyn an einem Anderen erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A4","text":"Eine Ursache ist nur hinsichtlich derjenigen Bestimmungen Ursache, die sich in ihrer Wirkung manifestieren; ihr übriger Inhalt ist für dieses Kausalverhältniß gleichgültig.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A5","text":"Entfernte Kausalreihen verdecken die Inhaltsidentität durch Mittelglieder und Umstände, sodass ein einzelnes vorausgehendes Ereigniß nur ein Moment von Möglichkeitsbedingungen sein kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A6","text":"Das Lebendige und der Geist nehmen eine äußere Ursache nicht unverändert auf, sondern bestimmen, verwandeln und brechen sie ab.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A7","text":"Wo das Verhältniß von Ursache und Wirkung überhaupt zugelassen wird, ist die Wirkung nur Manifestation der Ursache und kann nicht größer als diese sein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A8","text":"Der der Kausalität äußerliche Inhalt besteht als unmittelbares Ding oder endliche Substanz, an der Ursache und Wirkung als besondere Formbestimmungen ihr Substrat haben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A9","text":"Die endliche ursachliche Substanz beginnt von einer äußeren Bestimmung, hebt diese in ihrer Wirkung auf und kehrt dadurch in ihre unmittelbare Identität zurück, wodurch sie ihre Kausalität aufhebt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A10","text":"Jede bestimmte Ursache ist als endliches Moment selbst Wirkung, weil ihre Bestimmtheit und Negation außer ihr liegt und ihre Einheit mit der Wirkung nur als unmittelbares Substrat besteht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A11","text":"Der Übergang der Ursache in Wirkung und der Wirkung in Ursache erzeugt den unendlichen Regreß von Ursachen sowie den gleichartigen unendlichen Progreß von Wirkungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A12","text":"Die Kausalität setzt und hebt sich in ihrem Anderswerden selbst auf und voraus; das Substrat wird dadurch zur gesetzten Voraussetzung der wirkenden Kausalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0028","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_BDBK:NX1","text":"Die endliche Kausalität ist nicht die formelle Kausalität absoluter Macht, deren Inhalt reine Manifestation oder Nothwendigkeit wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX2","text":"Die Erklärung einer Wirkung durch ihre unmittelbare Ursache ist keine inhaltliche Erkenntnißserweiterung, sofern nur derselbe Inhalt wiederholt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX3","text":"Keine Eigenschaft eines Dinges ist dadurch schon kausal relevant, dass sie ihm zukommt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX4","text":"Ein entfernter vorausgehender Umstand ist nicht für sich die vollständige Ursache einer späteren Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX5","text":"Nahrung, Klima, einzelne Ereignisse oder äußere Zustände sind nicht im eigentlichen Sinn Ursachen organischer, geistiger oder geschichtlicher Hervorbringungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX6","text":"Das Große entsteht nicht kausal aus dem Kleinen, wenn das Kleine nur als äußerliche Veranlassung fungiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX7","text":"Ursache und Wirkung sind nicht dauerhaft einseitige Rollen verschiedener Substrate.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX8","text":"Der unendliche Fortgang der endlichen Reflexion erreicht keine festgehaltene Formeinheit von Ursache und Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_BDBK:D1","text":"Die endliche Kausalerklärung ist analytisch, weil sie denselben Inhalt unter den äußerlichen Formnamen Ursache und Wirkung wiederholt.","refs":["CH_GB18_BDBK:A2","CH_GB18_BDBK:A3","CH_GB18_BDBK:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:D2","text":"Eine mehrgliedrige Kausalreihe erklärt eine Wirkung nicht durch einen ersten isolierten Ursprung, sondern verteilt ihre Möglichkeitsbedingungen über miteinander verknüpfte Momente.","refs":["CH_GB18_BDBK:A3","CH_GB18_BDBK:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:D3","text":"Geschichtliche Anekdoten verlieren den Status erster Ursachen und werden zu Veranlassungen, durch die sich ein bereits wirksamer innerer Geist äußert.","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:A6","CH_GB18_BDBK:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:D4","text":"Organisches und geistiges Geschehen kann äußere Einwirkungen nur als transformiertes Material, nicht als fortgesetzte Ursächlichkeit aufnehmen.","refs":["CH_GB18_BDBK:A6","CH_GB18_BDBK:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:D5","text":"Die endliche Kausalitätszuschreibung kann Ursache und Wirkung nicht stabil unterscheiden, weil jede Ursache als Bestimmtes selbst Wirkung und jede Wirkung an einem Substrat erneut Ursache wird.","refs":["CH_GB18_BDBK:A8","CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:D6","text":"Das unmittelbare Substrat verliert den Status eines bloß gegebenen Trägers, sobald die Kausalität es als eigene Voraussetzung setzt.","refs":["CH_GB18_BDBK:A8","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_BDBK:SD1","text":"Die endliche Kausalität ist strukturell zweigeteilt: Ihr Inhalt ist identisch, während ihre Form die Identität äußerlich auseinanderlegt und dadurch das Bedürfniß nach Erklärung selbst erzeugt.","refs":["CH_GB18_BDBK:A1","CH_GB18_BDBK:A2","CH_GB18_BDBK:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:SD2","text":"Der unendliche Kausalregreß ist kein Mangel an noch unbekannten Ursachen, sondern die notwendige Folge davon, dass die endliche Ursache ihre eigene Endlichkeit als Wirkung mitführt.","refs":["CH_GB18_BDBK:A8","CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:SD3","text":"Die Selbstaufhebung der endlichen Kausalität erzeugt eine Kausalität, deren Bedingung nicht mehr äußerlich vor ihr liegt, sondern von ihr selbst gesetzt wird.","refs":["CH_GB18_BDBK:A9","CH_GB18_BDBK:A11","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:SD4","text":"Die geschichtliche Erklärung wird von einer Suche nach kleinsten äußeren Auslösern auf die Unterscheidung zwischen Veranlassung und innerer Manifestationskraft umgestellt.","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:A6","CH_GB18_BDBK:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_BDBK:DNX1","text":"Kein inhaltlicher Unterschied begründet aus sich die Differenz von Ursache und Wirkung, weil diese Differenz zunächst ausschließlich Formdifferenz ist.","refs":["CH_GB18_BDBK:A1","CH_GB18_BDBK:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:DNX2","text":"Keine endliche Ursache kann als schlechthin ursprünglicher Ursprung gelten, weil ihre Bestimmtheit sie zugleich als Wirkung ausweist.","refs":["CH_GB18_BDBK:A9","CH_GB18_BDBK:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:DNX3","text":"Kein einzelnes äußerliches Ereigniß besitzt die Kraft, organische, geistige oder geschichtliche Gestalten unvermittelt hervorzubringen.","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:A6","CH_GB18_BDBK:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:DNX4","text":"Kein unendlicher Fortgang von Ursachen erreicht eine letzte Erklärung, solange Kausalität als äußerliche Beziehung endlicher Substrate begriffen wird.","refs":["CH_GB18_BDBK:A8","CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_BDBK:SNX1","text":"Ausgeschlossen ist ein endlicher, äußerlich lokalisierter und zugleich selbstbegründender erster Grund.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:SNX2","text":"Ausgeschlossen ist eine lineare Kausalform, die zugleich Veränderung erklären und die Identität des Inhalts unverändert festhalten könnte.","refs":["CH_GB18_BDBK:A1","CH_GB18_BDBK:A3","CH_GB18_BDBK:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:SNX3","text":"Ausgeschlossen ist die Reduktion geistiger oder geschichtlicher Wirklichkeit auf die Kontinuität äußerer Bedingungen in ihren Resultaten.","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:A6","CH_GB18_BDBK:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_BDBK:FGS1","text":"Inhaltsidentität von Ursache und Wirkung ∧ äußere Formdifferenz → endliche und analytische Kausalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:FGS2","text":"Äußere Formdifferenz ∧ inhaltsindifferentes Substrat → Ursache und Wirkung als getrennte Bestimmungen endlicher Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:FGS3","text":"Endliche Substanz ∧ fremdes Gesetztseyn → ursächliches Handeln als Aufhebung einer äußeren Bestimmung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:FGS4","text":"Bestimmte Ursache → eigene Bestimmtheit → Wirkung → erneute Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0027","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:FGS5","text":"Wiederholung der Umkehrung von Ursache und Wirkung → unendlicher Regreß und Progreß der endlichen Kausalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:FGS6","text":"Gegenseitiges Setzen und Aufheben von Ursache und Wirkung → Selbstvoraussetzung und Selbstbedingung der Kausalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0028","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_BDBK:AF1","text":"Inhaltsidentität → äußerliche Ursache-Wirkung-Form → analytische Erklärung → endliche Substanz als Substrat → äußerlich gesetzte Ursächlichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AF2","text":"Endliche Ursache als Wirkung → Wirkung als erneute Ursache → schlechtes Unendliches → gegenseitige Selbstaufhebung → sich selbst voraussetzende Kausalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_BDBK:ME1","text":"Kausalerklärung wird in die Wiederholung eines identischen Inhalts und die äußerliche Zuordnung von Formrollen zerlegt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ME2","text":"Die Unterscheidung zwischen Ursache, Möglichkeitsbedingung und Veranlassung ersetzt die Gleichsetzung jedes vorausgehenden Umstands mit einer wirkenden Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ME3","text":"Organische, geistige und geschichtliche Prozesse werden als Umformung äußerer Einwirkungen statt als deren bloße Fortsetzung sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ME4","text":"Der unendliche Regreß wird von einer epistemischen Unvollständigkeit zu einer im endlichen Kausalverhältniß selbst erzeugten Struktur.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ME5","text":"Das Substrat erscheint nicht länger als neutrales Drittes, sondern als Voraussetzung, die von der Kausalität selbst gesetzt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_BDBK:ALT1","text":"Surface — Ursache und Wirkung werden als Bestimmungen eines identischen Inhalts analysiert, der unter verschiedenen Formnamen erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ALT2","text":"Structural — Die Trennung von Inhalt, Form und Substrat erzeugt die Endlichkeit äußerlicher Kausalität und deren unendliche Fortsetzung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ALT3","text":"Metastrategic — Erklärungen werden danach unterschieden, ob sie nur Anlässe registrieren oder eine immanente Selbstbestimmung des Gegenstands erfassen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ALT4","text":"Ontological/Temporal — Kausalität wird von einer zeitlich-linearen Übertragung zu einem Prozeß, in dem Ursache und Wirkung sich wechselseitig voraussetzen und setzen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_BDBK:MRT1","text":"Die Axiome reichen aus, um die Bewegung von Inhaltsidentität über endliche Äußerlichkeit und unendlichen Regreß zur Selbstvoraussetzung der Kausalität zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT2","text":"Unterbestimmt bleibt die positive Bestimmung derjenigen Verhältnisse der Idee, in denen organisches und geistiges Geschehen erst angemessen behandelt werden soll.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0011","trace_type":"Direct","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT3","text":"Die Struktur ist kohärent, sofern die Endlichkeit einer Ursache als Grund ihrer Umkehrung in Wirkung verstanden wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT4","text":"Ihre stärkste Verbindung liegt in der Ableitung des unendlichen Regresses aus der äußerlichen Einheit von Form und Substrat.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT5","text":"Eine Spannung bleibt zwischen der anfänglichen Behauptung analytischer Inhaltsidentität und der späteren Behauptung einer Kausalität, die sich selbst aktiv setzt und bedingt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT6","text":"Eine weitere Spannung entsteht, weil die Zurückweisung äußerlicher Kausalität für Geist und Leben bereits eine Selbsttätigkeit voraussetzt, deren positive Struktur hier vertagt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT7","text":"Die Begrenzung der Wirkung auf die Manifestation ihrer Ursache bleibt nur haltbar, indem große geschichtliche Folgen als Manifestationen eines inneren Geistes und nicht als Wirkungen kleiner Anlässe klassifiziert werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0011","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT8","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung nur, wenn die Selbstvoraussetzung nicht als endgültige Schließung, sondern als Übergang über die endliche Kausalität hinaus gelesen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0028","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T112809437650Z_dbf4e660","language_code":"en","language_name":"English","title":"b. The determinate relation of causality.","source_sha256":"85b99a252fb467fc07b97691623b128a81c66d58a243b384d5404ccc543712a6","sha256":"0d32c02a700a8647238ef1414dae37e872536879de2ed6ce60c91869f4175a77","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:28:09.439661+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_BDBK:AS1","text":"The determinate relation of causality is to explain how cause and effect can be identical in content and yet appear as finite, externally distinct determinations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AS2","text":"The identity in content of cause and effect initially empties finite causality into an analytical repetition of the same content under two formal determinations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AS3","text":"The externality of form and content makes cause and effect determinations of a finite substrate, whose causality proceeds from an alien determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AS4","text":"Because every determinate cause is at once a posited, finite moment and hence itself an effect, finite causality generates infinite regress and progress.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AS5","text":"The movement sublates external succession by cause and effect mutually positing, sublating, and presupposing each other as conditioning causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AS6","text":"The argument proceeds dialectically from tautological identity of content, through the finitude of external causality, to the self-presupposition of causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_BDBK:A1","text":"The identity of the cause with itself in its effect sublates its power and negativity and lets the content emerge as a unity indifferent to the differences of form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A2","text":"In finite causality, content and causal form are different, such that causality is external and contingent to determinate content.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A3","text":"As finite causal determinations, cause and effect contain the same content, which appears once as self-subsistent existence and once as being-posited in an other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A4","text":"A cause is a cause only with respect to those determinations that manifest themselves in its effect; its remaining content is indifferent to this relation of causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A5","text":"Remote causal series obscure the identity of content through intermediate links and circumstances, such that a single preceding event can only be a moment of conditions of possibility.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A6","text":"The living and spirit do not take up an external cause unchanged, but determine, transform, and break it off.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A7","text":"Wherever the relation of cause and effect is admitted at all, the effect is only the manifestation of the cause and cannot be greater than it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A8","text":"The content external to causality subsists as an immediate thing or finite substance, in which cause and effect have their substrate as particular formal determinations.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A9","text":"Finite causal substance begins from an external determination, sublates it in its effect, and thereby returns into its immediate identity, whereby it sublates its causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A10","text":"Every determinate cause is itself an effect as a finite moment, because its determinacy and negation lie outside it and its unity with the effect subsists only as an immediate substrate.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A11","text":"The transition of cause into effect and of effect into cause generates the infinite regress of causes as well as the analogous infinite progress of effects.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:A12","text":"Causality posits and sublates itself in its becoming-other and presupposes itself; the substrate thereby becomes the posited presupposition of acting causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0028","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_BDBK:NX1","text":"Finite causality is not the formal causality of absolute power, whose content would be pure manifestation or necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX2","text":"The explanation of an effect through its immediate cause is no extension of cognition in content, insofar as only the same content is repeated.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX3","text":"No property of a thing is thereby already causally relevant merely because it belongs to it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX4","text":"A remote preceding circumstance is not by itself the complete cause of a later effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX5","text":"Food, climate, individual events, or external states are not, in the proper sense, causes of organic, spiritual, or historical productions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX6","text":"The great does not arise causally from the small when the small functions only as an external occasion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0013","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX7","text":"Cause and effect are not enduringly one-sided roles of different substrates.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:NX8","text":"The infinite progression of finite reflection attains no fixed unity of form of cause and effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_BDBK:D1","text":"Finite causal explanation is analytical because it repeats the same content under the external formal names of cause and effect.","refs":["CH_GB18_BDBK:A2","CH_GB18_BDBK:A3","CH_GB18_BDBK:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:D2","text":"A multi-membered causal series does not explain an effect through a first isolated origin, but distributes its conditions of possibility across interconnected moments.","refs":["CH_GB18_BDBK:A3","CH_GB18_BDBK:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:D3","text":"Historical anecdotes lose the status of first causes and become occasions through which an already active inner spirit expresses itself.","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:A6","CH_GB18_BDBK:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:D4","text":"Organic and spiritual events can take up external influences only as transformed material, not as continued causality.","refs":["CH_GB18_BDBK:A6","CH_GB18_BDBK:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:D5","text":"Finite causal attribution cannot stably distinguish cause and effect, because every cause, as something determinate, is itself an effect, and every effect becomes again a cause in a substrate.","refs":["CH_GB18_BDBK:A8","CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:D6","text":"The immediate substrate loses the status of a merely given bearer as soon as causality posits it as its own presupposition.","refs":["CH_GB18_BDBK:A8","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_BDBK:SD1","text":"Finite causality is structurally divided in two: its content is identical, while its form externally separates the identity and thereby itself generates the need for explanation.","refs":["CH_GB18_BDBK:A1","CH_GB18_BDBK:A2","CH_GB18_BDBK:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:SD2","text":"The infinite causal regress is not a lack of causes still unknown, but the necessary consequence of the finite cause carrying its own finitude along with it as effect.","refs":["CH_GB18_BDBK:A8","CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:SD3","text":"The self-sublation of finite causality generates a causality whose condition no longer lies externally before it, but is posited by itself.","refs":["CH_GB18_BDBK:A9","CH_GB18_BDBK:A11","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:SD4","text":"Historical explanation is shifted from a search for the smallest external triggers to the distinction between occasion and inner power of manifestation.","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:A6","CH_GB18_BDBK:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_BDBK:DNX1","text":"No difference in content grounds from itself the difference between cause and effect, because this difference is initially exclusively a difference of form.","refs":["CH_GB18_BDBK:A1","CH_GB18_BDBK:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:DNX2","text":"No finite cause can count as an absolutely original origin, because its determinacy simultaneously marks it as an effect.","refs":["CH_GB18_BDBK:A9","CH_GB18_BDBK:A10"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:DNX3","text":"No single external event possesses the power immediately to bring forth organic, spiritual, or historical forms.","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:A6","CH_GB18_BDBK:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:DNX4","text":"No infinite progression of causes attains a final explanation so long as causality is conceived as an external relation of finite substrates.","refs":["CH_GB18_BDBK:A8","CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0023","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_BDBK:SNX1","text":"Excluded is a finite, externally localized, and at the same time self-grounding first ground.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:SNX2","text":"Excluded is a linear form of causality that could at once explain change and retain the identity of content unchanged.","refs":["CH_GB18_BDBK:A1","CH_GB18_BDBK:A3","CH_GB18_BDBK:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:SNX3","text":"Excluded is the reduction of spiritual or historical actuality to the continuity of external conditions in its results.","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:A6","CH_GB18_BDBK:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_BDBK:FGS1","text":"Identity of content of cause and effect ∧ external difference of form → finite and analytical causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:FGS2","text":"External difference of form ∧ content-indifferent substrate → cause and effect as separate determinations of finite substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0014","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:FGS3","text":"Finite substance ∧ alien being-posited → causal action as sublation of an external determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0016","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:FGS4","text":"Determinate cause → own determinacy → effect → renewed cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0027","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:FGS5","text":"Repetition of the reversal of cause and effect → infinite regress and progress of finite causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0024","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:FGS6","text":"Mutual positing and sublation of cause and effect → self-presupposition and self-conditioning of causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0028","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_BDBK:AF1","text":"Identity of content → external cause-effect form → analytical explanation → finite substance as substrate → externally posited causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0016","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:AF2","text":"Finite cause as effect → effect as renewed cause → bad infinity → mutual self-sublation → self-presupposing causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0025","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_BDBK:ME1","text":"Causal explanation is divided into the repetition of an identical content and the external assignment of formal roles.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ME2","text":"The distinction between cause, condition of possibility, and occasion replaces the equation of every preceding circumstance with an acting cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ME3","text":"Organic, spiritual, and historical processes become visible as transformations of external influences rather than as their mere continuation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ME4","text":"Infinite regress is transformed from an epistemic incompleteness into a structure generated within the finite relation of causality itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ME5","text":"The substrate no longer appears as a neutral third, but as a presupposition posited by causality itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_BDBK:ALT1","text":"Surface — Cause and effect are analyzed as determinations of an identical content that appears under different formal names.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ALT2","text":"Structural — The separation of content, form, and substrate generates the finitude of external causality and its infinite continuation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0014","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ALT3","text":"Metastrategic — Explanations are distinguished according to whether they merely register occasions or grasp an immanent self-determination of the object.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:ALT4","text":"Ontological/Temporal — Causality becomes, from a temporally linear transmission, a process in which cause and effect mutually presuppose and posit each other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0027","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_BDBK:MRT1","text":"The axioms suffice to reconstruct the movement from identity of content, through finite externality and infinite regress, to the self-presupposition of causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT2","text":"What remains underdetermined is the positive determination of those relations of the Idea in which organic and spiritual events are first to be treated adequately.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0011","trace_type":"Direct","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT3","text":"The structure is coherent insofar as the finitude of a cause is understood as the ground of its reversal into effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT4","text":"Its strongest connection lies in the derivation of infinite regress from the external unity of form and substrate.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0022","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT5","text":"A tension remains between the initial assertion of analytical identity of content and the later assertion of a causality that actively posits and conditions itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0028","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT6","text":"A further tension arises because the rejection of external causality for spirit and life already presupposes a self-activity whose positive structure is here deferred.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0011","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT7","text":"The limitation of the effect to the manifestation of its cause remains tenable only by classifying great historical consequences as manifestations of an inner spirit and not as effects of small occasions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0011","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0012","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_BDBK:MRT8","text":"The reconstruction preserves the actual movement only if self-presupposition is read not as a final closure, but as a transition beyond finite causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_BDBK:P0028","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_BDBK:P0029","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_BDBK@R001","source_variant_id":"canonical:CH_GB18_BDBK:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 165","title":"b. The Determinate Causal Relation.","context":"Chapter 165","original_title":"b. Das bestimmte Kausalitätsverhältniß."},"original_title":"b. Das bestimmte Kausalitätsverhältniß.","title_language_code":"en"},{"id":"CH_GB18_CWUG","layer":"CH","title":"c. Action and Reaction.","order":166,"parents":["RAW_GB18_CWUG"],"revision":"CH_GB18_CWUG@R001","sha256":"fa17d6630054695df71d19c962c55baaa514e802c59add2cd971a47e2e297c9a","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_CWUG:AS1","text":"Die endliche Kausalität erzeugt einen äußerlichen, potentiell unendlichen Fortschritt von Ursache und Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AS2","text":"Die Ursache wird als voraussetzendes Tun bestimmt und setzt sich notwendig eine passive Substanz als ihr Anderes voraus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AS3","text":"Die passive Substanz ist kein schlechthin Fremdes, sondern die vorausgesetzte, nur gesetzte und an sich mit der Ursache identische Bedingung ihres Wirkens.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AS4","text":"Das Wirken hebt zugleich die Selbstständigkeit des Passiven auf und erhält es als die Bedingung, in welcher die Ursache sich selbst als Anderes setzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AS5","text":"Das Bestimmtwerden des Passiven ist zugleich sein eigenes Werden zur Ursache; Einwirkung wird Gegenwirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AS6","text":"Die Gegenwirkung hebt die Wirkung der ersten Ursache und damit deren isolierte Ursächlichkeit auf; Kausalität wird zum in sich zurückkehrenden unendlichen Wechselwirken.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_CWUG:A1","text":"Kausalität ist voraussetzendes Tun.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A2","text":"Die Ursache ist bedingt, weil sie ihr Anderes als vorausgesetzte Bedingung ihrer Tätigkeit hat.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A3","text":"Die passive Substanz ist unmittelbares Ansichsein, das nicht für sich ist und daher nur als Gesetztes besteht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A4","text":"Die passive Substanz ist an sich mit der wirkenden Ursache identisch.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A5","text":"Die wirkende Substanz ist negative Beziehung auf sich und stellt sich im Wirken als Ursache wieder her.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A6","text":"Wirken ist zugleich Aufheben des Andersseins des Passiven und Setzen desselben als bestimmtes Anderes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A7","text":"Das Erhalten des Passiven ist kein Verzicht auf Negation, sondern die Form, in der die Ursache sich selbst als vorausgesetztes Anderes setzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A8","text":"Gewalt ist die Erscheinung der Macht als äußerliche Einwirkung auf ein nur gesetztes Selbstständiges.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A9","text":"Das Gesetztwerden des Passiven durch ein Anderes und sein eigenes Werden zur Ursache sind identisch.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A10","text":"Eine Ursache besitzt substanzielle Wirklichkeit nur in ihrer Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A11","text":"Das Aufheben der Wirkung hebt die Ursächlichkeit der Ursache auf und bestimmt sie selbst als passiv.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A12","text":"Die bedingte Kausalität bezieht die Ursache in ihrer Wirkung auf sich selbst zurück.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_CWUG:NX1","text":"Kausalität ist nicht eine Formbestimmung, die einem unabhängigen Substrat äußerlich inhärriert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX2","text":"Die passive Substanz ist nicht unmittelbar selbstständig, obwohl sie zunächst als selbstständiges Anderes erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX3","text":"Die Ursache ist nicht unbedingt oder von ihrer Wirkung unabhängig.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX4","text":"Gewalt ist nicht bloß äußerliche Willkür gegenüber einem schlechthin fremden Gegenstand.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX5","text":"Das Erleiden einer Einwirkung ist nicht bloße Aufhebung des Passiven.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX6","text":"Gegenwirkung ist nicht die bloße Fortsetzung einer Ursache in einer weiteren, äußerlichen Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX7","text":"Der unendliche Progressus von Wirkungen ist nicht die Wahrheit der Kausalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_CWUG:D1","text":"Die Ursache kann nur wirken, indem sie die passive Substanz sowohl negiert als auch als Bedingung ihres eigenen Wirkens erhält.","refs":["CH_GB18_CWUG:A1","CH_GB18_CWUG:A2","CH_GB18_CWUG:A6","CH_GB18_CWUG:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D2","text":"Die passive Substanz erweist sich in ihrer Unmittelbarkeit als Möglichkeit und nicht als vollgültige Selbstständigkeit.","refs":["CH_GB18_CWUG:A3","CH_GB18_CWUG:A4","CH_GB18_CWUG:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D3","text":"Die Gewalt aktualisiert nach der Begriffsbestimmung des Textes nur die bereits in der passiven Substanz liegende Bestimmung ihres Gesetztseins.","refs":["CH_GB18_CWUG:A3","CH_GB18_CWUG:A8","CH_GB18_CWUG:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D4","text":"Das Passive wird durch Bestimmung nicht einfach zerstört, sondern geht in seinem Bestimmtwerden mit sich selbst zusammen.","refs":["CH_GB18_CWUG:A3","CH_GB18_CWUG:A7","CH_GB18_CWUG:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D5","text":"Gegenwirkung ist die Aufhebung der empfangenen Wirkung durch die Umkehrung des Passiven in Ursache.","refs":["CH_GB18_CWUG:A9","CH_GB18_CWUG:A10","CH_GB18_CWUG:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D6","text":"Die erste Ursache wird durch ihre in der Gegenwirkung aufgehobene Wirkung selbst zur passiven Substanz.","refs":["CH_GB18_CWUG:A10","CH_GB18_CWUG:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D7","text":"Bedingte Kausalität schließt den äußerlichen Fortschritt, weil Ursache und Bedingung in der Wirkung als wechselseitige Momente gesetzt werden.","refs":["CH_GB18_CWUG:A2","CH_GB18_CWUG:A9","CH_GB18_CWUG:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_CWUG:SD1","text":"Ursächlichkeit ist keine stabile Stellung eines einzelnen Subjekts, sondern eine reversible Relation, in der Aktivität notwendig Passivität und Passivität notwendig Aktivität hervorbringt.","refs":["CH_GB18_CWUG:A5","CH_GB18_CWUG:A9","CH_GB18_CWUG:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:SD2","text":"Die scheinbare Exteriorität der Einwirkung wird als Selbstvermittlung einer substantiellen Identität rekonstruiert.","refs":["CH_GB18_CWUG:A2","CH_GB18_CWUG:A4","CH_GB18_CWUG:A6","CH_GB18_CWUG:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:SD3","text":"Gewalt verliert im System den Status eines absolut heteronomen Übergriffs, weil sie die Wahrheit des passiven Subjekts als Gesetztsein manifestieren soll.","refs":["CH_GB18_CWUG:A3","CH_GB18_CWUG:A8","CH_GB18_CWUG:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:SD4","text":"Das unendliche Wechselwirken ist keine Addition von Einzelkausalitäten, sondern die Rückkehr jeder Ursache aus ihrer Wirkung in die Bedingtheit ihrer eigenen Tätigkeit.","refs":["CH_GB18_CWUG:A1","CH_GB18_CWUG:A10","CH_GB18_CWUG:A11","CH_GB18_CWUG:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_CWUG:DNX1","text":"Ausgeschlossen ist die Möglichkeit einer Ursache, die ohne vorausgesetzte Bedingung und ohne Abhängigkeit von ihrer Wirkung vollständig wirksam wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:DNX2","text":"Ausgeschlossen ist die Möglichkeit einer passiven Substanz, deren Bestimmtheit ihr schlechthin äußerlich bliebe.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:DNX3","text":"Ausgeschlossen ist ein Verhältnis, in dem Einwirkung und Selbstwerden zwei vollständig trennbare Ereignisse wären.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:DNX4","text":"Ausgeschlossen ist eine endgültige Asymmetrie zwischen aktivem Täter und passivem Erleidenden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:DNX5","text":"Ausgeschlossen ist eine Kausalität, deren Wahrheit im bloßen Fortschreiten von Wirkungen in weitere Substanzen läge.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_CWUG:SNX1","text":"Unverfügbar ist ein schlechthin unmittelbarer Anfang, weil jedes Ursprüngliche nur als durch sich selbst vorausgesetzte Kausalität erscheint.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0002","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:SNX2","text":"Unzulässig ist die Annahme einer dauerhaften, von Vermittlung unberührten Substanzidentität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:SNX3","text":"Versperrt ist eine Endposition außerhalb des Wechselwirkens, weil jede gesetzte Ursache durch ihre Wirkung wieder in Passivität übergeht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_CWUG:FGS1","text":"Vorausgesetzte Bedingung → Ursache als negative Selbstbeziehung → Setzung des Passiven als Anderes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:FGS2","text":"Setzung des Anderen → Aufhebung seiner scheinbaren Selbstständigkeit → Erhaltung desselben als Bedingung der Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:FGS3","text":"Bestimmtwerden des Passiven → Zusammengehen mit sich selbst → Umkehrung des Passiven in Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:FGS4","text":"Umkehrung in Ursache → Aufhebung der empfangenen Wirkung → Gegenwirkung gegen die erste Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:FGS5","text":"Aufhebung der ersten Wirkung → Passivierung der ersten Ursache → Rückkehr der Ursächlichkeit in sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:FGS6","text":"Rückkehr der Ursache in ihre Bedingung → Aufhebung des schlechten Progressus → unendliches Wechselwirken.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_CWUG:AF1","text":"Endliche Kausalität als äußerlicher Wirkungsfortschritt → Ursache als voraussetzendes Tun → passive Substanz als gesetzte Bedingung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AF2","text":"Passive Bedingung → gewaltsame Einwirkung als Machtäußerung → Enthüllung der passiven Unmittelbarkeit als bloßer Schein.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AF3","text":"Bestimmtwerden des Passiven → Selbstsetzung als Ursache → Gegenwirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AF4","text":"Gegenwirkung → Aufhebung der ersten Wirkung → Passivierung der ersten Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AF5","text":"Wechselseitige Passivierung und Aktivierung → Rückkehr der Kausalität in sich → unendliches Wechselwirken.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_CWUG:ME1","text":"Ursache und Wirkung werden von getrennten Ereignispositionen zu wechselnden Funktionen einer einzigen vermittelten Substanzrelation umgeordnet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ME2","text":"Aktivität und Passivität werden nicht als feste Gegensätze behandelt, sondern als Umschlagsmomente derselben Kausalität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ME3","text":"Gewalt wird von einer bloß äußeren Relation zu einer Erscheinungsform der im Passiven selbst wirksamen Macht umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ME4","text":"Bedingung wird nicht als äußerlicher Hintergrund, sondern als von der Ursache selbst vorausgesetztes Anderes bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ME5","text":"Unendlichkeit wird vom endlosen Fortschritt zur Rückkehrsstruktur des Wechselwirkens verschoben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_CWUG:ALT1","text":"Surface — Der Text bestimmt das Verhältnis von wirkender Ursache, passiver Substanz, Gewalt, Gegenwirkung und Wechselwirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ALT2","text":"Structural — Jede Ursache setzt die Bedingung ihrer Wirksamkeit voraus, negiert deren Selbstständigkeit und reproduziert sie zugleich als ihre eigene Vermittlung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ALT3","text":"Metastrategic — Der argumentative Fortschritt ersetzt die Erklärung durch lineare Verursachung durch eine rekursive Umkehrung von Aktivität in Passivität und Passivität in Aktivität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ALT4","text":"Ontological/Temporal — Ursprünglichkeit existiert nicht vor der Vermittlung, sondern nur als Rückkehr aus gesetzter Andersheit; Unendlichkeit ist Rückbezüglichkeit statt endlose Sukzession.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_CWUG:MRT1","text":"Die Axiome reichen aus, um den Übergang von bestimmter Kausalität über Gewalt und Gegenwirkung zum unendlichen Wechselwirken zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:MRT2","text":"Unterbestimmt bleibt, weshalb die substantielle Identität von Ursache und passiver Substanz als notwendig und nicht nur behauptet gelten soll.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_CWUG:MRT3","text":"Das System ist kohärent, sofern Gesetztsein, Bedingtheit und Selbstwerden als verschiedene Seiten desselben Vermittlungsprozesses gelten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:MRT4","text":"Seine stärkste Operation liegt in der Umkehrung des Passiven zur Ursache, weil dadurch der schlechte Wirkungsfortschritt strukturell geschlossen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:MRT5","text":"Seine Hauptspannung liegt darin, dass Gewalt zugleich als äußerliche Einwirkung erscheint und als Verwirklichung der eigenen Bestimmung des Erleidenden bestimmt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:MRT6","text":"Eine weitere Spannung liegt darin, dass die reale Differenz von Ursache und Passivem behauptet wird, während ihre Identität die Differenz bereits begrifflich entkräftet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:MRT7","text":"Die Rekonstruktion bewahrt die tatsächliche Argumentbewegung, sofern die Passage nicht als Lehre symmetrischer Einzelursachen, sondern als Selbstvermittlung der Kausalität gelesen wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T114839424153Z_de20468a","language_code":"en","language_name":"English","title":"c. Action and Reaction.","source_sha256":"fa17d6630054695df71d19c962c55baaa514e802c59add2cd971a47e2e297c9a","sha256":"8f2daab1861ed14a5354a13969f4a8f4fe3f053d448aee8c5c51c3ed1f960052","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:48:39.427242+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_CWUG:AS1","text":"Finite causality produces an external, potentially infinite progression of cause and effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AS2","text":"The cause is determined as presupposing activity and necessarily presupposes a passive substance as its other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AS3","text":"The passive substance is not something absolutely alien, but the presupposed, merely posited condition of its activity, identical in itself with the cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AS4","text":"Activity simultaneously sublates the self-subsistence of the passive and preserves it as the condition in which the cause posits itself as other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AS5","text":"The being-determined of the passive is at the same time its own becoming-cause; action upon becomes reaction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AS6","text":"Reaction sublates the effect of the first cause and thereby its isolated causality; causality becomes infinite interaction returning into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_CWUG:A1","text":"Causality is presupposing activity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A2","text":"The cause is conditioned because it has its other as the presupposed condition of its activity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A3","text":"The passive substance is immediate being-in-itself, which is not for itself and therefore exists only as posited.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A4","text":"The passive substance is in itself identical with the acting cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A5","text":"The acting substance is negative relation to itself and restores itself in acting as cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A6","text":"Acting is at once the sublation of the otherness of the passive and the positing of it as determinate other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A7","text":"The preservation of the passive is not a renunciation of negation, but the form in which the cause posits itself as presupposed other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A8","text":"Violence is the appearance of power as external action upon a merely posited self-subsistent entity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A9","text":"The being-posited of the passive by an other and its own becoming-cause are identical.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A10","text":"A cause possesses substantial actuality only in its effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A11","text":"The sublation of the effect sublates the causality of the cause and determines it itself as passive.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:A12","text":"Conditioned causality relates the cause back to itself in its effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_CWUG:NX1","text":"Causality is not a determination of form that inheres externally in an independent substrate.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX2","text":"The passive substance is not immediately self-subsistent, although it initially appears as a self-subsistent other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX3","text":"The cause is not unconditioned or independent of its effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX4","text":"Violence is not merely external arbitrariness toward an absolutely alien object.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX5","text":"Undergoing an action upon is not the mere sublation of the passive.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX6","text":"Reaction is not the mere continuation of one cause in a further, external substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:NX7","text":"The infinite progressus of effects is not the truth of causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_CWUG:D1","text":"The cause can act only by both negating the passive substance and preserving it as the condition of its own activity.","refs":["CH_GB18_CWUG:A1","CH_GB18_CWUG:A2","CH_GB18_CWUG:A6","CH_GB18_CWUG:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D2","text":"The passive substance proves to be, in its immediacy, possibility and not fully valid self-subsistence.","refs":["CH_GB18_CWUG:A3","CH_GB18_CWUG:A4","CH_GB18_CWUG:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D3","text":"According to the conceptual determination of the text, violence actualizes only the determination of its being-posited already residing in the passive substance.","refs":["CH_GB18_CWUG:A3","CH_GB18_CWUG:A8","CH_GB18_CWUG:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D4","text":"The passive is not simply destroyed through determination, but in its being-determined comes together with itself.","refs":["CH_GB18_CWUG:A3","CH_GB18_CWUG:A7","CH_GB18_CWUG:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D5","text":"Reaction is the sublation of the received effect through the reversal of the passive into cause.","refs":["CH_GB18_CWUG:A9","CH_GB18_CWUG:A10","CH_GB18_CWUG:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D6","text":"Through its effect, sublated in the reaction, the first cause itself becomes the passive substance.","refs":["CH_GB18_CWUG:A10","CH_GB18_CWUG:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:D7","text":"Conditioned causality closes the external progression because cause and condition are posited in the effect as reciprocal moments.","refs":["CH_GB18_CWUG:A2","CH_GB18_CWUG:A9","CH_GB18_CWUG:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_CWUG:SD1","text":"Causality is not a stable position of an individual subject, but a reversible relation in which activity necessarily produces passivity and passivity necessarily produces activity.","refs":["CH_GB18_CWUG:A5","CH_GB18_CWUG:A9","CH_GB18_CWUG:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:SD2","text":"The apparent externality of action upon is reconstructed as the self-mediation of a substantial identity.","refs":["CH_GB18_CWUG:A2","CH_GB18_CWUG:A4","CH_GB18_CWUG:A6","CH_GB18_CWUG:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:SD3","text":"Within the system, violence loses the status of an absolutely heteronomous encroachment, because it is meant to manifest the truth of the passive subject as being-posited.","refs":["CH_GB18_CWUG:A3","CH_GB18_CWUG:A8","CH_GB18_CWUG:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:SD4","text":"Infinite interaction is not an addition of individual causalities, but the return of every cause from its effect into the conditionedness of its own activity.","refs":["CH_GB18_CWUG:A1","CH_GB18_CWUG:A10","CH_GB18_CWUG:A11","CH_GB18_CWUG:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_CWUG:DNX1","text":"Excluded is the possibility of a cause that would be fully effective without a presupposed condition and without dependence on its effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:DNX2","text":"Excluded is the possibility of a passive substance whose determinacy would remain absolutely external to it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0007","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:DNX3","text":"Excluded is a relation in which action upon and self-becoming would be two completely separable events.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:DNX4","text":"Excluded is a definitive asymmetry between active agent and passive sufferer.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:DNX5","text":"Excluded is a causality whose truth would lie in the mere progression of effects into further substances.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_CWUG:SNX1","text":"Unavailable is an absolutely immediate beginning, because everything original appears only as causality presupposed through itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0002","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:SNX2","text":"Impermissible is the assumption of an enduring identity of substance untouched by mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0004","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:SNX3","text":"Barred is a final position outside interaction, because every posited cause passes back into passivity through its effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_CWUG:FGS1","text":"Presupposed condition → cause as negative self-relation → positing of the passive as other.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:FGS2","text":"Positing of the other → sublation of its apparent self-subsistence → preservation of it as the condition of the cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:FGS3","text":"Being-determined of the passive → coming together with itself → reversal of the passive into cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:FGS4","text":"Reversal into cause → sublation of the received effect → reaction against the first cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:FGS5","text":"Sublation of the first effect → passivization of the first cause → return of causality into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:FGS6","text":"Return of the cause into its condition → sublation of the bad progressus → infinite interaction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_CWUG:AF1","text":"Finite causality as external progression of effects → cause as presupposing activity → passive substance as posited condition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AF2","text":"Passive condition → violent action upon as manifestation of power → disclosure of passive immediacy as mere semblance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AF3","text":"Being-determined of the passive → self-positing as cause → reaction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AF4","text":"Reaction → sublation of the first effect → passivization of the first cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:AF5","text":"Reciprocal passivization and activation → return of causality into itself → infinite interaction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_CWUG:ME1","text":"Cause and effect are reordered from separate event-positions into alternating functions of a single mediated substantial relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ME2","text":"Activity and passivity are treated not as fixed opposites, but as moments of transition of the same causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ME3","text":"Violence is reclassified from a merely external relation into a form of appearance of the power effective in the passive itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ME4","text":"Condition is determined not as an external background, but as the other presupposed by the cause itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ME5","text":"Infinity is shifted from endless progression to the return-structure of interaction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_CWUG:ALT1","text":"Surface — The text determines the relation of acting cause, passive substance, violence, reaction, and interaction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ALT2","text":"Structural — Every cause presupposes the condition of its efficacy, negates its self-subsistence, and at the same time reproduces it as its own mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ALT3","text":"Metastrategic — The argumentative progression replaces explanation through linear causation with a recursive reversal of activity into passivity and passivity into activity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:ALT4","text":"Ontological/Temporal — Originary character does not exist prior to mediation, but only as return from posited otherness; infinity is self-relatedness rather than endless succession.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_CWUG:MRT1","text":"The axioms suffice to reconstruct the transition from determinate causality through violence and reaction to infinite interaction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:MRT2","text":"What remains underdetermined is why the substantial identity of cause and passive substance should count as necessary and not merely asserted.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_CWUG:MRT3","text":"The system is coherent insofar as being-posited, conditionedness, and self-becoming count as different sides of the same process of mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:MRT4","text":"Its strongest operation lies in the reversal of the passive into cause, because thereby the bad progression of effects is structurally closed.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:MRT5","text":"Its principal tension lies in the fact that violence appears at once as external action upon and is determined as the actualization of the sufferer's own determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0005","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0006","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:MRT6","text":"A further tension lies in the fact that the real difference between cause and the passive is asserted, while their identity already conceptually invalidates the difference.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0004","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CWUG:MRT7","text":"The reconstruction preserves the actual movement of the argument insofar as the passage is read not as a doctrine of symmetrical individual causes, but as the self-mediation of causality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CWUG:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CWUG:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_CWUG@R001","source_variant_id":"canonical:CH_GB18_CWUG:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 166","title":"c. Action and Reaction.","context":"Chapter 166","original_title":"c. Wirkung und Gegenwirkung."},"original_title":"c. Wirkung und Gegenwirkung.","title_language_code":"en"},{"id":"CH_GB18_CD_4","layer":"CH","title":"C. Reciprocal Action.","order":167,"parents":["RAW_GB18_CD_4"],"revision":"CH_GB18_CD_4@R001","sha256":"d98557efb009b8bb6736c9ea6b4823bbf670f371f7497e40b2117fa78b3b1504","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_CD_4:AS1","text":"Die endliche Kausalität problematisiert sich, weil Ursache und Wirkung als äußerliche Substanzen erscheinen und ihre Identität deshalb nicht manifest ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AS2","text":"Die Wechselwirkung hebt die vorausgesetzte Selbständigkeit der wirkenden Substanzen auf, indem jede zugleich aktiv und passiv bestimmt ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AS3","text":"Die Passivität der Ursache wird als durch ihre eigene Aktivität gesetzte Bedingung bestimmt; Ursache und Wirkung vermitteln sich daher selbst.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AS4","text":"Die so begriffene Kausalität enthüllt sich als Bewegung, in der das Übergehen in Anderes Reflexion in sich selbst ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AS5","text":"Die Manifestation dieser inneren Identität transformiert Notwendigkeit und Zufälligkeit in Freiheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AS6","text":"Die absolute Substanz bestimmt sich als die Einheit von Allgemeinheit, Besonderheit und Einzelheit und ist damit Begriff, Subjektivität und Freiheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_CD_4:A1","text":"Endliche Kausalität setzt Ursache und Wirkung als äußerliche, gegeneinander bestehende Substanzen voraus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A2","text":"Wechselwirkung bestimmt jede Substanz zugleich als aktiv und passiv.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A3","text":"Die Einheit von Aktivität und Passivität hebt den substantiellen Unterschied der wechselwirkenden Seiten auf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A4","text":"Die Passivität der Ursache ist durch deren eigene Aktivität vermittelt und gesetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A5","text":"Eine Ursache ist nur Ursache, indem sie sich wesentlich zur Wirkung macht und in dieser Wirkung auf sich selbst bezogen bleibt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A6","text":"Das kausale Übergehen in Anderes ist, als aufgehobene Äußerlichkeit, Reflexion-in-sich.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A7","text":"Notwendigkeit ist innere Identität, deren substantielles Anderssein nur Schein ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A8","text":"Freiheit entsteht durch die Manifestation der inneren Identität der Notwendigkeit, nicht durch die Beseitigung der Notwendigkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A9","text":"Allgemeinheit und Einzelheit sind als aufgehobene Negativität unmittelbar identisch.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A10","text":"Besonderheit ist die unmittelbare Einheit der Bestimmtheit des Einzelnen und der Reflexion-in-sich des Allgemeinen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A11","text":"Die Einheit von Allgemeinheit, Besonderheit und Einzelheit ist der Begriff als Reich der Subjektivität oder Freiheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_CD_4:NX1","text":"Wechselwirkung ist nicht die Beziehung bleibend selbständiger Substrate.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX2","text":"Aktivität und Passivität sind nicht feste, unterschiedlichen Substanzen zukommende Eigenschaften.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX3","text":"Die Einwirkung auf die Ursache stammt nicht von einer schlechthin ursprünglichen anderen Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX4","text":"Kausalität ist nicht ein bloß einseitiges Übergehen einer ursprünglichen Ursache in eine fremde Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX5","text":"Notwendigkeit ist nicht Freiheit durch ihr Verschwinden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX6","text":"Zufälligkeit ist nicht das Auseinanderfallen gleichgültiger, äußerlicher Wirklichkeiten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX7","text":"Allgemeinheit, Besonderheit und Einzelheit sind nicht drei getrennte ontische Totalitäten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_CD_4:D1","text":"Die wechselseitig bedingenden Substanzen verlieren ihren Unterschied, weil jede nur durch die Identität ihrer Aktivität und Passivität besteht.","refs":["CH_GB18_CD_4:A2","CH_GB18_CD_4:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D2","text":"Die Bedingung der Ursache ist kein äußerer Zusatz, sondern ihre selbstgesetzte Negation.","refs":["CH_GB18_CD_4:A4","CH_GB18_CD_4:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D3","text":"Wechselwirkung ist keine zusätzliche Relationsform neben Kausalität, sondern deren explizite Selbstvermittlung.","refs":["CH_GB18_CD_4:A3","CH_GB18_CD_4:A4","CH_GB18_CD_4:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D4","text":"Der Unterschied von Ursache und Wirkung besteht nur als durchsichtiger Schein innerhalb einer identischen Reflexionsbewegung.","refs":["CH_GB18_CD_4:A5","CH_GB18_CD_4:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D5","text":"Die absolute Zufälligkeit der unterschiedenen Seiten ist die Erscheinungsform ihrer noch nicht manifesten notwendigen Identität.","refs":["CH_GB18_CD_4:A6","CH_GB18_CD_4:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D6","text":"Freiheit bezeichnet die gesetzte Identität der zuvor als selbständig erscheinenden Seiten der Notwendigkeit.","refs":["CH_GB18_CD_4:A7","CH_GB18_CD_4:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D7","text":"Die begrifflichen Momente unterscheiden sich nur als Selbstunterscheidung einer einzigen Reflexion.","refs":["CH_GB18_CD_4:A9","CH_GB18_CD_4:A10","CH_GB18_CD_4:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_CD_4:SD1","text":"Das System ersetzt lineare Kausalität durch eine rekursive Architektur, in der Ursache ihre Bedingung, Negation und Wirkung aus sich selbst hervorbringt.","refs":["CH_GB18_CD_4:A4","CH_GB18_CD_4:A5","CH_GB18_CD_4:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:SD2","text":"Die Umwandlung von Notwendigkeit in Freiheit ist keine Befreiung von Vermittlung, sondern die vollständige Transparenz der Vermittlung für sich selbst.","refs":["CH_GB18_CD_4:A6","CH_GB18_CD_4:A7","CH_GB18_CD_4:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:SD3","text":"Subjektivität ist nicht ein vorausgesetztes individuelles Zentrum, sondern die Form, in der absolute Substanz ihre Differenz als identische Selbstbestimmung setzt.","refs":["CH_GB18_CD_4:A8","CH_GB18_CD_4:A9","CH_GB18_CD_4:A10","CH_GB18_CD_4:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:SD4","text":"Der Begriff totalisiert Ursache, Wirkung, Notwendigkeit, Zufälligkeit und Substanz als Momente einer Selbstreflexion.","refs":["CH_GB18_CD_4:A5","CH_GB18_CD_4:A6","CH_GB18_CD_4:A7","CH_GB18_CD_4:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_CD_4:DNX1","text":"Ausgeschlossen ist ein Modell, in dem Relata ihrer Relation logisch vorausgehen und durch sie unverändert bleiben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:DNX2","text":"Ausgeschlossen ist ein Modell, in dem Negation bloßer Verlust, Mangel oder Abbruch statt produktive Selbstvermittlung ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:DNX3","text":"Ausgeschlossen ist eine Freiheit, die als Unbedingtheit, Willkür oder Abwesenheit von Notwendigkeit verstanden wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:DNX4","text":"Ausgeschlossen ist eine Pluralität letzter, irreduzibel äußerlicher Substanzen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:DNX5","text":"Ausgeschlossen ist eine Trennung von logischer Form und ontologischer Wirklichkeit, weil die Kategorien selbst die Bewegungsform des Wirklichen artikulieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_CD_4:SNX1","text":"Unverfügbar ist ein absolut ursprünglicher Anfang, der nicht schon durch Negation, Bedingung und Vermittlung konstituiert wäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:SNX2","text":"Unmöglich ist ein endgültiges Außen der Selbstvermittlung, aus dem eine Ursache, Bedingung oder Bestimmung unabhängig einwirken könnte.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:SNX3","text":"Unzulässig ist eine Freiheit, die eine bleibende Nichtidentität von Subjekt und objektiver Bestimmung bewahren würde.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_CD_4:FGS1","text":"Äußerliche Ursache/Wirkung → wechselseitige Aktivität/Passivität → Aufhebung selbständiger Substrate.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:FGS2","text":"Selbstgesetzte Passivität → Ursache als durch Wirkung bedingt → Kausalität als Selbstbeziehung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:FGS3","text":"Übergehen-in-Anderes → Reflexion-in-sich → Scheincharakter substantieller Äußerlichkeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:FGS4","text":"Innere Notwendigkeit + manifestierte Identität → Aufhebung von Notwendigkeit/Zufälligkeit als Gegensätzen → Freiheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:FGS5","text":"Selbstunterscheidung der absoluten Substanz → Allgemeinheit/Einzelheit → Besonderheit als ihre Einheit → Begriff.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_CD_4:AF1","text":"Äußerliche endliche Kausalität → Wechselwirkung als gegenseitige Kausalität → Identität von Aktivität und Passivität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AF2","text":"Identität von Aktivität und Passivität → selbstgesetzte Passivität der Ursache → Kausalität als reflexive Selbstvermittlung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AF3","text":"Reflexive Kausalität → Manifestation der inneren Notwendigkeit → Freiheit als gesetzte Identität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AF4","text":"Freiheit der manifesten Identität → Selbstunterscheidung der absoluten Substanz → Begriff als Allgemeinheit, Besonderheit und Einzelheit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_CD_4:ME1","text":"Ursache und Wirkung werden von getrennten Entitäten zu asymmetrischen Momenten einer einzigen Selbstvermittlungsbewegung umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ME2","text":"Passivität wird von fremder Einwirkung zu einer von Aktivität selbst hervorgebrachten Bestimmung transformiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ME3","text":"Notwendigkeit und Zufälligkeit erscheinen nicht mehr als gegensätzliche Modalitäten, sondern als unmanifestierte und manifeste Formen identischer Reflexion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ME4","text":"Freiheit wird von der Negation der Bedingtheit zur expliziten Selbstgegenwart der Bedingtheit verschoben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ME5","text":"Allgemeinheit, Besonderheit und Einzelheit werden nicht als Klassifikationsstufen, sondern als koextensive Totalitäten einer begrifflichen Selbstunterscheidung sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_CD_4:ALT1","text":"Surface — Wechselwirkung bestimmt die gegenseitige Kausalität zweier zunächst als selbständig vorausgesetzter Substanzen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ALT2","text":"Structural — Jede wirkende Seite setzt die eigene Passivität und ist nur durch die von ihr hervorgebrachte Bedingung Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ALT3","text":"Metastrategic — Der Text neutralisiert feste Gegensatzpaare nicht durch ihre Tilgung, sondern durch ihre Rekonstruktion als Momente einer höheren Selbstvermittlung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ALT4","text":"Ontological/Temporal — Werden ist kein reales Fortgehen von einem selbständigen Sein zu einem anderen, sondern der Schein einer in sich zurückkehrenden Reflexion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ALT5","text":"Ontological/Temporal — Freiheit bezeichnet die vollzogene Manifestation einer Identität, die in Notwendigkeit bereits innerlich wirksam ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_CD_4:MRT1","text":"Die Axiome reichen aus, um den Übergang von endlicher Kausalität über Wechselwirkung zur Freiheit und zum Begriff zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:MRT2","text":"Unterbestimmt bleibt, warum die Selbstvermittlung notwendig als dreigliedrige Einheit von Allgemeinheit, Besonderheit und Einzelheit artikuliert werden muss.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_CD_4:MRT3","text":"Die Struktur ist kohärent, sofern Äußerlichkeit, Negation und Vermittlung als immanente Momente derselben Reflexion akzeptiert werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:MRT4","text":"Die stärkste Operation liegt in der Umdeutung der passiven Bedingung als Selbstsetzung der Ursache.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:MRT5","text":"Die Rekonstruktion hängt von der nicht weiter begründeten Gleichsetzung des Übergehens in Anderes mit Reflexion-in-sich ab.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_CD_4:MRT6","text":"Eine Spannung verbleibt zwischen der behaupteten Aufhebung äußerlicher Verschiedenheit und der fortgesetzten Notwendigkeit, Unterschiede als bestimmte Momente auszuweisen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:MRT7","text":"Die Bewegung des Textes bleibt erhalten, wenn Wechselwirkung als Übergangsform verstanden wird, deren Resultat nicht Relation, sondern Begriff ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T114454118641Z_c9f5d7fd","language_code":"en","language_name":"English","title":"C. Reciprocity.","source_sha256":"d98557efb009b8bb6736c9ea6b4823bbf670f371f7497e40b2117fa78b3b1504","sha256":"bdd065e39233c9eb31eaa86e044d853dc2380e4f688d541a95a339ac54adfaf3","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T11:44:54.119869+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_GB18_CD_4:AS1","text":"Finite causality becomes problematic because cause and effect appear as external substances, and their identity is therefore not manifest.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AS2","text":"Reciprocity sublates the presupposed self-subsistence of the acting substances, in that each is determined as both active and passive.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AS3","text":"The passivity of the cause is determined as a condition posited through its own activity; cause and effect therefore mediate themselves.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AS4","text":"Causality thus conceived reveals itself as a movement in which transition into another is reflection into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AS5","text":"The manifestation of this inner identity transforms necessity and contingency into freedom.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AS6","text":"Absolute substance determines itself as the unity of universality, particularity, and individuality, and is thereby Concept, subjectivity, and freedom.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argumental Spine"},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_GB18_CD_4:A1","text":"Finite causality presupposes cause and effect as external substances existing over against one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A2","text":"Reciprocity determines each substance simultaneously as active and passive.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A3","text":"The unity of activity and passivity sublates the substantial difference of the reciprocally interacting sides.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A4","text":"The passivity of the cause is mediated and posited through its own activity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A5","text":"A cause is a cause only in that it essentially makes itself into an effect and remains related to itself in this effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A6","text":"Causal transition into another is, as sublated externality, reflection-into-self.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A7","text":"Necessity is inner identity, whose substantial otherness is mere semblance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A8","text":"Freedom arises through the manifestation of the inner identity of necessity, not through the elimination of necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A9","text":"Universality and individuality are immediately identical as sublated negativity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A10","text":"Particularity is the immediate unity of the determinacy of the individual and the reflection-into-self of the universal.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0010","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:A11","text":"The unity of universality, particularity, and individuality is the Concept as the realm of subjectivity or freedom.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Load-Bearing Axioms"},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_GB18_CD_4:NX1","text":"Reciprocity is not the relation of remaining self-subsistent substrates.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX2","text":"Activity and passivity are not fixed properties belonging to different substances.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX3","text":"The effect upon the cause does not originate from an absolutely original other substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX4","text":"Causality is not a merely one-sided transition of an original cause into an alien effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX5","text":"Necessity is not freedom through its disappearance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX6","text":"Contingency is not the falling-apart of indifferent, external actualities.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:NX7","text":"Universality, particularity, and individuality are not three separate ontic totalities.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Apophatic Structure"},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_GB18_CD_4:D1","text":"The mutually conditioning substances lose their difference because each exists only through the identity of its activity and passivity.","refs":["CH_GB18_CD_4:A2","CH_GB18_CD_4:A3"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D2","text":"The condition of the cause is not an external addition, but its self-posited negation.","refs":["CH_GB18_CD_4:A4","CH_GB18_CD_4:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D3","text":"Reciprocity is not an additional form of relation alongside causality, but its explicit self-mediation.","refs":["CH_GB18_CD_4:A3","CH_GB18_CD_4:A4","CH_GB18_CD_4:A5"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D4","text":"The difference between cause and effect exists only as transparent semblance within an identical movement of reflection.","refs":["CH_GB18_CD_4:A5","CH_GB18_CD_4:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D5","text":"The absolute contingency of the differentiated sides is the form of appearance of their as yet unmanifest necessary identity.","refs":["CH_GB18_CD_4:A6","CH_GB18_CD_4:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D6","text":"Freedom designates the posited identity of the sides of necessity that previously appeared self-subsistent.","refs":["CH_GB18_CD_4:A7","CH_GB18_CD_4:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:D7","text":"The conceptual moments differ only as the self-differentiation of a single reflection.","refs":["CH_GB18_CD_4:A9","CH_GB18_CD_4:A10","CH_GB18_CD_4:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Derivative Propositions"},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_GB18_CD_4:SD1","text":"The system replaces linear causality with a recursive architecture in which cause generates its condition, negation, and effect out of itself.","refs":["CH_GB18_CD_4:A4","CH_GB18_CD_4:A5","CH_GB18_CD_4:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:SD2","text":"The transformation of necessity into freedom is not a liberation from mediation, but the complete transparency of mediation for itself.","refs":["CH_GB18_CD_4:A6","CH_GB18_CD_4:A7","CH_GB18_CD_4:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:SD3","text":"Subjectivity is not a presupposed individual centre, but the form in which absolute substance posits its difference as identical self-determination.","refs":["CH_GB18_CD_4:A8","CH_GB18_CD_4:A9","CH_GB18_CD_4:A10","CH_GB18_CD_4:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:SD4","text":"The Concept totalizes cause, effect, necessity, contingency, and substance as moments of a self-reflection.","refs":["CH_GB18_CD_4:A5","CH_GB18_CD_4:A6","CH_GB18_CD_4:A7","CH_GB18_CD_4:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_GB18_CD_4:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Derivatives"},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_GB18_CD_4:DNX1","text":"Excluded is a model in which relata logically precede their relation and remain unchanged by it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:DNX2","text":"Excluded is a model in which negation is mere loss, deficiency, or interruption rather than productive self-mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:DNX3","text":"Excluded is a freedom understood as unconditionedness, arbitrariness, or absence of necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:DNX4","text":"Excluded is a plurality of ultimate, irreducibly external substances.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:DNX5","text":"Excluded is a separation of logical form and ontological actuality, because the categories themselves articulate the form of movement of the actual.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Deep Apophatics"},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_GB18_CD_4:SNX1","text":"Unavailable is an absolutely original beginning that would not already be constituted through negation, condition, and mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:SNX2","text":"Impossible is a final outside of self-mediation from which a cause, condition, or determination could act independently.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:SNX3","text":"Inadmissible is a freedom that would preserve an abiding non-identity of subject and objective determination.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Super-Apophatics"},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_GB18_CD_4:FGS1","text":"External cause/effect → reciprocal activity/passivity → sublation of self-subsistent substrates.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:FGS2","text":"Self-posited passivity → cause as conditioned through effect → causality as self-relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:FGS3","text":"Transition-into-another → reflection-into-self → semblance-character of substantial externality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:FGS4","text":"Inner necessity + manifested identity → sublation of necessity/contingency as opposites → freedom.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:FGS5","text":"Self-differentiation of absolute substance → universality/individuality → particularity as their unity → Concept.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Formal Generative Schema"},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_GB18_CD_4:AF1","text":"External finite causality → reciprocity as mutual causality → identity of activity and passivity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AF2","text":"Identity of activity and passivity → self-posited passivity of the cause → causality as reflexive self-mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AF3","text":"Reflexive causality → manifestation of inner necessity → freedom as posited identity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:AF4","text":"Freedom of manifest identity → self-differentiation of absolute substance → Concept as universality, particularity, and individuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Argument Flow Map"},{"number":"10","name":"Map-Effects","items":[{"id":"CH_GB18_CD_4:ME1","text":"Cause and effect are reclassified from separate entities into asymmetrical moments of a single movement of self-mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ME2","text":"Passivity is transformed from an alien effect into a determination produced by activity itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ME3","text":"Necessity and contingency no longer appear as opposed modalities, but as unmanifest and manifest forms of identical reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ME4","text":"Freedom is shifted from the negation of conditionedness to the explicit self-presence of conditionedness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ME5","text":"Universality, particularity, and individuality become visible not as levels of classification, but as coextensive totalities of a conceptual self-differentiation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Map-Effects"},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_GB18_CD_4:ALT1","text":"Surface — Reciprocity determines the mutual causality of two substances initially presupposed as self-subsistent.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ALT2","text":"Structural — Each acting side posits its own passivity and is a cause only through the condition it produces.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ALT3","text":"Metastrategic — The text neutralizes fixed pairs of opposites not by erasing them, but by reconstructing them as moments of a higher self-mediation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ALT4","text":"Ontological/Temporal — Becoming is not a real progression from one self-subsistent being to another, but the semblance of a reflection returning into itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:ALT5","text":"Ontological/Temporal — Freedom designates the accomplished manifestation of an identity that is already inwardly operative in necessity.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}],"original_name":"Altitude Levels"},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_GB18_CD_4:MRT1","text":"The axioms suffice to reconstruct the transition from finite causality through reciprocity to freedom and the Concept.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0002","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:MRT2","text":"What remains underdetermined is why self-mediation must necessarily be articulated as a tripartite unity of universality, particularity, and individuality.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_CD_4:MRT3","text":"The structure is coherent insofar as externality, negation, and mediation are accepted as immanent moments of the same reflection.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0003","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0006","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:MRT4","text":"The strongest operation lies in the reinterpretation of the passive condition as the self-positing of the cause.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:MRT5","text":"The reconstruction depends on the not further justified identification of transition into another with reflection-into-self.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_GB18_CD_4:MRT6","text":"A tension remains between the asserted sublation of external difference and the continuing necessity of exhibiting differences as determinate moments.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0009","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0010","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_GB18_CD_4:MRT7","text":"The movement of the text is preserved if reciprocity is understood as a transitional form whose result is not relation, but Concept.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_GB18_CD_4:P0001","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_GB18_CD_4:P0011","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}],"original_name":"Minimal Reconstruction Test"}],"revision":"CH_GB18_CD_4@R001","source_variant_id":"canonical:CH_GB18_CD_4:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 167","title":"C. Reciprocal Action.","context":"Chapter 167","original_title":"C. Die Wechselwirkung."},"original_title":"C. Die Wechselwirkung.","title_language_code":"en"},{"id":"CL_GB18_01","layer":"CL","title":"Chapters 01–03","order":1,"parents":["CH_GB18_VZEA","CH_GB18_VZZA","CH_GB18_ABDL"],"revision":"CL_GB18_01@R001","sha256":"129347f8afa9775bf6263c876357ccf4d1a75801f055f6f8c1a2a247bb6fcdf7","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_01:AS-B01","text":"Das Cluster bearbeitet die Diskrepanz zwischen einer geschichtlich veränderten Geistesform und einer Logik, die ihre Denkbestimmungen nur als äußerlich fixiertes Material bewahrt.","refs":["CH_GB18_VZEA:AS1","CH_GB18_VZZA:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B02","text":"Die Neubestimmung erhebt Logik vom formalen Instrument zur erneuerten Metaphysik und zum System objektiver Denkbestimmungen.","refs":["CH_GB18_VZEA:A4","CH_GB18_ABDL:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B03","text":"Die Grundlage dieser Umstellung ist die Aufhebung des Gegensatzes von Selbstgewissheit und Gegenstand, durch die Kategorien nicht länger als Besitz des Subjekts gelten können.","refs":["CH_GB18_ABDL:AS3","CH_GB18_VZZA:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B04","text":"Der Beweisgang besteht darin, fixierte Bestimmungen durch ihre notwendige Beziehung auf anderes in Widerspruch zu führen und durch bestimmte Negation bewahrend zu überschreiten.","refs":["CH_GB18_ABDL:AS6","CH_GB18_ABDL:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B05","text":"Die Bewegung verläuft geschichtlich motiviert, aber logisch immanent: Ein neues Prinzip erzwingt wissenschaftliche Ausarbeitung, während die zunächst notwendige Abstraktion ihrer eigenen Fixierung entzogen wird.","refs":["CH_GB18_VZEA:AS4","CH_GB18_VZZA:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B06","text":"Der Fortgang ist rekursiv, weil das Resultat den Begriff der Wissenschaft erzeugt und damit den Anfang rückwirkend legitimiert.","refs":["CH_GB18_VZZA:SD6","CH_GB18_ABDL:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B07","text":"Die Schließung bleibt doppelt: Die Logik soll sich intern selbst begründen, setzt als Eintritt aber das phänomenologisch erzeugte reine Wissen voraus und bleibt darstellerisch durch äußere Reflexionen gebrochen.","refs":["CH_GB18_ABDL:SD1","CH_GB18_VZZA:SD7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B08","text":"Das Cluster erzeugt eine Wissenschaft, deren Wahrheit allein im selbstkonstruierenden Weg ihres Inhalts liegt und deren terminale Wirkung Freiheit als bewusst gewordene Notwendigkeit ist.","refs":["CH_GB18_VZEA:A14","CH_GB18_VZZA:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_01:GA-01","text":"[Mutating] Die geschichtliche Unangemessenheit überlieferter Logik mutiert zur strukturellen Diagnose, dass äußerlich fixierte Denkformen notwendig gehaltlos bleiben.","refs":["CH_GB18_VZEA:A1","CH_GB18_VZZA:A1","CH_GB18_ABDL:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-02","text":"[Persistent] Logik ist nur als erneuerte Metaphysik und als System objektiver Denkbestimmungen wissenschaftlich.","refs":["CH_GB18_VZEA:A4","CH_GB18_ABDL:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-03","text":"[Persistent] Die wissenschaftliche Methode darf weder äußerlich übernommen noch nachträglich angewandt werden, sondern muss die dialektische Selbstbewegung ihres Inhalts sein.","refs":["CH_GB18_VZEA:A5","CH_GB18_ABDL:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-04","text":"[Emergent] Der Begriff ist zugleich das Innerste subjektiven Denkens und die Bestimmung der Sache selbst.","refs":["CH_GB18_VZZA:A8","CH_GB18_ABDL:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-05","text":"[Mutating] Die Absonderung reiner Denkformen ist eine notwendige Anfangsoperation, die zur Unwahrheit wird, sobald sie als endgültige Trennung fixiert bleibt.","refs":["CH_GB18_VZZA:A5","CH_GB18_VZZA:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-06","text":"[Persistent] Jede isoliert festgehaltene Denkbestimmung ist endlich und gerät durch ihre notwendige Beziehung auf andere Bestimmungen in Widerspruch.","refs":["CH_GB18_VZZA:A12","CH_GB18_ABDL:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-07","text":"[Persistent] Bestimmte Negation bewahrt den negierten Inhalt und erzeugt aus ihm und seinem Entgegengesetzten einen reicheren Begriff.","refs":["CH_GB18_ABDL:A9","CH_GB18_ABDL:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-08","text":"[Emergent] Die Vielheit bestimmter Begriffe ist die interne Differenzierung eines einzigen substantiellen Begriffs.","refs":["CH_GB18_VZZA:A11","CH_GB18_VZZA:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-09","text":"[Attractor] Der Anfang erhält seine wissenschaftliche Geltung erst durch den vollständigen Durchgang, dessen Resultat ihn rückwirkend als notwendigen Anfang bestimmt.","refs":["CH_GB18_VZZA:A16","CH_GB18_ABDL:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-10","text":"[Terminal] Geistige Freiheit besteht im Bewusstmachen und Reinigen kategorialer Notwendigkeit, nicht in willkürlicher Verfügung über Kategorien.","refs":["CH_GB18_VZZA:A14","CH_GB18_VZZA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-11","text":"[Mutating] Das reine Wissen fungiert als phänomenologische Eintrittsbedingung, während die Logik innerhalb ihrer Durchführung Selbstbegründung beansprucht.","refs":["CH_GB18_VZEA:AS7","CH_GB18_ABDL:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-12","text":"[Attractor] Selbstbewegung des Begriffs ist der Attraktor, in dem Methode, Inhalt, Wahrheit und Objektivität zusammenfallen und ein außerlogisches Außen ausgeschlossen wird.","refs":["CH_GB18_VZEA:AS6","CH_GB18_VZZA:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_01:RMD-01","text":"[Mutation] Logik bleibt nominell derselbe Gegenstand, wechselt aber vom vermeintlichen Instrument des Denkens zum System reiner Vernunft.","refs":["CH_GB18_VZEA:NX3","CH_GB18_ABDL:ME7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-02","text":"[Reversal] Kategorien wechseln von frei verfügbarem Eigentum des Subjekts zu Strukturen, die Subjektivität und Gegenständlichkeit hervorbringen.","refs":["CH_GB18_VZZA:NX5","CH_GB18_VZZA:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-03","text":"[Functional Recurrence] Abstraktion kehrt als notwendige Erkenntnisbedingung wieder, verliert aber jede terminale Geltung und wird zur selbstaufhebenden Durchgangsstufe.","refs":["CH_GB18_VZZA:A5","CH_GB18_VZZA:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-04","text":"[Mutation] Negation wandert von der bloßen Auflösung fester Bestimmungen zur bewahrenden Erzeugung bestimmteren Inhalts.","refs":["CH_GB18_VZEA:A8","CH_GB18_ABDL:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-05","text":"[Reversal] Das Allgemeine wird vom abstrakten Rahmen zur Totalität, die den Reichtum des Besonderen immanent enthält.","refs":["CH_GB18_VZEA:NX6","CH_GB18_ABDL:ME9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-06","text":"[Displacement] Die isolierte Fixierung auf den Anfang wird durch seine rückwirkende Begründung aus der Gesamtentwicklung verdrängt.","refs":["CH_GB18_VZZA:NX11","CH_GB18_VZZA:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-07","text":"[Absorption] Geschichtliche Reife bleibt Motiv der wissenschaftlichen Erneuerung, wird aber in die historische Ermöglichung eines Gegenstands absorbiert, dessen Geltung nicht historisch begründet sein soll.","refs":["CH_GB18_VZEA:AS4","CH_GB18_VZZA:SD8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-08","text":"[Displacement] Die konkreten Wissenschaften wechseln vom möglichen Lieferanten fremden Wahrheitsstoffs zur retrospektiven Vermittlung, durch die das abstrakt gelernte Logische als erfülltes Allgemeines erkannt wird.","refs":["CH_GB18_ABDL:AS7","CH_GB18_ABDL:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_01:CGD-01","text":"Der institutionelle Fortbestand alter Logik und die Unruhe moderner Rezeption bleiben lokale historische Bedingungen; sie begründen nicht die logische Notwendigkeit.","refs":["CH_GB18_VZEA:AS3","CH_GB18_VZZA:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:CGD-02","text":"Sprache, Vorstellung, Begehren und Wollen bleiben lokale Erscheinungsfelder, skalieren aber als Beleg dafür, dass kategoriale Strukturen vor ihrer Erkenntnis wirksam sind.","refs":["CH_GB18_VZZA:A3","CH_GB18_VZZA:ME9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:CGD-03","text":"Die Phänomenologie skaliert als notwendige Schwelle zur Logik, nicht jedoch als ausgeführter Bestandteil der internen kategorialen Entwicklung.","refs":["CH_GB18_VZEA:D6","CH_GB18_ABDL:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:CGD-04","text":"Auf Clusterebene trägt nicht die einzelne historische oder pädagogische Diagnose, sondern die Identität von Sache, Begriff und methodischer Selbstbewegung.","refs":["CH_GB18_ABDL:A11","CH_GB18_ABDL:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:CGD-05","text":"Die Rückkehr aus konkreten Wissenschaften bleibt eine subjektive Aneignungsbewegung und darf nicht zur objektiven Quelle logischer Inhalte umgedeutet werden.","refs":["CH_GB18_ABDL:AS7","CH_GB18_ABDL:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:CGD-06","text":"Die Zurückweisung einzelner vormals metaphysischer Disziplinen bleibt lokal; global skaliert sie zur Forderung, Metaphysik nicht zu restaurieren, sondern in immanente Logik umzubilden.","refs":["CH_GB18_VZEA:NX1","CH_GB18_VZEA:D2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_01:GNX-01","text":"Kein mathematisches, intuitives, empirisches oder sonst außerhalb des logischen Prozesses liegendes Verfahren darf die Methode begründen. ; Trace Type — Negative","refs":["CH_GB18_VZEA:NX4","CH_GB18_ABDL:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GNX-02","text":"Kategorien sind weder verfügbares Eigentum des Subjekts noch eine vermittelnde Schranke zwischen Subjekt und Sache. ; Trace Type — Negative","refs":["CH_GB18_VZZA:NX5","CH_GB18_VZZA:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GNX-03","text":"Ein formloser Inhalt und eine unabhängig fertige Gegenstandsmaterie können keine positive Bestimmtheit besitzen. ; Trace Type — Negative","refs":["CH_GB18_VZZA:DNX4","CH_GB18_ABDL:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GNX-04","text":"Formale Richtigkeit und fixierte Gegensätze dürfen weder Wahrheit konstituieren noch als ungeprüfte Evidenzen vorausgesetzt werden. ; Trace Type — Negative","refs":["CH_GB18_VZZA:NX8","CH_GB18_VZZA:NX10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GNX-05","text":"Dialektik ist weder isolierte Negation noch der Beweis einer Erkenntnisunfähigkeit der Vernunft. ; Trace Type — Negative","refs":["CH_GB18_VZEA:NX5","CH_GB18_ABDL:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GNX-06","text":"Praktischer Nutzen, pädagogische Verwertbarkeit und unmittelbare Interessen können wissenschaftliche Objektivität nicht legitimieren. ; Trace Type — Negative","refs":["CH_GB18_VZEA:DNX5","CH_GB18_VZZA:D10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_01:DBN-01","text":"Damit das System bestehen kann, darf keine irreduzible ontologische Differenz zwischen Denken und Sein und kein externer Vergleichsstandpunkt verfügbar sein. ; Trace Type — Negative","refs":["CH_GB18_ABDL:DNX1","CH_GB18_VZZA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:DBN-02","text":"Keine endliche Denkbestimmung darf isoliert Wahrheit besitzen oder als widerspruchsfreie endgültige Identität bestehen bleiben. ; Trace Type — Negative","refs":["CH_GB18_VZZA:DNX3","CH_GB18_ABDL:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:DBN-03","text":"Der begriffliche Fortgang darf weder kontingent noch durch eine Pluralität gleichberechtigter Methoden erzeugt werden; wissenschaftlich zählt allein die immanente Notwendigkeit der Übergänge. ; Trace Type — Negative","refs":["CH_GB18_ABDL:DNX6","CH_GB18_ABDL:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:DBN-04","text":"Negation darf nicht reiner Verlust sein, und Widerspruch darf nicht ohne bestimmten Nachfolger bleiben, weil sonst die produktive Kontinuität des Systems abbricht. ; Trace Type — Negative","refs":["CH_GB18_ABDL:DNX4","CH_GB18_ABDL:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_01:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist eine dem Begriff dauerhaft entzogene Außenheit, die bestimmbar wäre, ohne bereits kategorial vermittelt zu sein. ; Trace Type — Negative","refs":["CH_GB18_VZZA:SD2","CH_GB18_ABDL:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSA-02","text":"Nicht verfügbar ist ein Anfang, der seine Letztbegründung vor dem Prozess seiner eigenen Durchführung besäße. ; Trace Type — Negative","refs":["CH_GB18_VZZA:SNX2","CH_GB18_ABDL:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSA-03","text":"Systemisch unzulässig ist ein Widerspruch, der keine aufhebbare Fortsetzung erzeugt; zugleich bleibt die Eindeutigkeit dieser Fortsetzung die nicht gesicherte Abwesenheit, um die sich das Verfahren organisiert. ; Trace Type — Tension","refs":["CH_GB18_ABDL:SNX3","CH_GB18_ABDL:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_01:XD-01","text":"Die historische Reife eines neuen Prinzips kann die Krise der alten Logik auslösen, darf aber weder Methode noch Denkform der erneuerten Wissenschaft liefern. ; Trace Type — Composite","refs":["CL_GB18_01:GA-01","CL_GB18_01:GA-03","CH_GB18_VZEA:AS4","CH_GB18_VZZA:SD8","CH_GB18_ABDL:A1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-02","text":"Weil Kategorien Sprache, Begehren und Handlung bereits strukturieren, entsteht Freiheit nicht durch Herrschaft über sie, sondern durch das Selbstwissen objektiver Denkbestimmungen. ; Trace Type — Composite","refs":["CL_GB18_01:GA-04","CL_GB18_01:GA-10","CL_GB18_01:GA-12","CH_GB18_VZZA:A3","CH_GB18_VZZA:A7","CH_GB18_ABDL:AS4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-03","text":"Die Abstraktion reiner Formen ist erkenntnisnotwendig, erzeugt aber leere und kalkulatorische Formen, wenn ihre Fixierung nicht durch bestimmte Negation aufgehoben wird. ; Trace Type — Composite","refs":["CL_GB18_01:GA-05","CL_GB18_01:GA-06","CL_GB18_01:GA-07","CH_GB18_VZZA:A5","CH_GB18_ABDL:D6","CH_GB18_ABDL:A9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-04","text":"Die Logik besitzt eine kontrollierte Zirkularität: Sie setzt reines Wissen als Eintritt voraus, beansprucht interne Selbstbegründung und legitimiert ihren Anfang erst rückwirkend. ; Trace Type — Tension","refs":["CL_GB18_01:GA-09","CL_GB18_01:GA-11","CH_GB18_VZEA:AS7","CH_GB18_ABDL:SD1","CH_GB18_VZZA:SD6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-05","text":"Sobald Form und Inhalt sowie Gedanke und Sache als Momente desselben Begriffs gelten, kollabiert die Möglichkeit eines externen Standpunkts, der beide unabhängig vergleichen könnte. ; Trace Type — Composite","refs":["CL_GB18_01:GA-04","CL_GB18_01:GA-12","CH_GB18_VZZA:AS6","CH_GB18_ABDL:A6","CH_GB18_VZZA:SNX1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-06","text":"Bestimmte Negation verbindet die produktive Auflösung einer Bestimmung mit dem wissenschaftlichen Anspruch, jeden Übergang als immanent notwendig auszuweisen. ; Trace Type — Composite","refs":["CL_GB18_01:GA-06","CL_GB18_01:GA-07","CH_GB18_VZEA:D4","CH_GB18_ABDL:A9","CH_GB18_ABDL:SD6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-07","text":"Das Ideal einer allein aus dem Inhalt hervorgehenden Methode kann in der vorläufigen Darstellung nicht rein erscheinen, weil es seine eigene Geltung vorwegnimmt und rezeptionsbedingte Abwehrreflexionen aufnehmen muss. ; Trace Type — Tension","refs":["CL_GB18_01:GA-03","CL_GB18_01:GA-09","CH_GB18_VZEA:MRT5","CH_GB18_VZZA:A17","CH_GB18_VZZA:SD7"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_01:BSD-01","text":"Erkenntnistheorie wird in Ontologie überführt, weil logisches Selbstwissen und Bestimmung des Seienden denselben Begriff zum Gegenstand haben. ; Trace Type — Composite","refs":["CH_GB18_VZZA:SD1","CH_GB18_ABDL:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSD-02","text":"Das Subjekt wird von einem kategorialen Souverän zu einem durch Kategorien strukturierten Ort, der Freiheit nur durch das Bewusstwerden dieser Notwendigkeit gewinnt. ; Trace Type — Composite","refs":["CH_GB18_VZZA:AS5","CH_GB18_VZZA:A14","CH_GB18_VZZA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSD-03","text":"Zeit erhält eine rekursive Gestalt: Das Resultat erzeugt die Bedeutung des Anfangs und bestimmt eine vorausliegende Setzung nachträglich als notwendig. ; Trace Type — Composite","refs":["CH_GB18_VZZA:SD6","CH_GB18_ABDL:SD4","CH_GB18_ABDL:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSD-04","text":"Kausalität wird logisch statt äußerlich: Eine Bestimmung erzeugt ihren Fortgang durch die notwendige Beziehung auf ihr Anderes, den daraus entstehenden Widerspruch und dessen bewahrende Negation. ; Trace Type — Composite","refs":["CH_GB18_ABDL:A8","CH_GB18_ABDL:A9","CH_GB18_ABDL:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSD-05","text":"Geschichte spaltet sich in Ermöglichung und Geltung: Geistiger Wandel macht die Erneuerung sichtbar, während die Notwendigkeit ihres Gegenstands nicht aus diesem Wandel abgeleitet werden darf. ; Trace Type — Tension","refs":["CH_GB18_VZEA:ME5","CH_GB18_VZZA:SD8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_01:RLE-01","text":"Geistige Umgestaltung entwertet die überlieferte Logik; deren Entleerung erzwingt eine spekulative Erneuerung, welche die historische Niederlage der Metaphysik in ihre systematische Reorganisation umkehrt.","refs":["CH_GB18_VZEA:A1","CH_GB18_VZEA:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RLE-02","text":"Unbewusste kategoriale Wirksamkeit führt zur Absonderung der Formen; deren Fixierung erzeugt Unwahrheit, deren Aufhebung wiederum kategoriales Bewusstsein und Freiheit hervorbringt.","refs":["CH_GB18_VZZA:A3","CH_GB18_VZZA:SD4","CH_GB18_VZZA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RLE-03","text":"Fixierte Bestimmung → notwendige Beziehung auf anderes → Widerspruch → bestimmte Negation → bewahrte Einheit → reicherer Begriff bildet die zentrale Eskalationsschleife.","refs":["CH_GB18_ABDL:A8","CH_GB18_ABDL:A9","CH_GB18_ABDL:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RLE-04","text":"Anfang und Totalität bilden einen rekursiven Attraktor: Der Anfang ermöglicht den Durchgang, während erst der Durchgang seine Notwendigkeit bestätigt, ohne die Zirkularität vollständig zu beseitigen.","refs":["CH_GB18_VZZA:SD6","CH_GB18_VZZA:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RLE-05","text":"Phänomenologie und Logik bilden eine verteilte Schleife, weil reines Wissen den Eintritt in die Logik erzeugt, die Logik aber die begriffliche Grundlage dieses Übergangs beansprucht.","refs":["CH_GB18_VZEA:MRT7","CH_GB18_ABDL:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RLE-06","text":"Der eine substantielle Begriff ist der zentrale Attraktor, der die Vielheit der Kategorien, die Einheit von Methode und Gegenstand sowie die aufgehobenen Gegensätze in sich verdichtet.","refs":["CH_GB18_VZZA:A11","CH_GB18_VZZA:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_01:FGS-B01","text":"Geistige Umgestaltung + äußerlich überlieferte Denkformen → historische und systematische Unangemessenheit der vorhandenen Logik.","refs":["CH_GB18_VZEA:AS1","CH_GB18_VZZA:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B02","text":"Aufhebung des Gegensatzes von Selbstgewissheit und Gegenstand → Einheit von Wahrheit und Gewissheit → reines Wissen als Schwelle objektiver Logik.","refs":["CH_GB18_ABDL:AS3","CH_GB18_ABDL:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B03","text":"Unbewusste kategoriale Wirksamkeit → Absonderung der Denkformen → Fixierung ihrer Selbständigkeit → formale Endlichkeit.","refs":["CH_GB18_VZZA:A3","CH_GB18_VZZA:A5","CH_GB18_VZZA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B04","text":"Fixierte Bestimmung + notwendige Beziehung auf ihr Anderes → innerer Widerspruch.","refs":["CH_GB18_ABDL:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B05","text":"Innerer Widerspruch → bestimmte Negation → Bewahrung des Negierten → Einheit mit seinem Entgegengesetzten → reicherer Begriff.","refs":["CH_GB18_ABDL:A9","CH_GB18_ABDL:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B06","text":"Rekursive Wiederholung der begrifflichen Anreicherung → Identität von Methode und Inhaltsbewegung → systematische Totalität des Begriffs.","refs":["CH_GB18_ABDL:A11","CH_GB18_ABDL:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B07","text":"Vollendeter Durchgang → wissenschaftlicher Begriff des Anfangs → retrospektive Rückkehr zu konkreten Wissenschaften → Erkenntnis ihrer logischen Universalität.","refs":["CH_GB18_ABDL:A2","CH_GB18_ABDL:AS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_01:AFM-B01","text":"Geistige Umgestaltung → Krise der überlieferten Formen → Entdeckung bewusstlos wirksamer Kategorien → notwendige Absonderung der Denkformen.","refs":["CH_GB18_VZEA:A1","CH_GB18_VZZA:A3","CH_GB18_VZZA:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AFM-B02","text":"Abgesonderte Form → selbständige Fixierung → endliche Unwahrheit → notwendige Beziehung auf anderes → Widerspruch.","refs":["CH_GB18_VZZA:A12","CH_GB18_ABDL:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AFM-B03","text":"Widerspruch → bestimmte Negation → bewahrte Einheit der Gegensätze → reicherer Begriff → Methode als Selbstbewegung des Inhalts.","refs":["CH_GB18_ABDL:A9","CH_GB18_ABDL:A10","CH_GB18_ABDL:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AFM-B04","text":"Begriffliche Totalität → rückwirkende Begründung des Anfangs → kategoriales Selbstwissen → Freiheit → erneute Erschließung der konkreten Wissenschaften.","refs":["CH_GB18_VZZA:SD6","CH_GB18_VZZA:A14","CH_GB18_ABDL:AS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_01:MME-01","text":"Logik wird von der Lehre formaler Richtigkeit zur Wissenschaft der Wahrheit, des Seienden und der reinen Vernunft umkartiert.","refs":["CH_GB18_VZZA:ME3","CH_GB18_ABDL:ME7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MME-02","text":"Kategorien werden von subjektiven Werkzeugen zu Strukturen umklassifiziert, in denen Subjektivität und Gegenständlichkeit als Momente objektiven Denkens entstehen.","refs":["CH_GB18_VZZA:ME2","CH_GB18_ABDL:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MME-03","text":"Die Gegensätze von Form und Inhalt sowie Denken und Sache kollabieren als unabhängige Sphären und werden zu internen Differenzen begrifflicher Selbstbestimmung.","refs":["CH_GB18_VZZA:ME5","CH_GB18_VZZA:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MME-04","text":"Widerspruch und Negation wechseln von Defekt und Vernichtung zu Motor und bewahrender Produktion begrifflichen Inhalts.","refs":["CH_GB18_ABDL:ME4","CH_GB18_ABDL:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MME-05","text":"Definitionen und Einteilungen verlieren Begründungskraft und werden zu nachträglichen Karten einer Entwicklung, die ihren Anfang selbst rückwirkend bestimmt.","refs":["CH_GB18_ABDL:ME8","CH_GB18_VZZA:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MME-06","text":"Kritik wird internalisiert: Einwände gelten nicht als unabhängige Prüfungen, sondern als kategorial bestimmte Operationen, deren Voraussetzungen systematisch zu lokalisieren sind.","refs":["CH_GB18_VZZA:ME7","CH_GB18_VZZA:D11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_01:ALT-B01","text":"An der Oberfläche fordert das Cluster die Erneuerung der Logik als inhaltliche Wissenschaft des reinen Denkens.","refs":["CH_GB18_VZEA:ALT1","CH_GB18_ABDL:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:ALT-B02","text":"Strukturell organisiert es Sprache, geistige Tätigkeit und Wissenschaft durch die rekursive Sequenz von Widerspruch, bestimmter Negation, Bewahrung und begrifflicher Anreicherung.","refs":["CH_GB18_ABDL:ALT2","CH_GB18_VZZA:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:ALT-B03","text":"Metastrategisch bindet es Kritik an immanente Entwicklung und disqualifiziert externe Definitionen, Klassifikationen und Methoden als voraussetzungsreiche Eingriffe.","refs":["CH_GB18_VZZA:ALT3","CH_GB18_ABDL:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:ALT-B04","text":"Ontologisch setzt es den Begriff als gemeinsame Grundlage von Denken und Sein; temporal lässt es das Ende den Anfang rückwirkend begründen.","refs":["CH_GB18_VZZA:ALT4","CH_GB18_ABDL:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:ALT-B05","text":"Methodologisch und performativ versucht die Darstellung notwendige Entwicklung zu vollziehen, zeigt aber durch ihre polemischen und rezeptionsbezogenen Einschübe zugleich die Unreinheit jeder vorläufigen Exposition.","refs":["CH_GB18_VZZA:D12","CH_GB18_VZZA:SD7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_01:FL-01","text":"Der Anspruch der Voraussetzungslosigkeit kollidiert mit der phänomenologischen Deduktion des Standpunkts, von dem aus die Logik beginnen kann. ; Trace Type — Tension","refs":["CH_GB18_ABDL:MRT5","CH_GB18_ABDL:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-02","text":"Die Forderung strenger Immanenz steht in Spannung zur unvermeidlichen Aufnahme polemischer, psychologischer und rezeptionsbezogener Reflexionen. ; Trace Type — Tension","refs":["CH_GB18_VZZA:MRT5","CH_GB18_VZZA:SD7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-03","text":"Die geschichtliche Diagnose eines Neubeginns motiviert das System, während dessen begriffliche Notwendigkeit ausdrücklich nicht historisch sein soll. ; Trace Type — Tension","refs":["CH_GB18_VZEA:MRT6","CH_GB18_VZZA:SD8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-04","text":"Die Identität von Begriff und Sache trägt die ontologische Architektur, wird aber stärker vorausgesetzt und komprimiert als kategorial entwickelt. ; Trace Type — Tension","refs":["CH_GB18_VZZA:MRT6","CH_GB18_ABDL:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-05","text":"Bestimmte Negation erklärt Bewahrung und Anreicherung, beweist jedoch nicht die Eindeutigkeit des jeweils folgenden Begriffs oder die notwendige Vollendung des Systems. ; Trace Type — Tension","refs":["CH_GB18_ABDL:MRT6","CH_GB18_ABDL:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-06","text":"Die objektive Selbstgenügsamkeit der Logik steht in Spannung zur subjektiven Erschließung ihres Gehalts durch die Erfahrung konkreter Wissenschaften. ; Trace Type — Tension","refs":["CH_GB18_ABDL:MRT8","CH_GB18_ABDL:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-07","text":"Die Bestimmung der Logik als zweckfreie Wissenschaft bleibt gespannt zu ihrer terminalen Funktion, den Geist zu Freiheit und Wahrheit zu führen. ; Trace Type — Tension","refs":["CH_GB18_VZZA:MRT8","CH_GB18_VZZA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MP-01","text":"Die Abstraktion mutiert von einer notwendigen Anfangsbedingung zu einer unwahren Form, sobald sie ihren vorläufigen Charakter verliert. ; Trace Type — Tension","refs":["CH_GB18_VZZA:D3","CH_GB18_VZZA:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MP-02","text":"Das Besitzverhältnis mutiert, sobald nicht mehr das Subjekt über Kategorien verfügt, sondern kategoriale Strukturen Subjektivität und Gegenständlichkeit bestimmen. ; Trace Type — Tension","refs":["CH_GB18_VZZA:AS5","CH_GB18_VZZA:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MP-03","text":"Logik mutiert von einer historisch verdünnten Disziplin zur erneuerten Metaphysik und zum System reiner Vernunft. ; Trace Type — Composite","refs":["CH_GB18_VZEA:ME1","CH_GB18_ABDL:ME7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_01:HSI-01","text":"Realität erscheint als begrifflicher Organismus, dessen Unterschiede aus der Selbstfortbestimmung einer immanent gegliederten Einheit hervorgehen. ; Trace Type — Composite","refs":["CH_GB18_ABDL:A7","CH_GB18_ABDL:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:HSI-02","text":"Das Subjekt ist kein souveräner Besitzer seiner Kategorien, sondern ein kategorial strukturierter Knoten, der seine Freiheit durch Selbstbewusstsein dieser Struktur gewinnt. ; Trace Type — Composite","refs":["CH_GB18_VZZA:A7","CH_GB18_VZZA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:HSI-03","text":"Zeit ist keine lineare Folge, sondern eine Spirale, in der das Resultat den Anfang erzeugend auslegt und rückwirkend legitimiert. ; Trace Type — Composite","refs":["CH_GB18_VZZA:SD6","CH_GB18_ABDL:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:HSI-04","text":"Kampf und Navigation bestehen nicht in der Flucht zu einem Außen, sondern in der immanenten Prüfung fixierter Bestimmungen und ihrer Bewegung durch Negation. ; Trace Type — Composite","refs":["CH_GB18_VZZA:D8","CH_GB18_VZZA:SD2","CH_GB18_ABDL:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_01:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Umdeutung der Logik, die kategoriale Umkehrung des Subjekts, die dialektische Methode und die rekursive Begründung des Anfangs auf Clusterebene zu rekonstruieren.","refs":["CH_GB18_VZEA:MRT1","CH_GB18_VZZA:MRT1","CH_GB18_ABDL:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MRT-B02","text":"Unterbestimmt bleiben die konkrete erste Kategorie und die eindeutigen Übergangsregeln, durch welche jede einzelne Bestimmung ihren notwendigen Nachfolger erzeugen soll.","refs":["CH_GB18_VZEA:MRT2","CH_GB18_VZZA:MRT2","CH_GB18_ABDL:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MRT-B03","text":"Die Architektur ist nur kohärent, wenn die Einheit subjektiven Denkens und objektiven Begriffs sowie die phänomenologische Aufhebung des Bewusstseinsgegensatzes anerkannt werden.","refs":["CH_GB18_VZZA:MRT4","CH_GB18_ABDL:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MRT-B04","text":"Die stärkste generative Verbindung ist die Transformation des inneren Widerspruchs durch bestimmte Negation, Bewahrung und begriffliche Anreicherung.","refs":["CH_GB18_VZEA:MRT4","CH_GB18_ABDL:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MRT-B05","text":"Die tatsächliche Bewegung bleibt erhalten, wenn historische Motivation, phänomenologische Eintrittsbedingung, immanente Durchführung, rückwirkende Begründung und subjektive Wiederaneignung getrennt, aber rekursiv verbunden werden.","refs":["CH_GB18_VZZA:MRT10","CH_GB18_ABDL:MRT9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MRT-B06","text":"Der axiomatischen Reduktion widerstehen die rhetorische Kompression konkurrierender Positionen, die unbelegte Eindeutigkeit dialektischer Nachfolger und die totalisierende Identität von Denken und Sache.","refs":["CH_GB18_VZZA:MRT9","CH_GB18_ABDL:MRT6","CH_GB18_ABDL:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120354744787Z_065df30b","language_code":"en","language_name":"English","title":"Chapters 01–03","source_sha256":"129347f8afa9775bf6263c876357ccf4d1a75801f055f6f8c1a2a247bb6fcdf7","sha256":"19c6b497f705fce2cc79c0d08c5e1a18e87f96c10c25500cc2b70802323f398a","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:03:54.746293+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_01:AS-B01","text":"The cluster addresses the discrepancy between a historically transformed form of spirit and a logic that preserves its determinations of thought only as externally fixed material.","refs":["CH_GB18_VZEA:AS1","CH_GB18_VZZA:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B02","text":"The redefinition elevates logic from a formal instrument to renewed metaphysics and to a system of objective determinations of thought.","refs":["CH_GB18_VZEA:A4","CH_GB18_ABDL:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B03","text":"The basis of this transformation is the sublation of the opposition between self-certainty and object, through which categories can no longer count as the possession of the subject.","refs":["CH_GB18_ABDL:AS3","CH_GB18_VZZA:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B04","text":"The course of proof consists in leading fixed determinations into contradiction through their necessary relation to another, and in preservingly transcending them through determinate negation.","refs":["CH_GB18_ABDL:AS6","CH_GB18_ABDL:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B05","text":"The movement proceeds with historical motivation but logical immanence: a new principle compels scientific elaboration, while the initially necessary abstraction is deprived of its own fixation.","refs":["CH_GB18_VZEA:AS4","CH_GB18_VZZA:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B06","text":"The progression is recursive because the result produces the concept of science and thereby retrospectively legitimates the beginning.","refs":["CH_GB18_VZZA:SD6","CH_GB18_ABDL:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B07","text":"The closure remains twofold: logic is to ground itself internally, but as its entrance it presupposes phenomenologically generated pure knowing and remains fractured in its presentation by external reflections.","refs":["CH_GB18_ABDL:SD1","CH_GB18_VZZA:SD7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AS-B08","text":"The cluster produces a science whose truth lies solely in the self-constructing path of its content and whose terminal effect is freedom as necessity made conscious.","refs":["CH_GB18_VZEA:A14","CH_GB18_VZZA:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_01:GA-01","text":"[Mutating] The historical inadequacy of inherited logic mutates into the structural diagnosis that externally fixed forms of thought necessarily remain devoid of content.","refs":["CH_GB18_VZEA:A1","CH_GB18_VZZA:A1","CH_GB18_ABDL:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-02","text":"[Persistent] Logic is scientific only as renewed metaphysics and as a system of objective determinations of thought.","refs":["CH_GB18_VZEA:A4","CH_GB18_ABDL:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-03","text":"[Persistent] Scientific method may neither be externally adopted nor subsequently applied, but must be the dialectical self-movement of its content.","refs":["CH_GB18_VZEA:A5","CH_GB18_ABDL:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-04","text":"[Emergent] The concept is at once the innermost element of subjective thinking and the determination of the thing itself.","refs":["CH_GB18_VZZA:A8","CH_GB18_ABDL:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-05","text":"[Mutating] The separation of pure forms of thought is a necessary initial operation that becomes untruth as soon as it remains fixed as a final separation.","refs":["CH_GB18_VZZA:A5","CH_GB18_VZZA:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-06","text":"[Persistent] Every determination of thought held fixed in isolation is finite and enters into contradiction through its necessary relation to other determinations.","refs":["CH_GB18_VZZA:A12","CH_GB18_ABDL:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-07","text":"[Persistent] Determinate negation preserves the negated content and generates from it and its opposite a richer concept.","refs":["CH_GB18_ABDL:A9","CH_GB18_ABDL:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-08","text":"[Emergent] The multiplicity of determinate concepts is the internal differentiation of a single substantial concept.","refs":["CH_GB18_VZZA:A11","CH_GB18_VZZA:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-09","text":"[Attractor] The beginning receives its scientific validity only through the complete traversal, whose result retrospectively determines it as a necessary beginning.","refs":["CH_GB18_VZZA:A16","CH_GB18_ABDL:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-10","text":"[Terminal] Spiritual freedom consists in making categorical necessity conscious and purifying it, not in arbitrary disposal over categories.","refs":["CH_GB18_VZZA:A14","CH_GB18_VZZA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-11","text":"[Mutating] Pure knowing functions as a phenomenological condition of entry, while logic claims self-grounding within its execution.","refs":["CH_GB18_VZEA:AS7","CH_GB18_ABDL:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GA-12","text":"[Attractor] The self-movement of the concept is the attractor in which method, content, truth, and objectivity coincide and an extra-logical outside is excluded.","refs":["CH_GB18_VZEA:AS6","CH_GB18_VZZA:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_01:RMD-01","text":"[Mutation] Logic remains nominally the same object, but shifts from the supposed instrument of thinking to the system of pure reason.","refs":["CH_GB18_VZEA:NX3","CH_GB18_ABDL:ME7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-02","text":"[Reversal] Categories shift from freely disposable property of the subject to structures that bring forth subjectivity and objectivity.","refs":["CH_GB18_VZZA:NX5","CH_GB18_VZZA:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-03","text":"[Functional Recurrence] Abstraction recurs as a necessary condition of cognition, but loses all terminal validity and becomes a self-sublating transitional stage.","refs":["CH_GB18_VZZA:A5","CH_GB18_VZZA:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-04","text":"[Mutation] Negation moves from the mere dissolution of fixed determinations to the preservative production of more determinate content.","refs":["CH_GB18_VZEA:A8","CH_GB18_ABDL:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-05","text":"[Reversal] The universal shifts from an abstract framework to the totality that immanently contains the richness of the particular.","refs":["CH_GB18_VZEA:NX6","CH_GB18_ABDL:ME9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-06","text":"[Displacement] Isolated fixation on the beginning is displaced by its retrospective grounding from the total development.","refs":["CH_GB18_VZZA:NX11","CH_GB18_VZZA:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-07","text":"[Absorption] Historical maturity remains the motive of scientific renewal, but is absorbed into the historical enabling of an object whose validity is not to be grounded historically.","refs":["CH_GB18_VZEA:AS4","CH_GB18_VZZA:SD8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RMD-08","text":"[Displacement] The concrete sciences shift from the possible supplier of alien truth-material to the retrospective mediation through which the logically learned in abstraction is recognized as fulfilled universal.","refs":["CH_GB18_ABDL:AS7","CH_GB18_ABDL:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_01:CGD-01","text":"The institutional persistence of old logic and the unrest of modern reception remain local historical conditions; they do not ground logical necessity.","refs":["CH_GB18_VZEA:AS3","CH_GB18_VZZA:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:CGD-02","text":"Language, representation, desire, and willing remain local fields of appearance, but scale as evidence that categorical structures are effective prior to their cognition.","refs":["CH_GB18_VZZA:A3","CH_GB18_VZZA:ME9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:CGD-03","text":"Phenomenology scales as a necessary threshold to logic, but not as an executed component of the internal categorical development.","refs":["CH_GB18_VZEA:D6","CH_GB18_ABDL:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:CGD-04","text":"At cluster level, what bears is not the individual historical or pedagogical diagnosis, but the identity of thing, concept, and methodological self-movement.","refs":["CH_GB18_ABDL:A11","CH_GB18_ABDL:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:CGD-05","text":"The return from concrete sciences remains a movement of subjective appropriation and must not be reinterpreted as the objective source of logical contents.","refs":["CH_GB18_ABDL:AS7","CH_GB18_ABDL:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:CGD-06","text":"The rejection of individual formerly metaphysical disciplines remains local; globally, it scales to the demand not to restore metaphysics, but to transform it into immanent logic.","refs":["CH_GB18_VZEA:NX1","CH_GB18_VZEA:D2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_01:GNX-01","text":"No mathematical, intuitive, empirical, or other procedure lying outside the logical process may ground the method. ; Trace Type — Negative","refs":["CH_GB18_VZEA:NX4","CH_GB18_ABDL:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GNX-02","text":"Categories are neither disposable property of the subject nor a mediating barrier between subject and thing. ; Trace Type — Negative","refs":["CH_GB18_VZZA:NX5","CH_GB18_VZZA:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GNX-03","text":"A formless content and an independently ready-made object-material cannot possess positive determinacy. ; Trace Type — Negative","refs":["CH_GB18_VZZA:DNX4","CH_GB18_ABDL:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GNX-04","text":"Formal correctness and fixed oppositions may neither constitute truth nor be presupposed as unexamined evidences. ; Trace Type — Negative","refs":["CH_GB18_VZZA:NX8","CH_GB18_VZZA:NX10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GNX-05","text":"Dialectic is neither isolated negation nor the proof of reason's incapacity for cognition. ; Trace Type — Negative","refs":["CH_GB18_VZEA:NX5","CH_GB18_ABDL:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:GNX-06","text":"Practical utility, pedagogical usability, and immediate interests cannot legitimate scientific objectivity. ; Trace Type — Negative","refs":["CH_GB18_VZEA:DNX5","CH_GB18_VZZA:D10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_01:DBN-01","text":"For the system to stand, no irreducible ontological difference between thinking and being and no external standpoint of comparison may be available. ; Trace Type — Negative","refs":["CH_GB18_ABDL:DNX1","CH_GB18_VZZA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:DBN-02","text":"No finite determination of thought may possess truth in isolation or remain as a contradiction-free final identity. ; Trace Type — Negative","refs":["CH_GB18_VZZA:DNX3","CH_GB18_ABDL:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:DBN-03","text":"The conceptual progression may be generated neither contingently nor by a plurality of equally entitled methods; scientifically, only the immanent necessity of the transitions counts. ; Trace Type — Negative","refs":["CH_GB18_ABDL:DNX6","CH_GB18_ABDL:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:DBN-04","text":"Negation may not be pure loss, and contradiction may not remain without a determinate successor, because otherwise the productive continuity of the system breaks off. ; Trace Type — Negative","refs":["CH_GB18_ABDL:DNX4","CH_GB18_ABDL:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_01:BSA-01","text":"The most deeply excluded possibility is an exteriority permanently withdrawn from the concept, which could be determinable without already being categorically mediated. ; Trace Type — Negative","refs":["CH_GB18_VZZA:SD2","CH_GB18_ABDL:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSA-02","text":"Unavailable is a beginning that would possess its ultimate grounding prior to the process of its own execution. ; Trace Type — Negative","refs":["CH_GB18_VZZA:SNX2","CH_GB18_ABDL:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSA-03","text":"Systemically inadmissible is a contradiction that generates no sublatable continuation; at the same time, the unicity of this continuation remains the unsecured absence around which the procedure organizes itself. ; Trace Type — Tension","refs":["CH_GB18_ABDL:SNX3","CH_GB18_ABDL:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_01:XD-01","text":"The historical maturity of a new principle can trigger the crisis of old logic, but may supply neither the method nor the form of thought of renewed science. ; Trace Type — Composite","refs":["CL_GB18_01:GA-01","CL_GB18_01:GA-03","CH_GB18_VZEA:AS4","CH_GB18_VZZA:SD8","CH_GB18_ABDL:A1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-02","text":"Because categories already structure language, desire, and action, freedom arises not through mastery over them, but through the self-knowledge of objective determinations of thought. ; Trace Type — Composite","refs":["CL_GB18_01:GA-04","CL_GB18_01:GA-10","CL_GB18_01:GA-12","CH_GB18_VZZA:A3","CH_GB18_VZZA:A7","CH_GB18_ABDL:AS4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-03","text":"The abstraction of pure forms is necessary for cognition, but produces empty and calculative forms if their fixation is not sublated through determinate negation. ; Trace Type — Composite","refs":["CL_GB18_01:GA-05","CL_GB18_01:GA-06","CL_GB18_01:GA-07","CH_GB18_VZZA:A5","CH_GB18_ABDL:D6","CH_GB18_ABDL:A9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-04","text":"Logic possesses a controlled circularity: it presupposes pure knowing as entry, claims internal self-grounding, and legitimates its beginning only retrospectively. ; Trace Type — Tension","refs":["CL_GB18_01:GA-09","CL_GB18_01:GA-11","CH_GB18_VZEA:AS7","CH_GB18_ABDL:SD1","CH_GB18_VZZA:SD6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-05","text":"As soon as form and content, as well as thought and thing, count as moments of the same concept, the possibility of an external standpoint that could compare both independently collapses. ; Trace Type — Composite","refs":["CL_GB18_01:GA-04","CL_GB18_01:GA-12","CH_GB18_VZZA:AS6","CH_GB18_ABDL:A6","CH_GB18_VZZA:SNX1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-06","text":"Determinate negation connects the productive dissolution of a determination with the scientific claim to demonstrate every transition as immanently necessary. ; Trace Type — Composite","refs":["CL_GB18_01:GA-06","CL_GB18_01:GA-07","CH_GB18_VZEA:D4","CH_GB18_ABDL:A9","CH_GB18_ABDL:SD6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_01:XD-07","text":"The ideal of a method emerging solely from the content cannot appear purely in the provisional presentation, because it anticipates its own validity and must incorporate reception-conditioned defensive reflections. ; Trace Type — Tension","refs":["CL_GB18_01:GA-03","CL_GB18_01:GA-09","CH_GB18_VZEA:MRT5","CH_GB18_VZZA:A17","CH_GB18_VZZA:SD7"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_01:BSD-01","text":"Epistemology is transferred into ontology because logical self-knowledge and the determination of what is have the same concept as their object. ; Trace Type — Composite","refs":["CH_GB18_VZZA:SD1","CH_GB18_ABDL:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSD-02","text":"The subject changes from a categorical sovereign into a site structured by categories, which gains freedom only through becoming conscious of this necessity. ; Trace Type — Composite","refs":["CH_GB18_VZZA:AS5","CH_GB18_VZZA:A14","CH_GB18_VZZA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSD-03","text":"Time receives a recursive form: the result produces the meaning of the beginning and retrospectively determines a prior positing as necessary. ; Trace Type — Composite","refs":["CH_GB18_VZZA:SD6","CH_GB18_ABDL:SD4","CH_GB18_ABDL:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSD-04","text":"Causality becomes logical rather than external: a determination produces its progression through the necessary relation to its other, the contradiction thereby arising, and its preservative negation. ; Trace Type — Composite","refs":["CH_GB18_ABDL:A8","CH_GB18_ABDL:A9","CH_GB18_ABDL:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:BSD-05","text":"History divides into enabling and validity: spiritual transformation makes the renewal visible, while the necessity of its object may not be derived from this transformation. ; Trace Type — Tension","refs":["CH_GB18_VZEA:ME5","CH_GB18_VZZA:SD8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_01:RLE-01","text":"Spiritual transformation devalues inherited logic; its emptying compels a speculative renewal that reverses the historical defeat of metaphysics into its systematic reorganization.","refs":["CH_GB18_VZEA:A1","CH_GB18_VZEA:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RLE-02","text":"Unconscious categorical efficacy leads to the separation of forms; their fixation produces untruth, whose sublation in turn brings forth categorical consciousness and freedom.","refs":["CH_GB18_VZZA:A3","CH_GB18_VZZA:SD4","CH_GB18_VZZA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RLE-03","text":"Fixed determination → necessary relation to another → contradiction → determinate negation → preserved unity → richer concept constitutes the central escalation loop.","refs":["CH_GB18_ABDL:A8","CH_GB18_ABDL:A9","CH_GB18_ABDL:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RLE-04","text":"Beginning and totality form a recursive attractor: the beginning enables the traversal, whereas only the traversal confirms its necessity, without completely eliminating circularity.","refs":["CH_GB18_VZZA:SD6","CH_GB18_VZZA:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RLE-05","text":"Phenomenology and logic form a distributed loop, because pure knowing produces entry into logic, while logic claims the conceptual foundation of this transition.","refs":["CH_GB18_VZEA:MRT7","CH_GB18_ABDL:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:RLE-06","text":"The one substantial concept is the central attractor that concentrates within itself the multiplicity of categories, the unity of method and object, and the sublated oppositions.","refs":["CH_GB18_VZZA:A11","CH_GB18_VZZA:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_01:FGS-B01","text":"Spiritual transformation + externally inherited forms of thought → historical and systematic inadequacy of existing logic.","refs":["CH_GB18_VZEA:AS1","CH_GB18_VZZA:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B02","text":"Sublation of the opposition between self-certainty and object → unity of truth and certainty → pure knowing as threshold of objective logic.","refs":["CH_GB18_ABDL:AS3","CH_GB18_ABDL:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B03","text":"Unconscious categorical efficacy → separation of forms of thought → fixation of their independence → formal finitude.","refs":["CH_GB18_VZZA:A3","CH_GB18_VZZA:A5","CH_GB18_VZZA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B04","text":"Fixed determination + necessary relation to its other → internal contradiction.","refs":["CH_GB18_ABDL:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B05","text":"Internal contradiction → determinate negation → preservation of the negated → unity with its opposite → richer concept.","refs":["CH_GB18_ABDL:A9","CH_GB18_ABDL:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B06","text":"Recursive repetition of conceptual enrichment → identity of method and movement of content → systematic totality of the concept.","refs":["CH_GB18_ABDL:A11","CH_GB18_ABDL:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FGS-B07","text":"Completed traversal → scientific concept of the beginning → retrospective return to concrete sciences → cognition of their logical universality.","refs":["CH_GB18_ABDL:A2","CH_GB18_ABDL:AS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_01:AFM-B01","text":"Spiritual transformation → crisis of inherited forms → discovery of unconsciously effective categories → necessary separation of forms of thought.","refs":["CH_GB18_VZEA:A1","CH_GB18_VZZA:A3","CH_GB18_VZZA:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AFM-B02","text":"Separated form → independent fixation → finite untruth → necessary relation to another → contradiction.","refs":["CH_GB18_VZZA:A12","CH_GB18_ABDL:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AFM-B03","text":"Contradiction → determinate negation → preserved unity of opposites → richer concept → method as self-movement of content.","refs":["CH_GB18_ABDL:A9","CH_GB18_ABDL:A10","CH_GB18_ABDL:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:AFM-B04","text":"Conceptual totality → retrospective grounding of the beginning → categorical self-knowledge → freedom → renewed disclosure of the concrete sciences.","refs":["CH_GB18_VZZA:SD6","CH_GB18_VZZA:A14","CH_GB18_ABDL:AS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_01:MME-01","text":"Logic is remapped from the doctrine of formal correctness to the science of truth, of what is, and of pure reason.","refs":["CH_GB18_VZZA:ME3","CH_GB18_ABDL:ME7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MME-02","text":"Categories are reclassified from subjective tools to structures in which subjectivity and objectivity arise as moments of objective thinking.","refs":["CH_GB18_VZZA:ME2","CH_GB18_ABDL:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MME-03","text":"The oppositions of form and content, as well as thinking and thing, collapse as independent spheres and become internal differences of conceptual self-determination.","refs":["CH_GB18_VZZA:ME5","CH_GB18_VZZA:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MME-04","text":"Contradiction and negation shift from defect and annihilation to motor and preservative production of conceptual content.","refs":["CH_GB18_ABDL:ME4","CH_GB18_ABDL:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MME-05","text":"Definitions and divisions lose their grounding force and become retrospective maps of a development that itself retrospectively determines its beginning.","refs":["CH_GB18_ABDL:ME8","CH_GB18_VZZA:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MME-06","text":"Critique is internalized: objections count not as independent examinations, but as categorically determined operations whose presuppositions are to be systematically located.","refs":["CH_GB18_VZZA:ME7","CH_GB18_VZZA:D11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_01:ALT-B01","text":"At the surface, the cluster demands the renewal of logic as a substantive science of pure thinking.","refs":["CH_GB18_VZEA:ALT1","CH_GB18_ABDL:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:ALT-B02","text":"Structurally, it organizes language, spiritual activity, and science through the recursive sequence of contradiction, determinate negation, preservation, and conceptual enrichment.","refs":["CH_GB18_ABDL:ALT2","CH_GB18_VZZA:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:ALT-B03","text":"Metastrategically, it binds critique to immanent development and disqualifies external definitions, classifications, and methods as presupposition-laden interventions.","refs":["CH_GB18_VZZA:ALT3","CH_GB18_ABDL:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:ALT-B04","text":"Ontologically, it posits the concept as the common ground of thinking and being; temporally, it lets the end retrospectively ground the beginning.","refs":["CH_GB18_VZZA:ALT4","CH_GB18_ABDL:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:ALT-B05","text":"Methodologically and performatively, the presentation attempts to execute necessary development, but through its polemical and reception-related insertions simultaneously displays the impurity of every provisional exposition.","refs":["CH_GB18_VZZA:D12","CH_GB18_VZZA:SD7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_01:FL-01","text":"The claim of presuppositionlessness collides with the phenomenological deduction of the standpoint from which logic can begin. ; Trace Type — Tension","refs":["CH_GB18_ABDL:MRT5","CH_GB18_ABDL:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-02","text":"The demand for strict immanence stands in tension with the unavoidable incorporation of polemical, psychological, and reception-related reflections. ; Trace Type — Tension","refs":["CH_GB18_VZZA:MRT5","CH_GB18_VZZA:SD7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-03","text":"The historical diagnosis of a new beginning motivates the system, while its conceptual necessity is expressly not to be historical. ; Trace Type — Tension","refs":["CH_GB18_VZEA:MRT6","CH_GB18_VZZA:SD8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-04","text":"The identity of concept and thing bears the ontological architecture, but is more strongly presupposed and compressed than categorically developed. ; Trace Type — Tension","refs":["CH_GB18_VZZA:MRT6","CH_GB18_ABDL:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-05","text":"Determinate negation explains preservation and enrichment, but does not prove the unicity of the concept that follows in each case or the necessary completion of the system. ; Trace Type — Tension","refs":["CH_GB18_ABDL:MRT6","CH_GB18_ABDL:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-06","text":"The objective self-sufficiency of logic stands in tension with the subjective disclosure of its content through the experience of concrete sciences. ; Trace Type — Tension","refs":["CH_GB18_ABDL:MRT8","CH_GB18_ABDL:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:FL-07","text":"The determination of logic as purposeless science remains in tension with its terminal function of leading spirit to freedom and truth. ; Trace Type — Tension","refs":["CH_GB18_VZZA:MRT8","CH_GB18_VZZA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MP-01","text":"Abstraction mutates from a necessary initial condition into an untrue form as soon as it loses its provisional character. ; Trace Type — Tension","refs":["CH_GB18_VZZA:D3","CH_GB18_VZZA:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MP-02","text":"The relation of possession mutates as soon as it is no longer the subject that disposes over categories, but categorical structures that determine subjectivity and objectivity. ; Trace Type — Tension","refs":["CH_GB18_VZZA:AS5","CH_GB18_VZZA:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MP-03","text":"Logic mutates from a historically thinned discipline into renewed metaphysics and the system of pure reason. ; Trace Type — Composite","refs":["CH_GB18_VZEA:ME1","CH_GB18_ABDL:ME7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_01:HSI-01","text":"Reality appears as a conceptual organism whose differences arise from the self-continuation of an immanently articulated unity. ; Trace Type — Composite","refs":["CH_GB18_ABDL:A7","CH_GB18_ABDL:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:HSI-02","text":"The subject is not a sovereign possessor of its categories, but a categorically structured node that gains its freedom through consciousness of this structure. ; Trace Type — Composite","refs":["CH_GB18_VZZA:A7","CH_GB18_VZZA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:HSI-03","text":"Time is not a linear sequence, but a spiral in which the result interpretively produces the beginning and retrospectively legitimates it. ; Trace Type — Composite","refs":["CH_GB18_VZZA:SD6","CH_GB18_ABDL:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:HSI-04","text":"Struggle and navigation consist not in flight to an outside, but in the immanent examination of fixed determinations and their movement through negation. ; Trace Type — Composite","refs":["CH_GB18_VZZA:D8","CH_GB18_VZZA:SD2","CH_GB18_ABDL:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_01:MRT-B01","text":"The extracted axioms suffice to reconstruct at cluster level the reinterpretation of logic, the categorical reversal of the subject, the dialectical method, and the recursive grounding of the beginning.","refs":["CH_GB18_VZEA:MRT1","CH_GB18_VZZA:MRT1","CH_GB18_ABDL:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MRT-B02","text":"Underdetermined remain the concrete first category and the unambiguous rules of transition through which each individual determination is to generate its necessary successor.","refs":["CH_GB18_VZEA:MRT2","CH_GB18_VZZA:MRT2","CH_GB18_ABDL:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MRT-B03","text":"The architecture is coherent only if the unity of subjective thinking and objective concept, as well as the phenomenological sublation of the opposition of consciousness, are acknowledged.","refs":["CH_GB18_VZZA:MRT4","CH_GB18_ABDL:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MRT-B04","text":"The strongest generative connection is the transformation of internal contradiction through determinate negation, preservation, and conceptual enrichment.","refs":["CH_GB18_VZEA:MRT4","CH_GB18_ABDL:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MRT-B05","text":"The actual movement is preserved if historical motivation, phenomenological condition of entry, immanent execution, retrospective grounding, and subjective reappropriation are kept distinct but recursively connected.","refs":["CH_GB18_VZZA:MRT10","CH_GB18_ABDL:MRT9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_01:MRT-B06","text":"What resists axiomatic reduction are the rhetorical compression of competing positions, the unsubstantiated unicity of dialectical successors, and the totalizing identity of thinking and thing.","refs":["CH_GB18_VZZA:MRT9","CH_GB18_ABDL:MRT6","CH_GB18_ABDL:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_01@R001","source_variant_id":"canonical:CL_GB18_01:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 01–03","context":"Vorrede zur ersten Ausgabe. · Vorrede zur zweiten Auflage. · Allgemeiner Begriff der Logik"},"title_language_code":"en"},{"id":"CL_GB18_02","layer":"CL","title":"Chapters 04–06","order":2,"parents":["CH_GB18_AEDL","CH_GB18_WMDA","CH_GB18_AEDS"],"revision":"CL_GB18_02@R001","sha256":"14205210d90e1d7ec79471a3d56d45f683f2a7a9817fce018cd3a7819fdfff05","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_02:AS-01","text":"Das System muss einen voraussetzungslosen Anfang mit einer bereits vermittelten Wissenschaft und deren zunächst nur vorläufiger Gliederung vereinbaren.","refs":["CH_GB18_WMDA:AS1","CH_GB18_AEDL:AS1"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-02","text":"Wissenschaftliche Ordnung gilt nur, wenn sachlicher Inhalt, Methode und Gliederung aus derselben Selbstbestimmung hervorgehen.","refs":["CH_GB18_WMDA:AS2","CH_GB18_AEDL:AS2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-03","text":"Das reine Wissen als Einheit von Seyn und Begriff reduziert sich nach Aufhebung seiner Unterschiede auf einfache Unmittelbarkeit, aus der die Bestimmungen des Seyns hervorgehen.","refs":["CH_GB18_AEDL:A3","CH_GB18_WMDA:A7","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-04","text":"Das Argument verfährt rekonstruktiv und apophatisch: Es entfernt äußere Begründungen, bis nur die Eigenbewegung des Inhalts als Quelle der Notwendigkeit verbleibt.","refs":["CH_GB18_WMDA:AS3","CH_GB18_WMDA:A16"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-05","text":"Die gerichtete Bewegung führt vom vermittelten reinen Wissen über reines Seyn zu Qualität, Quantität und Maaß.","refs":["CH_GB18_WMDA:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-06","text":"Die Entfaltung von Seyn, Wesen und Begriff sowie die Binnenentwicklung von Qualität, Quantität und Maaß sind verschachtelte Vollzüge derselben Selbstgliederung.","refs":["CH_GB18_AEDL:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-07","text":"Die Bewegung ist gerichtet, aber rekursiv: Der Fortgang kehrt in seinen Grund zurück und verleiht dem zunächst Vorläufigen rückwirkend Wahrheit.","refs":["CH_GB18_WMDA:A13","CH_GB18_AEDL:SD5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-08","text":"Die Schließung besteht in einem Kreis, in dem Anfang, Entwicklung und Eintheilung einander begründen, ohne durch einen äußeren Standpunkt autorisiert zu werden.","refs":["CH_GB18_WMDA:A14","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_02:GA-01","text":"[Attractor] Begriffliche Bestimmungen besitzen ihren Ursprung allein in der Selbstunterscheidung und Eigenbewegung ihres Inhalts.","refs":["CH_GB18_AEDL:A2","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-02","text":"[Persistent] Wissenschaftliche Wahrheit verlangt, dass Methode, Inhalt, Anfang und Gliederung nicht auseinanderfallen.","refs":["CH_GB18_WMDA:A1","CH_GB18_WMDA:AS2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-03","text":"[Mutating] Reines Wissen ist zunächst die konkrete Einheit von Seyn und Begriff und wird durch Aufhebung seiner Unterschiede zur einfachen Unmittelbarkeit.","refs":["CH_GB18_AEDL:A3","CH_GB18_WMDA:A7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-04","text":"[Persistent] Unmittelbarkeit und Vermittlung sind keine ausschließenden Alternativen, sondern wechselnde Funktionen derselben begrifflichen Bewegung.","refs":["CH_GB18_WMDA:A2","CH_GB18_WMDA:D4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-05","text":"[Terminal] Reines Seyn ist der einzig zulässige logische Anfang, weil jeder reichere Inhalt bereits Bestimmung und Vermittlung voraussetzt.","refs":["CH_GB18_WMDA:AS7","CH_GB18_WMDA:A8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-06","text":"[Mutating] Eintheilung beginnt als vorläufige Antizipation, wird aber zum Urteil des Begriffs und erhält ihre Geltung erst durch den vollzogenen Inhalt.","refs":["CH_GB18_AEDL:A1","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-07","text":"[Emergent] Die Makrogliederung von Seyn, Wesen und Begriff und die Binnengliederung des Seyns sind rekursive Instanzen derselben generativen Form.","refs":["CH_GB18_AEDL:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-08","text":"[Mutating] Bestimmtheit ist als vorausgesetzter Anfang unzulässig, wird jedoch als erste immanente Leistung des reinen Seyns zur Qualität.","refs":["CH_GB18_WMDA:A11","CH_GB18_AEDS:A7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-09","text":"[Persistent] Qualität, Quantität und Maaß bilden keine gleichrangige Liste, sondern die Folge unmittelbarer, aufgehobener und vermittelter Bestimmtheit.","refs":["CH_GB18_AEDS:A7","CH_GB18_AEDS:A8","CH_GB18_AEDS:A9"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-10","text":"[Attractor] Anfang und Eintheilung werden erst durch die Gesamtentwicklung vollständig erkannt und gerechtfertigt.","refs":["CH_GB18_WMDA:A15","CH_GB18_AEDS:D8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-11","text":"[Terminal] Ein archimedisches Außen, von dem aus Begriff, Anfang oder Kategorien neutral geordnet werden könnten, ist ausgeschlossen.","refs":["CH_GB18_AEDL:DNX1","CH_GB18_WMDA:SNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_02:RMD-01","text":"Reines Wissen kehrt nicht identisch wieder: Als vermitteltes Resultat verliert es seine Wissensform, wird einfache Unmittelbarkeit und erhält als reines Seyn eine Anfangsfunktion.","refs":["CH_GB18_WMDA:A5","CH_GB18_WMDA:A7","CH_GB18_WMDA:A8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-02","text":"Vermittlung mutiert vom scheinbaren Hindernis des absoluten Anfangs zum notwendigen Operator des Wesens und zur bestimmten Relation des Maaßes.","refs":["CH_GB18_WMDA:A2","CH_GB18_AEDL:A7","CH_GB18_AEDS:D5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-03","text":"Seyn verschiebt sich vom Moment der Einheit mit dem Begriff über den unbestimmten Anfang zur selbstbestimmenden Begriffssphäre.","refs":["CH_GB18_AEDL:A3","CH_GB18_AEDS:A2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-04","text":"Eintheilung wiederholt sich funktional als vorläufige Karte, Selbsturteil des Begriffs und nachträglich gerechtfertigte Entwicklungsordnung.","refs":["CH_GB18_AEDL:A1","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-05","text":"Der äußere Gegensatz von Wissen und Gegenstand wird in interne Übergänge zwischen Formen der Bestimmtheit verlagert.","refs":["CH_GB18_WMDA:A6","CH_GB18_AEDS:ME3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-06","text":"Das erkennende Subjekt verliert seine generative Funktion; diese wird vom sich selbst bewegenden Inhalt übernommen.","refs":["CH_GB18_WMDA:SD5","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-07","text":"Die Kantkritik wandert von der Begrenzung der Kategorien durch das subjektive Ich zur Kritik einer äußerlichen Kategorienfolge und ihrer unzureichenden systematischen Orte.","refs":["CH_GB18_AEDL:AS7","CH_GB18_AEDS:NX7"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_02:CGD-01","text":"Die konkreten Dreiteilungen bleiben lokale Gliederungen ihrer jeweiligen Sphären; auf Clusterebene skaliert allein das Gesetz ihrer immanenten Erzeugung.","refs":["CH_GB18_AEDL:A12","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:CGD-02","text":"Reines Seyn skaliert über seine lokale Anfangsfunktion hinaus, weil es zugleich den Übergang zum qualitativen Seyn und damit zur ersten entwickelten Sphäre trägt.","refs":["CH_GB18_WMDA:AS7","CH_GB18_AEDS:D1"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:CGD-03","text":"Die Kritik am Ding-an-sich sowie an Relation und Modalität bleibt in ihren Zielbegriffen lokal, skaliert aber als allgemeiner Ausschluss äußerlich fixierter Kategorienorte.","refs":["CH_GB18_AEDL:AS7","CH_GB18_AEDS:NX2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:CGD-04","text":"Ich, Gott und intellektuelle Anschauung bleiben lokale Gegenkandidaten des Anfangskapitels; ihre clusterweite Funktion besteht nur im Nachweis verfrühter Konkretion.","refs":["CH_GB18_WMDA:NX10","CH_GB18_WMDA:NX12"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:CGD-05","text":"Wesen und Maaß sind nicht gleichzusetzen: Lokal vermitteln sie verschiedene Sphären, während sie auf Clusterebene die rekursive Funktion bestimmter Vermittlung sichtbar machen.","refs":["CH_GB18_AEDL:A7","CH_GB18_AEDS:D5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:CGD-06","text":"Die Trennung objektiver und subjektiver Logik bleibt eine notwendige lokale Gliederung, wird aber clusterweit zu Formen des einen ganzen Begriffs herabgesetzt.","refs":["CH_GB18_AEDL:D2","CH_GB18_AEDL:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_02:GNX-01","text":"Ausgeschlossen ist jede Eintheilung, die ihre Kategorien empirisch, konventionell oder äußerlich übernimmt.","refs":["CH_GB18_AEDL:NX1","CH_GB18_AEDS:NX8"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:GNX-02","text":"Ausgeschlossen ist eine wissenschaftliche Autorisierung, die der Wissenschaft als Erkenntnisprüfung oder neutraler Außenstandpunkt vorausgehen soll.","refs":["CH_GB18_WMDA:NX5","CH_GB18_WMDA:SNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:GNX-03","text":"Ausgeschlossen ist ein inhaltlich bestimmter oder konkreter Anfang, weil er die erst zu erzeugende Vermittlung bereits voraussetzt.","refs":["CH_GB18_WMDA:NX8","CH_GB18_AEDS:SNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:GNX-04","text":"Ausgeschlossen ist eine Vielheit isolierter Kategorien, die ohne immanente Übergänge nebeneinandersteht.","refs":["CH_GB18_AEDL:NX2","CH_GB18_AEDS:SNX1"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:GNX-05","text":"Ausgeschlossen sind sowohl die exklusive Trennung von Unmittelbarkeit und Vermittlung als auch die Letztgültigkeit des Subjekt-Objekt-Gegensatzes.","refs":["CH_GB18_WMDA:NX1","CH_GB18_WMDA:DNX4"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_02:DBN-01","text":"Damit das System bestehen kann, darf Methode kein selbständiges Werkzeug sein, das auf einen unabhängig gegebenen Inhalt angewandt wird.","refs":["CH_GB18_WMDA:DNX2","CH_GB18_WMDA:A1"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:DBN-02","text":"Lineare Grundlegung muss falsch sein: Der Grund darf nicht endgültig vor dem Begründeten liegen, sondern muss durch den Kreis rückwirkend bestimmt werden.","refs":["CH_GB18_WMDA:DNX6","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:DBN-03","text":"Die Annahme, ein erkennendes Subjekt produziere oder ordne die Kategorien von außen, muss zugunsten der Selbstbewegung des Inhalts entfallen.","refs":["CH_GB18_WMDA:SD5","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:DBN-04","text":"Eine letzte Trennung von ontologischer Bestimmung und begrifflicher Bewegung ist unzulässig, weil sie Realität erneut außerhalb des Begriffs fixieren würde.","refs":["CH_GB18_AEDL:SNX1","CH_GB18_AEDS:SNX3"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_02:BSA-01","text":"Die tiefste nicht verfügbare Möglichkeit ist ein archimedisches Außen, von dem aus das System geordnet werden könnte, ohne selbst in seiner Bewegung zu stehen.","refs":["CH_GB18_WMDA:SNX2","CH_GB18_AEDL:DNX1"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:BSA-02","text":"Nicht verfügbar ist eine vollständig vorweggenommene Garantie des Anfangs oder der Eintheilung vor der vollendeten Totalität.","refs":["CH_GB18_WMDA:SNX3","CH_GB18_AEDL:SNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:BSA-03","text":"Unzulässig bleibt ein irreduzibel fremdes Substrat oder Anderes, das der begrifflichen Bewegung dauerhaft entzogen wäre.","refs":["CH_GB18_WMDA:SNX4","CH_GB18_AEDL:DNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:BSA-04","text":"Die verborgene Gegenmöglichkeit ist eine starre Identität von Seyn und Bestimmung, die weder qualitative Beschränkung noch quantitative Aufhebung noch maßhafte Vermittlung zulässt.","refs":["CH_GB18_AEDS:SNX4","CH_GB18_AEDS:SD4"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_02:XD-01","text":"Sobald im reinen Wissen der Gegensatz von Wissen und Gegenstand aufgehoben ist, verliert Wissen seine relationale Form und geht als einfache Unmittelbarkeit in reines Seyn über.","refs":["CL_GB18_02:GA-03","CL_GB18_02:GA-05","CH_GB18_WMDA:A6","CH_GB18_WMDA:A7","CH_GB18_WMDA:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-02","text":"Das unbestimmte reine Seyn bleibt keine Leere, sondern erzeugt durch immanente Selbstdetermination die Qualität als erste unmittelbare Bestimmtheit.","refs":["CL_GB18_02:GA-05","CL_GB18_02:GA-08","CL_GB18_02:GA-09","CH_GB18_WMDA:A12","CH_GB18_AEDS:A7","CH_GB18_AEDS:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-03","text":"Die Vorläufigkeit von Anfang und Eintheilung ist kein bloßer Mangel, sondern eine strukturelle Antizipation, deren Wahrheit erst die vollzogene Bewegung ausweist.","refs":["CL_GB18_02:GA-06","CL_GB18_02:GA-10","CH_GB18_AEDL:SD5","CH_GB18_AEDS:AS3","CH_GB18_WMDA:A15"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-04","text":"Voraussetzungslosigkeit bezeichnet keine Abwesenheit systemischer Vermittlung, sondern die lokale Funktion eines Anfangs, dessen vermittelter und abstrahierender Zugang auf denselben Minimalgehalt konvergieren.","refs":["CL_GB18_02:GA-03","CL_GB18_02:GA-04","CL_GB18_02:GA-05","CH_GB18_WMDA:D4","CH_GB18_WMDA:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-05","text":"Vermittlung ist ein skalenrekursiver Operator: Als Wesen vermittelt sie Seyn und Begriff, als Maaß vermittelt sie Qualität und Quantität.","refs":["CL_GB18_02:GA-04","CL_GB18_02:GA-07","CH_GB18_AEDL:A7","CH_GB18_AEDS:D5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-06","text":"Mit der Einheit von Methode und Inhalt geht die generative Handlungsmacht vom äußeren Subjekt auf die Eigenbewegung der Sache über.","refs":["CL_GB18_02:GA-01","CL_GB18_02:GA-02","CH_GB18_WMDA:SD5","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-07","text":"Äußere Gegensätze werden nicht vernichtet, sondern zu internen Übergangsformen des Begriffs herabgesetzt.","refs":["CL_GB18_02:GA-01","CL_GB18_02:GA-11","CH_GB18_AEDL:AS4","CH_GB18_AEDS:ME3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_02:BSD-01","text":"Realität erhält die Form einer sich selbst artikulierenden Begriffsbewegung, in der Seyn nicht außerhalb des Denkens liegt, sondern sich als dessen notwendiger Inhalt bestimmt.","refs":["CH_GB18_AEDL:SD3","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:BSD-02","text":"Logische Kausalität ist rückwirkend: Der Anfang trägt die Entwicklung, während das Resultat den Anfang als seinen eigenen Grund bestimmt.","refs":["CH_GB18_WMDA:SD2","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:BSD-03","text":"Epistemische Geltung wird von vorgängiger Gewissheit auf immanente Notwendigkeit und nachträgliche systemische Bewährung umgestellt.","refs":["CH_GB18_WMDA:A16","CH_GB18_WMDA:A15"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:BSD-04","text":"Das Subjekt wird von einem äußeren Produzenten zu einem vorübergehenden Träger einer Bewegung herabgesetzt, deren Unterschiede im Inhalt selbst entstehen.","refs":["CH_GB18_WMDA:SD5","CH_GB18_AEDL:A4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:BSD-05","text":"Negation ist produktiv: Die Entfernung von Grund, Unterschied und Inhalt erzeugt den Minimalanfang, dessen Eigenbewegung anschließend neue Bestimmtheit hervorbringt.","refs":["CH_GB18_WMDA:AS6","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:BSD-06","text":"Dieselbe generative Form operiert auf mehreren Maßstäben, indem der Begriff sich in Seyn, Wesen und Begriff und das Seyn sich in Qualität, Quantität und Maaß gliedert.","refs":["CH_GB18_AEDL:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_02:RLE-01","text":"Die zentrale Schleife führt vom vermittelten reinen Wissen über reine Unmittelbarkeit und reines Seyn zur Selbstdetermination und von dort zur rückwirkenden Erkenntnis des Anfangs.","refs":["CH_GB18_WMDA:A5","CH_GB18_WMDA:A8","CH_GB18_WMDA:A15"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RLE-02","text":"Die Eintheilungsschleife verläuft von vorläufiger Setzung über immanente Entwicklung zu nachträglicher Rechtfertigung und verwandelt Antizipation in notwendige Ordnung.","refs":["CH_GB18_AEDL:AS1","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RLE-03","text":"Der Eskalationspfad entfernt zunächst Grund, Unterschied und Inhalt, fixiert reines Seyn und entfaltet daraus Qualität, Quantität und Maaß.","refs":["CH_GB18_WMDA:AS6","CH_GB18_WMDA:A8","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RLE-04","text":"Der begriffliche Attraktor ist die konkrete Einheit von Seyn und Begriff, in der alle selbständig erscheinenden Gegensätze zu Formen des Ganzen werden.","refs":["CH_GB18_AEDL:AS3","CH_GB18_AEDL:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RLE-05","text":"Vermittlung verläuft spiralförmig: Sie erscheint zuerst als aufgehobene Alternative des Anfangs, dann als Wesen und schließlich als bestimmte Relation des Maaßes.","refs":["CH_GB18_WMDA:A2","CH_GB18_AEDL:A7","CH_GB18_AEDS:D5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RLE-06","text":"Das Maaß markiert einen Phasenwechsel, weil die dritte Bestimmung die abstrakte Unmittelbarkeit nicht wiederherstellt, sondern zu einer einzelnen Bestimmtheit innerhalb einer entwickelten Sphäre herabsetzt.","refs":["CH_GB18_AEDS:AS5","CH_GB18_AEDS:FGS8"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_02:FGS-B01","text":"Ausschluss äußerer Klassifikation und vorgängiger Erkenntnisprüfung → Einheit von Methode und Inhalt.","refs":["CH_GB18_AEDL:NX1","CH_GB18_WMDA:NX5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B02","text":"Phänomenologisch vermitteltes reines Wissen → Aufhebung des Subjekt-Objekt-Gegensatzes → einfache Unmittelbarkeit.","refs":["CH_GB18_WMDA:AS5","CH_GB18_WMDA:A7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B03","text":"Voraussetzungsloser Abstraktionsvollzug → Entfernung jeder Bestimmtheit → reines Seyn als Minimalanfang.","refs":["CH_GB18_WMDA:AS6","CH_GB18_WMDA:A8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B04","text":"Reines Seyn → immanente Selbstdetermination → Qualität als unmittelbare Bestimmtheit → Quantität als aufgehobene Bestimmtheit → Maaß als bestimmte Vermittlung.","refs":["CH_GB18_WMDA:A12","CH_GB18_AEDS:A7","CH_GB18_AEDS:A8","CH_GB18_AEDS:A13"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B05","text":"Binnengliederung des Seyns → Einordnung des Seyns als erste Sphäre → Übergang über das Wesen zum freien Begriff.","refs":["CH_GB18_AEDS:A5","CH_GB18_AEDL:AS5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B06","text":"Immanente Entwicklung → rückwirkende Rechtfertigung des Anfangs und der Eintheilung → Kreis von Erstem und Letztem.","refs":["CH_GB18_AEDS:AS3","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B07","text":"Kreisförmige Schließung → Absorption äußerer Kriterien, Substrate und Gegensätze in funktionale Momente des ganzen Begriffs.","refs":["CH_GB18_WMDA:SD6","CH_GB18_AEDL:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_02:AFM-B01","text":"Bewußtseinsgegensatz → reines Wissen → einfache Unmittelbarkeit → reines Seyn → Qualität → Quantität → Maaß.","refs":["CH_GB18_WMDA:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AFM-B02","text":"Äußere Begründung → apophatische Entfernung von Voraussetzungen → Minimalanfang → immanente Erzeugung von Bestimmtheit.","refs":["CH_GB18_WMDA:AS6","CH_GB18_WMDA:NX13"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AFM-B03","text":"Vorläufige Gliederung → Selbstbewegung des Inhalts → erzeugte Übergänge → Rückgang in den Grund → rückwirkend gerechtfertigte Kreisordnung.","refs":["CH_GB18_WMDA:A13","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_02:MME-01","text":"Eintheilung wird von taxonomischer Anordnung zu genetischer Selbstartikulation umkartiert.","refs":["CH_GB18_AEDS:ME1","CH_GB18_AEDL:AS2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MME-02","text":"Anfang wird nicht mehr als reiches Prinzip, sondern als Konvergenzpunkt vermittelter und voraussetzungslos abstrahierender Zugänge bestimmt.","refs":["CH_GB18_WMDA:SD1","CH_GB18_WMDA:AS7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MME-03","text":"Unmittelbarkeit und Vermittlung verlieren den Status konkurrierender Anfangstypen und werden zu skalierbaren Funktionen einer einzigen Bewegung.","refs":["CH_GB18_WMDA:ME2","CH_GB18_WMDA:A2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MME-04","text":"Qualität und Quantität werden asymmetrisch geordnet: Qualität ist ursprüngliche Einheit von Bestimmung und Seyn, Quantität deren negative Aufhebung.","refs":["CH_GB18_AEDS:SD2","CH_GB18_AEDS:D2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MME-05","text":"Maaß wird von allgemeiner Relation zu einer spezifischen Vermittlungsform zwischen qualitativer Identität und quantitativer Gleichgültigkeit reklassifiziert.","refs":["CH_GB18_AEDS:ME4","CH_GB18_AEDS:NX5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MME-06","text":"Fortschritt wird von linearer Ableitung zu rekursiver Selbstdetermination umgezeichnet, in der das Ende den Anfang begründet.","refs":["CH_GB18_WMDA:SD2","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_02:ALT-B01","text":"Auf der Oberflächenebene werden der Anfang der Logik, ihre Dreiteilung und die Folge Qualität–Quantität–Maaß bestimmt.","refs":["CH_GB18_WMDA:ALT1","CH_GB18_AEDS:ALT1"],"deep_refs":[],"trace_type":"Direct","passages":[]},{"id":"CL_GB18_02:ALT-B02","text":"Auf der strukturellen Ebene erzeugen Ausschlussfilter, immanente Übergänge und rückwirkende Rechtfertigung eine verschachtelte Ordnung von Begriffssphären.","refs":["CH_GB18_WMDA:ALT2","CH_GB18_AEDS:ALT2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:ALT-B03","text":"Auf der metastrategischen Ebene wird die Wahl fertiger Prinzipien und Kategorien durch die Prüfung ihrer immanenten Erzeugbarkeit ersetzt.","refs":["CH_GB18_WMDA:ALT3","CH_GB18_AEDS:ALT3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:ALT-B04","text":"Auf der ontologisch-temporalen Ebene ist Realität Selbstvermittlung, deren gerichtete Entwicklung kreisförmig auf ihren Anfang zurückwirkt.","refs":["CH_GB18_WMDA:ALT4","CH_GB18_AEDS:ALT4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:ALT-B05","text":"Auf der methodologisch-performativen Ebene vollzieht die Darstellung ihre These, indem sie vorläufig setzt, negiert, entwickelt und erst rückwirkend rechtfertigt.","refs":["CH_GB18_WMDA:MRT6","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_02:FL-01","text":"Die Voraussetzungslosigkeit der Logik bleibt mit ihrer systematischen Genese aus der Phänomenologie gespannt; vermittelt erzeugtes Wissen soll zugleich den voraussetzungslosen Anfang liefern.","refs":["CH_GB18_WMDA:MRT4","CH_GB18_WMDA:A5"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:FL-02","text":"Die Benennung des völlig Unbestimmten als Seyn und sein Übergang in weitere Bestimmungen bleiben gegenüber der behaupteten Selbstdetermination unterbestimmt.","refs":["CH_GB18_WMDA:MRT3"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:FL-03","text":"Die rückwirkende Rechtfertigung droht zirkulär zu werden, weil ihre lokale Geltung vom Erfolg einer noch ausstehenden Totalität abhängt.","refs":["CH_GB18_WMDA:MRT8","CH_GB18_AEDL:MRT5"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:FL-04","text":"Maaß ist zugleich dritte Bestimmung des Seyns und Rückführung abstrakter Unmittelbarkeit in die Qualität; seine systematische Höhe und lokale Einordnung fallen nicht restlos zusammen.","refs":["CH_GB18_AEDS:MRT6"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MP-01","text":"Reines Wissen mutiert in dem Augenblick, in dem die aufgehobene Differenz es als Wissen funktionslos und zur einfachen Unmittelbarkeit werden lässt.","refs":["CH_GB18_WMDA:A7"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MP-02","text":"Reines Seyn mutiert vom bestimmungslosen Anfang zur Quelle der Qualität, sobald Selbstdetermination als immanenter Fortgang einsetzt.","refs":["CH_GB18_WMDA:A12","CH_GB18_AEDS:A7"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MP-03","text":"Qualität mutiert zur Quantität, indem ihre unmittelbare Einheit mit dem Seyn negiert und Bestimmtheit gegen das Seyn gleichgültig wird.","refs":["CH_GB18_AEDS:D2","CH_GB18_AEDS:A11"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MP-04","text":"Quantität mutiert im Maaß zur bestimmten Relation mit Qualität, wodurch Gleichgültigkeit begrenzt und qualitative Relevanz wiederhergestellt wird.","refs":["CH_GB18_AEDS:D5","CH_GB18_AEDS:A13"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_02:HSI-01","text":"Die Realität erscheint als kreisförmige Selbstgliederungsmaschine, die Unterschiede erzeugt, vermittelt und als Momente ihrer Einheit zurücknimmt.","refs":["CH_GB18_AEDL:A5","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:HSI-02","text":"Das Subjekt ist kein souveräner Ursprung, sondern eine vorübergehende Station, durch deren Aufhebung die Handlungsmacht auf den Inhalt übergeht.","refs":["CH_GB18_WMDA:SD5","CH_GB18_WMDA:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:HSI-03","text":"Die vorausgesetzte Zeit ist weder bloß linear noch bloß zyklisch, sondern eine gerichtete Rückwirkung, in der das Ende den Anfang als Grund rekonstituiert.","refs":["CH_GB18_WMDA:A13","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:HSI-04","text":"Navigation bleibt nur als immanentes Folgen erzeugter Übergänge möglich; Flucht in äußere Kriterien, Substrate oder unmittelbare Gewissheit ist gesperrt.","refs":["CH_GB18_WMDA:A16","CH_GB18_WMDA:DNX1"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_02:MRT-B01","text":"Die extrahierten Axiome reichen aus, um den Cluster als Übergang vom reinen Wissen über den Minimalanfang zur immanenten Gliederung des Seyns zu rekonstruieren.","refs":["CH_GB18_WMDA:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MRT-B02","text":"Die Architektur ist am stärksten in der Konvergenz der beiden Anfangswege und in der gemeinsamen rückwirkenden Rechtfertigung von Anfang und Eintheilung.","refs":["CH_GB18_WMDA:SD1","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MRT-B03","text":"Der Cluster bleibt kohärent, sofern Unmittelbarkeit und Vermittlung als Funktionsweisen verschiedener systematischer Positionen und nicht als ausschließende Eigenschaften behandelt werden.","refs":["CH_GB18_WMDA:A2","CH_GB18_WMDA:D4"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MRT-B04","text":"Unterbestimmt bleiben die konkrete Benennung des reinen Seyns und die Übergänge von der ersten zur zweiten und von der zweiten zur dritten Bestimmung.","refs":["CH_GB18_WMDA:MRT3","CH_GB18_AEDS:MRT2"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MRT-B05","text":"Die Rekonstruktion hängt notwendig von Vorläufigkeit, rekursiver Rückkehr, apophatischer Kompression und der erfolgreichen Vollendung des Systems ab.","refs":["CH_GB18_AEDL:AS1","CH_GB18_WMDA:MRT8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MRT-B06","text":"Einer vollständigen axiomatischen Reduktion widersteht der Entschluss, Denken als solches zu betrachten, weil er zwischen zugestandener Setzung und behaupteter sachlicher Notwendigkeit verbleibt.","refs":["CH_GB18_WMDA:MRT5"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120430467830Z_aef9d801","language_code":"en","language_name":"English","title":"Chapters 04–06","source_sha256":"14205210d90e1d7ec79471a3d56d45f683f2a7a9817fce018cd3a7819fdfff05","sha256":"0b1510e6c36f79b83e06b35ce5d32c7e045d086969c38b7637cbd05084e7ef7d","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:04:30.469791+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_02:AS-01","text":"The system must reconcile a presuppositionless beginning with an already mediated science and its initially only provisional division.","refs":["CH_GB18_WMDA:AS1","CH_GB18_AEDL:AS1"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-02","text":"Scientific order is valid only when objective content, method, and division arise from the same self-determination.","refs":["CH_GB18_WMDA:AS2","CH_GB18_AEDL:AS2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-03","text":"Pure knowing, as the unity of Being (Seyn) and Concept (Begriff), reduces itself, after the sublation of its differences, to simple immediacy, from which the determinations of Being (Seyn) emerge.","refs":["CH_GB18_AEDL:A3","CH_GB18_WMDA:A7","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-04","text":"The argument proceeds reconstructively and apophatically: it removes external grounds until only the self-movement of the content remains as the source of necessity.","refs":["CH_GB18_WMDA:AS3","CH_GB18_WMDA:A16"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-05","text":"The directed movement leads from mediated pure knowing through pure Being (Seyn) to quality, quantity, and measure (Maaß).","refs":["CH_GB18_WMDA:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-06","text":"The unfolding of Being (Seyn), Essence (Wesen), and Concept (Begriff), as well as the internal development of quality, quantity, and measure (Maaß), are nested enactments of the same self-division.","refs":["CH_GB18_AEDL:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-07","text":"The movement is directed but recursive: the progression returns into its ground and retroactively confers truth upon what was initially provisional.","refs":["CH_GB18_WMDA:A13","CH_GB18_AEDL:SD5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AS-08","text":"The closure consists in a circle in which beginning, development, and division ground one another without being authorized by an external standpoint.","refs":["CH_GB18_WMDA:A14","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_02:GA-01","text":"[Attractor] Conceptual determinations have their origin solely in the self-differentiation and self-movement of their content.","refs":["CH_GB18_AEDL:A2","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-02","text":"[Persistent] Scientific truth requires that method, content, beginning, and division do not fall apart.","refs":["CH_GB18_WMDA:A1","CH_GB18_WMDA:AS2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-03","text":"[Mutating] Pure knowing is initially the concrete unity of Being (Seyn) and Concept (Begriff) and becomes simple immediacy through the sublation of its differences.","refs":["CH_GB18_AEDL:A3","CH_GB18_WMDA:A7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-04","text":"[Persistent] Immediacy and mediation are not mutually exclusive alternatives, but alternating functions of the same conceptual movement.","refs":["CH_GB18_WMDA:A2","CH_GB18_WMDA:D4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-05","text":"[Terminal] Pure Being (Seyn) is the only permissible logical beginning, because every richer content already presupposes determination and mediation.","refs":["CH_GB18_WMDA:AS7","CH_GB18_WMDA:A8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-06","text":"[Mutating] Division begins as provisional anticipation, but becomes the judgment of the Concept (Begriff) and receives its validity only through the enacted content.","refs":["CH_GB18_AEDL:A1","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-07","text":"[Emergent] The macro-division of Being (Seyn), Essence (Wesen), and Concept (Begriff), and the internal division of Being (Seyn), are recursive instances of the same generative form.","refs":["CH_GB18_AEDL:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-08","text":"[Mutating] Determinacy (Bestimmtheit) is inadmissible as a presupposed beginning, but becomes quality as the first immanent achievement of pure Being (Seyn).","refs":["CH_GB18_WMDA:A11","CH_GB18_AEDS:A7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-09","text":"[Persistent] Quality, quantity, and measure (Maaß) do not form a list of equal rank, but rather the sequence of immediate, sublated, and mediated determinacy (Bestimmtheit).","refs":["CH_GB18_AEDS:A7","CH_GB18_AEDS:A8","CH_GB18_AEDS:A9"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-10","text":"[Attractor] Beginning and division are fully recognized and justified only through the total development.","refs":["CH_GB18_WMDA:A15","CH_GB18_AEDS:D8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:GA-11","text":"[Terminal] An Archimedean outside from which Concept (Begriff), beginning, or categories could be ordered neutrally is excluded.","refs":["CH_GB18_AEDL:DNX1","CH_GB18_WMDA:SNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_02:RMD-01","text":"Pure knowing does not recur identically: as a mediated result, it loses its form of knowing, becomes simple immediacy, and assumes a function of beginning as pure Being (Seyn).","refs":["CH_GB18_WMDA:A5","CH_GB18_WMDA:A7","CH_GB18_WMDA:A8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-02","text":"Mediation mutates from the apparent obstacle to the absolute beginning into the necessary operator of Essence (Wesen) and into the determinate relation of measure (Maaß).","refs":["CH_GB18_WMDA:A2","CH_GB18_AEDL:A7","CH_GB18_AEDS:D5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-03","text":"Being (Seyn) shifts from the moment of unity with the Concept (Begriff), through the indeterminate beginning, to the self-determining sphere of the Concept (Begriff).","refs":["CH_GB18_AEDL:A3","CH_GB18_AEDS:A2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-04","text":"Division recurs functionally as a provisional map, self-judgment of the Concept (Begriff), and retroactively justified order of development.","refs":["CH_GB18_AEDL:A1","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-05","text":"The external opposition of knowing and object is displaced into internal transitions between forms of determinacy (Bestimmtheit).","refs":["CH_GB18_WMDA:A6","CH_GB18_AEDS:ME3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-06","text":"The cognizing subject loses its generative function; this is assumed by the self-moving content.","refs":["CH_GB18_WMDA:SD5","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RMD-07","text":"The critique of Kant shifts from the limitation of categories by the subjective I to the critique of an external sequence of categories and of their inadequate systematic places.","refs":["CH_GB18_AEDL:AS7","CH_GB18_AEDS:NX7"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_02:CGD-01","text":"The concrete triads remain local divisions of their respective spheres; at the cluster level, only the law of their immanent generation scales.","refs":["CH_GB18_AEDL:A12","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:CGD-02","text":"Pure Being (Seyn) scales beyond its local function of beginning because it simultaneously bears the transition to qualitative Being (Seyn) and thus to the first developed sphere.","refs":["CH_GB18_WMDA:AS7","CH_GB18_AEDS:D1"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:CGD-03","text":"The critique of the thing-in-itself, as well as of relation and modality, remains local in its target concepts, but scales as a general exclusion of externally fixed places of categories.","refs":["CH_GB18_AEDL:AS7","CH_GB18_AEDS:NX2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:CGD-04","text":"I, God, and intellectual intuition remain local counter-candidates of the chapter on the beginning; their cluster-wide function consists solely in demonstrating premature concretion.","refs":["CH_GB18_WMDA:NX10","CH_GB18_WMDA:NX12"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:CGD-05","text":"Essence (Wesen) and measure (Maaß) are not to be equated: locally they mediate different spheres, whereas at the cluster level they make visible the recursive function of determinate mediation.","refs":["CH_GB18_AEDL:A7","CH_GB18_AEDS:D5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:CGD-06","text":"The separation of objective and subjective logic remains a necessary local division, but is reduced cluster-wide to forms of the one whole Concept (Begriff).","refs":["CH_GB18_AEDL:D2","CH_GB18_AEDL:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_02:GNX-01","text":"Excluded is every division that adopts its categories empirically, conventionally, or externally.","refs":["CH_GB18_AEDL:NX1","CH_GB18_AEDS:NX8"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:GNX-02","text":"Excluded is a scientific authorization that is supposed to precede science as an examination of cognition or as a neutral external standpoint.","refs":["CH_GB18_WMDA:NX5","CH_GB18_WMDA:SNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:GNX-03","text":"Excluded is a materially determinate or concrete beginning, because it already presupposes the mediation yet to be generated.","refs":["CH_GB18_WMDA:NX8","CH_GB18_AEDS:SNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:GNX-04","text":"Excluded is a multiplicity of isolated categories standing alongside one another without immanent transitions.","refs":["CH_GB18_AEDL:NX2","CH_GB18_AEDS:SNX1"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:GNX-05","text":"Excluded are both the exclusive separation of immediacy and mediation and the ultimate validity of the subject-object opposition.","refs":["CH_GB18_WMDA:NX1","CH_GB18_WMDA:DNX4"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_02:DBN-01","text":"For the system to endure, method must not be an independent tool applied to an independently given content.","refs":["CH_GB18_WMDA:DNX2","CH_GB18_WMDA:A1"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:DBN-02","text":"Linear grounding must be false: the ground must not lie definitively before what is grounded, but must be retroactively determined by the circle.","refs":["CH_GB18_WMDA:DNX6","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:DBN-03","text":"The assumption that a cognizing subject produces or orders the categories from outside must be discarded in favor of the self-movement of the content.","refs":["CH_GB18_WMDA:SD5","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:DBN-04","text":"A final separation of ontological determination and conceptual movement is inadmissible, because it would again fix reality outside the Concept (Begriff).","refs":["CH_GB18_AEDL:SNX1","CH_GB18_AEDS:SNX3"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_02:BSA-01","text":"The deepest unavailable possibility is an Archimedean outside from which the system could be ordered without itself standing within its movement.","refs":["CH_GB18_WMDA:SNX2","CH_GB18_AEDL:DNX1"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:BSA-02","text":"Unavailable is a fully anticipated guarantee of the beginning or of the division prior to the completed totality.","refs":["CH_GB18_WMDA:SNX3","CH_GB18_AEDL:SNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:BSA-03","text":"Inadmissible remains an irreducibly alien substrate or Other that would be permanently withdrawn from conceptual movement.","refs":["CH_GB18_WMDA:SNX4","CH_GB18_AEDL:DNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_02:BSA-04","text":"The hidden counter-possibility is a rigid identity of Being (Seyn) and determination that permits neither qualitative limitation nor quantitative sublation nor measured mediation.","refs":["CH_GB18_AEDS:SNX4","CH_GB18_AEDS:SD4"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_02:XD-01","text":"As soon as the opposition of knowing and object is sublated in pure knowing, knowing loses its relational form and passes over as simple immediacy into pure Being (Seyn).","refs":["CL_GB18_02:GA-03","CL_GB18_02:GA-05","CH_GB18_WMDA:A6","CH_GB18_WMDA:A7","CH_GB18_WMDA:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-02","text":"Indeterminate pure Being (Seyn) remains no emptiness, but generates quality as the first immediate determinacy (Bestimmtheit) through immanent self-determination.","refs":["CL_GB18_02:GA-05","CL_GB18_02:GA-08","CL_GB18_02:GA-09","CH_GB18_WMDA:A12","CH_GB18_AEDS:A7","CH_GB18_AEDS:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-03","text":"The provisionality of beginning and division is not a mere deficiency, but a structural anticipation whose truth is demonstrated only by the enacted movement.","refs":["CL_GB18_02:GA-06","CL_GB18_02:GA-10","CH_GB18_AEDL:SD5","CH_GB18_AEDS:AS3","CH_GB18_WMDA:A15"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-04","text":"Presuppositionlessness does not designate an absence of systemic mediation, but the local function of a beginning whose mediated and abstracting access converge upon the same minimal content.","refs":["CL_GB18_02:GA-03","CL_GB18_02:GA-04","CL_GB18_02:GA-05","CH_GB18_WMDA:D4","CH_GB18_WMDA:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-05","text":"Mediation is a scale-recursive operator: as Essence (Wesen), it mediates Being (Seyn) and Concept (Begriff); as measure (Maaß), it mediates quality and quantity.","refs":["CL_GB18_02:GA-04","CL_GB18_02:GA-07","CH_GB18_AEDL:A7","CH_GB18_AEDS:D5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-06","text":"With the unity of method and content, generative agency passes from the external subject to the self-movement of the matter.","refs":["CL_GB18_02:GA-01","CL_GB18_02:GA-02","CH_GB18_WMDA:SD5","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_02:XD-07","text":"External oppositions are not annihilated, but reduced to internal transitional forms of the Concept (Begriff).","refs":["CL_GB18_02:GA-01","CL_GB18_02:GA-11","CH_GB18_AEDL:AS4","CH_GB18_AEDS:ME3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_02:BSD-01","text":"Reality receives the form of a self-articulating movement of the Concept (Begriff), in which Being (Seyn) does not lie outside thought, but determines itself as its necessary content.","refs":["CH_GB18_AEDL:SD3","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:BSD-02","text":"Logical causality is retroactive: the beginning bears the development, while the result determines the beginning as its own ground.","refs":["CH_GB18_WMDA:SD2","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:BSD-03","text":"Epistemic validity is shifted from prior certainty to immanent necessity and subsequent systemic vindication.","refs":["CH_GB18_WMDA:A16","CH_GB18_WMDA:A15"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:BSD-04","text":"The subject is reduced from an external producer to a temporary bearer of a movement whose differences arise in the content itself.","refs":["CH_GB18_WMDA:SD5","CH_GB18_AEDL:A4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:BSD-05","text":"Negation is productive: the removal of ground, difference, and content generates the minimal beginning, whose self-movement subsequently brings forth new determinacy (Bestimmtheit).","refs":["CH_GB18_WMDA:AS6","CH_GB18_AEDS:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:BSD-06","text":"The same generative form operates at several scales, insofar as the Concept (Begriff) divides itself into Being (Seyn), Essence (Wesen), and Concept (Begriff), and Being (Seyn) into quality, quantity, and measure (Maaß).","refs":["CH_GB18_AEDL:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_02:RLE-01","text":"The central loop leads from mediated pure knowing through pure immediacy and pure Being (Seyn) to self-determination, and thence to the retroactive recognition of the beginning.","refs":["CH_GB18_WMDA:A5","CH_GB18_WMDA:A8","CH_GB18_WMDA:A15"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RLE-02","text":"The division loop proceeds from provisional positing through immanent development to subsequent justification, and transforms anticipation into necessary order.","refs":["CH_GB18_AEDL:AS1","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RLE-03","text":"The escalation path first removes ground, difference, and content, fixes pure Being (Seyn), and unfolds quality, quantity, and measure (Maaß) from it.","refs":["CH_GB18_WMDA:AS6","CH_GB18_WMDA:A8","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RLE-04","text":"The conceptual attractor is the concrete unity of Being (Seyn) and Concept (Begriff), in which all apparently independent oppositions become forms of the whole.","refs":["CH_GB18_AEDL:AS3","CH_GB18_AEDL:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RLE-05","text":"Mediation proceeds spirally: it first appears as the sublated alternative of the beginning, then as Essence (Wesen), and finally as the determinate relation of measure (Maaß).","refs":["CH_GB18_WMDA:A2","CH_GB18_AEDL:A7","CH_GB18_AEDS:D5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:RLE-06","text":"Measure (Maaß) marks a phase transition because the third determination does not restore abstract immediacy, but reduces it to an individual determinacy (Bestimmtheit) within a developed sphere.","refs":["CH_GB18_AEDS:AS5","CH_GB18_AEDS:FGS8"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_02:FGS-B01","text":"Exclusion of external classification and prior examination of cognition → unity of method and content.","refs":["CH_GB18_AEDL:NX1","CH_GB18_WMDA:NX5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B02","text":"Phenomenologically mediated pure knowing → sublation of the subject-object opposition → simple immediacy.","refs":["CH_GB18_WMDA:AS5","CH_GB18_WMDA:A7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B03","text":"Presuppositionless act of abstraction → removal of every determinacy (Bestimmtheit) → pure Being (Seyn) as minimal beginning.","refs":["CH_GB18_WMDA:AS6","CH_GB18_WMDA:A8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B04","text":"Pure Being (Seyn) → immanent self-determination → quality as immediate determinacy (Bestimmtheit) → quantity as sublated determinacy (Bestimmtheit) → measure (Maaß) as determinate mediation.","refs":["CH_GB18_WMDA:A12","CH_GB18_AEDS:A7","CH_GB18_AEDS:A8","CH_GB18_AEDS:A13"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B05","text":"Internal division of Being (Seyn) → placement of Being (Seyn) as the first sphere → transition through Essence (Wesen) to the free Concept (Begriff).","refs":["CH_GB18_AEDS:A5","CH_GB18_AEDL:AS5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B06","text":"Immanent development → retroactive justification of the beginning and the division → circle of first and last.","refs":["CH_GB18_AEDS:AS3","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:FGS-B07","text":"Circular closure → absorption of external criteria, substrates, and oppositions into functional moments of the whole Concept (Begriff).","refs":["CH_GB18_WMDA:SD6","CH_GB18_AEDL:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_02:AFM-B01","text":"Opposition of consciousness → pure knowing → simple immediacy → pure Being (Seyn) → quality → quantity → measure (Maaß).","refs":["CH_GB18_WMDA:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AFM-B02","text":"External grounding → apophatic removal of presuppositions → minimal beginning → immanent generation of determinacy (Bestimmtheit).","refs":["CH_GB18_WMDA:AS6","CH_GB18_WMDA:NX13"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:AFM-B03","text":"Provisional division → self-movement of the content → generated transitions → return into the ground → retroactively justified circular order.","refs":["CH_GB18_WMDA:A13","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_02:MME-01","text":"Division is remapped from taxonomic arrangement to genetic self-articulation.","refs":["CH_GB18_AEDS:ME1","CH_GB18_AEDL:AS2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MME-02","text":"Beginning is no longer determined as a rich principle, but as the convergence point of mediated and presuppositionlessly abstracting approaches.","refs":["CH_GB18_WMDA:SD1","CH_GB18_WMDA:AS7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MME-03","text":"Immediacy and mediation lose the status of competing types of beginning and become scalable functions of a single movement.","refs":["CH_GB18_WMDA:ME2","CH_GB18_WMDA:A2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MME-04","text":"Quality and quantity are ordered asymmetrically: quality is the original unity of determination and Being (Seyn), quantity its negative sublation.","refs":["CH_GB18_AEDS:SD2","CH_GB18_AEDS:D2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MME-05","text":"Measure (Maaß) is reclassified from general relation to a specific form of mediation between qualitative identity and quantitative indifference.","refs":["CH_GB18_AEDS:ME4","CH_GB18_AEDS:NX5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MME-06","text":"Progress is redrawn from linear derivation to recursive self-determination, in which the end grounds the beginning.","refs":["CH_GB18_WMDA:SD2","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_02:ALT-B01","text":"At the surface level, the beginning of logic, its triadic division, and the sequence quality–quantity–measure (Maaß) are determined.","refs":["CH_GB18_WMDA:ALT1","CH_GB18_AEDS:ALT1"],"deep_refs":[],"trace_type":"Direct","passages":[]},{"id":"CL_GB18_02:ALT-B02","text":"At the structural level, exclusion filters, immanent transitions, and retroactive justification generate a nested order of Concept (Begriff)-spheres.","refs":["CH_GB18_WMDA:ALT2","CH_GB18_AEDS:ALT2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:ALT-B03","text":"At the metastrategic level, the selection of ready-made principles and categories is replaced by examination of their immanent generability.","refs":["CH_GB18_WMDA:ALT3","CH_GB18_AEDS:ALT3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:ALT-B04","text":"At the ontological-temporal level, reality is self-mediation, whose directed development acts retroactively and circularly upon its beginning.","refs":["CH_GB18_WMDA:ALT4","CH_GB18_AEDS:ALT4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:ALT-B05","text":"At the methodological-performative level, the exposition enacts its thesis by provisionally positing, negating, developing, and justifying only retroactively.","refs":["CH_GB18_WMDA:MRT6","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_02:FL-01","text":"The presuppositionlessness of logic remains in tension with its systematic genesis from phenomenology; mediately generated knowing is nevertheless supposed to supply the presuppositionless beginning.","refs":["CH_GB18_WMDA:MRT4","CH_GB18_WMDA:A5"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:FL-02","text":"The designation of the wholly indeterminate as Being (Seyn), and its transition into further determinations, remain underdetermined in relation to the asserted self-determination.","refs":["CH_GB18_WMDA:MRT3"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:FL-03","text":"Retroactive justification threatens to become circular, because its local validity depends on the success of a totality still outstanding.","refs":["CH_GB18_WMDA:MRT8","CH_GB18_AEDL:MRT5"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:FL-04","text":"Measure (Maaß) is at once the third determination of Being (Seyn) and the return of abstract immediacy into quality; its systematic altitude and local placement do not completely coincide.","refs":["CH_GB18_AEDS:MRT6"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MP-01","text":"Pure knowing mutates at the moment when the sublated difference renders it functionless as knowing and allows it to become simple immediacy.","refs":["CH_GB18_WMDA:A7"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MP-02","text":"Pure Being (Seyn) mutates from the determinationless beginning into the source of quality as soon as self-determination commences as immanent progression.","refs":["CH_GB18_WMDA:A12","CH_GB18_AEDS:A7"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MP-03","text":"Quality mutates into quantity by having its immediate unity with Being (Seyn) negated, and determinacy (Bestimmtheit) becomes indifferent to Being (Seyn).","refs":["CH_GB18_AEDS:D2","CH_GB18_AEDS:A11"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MP-04","text":"Quantity mutates in measure (Maaß) into determinate relation with quality, whereby indifference is limited and qualitative relevance restored.","refs":["CH_GB18_AEDS:D5","CH_GB18_AEDS:A13"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_02:HSI-01","text":"Reality appears as a circular machine of self-division that generates differences, mediates them, and takes them back as moments of its unity.","refs":["CH_GB18_AEDL:A5","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:HSI-02","text":"The subject is not a sovereign origin, but a temporary station through whose sublation agency passes over to the content.","refs":["CH_GB18_WMDA:SD5","CH_GB18_WMDA:A6"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:HSI-03","text":"The presupposed time is neither merely linear nor merely cyclical, but a directed retroaction in which the end reconstitutes the beginning as ground.","refs":["CH_GB18_WMDA:A13","CH_GB18_WMDA:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:HSI-04","text":"Navigation remains possible only as immanent following of generated transitions; escape into external criteria, substrates, or immediate certainty is barred.","refs":["CH_GB18_WMDA:A16","CH_GB18_WMDA:DNX1"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_02:MRT-B01","text":"The extracted axioms suffice to reconstruct the cluster as a transition from pure knowing, through the minimal beginning, to the immanent division of Being (Seyn).","refs":["CH_GB18_WMDA:AS5","CH_GB18_AEDS:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MRT-B02","text":"The architecture is strongest in the convergence of the two paths of beginning and in the shared retroactive justification of beginning and division.","refs":["CH_GB18_WMDA:SD1","CH_GB18_AEDS:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MRT-B03","text":"The cluster remains coherent provided that immediacy and mediation are treated as modes of functioning of different systematic positions, rather than as exclusive properties.","refs":["CH_GB18_WMDA:A2","CH_GB18_WMDA:D4"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MRT-B04","text":"The concrete designation of pure Being (Seyn), and the transitions from the first to the second and from the second to the third determination, remain underdetermined.","refs":["CH_GB18_WMDA:MRT3","CH_GB18_AEDS:MRT2"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_02:MRT-B05","text":"The reconstruction necessarily depends on provisionality, recursive return, apophatic compression, and the successful completion of the system.","refs":["CH_GB18_AEDL:AS1","CH_GB18_WMDA:MRT8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_02:MRT-B06","text":"A complete axiomatic reduction is resisted by the decision to consider thinking as such, because it remains between conceded positing and asserted objective necessity.","refs":["CH_GB18_WMDA:MRT5"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_02@R001","source_variant_id":"canonical:CL_GB18_02:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 04–06","context":"Allgemeine Eintheilung der Logik · Womit muß der Anfang der Wissenschaft gemacht werden? · Allgemeine Eintheilung des Seyns"},"title_language_code":"en"},{"id":"CL_GB18_03","layer":"CL","title":"Chapters 07–09","order":3,"parents":["CH_GB18_EABQ","CH_GB18_SEYN","CH_GB18_BNIC"],"revision":"CL_GB18_03@R001","sha256":"0e87efcb2c26076898e69300e9e1560fd1c6238dd10ac9ea9f17fb0550854044","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_03:SP-01","text":"Das System löst das Problem, wie aus völlig unbestimmtem Seyn überhaupt eine tragfähige Bestimmung entstehen kann, ohne einen äußeren Inhalt vorauszusetzen.","refs":["CH_GB18_SEYN:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:SP-02","text":"Es bestimmt Unmittelbarkeit zunächst apophatisch als Ausschluss jeder Differenz und zeigt dadurch, dass reine Positivität in Leere und reines Nichts umschlägt.","refs":["CH_GB18_SEYN:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:SP-03","text":"Die so erzeugte Identität von Seyn und Nichts bleibt jedoch instabil, weil bereits die Bestimmung ihrer Bestimmungslosigkeit eine relationale Operation voraussetzt.","refs":["CH_GB18_SEYN:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:SP-04","text":"Die Argumentbewegung verläuft daher von leerer Unmittelbarkeit über Gegensatz, Qualität, Daseyn und Endlichkeit zur Selbstbeziehung des Seyns; sie ist rekursiv-negativ, kumulativ und auf eine höhere Seinsform gerichtet.","refs":["CH_GB18_EABQ:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_03:GA-01","text":"[Persistent] Der Anfang ist reine, unbestimmte Unmittelbarkeit ohne vorausgesetzten Inhalt.","refs":["CH_GB18_EABQ:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-02","text":"[Persistent] Jede positive Bestimmung setzt Differenz voraus und zerstört dadurch die behauptete Reinheit unmittelbaren Seyns.","refs":["CH_GB18_SEYN:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-03","text":"[Emergent] Der Ausschluss jeder Differenz erzeugt die strukturelle Gleichrangigkeit von reinem Seyn und reinem Nichts.","refs":["CH_GB18_SEYN:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-04","text":"[Mutating] Differenz erscheint zunächst als verbotener Inhalt, kehrt dann als relationale beziehungsweise intentionale Tätigkeit zurück.","refs":["CH_GB18_BNIC:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-05","text":"[Emergent] Unbestimmtheit wird durch ihren Gegensatz nicht aufgehoben, sondern in eine eigene relationale Qualität verwandelt.","refs":["CH_GB18_EABQ:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-06","text":"[Emergent] Die gewonnene Qualität konkretisiert sich als bestimmtes Seyn und damit als Daseyn.","refs":["CH_GB18_EABQ:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-07","text":"[Terminal] Als Daseyn ist Bestimmtheit endlich und enthält die Notwendigkeit ihrer eigenen Aufhebung.","refs":["CH_GB18_EABQ:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-08","text":"[Attractor] Die Aufhebung der Endlichkeit zielt auf eine unendliche Beziehung des Seyns auf sich selbst.","refs":["CH_GB18_EABQ:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-09","text":"[Mutating] Negation bedeutet nicht Vernichtung, sondern die Erzeugung einer höheren Bestimmungsform.","refs":["CH_GB18_EABQ:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-10","text":"[Terminal] Fürsichseyn bezeichnet die vorläufige Schließung der Bewegung als Selbstbeziehung statt bloßer Unmittelbarkeit.","refs":["CH_GB18_EABQ:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_03:RMD-01","text":"Reines Seyn und reines Nichts wiederholen dieselbe Funktion der Inhaltslosigkeit, obwohl sie zunächst als getrennte Anfangsbestimmungen auftreten.","refs":["CH_GB18_SEYN:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-02","text":"Unbestimmtheit mutiert von einem Ausschluss jeder Bestimmung zu einer relationalen Qualität, sobald sie gegen Bestimmtheit gestellt wird.","refs":["CH_GB18_EABQ:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-03","text":"Differenz verschiebt sich vom ausgeschlossenen ontologischen Inhalt in die Form des Anschauens und Denkens.","refs":["CH_GB18_BNIC:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-04","text":"Die Differenz zwischen etwas und nichts wird dadurch von einer positiven ontologischen Trennung in eine Differenz der Bezugnahme umcodiert.","refs":["CH_GB18_BNIC:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-05","text":"Daseyn übernimmt die Funktion der vermittelnden Bestimmtheit und wird als endliche Übergangsform absorbiert.","refs":["CH_GB18_EABQ:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-06","text":"Sein und Nichts verlieren ihre isolierte Gegenstellung, nachdem sie die gemeinsame Struktur der Bestimmungslosigkeit freigelegt haben.","refs":["CH_GB18_BNIC:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-07","text":"Endlichkeit verschwindet nicht einfach, sondern wird als notwendige Durchgangsform in Selbstbeziehung transformiert.","refs":["CH_GB18_EABQ:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_03:CGD-01","text":"Lokal bleibt die Beschreibung reinen Seyns als leerer, ununterschiedener Anfang; auf Cluster-Ebene wird daraus die allgemeine Regel, dass Reinheit nur durch Ausschluss und Übergang bestimmt werden kann.","refs":["CH_GB18_SEYN:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:CGD-02","text":"Lokal bleibt das Nichts eine leere Tätigkeit des Denkens oder Anschauens; auf Cluster-Ebene wird diese Tätigkeit zum Modell dafür, wie Differenz ohne positiven Inhalt entstehen kann.","refs":["CH_GB18_BNIC:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:CGD-03","text":"Die lokale Gleichsetzung von Seyn und Nichts skaliert nach oben, weil sie die gemeinsame Ausgangslage für die spätere Erzeugung bestimmter Qualität bildet.","refs":["CH_GB18_BNIC:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:CGD-04","text":"Die lokale Ableitung des Fürsichseyns ist auf dieser Ebene nicht mehr bloße Kapitelkonklusion, sondern der Attraktor, auf den die gesamte Negationsbewegung zuläuft.","refs":["CH_GB18_EABQ:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_03:GNX-01","text":"Ausgeschlossen wird ein Seyn, das ohne Gegensatz, Relation oder Vermittlung als positiv bestimmbarer Inhalt bestehen könnte.","refs":["CH_GB18_EABQ:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GNX-02","text":"Ausgeschlossen wird ein Nichts, das als eigenständige positive Realität neben dem Seyn fixiert werden könnte.","refs":["CH_GB18_BNIC:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GNX-03","text":"Ausgeschlossen wird eine Endlichkeit, die sich als letzte und selbständige Form der Bestimmung erhalten könnte.","refs":["CH_GB18_EABQ:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GNX-04","text":"Ausgeschlossen wird eine Unendlichkeit, die lediglich grenzenlose Ausdehnung statt Selbstbeziehung bezeichnet.","refs":["CH_GB18_EABQ:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GNX-05","text":"Die wiederholte Negation statischer Identitäten erzeugt eine positive Architektur gestufter Übergänge.","refs":["CH_GB18_EABQ:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_03:DBN-01","text":"Das System kann nicht bestehen, wenn Unbestimmtheit als isolierte, relationslose Leere verstanden wird; sie muss durch Gegensatz bestimmbar werden.","refs":["CH_GB18_EABQ:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:DBN-02","text":"Es muss ausgeschlossen werden, dass Anschauen und Denken dem Nichts einen positiven Inhalt verleihen; sonst würde die gemeinsame Bestimmungslosigkeit von Seyn und Nichts zerfallen.","refs":["CH_GB18_BNIC:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:DBN-03","text":"Es muss ausgeschlossen werden, dass Aufhebung bloße Vernichtung bedeutet, weil nur ihre Umcodierung als Übergang die Entwicklung zur Selbstbeziehung ermöglicht.","refs":["CH_GB18_EABQ:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:DBN-04","text":"Das konkurrierende Modell einer statischen Ontologie wird über mehrere Einheiten hinweg disqualifiziert: keine Anfangsbestimmung darf isoliert, selbstgenügsam und unvermittelt bleiben.","refs":["CH_GB18_EABQ:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_03:BSA-01","text":"Das System umkreist die nicht verfügbare Möglichkeit eines reinen Anfangs, der zugleich völlig inhaltslos und dennoch positiv von seinem Negativen unterschieden wäre.","refs":["CH_GB18_SEYN:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSA-02","text":"Seine Kraft beruht auf der Abwesenheit eines externen Standpunkts, von dem aus Seyn und Nichts unabhängig von ihrer begrifflichen Bewegung fixiert werden könnten.","refs":["CH_GB18_BNIC:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSA-03","text":"Ontologisch unzulässig ist jede Trennung von Unmittelbarkeit, Bestimmtheit und Selbstbeziehung als dauerhaft getrennten Zuständen.","refs":["CH_GB18_EABQ:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_03:XD-01","text":"Die gemeinsame Bestimmungslosigkeit von reinem Seyn und reinem Nichts erzeugt eine Identität, die nicht abschließt, sondern den Bedarf an einer vermittelnden Differenz freilegt.","refs":["CL_GB18_03:GA-01","CL_GB18_03:GA-03","CL_GB18_03:GA-04","CH_GB18_SEYN:SD2","CH_GB18_BNIC:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_03:XD-02","text":"Weil reine Unmittelbarkeit weder Inhalt noch Unterschied bewahren kann, wird Gegensatz zur generativen Bedingung jeder späteren Bestimmung.","refs":["CL_GB18_03:GA-02","CL_GB18_03:GA-05","CH_GB18_EABQ:ME2","CH_GB18_SEYN:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_03:XD-03","text":"Die im Nichts als intentionale Tätigkeit auftretende Differenz und die im Seyn als Gegensatz auftretende Differenz konvergieren in der positiven Qualität des Daseyns.","refs":["CL_GB18_03:GA-04","CL_GB18_03:GA-05","CL_GB18_03:GA-06","CH_GB18_BNIC:D2","CH_GB18_EABQ:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_03:XD-04","text":"Die Verbindung von Daseyns-Endlichkeit und der apophatischen Unhaltbarkeit isolierter Bestimmungen erzeugt die Bewegung zur unendlichen Selbstbeziehung.","refs":["CL_GB18_03:GA-07","CL_GB18_03:GA-08","CL_GB18_03:GA-09","CH_GB18_EABQ:D5","CH_GB18_EABQ:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_03:XD-05","text":"Zwischen intentionaler Differenz und ontologischer Bestimmung bleibt eine produktive Spannung: Differenz wird benötigt, darf aber keinen positiven Inhalt als fertige Substanz etablieren.","refs":["CL_GB18_03:GA-02","CL_GB18_03:GA-04","CH_GB18_BNIC:MRT5","CH_GB18_BNIC:D4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_03:BSD-01","text":"Das System erzeugt eine Ontologie, in der Identität nicht vor der Differenz liegt, sondern als vorläufige Form einer durch Negation erzeugten Bewegung erscheint.","refs":["CH_GB18_SEYN:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSD-02","text":"Realität wird als gestufte Selbstüberschreitung organisiert: Jede erreichte Bestimmung bewahrt ihre Funktion nur, indem sie in eine höhere Relation übergeht.","refs":["CH_GB18_EABQ:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSD-03","text":"Kausalität wird immanenter Übergang: Nicht ein äußerer Grund bewegt das Seyn, sondern die Unhaltbarkeit jeder isolierten Bestimmung treibt die nächste Form hervor.","refs":["CH_GB18_EABQ:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSD-04","text":"Das Subjekt erscheint zunächst nur als leere Vollzugsform des Anschauens und Denkens und gewinnt erst über die Selbstbeziehung des Seyns eine ontologische Bestimmtheit.","refs":["CH_GB18_BNIC:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSD-05","text":"Die negative Methode wird selbst produktiv: Sie zerstört keine Bestimmung endgültig, sondern rekonstruiert aus jedem Ausschluss eine höhere Form.","refs":["CH_GB18_EABQ:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_03:RLE-01","text":"Die zentrale Schleife lautet: Ausschluss von Bestimmung → Leere → Identität von Seyn und Nichts → notwendige Differenz → neue Bestimmung → erneuter Ausschluss ihrer Isolation.","refs":["CH_GB18_SEYN:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RLE-02","text":"Unbestimmtheit wird zum Attraktor, der nicht als Endpunkt, sondern als wiederkehrender Prüfstein jeder neu entstehenden Bestimmung fungiert.","refs":["CH_GB18_EABQ:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RLE-03","text":"Die Eskalation verläuft von leerer Identität über relationale Qualität und endliches Daseyn zur Selbstbeziehung des Seyns.","refs":["CH_GB18_EABQ:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RLE-04","text":"Der scheinbare Rückfall von Seyn zu Nichts markiert keinen Abbruch, sondern einen Phasenwechsel, durch den die Bedingungen positiver Bestimmung sichtbar werden.","refs":["CH_GB18_SEYN:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RLE-05","text":"Die verstreuten Einheiten konvergieren auf den Attraktor, dass keine Bestimmung isoliert bleiben darf: Reinheit, Nichts, Daseyn und Fürsichseyn sind Momente derselben Übergangsmaschine.","refs":["CH_GB18_EABQ:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_03:FGS-B01","text":"Reine Unmittelbarkeit → Ausschluss jeder Differenz → Leere von Seyn und Nichts → Identität ihrer Bestimmungslosigkeit.","refs":["CH_GB18_SEYN:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FGS-B02","text":"Identität der Leere → relationale beziehungsweise intentionale Differenz → Unbestimmtheit als Qualität → bestimmtes Seyn als Daseyn.","refs":["CH_GB18_EABQ:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FGS-B03","text":"Daseyn → Endlichkeit → Selbstaufhebung → unendliche Selbstbeziehung → Fürsichseyn; jede Stufe entsteht durch die Negation ihrer isolierten Geltung.","refs":["CH_GB18_EABQ:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FGS-B04","text":"Formale Maschine: Ausschluss erzeugt Leere; Leere erzeugt Identität; Identität erzeugt Differenz; Differenz erzeugt Bestimmtheit; Bestimmtheit erzeugt ihre eigene Überschreitung.","refs":["CH_GB18_EABQ:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_03:AFM-B01","text":"Reine Unmittelbarkeit → apophatische Reinigung → Gleichrangigkeit von Seyn und Nichts → relationale Differenz → bestimmte Qualität → Daseyn.","refs":["CH_GB18_BNIC:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:AFM-B02","text":"Daseyn → Endlichkeit → immanente Aufhebung → unendliche Selbstbeziehung → Fürsichseyn als vorläufige terminale Form.","refs":["CH_GB18_EABQ:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_03:MME-01","text":"Unbestimmtheit wird nicht mehr als bloße Abwesenheit, sondern als relationale und produktive Qualität kartiert.","refs":["CH_GB18_EABQ:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MME-02","text":"Seyn und Nichts werden nicht länger als konkurrierende Inhalte, sondern als gleichrangige Grenzformen derselben Inhaltslosigkeit klassifiziert.","refs":["CH_GB18_BNIC:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MME-03","text":"Gegensatz wird von einer äußerlichen Gegenüberstellung in einen inneren Erzeugungsmechanismus der Bestimmung umgezeichnet.","refs":["CH_GB18_EABQ:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MME-04","text":"Daseyn erscheint als vermittelnde Schwelle zwischen unmittelbarer Leere und selbstbezogener Unendlichkeit, nicht als stabiler Gegenstandsbereich.","refs":["CH_GB18_EABQ:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MME-05","text":"Unendlichkeit wird als qualitative Selbstbeziehung und nicht als bloße Entfernung jeder Grenze klassifiziert.","refs":["CH_GB18_EABQ:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_03:ALT-B01","text":"Auf der Oberfläche stehen reines Seyn, reines Nichts, Daseyn, Endlichkeit und Fürsichseyn als benannte Bestimmungsformen.","refs":["CH_GB18_EABQ:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:ALT-B02","text":"Auf der Strukturebene organisiert sich das System durch Ausschluss, Gegensatz, relationale Differenz und Aufhebung.","refs":["CH_GB18_EABQ:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:ALT-B03","text":"Auf der metastrategischen Ebene wird jede isolierte Kategorie in ihre eigene Übergangsbedingung umcodiert; Interpretation folgt daher nicht festen Gegensätzen, sondern Funktionsverschiebungen.","refs":["CH_GB18_EABQ:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:ALT-B04","text":"Auf ontologisch-temporaler Ebene ist Seyn eine gestufte Bewegungsordnung von unmittelbarer Leere über Endlichkeit zu Selbstbeziehung.","refs":["CH_GB18_EABQ:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:ALT-B05","text":"Auf methodologisch-performativer Ebene vollzieht die Darstellung selbst, was sie behauptet: Sie reinigt Begriffe, erzeugt ihre Negation und gewinnt daraus eine neue Bestimmung.","refs":["CH_GB18_SEYN:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_03:FL-01","text":"Die anfängliche Behauptung reiner Unmittelbarkeit widerspricht ihrer späteren Bestimmung durch Gegensatz; diese Spannung ist jedoch der produktive Motor der gesamten Bewegung.","refs":["CH_GB18_EABQ:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FL-02","text":"Das Nichts wird als ununterschieden bestimmt, während Anschauen und Denken eine relationale Differenz einführen; die Differenz muss daher operativ, nicht inhaltlich verstanden werden.","refs":["CH_GB18_BNIC:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FL-03","text":"Die Rede von der Präsenz des Nichts im Denken droht eine ontologische Existenz einzuführen, die seine Inhaltslosigkeit zugleich unterminieren würde.","refs":["CH_GB18_BNIC:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FL-04","text":"Die Cluster-Schließung auf Fürsichseyn ist strukturell vorbereitet, bleibt aber abhängig von einer nur teilweise explizierten Vermittlung zwischen Qualität, Daseyn und Endlichkeit.","refs":["CH_GB18_EABQ:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MP-01","text":"Unbestimmtheit mutiert am Gegensatzpunkt von einer negativen Abwesenheit zu einer positiven relationalen Qualität.","refs":["CH_GB18_EABQ:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MP-02","text":"Die Differenz mutiert am Übergang vom Nichts zur intentionalen Tätigkeit: Sie wird nicht Inhalt, sondern Vollzugsform.","refs":["CH_GB18_BNIC:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MP-03","text":"Aufhebung mutiert am Übergang von Endlichkeit zu Fürsichseyn von Vernichtung zu höherer Selbstbeziehung.","refs":["CH_GB18_EABQ:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_03:HSI-01","text":"Das System hält Realität implizit für eine selbsttransformierende Übergangsmaschine, in der jede scheinbare Grundbestimmung durch ihre eigene Negation weitergetrieben wird.","refs":["CH_GB18_EABQ:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:HSI-02","text":"Das Subjekt ist zunächst kein souveräner Träger von Inhalten, sondern der leere Vollzug, in dem Bestimmungslosigkeit als Denken und Anschauen erscheint.","refs":["CH_GB18_BNIC:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:HSI-03","text":"Zeit ist keine äußere Abfolge, sondern die innere Staffelung von Unmittelbarkeit, Differenz, Endlichkeit, Aufhebung und Selbstbeziehung.","refs":["CH_GB18_EABQ:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:HSI-04","text":"Möglich bleibt ein Kampf der Bestimmungen gegen ihre eigene Isolation: Jede erreichte Form muss ihre Endlichkeit überschreiten, ohne in bloße Vernichtung zurückzufallen.","refs":["CH_GB18_EABQ:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_03:MRT-B01","text":"Die minimale Architektur ist hinreichend, wenn sie vier Operationen bewahrt: Ausschluss von Inhalt, Identität von Seyn und Nichts, Erzeugung relationaler Bestimmtheit und Aufhebung der Endlichkeit in Selbstbeziehung.","refs":["CH_GB18_EABQ:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MRT-B02","text":"Unterbestimmt bleibt die genaue Vermittlung, durch die aus der gemeinsamen Leere von Seyn und Nichts gerade Daseyn und nicht lediglich eine weitere Negation hervorgehen.","refs":["CH_GB18_BNIC:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MRT-B03","text":"Die stärkste Stelle der Cluster-Architektur ist die Umwandlung von Unbestimmtheit in relationale Qualität; sie verbindet die apophatischen Anfangseinheiten mit der ontologischen Eskalation.","refs":["CH_GB18_EABQ:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MRT-B04","text":"Die Rekonstruktion bleibt kohärent, sofern Differenz nicht als positiver Inhalt, sondern als notwendige Bewegungsform der Bestimmung verstanden wird.","refs":["CH_GB18_EABQ:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MRT-B05","text":"Die tatsächliche Bewegung bleibt nur erhalten, wenn Seyn und Nichts weder schlicht identifiziert noch dauerhaft getrennt, sondern als instabile Einheit ihrer späteren Differenz gelesen werden.","refs":["CH_GB18_SEYN:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MRT-B06","text":"Ein unverzichtbares Element widersteht der vollständigen Reduktion: die nicht vollständig explizierte Vermittlung zwischen leerer Identität, bestimmter Qualität und Fürsichseyn.","refs":["CH_GB18_EABQ:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120504201292Z_6e727404","language_code":"en","language_name":"English","title":"Chapters 07–09","source_sha256":"0e87efcb2c26076898e69300e9e1560fd1c6238dd10ac9ea9f17fb0550854044","sha256":"e4ccab126e1bbbf1b40b91224124d946f410f45ca7f39bfb9dfee876a1183e69","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:05:04.202347+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_03:SP-01","text":"The system resolves the problem of how a tenable determination can arise at all from wholly indeterminate Being (Seyn), without presupposing an external content.","refs":["CH_GB18_SEYN:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:SP-02","text":"It initially determines immediacy apophatically as the exclusion of every difference and thereby shows that pure positivity turns into emptiness and pure Nothing.","refs":["CH_GB18_SEYN:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:SP-03","text":"The identity of Being (Seyn) and Nothing thus produced nevertheless remains unstable, because the determination of their indeterminacy already presupposes a relational operation.","refs":["CH_GB18_SEYN:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:SP-04","text":"The movement of the argument therefore proceeds from empty immediacy through opposition, quality, determinate Being (Daseyn), and finitude to the self-relation of Being (Seyn); it is recursively negative, cumulative, and directed toward a higher form of being.","refs":["CH_GB18_EABQ:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_03:GA-01","text":"[Persistent] The beginning is pure, indeterminate immediacy without presupposed content.","refs":["CH_GB18_EABQ:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-02","text":"[Persistent] Every positive determination presupposes difference and thereby destroys the asserted purity of immediate Being (Seyn).","refs":["CH_GB18_SEYN:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-03","text":"[Emergent] The exclusion of every difference produces the structural equivalence of pure Being (Seyn) and pure Nothing.","refs":["CH_GB18_SEYN:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-04","text":"[Mutating] Difference initially appears as prohibited content, then returns as relational or intentional activity.","refs":["CH_GB18_BNIC:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-05","text":"[Emergent] Indeterminacy is not annulled by its opposite but transformed into a relational quality of its own.","refs":["CH_GB18_EABQ:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-06","text":"[Emergent] The quality thus gained becomes concrete as determinate Being (Seyn), and thereby as determinate Being (Daseyn).","refs":["CH_GB18_EABQ:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-07","text":"[Terminal] As determinate Being (Daseyn), determinacy is finite and contains the necessity of its own sublation (Aufhebung).","refs":["CH_GB18_EABQ:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-08","text":"[Attractor] The sublation (Aufhebung) of finitude aims at an infinite relation of Being (Seyn) to itself.","refs":["CH_GB18_EABQ:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-09","text":"[Mutating] Negation does not mean annihilation, but the production of a higher form of determination.","refs":["CH_GB18_EABQ:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GA-10","text":"[Terminal] Being-for-self (Fürsichseyn) designates the provisional closure of the movement as self-relation rather than mere immediacy.","refs":["CH_GB18_EABQ:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_03:RMD-01","text":"Pure Being (Seyn) and pure Nothing repeat the same function of contentlessness, although they initially appear as separate initial determinations.","refs":["CH_GB18_SEYN:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-02","text":"Indeterminacy mutates from an exclusion of every determination into a relational quality as soon as it is set against determinacy.","refs":["CH_GB18_EABQ:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-03","text":"Difference shifts from excluded ontological content into the form of intuition and thinking.","refs":["CH_GB18_BNIC:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-04","text":"The difference between something and nothing is thereby recoded from a positive ontological separation into a difference of reference.","refs":["CH_GB18_BNIC:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-05","text":"Determinate Being (Daseyn) assumes the function of mediating determinacy and is absorbed as a finite transitional form.","refs":["CH_GB18_EABQ:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-06","text":"Being and Nothing lose their isolated opposition after they have disclosed the shared structure of indeterminacy.","refs":["CH_GB18_BNIC:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RMD-07","text":"Finitude does not simply disappear but is transformed into self-relation as a necessary transitional form.","refs":["CH_GB18_EABQ:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_03:CGD-01","text":"Locally, the description of pure Being (Seyn) remains that of an empty, undifferentiated beginning; at the cluster level, this becomes the general rule that purity can be determined only through exclusion and transition.","refs":["CH_GB18_SEYN:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:CGD-02","text":"Locally, Nothing remains an empty activity of thinking or intuition; at the cluster level, this activity becomes the model for how difference can arise without positive content.","refs":["CH_GB18_BNIC:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:CGD-03","text":"The local equation of Being (Seyn) and Nothing scales upward because it forms the shared point of departure for the later production of determinate quality.","refs":["CH_GB18_BNIC:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:CGD-04","text":"The local derivation of being-for-self (Fürsichseyn) is at this level no longer a mere chapter conclusion, but the attractor toward which the entire movement of negation tends.","refs":["CH_GB18_EABQ:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_03:GNX-01","text":"Excluded is a Being (Seyn) that could subsist as positively determinable content without opposition, relation, or mediation.","refs":["CH_GB18_EABQ:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GNX-02","text":"Excluded is a Nothing that could be fixed as an independent positive reality alongside Being (Seyn).","refs":["CH_GB18_BNIC:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GNX-03","text":"Excluded is a finitude that could preserve itself as the final and independent form of determination.","refs":["CH_GB18_EABQ:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GNX-04","text":"Excluded is an infinity that designates merely boundless extension rather than self-relation.","refs":["CH_GB18_EABQ:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:GNX-05","text":"The repeated negation of static identities produces a positive architecture of graduated transitions.","refs":["CH_GB18_EABQ:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_03:DBN-01","text":"The system cannot subsist if indeterminacy is understood as isolated, relationless emptiness; it must become determinable through opposition.","refs":["CH_GB18_EABQ:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:DBN-02","text":"It must be excluded that intuition and thinking confer a positive content upon Nothing; otherwise, the shared indeterminacy of Being (Seyn) and Nothing would disintegrate.","refs":["CH_GB18_BNIC:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:DBN-03","text":"It must be excluded that sublation (Aufhebung) means mere annihilation, because only its recoding as transition enables the development toward self-relation.","refs":["CH_GB18_EABQ:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:DBN-04","text":"The competing model of a static ontology is disqualified across several units: no initial determination may remain isolated, self-sufficient, and unmediated.","refs":["CH_GB18_EABQ:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_03:BSA-01","text":"The system circles around the unavailable possibility of a pure beginning that is at once wholly contentless and yet positively distinguished from its negative.","refs":["CH_GB18_SEYN:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSA-02","text":"Its force rests on the absence of an external standpoint from which Being (Seyn) and Nothing could be fixed independently of their conceptual movement.","refs":["CH_GB18_BNIC:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSA-03","text":"Ontologically inadmissible is every separation of immediacy, determinacy, and self-relation as durably separate states.","refs":["CH_GB18_EABQ:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_03:XD-01","text":"The shared indeterminacy of pure Being (Seyn) and pure Nothing produces an identity that does not conclude but discloses the need for a mediating difference.","refs":["CL_GB18_03:GA-01","CL_GB18_03:GA-03","CL_GB18_03:GA-04","CH_GB18_SEYN:SD2","CH_GB18_BNIC:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_03:XD-02","text":"Because pure immediacy can preserve neither content nor difference, opposition becomes the generative condition of every later determination.","refs":["CL_GB18_03:GA-02","CL_GB18_03:GA-05","CH_GB18_EABQ:ME2","CH_GB18_SEYN:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_03:XD-03","text":"The difference appearing in Nothing as intentional activity and the difference appearing in Being (Seyn) as opposition converge in the positive quality of determinate Being (Daseyn).","refs":["CL_GB18_03:GA-04","CL_GB18_03:GA-05","CL_GB18_03:GA-06","CH_GB18_BNIC:D2","CH_GB18_EABQ:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_03:XD-04","text":"The connection between the finitude of determinate Being (Daseyn) and the apophatic untenability of isolated determinations produces the movement toward infinite self-relation.","refs":["CL_GB18_03:GA-07","CL_GB18_03:GA-08","CL_GB18_03:GA-09","CH_GB18_EABQ:D5","CH_GB18_EABQ:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_03:XD-05","text":"A productive tension remains between intentional difference and ontological determination: difference is needed, but it may not establish positive content as a finished substance.","refs":["CL_GB18_03:GA-02","CL_GB18_03:GA-04","CH_GB18_BNIC:MRT5","CH_GB18_BNIC:D4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_03:BSD-01","text":"The system produces an ontology in which identity does not precede difference, but appears as a provisional form of a movement generated through negation.","refs":["CH_GB18_SEYN:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSD-02","text":"Reality is organized as graduated self-transcendence: every attained determination preserves its function only by passing into a higher relation.","refs":["CH_GB18_EABQ:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSD-03","text":"Causality becomes immanent transition: it is not an external ground that moves Being (Seyn), but the untenability of every isolated determination that drives forth the next form.","refs":["CH_GB18_EABQ:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSD-04","text":"The subject initially appears only as the empty form of enactment of intuition and thinking and gains ontological determinacy only through the self-relation of Being (Seyn).","refs":["CH_GB18_BNIC:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:BSD-05","text":"The negative method itself becomes productive: it does not destroy any determination definitively, but reconstructs a higher form from every exclusion.","refs":["CH_GB18_EABQ:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_03:RLE-01","text":"The central loop is: exclusion of determination → emptiness → identity of Being (Seyn) and Nothing → necessary difference → new determination → renewed exclusion of its isolation.","refs":["CH_GB18_SEYN:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RLE-02","text":"Indeterminacy becomes the attractor that functions not as an endpoint, but as a recurring touchstone for every newly emerging determination.","refs":["CH_GB18_EABQ:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RLE-03","text":"The escalation proceeds from empty identity through relational quality and finite determinate Being (Daseyn) to the self-relation of Being (Seyn).","refs":["CH_GB18_EABQ:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RLE-04","text":"The apparent relapse from Being (Seyn) to Nothing marks not a break, but a phase change through which the conditions of positive determination become visible.","refs":["CH_GB18_SEYN:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:RLE-05","text":"The scattered units converge upon the attractor that no determination may remain isolated: purity, Nothing, determinate Being (Daseyn), and being-for-self (Fürsichseyn) are moments of the same transition-machine.","refs":["CH_GB18_EABQ:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_03:FGS-B01","text":"Pure immediacy → exclusion of every difference → emptiness of Being (Seyn) and Nothing → identity of their indeterminacy.","refs":["CH_GB18_SEYN:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FGS-B02","text":"Identity of emptiness → relational or intentional difference → indeterminacy as quality → determinate Being (Seyn) as determinate Being (Daseyn).","refs":["CH_GB18_EABQ:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FGS-B03","text":"Determinate Being (Daseyn) → finitude → self-sublation (Aufhebung) → infinite self-relation → being-for-self (Fürsichseyn); every stage arises through the negation of its isolated validity.","refs":["CH_GB18_EABQ:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FGS-B04","text":"Formal machine: exclusion produces emptiness; emptiness produces identity; identity produces difference; difference produces determinacy; determinacy produces its own transcendence.","refs":["CH_GB18_EABQ:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_03:AFM-B01","text":"Pure immediacy → apophatic purification → equivalence of Being (Seyn) and Nothing → relational difference → determinate quality → determinate Being (Daseyn).","refs":["CH_GB18_BNIC:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:AFM-B02","text":"Determinate Being (Daseyn) → finitude → immanent sublation (Aufhebung) → infinite self-relation → being-for-self (Fürsichseyn) as provisional terminal form.","refs":["CH_GB18_EABQ:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_03:MME-01","text":"Indeterminacy is no longer mapped as mere absence, but as a relational and productive quality.","refs":["CH_GB18_EABQ:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MME-02","text":"Being (Seyn) and Nothing are no longer classified as competing contents, but as equivalent limiting forms of the same contentlessness.","refs":["CH_GB18_BNIC:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MME-03","text":"Opposition is redrawn from an external juxtaposition into an internal generative mechanism of determination.","refs":["CH_GB18_EABQ:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MME-04","text":"Determinate Being (Daseyn) appears as a mediating threshold between immediate emptiness and self-related infinity, not as a stable domain of objects.","refs":["CH_GB18_EABQ:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MME-05","text":"Infinity is classified as qualitative self-relation and not as the mere removal of every limit.","refs":["CH_GB18_EABQ:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_03:ALT-B01","text":"At the surface stand pure Being (Seyn), pure Nothing, determinate Being (Daseyn), finitude, and being-for-self (Fürsichseyn) as named forms of determination.","refs":["CH_GB18_EABQ:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:ALT-B02","text":"At the structural level, the system organizes itself through exclusion, opposition, relational difference, and sublation (Aufhebung).","refs":["CH_GB18_EABQ:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:ALT-B03","text":"At the meta-strategic level, every isolated category is recoded into its own condition of transition; interpretation therefore follows not fixed oppositions, but shifts of function.","refs":["CH_GB18_EABQ:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:ALT-B04","text":"At the ontological-temporal level, Being (Seyn) is a graduated order of movement from immediate emptiness through finitude to self-relation.","refs":["CH_GB18_EABQ:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:ALT-B05","text":"At the methodological-performative level, the presentation itself enacts what it asserts: it purifies concepts, produces their negation, and derives a new determination from it.","refs":["CH_GB18_SEYN:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_03:FL-01","text":"The initial assertion of pure immediacy contradicts its later determination through opposition; this tension, however, is the productive motor of the entire movement.","refs":["CH_GB18_EABQ:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FL-02","text":"Nothing is determined as undifferentiated, while intuition and thinking introduce a relational difference; difference must therefore be understood operationally, not in terms of content.","refs":["CH_GB18_BNIC:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FL-03","text":"Talk of the presence of Nothing in thinking threatens to introduce an ontological existence that would simultaneously undermine its contentlessness.","refs":["CH_GB18_BNIC:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:FL-04","text":"The cluster's closure upon being-for-self (Fürsichseyn) is structurally prepared, but remains dependent upon a mediation between quality, determinate Being (Daseyn), and finitude that is only partially made explicit.","refs":["CH_GB18_EABQ:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MP-01","text":"At the point of opposition, indeterminacy mutates from a negative absence into a positive relational quality.","refs":["CH_GB18_EABQ:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MP-02","text":"Difference mutates at the transition from Nothing to intentional activity: it becomes not content, but a form of enactment.","refs":["CH_GB18_BNIC:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MP-03","text":"At the transition from finitude to being-for-self (Fürsichseyn), sublation (Aufhebung) mutates from annihilation into higher self-relation.","refs":["CH_GB18_EABQ:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_03:HSI-01","text":"The system implicitly regards reality as a self-transforming transition-machine in which every apparent fundamental determination is driven onward by its own negation.","refs":["CH_GB18_EABQ:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:HSI-02","text":"The subject is initially not a sovereign bearer of contents, but the empty enactment in which indeterminacy appears as thinking and intuition.","refs":["CH_GB18_BNIC:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:HSI-03","text":"Time is not an external succession, but the inner gradation of immediacy, difference, finitude, sublation (Aufhebung), and self-relation.","refs":["CH_GB18_EABQ:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:HSI-04","text":"There remains a struggle of determinations against their own isolation: every attained form must transcend its finitude without relapsing into mere annihilation.","refs":["CH_GB18_EABQ:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_03:MRT-B01","text":"The minimal architecture is sufficient if it preserves four operations: exclusion of content, identity of Being (Seyn) and Nothing, production of relational determinacy, and sublation (Aufhebung) of finitude into self-relation.","refs":["CH_GB18_EABQ:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MRT-B02","text":"What remains underdetermined is the precise mediation through which determinate Being (Daseyn), rather than merely another negation, proceeds from the shared emptiness of Being (Seyn) and Nothing.","refs":["CH_GB18_BNIC:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MRT-B03","text":"The strongest point of the cluster architecture is the transformation of indeterminacy into relational quality; it connects the apophatic initial units with the ontological escalation.","refs":["CH_GB18_EABQ:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MRT-B04","text":"The reconstruction remains coherent insofar as difference is understood not as positive content, but as the necessary form of movement of determination.","refs":["CH_GB18_EABQ:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MRT-B05","text":"The actual movement is preserved only if Being (Seyn) and Nothing are read neither as simply identical nor as permanently separate, but as the unstable unity of their later difference.","refs":["CH_GB18_SEYN:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_03:MRT-B06","text":"An indispensable element resists complete reduction: the not fully explicated mediation between empty identity, determinate quality, and being-for-self (Fürsichseyn).","refs":["CH_GB18_EABQ:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_03@R001","source_variant_id":"canonical:CL_GB18_03:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 07–09","context":"Erster Abschnitt. Bestimmtheit (Qualität). · A. Seyn. · B. Nichts."},"title_language_code":"en"},{"id":"CL_GB18_04","layer":"CL","title":"Chapters 10–12","order":4,"parents":["CH_GB18_1EDS","CH_GB18_ANM1","CH_GB18_ANM2"],"revision":"CL_GB18_04@R001","sha256":"c304681ab56fe421a98e775b9d70f179dbc611bd119105d114f6f4f3fa24cab7","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_04:BS-01","text":"Das System bestimmt den Anfang nicht als vorhandenes Erstes, sondern als reine Inhaltsleere, deren versuchte Fixierung jedes tragfähige Unterscheidungskriterium entzieht.","refs":["CH_GB18_1EDS:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-02","text":"Die Wahrheit der reinen Bestimmungen liegt nicht in ihrem isolierten Bestand, sondern in einer bereits vollzogenen gegenseitigen Übergegangenheit.","refs":["CH_GB18_1EDS:AS2","CH_GB18_1EDS:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-03","text":"Die Einheit von Seyn und Nichts ist keine Tilgung ihrer Differenz, sondern die Konstellation absoluter Unterschiedenheit ohne Selbständigkeit der unterschiedenen Momente.","refs":["CH_GB18_1EDS:A6","CH_GB18_1EDS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-04","text":"Werden erscheint als die einzige Form, in der Identität, Differenz, Verschwinden und Fortbestand zugleich artikulierbar bleiben.","refs":["CH_GB18_1EDS:A10","CH_GB18_ANM2:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-05","text":"Der Urteilsform wird ihre Fähigkeit abgesprochen, spekulative Einheit abschließend auszusagen, weil sie die Nichtidentität ihrer eigenen Bestimmungen nur verdeckt mitsetzt.","refs":["CH_GB18_ANM2:A5","CH_GB18_ANM2:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-06","text":"Der Widerspruch zwischen Identitätssatz und gesetzter Differenz wird nicht beseitigt, sondern als Selbstauflösung des Satzes in Bewegung produktiv gemacht.","refs":["CH_GB18_ANM2:AS3","CH_GB18_ANM2:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-07","text":"Wirkliche Bestimmtheit entsteht nicht auf der Ebene reiner Pole, sondern erst als Daseyn, in dem Inhalt und Beziehung Unterschiede erzeugen.","refs":["CH_GB18_ANM1:A8","CH_GB18_ANM2:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-08","text":"Die Bewegung ist spiralförmig: Abstraktion entzieht Inhalt, der Entzug zerstört stabile Differenz, die Selbstauflösung erzeugt Werden, und Werden eröffnet erst die Sphäre bestimmter Vermittlung.","refs":["CH_GB18_ANM1:FGS3","CH_GB18_ANM1:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_04:GA-01","text":"[Persistent] Reines Seyn und reines Nichts besitzen keine immanente positive Bestimmtheit, aus der ihr Unterschied als Eigentum eines der Pole hervorgehen könnte.","refs":["CH_GB18_ANM2:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-02","text":"[Persistent] Die Wahrheit beider reinen Bestimmungen liegt ausschließlich in ihrem gegenseitigen Übergang, nicht in einer äußerlichen Beziehung fertig bestehender Gegenstände.","refs":["CH_GB18_1EDS:A4","CH_GB18_ANM1:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-03","text":"[Mutating] Identität wird nur als Identität-in-Differenz gültig; absolute Unterschiedenheit und Untrennbarkeit sind keine Alternativen, sondern wechselseitige Bedingungen.","refs":["CH_GB18_1EDS:A6","CH_GB18_1EDS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-04","text":"[Attractor] Werden ist weder Resultat nach einem abgeschlossenen Übergang noch dritter ruhender Gegenstand, sondern die Einheit von Vollzug, Ergebnis und fortgesetzter Nichtselbständigkeit der Momente.","refs":["CH_GB18_1EDS:SD4","CH_GB18_ANM2:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-05","text":"[Mutating] Widerspruch ist kein äußerer Defekt des Gedankens, sondern die immanente Form, in der eine einseitige Bestimmung ihre Unzulänglichkeit in Bewegung überführt.","refs":["CH_GB18_ANM2:AS3","CH_GB18_ANM2:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-06","text":"[Emergent] Reale Differenz gehört dem bestimmten Daseyn, seinem Inhalt und seinen Beziehungen an; sie darf nicht rückwirkend in reine Seyn-und-Nichts-Bestimmungen eingeschleust werden.","refs":["CH_GB18_ANM1:A7","CH_GB18_ANM1:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-07","text":"[Persistent] Konkrete Erfahrung, endlicher Inhalt und empirische Einwände können die Wahrheit reiner Kategorien nicht unmittelbar beurteilen, weil sie bereits eine höhere Bestimmungsebene voraussetzen.","refs":["CH_GB18_ANM1:D3","CH_GB18_ANM1:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-08","text":"[Terminal] Ein einzelner Identitätssatz ist für spekulative Wahrheit nur als Übergangsform gültig, weil sein Vollzug die Differenz setzt, die seine prädikative Gestalt nicht tragen kann.","refs":["CH_GB18_ANM2:NX3","CH_GB18_ANM2:A7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_04:RMD-01","text":"Seyn und Nichts kehren als stabile Namen wieder, mutieren jedoch von scheinbar ersten Bestimmungen zu unselbständigen Grenzmomenten des Werdens.","refs":["CH_GB18_1EDS:A1","CH_GB18_ANM2:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RMD-02","text":"Differenz mutiert von der Behauptung absoluter Unterschiedenheit zu einer Differenz, die nur im Übergang Bestand hat und außerhalb des Werdens weder definierbar noch stabilisierbar ist.","refs":["CH_GB18_1EDS:A6","CH_GB18_ANM2:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RMD-03","text":"Nichts verschiebt sich von einer reinen, inhaltslosen Negation zu einer Bestimmung, deren konkrete Wirksamkeit erst im Daseyn als Verhältnis von Etwas und Anderem erscheint.","refs":["CH_GB18_ANM1:A2","CH_GB18_ANM1:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RMD-04","text":"Identität verschiebt sich von einer ontologischen Behauptung zu einem Problem der Ausdrucksform: Das Urteil setzt die Differenz voraus, die seine prädikative Einheit verdeckt.","refs":["CH_GB18_ANM2:A5","CH_GB18_ANM2:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RMD-05","text":"Bestimmtheit erscheint zunächst als ausgeschlossen und kehrt anschließend als Ergebnis wechselseitiger Vermittlung zurück; sie wird nicht gefunden, sondern durch den Ausfall reiner Selbständigkeit erzeugt.","refs":["CH_GB18_ANM1:AS5","CH_GB18_ANM2:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_04:CGD-01","text":"Die Gleichsetzung reiner Bestimmungen mit Werden skaliert auf Clusterebene, weil sie sowohl die ontologische Bewegung als auch die Kritik ihrer Ausdrucksform organisiert.","refs":["CH_GB18_1EDS:ME3","CH_GB18_ANM2:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:CGD-02","text":"Die Analyse möglicher und wirklicher Gegenstände bleibt lokal, gewinnt aber eine übergeordnete Funktion als Grenzmarkierung zwischen Inhaltsbestimmung und bloßer Existenzbehauptung.","refs":["CH_GB18_ANM1:D6","CH_GB18_ANM1:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:CGD-03","text":"Die Unterscheidung endlicher Dinge von Gott bleibt eine lokale metaphysische Sonderbestimmung, kann jedoch nicht zur allgemeinen Struktur reiner Negation oder des Werdens verallgemeinert werden.","refs":["CH_GB18_ANM1:AS6","CH_GB18_ANM1:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:CGD-04","text":"Die Analogie von Licht und Finsternis ist lokal austauschbar; ihre übergeordnete Funktion besteht allein darin, die Bedingung wechselseitiger Bestimmung gegen reine Leere abzugrenzen.","refs":["CH_GB18_ANM2:A10","CH_GB18_ANM2:NX7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_04:GNX-01","text":"Ausgeschlossen ist ein Seyn, das seine Wahrheit ohne Nichts besitzt, ebenso wie ein Nichts, das als selbständiger Gegenpol außerhalb des Seyns fortbesteht.","refs":["CH_GB18_1EDS:SNX1","CH_GB18_1EDS:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GNX-02","text":"Ausgeschlossen ist ein zeitliches oder substantielles Trägermedium, in dem Seyn und Nichts als nacheinander auftretende Zustände bestehen könnten.","refs":["CH_GB18_ANM1:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GNX-03","text":"Ausgeschlossen ist eine Einheit, die Differenz durch Gleichgültigkeit, Ununterschiedenheit oder bloße Abstraktion auslöscht.","refs":["CH_GB18_1EDS:NX3","CH_GB18_ANM2:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GNX-04","text":"Ausgeschlossen ist die Übertragung bestimmter Inhalte, empirischer Gegenstände oder sinnlicher Bilder in die Analyse reiner Kategorien.","refs":["CH_GB18_ANM1:DNX1","CH_GB18_ANM2:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GNX-05","text":"Ausgeschlossen ist eine Erkenntnisform, die Wahrheit durch äußere Vergleichung oder durch die Fixierung eines einzelnen Satzes erschöpfen könnte.","refs":["CH_GB18_ANM2:NX5","CH_GB18_ANM2:DNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_04:DBN-01","text":"Das System hält nur, wenn kein vorvermittelter ontologischer Grund zugelassen wird, der Seyn, Nichts oder Unterschied als festes Erstes bereitstellt.","refs":["CH_GB18_ANM2:DNX1","CH_GB18_ANM2:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:DBN-02","text":"Das System hält nur, wenn Unterschied nicht als positive Eigenschaft isolierter Pole gedacht wird, sondern als negative Bedingung ihrer Nichtselbständigkeit.","refs":["CH_GB18_ANM2:NX6","CH_GB18_ANM2:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:DBN-03","text":"Das System hält nur, wenn keine sprachliche Formel als endgültiger Besitz spekulativer Wahrheit behandelt wird.","refs":["CH_GB18_ANM2:SNX2","CH_GB18_ANM2:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_04:BSA-01","text":"Nicht verfügbar ist ein ruhender Anfang, der vor Negation, Übergang und Vermittlung als ontologisch gesicherter Ursprung fungieren könnte.","refs":["CH_GB18_ANM2:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BSA-02","text":"Nicht verfügbar ist eine endgültige Fixierung eines Moments, weil jedes Moment nur unter der Bedingung seines unmittelbaren Verschwindens bestimmt bleibt.","refs":["CH_GB18_1EDS:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BSA-03","text":"Nicht zulässig ist eine Realität, in der positive Bestimmtheit vor oder außerhalb wechselseitiger Vermittlung vorhanden wäre.","refs":["CH_GB18_ANM2:SD4","CH_GB18_ANM2:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_04:XD-01","text":"Die Entleerung von Inhalt und Beziehung ist keine bloß negative Abstraktion, sondern die Operation, welche die Selbständigkeit reiner Pole entzieht und ihre Wahrheit als Übergang erzwingt.","refs":["CL_GB18_04:GA-01","CL_GB18_04:GA-02","CH_GB18_ANM1:AS2","CH_GB18_1EDS:AS2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_04:XD-02","text":"Die im Satz auftretende Differenz bestätigt nicht die Unwahrheit der Einheit, sondern zeigt, dass Wahrheit nur als Selbstüberschreitung ihrer eigenen Ausdrucksform bestehen kann.","refs":["CL_GB18_04:GA-03","CL_GB18_04:GA-05","CL_GB18_04:GA-08","CH_GB18_ANM2:AS3","CH_GB18_1EDS:AS4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_04:XD-03","text":"Daseyn ist weder empirischer Gegenbeweis gegen reine Einheit noch nachträglicher Zusatz, sondern die notwendige Sphäre, in der die durch reine Abstraktion ausgeschlossene Bestimmtheit als Verhältnis zurückkehrt.","refs":["CL_GB18_04:GA-06","CL_GB18_04:GA-07","CH_GB18_ANM1:A8","CH_GB18_ANM2:D5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_04:XD-04","text":"Die Zeitlichkeit des Systems ist logisch und nicht chronologisch: Die Bewegung ist vollzogen, gerade weil ihre Momente nur im fortgesetzten Umschlag bestimmt bleiben.","refs":["CL_GB18_04:GA-04","CL_GB18_04:GA-08","CH_GB18_1EDS:AS3","CH_GB18_1EDS:SD4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_04:BSD-01","text":"Realität erscheint auf dieser Ebene nicht als Ansammlung vorhandener Einheiten, sondern als selbstdifferenzierende Bedingung, in der jedes Bestimmte nur durch seine Negation und Vermittlung besteht.","refs":["CH_GB18_ANM2:SD2","CH_GB18_ANM1:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BSD-02","text":"Erkenntnis wird als Disziplin des Ebenenunterschieds reorganisiert: Weder konkrete Erfahrung noch reine Abstraktion dürfen die Funktion der jeweils anderen Ebene usurpieren.","refs":["CH_GB18_ANM1:SD4","CH_GB18_ANM1:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BSD-03","text":"Sprache besitzt für spekulative Wahrheit keinen neutralen Darstellungsstatus, weil die Form ihrer Aussage den Überschuss des Gegenstands zugleich setzt und verdeckt.","refs":["CH_GB18_ANM2:A5","CH_GB18_ANM2:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BSD-04","text":"Der ontologische Anfang verliert jede Form ruhender Ursprünglichkeit und wird als retrospektiv lesbare Bewegung bestimmt, in der Resultat und Vollzug nicht auseinanderfallen.","refs":["CH_GB18_1EDS:SD4","CH_GB18_ANM2:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_04:RLE-01","text":"Die erste Schleife lautet: Entleerung von Inhalt erzeugt Ununterscheidbarkeit; Ununterscheidbarkeit zerstört die Selbständigkeit der Pole; diese Zerstörung erscheint als Werden.","refs":["CH_GB18_ANM1:FGS2","CH_GB18_ANM1:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RLE-02","text":"Die zweite Schleife lautet: Der Identitätssatz setzt Differenz; die gesetzte Differenz widerspricht seiner Form; der Widerspruch führt den Satz in die Bewegung zurück, die er nicht ausdrücken kann.","refs":["CH_GB18_ANM2:A7","CH_GB18_ANM2:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RLE-03","text":"Die dritte Schleife lautet: Konkrete Einwände gegen reine Einheit werden als Ebenenwechsel erkannt; dieser Ebenenwechsel verweist auf Daseyn; Daseyn bestätigt die Notwendigkeit der vorgängigen Abstraktion.","refs":["CH_GB18_ANM1:D3","CH_GB18_ANM1:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RLE-04","text":"Werden wirkt als begrifflicher Attraktor, weil Identität, Differenz, Negation, Urteil und Bestimmtheit jeweils nur durch Rückkehr in seine Bewegungsstruktur stabilisiert werden.","refs":["CH_GB18_ANM1:A12","CH_GB18_ANM2:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_04:FGS-B01","text":"Abstraktion von Inhalt, Beziehung und Substrat → reine Unbestimmtheit der Pole.","refs":["CH_GB18_ANM1:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FGS-B02","text":"Reine Unbestimmtheit → Unmöglichkeit einer immanenten positiven Differenz.","refs":["CH_GB18_ANM2:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FGS-B03","text":"Urteilsförmige Identität → Mitsetzung der verdrängten Nichtidentität → Selbstwiderspruch der Aussageform.","refs":["CH_GB18_ANM2:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FGS-B04","text":"Selbstwiderspruch ohne äußere Auflösung → immanentes Verschwinden der isolierten Bestimmungen → Werden.","refs":["CH_GB18_ANM2:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FGS-B05","text":"Werden als Einheit von Unterschied und Untrennbarkeit → vermittelte Bestimmtheit → Daseyn als Sphäre realer Inhalte und Beziehungen.","refs":["CH_GB18_ANM2:FGS4","CH_GB18_ANM1:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_04:AFM-B01","text":"Entzug bestimmter Inhalte und Beziehungen → reine Seyn-und-Nichts-Bestimmungen ohne immanente positive Differenz.","refs":["CH_GB18_ANM1:FGS1","CH_GB18_ANM2:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:AFM-B02","text":"Unmöglichkeit stabiler Differenz → Unzulänglichkeit bloßer Identität → Wahrheit als gegenseitiges Übergegangensein.","refs":["CH_GB18_1EDS:D1","CH_GB18_1EDS:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:AFM-B03","text":"Urteilsförmige Fixierung der Einheit → Sichtbarwerden der verdrängten Differenz → immanenter Selbstwiderspruch.","refs":["CH_GB18_ANM2:AS2","CH_GB18_ANM2:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:AFM-B04","text":"Selbstwiderspruch → Werden → Daseyn → Rückordnung konkreter Einwände in die Sphäre von Inhalt, Relation und Endlichkeit.","refs":["CH_GB18_ANM2:AS3","CH_GB18_ANM1:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_04:MME-01","text":"Wahrheit wird von einem isolierten Gegenstand auf eine Selbstumschlagsrelation umkartiert; Sein ist nicht mehr ohne seine immanente Negation intelligibel.","refs":["CH_GB18_1EDS:ME1","CH_GB18_1EDS:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MME-02","text":"Identität und Differenz verlieren ihren Status als ausschließende logische Alternativen und werden als gleichursprüngliche Momente einer Bewegung lesbar.","refs":["CH_GB18_1EDS:SD2","CH_GB18_ANM2:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MME-03","text":"Der Gegensatz abstrakter Logik und konkreter Wirklichkeit wird durch eine Architektur von Ebenen ersetzt, in der Daseyn als Vermittlungszone fungiert.","refs":["CH_GB18_ANM1:ME2","CH_GB18_ANM1:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MME-04","text":"Die angemessene Lektüreform verschiebt sich von der Extraktion einzelner Lehrsätze zur Rekonstruktion ihrer notwendigen Gegenbewegung und Selbstauflösung.","refs":["CH_GB18_ANM2:D2","CH_GB18_ANM2:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_04:ALT-B01","text":"Surface level — Das System behandelt Seyn, Nichts, Werden, Daseyn und die Unzulänglichkeit einer urteilsmäßigen Gleichsetzung.","refs":["CH_GB18_ANM2:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:ALT-B02","text":"Structural level — Das System organisiert reine Abstraktion, vermittelte Bestimmtheit, Inhalt und Beziehung als nicht ineinander reduzierbare logische Ebenen.","refs":["CH_GB18_ANM1:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:ALT-B03","text":"Metastrategic level — Das System neutralisiert Einwände nicht durch Widerlegung einzelner Beispiele, sondern durch Diagnose des jeweiligen Ebenenwechsels.","refs":["CH_GB18_ANM1:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:ALT-B04","text":"Ontological / Temporal level — Realität wird als Werden bestimmt, dessen Zeitlichkeit nicht Abfolge äußerer Zustände, sondern vollzogene Selbstvermittlung ist.","refs":["CH_GB18_ANM2:ALT4","CH_GB18_1EDS:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie den Identitätssatz nicht korrigiert, sondern ihn an seinem immanenten Widerspruch zerfallen lässt.","refs":["CH_GB18_ANM2:AS3","CH_GB18_ANM2:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_04:FL-01","text":"Die Architektur verlangt zugleich absolute Unterschiedenheit und die Unmöglichkeit einer immanenten positiven Bestimmung dieses Unterschieds; produktiv bleibt diese Spannung nur, wenn Differenz als Bewegungsmoment statt als Eigenschaft gelesen wird.","refs":["CH_GB18_1EDS:A6","CH_GB18_ANM2:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FL-02","text":"Die Bewegung wird als bereits vollzogen bestimmt, während ihre Momente zugleich nur im fortgesetzten Übergehen bestehen; die Zeitform des Systems bleibt daher logisch notwendig, aber nicht vollständig expliziert.","refs":["CH_GB18_1EDS:AS3","CH_GB18_1EDS:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FL-03","text":"Die Immanenz des Werdens verlangt, dass der Widerspruch sich selbst auflöst, doch seine Erkenntnis scheint eine reflektierende Instanz vorauszusetzen, deren Status unbestimmt bleibt.","refs":["CH_GB18_ANM2:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FL-04","text":"Die Ausnahme einer untrennbaren Einheit von Begriff und Seyn in Gott steht unter Spannung zur allgemeinen These, dass Wirklichkeit nur als instabile Einheit von Positivität und Negativität bestimmt ist.","refs":["CH_GB18_ANM1:A11","CH_GB18_ANM1:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MP-01","text":"Der Identitätssatz mutiert von einer scheinbaren Grundbehauptung zu einem Mechanismus, der die Notwendigkeit seiner eigenen Überschreitung erzeugt.","refs":["CH_GB18_ANM2:AS1","CH_GB18_ANM2:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MP-02","text":"Negation mutiert von reiner Inhaltslosigkeit zu einer Bedingung bestimmter Realität, sobald sie im Daseyn als Verhältnis von Etwas und Anderem wiederkehrt.","refs":["CH_GB18_ANM1:A2","CH_GB18_ANM1:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MP-03","text":"Urteilssprache mutiert von einem behaupteten Medium der Wahrheit zu einem performativen Ort, an dem die Unzulänglichkeit isolierter Prädikation sichtbar wird.","refs":["CH_GB18_ANM2:A5","CH_GB18_ANM2:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_04:HSI-01","text":"Realität erscheint als Maschine wechselseitiger Selbstaufhebung, in der kein Moment durch Eigenbestand, sondern nur durch seinen Übergang in sein Anderes bestimmt ist.","refs":["CH_GB18_1EDS:A8","CH_GB18_1EDS:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:HSI-02","text":"Das Subjekt erscheint nicht als äußerer Vergleicher fertiger Gegenstände, sondern als Instanz, die entweder Ebenen verwechselt oder die immanente Bewegung ihrer Bestimmungen nachvollzieht.","refs":["CH_GB18_ANM2:DNX3","CH_GB18_ANM2:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:HSI-03","text":"Zeit erscheint als logische Gegenwart des Übergegangenseins: Nicht ein Ereignis geschieht zwischen festen Polen, sondern die Pole sind nur als Vollzug ihres Verschwindens.","refs":["CH_GB18_1EDS:D5","CH_GB18_ANM2:A9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_04:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von reiner Unbestimmtheit über den Widerspruch der Urteilsform zum Werden und weiter zur Sphäre des Daseyns zu rekonstruieren.","refs":["CH_GB18_ANM1:MRT1","CH_GB18_ANM2:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MRT-B02","text":"Unterbestimmt bleibt, weshalb die Ununterscheidbarkeit reiner Bestimmungen notwendig Bewegung und nicht lediglich formale Gleichheit erzeugt.","refs":["CH_GB18_ANM1:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MRT-B03","text":"Die Architektur ist am stärksten, wo sie konkrete Einwände als verdeckte Ebenenwechsel diagnostiziert und die Urteilsform als unzureichende Behälterform spekulativer Wahrheit erweist.","refs":["CH_GB18_ANM1:MRT4","CH_GB18_ANM2:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MRT-B04","text":"Die Rekonstruktion bleibt nur kohärent, wenn Werden weder als dritte ruhende Bestimmung noch als bloße Synthese bereits fertiger Entitäten gelesen wird.","refs":["CH_GB18_ANM2:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120538151064Z_e3dd6ffb","language_code":"en","language_name":"English","title":"Chapters 10–12","source_sha256":"c304681ab56fe421a98e775b9d70f179dbc611bd119105d114f6f4f3fa24cab7","sha256":"9d432234c65cfe5e9e9ec8e654c9d9147f46ba3541c42b870c4fa3ae67d49423","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:05:38.152986+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_04:BS-01","text":"The system determines the beginning not as an existent first, but as pure emptiness of content, whose attempted fixation withdraws every sustainable criterion of distinction.","refs":["CH_GB18_1EDS:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-02","text":"The truth of the pure determinations lies not in their isolated subsistence, but in an already accomplished mutual having-passed-over.","refs":["CH_GB18_1EDS:AS2","CH_GB18_1EDS:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-03","text":"The unity of Being and Nothing is not an effacement of their difference, but the constellation of absolute distinctness without independence of the differentiated moments.","refs":["CH_GB18_1EDS:A6","CH_GB18_1EDS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-04","text":"Becoming appears as the only form in which identity, difference, disappearance, and persistence remain articulable at once.","refs":["CH_GB18_1EDS:A10","CH_GB18_ANM2:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-05","text":"The form of judgment is denied the capacity conclusively to state speculative unity, because it only covertly posits the non-identity of its own determinations.","refs":["CH_GB18_ANM2:A5","CH_GB18_ANM2:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-06","text":"The contradiction between the proposition of identity and posited difference is not eliminated, but made productive as the self-dissolution of the proposition into movement.","refs":["CH_GB18_ANM2:AS3","CH_GB18_ANM2:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-07","text":"Actual determinacy does not arise at the level of pure poles, but only as Daseyn, in which content and relation generate differences.","refs":["CH_GB18_ANM1:A8","CH_GB18_ANM2:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BS-08","text":"The movement is spiral-shaped: abstraction withdraws content, the withdrawal destroys stable difference, self-dissolution generates Becoming, and Becoming first opens the sphere of determinate mediation.","refs":["CH_GB18_ANM1:FGS3","CH_GB18_ANM1:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_04:GA-01","text":"[Persistent] Pure Being and pure Nothing possess no immanent positive determinacy from which their difference could arise as a property of either pole.","refs":["CH_GB18_ANM2:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-02","text":"[Persistent] The truth of both pure determinations lies exclusively in their mutual transition, not in an external relation of fully constituted objects.","refs":["CH_GB18_1EDS:A4","CH_GB18_ANM1:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-03","text":"[Mutating] Identity is valid only as identity-in-difference; absolute distinctness and inseparability are not alternatives, but reciprocal conditions.","refs":["CH_GB18_1EDS:A6","CH_GB18_1EDS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-04","text":"[Attractor] Becoming is neither a result after a completed transition nor a third resting object, but the unity of enactment, result, and the continued non-independence of the moments.","refs":["CH_GB18_1EDS:SD4","CH_GB18_ANM2:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-05","text":"[Mutating] Contradiction is not an external defect of thought, but the immanent form in which a one-sided determination transfers its inadequacy into movement.","refs":["CH_GB18_ANM2:AS3","CH_GB18_ANM2:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-06","text":"[Emergent] Real difference belongs to determinate Daseyn, to its content and its relations; it must not be retroactively smuggled into pure Being-and-Nothing determinations.","refs":["CH_GB18_ANM1:A7","CH_GB18_ANM1:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-07","text":"[Persistent] Concrete experience, finite content, and empirical objections cannot directly judge the truth of pure categories, because they already presuppose a higher level of determinacy.","refs":["CH_GB18_ANM1:D3","CH_GB18_ANM1:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GA-08","text":"[Terminal] A single proposition of identity is valid for speculative truth only as a transitional form, because its enactment posits the difference that its predicative shape cannot bear.","refs":["CH_GB18_ANM2:NX3","CH_GB18_ANM2:A7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_04:RMD-01","text":"Being and Nothing recur as stable names, but mutate from seemingly first determinations into non-independent boundary moments of Becoming.","refs":["CH_GB18_1EDS:A1","CH_GB18_ANM2:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RMD-02","text":"Difference mutates from the assertion of absolute distinctness into a difference that subsists only in transition and is neither definable nor stabilizable outside Becoming.","refs":["CH_GB18_1EDS:A6","CH_GB18_ANM2:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RMD-03","text":"Nothing shifts from a pure, contentless negation to a determination whose concrete efficacy first appears in Daseyn as the relation of Something and Other.","refs":["CH_GB18_ANM1:A2","CH_GB18_ANM1:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RMD-04","text":"Identity shifts from an ontological assertion to a problem of the form of expression: judgment presupposes the difference that its predicative unity conceals.","refs":["CH_GB18_ANM2:A5","CH_GB18_ANM2:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RMD-05","text":"Determinacy initially appears as excluded and subsequently returns as the result of reciprocal mediation; it is not found, but generated through the failure of pure independence.","refs":["CH_GB18_ANM1:AS5","CH_GB18_ANM2:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_04:CGD-01","text":"The equation of pure determinations with Becoming scales to the cluster level, because it organizes both the ontological movement and the critique of its form of expression.","refs":["CH_GB18_1EDS:ME3","CH_GB18_ANM2:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:CGD-02","text":"The analysis of possible and actual objects remains local, but acquires a higher-order function as a boundary marker between determination of content and the mere assertion of existence.","refs":["CH_GB18_ANM1:D6","CH_GB18_ANM1:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:CGD-03","text":"The distinction between finite things and God remains a local metaphysical special determination, but cannot be generalized into the general structure of pure negation or Becoming.","refs":["CH_GB18_ANM1:AS6","CH_GB18_ANM1:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:CGD-04","text":"The analogy of light and darkness is locally interchangeable; its higher-order function consists solely in delimiting the condition of reciprocal determination against pure emptiness.","refs":["CH_GB18_ANM2:A10","CH_GB18_ANM2:NX7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_04:GNX-01","text":"Excluded is a Being that possesses its truth without Nothing, just as is a Nothing that persists as an independent counter-pole outside Being.","refs":["CH_GB18_1EDS:SNX1","CH_GB18_1EDS:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GNX-02","text":"Excluded is a temporal or substantial carrier medium in which Being and Nothing could subsist as successively occurring states.","refs":["CH_GB18_ANM1:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GNX-03","text":"Excluded is a unity that extinguishes difference through indifference, indistinctness, or mere abstraction.","refs":["CH_GB18_1EDS:NX3","CH_GB18_ANM2:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GNX-04","text":"Excluded is the transfer of determinate contents, empirical objects, or sensible images into the analysis of pure categories.","refs":["CH_GB18_ANM1:DNX1","CH_GB18_ANM2:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:GNX-05","text":"Excluded is a form of cognition that could exhaust truth through external comparison or through the fixation of a single proposition.","refs":["CH_GB18_ANM2:NX5","CH_GB18_ANM2:DNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_04:DBN-01","text":"The system holds only if no pre-mediated ontological ground is admitted that provides Being, Nothing, or difference as a fixed first.","refs":["CH_GB18_ANM2:DNX1","CH_GB18_ANM2:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:DBN-02","text":"The system holds only if difference is not thought as a positive property of isolated poles, but as a negative condition of their non-independence.","refs":["CH_GB18_ANM2:NX6","CH_GB18_ANM2:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:DBN-03","text":"The system holds only if no linguistic formula is treated as the final possession of speculative truth.","refs":["CH_GB18_ANM2:SNX2","CH_GB18_ANM2:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_04:BSA-01","text":"Unavailable is a resting beginning that could function as an ontologically secured origin prior to negation, transition, and mediation.","refs":["CH_GB18_ANM2:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BSA-02","text":"Unavailable is a final fixation of a moment, because every moment remains determined only under the condition of its immediate disappearance.","refs":["CH_GB18_1EDS:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BSA-03","text":"Not permissible is a reality in which positive determinacy would be present prior to or outside reciprocal mediation.","refs":["CH_GB18_ANM2:SD4","CH_GB18_ANM2:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_04:XD-01","text":"The emptying of content and relation is not a merely negative abstraction, but the operation that withdraws the independence of pure poles and compels their truth as transition.","refs":["CL_GB18_04:GA-01","CL_GB18_04:GA-02","CH_GB18_ANM1:AS2","CH_GB18_1EDS:AS2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_04:XD-02","text":"The difference occurring in the proposition does not confirm the untruth of unity, but shows that truth can subsist only as the self-transcendence of its own form of expression.","refs":["CL_GB18_04:GA-03","CL_GB18_04:GA-05","CL_GB18_04:GA-08","CH_GB18_ANM2:AS3","CH_GB18_1EDS:AS4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_04:XD-03","text":"Daseyn is neither an empirical counterproof against pure unity nor a subsequent addition, but the necessary sphere in which the determinacy excluded through pure abstraction returns as relation.","refs":["CL_GB18_04:GA-06","CL_GB18_04:GA-07","CH_GB18_ANM1:A8","CH_GB18_ANM2:D5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_04:XD-04","text":"The temporality of the system is logical and not chronological: the movement is accomplished precisely because its moments remain determined only in continued reversal.","refs":["CL_GB18_04:GA-04","CL_GB18_04:GA-08","CH_GB18_1EDS:AS3","CH_GB18_1EDS:SD4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_04:BSD-01","text":"At this level, reality appears not as an aggregation of existent units, but as a self-differentiating condition in which every determinate thing subsists only through its negation and mediation.","refs":["CH_GB18_ANM2:SD2","CH_GB18_ANM1:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BSD-02","text":"Cognition is reorganized as a discipline of difference in levels: neither concrete experience nor pure abstraction may usurp the function of the other level.","refs":["CH_GB18_ANM1:SD4","CH_GB18_ANM1:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BSD-03","text":"For speculative truth, language possesses no neutral status of presentation, because the form of its statement simultaneously posits and conceals the excess of the object.","refs":["CH_GB18_ANM2:A5","CH_GB18_ANM2:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:BSD-04","text":"The ontological beginning loses every form of resting originality and is determined as retrospectively readable movement, in which result and enactment do not diverge.","refs":["CH_GB18_1EDS:SD4","CH_GB18_ANM2:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_04:RLE-01","text":"The first loop is as follows: emptying of content generates indistinguishability; indistinguishability destroys the independence of the poles; this destruction appears as Becoming.","refs":["CH_GB18_ANM1:FGS2","CH_GB18_ANM1:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RLE-02","text":"The second loop is as follows: the proposition of identity posits difference; the posited difference contradicts its form; contradiction leads the proposition back into the movement it cannot express.","refs":["CH_GB18_ANM2:A7","CH_GB18_ANM2:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RLE-03","text":"The third loop is as follows: concrete objections to pure unity are recognized as changes of level; this change of level refers to Daseyn; Daseyn confirms the necessity of the preceding abstraction.","refs":["CH_GB18_ANM1:D3","CH_GB18_ANM1:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:RLE-04","text":"Becoming acts as a conceptual attractor because identity, difference, negation, judgment, and determinacy are each stabilized only through return into its structure of movement.","refs":["CH_GB18_ANM1:A12","CH_GB18_ANM2:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_04:FGS-B01","text":"Abstraction from content, relation, and substrate → pure indeterminacy of the poles.","refs":["CH_GB18_ANM1:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FGS-B02","text":"Pure indeterminacy → impossibility of an immanent positive difference.","refs":["CH_GB18_ANM2:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FGS-B03","text":"Judgment-shaped identity → co-positing of repressed non-identity → self-contradiction of the form of statement.","refs":["CH_GB18_ANM2:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FGS-B04","text":"Self-contradiction without external resolution → immanent disappearance of the isolated determinations → Becoming.","refs":["CH_GB18_ANM2:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FGS-B05","text":"Becoming as unity of difference and inseparability → mediated determinacy → Daseyn as the sphere of real contents and relations.","refs":["CH_GB18_ANM2:FGS4","CH_GB18_ANM1:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_04:AFM-B01","text":"Withdrawal of determinate contents and relations → pure Being-and-Nothing determinations without immanent positive difference.","refs":["CH_GB18_ANM1:FGS1","CH_GB18_ANM2:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:AFM-B02","text":"Impossibility of stable difference → inadequacy of mere identity → truth as mutual having-passed-over.","refs":["CH_GB18_1EDS:D1","CH_GB18_1EDS:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:AFM-B03","text":"Judgment-shaped fixation of unity → emergence into visibility of repressed difference → immanent self-contradiction.","refs":["CH_GB18_ANM2:AS2","CH_GB18_ANM2:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:AFM-B04","text":"Self-contradiction → Becoming → Daseyn → reordering of concrete objections into the sphere of content, relation, and finitude.","refs":["CH_GB18_ANM2:AS3","CH_GB18_ANM1:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_04:MME-01","text":"Truth is remapped from an isolated object onto a relation of self-reversal; Being is no longer intelligible without its immanent negation.","refs":["CH_GB18_1EDS:ME1","CH_GB18_1EDS:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MME-02","text":"Identity and difference lose their status as mutually exclusive logical alternatives and become readable as co-originary moments of a movement.","refs":["CH_GB18_1EDS:SD2","CH_GB18_ANM2:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MME-03","text":"The opposition between abstract logic and concrete actuality is replaced by an architecture of levels in which Daseyn functions as a zone of mediation.","refs":["CH_GB18_ANM1:ME2","CH_GB18_ANM1:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MME-04","text":"The appropriate form of reading shifts from the extraction of individual doctrinal propositions to the reconstruction of their necessary counter-movement and self-dissolution.","refs":["CH_GB18_ANM2:D2","CH_GB18_ANM2:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_04:ALT-B01","text":"Surface level — The system treats Being, Nothing, Becoming, Daseyn, and the inadequacy of an equation in the form of judgment.","refs":["CH_GB18_ANM2:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:ALT-B02","text":"Structural level — The system organizes pure abstraction, mediated determinacy, content, and relation as logical levels irreducible to one another.","refs":["CH_GB18_ANM1:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:ALT-B03","text":"Metastrategic level — The system neutralizes objections not by refuting individual examples, but by diagnosing the respective change of level.","refs":["CH_GB18_ANM1:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:ALT-B04","text":"Ontological / Temporal level — Reality is determined as Becoming, whose temporality is not a succession of external states, but accomplished self-mediation.","refs":["CH_GB18_ANM2:ALT4","CH_GB18_1EDS:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:ALT-B05","text":"Methodological / Performative level — The presentation enacts its thesis by not correcting the proposition of identity, but allowing it to disintegrate at its immanent contradiction.","refs":["CH_GB18_ANM2:AS3","CH_GB18_ANM2:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_04:FL-01","text":"The architecture requires both absolute distinctness and the impossibility of an immanent positive determination of this difference; this tension remains productive only if difference is read as a moment of movement rather than as a property.","refs":["CH_GB18_1EDS:A6","CH_GB18_ANM2:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FL-02","text":"The movement is determined as already accomplished, while its moments simultaneously subsist only in continued passing-over; the temporal form of the system therefore remains logically necessary, but not fully explicated.","refs":["CH_GB18_1EDS:AS3","CH_GB18_1EDS:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FL-03","text":"The immanence of Becoming requires that contradiction dissolve itself, yet its cognition seems to presuppose a reflecting instance whose status remains indeterminate.","refs":["CH_GB18_ANM2:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:FL-04","text":"The exception of an inseparable unity of concept and Being in God stands in tension with the general thesis that actuality is determined only as an unstable unity of positivity and negativity.","refs":["CH_GB18_ANM1:A11","CH_GB18_ANM1:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MP-01","text":"The proposition of identity mutates from an apparent foundational assertion into a mechanism that generates the necessity of its own transcendence.","refs":["CH_GB18_ANM2:AS1","CH_GB18_ANM2:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MP-02","text":"Negation mutates from pure contentlessness into a condition of determinate reality as soon as it returns in Daseyn as the relation of Something and Other.","refs":["CH_GB18_ANM1:A2","CH_GB18_ANM1:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MP-03","text":"The language of judgment mutates from an asserted medium of truth into a performative site at which the inadequacy of isolated predication becomes visible.","refs":["CH_GB18_ANM2:A5","CH_GB18_ANM2:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_04:HSI-01","text":"Reality appears as a machine of reciprocal self-sublation, in which no moment is determined through self-subsistence, but only through its transition into its other.","refs":["CH_GB18_1EDS:A8","CH_GB18_1EDS:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:HSI-02","text":"The subject appears not as an external comparer of finished objects, but as an instance that either confuses levels or retraces the immanent movement of its determinations.","refs":["CH_GB18_ANM2:DNX3","CH_GB18_ANM2:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:HSI-03","text":"Time appears as the logical present of having-passed-over: not an event occurs between fixed poles, but the poles are only as the enactment of their disappearance.","refs":["CH_GB18_1EDS:D5","CH_GB18_ANM2:A9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_04:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from pure indeterminacy through the contradiction of the form of judgment to Becoming and onward to the sphere of Daseyn.","refs":["CH_GB18_ANM1:MRT1","CH_GB18_ANM2:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MRT-B02","text":"It remains underdetermined why the indistinguishability of pure determinations necessarily generates movement rather than merely formal equality.","refs":["CH_GB18_ANM1:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MRT-B03","text":"The architecture is strongest where it diagnoses concrete objections as concealed changes of level and demonstrates the form of judgment to be an inadequate container-form for speculative truth.","refs":["CH_GB18_ANM1:MRT4","CH_GB18_ANM2:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_04:MRT-B04","text":"The reconstruction remains coherent only if Becoming is read neither as a third resting determination nor as a mere synthesis of already finished entities.","refs":["CH_GB18_ANM2:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_04@R001","source_variant_id":"canonical:CL_GB18_04:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 10–12","context":"1. Einheit des Seyns und Nichts. · Anmerkung 1. · Anmerkung 2."},"title_language_code":"en"},{"id":"CL_GB18_05","layer":"CL","title":"Chapters 13–15","order":5,"parents":["CH_GB18_ANM3","CH_GB18_ANM4","CH_GB18_2MDW"],"revision":"CL_GB18_05@R001","sha256":"801138b292b7b3f60cfe470665475aa4152c1b5145fa1bf2a4a0996920aded36","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_05:AS-B01","text":"Das zentrale Problem besteht darin, die Einheit von Seyn und Nichts zu bestimmen, ohne ihre Differenz zu tilgen oder sie als selbständige Pole festzuhalten.","refs":["CH_GB18_2MDW:AS1","CH_GB18_ANM4:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B02","text":"Werden ist die Wahrheit von Seyn und Nichts, weil beide nur als aufgehobene Momente ihrer gemeinsamen Bewegung Bestand haben.","refs":["CH_GB18_ANM3:AS2","CH_GB18_ANM4:AS6","CH_GB18_2MDW:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B03","text":"Das Argument wird zur immanenten Dialektik, indem es nicht äußere Gegenbehauptungen aufstellt, sondern die fixierten Bestimmungen aus ihren eigenen Voraussetzungen in Bewegung setzt.","refs":["CH_GB18_ANM3:AS3","CH_GB18_ANM4:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B04","text":"Die Bewegung führt von abstrakter Trennung über die widersprüchliche Zulassung von Anfang und Aufhören zur Herabsetzung der Gegensätze zu Momenten.","refs":["CH_GB18_ANM3:A3","CH_GB18_ANM4:D4","CH_GB18_2MDW:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B05","text":"Der Fortgang ist rekursiv und mutationsgetrieben, weil jede Bestimmung durch ihre eigene Negativität in das Gegenteil umschlägt, aus dem sie erneut bestimmt wird.","refs":["CH_GB18_ANM3:A6","CH_GB18_2MDW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B06","text":"Kosmologischer Anfang, Aufhören und unendlich-kleine Größen fungieren als verschiedenartige Austragungsorte derselben unhaltbaren Trennung von Seyn und Nichts.","refs":["CH_GB18_ANM4:AS4","CH_GB18_ANM4:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B07","text":"Die zunächst unmittelbare Bewegung differenziert sich in Entstehen und Vergehen, deren gegenläufige Richtungen durch ihre wechselseitige Durchdringung eine Bewegung bilden.","refs":["CH_GB18_2MDW:A6","CH_GB18_2MDW:A9","CH_GB18_2MDW:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B08","text":"Die Schließung ist dynamisch statt terminal-statisch: Es bleibt keine Position außerhalb des Übergangs, während die Gegenrichtungen im Werden als Gesamtbewegung geschlossen werden.","refs":["CH_GB18_2MDW:SNX1","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_05:GA-01","text":"[Persistent] Seyn und Nichts sind nicht selbständig, sondern bestehen nur als verschwindende und aufgehobene Momente des Werdens.","refs":["CH_GB18_ANM3:A1","CH_GB18_2MDW:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-02","text":"[Persistent] Die absolute Trennung von Seyn und Nichts wird durch Abstraktion und reflexive Fixierung erzeugt, nicht durch die immanente Verfassung ihrer Bestimmungen.","refs":["CH_GB18_ANM3:A3","CH_GB18_ANM4:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-03","text":"[Persistent] Dialektische Geltung entsteht aus der immanenten Bewegung der Bestimmungen und nicht aus einer äußerlich festgesetzten Voraussetzung.","refs":["CH_GB18_ANM3:AS3","CH_GB18_ANM4:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-04","text":"[Mutating] Der zunächst unmittelbare und unvermittelte Übergang mutiert zur gegliederten Einheit gegenläufiger Richtungen.","refs":["CH_GB18_ANM3:A10","CH_GB18_2MDW:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-05","text":"[Emergent] Die Einheit von Seyn und Nichts ist bestimmt, weil sie ihre Differenz erhält, während sie die Selbständigkeit der unterschiedenen Bestimmungen aufhebt.","refs":["CH_GB18_2MDW:A2","CH_GB18_2MDW:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-06","text":"[Emergent] Die ungleiche Unmittelbarkeit der Momente erzeugt zwei Richtungen: den Übergang von Nichts in Seyn und den Übergang von Seyn in Nichts.","refs":["CH_GB18_2MDW:A6","CH_GB18_2MDW:A7","CH_GB18_2MDW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-07","text":"[Attractor] Jede Richtung enthält ihre Gegenrichtung als eigene innere Bewegung und hebt sich dadurch in ihr Gegenteil auf.","refs":["CH_GB18_2MDW:A10","CH_GB18_2MDW:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-08","text":"[Emergent] Anfang und Aufhören setzen die Ungetrenntheit von Seyn und Nichts voraus und werden unter ihrer absoluten Trennung unmöglich.","refs":["CH_GB18_ANM4:A7","CH_GB18_ANM4:D1","CH_GB18_ANM4:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-09","text":"[Mutating] Negativität mutiert von vermeintlicher Abwesenheit zur affirmativen Bestimmtheit und schließlich zur Form des verschwindenden, erhaltenen Moments.","refs":["CH_GB18_ANM3:A7","CH_GB18_2MDW:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-10","text":"[Terminal] Werden ist der Attraktor und Abschluss dieser Architektur: die Wahrheit der nichtselbständigen Momente und die identische Gesamtbewegung ihrer Umkehrungen.","refs":["CH_GB18_ANM3:A2","CH_GB18_ANM4:A8","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_05:RMD-01","text":"Die Benennungen Seyn und Nichts bleiben stabil, während ihre Funktion von vermeintlich reinen Ersten zu unselbständigen Momenten einer Bewegung mutiert.","refs":["CH_GB18_ANM3:A1","CH_GB18_2MDW:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-02","text":"Einheit kehrt funktional verändert wieder: Aus der zunächst behaupteten Wahrheit beider Momente wird eine bestimmte Einheit, die Differenz einschließt.","refs":["CH_GB18_ANM3:A2","CH_GB18_2MDW:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-03","text":"Übergang erweitert seinen Geltungsbereich vom unmittelbaren Umschlagen zwischen Seyn und Nichts zur Richtungsdifferenz von Entstehen und Vergehen.","refs":["CH_GB18_ANM3:A10","CH_GB18_2MDW:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-04","text":"Anfang und Aufhören kehren valenzverkehrt wieder: Als isolierte Ereignisse sind sie unmöglich, als interne Phasen des Übergangs werden sie notwendig.","refs":["CH_GB18_ANM4:D1","CH_GB18_ANM4:D2","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-05","text":"Negativität wandert von der abstrakten Bestimmung der Unbestimmtheit in die konkrete Form der verschwindenden und aufgehobenen Momente.","refs":["CH_GB18_ANM3:A6","CH_GB18_2MDW:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-06","text":"Das Dasselbe wird nicht als unterschiedslose Identität stabilisiert, sondern in die Identität entgegengesetzter Richtungen verschoben.","refs":["CH_GB18_ANM4:MRT6","CH_GB18_2MDW:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-07","text":"Das Unbegreifliche erfährt eine Umkehrung: Es bezeichnet nicht länger die Beschaffenheit des Gegenstands, sondern die Wirkung einer widersprüchlichen Voraussetzung.","refs":["CH_GB18_ANM4:AS3","CH_GB18_ANM4:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-08","text":"Die unendlich-kleine Größe verrichtet lokale Beweisarbeit als Größe im Verschwinden und wird anschließend in die allgemeine Übergangslogik absorbiert.","refs":["CH_GB18_ANM4:A9","CH_GB18_ANM4:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_05:CGD-01","text":"Die Zuordnung einzelner philosophischer Positionen zu Varianten reflexiver Fixierung bleibt lokal; nach oben skaliert allein der Mechanismus der Fixierung selbst.","refs":["CH_GB18_ANM3:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:CGD-02","text":"Reiner Raum, reine Zeit und reines Bewusstsein bleiben empirische Gegenfälle der unteren Ebene; auf Clusterebene zählt nur die asymmetrische Funktion solcher Fälle, Abstraktionen zu destabilisieren, ohne Notwendigkeit zu begründen.","refs":["CH_GB18_ANM3:NX5","CH_GB18_ANM3:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:CGD-03","text":"Die mathematische Verwendbarkeit unendlich-kleiner Größen bleibt ein lokaler Bestätigungsfall und wird nicht zur Grundlage der dialektischen Architektur erhoben.","refs":["CH_GB18_ANM4:D8","CH_GB18_ANM4:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:CGD-04","text":"Die Kritik abstrakter Trennung skaliert, weil sie über alle Eingabeeinheiten hinweg die immanente Wahrheit des Werdens organisiert.","refs":["CH_GB18_ANM3:A3","CH_GB18_ANM4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:CGD-05","text":"Entstehen und Vergehen sind zunächst lokale Ausdifferenzierungen des Werdens, liefern auf Clusterebene aber die terminale Form seiner identischen Gesamtbewegung.","refs":["CH_GB18_2MDW:A9","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:CGD-06","text":"Das lokale Verbot, den ersten Übergang durch Grund oder Ursache zu vermitteln, skaliert zur allgemeinen methodischen Forderung, Bewegung aus den Bestimmungen selbst hervorgehen zu lassen.","refs":["CH_GB18_ANM3:NX7","CH_GB18_ANM4:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_05:GNX-01","text":"Seyn und Nichts dürfen nicht als selbständige und vollständig isolierte Gegenstände angesetzt werden. ; Trace Type — Negative","refs":["CH_GB18_ANM3:NX1","CH_GB18_ANM4:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GNX-02","text":"Werden darf weder als nachträgliche Verbindung noch als statischer Mittelzustand zwischen fertigen Polen verstanden werden. ; Trace Type — Negative","refs":["CH_GB18_ANM3:NX4","CH_GB18_ANM4:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GNX-03","text":"Ein reines Erstes darf weder als fortgangsfähiger Ursprung noch durch einen äußeren Zusatz produktiv gemacht werden. ; Trace Type — Negative","refs":["CH_GB18_ANM3:A4","CH_GB18_ANM3:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GNX-04","text":"Die binäre Klassifikation eines Gegenstands als vollständig seiend oder vollständig nichtig ist für Übergangsbestimmungen ausgeschlossen. ; Trace Type — Negative","refs":["CH_GB18_ANM4:NX5","CH_GB18_ANM4:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GNX-05","text":"Weder feste Erklärungskategorien noch die Benennung eines Widerspruchs als unbegreiflich dürfen die immanente Rekonstruktion des Übergangs ersetzen. ; Trace Type — Negative","refs":["CH_GB18_ANM3:A9","CH_GB18_ANM4:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_05:DBN-01","text":"Damit das System Bestand hat, muss eine Ontologie vollständig isolierter Bestimmungen falsch sein; andernfalls gäbe es keine Position, von der aus Übergang überhaupt konstituiert werden könnte. ; Trace Type — Negative","refs":["CH_GB18_ANM4:DNX1","CH_GB18_2MDW:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:DBN-02","text":"Ausgeschlossen ist ein äußeres Metaniveau, das die Bewegung mit bereits fixierten Kategorien erklärt, statt sie aus den Bestimmungen hervorgehen zu lassen. ; Trace Type — Negative","refs":["CH_GB18_ANM3:DNX4","CH_GB18_ANM4:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:DBN-03","text":"Eine lineare Ordnung diskreter Anfänge, Enden und Übergänge ist unzulässig, weil Bewegung, Entstehung und Verschwinden dieselbe Übergangsstruktur artikulieren. ; Trace Type — Negative","refs":["CH_GB18_ANM4:DNX2","CH_GB18_ANM4:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:DBN-04","text":"Identität und Differenz dürfen nicht zu unabhängigen Prinzipien abstrahiert werden, weil erst ihre Ko-Konstitution die bestimmte Einheit des Werdens erzeugt. ; Trace Type — Negative","refs":["CH_GB18_2MDW:SNX3","CH_GB18_2MDW:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_05:BSA-01","text":"Nicht verfügbar ist eine reine Präsenz oder reine Abwesenheit, die von Negation, Beziehung und Bestimmung unberührt bliebe. ; Trace Type — Negative","refs":["CH_GB18_ANM3:DNX1","CH_GB18_ANM3:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:BSA-02","text":"Die tiefste ausgeschlossene Möglichkeit ist ein ontologischer Standpunkt außerhalb des Übergangs, von dem ein reiner Anfang ohne schon enthaltene Gegenbewegung gesetzt werden könnte. ; Trace Type — Negative","refs":["CH_GB18_2MDW:SNX1","CH_GB18_2MDW:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:BSA-03","text":"Es gibt keinen neutralen Bereich unterhalb oder zwischen Seyn und Nichts; jede solche Neutralität würde Werden erneut zu einem statischen dritten Zustand machen. ; Trace Type — Negative","refs":["CH_GB18_ANM4:SNX3","CH_GB18_ANM4:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_05:XD-01","text":"Ein Anfang kann nicht zugleich rein und produktiv sein; sobald er wirklich beginnt, erweist er sich als interne Phase einer schon wirksamen Übergangsstruktur. ; Trace Type — Composite","refs":["CL_GB18_05:GA-04","CL_GB18_05:GA-08","CL_GB18_05:GA-10","CH_GB18_ANM3:A4","CH_GB18_ANM4:A7","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:XD-02","text":"Bestimmtheit gehört nicht ausschließlich dem stabil Vorhandenen an, sondern kann gerade in affirmativer Negativität, Verschwinden und Aufhebung bestehen. ; Trace Type — Composite","refs":["CL_GB18_05:GA-05","CL_GB18_05:GA-09","CH_GB18_ANM3:A7","CH_GB18_ANM4:A9","CH_GB18_2MDW:A4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:XD-03","text":"Die immanente Synthesis ist eine dynamisch differenzierte Einheit: Sie ist weder äußere Verknüpfung noch statischer dritter Zustand, sondern erzeugt interne Asymmetrie. ; Trace Type — Composite","refs":["CL_GB18_05:GA-04","CL_GB18_05:GA-05","CL_GB18_05:GA-06","CH_GB18_ANM3:A5","CH_GB18_ANM4:NX6","CH_GB18_2MDW:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:XD-04","text":"Weil äußere Vermittlungen den anfänglichen Übergang bereits voraussetzen, kann Bewegung nur durch die immanente Selbstumkehrung ihrer Bestimmungen erzeugt werden. ; Trace Type — Negative","refs":["CL_GB18_05:GA-03","CL_GB18_05:GA-04","CL_GB18_05:GA-07","CH_GB18_ANM3:NX7","CH_GB18_ANM4:A12","CH_GB18_2MDW:FGS7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:XD-05","text":"Unbegreiflichkeit wird zum diagnostischen Index reflexiver Fixierung: Sie entsteht, wenn Bewegung anerkannt, ihre begriffliche Bedingung aber ausgeschlossen wird. ; Trace Type — Tension","refs":["CL_GB18_05:GA-02","CL_GB18_05:GA-08","CH_GB18_ANM3:A9","CH_GB18_ANM4:AS3","CH_GB18_ANM4:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:XD-06","text":"Empirische und mathematische Fälle können die binäre Ontologie operativ erschüttern, doch die Notwendigkeit des Werdens entsteht erst aus der inneren Ableitung der Gegenrichtung. ; Trace Type — Composite","refs":["CL_GB18_05:GA-03","CL_GB18_05:GA-07","CL_GB18_05:GA-10","CH_GB18_ANM3:A8","CH_GB18_ANM4:D8","CH_GB18_2MDW:MRT4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_05:BSD-01","text":"Realität erhält auf dieser Ebene den Status eines selbstbewegten Prozesses, in dem Gegensätze nur als aufgehobene und ineinander übergehende Bestimmungen wirklich sind. ; Trace Type — Composite","refs":["CL_GB18_05:GA-01","CL_GB18_05:GA-05","CL_GB18_05:GA-10","CH_GB18_ANM4:SD2","CH_GB18_2MDW:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:BSD-02","text":"Zeitlichkeit wird weder als lineare Folge stabiler Zustände noch als Folge absoluter Anfänge bestimmt, sondern als gerichtete und intern umkehrende Phasenstruktur. ; Trace Type — Composite","refs":["CL_GB18_05:GA-06","CL_GB18_05:GA-07","CL_GB18_05:GA-08","CH_GB18_2MDW:SD3","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:BSD-03","text":"Erkenntnis ist nicht die Anwendung fester Prädikate auf einen unbewegten Gegenstand, sondern die Rekonstruktion der Bewegung, durch die Bestimmungen ihr Ausgeschlossenes erzeugen. ; Trace Type — Composite","refs":["CL_GB18_05:GA-02","CL_GB18_05:GA-03","CH_GB18_ANM3:SD2","CH_GB18_ANM4:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:BSD-04","text":"Das reflektierende Subjekt verliert die Stellung eines souveränen Außenpunkts und erscheint als Operation, die Untrennbares abstrahiert, fixiert oder seiner immanenten Bewegung folgt. ; Trace Type — Composite","refs":["CL_GB18_05:GA-02","CL_GB18_05:GA-03","CH_GB18_ANM3:A3","CH_GB18_ANM3:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:BSD-05","text":"Handlungsmacht wird von einem äußeren Verursacher auf die Selbstaufhebung der Bestimmungen verlagert; Wirksamkeit besteht in innerer Umkehrbarkeit statt äußerem Anstoß. ; Trace Type — Composite","refs":["CL_GB18_05:GA-04","CL_GB18_05:GA-07","CH_GB18_ANM3:NX7","CH_GB18_2MDW:D7","CH_GB18_2MDW:ME3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_05:RLE-01","text":"Abstraktion trennt die Momente, Fixierung erklärt sie zu selbständigen Ersten, der Ausschluss des Übergangs erzeugt Stillstand, und dieser Stillstand erzwingt die Wiederkehr des ausgeschlossenen Anderen.","refs":["CH_GB18_ANM3:A3","CH_GB18_ANM3:D4","CH_GB18_ANM3:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RLE-02","text":"Die absolute Trennung macht Anfang und Aufhören unmöglich; ihre faktische Zulassung setzt jedoch Einheit voraus und führt rekursiv zur Kritik der Trennung zurück.","refs":["CH_GB18_ANM4:D1","CH_GB18_ANM4:D2","CH_GB18_ANM4:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RLE-03","text":"Bestimmte Einheit erzeugt asymmetrische Richtungen, jede Richtung hebt sich in die Gegenrichtung auf, und beide schließen sich als identisches Werden zusammen.","refs":["CH_GB18_2MDW:A2","CH_GB18_2MDW:A6","CH_GB18_2MDW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RLE-04","text":"Unbestimmtheit erzeugt Negativität, Negativität erhält affirmative Bestimmtheit, und diese Bestimmtheit besteht nur als Übergang zu ihrem Gegenteil.","refs":["CH_GB18_ANM3:A6","CH_GB18_ANM3:A7","CH_GB18_2MDW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RLE-05","text":"Werden fungiert als begrifflicher Attraktor, auf den kosmologische, mathematische und ontologische Streitfelder als Varianten derselben Übergangslogik konvergieren.","refs":["CH_GB18_ANM4:AS4","CH_GB18_ANM4:ME4","CH_GB18_ANM3:A2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_05:FGS-B01","text":"Abstraktion des jeweils Anderen → Trennung von Seyn und Nichts → reflexive Fixierung beider als selbständige Erste.","refs":["CH_GB18_ANM3:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B02","text":"Fixierung eines reinen Ersten → Ausschluss immanenten Fortgangs → Unmöglichkeit eines wirklichen Anfangs.","refs":["CH_GB18_ANM3:A4","CH_GB18_ANM4:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B03","text":"Gleichzeitige Zulassung von Bewegung → selbst erzeugte Unbegreiflichkeit → Rückführung des Widerspruchs auf seine Voraussetzung.","refs":["CH_GB18_ANM4:AS3","CH_GB18_ANM4:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B04","text":"Analyse der Unbestimmtheit → abstrakte Negativität → Herabsetzung von Seyn und Nichts zu verschwindenden Momenten.","refs":["CH_GB18_ANM3:A6","CH_GB18_2MDW:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B05","text":"Aufhebung der Selbständigkeit → Erhaltung der Differenz → bestimmte Einheit des Werdens.","refs":["CH_GB18_2MDW:A2","CH_GB18_2MDW:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B06","text":"Ungleiche Unmittelbarkeit der Momente → zwei Übergangsrichtungen → Entstehen und Vergehen.","refs":["CH_GB18_2MDW:A6","CH_GB18_2MDW:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B07","text":"Selbstaufhebung jeder Richtung → Umschlag in die Gegenrichtung → identische Gesamtbewegung des Werdens.","refs":["CH_GB18_2MDW:FGS7","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_05:AFM-B01","text":"Behauptete Selbständigkeit der Pole → abstrakte Trennung → Ausschluss des Übergangs → widersprüchliche Wiedereinführung von Anfang und Ende → Kritik der Voraussetzung → bestimmte Einheit → Richtungsdifferenz → Selbstumkehrung → identisches Werden.","refs":["CH_GB18_ANM3:AF1","CH_GB18_ANM4:AF1","CH_GB18_2MDW:AF1","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AFM-B02","text":"Kosmologischer Streit → mathematische Wiederkehr der Trennungslogik → domänenübergreifende Reklassifikation → Unterscheidung äußerer Sophisterei von immanenter Dialektik.","refs":["CH_GB18_ANM4:ME1","CH_GB18_ANM4:ME4","CH_GB18_ANM4:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_05:MME-01","text":"Seyn und Nichts werden von isolierten Gegenständen zu nichtselbständigen und relationalen Momenten einer Bewegung umkartiert.","refs":["CH_GB18_ANM3:ME1","CH_GB18_2MDW:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MME-02","text":"Anfang und Ende verlieren den Status absoluter Grenzen und werden zu Prüfungen beziehungsweise Phasen derselben Übergangsstruktur.","refs":["CH_GB18_ANM4:ME1","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MME-03","text":"Der Gegensatz von Identität und Differenz bricht zusammen, weil beide als ko-konstitutive Bestimmungen des Werdens lesbar werden.","refs":["CH_GB18_2MDW:ME4","CH_GB18_2MDW:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MME-04","text":"Dialektik und Sophisterei werden nicht nach äußerer Schlussform, sondern nach der Herkunft ihrer Bewegung aus fixierter Voraussetzung oder immanenter Bestimmung unterschieden.","refs":["CH_GB18_ANM4:NX7","CH_GB18_ANM4:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MME-05","text":"Negation, Abwesenheit und Verschwinden werden von ontologischen Defiziten zu affirmativen und wirksamen Formen von Bestimmtheit reklassifiziert.","refs":["CH_GB18_ANM3:ME5","CH_GB18_ANM3:A7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_05:ALT-B01","text":"Auf der Oberflächenebene erscheinen Anfang, Aufhören, Entstehen, Vergehen und unendlich-kleine Größen als verschiedene Probleme der Beziehung von Seyn und Nichts.","refs":["CH_GB18_ANM4:ALT1","CH_GB18_2MDW:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:ALT-B02","text":"Auf der Strukturebene werden diese Probleme durch die Aufhebung selbständiger Bestimmungen und ihre Umwandlung in relationale Momente vereinheitlicht.","refs":["CH_GB18_ANM4:ALT2","CH_GB18_2MDW:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:ALT-B03","text":"Auf der metastrategischen Ebene wird die Widerlegung einzelner Aussagen durch die Prüfung ihrer Voraussetzungen und die Rekonstruktion innerer Umkehrbarkeit ersetzt.","refs":["CH_GB18_ANM4:ALT3","CH_GB18_2MDW:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:ALT-B04","text":"Auf der ontologischen und zeitlichen Ebene besteht Realität aus gerichteten, aber intern umkehrenden Übergängen, deren Pole nur als Momente des Werdens gelten.","refs":["CH_GB18_ANM4:ALT4","CH_GB18_2MDW:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:ALT-B05","text":"Auf der methodologischen und performativen Ebene vollzieht die Argumentform selbst den behaupteten Übergang: Sie fixiert Bestimmungen probeweise, lässt die Fixierung scheitern und gewinnt aus diesem Scheitern die Gegenrichtung.","refs":["CH_GB18_ANM3:ALT3","CH_GB18_ANM4:D9","CH_GB18_2MDW:MRT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_05:FL-01","text":"Der Übergang soll unmittelbar und vermittlungsfrei sein, sein Nachweis operiert jedoch durch die reflektierte Bestimmung der Unbestimmtheit als Negativität. ; Trace Type — Tension","refs":["CH_GB18_ANM3:MRT6","CH_GB18_ANM3:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FL-02","text":"Werden wird als von seinen Momenten unterschiedene Einheit benötigt, darf aber nicht zu einem neutralen dritten Bereich oder statischen Mittelzustand verselbständigt werden. ; Trace Type — Tension","refs":["CH_GB18_ANM3:A2","CH_GB18_ANM4:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FL-03","text":"Die Rede von Seyn und Nichts als demselben bleibt instabil gegenüber ihrer Artikulation als unterschiedene, gegenläufige und einander paralysierende Richtungen. ; Trace Type — Tension","refs":["CH_GB18_ANM4:MRT6","CH_GB18_2MDW:A9","CH_GB18_2MDW:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FL-04","text":"Empirische Widerlegung gilt als begrifflich unzureichend, während mathematische Verwendbarkeit dennoch als operative Bestätigung der Übergangsbestimmung eingesetzt wird. ; Trace Type — Tension","refs":["CH_GB18_ANM3:SD5","CH_GB18_ANM4:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FL-05","text":"Die Ableitung der Gegenrichtung hängt von der Behauptung ab, jede Richtung sei an sich selbst ihr Gegenteil; diese Selbstumkehrung wird stärker verwendet als begründet. ; Trace Type — Tension","refs":["CH_GB18_2MDW:MRT5","CH_GB18_2MDW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MP-01","text":"Unbestimmtheit mutiert von vermeintlich reiner Positivität zur abstrakten Negativität und wird dadurch zum Motor des Umschlags. ; Trace Type — Tension","refs":["CH_GB18_ANM3:A6","CH_GB18_ANM3:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MP-02","text":"Einheit mutiert von abstrakter Identität zur bestimmten, asymmetrisch gewichteten Einheit zweier Übergangsrichtungen. ; Trace Type — Tension","refs":["CH_GB18_2MDW:A2","CH_GB18_2MDW:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MP-03","text":"Anfang und Aufhören mutieren von unter absoluter Trennung unmöglichen Ereignissen zu internen Bestimmungen einer Bewegung, in der jeder Anfang bereits Gegenbewegung enthält. ; Trace Type — Tension","refs":["CH_GB18_ANM4:D1","CH_GB18_ANM4:D2","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_05:HSI-01","text":"Die Realität erscheint als selbstbewegte Umkehrmaschine, in der aufgehobene Gegensätze sich in gegenläufige Richtungen differenzieren und als eine Gesamtbewegung schließen.","refs":["CH_GB18_2MDW:SD1","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:HSI-02","text":"Das Subjekt erscheint als Schaltstelle zwischen abstrahierender Fixierung und immanenter Lektüre: Es kann Untrennbares trennen oder die Formen dieser Trennung rekonstruieren.","refs":["CH_GB18_ANM3:ALT2","CH_GB18_ANM3:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:HSI-03","text":"Zeit ist keine Reihe ruhender Gegenwarten, sondern eine bidirektionale Phasenordnung, in der jeder Anfang intern auf sein Gegenteil verweist.","refs":["CH_GB18_2MDW:SD3","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:HSI-04","text":"Der mögliche Kampf besteht nicht in äußerer Beherrschung der Bewegung, sondern in der Unterscheidung zwischen fixierenden Voraussetzungen und der Navigation ihrer inneren Umkehrbarkeit.","refs":["CH_GB18_ANM4:A12","CH_GB18_2MDW:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_05:MRT-B01","text":"Die globalen Axiome reichen aus, um Werden aus der Nichtselbständigkeit und Negativität von Seyn und Nichts sowie aus ihrer Erhaltung als aufgehobene Momente zu rekonstruieren.","refs":["CH_GB18_ANM3:MRT1","CH_GB18_2MDW:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MRT-B02","text":"Unterbestimmt bleiben das Verhältnis zwischen unmittelbarem Übergang und reflektierendem Nachweis sowie die formale Begründung der asymmetrischen Gewichtung der Momente.","refs":["CH_GB18_ANM3:MRT2","CH_GB18_2MDW:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MRT-B03","text":"Die Architektur ist kohärent, sofern Werden weder als äußerer dritter Gegenstand noch als statischer Mittelzustand, sondern als Wahrheit und Übergang seiner Momente verstanden wird.","refs":["CH_GB18_ANM3:MRT3","CH_GB18_ANM4:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MRT-B04","text":"Die stärkste Operation ist die doppelte Umkehrung: Reine Unbestimmtheit wird als Negativität bestimmt, und jede Richtung erzeugt aus sich selbst die Gegenrichtung.","refs":["CH_GB18_ANM3:MRT4","CH_GB18_2MDW:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MRT-B05","text":"Die Rekonstruktion hängt wesentlich von rekursiver Sequenzierung ab: Abstraktion, Selbstwiderspruch und Negativität müssen als aufeinander zurückwirkende Operationen erhalten bleiben.","refs":["CH_GB18_ANM3:MRT9","CH_GB18_ANM3:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MRT-B06","text":"Axiomatischer Reduktion widersteht die Doppelbedeutung der Aufhebung als Negation und Erhaltung, weil gerade diese Spannung die unmittelbare Bewegung in eine bestimmte Einheit überführt.","refs":["CH_GB18_2MDW:MRT3","CH_GB18_ANM3:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120610894562Z_dfb28c2d","language_code":"en","language_name":"English","title":"Chapters 13–15","source_sha256":"801138b292b7b3f60cfe470665475aa4152c1b5145fa1bf2a4a0996920aded36","sha256":"0e2069c11c0271a50c031216ef9e29b4ad5bd0713d0ead422fcb76a6e8ded2c3","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:06:10.895526+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_05:AS-B01","text":"The central problem consists in determining the unity of Being and Nothing without effacing their difference or retaining them as independent poles.","refs":["CH_GB18_2MDW:AS1","CH_GB18_ANM4:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B02","text":"Becoming is the truth of Being and Nothing, because both subsist only as sublated moments of their common movement.","refs":["CH_GB18_ANM3:AS2","CH_GB18_ANM4:AS6","CH_GB18_2MDW:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B03","text":"The argument becomes immanent dialectic by not positing external counterclaims, but setting the fixed determinations in motion from their own presuppositions.","refs":["CH_GB18_ANM3:AS3","CH_GB18_ANM4:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B04","text":"The movement proceeds from abstract separation through the contradictory admission of beginning and ceasing to the reduction of the opposites to moments.","refs":["CH_GB18_ANM3:A3","CH_GB18_ANM4:D4","CH_GB18_2MDW:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B05","text":"The progression is recursive and mutation-driven, because each determination, through its own negativity, turns into its opposite, from which it is determined anew.","refs":["CH_GB18_ANM3:A6","CH_GB18_2MDW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B06","text":"Cosmological beginning, ceasing, and infinitely small magnitudes function as heterogeneous sites of contestation for the same untenable separation of Being and Nothing.","refs":["CH_GB18_ANM4:AS4","CH_GB18_ANM4:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B07","text":"The initially immediate movement differentiates itself into coming-to-be and passing-away, whose contrary directions form one movement through their mutual interpenetration.","refs":["CH_GB18_2MDW:A6","CH_GB18_2MDW:A9","CH_GB18_2MDW:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AS-B08","text":"The closure is dynamic rather than terminal-static: no position remains outside transition, while the contrary directions are closed in Becoming as total movement.","refs":["CH_GB18_2MDW:SNX1","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_05:GA-01","text":"[Persistent] Being and Nothing are not independent, but subsist only as vanishing and sublated moments of Becoming.","refs":["CH_GB18_ANM3:A1","CH_GB18_2MDW:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-02","text":"[Persistent] The absolute separation of Being and Nothing is produced by abstraction and reflective fixation, not by the immanent constitution of their determinations.","refs":["CH_GB18_ANM3:A3","CH_GB18_ANM4:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-03","text":"[Persistent] Dialectical validity arises from the immanent movement of determinations and not from an externally posited presupposition.","refs":["CH_GB18_ANM3:AS3","CH_GB18_ANM4:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-04","text":"[Mutating] The initially immediate and unmediated transition mutates into the articulated unity of contrary directions.","refs":["CH_GB18_ANM3:A10","CH_GB18_2MDW:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-05","text":"[Emergent] The unity of Being and Nothing is determinate because it preserves their difference while sublating the independence of the differentiated determinations.","refs":["CH_GB18_2MDW:A2","CH_GB18_2MDW:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-06","text":"[Emergent] The unequal immediacy of the moments produces two directions: the transition from Nothing into Being and the transition from Being into Nothing.","refs":["CH_GB18_2MDW:A6","CH_GB18_2MDW:A7","CH_GB18_2MDW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-07","text":"[Attractor] Each direction contains its contrary direction as its own inner movement and thereby sublates itself into its opposite.","refs":["CH_GB18_2MDW:A10","CH_GB18_2MDW:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-08","text":"[Emergent] Beginning and ceasing presuppose the inseparability of Being and Nothing and become impossible under their absolute separation.","refs":["CH_GB18_ANM4:A7","CH_GB18_ANM4:D1","CH_GB18_ANM4:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-09","text":"[Mutating] Negativity mutates from supposed absence into affirmative determinacy and finally into the form of the vanishing, preserved moment.","refs":["CH_GB18_ANM3:A7","CH_GB18_2MDW:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GA-10","text":"[Terminal] Becoming is the attractor and conclusion of this architecture: the truth of the non-independent moments and the identical total movement of their reversals.","refs":["CH_GB18_ANM3:A2","CH_GB18_ANM4:A8","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_05:RMD-01","text":"The designations Being and Nothing remain stable, while their function mutates from supposedly pure firsts into non-independent moments of a movement.","refs":["CH_GB18_ANM3:A1","CH_GB18_2MDW:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-02","text":"Unity recurs with a functionally altered role: what was initially asserted as the truth of both moments becomes a determinate unity that includes difference.","refs":["CH_GB18_ANM3:A2","CH_GB18_2MDW:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-03","text":"Transition extends its scope from the immediate reversal between Being and Nothing to the directional difference of coming-to-be and passing-away.","refs":["CH_GB18_ANM3:A10","CH_GB18_2MDW:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-04","text":"Beginning and ceasing recur with reversed valence: as isolated events they are impossible; as internal phases of transition they become necessary.","refs":["CH_GB18_ANM4:D1","CH_GB18_ANM4:D2","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-05","text":"Negativity migrates from the abstract determination of indeterminacy into the concrete form of vanishing and sublated moments.","refs":["CH_GB18_ANM3:A6","CH_GB18_2MDW:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-06","text":"The same is not stabilized as undifferentiated identity, but displaced into the identity of opposed directions.","refs":["CH_GB18_ANM4:MRT6","CH_GB18_2MDW:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-07","text":"The incomprehensible undergoes a reversal: it no longer designates the constitution of the object, but the effect of a contradictory presupposition.","refs":["CH_GB18_ANM4:AS3","CH_GB18_ANM4:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RMD-08","text":"The infinitely small magnitude performs local demonstrative work as a magnitude in vanishing and is subsequently absorbed into the general logic of transition.","refs":["CH_GB18_ANM4:A9","CH_GB18_ANM4:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_05:CGD-01","text":"The assignment of individual philosophical positions to variants of reflective fixation remains local; only the mechanism of fixation itself scales upward.","refs":["CH_GB18_ANM3:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:CGD-02","text":"Pure space, pure time, and pure consciousness remain empirical countercases of the lower level; at the cluster level, only the asymmetric function of such cases matters: destabilizing abstractions without grounding necessity.","refs":["CH_GB18_ANM3:NX5","CH_GB18_ANM3:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:CGD-03","text":"The mathematical usability of infinitely small magnitudes remains a local confirming case and is not elevated into the foundation of the dialectical architecture.","refs":["CH_GB18_ANM4:D8","CH_GB18_ANM4:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:CGD-04","text":"The critique of abstract separation scales because, across all input units, it organizes the immanent truth of Becoming.","refs":["CH_GB18_ANM3:A3","CH_GB18_ANM4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:CGD-05","text":"Coming-to-be and passing-away are initially local differentiations of Becoming, but at the cluster level provide the terminal form of its identical total movement.","refs":["CH_GB18_2MDW:A9","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:CGD-06","text":"The local prohibition against mediating the first transition through ground or cause scales into the general methodological demand to let movement arise from the determinations themselves.","refs":["CH_GB18_ANM3:NX7","CH_GB18_ANM4:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_05:GNX-01","text":"Being and Nothing must not be posited as independent and completely isolated objects. ; Trace Type — Negative","refs":["CH_GB18_ANM3:NX1","CH_GB18_ANM4:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GNX-02","text":"Becoming must be understood neither as a subsequent connection nor as a static intermediate state between finished poles. ; Trace Type — Negative","refs":["CH_GB18_ANM3:NX4","CH_GB18_ANM4:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GNX-03","text":"A pure first must be made productive neither as an origin capable of progression nor through an external addition. ; Trace Type — Negative","refs":["CH_GB18_ANM3:A4","CH_GB18_ANM3:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GNX-04","text":"The binary classification of an object as wholly being or wholly null is excluded for transition determinations. ; Trace Type — Negative","refs":["CH_GB18_ANM4:NX5","CH_GB18_ANM4:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:GNX-05","text":"Neither fixed explanatory categories nor the designation of a contradiction as incomprehensible may replace the immanent reconstruction of transition. ; Trace Type — Negative","refs":["CH_GB18_ANM3:A9","CH_GB18_ANM4:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_05:DBN-01","text":"For the system to subsist, an ontology of completely isolated determinations must be false; otherwise there would be no position from which transition could be constituted at all. ; Trace Type — Negative","refs":["CH_GB18_ANM4:DNX1","CH_GB18_2MDW:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:DBN-02","text":"Excluded is an external meta-level that explains movement with already fixed categories, rather than letting it arise from the determinations. ; Trace Type — Negative","refs":["CH_GB18_ANM3:DNX4","CH_GB18_ANM4:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:DBN-03","text":"A linear order of discrete beginnings, ends, and transitions is inadmissible, because movement, coming-to-be, and vanishing articulate the same transition structure. ; Trace Type — Negative","refs":["CH_GB18_ANM4:DNX2","CH_GB18_ANM4:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:DBN-04","text":"Identity and difference must not be abstracted into independent principles, because only their co-constitution produces the determinate unity of Becoming. ; Trace Type — Negative","refs":["CH_GB18_2MDW:SNX3","CH_GB18_2MDW:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_05:BSA-01","text":"Unavailable is a pure presence or pure absence that would remain untouched by negation, relation, and determination. ; Trace Type — Negative","refs":["CH_GB18_ANM3:DNX1","CH_GB18_ANM3:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:BSA-02","text":"The deepest excluded possibility is an ontological standpoint outside transition from which a pure beginning could be posited without already contained counter-movement. ; Trace Type — Negative","refs":["CH_GB18_2MDW:SNX1","CH_GB18_2MDW:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:BSA-03","text":"There is no neutral domain below or between Being and Nothing; every such neutrality would once again make Becoming into a static third state. ; Trace Type — Negative","refs":["CH_GB18_ANM4:SNX3","CH_GB18_ANM4:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_05:XD-01","text":"A beginning cannot be both pure and productive; as soon as it truly begins, it proves to be an internal phase of an already effective transition structure. ; Trace Type — Composite","refs":["CL_GB18_05:GA-04","CL_GB18_05:GA-08","CL_GB18_05:GA-10","CH_GB18_ANM3:A4","CH_GB18_ANM4:A7","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:XD-02","text":"Determinacy belongs not exclusively to what is stably present, but can consist precisely in affirmative negativity, vanishing, and sublation. ; Trace Type — Composite","refs":["CL_GB18_05:GA-05","CL_GB18_05:GA-09","CH_GB18_ANM3:A7","CH_GB18_ANM4:A9","CH_GB18_2MDW:A4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:XD-03","text":"Immanent synthesis is a dynamically differentiated unity: it is neither external linkage nor a static third state, but produces internal asymmetry. ; Trace Type — Composite","refs":["CL_GB18_05:GA-04","CL_GB18_05:GA-05","CL_GB18_05:GA-06","CH_GB18_ANM3:A5","CH_GB18_ANM4:NX6","CH_GB18_2MDW:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:XD-04","text":"Because external mediations already presuppose the initial transition, movement can be produced only through the immanent self-reversal of its determinations. ; Trace Type — Negative","refs":["CL_GB18_05:GA-03","CL_GB18_05:GA-04","CL_GB18_05:GA-07","CH_GB18_ANM3:NX7","CH_GB18_ANM4:A12","CH_GB18_2MDW:FGS7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:XD-05","text":"Incomprehensibility becomes the diagnostic index of reflective fixation: it arises when movement is acknowledged but its conceptual condition is excluded. ; Trace Type — Tension","refs":["CL_GB18_05:GA-02","CL_GB18_05:GA-08","CH_GB18_ANM3:A9","CH_GB18_ANM4:AS3","CH_GB18_ANM4:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:XD-06","text":"Empirical and mathematical cases can operationally unsettle binary ontology, yet the necessity of Becoming arises only from the inner derivation of the contrary direction. ; Trace Type — Composite","refs":["CL_GB18_05:GA-03","CL_GB18_05:GA-07","CL_GB18_05:GA-10","CH_GB18_ANM3:A8","CH_GB18_ANM4:D8","CH_GB18_2MDW:MRT4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_05:BSD-01","text":"At this level, reality acquires the status of a self-moving process in which opposites are real only as sublated determinations passing over into one another. ; Trace Type — Composite","refs":["CL_GB18_05:GA-01","CL_GB18_05:GA-05","CL_GB18_05:GA-10","CH_GB18_ANM4:SD2","CH_GB18_2MDW:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:BSD-02","text":"Temporality is determined neither as a linear sequence of stable states nor as a sequence of absolute beginnings, but as a directed and internally reversing phase structure. ; Trace Type — Composite","refs":["CL_GB18_05:GA-06","CL_GB18_05:GA-07","CL_GB18_05:GA-08","CH_GB18_2MDW:SD3","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:BSD-03","text":"Cognition is not the application of fixed predicates to an unmoved object, but the reconstruction of the movement through which determinations produce what they exclude. ; Trace Type — Composite","refs":["CL_GB18_05:GA-02","CL_GB18_05:GA-03","CH_GB18_ANM3:SD2","CH_GB18_ANM4:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:BSD-04","text":"The reflecting subject loses the position of a sovereign external point and appears as an operation that abstracts, fixes, or follows the immanent movement of what is inseparable. ; Trace Type — Composite","refs":["CL_GB18_05:GA-02","CL_GB18_05:GA-03","CH_GB18_ANM3:A3","CH_GB18_ANM3:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_05:BSD-05","text":"Agency is shifted from an external causer to the self-sublation of determinations; efficacy consists in inner reversibility rather than external impetus. ; Trace Type — Composite","refs":["CL_GB18_05:GA-04","CL_GB18_05:GA-07","CH_GB18_ANM3:NX7","CH_GB18_2MDW:D7","CH_GB18_2MDW:ME3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_05:RLE-01","text":"Abstraction separates the moments, fixation declares them independent firsts, the exclusion of transition produces stasis, and this stasis compels the return of the excluded other.","refs":["CH_GB18_ANM3:A3","CH_GB18_ANM3:D4","CH_GB18_ANM3:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RLE-02","text":"Absolute separation makes beginning and ceasing impossible; their factual admission, however, presupposes unity and recursively leads back to the critique of separation.","refs":["CH_GB18_ANM4:D1","CH_GB18_ANM4:D2","CH_GB18_ANM4:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RLE-03","text":"Determinate unity produces asymmetric directions, each direction sublates itself into the contrary direction, and both close together as identical Becoming.","refs":["CH_GB18_2MDW:A2","CH_GB18_2MDW:A6","CH_GB18_2MDW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RLE-04","text":"Indeterminacy produces negativity, negativity preserves affirmative determinacy, and this determinacy subsists only as transition to its opposite.","refs":["CH_GB18_ANM3:A6","CH_GB18_ANM3:A7","CH_GB18_2MDW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:RLE-05","text":"Becoming functions as a conceptual attractor upon which cosmological, mathematical, and ontological fields of dispute converge as variants of the same logic of transition.","refs":["CH_GB18_ANM4:AS4","CH_GB18_ANM4:ME4","CH_GB18_ANM3:A2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_05:FGS-B01","text":"Abstraction of the respective other → separation of Being and Nothing → reflective fixation of both as independent firsts.","refs":["CH_GB18_ANM3:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B02","text":"Fixation of a pure first → exclusion of immanent progression → impossibility of a real beginning.","refs":["CH_GB18_ANM3:A4","CH_GB18_ANM4:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B03","text":"Simultaneous admission of movement → self-produced incomprehensibility → reduction of the contradiction to its presupposition.","refs":["CH_GB18_ANM4:AS3","CH_GB18_ANM4:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B04","text":"Analysis of indeterminacy → abstract negativity → reduction of Being and Nothing to vanishing moments.","refs":["CH_GB18_ANM3:A6","CH_GB18_2MDW:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B05","text":"Sublation of independence → preservation of difference → determinate unity of Becoming.","refs":["CH_GB18_2MDW:A2","CH_GB18_2MDW:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B06","text":"Unequal immediacy of the moments → two directions of transition → coming-to-be and passing-away.","refs":["CH_GB18_2MDW:A6","CH_GB18_2MDW:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FGS-B07","text":"Self-sublation of each direction → reversal into the contrary direction → identical total movement of Becoming.","refs":["CH_GB18_2MDW:FGS7","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_05:AFM-B01","text":"Asserted independence of the poles → abstract separation → exclusion of transition → contradictory reintroduction of beginning and end → critique of the presupposition → determinate unity → directional difference → self-reversal → identical Becoming.","refs":["CH_GB18_ANM3:AF1","CH_GB18_ANM4:AF1","CH_GB18_2MDW:AF1","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:AFM-B02","text":"Cosmological dispute → mathematical recurrence of the logic of separation → cross-domain reclassification → distinction of external sophistry from immanent dialectic.","refs":["CH_GB18_ANM4:ME1","CH_GB18_ANM4:ME4","CH_GB18_ANM4:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_05:MME-01","text":"Being and Nothing are remapped from isolated objects into non-independent and relational moments of a movement.","refs":["CH_GB18_ANM3:ME1","CH_GB18_2MDW:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MME-02","text":"Beginning and end lose the status of absolute boundaries and become, respectively, tests and phases of the same transition structure.","refs":["CH_GB18_ANM4:ME1","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MME-03","text":"The opposition of identity and difference collapses because both become legible as co-constitutive determinations of Becoming.","refs":["CH_GB18_2MDW:ME4","CH_GB18_2MDW:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MME-04","text":"Dialectic and sophistry are distinguished not by external inferential form, but by whether their movement originates from a fixed presupposition or an immanent determination.","refs":["CH_GB18_ANM4:NX7","CH_GB18_ANM4:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MME-05","text":"Negation, absence, and vanishing are reclassified from ontological deficiencies into affirmative and effective forms of determinacy.","refs":["CH_GB18_ANM3:ME5","CH_GB18_ANM3:A7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_05:ALT-B01","text":"At the surface level, beginning, ceasing, coming-to-be, passing-away, and infinitely small magnitudes appear as different problems of the relation between Being and Nothing.","refs":["CH_GB18_ANM4:ALT1","CH_GB18_2MDW:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:ALT-B02","text":"At the structural level, these problems are unified through the sublation of independent determinations and their transformation into relational moments.","refs":["CH_GB18_ANM4:ALT2","CH_GB18_2MDW:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:ALT-B03","text":"At the metastrategic level, the refutation of individual statements is replaced by the examination of their presuppositions and the reconstruction of inner reversibility.","refs":["CH_GB18_ANM4:ALT3","CH_GB18_2MDW:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:ALT-B04","text":"At the ontological and temporal level, reality consists of directed but internally reversing transitions, whose poles count only as moments of Becoming.","refs":["CH_GB18_ANM4:ALT4","CH_GB18_2MDW:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:ALT-B05","text":"At the methodological and performative level, the argumentative form itself enacts the asserted transition: it provisionally fixes determinations, lets the fixation fail, and gains the contrary direction from this failure.","refs":["CH_GB18_ANM3:ALT3","CH_GB18_ANM4:D9","CH_GB18_2MDW:MRT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_05:FL-01","text":"Transition is supposed to be immediate and free of mediation, yet its proof operates through the reflected determination of indeterminacy as negativity. ; Trace Type — Tension","refs":["CH_GB18_ANM3:MRT6","CH_GB18_ANM3:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FL-02","text":"Becoming is needed as a unity distinct from its moments, but must not be made independent as a neutral third domain or static intermediate state. ; Trace Type — Tension","refs":["CH_GB18_ANM3:A2","CH_GB18_ANM4:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FL-03","text":"The talk of Being and Nothing as the same remains unstable in relation to their articulation as differentiated, contrary, and mutually paralyzing directions. ; Trace Type — Tension","refs":["CH_GB18_ANM4:MRT6","CH_GB18_2MDW:A9","CH_GB18_2MDW:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FL-04","text":"Empirical refutation is regarded as conceptually insufficient, while mathematical usability is nevertheless employed as operational confirmation of the transition determination. ; Trace Type — Tension","refs":["CH_GB18_ANM3:SD5","CH_GB18_ANM4:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:FL-05","text":"The derivation of the contrary direction depends on the assertion that each direction is in itself its opposite; this self-reversal is used more strongly than it is grounded. ; Trace Type — Tension","refs":["CH_GB18_2MDW:MRT5","CH_GB18_2MDW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MP-01","text":"Indeterminacy mutates from supposedly pure positivity into abstract negativity and thereby becomes the motor of reversal. ; Trace Type — Tension","refs":["CH_GB18_ANM3:A6","CH_GB18_ANM3:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MP-02","text":"Unity mutates from abstract identity into the determinate, asymmetrically weighted unity of two directions of transition. ; Trace Type — Tension","refs":["CH_GB18_2MDW:A2","CH_GB18_2MDW:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MP-03","text":"Beginning and ceasing mutate from events impossible under absolute separation into internal determinations of a movement in which every beginning already contains counter-movement. ; Trace Type — Tension","refs":["CH_GB18_ANM4:D1","CH_GB18_ANM4:D2","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_05:HSI-01","text":"Reality appears as a self-moving reversal machine in which sublated opposites differentiate themselves into contrary directions and close as one total movement.","refs":["CH_GB18_2MDW:SD1","CH_GB18_2MDW:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:HSI-02","text":"The subject appears as a switching point between abstracting fixation and immanent reading: it can separate what is inseparable or reconstruct the forms of this separation.","refs":["CH_GB18_ANM3:ALT2","CH_GB18_ANM3:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:HSI-03","text":"Time is not a series of resting presents, but a bidirectional phase order in which every beginning internally refers to its opposite.","refs":["CH_GB18_2MDW:SD3","CH_GB18_2MDW:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:HSI-04","text":"The possible struggle consists not in external mastery of movement, but in distinguishing between fixing presuppositions and navigating their inner reversibility.","refs":["CH_GB18_ANM4:A12","CH_GB18_2MDW:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_05:MRT-B01","text":"The global axioms suffice to reconstruct Becoming from the non-independence and negativity of Being and Nothing, as well as from their preservation as sublated moments.","refs":["CH_GB18_ANM3:MRT1","CH_GB18_2MDW:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MRT-B02","text":"The relation between immediate transition and reflecting proof, as well as the formal grounding of the asymmetric weighting of the moments, remains underdetermined.","refs":["CH_GB18_ANM3:MRT2","CH_GB18_2MDW:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MRT-B03","text":"The architecture is coherent provided Becoming is understood neither as an external third object nor as a static intermediate state, but as the truth and transition of its moments.","refs":["CH_GB18_ANM3:MRT3","CH_GB18_ANM4:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MRT-B04","text":"The strongest operation is the double reversal: pure indeterminacy is determined as negativity, and each direction produces the contrary direction from itself.","refs":["CH_GB18_ANM3:MRT4","CH_GB18_2MDW:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MRT-B05","text":"The reconstruction depends essentially on recursive sequencing: abstraction, self-contradiction, and negativity must be retained as operations reacting back upon one another.","refs":["CH_GB18_ANM3:MRT9","CH_GB18_ANM3:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_05:MRT-B06","text":"Axiomatic reduction is resisted by the double meaning of sublation as negation and preservation, because this very tension transforms immediate movement into a determinate unity.","refs":["CH_GB18_2MDW:MRT3","CH_GB18_ANM3:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_05@R001","source_variant_id":"canonical:CL_GB18_05:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 13–15","context":"Anmerkung 3. · Anmerkung 4. · 2. Momente des Werdens."},"title_language_code":"en"},{"id":"CL_GB18_06","layer":"CL","title":"Chapters 16–18","order":6,"parents":["CH_GB18_3ADW","CH_GB18_ANME","CH_GB18_DAS0"],"revision":"CL_GB18_06@R001","sha256":"10a011a414a84cd92dde96fd5d5e903b574e5430a8a7750ce861a6b4396d78cc","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_06:AS-01","text":"Das System löst das Problem, wie aus der unbestimmten Einheit von Sein und Nichts durch widersprüchliche Bewegung eine bestimmte Seinsform hervorgeht.","refs":["CH_GB18_3ADW:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-02","text":"Es bestimmt Werden als die wechselseitige Auflösung entgegengesetzter Momente und Aufheben als deren gleichzeitige Negation, Erhaltung und Neubestimmung.","refs":["CH_GB18_3ADW:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-03","text":"Die zentrale These lautet, dass Negation nicht in Leere endet, sondern die Unmittelbarkeit beseitigt und die Bestimmtheit in einer höheren Einheit bewahrt.","refs":["CH_GB18_ANME:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-04","text":"Aus der Selbstwidersprüchlichkeit des Werdens entsteht keine Rückkehr zu Sein oder Nichts, sondern eine ruhige, vermittelte Einheit, die als Daseyn gesetzt wird.","refs":["CH_GB18_3ADW:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-05","text":"Diese Einheit wird anschließend als Qualität bestimmt: Sie ist zugleich Realität und Negation, erzeugt Relation, Veränderlichkeit und Endlichkeit und richtet sich auf ihre eigene Überwindung.","refs":["CH_GB18_DAS0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-06","text":"Die Bewegung ist rekursiv und spiralförmig: Jede erreichte Unmittelbarkeit erweist sich als Resultat einer Vermittlung und eröffnet eine neue Bestimmungsstufe.","refs":["CH_GB18_ANME:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-07","text":"Die Schließung des Clusters ist daher terminal nur relativ: Daseyn und Fürsichseyn stabilisieren die erreichte Form, ohne die generative Negationslogik abzuschaffen.","refs":["CH_GB18_DAS0:A13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_06:GA-01","text":"[Persistent] Sein und Nichts besitzen keine vollständige begriffliche Identität außerhalb ihrer Unterschiedenheit und Vermittlung.","refs":["CH_GB18_3ADW:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-02","text":"[Persistent] Werden ist die wechselseitige Bewegung des Verschwindens von Sein und Nichts und enthält zugleich die Aufhebung dieser Bewegung.","refs":["CH_GB18_3ADW:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-03","text":"[Mutating] Aufheben negiert die unmittelbare Form einer Bestimmung, bewahrt aber ihre Bestimmtheit als Moment einer neuen Einheit.","refs":["CH_GB18_ANME:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-04","text":"[Emergent] Der Widerspruch einer Einheit kann produktiv werden, wenn er die Selbstaufhebung und damit eine resultative Form erzeugt.","refs":["CH_GB18_3ADW:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-05","text":"[Emergent] Das Resultat ist weder bloßes Nichts noch bloßes Sein, sondern eine ruhige Einheit, in der beide als Bestimmungen des Ganzen fortbestehen.","refs":["CH_GB18_3ADW:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-06","text":"[Persistent] Das im Resultat gesetzte Sein ist nicht selbständig, sondern nur als Bestimmung der aufgehobenen Totalität vorhanden.","refs":["CH_GB18_3ADW:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-07","text":"[Emergent] Daseyn ist vermittelte Unmittelbarkeit: eine seiende Einheit, die erst durch die Aufhebung ihrer gegensätzlichen Herkunft möglich wird.","refs":["CH_GB18_3ADW:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-08","text":"[Mutating] Daseyn verwandelt sich von resultativem Sein in qualitativ bestimmtes Sein; Qualität ist dabei zugleich Realität und Negation.","refs":["CH_GB18_DAS0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-09","text":"[Persistent] Qualität bestimmt Etwas nur relational gegenüber einem Anderen und macht es dadurch veränderlich und endlich.","refs":["CH_GB18_DAS0:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-10","text":"[Emergent] Endlichkeit ist keine äußerliche Begrenzung, sondern eine in der qualitativen Bestimmtheit selbst liegende Negativität.","refs":["CH_GB18_DAS0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-11","text":"[Attractor] Die Negation der Endlichkeit erzeugt zunächst den Gegensatz des Unendlichen, der sich anschließend zur gegensatzlosen Unendlichkeit umbildet.","refs":["CH_GB18_DAS0:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-12","text":"[Terminal] Gegenzatzlose Unendlichkeit wird als Fürsichseyn bestimmt, während Daseyn als in sich reflektiertes Etwas erscheint.","refs":["CH_GB18_DAS0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-13","text":"[Attractor] Die höhere Einheit erhält ihre Momente nicht als selbständige Substanzen, sondern als aufgehobene, relationale Bestimmungen.","refs":["CH_GB18_ANME:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_06:RMD-01","text":"Sein und Nichts kehren zunächst als Gegensätze wieder, werden im Werden zu verschwindenden Momenten und im Daseyn zu qualitativ bestimmten Relationen umcodiert.","refs":["CH_GB18_ANME:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-02","text":"Das Verschwinden mutiert von einer bloßen Auflösung zur Negation der abstrakten Form, durch die der begriffliche Gehalt erhalten bleibt.","refs":["CH_GB18_ANME:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-03","text":"Werden verschiebt sich von der bewegten Einheit der Gegensätze zur Operation ihrer Selbstaufhebung und schließlich zur Herkunft des Daseyns.","refs":["CH_GB18_3ADW:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-04","text":"Aufheben beginnt als sprachliche Doppelbedeutung und wird zur ontologischen Maschine, die negiert, bewahrt und weiterbestimmt.","refs":["CH_GB18_ANME:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-05","text":"Sein mutiert vom unmittelbaren Ausgangsmoment zum resultativen Sein und anschließend zur Qualität des Daseyns.","refs":["CH_GB18_3ADW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-06","text":"Negation verschiebt ihre Valenz von zerstörender Abwesenheit zu positiver Erzeugung einer höheren Bestimmtheit.","refs":["CH_GB18_ANME:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-07","text":"Das Unendliche wechselt vom äußerlichen Gegenpol des Endlichen zum Attraktor einer gegensatzlosen, selbstbezogenen Einheit.","refs":["CH_GB18_DAS0:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-08","text":"Der Gegensatz verschwindet nicht spurlos, sondern wird absorbiert: Er bleibt als innere Negativität und relationale Bestimmtheit der höheren Einheit wirksam.","refs":["CH_GB18_DAS0:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_06:CGD-01","text":"Lokal bleibt die genaue Ableitung des Werdens aus Sein und Nichts; auf Cluster-Ebene wird daraus das allgemeine Schema selbstaufhebender Vermittlung.","refs":["CH_GB18_3ADW:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:CGD-02","text":"Lokal bleibt die semantische Mehrdeutigkeit des Aufhebens; auf Cluster-Ebene wird sie als generativer Operator von Negation und Erhaltung funktionalisiert.","refs":["CH_GB18_ANME:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:CGD-03","text":"Lokal bleibt die Bestimmung von Qualität, Etwas und Anderem; auf Cluster-Ebene wird sie als Fortsetzung der resultativen Einheit in relationale Endlichkeit lesbar.","refs":["CH_GB18_DAS0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:CGD-04","text":"Die einzelnen Übergänge werden auf dieser Ebene durch eine gemeinsame Architektur verbunden: Unmittelbarkeit wird negiert, Bestimmtheit bewahrt und als neues Moment gesetzt.","refs":["CH_GB18_ANME:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:CGD-05","text":"Die lokale Unterscheidung zwischen Werden und Daseyn wird auf höherer Ebene zur Differenz zweier Phasen derselben Vermittlungslogik.","refs":["CH_GB18_ANME:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:CGD-06","text":"Die Bewegung zum Fürsichseyn ist keine bloße Fortsetzung des lokalen Daseynsbegriffs, sondern die clusterweite Eskalation von Relation zu Selbstbezug.","refs":["CH_GB18_DAS0:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_06:GNX-01","text":"Das System weist eine ruhende Identität zurück, in der Sein und Nichts ohne Differenz und Bewegung bestehen könnten.","refs":["CH_GB18_3ADW:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GNX-02","text":"Es weist die Gleichsetzung von Aufheben und Vernichtung zurück und bestimmt Negation stattdessen als Bedingung der Erhaltung.","refs":["CH_GB18_ANME:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GNX-03","text":"Es weist eine positive Qualität zurück, die nicht zugleich Grenze, Negation und Beziehung zu einem Anderen wäre.","refs":["CH_GB18_DAS0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GNX-04","text":"Es weist den abstrakten Dualismus von Endlichem und Unendlichem zurück und zwingt den Gegensatz in eine höhere Einheit.","refs":["CH_GB18_DAS0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GNX-05","text":"Es weist ein Resultat zurück, das entweder in eine Ausgangsbestimmung zurückfällt oder seine Herkunft vollständig verliert.","refs":["CH_GB18_3ADW:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GNX-06","text":"Die stabile äußere Grenze des Systems ist die Unzulässigkeit von Unmittelbarkeit ohne vermittelte Bestimmtheit.","refs":["CH_GB18_DAS0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_06:DBN-01","text":"Damit die Clusterlogik Bestand hat, darf keine Bestimmung als vollständig selbständig gelten; jede Bestimmtheit muss durch Differenz, Negation oder Vermittlung konstituiert sein.","refs":["CH_GB18_ANME:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:DBN-02","text":"Unzulässig ist eine Bewegung, deren Resultat die widersprüchlichen Momente nicht bewahrt, weil dadurch der Übergang in bloße Auslöschung zerfallen würde.","refs":["CH_GB18_3ADW:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:DBN-03","text":"Unzulässig ist ein Modell, in dem Einheit entweder bloße Identität oder bloße Auflösung bedeutet; Einheit muss erhaltene Differenz sein.","refs":["CH_GB18_ANME:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:DBN-04","text":"Ebenso disqualifiziert das System eine Endlichkeit ohne innere Negativität und eine Unendlichkeit ohne Beziehung zu dieser Endlichkeit.","refs":["CH_GB18_DAS0:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_06:BSA-01","text":"Das System kreist um die Abwesenheit eines selbständigen Anfangs- oder Endpunkts: Jede scheinbare Unmittelbarkeit ist Resultat einer vorausgehenden Vermittlung.","refs":["CH_GB18_3ADW:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:BSA-02","text":"Die nicht verfügbare Möglichkeit ist ein reines Resultat außerhalb der Beziehung von Sein, Nichts, Negation und Aufhebung.","refs":["CH_GB18_3ADW:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:BSA-03","text":"Ontologisch unstatthaft ist eine Realität, die sich nicht zugleich als eigene Grenze, Negation und Überschreitung ihrer Grenze bestimmen lässt.","refs":["CH_GB18_DAS0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:BSA-04","text":"Die tiefste Abwesenheit ist die Abwesenheit einer unvermittelten Identität: Das System kann Sein nur als bewahrte Spur seiner eigenen Negation setzen.","refs":["CH_GB18_3ADW:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_06:XD-01","text":"Werden, Aufheben und Daseyn bilden gemeinsam eine einzige Transformationskette, in der Selbstwiderspruch nicht beendet, sondern in eine neue Seinsform überführt wird.","refs":["CL_GB18_06:GA-02","CL_GB18_06:GA-03","CL_GB18_06:GA-07","CH_GB18_3ADW:SD1"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_06:XD-02","text":"Die Einheit von Sein und Nichts wird erst durch den Begriff des Aufhebens als bewahrte, nicht mehr abstrakte Einheit verständlich.","refs":["CL_GB18_06:GA-01","CL_GB18_06:GA-03","CL_GB18_06:GA-05","CH_GB18_ANME:D4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_06:XD-03","text":"Daseyn ist die positive Form einer zuvor negativen Bewegung: Seine Unmittelbarkeit ist nur deshalb stabil, weil ihre widersprüchliche Herkunft aufgehoben wurde.","refs":["CL_GB18_06:GA-05","CL_GB18_06:GA-07","CH_GB18_3ADW:SD5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_06:XD-04","text":"Qualität entsteht nicht nachträglich zum Daseyn, sondern expliziert die bereits im Resultat enthaltene Einheit von Realität und Negation.","refs":["CL_GB18_06:GA-07","CL_GB18_06:GA-08","CH_GB18_DAS0:A8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_06:XD-05","text":"Die gegensatzlose Unendlichkeit ist die gemeinsame Konsequenz aus der Selbstaufhebung des Werdens, der vermittelten Erhaltung und der inneren Negativität des Endlichen.","refs":["CL_GB18_06:GA-02","CL_GB18_06:GA-03","CL_GB18_06:GA-10","CL_GB18_06:GA-11","CH_GB18_DAS0:D7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_06:XD-06","text":"Der Cluster ersetzt die Alternative von Stabilität und Bewegung durch eine resultative Stabilität, die nur als aufgehobene Instabilität Bestand hat.","refs":["CL_GB18_06:GA-04","CL_GB18_06:GA-07","CL_GB18_06:GA-13","CH_GB18_3ADW:SD3"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_06:BSD-01","text":"Realität erscheint auf Cluster-Ebene nicht als vorausliegende Gegebenheit, sondern als Effekt einer geregelten Negation von Unmittelbarkeit.","refs":["CL_GB18_06:GA-03","CL_GB18_06:GA-07","CL_GB18_06:GA-08","CH_GB18_ANME:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_06:BSD-02","text":"Kausalität wird durch begriffliche Selbstbewegung ersetzt: Eine Bestimmung erzeugt ihre nächste Form, indem sie ihre eigene isolierte Form negiert.","refs":["CL_GB18_06:GA-02","CL_GB18_06:GA-03","CL_GB18_06:GA-08","CH_GB18_DAS0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_06:BSD-03","text":"Das Subjekt der Bewegung ist keine äußere Instanz, sondern die Bestimmung selbst, insofern sie ihre Grenze und ihren Gegenbegriff hervorbringt.","refs":["CL_GB18_06:GA-09","CL_GB18_06:GA-10","CL_GB18_06:GA-11","CH_GB18_DAS0:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_06:BSD-04","text":"Geschichte oder Zeit werden implizit als gerichtete Folge von Umformungen bestimmt, in der kein früheres Moment einfach verschwindet, sondern als aufgehobene Bedingung fortwirkt.","refs":["CL_GB18_06:GA-03","CL_GB18_06:GA-05","CL_GB18_06:GA-13","CH_GB18_ANME:AS5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_06:BSD-05","text":"Die operative Methode des Systems besteht darin, Gegensätze nicht zu harmonisieren, sondern ihre Instabilität als Produktionsbedingung einer höheren Einheit zu verwenden.","refs":["CL_GB18_06:GA-04","CL_GB18_06:GA-11","CH_GB18_3ADW:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_06:RLE-01","text":"Unmittelbarkeit → Differenz → Widerspruch → Selbstaufhebung → bewahrte Einheit → neue Bestimmtheit → erneute Negativität.","refs":["CH_GB18_ANME:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RLE-02","text":"Der zentrale Rekursionsloop lautet: Bestimmtheit erzeugt Grenze, Grenze erzeugt Negation, Negation erzeugt Gegenbestimmung, Gegenbestimmung wird in einer höheren Einheit absorbiert.","refs":["CH_GB18_DAS0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RLE-03","text":"Der Begriff des Aufhebens wird zum Attraktor, weil er die scheinbar getrennten Operationen Vernichten, Bewahren und Weiterbestimmen in einem Mechanismus bündelt.","refs":["CH_GB18_ANME:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RLE-04","text":"Daseyn markiert einen Phasenwechsel: Die Bewegung tritt nicht mehr nur als Übergang zwischen Sein und Nichts, sondern als qualitative Selbstbeziehung auf.","refs":["CH_GB18_DAS0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RLE-05","text":"Die Eskalation führt vom Gegensatz zur Relation, von der Relation zur Endlichkeit und von der Endlichkeit zur gegensatzlosen Selbstbeziehung.","refs":["CH_GB18_DAS0:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_06:FGS-B01","text":"Unbestimmte Einheit → Differenz von Sein und Nichts → Werden als gegenseitiges Verschwinden.","refs":["CH_GB18_3ADW:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FGS-B02","text":"Gegenseitiges Verschwinden → Selbstwiderspruch → Selbstaufhebung der bewegten Einheit.","refs":["CH_GB18_3ADW:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FGS-B03","text":"Selbstaufhebung → aufgehobene, ruhige Einheit → Daseyn als resultative Unmittelbarkeit.","refs":["CH_GB18_3ADW:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FGS-B04","text":"Resultative Unmittelbarkeit → Qualität als Realität und Negation → Etwas gegenüber einem Anderen.","refs":["CH_GB18_DAS0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FGS-B05","text":"Relation → Veränderlichkeit und Endlichkeit → Negation des Endlichen → Unendlichkeit → Fürsichseyn.","refs":["CH_GB18_DAS0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FGS-B06","text":"Das Gesamtschema ist keine lineare Ableitung, sondern eine rekursive Verdichtung, in der jede neue Bestimmung die Negation ihrer vorherigen Form bewahrt.","refs":["CH_GB18_ANME:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_06:AFM-B01","text":"Sein und Nichts als verschwindende Gegensätze → Werden als widersprüchliche Bewegung → Selbstaufhebung → bewahrte Einheit → Daseyn als vermittelte Unmittelbarkeit → Qualität als Realität und Negation → relationale Endlichkeit → gegensatzlose Unendlichkeit → Fürsichseyn.","refs":["CH_GB18_3ADW:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_06:MME-01","text":"Sein und Nichts werden von Grundsubstanzen zu funktionalen Momenten einer Vermittlungsarchitektur umkartiert.","refs":["CH_GB18_3ADW:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MME-02","text":"Negation wird als produktive Operation neu klassifiziert: Sie entfernt die abstrakte Form und erhält den bestimmenden Gehalt.","refs":["CH_GB18_ANME:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MME-03","text":"Ruhe und Bewegung erscheinen nicht mehr als Gegensätze, sondern als sukzessive Zustände derselben Bestimmungslogik.","refs":["CH_GB18_3ADW:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MME-04","text":"Daseyn wird von einer einfachen Gegebenheit zur vermittelten, qualitativ strukturierten und relational selbstbezogenen Einheit umkartiert.","refs":["CH_GB18_DAS0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MME-05","text":"Endlichkeit wird aus dem Bereich äußerer Begrenzung in den Bereich innerer Negativität verschoben.","refs":["CH_GB18_DAS0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MME-06","text":"Der Gegensatz von Endlichem und Unendlichem verliert seinen Status als letzte Alternative und wird zum Durchgangspunkt einer gegensatzlosen Selbstbeziehung.","refs":["CH_GB18_DAS0:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_06:ALT-B01","text":"Auf der Surface-Ebene geht das Werden aus dem Verschwinden von Sein und Nichts in die Einheit des Daseyns über.","refs":["CH_GB18_3ADW:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:ALT-B02","text":"Auf der Structural-Ebene organisiert die Differenz der Momente eine Kette aus Instabilität, Aufhebung, Qualität, Relation und Endlichkeit.","refs":["CH_GB18_3ADW:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:ALT-B03","text":"Auf der Metastrategic-Ebene ersetzt das System die Wahl zwischen gegensätzlichen Seiten durch die Erzeugung einer Resultatform, die beide Seiten transformiert.","refs":["CH_GB18_3ADW:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:ALT-B04","text":"Auf der Ontological/Temporal-Ebene wird Sein als Resultat einer bewegten Vermittlung und Daseyn als seiende, aber nicht selbständige Einheit bestimmt.","refs":["CH_GB18_3ADW:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:ALT-B05","text":"Auf der Methodological/Performative-Ebene vollzieht die Darstellung ihre eigene Methode: Sie lässt jeden Begriff durch seine Grenze in eine umgebildete Form übergehen.","refs":["CH_GB18_ANME:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_06:FL-01","text":"Die ruhige Einheit soll Sein und Nichts bewahren, darf sie aber nicht mehr als abstrakte Seinheit und Nichtigkeit gelten lassen; ihre Identität bleibt daher spannungsvoll.","refs":["CH_GB18_ANME:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FL-02","text":"Das Resultat wird als Sein bestimmt, darf aber kein Sein für sich sein; seine Stabilität hängt somit von einer fortbestehenden Abhängigkeit ab.","refs":["CH_GB18_3ADW:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FL-03","text":"Das System behauptet eine ruhige Einheit und hält zugleich die Differenz der aufgehobenen Momente aktiv; Ruhe ist daher keine spannungsfreie Identität.","refs":["CH_GB18_3ADW:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FL-04","text":"Die Auflösung des Gegensatzes von Endlichem und Unendlichem wird gesetzt, ohne den konkreten Vollzug dieser Auflösung vollständig auszuweisen.","refs":["CH_GB18_DAS0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MP-01","text":"Der erste Mutationspunkt liegt dort, wo das Verschwinden des Werdens zugleich zum Verschwinden des Verschwindens wird und dadurch in resultative Ruhe umschlägt.","refs":["CH_GB18_3ADW:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MP-02","text":"Der zweite Mutationspunkt liegt in der Umwandlung des Aufhebens von einer sprachlichen Doppelbedeutung in ein ontologisches Generativschema.","refs":["CH_GB18_ANME:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MP-03","text":"Der dritte Mutationspunkt liegt in der Umkehrung der Qualität: Was zunächst Realität ist, erweist sich zugleich als Negation und erzeugt dadurch Endlichkeit.","refs":["CH_GB18_DAS0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MP-04","text":"Der vierte Mutationspunkt liegt in der Umwandlung des Unendlichen vom Gegenpol zur gegensatzlosen Selbstbeziehung.","refs":["CH_GB18_DAS0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_06:HSI-01","text":"Das implizite Weltbild ist eine ontologische Maschine, in der jede Realität durch Differenz, Negation, Vermittlung und bewahrte Selbstaufhebung erzeugt wird.","refs":["CH_GB18_DAS0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:HSI-02","text":"Das Subjekt wird darin nicht als vorausgesetzte Substanz, sondern als in sich reflektiertes Etwas lesbar, dessen Selbständigkeit aus vermittelter Abhängigkeit hervorgeht.","refs":["CH_GB18_DAS0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:HSI-03","text":"Zeit erscheint als gerichtete Transformation, in der frühere Bestimmungen nicht verschwinden, sondern als aufgehobene Bedingungen späterer Formen fortwirken.","refs":["CH_GB18_ANME:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:HSI-04","text":"Möglich bleibt keine Flucht aus der Vermittlung, sondern nur die Navigation durch ihre Umformungen bis zur selbstbezüglichen Einheit.","refs":["CH_GB18_ANME:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_06:MRT-B01","text":"Die minimal hinreichende Architektur besteht aus fünf Operationen: Differenzierung, gegenseitiges Verschwinden, Aufhebung, qualitative Bestimmung und selbstbezügliche Rückwendung.","refs":["CH_GB18_DAS0:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MRT-B02","text":"Damit lässt sich der Übergang von Sein und Nichts über Werden und Daseyn bis zur qualitativen Endlichkeit und gegensatzlosen Unendlichkeit rekonstruieren; unterbestimmt bleibt der genaue Vollzug der weiteren Übergänge.","refs":["CH_GB18_DAS0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MRT-B03","text":"Die Rekonstruktion ist kohärent, weil sie Widerspruch als Übergangsoperator behandelt; sie bleibt jedoch auf die Spannung angewiesen, dass jede erreichte Einheit ihre aufgehobene Differenz weiterträgt.","refs":["CH_GB18_3ADW:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120646166847Z_afc15c35","language_code":"en","language_name":"English","title":"Chapters 16–18","source_sha256":"10a011a414a84cd92dde96fd5d5e903b574e5430a8a7750ce861a6b4396d78cc","sha256":"3066dd97116cbf03090bedb9f63a0c7805a084a6140ccbbaba108540638ac973","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:06:46.168761+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_06:AS-01","text":"The system resolves the problem of how a determinate form of being emerges from the indeterminate unity of Being and Nothing through contradictory movement.","refs":["CH_GB18_3ADW:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-02","text":"It determines Becoming as the reciprocal dissolution of opposed moments, and sublation as their simultaneous negation, preservation, and redetermination.","refs":["CH_GB18_3ADW:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-03","text":"The central thesis is that negation does not end in emptiness, but abolishes immediacy and preserves determinacy in a higher unity.","refs":["CH_GB18_ANME:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-04","text":"From the self-contradictoriness of Becoming there arises not a return to Being or Nothing, but a tranquil, mediated unity posited as determinate being.","refs":["CH_GB18_3ADW:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-05","text":"This unity is subsequently determined as quality: it is at once reality and negation, generates relation, mutability, and finitude, and is directed toward its own overcoming.","refs":["CH_GB18_DAS0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-06","text":"The movement is recursive and spiral-shaped: every achieved immediacy proves to be the result of a mediation and opens a new level of determination.","refs":["CH_GB18_ANME:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:AS-07","text":"The closure of the cluster is therefore terminal only relatively: determinate being and being-for-self stabilize the attained form without abolishing the generative logic of negation.","refs":["CH_GB18_DAS0:A13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_06:GA-01","text":"[Persistent] Being and Nothing possess no complete conceptual identity outside their distinctness and mediation.","refs":["CH_GB18_3ADW:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-02","text":"[Persistent] Becoming is the reciprocal movement of the vanishing of Being and Nothing and at the same time contains the sublation of this movement.","refs":["CH_GB18_3ADW:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-03","text":"[Mutating] Sublation negates the immediate form of a determination, but preserves its determinacy as a moment of a new unity.","refs":["CH_GB18_ANME:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-04","text":"[Emergent] The contradiction of a unity can become productive if it generates self-sublation and thereby a resultant form.","refs":["CH_GB18_3ADW:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-05","text":"[Emergent] The result is neither mere Nothing nor mere Being, but a tranquil unity in which both persist as determinations of the whole.","refs":["CH_GB18_3ADW:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-06","text":"[Persistent] The Being posited in the result is not self-subsistent, but exists only as a determination of the sublated totality.","refs":["CH_GB18_3ADW:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-07","text":"[Emergent] Determinate being is mediated immediacy: a being unity that becomes possible only through the sublation of its opposed origin.","refs":["CH_GB18_3ADW:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-08","text":"[Mutating] Determinate being transforms itself from resultant Being into qualitatively determined Being; quality is thereby at once reality and negation.","refs":["CH_GB18_DAS0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-09","text":"[Persistent] Quality determines something only relationally in opposition to an other, and thereby makes it mutable and finite.","refs":["CH_GB18_DAS0:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-10","text":"[Emergent] Finitude is not an external limitation, but a negativity residing in qualitative determinacy itself.","refs":["CH_GB18_DAS0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-11","text":"[Attractor] The negation of finitude initially produces the opposition of infinity, which subsequently transforms itself into oppositionless infinity.","refs":["CH_GB18_DAS0:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-12","text":"[Terminal] Oppositionless infinity is determined as being-for-self, while determinate being appears as something reflected into itself.","refs":["CH_GB18_DAS0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GA-13","text":"[Attractor] The higher unity retains its moments not as self-subsistent substances, but as sublated, relational determinations.","refs":["CH_GB18_ANME:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_06:RMD-01","text":"Being and Nothing initially recur as opposites, are recoded in Becoming as vanishing moments, and in determinate being as qualitatively determined relations.","refs":["CH_GB18_ANME:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-02","text":"Vanishing mutates from mere dissolution into the negation of abstract form, through which conceptual content is preserved.","refs":["CH_GB18_ANME:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-03","text":"Becoming shifts from the moving unity of opposites to the operation of their self-sublation and finally to the origin of determinate being.","refs":["CH_GB18_3ADW:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-04","text":"Sublation begins as a linguistic double meaning and becomes the ontological machine that negates, preserves, and further determines.","refs":["CH_GB18_ANME:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-05","text":"Being mutates from the immediate initial moment into resultant Being and subsequently into the quality of determinate being.","refs":["CH_GB18_3ADW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-06","text":"Negation shifts its valence from destructive absence to the positive production of a higher determinacy.","refs":["CH_GB18_ANME:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-07","text":"Infinity changes from the external counterpole of finitude into the attractor of an oppositionless, self-related unity.","refs":["CH_GB18_DAS0:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RMD-08","text":"The opposition does not vanish without trace, but is absorbed: it remains effective as the inner negativity and relational determinacy of the higher unity.","refs":["CH_GB18_DAS0:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_06:CGD-01","text":"Locally, the exact derivation of Becoming from Being and Nothing remains; at the cluster level, this becomes the general schema of self-sublating mediation.","refs":["CH_GB18_3ADW:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:CGD-02","text":"Locally, the semantic ambiguity of sublation remains; at the cluster level, it is functionalized as the generative operator of negation and preservation.","refs":["CH_GB18_ANME:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:CGD-03","text":"Locally, the determination of quality, something, and other remains; at the cluster level, it becomes legible as the continuation of resultant unity into relational finitude.","refs":["CH_GB18_DAS0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:CGD-04","text":"At this level, the individual transitions are connected by a common architecture: immediacy is negated, determinacy preserved, and posited as a new moment.","refs":["CH_GB18_ANME:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:CGD-05","text":"The local distinction between Becoming and determinate being becomes, at a higher level, the difference between two phases of the same logic of mediation.","refs":["CH_GB18_ANME:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:CGD-06","text":"The movement toward being-for-self is not a mere continuation of the local concept of determinate being, but the cluster-wide escalation from relation to self-relation.","refs":["CH_GB18_DAS0:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_06:GNX-01","text":"The system rejects a static identity in which Being and Nothing could exist without difference and movement.","refs":["CH_GB18_3ADW:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GNX-02","text":"It rejects the identification of sublation with annihilation and instead determines negation as the condition of preservation.","refs":["CH_GB18_ANME:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GNX-03","text":"It rejects a positive quality that would not at the same time be limit, negation, and relation to an other.","refs":["CH_GB18_DAS0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GNX-04","text":"It rejects the abstract dualism of finite and infinite and compels the opposition into a higher unity.","refs":["CH_GB18_DAS0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GNX-05","text":"It rejects a result that either falls back into an initial determination or completely loses its origin.","refs":["CH_GB18_3ADW:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:GNX-06","text":"The stable external limit of the system is the inadmissibility of immediacy without mediated determinacy.","refs":["CH_GB18_DAS0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_06:DBN-01","text":"For the cluster logic to hold, no determination may count as wholly self-subsistent; every determinacy must be constituted through difference, negation, or mediation.","refs":["CH_GB18_ANME:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:DBN-02","text":"Inadmissible is a movement whose result does not preserve the contradictory moments, because the transition would thereby collapse into mere extinction.","refs":["CH_GB18_3ADW:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:DBN-03","text":"Inadmissible is a model in which unity means either mere identity or mere dissolution; unity must be preserved difference.","refs":["CH_GB18_ANME:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:DBN-04","text":"Likewise, the system disqualifies a finitude without inner negativity and an infinity without relation to this finitude.","refs":["CH_GB18_DAS0:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_06:BSA-01","text":"The system revolves around the absence of a self-subsistent starting or end point: every apparent immediacy is the result of a preceding mediation.","refs":["CH_GB18_3ADW:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:BSA-02","text":"The unavailable possibility is a pure result outside the relation of Being, Nothing, negation, and sublation.","refs":["CH_GB18_3ADW:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:BSA-03","text":"Ontologically impermissible is a reality that cannot at the same time be determined as its own limit, negation, and transgression of its limit.","refs":["CH_GB18_DAS0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:BSA-04","text":"The deepest absence is the absence of an unmediated identity: the system can posit Being only as the preserved trace of its own negation.","refs":["CH_GB18_3ADW:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_06:XD-01","text":"Becoming, sublation, and determinate being together form a single chain of transformation in which self-contradiction is not ended, but transferred into a new form of Being.","refs":["CL_GB18_06:GA-02","CL_GB18_06:GA-03","CL_GB18_06:GA-07","CH_GB18_3ADW:SD1"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_06:XD-02","text":"The unity of Being and Nothing becomes intelligible as a preserved, no longer abstract unity only through the concept of sublation.","refs":["CL_GB18_06:GA-01","CL_GB18_06:GA-03","CL_GB18_06:GA-05","CH_GB18_ANME:D4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_06:XD-03","text":"Determinate being is the positive form of a previously negative movement: its immediacy is stable only because its contradictory origin has been sublated.","refs":["CL_GB18_06:GA-05","CL_GB18_06:GA-07","CH_GB18_3ADW:SD5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_06:XD-04","text":"Quality does not arise subsequently to determinate being, but explicates the unity of reality and negation already contained in the result.","refs":["CL_GB18_06:GA-07","CL_GB18_06:GA-08","CH_GB18_DAS0:A8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_06:XD-05","text":"Oppositionless infinity is the common consequence of the self-sublation of Becoming, mediated preservation, and the inner negativity of the finite.","refs":["CL_GB18_06:GA-02","CL_GB18_06:GA-03","CL_GB18_06:GA-10","CL_GB18_06:GA-11","CH_GB18_DAS0:D7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_06:XD-06","text":"The cluster replaces the alternative of stability and movement with a resultant stability that endures only as sublated instability.","refs":["CL_GB18_06:GA-04","CL_GB18_06:GA-07","CL_GB18_06:GA-13","CH_GB18_3ADW:SD3"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_06:BSD-01","text":"At the cluster level, reality appears not as a pregiven datum, but as the effect of a regulated negation of immediacy.","refs":["CL_GB18_06:GA-03","CL_GB18_06:GA-07","CL_GB18_06:GA-08","CH_GB18_ANME:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_06:BSD-02","text":"Causality is replaced by conceptual self-movement: a determination produces its next form by negating its own isolated form.","refs":["CL_GB18_06:GA-02","CL_GB18_06:GA-03","CL_GB18_06:GA-08","CH_GB18_DAS0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_06:BSD-03","text":"The subject of movement is not an external instance, but the determination itself, insofar as it brings forth its limit and its counter-concept.","refs":["CL_GB18_06:GA-09","CL_GB18_06:GA-10","CL_GB18_06:GA-11","CH_GB18_DAS0:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_06:BSD-04","text":"History or time are implicitly determined as a directed sequence of transformations in which no earlier moment simply vanishes, but continues to operate as a sublated condition.","refs":["CL_GB18_06:GA-03","CL_GB18_06:GA-05","CL_GB18_06:GA-13","CH_GB18_ANME:AS5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_06:BSD-05","text":"The operative method of the system consists not in harmonizing opposites, but in using their instability as the condition of production of a higher unity.","refs":["CL_GB18_06:GA-04","CL_GB18_06:GA-11","CH_GB18_3ADW:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_06:RLE-01","text":"Immediacy → difference → contradiction → self-sublation → preserved unity → new determinacy → renewed negativity.","refs":["CH_GB18_ANME:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RLE-02","text":"The central recursive loop is: determinacy generates limit, limit generates negation, negation generates counter-determination, counter-determination is absorbed in a higher unity.","refs":["CH_GB18_DAS0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RLE-03","text":"The concept of sublation becomes the attractor because it bundles the seemingly separate operations of annihilating, preserving, and further determining into one mechanism.","refs":["CH_GB18_ANME:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RLE-04","text":"Determinate being marks a phase transition: movement no longer occurs only as a transition between Being and Nothing, but as qualitative self-relation.","refs":["CH_GB18_DAS0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:RLE-05","text":"The escalation leads from opposition to relation, from relation to finitude, and from finitude to oppositionless self-relation.","refs":["CH_GB18_DAS0:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_06:FGS-B01","text":"Indeterminate unity → difference of Being and Nothing → Becoming as reciprocal vanishing.","refs":["CH_GB18_3ADW:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FGS-B02","text":"Reciprocal vanishing → self-contradiction → self-sublation of the moving unity.","refs":["CH_GB18_3ADW:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FGS-B03","text":"Self-sublation → sublated, tranquil unity → determinate being as resultant immediacy.","refs":["CH_GB18_3ADW:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FGS-B04","text":"Resultant immediacy → quality as reality and negation → something in relation to an other.","refs":["CH_GB18_DAS0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FGS-B05","text":"Relation → mutability and finitude → negation of the finite → infinity → being-for-self.","refs":["CH_GB18_DAS0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FGS-B06","text":"The overall schema is not a linear derivation, but a recursive condensation in which every new determination preserves the negation of its preceding form.","refs":["CH_GB18_ANME:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_06:AFM-B01","text":"Being and Nothing as vanishing opposites → Becoming as contradictory movement → self-sublation → preserved unity → determinate being as mediated immediacy → quality as reality and negation → relational finitude → oppositionless infinity → being-for-self.","refs":["CH_GB18_3ADW:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_06:MME-01","text":"Being and Nothing are remapped from fundamental substances into functional moments of an architecture of mediation.","refs":["CH_GB18_3ADW:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MME-02","text":"Negation is reclassified as a productive operation: it removes the abstract form and preserves the determining content.","refs":["CH_GB18_ANME:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MME-03","text":"Rest and movement no longer appear as opposites, but as successive states of the same logic of determination.","refs":["CH_GB18_3ADW:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MME-04","text":"Determinate being is remapped from a simple given into a mediated, qualitatively structured, and relationally self-related unity.","refs":["CH_GB18_DAS0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MME-05","text":"Finitude is displaced from the domain of external limitation into that of inner negativity.","refs":["CH_GB18_DAS0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MME-06","text":"The opposition of finite and infinite loses its status as the final alternative and becomes the passage-point of an oppositionless self-relation.","refs":["CH_GB18_DAS0:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_06:ALT-B01","text":"At the Surface level, Becoming passes from the vanishing of Being and Nothing into the unity of determinate being.","refs":["CH_GB18_3ADW:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:ALT-B02","text":"At the Structural level, the difference of the moments organizes a chain of instability, sublation, quality, relation, and finitude.","refs":["CH_GB18_3ADW:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:ALT-B03","text":"At the Metastrategic level, the system replaces the choice between opposed sides with the production of a resultant form that transforms both sides.","refs":["CH_GB18_3ADW:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:ALT-B04","text":"At the Ontological/Temporal level, Being is determined as the result of a moving mediation and determinate being as a being, yet not self-subsistent, unity.","refs":["CH_GB18_3ADW:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:ALT-B05","text":"At the Methodological/Performative level, the presentation enacts its own method: it lets every concept pass through its limit into a transformed form.","refs":["CH_GB18_ANME:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_06:FL-01","text":"The tranquil unity is to preserve Being and Nothing, but may no longer allow them to count as abstract beingness and nothingness; its identity therefore remains tension-filled.","refs":["CH_GB18_ANME:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FL-02","text":"The result is determined as Being, but may not be Being for itself; its stability thus depends on an enduring dependence.","refs":["CH_GB18_3ADW:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FL-03","text":"The system asserts a tranquil unity while simultaneously keeping the difference of the sublated moments active; rest is therefore not an identity free of tension.","refs":["CH_GB18_3ADW:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:FL-04","text":"The dissolution of the opposition between finite and infinite is posited without fully demonstrating the concrete enactment of this dissolution.","refs":["CH_GB18_DAS0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MP-01","text":"The first mutation point lies where the vanishing of Becoming becomes at the same time the vanishing of vanishing and thereby turns into resultant rest.","refs":["CH_GB18_3ADW:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MP-02","text":"The second mutation point lies in the transformation of sublation from a linguistic double meaning into an ontological generative schema.","refs":["CH_GB18_ANME:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MP-03","text":"The third mutation point lies in the reversal of quality: what is initially reality proves at the same time to be negation and thereby generates finitude.","refs":["CH_GB18_DAS0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MP-04","text":"The fourth mutation point lies in the transformation of infinity from counterpole into oppositionless self-relation.","refs":["CH_GB18_DAS0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_06:HSI-01","text":"The implicit worldview is an ontological machine in which every reality is generated through difference, negation, mediation, and preserved self-sublation.","refs":["CH_GB18_DAS0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:HSI-02","text":"Within it, the subject becomes legible not as a presupposed substance, but as something reflected into itself, whose self-subsistence emerges from mediated dependence.","refs":["CH_GB18_DAS0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:HSI-03","text":"Time appears as a directed transformation in which earlier determinations do not vanish, but continue to operate as sublated conditions of later forms.","refs":["CH_GB18_ANME:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:HSI-04","text":"What remains possible is not an escape from mediation, but only navigation through its transformations up to self-related unity.","refs":["CH_GB18_ANME:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_06:MRT-B01","text":"The minimally sufficient architecture consists of five operations: differentiation, reciprocal vanishing, sublation, qualitative determination, and self-related return.","refs":["CH_GB18_DAS0:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MRT-B02","text":"This permits the reconstruction of the transition from Being and Nothing through Becoming and determinate being to qualitative finitude and oppositionless infinity; the exact enactment of the further transitions remains underdetermined.","refs":["CH_GB18_DAS0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_06:MRT-B03","text":"The reconstruction is coherent because it treats contradiction as an operator of transition; yet it remains dependent on the tension that every attained unity continues to carry its sublated difference.","refs":["CH_GB18_3ADW:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_06@R001","source_variant_id":"canonical:CL_GB18_06:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 16–18","context":"3. Aufheben des Werdens. · Anmerkung. · A. Daseyn als solches."},"title_language_code":"en"},{"id":"CL_GB18_07","layer":"CL","title":"Chapters 19–21","order":7,"parents":["CH_GB18_DASB","CH_GB18_BQT0","CH_GB18_AN_2"],"revision":"CL_GB18_07@R001","sha256":"670e5be205f5f3b66342b05cc12e75c3ba8eb4370a335d941590614307df3985","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_07:AS-01","text":"Das Cluster bestimmt Realität nicht als vorliegende Positivität, sondern als Resultat einer Vermittlung, deren aufgehobene Herkunft in jeder Unmittelbarkeit fortwirkt.","refs":["CH_GB18_DASB:AS1","CH_GB18_DASB:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-02","text":"Daseyn bildet den ersten Knoten dieser Architektur: Es ist unmittelbares bestimmtes Seyn, weil Seyn und Nichtseyn nicht äußerlich verbunden, sondern in einer aufgehobenen Einheit enthalten sind.","refs":["CH_GB18_DASB:A4","CH_GB18_DASB:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-03","text":"Qualität entsteht, indem Bestimmtheit aus der zunächst ungeschiedenen Einheit isoliert wird; diese Isolierung macht sie zugleich als begrenzte und negative Bestimmtheit lesbar.","refs":["CH_GB18_BQT0:AS3","CH_GB18_BQT0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-04","text":"Realität und Negation treten nicht als Gegensphären auf, sondern als auseinandergelegte Funktionen desselben Daseyns, dessen Positivität ihre eigene Negativität zunächst verdeckt.","refs":["CH_GB18_BQT0:AS6","CH_GB18_BQT0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-05","text":"Die Anmerkung verallgemeinert diese begriffliche Bewegung zu einer Kritik jedes Realitätsbegriffs, der Bestimmtheit als negationsfreie Vollkommenheit oder Totalität behandeln will.","refs":["CH_GB18_AN_2:AS2","CH_GB18_AN_2:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-06","text":"Die gerichtete Bewegung führt von aufgehobener Vermittlung über bestimmte Negation zur Einsicht, dass die Entfernung aller Negation in leeres Sein umschlägt, ihre affirmative Totalisierung dagegen Widerspruch erzeugt.","refs":["CH_GB18_AN_2:A4","CH_GB18_AN_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-07","text":"Qualität endet auf dieser Ebene nicht als ruhende Beschaffenheit, sondern mutiert zur Eigenschaft, die sich nur durch Beziehung auf Anderes, Gegenwirkung und Kampf erhält.","refs":["CH_GB18_AN_2:A10","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-08","text":"Die Clusterbewegung ist rekursiv und spiralförmig: Vermittlung erzeugt Unmittelbarkeit, Unmittelbarkeit enthält Negation, Negation differenziert Realität, und Realität wird als bewegte Selbsterhaltung gegen ihre Auflösung bestimmt.","refs":["CH_GB18_DASB:FGS2","CH_GB18_AN_2:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_07:GA-01","text":"[Persistent] Jede Unmittelbarkeit des Daseyns ist resultativ: Sie erscheint unmittelbar, weil die Vermittlung, aus der sie hervorgeht, aufgehoben und in ihr bewahrt ist.","refs":["CH_GB18_DASB:A5","CH_GB18_DASB:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-02","text":"[Persistent] Bestimmtheit ist keine äußerliche Zugabe zum Seyn, sondern die im Seyn aufgenommene und wirksame Negation.","refs":["CH_GB18_DASB:A7","CH_GB18_DASB:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-03","text":"[Mutating] Nichtseyn mutiert von einem Moment des Werdens zu einer im Daseyn enthaltenen Negativität und weiter zu Grenze, Schranke, Mangel, Widerstand und Selbsterhaltung.","refs":["CH_GB18_DASB:FGS3","CH_GB18_BQT0:A10","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-04","text":"[Persistent] Qualität ist die isolierte Form seyender Bestimmtheit, nicht der vollständige Umfang aller möglichen Bestimmungen.","refs":["CH_GB18_BQT0:A5","CH_GB18_BQT0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-05","text":"[Emergent] Realität und Negation sind koextensive Formen des Daseyns; ihre Unterscheidung artikuliert eine interne Differenz statt eine Trennung zweier ontologischer Bereiche.","refs":["CH_GB18_BQT0:A9","CH_GB18_BQT0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-06","text":"[Attractor] Positivität ist nur als selektive Erscheinungsform möglich, weil sie ihre konstitutive Negativität ausschließt und dadurch deren Rückkehr erzwingt.","refs":["CH_GB18_BQT0:A12","CH_GB18_BQT0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-07","text":"[Emergent] Jede affirmative Totalisierung bestimmter Realität ist selbstaufhebend: Ohne Negation wird sie abstraktes Sein, mit allen Bestimmtheiten wird sie Totalität der Widersprüche.","refs":["CH_GB18_AN_2:A5","CH_GB18_AN_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-08","text":"[Terminal] Eigenschaft ist keine ruhende Form, sondern die aktive Erhaltung immanenter Bestimmtheit in äußerer Beziehung und negativer Gegenwirkung.","refs":["CH_GB18_AN_2:A10","CH_GB18_AN_2:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-09","text":"[Persistent] Nur am Begriff gesetzte Bestimmungen dürfen die Entwicklung tragen; äußerliche Reflexion kann erläutern, aber keine immanente Notwendigkeit erzeugen.","refs":["CH_GB18_DASB:A9","CH_GB18_DASB:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-10","text":"[Attractor] Endliche Individualität besitzt innerhalb bloßer Seinskategorien keine substanzielle Selbständigkeit, sondern nur eine begrenzte, relationale und konflikthafte Selbstbehauptung.","refs":["CH_GB18_AN_2:A8","CH_GB18_AN_2:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_07:RMD-01","text":"Seyn und Nichts kehren nicht als stabile Gegenstände wieder: Ihre anfängliche Einheit im Daseyn wird zur inneren Struktur von Bestimmtheit und schließlich zur Differenz von Realität und Negation verschoben.","refs":["CH_GB18_BQT0:A1","CH_GB18_BQT0:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RMD-02","text":"Vermittlung verliert ihre selbständige Form im Daseyn, bleibt jedoch als resultative Herkunft wirksam und verhindert, dass Unmittelbarkeit als voraussetzungslose Gegebenheit gelten kann.","refs":["CH_GB18_DASB:A3","CH_GB18_DASB:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RMD-03","text":"Bestimmtheit bleibt als Begriff persistent, mutiert jedoch funktional von der Einheit von Seyn und Nichtseyn über Qualität zur negativen Struktur von Realität, Grenze, Schranke und Mangel.","refs":["CH_GB18_DASB:A7","CH_GB18_BQT0:A5","CH_GB18_BQT0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RMD-04","text":"Realität verschiebt sich von einer bestimmten Qualität zu einem Prüfbegriff, an dem ontologische Vollkommenheit, abstrakte Substanz und das Verhältnis von Idee und Dasein scheitern.","refs":["CH_GB18_AN_2:AS3","CH_GB18_AN_2:ME2","CH_GB18_AN_2:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RMD-05","text":"Negation kehrt als funktionale Konstante wieder, wechselt aber ihre Valenz: Sie ist weder reines Nichts noch bloßer Mangel, sondern die Bedingung bestimmter Realität, Grenze, Relation und Bewegung.","refs":["CH_GB18_BQT0:NX5","CH_GB18_BQT0:D9","CH_GB18_AN_2:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RMD-06","text":"Das endliche Individuum wird aus der Vorstellung atomarer Selbständigkeit verdrängt und in eine Architektur begrenzter Selbstbeziehung, Widerständigkeit und Selbsterhaltung absorbiert.","refs":["CH_GB18_AN_2:D4","CH_GB18_AN_2:ME5","CH_GB18_AN_2:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_07:CGD-01","text":"Die Abweisung einer räumlichen Lesart von Daseyn bleibt eine lokale begriffliche Reinigung und trägt die Clusterarchitektur nur insofern, als sie Konkretheit von äußerlicher Lokalisierung trennt.","refs":["CH_GB18_DASB:NX2","CH_GB18_DASB:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:CGD-02","text":"Die bloße Sequenz Seyn, Nichts, Werden und Daseyn bleibt untere Entwicklungsebene; auf Clusterebene zählt allein ihre resultative Transformation in eine Theorie immanenter Negativität.","refs":["CH_GB18_DASB:FGS1","CH_GB18_DASB:FGS2","CH_GB18_DASB:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:CGD-03","text":"Die methodische Differenz von begrifflich gesetzter Bestimmung und äußerlicher Reflexion skaliert zur globalen Regel, dass Realität nur aus immanenter Selbstbestimmung und nicht aus vorausgesetzter Prädikation erklärt werden darf.","refs":["CH_GB18_DASB:SD3","CH_GB18_AN_2:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:CGD-04","text":"Die einzelne Ableitung von Grenze, Schranke und Mangel wird auf Clusterebene zur umfassenderen These, dass jede positive Bestimmtheit eine negative Relationsform hervorbringt.","refs":["CH_GB18_BQT0:D8","CH_GB18_AN_2:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:CGD-05","text":"Der noch unterbestimmte positive Begriff des wahren Unendlichen bleibt außerhalb der erreichten Clusterarchitektur; das Cluster erzeugt dessen negative Vorbedingung, aber nicht dessen positive Bestimmung.","refs":["CH_GB18_AN_2:NX4","CH_GB18_AN_2:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_07:GNX-01","text":"Ausgeschlossen ist eine Ontologie reiner Unmittelbarkeit, in der Daseyn unabhängig von aufgehobener Vermittlung und innerer Negativität bestehen könnte.","refs":["CH_GB18_DASB:SNX1","CH_GB18_DASB:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GNX-02","text":"Ausgeschlossen ist ein äußeres Differenzmodell, das Seyn und Nichts als fertige Entitäten trennt und ihre Einheit erst nachträglich herstellt.","refs":["CH_GB18_DASB:SNX2","CH_GB18_BQT0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GNX-03","text":"Ausgeschlossen ist eine Realität, die als reine Affirmation, Vollkommenheit oder Positivität ohne konstitutive Negation bestehen soll.","refs":["CH_GB18_AN_2:NX3","CH_GB18_BQT0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GNX-04","text":"Ausgeschlossen ist eine Metaphysik, die die Summe bestimmter Realitäten als widerspruchslose höchste Einheit ausgeben könnte.","refs":["CH_GB18_AN_2:NX5","CH_GB18_AN_2:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GNX-05","text":"Ausgeschlossen ist die Vorstellung, das Endliche könne als beziehungslose, schrankenlose oder substantiell selbständige Einheit innerhalb der Sphäre des Seins bestehen.","refs":["CH_GB18_AN_2:DNX4","CH_GB18_AN_2:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_07:DBN-01","text":"Falsch sein muss, dass ein bestimmter Inhalt ohne Negation von anderem bestehen kann; andernfalls verlöre Bestimmtheit ihren Grund und Realität ihre Differenzierbarkeit.","refs":["CH_GB18_AN_2:DNX1","CH_GB18_AN_2:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:DBN-02","text":"Falsch sein muss, dass die Beseitigung aller Grenzen den Gehalt des Bestimmten bewahrt; sie hebt bestimmte Realität auf und führt in abstraktes Sein und Nichts zurück.","refs":["CH_GB18_AN_2:DNX2","CH_GB18_AN_2:A4","CH_GB18_AN_2:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:DBN-03","text":"Falsch sein muss, dass Wahrheit durch die Wahl zwischen äußerlichem Dasein und einer gegen Daseyn gleichgültigen Idee gewonnen werden kann.","refs":["CH_GB18_AN_2:AS1","CH_GB18_AN_2:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:DBN-04","text":"Falsch sein muss, dass Negation entweder als eliminierbarer Mangel oder als abschließender metaphysischer Inhalt fungieren kann; sie ist vielmehr die Bewegungsform bestimmter Realität.","refs":["CH_GB18_AN_2:DNX5","CH_GB18_AN_2:A9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_07:BSA-01","text":"Unverfügbar bleibt ein positives Absolutes, das vor aller Differenz, Negation und Vermittlung als unmittelbar erfüllte Totalität dargestellt werden könnte.","refs":["CH_GB18_AN_2:SNX1","CH_GB18_AN_2:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSA-02","text":"Unmöglich bleibt eine konfliktlose Selbstidentität bestimmter Prädikate, weil jede Bestimmtheit nur als Negation und Beziehung auf Anderes bestimmt ist.","refs":["CH_GB18_AN_2:SNX3","CH_GB18_AN_2:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSA-03","text":"Nicht verfügbar bleibt eine endliche Individualität, die zugleich unabhängig, grenzenlos und an-und-für-sich sei; ihre einzige mögliche Gestalt ist relationale Selbsterhaltung im Widerstand.","refs":["CH_GB18_AN_2:SNX4","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_07:XD-01","text":"Die resultative Unmittelbarkeit des Daseyns macht Qualität zu keiner äußerlich klassifizierten Eigenschaft, sondern zu der Weise, in der aufgehobene Vermittlung als bestimmte Negativität fortarbeitet.","refs":["CL_GB18_07:GA-01","CL_GB18_07:GA-02","CL_GB18_07:GA-04","CH_GB18_DASB:SD1","CH_GB18_BQT0:SD2"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_07:XD-02","text":"Die positive Erscheinung der Realität wird zum Übergangsmechanismus der Kritik: Gerade indem Realität Negation ausschließt, exponiert sie sich als unzulänglicher Grund für eine affirmative Ontologie.","refs":["CL_GB18_07:GA-05","CL_GB18_07:GA-06","CL_GB18_07:GA-07","CH_GB18_BQT0:A12","CH_GB18_AN_2:SD1"],"deep_refs":[],"trace_type":"Tension.","passages":[]},{"id":"CL_GB18_07:XD-03","text":"Die Alternative zwischen leerem Sein und widersprüchlicher Totalität fungiert als systemischer Test für jede Theorie, die Realität durch die Steigerung oder Anhäufung positiver Prädikate definieren will.","refs":["CL_GB18_07:GA-02","CL_GB18_07:GA-07","CH_GB18_AN_2:A5","CH_GB18_AN_2:SD2"],"deep_refs":[],"trace_type":"Negative.","passages":[]},{"id":"CL_GB18_07:XD-04","text":"Die dynamische Eigenschaft entsteht erst, wenn die im Daseyn enthaltene Negation nicht bloß als logische Differenz, sondern als äußere Gegenwirkung und innere Unruhe wirksam wird.","refs":["CL_GB18_07:GA-03","CL_GB18_07:GA-08","CL_GB18_07:GA-10","CH_GB18_AN_2:A10","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_07:XD-05","text":"Die Kritik isolierter Realität und die Kritik selbständiger Substanz folgen demselben Muster: Was sich als positives Für-sich setzt, verliert entweder Bestimmtheit oder wird durch seine ausgeschlossene Negativität relationiert.","refs":["CL_GB18_07:GA-06","CL_GB18_07:GA-10","CH_GB18_AN_2:D6","CH_GB18_AN_2:ME4"],"deep_refs":[],"trace_type":"Composite.","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_07:BSD-01","text":"Realität wird als Selbstverhältnis bestimmter Negativität rekonfiguriert: Sie ist weder bloßes Vorhandensein noch reine Idee, sondern eine durch Differenz, Grenze und Vermittlung hervorgebrachte Bewegungsform.","refs":["CH_GB18_AN_2:A1","CH_GB18_AN_2:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSD-02","text":"Das Cluster transformiert Abstraktion von einer Methode der Reinigung in einen kritischen Indikator: Abstraktion zerstört ihren Gegenstand, sobald sie dessen bestimmte Negativität entfernt.","refs":["CH_GB18_AN_2:A4","CH_GB18_AN_2:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSD-03","text":"Die Ontologie affirmativer Totalität wird nicht durch eine Gegenaffirmation überwunden, sondern durch den Nachweis ihrer doppelten Selbstauflösung in Leere oder Widerspruch.","refs":["CH_GB18_AN_2:A5","CH_GB18_AN_2:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSD-04","text":"Das Endliche erhält keinen unabhängigen Seinsstatus, aber auch keine bloße Auslöschung: Es wird als prekäre Form der Selbsterhaltung bestimmt, die nur in Beziehung auf Anderes bestehen kann.","refs":["CH_GB18_AN_2:A8","CH_GB18_AN_2:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSD-05","text":"Methodisch entsteht eine immanente Kritikform, in der ein Begriff nicht gegen einen fremden Maßstab verworfen wird, sondern durch die Konsequenzen seiner eigenen Abstraktion, Positivierung und Totalisierung zerfällt.","refs":["CH_GB18_DASB:A9","CH_GB18_AN_2:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_07:RLE-01","text":"Die Grundschleife verläuft von Vermittlung zu resultativer Unmittelbarkeit, von Unmittelbarkeit zu Bestimmtheit und von Bestimmtheit zu einer Negation, die die Vermittlungsbewegung erneut freisetzt.","refs":["CH_GB18_DASB:FGS2","CH_GB18_DASB:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RLE-02","text":"Realität bildet einen rekursiven Attraktor: Sie erscheint als positives Resultat, schließt Negation aus und muss gerade dadurch als negativ bestimmte Realität zurückgewonnen werden.","refs":["CH_GB18_BQT0:A12","CH_GB18_AN_2:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RLE-03","text":"Totalisierung bildet eine Eskalationsschleife, weil sie sich durch Entfernung der Negation entleert und durch Erhaltung aller Bestimmungen in widersprüchliche Überfülle umschlägt.","refs":["CH_GB18_AN_2:A4","CH_GB18_AN_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RLE-04","text":"Grenze, Schranke und Mangel sind keine terminalen Defizite, sondern Übergangspunkte, an denen Bestimmtheit in Relation, Widerstand und bewegte Selbsterhaltung umschlägt.","refs":["CH_GB18_BQT0:D8","CH_GB18_AN_2:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RLE-05","text":"Die bestimmte Negation ist der begriffliche Attraktor des Clusters, weil sie Daseyn, Qualität, Realität, Kritik der Totalität und dynamische Eigenschaft in einer einzigen generativen Funktion verbindet.","refs":["CH_GB18_BQT0:D6","CH_GB18_AN_2:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_07:FGS-B01","text":"Seyn und Nichtseyn werden nicht addiert, sondern durch Werden vermittelt; die Vermittlung hebt sich auf und setzt Daseyn als resultative Unmittelbarkeit.","refs":["CH_GB18_DASB:A2","CH_GB18_DASB:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FGS-B02","text":"Daseyn nimmt Nichtseyn in sich auf; seine Bestimmtheit wird dadurch nicht äußerliche Prädikation, sondern immanente Negativität.","refs":["CH_GB18_DASB:A6","CH_GB18_DASB:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FGS-B03","text":"Die Isolation seyender Bestimmtheit erzeugt Qualität, deren unmittelbare Positivität stets eine Bestimmung des Nichts enthält.","refs":["CH_GB18_BQT0:A5","CH_GB18_BQT0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FGS-B04","text":"Die Reflexion dieser enthaltenen Negativität differenziert Realität und Negation und erzeugt Grenze, Schranke und Mangel als interne Formen der Qualität.","refs":["CH_GB18_BQT0:A8","CH_GB18_BQT0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FGS-B05","text":"Die Ausweitung positiver Realität zu einer Totalität führt notwendig entweder zur Abstraktion aller Bestimmtheit oder zur Totalität der Widersprüche.","refs":["CH_GB18_AN_2:A4","CH_GB18_AN_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FGS-B06","text":"Die Selbstauflösung statischer Realität erzwingt die Umcodierung von Qualität als Eigenschaft: Bestimmtheit besteht nur als negative Selbsterhaltung in Beziehung, Gegenwirkung und Kampf.","refs":["CH_GB18_AN_2:A10","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_07:AFM-B01","text":"Vermittlung von Seyn und Nichtseyn → Aufhebung der Vermittlung → Daseyn als resultative Unmittelbarkeit.","refs":["CH_GB18_DASB:A2","CH_GB18_DASB:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AFM-B02","text":"Daseyn als Einheit → immanente Bestimmtheit → Isolation der seyenden Bestimmtheit als Qualität.","refs":["CH_GB18_DASB:A7","CH_GB18_BQT0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AFM-B03","text":"Qualität → enthaltene Negation → Unterscheidung von Realität und Negation → Grenze, Schranke und Mangel.","refs":["CH_GB18_BQT0:D5","CH_GB18_BQT0:D7","CH_GB18_BQT0:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AFM-B04","text":"Realität als scheinbare Positivität → Ausschluss der eigenen Negativität → Kritik einer negationsfreien Vollkommenheit.","refs":["CH_GB18_BQT0:SD4","CH_GB18_AN_2:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AFM-B05","text":"Affirmative Totalisierung → Bestimmungslosigkeit oder Widerspruch → Entzug substantieller Selbständigkeit von Attribut, Modus und Individuum.","refs":["CH_GB18_AN_2:A5","CH_GB18_AN_2:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AFM-B06","text":"Verlust statischer Selbständigkeit → relationale Bestimmtheit → Eigenschaft als Selbsterhaltung im Widerstand und Kampf.","refs":["CH_GB18_AN_2:D5","CH_GB18_AN_2:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_07:MME-01","text":"Unmittelbarkeit wird als verdichtete Geschichte aufgehobener Vermittlung kartiert und nicht mehr als bloßes Fehlen von Vermittlung verstanden.","refs":["CH_GB18_DASB:ME1","CH_GB18_DASB:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MME-02","text":"Die Karte des Negativen verschiebt sich von einem äußeren Gegenpol der Realität zu einer immanenten Bedingung ihrer Bestimmtheit, Begrenzung und Beweglichkeit.","refs":["CH_GB18_DASB:ME2","CH_GB18_BQT0:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MME-03","text":"Der Gegensatz von Realität und Idee verliert seine exklusive Form, weil beide als abstrakte Einseitigkeiten erscheinen, sobald sie von bestimmter Negativität getrennt werden.","refs":["CH_GB18_AN_2:NX1","CH_GB18_AN_2:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MME-04","text":"Ontologische Vollkommenheit wird von einem höchsten positiven Gehalt in einen Selbstprüfungsmechanismus umgezeichnet, der Totalisierung als Entleerung oder Widerspruch ausweist.","refs":["CH_GB18_AN_2:ME3","CH_GB18_AN_2:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MME-05","text":"Individualität wird nicht als atomare Einheit, sondern als begrenzte Fähigkeit zur Erhaltung einer immanenten Bestimmung gegen äußere Einwirkung neu klassifiziert.","refs":["CH_GB18_AN_2:ME5","CH_GB18_AN_2:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_07:ALT-B01","text":"Surface level — Das Cluster behandelt Daseyn, Qualität, Realität, Negation, Grenze, Schranke, Mangel, ontologische Vollkommenheit, Substanz und Eigenschaft.","refs":["CH_GB18_BQT0:AS5","CH_GB18_AN_2:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:ALT-B02","text":"Structural level — Die wiederkehrende Struktur ist die Erzeugung bestimmter Realität durch Negation und ihre Selbstauflösung, sobald Negation entfernt, verleugnet oder totalisiert wird.","refs":["CH_GB18_BQT0:ALT2","CH_GB18_AN_2:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:ALT-B03","text":"Metastrategic level — Der argumentative Eingriff ersetzt äußerliche Gegenüberstellungen durch immanente Ableitung und lässt gegnerische Realitätsmodelle an ihren eigenen Voraussetzungen zerfallen.","refs":["CH_GB18_DASB:ALT3","CH_GB18_AN_2:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:ALT-B04","text":"Ontological / Temporal level — Realität besitzt keine ruhende Selbstidentität; sie ist nachträgliche Unmittelbarkeit, negative Relation und fortgesetzte Bewegung der Selbsterhaltung.","refs":["CH_GB18_DASB:ALT2","CH_GB18_AN_2:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:ALT-B05","text":"Methodological / Performative level — Die Form des Clusters vollzieht seine These, indem sie jede scheinbar positive Bestimmung wieder in ihre ausgeschlossene Bedingung zurückführt und daraus den nächsten Übergang erzeugt.","refs":["CH_GB18_DASB:FGS5","CH_GB18_BQT0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_07:FL-01","text":"Die Architektur benötigt Daseyn zugleich als erstes unmittelbares Resultat und als Effekt vorausgehender Vermittlung; diese Spannung ist produktiv, weil sie Unmittelbarkeit selbst historisiert.","refs":["CH_GB18_DASB:MRT6","CH_GB18_DASB:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FL-02","text":"Realität muss Negation ausschließen, um als Positives zu erscheinen, obwohl sie als Bestimmtheit nur durch diese ausgeschlossene Negation Realität ist.","refs":["CH_GB18_BQT0:MRT7","CH_GB18_BQT0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FL-03","text":"Die Kritik affirmativer Totalität begründet negativ den Bedarf nach wahrer Unendlichkeit, lässt deren positive Form aber ausdrücklich unterbestimmt.","refs":["CH_GB18_AN_2:NX4","CH_GB18_AN_2:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FL-04","text":"Der Übergang von der logischen Negativität der Qualität zur kämpfenden Selbsterhaltung der Eigenschaft bleibt ein notwendiger, aber nur teilweise vermittelter Sprung.","refs":["CH_GB18_AN_2:MRT7","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MP-01","text":"Der Begriff des Nichtseyns mutiert, sobald er nicht mehr als Moment des Werdens, sondern als im Seyn aufgenommene Bestimmtheit fungiert.","refs":["CH_GB18_DASB:A2","CH_GB18_DASB:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MP-02","text":"Negation mutiert von einer reflektierten Verneinung zu Grenze, Schranke und Mangel, wodurch sie von einem logischen Moment zu einer strukturellen Relationsform wird.","refs":["CH_GB18_BQT0:A8","CH_GB18_BQT0:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MP-03","text":"Realität mutiert von der bestimmten Qualität zu einem Prüfbegriff der Ontologie, sobald ihr Anspruch auf reine Vollkommenheit oder vollständige Totalität untersucht wird.","refs":["CH_GB18_AN_2:AS3","CH_GB18_AN_2:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MP-04","text":"Qualität mutiert terminal zur Eigenschaft, wenn ihre negative Struktur als aktive Erhaltung gegen fremde Einwirkung bestimmt wird.","refs":["CH_GB18_AN_2:NX8","CH_GB18_AN_2:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_07:HSI-01","text":"Realität erscheint implizit als Maschine bestimmter Negativität: Sie produziert keine stabilen Dinge, sondern resultative Unmittelbarkeiten, Grenzen, Relationen und Bewegungen.","refs":["CH_GB18_DASB:SD4","CH_GB18_AN_2:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:HSI-02","text":"Das endliche Individuum erscheint nicht als souveräner Träger fertiger Eigenschaften, sondern als prekäre Konfiguration, die ihre Bestimmung nur durch Widerstand gegen Anderes erhält.","refs":["CH_GB18_AN_2:D5","CH_GB18_AN_2:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:HSI-03","text":"Zeit erscheint als nichtlineare Nachträglichkeit: Was als unmittelbar vorliegt, bewahrt die aufgehobene Bewegung seiner eigenen Genese und kann deshalb erneut differenziert werden.","refs":["CH_GB18_DASB:D3","CH_GB18_DASB:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:HSI-04","text":"Kampf bleibt nicht äußerer Zusatz zur Realität, sondern die sichtbare Form jener negativen Selbstbeziehung, durch die bestimmte Existenz sich erhält, ohne unabhängige Selbständigkeit zu gewinnen.","refs":["CH_GB18_AN_2:A11","CH_GB18_AN_2:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_07:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Clusterbewegung von aufgehobener Vermittlung über Qualität und bestimmte Negation bis zur dynamischen Eigenschaft zu rekonstruieren.","refs":["CH_GB18_DASB:MRT1","CH_GB18_BQT0:MRT1","CH_GB18_AN_2:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MRT-B02","text":"Die Rekonstruktion ist kohärent, sofern Unmittelbarkeit nie als vermittlungslose Gegebenheit und Negation nie als reines Nichts oder bloßer Mangel behandelt wird.","refs":["CH_GB18_DASB:MRT3","CH_GB18_BQT0:MRT4","CH_GB18_AN_2:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MRT-B03","text":"Die stärkste Architekturleistung liegt in der Durchhaltung einer einzigen generativen Funktion: Bestimmtheit erzeugt Realität nur als Negativität, und diese Negativität erzwingt Relation, Grenze und Bewegung.","refs":["CH_GB18_DASB:MRT5","CH_GB18_AN_2:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MRT-B04","text":"Unterbestimmt bleiben die positive Gestalt des wahren Unendlichen und die vollständige Vermittlung des Übergangs von logischer Qualität zu kämpfender Eigenschaft.","refs":["CH_GB18_AN_2:MRT3","CH_GB18_AN_2:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MRT-B05","text":"Die Minimalrekonstruktion bewahrt die tatsächliche Clusterbewegung nur, wenn die Abfolge nicht als lineare Reihe von Begriffen, sondern als Rückkehr der ausgeschlossenen Negativität in immer höheren Funktionsformen gelesen wird.","refs":["CH_GB18_DASB:FGS6","CH_GB18_BQT0:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120720239749Z_70a19b7d","language_code":"en","language_name":"English","title":"Chapters 19–21","source_sha256":"670e5be205f5f3b66342b05cc12e75c3ba8eb4370a335d941590614307df3985","sha256":"16146b44bf83080afeeb04719e526735ff63b1df633f39fe18eb549b25faf1a0","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:07:20.241326+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_07:AS-01","text":"The cluster determines reality not as given positivity, but as the result of a mediation whose sublated origin continues to operate in every immediacy.","refs":["CH_GB18_DASB:AS1","CH_GB18_DASB:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-02","text":"Daseyn constitutes the first node of this architecture: it is immediate determinate Seyn, because Seyn and Nichtseyn are not externally joined but contained in a sublated unity.","refs":["CH_GB18_DASB:A4","CH_GB18_DASB:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-03","text":"Quality arises by isolating determinacy from the initially undifferentiated unity; this isolation simultaneously renders it legible as limited and negative determinacy.","refs":["CH_GB18_BQT0:AS3","CH_GB18_BQT0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-04","text":"Reality and negation do not appear as opposing spheres, but as disjoined functions of the same Daseyn, whose positivity initially conceals its own negativity.","refs":["CH_GB18_BQT0:AS6","CH_GB18_BQT0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-05","text":"The note generalizes this conceptual movement into a critique of every concept of reality that seeks to treat determinacy as negation-free perfection or totality.","refs":["CH_GB18_AN_2:AS2","CH_GB18_AN_2:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-06","text":"The directed movement leads from sublated mediation through determinate negation to the insight that the removal of all negation turns into empty being, whereas its affirmative totalization produces contradiction.","refs":["CH_GB18_AN_2:A4","CH_GB18_AN_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-07","text":"At this level, quality does not end as a resting constitution, but mutates into property, which sustains itself only through relation to an other, counteraction, and struggle.","refs":["CH_GB18_AN_2:A10","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AS-08","text":"The cluster movement is recursive and spiral-shaped: mediation produces immediacy, immediacy contains negation, negation differentiates reality, and reality is determined as moving self-preservation against its dissolution.","refs":["CH_GB18_DASB:FGS2","CH_GB18_AN_2:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_07:GA-01","text":"[Persistent] Every immediacy of Daseyn is resultant: it appears immediate because the mediation from which it emerges is sublated and preserved within it.","refs":["CH_GB18_DASB:A5","CH_GB18_DASB:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-02","text":"[Persistent] Determinacy is not an external addition to Seyn, but the negation taken up into Seyn and effective within it.","refs":["CH_GB18_DASB:A7","CH_GB18_DASB:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-03","text":"[Mutating] Nichtseyn mutates from a moment of becoming into a negativity contained in Daseyn and further into limit, restriction, lack, resistance, and self-preservation.","refs":["CH_GB18_DASB:FGS3","CH_GB18_BQT0:A10","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-04","text":"[Persistent] Quality is the isolated form of existent determinacy, not the complete scope of all possible determinations.","refs":["CH_GB18_BQT0:A5","CH_GB18_BQT0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-05","text":"[Emergent] Reality and negation are coextensive forms of Daseyn; their distinction articulates an internal difference rather than a separation of two ontological domains.","refs":["CH_GB18_BQT0:A9","CH_GB18_BQT0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-06","text":"[Attractor] Positivity is possible only as a selective mode of appearance, because it excludes its constitutive negativity and thereby compels its return.","refs":["CH_GB18_BQT0:A12","CH_GB18_BQT0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-07","text":"[Emergent] Every affirmative totalization of determinate reality is self-sublating: without negation it becomes abstract being; with all determinacies it becomes a totality of contradictions.","refs":["CH_GB18_AN_2:A5","CH_GB18_AN_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-08","text":"[Terminal] Property is not a resting form, but the active preservation of immanent determinacy in external relation and negative counteraction.","refs":["CH_GB18_AN_2:A10","CH_GB18_AN_2:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-09","text":"[Persistent] Only determinations posited in the concept may carry the development; external reflection may elucidate, but cannot generate immanent necessity.","refs":["CH_GB18_DASB:A9","CH_GB18_DASB:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GA-10","text":"[Attractor] Finite individuality possesses no substantial independence within mere categories of being, but only a limited, relational, and conflictual self-assertion.","refs":["CH_GB18_AN_2:A8","CH_GB18_AN_2:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_07:RMD-01","text":"Seyn and Nothing do not recur as stable objects: their initial unity in Daseyn is displaced into the inner structure of determinacy and finally into the difference of reality and negation.","refs":["CH_GB18_BQT0:A1","CH_GB18_BQT0:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RMD-02","text":"Mediation loses its independent form in Daseyn, yet remains effective as resultant origin and prevents immediacy from counting as presuppositionless givenness.","refs":["CH_GB18_DASB:A3","CH_GB18_DASB:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RMD-03","text":"Determinacy remains persistent as a concept, but mutates functionally from the unity of Seyn and Nichtseyn through quality into the negative structure of reality, limit, restriction, and lack.","refs":["CH_GB18_DASB:A7","CH_GB18_BQT0:A5","CH_GB18_BQT0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RMD-04","text":"Reality shifts from a determinate quality to a testing concept at which ontological perfection, abstract substance, and the relation of idea and Dasein fail.","refs":["CH_GB18_AN_2:AS3","CH_GB18_AN_2:ME2","CH_GB18_AN_2:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RMD-05","text":"Negation recurs as a functional constant, but changes its valence: it is neither pure nothing nor mere lack, but the condition of determinate reality, limit, relation, and movement.","refs":["CH_GB18_BQT0:NX5","CH_GB18_BQT0:D9","CH_GB18_AN_2:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RMD-06","text":"The finite individual is displaced from the notion of atomic independence and absorbed into an architecture of limited self-relation, resistance, and self-preservation.","refs":["CH_GB18_AN_2:D4","CH_GB18_AN_2:ME5","CH_GB18_AN_2:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_07:CGD-01","text":"The rejection of a spatial reading of Daseyn remains a local conceptual purification and supports the cluster architecture only insofar as it separates concreteness from external localization.","refs":["CH_GB18_DASB:NX2","CH_GB18_DASB:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:CGD-02","text":"The mere sequence Seyn, Nothing, Becoming, and Daseyn remains a lower level of development; at the cluster level, only its resultant transformation into a theory of immanent negativity matters.","refs":["CH_GB18_DASB:FGS1","CH_GB18_DASB:FGS2","CH_GB18_DASB:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:CGD-03","text":"The methodological difference between conceptually posited determination and external reflection scales into the global rule that reality may be explained only from immanent self-determination and not from presupposed predication.","refs":["CH_GB18_DASB:SD3","CH_GB18_AN_2:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:CGD-04","text":"The individual derivation of limit, restriction, and lack becomes, at the cluster level, the more comprehensive thesis that every positive determinacy produces a negative relational form.","refs":["CH_GB18_BQT0:D8","CH_GB18_AN_2:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:CGD-05","text":"The still underdetermined positive concept of the true infinite remains outside the attained cluster architecture; the cluster produces its negative precondition, but not its positive determination.","refs":["CH_GB18_AN_2:NX4","CH_GB18_AN_2:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_07:GNX-01","text":"Excluded is an ontology of pure immediacy in which Daseyn could subsist independently of sublated mediation and inner negativity.","refs":["CH_GB18_DASB:SNX1","CH_GB18_DASB:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GNX-02","text":"Excluded is an external model of difference that separates Seyn and Nothing as finished entities and establishes their unity only subsequently.","refs":["CH_GB18_DASB:SNX2","CH_GB18_BQT0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GNX-03","text":"Excluded is a reality that is supposed to subsist as pure affirmation, perfection, or positivity without constitutive negation.","refs":["CH_GB18_AN_2:NX3","CH_GB18_BQT0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GNX-04","text":"Excluded is a metaphysics that could present the sum of determinate realities as a contradiction-free highest unity.","refs":["CH_GB18_AN_2:NX5","CH_GB18_AN_2:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:GNX-05","text":"Excluded is the notion that the finite could subsist as a relationless, unrestricted, or substantially independent unity within the sphere of being.","refs":["CH_GB18_AN_2:DNX4","CH_GB18_AN_2:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_07:DBN-01","text":"It must be false that a determinate content can subsist without negation of another; otherwise determinacy would lose its ground and reality its differentiability.","refs":["CH_GB18_AN_2:DNX1","CH_GB18_AN_2:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:DBN-02","text":"It must be false that the removal of all limits preserves the content of the determinate; it sublates determinate reality and leads back into abstract being and nothing.","refs":["CH_GB18_AN_2:DNX2","CH_GB18_AN_2:A4","CH_GB18_AN_2:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:DBN-03","text":"It must be false that truth can be attained through the choice between external Dasein and an idea indifferent to Daseyn.","refs":["CH_GB18_AN_2:AS1","CH_GB18_AN_2:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:DBN-04","text":"It must be false that negation can function either as an eliminable lack or as conclusive metaphysical content; rather, it is the form of movement of determinate reality.","refs":["CH_GB18_AN_2:DNX5","CH_GB18_AN_2:A9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_07:BSA-01","text":"Unavailable remains a positive absolute that could be represented as immediately fulfilled totality prior to all difference, negation, and mediation.","refs":["CH_GB18_AN_2:SNX1","CH_GB18_AN_2:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSA-02","text":"Impossible remains a conflict-free self-identity of determinate predicates, because every determinacy is determined only as negation and relation to an other.","refs":["CH_GB18_AN_2:SNX3","CH_GB18_AN_2:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSA-03","text":"Unavailable remains a finite individuality that would be at once independent, limitless, and an-und-für-sich; its only possible form is relational self-preservation in resistance.","refs":["CH_GB18_AN_2:SNX4","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_07:XD-01","text":"The resultant immediacy of Daseyn makes quality not an externally classified property, but the manner in which sublated mediation continues to operate as determinate negativity.","refs":["CL_GB18_07:GA-01","CL_GB18_07:GA-02","CL_GB18_07:GA-04","CH_GB18_DASB:SD1","CH_GB18_BQT0:SD2"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_07:XD-02","text":"The positive appearance of reality becomes the transitional mechanism of critique: precisely by excluding negation, reality exposes itself as an inadequate ground for an affirmative ontology.","refs":["CL_GB18_07:GA-05","CL_GB18_07:GA-06","CL_GB18_07:GA-07","CH_GB18_BQT0:A12","CH_GB18_AN_2:SD1"],"deep_refs":[],"trace_type":"Tension.","passages":[]},{"id":"CL_GB18_07:XD-03","text":"The alternative between empty being and contradictory totality functions as a systemic test for every theory that seeks to define reality through the intensification or accumulation of positive predicates.","refs":["CL_GB18_07:GA-02","CL_GB18_07:GA-07","CH_GB18_AN_2:A5","CH_GB18_AN_2:SD2"],"deep_refs":[],"trace_type":"Negative.","passages":[]},{"id":"CL_GB18_07:XD-04","text":"Dynamic property arises only when the negation contained in Daseyn becomes effective not merely as logical difference, but as external counteraction and inner unrest.","refs":["CL_GB18_07:GA-03","CL_GB18_07:GA-08","CL_GB18_07:GA-10","CH_GB18_AN_2:A10","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_07:XD-05","text":"The critique of isolated reality and the critique of independent substance follow the same pattern: what posits itself as positive Für-sich either loses determinacy or is rendered relational by its excluded negativity.","refs":["CL_GB18_07:GA-06","CL_GB18_07:GA-10","CH_GB18_AN_2:D6","CH_GB18_AN_2:ME4"],"deep_refs":[],"trace_type":"Composite.","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_07:BSD-01","text":"Reality is reconfigured as the self-relation of determinate negativity: it is neither mere presence nor pure idea, but a form of movement produced through difference, limit, and mediation.","refs":["CH_GB18_AN_2:A1","CH_GB18_AN_2:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSD-02","text":"The cluster transforms abstraction from a method of purification into a critical indicator: abstraction destroys its object as soon as it removes its determinate negativity.","refs":["CH_GB18_AN_2:A4","CH_GB18_AN_2:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSD-03","text":"The ontology of affirmative totality is overcome not by a counter-affirmation, but by demonstrating its double self-dissolution into emptiness or contradiction.","refs":["CH_GB18_AN_2:A5","CH_GB18_AN_2:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSD-04","text":"The finite receives no independent status of being, but neither does it receive mere annihilation: it is determined as a precarious form of self-preservation that can subsist only in relation to an other.","refs":["CH_GB18_AN_2:A8","CH_GB18_AN_2:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:BSD-05","text":"Methodologically, an immanent form of critique arises in which a concept is not rejected against an alien standard, but disintegrates through the consequences of its own abstraction, positivization, and totalization.","refs":["CH_GB18_DASB:A9","CH_GB18_AN_2:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_07:RLE-01","text":"The basic loop runs from mediation to resultant immediacy, from immediacy to determinacy, and from determinacy to a negation that releases the movement of mediation anew.","refs":["CH_GB18_DASB:FGS2","CH_GB18_DASB:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RLE-02","text":"Reality forms a recursive attractor: it appears as a positive result, excludes negation, and precisely thereby must be regained as negatively determined reality.","refs":["CH_GB18_BQT0:A12","CH_GB18_AN_2:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RLE-03","text":"Totalization forms an escalation loop because it empties itself through the removal of negation and turns into contradictory excess through the preservation of all determinations.","refs":["CH_GB18_AN_2:A4","CH_GB18_AN_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RLE-04","text":"Limit, restriction, and lack are not terminal deficits, but transition points at which determinacy turns into relation, resistance, and moving self-preservation.","refs":["CH_GB18_BQT0:D8","CH_GB18_AN_2:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:RLE-05","text":"Determinate negation is the conceptual attractor of the cluster because it connects Daseyn, quality, reality, critique of totality, and dynamic property in a single generative function.","refs":["CH_GB18_BQT0:D6","CH_GB18_AN_2:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_07:FGS-B01","text":"Seyn and Nichtseyn are not added together, but mediated through becoming; mediation sublates itself and posits Daseyn as resultant immediacy.","refs":["CH_GB18_DASB:A2","CH_GB18_DASB:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FGS-B02","text":"Daseyn takes Nichtseyn into itself; its determinacy thereby becomes not external predication, but immanent negativity.","refs":["CH_GB18_DASB:A6","CH_GB18_DASB:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FGS-B03","text":"The isolation of existent determinacy produces quality, whose immediate positivity always contains a determination of nothing.","refs":["CH_GB18_BQT0:A5","CH_GB18_BQT0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FGS-B04","text":"The reflection of this contained negativity differentiates reality and negation and produces limit, restriction, and lack as internal forms of quality.","refs":["CH_GB18_BQT0:A8","CH_GB18_BQT0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FGS-B05","text":"The expansion of positive reality into a totality necessarily leads either to the abstraction of all determinacy or to the totality of contradictions.","refs":["CH_GB18_AN_2:A4","CH_GB18_AN_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FGS-B06","text":"The self-dissolution of static reality compels the recoding of quality as property: determinacy subsists only as negative self-preservation in relation, counteraction, and struggle.","refs":["CH_GB18_AN_2:A10","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_07:AFM-B01","text":"Mediation of Seyn and Nichtseyn → sublation of mediation → Daseyn as resultant immediacy.","refs":["CH_GB18_DASB:A2","CH_GB18_DASB:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AFM-B02","text":"Daseyn as unity → immanent determinacy → isolation of existent determinacy as quality.","refs":["CH_GB18_DASB:A7","CH_GB18_BQT0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AFM-B03","text":"Quality → contained negation → distinction of reality and negation → limit, restriction, and lack.","refs":["CH_GB18_BQT0:D5","CH_GB18_BQT0:D7","CH_GB18_BQT0:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AFM-B04","text":"Reality as apparent positivity → exclusion of its own negativity → critique of a negation-free perfection.","refs":["CH_GB18_BQT0:SD4","CH_GB18_AN_2:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AFM-B05","text":"Affirmative totalization → indeterminacy or contradiction → withdrawal of substantial independence from attribute, mode, and individual.","refs":["CH_GB18_AN_2:A5","CH_GB18_AN_2:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:AFM-B06","text":"Loss of static independence → relational determinacy → property as self-preservation in resistance and struggle.","refs":["CH_GB18_AN_2:D5","CH_GB18_AN_2:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_07:MME-01","text":"Immediacy is mapped as a condensed history of sublated mediation and no longer understood as the mere absence of mediation.","refs":["CH_GB18_DASB:ME1","CH_GB18_DASB:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MME-02","text":"The map of the negative shifts from an external counterpole of reality to an immanent condition of its determinacy, limitation, and mobility.","refs":["CH_GB18_DASB:ME2","CH_GB18_BQT0:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MME-03","text":"The opposition of reality and idea loses its exclusive form because both appear as abstract one-sidednesses as soon as they are separated from determinate negativity.","refs":["CH_GB18_AN_2:NX1","CH_GB18_AN_2:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MME-04","text":"Ontological perfection is redrawn from a highest positive content into a mechanism of self-testing that identifies totalization as emptying or contradiction.","refs":["CH_GB18_AN_2:ME3","CH_GB18_AN_2:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MME-05","text":"Individuality is reclassified not as an atomic unity, but as a limited capacity for preserving an immanent determination against external influence.","refs":["CH_GB18_AN_2:ME5","CH_GB18_AN_2:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_07:ALT-B01","text":"Surface level — The cluster treats Daseyn, quality, reality, negation, limit, restriction, lack, ontological perfection, substance, and property.","refs":["CH_GB18_BQT0:AS5","CH_GB18_AN_2:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:ALT-B02","text":"Structural level — The recurring structure is the production of determinate reality through negation and its self-dissolution as soon as negation is removed, denied, or totalized.","refs":["CH_GB18_BQT0:ALT2","CH_GB18_AN_2:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:ALT-B03","text":"Metastrategic level — The argumentative intervention replaces external juxtapositions with immanent derivation and lets opposing models of reality disintegrate through their own presuppositions.","refs":["CH_GB18_DASB:ALT3","CH_GB18_AN_2:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:ALT-B04","text":"Ontological / Temporal level — Reality possesses no resting self-identity; it is retrospective immediacy, negative relation, and continued movement of self-preservation.","refs":["CH_GB18_DASB:ALT2","CH_GB18_AN_2:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:ALT-B05","text":"Methodological / Performative level — The form of the cluster performs its thesis by leading every apparently positive determination back into its excluded condition and thereby generating the next transition.","refs":["CH_GB18_DASB:FGS5","CH_GB18_BQT0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_07:FL-01","text":"The architecture requires Daseyn both as the first immediate result and as the effect of preceding mediation; this tension is productive because it historicizes immediacy itself.","refs":["CH_GB18_DASB:MRT6","CH_GB18_DASB:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FL-02","text":"Reality must exclude negation in order to appear as positive, although as determinacy it is reality only through this excluded negation.","refs":["CH_GB18_BQT0:MRT7","CH_GB18_BQT0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FL-03","text":"The critique of affirmative totality negatively grounds the need for true infinity, but leaves its positive form expressly underdetermined.","refs":["CH_GB18_AN_2:NX4","CH_GB18_AN_2:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:FL-04","text":"The transition from the logical negativity of quality to the struggling self-preservation of property remains a necessary, but only partially mediated, leap.","refs":["CH_GB18_AN_2:MRT7","CH_GB18_AN_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MP-01","text":"The concept of Nichtseyn mutates as soon as it functions no longer as a moment of becoming, but as determinacy taken up into Seyn.","refs":["CH_GB18_DASB:A2","CH_GB18_DASB:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MP-02","text":"Negation mutates from a reflected negation into limit, restriction, and lack, whereby it becomes from a logical moment a structural relational form.","refs":["CH_GB18_BQT0:A8","CH_GB18_BQT0:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MP-03","text":"Reality mutates from determinate quality into a testing concept of ontology as soon as its claim to pure perfection or complete totality is examined.","refs":["CH_GB18_AN_2:AS3","CH_GB18_AN_2:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MP-04","text":"Quality mutates terminally into property when its negative structure is determined as active preservation against alien influence.","refs":["CH_GB18_AN_2:NX8","CH_GB18_AN_2:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_07:HSI-01","text":"Reality appears implicitly as a machine of determinate negativity: it produces not stable things, but resultant immediacies, limits, relations, and movements.","refs":["CH_GB18_DASB:SD4","CH_GB18_AN_2:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:HSI-02","text":"The finite individual appears not as a sovereign bearer of finished properties, but as a precarious configuration that preserves its determination only through resistance against an other.","refs":["CH_GB18_AN_2:D5","CH_GB18_AN_2:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:HSI-03","text":"Time appears as nonlinear retrospectivity: what is immediately present preserves the sublated movement of its own genesis and can therefore be differentiated anew.","refs":["CH_GB18_DASB:D3","CH_GB18_DASB:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:HSI-04","text":"Struggle remains not an external addition to reality, but the visible form of that negative self-relation through which determinate existence preserves itself without attaining independent self-subsistence.","refs":["CH_GB18_AN_2:A11","CH_GB18_AN_2:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_07:MRT-B01","text":"The extracted axioms suffice to reconstruct the cluster movement from sublated mediation through quality and determinate negation to dynamic property.","refs":["CH_GB18_DASB:MRT1","CH_GB18_BQT0:MRT1","CH_GB18_AN_2:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MRT-B02","text":"The reconstruction is coherent provided that immediacy is never treated as mediationless givenness and negation never as pure nothing or mere lack.","refs":["CH_GB18_DASB:MRT3","CH_GB18_BQT0:MRT4","CH_GB18_AN_2:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MRT-B03","text":"The strongest architectural achievement lies in maintaining a single generative function: determinacy produces reality only as negativity, and this negativity compels relation, limit, and movement.","refs":["CH_GB18_DASB:MRT5","CH_GB18_AN_2:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MRT-B04","text":"The positive form of true infinity and the complete mediation of the transition from logical quality to struggling property remain underdetermined.","refs":["CH_GB18_AN_2:MRT3","CH_GB18_AN_2:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_07:MRT-B05","text":"The minimal reconstruction preserves the actual cluster movement only if the sequence is read not as a linear series of concepts, but as the return of excluded negativity in ever higher functional forms.","refs":["CH_GB18_DASB:FGS6","CH_GB18_BQT0:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_07@R001","source_variant_id":"canonical:CL_GB18_07:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 19–21","context":"a. Daseyn überhaupt. · b. Qualität. · Anmerkung."},"title_language_code":"en"},{"id":"CL_GB18_08","layer":"CL","title":"Chapters 22–24","order":8,"parents":["CH_GB18_CETW","CH_GB18_BDE0","CH_GB18_EUEA"],"revision":"CL_GB18_08@R001","sha256":"14e80ca5f9242cec8e198c562681dd8253c7cc41ab691e0cb98a150244fb5a56","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_08:AS-B01","text":"Das System bestimmt Etwas nicht als bereits gegebenen Träger äußerer Unterschiede, sondern als Resultat einer Bestimmtheit, die Negation in sich enthält.","refs":["CH_GB18_EUEA:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B02","text":"Die Gleichrangigkeit von Etwas und Anderem entzieht jedem Einzelnen ontologische Priorität und macht Andersheit zu einer reziproken Form derselben Daseinsweise.","refs":["CH_GB18_EUEA:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B03","text":"Die zunächst äußerlich erscheinende Negation wird schrittweise in die Bestimmtheit des Etwas zurückgenommen und verliert dadurch den Status einer bloß fremden Gegenmacht.","refs":["CH_GB18_CETW:AS2","CH_GB18_BDE0:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B04","text":"Aufhebung erzeugt Identität nicht durch Tilgung des Unterschieds, sondern durch dessen Erhaltung als vermittelte Negativität.","refs":["CH_GB18_CETW:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B05","text":"Ansichseyn und Seyn-für-Anderes erscheinen als untrennbare Momente, durch die Selbstbeziehung nur als Beziehung auf Andersheit möglich wird.","refs":["CH_GB18_EUEA:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B06","text":"Die immanente Rücknahme des Seyns-für-Anderes erzeugt Grenze; Grenze erzeugt Endlichkeit als Selbstbestimmung des Etwas.","refs":["CH_GB18_BDE0:A8","CH_GB18_BDE0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B07","text":"Die Bewegung ist kumulativ-negativ: affirmative Qualität wird über erste Negation in eine Negation der Negation überführt, ohne die qualitative Sphäre zu verlassen.","refs":["CH_GB18_BDE0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B08","text":"Qualität kehrt als reflektierte Bestimmtheit zurück und erweist sich damit als Resultat von Andersheit, nicht als deren voraussetzungsloser Anfang.","refs":["CH_GB18_EUEA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B09","text":"Die gegenwärtige Sphäre vollzieht Übergehen, aber noch kein Setzen; sie erzeugt reale Vermittlung, ohne ihre konkrete Hervorbringung bereits explizit zu machen.","refs":["CH_GB18_EUEA:A12","CH_GB18_EUEA:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B10","text":"Die Schließung des Clusters besteht in einer endlichen, bestimmten und relationalen Qualität, deren wahres Ansich nicht hinter ihren Bestimmungen liegt.","refs":["CH_GB18_EUEA:A10","CH_GB18_EUEA:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_08:GA-01","text":"[Persistent] Daseyn ist nur als bestimmte Qualität tragfähig, weil Realität und Negation nicht äußerlich getrennt, sondern im selben Daseyn verschränkt sind.","refs":["CH_GB18_CETW:A1","CH_GB18_CETW:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-02","text":"[Persistent] Etwas und Anderes sind strukturell gleichrangige Etwas; Andersheit begründet keine Priorität eines ersten oder eigentlichen Seins.","refs":["CH_GB18_EUEA:A1","CH_GB18_EUEA:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-03","text":"[Persistent] Aufhebung bewahrt den Unterschied als wirksame Negativität und erzeugt aus ihm vermittelte Selbstgleichheit.","refs":["CH_GB18_CETW:AS3","CH_GB18_CETW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-04","text":"[Mutating] Ansichseyn mutiert von einer zunächst einfachen Selbstbeziehung zur Einheit mit Seyn-für-Anderes und verliert damit jede relationslose Innerlichkeit.","refs":["CH_GB18_EUEA:A7","CH_GB18_EUEA:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-05","text":"[Emergent] Grenze ist die im Etwas wirksame Form seines negierten Bezogenseins auf Anderes und bestimmt dieses Etwas als endlich.","refs":["CH_GB18_BDE0:D4","CH_GB18_BDE0:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-06","text":"[Mutating] Negation durchläuft die Folge äußerliche Differenz, immanente Bestimmtheit und Negation der Negation; Endlichkeit ist ihr bestimmtes Resultat, nicht ihr äußerer Zusatz.","refs":["CH_GB18_BDE0:SD4","CH_GB18_BDE0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-07","text":"[Mutating] Qualität ist nicht bloße Unmittelbarkeit, sondern die Rückkehr reflektierter Andersheit in einfaches Seyn.","refs":["CH_GB18_EUEA:A13","CH_GB18_EUEA:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-08","text":"[Terminal] Die Sphäre des Seyns vollzieht Bestimmung als Übergehen und kann konkrete Vermittlung noch nicht als reflektierendes Setzen ausweisen.","refs":["CH_GB18_EUEA:A12","CH_GB18_EUEA:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-09","text":"[Attractor] Das wahre Ansich eines Etwas ist sein konkreter Zusammenhang von Bestimmungen; ein bestimmungsloses Ding-an-sich ist keine verbleibende Erkenntnisgrenze.","refs":["CH_GB18_EUEA:A10","CH_GB18_EUEA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-10","text":"[Terminal] Die negative Selbstbeziehung eröffnet Subjektivität, liefert auf der Stufe des Etwas aber noch keine konkrete Form des Subjekts.","refs":["CH_GB18_CETW:A11","CH_GB18_CETW:SNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_08:RMD-01","text":"Negation kehrt wieder, behält aber nicht dieselbe Funktion: Sie beginnt als im Daseyn enthaltene Differenz, erscheint als äußerliche Gegenbestimmung und wird schließlich als immanente Grenze produktiv.","refs":["CH_GB18_CETW:AS2","CH_GB18_BDE0:A3","CH_GB18_BDE0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RMD-02","text":"Das Andere mutiert von einem gleichrangigen Etwas über das Andere seiner selbst zu einem inneren Moment der Bestimmtheit des Etwas.","refs":["CH_GB18_EUEA:A1","CH_GB18_EUEA:A4","CH_GB18_BDE0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RMD-03","text":"Aufhebung bleibt als Struktur erhalten, verschiebt sich aber von der Vermittlung von Realität und Negation zur Rücknahme äußerlicher Andersheit in die Selbstbestimmung des Endlichen.","refs":["CH_GB18_CETW:AS3","CH_GB18_BDE0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RMD-04","text":"Ansichseyn wandert von vermittelte Einfachheit über die Einheit mit Seyn-für-Anderes zur Kritik eines abstrakten Inneren, das von allen Bestimmungen abgesondert wäre.","refs":["CH_GB18_CETW:A8","CH_GB18_EUEA:A9","CH_GB18_EUEA:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RMD-05","text":"Qualität kehrt funktional wieder, doch ihre Valenz kippt: Was zunächst Daseyn bestimmt, wird zuletzt zum Resultat der in sich reflektierten Andersheit.","refs":["CH_GB18_CETW:A1","CH_GB18_EUEA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RMD-06","text":"Vermittlung wird als universelle Bedingung jedes Begriffs behauptet, bleibt in der Sphäre des Etwas jedoch noch ohne konkret gesetzte Seiten und markiert deshalb einen Übergangspunkt.","refs":["CH_GB18_CETW:A15","CH_GB18_CETW:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_08:CGD-01","text":"Die Unterscheidung von Realität und Negation bleibt als lokale Ausgangsgrammatik des qualitativen Daseyns untergeordnet; auf Clusterebene trägt nur die Regel, dass Bestimmtheit sich aus immanenter Negativität bildet.","refs":["CH_GB18_CETW:A2","CH_GB18_EUEA:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:CGD-02","text":"Die Formel des Anderen seiner selbst ist lokal die Selbstnegation des Anderen; auf Clusterebene fungiert sie als Transformationsoperator, der äußere Differenz in Selbstbeziehung überführt.","refs":["CH_GB18_EUEA:A4","CH_GB18_EUEA:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:CGD-03","text":"Die erste Subjektbestimmung bleibt ein lokaler Zukunftsverweis und wird nicht zur gegenwärtig erreichten Subjektivität erhoben.","refs":["CH_GB18_CETW:A11","CH_GB18_CETW:DNX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:CGD-04","text":"Die Differenz von Übergehen und Setzen ist auf Clusterebene keine beiläufige Stufenmarkierung, sondern die Grenzregel, die konkrete Reflexion von der gegenwärtigen Bewegungsform ausschließt.","refs":["CH_GB18_EUEA:A12","CH_GB18_EUEA:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:CGD-05","text":"Die Zuordnung von Natur und Geist bleibt lokale Anwendung und besitzt keine tragende Funktion für die Rekonstruktion der immanenten Bewegungslogik.","refs":["CH_GB18_EUEA:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_08:GNX-01","text":"Ausgeschlossen ist eine Ontologie reiner Unmittelbarkeit, in der Daseyn, Realität oder Etwas ohne immanente Negation bestehen könnten.","refs":["CH_GB18_CETW:NX3","CH_GB18_CETW:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GNX-02","text":"Ausgeschlossen ist ein absolut äußeres Anderes, das dem Etwas gegenüberstünde, ohne selbst Etwas zu sein und ohne in dessen Bestimmtheit zurückzukehren.","refs":["CH_GB18_BDE0:NX3","CH_GB18_EUEA:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GNX-03","text":"Ausgeschlossen ist eine Grenze als bloß äußerliche Schranke zwischen bereits fertigen und voneinander unabhängigen Entitäten.","refs":["CH_GB18_BDE0:NX4","CH_GB18_BDE0:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GNX-04","text":"Ausgeschlossen ist eine Identität, die durch Wegnahme des Unterschieds statt durch dessen Aufhebung hergestellt würde.","refs":["CH_GB18_CETW:NX4","CH_GB18_CETW:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GNX-05","text":"Ausgeschlossen ist ein relationsloses Ansich oder Ding-an-sich, dessen Wahrheit jenseits seiner bestimmenden Beziehungen läge.","refs":["CH_GB18_EUEA:NX3","CH_GB18_EUEA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_08:DBN-01","text":"Das System disqualifiziert das Gesamtmodell vorgegebener Substanzen, die erst nachträglich durch Beziehungen, Unterschiede oder Grenzen verbunden werden.","refs":["CH_GB18_EUEA:DNX1","CH_GB18_BDE0:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:DBN-02","text":"Das System disqualifiziert eine positive Realität, die Negation nur als äußerlichen Verlust, bloßes Nichts oder spätere Einschränkung behandeln könnte.","refs":["CH_GB18_CETW:NX1","CH_GB18_CETW:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:DBN-03","text":"Das System disqualifiziert eine Erkenntnistheorie des unzugänglichen Kerns, in der Bestimmungslosigkeit als Tiefe oder Erkenntnisverzicht als Weisheit gelten könnte.","refs":["CH_GB18_EUEA:SD4","CH_GB18_EUEA:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:DBN-04","text":"Das System disqualifiziert die Vorstellung, Endlichkeit sei ein zufälliger Mangel eines an sich unbegrenzten Etwas.","refs":["CH_GB18_BDE0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_08:BSA-01","text":"Unverfügbar ist ein Selbst, das sich ohne Nichtseyn, Andersheit und negative Selbstbeziehung unmittelbar mit sich identisch wüsste.","refs":["CH_GB18_CETW:DNX3","CH_GB18_EUEA:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:BSA-02","text":"Unzulässig ist eine vollständig konkrete Vermittlung auf der Stufe des Etwas, weil die gegenwärtige Bewegung nur Übergehen und noch kein reflektierendes Setzen vollzieht.","refs":["CH_GB18_CETW:SNX6","CH_GB18_EUEA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:BSA-03","text":"Unmöglich ist eine Bestimmung, die sich auf äußeres Zeigen oder subjektives Bezeichnen stützt, ohne ihre Differenz aus der Sache selbst hervorzubringen.","refs":["CH_GB18_EUEA:A3","CH_GB18_EUEA:NX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_08:XD-01","text":"Grenze ist die internalisierte Form reziproker Andersheit: Sie trennt Etwas nicht von einem fremden Außen, sondern hält dessen Bezogensein auf Anderes als eigene Bestimmung fest. ; Trace Type — Composite","refs":["CL_GB18_08:GA-02","CL_GB18_08:GA-04","CL_GB18_08:GA-05","CH_GB18_EUEA:A2","CH_GB18_BDE0:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:XD-02","text":"Endlichkeit ist die positive Qualität eines Etwas, insofern dessen Selbstbeziehung nur durch die in ihm wirksame Negation seines Seyns-für-Anderes besteht. ; Trace Type — Composite","refs":["CL_GB18_08:GA-04","CL_GB18_08:GA-05","CL_GB18_08:GA-07","CH_GB18_EUEA:A6","CH_GB18_BDE0:D5","CH_GB18_EUEA:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:XD-03","text":"Die Sphäre des Seyns besitzt bereits immanente Vermittlung, kann diese jedoch nicht als von ihr gesetzte Vermittlung ausweisen; ihre Wahrheit ist daher strukturell real, aber operationslogisch vorreflexiv. ; Trace Type — Tension","refs":["CL_GB18_08:GA-03","CL_GB18_08:GA-08","CH_GB18_CETW:A15","CH_GB18_EUEA:NX6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:XD-04","text":"Die Kritik des Ding-an-sich ist keine beiläufige epistemische Polemik, sondern die notwendige Konsequenz daraus, dass Ansichseyn nur als bestimmter Zusammenhang seiner Beziehung auf Anderes wahr sein kann. ; Trace Type — Negative","refs":["CL_GB18_08:GA-04","CL_GB18_08:GA-09","CH_GB18_EUEA:A9","CH_GB18_EUEA:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:XD-05","text":"Die eröffnete Subjektivität kann nur über die Endlichkeit hindurch entstehen: Die negative Selbstbeziehung des Etwas wird nicht durch Aufhebung seiner Grenze erreicht, sondern durch deren immanente Aneignung. ; Trace Type — Tension","refs":["CL_GB18_08:GA-05","CL_GB18_08:GA-06","CL_GB18_08:GA-10","CH_GB18_CETW:AS5","CH_GB18_BDE0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_08:BSD-01","text":"Realität erscheint als dynamische Konfiguration bestimmter Selbstbeziehungen, deren Stabilität gerade aus der fortwirkenden Negativität ihrer Unterschiede hervorgeht.","refs":["CL_GB18_08:GA-01","CL_GB18_08:GA-03","CL_GB18_08:GA-06","CH_GB18_CETW:SD1","CH_GB18_BDE0:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:BSD-02","text":"Erkenntnis verliert die Aufgabe, einen jenseitigen Kern zu erreichen, und wird zur Rekonstruktion der immanenten Bestimmungszusammenhänge eines Etwas.","refs":["CL_GB18_08:GA-04","CL_GB18_08:GA-09","CH_GB18_EUEA:D5","CH_GB18_EUEA:ME3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:BSD-03","text":"Zeitlichkeit erscheint als gerichtete Selbsttransformation: äußerliche Differenz wird nicht chronologisch addiert, sondern kehrt als veränderte Selbstbestimmung in die Sache zurück.","refs":["CL_GB18_08:GA-03","CL_GB18_08:GA-06","CL_GB18_08:GA-07","CH_GB18_CETW:SD4","CH_GB18_BDE0:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:BSD-04","text":"Dialektische Methode wird als Pflicht zur Verfolgung funktionaler Mutationen bestimmt; Begriffe dürfen weder als konstante Namen noch als fertige Entitäten behandelt werden.","refs":["CL_GB18_08:GA-02","CL_GB18_08:GA-06","CL_GB18_08:GA-08","CH_GB18_EUEA:ME4","CH_GB18_EUEA:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:BSD-05","text":"Die gegenwärtige Architektur erzeugt eine endliche Selbstbeziehung, deren Vollzug über ihre eigene Grenze hinausweist, ohne den späteren Übergang zur reflektierten Subjektivität vorwegzunehmen.","refs":["CL_GB18_08:GA-05","CL_GB18_08:GA-08","CL_GB18_08:GA-10","CH_GB18_CETW:MRT7","CH_GB18_EUEA:MRT7"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_08:RLE-01","text":"Die zentrale Schleife lautet: Andersheit → Selbstnegation → Selbstbeziehung → reflektierte Qualität → erneute Bestimmtheit gegenüber Anderem.","refs":["CH_GB18_EUEA:A4","CH_GB18_EUEA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RLE-02","text":"Die Negationsschleife lautet: Realität und Negation → Aufhebung → vermittelte Einfachheit → erneute Negativität als Grenze.","refs":["CH_GB18_CETW:AS2","CH_GB18_CETW:A8","CH_GB18_BDE0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RLE-03","text":"Der Eskalationspfad führt vom qualitativen Daseyn über Etwas und Anderes zu Ansichseyn, Beschaffenheit, Grenze und Endlichkeit.","refs":["CH_GB18_CETW:AS1","CH_GB18_BDE0:AS4","CH_GB18_BDE0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RLE-04","text":"Immanente Negation fungiert als begrifflicher Attraktor, weil jede äußerliche Differenz in eine Bestimmung des betreffenden Etwas zurückgeführt werden muss.","refs":["CH_GB18_BDE0:AS3","CH_GB18_BDE0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RLE-05","text":"Die Differenz von Übergehen und Setzen markiert eine Schwelle: Die Bewegung spiralt zur Reflexion hin, darf diese aber innerhalb der gegenwärtigen Sphäre nicht als erreicht behandeln.","refs":["CH_GB18_EUEA:A12","CH_GB18_EUEA:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_08:FGS-B01","text":"Qualitatives Daseyn + immanente Negation → bestimmter Unterschied von Realität und Negation.","refs":["CH_GB18_CETW:AS1","CH_GB18_CETW:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FGS-B02","text":"Vorhandener Unterschied + Aufhebung ohne Tilgung → vermittelte Einfachheit → Insichseyn → Etwas.","refs":["CH_GB18_CETW:AS3","CH_GB18_CETW:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FGS-B03","text":"Etwas + Anderes als gleichrangige Daseyende → Aufhebung der ontologischen Priorität eines ersten Etwas.","refs":["CH_GB18_EUEA:A1","CH_GB18_EUEA:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FGS-B04","text":"Äußerliche Negation + Rücknahme in die Bestimmtheit → Beschaffenheit als Einheit von Ansichseyn und Seyn-für-Anderes.","refs":["CH_GB18_BDE0:D2","CH_GB18_BDE0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FGS-B05","text":"Negiertes Seyn-für-Anderes + immanente Bestimmung → Grenze → Endlichkeit.","refs":["CH_GB18_BDE0:A7","CH_GB18_BDE0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FGS-B06","text":"Reflektierte Bestimmtheit → einfache Qualität; zugleich bleibt die konkrete Vermittlung als Setzen aufgeschoben.","refs":["CH_GB18_EUEA:A13","CH_GB18_EUEA:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_08:AFM-B01","text":"Qualitatives Daseyn → Realität und Negation als immanente Differenz.","refs":["CH_GB18_CETW:AS1","CH_GB18_CETW:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B02","text":"Immanente Differenz → Aufhebung ohne Verlust → vermittelte Einfachheit.","refs":["CH_GB18_CETW:AS3","CH_GB18_CETW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B03","text":"Vermittelte Einfachheit → Etwas → erste negative Selbstbeziehung.","refs":["CH_GB18_CETW:AS4","CH_GB18_CETW:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B04","text":"Etwas und Anderes → reziproke Andersheit → Selbstnegation des isolierten Anderen.","refs":["CH_GB18_EUEA:A2","CH_GB18_EUEA:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B05","text":"Selbstnegation → Einheit von Ansichseyn und Seyn-für-Anderes → bestimmte Beschaffenheit.","refs":["CH_GB18_EUEA:A7","CH_GB18_BDE0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B06","text":"Beschaffenheit → immanente Grenze → Endlichkeit als Selbstbestimmung.","refs":["CH_GB18_BDE0:A8","CH_GB18_BDE0:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B07","text":"Endliche Bestimmtheit → reflektierte Qualität → Schwelle von Übergehen zu künftigem Setzen.","refs":["CH_GB18_EUEA:A13","CH_GB18_EUEA:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_08:MME-01","text":"Differenz wird von einer Relation zwischen fertigen Gegenständen zu einer immanenten Bedingung der Selbstbestimmung jedes Etwas umkartiert.","refs":["CH_GB18_EUEA:ME1","CH_GB18_BDE0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MME-02","text":"Grenze wird von einer äußeren Trennlinie zu einer positiven Form der Endlichkeit und damit der Bestimmtheit umklassifiziert.","refs":["CH_GB18_BDE0:ME2","CH_GB18_BDE0:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MME-03","text":"Innen und Außen verlieren ihre ontologische Gegensätzlichkeit, weil das am Etwas Befindliche zu dessen Ansichseyn gehört.","refs":["CH_GB18_EUEA:D4","CH_GB18_EUEA:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MME-04","text":"Das Ding-an-sich wird von einem transzendenten Erkenntnisobjekt zu einer fehlerhaften Abstraktionsoperation umkartiert.","refs":["CH_GB18_EUEA:SD4","CH_GB18_EUEA:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MME-05","text":"Die Unterscheidung zwischen Übergehen und Setzen reorganisiert die logische Landschaft als Abfolge unterschiedlicher Operationsregime statt als bloße Folge von Gegenständen.","refs":["CH_GB18_EUEA:SD3","CH_GB18_EUEA:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_08:ALT-B01","text":"Oberflächenebene — Etwas, Anderes, Ansichseyn, Seyn-für-Anderes, Beschaffenheit, Grenze und Endlichkeit bilden die expliziten Gegenstände der Bewegung.","refs":["CH_GB18_EUEA:ALT1","CH_GB18_BDE0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:ALT-B02","text":"Strukturebene — Bestimmtheit entsteht durch die Integration von Negation, Beziehung auf Anderes, Selbstbeziehung und Rückkehr zur Qualität.","refs":["CH_GB18_EUEA:ALT2","CH_GB18_BDE0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:ALT-B03","text":"Metastrategische Ebene — Äußeres Bezeichnen, Vergleichen und Gegenüberstellen werden durch immanente Entwicklung als gültige Bestimmungsweise ersetzt.","refs":["CH_GB18_EUEA:A3","CH_GB18_EUEA:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:ALT-B04","text":"Ontologisch-temporale Ebene — Seyn ist eine negative Bewegung des Übergehens, in der Identität nur als fortgesetzte Rückkehr aus Andersheit besteht.","refs":["CH_GB18_CETW:ALT4","CH_GB18_EUEA:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:ALT-B05","text":"Methodologisch-performative Ebene — Die Darstellung vollzieht ihre These, indem sie jeden scheinbar festen Terminus durch seine immanente Negation in eine veränderte Funktion überführt.","refs":["CH_GB18_EUEA:AS3","CH_GB18_EUEA:A5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_08:FL-01","text":"Die Struktur beginnt mit einer äußerlichen Negation zwischen Etwas und Anderem, muss diese aber später als immer schon immanente Bestimmung ausweisen; der Status dieser anfänglichen Äußerlichkeit bleibt spannungsvoll.","refs":["CH_GB18_BDE0:A3","CH_GB18_BDE0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FL-02","text":"Selbstidentität wird dem sich negierenden Anderen zugeschrieben, ohne dass die Notwendigkeit des Übergangs von Veränderung zu Identität innerhalb der gegebenen Sphäre vollständig entfaltet wird.","refs":["CH_GB18_EUEA:A5","CH_GB18_EUEA:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FL-03","text":"Die Kritik eines abstrakten Ansich verlangt zugleich ein wahres Ansich als Begriff; die konkrete Gestalt dieser positiven Erkenntnisform wird vorausgesetzt, nicht im Cluster selbst erzeugt.","refs":["CH_GB18_EUEA:A10","CH_GB18_EUEA:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MP-01","text":"Realität und Negation mutieren von qualitativen Momenten des Daseyns zu der Selbstbegrenzung, durch welche das Etwas endlich wird.","refs":["CH_GB18_CETW:A3","CH_GB18_BDE0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MP-02","text":"Ansichseyn mutiert von einer einfachen Rückkehr zu sich selbst in eine negative Beziehung auf Seyn-für-Anderes und wird dadurch relational statt abgeschottet.","refs":["CH_GB18_CETW:A9","CH_GB18_EUEA:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MP-03","text":"Vermittlung mutiert von der allgemeinen Bedingung des Begriffs zur Grenzbestimmung der gegenwärtigen Sphäre, weil sie zwar wirksam, aber noch nicht als konkrete Vermittlung gesetzt ist.","refs":["CH_GB18_CETW:A15","CH_GB18_CETW:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_08:HSI-01","text":"Realität erscheint als Maschine immanenter Rücknahme: Jede Differenz erzeugt eine Beziehung, deren Rückkehr die betreffende Einheit verändert.","refs":["CH_GB18_CETW:SD4","CH_GB18_BDE0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:HSI-02","text":"Das Subjekt erscheint nicht als vorausgesetzte Instanz, sondern als noch unvollendete Möglichkeit negativer Selbstbeziehung.","refs":["CH_GB18_CETW:SD2","CH_GB18_CETW:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:HSI-03","text":"Zeit erscheint als logische Mutation, in der das Äußere nicht verschwindet, sondern als veränderte innere Bestimmung wiederkehrt.","refs":["CH_GB18_EUEA:A5","CH_GB18_BDE0:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:HSI-04","text":"Kampf, Navigation und Erkenntnis bestehen nicht in der Flucht aus Endlichkeit, sondern in der Rekonstruktion ihrer immanenten Bestimmungszusammenhänge.","refs":["CH_GB18_EUEA:D5","CH_GB18_BDE0:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_08:MRT-B01","text":"Die globalen Axiome reichen aus, um die Bewegung vom qualitativen Daseyn über Etwas, Anderes und Ansichseyn bis zu Grenze und Endlichkeit zu rekonstruieren.","refs":["CH_GB18_CETW:MRT1","CH_GB18_BDE0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MRT-B02","text":"Die Rekonstruktion ist nur dann kohärent, wenn Aufhebung zugleich Erhaltung und Negation des Unterschieds bedeutet und Grenze als immanente Bestimmung gelesen wird.","refs":["CH_GB18_CETW:MRT3","CH_GB18_BDE0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MRT-B03","text":"Unterbestimmt bleibt die konkrete Ausgestaltung des Übergangs von negativer Selbstbeziehung zu Fürsichseyn, reflektiertem Setzen und entwickelter Subjektivität.","refs":["CH_GB18_CETW:MRT2","CH_GB18_CETW:SNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MRT-B04","text":"Die stärkste Verdichtung liegt in der Ableitung der Identität aus vermittelter Differenz und der Endlichkeit aus der eigenen Bestimmtheit des Etwas.","refs":["CH_GB18_CETW:MRT4","CH_GB18_BDE0:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MRT-B05","text":"Die Architektur bleibt auf die Spannung angewiesen, dass Vermittlung bereits konstitutiv ist, aber innerhalb der Sphäre des Seyns noch nicht als konkrete, gesetzte Vermittlung erscheinen darf.","refs":["CH_GB18_CETW:MRT6","CH_GB18_EUEA:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120756470833Z_f9089c6d","language_code":"en","language_name":"English","title":"Chapters 22–24","source_sha256":"14e80ca5f9242cec8e198c562681dd8253c7cc41ab691e0cb98a150244fb5a56","sha256":"a95d3be537a00575342fdba744c9d304964d9e2baec359ab47d54b2418d4f537","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:07:56.472244+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_08:AS-B01","text":"The system determines Something not as an already given bearer of external differences, but as the result of a determinacy that contains negation within itself.","refs":["CH_GB18_EUEA:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B02","text":"The equal rank of Something and Other deprives each individual of ontological priority and makes otherness a reciprocal form of the same mode of being.","refs":["CH_GB18_EUEA:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B03","text":"The negation that initially appears external is gradually taken back into the determinacy of Something and thereby loses the status of a merely alien counterforce.","refs":["CH_GB18_CETW:AS2","CH_GB18_BDE0:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B04","text":"Sublation produces identity not by erasing difference, but by preserving it as mediated negativity.","refs":["CH_GB18_CETW:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B05","text":"Being-in-itself and being-for-other appear as inseparable moments, through which self-relation is possible only as relation to otherness.","refs":["CH_GB18_EUEA:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B06","text":"The immanent taking-back of being-for-other produces limit; limit produces finitude as the self-determination of Something.","refs":["CH_GB18_BDE0:A8","CH_GB18_BDE0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B07","text":"The movement is cumulative-negative: affirmative quality is carried over through first negation into a negation of negation, without leaving the qualitative sphere.","refs":["CH_GB18_BDE0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B08","text":"Quality returns as reflected determinacy and thus proves to be the result of otherness, not its presuppositionless beginning.","refs":["CH_GB18_EUEA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B09","text":"The present sphere carries out transition, but not yet positing; it produces real mediation without yet making its concrete production explicit.","refs":["CH_GB18_EUEA:A12","CH_GB18_EUEA:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AS-B10","text":"The closure of the cluster consists in a finite, determinate, and relational quality whose true in-itself does not lie behind its determinations.","refs":["CH_GB18_EUEA:A10","CH_GB18_EUEA:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_08:GA-01","text":"[Persistent] Determinate being is sustainable only as determinate quality, because reality and negation are not externally separated but intertwined in the same determinate being.","refs":["CH_GB18_CETW:A1","CH_GB18_CETW:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-02","text":"[Persistent] Something and Other are structurally equal-ranking Somethings; otherness establishes no priority of a first or proper being.","refs":["CH_GB18_EUEA:A1","CH_GB18_EUEA:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-03","text":"[Persistent] Sublation preserves difference as effective negativity and produces mediated self-sameness from it.","refs":["CH_GB18_CETW:AS3","CH_GB18_CETW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-04","text":"[Mutating] Being-in-itself mutates from an initially simple self-relation into unity with being-for-other and thereby loses every relationless inwardness.","refs":["CH_GB18_EUEA:A7","CH_GB18_EUEA:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-05","text":"[Emergent] Limit is the form, effective in Something, of its negated relation to Other, and determines this Something as finite.","refs":["CH_GB18_BDE0:D4","CH_GB18_BDE0:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-06","text":"[Mutating] Negation traverses the sequence of external difference, immanent determinacy, and negation of negation; finitude is its determinate result, not its external addition.","refs":["CH_GB18_BDE0:SD4","CH_GB18_BDE0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-07","text":"[Mutating] Quality is not mere immediacy, but the return of reflected otherness into simple being.","refs":["CH_GB18_EUEA:A13","CH_GB18_EUEA:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-08","text":"[Terminal] The sphere of being carries out determination as transition and cannot yet exhibit concrete mediation as reflective positing.","refs":["CH_GB18_EUEA:A12","CH_GB18_EUEA:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-09","text":"[Attractor] The true in-itself of a Something is its concrete nexus of determinations; an indeterminate thing-in-itself is no remaining limit of cognition.","refs":["CH_GB18_EUEA:A10","CH_GB18_EUEA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GA-10","text":"[Terminal] Negative self-relation opens subjectivity, but at the level of Something does not yet supply a concrete form of the subject.","refs":["CH_GB18_CETW:A11","CH_GB18_CETW:SNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_08:RMD-01","text":"Negation recurs, but does not retain the same function: it begins as difference contained in determinate being, appears as external counter-determination, and finally becomes productive as immanent limit.","refs":["CH_GB18_CETW:AS2","CH_GB18_BDE0:A3","CH_GB18_BDE0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RMD-02","text":"Other mutates from an equal-ranking Something, through the other of itself, into an inner moment of the determinacy of Something.","refs":["CH_GB18_EUEA:A1","CH_GB18_EUEA:A4","CH_GB18_BDE0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RMD-03","text":"Sublation remains preserved as a structure, but shifts from the mediation of reality and negation to the taking-back of external otherness into the self-determination of the finite.","refs":["CH_GB18_CETW:AS3","CH_GB18_BDE0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RMD-04","text":"Being-in-itself moves from mediated simplicity through unity with being-for-other to the critique of an abstract inner that would be separated from all determinations.","refs":["CH_GB18_CETW:A8","CH_GB18_EUEA:A9","CH_GB18_EUEA:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RMD-05","text":"Quality recurs functionally, but its valence shifts: what initially determines determinate being becomes, finally, the result of otherness reflected into itself.","refs":["CH_GB18_CETW:A1","CH_GB18_EUEA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RMD-06","text":"Mediation is asserted as the universal condition of every concept, but in the sphere of Something it still remains without concretely posited sides and therefore marks a point of transition.","refs":["CH_GB18_CETW:A15","CH_GB18_CETW:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_08:CGD-01","text":"The distinction between reality and negation remains subordinate as the local initial grammar of qualitative determinate being; at the cluster level, only the rule that determinacy forms itself from immanent negativity is operative.","refs":["CH_GB18_CETW:A2","CH_GB18_EUEA:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:CGD-02","text":"The formula of the other of itself is locally the self-negation of Other; at the cluster level, it functions as a transformation operator that converts external difference into self-relation.","refs":["CH_GB18_EUEA:A4","CH_GB18_EUEA:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:CGD-03","text":"The first determination of subject remains a local reference to the future and is not elevated into presently achieved subjectivity.","refs":["CH_GB18_CETW:A11","CH_GB18_CETW:DNX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:CGD-04","text":"At the cluster level, the difference between transition and positing is not an incidental stage-marker, but the boundary rule that excludes concrete reflection from the present form of movement.","refs":["CH_GB18_EUEA:A12","CH_GB18_EUEA:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:CGD-05","text":"The assignment of nature and spirit remains a local application and has no supporting function for the reconstruction of the immanent logic of movement.","refs":["CH_GB18_EUEA:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_08:GNX-01","text":"Excluded is an ontology of pure immediacy in which determinate being, reality, or Something could exist without immanent negation.","refs":["CH_GB18_CETW:NX3","CH_GB18_CETW:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GNX-02","text":"Excluded is an absolutely external Other that would stand opposed to Something without itself being Something and without returning into its determinacy.","refs":["CH_GB18_BDE0:NX3","CH_GB18_EUEA:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GNX-03","text":"Excluded is a limit as a merely external barrier between already complete and mutually independent entities.","refs":["CH_GB18_BDE0:NX4","CH_GB18_BDE0:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GNX-04","text":"Excluded is an identity that would be established by removal of difference rather than by its sublation.","refs":["CH_GB18_CETW:NX4","CH_GB18_CETW:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:GNX-05","text":"Excluded is a relationless in-itself or thing-in-itself whose truth would lie beyond its determining relations.","refs":["CH_GB18_EUEA:NX3","CH_GB18_EUEA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_08:DBN-01","text":"The system disqualifies the overall model of pregiven substances that are connected only subsequently through relations, differences, or limits.","refs":["CH_GB18_EUEA:DNX1","CH_GB18_BDE0:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:DBN-02","text":"The system disqualifies a positive reality that could treat negation merely as external loss, mere nothing, or subsequent restriction.","refs":["CH_GB18_CETW:NX1","CH_GB18_CETW:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:DBN-03","text":"The system disqualifies an epistemology of the inaccessible core in which indeterminacy could count as depth or the renunciation of cognition as wisdom.","refs":["CH_GB18_EUEA:SD4","CH_GB18_EUEA:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:DBN-04","text":"The system disqualifies the notion that finitude is an accidental deficiency of a Something unlimited in itself.","refs":["CH_GB18_BDE0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_08:BSA-01","text":"Unavailable is a self that would know itself immediately identical with itself without non-being, otherness, and negative self-relation.","refs":["CH_GB18_CETW:DNX3","CH_GB18_EUEA:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:BSA-02","text":"Impermissible is a fully concrete mediation at the level of Something, because the present movement carries out only transition and not yet reflective positing.","refs":["CH_GB18_CETW:SNX6","CH_GB18_EUEA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:BSA-03","text":"Impossible is a determination that relies on external pointing or subjective designation without producing its difference from the matter itself.","refs":["CH_GB18_EUEA:A3","CH_GB18_EUEA:NX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_08:XD-01","text":"Limit is the internalized form of reciprocal otherness: it does not separate Something from an alien outside, but retains its relation to Other as its own determination. ; Trace Type — Composite","refs":["CL_GB18_08:GA-02","CL_GB18_08:GA-04","CL_GB18_08:GA-05","CH_GB18_EUEA:A2","CH_GB18_BDE0:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:XD-02","text":"Finitude is the positive quality of a Something insofar as its self-relation exists only through the negation of its being-for-other effective within it. ; Trace Type — Composite","refs":["CL_GB18_08:GA-04","CL_GB18_08:GA-05","CL_GB18_08:GA-07","CH_GB18_EUEA:A6","CH_GB18_BDE0:D5","CH_GB18_EUEA:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:XD-03","text":"The sphere of being already possesses immanent mediation, but cannot exhibit it as mediation posited by it; its truth is therefore structurally real, but operationally pre-reflective. ; Trace Type — Tension","refs":["CL_GB18_08:GA-03","CL_GB18_08:GA-08","CH_GB18_CETW:A15","CH_GB18_EUEA:NX6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:XD-04","text":"The critique of the thing-in-itself is not an incidental epistemic polemic, but the necessary consequence of the fact that being-in-itself can be true only as the determinate nexus of its relation to Other. ; Trace Type — Negative","refs":["CL_GB18_08:GA-04","CL_GB18_08:GA-09","CH_GB18_EUEA:A9","CH_GB18_EUEA:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:XD-05","text":"The subjectivity thereby opened can arise only through finitude: the negative self-relation of Something is attained not by sublating its limit, but by its immanent appropriation. ; Trace Type — Tension","refs":["CL_GB18_08:GA-05","CL_GB18_08:GA-06","CL_GB18_08:GA-10","CH_GB18_CETW:AS5","CH_GB18_BDE0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_08:BSD-01","text":"Reality appears as a dynamic configuration of determinate self-relations whose stability arises precisely from the continuing negativity of their differences.","refs":["CL_GB18_08:GA-01","CL_GB18_08:GA-03","CL_GB18_08:GA-06","CH_GB18_CETW:SD1","CH_GB18_BDE0:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:BSD-02","text":"Cognition loses the task of reaching a transcendent core and becomes the reconstruction of the immanent nexuses of determination of a Something.","refs":["CL_GB18_08:GA-04","CL_GB18_08:GA-09","CH_GB18_EUEA:D5","CH_GB18_EUEA:ME3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:BSD-03","text":"Temporality appears as directed self-transformation: external difference is not added chronologically, but returns into the matter as altered self-determination.","refs":["CL_GB18_08:GA-03","CL_GB18_08:GA-06","CL_GB18_08:GA-07","CH_GB18_CETW:SD4","CH_GB18_BDE0:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:BSD-04","text":"Dialectical method is determined as the obligation to track functional mutations; concepts must be treated neither as constant names nor as finished entities.","refs":["CL_GB18_08:GA-02","CL_GB18_08:GA-06","CL_GB18_08:GA-08","CH_GB18_EUEA:ME4","CH_GB18_EUEA:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_08:BSD-05","text":"The present architecture produces a finite self-relation whose enactment points beyond its own limit without anticipating the later transition to reflected subjectivity.","refs":["CL_GB18_08:GA-05","CL_GB18_08:GA-08","CL_GB18_08:GA-10","CH_GB18_CETW:MRT7","CH_GB18_EUEA:MRT7"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_08:RLE-01","text":"The central loop is: otherness → self-negation → self-relation → reflected quality → renewed determinacy vis-à-vis Other.","refs":["CH_GB18_EUEA:A4","CH_GB18_EUEA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RLE-02","text":"The negation loop is: reality and negation → sublation → mediated simplicity → renewed negativity as limit.","refs":["CH_GB18_CETW:AS2","CH_GB18_CETW:A8","CH_GB18_BDE0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RLE-03","text":"The escalation path leads from qualitative determinate being through Something and Other to being-in-itself, constitution, limit, and finitude.","refs":["CH_GB18_CETW:AS1","CH_GB18_BDE0:AS4","CH_GB18_BDE0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RLE-04","text":"Immanent negation functions as a conceptual attractor because every external difference must be led back into a determination of the Something in question.","refs":["CH_GB18_BDE0:AS3","CH_GB18_BDE0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:RLE-05","text":"The difference between transition and positing marks a threshold: the movement spirals toward reflection, but must not treat it as achieved within the present sphere.","refs":["CH_GB18_EUEA:A12","CH_GB18_EUEA:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_08:FGS-B01","text":"Qualitative determinate being + immanent negation → determinate difference of reality and negation.","refs":["CH_GB18_CETW:AS1","CH_GB18_CETW:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FGS-B02","text":"Existing difference + sublation without erasure → mediated simplicity → being-within-itself → Something.","refs":["CH_GB18_CETW:AS3","CH_GB18_CETW:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FGS-B03","text":"Something + Other as equal-ranking determinate beings → sublation of the ontological priority of a first Something.","refs":["CH_GB18_EUEA:A1","CH_GB18_EUEA:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FGS-B04","text":"External negation + taking-back into determinacy → constitution as unity of being-in-itself and being-for-other.","refs":["CH_GB18_BDE0:D2","CH_GB18_BDE0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FGS-B05","text":"Negated being-for-other + immanent determination → limit → finitude.","refs":["CH_GB18_BDE0:A7","CH_GB18_BDE0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FGS-B06","text":"Reflected determinacy → simple quality; at the same time, concrete mediation as positing remains deferred.","refs":["CH_GB18_EUEA:A13","CH_GB18_EUEA:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_08:AFM-B01","text":"Qualitative determinate being → reality and negation as immanent difference.","refs":["CH_GB18_CETW:AS1","CH_GB18_CETW:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B02","text":"Immanent difference → sublation without loss → mediated simplicity.","refs":["CH_GB18_CETW:AS3","CH_GB18_CETW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B03","text":"Mediated simplicity → Something → first negative self-relation.","refs":["CH_GB18_CETW:AS4","CH_GB18_CETW:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B04","text":"Something and Other → reciprocal otherness → self-negation of the isolated Other.","refs":["CH_GB18_EUEA:A2","CH_GB18_EUEA:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B05","text":"Self-negation → unity of being-in-itself and being-for-other → determinate constitution.","refs":["CH_GB18_EUEA:A7","CH_GB18_BDE0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B06","text":"Constitution → immanent limit → finitude as self-determination.","refs":["CH_GB18_BDE0:A8","CH_GB18_BDE0:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:AFM-B07","text":"Finite determinacy → reflected quality → threshold from transition to future positing.","refs":["CH_GB18_EUEA:A13","CH_GB18_EUEA:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_08:MME-01","text":"Difference is remapped from a relation between finished objects into an immanent condition of the self-determination of every Something.","refs":["CH_GB18_EUEA:ME1","CH_GB18_BDE0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MME-02","text":"Limit is reclassified from an external dividing line into a positive form of finitude and thereby of determinacy.","refs":["CH_GB18_BDE0:ME2","CH_GB18_BDE0:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MME-03","text":"Inside and outside lose their ontological opposition because what is found in Something belongs to its being-in-itself.","refs":["CH_GB18_EUEA:D4","CH_GB18_EUEA:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MME-04","text":"The thing-in-itself is remapped from a transcendent object of cognition into a faulty operation of abstraction.","refs":["CH_GB18_EUEA:SD4","CH_GB18_EUEA:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MME-05","text":"The distinction between transition and positing reorganizes the logical landscape as a sequence of different operational regimes rather than as a mere sequence of objects.","refs":["CH_GB18_EUEA:SD3","CH_GB18_EUEA:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_08:ALT-B01","text":"Surface level — Something, Other, being-in-itself, being-for-other, constitution, limit, and finitude form the explicit objects of the movement.","refs":["CH_GB18_EUEA:ALT1","CH_GB18_BDE0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:ALT-B02","text":"Structural level — Determinacy arises through the integration of negation, relation to Other, self-relation, and return to quality.","refs":["CH_GB18_EUEA:ALT2","CH_GB18_BDE0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:ALT-B03","text":"Metastrategic level — External designation, comparison, and juxtaposition are replaced by immanent development as the valid mode of determination.","refs":["CH_GB18_EUEA:A3","CH_GB18_EUEA:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:ALT-B04","text":"Ontological-temporal level — Being is a negative movement of transition in which identity exists only as continued return from otherness.","refs":["CH_GB18_CETW:ALT4","CH_GB18_EUEA:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:ALT-B05","text":"Methodological-performative level — The exposition enacts its thesis by converting every seemingly fixed term, through its immanent negation, into an altered function.","refs":["CH_GB18_EUEA:AS3","CH_GB18_EUEA:A5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_08:FL-01","text":"The structure begins with an external negation between Something and Other, but must later exhibit this as an always already immanent determination; the status of this initial externality remains tension-filled.","refs":["CH_GB18_BDE0:A3","CH_GB18_BDE0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FL-02","text":"Self-identity is attributed to the Other that negates itself, without the necessity of the transition from alteration to identity being fully unfolded within the given sphere.","refs":["CH_GB18_EUEA:A5","CH_GB18_EUEA:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:FL-03","text":"The critique of an abstract in-itself simultaneously requires a true in-itself as concept; the concrete shape of this positive form of cognition is presupposed, not generated in the cluster itself.","refs":["CH_GB18_EUEA:A10","CH_GB18_EUEA:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MP-01","text":"Reality and negation mutate from qualitative moments of determinate being into the self-limitation through which Something becomes finite.","refs":["CH_GB18_CETW:A3","CH_GB18_BDE0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MP-02","text":"Being-in-itself mutates from a simple return to itself into a negative relation to being-for-other and thereby becomes relational rather than sealed off.","refs":["CH_GB18_CETW:A9","CH_GB18_EUEA:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MP-03","text":"Mediation mutates from the general condition of the concept into the limiting determination of the present sphere, because it is indeed effective but not yet posited as concrete mediation.","refs":["CH_GB18_CETW:A15","CH_GB18_CETW:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_08:HSI-01","text":"Reality appears as a machine of immanent taking-back: every difference produces a relation whose return alters the unity in question.","refs":["CH_GB18_CETW:SD4","CH_GB18_BDE0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:HSI-02","text":"The subject appears not as a presupposed instance, but as the still unfinished possibility of negative self-relation.","refs":["CH_GB18_CETW:SD2","CH_GB18_CETW:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:HSI-03","text":"Time appears as logical mutation in which the external does not disappear, but returns as altered inner determination.","refs":["CH_GB18_EUEA:A5","CH_GB18_BDE0:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:HSI-04","text":"Struggle, navigation, and cognition consist not in flight from finitude, but in the reconstruction of its immanent nexuses of determination.","refs":["CH_GB18_EUEA:D5","CH_GB18_BDE0:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_08:MRT-B01","text":"The global axioms suffice to reconstruct the movement from qualitative determinate being through Something, Other, and being-in-itself to limit and finitude.","refs":["CH_GB18_CETW:MRT1","CH_GB18_BDE0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MRT-B02","text":"The reconstruction is coherent only if sublation means both preservation and negation of difference, and limit is read as an immanent determination.","refs":["CH_GB18_CETW:MRT3","CH_GB18_BDE0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MRT-B03","text":"The concrete elaboration of the transition from negative self-relation to being-for-self, reflective positing, and developed subjectivity remains underdetermined.","refs":["CH_GB18_CETW:MRT2","CH_GB18_CETW:SNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MRT-B04","text":"The greatest condensation lies in the derivation of identity from mediated difference and of finitude from the proper determinacy of Something.","refs":["CH_GB18_CETW:MRT4","CH_GB18_BDE0:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_08:MRT-B05","text":"The architecture remains dependent on the tension that mediation is already constitutive, but may not yet appear within the sphere of being as concrete, posited mediation.","refs":["CH_GB18_CETW:MRT6","CH_GB18_EUEA:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_08@R001","source_variant_id":"canonical:CL_GB18_08:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 22–24","context":"c. Etwas. · B. Die Endlichkeit. · a. Etwas und ein Anderes."},"title_language_code":"en"},{"id":"CL_GB18_09","layer":"CL","title":"Chapters 25–27","order":9,"parents":["CH_GB18_BBBU","CH_GB18_CDE0","CH_GB18_1DUD"],"revision":"CL_GB18_09@R001","sha256":"8d88e663e5eac57baf42ef24dd72ed5fb93bc0e4b8d3b512332621f2e66c7d1b","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_09:AS-01","text":"Das System bestimmt bestimmte Existenz so, dass sie weder aus abstrakter Selbstidentität noch aus einem bloß äußeren Bestimmtwerden erklärt werden kann.","refs":["CH_GB18_BBBU:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-02","text":"Selbstbeziehung wird als durch Anderssein vermittelte Struktur rekonstruiert; die Identität des Etwas enthält ihre Differenz als eigenes Moment.","refs":["CH_GB18_BBBU:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-03","text":"Die Differenz von Bestimmung und Beschaffenheit eröffnet zunächst die Spannung von Innerem und Äußerem, kann diese Trennung aber nicht stabilisieren.","refs":["CH_GB18_BBBU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-04","text":"Die Grenze wird zur generativen Mitte der Architektur: Sie konstituiert das Etwas, trennt es von Anderem und setzt sein Nichtsein in seine eigene Bestimmtheit ein.","refs":["CH_GB18_BBBU:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-05","text":"Endlichkeit entsteht, sobald die Grenze nicht als Rand, sondern als immanente Negation verstanden wird, deren Sein notwendig über sich hinausgeht.","refs":["CH_GB18_CDE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-06","text":"Die unmittelbare Auffassung der Endlichkeit fixiert diese Selbstüberschreitung zur absoluten Negativität und verwandelt dadurch eine Prozessform in eine scheinbar letzte Bestimmung.","refs":["CH_GB18_1DUD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-07","text":"Weder die affirmative Vereinigung mit dem Unendlichen noch das abstrakte Nichts kann die fixierte Endlichkeit abschließen, weil beide Alternativen den Widerspruch reproduzieren.","refs":["CH_GB18_1DUD:AS4","CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-08","text":"Die Schließung bleibt negativ: Nicht ein positiv ausgearbeitetes Unendliches, sondern das Vergehen der Letztgültigkeit des Vergehens beendet die Herrschaft der fixierten Endlichkeit.","refs":["CH_GB18_1DUD:AS6","CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_09:GA-01","text":"[Persistent] Bestimmtheit ist nur als vermittelte Selbstbeziehung möglich; sie setzt das aufgehobene Anderssein voraus, statt es auszuschließen.","refs":["CH_GB18_BBBU:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-02","text":"[Mutating] Das Andere wandert von einer scheinbar äußeren Gegenposition in die immanente Negation des Etwas.","refs":["CH_GB18_BBBU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-03","text":"[Persistent] Die Grenze ist zugleich Existenzbedingung, Differenzform und Negation des bestimmten Etwas.","refs":["CH_GB18_BBBU:A10","CH_GB18_BBBU:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-04","text":"[Mutating] Qualität und Grenze beginnen als affirmative Bestimmtheit, enthüllen sich aber als Träger einer dem Dasein immanenten Negation.","refs":["CH_GB18_CDE0:A3","CH_GB18_CDE0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-05","text":"[Emergent] Endlichkeit ist die Einheit von Bestimmtheit, Nichtsein, negativem Selbstverhältnis und notwendigem Vergehen.","refs":["CH_GB18_CDE0:A7","CH_GB18_CDE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-06","text":"[Attractor] Jeder bestimmte Bestand wird durch seine immanente Grenze als Widerspruch organisiert und dadurch in Selbstüberschreitung getrieben.","refs":["CH_GB18_BBBU:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-07","text":"[Mutating] Die Fixierung der Endlichkeit als schlechthin Negatives erzeugt gerade die negative Absolutheit, die sie dem Endlichen absprechen will.","refs":["CH_GB18_1DUD:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-08","text":"[Terminal] Das Ende kann nicht als letztes Nichts bestimmt werden, weil dem Nichts im Vollzug des Denkens, Vorstellens oder Sprechens zugleich Bestehen zukommt.","refs":["CH_GB18_1DUD:A10","CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-09","text":"[Terminal] Das Vergehen des Endlichen wird aufgehoben, indem seine behauptete Letztgültigkeit selbst vergeht.","refs":["CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-10","text":"[Attractor] Das Affirmative bleibt als notwendiges Anderes der Endlichkeit strukturell erforderlich, ohne auf dieser Ebene positiv bestimmt zu werden.","refs":["CH_GB18_1DUD:SD5","CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_09:RMD-01","text":"[Stable identity] Ansichsein behält seine Funktion als Selbstbeziehung, verliert jedoch jede Bedeutung abstrakter Unmittelbarkeit und wird vollständig vermittlungsabhängig.","refs":["CH_GB18_BBBU:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RMD-02","text":"[Absorption] Bestimmung und Beschaffenheit bleiben als lokale Unterscheidung wirksam, werden aber auf höherer Ebene in die Einheit qualitativer Grenze absorbiert.","refs":["CH_GB18_BBBU:A6","CH_GB18_CDE0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RMD-03","text":"[Displacement] Das Andere verschiebt sich vom Vergleichsgegenstand zur inneren Negation, durch welche das Etwas sein bestimmtes Insichsein erhält.","refs":["CH_GB18_BBBU:AS2","CH_GB18_BBBU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RMD-04","text":"[Escalation] Die Grenze mutiert von einer Bestimmtheit des Etwas zu der Negativität, durch welche das Etwas zum Werden und zur Überschreitung seines Seins wird.","refs":["CH_GB18_CDE0:A4","CH_GB18_CDE0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RMD-05","text":"[Terminal transformation] Endlichkeit erscheint zunächst als notwendiges Vergehen, wird dann als fixierte Negation absolut gesetzt und verliert schließlich die Letztgültigkeit ihres eigenen Vergehens.","refs":["CH_GB18_CDE0:A11","CH_GB18_1DUD:AS2","CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RMD-06","text":"[Functional recurrence] Das Unendliche kehrt nicht als ausgearbeitete positive Sphäre wieder, sondern als notwendiges Gegenmoment, dessen Abwesenheit die negative Bewegung antreibt.","refs":["CH_GB18_1DUD:A6","CH_GB18_1DUD:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_09:CGD-01","text":"Die Bestimmung des Menschen als denkende Vernunft bleibt eine lokale exemplarische Konkretisierung und trägt die Clusterarchitektur nicht selbst.","refs":["CH_GB18_BBBU:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:CGD-02","text":"Punkt, Linie und Fläche bleiben lokale Anschauungsfelder der Grenzlogik; ihre begriffliche Funktion wird auf der aktuellen Ebene in die allgemeine Produktivität der Grenze integriert.","refs":["CH_GB18_BBBU:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:CGD-03","text":"Die Unterscheidung von Bestimmung und Beschaffenheit ist auf der unteren Ebene analytisch notwendig, wird auf der Cluster-Ebene jedoch als instabile Vorform der qualitativen Grenze behandelt.","refs":["CH_GB18_BBBU:A6","CH_GB18_CDE0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:CGD-04","text":"Die Grenze skaliert von einer Kategorie bestimmter Existenz zur globalen Maschine, die Innen und Außen, Sein und Nichtsein sowie Bestand und Übergang vermittelt.","refs":["CH_GB18_BBBU:A12","CH_GB18_CDE0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:CGD-05","text":"Das Vergehen des Vergehens ist keine lokale Konsequenz der Endlichkeit, sondern die clusterweite Umcodierung jeder behaupteten letzten Negativität.","refs":["CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_09:GNX-01","text":"Ausgeschlossen ist eine unmittelbare Selbstidentität, die keiner Vermittlung durch Anderssein und Negation bedarf.","refs":["CH_GB18_BBBU:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GNX-02","text":"Ausgeschlossen ist eine absolute Exteriorität, in der äußere Einflüsse ein Etwas bestimmen könnten, ohne von dessen eigener Bestimmung mitbedingt zu sein.","refs":["CH_GB18_BBBU:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GNX-03","text":"Ausgeschlossen ist eine Grenze, die als bloß äußerliche Begrenzung einem ansonsten unberührten Seienden hinzutritt.","refs":["CH_GB18_CDE0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GNX-04","text":"Ausgeschlossen ist ein endliches Seiendes, das unabhängig von seinem Vergehen bestehen könnte.","refs":["CH_GB18_CDE0:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GNX-05","text":"Ausgeschlossen ist die affirmative Vereinigung mit dem Unendlichen als äußerlicher Ausweg aus der Endlichkeit.","refs":["CH_GB18_1DUD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GNX-06","text":"Ausgeschlossen ist ein endgültiges Nichts als letzter ontologischer Zustand des Endlichen.","refs":["CH_GB18_1DUD:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_09:DBN-01","text":"Das System disqualifiziert jedes Gesamtmodell, das Inneres und Äußeres als ontologisch getrennte Bereiche behandelt.","refs":["CH_GB18_BBBU:DNX3","CH_GB18_CDE0:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:DBN-02","text":"Das System disqualifiziert eine äußere Kausalität des Endes, weil das Vergehen im Selbstverhältnis des Endlichen fundiert sein muss.","refs":["CH_GB18_CDE0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:DBN-03","text":"Das System disqualifiziert Kontingenz als zureichende Erklärung des Vergehens, weil das Ende aus der Struktur der Endlichkeit folgen soll.","refs":["CH_GB18_CDE0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:DBN-04","text":"Das System disqualifiziert eine stabile Koexistenz von Endlichem und Unendlichem als äußerlich getrennten Absolutheiten.","refs":["CH_GB18_1DUD:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:DBN-05","text":"Das System disqualifiziert jede Versöhnung, die von außen auf den Widerspruch trifft, statt dessen immanente Selbstauflösung zu vollziehen.","refs":["CH_GB18_1DUD:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_09:BSA-01","text":"Nicht verfügbar ist ein neutraler Außenstandpunkt, von dem Etwas, Grenze, Endlichkeit und Ende als fertige Gegenstände bestimmt werden könnten.","refs":["CH_GB18_BBBU:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSA-02","text":"Nicht verfügbar ist ein absolut selbstgenügsames Endliches, das seine Grenze besitzen könnte, ohne sich durch sie selbst zu überschreiten.","refs":["CH_GB18_BBBU:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSA-03","text":"Nicht verfügbar ist ein positiver Endgehalt zwischen Endlichkeit und Unendlichkeit; strukturell verfügbar bleibt nur die Negation der Negation.","refs":["CH_GB18_1DUD:SNX1","CH_GB18_1DUD:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSA-04","text":"Unmöglich ist ein letztes Nichts, dessen Negativität nicht selbst wieder der Negation ausgesetzt wäre.","refs":["CH_GB18_1DUD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_09:XD-01","text":"Die vermittelte Identität des Etwas und der Keim seines Vergehens sind dieselbe Struktur unter verschiedener Skala: Was Anderssein als eigenes Moment enthält, enthält auch die Möglichkeit seines Selbstüberschreitens.","refs":["CL_GB18_09:GA-01","CL_GB18_09:GA-05","CH_GB18_BBBU:AS2","CH_GB18_CDE0:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_09:XD-02","text":"Äußerlichkeit wird nicht beseitigt, sondern zur inneren Exponiertheit des Etwas umklassifiziert: Was es von außen zu treffen scheint, artikuliert seine eigene Grenze.","refs":["CL_GB18_09:GA-02","CL_GB18_09:GA-03","CH_GB18_BBBU:A5","CH_GB18_CDE0:AS2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_09:XD-03","text":"Die notwendige Vergänglichkeit wird erst dann problematisch, wenn sie selbst als unwandelbare letzte Bestimmung festgehalten wird; die Fixierung des Prozesses erzeugt den neuen Widerspruch.","refs":["CL_GB18_09:GA-05","CL_GB18_09:GA-07","CH_GB18_CDE0:A11","CH_GB18_1DUD:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_09:XD-04","text":"Der Versuch, die Endlichkeit durch Nichts abzuschließen, scheitert, weil das gesetzte Nichts im Denken oder Sprechen eine Form von Bestehen erhält und damit nicht absolut negativ bleiben kann.","refs":["CL_GB18_09:GA-08","CH_GB18_1DUD:A10","CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_09:XD-05","text":"Das Vergehen des Vergehens erzeugt eine negative Schließung: Die Endlichkeit verliert ihre Absolutheit, ohne dass das erforderliche Affirmative positiv ausgearbeitet würde.","refs":["CL_GB18_09:GA-09","CL_GB18_09:GA-10","CH_GB18_1DUD:AS6","CH_GB18_1DUD:SD5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_09:BSD-01","text":"Identität wird zeitlich: Sie besteht nicht vor ihrer Negation, sondern nur als Prozess, in dem sie durch ihre Grenze hindurch zu sich und über sich hinausgeht.","refs":["CH_GB18_BBBU:A12","CH_GB18_CDE0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSD-02","text":"Kausalität wird von äußerer Einwirkung auf immanente Bedingtheit verschoben; das scheinbar Äußere erscheint als artikulierte Exponiertheit einer eigenen Bestimmung.","refs":["CH_GB18_BBBU:SD2","CH_GB18_BBBU:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSD-03","text":"Zeit wird als einheitliche Entfaltung der Endlichkeit organisiert: Geburt und Tod sind keine getrennten Ereignisse, und selbst das Vergehen besitzt keine letzte Zeitstellung.","refs":["CH_GB18_CDE0:A13","CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSD-04","text":"Das Unendliche fungiert als strukturelle Forderung der Endlichkeit, bleibt aber auf dieser Ebene ohne positiven Gehalt; die Architektur erzeugt eine notwendige Leerstelle.","refs":["CH_GB18_1DUD:SD5","CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSD-05","text":"Keine negative Bestimmung darf als letzter Bestand auftreten, weil jede behauptete Endgültigkeit in die Bewegung ihrer eigenen Negation zurückgezogen wird.","refs":["CH_GB18_1DUD:SNX3","CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_09:RLE-01","text":"Vermittelte Selbstbeziehung → immanentes Anderssein → Grenze → negatives Selbstverhältnis → Selbstüberschreitung bildet die primäre rekursive Schleife des Clusters.","refs":["CH_GB18_BBBU:AS2","CH_GB18_CDE0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RLE-02","text":"Die Eskalation verläuft von äußerlich erscheinender Beschaffenheit über immanente Grenze zur Endlichkeit als notwendigem Vergehen.","refs":["CH_GB18_BBBU:A4","CH_GB18_CDE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RLE-03","text":"Die Grenze ist der begriffliche Attraktor, weil jede Bestimmtheit zu ihr zurückkehrt: als Qualität, Negation, Daseinsbedingung, Nichtsein und Übergang.","refs":["CH_GB18_BBBU:A10","CH_GB18_CDE0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RLE-04","text":"Die Fixierung der Endlichkeit erzeugt einen sekundären Kreislauf: Negation wird absolut gesetzt, erhält dadurch selbst den Status eines Bestandes und muss ihre eigene Stabilität verlieren.","refs":["CH_GB18_1DUD:AS2","CH_GB18_1DUD:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RLE-05","text":"Das Nichts fungiert als rückgekoppelter Pseudo-Endpunkt, weil sein Gedachtwerden die Existenzform reproduziert, die es eliminieren sollte.","refs":["CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_09:FGS-B01","text":"Vermittelte Selbstbeziehung + aufgehobenes Anderssein → bestimmte Existenz, deren Identität keine reine Unmittelbarkeit mehr sein kann.","refs":["CH_GB18_BBBU:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FGS-B02","text":"Bestimmung + Beschaffenheit → instabile Differenz von Innerem und Äußerem → qualitative Grenze als absorbierende Einheit.","refs":["CH_GB18_BBBU:A6","CH_GB18_CDE0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FGS-B03","text":"Qualitative Grenze → immanente Negation → Insichsein als Werden statt als ruhender Bestand.","refs":["CH_GB18_CDE0:A4","CH_GB18_CDE0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FGS-B04","text":"Werden an ihm selbst → negatives Selbstverhältnis → Endlichkeit als notwendige Selbstüberschreitung und notwendiges Vergehen.","refs":["CH_GB18_CDE0:A8","CH_GB18_CDE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FGS-B05","text":"Fixierte Endlichkeit → Gegensatz zum Unendlichen → Ausschluss affirmativer Vereinigung und Rückfall des Nichts in seinen eigenen Widerspruch.","refs":["CH_GB18_1DUD:AS2","CH_GB18_1DUD:A9","CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FGS-B06","text":"Widerspruch der letzten Negation → Vergehen des Vergehens → negative Schließung ohne positive Explikation des Affirmativen.","refs":["CH_GB18_1DUD:AS6","CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_09:AFM-B01","text":"Vermittelte Selbstbeziehung → Anderssein als eigenes Moment.","refs":["CH_GB18_BBBU:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B02","text":"Anderssein als eigenes Moment → Instabilität der Trennung von Bestimmung und Beschaffenheit.","refs":["CH_GB18_BBBU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B03","text":"Instabile Bestimmtheit → Grenze als Einheit von Konstitution, Differenz und Negation.","refs":["CH_GB18_BBBU:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B04","text":"Grenze als Negation → Endlichkeit als negatives Selbstverhältnis und notwendiges Vergehen.","refs":["CH_GB18_CDE0:A8","CH_GB18_CDE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B05","text":"Notwendiges Vergehen → Fixierung der Endlichkeit als scheinbar absolute Negativität.","refs":["CH_GB18_1DUD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B06","text":"Fixierte Negativität → Unhaltbarkeit von Vereinigung und Nichts → immanenter Zusammenfall der letzten Negation.","refs":["CH_GB18_1DUD:AS4","CH_GB18_1DUD:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B07","text":"Zusammenfall der letzten Negation → Vergehen des Vergehens als negative, nicht positiv ausgefüllte Schließung.","refs":["CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_09:MME-01","text":"Die Karte von Innerem und Äußerem wird umgeordnet: Das Äußere ist nicht Gegenbereich des Inneren, sondern dessen eigene vermittelte Exponiertheit.","refs":["CH_GB18_BBBU:DNX3","CH_GB18_BBBU:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MME-02","text":"Die Grenze wird vom Rand eines fertigen Gegenstandes zur Bedingung seiner bestimmten Existenz und zum Operator seiner Auflösung.","refs":["CH_GB18_BBBU:ME3","CH_GB18_BBBU:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MME-03","text":"Qualität, Grenze und Zeit werden zu Momenten eines Prozesses zusammengezogen: Qualität begrenzt, Grenze negiert, Endlichkeit vergeht.","refs":["CH_GB18_CDE0:A2","CH_GB18_CDE0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MME-04","text":"Der Gegensatz von Endlichem und Unendlichem wird nicht als ursprüngliche Zweiheit, sondern als Effekt der Fixierung einer negativen Bestimmung sichtbar.","refs":["CH_GB18_1DUD:SD3","CH_GB18_1DUD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MME-05","text":"Lesen und Denken werden auf Übergänge statt auf fixe Prädikate verpflichtet; jede scheinbar stabile Opposition wird als vorläufige Abstraktion behandelt.","refs":["CH_GB18_BBBU:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_09:ALT-B01","text":"Surface level — Bestimmung, Beschaffenheit, Qualität, Grenze, Endlichkeit, Vergehen, Nichts und Unendliches erscheinen als explizite Gegenstände der Bewegung.","refs":["CH_GB18_BBBU:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:ALT-B02","text":"Structural level — Die wiederkehrende Maschine verbindet vermittelte Identität, immanente Negation, Grenze, negatives Selbstverhältnis und Selbstüberschreitung.","refs":["CH_GB18_BBBU:ALT2","CH_GB18_CDE0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:ALT-B03","text":"Metastrategic level — Die Erklärung verlagert sich systematisch von äußerer Einwirkung und äußerer Versöhnung auf immanente Prüfung und Selbstauflösung.","refs":["CH_GB18_CDE0:ALT3","CH_GB18_1DUD:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:ALT-B04","text":"Ontological / Temporal level — Endliches Sein enthält sein Nichtsein; Geburt, Tod und Vergehen sind zeitliche Artikulationen einer einzigen negativen Struktur.","refs":["CH_GB18_CDE0:A7","CH_GB18_CDE0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:ALT-B05","text":"Methodological / Performative level — Die Form vollzieht ihre eigene These, indem sie jede feste Bestimmung erst setzt, dann in ihren immanenten Gegensatz überführt und schließlich ihre behauptete Letztgültigkeit auflöst.","refs":["CH_GB18_1DUD:AS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_09:FL-01","text":"Die Grenze muss zugleich affirmative Bestimmung und Negation des Daseins sein; die Architektur benötigt beide Seiten, kann sie aber nicht in eine ruhende Einheit überführen.","refs":["CH_GB18_CDE0:A3","CH_GB18_CDE0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FL-02","text":"Das Ende ist als Wahrheit des endlichen Seins notwendig, doch das Vergehen darf nicht die letzte Wahrheit sein; die Bewegung benötigt diese Spannung, um über die fixierte Endlichkeit hinauszugehen.","refs":["CH_GB18_CDE0:A10","CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FL-03","text":"Das Affirmative ist für die Diagnose der fixierten Negation erforderlich, bleibt aber inhaltlich unterbestimmt und verhindert eine positive Schließung.","refs":["CH_GB18_1DUD:SD5","CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FL-04","text":"Die anfängliche Unterscheidung von Bestimmung und Beschaffenheit ist notwendig, wird aber durch den notwendigen Übergang ihrer Seiten zugleich relativiert.","refs":["CH_GB18_BBBU:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MP-01","text":"Die Grenze mutiert von der Bestimmtheit eines ruhenden Daseins zur immanenten Negation, die das Dasein in Werden überführt.","refs":["CH_GB18_CDE0:A3","CH_GB18_CDE0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MP-02","text":"Endlichkeit mutiert von der prozessualen Selbstüberschreitung des bestimmten Seienden zur fixierten Negation, deren Starrheit ihren eigenen Widerspruch hervorbringt.","refs":["CH_GB18_CDE0:A9","CH_GB18_1DUD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MP-03","text":"Das Nichts mutiert vom vermeintlichen Endpunkt zur widersprüchlichen Existenzform und wird dadurch zum Übergangspunkt der Negation ihrer eigenen Letztgültigkeit.","refs":["CH_GB18_1DUD:NX6","CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_09:HSI-01","text":"Realität erscheint als Maschine immanenter Grenzen: Jede bestimmte Einheit wird durch das konstituiert, was sie zugleich begrenzt, negiert und in ihre weitere Gestalt überführt.","refs":["CH_GB18_BBBU:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:HSI-02","text":"Ein Subjekt erhält keinen souveränen Außenstatus; soweit es als bestimmtes Etwas erscheint, unterliegt es derselben Vermittlung von Bestimmung, Grenze und negativem Selbstverhältnis.","refs":["CH_GB18_BBBU:D2","CH_GB18_CDE0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:HSI-03","text":"Zeit ist kein neutrales Medium, sondern die Explikation einer Endlichkeit, in der Geburt bereits Todesbestimmung und Vergehen selbst nicht letztgültig ist.","refs":["CH_GB18_CDE0:ALT4","CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:HSI-04","text":"Möglich bleibt keine Flucht in einen äußeren Standpunkt, sondern nur die immanente Bewegung, in der eine fixierte Negation ihre eigene Stabilität verliert.","refs":["CH_GB18_BBBU:SNX2","CH_GB18_1DUD:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_09:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von vermittelter Bestimmtheit über Grenze und Endlichkeit bis zum Vergehen des Vergehens zu rekonstruieren.","refs":["CH_GB18_BBBU:MRT1","CH_GB18_1DUD:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MRT-B02","text":"Unterbestimmt bleibt der positive Gehalt des Unendlichen beziehungsweise Affirmativen; die Architektur liefert seine Notwendigkeit, nicht seine positive Bestimmung.","refs":["CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MRT-B03","text":"Die stärkste Operation liegt in der Umwandlung äußerlicher Begrenzung in immanente Vermittlung, produktiven Widerspruch und notwendige Selbstüberschreitung.","refs":["CH_GB18_BBBU:MRT4","CH_GB18_BBBU:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MRT-B04","text":"Die Rekonstruktion bleibt kohärent, sofern Negation nicht als äußerer Mangel behandelt wird und sofern Grenze, Nichtsein, Ende und Vergehen als aufeinander erzeugende Stufen gelesen werden.","refs":["CH_GB18_BBBU:MRT3","CH_GB18_CDE0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MRT-B05","text":"Axiomatischer Reduktion widersteht die verbleibende Leerstelle des Affirmativen: Das System benötigt sie als Attraktor, darf sie auf dieser Ebene aber nicht als positive Endposition ausgeben.","refs":["CH_GB18_1DUD:SNX1","CH_GB18_1DUD:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120828454853Z_28c6c273","language_code":"en","language_name":"English","title":"Chapters 25–27","source_sha256":"8d88e663e5eac57baf42ef24dd72ed5fb93bc0e4b8d3b512332621f2e66c7d1b","sha256":"75fb6036078c70842edb07f231a1816002c69bbb6d5546049c9f75324bf3c5b1","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:08:28.458358+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_09:AS-01","text":"The system determines determinate existence such that it can be explained neither from abstract self-identity nor from a merely external being-determined.","refs":["CH_GB18_BBBU:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-02","text":"Self-relation is reconstructed as a structure mediated through otherness; the identity of the something contains its difference as its own moment.","refs":["CH_GB18_BBBU:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-03","text":"The difference between determination and constitution initially opens the tension between inner and outer, but cannot stabilize this separation.","refs":["CH_GB18_BBBU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-04","text":"The limit becomes the generative center of the architecture: it constitutes the something, separates it from other, and inserts its non-being into its own determinacy.","refs":["CH_GB18_BBBU:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-05","text":"Finitude arises as soon as the limit is understood not as an edge but as immanent negation, whose being necessarily goes beyond itself.","refs":["CH_GB18_CDE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-06","text":"The immediate conception of finitude fixes this self-transcendence as absolute negativity and thereby transforms a process-form into an apparently final determination.","refs":["CH_GB18_1DUD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-07","text":"Neither affirmative unification with the infinite nor abstract nothing can conclude fixed finitude, because both alternatives reproduce the contradiction.","refs":["CH_GB18_1DUD:AS4","CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AS-08","text":"The closure remains negative: not a positively elaborated infinite, but the passing away of the final validity of passing away ends the rule of fixed finitude.","refs":["CH_GB18_1DUD:AS6","CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_09:GA-01","text":"[Persistent] Determinacy is possible only as mediated self-relation; it presupposes sublated otherness rather than excluding it.","refs":["CH_GB18_BBBU:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-02","text":"[Mutating] The other migrates from an apparently external counter-position into the immanent negation of the something.","refs":["CH_GB18_BBBU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-03","text":"[Persistent] The limit is at once the condition of existence, the form of difference, and the negation of the determinate something.","refs":["CH_GB18_BBBU:A10","CH_GB18_BBBU:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-04","text":"[Mutating] Quality and limit begin as affirmative determinacy, but reveal themselves as bearers of a negation immanent to existence.","refs":["CH_GB18_CDE0:A3","CH_GB18_CDE0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-05","text":"[Emergent] Finitude is the unity of determinacy, non-being, negative self-relation, and necessary passing away.","refs":["CH_GB18_CDE0:A7","CH_GB18_CDE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-06","text":"[Attractor] Every determinate subsistence is organized as contradiction by its immanent limit and thereby driven into self-transcendence.","refs":["CH_GB18_BBBU:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-07","text":"[Mutating] The fixation of finitude as utterly negative produces precisely the negative absoluteness that it seeks to deny to the finite.","refs":["CH_GB18_1DUD:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-08","text":"[Terminal] The end cannot be determined as final nothing, because in the enactment of thinking, representing, or speaking, nothing simultaneously acquires subsistence.","refs":["CH_GB18_1DUD:A10","CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-09","text":"[Terminal] The passing away of the finite is sublated insofar as its asserted final validity itself passes away.","refs":["CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GA-10","text":"[Attractor] The affirmative remains structurally necessary as the necessary other of finitude, without being positively determined at this level.","refs":["CH_GB18_1DUD:SD5","CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_09:RMD-01","text":"[Stable identity] Being-in-itself retains its function as self-relation, yet loses every meaning of abstract immediacy and becomes wholly dependent on mediation.","refs":["CH_GB18_BBBU:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RMD-02","text":"[Absorption] Determination and constitution remain effective as a local distinction, but are absorbed at a higher level into the unity of qualitative limit.","refs":["CH_GB18_BBBU:A6","CH_GB18_CDE0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RMD-03","text":"[Displacement] The other shifts from an object of comparison to the inner negation through which the something receives its determinate being-in-itself.","refs":["CH_GB18_BBBU:AS2","CH_GB18_BBBU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RMD-04","text":"[Escalation] The limit mutates from a determinacy of the something into the negativity through which the something becomes becoming and the transcendence of its being.","refs":["CH_GB18_CDE0:A4","CH_GB18_CDE0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RMD-05","text":"[Terminal transformation] Finitude initially appears as necessary passing away, is then absolutized as fixed negation, and finally loses the final validity of its own passing away.","refs":["CH_GB18_CDE0:A11","CH_GB18_1DUD:AS2","CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RMD-06","text":"[Functional recurrence] The infinite returns not as an elaborated positive sphere, but as a necessary counter-moment whose absence drives the negative movement.","refs":["CH_GB18_1DUD:A6","CH_GB18_1DUD:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_09:CGD-01","text":"The determination of the human being as thinking reason remains a local exemplary concretization and does not itself bear the cluster architecture.","refs":["CH_GB18_BBBU:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:CGD-02","text":"Point, line, and surface remain local fields of intuition of the logic of limit; their conceptual function is integrated at the current level into the general productivity of the limit.","refs":["CH_GB18_BBBU:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:CGD-03","text":"The distinction between determination and constitution is analytically necessary at the lower level, but at the cluster level is treated as an unstable preliminary form of qualitative limit.","refs":["CH_GB18_BBBU:A6","CH_GB18_CDE0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:CGD-04","text":"The limit scales from a category of determinate existence to the global machine that mediates inner and outer, being and non-being, as well as subsistence and transition.","refs":["CH_GB18_BBBU:A12","CH_GB18_CDE0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:CGD-05","text":"The passing away of passing away is not a local consequence of finitude, but the cluster-wide recoding of every asserted final negativity.","refs":["CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_09:GNX-01","text":"Excluded is an immediate self-identity requiring no mediation through otherness and negation.","refs":["CH_GB18_BBBU:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GNX-02","text":"Excluded is an absolute exteriority in which external influences could determine a something without being co-conditioned by its own determination.","refs":["CH_GB18_BBBU:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GNX-03","text":"Excluded is a limit that accrues as a merely external restriction to an otherwise untouched being.","refs":["CH_GB18_CDE0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GNX-04","text":"Excluded is a finite being that could subsist independently of its passing away.","refs":["CH_GB18_CDE0:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GNX-05","text":"Excluded is affirmative unification with the infinite as an external way out of finitude.","refs":["CH_GB18_1DUD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:GNX-06","text":"Excluded is a definitive nothing as the final ontological state of the finite.","refs":["CH_GB18_1DUD:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_09:DBN-01","text":"The system disqualifies every overall model that treats inner and outer as ontologically separate domains.","refs":["CH_GB18_BBBU:DNX3","CH_GB18_CDE0:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:DBN-02","text":"The system disqualifies an external causality of the end, because passing away must be grounded in the self-relation of the finite.","refs":["CH_GB18_CDE0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:DBN-03","text":"The system disqualifies contingency as a sufficient explanation of passing away, because the end is supposed to follow from the structure of finitude.","refs":["CH_GB18_CDE0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:DBN-04","text":"The system disqualifies a stable coexistence of finite and infinite as externally separate absolutes.","refs":["CH_GB18_1DUD:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:DBN-05","text":"The system disqualifies every reconciliation that encounters contradiction from outside rather than enacting its immanent self-dissolution.","refs":["CH_GB18_1DUD:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_09:BSA-01","text":"Unavailable is a neutral external standpoint from which something, limit, finitude, and end could be determined as finished objects.","refs":["CH_GB18_BBBU:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSA-02","text":"Unavailable is an absolutely self-sufficient finite that could possess its limit without transcending itself through it.","refs":["CH_GB18_BBBU:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSA-03","text":"Unavailable is a positive final content between finitude and infinity; structurally available remains only the negation of negation.","refs":["CH_GB18_1DUD:SNX1","CH_GB18_1DUD:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSA-04","text":"Impossible is a final nothing whose negativity would not itself again be subjected to negation.","refs":["CH_GB18_1DUD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_09:XD-01","text":"The mediated identity of the something and the germ of its passing away are the same structure at different scales: what contains otherness as its own moment also contains the possibility of its self-transcendence.","refs":["CL_GB18_09:GA-01","CL_GB18_09:GA-05","CH_GB18_BBBU:AS2","CH_GB18_CDE0:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_09:XD-02","text":"Externality is not eliminated, but reclassified as the inner exposedness of the something: what seems to affect it from outside articulates its own limit.","refs":["CL_GB18_09:GA-02","CL_GB18_09:GA-03","CH_GB18_BBBU:A5","CH_GB18_CDE0:AS2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_09:XD-03","text":"Necessary transience becomes problematic only when it is itself held fast as an unchanging final determination; the fixation of the process produces the new contradiction.","refs":["CL_GB18_09:GA-05","CL_GB18_09:GA-07","CH_GB18_CDE0:A11","CH_GB18_1DUD:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_09:XD-04","text":"The attempt to conclude finitude through nothing fails because posited nothing acquires a form of subsistence in thinking or speaking and thus cannot remain absolutely negative.","refs":["CL_GB18_09:GA-08","CH_GB18_1DUD:A10","CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_09:XD-05","text":"The passing away of passing away produces a negative closure: finitude loses its absoluteness without the requisite affirmative being positively elaborated.","refs":["CL_GB18_09:GA-09","CL_GB18_09:GA-10","CH_GB18_1DUD:AS6","CH_GB18_1DUD:SD5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_09:BSD-01","text":"Identity becomes temporal: it does not subsist prior to its negation, but only as a process in which it goes through its limit to itself and beyond itself.","refs":["CH_GB18_BBBU:A12","CH_GB18_CDE0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSD-02","text":"Causality is shifted from external effectuation to immanent conditionedness; the seemingly external appears as the articulated exposedness of a determination proper to itself.","refs":["CH_GB18_BBBU:SD2","CH_GB18_BBBU:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSD-03","text":"Time is organized as the unified unfolding of finitude: birth and death are not separate events, and even passing away possesses no final temporal position.","refs":["CH_GB18_CDE0:A13","CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSD-04","text":"The infinite functions as a structural demand of finitude, but remains without positive content at this level; the architecture produces a necessary empty place.","refs":["CH_GB18_1DUD:SD5","CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:BSD-05","text":"No negative determination may appear as final subsistence, because every asserted definitiveness is withdrawn into the movement of its own negation.","refs":["CH_GB18_1DUD:SNX3","CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_09:RLE-01","text":"Mediated self-relation → immanent otherness → limit → negative self-relation → self-transcendence forms the cluster's primary recursive loop.","refs":["CH_GB18_BBBU:AS2","CH_GB18_CDE0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RLE-02","text":"The escalation proceeds from apparently external constitution through immanent limit to finitude as necessary passing away.","refs":["CH_GB18_BBBU:A4","CH_GB18_CDE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RLE-03","text":"The limit is the conceptual attractor because every determinacy returns to it: as quality, negation, condition of existence, non-being, and transition.","refs":["CH_GB18_BBBU:A10","CH_GB18_CDE0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RLE-04","text":"The fixation of finitude produces a secondary circuit: negation is absolutized, thereby itself acquires the status of a subsistence, and must lose its own stability.","refs":["CH_GB18_1DUD:AS2","CH_GB18_1DUD:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:RLE-05","text":"Nothing functions as a feedback-coupled pseudo-endpoint because its being thought reproduces the form of existence that it was supposed to eliminate.","refs":["CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_09:FGS-B01","text":"Mediated self-relation + sublated otherness → determinate existence whose identity can no longer be pure immediacy.","refs":["CH_GB18_BBBU:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FGS-B02","text":"Determination + constitution → unstable difference of inner and outer → qualitative limit as absorbing unity.","refs":["CH_GB18_BBBU:A6","CH_GB18_CDE0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FGS-B03","text":"Qualitative limit → immanent negation → being-in-itself as becoming rather than as resting subsistence.","refs":["CH_GB18_CDE0:A4","CH_GB18_CDE0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FGS-B04","text":"Becoming in itself → negative self-relation → finitude as necessary self-transcendence and necessary passing away.","refs":["CH_GB18_CDE0:A8","CH_GB18_CDE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FGS-B05","text":"Fixed finitude → opposition to the infinite → exclusion of affirmative unification and relapse of nothing into its own contradiction.","refs":["CH_GB18_1DUD:AS2","CH_GB18_1DUD:A9","CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FGS-B06","text":"Contradiction of final negation → passing away of passing away → negative closure without positive explication of the affirmative.","refs":["CH_GB18_1DUD:AS6","CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_09:AFM-B01","text":"Mediated self-relation → otherness as its own moment.","refs":["CH_GB18_BBBU:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B02","text":"Otherness as its own moment → instability of the separation between determination and constitution.","refs":["CH_GB18_BBBU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B03","text":"Unstable determinacy → limit as unity of constitution, difference, and negation.","refs":["CH_GB18_BBBU:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B04","text":"Limit as negation → finitude as negative self-relation and necessary passing away.","refs":["CH_GB18_CDE0:A8","CH_GB18_CDE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B05","text":"Necessary passing away → fixation of finitude as apparently absolute negativity.","refs":["CH_GB18_1DUD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B06","text":"Fixed negativity → untenability of unification and nothing → immanent collapse of final negation.","refs":["CH_GB18_1DUD:AS4","CH_GB18_1DUD:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:AFM-B07","text":"Collapse of final negation → passing away of passing away as negative closure, not positively filled out.","refs":["CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_09:MME-01","text":"The map of inner and outer is reordered: the outer is not the counter-domain of the inner, but its own mediated exposedness.","refs":["CH_GB18_BBBU:DNX3","CH_GB18_BBBU:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MME-02","text":"The limit becomes, from the edge of a finished object, the condition of its determinate existence and the operator of its dissolution.","refs":["CH_GB18_BBBU:ME3","CH_GB18_BBBU:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MME-03","text":"Quality, limit, and time are drawn together into moments of one process: quality limits, limit negates, finitude passes away.","refs":["CH_GB18_CDE0:A2","CH_GB18_CDE0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MME-04","text":"The opposition of finite and infinite becomes visible not as an original duality, but as the effect of the fixation of a negative determination.","refs":["CH_GB18_1DUD:SD3","CH_GB18_1DUD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MME-05","text":"Reading and thinking are committed to transitions rather than fixed predicates; every seemingly stable opposition is treated as a provisional abstraction.","refs":["CH_GB18_BBBU:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_09:ALT-B01","text":"Surface level — determination, constitution, quality, limit, finitude, passing away, nothing, and the infinite appear as explicit objects of movement.","refs":["CH_GB18_BBBU:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:ALT-B02","text":"Structural level — the recurring machine connects mediated identity, immanent negation, limit, negative self-relation, and self-transcendence.","refs":["CH_GB18_BBBU:ALT2","CH_GB18_CDE0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:ALT-B03","text":"Metastrategic level — explanation shifts systematically from external effectuation and external reconciliation to immanent examination and self-dissolution.","refs":["CH_GB18_CDE0:ALT3","CH_GB18_1DUD:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:ALT-B04","text":"Ontological / Temporal level — finite being contains its non-being; birth, death, and passing away are temporal articulations of a single negative structure.","refs":["CH_GB18_CDE0:A7","CH_GB18_CDE0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:ALT-B05","text":"Methodological / Performative level — the form enacts its own thesis by first positing every fixed determination, then transferring it into its immanent opposite, and finally dissolving its asserted final validity.","refs":["CH_GB18_1DUD:AS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_09:FL-01","text":"The limit must be both affirmative determination and negation of existence; the architecture requires both sides, but cannot transfer them into a resting unity.","refs":["CH_GB18_CDE0:A3","CH_GB18_CDE0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FL-02","text":"The end is necessary as the truth of finite being, yet passing away must not be the final truth; the movement requires this tension in order to go beyond fixed finitude.","refs":["CH_GB18_CDE0:A10","CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FL-03","text":"The affirmative is required for the diagnosis of fixed negation, but remains underdetermined in content and prevents a positive closure.","refs":["CH_GB18_1DUD:SD5","CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:FL-04","text":"The initial distinction between determination and constitution is necessary, but is simultaneously relativized by the necessary transition of its sides.","refs":["CH_GB18_BBBU:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MP-01","text":"The limit mutates from the determinacy of a resting existence into the immanent negation that transfers existence into becoming.","refs":["CH_GB18_CDE0:A3","CH_GB18_CDE0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MP-02","text":"Finitude mutates from the processual self-transcendence of determinate being into fixed negation, whose rigidity produces its own contradiction.","refs":["CH_GB18_CDE0:A9","CH_GB18_1DUD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MP-03","text":"Nothing mutates from the supposed endpoint into a contradictory form of existence and thereby becomes the point of transition of the negation of its own final validity.","refs":["CH_GB18_1DUD:NX6","CH_GB18_1DUD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_09:HSI-01","text":"Reality appears as a machine of immanent limits: every determinate unity is constituted by what simultaneously limits it, negates it, and transfers it into its further shape.","refs":["CH_GB18_BBBU:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:HSI-02","text":"A subject receives no sovereign external status; insofar as it appears as a determinate something, it is subject to the same mediation of determination, limit, and negative self-relation.","refs":["CH_GB18_BBBU:D2","CH_GB18_CDE0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:HSI-03","text":"Time is not a neutral medium, but the explication of a finitude in which birth is already determination toward death and passing away itself is not finally valid.","refs":["CH_GB18_CDE0:ALT4","CH_GB18_1DUD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:HSI-04","text":"What remains possible is no flight into an external standpoint, but only the immanent movement in which a fixed negation loses its own stability.","refs":["CH_GB18_BBBU:SNX2","CH_GB18_1DUD:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_09:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from mediated determinacy through limit and finitude to the passing away of passing away.","refs":["CH_GB18_BBBU:MRT1","CH_GB18_1DUD:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MRT-B02","text":"The positive content of the infinite or affirmative remains underdetermined; the architecture provides its necessity, not its positive determination.","refs":["CH_GB18_1DUD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MRT-B03","text":"The strongest operation lies in the transformation of external limitation into immanent mediation, productive contradiction, and necessary self-transcendence.","refs":["CH_GB18_BBBU:MRT4","CH_GB18_BBBU:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MRT-B04","text":"The reconstruction remains coherent provided that negation is not treated as an external deficiency and provided that limit, non-being, end, and passing away are read as mutually generating stages.","refs":["CH_GB18_BBBU:MRT3","CH_GB18_CDE0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_09:MRT-B05","text":"The remaining empty place of the affirmative resists axiomatic reduction: the system requires it as an attractor, but at this level must not present it as a positive final position.","refs":["CH_GB18_1DUD:SNX1","CH_GB18_1DUD:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_09@R001","source_variant_id":"canonical:CL_GB18_09:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 25–27","context":"b. Bestimmung, Beschaffenheit und Grenze. · c. Die Endlichkeit. · 1. Die Unmittelbarkeit der Endlichkeit."},"title_language_code":"en"},{"id":"CL_GB18_10","layer":"CL","title":"Chapters 28–30","order":10,"parents":["CH_GB18_2DSU","CH_GB18_AN_3","CH_GB18_3BDE"],"revision":"CL_GB18_10@R001","sha256":"a19f1659d0bbdd21f3c0b68ea29135816834cc011215b8c7cbaba11c1a831641","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_10:AS-01","text":"Das Cluster bestimmt das Problem der Endlichkeit als Erzeugung einer immanenten Grenze, die nicht bloß beschränkt, sondern die Bewegung ihrer eigenen Überschreitung hervorbringt.","refs":["CH_GB18_2DSU:AS1","CH_GB18_3BDE:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-02","text":"Das Endliche wird als relationale Einheit von Sollen und Schranke rekonstruiert, deren Momente einander nicht äußerlich begrenzen, sondern wechselseitig als Negationen enthalten.","refs":["CH_GB18_2DSU:A13","CH_GB18_3BDE:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-03","text":"Das Sollen eröffnet ein Hinausgehen über die Schranke, bleibt aber durch die Schranke bestimmt und kann daher keine unmittelbare Befreiung leisten.","refs":["CH_GB18_2DSU:AS6","CH_GB18_AN_3:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-04","text":"Die Vermittlung von Ansichsein und Dasein erzeugt eine widersprüchliche Doppelstruktur, in der formale Möglichkeit und qualitative Unmöglichkeit zugleich auftreten.","refs":["CH_GB18_AN_3:A2","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-05","text":"Konkrete Selbstüberschreitung tritt als immanente Aktivität einer Existenz auf, deren Negation als eigene Schranke erlebt, gedacht oder vollzogen wird.","refs":["CH_GB18_AN_3:A6","CH_GB18_AN_3:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-06","text":"Das Sollen behält innerhalb endlicher Verhältnisse normative Geltung, verliert jedoch den Anspruch, die letzte Wahrheit oder endgültige Versöhnung zu bilden.","refs":["CH_GB18_AN_3:AS5","CH_GB18_AN_3:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-07","text":"Der Widerspruch des Endlichen führt zunächst nicht unmittelbar in eine fertige Unendlichkeit, sondern in die Fortsetzung des Übergangs durch andere Endliche.","refs":["CH_GB18_3BDE:AS3","CH_GB18_3BDE:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-08","text":"Die Schließung des Clusters liegt in der Negation der Negation, durch welche das Unendliche nicht als äußeres Jenseits, sondern als affirmatives Sein der durchgearbeiteten Endlichkeit erscheint.","refs":["CH_GB18_3BDE:A15","CH_GB18_3BDE:A16"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_10:GA-01","text":"[Persistent] Endlichkeit ist keine Eigenschaft eines isolierten Dinges, sondern die Selbstbeziehung eines Etwas auf seine immanente Negation.","refs":["CH_GB18_2DSU:A3","CH_GB18_3BDE:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-02","text":"[Persistent] Die Schranke ist keine fremde Begrenzung, sondern die eigene Bestimmtheit des Endlichen als gemeinsamer Bezugspunkt von Etwas und Anderem.","refs":["CH_GB18_2DSU:A10","CH_GB18_3BDE:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-03","text":"[Mutating] Das Sollen mutiert von der negativen Beziehung des Ansichseins auf seine Schranke zu einer endlichen Vermittlungsform, deren Überschreitungsanspruch ihre eigene Begrenzung enthält.","refs":["CH_GB18_2DSU:A11","CH_GB18_AN_3:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-04","text":"[Mutating] Möglichkeit ist nicht autonome Potenz, sondern die abstrakte Seite eines Verhältnisses, dessen qualitative Schranke zugleich Nichtkönnen und Unmöglichkeit erzeugt.","refs":["CH_GB18_AN_3:A2","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-05","text":"[Persistent] Hinausgehen über eine Schranke ist nur als fortgesetzte Beziehung auf diese Schranke möglich und bildet daher keine bloße Flucht aus der Endlichkeit.","refs":["CH_GB18_2DSU:AS6","CH_GB18_AN_3:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-06","text":"[Mutating] Das Andere wandelt sich von einer zugleich inneren und äußeren Bestimmtheit in die entzweit auftretende Selbstidentität eines Moments.","refs":["CH_GB18_2DSU:A6","CH_GB18_3BDE:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-07","text":"[Emergent] Die wechselseitige Negation von Sollen und Schranke macht den Widerspruch nicht zu einem Defekt des Endlichen, sondern zu seiner Bewegungsform und Selbstaufhebung.","refs":["CH_GB18_3BDE:A5","CH_GB18_3BDE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-08","text":"[Attractor] Negation bewahrt ihr Negiertes als Bestimmung, weil die Negation der Negation nicht Vernichtung, sondern die Rückkehr des Endlichen in seine eigene Bestimmtheit leistet.","refs":["CH_GB18_2DSU:A7","CH_GB18_3BDE:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-09","text":"[Terminal] Das Unendliche ist affirmatives Sein nur als Resultat der Selbstnegation des Endlichen und nicht als vorausgesetzte Gegeninstanz.","refs":["CH_GB18_3BDE:D7","CH_GB18_3BDE:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-10","text":"[Terminal] Die normative Geltung des Sollens bleibt erhalten, doch seine Verabsolutierung würde die Endlichkeit und den Widerspruch verewigen.","refs":["CH_GB18_AN_3:AS5","CH_GB18_AN_3:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_10:RMD-01","text":"Die Grenze kehrt als immanente Qualität wieder, mutiert zur Schranke und wird schließlich als produktives Moment der Selbstüberschreitung absorbiert.","refs":["CH_GB18_2DSU:A4","CH_GB18_2DSU:A9","CH_GB18_3BDE:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RMD-02","text":"Das Anderssein verliert die Stellung eines bloßen Außen und erscheint als innere Entzweiung, deren Anderes das Moment selbst in differenzierter Gestalt ist.","refs":["CH_GB18_2DSU:A6","CH_GB18_3BDE:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RMD-03","text":"Negation verschiebt sich von der Bestimmung einer Grenze über die Schranke zur Negation der Negation, die affirmatives Sein erzeugt.","refs":["CH_GB18_2DSU:A7","CH_GB18_3BDE:AS6","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RMD-04","text":"Das Hinausgehen erscheint zuerst als Sollen, konkretisiert sich als Selbstüberschreitung und setzt sich anschließend als Übergang in andere Endliche fort.","refs":["CH_GB18_2DSU:A17","CH_GB18_AN_3:A6","CH_GB18_3BDE:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RMD-05","text":"Das Ansichsein mutiert von abstrakter Selbstbeziehung und bloßem Können zu einem im Vergehen erreichten Zusammengehen des Endlichen mit sich selbst.","refs":["CH_GB18_AN_3:A2","CH_GB18_3BDE:A11","CH_GB18_3BDE:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RMD-06","text":"Die Pflicht bleibt als endliche Gegeninstanz gegen besonderen Willen bestehen, wird jedoch aus einer letzten Ontologie der Vernunft in eine begrenzte normative Funktion verschoben.","refs":["CH_GB18_AN_3:A11","CH_GB18_AN_3:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_10:CGD-01","text":"Die Differenz von Beschaffenheit und Bestimmung bleibt auf der unteren Ebene lokal, weil ihre eigenständige Funktion für die clusterweite Bewegung von Schranke, Sollen und Unendlichkeit nicht weiter ausgeführt wird.","refs":["CH_GB18_2DSU:AS2","CH_GB18_2DSU:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:CGD-02","text":"Schmerz, Trieb, organische Entwicklung und Denken sind lokale Erscheinungsweisen der Selbstüberschreitung, skalieren aber nur als Belegform für die allgemeinere Struktur immanenter Negation.","refs":["CH_GB18_AN_3:AS3","CH_GB18_AN_3:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:CGD-03","text":"Die wechselseitige Implikation von Sollen und Schranke skaliert zur globalen Architektur, weil sie sowohl die Endlichkeit als Widerspruch als auch ihren Übergang bestimmt.","refs":["CH_GB18_2DSU:A13","CH_GB18_3BDE:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:CGD-04","text":"Die moralische Pflicht wird nicht aufgehoben, sondern auf die Ebene endlicher Geltung zurückgestuft und dadurch der höheren Bewegung des Endlichen untergeordnet.","refs":["CH_GB18_AN_3:A11","CH_GB18_AN_3:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:CGD-05","text":"Die positive Gestalt wahrhafter Befreiung bleibt lokal unterbestimmt; auf Clusterebene ist allein bestimmt, dass sie nicht mit dem abstrakten Sollen identisch sein kann.","refs":["CH_GB18_AN_3:MRT2","CH_GB18_AN_3:A9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_10:GNX-01","text":"Ausgeschlossen wird ein Modell der Grenze als äußerlich auferlegtes Hindernis, weil die Schranke zur eigenen Bestimmtheit des Endlichen gehört.","refs":["CH_GB18_2DSU:NX1","CH_GB18_3BDE:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GNX-02","text":"Ausgeschlossen wird ein Sollen, das ohne bestimmte Schranke als reines Ansichsein oder schrankenlose Möglichkeit bestehen könnte.","refs":["CH_GB18_2DSU:NX5","CH_GB18_3BDE:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GNX-03","text":"Ausgeschlossen wird die Gleichsetzung jedes Hinausgehens mit Befreiung, weil abstrakte Transzendenz die Endlichkeit reproduzieren kann.","refs":["CH_GB18_AN_3:A9","CH_GB18_AN_3:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GNX-04","text":"Ausgeschlossen wird ein dauerhaftes Sollen als Form letzter Wahrheit, weil dessen Perennierung die Endlichkeit absolut setzen würde.","refs":["CH_GB18_AN_3:NX6","CH_GB18_AN_3:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GNX-05","text":"Ausgeschlossen wird eine Negation, die nur vernichtet, da jede wirksame Aufhebung eine neue Bestimmung und ein affirmatives Resultat erzeugen muss.","refs":["CH_GB18_3BDE:DNX4","CH_GB18_3BDE:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_10:DBN-01","text":"Das System kann keinen äußeren Standpunkt zulassen, von dem das Endliche seine Schranke ohne fortdauernde Vermittlung verlassen könnte.","refs":["CH_GB18_2DSU:SNX2","CH_GB18_2DSU:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:DBN-02","text":"Das System kann kein vom Endlichen abgetrenntes Unendliches zulassen, weil das Unendliche nur aus der Selbstnegation des Endlichen hervorgeht.","refs":["CH_GB18_3BDE:SNX2","CH_GB18_3BDE:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:DBN-03","text":"Das System kann kein statisches Endliches zulassen, dessen Identität ohne innere Überschreitung und ohne Widerspruch vollendet wäre.","refs":["CH_GB18_3BDE:SNX1","CH_GB18_3BDE:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:DBN-04","text":"Das System kann keine positive Identität zulassen, die der Durcharbeitung von Negation und Widerspruch vorausläge.","refs":["CH_GB18_3BDE:DNX6","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_10:BSA-01","text":"Verwehrt bleibt eine reine Gegenwart des Seienden ebenso wie eine reine Abwesenheit, weil Sein nur als vermittelte Bestimmtheit innerhalb negativer Selbstbeziehung erscheint.","refs":["CH_GB18_2DSU:SNX3","CH_GB18_3BDE:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:BSA-02","text":"Verwehrt bleibt die Möglichkeit, dass das Sollen selbst dauerhaft die Form der Wahrheit bilden könnte, ohne die Endlichkeit absolut zu machen.","refs":["CH_GB18_AN_3:SNX1","CH_GB18_AN_3:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:BSA-03","text":"Verwehrt bleibt ein Unendliches, das als unbestimmte Abwesenheit des Endlichen oder als bloße erste Negation gedacht wird.","refs":["CH_GB18_3BDE:DNX5","CH_GB18_3BDE:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:BSA-04","text":"Verwehrt bleibt ein Anderes, das außerhalb der Selbstbeziehung der Bestimmungen läge und daher keine immanente Vermittlung mit dem Endlichen hätte.","refs":["CH_GB18_3BDE:SNX4","CH_GB18_3BDE:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_10:XD-01","text":"Das Sollen kann nicht als Lösung der Schranke fungieren, weil seine Überschreitungsform zugleich die widersprüchliche Kopplung von Möglichkeit und Unmöglichkeit erzeugt. ; Trace Type — Tension","refs":["CL_GB18_10:GA-03","CL_GB18_10:GA-04","CH_GB18_2DSU:AS6","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:XD-02","text":"Die begriffliche Überschreitbarkeit einer Schranke begründet keine Befreiung, sondern verlangt die Unterscheidung zwischen abstraktem Hinausgehen und immanenter Selbstvollziehung. ; Trace Type — Composite","refs":["CL_GB18_10:GA-02","CL_GB18_10:GA-05","CH_GB18_AN_3:A5","CH_GB18_AN_3:A9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:XD-03","text":"Die endliche Geltung des Sollens wird zur Übergangsbedingung seiner eigenen Entmachtung als Letztprinzip: Was normativ wirksam ist, kann ontologisch nicht die Schließung leisten. ; Trace Type — Composite","refs":["CL_GB18_10:GA-03","CL_GB18_10:GA-07","CL_GB18_10:GA-10","CH_GB18_AN_3:AS5","CH_GB18_3BDE:AS3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:XD-04","text":"Die Reihe anderer Endlicher ist keine Begegnung mit einem fremden Außen, sondern die operative Verlängerung einer Selbstentzweiung, in der jedes Andere die eigene Bestimmung fortsetzt. ; Trace Type — Composite","refs":["CL_GB18_10:GA-06","CL_GB18_10:GA-07","CH_GB18_3BDE:A9","CH_GB18_3BDE:A14"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:XD-05","text":"Das Vergehen des Endlichen produziert affirmatives Sein nur deshalb, weil seine Negation als Negation des Negativen die Bestimmung des Endlichen bewahrt. ; Trace Type — Composite","refs":["CL_GB18_10:GA-08","CL_GB18_10:GA-09","CH_GB18_3BDE:A8","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:XD-06","text":"Subjektive Fähigkeit ist kein hinreichendes Kriterium der Freiheit, weil abstraktes Können erst durch die konkrete Selbstüberschreitung einer immanenten Schranke bestimmt wird. ; Trace Type — Tension","refs":["CL_GB18_10:GA-04","CL_GB18_10:GA-05","CH_GB18_AN_3:A2","CH_GB18_AN_3:A6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_10:BSD-01","text":"Das Endliche wird zur generativen Maschine, die ihre Begrenzung nicht nur erleidet, sondern aus ihrer eigenen negativen Organisation den Übergang zum Unendlichen erzeugt.","refs":["CL_GB18_10:GA-01","CL_GB18_10:GA-07","CL_GB18_10:GA-09","CH_GB18_3BDE:SD1","CH_GB18_3BDE:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:BSD-02","text":"Kausalität wird als immanente Selbstverursachung durch Negation reorganisiert: Nicht ein äußeres Ereignis, sondern die innere Unvereinbarkeit der Bestimmungen treibt das Werden.","refs":["CL_GB18_10:GA-01","CL_GB18_10:GA-07","CH_GB18_3BDE:A6","CH_GB18_3BDE:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:BSD-03","text":"Zeit erscheint als doppelte Bewegung aus Wiederholung und Rückkehr: Die Folge anderer Endlicher verlängert den Übergang, während die Negation der Negation auf affirmative Selbstbeziehung zielt.","refs":["CL_GB18_10:GA-07","CL_GB18_10:GA-08","CL_GB18_10:GA-09","CH_GB18_3BDE:D3","CH_GB18_3BDE:FGS6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:BSD-04","text":"Moralität wird weder verworfen noch ontologisiert, sondern als gültige endliche Gegenform gegen Partikularität bestimmt, deren eigene Grenze ihre Absolutsetzung verhindert.","refs":["CL_GB18_10:GA-03","CL_GB18_10:GA-10","CH_GB18_AN_3:A11","CH_GB18_AN_3:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:BSD-05","text":"Das Unendliche wird nicht als Gegenstand außerhalb des Endlichen kartiert, sondern als Modus, in dem die durch Negation vermittelte Selbstidentität affirmativ wird.","refs":["CL_GB18_10:GA-06","CL_GB18_10:GA-08","CL_GB18_10:GA-09","CH_GB18_3BDE:SD3","CH_GB18_3BDE:D7"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_10:RLE-01","text":"Grenze → Schranke → Sollen → Hinausgehen → erneute Schrankenbestimmung bildet die Grundschleife, in der Überschreitung ihre eigene Bedingung reproduziert.","refs":["CH_GB18_2DSU:FGS1","CH_GB18_2DSU:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RLE-02","text":"Das Sollen erzeugt eine reversible Schleife von Können und Nichtkönnen, in der formale Selbstbeziehung und reale Andersheit einander wechselseitig blockieren.","refs":["CH_GB18_AN_3:SD1","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RLE-03","text":"Das Vergehen des Endlichen eskaliert als Übergangsserie, weil jedes andere Endliche den Widerspruch wiederholt, den es zunächst zu verlassen scheint.","refs":["CH_GB18_3BDE:A9","CH_GB18_3BDE:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RLE-04","text":"Die Negation der Negation fungiert als Attraktor, weil sie die zerstreute Bewegung der Selbstüberschreitung in affirmativer Selbstidentität konzentriert.","refs":["CH_GB18_3BDE:A8","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RLE-05","text":"Das Unendliche ist der begriffliche Attraktor der Bewegung, darf aber nicht als Abkürzung an die Stelle der endlichen Vermittlungen gesetzt werden, aus denen es hervorgeht.","refs":["CH_GB18_3BDE:SD2","CH_GB18_3BDE:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_10:FGS-B01","text":"Reflektiertes Etwas → immanente Grenze → Endlichkeit als Selbstbeziehung auf eigenes Nichtsein.","refs":["CH_GB18_2DSU:A1","CH_GB18_2DSU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B02","text":"Immanente Grenze → wesentliche Negativität → Schranke als eigene Bestimmtheit des Endlichen.","refs":["CH_GB18_2DSU:A9","CH_GB18_2DSU:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B03","text":"Schranke → negative Beziehung des Ansichseins → Sollen als Überschreitung, die ihre Begrenzung mitführt.","refs":["CH_GB18_2DSU:A11","CH_GB18_2DSU:A18"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B04","text":"Sollen → abstraktes Können plus qualitative Schranke → Widerspruch von Möglichkeit und Unmöglichkeit.","refs":["CH_GB18_AN_3:A2","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B05","text":"Sollen ∧ Schranke → wechselseitige Negation → Endlichkeit als sich selbst aufhebender Widerspruch.","refs":["CH_GB18_3BDE:A4","CH_GB18_3BDE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B06","text":"Selbstaufhebung → anderes Endliches → fortgesetztes Übergehen als Reihe immanenter Selbstentzweiungen.","refs":["CH_GB18_3BDE:A9","CH_GB18_3BDE:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B07","text":"Negation des Negativen → Zusammengehen mit sich → affirmatives Sein des Unendlichen.","refs":["CH_GB18_3BDE:A8","CH_GB18_3BDE:A12","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_10:AFM-B01","text":"Reflektiertes Insichsein → immanente Grenze.","refs":["CH_GB18_2DSU:A1","CH_GB18_2DSU:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B02","text":"Immanente Grenze → Schranke als wesentliche Negativität.","refs":["CH_GB18_2DSU:A7","CH_GB18_2DSU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B03","text":"Schranke → Sollen als negative Beziehung auf die eigene Begrenzung.","refs":["CH_GB18_2DSU:A11","CH_GB18_2DSU:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B04","text":"Sollen → Widerspruch von abstrakter Möglichkeit und qualitativer Unmöglichkeit.","refs":["CH_GB18_AN_3:A2","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B05","text":"Endliche Normgeltung → Entzug der Letztgeltung des Sollens.","refs":["CH_GB18_AN_3:AS5","CH_GB18_AN_3:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B06","text":"Wechselseitige Negation von Sollen und Schranke → Vergehen des Endlichen → anderes Endliches.","refs":["CH_GB18_3BDE:A5","CH_GB18_3BDE:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B07","text":"Fortgesetzter Übergang → Negation der Negation → affirmatives Unendliches.","refs":["CH_GB18_3BDE:A10","CH_GB18_3BDE:A8","CH_GB18_3BDE:A16"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_10:MME-01","text":"Das Endliche wird von einem begrenzten Gegenstand zu einer selbstnegativen Relationsform umkartiert, deren Grenze ihren eigenen Übergang erzeugt.","refs":["CH_GB18_2DSU:ME1","CH_GB18_3BDE:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MME-02","text":"Die Schranke wird von einem Verbot oder Hindernis zu einer produktiven Bestimmtheit umklassifiziert, die die Möglichkeit ihres Jenseits bereits enthält.","refs":["CH_GB18_AN_3:ME1","CH_GB18_3BDE:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MME-03","text":"Das Andere wird von einem äußeren Gegenüber zu einer entzweiten Form der Selbstbeziehung umgeordnet.","refs":["CH_GB18_3BDE:ME3","CH_GB18_3BDE:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MME-04","text":"Moralische Pflicht wird als endliche normative Vermittlung lesbar, deren Geltung nicht ihre Erhebung zum ontologischen Endpunkt rechtfertigt.","refs":["CH_GB18_AN_3:ME4","CH_GB18_AN_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MME-05","text":"Das Unendliche wird von einer jenseitigen Gegenwelt zu einer genetischen Bestimmung des Endlichen verschoben.","refs":["CH_GB18_3BDE:ME4","CH_GB18_3BDE:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_10:ALT-B01","text":"Auf der Oberfläche behandelt das System Grenze, Pflicht, Möglichkeit, Können und Übergang als explizite Bestimmungen des Endlichen.","refs":["CH_GB18_AN_3:ALT1","CH_GB18_3BDE:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:ALT-B02","text":"Strukturell organisiert das System eine wechselseitige Negation, in der Grenze, Anderssein, Ansichsein und Dasein als Momente derselben Widerspruchsform auftreten.","refs":["CH_GB18_AN_3:ALT2","CH_GB18_3BDE:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:ALT-B03","text":"Metastrategisch ersetzt das System das Modell äußerer Befreiung durch immanente Selbstüberschreitung und ersetzt die Verteidigung des Sollens durch die Begrenzung seiner Letztgeltung.","refs":["CH_GB18_AN_3:ALT3","CH_GB18_3BDE:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:ALT-B04","text":"Ontologisch und temporal erscheint Sein als Negation der Negation, während Zeit als Vergehen, Übergang, Wiederholung und Selbstzusammengehen organisiert wird.","refs":["CH_GB18_3BDE:ALT4","CH_GB18_AN_3:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:ALT-B05","text":"Methodologisch vollzieht die Form des Systems seine Behauptung, indem sie Begriffe nicht additiv ordnet, sondern sie durch Negation, Mutation und Rückkehr in neue Funktionen zwingt.","refs":["CH_GB18_2DSU:AF1","CH_GB18_3BDE:AF2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_10:FL-01","text":"Das Sollen ist zugleich notwendige endliche Normform und unzureichende Widerspruchsform; seine positive Aufhebung wird verlangt, aber nicht in positiver Gestalt ausgeführt.","refs":["CH_GB18_AN_3:MRT5","CH_GB18_AN_3:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FL-02","text":"Die begriffliche Einsicht, dass jede Schranke ihr Jenseits impliziert, ist nicht identisch mit wahrhafter Befreiung; zwischen Überschreitbarkeit und vollzogener Affirmation bleibt eine produktive Differenz.","refs":["CH_GB18_AN_3:D1","CH_GB18_AN_3:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FL-03","text":"Die Bewegung oszilliert zwischen der unendlichen Folge anderer Endlicher und dem affirmativen Unendlichen, ohne den Übergang von Serie zu Schließung vollständig zu explizieren.","refs":["CH_GB18_3BDE:MRT2","CH_GB18_3BDE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FL-04","text":"Die Kritik des perennierenden Sollens setzt eine Reduktion der kantisch-fichteschen Position auf einen höchsten Sollensstandpunkt voraus, deren interne Differenzierung nicht geleistet wird.","refs":["CH_GB18_AN_3:MRT6","CH_GB18_AN_3:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MP-01","text":"Die Grenze mutiert zur Schranke, sobald sie nicht mehr als bloße Markierung, sondern als wesentlich negative eigene Bestimmtheit des Etwas fungiert.","refs":["CH_GB18_2DSU:NX3","CH_GB18_2DSU:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MP-02","text":"Das Sollen mutiert von einer Form negativer Selbstbeziehung zu einer moralisch normativen und danach wieder ontologisch unzureichenden Vermittlungsform.","refs":["CH_GB18_2DSU:D6","CH_GB18_AN_3:A11","CH_GB18_AN_3:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MP-03","text":"Das Andere mutiert vom unterschiedenen Außen zur immanenten Entzweiung, in der jedes Moment sein eigenes Anderes erzeugt.","refs":["CH_GB18_2DSU:AS3","CH_GB18_3BDE:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MP-04","text":"Negation mutiert von der Schrankenbestimmung zur affirmativen Selbstidentität, sobald sie als Negation der Negation die eigene Bestimmung erhält.","refs":["CH_GB18_2DSU:A7","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_10:HSI-01","text":"Realität erscheint als Maschine immanenter Selbstbegrenzung, deren Grenzen nicht den Abschluss des Seienden markieren, sondern die Bedingungen seiner eigenen Transformation erzeugen.","refs":["CH_GB18_2DSU:SD1","CH_GB18_3BDE:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:HSI-02","text":"Das Subjekt erscheint als Ort, an dem Negation als eigene Schranke empfunden, gedacht oder praktisch als Selbstüberschreitung vollzogen wird.","refs":["CH_GB18_AN_3:A7","CH_GB18_AN_3:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:HSI-03","text":"Zeit erscheint als Verlauf von Vergehen und Wiederkehr, in dem die Folge anderer Endlicher erst durch die Negation der Negation auf Selbstbeziehung hin orientiert wird.","refs":["CH_GB18_3BDE:D3","CH_GB18_3BDE:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:HSI-04","text":"Kampf und Freiheit bleiben nur als immanente Navigation durch die eigene Schranke möglich; jede Vorstellung eines schrankenlosen äußeren Ausbruchs wird ausgeschlossen.","refs":["CH_GB18_2DSU:NX7","CH_GB18_2DSU:SNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_10:MRT-B01","text":"Die globalen Axiome reichen aus, um die Bewegung von immanenter Grenze über Schranke und Sollen bis zur Negation der Negation als affirmativer Bestimmung zu rekonstruieren.","refs":["CH_GB18_2DSU:MRT1","CH_GB18_3BDE:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MRT-B02","text":"Unterbestimmt bleibt die positive Gestalt der wahrhaften Befreiung, weil das Cluster das unvollkommene Hinausgehen bestimmt, aber dessen vollendete Affirmation nicht entfaltet.","refs":["CH_GB18_AN_3:MRT2","CH_GB18_AN_3:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MRT-B03","text":"Die Rekonstruktion ist kohärent, sofern Negation der Negation als Erhaltung und Umformung des Negierten verstanden wird und nicht als bloße Tilgung.","refs":["CH_GB18_2DSU:MRT3","CH_GB18_3BDE:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MRT-B04","text":"Die stärkste Architekturleistung besteht in der Ableitung des Sollens aus der immanenten Schranke und in der anschließenden Begrenzung seines Anspruchs auf letzte Wahrheit.","refs":["CH_GB18_2DSU:MRT4","CH_GB18_AN_3:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MRT-B05","text":"Unverzichtbar bleibt die Spannung zwischen fortgesetztem Übergang in andere Endliche und der affirmativen Schließung im Unendlichen, weil gerade diese Spannung die Differenz von schlechter Wiederholung und negativer Selbstvermittlung sichtbar hält.","refs":["CH_GB18_3BDE:MRT2","CH_GB18_3BDE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120901719983Z_1f0ed993","language_code":"en","language_name":"English","title":"Chapters 28–30","source_sha256":"a19f1659d0bbdd21f3c0b68ea29135816834cc011215b8c7cbaba11c1a831641","sha256":"5e01f60c79f142b4941e0dcb3de638ca9fc641e76189b4ff668c732d84574e70","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:09:01.722857+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_10:AS-01","text":"The cluster determines the problem of finitude as the production of an immanent limit that does not merely restrict, but brings forth the movement of its own transgression.","refs":["CH_GB18_2DSU:AS1","CH_GB18_3BDE:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-02","text":"The finite is reconstructed as the relational unity of ought and limit, whose moments do not externally limit one another, but mutually contain one another as negations.","refs":["CH_GB18_2DSU:A13","CH_GB18_3BDE:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-03","text":"The ought opens a going-beyond the limit, but remains determined by the limit and can therefore provide no immediate liberation.","refs":["CH_GB18_2DSU:AS6","CH_GB18_AN_3:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-04","text":"The mediation of being-in-itself and determinate being produces a contradictory double structure in which formal possibility and qualitative impossibility occur simultaneously.","refs":["CH_GB18_AN_3:A2","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-05","text":"Concrete self-transcendence emerges as the immanent activity of an existence whose negation is experienced, thought, or enacted as its own limit.","refs":["CH_GB18_AN_3:A6","CH_GB18_AN_3:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-06","text":"Within finite relations, the ought retains normative validity, yet loses the claim to constitute the final truth or definitive reconciliation.","refs":["CH_GB18_AN_3:AS5","CH_GB18_AN_3:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-07","text":"The contradiction of the finite does not initially lead directly into a completed infinity, but into the continuation of transition through other finites.","refs":["CH_GB18_3BDE:AS3","CH_GB18_3BDE:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AS-08","text":"The closure of the cluster lies in the negation of negation, through which the infinite appears not as an external beyond, but as the affirmative being of finitude worked through.","refs":["CH_GB18_3BDE:A15","CH_GB18_3BDE:A16"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_10:GA-01","text":"[Persistent] Finitude is not a property of an isolated thing, but the self-relation of a something to its immanent negation.","refs":["CH_GB18_2DSU:A3","CH_GB18_3BDE:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-02","text":"[Persistent] The limit is not an alien restriction, but the finite's own determinacy as the shared point of reference of something and other.","refs":["CH_GB18_2DSU:A10","CH_GB18_3BDE:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-03","text":"[Mutating] The ought mutates from the negative relation of being-in-itself to its limit into a finite form of mediation whose claim to transgression contains its own limitation.","refs":["CH_GB18_2DSU:A11","CH_GB18_AN_3:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-04","text":"[Mutating] Possibility is not autonomous potentiality, but the abstract side of a relation whose qualitative limit simultaneously produces incapacity and impossibility.","refs":["CH_GB18_AN_3:A2","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-05","text":"[Persistent] Going beyond a limit is possible only as a continued relation to that limit and therefore does not constitute a mere escape from finitude.","refs":["CH_GB18_2DSU:AS6","CH_GB18_AN_3:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-06","text":"[Mutating] The other changes from a determination that is at once internal and external into the self-identity of a moment appearing in division.","refs":["CH_GB18_2DSU:A6","CH_GB18_3BDE:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-07","text":"[Emergent] The mutual negation of ought and limit makes contradiction not a defect of the finite, but its form of movement and self-sublation.","refs":["CH_GB18_3BDE:A5","CH_GB18_3BDE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-08","text":"[Attractor] Negation preserves what it negates as a determination, because the negation of negation accomplishes not annihilation, but the return of the finite into its own determinacy.","refs":["CH_GB18_2DSU:A7","CH_GB18_3BDE:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-09","text":"[Terminal] The infinite is affirmative being only as the result of the finite's self-negation and not as a presupposed counter-instance.","refs":["CH_GB18_3BDE:D7","CH_GB18_3BDE:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GA-10","text":"[Terminal] The normative validity of the ought is retained, yet its absolutization would perpetuate finitude and contradiction.","refs":["CH_GB18_AN_3:AS5","CH_GB18_AN_3:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_10:RMD-01","text":"The boundary recurs as an immanent quality, mutates into the limit, and is finally absorbed as a productive moment of self-transcendence.","refs":["CH_GB18_2DSU:A4","CH_GB18_2DSU:A9","CH_GB18_3BDE:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RMD-02","text":"Otherness loses the status of a mere outside and appears as an inner division whose other is the moment itself in differentiated form.","refs":["CH_GB18_2DSU:A6","CH_GB18_3BDE:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RMD-03","text":"Negation shifts from the determination of a boundary through the limit to the negation of negation, which produces affirmative being.","refs":["CH_GB18_2DSU:A7","CH_GB18_3BDE:AS6","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RMD-04","text":"Going-beyond first appears as ought, becomes concrete as self-transcendence, and subsequently continues as transition into other finites.","refs":["CH_GB18_2DSU:A17","CH_GB18_AN_3:A6","CH_GB18_3BDE:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RMD-05","text":"Being-in-itself mutates from abstract self-relation and mere capacity into a coming-together with itself attained in passing away.","refs":["CH_GB18_AN_3:A2","CH_GB18_3BDE:A11","CH_GB18_3BDE:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RMD-06","text":"Duty remains as a finite counter-instance against particular will, yet is displaced from a final ontology of reason into a limited normative function.","refs":["CH_GB18_AN_3:A11","CH_GB18_AN_3:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_10:CGD-01","text":"The difference between constitution and determination remains local at the lower level, because its independent function for the cluster-wide movement of limit, ought, and infinity is not further elaborated.","refs":["CH_GB18_2DSU:AS2","CH_GB18_2DSU:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:CGD-02","text":"Pain, drive, organic development, and thought are local manifestations of self-transcendence, but scale only as evidentiary forms for the more general structure of immanent negation.","refs":["CH_GB18_AN_3:AS3","CH_GB18_AN_3:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:CGD-03","text":"The mutual implication of ought and limit scales into the global architecture, because it determines both finitude as contradiction and its transition.","refs":["CH_GB18_2DSU:A13","CH_GB18_3BDE:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:CGD-04","text":"Moral duty is not sublated, but downgraded to the level of finite validity and thereby subordinated to the higher movement of the finite.","refs":["CH_GB18_AN_3:A11","CH_GB18_AN_3:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:CGD-05","text":"The positive shape of true liberation remains locally underdetermined; at the cluster level, it is determined only that it cannot be identical with abstract ought.","refs":["CH_GB18_AN_3:MRT2","CH_GB18_AN_3:A9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_10:GNX-01","text":"Excluded is a model of the boundary as an externally imposed obstacle, because the limit belongs to the finite's own determinacy.","refs":["CH_GB18_2DSU:NX1","CH_GB18_3BDE:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GNX-02","text":"Excluded is an ought that could exist without a determinate limit as pure being-in-itself or limitless possibility.","refs":["CH_GB18_2DSU:NX5","CH_GB18_3BDE:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GNX-03","text":"Excluded is the equation of every going-beyond with liberation, because abstract transcendence can reproduce finitude.","refs":["CH_GB18_AN_3:A9","CH_GB18_AN_3:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GNX-04","text":"Excluded is a permanent ought as the form of final truth, because its perpetuation would posit finitude as absolute.","refs":["CH_GB18_AN_3:NX6","CH_GB18_AN_3:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:GNX-05","text":"Excluded is a negation that merely annihilates, since every effective sublation must produce a new determination and an affirmative result.","refs":["CH_GB18_3BDE:DNX4","CH_GB18_3BDE:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_10:DBN-01","text":"The system cannot admit an external standpoint from which the finite could leave its limit without ongoing mediation.","refs":["CH_GB18_2DSU:SNX2","CH_GB18_2DSU:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:DBN-02","text":"The system cannot admit an infinite separated from the finite, because the infinite proceeds only from the self-negation of the finite.","refs":["CH_GB18_3BDE:SNX2","CH_GB18_3BDE:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:DBN-03","text":"The system cannot admit a static finite whose identity would be completed without inner transcendence and without contradiction.","refs":["CH_GB18_3BDE:SNX1","CH_GB18_3BDE:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:DBN-04","text":"The system cannot admit a positive identity that would precede the working-through of negation and contradiction.","refs":["CH_GB18_3BDE:DNX6","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_10:BSA-01","text":"Denied is a pure presence of being just as much as a pure absence, because being appears only as mediated determinacy within negative self-relation.","refs":["CH_GB18_2DSU:SNX3","CH_GB18_3BDE:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:BSA-02","text":"Denied is the possibility that ought itself could permanently constitute the form of truth without making finitude absolute.","refs":["CH_GB18_AN_3:SNX1","CH_GB18_AN_3:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:BSA-03","text":"Denied is an infinite conceived as the indeterminate absence of the finite or as mere first negation.","refs":["CH_GB18_3BDE:DNX5","CH_GB18_3BDE:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:BSA-04","text":"Denied is an other that would lie outside the self-relation of determinations and would therefore have no immanent mediation with the finite.","refs":["CH_GB18_3BDE:SNX4","CH_GB18_3BDE:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_10:XD-01","text":"The ought cannot function as the solution to the limit, because its form of transgression simultaneously produces the contradictory coupling of possibility and impossibility. ; Trace Type — Tension","refs":["CL_GB18_10:GA-03","CL_GB18_10:GA-04","CH_GB18_2DSU:AS6","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:XD-02","text":"The conceptual transgressibility of a limit does not establish liberation, but demands the distinction between abstract going-beyond and immanent self-enactment. ; Trace Type — Composite","refs":["CL_GB18_10:GA-02","CL_GB18_10:GA-05","CH_GB18_AN_3:A5","CH_GB18_AN_3:A9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:XD-03","text":"The finite validity of ought becomes the condition of transition for its own disempowerment as final principle: what is normatively effective cannot ontologically provide closure. ; Trace Type — Composite","refs":["CL_GB18_10:GA-03","CL_GB18_10:GA-07","CL_GB18_10:GA-10","CH_GB18_AN_3:AS5","CH_GB18_3BDE:AS3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:XD-04","text":"The series of other finites is not an encounter with an alien outside, but the operative prolongation of a self-division in which every other continues its own determination. ; Trace Type — Composite","refs":["CL_GB18_10:GA-06","CL_GB18_10:GA-07","CH_GB18_3BDE:A9","CH_GB18_3BDE:A14"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:XD-05","text":"The passing away of the finite produces affirmative being only because its negation, as negation of the negative, preserves the determination of the finite. ; Trace Type — Composite","refs":["CL_GB18_10:GA-08","CL_GB18_10:GA-09","CH_GB18_3BDE:A8","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:XD-06","text":"Subjective capacity is not a sufficient criterion of freedom, because abstract ability is determined only through the concrete self-transcendence of an immanent limit. ; Trace Type — Tension","refs":["CL_GB18_10:GA-04","CL_GB18_10:GA-05","CH_GB18_AN_3:A2","CH_GB18_AN_3:A6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_10:BSD-01","text":"The finite becomes a generative machine that does not merely suffer its limitation, but produces from its own negative organization the transition to the infinite.","refs":["CL_GB18_10:GA-01","CL_GB18_10:GA-07","CL_GB18_10:GA-09","CH_GB18_3BDE:SD1","CH_GB18_3BDE:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:BSD-02","text":"Causality is reorganized as immanent self-causation through negation: not an external event, but the internal incompatibility of determinations drives becoming.","refs":["CL_GB18_10:GA-01","CL_GB18_10:GA-07","CH_GB18_3BDE:A6","CH_GB18_3BDE:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:BSD-03","text":"Time appears as a double movement of repetition and return: the succession of other finites prolongs the transition, while the negation of negation aims at affirmative self-relation.","refs":["CL_GB18_10:GA-07","CL_GB18_10:GA-08","CL_GB18_10:GA-09","CH_GB18_3BDE:D3","CH_GB18_3BDE:FGS6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:BSD-04","text":"Morality is neither rejected nor ontologized, but determined as a valid finite counter-form against particularity, whose own limit prevents its absolutization.","refs":["CL_GB18_10:GA-03","CL_GB18_10:GA-10","CH_GB18_AN_3:A11","CH_GB18_AN_3:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_10:BSD-05","text":"The infinite is not mapped as an object outside the finite, but as a mode in which self-identity mediated through negation becomes affirmative.","refs":["CL_GB18_10:GA-06","CL_GB18_10:GA-08","CL_GB18_10:GA-09","CH_GB18_3BDE:SD3","CH_GB18_3BDE:D7"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_10:RLE-01","text":"Boundary → limit → ought → going-beyond → renewed determination of the limit forms the basic loop in which transgression reproduces its own condition.","refs":["CH_GB18_2DSU:FGS1","CH_GB18_2DSU:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RLE-02","text":"The ought produces a reversible loop of ability and incapacity in which formal self-relation and real otherness mutually block one another.","refs":["CH_GB18_AN_3:SD1","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RLE-03","text":"The passing away of the finite escalates as a series of transitions, because every other finite repeats the contradiction that it initially appears to leave behind.","refs":["CH_GB18_3BDE:A9","CH_GB18_3BDE:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RLE-04","text":"The negation of negation functions as an attractor because it concentrates the scattered movement of self-transcendence in affirmative self-identity.","refs":["CH_GB18_3BDE:A8","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:RLE-05","text":"The infinite is the conceptual attractor of the movement, but must not be placed as a shortcut in lieu of the finite mediations from which it proceeds.","refs":["CH_GB18_3BDE:SD2","CH_GB18_3BDE:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_10:FGS-B01","text":"Reflected something → immanent boundary → finitude as self-relation to its own non-being.","refs":["CH_GB18_2DSU:A1","CH_GB18_2DSU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B02","text":"Immanent boundary → essential negativity → limit as the finite's own determinacy.","refs":["CH_GB18_2DSU:A9","CH_GB18_2DSU:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B03","text":"Limit → negative relation of being-in-itself → ought as transgression that carries its limitation along with it.","refs":["CH_GB18_2DSU:A11","CH_GB18_2DSU:A18"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B04","text":"Ought → abstract ability plus qualitative limit → contradiction of possibility and impossibility.","refs":["CH_GB18_AN_3:A2","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B05","text":"Ought ∧ limit → mutual negation → finitude as self-sublating contradiction.","refs":["CH_GB18_3BDE:A4","CH_GB18_3BDE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B06","text":"Self-sublation → other finite → continued passing-over as a series of immanent self-divisions.","refs":["CH_GB18_3BDE:A9","CH_GB18_3BDE:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FGS-B07","text":"Negation of the negative → coming-together with itself → affirmative being of the infinite.","refs":["CH_GB18_3BDE:A8","CH_GB18_3BDE:A12","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_10:AFM-B01","text":"Reflected being-within-itself → immanent boundary.","refs":["CH_GB18_2DSU:A1","CH_GB18_2DSU:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B02","text":"Immanent boundary → limit as essential negativity.","refs":["CH_GB18_2DSU:A7","CH_GB18_2DSU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B03","text":"Limit → ought as negative relation to its own limitation.","refs":["CH_GB18_2DSU:A11","CH_GB18_2DSU:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B04","text":"Ought → contradiction of abstract possibility and qualitative impossibility.","refs":["CH_GB18_AN_3:A2","CH_GB18_AN_3:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B05","text":"Finite normative validity → withdrawal of the final validity of ought.","refs":["CH_GB18_AN_3:AS5","CH_GB18_AN_3:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B06","text":"Mutual negation of ought and limit → passing away of the finite → other finite.","refs":["CH_GB18_3BDE:A5","CH_GB18_3BDE:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:AFM-B07","text":"Continued transition → negation of negation → affirmative infinite.","refs":["CH_GB18_3BDE:A10","CH_GB18_3BDE:A8","CH_GB18_3BDE:A16"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_10:MME-01","text":"The finite is remapped from a limited object into a self-negative relational form whose boundary produces its own transition.","refs":["CH_GB18_2DSU:ME1","CH_GB18_3BDE:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MME-02","text":"The limit is reclassified from a prohibition or obstacle into a productive determinacy that already contains the possibility of its beyond.","refs":["CH_GB18_AN_3:ME1","CH_GB18_3BDE:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MME-03","text":"The other is reordered from an external counterpart into a divided form of self-relation.","refs":["CH_GB18_3BDE:ME3","CH_GB18_3BDE:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MME-04","text":"Moral duty becomes legible as finite normative mediation whose validity does not justify its elevation to the ontological endpoint.","refs":["CH_GB18_AN_3:ME4","CH_GB18_AN_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MME-05","text":"The infinite is displaced from a transcendent counter-world into a genetic determination of the finite.","refs":["CH_GB18_3BDE:ME4","CH_GB18_3BDE:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_10:ALT-B01","text":"At the surface, the system treats boundary, duty, possibility, ability, and transition as explicit determinations of the finite.","refs":["CH_GB18_AN_3:ALT1","CH_GB18_3BDE:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:ALT-B02","text":"Structurally, the system organizes a mutual negation in which boundary, otherness, being-in-itself, and determinate being appear as moments of the same form of contradiction.","refs":["CH_GB18_AN_3:ALT2","CH_GB18_3BDE:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:ALT-B03","text":"Metastrategically, the system replaces the model of external liberation with immanent self-transcendence and replaces the defense of ought with the limitation of its final validity.","refs":["CH_GB18_AN_3:ALT3","CH_GB18_3BDE:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:ALT-B04","text":"Ontologically and temporally, being appears as negation of negation, while time is organized as passing away, transition, repetition, and self-coming-together.","refs":["CH_GB18_3BDE:ALT4","CH_GB18_AN_3:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:ALT-B05","text":"Methodologically, the form of the system enacts its assertion by ordering concepts not additively, but by forcing them through negation, mutation, and return into new functions.","refs":["CH_GB18_2DSU:AF1","CH_GB18_3BDE:AF2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_10:FL-01","text":"The ought is at once a necessary finite normative form and an insufficient form of contradiction; its positive sublation is demanded, but not elaborated in positive form.","refs":["CH_GB18_AN_3:MRT5","CH_GB18_AN_3:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FL-02","text":"The conceptual insight that every limit implies its beyond is not identical with true liberation; between transgressibility and enacted affirmation there remains a productive difference.","refs":["CH_GB18_AN_3:D1","CH_GB18_AN_3:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FL-03","text":"The movement oscillates between the infinite succession of other finites and the affirmative infinite without fully explicating the transition from series to closure.","refs":["CH_GB18_3BDE:MRT2","CH_GB18_3BDE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:FL-04","text":"The critique of the perpetuating ought presupposes a reduction of the Kantian-Fichtean position to a highest standpoint of ought, whose internal differentiation is not undertaken.","refs":["CH_GB18_AN_3:MRT6","CH_GB18_AN_3:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MP-01","text":"The boundary mutates into the limit as soon as it functions no longer as a mere marking, but as the essentially negative own determinacy of the something.","refs":["CH_GB18_2DSU:NX3","CH_GB18_2DSU:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MP-02","text":"The ought mutates from a form of negative self-relation into a morally normative and thereafter once again ontologically insufficient form of mediation.","refs":["CH_GB18_2DSU:D6","CH_GB18_AN_3:A11","CH_GB18_AN_3:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MP-03","text":"The other mutates from differentiated outside into immanent division, in which every moment produces its own other.","refs":["CH_GB18_2DSU:AS3","CH_GB18_3BDE:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MP-04","text":"Negation mutates from the determination of the limit into affirmative self-identity as soon as it preserves its own determination as negation of negation.","refs":["CH_GB18_2DSU:A7","CH_GB18_3BDE:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_10:HSI-01","text":"Reality appears as a machine of immanent self-limitation whose boundaries do not mark the closure of being, but produce the conditions of its own transformation.","refs":["CH_GB18_2DSU:SD1","CH_GB18_3BDE:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:HSI-02","text":"The subject appears as the site at which negation is felt, thought, or practically enacted as self-transcendence as its own limit.","refs":["CH_GB18_AN_3:A7","CH_GB18_AN_3:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:HSI-03","text":"Time appears as a course of passing away and return, in which the succession of other finites is oriented toward self-relation only through the negation of negation.","refs":["CH_GB18_3BDE:D3","CH_GB18_3BDE:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:HSI-04","text":"Struggle and freedom remain possible only as immanent navigation through one's own limit; every conception of an unlimited external breakout is excluded.","refs":["CH_GB18_2DSU:NX7","CH_GB18_2DSU:SNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_10:MRT-B01","text":"The global axioms suffice to reconstruct the movement from immanent boundary through limit and ought up to the negation of negation as affirmative determination.","refs":["CH_GB18_2DSU:MRT1","CH_GB18_3BDE:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MRT-B02","text":"The positive shape of true liberation remains underdetermined, because the cluster determines imperfect going-beyond but does not unfold its completed affirmation.","refs":["CH_GB18_AN_3:MRT2","CH_GB18_AN_3:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MRT-B03","text":"The reconstruction is coherent insofar as negation of negation is understood as preservation and transformation of what is negated, and not as mere erasure.","refs":["CH_GB18_2DSU:MRT3","CH_GB18_3BDE:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MRT-B04","text":"The strongest architectural achievement consists in deriving ought from the immanent limit and in subsequently limiting its claim to final truth.","refs":["CH_GB18_2DSU:MRT4","CH_GB18_AN_3:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_10:MRT-B05","text":"Indispensable remains the tension between continued transition into other finites and affirmative closure in the infinite, because precisely this tension keeps visible the difference between bad repetition and negative self-mediation.","refs":["CH_GB18_3BDE:MRT2","CH_GB18_3BDE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_10@R001","source_variant_id":"canonical:CL_GB18_10:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 28–30","context":"2. Die Schranke und das Sollen. · Anmerkung. · 3. Übergang des Endlichen in das Unendliche."},"title_language_code":"en"},{"id":"CL_GB18_11","layer":"CL","title":"Chapters 31–33","order":11,"parents":["CH_GB18_CDU0","CH_GB18_DUB0","CH_GB18_BWDE"],"revision":"CL_GB18_11@R001","sha256":"8b369334eda8657c2305ba9c25b82452770026a8bc4f7a0ebd6b8f646626abb0","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_11:AS-B01","text":"Das Cluster bestimmt Absolutheit nicht als fertige Gegenregion zur Endlichkeit, sondern als Problem der Selbstbeziehung, die jede isolierte Bestimmung in ihre eigene Grenze zurückführt.","refs":["CH_GB18_CDU0:AS1","CH_GB18_CDU0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AS-B02","text":"Die Endlichkeit fungiert nicht als äußerlich zu überwindendes Material, sondern als eine Schrankenstruktur, deren Selbstbezug ihren Übergang in das Unendliche erzeugt.","refs":["CH_GB18_DUB0:A5","CH_GB18_BWDE:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AS-B03","text":"Die erste Negation des Endlichen scheitert gerade durch ihren Ausschlussgestus: Sie setzt das Endliche als ihr notwendiges Anderes und verendlicht damit das beanspruchte Unendliche.","refs":["CH_GB18_CDU0:A5","CH_GB18_BWDE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AS-B04","text":"Der unendliche Progress bildet die zeitliche Erscheinungsform einer begrifflich unverarbeiteten Einheit, weil jedes Überschreiten die Struktur von Grenze und Gegenüber erneut setzt.","refs":["CH_GB18_BWDE:AS5","CH_GB18_BWDE:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AS-B05","text":"Die Bewegung schließt nicht mit einer neuen positiven Bestimmung, sondern mit dem wahrhaften Unendlichen als Aufhebung der Selbständigkeit beider Seiten, in der das Endliche genetisch wirksam bleibt, aber nicht mehr als Resultat besteht.","refs":["CH_GB18_CDU0:AS7","CH_GB18_DUB0:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_11:GA-01","text":"[Persistent] Das Absolute kann nicht durch eine unmittelbare endliche Daseinsform bestimmt werden, weil jede solche Bestimmtheit nur als begrenztes Moment innerhalb einer weitergehenden Selbstbeziehung besteht.","refs":["CH_GB18_CDU0:AS2","CH_GB18_CDU0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-02","text":"[Persistent] Die Schranke ist keine bloße Begrenzung eines fertigen Endlichen, sondern dessen Selbstbeziehung und immanente Triebkraft des Übergangs.","refs":["CH_GB18_DUB0:A5","CH_GB18_BWDE:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-03","text":"[Mutating] Negation wird nur dann wahrhaft affirmativ, wenn sie nicht beim Ausschluss ihres Anderen verharrt, sondern die Einseitigkeit ihrer eigenen Setzung negiert.","refs":["CH_GB18_DUB0:AS3","CH_GB18_CDU0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-04","text":"[Persistent] Ein Unendliches, das dem Endlichen als selbständige Gegenbestimmung gegenübersteht, ist selbst begrenzt, weil seine Identität von genau dem ausgeschlossenen Anderen abhängt.","refs":["CH_GB18_CDU0:AS4","CH_GB18_BWDE:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-05","text":"[Emergent] Endliches und Unendliches bilden keine zwei ontologisch getrennten Regionen, sondern eine genetische Einheit, deren Momente sich wechselseitig setzen und begrenzen.","refs":["CH_GB18_DUB0:SD1","CH_GB18_BWDE:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-06","text":"[Attractor] Selbstbeziehung ist der verdeckte Attraktor der gesamten Bewegung: Grenze, Negation, Übergang und Aufhebung sind Formen, in denen Bestimmungen auf ihre eigene Nichtselbständigkeit zurückgeführt werden.","refs":["CH_GB18_CDU0:AS1","CH_GB18_DUB0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-07","text":"[Mutating] Das Endliche verändert seinen Status vom ausgeschlossenen Anderen über den notwendigen Vermittler zur aufgehobenen, nicht mehr selbständigen Bestimmung.","refs":["CH_GB18_CDU0:A4","CH_GB18_DUB0:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-08","text":"[Persistent] Der unendliche Progress ist keine Erfüllung der Unendlichkeit, sondern die Wiederkehr derselben Grenze unter der Form fortgesetzten Überschreitens.","refs":["CH_GB18_BWDE:D6","CH_GB18_BWDE:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-09","text":"[Emergent] Das wahrhafte Unendliche entsteht als Prozess, in dem die isolierten Bestimmungen von Endlichem und Unendlichem ihre wechselseitige Abhängigkeit aufheben.","refs":["CH_GB18_CDU0:A8","CH_GB18_BWDE:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-10","text":"[Terminal] Die Schlussformel, dass nur das Unendliche ist, bezeichnet keine Vernichtung der Vermittlung, sondern den Entzug selbständigen Seins vom Endlichen nach vollzogener Aufhebung.","refs":["CH_GB18_DUB0:A13","CH_GB18_DUB0:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_11:RMD-01","text":"Die Schranke kehrt zunächst als endliche Begrenzung wieder, mutiert aber zur Selbstbeziehung des Endlichen und schließlich zum Mechanismus, durch den jede feste Seite in ihr Anderes übergeht.","refs":["CH_GB18_DUB0:A3","CH_GB18_BWDE:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RMD-02","text":"Negation kehrt funktional wieder, jedoch nicht identisch: Als erste Negation produziert sie Gegenüberstellung; als Negation der Negation erzeugt sie affirmative Unendlichkeit.","refs":["CH_GB18_CDU0:A4","CH_GB18_DUB0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RMD-03","text":"Das Unendliche mutiert vom abstrakten Jenseits über ein endliches Unendliches zur prozessualen Einheit, welche die Form des Jenseits selbst annulliert.","refs":["CH_GB18_CDU0:A6","CH_GB18_DUB0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RMD-04","text":"Das Endliche wird zunächst als Gegenpol benötigt, dann als immanenter Vermittler bestimmt und am Ende nur noch als aufgehobene Bedingung der Unendlichkeit erhalten.","refs":["CH_GB18_DUB0:D4","CH_GB18_DUB0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RMD-05","text":"Der Fortschritt kehrt als scheinbare Unendlichkeit wieder, erfährt aber eine Valenzumkehr: Was als Überschreitung erscheint, wird als Reproduktion nicht aufgehobener Endlichkeit klassifiziert.","refs":["CH_GB18_BWDE:AS5","CH_GB18_BWDE:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_11:CGD-01","text":"Seyn und Werden bleiben lokale Anfangsfiguren der Bestimmungslosigkeit; auf Clusterebene tragen sie nur die allgemeinere Forderung, dass Absolutheit nicht in einer unmittelbaren Bestimmung stillgestellt werden kann.","refs":["CH_GB18_CDU0:A2","CH_GB18_CDU0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:CGD-02","text":"Die konkrete Bestimmung der Schranke als Eigentum des Endlichen skaliert zur globalen Regel, dass jede scheinbar selbständige Bestimmung ihre eigene Übergangsbedingung enthält.","refs":["CH_GB18_DUB0:A4","CH_GB18_BWDE:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:CGD-03","text":"Die Zurückweisung subjektiver Vernunft und äußerer Gewalt bleibt nicht lokal, sondern wird zur clusterweiten Verlagerung von Erklärung aus externen Ursachen in immanente Selbstbewegung.","refs":["CH_GB18_DUB0:A8","CH_GB18_DUB0:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:CGD-04","text":"Das perennierende Sollen und der unendliche Progress sind nicht bloß lokale Fehlformen, sondern die globale Diagnose jeder Bewegung, die Übergang vollzieht, ohne die Struktur des Gegenübers aufzuheben.","refs":["CH_GB18_BWDE:A11","CH_GB18_BWDE:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_11:GNX-01","text":"Ausgeschlossen wird ein Zweiweltenmodell, in dem Endliches und Unendliches als unabhängig bestehende ontologische Regionen verteilt werden.","refs":["CH_GB18_CDU0:DNX3","CH_GB18_DUB0:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GNX-02","text":"Ausgeschlossen wird eine Unendlichkeit, die durch bloßen Ausschluss des Endlichen oder durch räumliche Entfernung von ihm erreicht werden könnte.","refs":["CH_GB18_CDU0:NX2","CH_GB18_BWDE:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GNX-03","text":"Ausgeschlossen wird jede äußere Instanz, die den Übergang hervorbringen könnte, sei sie subjektive Vernunft, fremde Gewalt oder transzendentes Jenseits.","refs":["CH_GB18_DUB0:NX4","CH_GB18_DUB0:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GNX-04","text":"Ausgeschlossen wird die Behauptung, endloses Weitergehen könne den Widerspruch lösen, den es bei jedem Schritt erneut erzeugt.","refs":["CH_GB18_BWDE:NX5","CH_GB18_BWDE:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_11:DBN-01","text":"Das Cluster kann keine schlechthin selbständige Endlichkeit und keine schlechthin selbständige Unendlichkeit zulassen, weil jede Seite nur durch ihr Anderes bestimmt wäre.","refs":["CH_GB18_BWDE:DNX1","CH_GB18_BWDE:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:DBN-02","text":"Das Cluster disqualifiziert jede Ontologie, in der Grenze letzte Identität bedeutet; eine Grenze muss Übergang und Selbstnegation enthalten, um nicht selbst zur absoluten Schranke des Denkens zu werden.","refs":["CH_GB18_DUB0:SNX3","CH_GB18_BWDE:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:DBN-03","text":"Das Cluster kann keine positive Endbestimmung außerhalb ihrer eigenen Aufhebung anerkennen; jedes fertige Resultat würde erneut in die Einseitigkeit zurückfallen, die es überwinden soll.","refs":["CH_GB18_CDU0:SNX2","CH_GB18_BWDE:A4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_11:BSA-01","text":"Unverfügbar ist ein äußerer Standpunkt, von dem aus Endlichkeit verlassen oder Unendlichkeit als bereits fertiger Besitz ergriffen werden könnte.","refs":["CH_GB18_DUB0:SNX2","CH_GB18_DUB0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSA-02","text":"Unmöglich ist ein letzter positiver Grund, der nicht durch die Aufhebung seiner eigenen isolierten Bestimmtheit hindurchgegangen wäre.","refs":["CH_GB18_CDU0:SNX3","CH_GB18_CDU0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSA-03","text":"Unzulässig ist eine Zeitform des bloßen „Und so fort“, weil sie Zukunft als Wiederholung derselben Grenze statt als Vollzug ihrer begrifflichen Aufhebung organisiert.","refs":["CH_GB18_BWDE:SNX3","CH_GB18_BWDE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_11:XD-01","text":"Der Übergang ins Unendliche ist weder Flucht aus einer Grenze noch Zugang zu einem äußeren Jenseits, sondern die Selbstentfaltung einer Grenze, die sich als eigene Negativität erweist.","refs":["CL_GB18_11:GA-02","CL_GB18_11:GA-06","CH_GB18_DUB0:A5","CH_GB18_BWDE:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_11:XD-02","text":"Der unendliche Progress entsteht, wenn die notwendige Einheit der Momente nur faktisch wirksam ist, aber nicht als Einheit begriffen wird; Zeit ersetzt dann die ausstehende begriffliche Vermittlung.","refs":["CL_GB18_11:GA-05","CL_GB18_11:GA-08","CH_GB18_BWDE:AS4","CH_GB18_BWDE:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_11:XD-03","text":"Die terminale Formel des alleinigen Unendlichen kann nur gelten, wenn das Verschwinden des Endlichen als Aufhebung seiner Selbständigkeit und nicht als Löschung seiner Vermittlungsfunktion verstanden wird.","refs":["CL_GB18_11:GA-07","CL_GB18_11:GA-10","CH_GB18_DUB0:A12","CH_GB18_DUB0:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_11:XD-04","text":"Die Kritik äußerer Erhebung und die Kritik endlosen Fortschritts bilden gemeinsam eine Theorie immanenter Notwendigkeit: Weder Subjekt noch Zukunft können leisten, was nur die Selbstaufhebung der Bestimmungen leisten kann.","refs":["CL_GB18_11:GA-03","CL_GB18_11:GA-08","CH_GB18_DUB0:D7","CH_GB18_BWDE:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_11:XD-05","text":"Das wahrhafte Unendliche ist nicht das letzte Glied einer Fortschrittsreihe, sondern die Umformung der Regel, durch die jedes Glied überhaupt als begrenztes Gegenüber erzeugt wird.","refs":["CL_GB18_11:GA-08","CL_GB18_11:GA-09","CH_GB18_CDU0:AS7","CH_GB18_BWDE:A10"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_11:BSD-01","text":"Realität erscheint als immanente Maschine der Selbstbegrenzung, in der jede feste Identität durch ihre eigene Beziehung auf ein Anderes in Bewegung gerät.","refs":["CH_GB18_BWDE:A6","CH_GB18_BWDE:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSD-02","text":"Zeitliche Unendlichkeit wird als Symptom einer nicht reflektierten Begriffsstruktur umgedeutet; Dauer ist hier nicht Tiefe der Unendlichkeit, sondern Persistenz des ungelösten Gegensatzes.","refs":["CH_GB18_BWDE:SD3","CH_GB18_BWDE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSD-03","text":"Das Subjekt verliert den Status eines erzeugenden Ursprungs und wird höchstens zur begrifflichen Nachvollzugsinstanz einer Bewegung, die im Gegenstand selbst verankert ist.","refs":["CH_GB18_DUB0:A8","CH_GB18_DUB0:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSD-04","text":"Wahrheit ist nicht dauerhafte Selbigkeit, sondern affirmative Selbstaufhebung: Eine Bestimmung ist wahr, sofern sie ihre eigene Einseitigkeit als Moment einer umfassenderen Bewegung ausweist.","refs":["CH_GB18_DUB0:SD3","CH_GB18_DUB0:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSD-05","text":"Methodisch verlangt das Cluster immanente Kritik: Nicht die äußerliche Widerlegung, sondern die Rekonstruktion der Selbstbegrenzung einer Bestimmung erzeugt ihren Übergang.","refs":["CH_GB18_CDU0:SD1","CH_GB18_BWDE:A2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_11:RLE-01","text":"Die zentrale Schleife lautet: Schranke erzeugt Überschreitung, Überschreitung setzt neue Schranke, neue Schranke reproduziert das Bedürfnis nach Überschreitung.","refs":["CH_GB18_DUB0:FGS2","CH_GB18_BWDE:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RLE-02","text":"Die Schleife der schlechten Unendlichkeit lautet: Negation des Endlichen erzeugt ein Gegenüber, das Gegenüber begrenzt das Unendliche, und diese Begrenzung fordert erneute Negation.","refs":["CH_GB18_BWDE:AS1","CH_GB18_BWDE:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RLE-03","text":"Die Eskalation zur wahren Unendlichkeit beginnt dort, wo die Wiederkehr der Grenze nicht als Aufforderung zum Weitergehen, sondern als Beweis für die Endlichkeit des isolierten Unendlichen gelesen wird.","refs":["CH_GB18_CDU0:D5","CH_GB18_BWDE:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RLE-04","text":"Selbstbeziehung fungiert als begrifflicher Attraktor: Alle Übergänge konvergieren auf die Einsicht, dass das Andere jeder Bestimmung in ihrer eigenen Struktur bereits wirksam ist.","refs":["CH_GB18_DUB0:A5","CH_GB18_BWDE:A6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_11:FGS-B01","text":"Bestimmungslose Selbstbeziehung → Ausschluss unmittelbarer endlicher Formen → Erfordernis einer nicht-fixierten Bestimmung des Absoluten.","refs":["CH_GB18_CDU0:A1","CH_GB18_CDU0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FGS-B02","text":"Endlichkeit als Schranke → Selbstbeziehung auf die Schranke → immanenter Übergang über die eigene Begrenzung.","refs":["CH_GB18_DUB0:A3","CH_GB18_DUB0:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FGS-B03","text":"Äußerliche Negation des Endlichen → Gegenüberstellung von Endlichem und Unendlichem → Verendlichung des behauptet Unendlichen.","refs":["CH_GB18_CDU0:A5","CH_GB18_BWDE:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FGS-B04","text":"Verborgene Einheit bei behaupteter Selbständigkeit der Seiten → äußerliches Umschlagen → Wiederkehr der Grenze als unendlicher Progress.","refs":["CH_GB18_BWDE:A9","CH_GB18_BWDE:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FGS-B05","text":"Reflexion der wechselseitigen Abhängigkeit → Sichaufheben von Endlichem und abstraktem Unendlichen → Unendlichkeit als affirmative, nicht mehr äußerlich begrenzte Prozessform.","refs":["CH_GB18_CDU0:A8","CH_GB18_DUB0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_11:AFM-B01","text":"Bestimmungslose Absolutheit → Ausschluss endlicher Unmittelbarkeit → Suche nach einer Bestimmung ohne feste Gegenüberstellung.","refs":["CH_GB18_CDU0:AS1","CH_GB18_CDU0:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AFM-B02","text":"Schranke des Endlichen → immanentes Überschreiten → Negation der Negation als affirmative Unendlichkeit.","refs":["CH_GB18_DUB0:A4","CH_GB18_DUB0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AFM-B03","text":"Unmittelbares Unendliches → qualitative Opposition → Begrenzung des Unendlichen durch das von ihm gesetzte Endliche.","refs":["CH_GB18_BWDE:AS1","CH_GB18_BWDE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AFM-B04","text":"Wiederkehr der Grenze → unendlicher Progress und perennierendes Sollen → Diagnose der schlechten Unendlichkeit.","refs":["CH_GB18_BWDE:D6","CH_GB18_BWDE:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AFM-B05","text":"Aufhebung der isolierten Seiten → Wahrheit des Endlichen als Unendlichkeit → Entzug der Selbständigkeit des Endlichen im alleinigen Unendlichen.","refs":["CH_GB18_DUB0:D5","CH_GB18_DUB0:A13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_11:MME-01","text":"Die Karte von Diesseits und Jenseits wird durch eine Karte immanenter Wechselbestimmung ersetzt; das Jenseits ist Effekt einer bestimmten Negationsform, nicht eigener Bereich.","refs":["CH_GB18_BWDE:ME1","CH_GB18_BWDE:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MME-02","text":"Die Grenze wird von einem statischen Hindernis zur produktiven Form umkartiert, die sowohl Übergang als auch die Reproduktion der zu überwindenden Differenz organisiert.","refs":["CH_GB18_DUB0:ME3","CH_GB18_BWDE:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MME-03","text":"Fortschritt verliert seinen positiven Status, weil das reine Weitergehen als zyklische Installation derselben Struktur von Endlichkeit sichtbar wird.","refs":["CH_GB18_BWDE:SD1","CH_GB18_BWDE:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MME-04","text":"Vernunft wird vom subjektiven Ursprung zum Namen einer objektiven begrifflichen Bewegung verschoben, deren Notwendigkeit im Gegenstand selbst liegt.","refs":["CH_GB18_DUB0:ME4","CH_GB18_DUB0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MME-05","text":"Das Absolute wird nicht mehr als höchste isolierte Entität lesbar, sondern als Vollzug der Aufhebung jener Isolierungen, durch die Entitäten überhaupt als endlich erscheinen.","refs":["CH_GB18_CDU0:ME4","CH_GB18_CDU0:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_11:ALT-B01","text":"Auf der Oberflächenebene werden Endliches, Unendliches, Schranke, Jenseits und Fortschritt als explizite Gegenstände einer Bestimmung ihres Verhältnisses behandelt.","refs":["CH_GB18_DUB0:AS1","CH_GB18_BWDE:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:ALT-B02","text":"Auf der strukturellen Ebene organisiert die Selbstbeziehung der Grenze eine wechselseitige Produktion von Endlichem und Unendlichem.","refs":["CH_GB18_DUB0:ALT2","CH_GB18_BWDE:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:ALT-B03","text":"Auf der metastrategischen Ebene wird jede Lösung verworfen, die auf Absonderung, subjektivem Akt, äußerer Gewalt oder endlosem Fortschritt beruht.","refs":["CH_GB18_CDU0:ALT3","CH_GB18_BWDE:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:ALT-B04","text":"Auf der ontologisch-temporalen Ebene ist Sein Resultat selbstnegativer Bewegung, während endlose Zeit als Erscheinungsform begrifflicher Unversöhnung bestimmt wird.","refs":["CH_GB18_DUB0:ALT4","CH_GB18_BWDE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:ALT-B05","text":"Auf der methodologisch-performativen Ebene vollzieht die Argumentation ihre These, indem sie jede feste Bestimmung aus ihrer eigenen Gegenbestimmung und deren immanenter Instabilität ableitet.","refs":["CH_GB18_CDU0:SD4","CH_GB18_BWDE:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_11:FL-01","text":"Das Endliche ist zugleich notwendige Vermittlungsbedingung des Unendlichen und ein Moment, dessen selbständiges Sein im Resultat verschwinden soll; diese Doppelstellung wird nicht vollständig stillgestellt.","refs":["CH_GB18_DUB0:SD1","CH_GB18_DUB0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FL-02","text":"Die affirmative Wiederherstellung des Seins bleibt instabil, weil unmittelbare Affirmation erneut qualitative Bestimmtheit und damit die Form der Begrenzung erzeugen kann.","refs":["CH_GB18_DUB0:A2","CH_GB18_BWDE:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FL-03","text":"Die notwendige Einheit wird als Triebfeder des Übergangs behauptet, bleibt im unendlichen Progress jedoch verborgen; das Cluster benötigt diese Nichtmanifestation, um den Unterschied zwischen Wechsel und Aufhebung aufrechtzuerhalten.","refs":["CH_GB18_BWDE:A8","CH_GB18_BWDE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MP-01","text":"Negation mutiert vom ausschließenden Akt gegen das Endliche zur Selbstnegation einer einseitigen Opposition und erhält erst dadurch affirmative Funktion.","refs":["CH_GB18_CDU0:A4","CH_GB18_DUB0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MP-02","text":"Die Schranke mutiert von der Kennzeichnung endlichen Daseins zur immanenten Form seines Übergangs und damit zur Bedingung der Unendlichkeit.","refs":["CH_GB18_DUB0:A3","CH_GB18_DUB0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MP-03","text":"Das Unendliche mutiert vom unmittelbar affirmierten Gegenpol des Endlichen zur prozessualen Einheit, in der beide isolierten Seiten ihre Selbständigkeit verlieren.","refs":["CH_GB18_BWDE:A1","CH_GB18_CDU0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_11:HSI-01","text":"Die Wirklichkeit erscheint als Maschine produktiver Grenzen: Jede Bestimmung erzeugt durch ihre Begrenztheit den Übergang, der sie zugleich bewahrt, verändert und ihrer Selbständigkeit beraubt.","refs":["CH_GB18_BWDE:A7","CH_GB18_BWDE:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:HSI-02","text":"Das Subjekt erscheint nicht als souveräner Fluchtpunkt aus der Endlichkeit, sondern als möglicher Ort des Begreifens einer Bewegung, deren Ursache nicht im Subjekt liegt.","refs":["CH_GB18_DUB0:A8","CH_GB18_DUB0:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:HSI-03","text":"Zeit erscheint doppeldeutig: Als Progress konserviert sie den Widerspruch; als prozessuale Aufhebung markiert sie die Entmachtung der wiederkehrenden Grenze.","refs":["CH_GB18_BWDE:SD3","CH_GB18_CDU0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_11:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von endlicher Schranke über abstrakte Unendlichkeit und unendlichen Progress zur Forderung prozessualer Aufhebung zu rekonstruieren.","refs":["CH_GB18_CDU0:MRT1","CH_GB18_BWDE:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MRT-B02","text":"Unterbestimmt bleibt die positive Gestalt der Einheit, welche die Wechselbestimmung trägt, sowie der konkrete Vollzug, durch den die Selbstaufhebung mehr als geforderte Struktur wird.","refs":["CH_GB18_CDU0:MRT2","CH_GB18_BWDE:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MRT-B03","text":"Die Clusterarchitektur bleibt kohärent, wenn das Verschwinden des Endlichen als Verlust seiner Selbständigkeit verstanden wird und nicht als Tilgung seiner genetischen Vermittlungsfunktion.","refs":["CH_GB18_DUB0:MRT3","CH_GB18_DUB0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MRT-B04","text":"Die stärkste Rekonstruktionsachse liegt im Nachweis, dass jede isolierende Abstraktion das Ausgeschlossene als notwendige Gegenbestimmung konserviert und dadurch ihre eigene Endlichkeit produziert.","refs":["CH_GB18_CDU0:MRT4","CH_GB18_BWDE:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T120933318278Z_81e115e0","language_code":"en","language_name":"English","title":"Chapters 31–33","source_sha256":"8b369334eda8657c2305ba9c25b82452770026a8bc4f7a0ebd6b8f646626abb0","sha256":"54b18b4d4de6cc5777f3c9e78ee9d3f8f679d9a928d21fa15aeeeffd8d42a9bd","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:09:33.319356+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_11:AS-B01","text":"The cluster determines absoluteness not as a ready-made counter-region to finitude, but as a problem of self-relation that leads every isolated determination back into its own limit.","refs":["CH_GB18_CDU0:AS1","CH_GB18_CDU0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AS-B02","text":"Finitude does not function as material to be overcome externally, but as a structure of limitation whose self-relation generates its transition into the infinite.","refs":["CH_GB18_DUB0:A5","CH_GB18_BWDE:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AS-B03","text":"The first negation of the finite fails precisely through its gesture of exclusion: it posits the finite as its necessary other and thereby finitizes the claimed infinite.","refs":["CH_GB18_CDU0:A5","CH_GB18_BWDE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AS-B04","text":"Infinite progress constitutes the temporal appearance-form of a conceptually unprocessed unity, because every transcendence re-posits the structure of limit and opposition.","refs":["CH_GB18_BWDE:AS5","CH_GB18_BWDE:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AS-B05","text":"The movement concludes not with a new positive determination, but with the true infinite as the sublation of the self-subsistence of both sides, in which the finite remains genetically efficacious but no longer exists as result.","refs":["CH_GB18_CDU0:AS7","CH_GB18_DUB0:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_11:GA-01","text":"[Persistent] The Absolute cannot be determined through an immediate finite form of existence, because every such determinacy exists only as a limited moment within a more extensive self-relation.","refs":["CH_GB18_CDU0:AS2","CH_GB18_CDU0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-02","text":"[Persistent] The limit is not merely a limitation of a finished finite, but its self-relation and the immanent driving force of transition.","refs":["CH_GB18_DUB0:A5","CH_GB18_BWDE:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-03","text":"[Mutating] Negation becomes truly affirmative only when it does not persist in the exclusion of its other, but negates the one-sidedness of its own positing.","refs":["CH_GB18_DUB0:AS3","CH_GB18_CDU0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-04","text":"[Persistent] An infinite that stands opposed to the finite as a self-subsistent counter-determination is itself limited, because its identity depends upon precisely the other it excludes.","refs":["CH_GB18_CDU0:AS4","CH_GB18_BWDE:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-05","text":"[Emergent] The finite and the infinite do not form two ontologically separate regions, but a genetic unity whose moments mutually posit and limit one another.","refs":["CH_GB18_DUB0:SD1","CH_GB18_BWDE:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-06","text":"[Attractor] Self-relation is the concealed attractor of the entire movement: limit, negation, transition, and sublation are forms in which determinations are led back to their own non-self-subsistence.","refs":["CH_GB18_CDU0:AS1","CH_GB18_DUB0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-07","text":"[Mutating] The finite changes its status from excluded other, through necessary mediator, to sublated determination that is no longer self-subsistent.","refs":["CH_GB18_CDU0:A4","CH_GB18_DUB0:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-08","text":"[Persistent] Infinite progress is not the fulfillment of infinity, but the return of the same limit in the form of continued transcendence.","refs":["CH_GB18_BWDE:D6","CH_GB18_BWDE:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-09","text":"[Emergent] The true infinite arises as a process in which the isolated determinations of finite and infinite sublate their mutual dependence.","refs":["CH_GB18_CDU0:A8","CH_GB18_BWDE:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GA-10","text":"[Terminal] The concluding formula that only the infinite is does not designate an annihilation of mediation, but the withdrawal of self-subsistent being from the finite after completed sublation.","refs":["CH_GB18_DUB0:A13","CH_GB18_DUB0:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_11:RMD-01","text":"The limit initially recurs as finite limitation, but mutates into the self-relation of the finite and finally into the mechanism through which every fixed side passes over into its other.","refs":["CH_GB18_DUB0:A3","CH_GB18_BWDE:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RMD-02","text":"Negation recurs functionally, though not identically: as first negation it produces opposition; as negation of negation it produces affirmative infinity.","refs":["CH_GB18_CDU0:A4","CH_GB18_DUB0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RMD-03","text":"The infinite mutates from the abstract beyond, through a finite infinite, into the processual unity that itself annuls the form of the beyond.","refs":["CH_GB18_CDU0:A6","CH_GB18_DUB0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RMD-04","text":"The finite is initially needed as counterpole, then determined as immanent mediator, and at the end preserved only as the sublated condition of infinity.","refs":["CH_GB18_DUB0:D4","CH_GB18_DUB0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RMD-05","text":"Progress recurs as apparent infinity, but undergoes a reversal of valence: what appears as transcendence is classified as the reproduction of unsubated finitude.","refs":["CH_GB18_BWDE:AS5","CH_GB18_BWDE:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_11:CGD-01","text":"Seyn and Becoming remain local initial figures of indeterminacy; at the cluster level they bear only the more general demand that absoluteness cannot be immobilized in an immediate determination.","refs":["CH_GB18_CDU0:A2","CH_GB18_CDU0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:CGD-02","text":"The concrete determination of the limit as a property of the finite scales into the global rule that every apparently self-subsistent determination contains its own condition of transition.","refs":["CH_GB18_DUB0:A4","CH_GB18_BWDE:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:CGD-03","text":"The rejection of subjective reason and external force does not remain local, but becomes a cluster-wide relocation of explanation from external causes into immanent self-movement.","refs":["CH_GB18_DUB0:A8","CH_GB18_DUB0:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:CGD-04","text":"The perennial ought and infinite progress are not merely local defective forms, but the global diagnosis of every movement that effects transition without sublating the structure of opposition.","refs":["CH_GB18_BWDE:A11","CH_GB18_BWDE:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_11:GNX-01","text":"Excluded is a two-world model in which finite and infinite are distributed as independently existing ontological regions.","refs":["CH_GB18_CDU0:DNX3","CH_GB18_DUB0:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GNX-02","text":"Excluded is an infinity that could be attained through the mere exclusion of the finite or through spatial removal from it.","refs":["CH_GB18_CDU0:NX2","CH_GB18_BWDE:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GNX-03","text":"Excluded is every external instance that could bring forth transition, whether it be subjective reason, alien force, or transcendent beyond.","refs":["CH_GB18_DUB0:NX4","CH_GB18_DUB0:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:GNX-04","text":"Excluded is the assertion that endless continuation could resolve the contradiction that it produces anew at every step.","refs":["CH_GB18_BWDE:NX5","CH_GB18_BWDE:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_11:DBN-01","text":"The cluster can permit neither absolutely self-subsistent finitude nor absolutely self-subsistent infinity, because each side would be determined only through its other.","refs":["CH_GB18_BWDE:DNX1","CH_GB18_BWDE:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:DBN-02","text":"The cluster disqualifies every ontology in which limit signifies ultimate identity; a limit must contain transition and self-negation if it is not itself to become the absolute limit of thought.","refs":["CH_GB18_DUB0:SNX3","CH_GB18_BWDE:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:DBN-03","text":"The cluster cannot acknowledge any positive final determination outside its own sublation; every finished result would fall back anew into the one-sidedness it is meant to overcome.","refs":["CH_GB18_CDU0:SNX2","CH_GB18_BWDE:A4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_11:BSA-01","text":"Unavailable is an external standpoint from which finitude could be left behind or infinity seized as an already finished possession.","refs":["CH_GB18_DUB0:SNX2","CH_GB18_DUB0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSA-02","text":"Impossible is an ultimate positive ground that had not passed through the sublation of its own isolated determinacy.","refs":["CH_GB18_CDU0:SNX3","CH_GB18_CDU0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSA-03","text":"Impermissible is a temporal form of mere “And so forth,” because it organizes the future as repetition of the same limit rather than as the enactment of its conceptual sublation.","refs":["CH_GB18_BWDE:SNX3","CH_GB18_BWDE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_11:XD-01","text":"The transition into the infinite is neither flight from a limit nor access to an external beyond, but the self-unfolding of a limit that proves to be its own negativity.","refs":["CL_GB18_11:GA-02","CL_GB18_11:GA-06","CH_GB18_DUB0:A5","CH_GB18_BWDE:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_11:XD-02","text":"Infinite progress arises when the necessary unity of the moments is effective only factually, but is not comprehended as unity; time then replaces the outstanding conceptual mediation.","refs":["CL_GB18_11:GA-05","CL_GB18_11:GA-08","CH_GB18_BWDE:AS4","CH_GB18_BWDE:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_11:XD-03","text":"The terminal formula of the sole infinite can hold only if the disappearance of the finite is understood as the sublation of its self-subsistence and not as the erasure of its mediating function.","refs":["CL_GB18_11:GA-07","CL_GB18_11:GA-10","CH_GB18_DUB0:A12","CH_GB18_DUB0:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_11:XD-04","text":"The critique of external elevation and the critique of endless progress jointly form a theory of immanent necessity: neither subject nor future can accomplish what only the self-sublation of determinations can accomplish.","refs":["CL_GB18_11:GA-03","CL_GB18_11:GA-08","CH_GB18_DUB0:D7","CH_GB18_BWDE:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_11:XD-05","text":"The true infinite is not the final member of a series of progress, but the transformation of the rule through which every member is generated at all as a limited opposite.","refs":["CL_GB18_11:GA-08","CL_GB18_11:GA-09","CH_GB18_CDU0:AS7","CH_GB18_BWDE:A10"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_11:BSD-01","text":"Reality appears as an immanent machine of self-limitation, in which every fixed identity is set in motion through its own relation to an other.","refs":["CH_GB18_BWDE:A6","CH_GB18_BWDE:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSD-02","text":"Temporal infinity is reinterpreted as a symptom of an unreflected conceptual structure; duration is here not the depth of infinity, but the persistence of unresolved opposition.","refs":["CH_GB18_BWDE:SD3","CH_GB18_BWDE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSD-03","text":"The subject loses the status of a generative origin and becomes at most an instance of conceptual retracing of a movement anchored in the object itself.","refs":["CH_GB18_DUB0:A8","CH_GB18_DUB0:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSD-04","text":"Truth is not enduring self-identity, but affirmative self-sublation: a determination is true insofar as it demonstrates its own one-sidedness as a moment of a more comprehensive movement.","refs":["CH_GB18_DUB0:SD3","CH_GB18_DUB0:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:BSD-05","text":"Methodologically, the cluster demands immanent critique: not external refutation, but the reconstruction of a determination's self-limitation generates its transition.","refs":["CH_GB18_CDU0:SD1","CH_GB18_BWDE:A2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_11:RLE-01","text":"The central loop runs: limit generates transcendence, transcendence posits a new limit, the new limit reproduces the need for transcendence.","refs":["CH_GB18_DUB0:FGS2","CH_GB18_BWDE:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RLE-02","text":"The loop of bad infinity runs: negation of the finite generates an opposite, the opposite limits the infinite, and this limitation demands renewed negation.","refs":["CH_GB18_BWDE:AS1","CH_GB18_BWDE:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RLE-03","text":"The escalation to true infinity begins where the return of the limit is read not as an invitation to continue, but as proof of the finitude of the isolated infinite.","refs":["CH_GB18_CDU0:D5","CH_GB18_BWDE:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:RLE-04","text":"Self-relation functions as a conceptual attractor: all transitions converge upon the insight that the other of every determination is already effective within its own structure.","refs":["CH_GB18_DUB0:A5","CH_GB18_BWDE:A6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_11:FGS-B01","text":"Indeterminate self-relation → exclusion of immediate finite forms → requirement of a non-fixed determination of the Absolute.","refs":["CH_GB18_CDU0:A1","CH_GB18_CDU0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FGS-B02","text":"Finitude as limit → self-relation to the limit → immanent transition beyond its own limitation.","refs":["CH_GB18_DUB0:A3","CH_GB18_DUB0:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FGS-B03","text":"External negation of the finite → opposition of finite and infinite → finitization of the asserted infinite.","refs":["CH_GB18_CDU0:A5","CH_GB18_BWDE:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FGS-B04","text":"Hidden unity amid asserted self-subsistence of the sides → external reversal → return of the limit as infinite progress.","refs":["CH_GB18_BWDE:A9","CH_GB18_BWDE:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FGS-B05","text":"Reflection of mutual dependence → self-sublation of finite and abstract infinite → infinity as an affirmative process-form no longer externally limited.","refs":["CH_GB18_CDU0:A8","CH_GB18_DUB0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_11:AFM-B01","text":"Indeterminate absoluteness → exclusion of finite immediacy → search for a determination without fixed opposition.","refs":["CH_GB18_CDU0:AS1","CH_GB18_CDU0:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AFM-B02","text":"Limit of the finite → immanent transcendence → negation of negation as affirmative infinity.","refs":["CH_GB18_DUB0:A4","CH_GB18_DUB0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AFM-B03","text":"Immediate infinite → qualitative opposition → limitation of the infinite by the finite posited by it.","refs":["CH_GB18_BWDE:AS1","CH_GB18_BWDE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AFM-B04","text":"Return of the limit → infinite progress and perennial ought → diagnosis of bad infinity.","refs":["CH_GB18_BWDE:D6","CH_GB18_BWDE:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:AFM-B05","text":"Sublation of the isolated sides → truth of the finite as infinity → withdrawal of the self-subsistence of the finite in the sole infinite.","refs":["CH_GB18_DUB0:D5","CH_GB18_DUB0:A13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_11:MME-01","text":"The map of here and beyond is replaced by a map of immanent reciprocal determination; the beyond is the effect of a determinate form of negation, not a domain of its own.","refs":["CH_GB18_BWDE:ME1","CH_GB18_BWDE:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MME-02","text":"The limit is remapped from a static obstacle into a productive form that organizes both transition and the reproduction of the difference to be overcome.","refs":["CH_GB18_DUB0:ME3","CH_GB18_BWDE:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MME-03","text":"Progress loses its positive status because mere continuation becomes visible as a cyclical installation of the same structure of finitude.","refs":["CH_GB18_BWDE:SD1","CH_GB18_BWDE:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MME-04","text":"Reason is shifted from subjective origin to the name of an objective conceptual movement whose necessity lies in the object itself.","refs":["CH_GB18_DUB0:ME4","CH_GB18_DUB0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MME-05","text":"The Absolute is no longer legible as the highest isolated entity, but as the enactment of the sublation of those isolations through which entities appear as finite at all.","refs":["CH_GB18_CDU0:ME4","CH_GB18_CDU0:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_11:ALT-B01","text":"At the surface level, finite, infinite, limit, beyond, and progress are treated as explicit objects of a determination of their relation.","refs":["CH_GB18_DUB0:AS1","CH_GB18_BWDE:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:ALT-B02","text":"At the structural level, the self-relation of the limit organizes a mutual production of finite and infinite.","refs":["CH_GB18_DUB0:ALT2","CH_GB18_BWDE:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:ALT-B03","text":"At the metastrategic level, every solution based on separation, subjective act, external force, or endless progress is rejected.","refs":["CH_GB18_CDU0:ALT3","CH_GB18_BWDE:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:ALT-B04","text":"At the ontological-temporal level, being is the result of self-negative movement, while endless time is determined as the appearance-form of conceptual unreconciledness.","refs":["CH_GB18_DUB0:ALT4","CH_GB18_BWDE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:ALT-B05","text":"At the methodological-performative level, the argumentation enacts its thesis by deriving every fixed determination from its own counter-determination and the latter's immanent instability.","refs":["CH_GB18_CDU0:SD4","CH_GB18_BWDE:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_11:FL-01","text":"The finite is at once a necessary condition of mediation for the infinite and a moment whose self-subsistent being is meant to disappear in the result; this double position is not fully immobilized.","refs":["CH_GB18_DUB0:SD1","CH_GB18_DUB0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FL-02","text":"The affirmative restoration of being remains unstable because immediate affirmation can once again generate qualitative determinacy and thus the form of limitation.","refs":["CH_GB18_DUB0:A2","CH_GB18_BWDE:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:FL-03","text":"Necessary unity is asserted as the driving force of transition, yet remains concealed in infinite progress; the cluster requires this non-manifestation in order to maintain the distinction between alternation and sublation.","refs":["CH_GB18_BWDE:A8","CH_GB18_BWDE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MP-01","text":"Negation mutates from the excluding act against the finite into the self-negation of a one-sided opposition and thereby first acquires affirmative function.","refs":["CH_GB18_CDU0:A4","CH_GB18_DUB0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MP-02","text":"The limit mutates from the marking of finite existence into the immanent form of its transition and thus into the condition of infinity.","refs":["CH_GB18_DUB0:A3","CH_GB18_DUB0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MP-03","text":"The infinite mutates from the immediately affirmed counterpole of the finite into the processual unity in which both isolated sides lose their self-subsistence.","refs":["CH_GB18_BWDE:A1","CH_GB18_CDU0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_11:HSI-01","text":"Reality appears as a machine of productive limits: through its limitedness, every determination generates the transition that simultaneously preserves it, transforms it, and deprives it of its self-subsistence.","refs":["CH_GB18_BWDE:A7","CH_GB18_BWDE:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:HSI-02","text":"The subject appears not as a sovereign vanishing-point out of finitude, but as a possible site of comprehending a movement whose cause does not lie in the subject.","refs":["CH_GB18_DUB0:A8","CH_GB18_DUB0:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:HSI-03","text":"Time appears ambiguous: as progress it conserves contradiction; as processual sublation it marks the disempowerment of the recurring limit.","refs":["CH_GB18_BWDE:SD3","CH_GB18_CDU0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_11:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from finite limit through abstract infinity and infinite progress to the demand for processual sublation.","refs":["CH_GB18_CDU0:MRT1","CH_GB18_BWDE:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MRT-B02","text":"Underdetermined remain the positive shape of the unity that bears reciprocal determination, as well as the concrete enactment through which self-sublation becomes more than a demanded structure.","refs":["CH_GB18_CDU0:MRT2","CH_GB18_BWDE:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MRT-B03","text":"The cluster architecture remains coherent if the disappearance of the finite is understood as the loss of its self-subsistence and not as the obliteration of its genetic mediating function.","refs":["CH_GB18_DUB0:MRT3","CH_GB18_DUB0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_11:MRT-B04","text":"The strongest axis of reconstruction lies in demonstrating that every isolating abstraction preserves the excluded as a necessary counter-determination and thereby produces its own finitude.","refs":["CH_GB18_CDU0:MRT4","CH_GB18_BWDE:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_11@R001","source_variant_id":"canonical:CL_GB18_11:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 31–33","context":"C. Die Unendlichkeit. · a. Das Unendliche überhaupt. · b. Wechselbestimmung des Endlichen und Unendlichen."},"title_language_code":"en"},{"id":"CL_GB18_12","layer":"CL","title":"Chapters 34–36","order":12,"parents":["CH_GB18_CDAU","CH_GB18_DERB","CH_GB18_AN_4"],"revision":"CL_GB18_12@R001","sha256":"ff22484ca747baa3f77e0f8d341d436fbfe0096a44e3ca903f600c4df1586737","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_12:AS-B01","text":"Das zentrale Problem ist die Selbstverfehlung eines Unendlichen, das sich als äußeres Jenseits setzt und dadurch von eben jener Endlichkeit abhängig wird, die es ausschließen soll.","refs":["CH_GB18_AN_4:AS1","CH_GB18_CDAU:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B02","text":"Die Rekonstruktion ersetzt die Opposition von Endlichem und Unendlichem durch eine immanente Vermittlung, in der jedes Moment sein Anderes als eigene Bestimmung enthält.","refs":["CH_GB18_CDAU:A3","CH_GB18_AN_4:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B03","text":"Der unendliche Progress wird nicht als Wahrheit der Unendlichkeit behandelt, sondern als notwendige, aber unbegriffene Wiederholung der Trennung und Einheit derselben Bestimmungen.","refs":["CH_GB18_CDAU:SD3","CH_GB18_AN_4:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B04","text":"Die Bewegung ist rekursiv und spiralförmig: äußere Negation erzeugt Gegenüberstellung, Gegenüberstellung enthüllt wechselseitige Immanenz, und deren Aufhebung erzeugt affirmative Selbstbeziehung.","refs":["CH_GB18_CDAU:AS5","CH_GB18_AN_4:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B05","text":"Die Einheit bleibt nicht bei einer logischen Versöhnung stehen, sondern mutiert zur ontologischen Erzeugung von Seyn, Daseyn und Fürsichseyn als Stufen gesteigerter Selbstbezüglichkeit.","refs":["CH_GB18_DERB:AS5","CH_GB18_DERB:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B06","text":"Die Kritik richtet sich nicht nur gegen falsche Antworten, sondern gegen Fragen, deren Form bereits getrennte Selbstständigkeiten und lineare Übergänge voraussetzt.","refs":["CH_GB18_AN_4:AS5","CH_GB18_AN_4:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B07","text":"Die Schließung des Systems besteht nicht in der Stillstellung der Bewegung, sondern in ihrer Rückkehr zu einer Einheit, die Unterschied und Negation als ihre ideellen Momente trägt.","refs":["CH_GB18_CDAU:A9","CH_GB18_AN_4:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B08","text":"Das Cluster erzeugt eine affirmative Ontologie, in der Realität weder dem isolierten Endlichen noch einem transzendenten Unendlichen zukommt, sondern dem sich selbst vermittelnden Ganzen.","refs":["CH_GB18_CDAU:AS7","CH_GB18_CDAU:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_12:GA-01","text":"[Persistent] Endliches und Unendliches besitzen keine unabhängige Identität, weil jede Bestimmung ihr Anderes als immanentes Moment enthält.","refs":["CH_GB18_CDAU:A3","CH_GB18_AN_4:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-02","text":"[Persistent] Die abstrakte Trennung von Endlichem und Unendlichem erzeugt notwendig ein schlechtes Unendliches, weil das gesetzte Jenseits durch sein Gegenüber begrenzt bleibt.","refs":["CH_GB18_CDAU:A4","CH_GB18_AN_4:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-03","text":"[Mutating] Negation ist nicht Verlust, sondern die Operation, durch welche isolierte Bestimmungen in ihre vermittelte Selbstbeziehung zurückkehren.","refs":["CH_GB18_CDAU:A7","CH_GB18_DERB:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-04","text":"[Emergent] Der unendliche Progress ist die formale Selbstreproduktion eines Verhältnisses, dessen Einheit und Unterschied fortwährend gesetzt, aber nicht begriffen werden.","refs":["CH_GB18_CDAU:A8","CH_GB18_AN_4:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-05","text":"[Mutating] Idealität bezeichnet nicht die Entwirklichung von Bestimmtheit, sondern deren Status als unterschiedenes, jedoch nicht selbstständiges Moment einer Einheit.","refs":["CH_GB18_CDAU:A12","CH_GB18_AN_4:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-06","text":"[Emergent] Werden erhält seine bestimmte Gestalt als Übergang, in dem Endlichkeit und negative Unendlichkeit zugleich aufgehoben werden.","refs":["CH_GB18_DERB:A2","CH_GB18_DERB:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-07","text":"[Terminal] Seyn wird nur als negationshaltiges Daseyn bestimmt, und Daseyn wird erst durch die Selbstbeziehung der Negation zum Fürsichseyn.","refs":["CH_GB18_DERB:A8","CH_GB18_DERB:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-08","text":"[Attractor] Affirmation entsteht allein als Rückkehr der Negation aus ihrer eigenen Einseitigkeit und nicht als vorgängige, bewegungslose Positivität.","refs":["CH_GB18_CDAU:D6","CH_GB18_AN_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-09","text":"[Attractor] Philosophische Kritik muss die Voraussetzungen einer Frage negieren, wenn diese Voraussetzungen die zu untersuchende Trennung bereits als gültig einsetzen.","refs":["CH_GB18_AN_4:A10","CH_GB18_AN_4:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_12:RMD-01","text":"Das Unendliche kehrt zunächst als abstraktes Jenseits wieder, mutiert dann zur immanenten Selbstvermittlung und endet als affirmative Gegenwart des sich auf sich beziehenden Werdens.","refs":["CH_GB18_CDAU:AS2","CH_GB18_CDAU:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RMD-02","text":"Der Progress bleibt funktional erhalten, doch seine Valenz kehrt sich um: Was als Flucht in Unendlichkeit erscheint, wird zum Symptom einer verdeckten Selbstschließung.","refs":["CH_GB18_CDAU:D2","CH_GB18_AN_4:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RMD-03","text":"Idealität verschiebt sich von der Bestimmung des Endlichen als nicht selbstständig zu einem Prozess, der die ontologische Gestalt des Daseyns hervorbringt.","refs":["CH_GB18_CDAU:A12","CH_GB18_DERB:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RMD-04","text":"Negation mutiert von der Bestimmung des Endlichen als Nichtigkeit zu einer generativen Operation, welche Selbstbeziehung, Daseyn und Fürsichseyn produziert.","refs":["CH_GB18_CDAU:A2","CH_GB18_DERB:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RMD-05","text":"Der Übergang verliert den Status eines zeitlichen oder räumlichen Vorgangs und wird als innere Selbstbewegung der aufgehobenen Gegensätze bestimmt.","refs":["CH_GB18_DERB:SNX4","CH_GB18_AN_4:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_12:CGD-01","text":"Die Bestimmung einzelner Kategorien als Seyn, Daseyn und Fürsichseyn gehört der unmittelbaren Ableitungssequenz an; auf Clusterebene trägt allein ihre gemeinsame Logik zunehmender Selbstbeziehung.","refs":["CH_GB18_DERB:SD3","CH_GB18_DERB:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:CGD-02","text":"Die Ursache-Wirkung-Relation bleibt ein lokales Exempel, wird aber auf Clusterebene als Beleg dafür absorbiert, dass Gegensätze nur innerhalb eines Verhältnisses bestimmt sind.","refs":["CH_GB18_AN_4:A6","CH_GB18_AN_4:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:CGD-03","text":"Die Polemik gegen das schlechte Unendliche ist lokal, doch ihre höhere Funktion besteht darin, jede Ontologie äußerlich begrenzter Selbstständigkeiten zu disqualifizieren.","refs":["CH_GB18_CDAU:D1","CH_GB18_DERB:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:CGD-04","text":"Die Gegenüberstellung von Verstand und spekulativem Denken wird auf Clusterebene zur methodischen Unterscheidung zwischen fixierender Analyse und immanenter Rekonstruktion.","refs":["CH_GB18_CDAU:ALT3","CH_GB18_AN_4:AS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_12:GNX-01","text":"Ausgeschlossen ist eine Ontologie, in der Bestimmungen ihre Identität durch feste äußere Grenzen und voneinander unabhängige Selbstständigkeit erhalten.","refs":["CH_GB18_CDAU:DNX1","CH_GB18_AN_4:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GNX-02","text":"Ausgeschlossen ist ein Unendliches, das durch bloße Entfernung vom Endlichen wahrer würde oder als unerreichbares Jenseits bestehen könnte.","refs":["CH_GB18_CDAU:DNX3","CH_GB18_AN_4:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GNX-03","text":"Ausgeschlossen ist eine Negation, die ausschließlich Verlust, Vernichtung oder einmalige Aufhebung bedeutet und keine affirmative Rückkehr zulässt.","refs":["CH_GB18_CDAU:DNX2","CH_GB18_DERB:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GNX-04","text":"Ausgeschlossen ist eine voraussetzungsneutrale Frageform, weil Fragen selbst ontologische Trennungen setzen und daher der Kritik unterliegen.","refs":["CH_GB18_AN_4:NX7","CH_GB18_AN_4:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_12:DBN-01","text":"Damit das System Bestand hat, muss falsch sein, dass Gegensätze zunächst vollständig getrennt existieren und erst nachträglich vermittelt werden.","refs":["CH_GB18_AN_4:DNX1","CH_GB18_CDAU:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:DBN-02","text":"Damit Daseyn als Resultat bestimmt werden kann, muss ein unmittelbares, negationsloses Seyn ausgeschlossen bleiben.","refs":["CH_GB18_DERB:NX4","CH_GB18_DERB:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:DBN-03","text":"Damit der Übergang immanent sein kann, muss jeder äußere Mechanismus verworfen werden, der zwischen vorher selbstständigen Bestimmungen vermitteln würde.","refs":["CH_GB18_DERB:SNX4","CH_GB18_AN_4:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_12:BSA-01","text":"Unverfügbar ist ein absolut äußerer Standpunkt, von dem Endliches und Unendliches als fertige Gegenstände verglichen werden könnten.","refs":["CH_GB18_AN_4:SNX1","CH_GB18_CDAU:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:BSA-02","text":"Unmöglich ist eine letzte Identität, die gegen Vermittlung, Negation und innere Differenz immun wäre.","refs":["CH_GB18_CDAU:SNX2","CH_GB18_AN_4:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:BSA-03","text":"Nicht verfügbar ist ein reines Anfangs- oder Endmoment, das der Bewegung vorausläge oder ihr als transzendenter Abschluss entzogen werden könnte.","refs":["CH_GB18_CDAU:DNX5","CH_GB18_AN_4:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_12:XD-01","text":"Der unendliche Progress ist weder bloßer Irrtum noch bloße Wahrheit, sondern die notwendige Erscheinungsform einer Einheit, die sich zunächst als Alternation von Trennung und Wiederkehr verkennt.","refs":["CL_GB18_12:GA-01","CL_GB18_12:GA-04","CH_GB18_CDAU:SD3","CH_GB18_AN_4:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:XD-02","text":"Affirmative Unendlichkeit erhält erst dann ontologische Bestimmtheit, wenn ihre Selbstvermittlung nicht bei Einheit verbleibt, sondern in negationshaltiges Daseyn übergeht.","refs":["CL_GB18_12:GA-06","CL_GB18_12:GA-08","CH_GB18_CDAU:FGS6","CH_GB18_DERB:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:XD-03","text":"Die Negation der Übergangsfrage ist selbst keine Verweigerung der Bewegung, sondern die methodische Bedingung, den Übergang als immanente Selbstbestimmung statt als äußeren Transport zu begreifen.","refs":["CL_GB18_12:GA-06","CL_GB18_12:GA-09","CH_GB18_AN_4:AS5","CH_GB18_DERB:MRT6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:XD-04","text":"Die Idealität der Gegensätze bildet das Scharnier zwischen der Kritik des schlechten Unendlichen und der Erzeugung von Fürsichseyn, weil sie Unterschied ohne Selbstständigkeit bewahrt.","refs":["CL_GB18_12:GA-05","CL_GB18_12:GA-07","CH_GB18_AN_4:A7","CH_GB18_DERB:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:XD-05","text":"Die Kritik linearer Kausalität und die Kritik des unendlichen Progresses konvergieren in einer relationalen Ontologie, in der Reihen nur die wiederholte Abstraktion einer bereits wirksamen Einheit darstellen.","refs":["CL_GB18_12:GA-01","CL_GB18_12:GA-04","CH_GB18_AN_4:D2","CH_GB18_AN_4:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_12:BSD-01","text":"Realität wird als Selbstdifferenzierung bestimmt: Sie ist nur wirklich, insofern sie ihre Endlichkeit hervorbringt, aufhebt und als ideelles Moment in sich zurücknimmt.","refs":["CL_GB18_12:GA-03","CL_GB18_12:GA-05","CL_GB18_12:GA-08","CH_GB18_CDAU:D7","CH_GB18_DERB:AS3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:BSD-02","text":"Zeitliche Herkunftserzählungen verlieren ihre ontologische Kraft, weil Endlichkeit und Unendlichkeit weder zuerst noch nachträglich bestehen, sondern in einer ewigen Selbstvermittlung koexistieren.","refs":["CL_GB18_12:GA-01","CL_GB18_12:GA-06","CH_GB18_AN_4:D7","CH_GB18_AN_4:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:BSD-03","text":"Erkenntnis wird zur Rekonstruktion der Bedingungen, unter denen ein Gegensatz, eine Frage oder eine Reihe überhaupt als selbstständig erscheinen kann.","refs":["CL_GB18_12:GA-02","CL_GB18_12:GA-09","CH_GB18_AN_4:SD4","CH_GB18_AN_4:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:BSD-04","text":"Das Subjekt wird nicht als äußerer Beobachter der Bewegung impliziert, sondern als Vollzug eines Begreifens, das die Untrennbarkeit sich negierender Bestimmungen erfasst.","refs":["CL_GB18_12:GA-01","CL_GB18_12:GA-09","CH_GB18_AN_4:A9","CH_GB18_AN_4:AS4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_12:RLE-01","text":"Die Grundschleife lautet: abstrakte Trennung erzeugt wechselseitige Implikation; deren einseitige Setzung erzeugt erneute Trennung; die Wiederholung enthüllt den Progress als Selbstwiderspruch.","refs":["CH_GB18_AN_4:A3","CH_GB18_AN_4:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RLE-02","text":"Der Progress fungiert als Attraktor der Fehlform, weil jede Flucht über eine Grenze die Grenze als eigenes Moment erneut hervorbringt.","refs":["CH_GB18_CDAU:D3","CH_GB18_AN_4:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RLE-03","text":"Die Negation der Negation bildet die produktive Schleife, in der Negativität nicht verschwindet, sondern in affirmierte Selbstbeziehung umgeschlagen wird.","refs":["CH_GB18_CDAU:AS5","CH_GB18_AN_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RLE-04","text":"Der Übergang markiert einen Eskalationspunkt: Die Analyse des Unendlichen wird zur Ontologie des Daseyns und endet in der Kategorie des Fürsichseyns.","refs":["CH_GB18_DERB:AS2","CH_GB18_DERB:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_12:FGS-B01","text":"Abstrakte Gegenüberstellung von Endlichem und Unendlichem erzeugt ein Jenseits, das durch sein Gegenüber selbst endlich wird.","refs":["CH_GB18_CDAU:FGS1","CH_GB18_AN_4:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FGS-B02","text":"Die wechselseitige Begrenzung enthüllt, dass jede Bestimmung ihr Anderes als eigenes Moment enthält und daher nicht selbstständig sein kann.","refs":["CH_GB18_CDAU:FGS3","CH_GB18_AN_4:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FGS-B03","text":"Die einseitige Fixierung von Einheit oder Unterschied reproduziert den unendlichen Progress als abstrakte Alternation.","refs":["CH_GB18_AN_4:FGS3","CH_GB18_AN_4:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FGS-B04","text":"Die Diagnose der Alternation hebt nicht den Unterschied auf, sondern bestimmt ihn als ideelle Differenz innerhalb einer sich selbst vermittelnden Einheit.","refs":["CH_GB18_AN_4:FGS5","CH_GB18_AN_4:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FGS-B05","text":"Die ideelle Einheit vollzieht sich als Aufhebung von Endlichkeit und negativer Unendlichkeit, deren Resultat Rückkehr in sich ist.","refs":["CH_GB18_DERB:FGS2","CH_GB18_DERB:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FGS-B06","text":"Rückkehr in sich bestimmt Seyn als negationshaltiges Daseyn und führt durch Selbstbeziehung der Negation zum Fürsichseyn.","refs":["CH_GB18_DERB:FGS4","CH_GB18_DERB:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_12:AFM-B01","text":"Schlechtes Unendliches → äußere Gegenüberstellung von Endlichem und Unendlichem.","refs":["CH_GB18_CDAU:AF1","CH_GB18_AN_4:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AFM-B02","text":"Äußere Gegenüberstellung → wechselseitige Begrenzung und Enthüllung der immanenten Andersheit.","refs":["CH_GB18_CDAU:AF2","CH_GB18_AN_4:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AFM-B03","text":"Wechselseitige Andersheit → Alternation von Einheit und Trennung als unendlicher Progress.","refs":["CH_GB18_CDAU:AF3","CH_GB18_AN_4:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AFM-B04","text":"Diagnose der Alternation → Idealität der unterschiedenen Momente und Negation ihrer Selbstständigkeit.","refs":["CH_GB18_AN_4:AF4","CH_GB18_AN_4:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AFM-B05","text":"Idealität → Rückkehr in sich und affirmative Negation der Negation.","refs":["CH_GB18_CDAU:AF5","CH_GB18_AN_4:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AFM-B06","text":"Affirmative Rückkehr → Daseyn → Fürsichseyn als ontologische Verdichtung der Selbstbeziehung.","refs":["CH_GB18_CDAU:AF6","CH_GB18_DERB:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_12:MME-01","text":"Endlichkeit und Unendlichkeit werden von getrennten Seinsregionen zu korrelativen Momenten eines einzigen Vermittlungsprozesses umklassifiziert.","refs":["CH_GB18_CDAU:ME1","CH_GB18_DERB:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MME-02","text":"Negation wird von einer destruktiven Operation zur produktiven Quelle von Affirmation, Bestimmtheit und Selbstbeziehung transformiert.","refs":["CH_GB18_CDAU:ME3","CH_GB18_DERB:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MME-03","text":"Das Jenseits verliert seinen Rang als höhere Realität und erscheint als Symptom einer noch nicht vollzogenen Rückkehr der Negation zu sich.","refs":["CH_GB18_CDAU:ME4","CH_GB18_CDAU:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MME-04","text":"Philosophische Fragen werden zu kartierbaren Trägern ontologischer Voraussetzungen, wodurch Kritik zur Analyse der Frageform selbst wird.","refs":["CH_GB18_AN_4:ME4","CH_GB18_AN_4:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_12:ALT-B01","text":"Surface level — Das Cluster rekonstruiert das Verhältnis von Endlichkeit, Unendlichkeit, Grenze, Progress, Idealität, Seyn, Daseyn und Fürsichseyn.","refs":["CH_GB18_CDAU:ALT1","CH_GB18_DERB:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:ALT-B02","text":"Structural level — Jede Bestimmung entsteht durch immanente Negation, Vermittlung mit ihrem Anderen und Rückkehr als selbstbezogene Bestimmtheit.","refs":["CH_GB18_CDAU:ALT2","CH_GB18_DERB:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:ALT-B03","text":"Metastrategic level — Das Argument ersetzt äußerliche Vergleichung und lineare Erklärung durch die immanente Rekonstruktion der Bedingungen, welche die Gegensätze erzeugen.","refs":["CH_GB18_DERB:ALT3","CH_GB18_AN_4:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:ALT-B04","text":"Ontological / Temporal level — Realität besitzt die Form gegenwärtiger Selbstvermittlung und keine zeitlich geordnete Herkunftsstruktur aus zuerst getrennten Entitäten.","refs":["CH_GB18_CDAU:ALT4","CH_GB18_AN_4:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:ALT-B05","text":"Methodological / Performative level — Das Verfahren vollzieht seine These performativ, indem es jede behauptete Selbstständigkeit nur durch deren immanente Aufhebung bestimmt.","refs":["CH_GB18_CDAU:AS3","CH_GB18_AN_4:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_12:FL-01","text":"Die affirmative Kraft der Negation der Negation bleibt methodisch spannungsvoll, weil ihre Notwendigkeit behauptet wird, ohne vollständig von einer bloßen Umbenennung des Resultats getrennt zu werden.","refs":["CH_GB18_AN_4:MRT3","CH_GB18_CDAU:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FL-02","text":"Die Bestimmung des wahrhaft Unendlichen oszilliert zwischen gegenwärtigem affirmativem Dasein und fortdauerndem Werden, ohne die Differenz beider Register endgültig zu schließen.","refs":["CH_GB18_CDAU:MRT6","CH_GB18_CDAU:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FL-03","text":"Die Übergangsfrage wird als unwahr negiert, während ihr Inhalt zugleich als notwendige Selbstbewegung des Unendlichen zurückkehrt.","refs":["CH_GB18_AN_4:MRT6","CH_GB18_AN_4:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MP-01","text":"Das Unendliche mutiert vom abstrakten Jenseits zur immanenten Realität eines Prozesses, der seine Endlichkeit nicht ausschließt, sondern ideell enthält.","refs":["CH_GB18_CDAU:NX1","CH_GB18_CDAU:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MP-02","text":"Idealität mutiert von einer Qualität der Unendlichkeit zur Vermittlungsform, durch welche aufgehobene Gegensätze Daseyn erzeugen.","refs":["CH_GB18_DERB:A1","CH_GB18_DERB:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MP-03","text":"Übergang mutiert von einer scheinbar äußeren Relation zu einer inneren Operation, die aus der Negativität der Bestimmungen selbst hervorgeht.","refs":["CH_GB18_DERB:A3","CH_GB18_DERB:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_12:HSI-01","text":"Die Realität erscheint als Maschine rekursiver Selbstvermittlung, die ihre Unterschiede erzeugt, negiert und als ideelle Momente ihrer eigenen Einheit zurücknimmt.","refs":["CH_GB18_CDAU:FGS5","CH_GB18_AN_4:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:HSI-02","text":"Das Subjekt erscheint als Vollzug des Begreifens, das nicht außerhalb der Gegensätze steht, sondern ihre Untrennbarkeit im Denken realisiert.","refs":["CH_GB18_AN_4:AS4","CH_GB18_AN_4:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:HSI-03","text":"Zeit erscheint nicht als lineare Folge von Ursprung, Übergang und Ende, sondern als Gegenwart einer Bewegung, die ihre eigene Voraussetzung beständig nachträglich erzeugt.","refs":["CH_GB18_CDAU:ALT4","CH_GB18_AN_4:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:HSI-04","text":"Möglicher Kampf besteht in der Aufhebung fixierter Grenzen, falscher Jenseitsmodelle und voraussetzungsbeladener Fragen durch Rekonstruktion ihrer immanenten Bedingungen.","refs":["CH_GB18_CDAU:DNX1","CH_GB18_AN_4:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_12:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von abstrakter Trennung über Progress, Idealität und affirmative Negation bis zu Daseyn und Fürsichseyn zu rekonstruieren.","refs":["CH_GB18_CDAU:MRT1","CH_GB18_DERB:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MRT-B02","text":"Unterbestimmt bleibt die formale Notwendigkeit, mit der Wiederkehr im Progress als immanente Einheit und die Negation der Negation als Affirmation gesichert werden.","refs":["CH_GB18_CDAU:MRT2","CH_GB18_DERB:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MRT-B03","text":"Die Architektur ist am stärksten dort, wo sie äußere Gegenüberstellung, lineare Herkunft und statische Identität zugleich in eine rekursive Selbstvermittlungslogik überführt.","refs":["CH_GB18_CDAU:MRT4","CH_GB18_DERB:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MRT-B04","text":"Die Rekonstruktion bleibt nur dann adäquat, wenn Einheit nicht als Endzustand, sondern als fortgesetzte Aufhebung der Trennung und als Selbstbeziehung der Negation gelesen wird.","refs":["CH_GB18_CDAU:MRT7","CH_GB18_DERB:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121003826961Z_82eae9f9","language_code":"en","language_name":"English","title":"Chapters 34–36","source_sha256":"ff22484ca747baa3f77e0f8d341d436fbfe0096a44e3ca903f600c4df1586737","sha256":"6b36639a4e9936977e4b7eba75d35b77f954cc59afc3b10d7e849c72b24fdd27","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:10:03.828717+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_12:AS-B01","text":"The central problem is the self-failure of an infinite that posits itself as an external beyond and thereby becomes dependent on precisely that finitude which it is supposed to exclude.","refs":["CH_GB18_AN_4:AS1","CH_GB18_CDAU:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B02","text":"The reconstruction replaces the opposition of finite and infinite with an immanent mediation in which each moment contains its other as its own determination.","refs":["CH_GB18_CDAU:A3","CH_GB18_AN_4:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B03","text":"Infinite progress is treated not as the truth of infinity, but as a necessary yet unconceived repetition of the separation and unity of the same determinations.","refs":["CH_GB18_CDAU:SD3","CH_GB18_AN_4:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B04","text":"The movement is recursive and spiral-shaped: external negation produces opposition, opposition reveals reciprocal immanence, and its sublation produces affirmative self-relation.","refs":["CH_GB18_CDAU:AS5","CH_GB18_AN_4:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B05","text":"Unity does not remain at the level of a logical reconciliation, but mutates into the ontological production of Seyn, Daseyn, and Fürsichseyn as stages of intensified self-referentiality.","refs":["CH_GB18_DERB:AS5","CH_GB18_DERB:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B06","text":"The critique is directed not only against false answers, but against questions whose form already presupposes separate self-subsistences and linear transitions.","refs":["CH_GB18_AN_4:AS5","CH_GB18_AN_4:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B07","text":"The closure of the system does not consist in the arrest of movement, but in its return to a unity that bears difference and negation as its ideal moments.","refs":["CH_GB18_CDAU:A9","CH_GB18_AN_4:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AS-B08","text":"The cluster produces an affirmative ontology in which reality belongs neither to the isolated finite nor to a transcendent infinite, but to the whole that mediates itself.","refs":["CH_GB18_CDAU:AS7","CH_GB18_CDAU:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_12:GA-01","text":"[Persistent] The finite and the infinite possess no independent identity, because each determination contains its other as an immanent moment.","refs":["CH_GB18_CDAU:A3","CH_GB18_AN_4:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-02","text":"[Persistent] The abstract separation of finite and infinite necessarily produces a bad infinite, because the posited beyond remains limited by its opposite.","refs":["CH_GB18_CDAU:A4","CH_GB18_AN_4:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-03","text":"[Mutating] Negation is not loss, but the operation through which isolated determinations return into their mediated self-relation.","refs":["CH_GB18_CDAU:A7","CH_GB18_DERB:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-04","text":"[Emergent] Infinite progress is the formal self-reproduction of a relation whose unity and difference are continually posited but not conceived.","refs":["CH_GB18_CDAU:A8","CH_GB18_AN_4:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-05","text":"[Mutating] Ideality denotes not the derealization of determinacy, but its status as a differentiated yet non-self-subsistent moment of a unity.","refs":["CH_GB18_CDAU:A12","CH_GB18_AN_4:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-06","text":"[Emergent] Becoming receives its determinate form as a transition in which finitude and negative infinity are simultaneously sublated.","refs":["CH_GB18_DERB:A2","CH_GB18_DERB:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-07","text":"[Terminal] Seyn is determined only as Daseyn containing negation, and Daseyn becomes Fürsichseyn only through the self-relation of negation.","refs":["CH_GB18_DERB:A8","CH_GB18_DERB:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-08","text":"[Attractor] Affirmation arises solely as the return of negation from its own one-sidedness and not as antecedent, motionless positivity.","refs":["CH_GB18_CDAU:D6","CH_GB18_AN_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GA-09","text":"[Attractor] Philosophical critique must negate the presuppositions of a question when these presuppositions already posit the separation to be investigated as valid.","refs":["CH_GB18_AN_4:A10","CH_GB18_AN_4:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_12:RMD-01","text":"The infinite first recurs as an abstract beyond, then mutates into immanent self-mediation, and ends as the affirmative presence of becoming relating to itself.","refs":["CH_GB18_CDAU:AS2","CH_GB18_CDAU:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RMD-02","text":"Progress remains functionally preserved, yet its valence is reversed: what appears as flight into infinity becomes the symptom of a concealed self-closure.","refs":["CH_GB18_CDAU:D2","CH_GB18_AN_4:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RMD-03","text":"Ideality shifts from the determination of the finite as non-self-subsistent to a process that brings forth the ontological form of Daseyn.","refs":["CH_GB18_CDAU:A12","CH_GB18_DERB:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RMD-04","text":"Negation mutates from the determination of the finite as nothingness into a generative operation that produces self-relation, Daseyn, and Fürsichseyn.","refs":["CH_GB18_CDAU:A2","CH_GB18_DERB:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RMD-05","text":"Transition loses the status of a temporal or spatial process and is determined as the inner self-movement of the sublated opposites.","refs":["CH_GB18_DERB:SNX4","CH_GB18_AN_4:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_12:CGD-01","text":"The determination of individual categories as Seyn, Daseyn, and Fürsichseyn belongs to the immediate sequence of derivation; at the cluster level, only their shared logic of increasing self-relation is operative.","refs":["CH_GB18_DERB:SD3","CH_GB18_DERB:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:CGD-02","text":"The cause-effect relation remains a local example, but at the cluster level it is absorbed as evidence that opposites are determined only within a relation.","refs":["CH_GB18_AN_4:A6","CH_GB18_AN_4:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:CGD-03","text":"The polemic against the bad infinite is local, but its higher function consists in disqualifying every ontology of externally delimited self-subsistences.","refs":["CH_GB18_CDAU:D1","CH_GB18_DERB:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:CGD-04","text":"The opposition of understanding and speculative thinking becomes, at the cluster level, the methodological distinction between fixating analysis and immanent reconstruction.","refs":["CH_GB18_CDAU:ALT3","CH_GB18_AN_4:AS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_12:GNX-01","text":"Excluded is an ontology in which determinations obtain their identity through fixed external boundaries and mutually independent self-subsistence.","refs":["CH_GB18_CDAU:DNX1","CH_GB18_AN_4:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GNX-02","text":"Excluded is an infinite that would become truer through mere distance from the finite or could subsist as an unattainable beyond.","refs":["CH_GB18_CDAU:DNX3","CH_GB18_AN_4:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GNX-03","text":"Excluded is a negation that means exclusively loss, annihilation, or one-time sublation and permits no affirmative return.","refs":["CH_GB18_CDAU:DNX2","CH_GB18_DERB:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:GNX-04","text":"Excluded is a presupposition-neutral form of questioning, because questions themselves posit ontological separations and are therefore subject to critique.","refs":["CH_GB18_AN_4:NX7","CH_GB18_AN_4:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_12:DBN-01","text":"For the system to hold, it must be false that opposites initially exist in complete separation and are only subsequently mediated.","refs":["CH_GB18_AN_4:DNX1","CH_GB18_CDAU:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:DBN-02","text":"For Daseyn to be determinable as a result, an immediate Seyn devoid of negation must remain excluded.","refs":["CH_GB18_DERB:NX4","CH_GB18_DERB:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:DBN-03","text":"For transition to be immanent, every external mechanism that would mediate between previously self-subsistent determinations must be rejected.","refs":["CH_GB18_DERB:SNX4","CH_GB18_AN_4:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_12:BSA-01","text":"Unavailable is an absolutely external standpoint from which the finite and the infinite could be compared as ready-made objects.","refs":["CH_GB18_AN_4:SNX1","CH_GB18_CDAU:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:BSA-02","text":"Impossible is a final identity that would be immune to mediation, negation, and inner difference.","refs":["CH_GB18_CDAU:SNX2","CH_GB18_AN_4:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:BSA-03","text":"Unavailable is a pure initial or final moment that would precede the movement or could be withdrawn from it as a transcendent conclusion.","refs":["CH_GB18_CDAU:DNX5","CH_GB18_AN_4:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_12:XD-01","text":"Infinite progress is neither mere error nor mere truth, but the necessary appearance-form of a unity that initially misrecognizes itself as an alternation of separation and return.","refs":["CL_GB18_12:GA-01","CL_GB18_12:GA-04","CH_GB18_CDAU:SD3","CH_GB18_AN_4:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:XD-02","text":"Affirmative infinity acquires ontological determinacy only when its self-mediation does not remain at unity, but passes over into Daseyn containing negation.","refs":["CL_GB18_12:GA-06","CL_GB18_12:GA-08","CH_GB18_CDAU:FGS6","CH_GB18_DERB:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:XD-03","text":"The negation of the question of transition is itself not a refusal of movement, but the methodological condition for conceiving transition as immanent self-determination rather than as external transport.","refs":["CL_GB18_12:GA-06","CL_GB18_12:GA-09","CH_GB18_AN_4:AS5","CH_GB18_DERB:MRT6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:XD-04","text":"The ideality of opposites forms the hinge between the critique of the bad infinite and the production of Fürsichseyn, because it preserves difference without self-subsistence.","refs":["CL_GB18_12:GA-05","CL_GB18_12:GA-07","CH_GB18_AN_4:A7","CH_GB18_DERB:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:XD-05","text":"The critique of linear causality and the critique of infinite progress converge in a relational ontology in which series represent only the repeated abstraction of a unity already in effect.","refs":["CL_GB18_12:GA-01","CL_GB18_12:GA-04","CH_GB18_AN_4:D2","CH_GB18_AN_4:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_12:BSD-01","text":"Reality is determined as self-differentiation: it is actual only insofar as it brings forth its finitude, sublates it, and takes it back into itself as an ideal moment.","refs":["CL_GB18_12:GA-03","CL_GB18_12:GA-05","CL_GB18_12:GA-08","CH_GB18_CDAU:D7","CH_GB18_DERB:AS3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:BSD-02","text":"Temporal narratives of origin lose their ontological force, because finitude and infinity exist neither first nor subsequently, but coexist in an eternal self-mediation.","refs":["CL_GB18_12:GA-01","CL_GB18_12:GA-06","CH_GB18_AN_4:D7","CH_GB18_AN_4:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:BSD-03","text":"Cognition becomes the reconstruction of the conditions under which an opposite, a question, or a series can appear self-subsistent at all.","refs":["CL_GB18_12:GA-02","CL_GB18_12:GA-09","CH_GB18_AN_4:SD4","CH_GB18_AN_4:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_12:BSD-04","text":"The subject is not implied as an external observer of movement, but as the enactment of a conceiving that grasps the inseparability of self-negating determinations.","refs":["CL_GB18_12:GA-01","CL_GB18_12:GA-09","CH_GB18_AN_4:A9","CH_GB18_AN_4:AS4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_12:RLE-01","text":"The basic loop is as follows: abstract separation produces reciprocal implication; its one-sided positing produces renewed separation; repetition reveals progress as self-contradiction.","refs":["CH_GB18_AN_4:A3","CH_GB18_AN_4:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RLE-02","text":"Progress functions as an attractor of the defective form, because every flight beyond a boundary reproduces the boundary as its own moment.","refs":["CH_GB18_CDAU:D3","CH_GB18_AN_4:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RLE-03","text":"The negation of negation constitutes the productive loop in which negativity does not disappear, but is transformed into affirmed self-relation.","refs":["CH_GB18_CDAU:AS5","CH_GB18_AN_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:RLE-04","text":"Transition marks a point of escalation: the analysis of the infinite becomes the ontology of Daseyn and ends in the category of Fürsichseyn.","refs":["CH_GB18_DERB:AS2","CH_GB18_DERB:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_12:FGS-B01","text":"The abstract opposition of finite and infinite produces a beyond that itself becomes finite through its opposite.","refs":["CH_GB18_CDAU:FGS1","CH_GB18_AN_4:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FGS-B02","text":"Reciprocal limitation reveals that each determination contains its other as its own moment and therefore cannot be self-subsistent.","refs":["CH_GB18_CDAU:FGS3","CH_GB18_AN_4:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FGS-B03","text":"The one-sided fixation of unity or difference reproduces infinite progress as abstract alternation.","refs":["CH_GB18_AN_4:FGS3","CH_GB18_AN_4:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FGS-B04","text":"The diagnosis of alternation does not sublate difference, but determines it as ideal difference within a unity mediating itself.","refs":["CH_GB18_AN_4:FGS5","CH_GB18_AN_4:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FGS-B05","text":"The ideal unity enacts itself as the sublation of finitude and negative infinity, the result of which is return into itself.","refs":["CH_GB18_DERB:FGS2","CH_GB18_DERB:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FGS-B06","text":"Return into itself determines Seyn as Daseyn containing negation and leads, through the self-relation of negation, to Fürsichseyn.","refs":["CH_GB18_DERB:FGS4","CH_GB18_DERB:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_12:AFM-B01","text":"Bad infinite → external opposition of finite and infinite.","refs":["CH_GB18_CDAU:AF1","CH_GB18_AN_4:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AFM-B02","text":"External opposition → reciprocal limitation and revelation of immanent otherness.","refs":["CH_GB18_CDAU:AF2","CH_GB18_AN_4:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AFM-B03","text":"Reciprocal otherness → alternation of unity and separation as infinite progress.","refs":["CH_GB18_CDAU:AF3","CH_GB18_AN_4:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AFM-B04","text":"Diagnosis of alternation → ideality of the differentiated moments and negation of their self-subsistence.","refs":["CH_GB18_AN_4:AF4","CH_GB18_AN_4:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AFM-B05","text":"Ideality → return into itself and affirmative negation of negation.","refs":["CH_GB18_CDAU:AF5","CH_GB18_AN_4:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:AFM-B06","text":"Affirmative return → Daseyn → Fürsichseyn as ontological condensation of self-relation.","refs":["CH_GB18_CDAU:AF6","CH_GB18_DERB:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_12:MME-01","text":"Finitude and infinity are reclassified from separate regions of being into correlative moments of a single process of mediation.","refs":["CH_GB18_CDAU:ME1","CH_GB18_DERB:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MME-02","text":"Negation is transformed from a destructive operation into the productive source of affirmation, determinacy, and self-relation.","refs":["CH_GB18_CDAU:ME3","CH_GB18_DERB:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MME-03","text":"The beyond loses its rank as a higher reality and appears as the symptom of a return of negation to itself not yet enacted.","refs":["CH_GB18_CDAU:ME4","CH_GB18_CDAU:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MME-04","text":"Philosophical questions become mappable bearers of ontological presuppositions, whereby critique becomes analysis of the question-form itself.","refs":["CH_GB18_AN_4:ME4","CH_GB18_AN_4:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_12:ALT-B01","text":"Surface level — The cluster reconstructs the relation of finitude, infinity, boundary, progress, ideality, Seyn, Daseyn, and Fürsichseyn.","refs":["CH_GB18_CDAU:ALT1","CH_GB18_DERB:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:ALT-B02","text":"Structural level — Each determination arises through immanent negation, mediation with its other, and return as self-related determinacy.","refs":["CH_GB18_CDAU:ALT2","CH_GB18_DERB:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:ALT-B03","text":"Metastrategic level — The argument replaces external comparison and linear explanation with the immanent reconstruction of the conditions that produce the opposites.","refs":["CH_GB18_DERB:ALT3","CH_GB18_AN_4:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:ALT-B04","text":"Ontological / Temporal level — Reality has the form of present self-mediation and no temporally ordered structure of origin from entities initially separate.","refs":["CH_GB18_CDAU:ALT4","CH_GB18_AN_4:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:ALT-B05","text":"Methodological / Performative level — The procedure performs its thesis by determining every asserted self-subsistence only through its immanent sublation.","refs":["CH_GB18_CDAU:AS3","CH_GB18_AN_4:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_12:FL-01","text":"The affirmative force of the negation of negation remains methodologically tension-filled, because its necessity is asserted without being fully distinguished from a mere renaming of the result.","refs":["CH_GB18_AN_4:MRT3","CH_GB18_CDAU:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FL-02","text":"The determination of the true infinite oscillates between present affirmative Daseyn and continuing becoming, without definitively closing the difference between the two registers.","refs":["CH_GB18_CDAU:MRT6","CH_GB18_CDAU:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:FL-03","text":"The question of transition is negated as untrue, while its content simultaneously returns as the necessary self-movement of the infinite.","refs":["CH_GB18_AN_4:MRT6","CH_GB18_AN_4:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MP-01","text":"The infinite mutates from the abstract beyond into the immanent reality of a process that does not exclude its finitude, but contains it ideally.","refs":["CH_GB18_CDAU:NX1","CH_GB18_CDAU:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MP-02","text":"Ideality mutates from a quality of infinity into the form of mediation through which sublated opposites produce Daseyn.","refs":["CH_GB18_DERB:A1","CH_GB18_DERB:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MP-03","text":"Transition mutates from an apparently external relation into an inner operation that proceeds from the negativity of the determinations themselves.","refs":["CH_GB18_DERB:A3","CH_GB18_DERB:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_12:HSI-01","text":"Reality appears as a machine of recursive self-mediation that produces its differences, negates them, and takes them back as ideal moments of its own unity.","refs":["CH_GB18_CDAU:FGS5","CH_GB18_AN_4:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:HSI-02","text":"The subject appears as the enactment of a conceiving that does not stand outside opposites, but realizes their inseparability in thought.","refs":["CH_GB18_AN_4:AS4","CH_GB18_AN_4:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:HSI-03","text":"Time appears not as a linear sequence of origin, transition, and end, but as the present of a movement that continually produces its own presupposition retrospectively.","refs":["CH_GB18_CDAU:ALT4","CH_GB18_AN_4:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:HSI-04","text":"Possible struggle consists in the sublation of fixed boundaries, false models of the beyond, and presupposition-laden questions through the reconstruction of their immanent conditions.","refs":["CH_GB18_CDAU:DNX1","CH_GB18_AN_4:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_12:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from abstract separation through progress, ideality, and affirmative negation to Daseyn and Fürsichseyn.","refs":["CH_GB18_CDAU:MRT1","CH_GB18_DERB:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MRT-B02","text":"What remains underdetermined is the formal necessity by which recurrence in progress is secured as immanent unity and the negation of negation as affirmation.","refs":["CH_GB18_CDAU:MRT2","CH_GB18_DERB:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MRT-B03","text":"The architecture is strongest where it simultaneously translates external opposition, linear origin, and static identity into a logic of recursive self-mediation.","refs":["CH_GB18_CDAU:MRT4","CH_GB18_DERB:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_12:MRT-B04","text":"The reconstruction remains adequate only if unity is read not as a final state, but as the continued sublation of separation and as the self-relation of negation.","refs":["CH_GB18_CDAU:MRT7","CH_GB18_DERB:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_12@R001","source_variant_id":"canonical:CL_GB18_12:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 34–36","context":"c. Die affirmative Unendlichkeit. · Der Übergang. · Anmerkung 1."},"title_language_code":"en"},{"id":"CL_GB18_13","layer":"CL","title":"Chapters 37–39","order":13,"parents":["CH_GB18_AN_5","CH_GB18_DFRA","CH_GB18_DUFR"],"revision":"CL_GB18_13@R001","sha256":"d6adec2cd1979b4401a3176a52af6135dc582851be3f8776c4341e8a6bb63325","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_13:ASP-01","text":"Das Cluster löst das Problem, wie Endlichkeit aufgehoben werden kann, ohne sie entweder als selbständiges Absolutes zu belassen oder sie durch bloßen subjektiven Formwechsel zu eliminieren.","refs":["CH_GB18_AN_5:A1","CH_GB18_AN_5:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ASP-02","text":"Seine Kernthese bestimmt Idealität als immanente Rücknahme des Endlichen in eine konkrete Selbstbeziehung, nicht als Absonderung einer ideellen Sphäre von Realität.","refs":["CH_GB18_AN_5:A7","CH_GB18_DUFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ASP-03","text":"Die Argumentbewegung ist rekursiv: Unmittelbarkeit erzeugt Differenz, Differenz setzt Negation frei, Negation wird Negation ihrer selbst, und die resultierende Selbstbeziehung enthält das Negierte als Moment.","refs":["CH_GB18_DFRA:A10","CH_GB18_DUFR:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ASP-04","text":"Das Fürsichseyn liefert die logische Durchführung dessen, was die Idealismusbestimmung fordert: Das Andere verliert seine Selbständigkeit, ohne als bloßer Inhalt eines privaten Ich zu verschwinden.","refs":["CH_GB18_AN_5:A9","CH_GB18_DFRA:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ASP-05","text":"Die Schließung bleibt nicht bei qualitativer Selbstidentität stehen, weil Eins, Vielheit, Repulsion und Attraktion die Selbstbeziehung in eine neue kategoriale Ordnung überführen.","refs":["CH_GB18_DFRA:A12","CH_GB18_DFRA:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_13:GA-01","text":"[Persistent] Endlichkeit besitzt keine letzte Selbständigkeit; sie ist nur als gesetzte, vermittelte und aufhebbare Bestimmtheit real.","refs":["CH_GB18_AN_5:A1","CH_GB18_DUFR:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-02","text":"[Mutating] Idealität bezeichnet zunächst die Nichtanerkennung des Endlichen als Absolutes und wird sodann zur positiven Struktur einer Einheit, die ihre endlichen Momente in sich enthält.","refs":["CH_GB18_AN_5:A2","CH_GB18_AN_5:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-03","text":"[Persistent] Aufhebung ist keine Tilgung, sondern eine Negation, die das Negierte als funktionales Moment der höheren Einheit bewahrt.","refs":["CH_GB18_DFRA:SD2","CH_GB18_DUFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-04","text":"[Emergent] Daseyn ist weder selbständige Realität noch bloße Illusion, sondern die unmittelbare Erscheinungsform einer noch nicht als unendliche Selbstbeziehung gesetzten Negativität.","refs":["CH_GB18_DUFR:A4","CH_GB18_DUFR:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-05","text":"[Mutating] Fürsichseyn ist nicht subjektive Innerlichkeit, sondern die gesetzte Negation der Negation, in der Bestimmtheit als Beziehung auf sich selbst vollbracht wird.","refs":["CH_GB18_DFRA:A10","CH_GB18_DFRA:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-06","text":"[Attractor] Das Andere ist nur als inneres Moment der Selbstbeziehung tragfähig; jede äußerlich bleibende Andersheit muss in Seyn-für-Eines transformiert werden.","refs":["CH_GB18_DUFR:A8","CH_GB18_DUFR:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-07","text":"[Emergent] Einheit entsteht nicht vor der Differenz, sondern nur durch die Erzeugung, Gegenbewegung und Rücknahme von Vielheit, Repulsion und Attraktion.","refs":["CH_GB18_DFRA:A12","CH_GB18_DFRA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-08","text":"[Terminal] Vollendetes qualitatives Seyn schließt keine Ruhe ein, sondern erzwingt den Übergang zur Quantität, weil seine Einheit nur durch die Dynamik ihrer eigenen Unterschiede besteht.","refs":["CH_GB18_DFRA:A1","CH_GB18_DFRA:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-09","text":"[Tension] Konkrete Idealität verlangt mehr als die subjektive Aufhebung äußerer Realität, doch ihre logische Form bleibt zunächst abstrakter als die beanspruchte konkrete Totalität.","refs":["CH_GB18_AN_5:SD3","CH_GB18_DFRA:SNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_13:RMD-01","text":"Endlichkeit kehrt funktional wieder, mutiert jedoch vom zurückgewiesenen absoluten Sein zur notwendigen, aber unselbständigen Bestimmtheit innerhalb der Selbstbeziehung.","refs":["CH_GB18_AN_5:NX1","CH_GB18_DFRA:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:RMD-02","text":"Negation verschiebt sich von einer Grenze des Daseyns zur produktiven Operation, durch die die Grenze in Selbstbeziehung, Erhaltung und ideelle Einheit übergeht.","refs":["CH_GB18_DFRA:A8","CH_GB18_DFRA:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:RMD-03","text":"Das Andere mutiert von äußerem Gegenstand über ideell besessenen Inhalt zu einem inneren Moment des Seyn-für-Eines.","refs":["CH_GB18_DFRA:A17","CH_GB18_DUFR:A9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_13:CGD-01","text":"Die Abfolge von Eins, Vielheit, Repulsion, Attraktion und Gleichgewicht bleibt als lokale kategoriale Durchführung bestimmt; auf Clusterebene trägt sie nur insofern, als sie die Unmöglichkeit statischer Selbstidentität beweist.","refs":["CH_GB18_DFRA:FGS3","CH_GB18_DFRA:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:CGD-02","text":"Die Gegenüberstellung von Bewußtseyn und Selbstbewußtseyn bleibt eine lokale Veranschaulichungsform, während ihre skalierende Funktion darin besteht, ideellen Besitz und fortbestehende äußere Realität auseinanderzuhalten.","refs":["CH_GB18_DFRA:A17","CH_GB18_DFRA:A18"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:CGD-03","text":"Auf Clusterebene wird die Kritik des subjektiven Idealismus zur allgemeinen Regel: Eine Formveränderung zählt nur dann als Aufhebung, wenn sie den Status des endlichen Inhalts transformiert.","refs":["CH_GB18_AN_5:A11","CH_GB18_AN_5:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_13:GNX-01","text":"Ausgeschlossen wird ein endliches Seiendes, das als ungesetztes, in sich gegründetes und vom Ganzen unabhängiges Letztes bestehen könnte.","refs":["CH_GB18_AN_5:DNX1","CH_GB18_DFRA:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GNX-02","text":"Ausgeschlossen wird ebenso eine Idealität, die nur die Form des Vorstellens verändert und dadurch den endlichen Inhalt unangetastet lässt.","refs":["CH_GB18_AN_5:NX6","CH_GB18_AN_5:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GNX-03","text":"Nicht zugelassen wird eine äußerliche Andersheit, die sich dauerhaft der Rücknahme in Selbstbeziehung, ideelle Vermittlung und Seyn-für-Eines entzöge.","refs":["CH_GB18_DFRA:DNX4","CH_GB18_DUFR:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_13:DBN-01","text":"Das Cluster disqualifiziert konkurrierende Ontologien getrennter Bereiche: weder Realität und Idealität noch Daseyn und Fürsichseyn dürfen als unabhängig bestehende Sphären angesetzt werden.","refs":["CH_GB18_AN_5:SNX3","CH_GB18_DUFR:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:DBN-02","text":"Es verwirft jede Theorie der Einheit, die ohne Durcharbeitung von Negation, Differenz und erhaltenem Andersseyn zu einer reinen positiven Identität gelangen will.","refs":["CH_GB18_DFRA:DNX5","CH_GB18_DFRA:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_13:BSA-01","text":"Unverfügbar ist ein absoluter Außenstandpunkt, von dem Endlichkeit, Andersheit oder Realität als vollständig unmittelbare Tatsachen bestätigt werden könnten.","refs":["CH_GB18_AN_5:SNX5","CH_GB18_DFRA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:BSA-02","text":"Unmöglich ist eine Selbstbeziehung ohne eine in ihr enthaltene Beziehung zu anderem; reine Identität wäre nicht Vollendung, sondern Abstraktion ohne generative Kraft.","refs":["CH_GB18_DUFR:SNX4","CH_GB18_DUFR:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_13:XD-01","text":"Die Kritik des formellen Idealismus erhält ihre positive logische Begründung: Nur eine Negation, die ihr Anderes bewahrt und zurücknimmt, kann Endlichkeit aufheben, statt sie bloß umzubenennen.","refs":["CL_GB18_13:GA-02","CL_GB18_13:GA-03","CL_GB18_13:GA-05","CH_GB18_AN_5:D7","CH_GB18_DFRA:SD2"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_13:XD-02","text":"Daseyn wird zum Vermittlungsglied zwischen der universalen Nichtabsolutheit des Endlichen und der konkreten Selbstbeziehung des Fürsichseyns: Es ist unterschieden, aber nicht äußerlich.","refs":["CL_GB18_13:GA-01","CL_GB18_13:GA-04","CL_GB18_13:GA-06","CH_GB18_DUFR:A5","CH_GB18_DUFR:A6"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_13:XD-03","text":"Die Umwandlung von Seyn-für-Anderes in Seyn-für-Eines zeigt, dass Idealität keine Subjektivierung der Welt ist, sondern die Reorganisation von Relation als immanente Bestimmung.","refs":["CL_GB18_13:GA-02","CL_GB18_13:GA-06","CH_GB18_AN_5:NX5","CH_GB18_DUFR:ME3"],"deep_refs":[],"trace_type":"Composite.","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_13:BSD-01","text":"Realität wird nicht zwischen objektivem Sein und subjektiver Vorstellung verteilt, sondern als gestufte Vermittlung bestimmt, in der Unmittelbarkeit, Differenz und Selbstbeziehung verschiedene Zustände derselben Bewegung bilden.","refs":["CH_GB18_AN_5:ME5","CH_GB18_DUFR:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:BSD-02","text":"Die Frage nach Idealismus und Realismus wird durch eine strengere Frage ersetzt: Ob und wie eine Bestimmung ihr Anderes als Moment ihrer eigenen Wahrheit enthalten kann.","refs":["CH_GB18_AN_5:ME1","CH_GB18_DUFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:BSD-03","text":"Die Vollendung einer Kategorie wird systematisch als Übergang lesbar: Was sich als absolute Bestimmtheit behauptet, produziert durch seine immanente Negativität eine weiterführende Ordnung.","refs":["CH_GB18_DFRA:SD5","CH_GB18_DFRA:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_13:RLE-01","text":"Die Hauptschleife lautet: Endlichkeit setzt Grenze, Grenze setzt Negation, Negation negiert ihre äußere Gestalt, und die Rückkehr in sich erhält das Begrenzte als ideelles Moment.","refs":["CH_GB18_DFRA:A9","CH_GB18_DUFR:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:RLE-02","text":"Der Attraktor des Clusters ist die konkrete Einheit, in der weder unmittelbares Sein noch Andersheit verschwinden, sondern beide ihren Status als selbständige Letztinstanzen verlieren.","refs":["CH_GB18_AN_5:A7","CH_GB18_DUFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:RLE-03","text":"Die Eskalation führt von der Kritik einer falschen Gegenüberstellung über die Rücknahme von Andersheit bis zur Überschreitung des Qualitativen in Quantität.","refs":["CH_GB18_AN_5:NX8","CH_GB18_DFRA:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_13:FGS-B01","text":"Absolutgesetztes Endliches → Nachweis seiner Abhängigkeit und Vermitteltheit → Bestimmung seiner Idealität als nichtselbständiges Moment.","refs":["CH_GB18_AN_5:FGS1","CH_GB18_AN_5:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:FGS-B02","text":"Unmittelbare Negation → Daseyn als endliche Differenz → gesetzte Negation der Negation → Fürsichseyn als einfache Selbstbeziehung.","refs":["CH_GB18_DFRA:FGS1","CH_GB18_DFRA:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:FGS-B03","text":"Fürsichseyn → Eins → Vielheit → Repulsion und Attraktion → Rücknahme des Anderen → Übergang aus qualitativer Selbstbeziehung in Quantität.","refs":["CH_GB18_DFRA:FGS3","CH_GB18_DFRA:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_13:AFM-B01","text":"Endlichkeit als vermeintliches Absolutes → Entkräftung selbständiger Realität → Ideellsetzung als vermittelte Abhängigkeit.","refs":["CH_GB18_AN_5:AF1","CH_GB18_AN_5:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:AFM-B02","text":"Vermittelte Endlichkeit → Daseyn als Differenz → Negation der Negation → Fürsichseyn als Rückkehr in sich.","refs":["CH_GB18_DFRA:AF1","CH_GB18_DFRA:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:AFM-B03","text":"Selbstbeziehung → Erzeugung und Rücknahme von Vielheit → Gleichgewicht → Überschreitung des Qualitativen → offene kategoriale Fortsetzung.","refs":["CH_GB18_DFRA:AF2","CH_GB18_DFRA:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_13:MME-01","text":"Die Karte verschiebt sich von einer Opposition Idealismus gegen Realismus zu einer Skala der Durchführung von Aufhebung, Vermittlung und konkreter Einheit.","refs":["CH_GB18_AN_5:ME2","CH_GB18_AN_5:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MME-02","text":"Das Andere wird nicht mehr als Gegenstand außerhalb eines Subjekts kartiert, sondern als variable Form einer Relation, die in Selbstbeziehung zurückgebogen werden kann.","refs":["CH_GB18_DFRA:ME3","CH_GB18_DUFR:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MME-03","text":"Qualität erscheint nicht als stabile ontologische Grundschicht, sondern als selbstüberschreitende Ordnung, deren Vollzug die Quantität vorbereitet.","refs":["CH_GB18_DFRA:ME5","CH_GB18_DFRA:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_13:ALT-B01","text":"Surface level — Behandelt werden Endlichkeit, Idealismus, Daseyn, Fürsichseyn, Eins, Vielheit, Bewußtseyn und Selbstbewußtseyn.","refs":["CH_GB18_AN_5:ALT1","CH_GB18_DFRA:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ALT-B02","text":"Structural level — Die tragende Maschine ist die Transformation äußerlicher Negation in gesetzte Negation der Negation, durch welche Differenz zugleich erhalten und entmachtet wird.","refs":["CH_GB18_AN_5:ALT2","CH_GB18_DFRA:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ALT-B03","text":"Metastrategic level — Philosophische Lager, Subjekt-Objekt-Gegensätze und starre Alternativen werden durch die Prüfung ersetzt, ob eine Bestimmung ihr Anderes wirklich in ihrer eigenen Wahrheit vermittelt.","refs":["CH_GB18_AN_5:ALT3","CH_GB18_DUFR:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ALT-B04","text":"Ontological / Temporal level — Realität ist eine gestufte Logik des Hervorgangs, in der Unmittelbarkeit, Differenz, Rücknahme und Übergang keine zeitlichen Episoden, sondern Seinsweisen sind.","refs":["CH_GB18_DFRA:ALT4","CH_GB18_DUFR:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ALT-B05","text":"Methodological / Performative level — Die Form vollzieht ihre These, indem sie Begriffe nicht definiert fixiert, sondern durch ihre Übergänge, Gegenbewegungen und Rücknahmen bestimmt.","refs":["CH_GB18_DFRA:SD3","CH_GB18_AN_5:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_13:FL-01","text":"Das Fürsichseyn wird als vollendetes qualitatives Seyn bestimmt, muss aber gerade wegen dieser Vollendung weiter in Vielheit, Gleichgewicht und Quantität übergehen.","refs":["CH_GB18_DFRA:MRT6","CH_GB18_DFRA:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:FL-02","text":"Die konkrete Idealität wird gegen subjektiven Formalismus verteidigt, doch der Übergang von logischer Selbstbeziehung zur vollen Konkretion von Geist und Idee bleibt unentwickelt.","refs":["CH_GB18_AN_5:MRT2","CH_GB18_DFRA:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MP-01","text":"Der Begriff der Idealität mutiert, sobald er vom Kriterium der Nichtabsolutheit des Endlichen zur positiven Einheit eines Ganzen mit seinen aufgehobenen Momenten wird.","refs":["CH_GB18_AN_5:A2","CH_GB18_AN_5:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MP-02","text":"Das Daseyn mutiert vom Feld relativer Bestimmtheit zur inneren Bestimmung des Fürsichseyns, ohne dass seine Differenz vollständig in bloße Identität eingeebnet werden darf.","refs":["CH_GB18_DFRA:A5","CH_GB18_DUFR:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_13:HSI-01","text":"Die Realität erscheint als Maschine rekursiver Vermittlung, in der jede scheinbare Selbständigkeit durch ihre Abhängigkeit von Negation, Relation und Rücknahme bestimmt wird.","refs":["CH_GB18_AN_5:A6","CH_GB18_DUFR:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:HSI-02","text":"Das Subjekt ist keine souveräne Instanz außerhalb der Welt, sondern die zugespitzte Form einer Bewegung, in der äußerliches Sein ideell besessen wird und doch nicht bloß verschwindet.","refs":["CH_GB18_AN_5:A9","CH_GB18_DFRA:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:HSI-03","text":"Möglicher Kampf besteht nicht in der Vernichtung des Anderen, sondern in der Prüfung, ob seine behauptete Äußerlichkeit als Moment einer höheren Selbstbeziehung lesbar wird.","refs":["CH_GB18_DFRA:A16","CH_GB18_DUFR:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_13:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Clusterbewegung von der Nichtabsolutheit des Endlichen über Daseyn und Fürsichseyn bis zum Übergang in Quantität zu rekonstruieren.","refs":["CH_GB18_AN_5:MRT1","CH_GB18_DFRA:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MRT-B02","text":"Die Rekonstruktion bleibt nur kohärent, wenn Aufhebung zugleich Negation, Erhaltung, Rückführung und Verlust selbständiger Geltung bedeutet.","refs":["CH_GB18_DFRA:MRT4","CH_GB18_DUFR:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MRT-B03","text":"Unterbestimmt bleibt die Vermittlung zwischen logischer Genesis, Bewußtseyn, Selbstbewußtseyn und konkreter Idealität; diese Lücke ist die zentrale Grenze der vorliegenden Clusterschließung.","refs":["CH_GB18_DFRA:MRT7","CH_GB18_DUFR:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121029298787Z_73c161fd","language_code":"en","language_name":"English","title":"Chapters 37–39","source_sha256":"d6adec2cd1979b4401a3176a52af6135dc582851be3f8776c4341e8a6bb63325","sha256":"976f28d6716ba3f6961767c7629d9d092df8a1ae41b3112bfe8c8e8d0431e47c","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:10:29.300092+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_13:ASP-01","text":"The cluster resolves the problem of how finitude can be sublated without either leaving it as an independent absolute or eliminating it through a merely subjective change of form.","refs":["CH_GB18_AN_5:A1","CH_GB18_AN_5:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ASP-02","text":"Its core thesis determines ideality as the immanent retraction of the finite into a concrete self-relation, not as the separation of an ideal sphere from reality.","refs":["CH_GB18_AN_5:A7","CH_GB18_DUFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ASP-03","text":"The movement of the argument is recursive: immediacy generates difference, difference releases negation, negation becomes the negation of itself, and the resulting self-relation contains the negated as a moment.","refs":["CH_GB18_DFRA:A10","CH_GB18_DUFR:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ASP-04","text":"Being-for-self (Fürsichseyn) provides the logical development of what the determination of idealism demands: the other loses its independence without disappearing as the mere content of a private I.","refs":["CH_GB18_AN_5:A9","CH_GB18_DFRA:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ASP-05","text":"The closure does not remain at qualitative self-identity, because the One, plurality, repulsion, and attraction transfer self-relation into a new categorial order.","refs":["CH_GB18_DFRA:A12","CH_GB18_DFRA:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_13:GA-01","text":"[Persistent] Finitude possesses no ultimate independence; it is real only as posited, mediated, and sublatable determinacy.","refs":["CH_GB18_AN_5:A1","CH_GB18_DUFR:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-02","text":"[Mutating] Ideality initially denotes the non-recognition of the finite as an absolute and then becomes the positive structure of a unity that contains its finite moments within itself.","refs":["CH_GB18_AN_5:A2","CH_GB18_AN_5:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-03","text":"[Persistent] Sublation is not erasure, but a negation that preserves the negated as a functional moment of the higher unity.","refs":["CH_GB18_DFRA:SD2","CH_GB18_DUFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-04","text":"[Emergent] Determinate being (Daseyn) is neither independent reality nor mere illusion, but the immediate form of appearance of a negativity not yet posited as infinite self-relation.","refs":["CH_GB18_DUFR:A4","CH_GB18_DUFR:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-05","text":"[Mutating] Being-for-self (Fürsichseyn) is not subjective inwardness, but the posited negation of negation, in which determinacy is accomplished as relation to itself.","refs":["CH_GB18_DFRA:A10","CH_GB18_DFRA:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-06","text":"[Attractor] The other is sustainable only as an inner moment of self-relation; every otherness that remains external must be transformed into Being-for-One (Seyn-für-Eines).","refs":["CH_GB18_DUFR:A8","CH_GB18_DUFR:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-07","text":"[Emergent] Unity does not arise prior to difference, but only through the production, counter-movement, and retraction of plurality, repulsion, and attraction.","refs":["CH_GB18_DFRA:A12","CH_GB18_DFRA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-08","text":"[Terminal] Completed qualitative being (Seyn) entails no rest, but compels the transition to quantity, because its unity exists only through the dynamics of its own differences.","refs":["CH_GB18_DFRA:A1","CH_GB18_DFRA:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GA-09","text":"[Tension] Concrete ideality demands more than the subjective sublation of external reality, yet its logical form initially remains more abstract than the claimed concrete totality.","refs":["CH_GB18_AN_5:SD3","CH_GB18_DFRA:SNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_13:RMD-01","text":"Finitude recurs functionally, but mutates from rejected absolute being into necessary, yet non-independent, determinacy within self-relation.","refs":["CH_GB18_AN_5:NX1","CH_GB18_DFRA:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:RMD-02","text":"Negation shifts from a limit of determinate being (Daseyn) to the productive operation through which the limit passes into self-relation, preservation, and ideal unity.","refs":["CH_GB18_DFRA:A8","CH_GB18_DFRA:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:RMD-03","text":"The other mutates from an external object, through ideally possessed content, into an inner moment of Being-for-One (Seyn-für-Eines).","refs":["CH_GB18_DFRA:A17","CH_GB18_DUFR:A9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_13:CGD-01","text":"The sequence of One, plurality, repulsion, attraction, and equilibrium remains determined as a local categorial development; at the cluster level, it bears only insofar as it proves the impossibility of static self-identity.","refs":["CH_GB18_DFRA:FGS3","CH_GB18_DFRA:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:CGD-02","text":"The contrast between consciousness (Bewußtseyn) and self-consciousness (Selbstbewußtseyn) remains a local form of illustration, while its scaling function consists in distinguishing ideal possession from persisting external reality.","refs":["CH_GB18_DFRA:A17","CH_GB18_DFRA:A18"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:CGD-03","text":"At the cluster level, the critique of subjective idealism becomes a general rule: a change of form counts as sublation only if it transforms the status of finite content.","refs":["CH_GB18_AN_5:A11","CH_GB18_AN_5:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_13:GNX-01","text":"Excluded is a finite entity that could subsist as an unposited ultimate grounded in itself and independent of the whole.","refs":["CH_GB18_AN_5:DNX1","CH_GB18_DFRA:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GNX-02","text":"Likewise excluded is an ideality that merely changes the form of representation and thereby leaves finite content untouched.","refs":["CH_GB18_AN_5:NX6","CH_GB18_AN_5:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:GNX-03","text":"An external otherness that would permanently evade retraction into self-relation, ideal mediation, and Being-for-One (Seyn-für-Eines) is not admitted.","refs":["CH_GB18_DFRA:DNX4","CH_GB18_DUFR:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_13:DBN-01","text":"The cluster disqualifies competing ontologies of separate domains: neither reality and ideality nor determinate being (Daseyn) and Being-for-self (Fürsichseyn) may be posited as independently existing spheres.","refs":["CH_GB18_AN_5:SNX3","CH_GB18_DUFR:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:DBN-02","text":"It rejects every theory of unity that seeks to attain a pure positive identity without working through negation, difference, and preserved otherness.","refs":["CH_GB18_DFRA:DNX5","CH_GB18_DFRA:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_13:BSA-01","text":"Unavailable is an absolute external standpoint from which finitude, otherness, or reality could be affirmed as wholly immediate facts.","refs":["CH_GB18_AN_5:SNX5","CH_GB18_DFRA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:BSA-02","text":"Impossible is a self-relation without a relation to something other contained within it; pure identity would not be completion, but abstraction without generative force.","refs":["CH_GB18_DUFR:SNX4","CH_GB18_DUFR:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_13:XD-01","text":"The critique of formal idealism receives its positive logical grounding: only a negation that preserves and retracts its other can sublate finitude rather than merely rename it.","refs":["CL_GB18_13:GA-02","CL_GB18_13:GA-03","CL_GB18_13:GA-05","CH_GB18_AN_5:D7","CH_GB18_DFRA:SD2"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_13:XD-02","text":"Determinate being (Daseyn) becomes the mediating link between the universal non-absoluteness of the finite and the concrete self-relation of Being-for-self (Fürsichseyn): it is differentiated, but not external.","refs":["CL_GB18_13:GA-01","CL_GB18_13:GA-04","CL_GB18_13:GA-06","CH_GB18_DUFR:A5","CH_GB18_DUFR:A6"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_13:XD-03","text":"The transformation of Being-for-Other (Seyn-für-Anderes) into Being-for-One (Seyn-für-Eines) shows that ideality is not a subjectivization of the world, but the reorganization of relation as immanent determinacy.","refs":["CL_GB18_13:GA-02","CL_GB18_13:GA-06","CH_GB18_AN_5:NX5","CH_GB18_DUFR:ME3"],"deep_refs":[],"trace_type":"Composite.","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_13:BSD-01","text":"Reality is not distributed between objective being and subjective representation, but determined as graduated mediation, in which immediacy, difference, and self-relation constitute different states of the same movement.","refs":["CH_GB18_AN_5:ME5","CH_GB18_DUFR:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:BSD-02","text":"The question of idealism and realism is replaced by a stricter question: whether and how a determinacy can contain its other as a moment of its own truth.","refs":["CH_GB18_AN_5:ME1","CH_GB18_DUFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:BSD-03","text":"The completion of a category becomes systematically legible as transition: what asserts itself as absolute determinacy produces, through its immanent negativity, a further order.","refs":["CH_GB18_DFRA:SD5","CH_GB18_DFRA:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_13:RLE-01","text":"The principal loop is: finitude posits limit, limit posits negation, negation negates its external shape, and the return into itself preserves the delimited as an ideal moment.","refs":["CH_GB18_DFRA:A9","CH_GB18_DUFR:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:RLE-02","text":"The cluster's attractor is the concrete unity in which neither immediate being nor otherness disappears, but both lose their status as independent ultimate instances.","refs":["CH_GB18_AN_5:A7","CH_GB18_DUFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:RLE-03","text":"The escalation leads from the critique of a false opposition through the retraction of otherness to the surpassing of the qualitative into quantity.","refs":["CH_GB18_AN_5:NX8","CH_GB18_DFRA:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_13:FGS-B01","text":"Absolutely posited finite → demonstration of its dependence and mediation → determination of its ideality as a non-independent moment.","refs":["CH_GB18_AN_5:FGS1","CH_GB18_AN_5:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:FGS-B02","text":"Immediate negation → determinate being (Daseyn) as finite difference → posited negation of negation → Being-for-self (Fürsichseyn) as simple self-relation.","refs":["CH_GB18_DFRA:FGS1","CH_GB18_DFRA:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:FGS-B03","text":"Being-for-self (Fürsichseyn) → One → plurality → repulsion and attraction → retraction of the other → transition from qualitative self-relation into quantity.","refs":["CH_GB18_DFRA:FGS3","CH_GB18_DFRA:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_13:AFM-B01","text":"Finitude as purported absolute → invalidation of independent reality → ideal positing as mediated dependence.","refs":["CH_GB18_AN_5:AF1","CH_GB18_AN_5:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:AFM-B02","text":"Mediated finitude → determinate being (Daseyn) as difference → negation of negation → Being-for-self (Fürsichseyn) as return into itself.","refs":["CH_GB18_DFRA:AF1","CH_GB18_DFRA:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:AFM-B03","text":"Self-relation → production and retraction of plurality → equilibrium → surpassing of the qualitative → open categorial continuation.","refs":["CH_GB18_DFRA:AF2","CH_GB18_DFRA:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_13:MME-01","text":"The map shifts from an opposition of idealism and realism to a scale of the development of sublation, mediation, and concrete unity.","refs":["CH_GB18_AN_5:ME2","CH_GB18_AN_5:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MME-02","text":"The other is no longer mapped as an object outside a subject, but as a variable form of a relation that can be bent back into self-relation.","refs":["CH_GB18_DFRA:ME3","CH_GB18_DUFR:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MME-03","text":"Quality appears not as a stable ontological foundational layer, but as a self-surpassing order whose enactment prepares quantity.","refs":["CH_GB18_DFRA:ME5","CH_GB18_DFRA:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_13:ALT-B01","text":"Surface level — Finitude, idealism, determinate being (Daseyn), Being-for-self (Fürsichseyn), One, plurality, consciousness (Bewußtseyn), and self-consciousness (Selbstbewußtseyn) are treated.","refs":["CH_GB18_AN_5:ALT1","CH_GB18_DFRA:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ALT-B02","text":"Structural level — The supporting mechanism is the transformation of external negation into the posited negation of negation, through which difference is simultaneously preserved and disempowered.","refs":["CH_GB18_AN_5:ALT2","CH_GB18_DFRA:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ALT-B03","text":"Metastrategic level — Philosophical camps, subject-object oppositions, and rigid alternatives are replaced by the examination of whether a determinacy genuinely mediates its other within its own truth.","refs":["CH_GB18_AN_5:ALT3","CH_GB18_DUFR:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ALT-B04","text":"Ontological / Temporal level — Reality is a graduated logic of emergence, in which immediacy, difference, retraction, and transition are not temporal episodes but modes of being.","refs":["CH_GB18_DFRA:ALT4","CH_GB18_DUFR:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:ALT-B05","text":"Methodological / Performative level — The form enacts its thesis by determining concepts not through fixed definitions, but through their transitions, counter-movements, and retractions.","refs":["CH_GB18_DFRA:SD3","CH_GB18_AN_5:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_13:FL-01","text":"Being-for-self (Fürsichseyn) is determined as completed qualitative being (Seyn), but precisely because of this completion it must proceed further into plurality, equilibrium, and quantity.","refs":["CH_GB18_DFRA:MRT6","CH_GB18_DFRA:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:FL-02","text":"Concrete ideality is defended against subjective formalism, yet the transition from logical self-relation to the full concretion of spirit and idea remains undeveloped.","refs":["CH_GB18_AN_5:MRT2","CH_GB18_DFRA:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MP-01","text":"The concept of ideality mutates as soon as it becomes, from the criterion of the non-absoluteness of the finite, the positive unity of a whole with its sublated moments.","refs":["CH_GB18_AN_5:A2","CH_GB18_AN_5:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MP-02","text":"Determinate being (Daseyn) mutates from the field of relative determinacy into the inner determinacy of Being-for-self (Fürsichseyn), without its difference being permitted to be completely leveled into mere identity.","refs":["CH_GB18_DFRA:A5","CH_GB18_DUFR:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_13:HSI-01","text":"Reality appears as a machine of recursive mediation, in which every apparent independence is determined through its dependence on negation, relation, and retraction.","refs":["CH_GB18_AN_5:A6","CH_GB18_DUFR:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:HSI-02","text":"The subject is not a sovereign instance outside the world, but the intensified form of a movement in which external being is ideally possessed and yet does not merely disappear.","refs":["CH_GB18_AN_5:A9","CH_GB18_DFRA:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:HSI-03","text":"Possible struggle does not consist in the annihilation of the other, but in examining whether its asserted externality becomes legible as a moment of a higher self-relation.","refs":["CH_GB18_DFRA:A16","CH_GB18_DUFR:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_13:MRT-B01","text":"The extracted axioms suffice to reconstruct the cluster movement from the non-absoluteness of the finite through determinate being (Daseyn) and Being-for-self (Fürsichseyn) to the transition into quantity.","refs":["CH_GB18_AN_5:MRT1","CH_GB18_DFRA:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MRT-B02","text":"The reconstruction remains coherent only if sublation simultaneously signifies negation, preservation, return, and loss of independent validity.","refs":["CH_GB18_DFRA:MRT4","CH_GB18_DUFR:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_13:MRT-B03","text":"The mediation between logical genesis, consciousness (Bewußtseyn), self-consciousness (Selbstbewußtseyn), and concrete ideality remains underdetermined; this gap is the central limit of the present cluster closure.","refs":["CH_GB18_DFRA:MRT7","CH_GB18_DUFR:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_13@R001","source_variant_id":"canonical:CL_GB18_13:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 37–39","context":"Anmerkung 2. · A. Das Fürsichseyn als solches. · a. Daseyn und Fürsichseyn."},"title_language_code":"en"},{"id":"CL_GB18_14","layer":"CL","title":"Chapters 40–42","order":14,"parents":["CH_GB18_BSFR","CH_GB18_AN_6","CH_GB18_CEIN"],"revision":"CL_GB18_14@R001","sha256":"dffd6fde67dddeda206fa2cb3ad98464639931d6aedf2874972e34dd9b80fe98","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_14:BAS-01","text":"Das Cluster bestimmt Idealität als Einheit, die das Endliche nicht einem Unendlichen gegenüberstellt, sondern beide als immanente Selbstbeziehung organisiert.","refs":["CH_GB18_BSFR:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-02","text":"Die Aufhebung des Andersseyns erzeugt keine leere Identität, sondern eine Beziehung, deren Anderes nur als aufgehobenes Moment der Selbstbeziehung besteht.","refs":["CH_GB18_BSFR:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-03","text":"Vollendeter Idealismus wird nicht an der Behauptung von Einheit, sondern an der Aufhebung jeder selbständigen Endlichkeit, Vielheit und Jenseitigkeit gemessen.","refs":["CH_GB18_AN_6:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-04","text":"Die philosophiegeschichtliche Kritik fungiert als Negativtest: Jedes System scheitert dort, wo die Aufhebung des Andersseyns dem Gegenstand nicht immanent wird.","refs":["CH_GB18_AN_6:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-05","text":"Die immanente Idealität schlägt in eine durch Negation vermittelte Unmittelbarkeit um und erzeugt damit nicht Ruhe, sondern die Seinsform des Fürsichseyenden.","refs":["CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-06","text":"Das Eins ist nicht der ursprüngliche Träger der Idealität, sondern deren abstrakte Erscheinungsform, in der die innere Bedeutung der negativen Selbstbeziehung verdeckt wird.","refs":["CH_GB18_CEIN:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-07","text":"Indem die Seinsform begrifflich untrennbare Momente als selbständige Bestimmungen setzt, erzeugt sie den Widerspruch zwischen gesetzter Selbständigkeit und innerer Einheit.","refs":["CH_GB18_CEIN:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-08","text":"Die Bewegung schließt nicht mit einer widerspruchsfreien Einheit, sondern mit einer rekursiven Struktur, in der die Darstellungsform den von ihr verdeckten negativen Zusammenhang erneut hervorbringt.","refs":["CH_GB18_CEIN:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_14:GA-01","text":"[Persistent] Selbstbeziehung entsteht nur als aufgehobenes Andersseyn; sie setzt kein äußeres Gegenüber voraus und erhält keines als Grund.","refs":["CH_GB18_BSFR:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-02","text":"[Persistent] Idealität ist die Einheit von Endlichem und Unendlichem sowie von Ideellem und Reellem innerhalb eines einzigen Für-Eines.","refs":["CH_GB18_BSFR:AS1","CH_GB18_AN_6:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-03","text":"[Mutating] Das Für-Eines beginnt ohne vorausgesetztes Eins und wird erst als Selbstidentität der negativen Beziehung zur Bestimmung des Eins.","refs":["CH_GB18_BSFR:A4","CH_GB18_CEIN:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-04","text":"[Attractor] Vollendete Idealität verlangt, dass Endlichkeit, Vielheit und Unendlichkeit nicht außerhalb der Selbstbeziehung fortbestehen.","refs":["CH_GB18_AN_6:A7","CH_GB18_AN_6:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-05","text":"[Emergent] Unmittelbarkeit ist kein voraussetzungsloser Anfang, sondern die durch Negation erzeugte Form einer bereits vermittelten Einheit.","refs":["CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-06","text":"[Terminal] Das Eins ist die abstrakte Grenze, in welcher negative Selbstbeziehung als unmittelbares Seyn erscheint und ihren eigenen Begriff verdeckt.","refs":["CH_GB18_CEIN:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-07","text":"[Mutating] Widerspruch entsteht notwendig, sobald die Form des Seyns Momente als selbständig setzt, die begrifflich untrennbar bleiben.","refs":["CH_GB18_CEIN:A13","CH_GB18_CEIN:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-08","text":"[Attractor] Ein endgültiges Außen der Einheit ist unzulässig, weil jedes fortdauernde Ansichsein die Idealität wieder in Dualismus zurückfallen ließe.","refs":["CH_GB18_AN_6:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-09","text":"[Emergent] Der Zweier und die Vielheit sind nicht äußeres Material, sondern innere Folgen der Verdopplung der Negation innerhalb des Eins.","refs":["CH_GB18_CEIN:D4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_14:RMD-01","text":"Das Andersseyn behält seine Funktion als Negativbegriff, mutiert jedoch von der ausgeschlossenen äußeren Grenze zum inneren Restbestand, an dem unvollendete Idealität und abstrakte Unmittelbarkeit sichtbar werden.","refs":["CH_GB18_BSFR:AS2","CH_GB18_AN_6:NX6","CH_GB18_CEIN:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-02","text":"Das Seyn-für-Eines verschiebt sich von einer Bestimmung ohne vorhandenes Eins zu der Form, in der das Eins als abstrakte Selbstidentität hervorgebracht wird.","refs":["CH_GB18_BSFR:A4","CH_GB18_CEIN:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-03","text":"Idealität kehrt zunächst als untrennbare Einheit wieder, wird dann zum Prüfmaßstab der Philosophiegeschichte und schließlich in die negative Struktur der Unmittelbarkeit absorbiert.","refs":["CH_GB18_BSFR:AS6","CH_GB18_AN_6:SD2","CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-04","text":"Das Reelle verliert die Funktion eines Gegenprinzips zum Ideellen und erscheint als Geltungsform derselben Selbstbeziehung, die im Seyn als scheinbare Selbständigkeit ausgestellt wird.","refs":["CH_GB18_AN_6:A3","CH_GB18_CEIN:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-05","text":"Unendlichkeit mutiert von der Einheit des Endlichen mit dem Unendlichen zum Kriterium gegen jede unbewegte Einheit und gegen jeden unendlichen Progress.","refs":["CH_GB18_AN_6:A4","CH_GB18_AN_6:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-06","text":"Negation erweitert sich von der Aufhebung des äußeren Andersseyns zur verdoppelten Negation, aus der Identität, Gegensatz und Zweier zugleich hervorgehen.","refs":["CH_GB18_BSFR:D1","CH_GB18_CEIN:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-07","text":"Der Restbestand des Anderen mutiert vom Fehler unvollendeter Idealismen zur produktiven Widerspruchsform, durch die die Darstellung ihren eigenen Begriff überschreitet.","refs":["CH_GB18_AN_6:AF6","CH_GB18_CEIN:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_14:CGD-01","text":"Die Bestimmungen von Geist, Gott und Selbstbewusstsein bleiben lokale Exemplifikationen; auf Clusterebene zählt allein ihr strukturelles Kriterium, nur für sich selbst zu sein.","refs":["CH_GB18_AN_6:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:CGD-02","text":"Die einzelnen Lehren von Eleaten, Spinoza, Malebranche, Leibniz, Kant und Fichte bleiben lokale Prüfkonfigurationen; übergeordnet wird ihre gemeinsame Form als Fortbestand äußerlicher Negativität.","refs":["CH_GB18_AN_6:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:CGD-03","text":"Die einzelnen Momente von Negation, Zweier, Identität und Gegensatz bleiben als kategoriale Detailglieder lokal, skalieren aber zur allgemeinen Regel, dass abstrakte Setzung ihr Gegentheil erzeugt.","refs":["CH_GB18_CEIN:FGS4","CH_GB18_CEIN:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:CGD-04","text":"Auf Clusterebene wird die Unterscheidung zwischen Fürsichseyn und Seyn-für-Eines nicht als bloßer Kategorienunterschied bewahrt, sondern als Transformationsgesetz von Selbstbeziehung in Unmittelbarkeit.","refs":["CH_GB18_CEIN:AS1","CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:CGD-05","text":"Unterbestimmt bleibt die positive Erzeugung der Vielheit aus der absoluten Idealität; der Cluster rekonstruiert die Notwendigkeit ihres Auftretens, nicht ihre weitere vollständige Entwicklung.","refs":["CH_GB18_AN_6:MRT3","CH_GB18_CEIN:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:CGD-06","text":"Die aktuelle Ebene verschiebt die lokale Schwierigkeit des Eins in eine globale Einsicht: Widerspruch ist der notwendige Übergang zwischen begrifflicher Einheit und ihrer seyenden Darstellung.","refs":["CH_GB18_CEIN:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_14:GNX-01","text":"Ausgeschlossen wird eine Selbstbeziehung, die sich durch die Abweisung eines bleibend äußeren Anderen konstituiert.","refs":["CH_GB18_BSFR:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GNX-02","text":"Ausgeschlossen wird ein einseitiger Idealismus, der ein selbständig Reelles dem Ideellen gegenüberstehen lässt.","refs":["CH_GB18_AN_6:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GNX-03","text":"Ausgeschlossen wird eine abstrakte Einheit, die Bestimmtheit nur tilgt, statt Negativität als eigene Bewegung hervorzubringen.","refs":["CH_GB18_AN_6:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GNX-04","text":"Ausgeschlossen wird Vermittlung durch ein äußerliches Drittes, weil sie Vielheit koordiniert, ohne sie als innere Differenz der Einheit zu bestimmen.","refs":["CH_GB18_AN_6:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GNX-05","text":"Ausgeschlossen wird reine positive Unmittelbarkeit, weil das Fürsichseyn nur als negative Selbstbeziehung unmittelbar sein kann.","refs":["CH_GB18_CEIN:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GNX-06","text":"Ausgeschlossen wird eine stabile Einseitigkeit, weil jede abstrakt gesetzte Bestimmung ihr eigenes Gegentheil mitsetzt.","refs":["CH_GB18_CEIN:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_14:DBN-01","text":"Falsch sein muss die Annahme, dass ein schlechthin selbständiges endliches Daseyn mit vollendeter Idealität vereinbar wäre.","refs":["CH_GB18_AN_6:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:DBN-02","text":"Falsch sein muss die Annahme, Einheit könne Differenz nur faktisch, schöpferisch oder vorgestelltermaßen hervorbringen, ohne sie begrifflich zu erzeugen.","refs":["CH_GB18_AN_6:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:DBN-03","text":"Falsch sein muss die Annahme, Seyn oder Unmittelbarkeit bilde ein vornegatives Substrat, auf dem Selbstbeziehung erst nachträglich operiert.","refs":["CH_GB18_CEIN:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:DBN-04","text":"Falsch sein muss die Annahme, begriffliche Momente könnten als selbständige Inhalte fortbestehen, ohne die Einheit zu zerstören, aus der sie hervorgegangen sind.","refs":["CH_GB18_CEIN:DNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_14:BSA-01","text":"Nicht verfügbar ist ein ursprüngliches Eins, das vor der Negation läge und deren vermittelnde Arbeit nicht bereits in sich enthielte.","refs":["CH_GB18_CEIN:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BSA-02","text":"Nicht verfügbar ist ein unassimilierbares Außen, weil jede Außenposition entweder als Restdualismus fortdauert oder als inneres Moment der Selbstbeziehung zurückkehrt.","refs":["CH_GB18_AN_6:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BSA-03","text":"Nicht verfügbar ist eine widerspruchsfreie Entwicklung, die Momente auseinanderlegt, ohne eben dadurch ihren Zusammenhang erneut erzwingen zu müssen.","refs":["CH_GB18_CEIN:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BSA-04","text":"Nicht verfügbar ist ein äußerer Beobachterstandpunkt, für den Sein und dasjenige, für welches es ist, als endgültig getrennte Seiten bestehen könnten.","refs":["CH_GB18_AN_6:AS1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_14:XD-01","text":"Der Maßstab vollendeter Idealität macht jede bleibende Selbständigkeit des Endlichen zum Nachweis, dass Selbstbeziehung noch durch ein äußerliches Anderes organisiert ist. ; Trace Type — Composite","refs":["CL_GB18_14:GA-01","CL_GB18_14:GA-04","CH_GB18_AN_6:A7","CH_GB18_BSFR:NX2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:XD-02","text":"Der Übergang zum Eins widerlegt ruhende Selbstidentität: Die Ausschaltung des äußeren Anderen sedimentiert in einer unmittelbaren Form, welche Differenz als inneren Gegensatz reproduziert. ; Trace Type — Tension","refs":["CL_GB18_14:GA-01","CL_GB18_14:GA-05","CL_GB18_14:GA-06","CH_GB18_BSFR:AS5","CH_GB18_CEIN:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:XD-03","text":"Vielheit kann weder als unabhängig vorhandenes Material noch als äußere Koordination gelten, sondern nur als Differenzmodus, den die Verdopplung der Negation im Eins hervorbringt. ; Trace Type — Composite","refs":["CL_GB18_14:GA-04","CL_GB18_14:GA-09","CH_GB18_AN_6:A10","CH_GB18_CEIN:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:XD-04","text":"Die Gleichgeltung von Ideellem und Reellem verhindert, Idealität als Weltverneinung zu lesen, und bestimmt Realität als interne Geltungsform derselben Selbstbeziehung. ; Trace Type — Composite","refs":["CL_GB18_14:GA-02","CL_GB18_14:GA-05","CH_GB18_AN_6:A3","CH_GB18_CEIN:D2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:XD-05","text":"Der Widerspruch markiert nicht bloß eine Fehlform, sondern den Punkt, an dem verselbständigte Darstellungsmomente auf ihre begriffliche Untrennbarkeit zurückverwiesen werden. ; Trace Type — Tension","refs":["CL_GB18_14:GA-07","CH_GB18_CEIN:AS6","CH_GB18_CEIN:SD5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_14:BSD-01","text":"Realität erhält den Status einer Selbstvermittlung: Seyn ist nicht ontologischer Untergrund, sondern unmittelbare Gestalt einer durch Negation hervorgebrachten Einheit.","refs":["CL_GB18_14:GA-01","CL_GB18_14:GA-05","CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:BSD-02","text":"Philosophische Systeme werden nicht nach ihrem Einheitsbekenntnis, sondern nach ihren jeweiligen Regimen unaufgehobener Negativität klassifiziert.","refs":["CL_GB18_14:GA-04","CL_GB18_14:GA-08","CH_GB18_AN_6:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:BSD-03","text":"Das Subjekt ist keine Instanz, die einem äußeren Objekt gegenübersteht, sondern die Selbstbeziehung, in der Bestimmendes, Bestimmtes und Für-welches ineinanderfallen.","refs":["CL_GB18_14:GA-01","CL_GB18_14:GA-02","CH_GB18_AN_6:A1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:BSD-04","text":"Zeit und Entwicklung erscheinen nicht als lineare Abfolge, sondern als rekursive Sedimentierung: Negation erzeugt Unmittelbarkeit, Unmittelbarkeit setzt Differenz frei, Differenz erzwingt erneute Vermittlung.","refs":["CL_GB18_14:GA-05","CL_GB18_14:GA-07","CH_GB18_CEIN:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:BSD-05","text":"Die Methode des Clusters besteht darin, in jeder behaupteten Einheit nach dem fortdauernden Rest eines äußeren Anderen zu suchen.","refs":["CL_GB18_14:GA-04","CL_GB18_14:GA-08","CH_GB18_AN_6:AF6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_14:RLE-01","text":"Die Grundschleife lautet: aufgehobenes Andersseyn erzeugt Selbstbeziehung, Selbstbeziehung erzeugt Unmittelbarkeit, Unmittelbarkeit erzeugt das Eins, und das Eins erzeugt erneut Differenz.","refs":["CH_GB18_BSFR:D1","CH_GB18_CEIN:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RLE-02","text":"Die Beseitigung des äußeren Anderen kehrt in der Seinsform als innere Verselbständigung der Momente wieder und transformiert Ausschluss in immanenten Gegensatz.","refs":["CH_GB18_BSFR:NX2","CH_GB18_CEIN:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RLE-03","text":"Immanente Idealität fungiert als Attraktor, weil jede Form abstrakter Einheit, äußerlicher Vermittlung oder bleibender Jenseitigkeit auf sie zurückverwiesen wird.","refs":["CH_GB18_AN_6:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RLE-04","text":"Die Eskalation führt von der Kritik an äußerer Relation über die Aufhebung selbständiger Endlichkeit zur Einsicht, dass auch abstrakte Identität ihren Gegensatz intern erzeugt.","refs":["CH_GB18_AN_6:A7","CH_GB18_CEIN:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RLE-05","text":"Jeder Rest eines Jenseits öffnet die Schleife erneut, weil er die Einheit wieder als unvollendete Beziehung auf ein fremdes Ansichsein erscheinen lässt.","refs":["CH_GB18_AN_6:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_14:FGS-B01","text":"Einheit von Endlichem und Unendlichem → Idealität als Selbstbeziehung → Ausschluss eines äußeren Grundes der Beziehung.","refs":["CH_GB18_BSFR:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B02","text":"Aufhebung des Andersseyns → Für-Eines ohne vorausgesetztes Eins → Identität des Ideellen mit dem, für welches es ist.","refs":["CH_GB18_BSFR:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B03","text":"Gleichgeltung von Ideellem und Reellem → Prüfmaßstab der vollendeten Idealität → Diagnose aller selbständigen Endlichkeit als Restdualismus.","refs":["CH_GB18_AN_6:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B04","text":"Negative Selbstbeziehung → Unterschiedslosigkeit → negationsbegründete Unmittelbarkeit → Fürsichseyendes.","refs":["CH_GB18_CEIN:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B05","text":"Fürsichseyendes → abstrakte Grenze → Eins → Auseinandertreten von Negation, Identität, Gegensatz und Zweier.","refs":["CH_GB18_CEIN:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B06","text":"Form des Seyns → selbständige Setzung der Momente → Fortbestand ihrer Untrennbarkeit → notwendige Zuschreibung des Gegentheils.","refs":["CH_GB18_CEIN:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B07","text":"Widerspruch → Verlust der scheinbaren Stabilität des Eins → Eröffnung weiterer begrifflicher Entwicklung statt terminaler Ruhe.","refs":["CH_GB18_CEIN:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_14:AFM-B01","text":"Einheit von Endlichem und Unendlichem → Idealität als Für-Eines ohne äußeres Gegenüber.","refs":["CH_GB18_BSFR:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B02","text":"Für-Eines ohne äußeres Gegenüber → Selbstbeziehung im aufgehobenen Andersseyn.","refs":["CH_GB18_BSFR:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B03","text":"Selbstbeziehung → Vollständigkeitstest gegen selbständige Endlichkeit, äußerliche Vielheit und bleibendes Jenseits.","refs":["CH_GB18_AN_6:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B04","text":"Vollständigkeitstest → Unmittelbarkeit als Resultat der Negation statt als ursprünglicher Anfang.","refs":["CH_GB18_CEIN:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B05","text":"Negationsbegründete Unmittelbarkeit → abstrakte Grenze des Eins.","refs":["CH_GB18_CEIN:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B06","text":"Eins → Auseinandertreten seiner Momente in der Form des Seyns.","refs":["CH_GB18_CEIN:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B07","text":"Selbständige Setzung und begriffliche Untrennbarkeit → Widerspruch als notwendige Entwicklungsform.","refs":["CH_GB18_CEIN:AF3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_14:MME-01","text":"Real und ideell werden nicht länger als Gegensätze kartiert, sondern als Momente derselben Geltung für Eines.","refs":["CH_GB18_AN_6:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MME-02","text":"Der Unterschied zwischen starken und unvollendeten Idealismen wird von ihrem Einheitsanspruch auf die Immanenz ihrer Vermittlung verlagert.","refs":["CH_GB18_AN_6:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MME-03","text":"Vielheit wird von einer Anzahl äußerer Seiender zum Prüfstein dafür umkartiert, ob Differenz aus der Einheit hervorgeht und in ihr aufgehoben bleibt.","refs":["CH_GB18_AN_6:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MME-04","text":"Unmittelbarkeit wird von einer ursprünglichen Grundlage zu einem Resultat der Negation umklassifiziert.","refs":["CH_GB18_CEIN:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MME-05","text":"Widerspruch wird von einer Störung der Darstellung zur Wirkung jener Seinsform umkartiert, die Momente als selbständig ausstellt.","refs":["CH_GB18_CEIN:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MME-06","text":"Ding-an-sich, abstrakte Substanz, prästabilierte Harmonie und unendlicher Anstoß erscheinen als unterschiedliche Gestalten eines einzigen Strukturfehlers: persistierender äußerer Negativität.","refs":["CH_GB18_AN_6:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_14:ALT-B01","text":"Auf der Oberflächenebene werden Seyn-für-Eines, Fürsichseyn, Idealität, Qualität, Realität und Eins als ineinander übergehende Bestimmungen behandelt.","refs":["CH_GB18_AN_6:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:ALT-B02","text":"Auf der Strukturebene organisiert negative Selbstbeziehung die Verteilung von Einheit, Vielheit, Vermittlung, Unmittelbarkeit und Widerspruch.","refs":["CH_GB18_CEIN:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:ALT-B03","text":"Auf der metastrategischen Ebene ersetzt der Cluster die Opposition idealistisch-realistisch durch einen Vollständigkeitstest der immanenten Aufhebung.","refs":["CH_GB18_AN_6:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:ALT-B04","text":"Auf ontologischer und temporaler Ebene ist Seyn die unmittelbare Form einer erzeugten Einheit, deren Entwicklung ihren eigenen negativen Grund wieder freilegt.","refs":["CH_GB18_CEIN:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:ALT-B05","text":"Auf methodologischer und performativer Ebene vollzieht die Darstellung selbst die problematische Setzung getrennter Momente und macht dadurch ihren Widerspruch sichtbar.","refs":["CH_GB18_CEIN:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_14:FL-01","text":"Die Idealität schließt ein äußeres Anderes aus, doch ihre Darstellung muss Momente als getrennte seyende Bestimmungen setzen; diese Spannung ist produktiv und nicht aufhebbar ohne Verlust der Entwicklung.","refs":["CH_GB18_BSFR:NX2","CH_GB18_CEIN:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FL-02","text":"Die Kritik verlangt die immanente Erzeugung der Vielheit, führt deren positiven Vollzug innerhalb des Clusters jedoch nicht vollständig aus.","refs":["CH_GB18_AN_6:MRT5","CH_GB18_AN_6:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FL-03","text":"Das Reelle wird in die Idealität integriert, erscheint aber im Seyn erneut als Form scheinbarer Selbständigkeit; die Integration bleibt daher nur durch fortgesetzte Vermittlung stabil.","refs":["CH_GB18_AN_6:A3","CH_GB18_CEIN:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FL-04","text":"Die historische Kritik operiert mit einem Vollständigkeitsmaßstab, dessen eigener positiver Vollzug nicht demonstriert, sondern als notwendige Norm vorausgesetzt wird.","refs":["CH_GB18_AN_6:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MP-01","text":"Das Für-Eines mutiert vom Namen einer Beziehung ohne vorhandenes Eins zur abstrakten Selbstidentität, die im Eins erscheint.","refs":["CH_GB18_BSFR:NX3","CH_GB18_CEIN:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MP-02","text":"Negation mutiert von der Nichtäußerlichkeit der Grenze zur produktiven Verdopplung, durch welche Zweier und Gegensatz hervorgehen.","refs":["CH_GB18_BSFR:NX1","CH_GB18_CEIN:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MP-03","text":"Idealität mutiert von der Einheit des Fürsichseyns und Für-Eines-Seins zum kritischen Kriterium, das alle Formen persistierender Selbständigkeit diagnostiziert.","refs":["CH_GB18_BSFR:A11","CH_GB18_AN_6:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MP-04","text":"Widerspruch mutiert vom Zeichen unvollendeter äußerer Vermittlung zur notwendigen Wirkung der Darstellung des Eins in der Form des Seyns.","refs":["CH_GB18_AN_6:SD3","CH_GB18_CEIN:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_14:HSI-01","text":"Die Realität erscheint als Maschine negativer Selbstbeziehung, die ihre Einheit nur erhält, indem sie Unmittelbarkeit, Differenz und Widerspruch aus sich erzeugt.","refs":["CH_GB18_CEIN:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:HSI-02","text":"Das Subjekt erscheint nicht als Besitzer einer Beziehung zu einem Gegenstand, sondern als Moment einer Idealität, die selbst das ist, was für sie ist.","refs":["CH_GB18_BSFR:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:HSI-03","text":"Zeit erscheint als rückläufige Erzeugung: Was als unmittelbarer Anfang erscheint, erweist sich als nachträgliches Resultat der Negation.","refs":["CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:HSI-04","text":"Möglich bleibt kein Entkommen in ein Außen, sondern nur die Navigation derjenigen Reste von Jenseitigkeit, die als unvollendete Selbstvermittlung zu transformieren sind.","refs":["CH_GB18_AN_6:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_14:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die zentrale Bewegung von Idealität über negationsbegründete Unmittelbarkeit bis zum widersprüchlichen Eins zu rekonstruieren.","refs":["CH_GB18_CEIN:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MRT-B02","text":"Die Rekonstruktion ist kohärent, sofern Selbstbeziehung, Aufhebung des Andersseyns, Unmittelbarkeit und Widerspruch als aufeinander bezogene Momente einer einzigen Maschine gelesen werden.","refs":["CH_GB18_AN_6:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MRT-B03","text":"Unterbestimmt bleibt die weitere positive Entwicklung des Eins sowie die vollständige begriffliche Erzeugung der Vielheit aus der Idealität.","refs":["CH_GB18_CEIN:MRT3","CH_GB18_AN_6:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MRT-B04","text":"Die stärkste Architektur liegt in der Ableitung, dass die Darstellungsform des Seyns selbst jene Selbständigkeit erzeugt, deren begriffliche Unhaltbarkeit sie anschließend offenlegt.","refs":["CH_GB18_CEIN:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MRT-B05","text":"Die axiomatische Reduktion widersteht dort der vollständigen Schließung, wo die philosophiegeschichtlichen Fälle und die begriffliche Entwicklung nur gemeinsam den Maßstab immanenter Idealität konkretisieren.","refs":["CH_GB18_AN_6:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121107248719Z_3874d5e7","language_code":"en","language_name":"English","title":"Chapters 40–42","source_sha256":"dffd6fde67dddeda206fa2cb3ad98464639931d6aedf2874972e34dd9b80fe98","sha256":"e086974a028c7f3bcd557e4a389917eb0e91bf1010e14fd79db786969cfda2dd","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:11:07.251119+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_14:BAS-01","text":"The cluster determines ideality as a unity that does not set the finite over against an infinite, but organizes both as immanent self-relation.","refs":["CH_GB18_BSFR:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-02","text":"The sublation of otherness produces no empty identity, but a relation whose other exists only as a sublated moment of self-relation.","refs":["CH_GB18_BSFR:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-03","text":"Complete idealism is measured not by the assertion of unity, but by the sublation of every self-subsistent finitude, multiplicity, and beyond.","refs":["CH_GB18_AN_6:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-04","text":"The critique of the history of philosophy functions as a negative test: every system fails where the sublation of otherness does not become immanent to the object.","refs":["CH_GB18_AN_6:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-05","text":"Immanent ideality turns into an immediacy mediated through negation and thereby produces not repose, but the form of being of being-for-self.","refs":["CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-06","text":"The One is not the original bearer of ideality, but its abstract form of appearance, in which the inner significance of negative self-relation is concealed.","refs":["CH_GB18_CEIN:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-07","text":"Insofar as the form of being posits conceptually inseparable moments as self-subsistent determinations, it produces the contradiction between posited self-subsistence and inner unity.","refs":["CH_GB18_CEIN:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BAS-08","text":"The movement does not conclude with a contradiction-free unity, but with a recursive structure in which the form of presentation again brings forth the negative connection it conceals.","refs":["CH_GB18_CEIN:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_14:GA-01","text":"[Persistent] Self-relation arises only as sublated otherness; it presupposes no external counterpart and retains none as its ground.","refs":["CH_GB18_BSFR:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-02","text":"[Persistent] Ideality is the unity of finite and infinite, as well as of ideal and real, within a single being-for-one.","refs":["CH_GB18_BSFR:AS1","CH_GB18_AN_6:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-03","text":"[Mutating] Being-for-one begins without a presupposed One and becomes the determination of the One only as the self-identity of the negative relation.","refs":["CH_GB18_BSFR:A4","CH_GB18_CEIN:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-04","text":"[Attractor] Complete ideality requires that finitude, multiplicity, and infinity do not persist outside self-relation.","refs":["CH_GB18_AN_6:A7","CH_GB18_AN_6:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-05","text":"[Emergent] Immediacy is not a presuppositionless beginning, but the form of an already mediated unity produced through negation.","refs":["CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-06","text":"[Terminal] The One is the abstract limit in which negative self-relation appears as immediate being and conceals its own concept.","refs":["CH_GB18_CEIN:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-07","text":"[Mutating] Contradiction necessarily arises as soon as the form of being posits as self-subsistent moments that remain conceptually inseparable.","refs":["CH_GB18_CEIN:A13","CH_GB18_CEIN:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-08","text":"[Attractor] A final outside of unity is inadmissible, because every enduring being-in-itself would cause ideality to relapse into dualism.","refs":["CH_GB18_AN_6:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GA-09","text":"[Emergent] Twoness and multiplicity are not external material, but inner consequences of the doubling of negation within the One.","refs":["CH_GB18_CEIN:D4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_14:RMD-01","text":"Otherness retains its function as a negative concept, but mutates from the excluded external limit into the inner remainder in which incomplete ideality and abstract immediacy become visible.","refs":["CH_GB18_BSFR:AS2","CH_GB18_AN_6:NX6","CH_GB18_CEIN:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-02","text":"Being-for-one shifts from a determination without an existing One to the form in which the One is produced as abstract self-identity.","refs":["CH_GB18_BSFR:A4","CH_GB18_CEIN:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-03","text":"Ideality initially recurs as inseparable unity, then becomes the criterion of the history of philosophy, and finally is absorbed into the negative structure of immediacy.","refs":["CH_GB18_BSFR:AS6","CH_GB18_AN_6:SD2","CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-04","text":"The real loses the function of a counter-principle to the ideal and appears as the form of validity of the same self-relation that is exhibited in being as apparent self-subsistence.","refs":["CH_GB18_AN_6:A3","CH_GB18_CEIN:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-05","text":"Infinity mutates from the unity of the finite with the infinite into the criterion against every motionless unity and against every infinite progress.","refs":["CH_GB18_AN_6:A4","CH_GB18_AN_6:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-06","text":"Negation expands from the sublation of external otherness to doubled negation, from which identity, opposition, and twoness arise simultaneously.","refs":["CH_GB18_BSFR:D1","CH_GB18_CEIN:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RMD-07","text":"The remainder of the other mutates from the error of incomplete idealisms into the productive form of contradiction through which presentation exceeds its own concept.","refs":["CH_GB18_AN_6:AF6","CH_GB18_CEIN:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_14:CGD-01","text":"The determinations of spirit, God, and self-consciousness remain local exemplifications; at the cluster level, only their structural criterion, of being only for themselves, counts.","refs":["CH_GB18_AN_6:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:CGD-02","text":"The individual doctrines of the Eleatics, Spinoza, Malebranche, Leibniz, Kant, and Fichte remain local test configurations; at the higher level, their common form is the persistence of external negativity.","refs":["CH_GB18_AN_6:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:CGD-03","text":"The individual moments of negation, twoness, identity, and opposition remain local as categorical detailed members, but scale into the general rule that abstract positing produces its opposite.","refs":["CH_GB18_CEIN:FGS4","CH_GB18_CEIN:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:CGD-04","text":"At the cluster level, the distinction between being-for-self and being-for-one is preserved not as a mere categorical difference, but as the law of transformation of self-relation into immediacy.","refs":["CH_GB18_CEIN:AS1","CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:CGD-05","text":"The positive production of multiplicity from absolute ideality remains underdetermined; the cluster reconstructs the necessity of its appearance, not its further complete development.","refs":["CH_GB18_AN_6:MRT3","CH_GB18_CEIN:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:CGD-06","text":"The current level shifts the local difficulty of the One into a global insight: contradiction is the necessary transition between conceptual unity and its presentation as being.","refs":["CH_GB18_CEIN:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_14:GNX-01","text":"Excluded is a self-relation that constitutes itself through the rejection of an enduringly external other.","refs":["CH_GB18_BSFR:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GNX-02","text":"Excluded is a one-sided idealism that allows a self-subsistent real to stand opposed to the ideal.","refs":["CH_GB18_AN_6:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GNX-03","text":"Excluded is an abstract unity that merely effaces determinacy instead of bringing forth negativity as its own movement.","refs":["CH_GB18_AN_6:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GNX-04","text":"Excluded is mediation through an external third, because it coordinates multiplicity without determining it as an inner difference of unity.","refs":["CH_GB18_AN_6:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GNX-05","text":"Excluded is pure positive immediacy, because being-for-self can be immediate only as negative self-relation.","refs":["CH_GB18_CEIN:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:GNX-06","text":"Excluded is a stable one-sidedness, because every abstractly posited determination co-posites its own opposite.","refs":["CH_GB18_CEIN:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_14:DBN-01","text":"False must be the assumption that an absolutely self-subsistent finite existence would be compatible with complete ideality.","refs":["CH_GB18_AN_6:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:DBN-02","text":"False must be the assumption that unity could bring forth difference only factually, creatively, or representationally, without producing it conceptually.","refs":["CH_GB18_AN_6:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:DBN-03","text":"False must be the assumption that being or immediacy forms a pre-negative substrate upon which self-relation operates only subsequently.","refs":["CH_GB18_CEIN:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:DBN-04","text":"False must be the assumption that conceptual moments could persist as self-subsistent contents without destroying the unity from which they emerged.","refs":["CH_GB18_CEIN:DNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_14:BSA-01","text":"Unavailable is an original One that would lie prior to negation and would not already contain within itself its mediating work.","refs":["CH_GB18_CEIN:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BSA-02","text":"Unavailable is an unassimilable outside, because every external position either persists as residual dualism or returns as an inner moment of self-relation.","refs":["CH_GB18_AN_6:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BSA-03","text":"Unavailable is a contradiction-free development that separates moments without thereby having again to compel their connection.","refs":["CH_GB18_CEIN:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:BSA-04","text":"Unavailable is an external observer standpoint for which being and that for which it is could exist as finally separated sides.","refs":["CH_GB18_AN_6:AS1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_14:XD-01","text":"The criterion of complete ideality makes every enduring self-subsistence of the finite proof that self-relation is still organized through an external other. ; Trace Type — Composite","refs":["CL_GB18_14:GA-01","CL_GB18_14:GA-04","CH_GB18_AN_6:A7","CH_GB18_BSFR:NX2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:XD-02","text":"The transition to the One refutes quiescent self-identity: the elimination of the external other sediments into an immediate form that reproduces difference as inner opposition. ; Trace Type — Tension","refs":["CL_GB18_14:GA-01","CL_GB18_14:GA-05","CL_GB18_14:GA-06","CH_GB18_BSFR:AS5","CH_GB18_CEIN:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:XD-03","text":"Multiplicity can count neither as independently existing material nor as external coordination, but only as a mode of difference that the doubling of negation in the One brings forth. ; Trace Type — Composite","refs":["CL_GB18_14:GA-04","CL_GB18_14:GA-09","CH_GB18_AN_6:A10","CH_GB18_CEIN:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:XD-04","text":"The equal validity of ideal and real prevents reading ideality as world-negation and determines reality as the internal form of validity of the same self-relation. ; Trace Type — Composite","refs":["CL_GB18_14:GA-02","CL_GB18_14:GA-05","CH_GB18_AN_6:A3","CH_GB18_CEIN:D2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:XD-05","text":"Contradiction marks not merely a defective form, but the point at which autonomized moments of presentation are referred back to their conceptual inseparability. ; Trace Type — Tension","refs":["CL_GB18_14:GA-07","CH_GB18_CEIN:AS6","CH_GB18_CEIN:SD5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_14:BSD-01","text":"Reality receives the status of self-mediation: being is not an ontological substratum, but the immediate shape of a unity brought forth through negation.","refs":["CL_GB18_14:GA-01","CL_GB18_14:GA-05","CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:BSD-02","text":"Philosophical systems are classified not according to their profession of unity, but according to their respective regimes of unsublated negativity.","refs":["CL_GB18_14:GA-04","CL_GB18_14:GA-08","CH_GB18_AN_6:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:BSD-03","text":"The subject is not an instance standing opposed to an external object, but the self-relation in which determining, determined, and that-for-which coincide.","refs":["CL_GB18_14:GA-01","CL_GB18_14:GA-02","CH_GB18_AN_6:A1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:BSD-04","text":"Time and development appear not as a linear sequence, but as recursive sedimentation: negation produces immediacy, immediacy releases difference, difference compels renewed mediation.","refs":["CL_GB18_14:GA-05","CL_GB18_14:GA-07","CH_GB18_CEIN:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_14:BSD-05","text":"The method of the cluster consists in seeking, in every asserted unity, the enduring remainder of an external other.","refs":["CL_GB18_14:GA-04","CL_GB18_14:GA-08","CH_GB18_AN_6:AF6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_14:RLE-01","text":"The basic loop is: sublated otherness produces self-relation, self-relation produces immediacy, immediacy produces the One, and the One again produces difference.","refs":["CH_GB18_BSFR:D1","CH_GB18_CEIN:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RLE-02","text":"The removal of the external other returns in the form of being as the inner autonomization of the moments and transforms exclusion into immanent opposition.","refs":["CH_GB18_BSFR:NX2","CH_GB18_CEIN:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RLE-03","text":"Immanent ideality functions as an attractor because every form of abstract unity, external mediation, or enduring beyond is referred back to it.","refs":["CH_GB18_AN_6:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RLE-04","text":"The escalation leads from the critique of external relation through the sublation of self-subsistent finitude to the insight that abstract identity too internally produces its opposition.","refs":["CH_GB18_AN_6:A7","CH_GB18_CEIN:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:RLE-05","text":"Every remainder of a beyond reopens the loop, because it makes unity appear again as an incomplete relation to an alien being-in-itself.","refs":["CH_GB18_AN_6:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_14:FGS-B01","text":"Unity of finite and infinite → ideality as self-relation → exclusion of an external ground of relation.","refs":["CH_GB18_BSFR:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B02","text":"Sublation of otherness → being-for-one without a presupposed One → identity of the ideal with that for which it is.","refs":["CH_GB18_BSFR:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B03","text":"Equal validity of ideal and real → criterion of complete ideality → diagnosis of all self-subsistent finitude as residual dualism.","refs":["CH_GB18_AN_6:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B04","text":"Negative self-relation → difference-lessness → negation-grounded immediacy → being-for-self.","refs":["CH_GB18_CEIN:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B05","text":"Being-for-self → abstract limit → One → divergence of negation, identity, opposition, and twoness.","refs":["CH_GB18_CEIN:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B06","text":"Form of being → self-subsistent positing of the moments → persistence of their inseparability → necessary attribution of the opposite.","refs":["CH_GB18_CEIN:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FGS-B07","text":"Contradiction → loss of the apparent stability of the One → opening of further conceptual development instead of terminal repose.","refs":["CH_GB18_CEIN:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_14:AFM-B01","text":"Unity of finite and infinite → ideality as being-for-one without an external counterpart.","refs":["CH_GB18_BSFR:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B02","text":"Being-for-one without an external counterpart → self-relation in sublated otherness.","refs":["CH_GB18_BSFR:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B03","text":"Self-relation → completeness test against self-subsistent finitude, external multiplicity, and enduring beyond.","refs":["CH_GB18_AN_6:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B04","text":"Completeness test → immediacy as result of negation rather than as original beginning.","refs":["CH_GB18_CEIN:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B05","text":"Negation-grounded immediacy → abstract limit of the One.","refs":["CH_GB18_CEIN:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B06","text":"One → divergence of its moments in the form of being.","refs":["CH_GB18_CEIN:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:AFM-B07","text":"Self-subsistent positing and conceptual inseparability → contradiction as necessary form of development.","refs":["CH_GB18_CEIN:AF3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_14:MME-01","text":"Real and ideal are no longer mapped as opposites, but as moments of the same validity for one.","refs":["CH_GB18_AN_6:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MME-02","text":"The distinction between strong and incomplete idealisms is shifted from their claim to unity to the immanence of their mediation.","refs":["CH_GB18_AN_6:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MME-03","text":"Multiplicity is remapped from a number of external beings into the touchstone of whether difference proceeds from unity and remains sublated within it.","refs":["CH_GB18_AN_6:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MME-04","text":"Immediacy is reclassified from an original foundation into a result of negation.","refs":["CH_GB18_CEIN:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MME-05","text":"Contradiction is remapped from a disturbance of presentation into the effect of that form of being which exhibits moments as self-subsistent.","refs":["CH_GB18_CEIN:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MME-06","text":"Thing-in-itself, abstract substance, pre-established harmony, and infinite impulse appear as distinct forms of a single structural error: persistent external negativity.","refs":["CH_GB18_AN_6:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_14:ALT-B01","text":"At the surface level, being-for-one, being-for-self, ideality, quality, reality, and One are treated as determinations passing over into one another.","refs":["CH_GB18_AN_6:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:ALT-B02","text":"At the structural level, negative self-relation organizes the distribution of unity, multiplicity, mediation, immediacy, and contradiction.","refs":["CH_GB18_CEIN:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:ALT-B03","text":"At the metastrategic level, the cluster replaces the idealist-realist opposition with a completeness test of immanent sublation.","refs":["CH_GB18_AN_6:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:ALT-B04","text":"At the ontological and temporal level, being is the immediate form of a produced unity whose development again lays bare its own negative ground.","refs":["CH_GB18_CEIN:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:ALT-B05","text":"At the methodological and performative level, presentation itself enacts the problematic positing of separate moments and thereby makes its contradiction visible.","refs":["CH_GB18_CEIN:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_14:FL-01","text":"Ideality excludes an external other, yet its presentation must posit moments as separate determinations of being; this tension is productive and cannot be sublated without loss of development.","refs":["CH_GB18_BSFR:NX2","CH_GB18_CEIN:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FL-02","text":"The critique requires the immanent production of multiplicity, but does not fully carry out its positive enactment within the cluster.","refs":["CH_GB18_AN_6:MRT5","CH_GB18_AN_6:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FL-03","text":"The real is integrated into ideality, but reappears in being as a form of apparent self-subsistence; the integration therefore remains stable only through continued mediation.","refs":["CH_GB18_AN_6:A3","CH_GB18_CEIN:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:FL-04","text":"Historical critique operates with a criterion of completeness whose own positive enactment is not demonstrated, but presupposed as a necessary norm.","refs":["CH_GB18_AN_6:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MP-01","text":"Being-for-one mutates from the name of a relation without an existing One into the abstract self-identity that appears in the One.","refs":["CH_GB18_BSFR:NX3","CH_GB18_CEIN:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MP-02","text":"Negation mutates from the non-externality of the limit into the productive doubling through which twoness and opposition arise.","refs":["CH_GB18_BSFR:NX1","CH_GB18_CEIN:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MP-03","text":"Ideality mutates from the unity of being-for-self and being-for-one into the critical criterion that diagnoses all forms of persistent self-subsistence.","refs":["CH_GB18_BSFR:A11","CH_GB18_AN_6:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MP-04","text":"Contradiction mutates from the sign of incomplete external mediation into the necessary effect of the presentation of the One in the form of being.","refs":["CH_GB18_AN_6:SD3","CH_GB18_CEIN:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_14:HSI-01","text":"Reality appears as a machine of negative self-relation that maintains its unity only by producing immediacy, difference, and contradiction from itself.","refs":["CH_GB18_CEIN:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:HSI-02","text":"The subject appears not as the possessor of a relation to an object, but as a moment of an ideality that itself is what it is for.","refs":["CH_GB18_BSFR:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:HSI-03","text":"Time appears as retroactive production: what appears as an immediate beginning proves to be a subsequent result of negation.","refs":["CH_GB18_CEIN:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:HSI-04","text":"No escape into an outside remains possible, but only the navigation of those remainders of beyondness that are to be transformed as incomplete self-mediation.","refs":["CH_GB18_AN_6:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_14:MRT-B01","text":"The extracted axioms suffice to reconstruct the central movement from ideality through negation-grounded immediacy to the contradictory One.","refs":["CH_GB18_CEIN:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MRT-B02","text":"The reconstruction is coherent insofar as self-relation, sublation of otherness, immediacy, and contradiction are read as interrelated moments of a single machine.","refs":["CH_GB18_AN_6:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MRT-B03","text":"The further positive development of the One, as well as the complete conceptual production of multiplicity from ideality, remains underdetermined.","refs":["CH_GB18_CEIN:MRT3","CH_GB18_AN_6:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MRT-B04","text":"The strongest architecture lies in the derivation that the form of presentation of being itself produces that self-subsistence whose conceptual untenability it subsequently discloses.","refs":["CH_GB18_CEIN:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_14:MRT-B05","text":"The axiomatic reduction resists complete closure where the cases from the history of philosophy and conceptual development only jointly concretize the criterion of immanent ideality.","refs":["CH_GB18_AN_6:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_14@R001","source_variant_id":"canonical:CL_GB18_14:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 40–42","context":"b. Seyn-für-eines. · Anmerkung. · c. Eins."},"title_language_code":"en"},{"id":"CL_GB18_15","layer":"CL","title":"Chapters 43–45","order":15,"parents":["CH_GB18_BEUV","CH_GB18_DEIS","CH_GB18_BDEU"],"revision":"CL_GB18_15@R001","sha256":"9c514442bc1482bf02b8803964b1a21fdef2c36d0f9727ad93f8633a0bda7889","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_15:SP-01","text":"Das System rekonstruiert, wie eine einfache Selbstbeziehung durch ihre eigene Setzung in Bestimmtheit, Differenz und schließlich äußerliche Gegenüberstellung übergeht.","refs":["CH_GB18_BEUV:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:SP-02","text":"Die zentrale Neubestimmung besteht darin, Unmittelbarkeit nicht als Abwesenheit von Vermittlung, sondern als gesetzte und später rückläufig vermittelte Form der Selbstbeziehung zu bestimmen.","refs":["CH_GB18_BEUV:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:SP-03","text":"Das Argument wird zu einer rekursiven Ontologie der Negation: Selbstbeziehung erzeugt Differenz, Differenz erzeugt ein Anderes, und dessen Ausschluss stabilisiert die Einheit erneut.","refs":["CH_GB18_BEUV:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:SP-04","text":"Die Bewegung ist spiralförmig und mutationsgetrieben; sie endet nicht bei reiner Identität, sondern bei einer negativen Einheit, deren Dasein aus der hervorgebrachten Äußerlichkeit von Eins und Leere entsteht.","refs":["CH_GB18_BDEU:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_15:GA-01","text":"[Persistent] Das Fürsichseyn beginnt als einfache Beziehung auf sich selbst.","refs":["CH_GB18_BEUV:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-02","text":"[Persistent] Die Beziehung auf sich ist zugleich negative Selbstbeziehung und unendliches Selbstbestimmen.","refs":["CH_GB18_BEUV:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-03","text":"[Mutating] Die Selbstbeziehung setzt ihre Momente als unmittelbare und daseiende Bestimmungen.","refs":["CH_GB18_BEUV:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-04","text":"[Emergent] Die gesetzte Unmittelbarkeit erzeugt eine Differenz, die als eigenes Anderes der Einheit erscheint.","refs":["CH_GB18_BEUV:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-05","text":"[Mutating] Die ideal gesetzte Totalität schlägt in abstrakte Realität und anschließend in reines, unveränderliches Sein um.","refs":["CH_GB18_BEUV:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-06","text":"[Emergent] Die Negation enthält einen Unterschied, der mangels eines selbständigen Anderen in die Selbstbeziehung zurückkehrt.","refs":["CH_GB18_DEIS:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-07","text":"[Emergent] Diese Rückkehr erzeugt eine vermittelte Unmittelbarkeit, in der Dasein und Idealität zusammenfallen.","refs":["CH_GB18_DEIS:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-08","text":"[Mutating] Das innerhalb des Eins gesetzte Nichts wird als Leeres zunächst intern bestimmt und danach als äußerlich gegenüberstehendes Moment gefasst.","refs":["CH_GB18_DEIS:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-09","text":"[Emergent] Eins und Leere bilden eine gesetzte Verschiedenheit auf dem gemeinsamen Boden negativer Selbstbeziehung.","refs":["CH_GB18_BDEU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-10","text":"[Terminal] Die Einheit der Momente schlägt in Dasein und äußerliche Gegenüberstellung um.","refs":["CH_GB18_BDEU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-11","text":"[Attractor] Die Einheit erhält sich, indem sie Andersheit hervorbringt, auf sie bezogen bleibt und sie aus sich ausschließt.","refs":["CH_GB18_BEUV:A18"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_15:RMD-01","text":"Das Eins bewahrt seine Identität, verändert aber seine Funktion: Es ist zunächst Selbstbeziehung, dann abstrakte Realität, reines Sein und schließlich ein relationaler Pol gegenüber dem Leeren.","refs":["CH_GB18_BDEU:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-02","text":"Die negative Selbstbeziehung kehrt funktional stabil wieder, verschiebt sich jedoch von der Bestimmung des Eins zur gemeinsamen Produktionsbasis von Eins und Leere.","refs":["CH_GB18_BDEU:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-03","text":"Unmittelbarkeit mutiert von einer scheinbar voraussetzungslosen Einfachheit zu einer gesetzten und durch Rückkehr vermittelten Form.","refs":["CH_GB18_DEIS:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-04","text":"Das Andere wird vom erzeugten Selbstbestimmen des Eins zum äußerlich erscheinenden Leeren verschoben, ohne seine immanente Herkunft zu verlieren.","refs":["CH_GB18_BDEU:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-05","text":"Das Nichts wechselt seine Valenz: Es ist zunächst ein im Eins gesetztes Moment, danach ein gegenüber dem Eins bestimmtes Dasein.","refs":["CH_GB18_BDEU:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-06","text":"Differenz wird zuerst als innere Richtungsdifferenz, dann als relationale Verschiedenheit und schließlich als Äußerlichkeit der Momente organisiert.","refs":["CH_GB18_DEIS:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-07","text":"Ausschluss verschwindet als bloße Endoperation und wird zum Attraktor, der die Einheit sowohl erzeugt als auch erhält.","refs":["CH_GB18_BEUV:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-08","text":"Die Kategorie des Daseins entsteht erst, nachdem interne Negation in gegenüberstehende Bestimmungen umgeschlagen ist.","refs":["CH_GB18_BDEU:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_15:CGD-01","text":"Die lokale Bestimmung des Eins als reines Sein, Unveränderlichkeit und Leere bleibt eine Binnencharakteristik der entsprechenden Einheit; auf Cluster-Ebene wird daraus die Funktion einer negativen Stabilisierung.","refs":["CH_GB18_DEIS:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:CGD-02","text":"Die einzelne Ableitung des Anderen aus dem Selbstbestimmen skaliert nach oben, weil sie mit der späteren Gegenüberstellung von Eins und Leere eine allgemeine Produktionsregel der Differenz bildet.","refs":["CH_GB18_BEUV:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:CGD-03","text":"Die lokale Negation äußerer Kategorien wird auf Cluster-Ebene zur Ausschlussbedingung einer Ontologie, in der Bestimmtheit nicht von äußerer Relation abhängt.","refs":["CH_GB18_DEIS:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:CGD-04","text":"Die lokale Unterscheidung zwischen Insichsein und gesetztem Nichts wird auf höherer Ebene zur Oszillation zwischen innerem Moment und äußerem Gegenüber.","refs":["CH_GB18_DEIS:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:CGD-05","text":"Erst das Zusammenwirken der Einheiten zeigt, dass Dasein keine lokale Grundkategorie, sondern das Ergebnis einer über mehrere Bestimmungen verteilten Äußerlichwerdung ist.","refs":["CH_GB18_BDEU:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_15:GNX-01","text":"Das System weist ein isoliertes Eins zurück, dessen Einheit ohne gesetzte Differenz bestehen könnte.","refs":["CH_GB18_BEUV:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GNX-02","text":"Es weist ein äußerliches Anderes zurück, das nicht aus der Selbstbestimmung des Eins hervorgegangen wäre.","refs":["CH_GB18_BEUV:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GNX-03","text":"Es weist eine reine Unmittelbarkeit zurück, die ohne innere Vermittlung und Rückkehr auskäme.","refs":["CH_GB18_DEIS:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GNX-04","text":"Es weist ein Leeres zurück, das entweder mit dem Eins identisch oder von jeder Beziehung zum Eins unabhängig wäre.","refs":["CH_GB18_BDEU:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GNX-05","text":"Es weist ein Dasein zurück, das nicht aus der Differenzierung negativer Selbstbeziehung hervorgeht.","refs":["CH_GB18_BDEU:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_15:DBN-01","text":"Das System kann nicht bestehen, wenn Einheit als positive Identität ohne Selbstunterscheidung verstanden wird.","refs":["CH_GB18_BEUV:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:DBN-02","text":"Es muss ausgeschlossen werden, dass Vermittlung ein Übergang zwischen bereits getrennten, äußerlich vorliegenden Bestimmungen ist.","refs":["CH_GB18_DEIS:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:DBN-03","text":"Es muss ausgeschlossen werden, dass Unbestimmtheit bloße Inhaltslosigkeit oder epistemische Unkenntnis bedeutet; sie fungiert als absolute Selbstbestimmtheit.","refs":["CH_GB18_DEIS:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:DBN-04","text":"Unzulässig ist ein unabhängiges Nichts, weil dadurch die gemeinsame negative Herkunft von Eins und Leere zerfiele.","refs":["CH_GB18_BDEU:DNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_15:BSA-01","text":"Unmöglich ist eine Einheit, die Andersheit nicht aus sich hervorbringen und dennoch als Einheit bestehen könnte.","refs":["CH_GB18_BEUV:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSA-02","text":"Nicht verfügbar ist eine Differenz, die dem Eins äußerlich bliebe und nicht als eigene Selbstbestimmung lesbar wäre.","refs":["CH_GB18_BEUV:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSA-03","text":"Versperrt ist eine Totalität, deren Selbstbezug nicht zugleich Selbstunterscheidung, Vermittlung und Ausschluss wäre.","refs":["CH_GB18_BEUV:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSA-04","text":"Die Abwesenheit von Ausschluss gilt als unzureichende Form von Einheit; die negative Einheit wird um diese Unmöglichkeit herum organisiert.","refs":["CH_GB18_BEUV:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_15:XD-01","text":"Die Unmittelbarkeit der Selbstbeziehung erzeugt die Differenz, die sie zunächst auszuschließen scheint, und bereitet dadurch die Gegenüberstellung von Eins und Leere vor.","refs":["CL_GB18_15:GA-01","CL_GB18_15:GA-03","CL_GB18_15:GA-04","CH_GB18_BEUV:SD1","CH_GB18_BDEU:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_15:XD-02","text":"Die scheinbare Zweiheit von Eins und Leere ist keine ursprüngliche Zweiheit, sondern die Äußerlichwerdung einer gemeinsamen negativen Selbstbeziehung.","refs":["CL_GB18_15:GA-08","CL_GB18_15:GA-09","CL_GB18_15:GA-10","CH_GB18_BDEU:SD1","CH_GB18_BDEU:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_15:XD-03","text":"Der Widerspruch zwischen der Beziehungsfreiheit des Eins und seiner Beziehung zum Leeren markiert einen Maßstabswechsel: Beziehung wird zunächst ausgeschlossen, dann als innere Hervorbringung rekonstruiert.","refs":["CL_GB18_15:GA-05","CL_GB18_15:GA-06","CL_GB18_15:GA-09","CH_GB18_DEIS:A3","CH_GB18_BDEU:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_15:XD-04","text":"Dasein entsteht erst durch die Differenzierung der negativen Einheit und ist daher weder vorausgesetzte Grundlage noch äußerlich hinzugefügte Bestimmung.","refs":["CL_GB18_15:GA-09","CL_GB18_15:GA-10","CH_GB18_BDEU:SD3","CH_GB18_BDEU:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_15:XD-05","text":"Das Leere fungiert zugleich als im Eins gesetztes Nichts und als gegenüberstehendes Dasein; diese Doppelstellung ist ein struktureller Übergang, kein bloßer Widerspruch.","refs":["CL_GB18_15:GA-08","CL_GB18_15:GA-10","CH_GB18_DEIS:A12","CH_GB18_BDEU:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_15:XD-06","text":"Ausschluss ist nicht das Ende der Bewegung, sondern die Operation, durch die die negative Einheit ihre Realität gewinnt und erneut auf sich bezogen wird.","refs":["CL_GB18_15:GA-10","CL_GB18_15:GA-11","CH_GB18_BEUV:SD4","CH_GB18_BEUV:D6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_15:BSD-01","text":"Das System erzeugt eine Ontologie, in der Bestimmtheit aus der Selbstorganisation von Negation hervorgeht und nicht aus positivem Inhalt.","refs":["CH_GB18_DEIS:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSD-02","text":"Identität erscheint als operative Erhaltung durch Hervorbringung und Ausschluss von Andersheit, nicht als Abwesenheit von Differenz.","refs":["CH_GB18_BEUV:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSD-03","text":"Das Dasein erhält den Status einer nachträglichen, aber notwendigen Stufe: Es ist die gegenständliche Form einer zuvor internen Negationsbewegung.","refs":["CH_GB18_BDEU:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSD-04","text":"Die Zeitlichkeit des Systems ist keine lineare Entwicklung, sondern eine rekursive Nachträglichkeit, in der spätere Äußerlichkeit die frühere Einheit als bereits differenzierend sichtbar macht.","refs":["CH_GB18_DEIS:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSD-05","text":"Methodisch wird jede unmittelbare Bestimmung als Resultat einer noch nicht vollständig explizierten Vermittlung lesbar.","refs":["CH_GB18_DEIS:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_15:RLE-01","text":"Selbstbeziehung → gesetzte Unmittelbarkeit → Differenz → Anderes → Ausschluss → erneute Stabilisierung der Selbstbeziehung.","refs":["CH_GB18_BEUV:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RLE-02","text":"Der Ausschluss des Anderen erzeugt gerade die relationale Struktur, in der das Andere als notwendiges Moment der Einheit wiederkehrt.","refs":["CH_GB18_BEUV:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RLE-03","text":"Die Negation oszilliert zwischen Außenrichtung und Rückkehr: Mangels eines unabhängigen Anderen wird die Differenz in die Selbstbeziehung zurückgeführt.","refs":["CH_GB18_DEIS:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RLE-04","text":"Das Leere bildet einen begrifflichen Attraktor, weil es die interne Inhaltslosigkeit des Eins in eine äußerlich bestimmte Gegenüberstellung überführt.","refs":["CH_GB18_DEIS:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RLE-05","text":"Die Wiederholung von Einheit und Differenz markiert jeweils einen Phasenwechsel: von Idealität zu Realität, von Insichsein zu Leere und von Einheit zu Dasein.","refs":["CH_GB18_BEUV:AF2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_15:FGS-B01","text":"Einfache Selbstbeziehung → Zusammenfall der Momente → gesetzte Unmittelbarkeit.","refs":["CH_GB18_BEUV:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FGS-B02","text":"Gesetzte Unmittelbarkeit → daseiende Bestimmungen → Umschlag der Idealität in abstrakte Realität.","refs":["CH_GB18_BEUV:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FGS-B03","text":"Negative Selbstbeziehung → innere Richtungsdifferenz → Rückkehr in sich → vermittelte Unmittelbarkeit.","refs":["CH_GB18_DEIS:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FGS-B04","text":"Gesetztes Nichts → Leeres → äußerlich gegenüberstehendes Dasein des Nichts.","refs":["CH_GB18_DEIS:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FGS-B05","text":"Äußerliche Gegenüberstellung → relationale Differenz → Ausschluss → negative Einheit als rekursive Schließung.","refs":["CH_GB18_BDEU:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_15:AFM-B01","text":"Selbstbeziehung → Zusammenfall → Unmittelbarkeit → gesetzte Differenz → internes Anderes → Rückkehr der Negation → Eins und Leere → Dasein → Äußerlichkeit → Ausschluss → negative Einheit.","refs":["CH_GB18_BDEU:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:AFM-B02","text":"Die Schlussbewegung ist rekursiv: Die Einheit erzeugt ihr Außen, das Außen macht die innere Negation sichtbar, und der Ausschluss des Außen reproduziert die Einheit in bestimmter Form.","refs":["CH_GB18_BEUV:AF6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_15:MME-01","text":"Das Eins wird von einer isolierten Einheit zu einer Produktionsstruktur aus Selbstbeziehung, Differenz und Ausschluss umkartiert.","refs":["CH_GB18_BEUV:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MME-02","text":"Das Andere wird von einem äußerlich vorgefundenen Gegenüber zu einer erzeugten Gestalt des eigenen Selbstbestimmens umklassifiziert.","refs":["CH_GB18_BEUV:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MME-03","text":"Unmittelbarkeit wird als verdichtete Vermittlung lesbar; damit bricht der Gegensatz zwischen unmittelbarer Gegebenheit und begrifflicher Konstruktion zusammen.","refs":["CH_GB18_DEIS:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MME-04","text":"Das Leere wird vom bloßen Mangel zu einer positiven strukturellen Position innerhalb der Entstehung von Dasein umklassifiziert.","refs":["CH_GB18_DEIS:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MME-05","text":"Ausschluss wird von einer nachträglichen Abwehrmaßnahme zur konstitutiven Form der Einheit umbestimmt.","refs":["CH_GB18_BEUV:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_15:ALT-B01","text":"[Surface level] Das Eins und das Leere erscheinen als unterschiedliche Bestimmungen des Fürsichseyns, deren Gegenüberstellung Dasein hervorbringt.","refs":["CH_GB18_BDEU:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:ALT-B02","text":"[Structural level] Eine negative Selbstbeziehung organisiert die Übergänge von Unmittelbarkeit, Differenz, Rückkehr und Äußerlichkeit.","refs":["CH_GB18_BDEU:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:ALT-B03","text":"[Metastrategic level] Der Gegensatz von Eins und Anderem wird als interne Setzungsbewegung rekonstruiert, nicht als äußerlich gegebene Opposition.","refs":["CH_GB18_BDEU:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:ALT-B04","text":"[Ontological / Temporal level] Realität erscheint als Umschlag idealer Totalität in Dasein; Zeitlichkeit wird als rekursive Entfaltung von Bestimmungen lesbar.","refs":["CH_GB18_BEUV:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:ALT-B05","text":"[Methodological / Performative level] Die Argumentform vollzieht ihre These, indem sie jede scheinbare Unmittelbarkeit durch eine nachträglich sichtbar werdende Negationsbewegung umcodiert.","refs":["CH_GB18_DEIS:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_15:FL-01","text":"Das Eins soll keine Beziehung auf ein Anderes enthalten, wird aber nur als Eins verständlich, indem es ein Anderes hervorbringt und ausschließt.","refs":["CH_GB18_DEIS:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FL-02","text":"Das Leere erscheint zugleich als im Eins gesetztes Nichts und als außerhalb des Eins stehendes Dasein.","refs":["CH_GB18_BDEU:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FL-03","text":"Die Einheit soll ungeteilt sein, erzeugt aber gerade durch ihre Setzung die Verschiedenheit ihrer Momente.","refs":["CH_GB18_BDEU:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FL-04","text":"Die Behauptung der Unveränderlichkeit steht unter Spannung zur Bewegung, durch die das Eins Realität, Differenz und Dasein hervorbringt.","refs":["CH_GB18_DEIS:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MP-01","text":"Unbestimmtheit mutiert von scheinbarer Inhaltslosigkeit zu absoluter Selbstbestimmtheit und wird dadurch zur positiven strukturellen Bestimmung.","refs":["CH_GB18_DEIS:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MP-02","text":"Das Nichts mutiert vom inneren gesetzten Moment zum äußerlich gegenüberstehenden Leeren, ohne seine negative Herkunft zu verlieren.","refs":["CH_GB18_DEIS:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MP-03","text":"Unmittelbarkeit mutiert von der Form reiner Einfachheit zur Form einer vermittelten Rückkehr und wird damit selbst zum Ergebnis.","refs":["CH_GB18_DEIS:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_15:HSI-01","text":"Das System behandelt Realität implizit als eine Maschine der Selbstbestimmung, die ihre eigenen Differenzen erzeugt, vergegenständlicht und durch Ausschluss stabilisiert.","refs":["CH_GB18_BEUV:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:HSI-02","text":"Das Subjekt dieser Maschine ist keine isolierte Einheit, sondern eine negative Einheit, die nur durch das von ihr erzeugte Andere bestimmt ist.","refs":["CH_GB18_BDEU:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:HSI-03","text":"Die mögliche Bewegung besteht nicht in der Flucht aus der Differenz, sondern in der Rekonstruktion ihrer immanenten Herkunft und ihrer rückläufigen Vermittlung.","refs":["CH_GB18_DEIS:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_15:MRT-B01","text":"Die Axiome sind hinreichend, um die Bewegung von der einfachen Selbstbeziehung über vermittelte Unmittelbarkeit und interne Differenz bis zur negativen Einheit von Eins und Leere zu rekonstruieren.","refs":["CH_GB18_BEUV:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MRT-B02","text":"Unterbestimmt bleibt der genaue begriffliche Mechanismus, durch den die Idealität in Realität und die interne Negation in äußerliches Dasein umschlägt.","refs":["CH_GB18_BEUV:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MRT-B03","text":"Die Rekonstruktion ist auf Cluster-Ebene kohärent, solange der Widerspruch zwischen Insichsein und äußerer Gegenüberstellung als notwendiger Produktionsmechanismus und nicht als Fehler behandelt wird.","refs":["CH_GB18_BDEU:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MRT-B04","text":"Ihre stärkste Stelle ist die Ableitung der Differenz aus der Einheit; ihr unverzichtbares Restmoment ist die gleichzeitige interne und externe Stellung des Leeren.","refs":["CH_GB18_BDEU:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MRT-B05","text":"Die minimale Rekonstruktion bewahrt die tatsächliche Bewegung nur dann, wenn Dasein als Folge der Äußerlichwerdung und Ausschluss als konstitutive Rückkehr zur Einheit verstanden werden.","refs":["CH_GB18_BDEU:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121135204738Z_11dfaaea","language_code":"en","language_name":"English","title":"Chapters 43–45","source_sha256":"9c514442bc1482bf02b8803964b1a21fdef2c36d0f9727ad93f8633a0bda7889","sha256":"0d9f769d061d96e802274acda7c355bdc4608a401e676fc6b11d877a2da4cd9e","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:11:35.205698+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_15:SP-01","text":"The system reconstructs how a simple self-relation passes, through its own positing, into determinacy, difference, and finally external opposition.","refs":["CH_GB18_BEUV:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:SP-02","text":"The central redefinition consists in determining immediacy not as the absence of mediation, but as a posited and subsequently retroactively mediated form of self-relation.","refs":["CH_GB18_BEUV:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:SP-03","text":"The argument becomes a recursive ontology of negation: self-relation generates difference, difference generates an Other, and its exclusion stabilizes unity anew.","refs":["CH_GB18_BEUV:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:SP-04","text":"The movement is spiral-shaped and mutation-driven; it ends not with pure identity, but with a negative unity whose Dasein arises from the produced externality of One and Void.","refs":["CH_GB18_BDEU:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_15:GA-01","text":"[Persistent] Being-for-self begins as a simple relation to itself.","refs":["CH_GB18_BEUV:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-02","text":"[Persistent] The relation to itself is at once negative self-relation and infinite self-determination.","refs":["CH_GB18_BEUV:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-03","text":"[Mutating] Self-relation posits its moments as immediate and existing determinations.","refs":["CH_GB18_BEUV:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-04","text":"[Emergent] Posited immediacy generates a difference that appears as the unity's own Other.","refs":["CH_GB18_BEUV:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-05","text":"[Mutating] The ideally posited totality passes over into abstract reality and subsequently into pure, unchangeable being.","refs":["CH_GB18_BEUV:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-06","text":"[Emergent] Negation contains a difference which, for lack of an independent Other, returns into self-relation.","refs":["CH_GB18_DEIS:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-07","text":"[Emergent] This return generates a mediated immediacy in which Dasein and ideality coincide.","refs":["CH_GB18_DEIS:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-08","text":"[Mutating] The Nothing posited within the One is initially determined internally as Void and is then grasped as an externally opposed moment.","refs":["CH_GB18_DEIS:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-09","text":"[Emergent] One and Void form a posited difference on the common ground of negative self-relation.","refs":["CH_GB18_BDEU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-10","text":"[Terminal] The unity of the moments passes over into Dasein and external opposition.","refs":["CH_GB18_BDEU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GA-11","text":"[Attractor] Unity sustains itself by producing otherness, remaining related to it, and excluding it from itself.","refs":["CH_GB18_BEUV:A18"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_15:RMD-01","text":"The One preserves its identity but changes its function: it is initially self-relation, then abstract reality, pure being, and finally a relational pole vis-à-vis the Void.","refs":["CH_GB18_BDEU:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-02","text":"Negative self-relation recurs with functional stability, but shifts from the determination of the One to the common productive basis of One and Void.","refs":["CH_GB18_BDEU:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-03","text":"Immediacy mutates from an apparently presuppositionless simplicity into a posited form mediated through return.","refs":["CH_GB18_DEIS:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-04","text":"The Other is displaced from the generated self-determination of the One to the externally appearing Void, without losing its immanent origin.","refs":["CH_GB18_BDEU:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-05","text":"Nothing changes its valence: it is initially a moment posited in the One, thereafter a Dasein determined as opposed to the One.","refs":["CH_GB18_BDEU:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-06","text":"Difference is organized first as an internal directional difference, then as relational distinctness, and finally as the externality of the moments.","refs":["CH_GB18_DEIS:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-07","text":"Exclusion disappears as a mere final operation and becomes the attractor that both generates and sustains unity.","refs":["CH_GB18_BEUV:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RMD-08","text":"The category of Dasein arises only after internal negation has passed over into opposed determinations.","refs":["CH_GB18_BDEU:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_15:CGD-01","text":"The local determination of the One as pure being, unchangeability, and Void remains an internal characteristic of the corresponding unity; at the cluster level, it becomes the function of negative stabilization.","refs":["CH_GB18_DEIS:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:CGD-02","text":"The individual derivation of the Other from self-determination scales upward because, together with the later opposition of One and Void, it forms a general productive rule of difference.","refs":["CH_GB18_BEUV:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:CGD-03","text":"The local negation of external categories becomes, at the cluster level, the condition of exclusion for an ontology in which determinacy does not depend on external relation.","refs":["CH_GB18_DEIS:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:CGD-04","text":"The local distinction between being-in-itself and posited Nothing becomes, at a higher level, the oscillation between internal moment and external counterpart.","refs":["CH_GB18_DEIS:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:CGD-05","text":"Only the interaction of the unities shows that Dasein is not a local basic category, but the result of an becoming-external distributed across several determinations.","refs":["CH_GB18_BDEU:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_15:GNX-01","text":"The system rejects an isolated One whose unity could subsist without posited difference.","refs":["CH_GB18_BEUV:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GNX-02","text":"It rejects an external Other that would not have arisen from the self-determination of the One.","refs":["CH_GB18_BEUV:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GNX-03","text":"It rejects a pure immediacy that could do without internal mediation and return.","refs":["CH_GB18_DEIS:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GNX-04","text":"It rejects a Void that would either be identical with the One or independent of every relation to the One.","refs":["CH_GB18_BDEU:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:GNX-05","text":"It rejects a Dasein that does not arise from the differentiation of negative self-relation.","refs":["CH_GB18_BDEU:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_15:DBN-01","text":"The system cannot subsist if unity is understood as positive identity without self-differentiation.","refs":["CH_GB18_BEUV:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:DBN-02","text":"It must be excluded that mediation is a transition between determinations already separated and externally present.","refs":["CH_GB18_DEIS:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:DBN-03","text":"It must be excluded that indeterminacy means mere lack of content or epistemic ignorance; it functions as absolute self-determinacy.","refs":["CH_GB18_DEIS:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:DBN-04","text":"An independent Nothing is inadmissible, because the common negative origin of One and Void would thereby disintegrate.","refs":["CH_GB18_BDEU:DNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_15:BSA-01","text":"Impossible is a unity that could not bring forth otherness from itself and yet subsist as unity.","refs":["CH_GB18_BEUV:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSA-02","text":"Unavailable is a difference that would remain external to the One and could not be read as its own self-determination.","refs":["CH_GB18_BEUV:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSA-03","text":"Blocked is a totality whose self-relation would not at once be self-differentiation, mediation, and exclusion.","refs":["CH_GB18_BEUV:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSA-04","text":"The absence of exclusion counts as an inadequate form of unity; negative unity is organized around this impossibility.","refs":["CH_GB18_BEUV:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_15:XD-01","text":"The immediacy of self-relation generates the difference it initially seems to exclude, thereby preparing the opposition of One and Void.","refs":["CL_GB18_15:GA-01","CL_GB18_15:GA-03","CL_GB18_15:GA-04","CH_GB18_BEUV:SD1","CH_GB18_BDEU:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_15:XD-02","text":"The apparent duality of One and Void is not an original duality, but the becoming-external of a common negative self-relation.","refs":["CL_GB18_15:GA-08","CL_GB18_15:GA-09","CL_GB18_15:GA-10","CH_GB18_BDEU:SD1","CH_GB18_BDEU:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_15:XD-03","text":"The contradiction between the One's freedom from relation and its relation to the Void marks a change of scale: relation is initially excluded, then reconstructed as internal production.","refs":["CL_GB18_15:GA-05","CL_GB18_15:GA-06","CL_GB18_15:GA-09","CH_GB18_DEIS:A3","CH_GB18_BDEU:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_15:XD-04","text":"Dasein arises only through the differentiation of negative unity and is therefore neither a presupposed foundation nor an externally added determination.","refs":["CL_GB18_15:GA-09","CL_GB18_15:GA-10","CH_GB18_BDEU:SD3","CH_GB18_BDEU:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_15:XD-05","text":"The Void functions at once as Nothing posited in the One and as opposed Dasein; this double position is a structural transition, not a mere contradiction.","refs":["CL_GB18_15:GA-08","CL_GB18_15:GA-10","CH_GB18_DEIS:A12","CH_GB18_BDEU:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_15:XD-06","text":"Exclusion is not the end of the movement, but the operation through which negative unity gains its reality and is related to itself anew.","refs":["CL_GB18_15:GA-10","CL_GB18_15:GA-11","CH_GB18_BEUV:SD4","CH_GB18_BEUV:D6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_15:BSD-01","text":"The system generates an ontology in which determinacy arises from the self-organization of negation and not from positive content.","refs":["CH_GB18_DEIS:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSD-02","text":"Identity appears as operative preservation through the production and exclusion of otherness, not as the absence of difference.","refs":["CH_GB18_BEUV:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSD-03","text":"Dasein receives the status of a subsequent yet necessary stage: it is the objective form of a previously internal movement of negation.","refs":["CH_GB18_BDEU:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSD-04","text":"The temporality of the system is not a linear development, but a recursive belatedness in which later externality makes the earlier unity visible as already differentiating.","refs":["CH_GB18_DEIS:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:BSD-05","text":"Methodologically, every immediate determination becomes readable as the result of a mediation not yet fully made explicit.","refs":["CH_GB18_DEIS:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_15:RLE-01","text":"Self-relation → posited immediacy → difference → Other → exclusion → renewed stabilization of self-relation.","refs":["CH_GB18_BEUV:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RLE-02","text":"The exclusion of the Other generates precisely the relational structure in which the Other returns as a necessary moment of unity.","refs":["CH_GB18_BEUV:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RLE-03","text":"Negation oscillates between outward direction and return: for lack of an independent Other, difference is led back into self-relation.","refs":["CH_GB18_DEIS:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RLE-04","text":"The Void forms a conceptual attractor because it transfers the internal lack of content of the One into an externally determined opposition.","refs":["CH_GB18_DEIS:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:RLE-05","text":"The repetition of unity and difference marks in each instance a phase change: from ideality to reality, from being-in-itself to Void, and from unity to Dasein.","refs":["CH_GB18_BEUV:AF2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_15:FGS-B01","text":"Simple self-relation → coincidence of the moments → posited immediacy.","refs":["CH_GB18_BEUV:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FGS-B02","text":"Posited immediacy → existing determinations → transition of ideality into abstract reality.","refs":["CH_GB18_BEUV:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FGS-B03","text":"Negative self-relation → internal directional difference → return into itself → mediated immediacy.","refs":["CH_GB18_DEIS:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FGS-B04","text":"Posited Nothing → Void → externally opposed Dasein of Nothing.","refs":["CH_GB18_DEIS:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FGS-B05","text":"External opposition → relational difference → exclusion → negative unity as recursive closure.","refs":["CH_GB18_BDEU:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_15:AFM-B01","text":"Self-relation → coincidence → immediacy → posited difference → internal Other → return of negation → One and Void → Dasein → externality → exclusion → negative unity.","refs":["CH_GB18_BDEU:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:AFM-B02","text":"The concluding movement is recursive: unity generates its outside, the outside makes internal negation visible, and the exclusion of the outside reproduces unity in determinate form.","refs":["CH_GB18_BEUV:AF6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_15:MME-01","text":"The One is remapped from an isolated unity into a productive structure of self-relation, difference, and exclusion.","refs":["CH_GB18_BEUV:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MME-02","text":"The Other is reclassified from an externally encountered counterpart into a generated configuration of its own self-determination.","refs":["CH_GB18_BEUV:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MME-03","text":"Immediacy becomes readable as condensed mediation; thereby the opposition between immediate givenness and conceptual construction collapses.","refs":["CH_GB18_DEIS:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MME-04","text":"The Void is reclassified from mere lack into a positive structural position within the genesis of Dasein.","refs":["CH_GB18_DEIS:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MME-05","text":"Exclusion is redefined from a subsequent defensive measure into the constitutive form of unity.","refs":["CH_GB18_BEUV:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_15:ALT-B01","text":"[Surface level] The One and the Void appear as different determinations of being-for-self, whose opposition produces Dasein.","refs":["CH_GB18_BDEU:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:ALT-B02","text":"[Structural level] A negative self-relation organizes the transitions of immediacy, difference, return, and externality.","refs":["CH_GB18_BDEU:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:ALT-B03","text":"[Metastrategic level] The opposition of One and Other is reconstructed as an internal movement of positing, not as an externally given opposition.","refs":["CH_GB18_BDEU:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:ALT-B04","text":"[Ontological / Temporal level] Reality appears as the transition of ideal totality into Dasein; temporality becomes readable as the recursive unfolding of determinations.","refs":["CH_GB18_BEUV:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:ALT-B05","text":"[Methodological / Performative level] The argumentative form enacts its thesis by recoding every apparent immediacy through a movement of negation that becomes visible retroactively.","refs":["CH_GB18_DEIS:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_15:FL-01","text":"The One is supposed to contain no relation to an Other, yet becomes intelligible as One only by bringing forth and excluding an Other.","refs":["CH_GB18_DEIS:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FL-02","text":"The Void appears at once as Nothing posited in the One and as Dasein standing outside the One.","refs":["CH_GB18_BDEU:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FL-03","text":"Unity is supposed to be undivided, yet precisely through its positing it generates the distinctness of its moments.","refs":["CH_GB18_BDEU:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:FL-04","text":"The assertion of unchangeability stands in tension with the movement through which the One produces reality, difference, and Dasein.","refs":["CH_GB18_DEIS:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MP-01","text":"Indeterminacy mutates from apparent lack of content into absolute self-determinacy and thereby becomes a positive structural determination.","refs":["CH_GB18_DEIS:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MP-02","text":"Nothing mutates from an internal posited moment into an externally opposed Void, without losing its negative origin.","refs":["CH_GB18_DEIS:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MP-03","text":"Immediacy mutates from the form of pure simplicity into the form of a mediated return and thus itself becomes a result.","refs":["CH_GB18_DEIS:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_15:HSI-01","text":"The system implicitly treats reality as a machine of self-determination that generates its own differences, objectifies them, and stabilizes itself through exclusion.","refs":["CH_GB18_BEUV:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:HSI-02","text":"The subject of this machine is not an isolated unity, but a negative unity determined only through the Other it generates.","refs":["CH_GB18_BDEU:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:HSI-03","text":"The possible movement consists not in flight from difference, but in the reconstruction of its immanent origin and its retroactive mediation.","refs":["CH_GB18_DEIS:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_15:MRT-B01","text":"The axioms are sufficient to reconstruct the movement from simple self-relation through mediated immediacy and internal difference to the negative unity of One and Void.","refs":["CH_GB18_BEUV:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MRT-B02","text":"What remains underdetermined is the precise conceptual mechanism through which ideality passes over into reality and internal negation into external Dasein.","refs":["CH_GB18_BEUV:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MRT-B03","text":"The reconstruction is coherent at the cluster level, so long as the contradiction between being-in-itself and external opposition is treated as a necessary productive mechanism rather than as an error.","refs":["CH_GB18_BDEU:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MRT-B04","text":"Its strongest point is the derivation of difference from unity; its indispensable residual moment is the simultaneous internal and external position of the Void.","refs":["CH_GB18_BDEU:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_15:MRT-B05","text":"The minimal reconstruction preserves the actual movement only if Dasein is understood as a consequence of becoming-external and exclusion as the constitutive return to unity.","refs":["CH_GB18_BDEU:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_15@R001","source_variant_id":"canonical:CL_GB18_15:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 43–45","context":"B. Eins und Vieles. · a. Das Eins an ihm selbst. · b. Das Eins und das Leere."},"title_language_code":"en"},{"id":"CL_GB18_16","layer":"CL","title":"Chapters 46–48","order":16,"parents":["CH_GB18_AN_7","CH_GB18_CVER","CH_GB18_AN_8"],"revision":"CL_GB18_16@R001","sha256":"f15a5bff6090b98c5f0f64e5541de946f51e67668eae7aa11f52a75079964515","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_16:AS-B01","text":"Das Problem besteht darin, Vielheit und Bewegung nicht als vorliegende Tatsachen, sondern als notwendige Selbstentfaltung des Fürsichseins zu bestimmen.","refs":["CH_GB18_AN_8:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B02","text":"Das atomistische Eins eröffnet die Frage der Selbstbeziehung, bleibt jedoch als unveränderliche Einzelheit unfähig, seine konkreten Beziehungen aus sich abzuleiten.","refs":["CH_GB18_AN_7:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B03","text":"Das Leere mutiert von der bloßen räumlichen Abwesenheit zur negativen Relation, durch die Bewegung als immanente Selbstbewegung überhaupt begründet werden kann.","refs":["CH_GB18_AN_7:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B04","text":"Die negative Selbstbeziehung des Eins wird als Repulsion operativ und setzt eine Vielheit, ohne dass das Eins in ein qualitativ anderes Sein übergeht.","refs":["CH_GB18_CVER:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B05","text":"Die erzeugte Vielheit erscheint zugleich als Setzung des Eins und als äußerlich vorausgesetzte Menge selbständiger Einsheiten; dieser Widerspruch ist keine Störung, sondern die Form ihrer Unendlichkeit.","refs":["CH_GB18_CVER:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B06","text":"Leibnizianische Monadenlehre und Atomismus werden nicht als konkurrierende Ontologien, sondern als unterschiedliche Formen unzureichender Vermittlung klassifiziert.","refs":["CH_GB18_AN_8:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B07","text":"Der Maßstab der Kritik ist Idealität: Ein Eins ist nur dann begrifflich zureichend, wenn Fürsichsein sein Für-es-sein nicht ausschließt, sondern immanent enthält.","refs":["CH_GB18_AN_8:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B08","text":"Die Bewegung des Clusters ist rekursiv: abstrakte Einzelheit erzeugt Vielheit, die Vielheit exponiert die Unzulänglichkeit abstrakter Einzelheit, und diese Unzulänglichkeit erzwingt die ideelle Vermittlung.","refs":["CH_GB18_AN_8:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_16:GA-01","text":"[Persistent] Fürsichsein ist keine abgeschlossene Positivität, sondern eine negative Selbstbeziehung, deren Wahrheit nur in ihrer Fähigkeit zur Selbstentäußerung liegt.","refs":["CH_GB18_CVER:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-02","text":"[Mutating] Das Leere ist zunächst Negation des Nichtseins, wird aber auf Cluster-Ebene zur Grenze und zum negativen Medium, in dem die äußerliche Vielheit erscheint.","refs":["CH_GB18_CVER:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-03","text":"[Emergent] Vielheit ist nicht ursprünglich gegeben, sondern die immanente Setzung des Eins durch Repulsion.","refs":["CH_GB18_CVER:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-04","text":"[Persistent] Eine Vielheit bleibt begrifflich mangelhaft, wenn ihre Beziehungen äußerlich hinzutreten oder von einer übergeordneten Instanz repräsentiert werden müssen.","refs":["CH_GB18_AN_8:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-05","text":"[Attractor] Repulsion ist die Operation, durch welche negative Selbstbeziehung Vielheit erzeugt, ohne ihre Herkunft in einem äußeren Übergang oder einer vorgegebenen Menge zu suchen.","refs":["CH_GB18_CVER:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-06","text":"[Mutating] Das atomistische Eins enthält einen spekulativen Kern, der als negative Bewegungsbeziehung produktiv ist, und zugleich eine abstrakte Erstarrung, die konkrete Bestimmungen äußerlich macht.","refs":["CH_GB18_AN_7:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-07","text":"[Terminal] Idealität bezeichnet die nicht mehr äußerliche Einheit von Fürsichsein und Für-es-sein und bildet damit das Kriterium jeder zureichenden Theorie der Vielheit.","refs":["CH_GB18_AN_8:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-08","text":"[Attractor] Die Gleichheit von repellierendem und repelliertem Eins unterbindet jede asymmetrische Ursprungsordnung und erzwingt eine Selbstproduktion ohne externen ersten Träger.","refs":["CH_GB18_CVER:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-09","text":"[Emergent] Die Unendlichkeit der Vielheit besteht nicht in ihrer Anzahl, sondern darin, dass die Selbstbeziehung des Eins außer sich als äußerliche Vielheit wiederkehrt.","refs":["CH_GB18_CVER:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-10","text":"[Persistent] Jede Erklärung, die Einzelheiten als selbstgenügsame Gründe behandelt, reproduziert eine bereichsübergreifende Begrifflosigkeit in Natur-, Staats- und Beziehungstheorie.","refs":["CH_GB18_AN_7:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_16:RMD-01","text":"Das Eins bleibt als Form des Fürsichseins persistent, mutiert jedoch von der atomistischen Unveränderlichkeit zur sich selbst negativ beziehenden Einheit, die ihre Vielheit setzt.","refs":["CH_GB18_AN_7:A3","CH_GB18_CVER:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RMD-02","text":"Das Leere verschiebt sich von der bloßen Bedingung räumlicher Bewegung zu einer Grenzform der Vielheit und verliert damit seine Funktion als selbständiger Behälter.","refs":["CH_GB18_AN_7:NX2","CH_GB18_CVER:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RMD-03","text":"Vielheit mutiert von einer äußerlich gegebenen Menge in eine durch Repulsion gesetzte, aber als vorausgesetzt erscheinende Struktur.","refs":["CH_GB18_AN_8:A5","CH_GB18_CVER:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RMD-04","text":"Beziehung kehrt funktional wieder, erfährt jedoch eine Valenzumkehr: Als äußerliche Verbindung ist sie Mangel, als immanente Bestimmung der Einheit ist sie Idealität.","refs":["CH_GB18_AN_8:D7","CH_GB18_AN_8:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RMD-05","text":"Der betrachtende Philosoph erscheint nicht als epistemische Ergänzung, sondern als Symptom dafür, dass die Theorie die Vermittlung nicht aus ihrem Gegenstand erzeugen konnte.","refs":["CH_GB18_AN_8:A12","CH_GB18_AN_8:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RMD-06","text":"Der Atomismus wird nicht verworfen, sondern in eine höhere Struktur absorbiert: Seine Repulsion bewahrt die immanente Erzeugung der Vielheit, während seine einfache Einzelheit durch Idealität überboten wird.","refs":["CH_GB18_AN_8:A9","CH_GB18_AN_8:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_16:CGD-01","text":"Die Bestimmungen von Gestalt, Stellung und Bewegungsrichtung der Atome bleiben lokale Symptome der atomistischen Willkür und tragen die Clusterarchitektur nicht selbst.","refs":["CH_GB18_AN_7:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:CGD-02","text":"Die Unterscheidung zwischen räumlicher Ortsbewegung und Selbstbewegung skaliert nach oben, weil sie entscheidet, ob Vielheit aus äußerem Arrangement oder immanenter Negativität erklärt wird.","refs":["CH_GB18_AN_7:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:CGD-03","text":"Die monadische Abgeschlossenheit ist lokal eine Bestimmung Leibniz', wird aber global zum Modell jeder Einheit, die ihre Beziehungen nicht aus sich selbst hervorbringen kann.","refs":["CH_GB18_AN_8:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:CGD-04","text":"Die Repulsion überschreitet ihren lokalen Status als Kategorie der Vielheit und wird zur generativen Vermittlungsform zwischen Selbstbeziehung, Differenz und äußerlicher Welt.","refs":["CH_GB18_CVER:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:CGD-05","text":"Idealität ist keine zusätzliche Eigenschaft des Eins, sondern die aktuelle Ebene, auf der Atomismus und Monadologie als unzureichende Varianten derselben Vermittlungskrise lesbar werden.","refs":["CH_GB18_AN_8:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_16:GNX-01","text":"Ausgeschlossen wird die Annahme, Vielheit sei als empirisch oder ontologisch vorgegebene Menge bereits erklärt.","refs":["CH_GB18_AN_8:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GNX-02","text":"Ausgeschlossen wird ein Begriff des Leeren als neutraler Raum, der Bewegung nur aufnimmt, aber nicht hervorbringt.","refs":["CH_GB18_AN_7:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GNX-03","text":"Ausgeschlossen wird ein Übergangsmodell, in dem die Vielheit durch den Wechsel des Eins in Nichtsein entsteht.","refs":["CH_GB18_CVER:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GNX-04","text":"Ausgeschlossen wird eine positive Wechselbeziehung isolierter Einsheiten, weil sie deren abstrakte Selbständigkeit in Sein-für-Anderes verwandeln würde.","refs":["CH_GB18_CVER:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GNX-05","text":"Ausgeschlossen wird die Delegation von Vermittlung an eine Monade der Monaden oder an ein äußerliches Bewusstsein.","refs":["CH_GB18_AN_8:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GNX-06","text":"Ausgeschlossen wird die Gleichsetzung innerer Mannigfaltigkeit mit wirklicher Relation, weil Repräsentation die abgeschlossene Form des Fürsichseins nicht verändert.","refs":["CH_GB18_AN_8:NX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_16:DBN-01","text":"Damit das System trägt, darf keine Einzelheit als letzter, selbstgenügsamer Grund von Natur, Staat oder Beziehung anerkannt werden.","refs":["CH_GB18_AN_7:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:DBN-02","text":"Damit die Vielheit begrifflich bleibt, darf ihre Vermittlung weder vor ihrer Erzeugung angesetzt noch nachträglich durch äußere Zusammensetzung ergänzt werden.","refs":["CH_GB18_AN_7:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:DBN-03","text":"Damit Bewegung nicht vorausgesetzt wird, darf Negativität nicht als bloßer Mangel, Raum oder Nichtsein behandelt werden.","refs":["CH_GB18_AN_7:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:DBN-04","text":"Damit Idealität möglich wird, darf Fürsichsein nicht mit einfacher Isolation zusammenfallen.","refs":["CH_GB18_AN_8:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:DBN-05","text":"Damit Repulsion produktiv bleibt, darf der Widerspruch zwischen eigener Setzung und äußerlichem Vorausgesetztsein nicht durch eine lineare Ursprungsrelation neutralisiert werden.","refs":["CH_GB18_CVER:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_16:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist eine Realität aus fertigen, selbstidentischen Einheiten, deren Beziehungen lediglich nachträglich hinzukommen.","refs":["CH_GB18_AN_8:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:BSA-02","text":"Unzulässig ist eine Kausalität, in der Bewegung bereits vorhanden ist und ihr Grund deshalb nicht aus Negativität rekonstruiert werden muss.","refs":["CH_GB18_AN_7:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:BSA-03","text":"Versperrt bleibt jede positive Gemeinsamkeit, die die Vielheit ohne Veränderung der Einsheiten als unmittelbare Harmonie ausweisen könnte.","refs":["CH_GB18_CVER:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:BSA-04","text":"Die abwesende, aber strukturierende Möglichkeit ist eine Einheit, die ihre Differenz selbst erzeugt, ohne in isolierte Abgeschlossenheit oder äußerliche Relation zurückzufallen.","refs":["CH_GB18_AN_8:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_16:XD-01","text":"Die atomistische Kritik des bloßen Nebeneinanders und die Theorie der Repulsion bilden zusammen eine Umkehrung: Das, was zunächst als Defizit äußerlicher Vielheit erscheint, wird als notwendige Erscheinungsform negativer Selbstbeziehung lesbar.","refs":["CL_GB18_16:GA-02","CL_GB18_16:GA-05","CH_GB18_AN_7:AS3","CH_GB18_CVER:AS4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:XD-02","text":"Die monadische Unmittelbarkeit und die atomistische Einfachheit sind komplementäre Fehlformen: Die eine setzt Vielheit ohne Erzeugung, die andere erzeugt Vielheit ohne deren ideelle Vermittlung vollenden zu können.","refs":["CL_GB18_16:GA-03","CL_GB18_16:GA-07","CH_GB18_AN_8:A5","CH_GB18_AN_8:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:XD-03","text":"Die Negativität des Leeren erhält erst durch die Repulsion eine bestimmte Funktion: Sie ist nicht Ursprung eines anderen Seins, sondern die Grenze, an der das gesetzte Viele als äußerlich erscheint.","refs":["CL_GB18_16:GA-02","CL_GB18_16:GA-05","CH_GB18_AN_7:A9","CH_GB18_CVER:FGS6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:XD-04","text":"Die Gleichheit von aktivem und passivem Repellieren verhindert, dass die erzeugende Einheit als souveräner erster Grund außerhalb ihrer Produkte verbleibt.","refs":["CL_GB18_16:GA-08","CH_GB18_CVER:NX6","CH_GB18_CVER:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:XD-05","text":"Die Verlagerung von Vermittlung in Beobachter, Institutionen oder Zusammensetzungen erscheint als wiederkehrendes Symptom derselben strukturellen Unfähigkeit, Beziehung im Eins selbst zu bestimmen.","refs":["CL_GB18_16:GA-04","CL_GB18_16:GA-10","CH_GB18_AN_7:DNX5","CH_GB18_AN_8:A12"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_16:BSD-01","text":"Das System ersetzt eine Ontologie der Substanzen durch eine Ontologie operativer Selbstunterscheidung: Einheit ist nur wirklich, indem sie die Bedingungen ihrer Vielheit produziert.","refs":["CL_GB18_16:GA-01","CL_GB18_16:GA-03","CL_GB18_16:GA-05","CH_GB18_CVER:A9","CH_GB18_AN_8:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:BSD-02","text":"Geschichte, Natur und politische Einzelheit werden als homologe Felder lesbar, sofern sie abstrakte Selbständigkeit mit äußerlicher Zusammensetzung verwechseln.","refs":["CL_GB18_16:GA-10","CH_GB18_AN_7:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:BSD-03","text":"Der Status des Subjekts verschiebt sich von der monadischen Innenwelt oder atomistischen Einzelheit zu einer Einheit, deren Selbstbezug nur als immanente Beziehung auf anderes wahr ist.","refs":["CL_GB18_16:GA-01","CL_GB18_16:GA-07","CH_GB18_AN_8:A1","CH_GB18_AN_8:ME3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:BSD-04","text":"Kausalität wird als negative Selbstvermittlung umgeordnet: Nicht äußere Stöße, räumliche Bedingungen oder vorgegebene Mengen erklären Bewegung, sondern die Selbstentfaltung der Negativität.","refs":["CL_GB18_16:GA-02","CL_GB18_16:GA-05","CH_GB18_AN_7:A7","CH_GB18_CVER:ME1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_16:RLE-01","text":"Die zentrale Schleife lautet: Eins → negative Selbstbeziehung → Repulsion → viele Eins → äußerliche Vielheit → erneute Sichtbarkeit der unzureichenden Einsform.","refs":["CH_GB18_CVER:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RLE-02","text":"Die Eskalation führt von der Kritik räumlicher Leere zur Kritik jeder Ontologie, die Bewegung und Beziehung als äußere Zusätze behandelt.","refs":["CH_GB18_AN_7:NX2","CH_GB18_AN_8:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RLE-03","text":"Repulsion fungiert als Attraktor, weil sie Selbstbeziehung, Erzeugung der Vielheit, Gleichheit der Einsheiten und deren äußerliche Grenze zugleich organisiert.","refs":["CH_GB18_CVER:A8","CH_GB18_CVER:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RLE-04","text":"Idealität bildet den terminalen Attraktor, weil sie die Wiederkehr von Isolation und äußerer Vermittlung nicht beseitigt, sondern als unzureichende Momente einer umfassenderen Einheit aufnimmt.","refs":["CH_GB18_AN_8:A7","CH_GB18_AN_8:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RLE-05","text":"Die Wiederholung der atomistischen Form in naturwissenschaftlichen und politischen Figuren ist kein bloßes Beispiel, sondern die Rekursion eines abstrakten Einzelheitsmodells über verschiedene Gegenstandsbereiche hinweg.","refs":["CH_GB18_AN_7:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_16:FGS-B01","text":"Abstraktes Eins + Leeres → Reduktion der Mannigfaltigkeit auf äußerliche Einzelheit und räumliche Negativität.","refs":["CH_GB18_AN_7:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FGS-B02","text":"Eins als negative Selbstbeziehung → immanente Negativität → Bewegung nicht als Ortswechsel, sondern als Selbstbewegung.","refs":["CH_GB18_AN_7:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FGS-B03","text":"Fixiertes Fürsichsein → Beziehung auf ein seiendes Anderes → Anderes als weiteres Eins → Repulsion.","refs":["CH_GB18_CVER:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FGS-B04","text":"Repulsion → Setzung vieler Eins → Aufhebung ihres Gesetztseins → Vielheit als zugleich produziert und vorausgesetzt.","refs":["CH_GB18_CVER:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FGS-B05","text":"Ausschluss positiver Wechselbeziehung → Leeres als Grenze → Unendlichkeit als außer sich gekommene Selbstbeziehung.","refs":["CH_GB18_CVER:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FGS-B06","text":"Vergleich mit abgeschlossener Monade und atomistischem Eins → Diagnose äußerlicher Vermittlung → Erfordernis eines ideellen Eins als Einheit von Fürsichsein und Für-es-sein.","refs":["CH_GB18_AN_8:AF2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_16:AFM-B01","text":"Atomistische Reduktion der Mannigfaltigkeit → Kritik des bloßen Nebeneinanders → Leeres als negative Bewegungsrelation → Selbstrepulsion des Eins → gesetzte Vielheit → Widerspruch von Setzung und Vorausgesetztheit → Kritik monadischer und atomistischer Isolation → Idealität als immanente Vermittlung.","refs":["CH_GB18_AN_7:AF1","CH_GB18_CVER:AF1","CH_GB18_AN_8:AF3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_16:MME-01","text":"Bewegung wird von einer empirischen Veränderung im Raum zu einer ontologischen Operation negativer Selbstbeziehung umkartiert.","refs":["CH_GB18_AN_7:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MME-02","text":"Vielheit wird von einer numerischen oder gegebenen Menge zu einer problematischen Selbstsetzung der Einheit reklassifiziert.","refs":["CH_GB18_AN_8:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MME-03","text":"Die Alternative zwischen Atomismus und Monadologie zerfällt als falscher Gegensatz, weil beide die Vermittlung von Einheit und Beziehung nicht vollständig immanent leisten.","refs":["CH_GB18_AN_8:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MME-04","text":"Das Leere verliert den Status eines passiven Zwischenraums und wird als negative Grenze sichtbar, an der äußerliche Vielheit ihre Wahrheit und Unzulänglichkeit zugleich ausstellt.","refs":["CH_GB18_CVER:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MME-05","text":"Naturwissenschaftliche, politische und metaphysische Einzelheitsmodelle werden als Varianten eines gemeinsamen Problems der äußerlichen Zusammensetzung kartiert.","refs":["CH_GB18_AN_7:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_16:ALT-B01","text":"Surface level — Atome, Monaden, Eins, Leeres, Repulsion und Vielheit bilden die expliziten Gegenstände der Untersuchung.","refs":["CH_GB18_AN_8:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:ALT-B02","text":"Structural level — Entscheidend ist, ob Differenz und Beziehung aus der Einheit selbst hervorgehen oder lediglich als äußere Bestimmungen hinzutreten.","refs":["CH_GB18_AN_8:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:ALT-B03","text":"Metastrategic level — Die konkurrierenden Theorien werden nach ihrer Fähigkeit geordnet, ihren eigenen Vermittlungsgrund hervorzubringen, nicht nach der Anzahl oder Art ihrer Einheiten.","refs":["CH_GB18_AN_8:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:ALT-B04","text":"Ontological / Temporal level — Genese ist kein Übergang in ein anderes Sein, sondern eine Selbstentäußerung, deren Resultat zugleich gesetzt und als bereits seiend erscheint.","refs":["CH_GB18_CVER:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:ALT-B05","text":"Methodological / Performative level — Die Argumentation vollzieht ihren Gegenstand, indem sie jede behauptete Unmittelbarkeit wieder in die Vermittlungsoperation zurückführt, die sie verleugnet.","refs":["CH_GB18_AN_8:AF3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_16:FL-01","text":"Die Vielheit muss vom Eins erzeugt sein, um nicht bloß vorausgesetzt zu werden, und muss zugleich als vorausgesetzte Selbständigkeit erscheinen, damit Repulsion äußerlich werden kann.","refs":["CH_GB18_CVER:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FL-02","text":"Das Leere ist einerseits produktive Negativität, andererseits reine negative Grenze; die Passage zwischen Bewegungsgrund und Grenzform bleibt strukturell komprimiert.","refs":["CH_GB18_AN_7:A6","CH_GB18_CVER:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FL-03","text":"Die atomistische Repulsion wird als Fortschritt gegenüber monadischer Gleichgültigkeit behandelt, obwohl die Atomistik den Begriff der Idealität weiterhin verfehlt.","refs":["CH_GB18_AN_8:AS3","CH_GB18_AN_8:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MP-01","text":"Der entscheidende Mutationspunkt liegt in der Umcodierung des Anderen: Es ist nicht mehr das Leere, sondern ein weiteres Eins.","refs":["CH_GB18_CVER:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MP-02","text":"Ein zweiter Mutationspunkt liegt in der Umcodierung des Werdens in Gesetztwerden, wodurch Genese nicht verschwindet, sondern als aufgehobene Produktionsspur fortbesteht.","refs":["CH_GB18_CVER:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MP-03","text":"Ein dritter Mutationspunkt liegt in der Verschiebung von abstraktem Fürsichsein zu Idealität, in der Für-es-sein nicht mehr als Verlust der Einheit fungiert.","refs":["CH_GB18_AN_8:AS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_16:HSI-01","text":"Realität erscheint als Maschine negativer Selbstunterscheidung: Jede Einheit produziert ihr Außen aus sich, begegnet diesem Außen als äußerlicher Vielheit und wird erst wahr, wenn sie diese Äußerlichkeit als eigene Bewegung begreift.","refs":["CH_GB18_CVER:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:HSI-02","text":"Das Subjekt ist weder Monade noch Atom, sondern eine instabile Einheit, deren Selbständigkeit nur durch die immanente Erzeugung ihres Für-es-seins haltbar ist.","refs":["CH_GB18_AN_8:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:HSI-03","text":"Zeit erscheint nicht als neutrale Folge von Zuständen, sondern als Form aufgehobener Setzung, in der Produktion in ihrem Resultat verschwindet und dennoch wirksam bleibt.","refs":["CH_GB18_CVER:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:HSI-04","text":"Kampf und Navigation bestehen darin, äußerliche Vermittlungen nicht zu akzeptieren, ohne deshalb Differenz oder Vielheit zu verleugnen; die mögliche Fluchtlinie ist ideelle Beziehung.","refs":["CH_GB18_AN_8:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_16:MRT-B01","text":"Die globalen Axiome reichen aus, um die Bewegung von atomistischer Abstraktion über Repulsion zur Forderung nach Idealität zu rekonstruieren.","refs":["CH_GB18_AN_8:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MRT-B02","text":"Die Rekonstruktion ist am stärksten dort, wo Negativität, Selbstbewegung, Repulsion und Vielheit als eine einzige generative Kette bestimmt werden.","refs":["CH_GB18_AN_7:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MRT-B03","text":"Unterbestimmt bleibt die positive Ausarbeitung, durch welche Repulsion selbst in eine konkrete, nicht nur negativ bestimmte Beziehung übergeht.","refs":["CH_GB18_AN_8:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MRT-B04","text":"Die Architektur bleibt kohärent, sofern die äußerliche Vielheit nicht als Endzustand genommen wird, sondern als notwendiger, aber unzureichender Ausdruck negativer Selbstbeziehung.","refs":["CH_GB18_CVER:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MRT-B05","text":"Die irreduzible Spannung besteht darin, dass das System die äußere Selbständigkeit der vielen Eins zugleich erzeugen, zurückweisen und als Erscheinungsform seiner eigenen Unendlichkeit bewahren muss.","refs":["CH_GB18_CVER:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121204931041Z_bfdc3493","language_code":"en","language_name":"English","title":"Chapters 46–48","source_sha256":"f15a5bff6090b98c5f0f64e5541de946f51e67668eae7aa11f52a75079964515","sha256":"a784a88cbe5e84faca1be15dc6a60d6e134f2e6ef9c6437487575199381cb6ef","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:12:04.932069+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_16:AS-B01","text":"The problem consists in determining multiplicity and movement not as given facts, but as the necessary self-unfolding of being-for-self.","refs":["CH_GB18_AN_8:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B02","text":"The atomistic one opens the question of self-relation, yet, as immutable singularity, remains incapable of deriving its concrete relations from itself.","refs":["CH_GB18_AN_7:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B03","text":"The void mutates from mere spatial absence into the negative relation through which movement can first be grounded as immanent self-movement.","refs":["CH_GB18_AN_7:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B04","text":"The negative self-relation of the one becomes operative as repulsion and posits a multiplicity without the one passing over into a qualitatively other being.","refs":["CH_GB18_CVER:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B05","text":"The produced multiplicity appears at once as a positing of the one and as an externally presupposed aggregate of independent ones; this contradiction is not a disturbance, but the form of its infinity.","refs":["CH_GB18_CVER:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B06","text":"Leibnizian monadology and atomism are classified not as competing ontologies, but as different forms of inadequate mediation.","refs":["CH_GB18_AN_8:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B07","text":"The criterion of critique is ideality: a one is conceptually adequate only when being-for-self does not exclude its being-for-other, but contains it immanently.","refs":["CH_GB18_AN_8:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:AS-B08","text":"The movement of the cluster is recursive: abstract singularity produces multiplicity, multiplicity exposes the inadequacy of abstract singularity, and this inadequacy compels ideal mediation.","refs":["CH_GB18_AN_8:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_16:GA-01","text":"[Persistent] Being-for-self is not a closed positivity, but a negative self-relation whose truth lies only in its capacity for self-externalization.","refs":["CH_GB18_CVER:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-02","text":"[Mutating] The void is initially the negation of non-being, but at the cluster level becomes the boundary and negative medium in which external multiplicity appears.","refs":["CH_GB18_CVER:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-03","text":"[Emergent] Multiplicity is not originally given, but the immanent positing of the one through repulsion.","refs":["CH_GB18_CVER:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-04","text":"[Persistent] A multiplicity remains conceptually deficient when its relations are externally added or must be represented by a higher instance.","refs":["CH_GB18_AN_8:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-05","text":"[Attractor] Repulsion is the operation through which negative self-relation produces multiplicity without seeking its origin in an external transition or a predetermined aggregate.","refs":["CH_GB18_CVER:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-06","text":"[Mutating] The atomistic one contains a speculative core that is productive as a negative relation of movement, and at the same time an abstract rigidity that renders concrete determinations external.","refs":["CH_GB18_AN_7:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-07","text":"[Terminal] Ideality designates the no-longer-external unity of being-for-self and being-for-other and thereby constitutes the criterion of every adequate theory of multiplicity.","refs":["CH_GB18_AN_8:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-08","text":"[Attractor] The equality of repelling and repelled one prevents every asymmetrical order of origin and compels a self-production without an external first bearer.","refs":["CH_GB18_CVER:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-09","text":"[Emergent] The infinity of multiplicity consists not in its number, but in the fact that the self-relation of the one recurs outside itself as external multiplicity.","refs":["CH_GB18_CVER:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GA-10","text":"[Persistent] Every explanation that treats singularities as self-sufficient grounds reproduces a cross-domain conceptlessness in the theory of nature, the state, and relation.","refs":["CH_GB18_AN_7:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_16:RMD-01","text":"The one persists as the form of being-for-self, but mutates from atomistic immutability into the unity that negatively relates to itself and posits its multiplicity.","refs":["CH_GB18_AN_7:A3","CH_GB18_CVER:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RMD-02","text":"The void shifts from the mere condition of spatial movement to a boundary-form of multiplicity and thereby loses its function as an independent container.","refs":["CH_GB18_AN_7:NX2","CH_GB18_CVER:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RMD-03","text":"Multiplicity mutates from an externally given aggregate into a structure posited through repulsion, yet appearing as presupposed.","refs":["CH_GB18_AN_8:A5","CH_GB18_CVER:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RMD-04","text":"Relation recurs functionally, yet undergoes a reversal of valence: as external connection it is deficiency; as the immanent determination of unity it is ideality.","refs":["CH_GB18_AN_8:D7","CH_GB18_AN_8:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RMD-05","text":"The observing philosopher appears not as an epistemic supplement, but as a symptom that the theory could not generate mediation from its object.","refs":["CH_GB18_AN_8:A12","CH_GB18_AN_8:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RMD-06","text":"Atomism is not discarded, but absorbed into a higher structure: its repulsion preserves the immanent generation of multiplicity, while its simple singularity is surpassed through ideality.","refs":["CH_GB18_AN_8:A9","CH_GB18_AN_8:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_16:CGD-01","text":"The determinations of the shape, position, and direction of movement of atoms remain local symptoms of atomistic arbitrariness and do not themselves bear the cluster architecture.","refs":["CH_GB18_AN_7:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:CGD-02","text":"The distinction between spatial local movement and self-movement scales upward, because it decides whether multiplicity is explained through external arrangement or immanent negativity.","refs":["CH_GB18_AN_7:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:CGD-03","text":"Monadic closure is locally a determination of Leibniz, but globally becomes the model of every unity unable to bring forth its relations from itself.","refs":["CH_GB18_AN_8:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:CGD-04","text":"Repulsion exceeds its local status as a category of multiplicity and becomes the generative form of mediation between self-relation, difference, and the external world.","refs":["CH_GB18_CVER:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:CGD-05","text":"Ideality is not an additional property of the one, but the current level at which atomism and monadology become readable as inadequate variants of the same crisis of mediation.","refs":["CH_GB18_AN_8:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_16:GNX-01","text":"Excluded is the assumption that multiplicity, as an empirically or ontologically pre-given aggregate, is already explained.","refs":["CH_GB18_AN_8:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GNX-02","text":"Excluded is a concept of the void as neutral space that merely receives movement but does not produce it.","refs":["CH_GB18_AN_7:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GNX-03","text":"Excluded is a model of transition in which multiplicity arises through the one’s transition into non-being.","refs":["CH_GB18_CVER:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GNX-04","text":"Excluded is a positive reciprocal relation of isolated ones, because it would transform their abstract independence into being-for-other.","refs":["CH_GB18_CVER:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GNX-05","text":"Excluded is the delegation of mediation to a monad of monads or to an external consciousness.","refs":["CH_GB18_AN_8:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:GNX-06","text":"Excluded is the equation of inner manifoldness with actual relation, because representation does not alter the closed form of being-for-self.","refs":["CH_GB18_AN_8:NX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_16:DBN-01","text":"For the system to hold, no singularity may be acknowledged as the ultimate, self-sufficient ground of nature, state, or relation.","refs":["CH_GB18_AN_7:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:DBN-02","text":"For multiplicity to remain conceptual, its mediation may neither be posited before its generation nor subsequently supplemented through external composition.","refs":["CH_GB18_AN_7:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:DBN-03","text":"For movement not to be presupposed, negativity may not be treated as mere deficiency, space, or non-being.","refs":["CH_GB18_AN_7:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:DBN-04","text":"For ideality to become possible, being-for-self may not coincide with simple isolation.","refs":["CH_GB18_AN_8:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:DBN-05","text":"For repulsion to remain productive, the contradiction between its own positing and external presupposedness may not be neutralized by a linear relation of origin.","refs":["CH_GB18_CVER:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_16:BSA-01","text":"The deepest excluded possibility is a reality of finished, self-identical units whose relations are merely added afterward.","refs":["CH_GB18_AN_8:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:BSA-02","text":"Impermissible is a causality in which movement is already present and its ground therefore need not be reconstructed from negativity.","refs":["CH_GB18_AN_7:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:BSA-03","text":"Barred remains every positive commonality that could present multiplicity as immediate harmony without alteration of the ones.","refs":["CH_GB18_CVER:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:BSA-04","text":"The absent, yet structuring possibility is a unity that generates its own difference without relapsing into isolated closure or external relation.","refs":["CH_GB18_AN_8:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_16:XD-01","text":"The atomistic critique of mere juxtaposition and the theory of repulsion together constitute an inversion: what initially appears as the deficit of external multiplicity becomes readable as the necessary form of appearance of negative self-relation.","refs":["CL_GB18_16:GA-02","CL_GB18_16:GA-05","CH_GB18_AN_7:AS3","CH_GB18_CVER:AS4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:XD-02","text":"Monadic immediacy and atomistic simplicity are complementary deficient forms: the former posits multiplicity without generation, the latter generates multiplicity without being able to complete its ideal mediation.","refs":["CL_GB18_16:GA-03","CL_GB18_16:GA-07","CH_GB18_AN_8:A5","CH_GB18_AN_8:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:XD-03","text":"The negativity of the void acquires a determinate function only through repulsion: it is not the origin of another being, but the boundary at which the posited many appears as external.","refs":["CL_GB18_16:GA-02","CL_GB18_16:GA-05","CH_GB18_AN_7:A9","CH_GB18_CVER:FGS6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:XD-04","text":"The equality of active and passive repelling prevents the generating unity from remaining as a sovereign first ground outside its products.","refs":["CL_GB18_16:GA-08","CH_GB18_CVER:NX6","CH_GB18_CVER:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:XD-05","text":"The displacement of mediation into observers, institutions, or compositions appears as a recurring symptom of the same structural incapacity to determine relation in the one itself.","refs":["CL_GB18_16:GA-04","CL_GB18_16:GA-10","CH_GB18_AN_7:DNX5","CH_GB18_AN_8:A12"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_16:BSD-01","text":"The system replaces an ontology of substances with an ontology of operative self-differentiation: unity is actual only insofar as it produces the conditions of its multiplicity.","refs":["CL_GB18_16:GA-01","CL_GB18_16:GA-03","CL_GB18_16:GA-05","CH_GB18_CVER:A9","CH_GB18_AN_8:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:BSD-02","text":"History, nature, and political singularity become readable as homologous fields insofar as they confuse abstract independence with external composition.","refs":["CL_GB18_16:GA-10","CH_GB18_AN_7:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:BSD-03","text":"The status of the subject shifts from the monadic inner world or atomistic singularity to a unity whose self-relation is true only as immanent relation to another.","refs":["CL_GB18_16:GA-01","CL_GB18_16:GA-07","CH_GB18_AN_8:A1","CH_GB18_AN_8:ME3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_16:BSD-04","text":"Causality is reordered as negative self-mediation: not external impacts, spatial conditions, or predetermined aggregates explain movement, but the self-unfolding of negativity.","refs":["CL_GB18_16:GA-02","CL_GB18_16:GA-05","CH_GB18_AN_7:A7","CH_GB18_CVER:ME1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_16:RLE-01","text":"The central loop is: one → negative self-relation → repulsion → many ones → external multiplicity → renewed visibility of the inadequate form of the one.","refs":["CH_GB18_CVER:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RLE-02","text":"The escalation leads from the critique of spatial void to the critique of every ontology that treats movement and relation as external additions.","refs":["CH_GB18_AN_7:NX2","CH_GB18_AN_8:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RLE-03","text":"Repulsion functions as an attractor because it simultaneously organizes self-relation, the generation of multiplicity, the equality of the ones, and their external boundary.","refs":["CH_GB18_CVER:A8","CH_GB18_CVER:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RLE-04","text":"Ideality constitutes the terminal attractor because it does not eliminate the recurrence of isolation and external mediation, but sublates them as inadequate moments of a more comprehensive unity.","refs":["CH_GB18_AN_8:A7","CH_GB18_AN_8:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:RLE-05","text":"The repetition of the atomistic form in scientific and political figures is not a mere example, but the recursion of a model of abstract singularity across different domains of objects.","refs":["CH_GB18_AN_7:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_16:FGS-B01","text":"Abstract one + void → reduction of manifoldness to external singularity and spatial negativity.","refs":["CH_GB18_AN_7:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FGS-B02","text":"One as negative self-relation → immanent negativity → movement not as change of place, but as self-movement.","refs":["CH_GB18_AN_7:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FGS-B03","text":"Fixed being-for-self → relation to a being other → other as another one → repulsion.","refs":["CH_GB18_CVER:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FGS-B04","text":"Repulsion → positing of many ones → sublation of their positedness → multiplicity as at once produced and presupposed.","refs":["CH_GB18_CVER:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FGS-B05","text":"Exclusion of positive reciprocal relation → void as boundary → infinity as self-relation that has come outside itself.","refs":["CH_GB18_CVER:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FGS-B06","text":"Comparison with the closed monad and the atomistic one → diagnosis of external mediation → requirement of an ideal one as unity of being-for-self and being-for-other.","refs":["CH_GB18_AN_8:AF2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_16:AFM-B01","text":"Atomistic reduction of manifoldness → critique of mere juxtaposition → void as negative relation of movement → self-repulsion of the one → posited multiplicity → contradiction of positing and presupposedness → critique of monadic and atomistic isolation → ideality as immanent mediation.","refs":["CH_GB18_AN_7:AF1","CH_GB18_CVER:AF1","CH_GB18_AN_8:AF3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_16:MME-01","text":"Movement is remapped from an empirical alteration in space to an ontological operation of negative self-relation.","refs":["CH_GB18_AN_7:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MME-02","text":"Multiplicity is reclassified from a numerical or given aggregate to a problematic self-positing of unity.","refs":["CH_GB18_AN_8:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MME-03","text":"The alternative between atomism and monadology collapses as a false opposition, because neither fully accomplishes the mediation of unity and relation immanently.","refs":["CH_GB18_AN_8:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MME-04","text":"The void loses the status of a passive interspace and becomes visible as a negative boundary at which external multiplicity displays its truth and inadequacy simultaneously.","refs":["CH_GB18_CVER:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MME-05","text":"Scientific, political, and metaphysical models of singularity are mapped as variants of a common problem of external composition.","refs":["CH_GB18_AN_7:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_16:ALT-B01","text":"Surface level — Atoms, monads, one, void, repulsion, and multiplicity constitute the explicit objects of the investigation.","refs":["CH_GB18_AN_8:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:ALT-B02","text":"Structural level — Decisive is whether difference and relation proceed from unity itself or merely accrue as external determinations.","refs":["CH_GB18_AN_8:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:ALT-B03","text":"Metastrategic level — The competing theories are ordered according to their capacity to bring forth their own ground of mediation, not according to the number or kind of their units.","refs":["CH_GB18_AN_8:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:ALT-B04","text":"Ontological / Temporal level — Genesis is not a transition into another being, but a self-externalization whose result appears at once as posited and as already being.","refs":["CH_GB18_CVER:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:ALT-B05","text":"Methodological / Performative level — The argument enacts its object by leading every asserted immediacy back into the operation of mediation that it disavows.","refs":["CH_GB18_AN_8:AF3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_16:FL-01","text":"Multiplicity must be generated by the one in order not merely to be presupposed, and must at the same time appear as presupposed independence in order for repulsion to become external.","refs":["CH_GB18_CVER:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FL-02","text":"The void is, on the one hand, productive negativity and, on the other, pure negative boundary; the passage between ground of movement and boundary-form remains structurally compressed.","refs":["CH_GB18_AN_7:A6","CH_GB18_CVER:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:FL-03","text":"Atomistic repulsion is treated as progress over monadic indifference, although atomism continues to miss the concept of ideality.","refs":["CH_GB18_AN_8:AS3","CH_GB18_AN_8:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MP-01","text":"The decisive mutation point lies in the recoding of the other: it is no longer the void, but another one.","refs":["CH_GB18_CVER:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MP-02","text":"A second mutation point lies in the recoding of becoming into being-posited, whereby genesis does not disappear, but persists as a sublated trace of production.","refs":["CH_GB18_CVER:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MP-03","text":"A third mutation point lies in the shift from abstract being-for-self to ideality, in which being-for-other no longer functions as a loss of unity.","refs":["CH_GB18_AN_8:AS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_16:HSI-01","text":"Reality appears as a machine of negative self-differentiation: every unity produces its outside from itself, encounters this outside as external multiplicity, and becomes true only when it comprehends this externality as its own movement.","refs":["CH_GB18_CVER:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:HSI-02","text":"The subject is neither monad nor atom, but an unstable unity whose independence is sustainable only through the immanent generation of its being-for-other.","refs":["CH_GB18_AN_8:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:HSI-03","text":"Time appears not as a neutral succession of states, but as the form of sublated positing, in which production vanishes in its result and yet remains effective.","refs":["CH_GB18_CVER:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:HSI-04","text":"Struggle and navigation consist in not accepting external mediations without thereby disavowing difference or multiplicity; the possible line of flight is ideal relation.","refs":["CH_GB18_AN_8:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_16:MRT-B01","text":"The global axioms suffice to reconstruct the movement from atomistic abstraction through repulsion to the demand for ideality.","refs":["CH_GB18_AN_8:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MRT-B02","text":"The reconstruction is strongest where negativity, self-movement, repulsion, and multiplicity are determined as a single generative chain.","refs":["CH_GB18_AN_7:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MRT-B03","text":"What remains underdetermined is the positive elaboration through which repulsion itself passes over into a concrete relation not determined merely negatively.","refs":["CH_GB18_AN_8:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MRT-B04","text":"The architecture remains coherent insofar as external multiplicity is not taken as an end-state, but as a necessary yet inadequate expression of negative self-relation.","refs":["CH_GB18_CVER:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_16:MRT-B05","text":"The irreducible tension consists in the system’s having simultaneously to produce, reject, and preserve as the form of appearance of its own infinity the external independence of the many ones.","refs":["CH_GB18_CVER:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_16@R001","source_variant_id":"canonical:CL_GB18_16:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 46–48","context":"Anmerkung. · c. Viele Eins. Repulsion. · Anmerkung."},"title_language_code":"en"},{"id":"CL_GB18_17","layer":"CL","title":"Chapters 49–51","order":17,"parents":["CH_GB18_ADE0","CH_GB18_AN_9","CH_GB18_BDEE"],"revision":"CL_GB18_17@R001","sha256":"7d1d59ea31d093ae683762daeed22d41bf4904349bec825c85bd9fe8ee54977e","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_17:AS-B01","text":"Das Problem besteht darin, wie das Eins als selbständige Bestimmung auftreten kann, obwohl seine Selbstständigkeit nur durch ein Verhältnis zu anderen Eins wirksam wird.","refs":["CH_GB18_ADE0:AS1","CH_GB18_AN_9:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B02","text":"Die Ausschließung der Vielen setzt die Vielen voraus, die sie abweisen will; ihre negative Operation erzeugt deshalb keine reine Trennung, sondern ein gemeinsames Beziehungsfeld.","refs":["CH_GB18_ADE0:AS3","CH_GB18_BDEE:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B03","text":"Die anfängliche Selbständigkeit erweist sich als abstrakte Selbstnegation: Was als Sicherung des Eins gegen das Andere beginnt, zerstört die isolierte Form, die es behauptet.","refs":["CH_GB18_ADE0:NX5","CH_GB18_AN_9:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B04","text":"Attraktion ist keine Gegenkraft zur Repulsion, sondern deren immanente Umwendung in Selbstbeziehung, Anerkennung und vermittelte Einheit.","refs":["CH_GB18_ADE0:AS7","CH_GB18_BDEE:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B05","text":"Das Eine Eins entsteht nicht durch Tilgung der Vielheit, sondern dadurch, dass die Vielheit als negierte, erhaltene und fortwirkende Voraussetzung in die Einheit eingeht.","refs":["CH_GB18_BDEE:AS4","CH_GB18_BDEE:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B06","text":"Die Bewegung ist rekursiv und nicht terminal: Repulsion erzeugt die Materie der Attraktion, Attraktion bewahrt und reproduziert die Vielheit, von der sie abhängt.","refs":["CH_GB18_BDEE:A5","CH_GB18_BDEE:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B07","text":"Die Schließung besteht daher nicht in ruhender Identität, sondern in einer Einheit, deren Bestand die fortgesetzte Vermittlung von Unterschied, Negation und Rückkehr voraussetzt.","refs":["CH_GB18_AN_9:A6","CH_GB18_BDEE:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_17:GA-01","text":"[Persistent] Selbstständigkeit ist nur als negative Beziehung auf ein Anderes wirksam und kann keine absolut isolierte Form annehmen.","refs":["CH_GB18_ADE0:A3","CH_GB18_AN_9:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-02","text":"[Persistent] Repulsion setzt die Vielen voraus, die sie ausschließt; sie ist daher Beziehung und nicht bloße äußere Abstoßung.","refs":["CH_GB18_ADE0:A4","CH_GB18_ADE0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-03","text":"[Mutating] Ausschließung fungiert zunächst als Selbsterhaltung, schlägt aber in die Auflösung der behaupteten selbständigen Verschiedenheit um.","refs":["CH_GB18_ADE0:A8","CH_GB18_ADE0:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-04","text":"[Emergent] Die Gleichheit des Ansichseins und des gegenseitigen Negierens hebt die Vielen nicht in bloße Gleichförmigkeit auf, sondern macht ihre Einheit als immanente Bestimmung sichtbar.","refs":["CH_GB18_ADE0:A10","CH_GB18_AN_9:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-05","text":"[Mutating] Das negative Verhältnis zum Anderen wird wahr, wenn das Negierte als eigenes Wesen anerkannt und nicht länger als äußerlicher Gegner behandelt wird.","refs":["CH_GB18_AN_9:AS4","CH_GB18_AN_9:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-06","text":"[Attractor] Attraktion ist die Realisierung einer in der Repulsion angelegten Idealität und setzt die Repulsion als eigene Voraussetzung voraus.","refs":["CH_GB18_BDEE:AS2","CH_GB18_BDEE:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-07","text":"[Terminal] Das Eine Eins ist kein ursprünglicher Grund, sondern das vermittelte Resultat, das Repulsion und Attraktion als seine innere Bestimmung enthält.","refs":["CH_GB18_BDEE:A11","CH_GB18_BDEE:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-08","text":"[Attractor] Einheit bleibt nur als fortgesetzte Erhaltung der Vielheit in ihrer Negation bestehen; eine vollendete Aufhebung der Vielen vernichtete die Attraktion selbst.","refs":["CH_GB18_BDEE:A7","CH_GB18_BDEE:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_17:RMD-01","text":"Das Eins kehrt als stabile Identität wieder, mutiert jedoch von unmittelbarer Einzelheit über ausschließende Selbstbehauptung zu einem vermittelten Einen Eins.","refs":["CH_GB18_ADE0:A1","CH_GB18_BDEE:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RMD-02","text":"Repulsion wiederholt sich funktional als Ausschließung, Selbsterhaltung und Selbstbeziehung; ihre scheinbar negative Valenz kippt in die Bedingung der Attraktion.","refs":["CH_GB18_ADE0:A6","CH_GB18_ADE0:D8","CH_GB18_BDEE:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RMD-03","text":"Vielheit wandert von der Voraussetzung äußerlicher Nicht-Beziehung zur inneren Materie der Einheit und wird dadurch in eine höhere Vermittlungsstruktur absorbiert.","refs":["CH_GB18_ADE0:A2","CH_GB18_BDEE:A5","CH_GB18_BDEE:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RMD-04","text":"Selbstständigkeit mutiert von abstrakter Selbstgenügsamkeit zu einer Form, die ihre Wahrheit nur durch Anerkennung des negierten Bezugs gewinnt.","refs":["CH_GB18_AN_9:A1","CH_GB18_AN_9:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RMD-05","text":"Die ruhende Satzform verschwindet als angemessene Wahrheitsform, nachdem sie die Notwendigkeit einer prozessualen Darstellung von Einheit und Unterschied sichtbar gemacht hat.","refs":["CH_GB18_AN_9:A6","CH_GB18_AN_9:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_17:CGD-01","text":"Lokal bleibt die Bestimmung der Repulsion als Ausschließen bereits vorhandener Eins; auf Clusterebene trägt nur ihre Funktion als Selbstwiderspruch der isolierten Selbstständigkeit.","refs":["CH_GB18_ADE0:AS3","CH_GB18_AN_9:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:CGD-02","text":"Lokal bleibt die Vergleichbarkeit der Vielen; auf Clusterebene wird sie zum Beweis, dass Verschiedenheit und Gleichheit nicht getrennte Grundformen sind.","refs":["CH_GB18_AN_9:A8","CH_GB18_AN_9:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:CGD-03","text":"Lokal bleibt die Darstellung von Versöhnung als Umkehrung einer negativen Haltung; auf Clusterebene wird sie zur allgemeinen Form des Übergangs von Repulsion zu Attraktion.","refs":["CH_GB18_AN_9:AS4","CH_GB18_ADE0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:CGD-04","text":"Lokal bleibt das Eine Eins als Resultat der Attraktion; auf Clusterebene wird es als nichtabschließbare Einheit bestimmt, die ihre eigene Voraussetzung reproduzieren muss.","refs":["CH_GB18_BDEE:A11","CH_GB18_BDEE:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_17:GNX-01","text":"Ausgeschlossen wird eine Vielheit, deren Einzelne durch ein unabhängiges Ansichsein dauerhaft getrennt bleiben könnten.","refs":["CH_GB18_ADE0:DNX1","CH_GB18_ADE0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GNX-02","text":"Ausgeschlossen wird ein Fürsichsein, das sich ohne Sein-für-Anderes und ohne Anerkennung eines negierten Wesens erhalten könnte.","refs":["CH_GB18_ADE0:SNX3","CH_GB18_AN_9:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GNX-03","text":"Ausgeschlossen wird eine Attraktion, die unabhängig von Repulsion operiert oder ihre Voraussetzung endgültig verbraucht.","refs":["CH_GB18_BDEE:NX3","CH_GB18_BDEE:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GNX-04","text":"Ausgeschlossen wird eine Einheit, die durch Auslöschung des Unterschieds oder durch träge Gleichgewichtslage erreicht würde.","refs":["CH_GB18_AN_9:NX7","CH_GB18_BDEE:D3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_17:DBN-01","text":"Das System kann kein Modell zulassen, in dem Beziehung nachträglich zwischen bereits vollständig bestimmten Substanzen hinzutritt.","refs":["CH_GB18_ADE0:DNX2","CH_GB18_BDEE:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:DBN-02","text":"Das System kann keine Freiheit zulassen, die ihr Wesen durch reine Negation gewinnt, weil diese Operation das zu sichernde Sein zerstört.","refs":["CH_GB18_AN_9:A3","CH_GB18_AN_9:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:DBN-03","text":"Das System kann keine endgültige Einheit zulassen, die ihre innere Negativität und die erhaltene Vielheit vollständig abgestreift hätte.","refs":["CH_GB18_BDEE:SNX1","CH_GB18_BDEE:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:DBN-04","text":"Das System disqualifiziert jede Erkenntnisform, die Einheit und Unterschied als getrennte Alternativen behandelt statt als sich gegenseitig bestimmende Bewegungsmomente.","refs":["CH_GB18_AN_9:DNX4","CH_GB18_AN_9:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_17:BSA-01","text":"Die tiefste Unmöglichkeit ist eine ontologisch ursprüngliche Identität, die weder Differenz erzeugen noch durch Differenz vermittelt werden müsste.","refs":["CH_GB18_ADE0:SNX2","CH_GB18_AN_9:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:BSA-02","text":"Nicht verfügbar ist ein reines Außen: Das Andere kann weder als bloß fremde Grenze noch als endgültig auszuschließendes Material bestehen.","refs":["CH_GB18_ADE0:NX8","CH_GB18_AN_9:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:BSA-03","text":"Unzulässig ist eine Vollendung, die Bewegung beendet, weil die Beendigung der Vermittlung zugleich die Bedingungen von Attraktion, Einheit und Selbstbeziehung aufhöbe.","refs":["CH_GB18_BDEE:A7","CH_GB18_BDEE:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_17:XD-01","text":"Die Selbstzerstörung abstrakter Selbstständigkeit und die Unmöglichkeit vollendeter Attraktion bilden dieselbe Struktur: Eine Bestimmung scheitert, sobald sie die Beziehung vernichten will, die ihre eigene Wirksamkeit trägt.","refs":["CL_GB18_17:GA-01","CL_GB18_17:GA-08","CH_GB18_AN_9:AS3","CH_GB18_BDEE:A7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:XD-02","text":"Versöhnung und Attraktion sind homologe Übergangsformen, weil beide das zunächst Negierte nicht hinzufügen, sondern als immanente Voraussetzung des eigenen Wesens anerkennen.","refs":["CL_GB18_17:GA-05","CL_GB18_17:GA-06","CH_GB18_AN_9:A5","CH_GB18_BDEE:AS3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:XD-03","text":"Die Einheit der Vielen entsteht weder trotz noch nach der Differenz, sondern durch eine Negation, die Differenz zugleich setzt, vermittelt und in sich erhält.","refs":["CL_GB18_17:GA-04","CL_GB18_17:GA-07","CH_GB18_AN_9:A12","CH_GB18_BDEE:A13"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:XD-04","text":"Der Übergang von Repulsion zu Attraktion ist kein Wechsel zweier Kräfte, sondern die Selbstumkehr einer negativen Beziehung, deren Ausschließung bereits Selbstbezug enthält.","refs":["CL_GB18_17:GA-02","CL_GB18_17:GA-06","CH_GB18_ADE0:A14","CH_GB18_ADE0:SD4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_17:BSD-01","text":"Das System ersetzt die Ontologie selbständiger Einheiten durch eine Ontologie reproduktiver Vermittlung: Was ist, bleibt nur, indem es die Bedingungen seiner eigenen Negation und Erhaltung hervorbringt.","refs":["CL_GB18_17:GA-02","CL_GB18_17:GA-08","CH_GB18_BDEE:SD2","CH_GB18_BDEE:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:BSD-02","text":"Das Subjektmodell abstrakter Freiheit wird in ein Prozessmodell überführt, in dem Freiheit nur als Anerkennung derjenigen Bestimmtheit möglich ist, die zunächst als Verlust der Selbstständigkeit erscheint.","refs":["CL_GB18_17:GA-01","CL_GB18_17:GA-05","CH_GB18_AN_9:NX1","CH_GB18_AN_9:ME1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:BSD-03","text":"Kausalität wird als zirkuläre Bedingtheit umkartiert: Repulsion erzeugt Vielheit, Vielheit ermöglicht Attraktion, Attraktion erhält die Vielheit als ihre fortdauernde Materie.","refs":["CL_GB18_17:GA-02","CL_GB18_17:GA-06","CL_GB18_17:GA-08","CH_GB18_BDEE:A1","CH_GB18_BDEE:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:BSD-04","text":"Wahrheit kann auf dieser Ebene nicht als ruhendes Resultat erscheinen, sondern nur als Darstellung einer Bewegung, die ihre Voraussetzungen in ihr Resultat zurücknimmt.","refs":["CL_GB18_17:GA-07","CL_GB18_17:GA-08","CH_GB18_AN_9:D4","CH_GB18_BDEE:SD3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_17:RLE-01","text":"Die zentrale Schleife lautet: Ausschließen setzt Andere voraus, die vorausgesetzten Anderen machen Ausschließen zum Beziehen, und dieses Beziehen treibt die Repulsion in Attraktion.","refs":["CH_GB18_ADE0:A4","CH_GB18_ADE0:A14","CH_GB18_ADE0:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RLE-02","text":"Eine zweite Schleife lautet: Attraktion negiert die unmittelbaren Vielen, erhält sie im Einen Eins und benötigt ihre fortdauernde Reproduktion, um Attraktion zu bleiben.","refs":["CH_GB18_BDEE:A10","CH_GB18_BDEE:A13","CH_GB18_BDEE:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RLE-03","text":"Der begriffliche Attraktor ist vermittelte Einheit: Jede isolierte Bestimmung wird durch die Notwendigkeit zurückgeführt, das ausgeschlossene Andere als eigene Bedingung aufzunehmen.","refs":["CH_GB18_AN_9:SD1","CH_GB18_BDEE:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RLE-04","text":"Der Eskalationspfad führt von äußerlicher Nicht-Beziehung über negative Selbstbeziehung und Selbstzerstörung zu einer Einheit, die Differenz nicht beseitigt, sondern als ihre innere Tätigkeit organisiert.","refs":["CH_GB18_ADE0:NX1","CH_GB18_AN_9:D1","CH_GB18_BDEE:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_17:FGS-B01","text":"Unmittelbares Eins + vorausgesetzte Viele → Ausschließung trifft auf bereits Seiendes und verfehlt damit reine Selbstgenügsamkeit.","refs":["CH_GB18_ADE0:AS3","CH_GB18_BDEE:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FGS-B02","text":"Ausschließung + gleiche Bestimmung aller Eins → Repulsion wird gemeinsames Dasein, in dem Verschiedenheit nur durch ihre eigene Negation fortbesteht.","refs":["CH_GB18_ADE0:A6","CH_GB18_ADE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FGS-B03","text":"Negative Selbstbeziehung + Behandlung des eigenen Wesens als Fremdes → Selbstzerstörung der abstrakten Selbstständigkeit.","refs":["CH_GB18_AN_9:A2","CH_GB18_AN_9:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FGS-B04","text":"Anerkennung des Negierten als eigenes Wesen → Versöhnung und Umkodierung der Negation in vermittelte Selbstbeziehung.","refs":["CH_GB18_AN_9:AS4","CH_GB18_AN_9:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FGS-B05","text":"Repulsion als unvollständige Idealität + Attraktion als gesetzte Negation → vermitteltes Eine Eins.","refs":["CH_GB18_BDEE:D1","CH_GB18_BDEE:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FGS-B06","text":"Vermitteltes Eine Eins + Erhaltung der Vielen → nichtabschließbare Einheit von Repulsion und Attraktion.","refs":["CH_GB18_BDEE:A14","CH_GB18_BDEE:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_17:AFM-B01","text":"Unmittelbare Selbstständigkeit → vorausgesetzte Vielheit → Ausschließung → gemeinsame negative Beziehung → Gleichheit der Bestimmungen → Krise abstrakter Selbständigkeit → Anerkennung des Negierten → Attraktion → vermitteltes Eine Eins → Reproduktion der Vielheit.","refs":["CH_GB18_ADE0:AF1","CH_GB18_AN_9:AF1","CH_GB18_BDEE:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_17:MME-01","text":"Einheit und Vielheit werden von ausschließenden Gegenbegriffen zu rekursiv ineinander übergehenden Funktionsmomenten umkartiert.","refs":["CH_GB18_ADE0:ME5","CH_GB18_BDEE:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MME-02","text":"Freiheit wird nicht mehr als Besitz einer isolierten Innerlichkeit, sondern als vermittelte Anerkennung desjenigen Bezugs lesbar, den abstrakte Selbstständigkeit abweist.","refs":["CH_GB18_AN_9:ME1","CH_GB18_AN_9:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MME-03","text":"Negation wird von einer bloß zerstörenden Operation zu einer produktiven Bedingung von Selbsterhaltung, Differenz und Einheit reorganisiert.","refs":["CH_GB18_ADE0:D7","CH_GB18_BDEE:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MME-04","text":"Das Eine Eins wird vom scheinbaren Ursprung zum Resultat und zugleich zum Träger einer fortgesetzten Vermittlung reklassifiziert.","refs":["CH_GB18_BDEE:SD3","CH_GB18_BDEE:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_17:ALT-B01","text":"Auf der Oberfläche werden Eins, Viele, Ausschließung, Freiheit, Versöhnung und Attraktion als explizite Gegenstände behandelt.","refs":["CH_GB18_ADE0:ALT1","CH_GB18_AN_9:ALT1","CH_GB18_BDEE:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:ALT-B02","text":"Strukturell organisiert das System Sein durch negative Beziehung, wechselseitige Voraussetzung, Erhaltung im Aufheben und reproduktive Vermittlung.","refs":["CH_GB18_ADE0:ALT2","CH_GB18_BDEE:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:ALT-B03","text":"Metastrategisch ersetzt die Bewegung äußere Vergleichung und isolierende Verstandesbestimmung durch die Analyse dessen, was die Beziehung selbst setzt.","refs":["CH_GB18_ADE0:ALT3","CH_GB18_AN_9:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:ALT-B04","text":"Ontologisch und temporal erscheint Sein als Werden, dessen Resultate die Bedingungen ihrer eigenen Hervorbringung aufnehmen und fortsetzen müssen.","refs":["CH_GB18_ADE0:ALT4","CH_GB18_BDEE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:ALT-B05","text":"Methodologisch vollzieht die Darstellung ihre These, indem sie ruhende Sätze in Übergänge, Umkehrungen und rekursive Folgeformen überführt.","refs":["CH_GB18_AN_9:A6","CH_GB18_BDEE:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_17:FL-01","text":"Die Einheit soll aus der Negation der Vielen hervorgehen, muss die Vielen aber zugleich erhalten; die Spannung ist produktiv, weil sie den Unterschied zwischen abstrakter Vernichtung und Vermittlung erzwingt.","refs":["CH_GB18_BDEE:A13","CH_GB18_BDEE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FL-02","text":"Die Eins werden als bereits seiend vorausgesetzt, während ihr Dasein zugleich durch ihre Beziehung gesetzt wird; diese Doppelstellung bleibt der notwendige Ausgangspunkt der Bewegung.","refs":["CH_GB18_ADE0:MRT5","CH_GB18_ADE0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FL-03","text":"Vollendete Attraktion erscheint als mögliche Vollendung und zugleich als Selbstaufhebung der Attraktion; das System benötigt diese Unabschließbarkeit, um Einheit als Tätigkeit zu erhalten.","refs":["CH_GB18_BDEE:A7","CH_GB18_BDEE:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MP-01","text":"Repulsion mutiert vom äußeren Ausschließen zur Selbstbeziehung, sobald sichtbar wird, dass das Ausschließende nur durch das ausgeschlossene Eins bestimmt ist.","refs":["CH_GB18_ADE0:A14","CH_GB18_ADE0:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MP-02","text":"Selbstständigkeit mutiert in Versöhnung, sobald die negative Behandlung des eigenen Wesens als Selbstzerstörung erkannt wird.","refs":["CH_GB18_AN_9:AS2","CH_GB18_AN_9:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MP-03","text":"Attraktion mutiert von der Vorstellung eines sammelnden Endvorgangs zu einer reproduktiven Tätigkeit, die ihre eigene Materie nicht endgültig aufheben darf.","refs":["CH_GB18_BDEE:D5","CH_GB18_BDEE:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_17:HSI-01","text":"Die Realität erscheint als Maschine negativer Vermittlung, in der jede Einheit nur durch die Hervorbringung und Aufnahme ihrer eigenen Differenz bestehen kann.","refs":["CH_GB18_ADE0:A12","CH_GB18_BDEE:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:HSI-02","text":"Das Subjekt erscheint als prekäre Selbstbeziehung: Es verliert sich, wenn es das Andere absolutisiert, und gewinnt sich nur, indem es das Negierte als eigenes Wesen anerkennt.","refs":["CH_GB18_AN_9:AS3","CH_GB18_AN_9:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:HSI-03","text":"Zeit erscheint als rekursive Dauer statt als lineare Vollendung, weil jedes Resultat seine verdrängte Voraussetzung in sich bewahren und reproduzieren muss.","refs":["CH_GB18_BDEE:SD2","CH_GB18_BDEE:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:HSI-04","text":"Kampf, Erfassung und Flucht sind nur als immanente Umwendung möglich: Nicht die Vernichtung des Anderen, sondern die Transformation seines Status in der Beziehung erzeugt Bewegung.","refs":["CH_GB18_ADE0:SD2","CH_GB18_AN_9:D3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_17:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von abstrakter Selbstständigkeit über Repulsion und Selbstnegation zur Attraktion und zum vermittelten Einen Eins zu rekonstruieren.","refs":["CH_GB18_ADE0:MRT1","CH_GB18_AN_9:MRT1","CH_GB18_BDEE:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MRT-B02","text":"Die Rekonstruktion ist am stärksten dort, wo die Gleichheit der konstitutiven Bestimmungen die behauptete selbständige Verschiedenheit unterläuft und Einheit als ihre immanente Wahrheit ausweist.","refs":["CH_GB18_ADE0:MRT4","CH_GB18_AN_9:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MRT-B03","text":"Unterbestimmt bleibt die konkrete Weise, in der Seyn, Idealität, Unendlichkeit und die fortdauernde Erzeugung der Vielen begrifflich vermittelt werden.","refs":["CH_GB18_ADE0:MRT2","CH_GB18_BDEE:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MRT-B04","text":"Die Architektur bleibt kohärent, sofern Negation zugleich als Bedingung der Erhaltung und als Grund der Auflösung begriffen wird und Attraktion nicht als ruhendes Endprodukt gelesen wird.","refs":["CH_GB18_ADE0:MRT3","CH_GB18_BDEE:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MRT-B05","text":"Die axiomatische Reduktion kann die systemische Bewegung bewahren, verliert aber notwendig die ausführliche Vermittlung, durch die Vergleichung, Selbstzerstörung, Versöhnung und reproduktive Einheit ineinander übergehen.","refs":["CH_GB18_ADE0:MRT7","CH_GB18_AN_9:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121231749563Z_fb5916ad","language_code":"en","language_name":"English","title":"Chapters 49–51","source_sha256":"7d1d59ea31d093ae683762daeed22d41bf4904349bec825c85bd9fe8ee54977e","sha256":"29dbe81b33cafebde08ae14e5550ea51338fb1c651f8a5c097f421e3333f1d70","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:12:31.753692+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_17:AS-B01","text":"The problem consists in how the One can appear as an independent determination, although its independence becomes effective only through a relation to other Ones.","refs":["CH_GB18_ADE0:AS1","CH_GB18_AN_9:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B02","text":"The exclusion of the many presupposes the many that it seeks to reject; its negative operation therefore produces not pure separation, but a shared field of relation.","refs":["CH_GB18_ADE0:AS3","CH_GB18_BDEE:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B03","text":"The initial independence proves to be abstract self-negation: what begins as the securing of the One against the Other destroys the isolated form that it asserts.","refs":["CH_GB18_ADE0:NX5","CH_GB18_AN_9:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B04","text":"Attraction is not a counterforce to repulsion, but its immanent reversal into self-relation, recognition, and mediated unity.","refs":["CH_GB18_ADE0:AS7","CH_GB18_BDEE:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B05","text":"The One One arises not through the erasure of multiplicity, but through multiplicity entering unity as a negated, preserved, and continuing presupposition.","refs":["CH_GB18_BDEE:AS4","CH_GB18_BDEE:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B06","text":"The movement is recursive and not terminal: repulsion produces the material of attraction, while attraction preserves and reproduces the multiplicity on which it depends.","refs":["CH_GB18_BDEE:A5","CH_GB18_BDEE:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:AS-B07","text":"The closure therefore consists not in static identity, but in a unity whose subsistence presupposes the continued mediation of difference, negation, and return.","refs":["CH_GB18_AN_9:A6","CH_GB18_BDEE:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_17:GA-01","text":"[Persistent] Independence is effective only as a negative relation to an Other and cannot assume an absolutely isolated form.","refs":["CH_GB18_ADE0:A3","CH_GB18_AN_9:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-02","text":"[Persistent] Repulsion presupposes the many that it excludes; it is therefore relation and not mere external repelling.","refs":["CH_GB18_ADE0:A4","CH_GB18_ADE0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-03","text":"[Mutating] Exclusion initially functions as self-preservation, but turns into the dissolution of the asserted independent difference.","refs":["CH_GB18_ADE0:A8","CH_GB18_ADE0:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-04","text":"[Emergent] The equality of being-in-itself and of mutual negating does not sublate the many into mere uniformity, but makes their unity visible as an immanent determination.","refs":["CH_GB18_ADE0:A10","CH_GB18_AN_9:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-05","text":"[Mutating] The negative relation to the Other becomes true when what is negated is recognized as one's own essence and is no longer treated as an external adversary.","refs":["CH_GB18_AN_9:AS4","CH_GB18_AN_9:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-06","text":"[Attractor] Attraction is the realization of an ideality inherent in repulsion and presupposes repulsion as its own premise.","refs":["CH_GB18_BDEE:AS2","CH_GB18_BDEE:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-07","text":"[Terminal] The One One is not an original ground, but the mediated result that contains repulsion and attraction as its inner determination.","refs":["CH_GB18_BDEE:A11","CH_GB18_BDEE:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GA-08","text":"[Attractor] Unity subsists only as the continued preservation of multiplicity in its negation; a completed sublation of the many would annihilate attraction itself.","refs":["CH_GB18_BDEE:A7","CH_GB18_BDEE:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_17:RMD-01","text":"The One recurs as stable identity, but mutates from immediate singularity through exclusive self-assertion into a mediated One One.","refs":["CH_GB18_ADE0:A1","CH_GB18_BDEE:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RMD-02","text":"Repulsion is functionally repeated as exclusion, self-preservation, and self-relation; its seemingly negative valence tips over into the condition of attraction.","refs":["CH_GB18_ADE0:A6","CH_GB18_ADE0:D8","CH_GB18_BDEE:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RMD-03","text":"Multiplicity migrates from the presupposition of external non-relation into the inner material of unity and is thereby absorbed into a higher structure of mediation.","refs":["CH_GB18_ADE0:A2","CH_GB18_BDEE:A5","CH_GB18_BDEE:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RMD-04","text":"Independence mutates from abstract self-sufficiency into a form that gains its truth only through recognition of the negated relation.","refs":["CH_GB18_AN_9:A1","CH_GB18_AN_9:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RMD-05","text":"The static propositional form disappears as an adequate form of truth after having made visible the necessity of a processual presentation of unity and difference.","refs":["CH_GB18_AN_9:A6","CH_GB18_AN_9:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_17:CGD-01","text":"Locally, the determination of repulsion as the exclusion of already existing Ones remains; at the cluster level, only its function as the self-contradiction of isolated independence carries weight.","refs":["CH_GB18_ADE0:AS3","CH_GB18_AN_9:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:CGD-02","text":"Locally, the comparability of the many remains; at the cluster level, it becomes proof that difference and equality are not separate fundamental forms.","refs":["CH_GB18_AN_9:A8","CH_GB18_AN_9:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:CGD-03","text":"Locally, the presentation of reconciliation as the reversal of a negative attitude remains; at the cluster level, it becomes the general form of the transition from repulsion to attraction.","refs":["CH_GB18_AN_9:AS4","CH_GB18_ADE0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:CGD-04","text":"Locally, the One One remains as the result of attraction; at the cluster level, it is determined as an unclosable unity that must reproduce its own presupposition.","refs":["CH_GB18_BDEE:A11","CH_GB18_BDEE:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_17:GNX-01","text":"Excluded is a multiplicity whose individuals could remain permanently separated through an independent being-in-itself.","refs":["CH_GB18_ADE0:DNX1","CH_GB18_ADE0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GNX-02","text":"Excluded is a being-for-self that could preserve itself without being-for-another and without recognition of a negated essence.","refs":["CH_GB18_ADE0:SNX3","CH_GB18_AN_9:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GNX-03","text":"Excluded is an attraction that operates independently of repulsion or definitively consumes its presupposition.","refs":["CH_GB18_BDEE:NX3","CH_GB18_BDEE:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:GNX-04","text":"Excluded is a unity that would be achieved through the erasure of difference or through a sluggish state of equilibrium.","refs":["CH_GB18_AN_9:NX7","CH_GB18_BDEE:D3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_17:DBN-01","text":"The system cannot admit a model in which relation is subsequently added between substances already fully determined.","refs":["CH_GB18_ADE0:DNX2","CH_GB18_BDEE:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:DBN-02","text":"The system cannot admit a freedom that gains its essence through pure negation, because this operation destroys the being to be secured.","refs":["CH_GB18_AN_9:A3","CH_GB18_AN_9:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:DBN-03","text":"The system cannot admit a final unity that had completely cast off its inner negativity and the preserved multiplicity.","refs":["CH_GB18_BDEE:SNX1","CH_GB18_BDEE:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:DBN-04","text":"The system disqualifies every form of cognition that treats unity and difference as separate alternatives rather than as mutually determining moments of movement.","refs":["CH_GB18_AN_9:DNX4","CH_GB18_AN_9:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_17:BSA-01","text":"The deepest impossibility is an ontologically original identity that would neither generate difference nor have to be mediated through difference.","refs":["CH_GB18_ADE0:SNX2","CH_GB18_AN_9:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:BSA-02","text":"A pure outside is unavailable: the Other can subsist neither as a merely alien boundary nor as material to be definitively excluded.","refs":["CH_GB18_ADE0:NX8","CH_GB18_AN_9:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:BSA-03","text":"Inadmissible is a completion that ends movement, because the termination of mediation would simultaneously sublate the conditions of attraction, unity, and self-relation.","refs":["CH_GB18_BDEE:A7","CH_GB18_BDEE:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_17:XD-01","text":"The self-destruction of abstract independence and the impossibility of completed attraction form the same structure: a determination fails as soon as it seeks to annihilate the relation that sustains its own efficacy.","refs":["CL_GB18_17:GA-01","CL_GB18_17:GA-08","CH_GB18_AN_9:AS3","CH_GB18_BDEE:A7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:XD-02","text":"Reconciliation and attraction are homologous transitional forms because both do not add what was initially negated, but recognize it as an immanent presupposition of their own essence.","refs":["CL_GB18_17:GA-05","CL_GB18_17:GA-06","CH_GB18_AN_9:A5","CH_GB18_BDEE:AS3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:XD-03","text":"The unity of the many arises neither despite nor after difference, but through a negation that simultaneously posits, mediates, and preserves difference within itself.","refs":["CL_GB18_17:GA-04","CL_GB18_17:GA-07","CH_GB18_AN_9:A12","CH_GB18_BDEE:A13"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:XD-04","text":"The transition from repulsion to attraction is not an alternation of two forces, but the self-reversal of a negative relation whose exclusion already contains self-reference.","refs":["CL_GB18_17:GA-02","CL_GB18_17:GA-06","CH_GB18_ADE0:A14","CH_GB18_ADE0:SD4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_17:BSD-01","text":"The system replaces the ontology of independent entities with an ontology of reproductive mediation: what is subsists only by producing the conditions of its own negation and preservation.","refs":["CL_GB18_17:GA-02","CL_GB18_17:GA-08","CH_GB18_BDEE:SD2","CH_GB18_BDEE:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:BSD-02","text":"The subject-model of abstract freedom is transferred into a process-model in which freedom is possible only as recognition of that determinacy which initially appears as the loss of independence.","refs":["CL_GB18_17:GA-01","CL_GB18_17:GA-05","CH_GB18_AN_9:NX1","CH_GB18_AN_9:ME1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:BSD-03","text":"Causality is remapped as circular conditionality: repulsion produces multiplicity, multiplicity enables attraction, attraction preserves multiplicity as its continuing material.","refs":["CL_GB18_17:GA-02","CL_GB18_17:GA-06","CL_GB18_17:GA-08","CH_GB18_BDEE:A1","CH_GB18_BDEE:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_17:BSD-04","text":"At this level, truth cannot appear as a static result, but only as the presentation of a movement that takes its presuppositions back into its result.","refs":["CL_GB18_17:GA-07","CL_GB18_17:GA-08","CH_GB18_AN_9:D4","CH_GB18_BDEE:SD3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_17:RLE-01","text":"The central loop is as follows: excluding presupposes Others, the presupposed Others make excluding into relating, and this relating drives repulsion into attraction.","refs":["CH_GB18_ADE0:A4","CH_GB18_ADE0:A14","CH_GB18_ADE0:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RLE-02","text":"A second loop is as follows: attraction negates the immediate many, preserves them in the One One, and requires their continued reproduction in order to remain attraction.","refs":["CH_GB18_BDEE:A10","CH_GB18_BDEE:A13","CH_GB18_BDEE:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RLE-03","text":"The conceptual attractor is mediated unity: every isolated determination is led back by the necessity of incorporating the excluded Other as its own condition.","refs":["CH_GB18_AN_9:SD1","CH_GB18_BDEE:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:RLE-04","text":"The escalation path leads from external non-relation through negative self-relation and self-destruction to a unity that does not eliminate difference, but organizes it as its inner activity.","refs":["CH_GB18_ADE0:NX1","CH_GB18_AN_9:D1","CH_GB18_BDEE:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_17:FGS-B01","text":"Immediate One + presupposed many → exclusion encounters what already is and thereby fails to achieve pure self-sufficiency.","refs":["CH_GB18_ADE0:AS3","CH_GB18_BDEE:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FGS-B02","text":"Exclusion + equal determination of all Ones → repulsion becomes shared determinate being, in which difference persists only through its own negation.","refs":["CH_GB18_ADE0:A6","CH_GB18_ADE0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FGS-B03","text":"Negative self-relation + treatment of one's own essence as alien → self-destruction of abstract independence.","refs":["CH_GB18_AN_9:A2","CH_GB18_AN_9:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FGS-B04","text":"Recognition of what is negated as one's own essence → reconciliation and recoding of negation into mediated self-relation.","refs":["CH_GB18_AN_9:AS4","CH_GB18_AN_9:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FGS-B05","text":"Repulsion as incomplete ideality + attraction as posited negation → mediated One One.","refs":["CH_GB18_BDEE:D1","CH_GB18_BDEE:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FGS-B06","text":"Mediated One One + preservation of the many → unclosable unity of repulsion and attraction.","refs":["CH_GB18_BDEE:A14","CH_GB18_BDEE:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_17:AFM-B01","text":"Immediate independence → presupposed multiplicity → exclusion → shared negative relation → equality of determinations → crisis of abstract independence → recognition of what is negated → attraction → mediated One One → reproduction of multiplicity.","refs":["CH_GB18_ADE0:AF1","CH_GB18_AN_9:AF1","CH_GB18_BDEE:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_17:MME-01","text":"Unity and multiplicity are remapped from mutually exclusive counterconcepts into functional moments that recursively pass into one another.","refs":["CH_GB18_ADE0:ME5","CH_GB18_BDEE:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MME-02","text":"Freedom becomes legible no longer as possession of an isolated inwardness, but as mediated recognition of the relation rejected by abstract independence.","refs":["CH_GB18_AN_9:ME1","CH_GB18_AN_9:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MME-03","text":"Negation is reorganized from a merely destructive operation into a productive condition of self-preservation, difference, and unity.","refs":["CH_GB18_ADE0:D7","CH_GB18_BDEE:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MME-04","text":"The One One is reclassified from apparent origin into result and, at the same time, into the bearer of a continuing mediation.","refs":["CH_GB18_BDEE:SD3","CH_GB18_BDEE:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_17:ALT-B01","text":"At the surface level, One, many, exclusion, freedom, reconciliation, and attraction are treated as explicit objects.","refs":["CH_GB18_ADE0:ALT1","CH_GB18_AN_9:ALT1","CH_GB18_BDEE:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:ALT-B02","text":"Structurally, the system organizes being through negative relation, mutual presupposition, preservation in sublation, and reproductive mediation.","refs":["CH_GB18_ADE0:ALT2","CH_GB18_BDEE:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:ALT-B03","text":"Metastrategically, the movement replaces external comparison and isolating determination of the understanding with the analysis of what relation itself posits.","refs":["CH_GB18_ADE0:ALT3","CH_GB18_AN_9:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:ALT-B04","text":"Ontologically and temporally, being appears as becoming, whose results must take up and continue the conditions of their own production.","refs":["CH_GB18_ADE0:ALT4","CH_GB18_BDEE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:ALT-B05","text":"Methodologically, the presentation enacts its thesis by transforming static propositions into transitions, reversals, and recursive consequential forms.","refs":["CH_GB18_AN_9:A6","CH_GB18_BDEE:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_17:FL-01","text":"Unity is supposed to arise from the negation of the many, yet must simultaneously preserve the many; the tension is productive because it compels the distinction between abstract annihilation and mediation.","refs":["CH_GB18_BDEE:A13","CH_GB18_BDEE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FL-02","text":"The Ones are presupposed as already being, while their determinate being is simultaneously posited through their relation; this double status remains the necessary point of departure of the movement.","refs":["CH_GB18_ADE0:MRT5","CH_GB18_ADE0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:FL-03","text":"Completed attraction appears as possible completion and, at the same time, as the self-sublation of attraction; the system requires this unclosability in order to preserve unity as activity.","refs":["CH_GB18_BDEE:A7","CH_GB18_BDEE:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MP-01","text":"Repulsion mutates from external exclusion into self-relation as soon as it becomes visible that what excludes is determined only through the excluded One.","refs":["CH_GB18_ADE0:A14","CH_GB18_ADE0:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MP-02","text":"Independence mutates into reconciliation as soon as the negative treatment of one's own essence is recognized as self-destruction.","refs":["CH_GB18_AN_9:AS2","CH_GB18_AN_9:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MP-03","text":"Attraction mutates from the notion of a gathering final process into a reproductive activity that may not definitively sublate its own material.","refs":["CH_GB18_BDEE:D5","CH_GB18_BDEE:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_17:HSI-01","text":"Reality appears as a machine of negative mediation in which every unity can subsist only through the production and incorporation of its own difference.","refs":["CH_GB18_ADE0:A12","CH_GB18_BDEE:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:HSI-02","text":"The subject appears as precarious self-relation: it loses itself when it absolutizes the Other, and gains itself only by recognizing what is negated as its own essence.","refs":["CH_GB18_AN_9:AS3","CH_GB18_AN_9:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:HSI-03","text":"Time appears as recursive duration rather than linear completion, because every result must preserve and reproduce within itself its repressed presupposition.","refs":["CH_GB18_BDEE:SD2","CH_GB18_BDEE:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:HSI-04","text":"Struggle, apprehension, and flight are possible only as immanent reversal: it is not the annihilation of the Other, but the transformation of its status in the relation, that produces movement.","refs":["CH_GB18_ADE0:SD2","CH_GB18_AN_9:D3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_17:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from abstract independence through repulsion and self-negation to attraction and the mediated One One.","refs":["CH_GB18_ADE0:MRT1","CH_GB18_AN_9:MRT1","CH_GB18_BDEE:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MRT-B02","text":"The reconstruction is strongest where the equality of the constitutive determinations undermines the asserted independent difference and demonstrates unity as its immanent truth.","refs":["CH_GB18_ADE0:MRT4","CH_GB18_AN_9:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MRT-B03","text":"What remains underdetermined is the concrete manner in which Seyn, ideality, infinity, and the continuing production of the many are conceptually mediated.","refs":["CH_GB18_ADE0:MRT2","CH_GB18_BDEE:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MRT-B04","text":"The architecture remains coherent insofar as negation is understood simultaneously as the condition of preservation and as the ground of dissolution, and attraction is not read as a static end product.","refs":["CH_GB18_ADE0:MRT3","CH_GB18_BDEE:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_17:MRT-B05","text":"The axiomatic reduction can preserve the systemic movement, but necessarily loses the detailed mediation through which comparison, self-destruction, reconciliation, and reproductive unity pass into one another.","refs":["CH_GB18_ADE0:MRT7","CH_GB18_AN_9:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_17@R001","source_variant_id":"canonical:CL_GB18_17:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 49–51","context":"a. Ausschließen des Eins. · Anmerkung. · b. Das Eine Eins der Attraktion."},"title_language_code":"en"},{"id":"CL_GB18_18","layer":"CL","title":"Chapters 52–54","order":18,"parents":["CH_GB18_CDBD","CH_GB18_A_10","CH_GB18_A_11"],"revision":"CL_GB18_18@R001","sha256":"cca56a338371d208ee80a2bed0d595f133c9263893247c3f1a3768d993938e54","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_18:AS-01","text":"Der Cluster löst das Problem, wie Einheit, Vielheit, Kraft, Materie und Größe ohne vorausgesetzte selbständige Träger gedacht werden können.","refs":["CH_GB18_CDBD:AS1","CH_GB18_A_10:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AS-02","text":"Seine Kernthese lautet, daß Repulsion und Attraktion keine äußeren Ursachen, sondern die wechselseitige Selbstvermittlung einer Einheit sind, die sich nur in ihrer Selbstentzweiung erhält.","refs":["CH_GB18_CDBD:AS6","CH_GB18_A_10:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AS-03","text":"Die Bewegung ist rekursiv: Ausschluß wird negative Beziehung, negative Beziehung wird Attraktion, Attraktion reproduziert Repulsion, und ihre aufgehobene Differenz erscheint als Quantität.","refs":["CH_GB18_CDBD:AS3","CH_GB18_CDBD:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AS-04","text":"Die Kritik empirischer Krafttheorie fungiert als methodischer Filter: Jede Erklärung, die bereits konstituierte Materie, Raum oder Bewegung voraussetzt, kann deren Hervorbringung nicht erklären.","refs":["CH_GB18_A_10:SD2","CH_GB18_A_10:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AS-05","text":"Die Schließung bleibt vorläufig und beweglich, weil Quantität ihre äußerliche Bestimmtheit nicht festhalten kann, sondern über Quantum und Verhältnis zur Wiederkehr qualitativer Bestimmung und zum Maß drängt.","refs":["CH_GB18_A_11:A8","CH_GB18_A_11:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_18:GA-01","text":"[Persistent] Relata bestehen nicht vor ihrer Beziehung; Einheit und Vielheit erhalten ihre Bestimmtheit ausschließlich durch wechselseitige Setzung.","refs":["CH_GB18_CDBD:A1","CH_GB18_CDBD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-02","text":"[Persistent] Negative Bestimmung ist keine beziehungslose Auslöschung, sondern erhält das Ausgeschlossene als notwendiges Moment ihrer eigenen Wirksamkeit.","refs":["CH_GB18_CDBD:AS3","CH_GB18_CDBD:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-03","text":"[Mutating] Repulsion und Attraktion mutieren von scheinbar materiellen Kräften zu logischen Übergangsmomenten, deren jeweilige Identität nur im Übergehen in ihr Gegenteil besteht.","refs":["CH_GB18_A_10:A2","CH_GB18_A_10:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-04","text":"[Persistent] Eine Erklärung ist ungültig, wenn sie den zu erzeugenden Gegenstand bereits als räumlich, materiell oder bewegt voraussetzt und seine vorausgesetzten Eigenschaften nachträglich als Gründe ausgibt.","refs":["CH_GB18_A_10:A4","CH_GB18_A_10:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-05","text":"[Emergent] Quantität entsteht nicht neben der Qualität, sondern als ihre vermittelte Externalisierung, in der qualitative Grenze erhalten, aber dem Sein äußerlich und gleichgültig geworden ist.","refs":["CH_GB18_CDBD:AS7","CH_GB18_A_11:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-06","text":"[Mutating] Die Repulsion der Vielen wird nicht aufgehoben, indem sie verschwindet, sondern indem ihr Ausschluß in nicht-ausschließende Kontinuität übergeht.","refs":["CH_GB18_A_11:A4","CH_GB18_A_11:NX9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-07","text":"[Persistent] Die quantitative Grenze ist äußerlich und veränderlich, doch gerade ihre Gleichgültigkeit zwingt sie über sich hinaus und verhindert ihre Fixierung als letzte Bestimmtheit.","refs":["CH_GB18_A_11:A5","CH_GB18_A_11:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-08","text":"[Attractor] Selbstbeziehung wird auf der quantitativen Ebene nur im Anderssein möglich: Ein Quantum erhält seine Bestimmung in einem anderen und drängt dadurch zum Verhältnis.","refs":["CH_GB18_A_11:A11","CH_GB18_A_11:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-09","text":"[Terminal] Der unendliche Progreß ist keine abschließende Totalität, sondern die Selbstaufhebung der gleichgültigen Quantität und die Rückkehr qualitativer Bestimmung.","refs":["CH_GB18_A_11:A10","CH_GB18_A_11:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-10","text":"[Attractor] Begriffliche Konstruktion verlangt, daß die Bedingungen eines Gegenstands aus dessen immanenter Bewegung hervorgebracht und nicht als empirische Voraussetzungen umetikettiert werden.","refs":["CH_GB18_A_10:A4","CH_GB18_A_10:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_18:RMD-01","text":"Das Eine kehrt nicht als stabile Substanz wieder, sondern mutiert zur Prozessform seiner Selbstentzweiung in Viele und seiner Rückkehr aus ihnen.","refs":["CH_GB18_CDBD:AS6","CH_GB18_CDBD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RMD-02","text":"Repulsion verschiebt sich von wechselseitigem Ausschluß zur Kontinuität; ihre ursprüngliche Trennungsfunktion wird zur Bedingung nicht-ausschließender Vielheit.","refs":["CH_GB18_CDBD:A2","CH_GB18_A_11:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RMD-03","text":"Attraktion und Repulsion verlieren ihre physikalische Rollenidentität und werden als Regeln gegenseitiger Funktionsübernahme und Selbstnegation absorbiert.","refs":["CH_GB18_A_10:AS1","CH_GB18_A_10:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RMD-04","text":"Die Grenze mutiert von wesentlicher qualitativer Bestimmtheit zu äußerlicher quantitativer Bestimmbarkeit, ohne daß ihre qualitative Herkunft vollständig verschwindet.","refs":["CH_GB18_CDBD:A12","CH_GB18_A_11:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RMD-05","text":"Unendlichkeit wird von der Vorstellung endloser Zerstreuung in die Funktion der Selbstnegation überführt, durch welche Quantität wieder auf Qualität verweist.","refs":["CH_GB18_CDBD:SNX2","CH_GB18_A_11:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RMD-06","text":"Materie verschwindet nach ihrer kritischen Funktion als ontologischer Träger und bleibt nur als Prüfstein dafür erhalten, ob Erklärung Konstruktion oder analytische Rückprojektion betreibt.","refs":["CH_GB18_A_10:AS2","CH_GB18_A_10:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_18:CGD-01","text":"Die Prüfung einzelner Kraftbestimmungen bleibt lokal; auf Clusterebene wird sie zum allgemeinen Kriterium, daß Erklärung ihren Gegenstand nicht als fertige Voraussetzung importieren darf.","refs":["CH_GB18_A_10:ALT1","CH_GB18_A_10:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:CGD-02","text":"Flächenkraft, Durchdringungskraft, Berührung und Kontinuität sind lokale problematische Figuren; global zeigen sie, daß jede feste Funktionsverteilung bereits die Bedingungen ihrer Anwendung voraussetzt.","refs":["CH_GB18_A_10:A7","CH_GB18_A_10:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:CGD-03","text":"Zentripetal- und Zentrifugalkraft bleiben lokale Beispiele; ihre skalierte Funktion besteht darin, die Zirkularität jeder Erklärung offenzulegen, die Erscheinungen in variable Kräfte zurückverlegt.","refs":["CH_GB18_A_10:A10","CH_GB18_A_10:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:CGD-04","text":"Die Unterscheidung einzelner quantitativer und qualitativer Veränderungen bleibt lokal; auf Clusterebene trägt sie die These, daß äußere Variation eine innere Grenze nie endgültig ersetzen kann.","refs":["CH_GB18_A_11:D9","CH_GB18_A_11:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:CGD-05","text":"Kraft, Materie, Raum und Größe werden nicht als selbständige Gegenstandsbereiche bewahrt, sondern als regionale Gestalten einer allgemeinen Logik immanenter Selbstvermittlung umcodiert.","refs":["CH_GB18_CDBD:ME3","CH_GB18_A_11:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_18:GNX-01","text":"Ausgeschlossen ist ein Modell zweier ursprünglicher, selbständiger Kräfte, die in einem neutralen materiellen Dritten lediglich zusammentreffen.","refs":["CH_GB18_CDBD:NX4","CH_GB18_A_10:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GNX-02","text":"Ausgeschlossen ist jede Konstruktion, die fertige Materie, Kontinuität, Raum oder Bewegung voraussetzt, um diese anschließend aus Kräften abzuleiten.","refs":["CH_GB18_A_10:AS4","CH_GB18_A_10:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GNX-03","text":"Ausgeschlossen ist eine Negation, die ihr Negiertes vollständig verliert, sowie eine Grenze, die absolute Trennung ohne vermittelte Einheit stiften könnte.","refs":["CH_GB18_CDBD:DNX2","CH_GB18_CDBD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GNX-04","text":"Ausgeschlossen ist eine quantitative Unendlichkeit, die als fertiger Abschluß oder als neutrale Selbstbestimmung der Größe verstanden werden könnte.","refs":["CH_GB18_A_11:NX5","CH_GB18_A_11:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_18:DBN-01","text":"Das System kann keine Ontologie zulassen, in der Relata der Beziehung vorausliegen; sonst verlören Ausschluß, Attraktion und Selbstvermittlung ihre konstitutive Funktion.","refs":["CH_GB18_CDBD:DNX1","CH_GB18_A_10:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:DBN-02","text":"Es kann keinen Gegenstand zulassen, der zugleich Resultat seiner Kräfte und deren bereits fertiger Träger wäre; diese Doppelstellung zerstört den Unterschied von Genesis und Analyse.","refs":["CH_GB18_A_10:DNX1","CH_GB18_A_10:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:DBN-03","text":"Es kann keine vollständig innere oder absolut äußere Grenze zulassen, weil Grenze nur als vermittelte Bestimmtheit zwischen Selbstbeziehung und Anderssein tragfähig ist.","refs":["CH_GB18_CDBD:SNX3","CH_GB18_A_11:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:DBN-04","text":"Es kann keine Definition der Größe zulassen, die ihre Veränderungsoperationen begrifflich voraussetzungslos erklärt, weil die quantitative Form selbst äußerliches Hinzufügen und Wegnehmen enthält.","refs":["CH_GB18_A_11:NX8","CH_GB18_A_11:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_18:BSA-01","text":"Unverfügbar ist ein schlechthin erstes Eines oder eine ursprüngliche Materie, die vor der Bewegung ihrer Selbstsetzung bestehen könnte.","refs":["CH_GB18_CDBD:SNX1","CH_GB18_A_10:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:BSA-02","text":"Unverfügbar ist eine endgültige Vielheit oder unendliche Progression, deren Zerstreuung nicht in eine veränderte Form qualitativer Bestimmung zurückkehrt.","refs":["CH_GB18_CDBD:SNX2","CH_GB18_A_11:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:BSA-03","text":"Unverfügbar ist eine unmittelbar gegebene absolute Einheit von Qualität und Quantität; Einheit erscheint nur als Resultat eines Verhältnisses, das seine eigene Äußerlichkeit überschreitet.","refs":["CH_GB18_CDBD:DNX3","CH_GB18_A_11:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_18:XD-01","text":"Die Kritik äußerlicher Krafttheorie wird zur positiven Geltungsbedingung dialektischer Konstruktion: Nur eine Bestimmung, die ihre Voraussetzungen selbst erzeugt, kann als Erklärung gelten.","refs":["CL_GB18_18:GA-01","CL_GB18_18:GA-10","CH_GB18_CDBD:A6","CH_GB18_A_10:SD2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_18:XD-02","text":"Die quantitative Kontinuität ist nicht ein zusätzlicher Zustand neben Repulsion, sondern deren notwendige Transformation, sobald Ausschluß als negative Beziehung begriffen wird.","refs":["CL_GB18_18:GA-02","CL_GB18_18:GA-06","CH_GB18_CDBD:AS3","CH_GB18_A_11:A4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_18:XD-03","text":"Das quantitative Verhältnis macht Anderssein zur Form von Selbstbeziehung und bildet damit die Brücke, auf der die äußere Bestimmtheit des Quantums in Maß übergehen kann.","refs":["CL_GB18_18:GA-07","CL_GB18_18:GA-08","CH_GB18_A_11:A11","CH_GB18_A_11:A12"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_18:XD-04","text":"Die Antimechanik des Clusters erzeugt keine bloße Zurückweisung physikalischer Erklärung, sondern eine kategoriale Genesis, in der die Unzulänglichkeit fester Kräfte den Übergang zur Quantität antreibt.","refs":["CL_GB18_18:GA-03","CL_GB18_18:GA-05","CH_GB18_A_10:SD4","CH_GB18_A_11:SD2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_18:XD-05","text":"Die Äußerlichkeit der Quantität ist zugleich ihre Produktivkraft und ihr Defizit: Sie erlaubt Veränderung ohne unmittelbare Wesensauflösung, kann aber keine abschließende Selbstbegründung liefern.","refs":["CL_GB18_18:GA-07","CL_GB18_18:GA-09","CH_GB18_A_11:SD4","CH_GB18_A_11:MRT4"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_18:BSD-01","text":"Realität erscheint als Produktionszusammenhang, in dem Identitäten keine vorausliegenden Substanzen, sondern stabilisierte Resultate von Selbstunterscheidung und Rückkehr sind.","refs":["CL_GB18_18:GA-01","CL_GB18_18:GA-05","CH_GB18_CDBD:AS6","CH_GB18_A_11:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_18:BSD-02","text":"Kausalität wird von äußerer Einwirkung auf immanente Bedingungsproduktion umgestellt: Ein Prozess erklärt nur, was er als Bedingung seines eigenen Vollzugs hervorbringt.","refs":["CL_GB18_18:GA-04","CL_GB18_18:GA-10","CH_GB18_CDBD:ALT3","CH_GB18_A_10:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_18:BSD-03","text":"Zeitlichkeit erscheint weder als Ursprung noch als bloßes Nacheinander, sondern als rekursive Bewegung, in der äußerliche Progression ihre qualitative Voraussetzung wiederherstellt.","refs":["CL_GB18_18:GA-09","CH_GB18_A_11:A9","CH_GB18_A_11:SNX3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_18:BSD-04","text":"Mathematik verliert den Status eines neutralen Fundaments und erscheint als abstrahierte Form äußerlicher Operationen, deren Begriffe genetischer Rekonstruktion bedürfen.","refs":["CL_GB18_18:GA-07","CL_GB18_18:GA-10","CH_GB18_A_11:AS6","CH_GB18_A_11:ME6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_18:RLE-01","text":"Ausschluß erzeugt Beziehung auf das Ausgeschlossene, Beziehung erzeugt Idealität, Idealität setzt Einheit, und Einheit erzeugt erneut die Vielheit, die sie negiert.","refs":["CH_GB18_CDBD:D5","CH_GB18_CDBD:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RLE-02","text":"Der mechanische Erklärungsversuch bildet eine Rückkopplungsschleife: Empirisch vorausgesetzte Materie wird in Kräfte zerlegt, deren Definition wiederum jene Materie voraussetzt.","refs":["CH_GB18_A_10:AS2","CH_GB18_A_10:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RLE-03","text":"Quantität eskaliert als reine Kontinuität zum Quantum, überschreitet sich im unendlichen Progreß und kehrt als wiederhergestellte Qualität in eine höhere Vermittlungsform zurück.","refs":["CH_GB18_A_11:A8","CH_GB18_A_11:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RLE-04","text":"Selbstvoraussetzung ist der zentrale Attraktor: Jede tragende Bestimmung produziert die Bedingung, die zunächst als ihr äußeres Vorausgesetztsein erscheint.","refs":["CH_GB18_CDBD:A6","CH_GB18_CDBD:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RLE-05","text":"Die Grenze fungiert als begrifflicher Attraktor, weil sie zugleich äußerlich sein muß, um Quantität zu ermöglichen, und aufgehoben werden muß, um deren Rückkehr zur Qualität zu erklären.","refs":["CH_GB18_A_11:A5","CH_GB18_A_11:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_18:FGS-B01","text":"Einheit/Vielheit → scheinbar selbständige Bestimmungen → Aufdeckung ihrer ausschließlichen Relationalität.","refs":["CH_GB18_CDBD:AS1","CH_GB18_CDBD:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FGS-B02","text":"Repulsion → negative Beziehung auf Ausgeschlossenes → immanente Attraktion → Attraktion → Setzung des Einen → immanente Repulsion.","refs":["CH_GB18_CDBD:AS3","CH_GB18_CDBD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FGS-B03","text":"Äußerliche Krafttheorie → vorausgesetzte Materie, Raum und Bewegung → analytische Zirkularität → Ausschluß äußerer Kausalmodelle.","refs":["CH_GB18_A_10:A3","CH_GB18_A_10:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FGS-B04","text":"Aufgehobene qualitative Differenz → äußere Gleichgültigkeit der Grenze → reine Quantität → äußerlich bestimmtes Quantum.","refs":["CH_GB18_CDBD:AS7","CH_GB18_A_11:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FGS-B05","text":"Quantum → Selbstüberschreitung → unendlicher Progreß → Wiederherstellung der Qualität → Verhältnis → Maß.","refs":["CH_GB18_A_11:AS4","CH_GB18_A_11:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_18:AFM-B01","text":"Einheit und Vielheit → Repulsion und Attraktion → Widerlegung äußerlicher Selbständigkeit → Selbstvermittlung.","refs":["CH_GB18_CDBD:AS1","CH_GB18_CDBD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AFM-B02","text":"Ausschluß → negative Beziehung → Idealität des Ausgeschlossenen → Aufhebung des festen Einen.","refs":["CH_GB18_CDBD:D5","CH_GB18_CDBD:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AFM-B03","text":"Empirisch vorausgesetzte Materie → Kraftzuweisung → Rückkehr der Voraussetzungen → Diagnose analytischer Zirkularität.","refs":["CH_GB18_A_10:FGS2","CH_GB18_A_10:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AFM-B04","text":"Aufgehobene qualitative Grenze → Quantität → Quantum → unendlicher Progreß → Wiederherstellung der Qualität.","refs":["CH_GB18_A_11:FGS3","CH_GB18_A_11:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AFM-B05","text":"Quantitatives Verhältnis → Selbstbeziehung im Anderssein → formelle Einheit von Qualität und Quantität → Maß.","refs":["CH_GB18_A_11:FGS6","CH_GB18_A_11:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_18:MME-01","text":"Kräfte werden aus der Karte physikalischer Grundursachen entfernt und als logische Figuren der Selbstunterscheidung von Einheit und Vielheit neu klassifiziert.","refs":["CH_GB18_A_10:A1","CH_GB18_A_10:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MME-02","text":"Die Grenze zwischen Konstruktion und Analyse wird neu gezogen: Nicht die Form der Ableitung, sondern die Herkunft ihrer Voraussetzungen entscheidet über ihre Geltung.","refs":["CH_GB18_A_10:A4","CH_GB18_A_10:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MME-03","text":"Vielheit wird von numerischer Zerstreuung zu kontinuierlicher Einheit umkartiert, wodurch Ausschluß und Kontinuität als Phasen desselben Prozesses lesbar werden.","refs":["CH_GB18_CDBD:ME1","CH_GB18_A_11:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MME-04","text":"Größe und Mathematik werden als sekundäre Gestalten äußerlicher Bestimmbarkeit kartiert, nicht als voraussetzungslose Sprache des Quantitativen.","refs":["CH_GB18_A_11:A15","CH_GB18_A_11:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_18:ALT-B01","text":"Auf der Oberflächenebene untersucht der Cluster Repulsion, Attraktion, Materie, Quantität, Quantum, Verhältnis und Maß als aufeinander bezogene Kategorien.","refs":["CH_GB18_CDBD:ALT1","CH_GB18_A_11:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:ALT-B02","text":"Auf der strukturellen Ebene zeigt er, daß jede Bestimmung ihre eigenen Voraussetzungen setzt, während quantitative Grenze als äußerliche Form dieser Selbstvermittlung erscheint.","refs":["CH_GB18_CDBD:ALT2","CH_GB18_A_11:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:ALT-B03","text":"Auf der metastrategischen Ebene ersetzt er das Suchen nach passenden Ursachen durch die Prüfung, ob Begriffe ihren Gegenstand erzeugen oder nur voraussetzen.","refs":["CH_GB18_CDBD:ALT3","CH_GB18_A_11:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:ALT-B04","text":"Auf der ontologischen und temporalen Ebene wird Sein als Werden bestimmt, dessen Stabilität nur aus der wiederholten Selbstaufhebung und Selbstwiederherstellung seiner Bestimmungen entsteht.","refs":["CH_GB18_CDBD:ALT4","CH_GB18_A_11:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:ALT-B05","text":"Auf der methodologischen und performativen Ebene vollzieht der Cluster, was er behauptet: Er entzieht äußeren Erklärungen ihre Selbständigkeit und rekonstruiert sie als Bewegungen ihrer immanenten Voraussetzungen.","refs":["CH_GB18_A_10:SD3","CH_GB18_A_10:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_18:FL-01","text":"Die positive Hervorbringung von Materie bleibt unterbestimmt, obwohl die Kritik ihrer analytischen Voraussetzungsstruktur stark ausgearbeitet ist.","refs":["CH_GB18_A_10:MRT2","CH_GB18_A_10:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FL-02","text":"Die Quantität muß zugleich dem Sein äußerlich und als dialektisch wirksame Instanz gedacht werden, die aus sich selbst die Wiederherstellung von Qualität erzwingt.","refs":["CH_GB18_A_11:MRT4","CH_GB18_A_11:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FL-03","text":"Der Übergang vom quantitativen Verhältnis zum Maß wird als notwendig angezeigt, aber nicht vollständig aus der formellen Einheit des Verhältnisses expliziert.","refs":["CH_GB18_A_11:MRT3","CH_GB18_A_11:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MP-01","text":"Repulsion mutiert am entscheidenden Umschlagspunkt von ausschließender Vielheit zu Kontinuität und verändert damit die Bedeutung von Vielheit selbst.","refs":["CH_GB18_A_11:A4","CH_GB18_A_11:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MP-02","text":"Der Kraftbegriff mutiert von einer scheinbar sachlichen Bestimmung materieller Wirklichkeit zu einem Symptom äußerlicher Erklärung und schließlich zu einem logischen Moment der Selbstvermittlung.","refs":["CH_GB18_A_10:AS1","CH_GB18_A_10:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_18:HSI-01","text":"Die Realität erscheint als Maschine immanenter Selbstproduktion, in der jede Trennung die Beziehung erzeugt, die sie zu leugnen versucht.","refs":["CH_GB18_CDBD:AS5","CH_GB18_CDBD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:HSI-02","text":"Das Etwas erscheint nicht als abgeschlossenes Substrat, sondern als bleibende Identität unter veränderlichen äußeren Grenzen, deren qualitativer Umschlag seine Bestimmtheit verändern kann.","refs":["CH_GB18_A_11:SD3","CH_GB18_A_11:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:HSI-03","text":"Zeit erscheint als rekursive Rückkehr: Fortschritt ist keine bloße Fortsetzung, sondern die Selbstaufhebung einer Form in die Bedingung ihrer eigenen qualitativen Transformation.","refs":["CH_GB18_A_11:A9","CH_GB18_A_11:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:HSI-04","text":"Erkenntnis ist nur dort möglich, wo sie äußere Erklärungsinstanzen in immanente Produktionsbedingungen zurückübersetzt und die Zirkularität ihrer Voraussetzungen sichtbar macht.","refs":["CH_GB18_CDBD:ALT3","CH_GB18_A_10:ALT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_18:MRT-B01","text":"Die globalen Axiome reichen aus, um die Bewegung von Einheit und Vielheit über die Kritik äußerlicher Kraftmodelle bis zur Entstehung der Quantität als vermittelte Externalität zu rekonstruieren.","refs":["CH_GB18_CDBD:MRT1","CH_GB18_A_11:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MRT-B02","text":"Unterbestimmt bleiben die vollständige positive Genesis der Materie, die Symmetrie von Attraktion und Repulsion sowie die explizite Notwendigkeit des Übergangs vom Verhältnis zum Maß.","refs":["CH_GB18_CDBD:MRT3","CH_GB18_A_11:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MRT-B03","text":"Die Rekonstruktion bleibt nur dann kohärent, wenn die negativen Ausschlüsse, die Rückkehr der Voraussetzungen und die Sequenz von Selbstvermittlung zu äußerlicher Quantität gemeinsam erhalten werden.","refs":["CH_GB18_CDBD:MRT2","CH_GB18_A_11:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121300497614Z_65eef338","language_code":"en","language_name":"English","title":"Chapters 52–54","source_sha256":"cca56a338371d208ee80a2bed0d595f133c9263893247c3f1a3768d993938e54","sha256":"5bf191842cd0826dc953a5978b51d56831cc4d2ad658c7ca3d2f6b35e576a3f7","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:13:00.498608+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_18:AS-01","text":"The cluster resolves the problem of how unity, multiplicity, force, matter, and magnitude can be thought without presupposed independent bearers.","refs":["CH_GB18_CDBD:AS1","CH_GB18_A_10:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AS-02","text":"Its core thesis is that repulsion and attraction are not external causes, but the reciprocal self-mediation of a unity that sustains itself only in its self-division.","refs":["CH_GB18_CDBD:AS6","CH_GB18_A_10:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AS-03","text":"The movement is recursive: exclusion becomes negative relation, negative relation becomes attraction, attraction reproduces repulsion, and their sublated difference appears as quantity.","refs":["CH_GB18_CDBD:AS3","CH_GB18_CDBD:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AS-04","text":"The critique of empirical force theory functions as a methodological filter: every explanation that already presupposes constituted matter, space, or movement cannot explain their production.","refs":["CH_GB18_A_10:SD2","CH_GB18_A_10:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AS-05","text":"The closure remains provisional and mobile because quantity cannot retain its external determinacy, but presses through quantum and ratio toward the return of qualitative determinacy and toward measure.","refs":["CH_GB18_A_11:A8","CH_GB18_A_11:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_18:GA-01","text":"[Persistent] Relata do not exist prior to their relation; unity and multiplicity receive their determinacy exclusively through reciprocal positing.","refs":["CH_GB18_CDBD:A1","CH_GB18_CDBD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-02","text":"[Persistent] Negative determination is not relationless annihilation, but preserves the excluded as a necessary moment of its own efficacy.","refs":["CH_GB18_CDBD:AS3","CH_GB18_CDBD:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-03","text":"[Mutating] Repulsion and attraction mutate from apparently material forces into logical moments of transition, whose respective identity consists only in passing over into their opposite.","refs":["CH_GB18_A_10:A2","CH_GB18_A_10:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-04","text":"[Persistent] An explanation is invalid if it already presupposes the object to be produced as spatial, material, or in motion, and subsequently presents its presupposed properties as grounds.","refs":["CH_GB18_A_10:A4","CH_GB18_A_10:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-05","text":"[Emergent] Quantity does not arise alongside quality, but as its mediated externalization, in which qualitative limit is preserved, yet has become external and indifferent to being.","refs":["CH_GB18_CDBD:AS7","CH_GB18_A_11:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-06","text":"[Mutating] The repulsion of the many is not sublated by disappearing, but by its exclusion passing over into non-exclusive continuity.","refs":["CH_GB18_A_11:A4","CH_GB18_A_11:NX9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-07","text":"[Persistent] The quantitative limit is external and mutable, yet precisely its indifference drives it beyond itself and prevents its fixation as final determinacy.","refs":["CH_GB18_A_11:A5","CH_GB18_A_11:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-08","text":"[Attractor] Self-relation becomes possible at the quantitative level only in otherness: a quantum receives its determinacy in another and thereby presses toward ratio.","refs":["CH_GB18_A_11:A11","CH_GB18_A_11:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-09","text":"[Terminal] Infinite progress is not a conclusive totality, but the self-sublation of indifferent quantity and the return of qualitative determinacy.","refs":["CH_GB18_A_11:A10","CH_GB18_A_11:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GA-10","text":"[Attractor] Conceptual construction requires that the conditions of an object be produced from its immanent movement and not relabeled as empirical presuppositions.","refs":["CH_GB18_A_10:A4","CH_GB18_A_10:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_18:RMD-01","text":"The One does not recur as a stable substance, but mutates into the process-form of its self-division into many and its return from them.","refs":["CH_GB18_CDBD:AS6","CH_GB18_CDBD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RMD-02","text":"Repulsion shifts from reciprocal exclusion to continuity; its original separating function becomes the condition of non-exclusive multiplicity.","refs":["CH_GB18_CDBD:A2","CH_GB18_A_11:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RMD-03","text":"Attraction and repulsion lose their physical role-identity and are absorbed as rules of reciprocal assumption of function and self-negation.","refs":["CH_GB18_A_10:AS1","CH_GB18_A_10:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RMD-04","text":"The limit mutates from essential qualitative determinacy into external quantitative determinability, without its qualitative origin disappearing completely.","refs":["CH_GB18_CDBD:A12","CH_GB18_A_11:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RMD-05","text":"Infinity is transferred from the conception of endless dispersal into the function of self-negation, through which quantity again refers to quality.","refs":["CH_GB18_CDBD:SNX2","CH_GB18_A_11:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RMD-06","text":"Matter disappears after its critical function as ontological bearer and remains preserved only as a touchstone for whether explanation practices construction or analytical retroprojection.","refs":["CH_GB18_A_10:AS2","CH_GB18_A_10:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_18:CGD-01","text":"The examination of individual force determinations remains local; at the cluster level, it becomes the general criterion that explanation may not import its object as a finished presupposition.","refs":["CH_GB18_A_10:ALT1","CH_GB18_A_10:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:CGD-02","text":"Surface force, penetrating force, contact, and continuity are locally problematic figures; globally, they show that every fixed distribution of functions already presupposes the conditions of its application.","refs":["CH_GB18_A_10:A7","CH_GB18_A_10:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:CGD-03","text":"Centripetal and centrifugal force remain local examples; their scaled function consists in disclosing the circularity of every explanation that reverts phenomena to variable forces.","refs":["CH_GB18_A_10:A10","CH_GB18_A_10:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:CGD-04","text":"The distinction between individual quantitative and qualitative changes remains local; at the cluster level, it supports the thesis that external variation can never definitively replace an internal limit.","refs":["CH_GB18_A_11:D9","CH_GB18_A_11:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:CGD-05","text":"Force, matter, space, and magnitude are not preserved as independent domains of objects, but recoded as regional configurations of a general logic of immanent self-mediation.","refs":["CH_GB18_CDBD:ME3","CH_GB18_A_11:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_18:GNX-01","text":"Excluded is a model of two original, independent forces that merely encounter one another in a neutral material third.","refs":["CH_GB18_CDBD:NX4","CH_GB18_A_10:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GNX-02","text":"Excluded is every construction that presupposes finished matter, continuity, space, or movement in order subsequently to derive these from forces.","refs":["CH_GB18_A_10:AS4","CH_GB18_A_10:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GNX-03","text":"Excluded is a negation that completely loses what it negates, as well as a limit that could institute absolute separation without mediated unity.","refs":["CH_GB18_CDBD:DNX2","CH_GB18_CDBD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:GNX-04","text":"Excluded is a quantitative infinity that could be understood as a finished completion or as neutral self-determination of magnitude.","refs":["CH_GB18_A_11:NX5","CH_GB18_A_11:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_18:DBN-01","text":"The system cannot admit an ontology in which relata precede relation; otherwise exclusion, attraction, and self-mediation would lose their constitutive function.","refs":["CH_GB18_CDBD:DNX1","CH_GB18_A_10:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:DBN-02","text":"It cannot admit an object that would be both the result of its forces and their already finished bearer; this double status destroys the distinction between genesis and analysis.","refs":["CH_GB18_A_10:DNX1","CH_GB18_A_10:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:DBN-03","text":"It cannot admit a completely internal or absolutely external limit, because limit is sustainable only as mediated determinacy between self-relation and otherness.","refs":["CH_GB18_CDBD:SNX3","CH_GB18_A_11:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:DBN-04","text":"It cannot admit a definition of magnitude that explains its operations of alteration in conceptually presuppositionless terms, because quantitative form itself contains external addition and subtraction.","refs":["CH_GB18_A_11:NX8","CH_GB18_A_11:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_18:BSA-01","text":"Unavailable is an absolutely first One or an original matter that could subsist prior to the movement of its self-positing.","refs":["CH_GB18_CDBD:SNX1","CH_GB18_A_10:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:BSA-02","text":"Unavailable is a final multiplicity or infinite progression whose dispersal does not return into an altered form of qualitative determinacy.","refs":["CH_GB18_CDBD:SNX2","CH_GB18_A_11:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:BSA-03","text":"Unavailable is an immediately given absolute unity of quality and quantity; unity appears only as the result of a ratio that surpasses its own externality.","refs":["CH_GB18_CDBD:DNX3","CH_GB18_A_11:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_18:XD-01","text":"The critique of external force theory becomes the positive condition of validity of dialectical construction: only a determination that itself produces its presuppositions can count as explanation.","refs":["CL_GB18_18:GA-01","CL_GB18_18:GA-10","CH_GB18_CDBD:A6","CH_GB18_A_10:SD2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_18:XD-02","text":"Quantitative continuity is not an additional state alongside repulsion, but its necessary transformation once exclusion is conceived as negative relation.","refs":["CL_GB18_18:GA-02","CL_GB18_18:GA-06","CH_GB18_CDBD:AS3","CH_GB18_A_11:A4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_18:XD-03","text":"Quantitative ratio makes otherness the form of self-relation and thereby forms the bridge upon which the external determinacy of quantum can pass over into measure.","refs":["CL_GB18_18:GA-07","CL_GB18_18:GA-08","CH_GB18_A_11:A11","CH_GB18_A_11:A12"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_18:XD-04","text":"The anti-mechanics of the cluster produces not a mere rejection of physical explanation, but a categorial genesis in which the inadequacy of fixed forces drives the transition to quantity.","refs":["CL_GB18_18:GA-03","CL_GB18_18:GA-05","CH_GB18_A_10:SD4","CH_GB18_A_11:SD2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_18:XD-05","text":"The externality of quantity is at once its productive force and its deficit: it permits change without immediate dissolution of essence, but can provide no conclusive self-grounding.","refs":["CL_GB18_18:GA-07","CL_GB18_18:GA-09","CH_GB18_A_11:SD4","CH_GB18_A_11:MRT4"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_18:BSD-01","text":"Reality appears as a nexus of production in which identities are not antecedent substances, but stabilized results of self-distinction and return.","refs":["CL_GB18_18:GA-01","CL_GB18_18:GA-05","CH_GB18_CDBD:AS6","CH_GB18_A_11:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_18:BSD-02","text":"Causality is shifted from external effectuation to immanent production of conditions: a process explains only what it produces as the condition of its own execution.","refs":["CL_GB18_18:GA-04","CL_GB18_18:GA-10","CH_GB18_CDBD:ALT3","CH_GB18_A_10:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_18:BSD-03","text":"Temporality appears neither as origin nor as mere succession, but as recursive movement in which external progression restores its qualitative presupposition.","refs":["CL_GB18_18:GA-09","CH_GB18_A_11:A9","CH_GB18_A_11:SNX3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_18:BSD-04","text":"Mathematics loses the status of a neutral foundation and appears as an abstracted form of external operations whose concepts require genetic reconstruction.","refs":["CL_GB18_18:GA-07","CL_GB18_18:GA-10","CH_GB18_A_11:AS6","CH_GB18_A_11:ME6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_18:RLE-01","text":"Exclusion produces relation to the excluded, relation produces ideality, ideality posits unity, and unity again produces the multiplicity that it negates.","refs":["CH_GB18_CDBD:D5","CH_GB18_CDBD:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RLE-02","text":"The mechanical attempt at explanation forms a feedback loop: empirically presupposed matter is decomposed into forces whose definition in turn presupposes that matter.","refs":["CH_GB18_A_10:AS2","CH_GB18_A_10:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RLE-03","text":"Quantity escalates as pure continuity into quantum, surpasses itself in infinite progress, and returns as restored quality in a higher form of mediation.","refs":["CH_GB18_A_11:A8","CH_GB18_A_11:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RLE-04","text":"Self-presupposition is the central attractor: every sustaining determination produces the condition that initially appears as its external presupposedness.","refs":["CH_GB18_CDBD:A6","CH_GB18_CDBD:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:RLE-05","text":"The limit functions as a conceptual attractor because it must at once be external in order to make quantity possible, and must be sublated in order to explain its return to quality.","refs":["CH_GB18_A_11:A5","CH_GB18_A_11:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_18:FGS-B01","text":"Unity/multiplicity → apparently independent determinations → disclosure of their exclusive relationality.","refs":["CH_GB18_CDBD:AS1","CH_GB18_CDBD:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FGS-B02","text":"Repulsion → negative relation to the excluded → immanent attraction → attraction → positing of the One → immanent repulsion.","refs":["CH_GB18_CDBD:AS3","CH_GB18_CDBD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FGS-B03","text":"External force theory → presupposed matter, space, and movement → analytical circularity → exclusion of external causal models.","refs":["CH_GB18_A_10:A3","CH_GB18_A_10:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FGS-B04","text":"Sublated qualitative difference → external indifference of the limit → pure quantity → externally determined quantum.","refs":["CH_GB18_CDBD:AS7","CH_GB18_A_11:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FGS-B05","text":"Quantum → self-surpassing → infinite progress → restoration of quality → ratio → measure.","refs":["CH_GB18_A_11:AS4","CH_GB18_A_11:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_18:AFM-B01","text":"Unity and multiplicity → repulsion and attraction → refutation of external independence → self-mediation.","refs":["CH_GB18_CDBD:AS1","CH_GB18_CDBD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AFM-B02","text":"Exclusion → negative relation → ideality of the excluded → sublation of the fixed One.","refs":["CH_GB18_CDBD:D5","CH_GB18_CDBD:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AFM-B03","text":"Empirically presupposed matter → attribution of forces → return of presuppositions → diagnosis of analytical circularity.","refs":["CH_GB18_A_10:FGS2","CH_GB18_A_10:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AFM-B04","text":"Sublated qualitative limit → quantity → quantum → infinite progress → restoration of quality.","refs":["CH_GB18_A_11:FGS3","CH_GB18_A_11:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:AFM-B05","text":"Quantitative ratio → self-relation in otherness → formal unity of quality and quantity → measure.","refs":["CH_GB18_A_11:FGS6","CH_GB18_A_11:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_18:MME-01","text":"Forces are removed from the map of physical root causes and reclassified as logical figures of the self-distinction of unity and multiplicity.","refs":["CH_GB18_A_10:A1","CH_GB18_A_10:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MME-02","text":"The boundary between construction and analysis is redrawn: not the form of derivation, but the origin of its presuppositions decides its validity.","refs":["CH_GB18_A_10:A4","CH_GB18_A_10:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MME-03","text":"Multiplicity is remapped from numerical dispersal into continuous unity, whereby exclusion and continuity become readable as phases of the same process.","refs":["CH_GB18_CDBD:ME1","CH_GB18_A_11:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MME-04","text":"Magnitude and mathematics are mapped as secondary forms of external determinability, not as the presuppositionless language of the quantitative.","refs":["CH_GB18_A_11:A15","CH_GB18_A_11:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_18:ALT-B01","text":"At the surface level, the cluster examines repulsion, attraction, matter, quantity, quantum, ratio, and measure as interrelated categories.","refs":["CH_GB18_CDBD:ALT1","CH_GB18_A_11:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:ALT-B02","text":"At the structural level, it shows that every determination posits its own presuppositions, while quantitative limit appears as the external form of this self-mediation.","refs":["CH_GB18_CDBD:ALT2","CH_GB18_A_11:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:ALT-B03","text":"At the metastrategic level, it replaces the search for fitting causes with the examination of whether concepts produce their object or merely presuppose it.","refs":["CH_GB18_CDBD:ALT3","CH_GB18_A_11:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:ALT-B04","text":"At the ontological and temporal level, being is determined as becoming, whose stability arises only from the repeated self-sublation and self-restoration of its determinations.","refs":["CH_GB18_CDBD:ALT4","CH_GB18_A_11:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:ALT-B05","text":"At the methodological and performative level, the cluster enacts what it asserts: it deprives external explanations of their independence and reconstructs them as movements of their immanent presuppositions.","refs":["CH_GB18_A_10:SD3","CH_GB18_A_10:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_18:FL-01","text":"The positive production of matter remains underdetermined, although the critique of its analytical structure of presupposition is strongly elaborated.","refs":["CH_GB18_A_10:MRT2","CH_GB18_A_10:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FL-02","text":"Quantity must be thought as both external to being and as a dialectically effective instance that compels from itself the restoration of quality.","refs":["CH_GB18_A_11:MRT4","CH_GB18_A_11:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:FL-03","text":"The transition from quantitative ratio to measure is indicated as necessary, but not fully explicated from the formal unity of ratio.","refs":["CH_GB18_A_11:MRT3","CH_GB18_A_11:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MP-01","text":"At the decisive turning point, repulsion mutates from exclusive multiplicity into continuity, thereby altering the meaning of multiplicity itself.","refs":["CH_GB18_A_11:A4","CH_GB18_A_11:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MP-02","text":"The concept of force mutates from an apparently objective determination of material reality into a symptom of external explanation and finally into a logical moment of self-mediation.","refs":["CH_GB18_A_10:AS1","CH_GB18_A_10:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_18:HSI-01","text":"Reality appears as a machine of immanent self-production in which every separation produces the relation that it attempts to deny.","refs":["CH_GB18_CDBD:AS5","CH_GB18_CDBD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:HSI-02","text":"The something appears not as a closed substrate, but as enduring identity under mutable external limits, whose qualitative transition can alter its determinacy.","refs":["CH_GB18_A_11:SD3","CH_GB18_A_11:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:HSI-03","text":"Time appears as recursive return: progress is not mere continuation, but the self-sublation of a form into the condition of its own qualitative transformation.","refs":["CH_GB18_A_11:A9","CH_GB18_A_11:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:HSI-04","text":"Cognition is possible only where it translates external explanatory instances back into immanent conditions of production and renders the circularity of its presuppositions visible.","refs":["CH_GB18_CDBD:ALT3","CH_GB18_A_10:ALT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_18:MRT-B01","text":"The global axioms suffice to reconstruct the movement from unity and multiplicity through the critique of external force models to the emergence of quantity as mediated externality.","refs":["CH_GB18_CDBD:MRT1","CH_GB18_A_11:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MRT-B02","text":"What remains underdetermined are the complete positive genesis of matter, the symmetry of attraction and repulsion, and the explicit necessity of the transition from ratio to measure.","refs":["CH_GB18_CDBD:MRT3","CH_GB18_A_11:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_18:MRT-B03","text":"The reconstruction remains coherent only if the negative exclusions, the return of presuppositions, and the sequence from self-mediation to external quantity are jointly preserved.","refs":["CH_GB18_CDBD:MRT2","CH_GB18_A_11:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_18@R001","source_variant_id":"canonical:CL_GB18_18:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 52–54","context":"c. Die Beziehung der Repulsion und Attraktion. · Anmerkung. · Anmerkung."},"title_language_code":"en"},{"id":"CL_GB18_19","layer":"CL","title":"Chapters 55–57","order":19,"parents":["CH_GB18_DRQT","CH_GB18_A_12","CH_GB18_A_13"],"revision":"CL_GB18_19@R001","sha256":"4396efbb0d29f6d3f1be605c9d5e7b7fdea18da0c9e828908a23aaa15291a86a","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_19:BAS-01","text":"Das zentrale Problem besteht darin, Einheit und Vielheit der Quantität zu vermitteln, ohne Diskretion und Kontinuität zu selbstständigen Gegenprinzipien zu verfestigen.","refs":["CH_GB18_A_13:AS1","CH_GB18_DRQT:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-02","text":"Das isolierte Eins wird nicht äußerlich verbunden, sondern erzeugt durch die Selbstaufhebung seiner ausschließenden Repulsion Attraktion und Kontinuität.","refs":["CH_GB18_DRQT:AS1","CH_GB18_DRQT:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-03","text":"Kontinuität ist nur wahr, sofern sie die Vielheit als innere Diskretion bewahrt; Diskretion ist nur wahr, sofern die Gleichheit ihrer Einsen bereits Kontinuität enthält.","refs":["CH_GB18_DRQT:D4","CH_GB18_A_13:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-04","text":"Reine Quantität ist unbegrenzt, kann aber Grenze und Quantum hervorbringen, weil die Grenze in ihr als aufgehobene Bestimmung und nicht als ihr erschöpfendes Wesen besteht.","refs":["CH_GB18_A_12:A1","CH_GB18_A_12:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-05","text":"Atomismus und unendliche Teilbarkeit werden nicht als konkurrierende Weltmodelle behandelt, sondern als Verselbstständigungen notwendiger Momente derselben quantitativen Struktur.","refs":["CH_GB18_A_12:D4","CH_GB18_A_13:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-06","text":"Die Antinomie vollzieht die innere Instabilität isolierter Bestimmungen, weil jede Seite aus ihrer eigenen Bestimmtheit in die andere übergeht.","refs":["CH_GB18_A_13:A2","CH_GB18_A_13:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-07","text":"Das Argument wird zur immanenten Begriffskritik: Beweise gelten nur, wenn ihre Voraussetzungen aus der Sache hervorgehen und nicht das zu Beweisende bereits einschmuggeln.","refs":["CH_GB18_A_13:SD3","CH_GB18_A_13:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-08","text":"Die Bewegung verläuft spiralförmig von der Genese der quantitativen Einheit über ihre Ausweitung auf verschiedene Existenzweisen zurück zu ihrer antinomischen Prüfung; sie schließt relativ, weil die Einheit bestätigt, ihr Übergang zum Quantum aber nicht vollständig entwickelt wird.","refs":["CH_GB18_A_13:AS4","CH_GB18_A_13:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_19:GA-01","text":"[Persistent] Quantität ist die einfache, nicht äußerlich zusammengesetzte Einheit von Kontinuität und Diskretion.","refs":["CH_GB18_A_13:A1","CH_GB18_DRQT:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-02","text":"[Mutating] Das Eins verliert seine Funktion als isolierter Grundbestandteil, indem seine Selbstbeziehung durch Repulsion in Attraktion, Idealität und kontinuierliches Außersichsein übergeht.","refs":["CH_GB18_DRQT:A14","CH_GB18_A_12:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-03","text":"[Persistent] Kontinuität ist keine unmittelbare Homogenität, sondern die immanent erzeugte Einheit der fürsichseienden Einsen.","refs":["CH_GB18_DRQT:A6","CH_GB18_A_12:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-04","text":"[Mutating] Diskretion besteht zunächst als inneres Moment der Kontinuität und erscheint auf entwickelter Ebene als Möglichkeit der Teilung, niemals als aktuale Menge selbstständiger Teile.","refs":["CH_GB18_DRQT:A10","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-05","text":"[Attractor] Jede isolierte quantitative Bestimmung enthält ihr Gegenteil und geht durch ihre eigene Einseitigkeit in dieses über.","refs":["CH_GB18_A_13:D2","CH_GB18_A_13:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-06","text":"[Persistent] Grenze und Quantum können gesetzt werden, ohne das unbegrenzte Wesen der reinen Quantität aufzuheben oder zu erschöpfen.","refs":["CH_GB18_A_12:A1","CH_GB18_A_12:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-07","text":"[Emergent] Eins, Grenze und Teile besitzen quantitative Realität nur als Möglichkeiten oder aufgehobene Momente, nicht als ontologisch letzte Bestandteile.","refs":["CH_GB18_A_13:NX7","CH_GB18_A_12:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-08","text":"[Attractor] Widerspruch ist eine objektive Folge notwendiger Begriffsbestimmungen und kein bloß subjektiver Schein des endlichen Erkennens.","refs":["CH_GB18_A_13:A2","CH_GB18_A_13:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-09","text":"[Emergent] Begriffliche Beweisgültigkeit verlangt, dass Voraussetzungen immanent erzeugt werden, statt als verdeckte Ergebnisse in die Beweisführung einzugehen.","refs":["CH_GB18_A_13:SD3","CH_GB18_A_13:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-10","text":"[Terminal] Die Wahrheit entgegengesetzter Bestimmungen liegt weder in ihrer Trennung noch in der Entscheidung für eine Seite, sondern ausschließlich in ihrer Aufhebung zur Einheit des Begriffs.","refs":["CH_GB18_A_13:AS2","CH_GB18_A_13:A3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_19:RMD-01","text":"Das Eins mutiert vom repulsiven Fürsichsein über die kontinuierliche Möglichkeit des Eins zum abstrakten Atom, dessen notwendige Funktion erhalten, dessen Selbstständigkeit aber aufgehoben wird.","refs":["CH_GB18_DRQT:A1","CH_GB18_A_12:A6","CH_GB18_A_13:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RMD-02","text":"Repulsion kehrt ihre anfängliche Valenz um: Aus dem Prinzip der Ausschließung wird das erzeugende Fortfließen, das Zusammenhang gerade durch Außersichkommen hervorbringt.","refs":["CH_GB18_DRQT:A2","CH_GB18_DRQT:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RMD-03","text":"Kontinuität wandert vom Resultat der Attraktion in eine allgemeine Struktur von Raum und Zeit und wird schließlich als isolierte Seite der Teilbarkeitsantinomie erneut problematisch.","refs":["CH_GB18_DRQT:AS3","CH_GB18_A_12:A13","CH_GB18_A_13:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RMD-04","text":"Diskretion verändert ihre Funktion vom enthaltenen Moment über die atomistische Verselbstständigung bis zur notwendigen, aber unwahren Einseitigkeit des absoluten Geteiltseins.","refs":["CH_GB18_DRQT:A9","CH_GB18_A_12:D4","CH_GB18_A_13:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RMD-05","text":"Vielheit erscheint zunächst als unterschiedsloses Außereinander, wird dann durch die Gleichheit der Vielen zur einfachen Einheit und schließlich von der aktualen Vielheit zur bloßen Möglichkeit unendlicher Teilung umcodiert.","refs":["CH_GB18_DRQT:A7","CH_GB18_A_12:A16","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RMD-06","text":"Der Widerspruch tritt erst in der Antinomie ausdrücklich hervor, formalisiert aber rückwirkend bereits die Bewegung, durch die Repulsion, Diskretion und Kontinuität ihre isolierte Geltung verlieren.","refs":["CH_GB18_A_13:A5","CH_GB18_A_13:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_19:CGD-01","text":"Die konkrete Ableitung der Kontinuität aus dem Fürsichsein bleibt eine lokale Genese; auf Clusterebene skaliert daraus nur die Regel, dass jede isolierte Bestimmung durch ihre eigene Operation in ihr Anderes übergeht.","refs":["CH_GB18_DRQT:D6","CH_GB18_A_13:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:CGD-02","text":"Raum, Zeit, Materie, Ich sowie die herangezogenen philosophischen Autoritäten bleiben lokale Realisierungen und Prüfmedien; sie sind nicht selbst die globale Grundlage der quantitativen Einheit.","refs":["CH_GB18_A_12:SD4","CH_GB18_A_12:A12","CH_GB18_A_13:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:CGD-03","text":"Die einzelnen Fehleranalysen der kantischen Thesis und Antithesis bleiben fallbezogen, während der Maßstab der Clusterebene das allgemeine Kriterium immanent erzeugter Prämissen übernimmt.","refs":["CH_GB18_A_13:A7","CH_GB18_A_13:A8","CH_GB18_A_13:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:CGD-04","text":"Zur aktuellen Ebene skaliert die Einheit von Kontinuität und Diskretion als Modell jedes Begriffs, dessen entgegengesetzte Momente weder getrennt noch äußerlich vermittelt werden können.","refs":["CH_GB18_A_13:A6","CH_GB18_A_13:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:CGD-05","text":"Der Übergang von reiner Quantität zu Grenze und Quantum bleibt eine unterbestimmte Brücke; er verbindet die Einheiten, erreicht aber keine abgeschlossene Entwicklung des Quantums.","refs":["CH_GB18_A_12:MRT2","CH_GB18_A_13:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_19:GNX-01","text":"Ausgeschlossen sind sowohl das absolute Atom als auch eine reine Kontinuität, in der Diskretion vollständig verschwunden wäre.","refs":["CH_GB18_A_13:NX4","CH_GB18_DRQT:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GNX-02","text":"Ein Kontinuum kann nicht durch die äußere Addition unendlich vieler diskreter Bestandteile konstituiert werden.","refs":["CH_GB18_A_12:NX6","CH_GB18_A_12:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GNX-03","text":"Reine Quantität darf weder mit einem ursprünglich begrenzten Quantum identifiziert noch durch eine endgültige Grenze fixiert werden.","refs":["CH_GB18_A_12:NX1","CH_GB18_A_12:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GNX-04","text":"Unendliche Teilbarkeit darf nicht in das aktuale Dasein einer unendlichen Teilemenge übersetzt werden.","refs":["CH_GB18_A_13:NX7","CH_GB18_A_13:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GNX-05","text":"Weder die subjektive Verlegung des Widerspruchs noch die Wahl eines empirischen oder kosmologischen Substrats kann die Antinomie begrifflich auflösen.","refs":["CH_GB18_A_13:NX5","CH_GB18_A_13:DNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_19:DBN-01","text":"Damit das System Bestand hat, darf keine feste Bestimmung ihre Wahrheit unabhängig von ihrer Mutation und ihrem Übergehen in das Gegenteil behaupten.","refs":["CH_GB18_A_13:SNX3","CH_GB18_A_12:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:DBN-02","text":"Unzulässig ist jedes Modell, das fertige Einheiten voraussetzt und ihre Kontinuität erst durch eine nachträgliche Außenvermittlung herstellen lässt.","refs":["CH_GB18_A_12:SNX1","CH_GB18_A_12:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:DBN-03","text":"Formale Beweisgestalt darf keine Geltung besitzen, wenn der entscheidende Schluss bereits als unbewiesene Voraussetzung in ihr operiert.","refs":["CH_GB18_A_13:D8","CH_GB18_A_13:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:DBN-04","text":"Weder endliche Kategorien noch vorstellende Zusammensetzung dürfen die Reichweite des Denkens und die ontologische Struktur der Quantität erschöpfen.","refs":["CH_GB18_A_13:DNX5","CH_GB18_A_12:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_19:BSA-01","text":"Die tiefste Abwesenheit ist ein äußerer Standort, an dem ein vorrelationales Eins oder ein unabhängiges Subjekt die Vermittlung von Kontinuität und Diskretion überblicken könnte.","refs":["CH_GB18_DRQT:SNX5","CH_GB18_A_13:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BSA-02","text":"Ontologisch unstatthaft sind die beiden symmetrischen Grenzfälle einer absolut reinen Trennung und einer absolut differenzlosen Kontinuität.","refs":["CH_GB18_DRQT:SNX1","CH_GB18_DRQT:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BSA-03","text":"Nicht verfügbar ist eine widerspruchsfreie letzte Identität; die Abwesenheit einer solchen Endbestimmung zwingt jede Gestalt zur rekursiven Aufnahme ihres Anderen.","refs":["CH_GB18_A_12:SNX5","CH_GB18_A_13:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_19:XD-01","text":"Die Antinomie ist die rekursive Zerlegung des bereits erzeugten Quantitätsbegriffs: Was in der Genese als Einheit hervorgeht, zerfällt bei isolierender Reflexion erneut in seine beiden Momente. ; Trace Type — Composite","refs":["CL_GB18_19:GA-01","CL_GB18_19:GA-02","CL_GB18_19:GA-05","CH_GB18_DRQT:D6","CH_GB18_A_13:AS1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:XD-02","text":"Ein Quantum kann begrenzt und teilbar sein, ohne aus aktual vorhandenen Atomen zu bestehen, weil Grenze und Teile innerhalb der reinen Quantität nur modale beziehungsweise aufgehobene Geltung besitzen. ; Trace Type — Composite","refs":["CL_GB18_19:GA-06","CL_GB18_19:GA-07","CH_GB18_A_12:D1","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:XD-03","text":"Raum, Zeit, Materie und Ich fungieren als Manifestationen der quantitativen Vermittlungsstruktur, während kein einzelnes Substrat deren begrifflichen Grund festlegt. ; Trace Type — Composite","refs":["CL_GB18_19:GA-03","CL_GB18_19:GA-04","CH_GB18_A_12:SD4","CH_GB18_A_13:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:XD-04","text":"Ontologische Atomistik und fehlerhafte Beweisführung reproduzieren dieselbe Struktur: Beide setzen äußerlich voraus, was sie als zusammengesetztes Resultat ausgeben. ; Trace Type — Negative","refs":["CL_GB18_19:GA-09","CH_GB18_A_12:A9","CH_GB18_A_13:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:XD-05","text":"Die Selbstbewegung der Quantität und die Methode ihrer Erkenntnis fallen strukturell zusammen, weil der Gegenstand wie der Beweis nur durch das immanente Übergehen jeder Seite in die andere wahr wird. ; Trace Type — Composite","refs":["CL_GB18_19:GA-05","CL_GB18_19:GA-08","CL_GB18_19:GA-10","CH_GB18_A_13:D2","CH_GB18_A_13:AS2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:XD-06","text":"Die Verallgemeinerung der quantitativen Antinomie auf jeden Begriff ist eine produktive Eskalation der Dialektik, bleibt aber gegenüber ihrer lokalen Ableitung unzureichend ausgewiesen. ; Trace Type — Tension","refs":["CL_GB18_19:GA-08","CL_GB18_19:GA-10","CH_GB18_A_13:A6","CH_GB18_A_13:MRT3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_19:BSD-01","text":"Ontologisch werden Entitäten zu relationalen Phasen einer Bewegung, in der Selbstständigkeit nur durch Verlust der isolierten Selbstständigkeit Bestand hat.","refs":["CL_GB18_19:GA-02","CL_GB18_19:GA-05","CL_GB18_19:GA-10","CH_GB18_DRQT:ME1","CH_GB18_A_13:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:BSD-02","text":"Raum und Zeit bestehen nicht aus elementaren Orten oder Jetztpunkten, sondern erzeugen ihre Einheit kontinuierlich, während Teilung in ihnen als Möglichkeit erhalten bleibt.","refs":["CL_GB18_19:GA-03","CL_GB18_19:GA-04","CL_GB18_19:GA-07","CH_GB18_A_12:D7","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:BSD-03","text":"Das Subjekt wird zu einer kontinuierlichen Selbstbeziehung, die ihre Allgemeinheit nicht trotz, sondern durch absolute Andersheit und Repulsion erhält.","refs":["CL_GB18_19:GA-03","CL_GB18_19:GA-05","CH_GB18_A_12:A15","CH_GB18_A_12:D9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:BSD-04","text":"Erkenntnis ist keine äußere Abbildung fertiger Gegenstände, sondern die Rekonstruktion der Operationen, durch die deren Bestimmungen entstehen, sich verkehren und aufgehoben werden.","refs":["CL_GB18_19:GA-09","CH_GB18_A_13:SD3","CH_GB18_A_12:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:BSD-05","text":"Kausalität wird als immanente Umkehrung lesbar: Trennung erzeugt Zusammenhang, und die innere Nichtigkeit einer Bestimmung erzeugt ihren Übergang statt bloßer Vernichtung.","refs":["CL_GB18_19:GA-05","CL_GB18_19:GA-08","CL_GB18_19:GA-10","CH_GB18_DRQT:SD3","CH_GB18_A_13:D2"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_19:RLE-01","text":"Das Eins stößt ein identisches Anderes ab, die Identität des Abgestoßenen verwandelt Repulsion in Attraktion, und die entstehende Kontinuität reproduziert wiederum Vielheit: Die Ausgangseinheit kehrt auf höherer Stufe zurück.","refs":["CH_GB18_DRQT:A15","CH_GB18_DRQT:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RLE-02","text":"Kontinuität ermöglicht Teilung, Teilung setzt gleiche Einsen, und deren Gleichheit stellt Kontinuität wieder her; der Zyklus verhindert die Selbstständigkeit beider Momente.","refs":["CH_GB18_A_13:A4","CH_GB18_A_12:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RLE-03","text":"Die Eskalation verläuft von der lokalen Isolierung eines Moments über seine Verabsolutierung zum antinomischen Zusammenbruch und von dort zur immanenten Einheit.","refs":["CH_GB18_A_13:D1","CH_GB18_A_13:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RLE-04","text":"Der begriffliche Attraktor ist die Einheit von Kontinuität und Diskretion; jede Abweichung in Richtung reiner Einheit oder reiner Vielheit wird durch die Wiederkehr des verdrängten Moments korrigiert.","refs":["CH_GB18_A_13:A1","CH_GB18_A_12:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RLE-05","text":"Die Gesamtbewegung ist spiralförmig: Die erzeugte Einheit expandiert in verschiedene Existenzweisen und kehrt als Gegenstand der Antinomie zurück, nun zugleich als ontologische Struktur und methodisches Resultat.","refs":["CH_GB18_A_12:AS5","CH_GB18_A_13:AS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_19:FGS-B01","text":"Ausgangsoperation: Selbstbeziehung des Eins plus Ausschließung des Anderen erzeugt die Selbstaufhebung der isolierten Einheit.","refs":["CH_GB18_DRQT:AS1","CH_GB18_DRQT:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B02","text":"Umkehroperation: aufgehobene Repulsion → Attraktion → identische Beziehung der Einsen → Kontinuität.","refs":["CH_GB18_DRQT:AS2","CH_GB18_DRQT:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B03","text":"Verdichtungsoperation: Kontinuität bewahrt Vielheit → Vielheit wird innere Diskretion → Quantität entsteht als Einheit beider Momente.","refs":["CH_GB18_DRQT:D3","CH_GB18_DRQT:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B04","text":"Modaloperation: Grenze, Eins und Teile werden gesetzt, aber als aufgehobene Bestimmungen oder Möglichkeiten innerhalb des Kontinuums gehalten.","refs":["CH_GB18_A_12:A3","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B05","text":"Pathologie der Isolierung: verselbstständigte Diskretion → absolutes Geteiltsein und Atomismus; verselbstständigte Kontinuität → unendliche Teilbarkeit.","refs":["CH_GB18_A_13:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B06","text":"Kritische Operation: äußere Zusammensetzung oder verdeckte Voraussetzung → Schein von Erklärung oder Beweis → Freilegung der nicht erzeugten Vermittlung.","refs":["CH_GB18_A_12:A9","CH_GB18_A_13:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B07","text":"Schließungsoperation: immanente Gegenwart des Anderen in jeder Seite → Aufhebung der Einseitigkeit → Wahrheit als begriffliche Einheit.","refs":["CH_GB18_A_13:A4","CH_GB18_A_13:AS2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_19:AFM-B01","text":"Isoliertes Fürsichsein → ausschließende Repulsion → Identität des Abgestoßenen → Attraktion → Kontinuität → innere Diskretion → Quantität als Einheit.","refs":["CH_GB18_DRQT:AS1","CH_GB18_DRQT:A4","CH_GB18_DRQT:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:AFM-B02","text":"Reine Quantität → Grenze als aufgehobenes Moment → Quantum als mögliche Begrenzung → Ausweitung der selbstproduzierenden Kontinuität auf Raum, Zeit, Materie und Ich.","refs":["CH_GB18_A_12:A1","CH_GB18_A_12:A3","CH_GB18_A_12:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:AFM-B03","text":"Trennung von Kontinuität und Diskretion → Atomismus und unendliche Teilbarkeit → Freilegung verdeckter Voraussetzungen → wechselseitige Immanenz → dialektische Einheit.","refs":["CH_GB18_A_13:AS1","CH_GB18_A_13:D8","CH_GB18_A_13:AS2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_19:MME-01","text":"Der Gegensatz von Einheit und Vielheit sowie derjenige von Kontinuität und Diskretion werden zu Binnenrelationen einer einzigen selbstproduzierenden Struktur umkartiert.","refs":["CH_GB18_DRQT:ME5","CH_GB18_A_12:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MME-02","text":"Atom und Teil wechseln vom Status ontologischer Bestandteile zum Status momentaner oder möglicher Bestimmungen des Kontinuums.","refs":["CH_GB18_A_12:ME4","CH_GB18_A_13:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MME-03","text":"Grenze wird von einer äußeren Schranke zur aufgehobenen Binnenbestimmung, sodass Begrenztheit nicht länger das Wesen des Quantums vollständig bestimmt.","refs":["CH_GB18_A_12:ME1","CH_GB18_A_12:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MME-04","text":"Raum, Zeit, Materie und Ich verlieren ihre begriffliche Isolation und werden zu unterschiedlichen Existenzweisen derselben Struktur, ohne die Antinomie selbst zu begründen.","refs":["CH_GB18_A_12:ME5","CH_GB18_A_13:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MME-05","text":"Antinomie wird von einem begrenzten kosmologischen Problem zur allgemeinen Diagnose isolierter Begriffsbestimmungen erweitert.","refs":["CH_GB18_A_13:ME1","CH_GB18_A_13:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MME-06","text":"Die Karte des Erkennens verschiebt sich von formaler Beweisgestalt und Vorstellung zur Prüfung der begrifflichen Erzeugung von Voraussetzungen und Vermittlungen.","refs":["CH_GB18_A_13:ME4","CH_GB18_A_12:ME7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_19:ALT-B01","text":"Auf dem Surface level erscheinen reine Quantität, Quantum, Grenze, Atom und unendliche Teilbarkeit als ausdrücklich behandelte Gegenstände eines gemeinsamen Widerstreits.","refs":["CH_GB18_A_12:AS1","CH_GB18_A_13:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:ALT-B02","text":"Auf dem Structural level organisiert die immanente Einheit von Kontinuität und Diskretion sämtliche Übergänge, Anwendungen und Antinomien.","refs":["CH_GB18_A_12:ALT2","CH_GB18_A_13:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:ALT-B03","text":"Auf dem Metastrategic level ersetzt das System äußere Zusammensetzung, Seitenwahl und apagogische Beweisführung durch die Rekonstruktion der inneren Entstehung jeder Bestimmung.","refs":["CH_GB18_A_12:ALT3","CH_GB18_A_13:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:ALT-B04","text":"Auf dem Ontological / Temporal level ist Realität kontinuierliches Außersichkommen, in dem räumliche, zeitliche und subjektive Differenzen die einfache Einheit nicht unterbrechen.","refs":["CH_GB18_A_12:ALT4","CH_GB18_A_12:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:ALT-B05","text":"Auf dem Methodological / Performative level vollzieht die Argumentation selbst die behauptete Bewegung, indem sie feste Gegensätze isoliert, ihre Voraussetzungen freilegt und jede Seite in ihr Anderes überführt.","refs":["CH_GB18_A_13:AS3","CH_GB18_A_13:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_19:FL-01","text":"Die Quantität wird anfänglich in der Form der Kontinuität gesetzt, obwohl ihre Wahrheit als gleichrangige Einheit von Kontinuität und Diskretion gelten soll; diese Asymmetrie bleibt produktiv, aber ungelöst.","refs":["CH_GB18_DRQT:A12","CH_GB18_A_13:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FL-02","text":"Der Übergang von reiner Quantität zum begrenzten Quantum wird vorausgesetzt, ohne die genaue Vermittlung zwischen unbegrenztem Wesen und gesetzter Grenze vollständig zu entwickeln.","refs":["CH_GB18_A_12:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FL-03","text":"Die Ableitung von Raum, Zeit, Materie und Ich aus reiner Quantität bleibt schwächer ausgeführt als die gemeinsame Struktur, die sie tragen sollen.","refs":["CH_GB18_A_12:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FL-04","text":"Die Verallgemeinerung der quantitativen Antinomie auf jeden Begriff überschreitet die innerhalb des Clusters tatsächlich geleistete Ableitung.","refs":["CH_GB18_A_13:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FL-05","text":"Die Bestimmung unendlicher Teilbarkeit als bloßer Möglichkeit stabilisiert die Lösung, wird aber nicht vollständig aus der vorhergehenden Kritik hergeleitet.","refs":["CH_GB18_A_13:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FL-06","text":"Das Ich soll absolute Repulsion und einfache Kontinuität zugleich sein; diese Verdichtung wiederholt die globale Struktur, ersetzt jedoch ihre besondere Vermittlung durch eine knappe Analogie.","refs":["CH_GB18_A_12:MRT5","CH_GB18_A_12:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MP-01","text":"Das Eins mutiert vom selbstständigen Ausgangspunkt zum relationalen Moment und schließlich zur bloßen Möglichkeit innerhalb der Quantität.","refs":["CH_GB18_DRQT:ME1","CH_GB18_A_12:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MP-02","text":"Repulsion mutiert vom ausschließenden Trennungsprinzip zur produktiven Operation, die Attraktion und Zusammenhang erzeugt.","refs":["CH_GB18_DRQT:D2","CH_GB18_DRQT:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MP-03","text":"Kontinuität mutiert vom dynamischen Resultat der Repulsion zur allgemeinen ontologischen Struktur und danach zur einseitigen Bestimmung innerhalb der Antinomie.","refs":["CH_GB18_DRQT:SD2","CH_GB18_A_13:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MP-04","text":"Antinomie mutiert vom vermeintlich subjektiven Erkenntnisproblem zur objektiven Form immanenter Begriffsbewegung.","refs":["CH_GB18_A_13:A9","CH_GB18_A_13:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_19:HSI-01","text":"Das Systembild der Realität ist eine selbst­differenzierende Kontinuitätsmaschine, deren Trennungen den Zusammenhang nicht abbrechen, sondern fortlaufend erzeugen.","refs":["CH_GB18_DRQT:SD2","CH_GB18_A_12:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:HSI-02","text":"Das Subjekt ist darin kein abgeschlossenes Zentrum, sondern eine repulsive Bewegung, die durch Anderswerden ihre einfache Allgemeinheit erhält.","refs":["CH_GB18_A_12:A15","CH_GB18_A_12:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:HSI-03","text":"Zeit ist keine Kette aktualer Jetztatome, sondern eine sich selbst hervorbringende Vielheit, in der diskrete Bestimmungen nur als Möglichkeiten auftreten.","refs":["CH_GB18_A_12:A13","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:HSI-04","text":"Als Navigation bleibt nur die immanente Verfolgung des Übergangs einer Bestimmung in ihr Gegenteil; ein äußerer Standort zur Neutralisierung des Widerspruchs ist ausgeschlossen.","refs":["CH_GB18_A_13:D2","CH_GB18_A_13:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_19:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Genese der Quantität, die Verselbstständigung ihrer Momente und deren dialektische Wiedervereinigung auf Clusterebene zu rekonstruieren.","refs":["CH_GB18_A_13:MRT1","CH_GB18_DRQT:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MRT-B02","text":"Die Architektur ist am stärksten im symmetrischen Nachweis, dass Kontinuität und Diskretion ihr jeweiliges Gegenteil bereits enthalten und deshalb keine unabhängige Wahrheit besitzen.","refs":["CH_GB18_A_13:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MRT-B03","text":"Unterbestimmt bleiben der präzise Übergang zum Quantum und die formale Ableitung der verschiedenen räumlichen, zeitlichen, materiellen und subjektiven Existenzweisen.","refs":["CH_GB18_A_12:MRT2","CH_GB18_A_12:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MRT-B04","text":"Die Kohärenz hängt von einer produktiven Zirkularität ab: Die Einheit von Kontinuität und Diskretion ist Ausgangsbestimmung, wird aber erst durch ihre Zerlegung und rekursive Wiederkehr als Resultat gerechtfertigt.","refs":["CH_GB18_A_13:MRT2","CH_GB18_DRQT:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MRT-B05","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung nur, wenn Aufhebung als immanente Erzeugung des Anderen verstanden wird; als bloße Negation, empirische Entscheidung oder subjektive Versöhnung würde die Gesamtmaschine kollabieren.","refs":["CH_GB18_A_13:MRT7","CH_GB18_A_12:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121334711985Z_be984f43","language_code":"en","language_name":"English","title":"Chapters 55–57","source_sha256":"4396efbb0d29f6d3f1be605c9d5e7b7fdea18da0c9e828908a23aaa15291a86a","sha256":"a6160bc173cc13846150d6327defab9b71e2f8f9fc14cdd72db3e905c89b0e00","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:13:34.713684+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_19:BAS-01","text":"The central problem consists in mediating the unity and multiplicity of quantity without hardening discreteness and continuity into autonomous counter-principles.","refs":["CH_GB18_A_13:AS1","CH_GB18_DRQT:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-02","text":"The isolated one is not externally combined, but generates attraction and continuity through the self-sublation of its excluding repulsion.","refs":["CH_GB18_DRQT:AS1","CH_GB18_DRQT:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-03","text":"Continuity is true only insofar as it preserves multiplicity as inner discreteness; discreteness is true only insofar as the equality of its ones already contains continuity.","refs":["CH_GB18_DRQT:D4","CH_GB18_A_13:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-04","text":"Pure quantity is unbounded, but can bring forth limit and quantum, because limit exists within it as a sublated determination and not as its exhaustive essence.","refs":["CH_GB18_A_12:A1","CH_GB18_A_12:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-05","text":"Atomism and infinite divisibility are treated not as competing world-models, but as autonomizations of necessary moments of the same quantitative structure.","refs":["CH_GB18_A_12:D4","CH_GB18_A_13:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-06","text":"The antinomy enacts the inner instability of isolated determinations, because each side passes from its own determinacy into the other.","refs":["CH_GB18_A_13:A2","CH_GB18_A_13:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-07","text":"The argument becomes immanent conceptual critique: proofs are valid only when their presuppositions arise from the matter itself and do not already smuggle in what is to be proved.","refs":["CH_GB18_A_13:SD3","CH_GB18_A_13:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BAS-08","text":"The movement proceeds spirally from the genesis of quantitative unity through its extension to different modes of existence back to its antinomic examination; it closes relatively, because unity is confirmed, but its transition to quantum is not fully developed.","refs":["CH_GB18_A_13:AS4","CH_GB18_A_13:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_19:GA-01","text":"[Persistent] Quantity is the simple, not externally composed unity of continuity and discreteness.","refs":["CH_GB18_A_13:A1","CH_GB18_DRQT:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-02","text":"[Mutating] The one loses its function as an isolated basic constituent insofar as its self-relation passes, through repulsion, into attraction, ideality, and continuous being-outside-itself.","refs":["CH_GB18_DRQT:A14","CH_GB18_A_12:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-03","text":"[Persistent] Continuity is not immediate homogeneity, but the immanently generated unity of the ones that are for themselves.","refs":["CH_GB18_DRQT:A6","CH_GB18_A_12:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-04","text":"[Mutating] Discreteness initially exists as an inner moment of continuity and appears at a developed level as the possibility of division, never as an actual aggregate of autonomous parts.","refs":["CH_GB18_DRQT:A10","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-05","text":"[Attractor] Every isolated quantitative determination contains its opposite and passes into it through its own one-sidedness.","refs":["CH_GB18_A_13:D2","CH_GB18_A_13:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-06","text":"[Persistent] Limit and quantum can be posited without sublating or exhausting the unbounded essence of pure quantity.","refs":["CH_GB18_A_12:A1","CH_GB18_A_12:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-07","text":"[Emergent] One, limit, and parts possess quantitative reality only as possibilities or sublated moments, not as ontologically ultimate constituents.","refs":["CH_GB18_A_13:NX7","CH_GB18_A_12:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-08","text":"[Attractor] Contradiction is an objective consequence of necessary conceptual determinations and not a merely subjective appearance of finite cognition.","refs":["CH_GB18_A_13:A2","CH_GB18_A_13:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-09","text":"[Emergent] Conceptual validity of proof requires that presuppositions be generated immanently, rather than entering the proof as concealed results.","refs":["CH_GB18_A_13:SD3","CH_GB18_A_13:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GA-10","text":"[Terminal] The truth of opposed determinations lies neither in their separation nor in the decision for one side, but exclusively in their sublation into the unity of the concept.","refs":["CH_GB18_A_13:AS2","CH_GB18_A_13:A3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_19:RMD-01","text":"The one mutates from repulsive being-for-self through the continuous possibility of the one into the abstract atom, whose necessary function is preserved but whose autonomy is sublated.","refs":["CH_GB18_DRQT:A1","CH_GB18_A_12:A6","CH_GB18_A_13:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RMD-02","text":"Repulsion reverses its initial valence: from the principle of exclusion arises the generative flowing-forth that produces connection precisely through coming-outside-itself.","refs":["CH_GB18_DRQT:A2","CH_GB18_DRQT:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RMD-03","text":"Continuity migrates from the result of attraction into a general structure of space and time and finally becomes problematic again as an isolated side of the antinomy of divisibility.","refs":["CH_GB18_DRQT:AS3","CH_GB18_A_12:A13","CH_GB18_A_13:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RMD-04","text":"Discreteness changes its function from the contained moment through atomistic autonomization to the necessary but untrue one-sidedness of absolute dividedness.","refs":["CH_GB18_DRQT:A9","CH_GB18_A_12:D4","CH_GB18_A_13:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RMD-05","text":"Multiplicity initially appears as indifferent externality, then becomes simple unity through the equality of the many, and is finally recoded from actual multiplicity into the mere possibility of infinite division.","refs":["CH_GB18_DRQT:A7","CH_GB18_A_12:A16","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RMD-06","text":"Contradiction emerges explicitly only in the antinomy, but retroactively formalizes the movement through which repulsion, discreteness, and continuity lose their isolated validity.","refs":["CH_GB18_A_13:A5","CH_GB18_A_13:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_19:CGD-01","text":"The concrete derivation of continuity from being-for-self remains a local genesis; at the cluster level, only the rule scales from it that every isolated determination passes through its own operation into its other.","refs":["CH_GB18_DRQT:D6","CH_GB18_A_13:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:CGD-02","text":"Space, time, matter, I, and the philosophical authorities invoked remain local realizations and media of examination; they are not themselves the global ground of quantitative unity.","refs":["CH_GB18_A_12:SD4","CH_GB18_A_12:A12","CH_GB18_A_13:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:CGD-03","text":"The individual analyses of errors in the Kantian thesis and antithesis remain case-specific, whereas the standard at the cluster level adopts the general criterion of immanently generated premises.","refs":["CH_GB18_A_13:A7","CH_GB18_A_13:A8","CH_GB18_A_13:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:CGD-04","text":"At the current level, the unity of continuity and discreteness scales as a model of every concept whose opposed moments can be neither separated nor externally mediated.","refs":["CH_GB18_A_13:A6","CH_GB18_A_13:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:CGD-05","text":"The transition from pure quantity to limit and quantum remains an underdetermined bridge; it connects the unities, but does not attain a completed development of quantum.","refs":["CH_GB18_A_12:MRT2","CH_GB18_A_13:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_19:GNX-01","text":"Excluded are both the absolute atom and a pure continuity in which discreteness would have completely disappeared.","refs":["CH_GB18_A_13:NX4","CH_GB18_DRQT:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GNX-02","text":"A continuum cannot be constituted through the external addition of infinitely many discrete constituents.","refs":["CH_GB18_A_12:NX6","CH_GB18_A_12:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GNX-03","text":"Pure quantity may neither be identified with an originally limited quantum nor fixed by a final limit.","refs":["CH_GB18_A_12:NX1","CH_GB18_A_12:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GNX-04","text":"Infinite divisibility must not be translated into the actual existence of an infinite set of parts.","refs":["CH_GB18_A_13:NX7","CH_GB18_A_13:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:GNX-05","text":"Neither the subjective relocation of contradiction nor the choice of an empirical or cosmological substrate can conceptually resolve the antinomy.","refs":["CH_GB18_A_13:NX5","CH_GB18_A_13:DNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_19:DBN-01","text":"For the system to endure, no fixed determination may assert its truth independently of its mutation and its transition into the opposite.","refs":["CH_GB18_A_13:SNX3","CH_GB18_A_12:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:DBN-02","text":"Every model that presupposes ready-made unities and allows their continuity to be established only through subsequent external mediation is inadmissible.","refs":["CH_GB18_A_12:SNX1","CH_GB18_A_12:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:DBN-03","text":"Formal proof-form may possess no validity when the decisive inference already operates within it as an unproved presupposition.","refs":["CH_GB18_A_13:D8","CH_GB18_A_13:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:DBN-04","text":"Neither finite categories nor representational composition may exhaust the scope of thought and the ontological structure of quantity.","refs":["CH_GB18_A_13:DNX5","CH_GB18_A_12:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_19:BSA-01","text":"The deepest absence is an external standpoint at which a pre-relational one or an independent subject could survey the mediation of continuity and discreteness.","refs":["CH_GB18_DRQT:SNX5","CH_GB18_A_13:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BSA-02","text":"Ontologically impermissible are the two symmetrical limiting cases of absolutely pure separation and absolutely difference-less continuity.","refs":["CH_GB18_DRQT:SNX1","CH_GB18_DRQT:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:BSA-03","text":"Unavailable is a contradiction-free final identity; the absence of such a final determination compels every configuration recursively to take up its other.","refs":["CH_GB18_A_12:SNX5","CH_GB18_A_13:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_19:XD-01","text":"The antinomy is the recursive decomposition of the already generated concept of quantity: what emerges as unity in the genesis breaks down again, under isolating reflection, into its two moments. ; Trace Type — Composite","refs":["CL_GB18_19:GA-01","CL_GB18_19:GA-02","CL_GB18_19:GA-05","CH_GB18_DRQT:D6","CH_GB18_A_13:AS1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:XD-02","text":"A quantum can be limited and divisible without consisting of actually existing atoms, because limit and parts possess only modal or sublated validity within pure quantity. ; Trace Type — Composite","refs":["CL_GB18_19:GA-06","CL_GB18_19:GA-07","CH_GB18_A_12:D1","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:XD-03","text":"Space, time, matter, and I function as manifestations of the quantitative structure of mediation, while no individual substrate determines its conceptual ground. ; Trace Type — Composite","refs":["CL_GB18_19:GA-03","CL_GB18_19:GA-04","CH_GB18_A_12:SD4","CH_GB18_A_13:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:XD-04","text":"Ontological atomism and faulty proof-procedure reproduce the same structure: both externally presuppose what they present as a composite result. ; Trace Type — Negative","refs":["CL_GB18_19:GA-09","CH_GB18_A_12:A9","CH_GB18_A_13:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:XD-05","text":"The self-movement of quantity and the method of its cognition structurally coincide, because the object, like the proof, becomes true only through the immanent passing of each side into the other. ; Trace Type — Composite","refs":["CL_GB18_19:GA-05","CL_GB18_19:GA-08","CL_GB18_19:GA-10","CH_GB18_A_13:D2","CH_GB18_A_13:AS2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:XD-06","text":"The generalization of the quantitative antinomy to every concept is a productive escalation of dialectic, but remains insufficiently demonstrated in relation to its local derivation. ; Trace Type — Tension","refs":["CL_GB18_19:GA-08","CL_GB18_19:GA-10","CH_GB18_A_13:A6","CH_GB18_A_13:MRT3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_19:BSD-01","text":"Ontologically, entities become relational phases of a movement in which autonomy endures only through the loss of isolated autonomy.","refs":["CL_GB18_19:GA-02","CL_GB18_19:GA-05","CL_GB18_19:GA-10","CH_GB18_DRQT:ME1","CH_GB18_A_13:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:BSD-02","text":"Space and time do not consist of elementary places or now-points, but continuously generate their unity, while division remains preserved within them as possibility.","refs":["CL_GB18_19:GA-03","CL_GB18_19:GA-04","CL_GB18_19:GA-07","CH_GB18_A_12:D7","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:BSD-03","text":"The subject becomes a continuous self-relation that maintains its universality not despite, but through absolute otherness and repulsion.","refs":["CL_GB18_19:GA-03","CL_GB18_19:GA-05","CH_GB18_A_12:A15","CH_GB18_A_12:D9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:BSD-04","text":"Cognition is not an external representation of ready-made objects, but the reconstruction of the operations through which their determinations arise, invert themselves, and are sublated.","refs":["CL_GB18_19:GA-09","CH_GB18_A_13:SD3","CH_GB18_A_12:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_19:BSD-05","text":"Causality becomes legible as immanent reversal: separation generates connection, and the inner nullity of a determination generates its transition rather than mere annihilation.","refs":["CL_GB18_19:GA-05","CL_GB18_19:GA-08","CL_GB18_19:GA-10","CH_GB18_DRQT:SD3","CH_GB18_A_13:D2"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_19:RLE-01","text":"The one repels an identical other, the identity of what is repelled transforms repulsion into attraction, and the emerging continuity in turn reproduces multiplicity: the initial unity returns at a higher level.","refs":["CH_GB18_DRQT:A15","CH_GB18_DRQT:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RLE-02","text":"Continuity enables division, division presupposes equal ones, and their equality restores continuity; the cycle prevents the autonomy of both moments.","refs":["CH_GB18_A_13:A4","CH_GB18_A_12:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RLE-03","text":"The escalation proceeds from the local isolation of a moment through its absolutization to antinomic collapse, and from there to immanent unity.","refs":["CH_GB18_A_13:D1","CH_GB18_A_13:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RLE-04","text":"The conceptual attractor is the unity of continuity and discreteness; every deviation toward pure unity or pure multiplicity is corrected through the return of the repressed moment.","refs":["CH_GB18_A_13:A1","CH_GB18_A_12:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:RLE-05","text":"The overall movement is spiral-shaped: the generated unity expands into different modes of existence and returns as the object of the antinomy, now simultaneously as ontological structure and methodological result.","refs":["CH_GB18_A_12:AS5","CH_GB18_A_13:AS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_19:FGS-B01","text":"Initial operation: self-relation of the one plus exclusion of the other generates the self-sublation of isolated unity.","refs":["CH_GB18_DRQT:AS1","CH_GB18_DRQT:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B02","text":"Reversal operation: sublated repulsion → attraction → identical relation of the ones → continuity.","refs":["CH_GB18_DRQT:AS2","CH_GB18_DRQT:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B03","text":"Condensation operation: continuity preserves multiplicity → multiplicity becomes inner discreteness → quantity arises as the unity of both moments.","refs":["CH_GB18_DRQT:D3","CH_GB18_DRQT:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B04","text":"Modal operation: limit, one, and parts are posited, but retained as sublated determinations or possibilities within the continuum.","refs":["CH_GB18_A_12:A3","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B05","text":"Pathology of isolation: autonomized discreteness → absolute dividedness and atomism; autonomized continuity → infinite divisibility.","refs":["CH_GB18_A_13:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B06","text":"Critical operation: external composition or concealed presupposition → appearance of explanation or proof → disclosure of mediation not generated.","refs":["CH_GB18_A_12:A9","CH_GB18_A_13:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FGS-B07","text":"Closure operation: immanent presence of the other in each side → sublation of one-sidedness → truth as conceptual unity.","refs":["CH_GB18_A_13:A4","CH_GB18_A_13:AS2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_19:AFM-B01","text":"Isolated being-for-self → excluding repulsion → identity of what is repelled → attraction → continuity → inner discreteness → quantity as unity.","refs":["CH_GB18_DRQT:AS1","CH_GB18_DRQT:A4","CH_GB18_DRQT:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:AFM-B02","text":"Pure quantity → limit as sublated moment → quantum as possible limitation → extension of self-producing continuity to space, time, matter, and I.","refs":["CH_GB18_A_12:A1","CH_GB18_A_12:A3","CH_GB18_A_12:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:AFM-B03","text":"Separation of continuity and discreteness → atomism and infinite divisibility → disclosure of concealed presuppositions → reciprocal immanence → dialectical unity.","refs":["CH_GB18_A_13:AS1","CH_GB18_A_13:D8","CH_GB18_A_13:AS2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_19:MME-01","text":"The opposition of unity and multiplicity, as well as that of continuity and discreteness, are remapped as internal relations of a single self-producing structure.","refs":["CH_GB18_DRQT:ME5","CH_GB18_A_12:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MME-02","text":"Atom and part shift from the status of ontological constituents to the status of momentary or possible determinations of the continuum.","refs":["CH_GB18_A_12:ME4","CH_GB18_A_13:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MME-03","text":"Limit shifts from an external barrier to a sublated internal determination, so that boundedness no longer completely determines the essence of quantum.","refs":["CH_GB18_A_12:ME1","CH_GB18_A_12:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MME-04","text":"Space, time, matter, and I lose their conceptual isolation and become different modes of existence of the same structure, without themselves grounding the antinomy.","refs":["CH_GB18_A_12:ME5","CH_GB18_A_13:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MME-05","text":"Antinomy is extended from a limited cosmological problem to a general diagnosis of isolated conceptual determinations.","refs":["CH_GB18_A_13:ME1","CH_GB18_A_13:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MME-06","text":"The map of cognition shifts from formal proof-form and representation to examination of the conceptual generation of presuppositions and mediations.","refs":["CH_GB18_A_13:ME4","CH_GB18_A_12:ME7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_19:ALT-B01","text":"At the Surface level, pure quantity, quantum, limit, atom, and infinite divisibility appear as explicitly treated objects of a common conflict.","refs":["CH_GB18_A_12:AS1","CH_GB18_A_13:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:ALT-B02","text":"At the Structural level, the immanent unity of continuity and discreteness organizes all transitions, applications, and antinomies.","refs":["CH_GB18_A_12:ALT2","CH_GB18_A_13:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:ALT-B03","text":"At the Metastrategic level, the system replaces external composition, choice of sides, and apagogic proof-procedure with the reconstruction of the inner emergence of every determination.","refs":["CH_GB18_A_12:ALT3","CH_GB18_A_13:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:ALT-B04","text":"At the Ontological / Temporal level, reality is continuous coming-outside-itself, in which spatial, temporal, and subjective differences do not interrupt simple unity.","refs":["CH_GB18_A_12:ALT4","CH_GB18_A_12:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:ALT-B05","text":"At the Methodological / Performative level, the argumentation itself enacts the asserted movement by isolating fixed oppositions, disclosing their presuppositions, and transferring each side into its other.","refs":["CH_GB18_A_13:AS3","CH_GB18_A_13:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_19:FL-01","text":"Quantity is initially posited in the form of continuity, although its truth is supposed to hold as the coequal unity of continuity and discreteness; this asymmetry remains productive but unresolved.","refs":["CH_GB18_DRQT:A12","CH_GB18_A_13:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FL-02","text":"The transition from pure quantity to limited quantum is presupposed without fully developing the precise mediation between unbounded essence and posited limit.","refs":["CH_GB18_A_12:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FL-03","text":"The derivation of space, time, matter, and I from pure quantity remains less fully developed than the common structure that they are supposed to bear.","refs":["CH_GB18_A_12:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FL-04","text":"The generalization of the quantitative antinomy to every concept exceeds the derivation actually accomplished within the cluster.","refs":["CH_GB18_A_13:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FL-05","text":"The determination of infinite divisibility as mere possibility stabilizes the solution, but is not fully derived from the preceding critique.","refs":["CH_GB18_A_13:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:FL-06","text":"The I is supposed to be absolute repulsion and simple continuity at once; this condensation repeats the global structure, but replaces its particular mediation with a brief analogy.","refs":["CH_GB18_A_12:MRT5","CH_GB18_A_12:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MP-01","text":"The one mutates from the autonomous point of departure into a relational moment and finally into a mere possibility within quantity.","refs":["CH_GB18_DRQT:ME1","CH_GB18_A_12:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MP-02","text":"Repulsion mutates from an excluding principle of separation into a productive operation that generates attraction and connection.","refs":["CH_GB18_DRQT:D2","CH_GB18_DRQT:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MP-03","text":"Continuity mutates from the dynamic result of repulsion into the general ontological structure and thereafter into a one-sided determination within the antinomy.","refs":["CH_GB18_DRQT:SD2","CH_GB18_A_13:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MP-04","text":"Antinomy mutates from a supposedly subjective problem of cognition into an objective form of immanent conceptual movement.","refs":["CH_GB18_A_13:A9","CH_GB18_A_13:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_19:HSI-01","text":"The system-image of reality is a self-differentiating continuity-machine whose separations do not break off connection, but continuously generate it.","refs":["CH_GB18_DRQT:SD2","CH_GB18_A_12:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:HSI-02","text":"Within it, the subject is not a self-contained center, but a repulsive movement that maintains its simple universality through becoming-other.","refs":["CH_GB18_A_12:A15","CH_GB18_A_12:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:HSI-03","text":"Time is not a chain of actual now-atoms, but a self-producing multiplicity in which discrete determinations appear only as possibilities.","refs":["CH_GB18_A_12:A13","CH_GB18_A_13:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:HSI-04","text":"As navigation, only the immanent tracking of a determination's transition into its opposite remains; an external standpoint for neutralizing contradiction is excluded.","refs":["CH_GB18_A_13:D2","CH_GB18_A_13:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_19:MRT-B01","text":"The extracted axioms suffice to reconstruct, at the cluster level, the genesis of quantity, the autonomization of its moments, and their dialectical reunification.","refs":["CH_GB18_A_13:MRT1","CH_GB18_DRQT:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MRT-B02","text":"The architecture is strongest in the symmetrical demonstration that continuity and discreteness already contain their respective opposite and therefore possess no independent truth.","refs":["CH_GB18_A_13:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MRT-B03","text":"Underdetermined remain the precise transition to quantum and the formal derivation of the various spatial, temporal, material, and subjective modes of existence.","refs":["CH_GB18_A_12:MRT2","CH_GB18_A_12:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MRT-B04","text":"The coherence depends on a productive circularity: the unity of continuity and discreteness is the initial determination, but is justified as a result only through its decomposition and recursive return.","refs":["CH_GB18_A_13:MRT2","CH_GB18_DRQT:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_19:MRT-B05","text":"The reconstruction preserves the actual movement only if sublation is understood as the immanent generation of the other; as mere negation, empirical decision, or subjective reconciliation, the entire machine would collapse.","refs":["CH_GB18_A_13:MRT7","CH_GB18_A_12:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_19@R001","source_variant_id":"canonical:CL_GB18_19:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 55–57","context":"A. Die reine Quantität. · Anmerkung 1. · Anmerkung 2."},"title_language_code":"en"},{"id":"CL_GB18_20","layer":"CL","title":"Chapters 58–60","order":20,"parents":["CH_GB18_BKUD","CH_GB18_CBDQ","CH_GB18_DIEZ"],"revision":"CL_GB18_20@R001","sha256":"0cc082736cc0b3a1905a9dde1bbe94836f32687bd2d77f1a33deb92d29258e70","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_20:AS-B01","text":"Quantität wird als Einheit von Kontinuität und Diskretion rekonstruiert, deren Gegensatz keine äußere Einteilung, sondern eine Selbstunterscheidung derselben Struktur bildet.","refs":["CH_GB18_BKUD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B02","text":"Die zunächst unmittelbare Kontinuität wird durch die immanente Setzung des Eins in Diskretion überführt, ohne ihre eigene Einheit zu verlieren.","refs":["CH_GB18_BKUD:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B03","text":"Das Eins mutiert vom Moment der Unterscheidung zum Prinzip der Vielheit, der Grenze und der Einheit eines bestimmten Daseins.","refs":["CH_GB18_CBDQ:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B04","text":"Grenze erscheint nicht als äußerer Abschluss, sondern als Selbstbeziehung der Quantität, die Vielheit zusammenfasst und zugleich deren Überschreitung ermöglicht.","refs":["CH_GB18_CBDQ:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B05","text":"Mit der Grenze wird Quantität zum Quantum; die vorherige Differenz von kontinuierlicher und diskreter Größe verliert ihre selbständige Geltung.","refs":["CH_GB18_CBDQ:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B06","text":"Die Zahl vollendet diese Bewegung als Quantum, dessen Einheit und Anzahl nicht getrennte Bestandteile, sondern die gemeinsame Gestalt seiner Grenze sind.","refs":["CH_GB18_DIEZ:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B07","text":"Die Zahl erzeugt aus ihrer Selbstbegrenzung eine innere Äußerlichkeit gegenüber anderen Zahlen und verwandelt damit quantitative Bestimmtheit in einen produktiven Widerspruch.","refs":["CH_GB18_DIEZ:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B08","text":"Die Gesamtbewegung ist rekursiv und eskalativ: Einheit erzeugt Differenz, Differenz Grenze, Grenze bestimmte Einheit, und bestimmte Einheit setzt die Äußerlichkeit frei, die weitere quantitative Entwicklung erzwingt.","refs":["CH_GB18_DIEZ:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_20:GA-01","text":"[Persistent] Quantität existiert nur als konkrete Einheit von Kontinuität und Diskretion; keine ihrer Formen kann ohne das jeweils andere Moment bestehen.","refs":["CH_GB18_BKUD:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-02","text":"[Mutating] Das Eins ist zunächst immanentes Prinzip der Diskretion, wird dann ausschließende Grenze und schließlich die Einheit, in der Anzahl und bestimmtes Quantum zusammenfallen.","refs":["CH_GB18_BKUD:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-03","text":"[Persistent] Diskretion ist keine atomistische Vielheit, weil die vielen Eins durch Gleichheit und gemeinsame Einheit kontinuierlich vermittelt bleiben.","refs":["CH_GB18_BKUD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-04","text":"[Emergent] Grenze ist die Selbstbeziehung der quantitativen Einheit: Sie bestimmt das Dasein als Ausschluss, ohne als fremdes Äußeres neben ihm zu stehen.","refs":["CH_GB18_CBDQ:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-05","text":"[Attractor] Quantitative Bestimmtheit entsteht nur durch die Kopplung von begrenzender Ausschließung und übergreifender Kontinuität.","refs":["CH_GB18_CBDQ:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-06","text":"[Terminal] Kontinuierliche und diskrete Größe werden als selbständige Formen aufgehoben, sobald beide als Quanta unter derselben immanenten Grenze bestimmt sind.","refs":["CH_GB18_CBDQ:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-07","text":"[Emergent] Die Zahl ist die vollständig bestimmte Form des Quantums, weil Einheit und Anzahl gemeinsam ihre Grenze erzeugen.","refs":["CH_GB18_DIEZ:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-08","text":"[Mutating] Die Vielzahl gleicher Eins ist nicht das Material einer von außen gesetzten Grenze, sondern die konkrete Bildung dieser Grenze selbst.","refs":["CH_GB18_DIEZ:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-09","text":"[Attractor] Quantität enthält eine unvermeidliche Äußerlichkeit: Sie ist gegen ihre Grenze und gegen andere Quanta gleichgültig, trägt diese Gleichgültigkeit jedoch als eigenes Moment in sich.","refs":["CH_GB18_DIEZ:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-10","text":"[Terminal] Der Widerspruch von immanenter Selbstbestimmung und äußerlicher Vergleichbarkeit ist keine Störung, sondern die Qualität, durch die Quantität ihre weitere Entwicklung eröffnet.","refs":["CH_GB18_DIEZ:AS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_20:RMD-01","text":"Kontinuität bleibt als identisches Moment der Quantität erhalten, verschiebt sich jedoch von unmittelbarer Fortsetzung über die Einheit gleicher Eins zur Überschreitung der Grenze.","refs":["CH_GB18_CBDQ:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RMD-02","text":"Diskretion mutiert von der Form eines unterbrochenen Außereinander zu einer durch die Grenze bestimmten Vielheit, deren Eins in einer Einheit aufgehoben sind.","refs":["CH_GB18_CBDQ:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RMD-03","text":"Das Eins wiederholt sich funktional als Prinzip der Diskretion, als ausschließende Grenze, als umschließende Selbstbeziehung und als Einheit der Zahl.","refs":["CH_GB18_DIEZ:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RMD-04","text":"Grenze kehrt nicht als festes Motiv wieder, sondern eskaliert vom ausgeschlossenen äußeren Rand zur immanenten Struktur des Quantums und zur durch die Anzahl gebildeten Bestimmtheit.","refs":["CH_GB18_DIEZ:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RMD-05","text":"Die Differenz von Kontinuität und Diskretion wird nicht beseitigt, sondern in der Zahl absorbiert, wo sie als Einheit und Anzahl eine neue operative Gestalt annimmt.","refs":["CH_GB18_DIEZ:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RMD-06","text":"Die äußere Beziehung zu anderem verschiebt sich von einem ausgeschlossenen Erklärungsmodell zu einem inneren Moment numerischer Identität.","refs":["CH_GB18_DIEZ:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_20:CGD-01","text":"Die Beschreibung von Raum, Zeit und Materie als kontinuierlichen Größen bleibt lokal, weil sie keine zusätzliche generative Bestimmung der hier entwickelten Quantitätsmaschine erzeugt.","refs":["CH_GB18_BKUD:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:CGD-02","text":"Die lokale Unterscheidung zwischen extensivem und intensivem Quantum bleibt untergeordnet, weil auf Clusterebene allein ihre gemeinsame Abhängigkeit von immanenter Begrenzung tragend ist.","refs":["CH_GB18_DIEZ:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:CGD-03","text":"Die Identifikation von Eins, Negation und Grenze ist auf Kapitelstufe ein Übergangsproblem, wird auf Clusterebene jedoch zur notwendigen Vermittlungsachse zwischen Quantität, Quantum und Zahl.","refs":["CH_GB18_CBDQ:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:CGD-04","text":"Die Gleichheit der Eins ist nicht bloß eine Eigenschaft diskreter Größe, sondern die Bedingung dafür, dass Vielheit überhaupt als bestimmte Einheit und Zahl auftreten kann.","refs":["CH_GB18_DIEZ:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:CGD-05","text":"Die Gleichgültigkeit von kontinuierlicher und diskreter Größe ist keine lokale Schlussfolgerung über Formen, sondern die systemische Voraussetzung ihrer gemeinsamen Überführung in das Quantum.","refs":["CH_GB18_CBDQ:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_20:GNX-01","text":"Ausgeschlossen ist jede Reduktion der Quantität auf reine Kontinuität oder reine Diskretion, weil jede solche Reinheit das vermittelnde Gegenmoment unterschlägt.","refs":["CH_GB18_BKUD:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GNX-02","text":"Ausgeschlossen ist ein Atomismus unabhängiger Eins, weil diskrete Vielheit nur als Einheit aufgehobener und gleicher Eins bestimmt wird.","refs":["CH_GB18_BKUD:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GNX-03","text":"Ausgeschlossen ist eine Grenze, die dem begrenzten Sein von außen auferlegt wird, weil Grenze die Selbstbestimmung dieses Seins ist.","refs":["CH_GB18_CBDQ:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GNX-04","text":"Ausgeschlossen ist eine Vielheit, deren Grenze durch ein ausgezeichnetes letztes Eins getragen würde, weil jedes Eins dieselbe Stellung innerhalb der Anzahl besitzt.","refs":["CH_GB18_DIEZ:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GNX-05","text":"Ausgeschlossen ist die qualitative Umdeutung numerischer Differenz, weil Zahlen sich nur quantitativ und äußerlich unterscheiden.","refs":["CH_GB18_DIEZ:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GNX-06","text":"Ausgeschlossen ist ein abgeschlossenes Quantum ohne innere Äußerlichkeit, weil seine Bestimmtheit zugleich die Beziehung auf anderes freisetzt.","refs":["CH_GB18_DIEZ:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_20:DBN-01","text":"Das System kann keine ontologisch selbständigen Prinzipien von Einheit, Vielheit, Kontinuität oder Diskretion zulassen, ohne die Selbstvermittlung der Quantität zu zerstören.","refs":["CH_GB18_BKUD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:DBN-02","text":"Es kann keinen äußeren Grund der Grenze zulassen, weil eine fremde Begrenzung die immanente Entstehung des Quantums aus Eins und Vielheit abbrechen würde.","refs":["CH_GB18_BKUD:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:DBN-03","text":"Es kann keine qualitative Singularität eines einzelnen Eins zulassen, weil die Zahl nur entsteht, wenn ihre Grenze die ganze Anzahl durchdringt.","refs":["CH_GB18_DIEZ:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:DBN-04","text":"Es kann keine endgültige Trennung von innerer Bestimmtheit und äußerlicher Beziehung zulassen, weil der Widerspruch beider die Entwicklungsfähigkeit des Quantums begründet.","refs":["CH_GB18_DIEZ:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_20:BSA-01","text":"Unverfügbar ist eine reine Selbstidentität der Quantität, die weder Differenz noch Äußerlichkeit hervorbrächte.","refs":["CH_GB18_DIEZ:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSA-02","text":"Unmöglich ist eine Zahl, deren Grenze außerhalb ihrer Anzahl liegt, weil dies die Selbstkonstitution der quantitativen Bestimmtheit rückgängig machen würde.","refs":["CH_GB18_DIEZ:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSA-03","text":"Unzulässig ist eine endgültige Ruhe der Grenze, weil die Kontinuität des begrenzten Seins jede Grenze zugleich überschreitet.","refs":["CH_GB18_CBDQ:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSA-04","text":"Das System umkreist die Unmöglichkeit einer Quantität ohne Widerspruch: Eine völlig innere oder völlig äußere Bestimmtheit würde die Bewegung zum Quantum und zur Zahl blockieren.","refs":["CH_GB18_CBDQ:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_20:XD-01","text":"Die im ersten Bewegungsabschnitt entwickelte Einheit von Kontinuität und Diskretion erhält erst durch die Grenze die Form eines Daseins; die Grenze ist daher keine Ergänzung der Quantität, sondern ihre Realisierung als Quantum.","refs":["CL_GB18_20:GA-01","CL_GB18_20:GA-04","CL_GB18_20:GA-05","CH_GB18_BKUD:A17","CH_GB18_CBDQ:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_20:XD-02","text":"Die Kontinuität der diskreten Vielheit und die Selbstbeziehung der Grenze bilden zusammen die Bedingung dafür, dass viele Eins nicht bloß koexistieren, sondern eine bestimmte Anzahl konstituieren.","refs":["CL_GB18_20:GA-03","CL_GB18_20:GA-08","CH_GB18_BKUD:A12","CH_GB18_DIEZ:A14"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_20:XD-03","text":"Das Eins verliert seine scheinbare Einfachheit, weil es zugleich Diskretion ermöglicht, Grenze setzt, Einheit erhält und die Zahl gegen anderes abschließt.","refs":["CL_GB18_20:GA-02","CL_GB18_20:GA-07","CH_GB18_BKUD:A7","CH_GB18_DIEZ:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_20:XD-04","text":"Die Aufhebung der Trennung von kontinuierlicher und diskreter Größe bereitet nicht bloß deren Versöhnung vor, sondern erzeugt die neue Differenz von Einheit und Anzahl innerhalb der Zahl.","refs":["CL_GB18_20:GA-06","CL_GB18_20:GA-07","CH_GB18_CBDQ:A14","CH_GB18_DIEZ:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_20:XD-05","text":"Die ausgeschlossene äußere Grenze kehrt als innere Äußerlichkeit wieder: Gerade weil die Zahl ihre Grenze selbst erzeugt, bleibt sie quantitativ auf andere Zahlen bezogen.","refs":["CL_GB18_20:GA-04","CL_GB18_20:GA-09","CH_GB18_CBDQ:NX3","CH_GB18_DIEZ:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_20:XD-06","text":"Die quantitative Unendlichkeit entsteht nicht aus grenzenloser Ausdehnung, sondern aus dem Widerspruch einer Grenze, die als Selbstbestimmung gesetzt ist und zugleich äußerlich vergleichbar bleibt.","refs":["CL_GB18_20:GA-09","CL_GB18_20:GA-10","CH_GB18_DIEZ:A4","CH_GB18_DIEZ:D8"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_20:BSD-01","text":"Quantität wird auf Clusterebene als Maschine der immanenten Individuation sichtbar: Sie erzeugt aus gleichförmigem Außereinander bestimmte Einheiten, ohne ein äußeres Prinzip der Individuation zu benötigen.","refs":["CH_GB18_BKUD:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSD-02","text":"Bestimmtheit ist keine Fixierung eines bereits gegebenen Inhalts, sondern ein Prozess, in dem Ausschluss, Umschließung und Überschreitung dieselbe quantitative Bewegung bilden.","refs":["CH_GB18_CBDQ:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSD-03","text":"Die Zahl transformiert Vielheit in eine Totalität: Nicht ein Element repräsentiert das Ganze, sondern die Gleichheit aller Eins lässt die Anzahl selbst als Grenze fungieren.","refs":["CH_GB18_DIEZ:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSD-04","text":"Die quantitative Ordnung erzeugt ihre eigene Instabilität, weil sie die Einheit gegen anderes abschließt und dieses Andere zugleich als notwendiges Feld äußerlicher Vergleichbarkeit enthält.","refs":["CH_GB18_DIEZ:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSD-05","text":"Der Übergang zur weiteren Entwicklung der Quantität wird nicht durch einen Wechsel des Gegenstands erzwungen, sondern durch die interne Unzulänglichkeit einer Bestimmtheit, die zugleich vollständig und äußerlich sein muss.","refs":["CH_GB18_DIEZ:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_20:RLE-01","text":"Die erste Rekursionsschleife lautet: Kontinuität setzt das Eins voraus; das Eins erzeugt Diskretion; die Gleichheit der Eins stellt Kontinuität im Diskreten wieder her.","refs":["CH_GB18_BKUD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RLE-02","text":"Die zweite Rekursionsschleife lautet: Eins erzeugt Grenze; Grenze umfasst Vielheit; Vielheit bildet als Anzahl die Grenze, die das Eins zunächst gesetzt hatte.","refs":["CH_GB18_DIEZ:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RLE-03","text":"Der Attraktor der Gesamtarchitektur ist die immanente Grenze, weil sie Kontinuität, Diskretion, Vielheit, Einheit, Dasein und Äußerlichkeit in einer einzigen Bewegungsform vermittelt.","refs":["CH_GB18_CBDQ:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RLE-04","text":"Der Eskalationspfad führt von vorquantitativen Formen über begrenztes Quantum zur Zahl und von dort zur quantitativen Unendlichkeit.","refs":["CH_GB18_BKUD:FGS7","CH_GB18_DIEZ:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RLE-05","text":"Der produktive Phasenwechsel liegt dort, wo Grenze nicht länger Negation eines Anderen bedeutet, sondern als Selbstbeziehung die eigene Überschreitung hervorbringt.","refs":["CH_GB18_CBDQ:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_20:FGS-B01","text":"Quantität → Einheit von Kontinuität und Diskretion → jede Form enthält ihr Gegenmoment.","refs":["CH_GB18_BKUD:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B02","text":"Unmittelbare Kontinuität → Aufhebung der Unmittelbarkeit → Eins als immanente Bestimmung → diskrete Vielheit.","refs":["CH_GB18_BKUD:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B03","text":"Gleiche Eins → kontinuierliche Vermittlung des Diskreten → Ausschluss atomistischer Unabhängigkeit.","refs":["CH_GB18_BKUD:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B04","text":"Diskrete Vielheit → aufgehobene Einheit → ausschließendes Eins → selbstbezogene und umschließende Grenze.","refs":["CH_GB18_CBDQ:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B05","text":"Grenze → begrenztes Dasein als Kontinuität → Überschreitung der Grenze → Quantum als Einheit von Ausschluss und Fortgang.","refs":["CH_GB18_CBDQ:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B06","text":"Quantum → Einheit und Anzahl → Zahl als selbstgebildete Grenze → innere Äußerlichkeit gegenüber anderem.","refs":["CH_GB18_DIEZ:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B07","text":"Innere Äußerlichkeit → Widerspruch von Selbstbestimmung und Vergleichbarkeit → Qualität des Quantums → weitere quantitative Entwicklung.","refs":["CH_GB18_DIEZ:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_20:AFM-B01","text":"Einheit unterschiedener Momente → unmittelbare Kontinuität → Eins als immanente Negation → diskrete Vielheit.","refs":["CH_GB18_BKUD:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AFM-B02","text":"Diskrete Vielheit → Gleichheit der Eins → Kontinuität des Diskreten → Ausschluss atomistischer Vereinzelung.","refs":["CH_GB18_BKUD:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AFM-B03","text":"Einheit aufgehobener Eins → ausschließende Grenze → selbstbezogene Umschließung → begrenztes Dasein.","refs":["CH_GB18_CBDQ:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AFM-B04","text":"Begrenztes Dasein → Überschreitung durch Kontinuität → Quantum → Gleichgültigkeit der ursprünglichen Größenunterscheidung.","refs":["CH_GB18_CBDQ:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AFM-B05","text":"Quantum → Einheit und Anzahl → Zahl als vollständige Grenze → innere Äußerlichkeit → Widerspruch → quantitative Unendlichkeit.","refs":["CH_GB18_DIEZ:AF2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_20:MME-01","text":"Der Gegensatz von Kontinuität und Diskretion wird von einer ontologischen Zweiheit in eine wechselnde Setzungsordnung innerhalb derselben Quantität umkartiert.","refs":["CH_GB18_BKUD:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MME-02","text":"Das Eins wird vom atomaren Element zum verteilten Organisationsprinzip umklassifiziert, das Vielheit, Grenze und Einheit zugleich ermöglicht.","refs":["CH_GB18_BKUD:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MME-03","text":"Grenze wird von der Linie zwischen einem Inneren und Äußeren zur immanenten Operation, durch die Quantität sich als Dasein bestimmt.","refs":["CH_GB18_CBDQ:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MME-04","text":"Zahl wird von einer Summe zählbarer Einheiten zu einer selbstbegrenzenden Totalität umkartiert, in der Anzahl die Gestalt der Grenze ist.","refs":["CH_GB18_DIEZ:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MME-05","text":"Äußerlichkeit wird nicht mehr als nachträgliche Relation zwischen fertigen Quanta verstanden, sondern als internes Produkt ihrer Selbstbestimmung.","refs":["CH_GB18_DIEZ:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MME-06","text":"Widerspruch wird von einem Defekt der Begriffskohärenz zum Motor der quantitativen Entwicklung reklassifiziert.","refs":["CH_GB18_DIEZ:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_20:ALT-B01","text":"Surface level — Der explizite Gegenstand ist die Bewegung von kontinuierlicher und diskreter Größe über das begrenzte Quantum zur Zahl.","refs":["CH_GB18_DIEZ:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:ALT-B02","text":"Structural level — Die tragende Struktur ist eine Selbstvermittlung, in der Einheit Differenz erzeugt, Differenz Grenze erzeugt und Grenze die Einheit als bestimmte Vielheit zurückbildet.","refs":["CH_GB18_CBDQ:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:ALT-B03","text":"Metastrategic level — Äußerliche Klassifikation, atomistische Addition und äußerliche Begrenzung werden durch eine immanente Rekonstruktion der quantitativen Selbstbestimmung ersetzt.","refs":["CH_GB18_BKUD:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:ALT-B04","text":"Ontological / Temporal level — Quantität ist ein Sein des Außereinander, dessen Bestimmtheit nicht in qualitative Andersheit übergeht, sondern sich als Grenze, Überschreitung und Unendlichkeit fortentwickelt.","refs":["CH_GB18_BKUD:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:ALT-B05","text":"Methodological / Performative level — Die Argumentform vollzieht ihre These, indem sie jeden scheinbar fixen Begriff nur durch seine immanente Selbstüberschreitung bestimmt.","refs":["CH_GB18_CBDQ:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_20:FL-01","text":"Die diskrete Größe muss Unterbrechung sein und zugleich kontinuierlich bleiben; diese Spannung wird als Einheit gleicher Eins bestimmt, aber nicht vollständig weitervermittelt.","refs":["CH_GB18_BKUD:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FL-02","text":"Das Eins muss zugleich einzelnes Moment, ausschließende Grenze, aufgehobene Einheit und allgemeines Prinzip sein; die Übergänge zwischen diesen Funktionen bleiben hochkomprimiert.","refs":["CH_GB18_CBDQ:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FL-03","text":"Das Quantum ist gegen seine Grenze gleichgültig und doch nur durch Grenze bestimmt; die Architektur benötigt diese Unvereinbarkeit als Quelle weiterer Bewegung.","refs":["CH_GB18_DIEZ:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FL-04","text":"Die Zahl kehrt in sich zurück und bleibt zugleich äußerlich auf andere Zahlen bezogen; diese Doppelstellung ist nicht auflösbar, ohne ihre quantitative Qualität zu verlieren.","refs":["CH_GB18_DIEZ:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MP-01","text":"Die erste Mutation liegt im Übergang von Kontinuität zum Eins: Unmittelbarkeit wird nicht einfach negiert, sondern als immanente Voraussetzung diskreter Bestimmung erhalten.","refs":["CH_GB18_BKUD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MP-02","text":"Die zweite Mutation liegt im Begriff der Grenze, die von ausschließender Negation zur umschließenden Selbstbeziehung des Quantums wird.","refs":["CH_GB18_CBDQ:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MP-03","text":"Die terminale Mutation liegt in der Zahl, wo die Grenze nicht mehr einer Vielheit gegenübersteht, sondern als Anzahl aus deren Gleichheit hervorgeht.","refs":["CH_GB18_DIEZ:D4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_20:HSI-01","text":"Realität erscheint als ein Gefüge, in dem jedes Außereinander nur als intern vermittelte Einheit bestehen kann und jede Einheit ihre Differenz selbst produziert.","refs":["CH_GB18_BKUD:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:HSI-02","text":"Das Subjektmodell des Systems ist kein souveränes Eins außerhalb der Vielheit, sondern ein Grenzmodus, der sich nur in der Einheit seiner aufgehobenen Momente erhält.","refs":["CH_GB18_CBDQ:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:HSI-03","text":"Zeitliche Bewegung erscheint nicht als äußerer Ablauf, sondern als quantitative Selbstüberschreitung, in der Begrenzung Fortgang erzeugt.","refs":["CH_GB18_CBDQ:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:HSI-04","text":"Mögliche Navigation besteht nicht in der Wahl zwischen Einheit und Vielheit, Kontinuität und Diskretion oder Innerem und Äußerem, sondern im Erfassen ihrer rekursiven Umschlagspunkte.","refs":["CH_GB18_BKUD:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_20:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Gesamtbewegung von der vorquantitativen Einheit der Größenformen über Grenze und Quantum zur Zahl als widersprüchlicher quantitativer Bestimmtheit zu rekonstruieren.","refs":["CH_GB18_BKUD:MRT1","CH_GB18_DIEZ:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MRT-B02","text":"Die Rekonstruktion ist dort am stärksten, wo sie die Grenze nicht als äußeren Rand, sondern als durch Vielheit, Einheit und Kontinuität selbst erzeugte Bestimmtheit fasst.","refs":["CH_GB18_DIEZ:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MRT-B03","text":"Unterbestimmt bleibt die genaue Vermittlung, durch die das Aufgehobensein der Unmittelbarkeit notwendig das Eins hervorbringt und durch die Zahl in quantitative Unendlichkeit übergeht.","refs":["CH_GB18_BKUD:MRT2","CH_GB18_DIEZ:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MRT-B04","text":"Die Architektur bleibt kohärent, sofern Kontinuität, Diskretion, Grenze, Einheit und Äußerlichkeit nicht als getrennte Dinge, sondern als mutierende Funktionen einer Selbstbestimmungsmaschine gelesen werden.","refs":["CH_GB18_CBDQ:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MRT-B05","text":"Unreduzierbar bleibt die produktive Spannung, dass Quantität ihre Grenze selbst erzeugen muss und durch eben diese Selbstbegrenzung auf ein ihr äußerliches Anderes verwiesen wird.","refs":["CH_GB18_DIEZ:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121409935222Z_be01b9e3","language_code":"en","language_name":"English","title":"Chapters 58–60","source_sha256":"0cc082736cc0b3a1905a9dde1bbe94836f32687bd2d77f1a33deb92d29258e70","sha256":"ef981a598577dfb5a16a2ff5b734a6b00b6ac3839d7ad49359fc9fd39caa6914","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:14:09.936401+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_20:AS-B01","text":"Quantity is reconstructed as the unity of continuity and discreteness, whose opposition constitutes not an external division but a self-differentiation of the same structure.","refs":["CH_GB18_BKUD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B02","text":"Initially immediate continuity is transformed into discreteness through the immanent positing of the One, without losing its own unity.","refs":["CH_GB18_BKUD:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B03","text":"The One mutates from a moment of differentiation into the principle of plurality, limit, and the unity of a determinate being-there (Dasein).","refs":["CH_GB18_CBDQ:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B04","text":"Limit appears not as an external closure, but as the self-relation of quantity, which gathers plurality together and at the same time enables its transgression.","refs":["CH_GB18_CBDQ:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B05","text":"With limit, quantity becomes quantum; the preceding difference between continuous and discrete magnitude loses its independent validity.","refs":["CH_GB18_CBDQ:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B06","text":"Number completes this movement as quantum, whose unit and amount are not separate components but the shared form of its limit.","refs":["CH_GB18_DIEZ:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B07","text":"From its self-limitation, number produces an internal externality toward other numbers, thereby transforming quantitative determinacy into a productive contradiction.","refs":["CH_GB18_DIEZ:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AS-B08","text":"The overall movement is recursive and escalating: unity produces difference, difference limit, limit determinate unity, and determinate unity releases the externality that compels further quantitative development.","refs":["CH_GB18_DIEZ:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_20:GA-01","text":"[Persistent] Quantity exists only as the concrete unity of continuity and discreteness; none of its forms can subsist without the respective other moment.","refs":["CH_GB18_BKUD:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-02","text":"[Mutating] The One is initially the immanent principle of discreteness, then becomes an excluding limit, and finally the unity in which amount and determinate quantum coincide.","refs":["CH_GB18_BKUD:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-03","text":"[Persistent] Discreteness is not an atomistic plurality, because the many Ones remain continuously mediated through equality and common unity.","refs":["CH_GB18_BKUD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-04","text":"[Emergent] Limit is the self-relation of quantitative unity: it determines being-there (Dasein) as exclusion without standing beside it as an alien externality.","refs":["CH_GB18_CBDQ:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-05","text":"[Attractor] Quantitative determinacy arises only through the coupling of limiting exclusion and overarching continuity.","refs":["CH_GB18_CBDQ:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-06","text":"[Terminal] Continuous and discrete magnitude are sublated as independent forms as soon as both are determined as quanta under the same immanent limit.","refs":["CH_GB18_CBDQ:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-07","text":"[Emergent] Number is the fully determinate form of quantum because unit and amount jointly produce its limit.","refs":["CH_GB18_DIEZ:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-08","text":"[Mutating] The multiplicity of equal Ones is not the material of a limit posited from outside, but the concrete formation of this limit itself.","refs":["CH_GB18_DIEZ:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-09","text":"[Attractor] Quantity contains an unavoidable externality: it is indifferent toward its limit and toward other quanta, yet bears this indifference within itself as its own moment.","refs":["CH_GB18_DIEZ:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GA-10","text":"[Terminal] The contradiction between immanent self-determination and external comparability is not a disturbance but the quality through which quantity opens its further development.","refs":["CH_GB18_DIEZ:AS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_20:RMD-01","text":"Continuity remains preserved as an identical moment of quantity, but shifts from immediate continuation through the unity of equal Ones to the transgression of limit.","refs":["CH_GB18_CBDQ:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RMD-02","text":"Discreteness mutates from the form of a discontinuous externality into a plurality determined by limit, whose Ones are sublated in a unity.","refs":["CH_GB18_CBDQ:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RMD-03","text":"The One recurs functionally as the principle of discreteness, as excluding limit, as encompassing self-relation, and as the unit of number.","refs":["CH_GB18_DIEZ:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RMD-04","text":"Limit does not recur as a fixed motif, but escalates from the excluded external edge to the immanent structure of quantum and to the determinacy formed through amount.","refs":["CH_GB18_DIEZ:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RMD-05","text":"The difference between continuity and discreteness is not eliminated, but absorbed in number, where it assumes a new operative form as unit and amount.","refs":["CH_GB18_DIEZ:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RMD-06","text":"The external relation to another shifts from an excluded explanatory model to an internal moment of numerical identity.","refs":["CH_GB18_DIEZ:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_20:CGD-01","text":"The description of space, time, and matter as continuous magnitudes remains local because it produces no additional generative determination of the quantitative machine developed here.","refs":["CH_GB18_BKUD:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:CGD-02","text":"The local distinction between extensive and intensive quantum remains subordinate because, at the cluster level, only their shared dependence on immanent limitation is load-bearing.","refs":["CH_GB18_DIEZ:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:CGD-03","text":"The identification of One, negation, and limit is a problem of transition at the chapter level, but at the cluster level it becomes the necessary axis of mediation between quantity, quantum, and number.","refs":["CH_GB18_CBDQ:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:CGD-04","text":"The equality of the Ones is not merely a property of discrete magnitude, but the condition under which plurality can appear at all as determinate unity and number.","refs":["CH_GB18_DIEZ:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:CGD-05","text":"The indifference of continuous and discrete magnitude is not a local conclusion about forms, but the systemic precondition of their joint transformation into quantum.","refs":["CH_GB18_CBDQ:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_20:GNX-01","text":"Excluded is every reduction of quantity to pure continuity or pure discreteness, because every such purity suppresses the mediating counter-moment.","refs":["CH_GB18_BKUD:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GNX-02","text":"Excluded is an atomism of independent Ones, because discrete plurality is determined only as the unity of sublated and equal Ones.","refs":["CH_GB18_BKUD:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GNX-03","text":"Excluded is a limit imposed externally upon limited being, because limit is the self-determination of this being.","refs":["CH_GB18_CBDQ:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GNX-04","text":"Excluded is a plurality whose limit would be borne by a privileged final One, because every One occupies the same position within the amount.","refs":["CH_GB18_DIEZ:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GNX-05","text":"Excluded is the qualitative reinterpretation of numerical difference, because numbers differ only quantitatively and externally.","refs":["CH_GB18_DIEZ:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:GNX-06","text":"Excluded is a closed quantum without internal externality, because its determinacy simultaneously releases the relation to another.","refs":["CH_GB18_DIEZ:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_20:DBN-01","text":"The system cannot permit ontologically independent principles of unity, plurality, continuity, or discreteness without destroying the self-mediation of quantity.","refs":["CH_GB18_BKUD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:DBN-02","text":"It cannot permit an external ground of limit, because an alien limitation would interrupt the immanent emergence of quantum from One and plurality.","refs":["CH_GB18_BKUD:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:DBN-03","text":"It cannot permit a qualitative singularity of an individual One, because number arises only if its limit permeates the entire amount.","refs":["CH_GB18_DIEZ:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:DBN-04","text":"It cannot permit a final separation of inner determinacy and external relation, because the contradiction of both grounds the capacity for development of quantum.","refs":["CH_GB18_DIEZ:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_20:BSA-01","text":"Unavailable is a pure self-identity of quantity that would produce neither difference nor externality.","refs":["CH_GB18_DIEZ:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSA-02","text":"Impossible is a number whose limit lies outside its amount, because this would undo the self-constitution of quantitative determinacy.","refs":["CH_GB18_DIEZ:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSA-03","text":"Impermissible is a final repose of limit, because the continuity of limited being simultaneously transgresses every limit.","refs":["CH_GB18_CBDQ:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSA-04","text":"The system circles around the impossibility of a quantity without contradiction: a wholly internal or wholly external determinacy would block the movement toward quantum and number.","refs":["CH_GB18_CBDQ:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_20:XD-01","text":"The unity of continuity and discreteness developed in the first section of movement receives the form of a being-there (Dasein) only through limit; limit is therefore not an addition to quantity, but its realization as quantum.","refs":["CL_GB18_20:GA-01","CL_GB18_20:GA-04","CL_GB18_20:GA-05","CH_GB18_BKUD:A17","CH_GB18_CBDQ:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_20:XD-02","text":"The continuity of discrete plurality and the self-relation of limit together form the condition under which many Ones do not merely coexist, but constitute a determinate amount.","refs":["CL_GB18_20:GA-03","CL_GB18_20:GA-08","CH_GB18_BKUD:A12","CH_GB18_DIEZ:A14"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_20:XD-03","text":"The One loses its apparent simplicity because it simultaneously enables discreteness, posits limit, preserves unity, and closes off number against another.","refs":["CL_GB18_20:GA-02","CL_GB18_20:GA-07","CH_GB18_BKUD:A7","CH_GB18_DIEZ:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_20:XD-04","text":"The sublation of the separation between continuous and discrete magnitude does not merely prepare their reconciliation, but produces the new difference between unit and amount within number.","refs":["CL_GB18_20:GA-06","CL_GB18_20:GA-07","CH_GB18_CBDQ:A14","CH_GB18_DIEZ:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_20:XD-05","text":"The excluded external limit returns as internal externality: precisely because number produces its own limit, it remains quantitatively related to other numbers.","refs":["CL_GB18_20:GA-04","CL_GB18_20:GA-09","CH_GB18_CBDQ:NX3","CH_GB18_DIEZ:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_20:XD-06","text":"Quantitative infinity arises not from boundless extension, but from the contradiction of a limit that is posited as self-determination and yet remains externally comparable.","refs":["CL_GB18_20:GA-09","CL_GB18_20:GA-10","CH_GB18_DIEZ:A4","CH_GB18_DIEZ:D8"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_20:BSD-01","text":"At the cluster level, quantity becomes visible as a machine of immanent individuation: from homogeneous externality it produces determinate unities without requiring an external principle of individuation.","refs":["CH_GB18_BKUD:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSD-02","text":"Determinacy is not a fixation of an already given content, but a process in which exclusion, enclosure, and transgression constitute the same quantitative movement.","refs":["CH_GB18_CBDQ:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSD-03","text":"Number transforms plurality into a totality: not one element represents the whole, but the equality of all Ones allows the amount itself to function as limit.","refs":["CH_GB18_DIEZ:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSD-04","text":"The quantitative order produces its own instability because it closes unity off against another while simultaneously containing this other as the necessary field of external comparability.","refs":["CH_GB18_DIEZ:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:BSD-05","text":"The transition to the further development of quantity is not compelled by a change of object, but by the internal inadequacy of a determinacy that must be both complete and external.","refs":["CH_GB18_DIEZ:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_20:RLE-01","text":"The first recursive loop runs: continuity presupposes the One; the One produces discreteness; the equality of the Ones restores continuity within the discrete.","refs":["CH_GB18_BKUD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RLE-02","text":"The second recursive loop runs: One produces limit; limit encompasses plurality; plurality, as amount, forms the limit that the One had initially posited.","refs":["CH_GB18_DIEZ:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RLE-03","text":"The attractor of the overall architecture is immanent limit, because it mediates continuity, discreteness, plurality, unity, being-there (Dasein), and externality in a single form of movement.","refs":["CH_GB18_CBDQ:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RLE-04","text":"The escalation path leads from pre-quantitative forms through limited quantum to number and from there to quantitative infinity.","refs":["CH_GB18_BKUD:FGS7","CH_GB18_DIEZ:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:RLE-05","text":"The productive phase change lies where limit no longer signifies the negation of another, but, as self-relation, brings forth its own transgression.","refs":["CH_GB18_CBDQ:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_20:FGS-B01","text":"Quantity → unity of continuity and discreteness → every form contains its counter-moment.","refs":["CH_GB18_BKUD:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B02","text":"Immediate continuity → sublation of immediacy → One as immanent determination → discrete plurality.","refs":["CH_GB18_BKUD:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B03","text":"Equal Ones → continuous mediation of the discrete → exclusion of atomistic independence.","refs":["CH_GB18_BKUD:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B04","text":"Discrete plurality → sublated unity → excluding One → self-related and encompassing limit.","refs":["CH_GB18_CBDQ:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B05","text":"Limit → limited being-there (Dasein) as continuity → transgression of limit → quantum as unity of exclusion and progression.","refs":["CH_GB18_CBDQ:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B06","text":"Quantum → unit and amount → number as self-formed limit → internal externality toward another.","refs":["CH_GB18_DIEZ:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FGS-B07","text":"Internal externality → contradiction of self-determination and comparability → quality of quantum → further quantitative development.","refs":["CH_GB18_DIEZ:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_20:AFM-B01","text":"Unity of differentiated moments → immediate continuity → One as immanent negation → discrete plurality.","refs":["CH_GB18_BKUD:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AFM-B02","text":"Discrete plurality → equality of the Ones → continuity of the discrete → exclusion of atomistic isolation.","refs":["CH_GB18_BKUD:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AFM-B03","text":"Unity of sublated Ones → excluding limit → self-related enclosure → limited being-there (Dasein).","refs":["CH_GB18_CBDQ:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AFM-B04","text":"Limited being-there (Dasein) → transgression through continuity → quantum → indifference of the original distinction of magnitudes.","refs":["CH_GB18_CBDQ:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:AFM-B05","text":"Quantum → unit and amount → number as complete limit → internal externality → contradiction → quantitative infinity.","refs":["CH_GB18_DIEZ:AF2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_20:MME-01","text":"The opposition of continuity and discreteness is remapped from an ontological duality into an alternating order of positing within the same quantity.","refs":["CH_GB18_BKUD:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MME-02","text":"The One is reclassified from an atomic element into a distributed organizational principle that simultaneously enables plurality, limit, and unity.","refs":["CH_GB18_BKUD:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MME-03","text":"Limit is transformed from the line between an interior and an exterior into the immanent operation through which quantity determines itself as being-there (Dasein).","refs":["CH_GB18_CBDQ:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MME-04","text":"Number is remapped from a sum of countable units into a self-limiting totality in which amount is the form of limit.","refs":["CH_GB18_DIEZ:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MME-05","text":"Externality is no longer understood as a subsequent relation between finished quanta, but as the internal product of their self-determination.","refs":["CH_GB18_DIEZ:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MME-06","text":"Contradiction is reclassified from a defect of conceptual coherence into the motor of quantitative development.","refs":["CH_GB18_DIEZ:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_20:ALT-B01","text":"Surface level — The explicit object is the movement from continuous and discrete magnitude through limited quantum to number.","refs":["CH_GB18_DIEZ:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:ALT-B02","text":"Structural level — The load-bearing structure is a self-mediation in which unity produces difference, difference produces limit, and limit reconstitutes unity as determinate plurality.","refs":["CH_GB18_CBDQ:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:ALT-B03","text":"Metastrategic level — External classification, atomistic addition, and external limitation are replaced by an immanent reconstruction of quantitative self-determination.","refs":["CH_GB18_BKUD:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:ALT-B04","text":"Ontological / Temporal level — Quantity is a being of externality, whose determinacy does not pass into qualitative otherness but develops further as limit, transgression, and infinity.","refs":["CH_GB18_BKUD:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:ALT-B05","text":"Methodological / Performative level — The argument-form enacts its thesis by determining every seemingly fixed concept only through its immanent self-transgression.","refs":["CH_GB18_CBDQ:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_20:FL-01","text":"Discrete magnitude must be discontinuity and yet remain continuous; this tension is determined as the unity of equal Ones, but is not fully further mediated.","refs":["CH_GB18_BKUD:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FL-02","text":"The One must simultaneously be an individual moment, excluding limit, sublated unity, and universal principle; the transitions between these functions remain highly compressed.","refs":["CH_GB18_CBDQ:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FL-03","text":"Quantum is indifferent toward its limit and yet determined only through limit; the architecture requires this incompatibility as the source of further movement.","refs":["CH_GB18_DIEZ:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:FL-04","text":"Number returns into itself and yet remains externally related to other numbers; this double position cannot be resolved without losing its quantitative quality.","refs":["CH_GB18_DIEZ:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MP-01","text":"The first mutation lies in the transition from continuity to the One: immediacy is not simply negated, but preserved as the immanent presupposition of discrete determination.","refs":["CH_GB18_BKUD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MP-02","text":"The second mutation lies in the concept of limit, which becomes from excluding negation the encompassing self-relation of quantum.","refs":["CH_GB18_CBDQ:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MP-03","text":"The terminal mutation lies in number, where limit no longer stands over against a plurality, but emerges as amount from its equality.","refs":["CH_GB18_DIEZ:D4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_20:HSI-01","text":"Reality appears as an arrangement in which every externality can subsist only as an internally mediated unity, and every unity itself produces its difference.","refs":["CH_GB18_BKUD:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:HSI-02","text":"The system's model of the subject is not a sovereign One outside plurality, but a mode of limit that preserves itself only in the unity of its sublated moments.","refs":["CH_GB18_CBDQ:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:HSI-03","text":"Temporal movement appears not as an external course, but as quantitative self-transgression in which limitation produces progression.","refs":["CH_GB18_CBDQ:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:HSI-04","text":"Possible navigation consists not in the choice between unity and plurality, continuity and discreteness, or interior and exterior, but in grasping their recursive points of reversal.","refs":["CH_GB18_BKUD:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_20:MRT-B01","text":"The extracted axioms suffice to reconstruct the overall movement from the pre-quantitative unity of forms of magnitude through limit and quantum to number as contradictory quantitative determinacy.","refs":["CH_GB18_BKUD:MRT1","CH_GB18_DIEZ:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MRT-B02","text":"The reconstruction is strongest where it grasps limit not as an external edge, but as a determinacy produced by plurality, unity, and continuity themselves.","refs":["CH_GB18_DIEZ:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MRT-B03","text":"What remains underdetermined is the precise mediation through which the sublatedness of immediacy necessarily brings forth the One and through which number passes into quantitative infinity.","refs":["CH_GB18_BKUD:MRT2","CH_GB18_DIEZ:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MRT-B04","text":"The architecture remains coherent insofar as continuity, discreteness, limit, unity, and externality are read not as separate things, but as mutating functions of a machine of self-determination.","refs":["CH_GB18_CBDQ:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_20:MRT-B05","text":"Irreducible remains the productive tension that quantity must itself produce its limit and, through precisely this self-limitation, is referred to an other external to it.","refs":["CH_GB18_DIEZ:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_20@R001","source_variant_id":"canonical:CL_GB18_20:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 58–60","context":"B. Kontinuirliche und diskrete Größe. · C. Begrenzung der Quantität. · A. Die Zahl."},"title_language_code":"en"},{"id":"CL_GB18_21","layer":"CL","title":"Chapters 61–63","order":21,"parents":["CH_GB18_A_14","CH_GB18_A_15","CH_GB18_UNTD"],"revision":"CL_GB18_21@R001","sha256":"c3d83bdc2f20317d9cedd17e3c559dd5c0ca703d15aadf56ff720880e0fc1785","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_21:AS-01","text":"Die Clusterarchitektur bestimmt Zahl als notwendige Form quantitativer Begrenzung, deren Äußerlichkeit jedoch weder mit begrifflicher Innerlichkeit noch mit der vollständigen Realität quantitativer Bestimmtheit zusammenfällt.","refs":["CH_GB18_A_14:AS1","CH_GB18_UNTD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-02","text":"Das Argument trennt äußeres Zählen, Rechnen und Symbolisieren von der logischen Bewegung, in der die Zahl ihre Vielheit aufhebt und als intensive Grenze in eine Relationsstruktur übergeht.","refs":["CH_GB18_A_14:A5","CH_GB18_UNTD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-03","text":"Die äußere Bestimmtheit der Zahl wird nicht einfach verworfen, sondern funktional gespalten: Als Rechenform bleibt sie mechanisch und begrifflos; als aufgehobene Anzahl wird sie Bedingung des Grades.","refs":["CH_GB18_A_15:A9","CH_GB18_UNTD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-04","text":"Der Grad vollzieht die Umkehrung, dass die aus ihm ausgeschlossene numerische Vielheit außerhalb seiner selbst als Bedingung seiner bestimmten Einfachheit fortwirkt.","refs":["CH_GB18_UNTD:SD2","CH_GB18_UNTD:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-05","text":"Die Bewegung verläuft rekursiv von Kontinuität und Diskretion über Zahl und Anzahl zur einfachen Grenze und von dort über äußere Gradrelation erneut zur Kontinuität einer Skala.","refs":["CH_GB18_UNTD:D1","CH_GB18_UNTD:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-06","text":"Die Kritik mathematischer Begriffsrepräsentation generalisiert die Differenz zwischen formaler Exaktheit und begrifflicher Wahrheit: Mit wachsender Konkretion verliert die Zahl ihre Darstellungsadäquanz.","refs":["CH_GB18_A_15:SD2","CH_GB18_A_15:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-07","text":"Die Methode verlangt zugleich, äußerlichen Stoff nicht spekulativ zu verinnerlichen und mathematische Formen erst durch ihre logische Übersetzung philosophisch zu legitimieren.","refs":["CH_GB18_A_14:AS6","CH_GB18_A_15:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-08","text":"Die Schließung besteht nicht in einer Verwerfung der Mathematik, sondern in ihrer Unterordnung unter eine Logik der bestimmenden Grenze, der immanenten Beziehung und der nichtmechanischen Bildung.","refs":["CH_GB18_A_14:SD5","CH_GB18_A_15:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_21:GA-01","text":"[Persistent] Bestimmtes Quantum verlangt die Vermittlung von Kontinuität, Diskretion, Einheit und Grenze; keine dieser Bestimmungen erzeugt für sich allein vollständige quantitative Bestimmtheit.","refs":["CH_GB18_UNTD:D1","CH_GB18_UNTD:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-02","text":"[Mutating] Zahl ist als gezählte und gerechnete Anzahl äußerliche Aggregation, wird aber als quantitative Grenze zur aufgehobenen Vielheit, die im Grad fortwirkt.","refs":["CH_GB18_A_14:A4","CH_GB18_UNTD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-03","text":"[Persistent] Begriffliche Wahrheit besteht nur dort, wo Bestimmungen als immanente Beziehungen und Bewegungen ihres Gegenstands auftreten, nicht als äußerlich angesetzte Einheiten oder Zeichen.","refs":["CH_GB18_A_15:A3","CH_GB18_A_15:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-04","text":"[Emergent] Äußerlichkeit besitzt zwei nicht gleichsetzbare Funktionen: Sie kennzeichnet die Begrifflosigkeit arithmetischer Operationen und bildet zugleich die reale Vermittlungsbedingung intensiver Bestimmtheit.","refs":["CH_GB18_A_15:A2","CH_GB18_UNTD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-05","text":"[Attractor] Die Grenze ist die zentrale Vermittlungsfigur, weil sie das Quantum bestimmt, die Anzahl in Einfachheit überführt und jede intensive Einheit auf ausgeschlossene Vielheit verweist.","refs":["CH_GB18_UNTD:A1","CH_GB18_UNTD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-06","text":"[Emergent] Der Grad ist keine innere Atomgröße, sondern eine einfache Grenze, deren Realität allein durch wesentliche Relation zu anderen Graden innerhalb einer kontinuierlichen Skala besteht.","refs":["CH_GB18_UNTD:AS5","CH_GB18_UNTD:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-07","text":"[Mutating] Zahl vermittelt geschichtlich zwischen Sinnlichkeit und Denken, verliert aber mit zunehmender Konkretion des Gedankens ihre Fähigkeit, dessen innere Bewegtheit auszudrücken.","refs":["CH_GB18_A_15:A5","CH_GB18_A_15:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-08","text":"[Terminal] Mathematische Kategorien erhalten keinen philosophischen Sinn aus ihrer technischen Verwendung, sondern nur aus logischer Bestimmung, Übersetzung und Rechtfertigung.","refs":["CH_GB18_A_15:A7","CH_GB18_A_15:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-09","text":"[Persistent] Wahre Synthese verlangt eine in sich unterschiedene Identität; bloßes Zählen, Summieren oder numerisches Benennen erfüllt diese Bedingung nicht.","refs":["CH_GB18_A_14:A13","CH_GB18_A_15:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-10","text":"[Terminal] Mechanisch reproduzierbare Rechenleistung kann reflektierende Abstraktion ausbilden, jedoch keine Bildung des Begriffs ersetzen und keine Vorrangstellung in der geistigen Bildung beanspruchen.","refs":["CH_GB18_A_15:A10","CH_GB18_A_15:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_21:RMD-01","text":"Die Zahl behält ihre stabile Identität als Quantitätsbestimmung, mutiert aber von äußerlich gesetzter Anzahl zu einer im Grad aufgehobenen und externalisierten Vielheit.","refs":["CH_GB18_A_15:A1","CH_GB18_UNTD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RMD-02","text":"Äußerlichkeit kehrt funktional wieder, wechselt jedoch ihre Valenz: Als Rechenform zeigt sie Begrifflosigkeit, als Gradrelation erzeugt sie qualitative Realität.","refs":["CH_GB18_A_14:SD2","CH_GB18_UNTD:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RMD-03","text":"Kontinuität und Diskretion erscheinen zunächst als unvollständige Abstraktionen, werden dann in der Zahl vermittelt und kehren schließlich als ununterbrochene Skala intensiver Unterschiede wieder.","refs":["CH_GB18_UNTD:A3","CH_GB18_UNTD:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RMD-04","text":"Die mathematische Form verschiebt sich von einer möglichen historischen Brücke zum Denken zu einer Grenzform, die bei konkreteren Begriffsverhältnissen ihre Darstellungskraft verliert.","refs":["CH_GB18_A_15:AS3","CH_GB18_A_15:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RMD-05","text":"Die Operationsfolge Addition, Subtraktion, Multiplikation, Division, Potenz und Wurzel bleibt lokal systematisch, wird auf Clusterebene jedoch in die allgemeinere Differenz zwischen äußerer Ordnung und immanenter Selbstbewegung absorbiert.","refs":["CH_GB18_A_14:A11","CH_GB18_A_14:NX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_21:CGD-01","text":"Die spezielle Ableitung einzelner Rechnungsarten aus Gleichheit, Ungleichheit, Einheit und Anzahl bleibt eine lokale Struktur der arithmetischen Operationsordnung.","refs":["CH_GB18_A_14:A10","CH_GB18_A_14:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:CGD-02","text":"Die Behauptung einer abschließenden numerischen Vollendung im Quadrat bleibt eine lokale Grenzthese und trägt nicht die globale Architektur der Transformation von Anzahl in Grad.","refs":["CH_GB18_A_14:MRT3","CH_GB18_A_14:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:CGD-03","text":"Die Zurückweisung einzelner kantischer Beispiele bleibt lokal, während das Kriterium einer innerlich unterschiedenen Identität zur clusterweiten Prüfung von Synthese, Symbolisierung und Begriffsbewegung aufsteigt.","refs":["CH_GB18_A_14:AS5","CH_GB18_A_14:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:CGD-04","text":"Die historischen Beispiele numerischer Philosophie bleiben exemplarisch, während ihre systematische Funktion global darin besteht, die Vermittlungsstellung und Darstellungsgrenze der Zahl sichtbar zu machen.","refs":["CH_GB18_A_15:D1","CH_GB18_A_15:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:CGD-05","text":"Die pädagogische Kritik ist keine selbständige Bildungslehre, sondern eine Folgerung aus der globalen Differenz zwischen mechanischer Wiederholung und immanenter Begriffsbildung.","refs":["CH_GB18_A_15:D5","CH_GB18_A_15:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_21:GNX-01","text":"Ausgeschlossen ist die Gleichsetzung von formaler Exaktheit, numerischer Bestimmtheit und begrifflicher Wahrheit.","refs":["CH_GB18_A_15:DNX1","CH_GB18_A_15:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GNX-02","text":"Ausgeschlossen ist die Annahme, dass äußerlich aggregierte Einheiten durch Wiederholung, Gedächtnis oder technische Reproduzierbarkeit innere Selbstbestimmung erzeugen könnten.","refs":["CH_GB18_A_14:SNX1","CH_GB18_A_15:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GNX-03","text":"Ausgeschlossen ist ein Begriff der Intensität als isolierter, in sich geschlossener Größe; jeder Grad bleibt durch ausgeschlossene Vielheit und andere Grade bestimmt.","refs":["CH_GB18_UNTD:NX6","CH_GB18_UNTD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GNX-04","text":"Ausgeschlossen ist die unmittelbare Übertragung spekulativer Selbstbewegung auf jeden Gegenstand; die Sphäre des Materials begrenzt die Form seiner philosophischen Darstellung.","refs":["CH_GB18_A_14:DNX3","CH_GB18_A_14:NX8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_21:DBN-01","text":"Das System setzt voraus, dass es keine einheitliche quantitative Wissenschaft gibt, in der Raum, Zahl, Maß, Grad und Begriff nur gleichrangige Varianten einer einzigen Bestimmungsform wären.","refs":["CH_GB18_A_14:DNX1","CH_GB18_UNTD:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:DBN-02","text":"Das System setzt voraus, dass keine arithmetische Operation aus sich selbst eine innere Notwendigkeit besitzt, sofern sie nur äußeres Setzen, Zählen und Verbinden vollzieht.","refs":["CH_GB18_A_14:DNX2","CH_GB18_A_15:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:DBN-03","text":"Das System setzt voraus, dass kein äußerliches Zeichenverhältnis die Selbstbeziehung und Bewegung eines konkreten Begriffs unverändert bewahren kann.","refs":["CH_GB18_A_15:DNX2","CH_GB18_A_15:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:DBN-04","text":"Das System setzt voraus, dass quantitative Bestimmtheit nicht rein quantitativ bleiben kann, weil ihre äußerliche Vermittlung im Grad als qualitative Realität erscheint.","refs":["CH_GB18_UNTD:DNX4","CH_GB18_UNTD:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_21:BSA-01","text":"Unvermittelte Selbstidentität ist unmöglich, weil jede bestimmte Einheit die von ihr ausgeschlossene Vielheit als Bedingung ihrer eigenen Bestimmtheit bewahrt.","refs":["CH_GB18_UNTD:SNX1","CH_GB18_UNTD:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:BSA-02","text":"Vollständige Begriffsrepräsentation durch ein dem Begriff äußerliches Medium ist unmöglich, weil dessen diskrete Form die konstitutive Beziehung und Bewegung des Gedankens zerlegt.","refs":["CH_GB18_A_15:SNX1","CH_GB18_A_15:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:BSA-03","text":"Eine letzte mathematische Formalisierung, die höhere quantitative Formen als höhere begriffliche Wahrheit ausgibt, ist ausgeschlossen.","refs":["CH_GB18_A_14:SNX3","CH_GB18_A_15:DNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_21:XD-01","text":"Die Äußerlichkeit der Zahl muss in zwei Ebenen zerlegt werden: Als äußerliches Rechnen bleibt sie begriffslos, als äußerlich gewordene Bestimmtheit wird sie Bedingung einer intensiven und qualitativen Realität. ; Trace Type — Tension.","refs":["CL_GB18_21:GA-02","CL_GB18_21:GA-04","CH_GB18_A_15:A2","CH_GB18_UNTD:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:XD-02","text":"Die Grenze der numerischen Begriffsrepräsentation ist nicht bloß semiotisch; sie folgt daraus, dass konkrete Begriffe innere Relation verlangen, während der Grad selbst nur durch externe Relation bestimmt ist. ; Trace Type — Composite.","refs":["CL_GB18_21:GA-03","CL_GB18_21:GA-06","CH_GB18_A_15:D2","CH_GB18_UNTD:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:XD-03","text":"Die philosophische Methode muss zwischen einer legitimen logischen Rekonstruktion von Quantität und einer illegitimen spekulativen Verinnerlichung äußerlicher Verfahren unterscheiden. ; Trace Type — Composite.","refs":["CL_GB18_21:GA-04","CL_GB18_21:GA-08","CH_GB18_A_14:SD5","CH_GB18_A_15:FGS4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:XD-04","text":"Wahre Synthese wird zur Prüfregel für den Übergang von Zahl zu Grad: Sie liegt nicht im bloßen Zusammenzählen, sondern in der bewahrenden Negation, durch die Vielheit als relationale Bedingung einfacher Grenze fortbesteht. ; Trace Type — Composite.","refs":["CL_GB18_21:GA-05","CL_GB18_21:GA-09","CH_GB18_A_14:A13","CH_GB18_UNTD:MRT5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:XD-05","text":"Die Kritik des Rechenunterrichts erhält ihre Tragweite erst dadurch, dass sie mechanische Reproduzierbarkeit nicht nur gegen Bildung, sondern gegen jede Verwechslung äußerer Verfahrenssicherheit mit immanenter Begriffsbildung richtet. ; Trace Type — Composite.","refs":["CL_GB18_21:GA-03","CL_GB18_21:GA-10","CH_GB18_A_15:A10","CH_GB18_A_15:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_21:BSD-01","text":"Das Cluster erzeugt eine Ontologie der bestimmten Grenze, in der Realität nicht durch isolierte Einheiten, sondern durch die Vermittlung von Selbstbeziehung, ausgeschlossener Vielheit und äußerer Relation besteht.","refs":["CL_GB18_21:GA-05","CL_GB18_21:GA-06","CH_GB18_UNTD:D5","CH_GB18_UNTD:SNX1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:BSD-02","text":"Quantität wird als Übergangsfeld sichtbar, in dem äußerliche Bestimmtheit nicht vernichtet, sondern in die qualitative Realität des Grades transformiert wird.","refs":["CL_GB18_21:GA-02","CL_GB18_21:GA-04","CH_GB18_UNTD:D6","CH_GB18_UNTD:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:BSD-03","text":"Erkenntnis wird neu geordnet: Die technische Beherrschung eines Zeichensystems begründet weder dessen philosophische Wahrheit noch seine pädagogische Vorrangstellung.","refs":["CL_GB18_21:GA-08","CL_GB18_21:GA-10","CH_GB18_A_15:SD3","CH_GB18_A_15:SNX3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:BSD-04","text":"Zeitlichkeit spaltet sich in mechanische Wiederholung des Zählens und unteilbares Werden der Intensität; erst die zweite Form trägt die Realität des bestimmten Grades.","refs":["CL_GB18_21:GA-02","CL_GB18_21:GA-06","CH_GB18_A_14:D4","CH_GB18_UNTD:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:BSD-05","text":"Die globale Methode ist nicht antimatematisch, sondern ordnet mathematische Verfahren ihrer eigentümlichen Sphäre zu und verweigert ihnen zugleich die Stellung letzter philosophischer Autorität.","refs":["CL_GB18_21:GA-08","CL_GB18_21:GA-09","CH_GB18_A_14:AS6","CH_GB18_A_15:NX5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_21:RLE-01","text":"Kontinuität und Diskretion erzeugen als unvollständige Abstraktionen das Bedürfnis nach Zahl; die Zahl hebt ihre Vielheit in Einheit auf; die Einheit wird als Grad durch äußere Vielheit bestimmt; die Gradskala stellt Kontinuität erneut her.","refs":["CH_GB18_UNTD:FGS1","CH_GB18_UNTD:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RLE-02","text":"Die Zahl wird zur rekursiven Maschine, weil sie ihre eigene Vielheit zugleich setzt, in Einheit aufhebt und als ausgeschlossene Bedingung der Intensität wiederkehren lässt.","refs":["CH_GB18_UNTD:A8","CH_GB18_UNTD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RLE-03","text":"Die Darstellungsschleife verläuft von numerischer Symbolisierung über logische Prüfung zur Ablösung der mathematischen Partikularform; jedes erfolgreiche Verständnis entzieht der Formel ihre autonome Autorität.","refs":["CH_GB18_A_15:D4","CH_GB18_A_15:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RLE-04","text":"Der Begriff der Grenze fungiert als Attraktor, weil er Raumgröße, Zahl, extensives Quantum, Grad, Skala und Qualität in eine einzige Vermittlungsarchitektur zieht.","refs":["CH_GB18_A_14:AS2","CH_GB18_UNTD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RLE-05","text":"Die Wiederkehr der Äußerlichkeit markiert keinen Stillstand, sondern einen Phasenwechsel: Von defizitärer Rechenoperation wird sie zur konstitutiven Außenbeziehung intensiver Bestimmtheit.","refs":["CH_GB18_A_15:A9","CH_GB18_UNTD:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_21:FGS-B01","text":"Kontinuität oder Diskretion ohne Grenze → unvollständige Abstraktion des Quantums.","refs":["CH_GB18_UNTD:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B02","text":"Grenze als Anzahl gleicher Einheiten → extensives Quantum und Zahl als bestimmte Vielheit.","refs":["CH_GB18_UNTD:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B03","text":"Gleichheit der numerischen Einheiten → Aufhebung der gezählten Vielheit in selbstbezogene einfache Einheit.","refs":["CH_GB18_UNTD:AS3","CH_GB18_UNTD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B04","text":"Einfache Grenze als aufgehobene Anzahl → Grad als intensives Quantum.","refs":["CH_GB18_UNTD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B05","text":"Ausschluss der Anzahl aus dem Grad → äußere Vielheit als bestimmender Grund einer einfachen Intensität.","refs":["CH_GB18_UNTD:FGS5","CH_GB18_UNTD:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B06","text":"Wesentliche Relation der Grade → kontinuierliche Skala → Realität der Qualität als äußerlich vermittelte quantitative Bestimmtheit.","refs":["CH_GB18_UNTD:A13","CH_GB18_UNTD:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B07","text":"Mathematische oder numerische Darstellung → logische Prüfung ihrer immanenten Bedeutung → methodische Begrenzung von Symbol, Rechenform und mechanischer Bildung.","refs":["CH_GB18_A_15:FGS2","CH_GB18_A_15:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_21:AFM-B01","text":"Unvollständigkeit von Kontinuität und Diskretion → Bedarf einer bestimmten quantitativen Grenze.","refs":["CH_GB18_UNTD:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B02","text":"Bestimmte Grenze → Zahl als Anzahl einer Einheit → extensives Quantum.","refs":["CH_GB18_UNTD:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B03","text":"Homogenität der gezählten Einheiten → Rückkehr der Anzahl in einfache Selbstbeziehung.","refs":["CH_GB18_UNTD:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B04","text":"Einfache Grenze → Grad als intensives Quantum → Externalisierung der aufgehobenen Anzahl.","refs":["CH_GB18_UNTD:AF4","CH_GB18_UNTD:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B05","text":"Äußere Gradrelation → kontinuierliche Skala → qualitative Realität quantitativer Bestimmtheit.","refs":["CH_GB18_UNTD:AF6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B06","text":"Äußerliche Zahlform → Kritik numerischer Begriffsrepräsentation → Vorrang immanenter Beziehung und Bewegung.","refs":["CH_GB18_A_15:AF1","CH_GB18_A_15:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B07","text":"Logische Rechenschaftspflicht mathematischer Formen → methodische und pädagogische Begrenzung mechanischer Rechenpraxis.","refs":["CH_GB18_A_15:ALT3","CH_GB18_A_15:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_21:MME-01","text":"Die Differenz zwischen Geometrie und Arithmetik wird von einer bloßen Unterscheidung kontinuierlicher und diskreter Gegenstände zu einer Differenz von Bestimmtheitsweisen umgeordnet.","refs":["CH_GB18_A_14:ME1","CH_GB18_UNTD:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MME-02","text":"Die Gegenüberstellung extensiv und intensiv wird von der Gegenüberstellung diskret und kontinuierlich gelöst und auf die Ebene der quantitativen Grenze verlegt.","refs":["CH_GB18_UNTD:NX1","CH_GB18_UNTD:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MME-03","text":"Zahl wird zugleich herab- und heraufgestuft: Sie verliert den Status begrifflicher Wahrheit, gewinnt jedoch als aufgehobene Anzahl eine notwendige Funktion in der Konstitution des Grades.","refs":["CH_GB18_A_15:NX1","CH_GB18_UNTD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MME-04","text":"Die Skala wird von einem äußerlichen Messinstrument zu einer konstitutiven Relationsstruktur, ohne die kein Grad bestimmte Realität besitzt.","refs":["CH_GB18_UNTD:ME4","CH_GB18_UNTD:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MME-05","text":"Symbolische Formen werden von Quellen philosophischer Tiefe zu Gegenständen logischer Entschlüsselung und methodischer Begrenzung reklassifiziert.","refs":["CH_GB18_A_15:A8","CH_GB18_A_15:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_21:ALT-B01","text":"Surface level — Das System behandelt Raumgröße, Zahlgröße, Geometrie, Arithmetik, Rechnungsarten, extensive Anzahl, intensive Grade und mathematische Symbolformen.","refs":["CH_GB18_A_14:ALT1","CH_GB18_UNTD:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:ALT-B02","text":"Structural level — Quantitative Bestimmtheit entsteht durch die Vermittlung von Einheit und Vielheit, Grenze und Anzahl, Selbstbeziehung und äußerer Relationsstruktur.","refs":["CH_GB18_UNTD:ALT2","CH_GB18_UNTD:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:ALT-B03","text":"Metastrategic level — Das System ersetzt feste Gegenüberstellungen durch Übergänge, in denen ausgeschlossene Bestimmungen als Bedingungen des Resultats fortwirken.","refs":["CH_GB18_UNTD:ALT3","CH_GB18_UNTD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:ALT-B04","text":"Ontological / Temporal level — Der Grad existiert als ununterbrochenes Werden innerhalb einer Skala, während das Rechnen zeitliche Wiederholung und gedächtnishafte Fixierung äußerlicher Resultate bleibt.","refs":["CH_GB18_UNTD:ALT4","CH_GB18_A_14:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:ALT-B05","text":"Methodological / Performative level — Die eigene Argumentform vollzieht die Differenz zwischen äußerem Ordnen und immanenter Bewegung, indem sie mathematische Verfahren klassifiziert, aber ihre philosophische Geltung an logische Selbstrechtfertigung bindet.","refs":["CH_GB18_A_14:D9","CH_GB18_A_15:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_21:FL-01","text":"Die Architektur oszilliert zwischen der Bestimmung der Zahl als begriffsloser Äußerlichkeit und ihrer logischen Funktion als notwendiger Übergang zur intensiven Bestimmtheit.","refs":["CH_GB18_A_14:NX3","CH_GB18_UNTD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FL-02","text":"Der Grad wird zugleich als selbstbezogene einfache Grenze und als nur durch andere Grade bestimmte Einheit gefasst; diese Spannung ist konstitutiv, aber nicht vollständig aufgelöst.","refs":["CH_GB18_UNTD:A13","CH_GB18_UNTD:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FL-03","text":"Die Forderung, äußerlichem Stoff keine spekulative Innerlichkeit zuzuschreiben, steht unter Spannung zur logischen Rekonstruktion der Zahl als aufgehobener Vielheit und des Grades als qualitativer Realität.","refs":["CH_GB18_A_14:NX8","CH_GB18_UNTD:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MP-01","text":"Die Zahl mutiert am Übergang von extensiver Anzahl zu intensiver Grenze: Ihre Vielheit wird weder vernichtet noch als innere Menge bewahrt, sondern als äußere Bedingung verlagert.","refs":["CH_GB18_UNTD:D2","CH_GB18_UNTD:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MP-02","text":"Äußerlichkeit mutiert von einem Kennzeichen mechanischer Operation zu einer Bestimmung der Realität selbst, sobald die Qualität des Quantums als äußerlich vermittelte Differenz bestimmt wird.","refs":["CH_GB18_A_14:SD2","CH_GB18_UNTD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MP-03","text":"Symbolisierung mutiert von einer vorläufigen Vermittlungsform zwischen Sinnlichkeit und Denken zu einer inadäquaten Form konkreter Begriffsverhältnisse.","refs":["CH_GB18_A_15:A5","CH_GB18_A_15:A6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_21:HSI-01","text":"Realität erscheint als Feld bestimmter Grenzen, in dem keine Einheit aus sich selbst vollständig ist, weil ihre Bestimmtheit die von ihr ausgeschlossene Vielheit voraussetzt.","refs":["CH_GB18_UNTD:SNX1","CH_GB18_UNTD:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:HSI-02","text":"Das Subjekt erscheint nicht als Rechenmaschine, sondern als Instanz, deren geistige Bildung von der Fähigkeit abhängt, immanente Beziehungen und konkrete Inhalte zu erfassen.","refs":["CH_GB18_A_15:SNX3","CH_GB18_A_15:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:HSI-03","text":"Zeit erscheint gespalten zwischen äußerlicher Wiederholung diskreter Operationen und dem unteilbaren Fließen intensiver Veränderung innerhalb einer kontinuierlichen Skala.","refs":["CH_GB18_UNTD:NX7","CH_GB18_A_14:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:HSI-04","text":"Philosophischer Kampf besteht in der Navigation zwischen legitimer Bestimmung äußerlicher Formen und ihrer illegitimen Erhebung zur Selbstbewegung des Begriffs.","refs":["CH_GB18_A_14:DNX3","CH_GB18_A_15:NX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_21:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die globale Bewegung von Zahl als äußerlicher Anzahl über ihre Aufhebung im Grad bis zur Skala intensiver Bestimmtheit zu rekonstruieren.","refs":["CH_GB18_UNTD:MRT1","CH_GB18_UNTD:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MRT-B02","text":"Die Architektur ist kohärent, sofern Aufhebung als bewahrende Negation verstanden wird und die äußere Vielheit nicht als bloßes Residuum, sondern als aktive Bestimmungsbedingung des Grades gilt.","refs":["CH_GB18_UNTD:MRT5","CH_GB18_UNTD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MRT-B03","text":"Unterbestimmt bleibt, wodurch die äußerliche Vielheit der Grade selbst als Totalität begrenzt, gegliedert oder normiert wird.","refs":["CH_GB18_UNTD:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MRT-B04","text":"Die stärkste Rekonstruktionsstelle ist die Umwandlung eines scheinbaren Gegensatzes in eine Vermittlung: Die Anzahl verschwindet im Grad nicht, sondern kehrt als dessen äußere Realität wieder.","refs":["CH_GB18_UNTD:MRT3","CH_GB18_UNTD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MRT-B05","text":"Ein unverzichtbarer Rest axiomatischer Spannung bleibt zwischen der Zurückweisung äußerlicher Zahlformen als begriffslos und ihrer logischen Funktion innerhalb der qualitativen Selbsttransformation des Quantums.","refs":["CH_GB18_A_15:MRT5","CH_GB18_A_14:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121440440792Z_d4297eda","language_code":"en","language_name":"English","title":"Chapters 61–63","source_sha256":"c3d83bdc2f20317d9cedd17e3c559dd5c0ca703d15aadf56ff720880e0fc1785","sha256":"eab3ba976ad85b4eadbc4c6773cecded91a5dbca3c893225f108aef9db5862f2","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:14:40.442739+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_21:AS-01","text":"The cluster architecture determines number as the necessary form of quantitative limitation, whose externality, however, coincides neither with conceptual inwardness nor with the full reality of quantitative determinacy.","refs":["CH_GB18_A_14:AS1","CH_GB18_UNTD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-02","text":"The argument separates external counting, calculating, and symbolizing from the logical movement in which number sublates its multiplicity and passes, as intensive limit, into a relational structure.","refs":["CH_GB18_A_14:A5","CH_GB18_UNTD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-03","text":"The external determinacy of number is not simply discarded, but functionally split: as a form of calculation, it remains mechanical and conceptless; as sublated number, it becomes the condition of degree.","refs":["CH_GB18_A_15:A9","CH_GB18_UNTD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-04","text":"Degree enacts the reversal whereby the numerical multiplicity excluded from it continues to operate outside itself as the condition of its determinate simplicity.","refs":["CH_GB18_UNTD:SD2","CH_GB18_UNTD:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-05","text":"The movement proceeds recursively from continuity and discreteness through number and number-of-units to the simple limit, and thence through external degree-relation back to the continuity of a scale.","refs":["CH_GB18_UNTD:D1","CH_GB18_UNTD:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-06","text":"The critique of mathematical conceptual representation generalizes the difference between formal exactness and conceptual truth: with increasing concreteness, number loses its adequacy of representation.","refs":["CH_GB18_A_15:SD2","CH_GB18_A_15:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-07","text":"The method simultaneously requires that external material not be speculatively internalized and that mathematical forms be philosophically legitimized only through their logical translation.","refs":["CH_GB18_A_14:AS6","CH_GB18_A_15:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AS-08","text":"The closure does not consist in a rejection of mathematics, but in its subordination to a logic of determinative limit, immanent relation, and non-mechanical cultivation.","refs":["CH_GB18_A_14:SD5","CH_GB18_A_15:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_21:GA-01","text":"[Persistent] Determinate quantum requires the mediation of continuity, discreteness, unity, and limit; none of these determinations alone produces complete quantitative determinacy.","refs":["CH_GB18_UNTD:D1","CH_GB18_UNTD:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-02","text":"[Mutating] Number, as counted and calculated number-of-units, is external aggregation, but as quantitative limit becomes sublated multiplicity, which continues to operate in degree.","refs":["CH_GB18_A_14:A4","CH_GB18_UNTD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-03","text":"[Persistent] Conceptual truth exists only where determinations appear as immanent relations and movements of their object, not as externally posited unities or signs.","refs":["CH_GB18_A_15:A3","CH_GB18_A_15:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-04","text":"[Emergent] Externality has two non-equatable functions: it marks the conceptlessness of arithmetical operations and at the same time forms the real condition of mediation of intensive determinacy.","refs":["CH_GB18_A_15:A2","CH_GB18_UNTD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-05","text":"[Attractor] Limit is the central figure of mediation because it determines quantum, transforms the number-of-units into simplicity, and refers every intensive unity to excluded multiplicity.","refs":["CH_GB18_UNTD:A1","CH_GB18_UNTD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-06","text":"[Emergent] Degree is not an inner atomic magnitude, but a simple limit whose reality consists solely in essential relation to other degrees within a continuous scale.","refs":["CH_GB18_UNTD:AS5","CH_GB18_UNTD:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-07","text":"[Mutating] Number historically mediates between sensibility and thinking, but with the increasing concreteness of thought loses its capacity to express its inner movement.","refs":["CH_GB18_A_15:A5","CH_GB18_A_15:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-08","text":"[Terminal] Mathematical categories acquire no philosophical sense from their technical use, but only from logical determination, translation, and justification.","refs":["CH_GB18_A_15:A7","CH_GB18_A_15:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-09","text":"[Persistent] True synthesis requires an identity differentiated within itself; mere counting, adding, or numerical naming does not fulfill this condition.","refs":["CH_GB18_A_14:A13","CH_GB18_A_15:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GA-10","text":"[Terminal] Mechanically reproducible computational ability can develop reflective abstraction, but cannot replace the cultivation of the concept or claim precedence in spiritual education.","refs":["CH_GB18_A_15:A10","CH_GB18_A_15:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_21:RMD-01","text":"Number retains its stable identity as a determination of quantity, but mutates from externally posited number-of-units into a multiplicity sublated and externalized in degree.","refs":["CH_GB18_A_15:A1","CH_GB18_UNTD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RMD-02","text":"Externality recurs functionally, yet changes its valence: as a form of calculation it exhibits conceptlessness; as degree-relation it produces qualitative reality.","refs":["CH_GB18_A_14:SD2","CH_GB18_UNTD:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RMD-03","text":"Continuity and discreteness initially appear as incomplete abstractions, are then mediated in number, and finally recur as the uninterrupted scale of intensive differences.","refs":["CH_GB18_UNTD:A3","CH_GB18_UNTD:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RMD-04","text":"The mathematical form shifts from a possible historical bridge to thinking to a limiting form that loses its representational power in more concrete conceptual relations.","refs":["CH_GB18_A_15:AS3","CH_GB18_A_15:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RMD-05","text":"The sequence of operations—addition, subtraction, multiplication, division, power, and root—remains locally systematic, but at the cluster level is absorbed into the more general difference between external order and immanent self-movement.","refs":["CH_GB18_A_14:A11","CH_GB18_A_14:NX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_21:CGD-01","text":"The specific derivation of individual modes of calculation from equality, inequality, unity, and number-of-units remains a local structure of the arithmetical order of operations.","refs":["CH_GB18_A_14:A10","CH_GB18_A_14:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:CGD-02","text":"The claim of a final numerical completion in the square remains a local thesis of limit and does not bear the global architecture of the transformation of number-of-units into degree.","refs":["CH_GB18_A_14:MRT3","CH_GB18_A_14:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:CGD-03","text":"The rejection of individual Kantian examples remains local, while the criterion of an inwardly differentiated identity rises to a cluster-wide test of synthesis, symbolization, and conceptual movement.","refs":["CH_GB18_A_14:AS5","CH_GB18_A_14:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:CGD-04","text":"The historical examples of numerical philosophy remain exemplary, while their systematic function globally consists in making visible the mediating position and representational limit of number.","refs":["CH_GB18_A_15:D1","CH_GB18_A_15:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:CGD-05","text":"The pedagogical critique is not an independent theory of education, but a consequence of the global difference between mechanical repetition and immanent conceptual cultivation.","refs":["CH_GB18_A_15:D5","CH_GB18_A_15:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_21:GNX-01","text":"Excluded is the equation of formal exactness, numerical determinacy, and conceptual truth.","refs":["CH_GB18_A_15:DNX1","CH_GB18_A_15:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GNX-02","text":"Excluded is the assumption that externally aggregated unities could generate inner self-determination through repetition, memory, or technical reproducibility.","refs":["CH_GB18_A_14:SNX1","CH_GB18_A_15:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GNX-03","text":"Excluded is a concept of intensity as an isolated magnitude enclosed within itself; every degree remains determined by excluded multiplicity and other degrees.","refs":["CH_GB18_UNTD:NX6","CH_GB18_UNTD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:GNX-04","text":"Excluded is the immediate transfer of speculative self-movement to every object; the sphere of the material limits the form of its philosophical representation.","refs":["CH_GB18_A_14:DNX3","CH_GB18_A_14:NX8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_21:DBN-01","text":"The system presupposes that there is no unified quantitative science in which space, number, measure, degree, and concept would be merely coequal variants of a single form of determination.","refs":["CH_GB18_A_14:DNX1","CH_GB18_UNTD:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:DBN-02","text":"The system presupposes that no arithmetical operation possesses an inner necessity from itself insofar as it merely performs external positing, counting, and connecting.","refs":["CH_GB18_A_14:DNX2","CH_GB18_A_15:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:DBN-03","text":"The system presupposes that no external sign-relation can preserve unchanged the self-relation and movement of a concrete concept.","refs":["CH_GB18_A_15:DNX2","CH_GB18_A_15:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:DBN-04","text":"The system presupposes that quantitative determinacy cannot remain purely quantitative, because its external mediation appears in degree as qualitative reality.","refs":["CH_GB18_UNTD:DNX4","CH_GB18_UNTD:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_21:BSA-01","text":"Unmediated self-identity is impossible, because every determinate unity preserves the multiplicity excluded by it as the condition of its own determinacy.","refs":["CH_GB18_UNTD:SNX1","CH_GB18_UNTD:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:BSA-02","text":"Complete conceptual representation through a medium external to the concept is impossible, because its discrete form disintegrates the constitutive relation and movement of thought.","refs":["CH_GB18_A_15:SNX1","CH_GB18_A_15:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:BSA-03","text":"A final mathematical formalization that presents higher quantitative forms as higher conceptual truth is excluded.","refs":["CH_GB18_A_14:SNX3","CH_GB18_A_15:DNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_21:XD-01","text":"The externality of number must be divided into two levels: as external calculation, it remains conceptless; as externalized determinacy, it becomes the condition of an intensive and qualitative reality. ; Trace Type — Tension.","refs":["CL_GB18_21:GA-02","CL_GB18_21:GA-04","CH_GB18_A_15:A2","CH_GB18_UNTD:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:XD-02","text":"The limit of numerical conceptual representation is not merely semiotic; it follows from the fact that concrete concepts require inner relation, whereas degree itself is determined only through external relation. ; Trace Type — Composite.","refs":["CL_GB18_21:GA-03","CL_GB18_21:GA-06","CH_GB18_A_15:D2","CH_GB18_UNTD:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:XD-03","text":"Philosophical method must distinguish between a legitimate logical reconstruction of quantity and an illegitimate speculative internalization of external procedures. ; Trace Type — Composite.","refs":["CL_GB18_21:GA-04","CL_GB18_21:GA-08","CH_GB18_A_14:SD5","CH_GB18_A_15:FGS4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:XD-04","text":"True synthesis becomes the rule of examination for the transition from number to degree: it lies not in mere addition, but in the preserving negation through which multiplicity persists as the relational condition of simple limit. ; Trace Type — Composite.","refs":["CL_GB18_21:GA-05","CL_GB18_21:GA-09","CH_GB18_A_14:A13","CH_GB18_UNTD:MRT5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:XD-05","text":"The critique of arithmetic instruction gains its significance only insofar as it directs mechanical reproducibility not merely against cultivation, but against every confusion of external procedural certainty with immanent conceptual cultivation. ; Trace Type — Composite.","refs":["CL_GB18_21:GA-03","CL_GB18_21:GA-10","CH_GB18_A_15:A10","CH_GB18_A_15:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_21:BSD-01","text":"The cluster produces an ontology of determinate limit, in which reality consists not through isolated unities, but through the mediation of self-relation, excluded multiplicity, and external relation.","refs":["CL_GB18_21:GA-05","CL_GB18_21:GA-06","CH_GB18_UNTD:D5","CH_GB18_UNTD:SNX1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:BSD-02","text":"Quantity becomes visible as a field of transition in which external determinacy is not annihilated, but transformed into the qualitative reality of degree.","refs":["CL_GB18_21:GA-02","CL_GB18_21:GA-04","CH_GB18_UNTD:D6","CH_GB18_UNTD:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:BSD-03","text":"Cognition is reordered: technical mastery of a system of signs grounds neither its philosophical truth nor its pedagogical precedence.","refs":["CL_GB18_21:GA-08","CL_GB18_21:GA-10","CH_GB18_A_15:SD3","CH_GB18_A_15:SNX3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:BSD-04","text":"Temporality divides into mechanical repetition of counting and indivisible becoming of intensity; only the second form bears the reality of determinate degree.","refs":["CL_GB18_21:GA-02","CL_GB18_21:GA-06","CH_GB18_A_14:D4","CH_GB18_UNTD:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_21:BSD-05","text":"The global method is not anti-mathematical, but assigns mathematical procedures to their peculiar sphere while at the same time refusing them the status of ultimate philosophical authority.","refs":["CL_GB18_21:GA-08","CL_GB18_21:GA-09","CH_GB18_A_14:AS6","CH_GB18_A_15:NX5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_21:RLE-01","text":"Continuity and discreteness, as incomplete abstractions, generate the need for number; number sublates its multiplicity into unity; unity, as degree, is determined by external multiplicity; the scale of degrees restores continuity.","refs":["CH_GB18_UNTD:FGS1","CH_GB18_UNTD:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RLE-02","text":"Number becomes a recursive machine because it simultaneously posits its own multiplicity, sublates it into unity, and allows it to recur as the excluded condition of intensity.","refs":["CH_GB18_UNTD:A8","CH_GB18_UNTD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RLE-03","text":"The representational loop proceeds from numerical symbolization through logical examination to the supersession of the particular mathematical form; every successful understanding deprives the formula of its autonomous authority.","refs":["CH_GB18_A_15:D4","CH_GB18_A_15:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RLE-04","text":"The concept of limit functions as an attractor because it draws spatial magnitude, number, extensive quantum, degree, scale, and quality into a single architecture of mediation.","refs":["CH_GB18_A_14:AS2","CH_GB18_UNTD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:RLE-05","text":"The recurrence of externality marks not a standstill, but a phase transition: from deficient calculating operation, it becomes the constitutive external relation of intensive determinacy.","refs":["CH_GB18_A_15:A9","CH_GB18_UNTD:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_21:FGS-B01","text":"Continuity or discreteness without limit → incomplete abstraction of quantum.","refs":["CH_GB18_UNTD:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B02","text":"Limit as number-of-units of equal unities → extensive quantum and number as determinate multiplicity.","refs":["CH_GB18_UNTD:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B03","text":"Equality of numerical unities → sublation of counted multiplicity into self-related simple unity.","refs":["CH_GB18_UNTD:AS3","CH_GB18_UNTD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B04","text":"Simple limit as sublated number-of-units → degree as intensive quantum.","refs":["CH_GB18_UNTD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B05","text":"Exclusion of number-of-units from degree → external multiplicity as the determining ground of a simple intensity.","refs":["CH_GB18_UNTD:FGS5","CH_GB18_UNTD:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B06","text":"Essential relation of degrees → continuous scale → reality of quality as externally mediated quantitative determinacy.","refs":["CH_GB18_UNTD:A13","CH_GB18_UNTD:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FGS-B07","text":"Mathematical or numerical representation → logical examination of its immanent significance → methodological limitation of symbol, form of calculation, and mechanical cultivation.","refs":["CH_GB18_A_15:FGS2","CH_GB18_A_15:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_21:AFM-B01","text":"Incompleteness of continuity and discreteness → need for a determinate quantitative limit.","refs":["CH_GB18_UNTD:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B02","text":"Determinate limit → number as number-of-units of a unity → extensive quantum.","refs":["CH_GB18_UNTD:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B03","text":"Homogeneity of the counted unities → return of number-of-units into simple self-relation.","refs":["CH_GB18_UNTD:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B04","text":"Simple limit → degree as intensive quantum → externalization of the sublated number-of-units.","refs":["CH_GB18_UNTD:AF4","CH_GB18_UNTD:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B05","text":"External degree-relation → continuous scale → qualitative reality of quantitative determinacy.","refs":["CH_GB18_UNTD:AF6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B06","text":"External form of number → critique of numerical conceptual representation → precedence of immanent relation and movement.","refs":["CH_GB18_A_15:AF1","CH_GB18_A_15:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:AFM-B07","text":"Logical accountability of mathematical forms → methodological and pedagogical limitation of mechanical calculating practice.","refs":["CH_GB18_A_15:ALT3","CH_GB18_A_15:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_21:MME-01","text":"The difference between geometry and arithmetic is reordered from a mere distinction between continuous and discrete objects into a difference of modes of determinacy.","refs":["CH_GB18_A_14:ME1","CH_GB18_UNTD:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MME-02","text":"The opposition of extensive and intensive is detached from the opposition of discrete and continuous and transferred to the level of quantitative limit.","refs":["CH_GB18_UNTD:NX1","CH_GB18_UNTD:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MME-03","text":"Number is simultaneously downgraded and upgraded: it loses the status of conceptual truth, yet as sublated number-of-units gains a necessary function in the constitution of degree.","refs":["CH_GB18_A_15:NX1","CH_GB18_UNTD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MME-04","text":"The scale is transformed from an external instrument of measurement into a constitutive relational structure without which no degree possesses determinate reality.","refs":["CH_GB18_UNTD:ME4","CH_GB18_UNTD:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MME-05","text":"Symbolic forms are reclassified from sources of philosophical depth into objects of logical decipherment and methodological limitation.","refs":["CH_GB18_A_15:A8","CH_GB18_A_15:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_21:ALT-B01","text":"Surface level — The system treats spatial magnitude, numerical magnitude, geometry, arithmetic, modes of calculation, extensive number-of-units, intensive degrees, and mathematical symbolic forms.","refs":["CH_GB18_A_14:ALT1","CH_GB18_UNTD:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:ALT-B02","text":"Structural level — Quantitative determinacy arises through the mediation of unity and multiplicity, limit and number-of-units, self-relation and external relational structure.","refs":["CH_GB18_UNTD:ALT2","CH_GB18_UNTD:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:ALT-B03","text":"Metastrategic level — The system replaces fixed oppositions with transitions in which excluded determinations continue to operate as conditions of the result.","refs":["CH_GB18_UNTD:ALT3","CH_GB18_UNTD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:ALT-B04","text":"Ontological / Temporal level — Degree exists as uninterrupted becoming within a scale, while calculation remains temporal repetition and mnemonic fixation of external results.","refs":["CH_GB18_UNTD:ALT4","CH_GB18_A_14:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:ALT-B05","text":"Methodological / Performative level — Its own argumentative form enacts the difference between external ordering and immanent movement by classifying mathematical procedures, while binding their philosophical validity to logical self-justification.","refs":["CH_GB18_A_14:D9","CH_GB18_A_15:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_21:FL-01","text":"The architecture oscillates between the determination of number as conceptless externality and its logical function as a necessary transition to intensive determinacy.","refs":["CH_GB18_A_14:NX3","CH_GB18_UNTD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FL-02","text":"Degree is conceived both as self-related simple limit and as a unity determined only through other degrees; this tension is constitutive, but not fully resolved.","refs":["CH_GB18_UNTD:A13","CH_GB18_UNTD:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:FL-03","text":"The demand not to ascribe speculative inwardness to external material stands in tension with the logical reconstruction of number as sublated multiplicity and of degree as qualitative reality.","refs":["CH_GB18_A_14:NX8","CH_GB18_UNTD:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MP-01","text":"Number mutates at the transition from extensive number-of-units to intensive limit: its multiplicity is neither annihilated nor preserved as an inner set, but displaced as an external condition.","refs":["CH_GB18_UNTD:D2","CH_GB18_UNTD:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MP-02","text":"Externality mutates from a mark of mechanical operation into a determination of reality itself, once the quality of quantum is determined as externally mediated difference.","refs":["CH_GB18_A_14:SD2","CH_GB18_UNTD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MP-03","text":"Symbolization mutates from a provisional mediating form between sensibility and thinking into an inadequate form of concrete conceptual relations.","refs":["CH_GB18_A_15:A5","CH_GB18_A_15:A6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_21:HSI-01","text":"Reality appears as a field of determinate limits in which no unity is complete from itself, because its determinacy presupposes the multiplicity excluded by it.","refs":["CH_GB18_UNTD:SNX1","CH_GB18_UNTD:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:HSI-02","text":"The subject appears not as a calculating machine, but as an instance whose spiritual cultivation depends on the capacity to grasp immanent relations and concrete contents.","refs":["CH_GB18_A_15:SNX3","CH_GB18_A_15:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:HSI-03","text":"Time appears divided between the external repetition of discrete operations and the indivisible flow of intensive change within a continuous scale.","refs":["CH_GB18_UNTD:NX7","CH_GB18_A_14:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:HSI-04","text":"Philosophical struggle consists in navigating between the legitimate determination of external forms and their illegitimate elevation into the self-movement of the concept.","refs":["CH_GB18_A_14:DNX3","CH_GB18_A_15:NX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_21:MRT-B01","text":"The extracted axioms suffice to reconstruct the global movement from number as external number-of-units through its sublation in degree to the scale of intensive determinacy.","refs":["CH_GB18_UNTD:MRT1","CH_GB18_UNTD:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MRT-B02","text":"The architecture is coherent insofar as sublation is understood as preserving negation and external multiplicity is regarded not as a mere residue, but as an active condition of determination of degree.","refs":["CH_GB18_UNTD:MRT5","CH_GB18_UNTD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MRT-B03","text":"What remains underdetermined is whereby the external multiplicity of degrees itself is limited, articulated, or normed as a totality.","refs":["CH_GB18_UNTD:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MRT-B04","text":"The strongest point of reconstruction is the transformation of an apparent opposition into a mediation: number-of-units does not disappear in degree, but returns as its external reality.","refs":["CH_GB18_UNTD:MRT3","CH_GB18_UNTD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_21:MRT-B05","text":"An indispensable remainder of axiomatic tension persists between the rejection of external numerical forms as conceptless and their logical function within the qualitative self-transformation of quantum.","refs":["CH_GB18_A_15:MRT5","CH_GB18_A_14:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_21@R001","source_variant_id":"canonical:CL_GB18_21:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 61–63","context":"Anmerkung 1. · Anmerkung 2. · a. Unterschied derselben."},"title_language_code":"en"},{"id":"CL_GB18_22","layer":"CL","title":"Chapters 64–66","order":22,"parents":["CH_GB18_BITD","CH_GB18_A_16","CH_GB18_A_17"],"revision":"CL_GB18_22@R001","sha256":"9d2703468ffe0dc88248b8005a76bda60f18f7be85e31490f4dee205f2fd2646","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_22:AS-01","text":"Das Problem besteht darin, quantitative Bestimmtheit so zu rekonstruieren, dass Grad, Anzahl, Einheit und Vielheit weder als getrennte Gegenstände noch als bloß äußerliche Relationen behandelt werden.","refs":["CH_GB18_BITD:AS1","CH_GB18_A_16:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-02","text":"Die extensive und die intensive Größe werden als zwei wechselnde Setzungsweisen desselben Quantums bestimmt: Die Anzahl ist jeweils zugleich im Grad enthalten und außerhalb seiner als Bedingung seiner Bestimmtheit wirksam.","refs":["CH_GB18_BITD:AS3","CH_GB18_BITD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-03","text":"Die dynamische Umdeutung äußerlicher Vielheit in Kraftäußerung korrigiert die mechanische Trennung, kann aber die extensive Vermittlung nicht eliminieren, weil Kraft nur in ihrer Äußerung bestimmt ist.","refs":["CH_GB18_A_16:AS2","CH_GB18_A_16:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-04","text":"Die quantitative Doppelbestimmung erzeugt keine reine Einheit, sondern eine relationale Einheit, deren Intensität durch Reihe, Skala, Wirkung und extensive Reichweite bestimmt bleibt.","refs":["CH_GB18_A_16:A8","CH_GB18_A_16:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-05","text":"Die negative Identität der quantitativen Unterschiede setzt ein qualitatives Etwas frei, das Quantum besitzt, ohne mit seiner quantitativen Bestimmung zusammenzufallen.","refs":["CH_GB18_BITD:AS7","CH_GB18_BITD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-06","text":"Die Anwendung dieser Logik auf die Seele zeigt die Grenze der Quantifizierung: Als unmittelbar Seiendes kann sie intensive Grade und deren Verminderung tragen, doch damit bleibt sie ein Seelending.","refs":["CH_GB18_A_17:AS2","CH_GB18_A_17:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-07","text":"Der Geist wird nicht durch eine höhere oder reinere Intensität bestimmt, sondern durch die Aufhebung der Kategorien des unmittelbaren Seins einschließlich des Quantums überhaupt.","refs":["CH_GB18_A_17:A9","CH_GB18_A_17:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-08","text":"Die Bewegung ist spiralförmig: quantitative Vermittlung erzeugt qualitative Bestimmtheit, deren geistige Form die Kategorien zurückweist, durch die die Vermittlung zunächst verständlich wurde.","refs":["CH_GB18_BITD:FGS5","CH_GB18_A_17:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_22:GA-01","text":"[Persistent] Extensive und intensive Größe sind keine getrennten Arten von Quantität, sondern unterschiedliche Stellungnahmen derselben Anzahl zu Einheit, Vielheit und Außersichsein.","refs":["CH_GB18_BITD:A7","CH_GB18_A_16:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-02","text":"[Persistent] Der Grad ist keine unmittelbare Einfachheit, sondern eine durch andere Grade, Reihe, Skala und eigene Anzahl vermittelte Einheit.","refs":["CH_GB18_BITD:A3","CH_GB18_A_16:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-03","text":"[Mutating] Das Außereinander der Vielheit wird zunächst als quantitative Äußerlichkeit, dann als notwendige Äußerung von Kraft und schließlich als unzulässige Kategorie für den Geist bestimmt.","refs":["CH_GB18_BITD:AS6","CH_GB18_A_16:A3","CH_GB18_A_17:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-04","text":"[Persistent] Keine Intensität ist ohne extensive Vermittlung bestimmbar, weil jede innere Bestimmung nur durch Wirkung, Reichweite, Reihe oder Anzahl konkrete Geltung erhält.","refs":["CH_GB18_A_16:A8","CH_GB18_A_16:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-05","text":"[Emergent] Die Identität von Einheit und Vielheit ist produktiv: Durch die Negation ihrer quantitativen Differenz entsteht ein qualitatives Etwas, das seine Quantität besitzt, aber nicht in ihr aufgeht.","refs":["CH_GB18_BITD:A11","CH_GB18_BITD:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-06","text":"[Mutating] Die quantitative Kritik der Seele ist innerhalb der Bestimmung eines unmittelbar seienden Substrats gültig, verliert jedoch ihre Reichweite, sobald Geist als nicht-dingliches Sein gefasst wird.","refs":["CH_GB18_A_17:D4","CH_GB18_A_17:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-07","text":"[Terminal] Geistige Bestimmung verlangt die Entfernung des Quantums überhaupt und verlagert die Erklärung von Beharrlichkeit auf die Hervorbringung von Dasein, Bewusstsein und Endlichkeit.","refs":["CH_GB18_A_17:AS5","CH_GB18_A_17:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-08","text":"[Attractor] Die gesamte Architektur konvergiert auf eine nicht-dingliche Bestimmung, in der vermittelte Endlichkeit weder als Eigenschaft eines Substrats noch als bloß graduelle Abschwächung begriffen werden kann.","refs":["CH_GB18_A_17:A11","CH_GB18_A_17:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_22:RMD-01","text":"Die Zahl bleibt als Einheit-und-Anzahl-Struktur identisch, mutiert aber von der Bestimmung des Quantums zur Vermittlung, die jede isolierte Intensität widerlegt.","refs":["CH_GB18_A_16:A7","CH_GB18_BITD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RMD-02","text":"Der Grad wiederholt sich funktional als relationale quantitative Einheit, wird jedoch im Übergang zum Geist nicht intensiviert, sondern kategorial suspendiert.","refs":["CH_GB18_BITD:A4","CH_GB18_A_17:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RMD-03","text":"Kraft und Äußerung übernehmen die strukturelle Rolle von Intensität und Extensität: Sie bestätigen deren Untrennbarkeit, werden aber nicht zur letzten ontologischen Erklärung.","refs":["CH_GB18_A_16:A3","CH_GB18_A_16:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RMD-04","text":"Das qualitative Etwas absorbiert die quantitative Differenz als besessene, aber gleichgültige Bestimmung; der Geist überschreitet anschließend auch diese Form eines vorausgesetzten Trägers.","refs":["CH_GB18_BITD:A12","CH_GB18_A_17:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_22:CGD-01","text":"Die konkrete Beschreibung des Grades als Ausschluss benachbarter Grade bleibt lokale quantitative Mechanik; auf Clusterebene wird sie zur allgemeinen These, dass Bestimmtheit nur relational existiert.","refs":["CH_GB18_BITD:A5","CH_GB18_A_16:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:CGD-02","text":"Beispiele wie Druck, Temperatur, Ton, Farbe und geistige Wirkung bleiben lokale Instanziierungen; skalierend ist allein die Regel, dass Intensität durch extensive Wirksamkeit lesbar wird.","refs":["CH_GB18_A_16:D7","CH_GB18_A_16:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:CGD-03","text":"Die mögliche Auflösung der Seele in nichts bleibt eine Konsequenz der Quantifizierung eines Seelendinges; auf Clusterebene fungiert sie als Grenztest für die Unangemessenheit dinglicher Geistontologie.","refs":["CH_GB18_A_17:D3","CH_GB18_A_17:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:CGD-04","text":"Die übergeordnete Struktur besteht nicht in einer Verallgemeinerung des Quantums, sondern in seiner Selbstbegrenzung: Seine Vermittlungslogik erzeugt die Bedingungen, unter denen Geist nicht mehr quantifizierbar ist.","refs":["CH_GB18_A_17:AS5","CH_GB18_A_17:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_22:GNX-01","text":"Ausgeschlossen ist eine Ontologie getrennter extensiver und intensiver Gegenstandsarten; beide Pole sind nur abstrahierte Formen derselben Bestimmtheit.","refs":["CH_GB18_BITD:NX6","CH_GB18_A_16:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GNX-02","text":"Ausgeschlossen ist sowohl reine Innerlichkeit ohne Äußerung als auch reine Äußerlichkeit ohne innere Bestimmung; jede Seite existiert nur in ihrer Vermittlung mit der anderen.","refs":["CH_GB18_A_16:DNX3","CH_GB18_A_16:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GNX-03","text":"Ausgeschlossen ist ein qualitatives Substrat, das der quantitativen Vermittlung äußerlich vorausläge oder durch sie vollständig erschöpft würde.","refs":["CH_GB18_BITD:DNX5","CH_GB18_BITD:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GNX-04","text":"Ausgeschlossen ist die Übertragung quantitativer Kategorien auf Geist, weil diese Übertragung dessen nicht-dingliche Seinsweise in ein unmittelbar vorhandenes Etwas zurückverwandelt.","refs":["CH_GB18_A_17:NX5","CH_GB18_A_17:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_22:DBN-01","text":"Damit die Architektur trägt, darf keine Bestimmtheit als unmittelbar gegeben gelten: weder Grad, Einheit, Kraft, Qualität, Seele noch Geist besitzen ihre Bedeutung außerhalb einer je verschiedenen Vermittlungsordnung.","refs":["CH_GB18_BITD:NX2","CH_GB18_A_16:NX4","CH_GB18_A_17:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:DBN-02","text":"Unzulässig ist eine Schlussform, die aus der Aufhebung einer quantitativen Bestimmung unmittelbar eine ontologische Befreiung ableitet; der Übergang vom Seelending zum Geist verlangt einen Wechsel des Gegenstandsbereichs.","refs":["CH_GB18_A_17:D6","CH_GB18_A_17:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:DBN-03","text":"Das System disqualifiziert jede Theorie, die Endlichkeit als bloße Verminderung eines ursprünglichen Bestandes erklärt, weil sie Geist erneut als graduell abschwächbares Ding voraussetzt.","refs":["CH_GB18_A_17:A6","CH_GB18_A_17:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_22:BSA-01","text":"Nicht verfügbar ist ein letzter Standpunkt, von dem Einheit, Vielheit, Qualität und Geist als unabhängig vorhandene positive Wesenheiten bestimmt werden könnten.","refs":["CH_GB18_BITD:SNX3","CH_GB18_A_17:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:BSA-02","text":"Die tiefste ausgeschlossene Möglichkeit ist eine Realität, in der Geist durch dieselben Kategorien erklärbar wäre, durch die quantitative Dinge, Kräfte und Seelenobjekte bestimmt werden.","refs":["CH_GB18_A_17:SNX1","CH_GB18_A_17:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_22:XD-01","text":"Die wechselseitige Bestimmung von Intensität und Extensität verhindert, dass der Übergang von Quantität zu Qualität als Flucht aus der Vermittlung verstanden wird; Qualität ist vielmehr deren negative Reorganisation.","refs":["CL_GB18_22:GA-01","CL_GB18_22:GA-05","CH_GB18_BITD:SD3","CH_GB18_A_16:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_22:XD-02","text":"Die dynamische Sprache von Kraft und Äußerung bestätigt die Doppelbestimmung des Quantums, zeigt zugleich aber, dass ein bloß dynamisches Modell die ontologische Differenz des Geistes nicht leisten kann.","refs":["CL_GB18_22:GA-03","CL_GB18_22:GA-07","CH_GB18_A_16:SD4","CH_GB18_A_17:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_22:XD-03","text":"Die quantitative Widerlegung der Seelenbeharrlichkeit ist keine Bestimmung des geistigen Seins, sondern ein negatives Resultat, das die Substanzform des Seelendinges erschüttert.","refs":["CL_GB18_22:GA-06","CL_GB18_22:GA-08","CH_GB18_A_17:D4","CH_GB18_A_17:DNX1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_22:XD-04","text":"Die Entfernung des Quantums vom Geist ist keine Leugnung von Endlichkeit, sondern die Forderung, Endlichkeit genetisch und nicht als messbare Abschwächung zu erklären.","refs":["CL_GB18_22:GA-07","CL_GB18_22:GA-08","CH_GB18_A_17:FGS4","CH_GB18_A_17:ME5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_22:BSD-01","text":"Realität wird als gestufte Ordnung von Vermittlungen reorganisiert: Quantität bestimmt sich durch ihr Anderssein, Qualität durch negative Identität, und Geist durch die Aufhebung der Kategorien dieser beiden Formen.","refs":["CH_GB18_BITD:A13","CH_GB18_BITD:FGS5","CH_GB18_A_17:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:BSD-02","text":"Das Subjekt zerfällt in zwei inkompatible Figuren: als Seele ist es ein quantitativ behandelbares einfaches Substrat; als Geist ist es die nicht-dingliche Quelle der zu erklärenden Endlichkeit.","refs":["CH_GB18_A_17:A1","CH_GB18_A_17:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:BSD-03","text":"Kausalität verschiebt sich von der linearen Hervorbringung äußerer Wirkungen durch innere Kräfte zu einer reziproken Bestimmung, die beim Geist in eine genetische Erklärung ohne Dingursache übergehen muss.","refs":["CH_GB18_A_16:A10","CH_GB18_A_17:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:BSD-04","text":"Die Architektur erzeugt eine Skala von ontologischer Geltung: Quantitative Kategorien sind nicht falsch, aber nur innerhalb der Sphäre unmittelbaren Seins legitim und für Geist terminal unzureichend.","refs":["CH_GB18_A_17:NX4","CH_GB18_A_17:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_22:RLE-01","text":"Die zentrale Schleife führt von Vielheit zu Einheit, von Einheit über eigene Anzahl zurück zur Vielheit und von deren negativer Identität zum qualitativen Etwas.","refs":["CH_GB18_BITD:AS6","CH_GB18_BITD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RLE-02","text":"Eine zweite Schleife transformiert innere Kraft in äußere Äußerung und liest die Äußerung wiederum als Nachweis intensiver Bestimmung, ohne einen der beiden Pole zu verselbständigen.","refs":["CH_GB18_A_16:A4","CH_GB18_A_16:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RLE-03","text":"Der Eskalationspfad verläuft von quantitativer Vermittlung über qualitative Trägerschaft zur kategorialen Selbstaufhebung des Quantums im Begriff des Geistes.","refs":["CH_GB18_BITD:D7","CH_GB18_A_17:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RLE-04","text":"Der Attraktor ist die nicht-dingliche Geistnatur, an der alle früheren Bestimmungen geprüft werden: Sie dürfen als vermittelte Formen gelten, aber nicht als letzte Prädikate des Geistes.","refs":["CH_GB18_A_17:A8","CH_GB18_A_17:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_22:FGS-B01","text":"Unterscheidung von extensiv und intensiv → Kritik getrennter Quantitätsarten → Rückführung auf dieselbe Anzahl in verschiedener Stellung.","refs":["CH_GB18_BITD:ME1","CH_GB18_A_16:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:FGS-B02","text":"Anzahl und Einheit → relationale Bestimmung des Grades → Ausschluss anderer Grade und eigene Anzahl als Doppelbedingung.","refs":["CH_GB18_BITD:D1","CH_GB18_BITD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:FGS-B03","text":"Intensive Einheit ↔ extensive Wirkung → Kraft ↔ Äußerung → universale Doppelbestimmung konkreter Größen.","refs":["CH_GB18_A_16:D6","CH_GB18_A_16:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:FGS-B04","text":"Negative Identität quantitativer Unterschiede → qualitatives Etwas mit Quantum → Begrenzung jeder rein quantitativen Ontologie.","refs":["CH_GB18_BITD:D7","CH_GB18_BITD:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:FGS-B05","text":"Quantifiziertes Seelending → graduelle Verminderbarkeit → Kritik der Beharrlichkeit → Aufhebung des Quantums im nicht-dinglichen Geist.","refs":["CH_GB18_A_17:FGS1","CH_GB18_A_17:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_22:AFM-B01","text":"Falsche Trennung quantitativer Arten → Identität derselben Bestimmtheit in innerer und äußerer Form.","refs":["CH_GB18_A_16:AS1","CH_GB18_A_16:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AFM-B02","text":"Identität von Einheit und Anzahl → Grad als relationale Bestimmtheit → Unmöglichkeit reiner Intensität.","refs":["CH_GB18_BITD:A13","CH_GB18_A_16:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AFM-B03","text":"Dynamische Neurahmung → Untrennbarkeit von Kraft und Äußerung → Rückkehr des Extensiven in jede Intensität.","refs":["CH_GB18_A_16:FGS3","CH_GB18_A_16:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AFM-B04","text":"Negative Identität der Quantität → qualitatives Etwas → Entzug des Trägers aus vollständiger quantitativer Reduktion.","refs":["CH_GB18_BITD:FGS5","CH_GB18_BITD:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AFM-B05","text":"Quantitative Seelenkritik → Differenz von Seele und Geist → genetische Aufgabe einer nicht-dinglichen Erklärung von Endlichkeit.","refs":["CH_GB18_A_17:AF4","CH_GB18_A_17:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_22:MME-01","text":"Die Karte der Quantität wird von einer Taxonomie zweier Größenarten in ein Feld reziproker Formbestimmungen umgezeichnet.","refs":["CH_GB18_A_16:ME1","CH_GB18_A_16:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MME-02","text":"Innen und Außen, Kraft und Äußerung, Einheit und Vielheit verlieren ihren Status als stabile Gegensätze und werden zu Umschlagsstellen einer einzigen Vermittlung.","refs":["CH_GB18_BITD:SD2","CH_GB18_A_16:SD7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MME-03","text":"Die Unterscheidung von Seele und Geist überordnet die quantitative Differenz und klassifiziert Quantifizierung als begrenzte Geltungsform unmittelbaren Seins.","refs":["CH_GB18_A_17:ME1","CH_GB18_A_17:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MME-04","text":"Die Frage nach Dauer wird durch die Frage ersetzt, wie endliche Bestimmungen hervorgehen können, ohne als Eigenschaften eines vorher bestehenden Dinges behandelt zu werden.","refs":["CH_GB18_A_17:ME2","CH_GB18_A_17:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_22:ALT-B01","text":"Surface level — Grad, Zahl, extensive Menge, intensive Einheit, Kraft, Äußerung, Seele und Geist werden als unterschiedliche Einsatzpunkte derselben Problematik behandelt.","refs":["CH_GB18_BITD:ALT1","CH_GB18_A_17:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:ALT-B02","text":"Structural level — Bestimmtheit entsteht durch Vermittlung von Einheit und Vielheit, Innerlichkeit und Äußerlichkeit, qualitativer Trägerschaft und quantitativer Differenz.","refs":["CH_GB18_BITD:ALT2","CH_GB18_A_16:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:ALT-B03","text":"Metastrategic level — Das Verfahren ersetzt exklusive Alternativen nicht durch Harmonie, sondern durch eine rekursive Rekonstruktion, die jede einseitige Position als abstrahiertes Moment ausweist.","refs":["CH_GB18_BITD:ALT3","CH_GB18_A_16:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:ALT-B04","text":"Ontological / Temporal level — Das Etwas besitzt quantitative Bestimmungen, Geist überschreitet deren Kategorien, und Endlichkeit wird als zu erklärender Hervorgang aus ewiger Geistnatur gesetzt.","refs":["CH_GB18_BITD:ALT4","CH_GB18_A_17:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:ALT-B05","text":"Methodological / Performative level — Die Argumentation vollzieht ihre These selbst, indem sie jeden erreichten Begriff durch seine eigene Vermittlung destabilisiert und in eine höhere Bestimmungsordnung überführt.","refs":["CH_GB18_BITD:FGS6","CH_GB18_A_17:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_22:FL-01","text":"Die Gleichgültigkeit des qualitativen Etwas gegen sein Quantum bleibt spannungsvoll, weil dieses Etwas zugleich erst aus der negativen Identität quantitativer Unterschiede hervorgeht.","refs":["CH_GB18_BITD:MRT6","CH_GB18_BITD:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:FL-02","text":"Die dynamische Betrachtung wird zunächst gegenüber der mechanischen privilegiert, später aber selbst als unzureichend behandelt, weil sie die Differenz von Seelending und Geist nicht erklären kann.","refs":["CH_GB18_A_16:D1","CH_GB18_A_16:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MP-01","text":"Der Begriff der Intensität mutiert an der Grenze zwischen Seele und Geist: Was für das unmittelbar Seiende als Grad der Realität gilt, ist für Geist keine zulässige kategoriale Bestimmung mehr.","refs":["CH_GB18_A_17:A5","CH_GB18_A_17:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MP-02","text":"Der Übergang von quantitativer Negation zu geistiger Ontologie bleibt produktiv offen, weil die Hervorbringung von Dasein, Bewusstsein und Endlichkeit gefordert, aber nicht konkret ausgeführt wird.","refs":["CH_GB18_A_17:A11","CH_GB18_A_17:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_22:HSI-01","text":"Die Realität erscheint als Vermittlungsmaschine, in der jede Einheit ihre Bestimmtheit nur durch das von ihr Ausgeschlossene, Enthaltene oder Hervorgebrachte erhält.","refs":["CH_GB18_BITD:D1","CH_GB18_BITD:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:HSI-02","text":"Das Subjekt erscheint zunächst als quantitativ graduierbares Seelending, wird aber als Geist zu einer nicht-dinglichen Quelle endlicher Bestimmungen.","refs":["CH_GB18_A_17:D1","CH_GB18_A_17:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:HSI-03","text":"Möglich bleibt keine Flucht aus Vermittlung, sondern nur deren Umcodierung: Quantität kann ihre eigene Grenze sichtbar machen, ohne die Aufgabe nicht-quantitativer Geistbestimmung selbst zu lösen.","refs":["CH_GB18_A_17:D6","CH_GB18_A_17:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_22:MRT-B01","text":"Die globalen Axiome reichen aus, um die Bewegung von der Identität extensiver und intensiver Größe über die qualitative negative Identität bis zur kategorialen Differenz von Seele und Geist zu rekonstruieren.","refs":["CH_GB18_BITD:MRT1","CH_GB18_A_17:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MRT-B02","text":"Die Rekonstruktion ist am stärksten, wo sie reine Intensität, reine Extensität und dinghafte Geistbestimmung als systematisch unhaltbare Grenzformen ausschließt.","refs":["CH_GB18_A_16:MRT7","CH_GB18_A_17:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MRT-B03","text":"Unterbestimmt bleibt die positive genetische Erklärung, wie Dasein, Bewusstsein und Endlichkeit aus der ewigen Natur des Geistes hervorgehen, ohne in Dinglichkeit zurückzufallen.","refs":["CH_GB18_A_17:MRT3","CH_GB18_A_17:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MRT-B04","text":"Die Clusterkohärenz hängt daher nicht von einer endgültigen Auflösung aller Spannungen ab, sondern von der präzisen Staffelung ihrer Geltungsbereiche: Quantum, Qualität, Seele und Geist dürfen nicht ineinander kollabieren.","refs":["CH_GB18_BITD:MRT5","CH_GB18_A_17:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121508195050Z_d6f2431b","language_code":"en","language_name":"English","title":"Chapters 64–66","source_sha256":"9d2703468ffe0dc88248b8005a76bda60f18f7be85e31490f4dee205f2fd2646","sha256":"b981b066e4e5c465c96df09d13035f3bdf9755bb9660f02f501c1a12dcc99693","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:15:08.197359+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_22:AS-01","text":"The problem consists in reconstructing quantitative determinacy such that degree, number, unity, and plurality are treated neither as separate objects nor as merely external relations.","refs":["CH_GB18_BITD:AS1","CH_GB18_A_16:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-02","text":"Extensive and intensive magnitude are determined as two alternating modes of positing the same quantum: number is in each case simultaneously contained in the degree and operative outside it as the condition of its determinacy.","refs":["CH_GB18_BITD:AS3","CH_GB18_BITD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-03","text":"The dynamic reinterpretation of external plurality as the manifestation of force corrects the mechanical separation, but cannot eliminate extensive mediation, because force is determined only in its manifestation.","refs":["CH_GB18_A_16:AS2","CH_GB18_A_16:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-04","text":"The quantitative double determination produces no pure unity, but rather a relational unity whose intensity remains determined by series, scale, effect, and extensive range.","refs":["CH_GB18_A_16:A8","CH_GB18_A_16:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-05","text":"The negative identity of quantitative differences releases a qualitative something that possesses quantum without coinciding with its quantitative determination.","refs":["CH_GB18_BITD:AS7","CH_GB18_BITD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-06","text":"The application of this logic to the soul shows the limit of quantification: as immediately existent, it can bear intensive degrees and their diminution, yet thereby it remains a soul-thing.","refs":["CH_GB18_A_17:AS2","CH_GB18_A_17:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-07","text":"Spirit is determined not by a higher or purer intensity, but by the sublation of the categories of immediate being, including quantum as such.","refs":["CH_GB18_A_17:A9","CH_GB18_A_17:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AS-08","text":"The movement is spiral-shaped: quantitative mediation produces qualitative determinacy, whose spiritual form rejects the categories through which the mediation initially became intelligible.","refs":["CH_GB18_BITD:FGS5","CH_GB18_A_17:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_22:GA-01","text":"[Persistent] Extensive and intensive magnitude are not separate kinds of quantity, but different positions of the same number in relation to unity, plurality, and externality.","refs":["CH_GB18_BITD:A7","CH_GB18_A_16:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-02","text":"[Persistent] Degree is not an immediate simplicity, but a unity mediated through other degrees, series, scale, and its own number.","refs":["CH_GB18_BITD:A3","CH_GB18_A_16:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-03","text":"[Mutating] The external juxtaposition of plurality is determined first as quantitative externality, then as the necessary manifestation of force, and finally as an inadmissible category for spirit.","refs":["CH_GB18_BITD:AS6","CH_GB18_A_16:A3","CH_GB18_A_17:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-04","text":"[Persistent] No intensity is determinable without extensive mediation, because every inner determination obtains concrete validity only through effect, range, series, or number.","refs":["CH_GB18_A_16:A8","CH_GB18_A_16:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-05","text":"[Emergent] The identity of unity and plurality is productive: through the negation of their quantitative difference, a qualitative something arises that possesses its quantity but is not exhausted in it.","refs":["CH_GB18_BITD:A11","CH_GB18_BITD:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-06","text":"[Mutating] The quantitative critique of the soul is valid within the determination of an immediately existent substrate, but loses its scope as soon as spirit is conceived as non-thingly being.","refs":["CH_GB18_A_17:D4","CH_GB18_A_17:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-07","text":"[Terminal] Spiritual determination requires the removal of quantum as such and shifts the explanation of persistence to the production of existence, consciousness, and finitude.","refs":["CH_GB18_A_17:AS5","CH_GB18_A_17:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GA-08","text":"[Attractor] The entire architecture converges on a non-thingly determination in which mediated finitude can be conceived neither as a property of a substrate nor as a merely gradual attenuation.","refs":["CH_GB18_A_17:A11","CH_GB18_A_17:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_22:RMD-01","text":"Number remains identical as a unity-and-number structure, but mutates from the determination of quantum into the mediation that refutes every isolated intensity.","refs":["CH_GB18_A_16:A7","CH_GB18_BITD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RMD-02","text":"Degree recurs functionally as relational quantitative unity, but in the transition to spirit it is not intensified but categorically suspended.","refs":["CH_GB18_BITD:A4","CH_GB18_A_17:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RMD-03","text":"Force and manifestation assume the structural role of intensity and extensity: they confirm their inseparability, but do not become the final ontological explanation.","refs":["CH_GB18_A_16:A3","CH_GB18_A_16:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RMD-04","text":"The qualitative something absorbs the quantitative difference as a possessed yet indifferent determination; spirit subsequently transcends even this form of a presupposed bearer.","refs":["CH_GB18_BITD:A12","CH_GB18_A_17:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_22:CGD-01","text":"The concrete description of degree as the exclusion of adjacent degrees remains local quantitative mechanics; at the cluster level it becomes the general thesis that determinacy exists only relationally.","refs":["CH_GB18_BITD:A5","CH_GB18_A_16:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:CGD-02","text":"Examples such as pressure, temperature, tone, color, and spiritual effect remain local instantiations; the sole scaling principle is that intensity becomes legible through extensive efficacy.","refs":["CH_GB18_A_16:D7","CH_GB18_A_16:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:CGD-03","text":"The possible dissolution of the soul into nothing remains a consequence of the quantification of a soul-thing; at the cluster level it functions as a limit test for the inadequacy of a thingly ontology of spirit.","refs":["CH_GB18_A_17:D3","CH_GB18_A_17:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:CGD-04","text":"The higher-order structure does not consist in a generalization of quantum, but in its self-limitation: its logic of mediation produces the conditions under which spirit is no longer quantifiable.","refs":["CH_GB18_A_17:AS5","CH_GB18_A_17:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_22:GNX-01","text":"Excluded is an ontology of separate extensive and intensive kinds of objects; both poles are only abstracted forms of the same determinacy.","refs":["CH_GB18_BITD:NX6","CH_GB18_A_16:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GNX-02","text":"Excluded are both pure inwardness without manifestation and pure externality without inner determination; each side exists only in its mediation with the other.","refs":["CH_GB18_A_16:DNX3","CH_GB18_A_16:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GNX-03","text":"Excluded is a qualitative substrate that would precede quantitative mediation externally or be completely exhausted by it.","refs":["CH_GB18_BITD:DNX5","CH_GB18_BITD:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:GNX-04","text":"Excluded is the transfer of quantitative categories to spirit, because this transfer transforms its non-thingly mode of being back into an immediately present something.","refs":["CH_GB18_A_17:NX5","CH_GB18_A_17:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_22:DBN-01","text":"For the architecture to hold, no determinacy may count as immediately given: neither degree, unity, force, quality, soul, nor spirit possesses its meaning outside a mediation order that differs in each case.","refs":["CH_GB18_BITD:NX2","CH_GB18_A_16:NX4","CH_GB18_A_17:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:DBN-02","text":"Inadmissible is a form of inference that directly derives ontological liberation from the sublation of a quantitative determination; the transition from soul-thing to spirit requires a change of the domain of objects.","refs":["CH_GB18_A_17:D6","CH_GB18_A_17:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:DBN-03","text":"The system disqualifies every theory that explains finitude as the mere diminution of an original stock, because it once again presupposes spirit as a thing capable of gradual attenuation.","refs":["CH_GB18_A_17:A6","CH_GB18_A_17:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_22:BSA-01","text":"Unavailable is a final standpoint from which unity, plurality, quality, and spirit could be determined as independently existing positive entities.","refs":["CH_GB18_BITD:SNX3","CH_GB18_A_17:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:BSA-02","text":"The most deeply excluded possibility is a reality in which spirit would be explainable through the same categories by which quantitative things, forces, and soul-objects are determined.","refs":["CH_GB18_A_17:SNX1","CH_GB18_A_17:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_22:XD-01","text":"The reciprocal determination of intensity and extensity prevents the transition from quantity to quality from being understood as an escape from mediation; quality is instead its negative reorganization.","refs":["CL_GB18_22:GA-01","CL_GB18_22:GA-05","CH_GB18_BITD:SD3","CH_GB18_A_16:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_22:XD-02","text":"The dynamic language of force and manifestation confirms the double determination of quantum, but also shows that a merely dynamic model cannot account for the ontological difference of spirit.","refs":["CL_GB18_22:GA-03","CL_GB18_22:GA-07","CH_GB18_A_16:SD4","CH_GB18_A_17:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_22:XD-03","text":"The quantitative refutation of the soul's persistence is not a determination of spiritual being, but a negative result that unsettles the substance-form of the soul-thing.","refs":["CL_GB18_22:GA-06","CL_GB18_22:GA-08","CH_GB18_A_17:D4","CH_GB18_A_17:DNX1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_22:XD-04","text":"The removal of quantum from spirit is not a denial of finitude, but the demand to explain finitude genetically rather than as measurable attenuation.","refs":["CL_GB18_22:GA-07","CL_GB18_22:GA-08","CH_GB18_A_17:FGS4","CH_GB18_A_17:ME5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_22:BSD-01","text":"Reality is reorganized as a stratified order of mediations: quantity determines itself through its otherness, quality through negative identity, and spirit through the sublation of the categories of these two forms.","refs":["CH_GB18_BITD:A13","CH_GB18_BITD:FGS5","CH_GB18_A_17:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:BSD-02","text":"The subject splits into two incompatible figures: as soul, it is a simple substrate amenable to quantitative treatment; as spirit, it is the non-thingly source of the finitude to be explained.","refs":["CH_GB18_A_17:A1","CH_GB18_A_17:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:BSD-03","text":"Causality shifts from the linear production of external effects by inner forces to a reciprocal determination that, in the case of spirit, must pass into a genetic explanation without thing-cause.","refs":["CH_GB18_A_16:A10","CH_GB18_A_17:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:BSD-04","text":"The architecture produces a scale of ontological validity: quantitative categories are not false, but are legitimate only within the sphere of immediate being and terminally inadequate for spirit.","refs":["CH_GB18_A_17:NX4","CH_GB18_A_17:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_22:RLE-01","text":"The central loop leads from plurality to unity, from unity through its own number back to plurality, and from their negative identity to the qualitative something.","refs":["CH_GB18_BITD:AS6","CH_GB18_BITD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RLE-02","text":"A second loop transforms inner force into external manifestation and in turn reads the manifestation as evidence of intensive determination, without hypostatizing either pole.","refs":["CH_GB18_A_16:A4","CH_GB18_A_16:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RLE-03","text":"The escalation path proceeds from quantitative mediation through qualitative bearership to the categorical self-sublation of quantum in the concept of spirit.","refs":["CH_GB18_BITD:D7","CH_GB18_A_17:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:RLE-04","text":"The attractor is the non-thingly nature of spirit, against which all earlier determinations are tested: they may count as mediated forms, but not as final predicates of spirit.","refs":["CH_GB18_A_17:A8","CH_GB18_A_17:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_22:FGS-B01","text":"Distinction between extensive and intensive → critique of separate kinds of quantity → reduction to the same number in different positions.","refs":["CH_GB18_BITD:ME1","CH_GB18_A_16:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:FGS-B02","text":"Number and unity → relational determination of degree → exclusion of other degrees and its own number as a double condition.","refs":["CH_GB18_BITD:D1","CH_GB18_BITD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:FGS-B03","text":"Intensive unity ↔ extensive effect → force ↔ manifestation → universal double determination of concrete magnitudes.","refs":["CH_GB18_A_16:D6","CH_GB18_A_16:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:FGS-B04","text":"Negative identity of quantitative differences → qualitative something with quantum → limitation of every purely quantitative ontology.","refs":["CH_GB18_BITD:D7","CH_GB18_BITD:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:FGS-B05","text":"Quantified soul-thing → gradual diminishability → critique of persistence → sublation of quantum in non-thingly spirit.","refs":["CH_GB18_A_17:FGS1","CH_GB18_A_17:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_22:AFM-B01","text":"False separation of quantitative kinds → identity of the same determinacy in inner and outer form.","refs":["CH_GB18_A_16:AS1","CH_GB18_A_16:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AFM-B02","text":"Identity of unity and number → degree as relational determinacy → impossibility of pure intensity.","refs":["CH_GB18_BITD:A13","CH_GB18_A_16:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AFM-B03","text":"Dynamic reframing → inseparability of force and manifestation → return of the extensive into every intensity.","refs":["CH_GB18_A_16:FGS3","CH_GB18_A_16:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AFM-B04","text":"Negative identity of quantity → qualitative something → withdrawal of the bearer from complete quantitative reduction.","refs":["CH_GB18_BITD:FGS5","CH_GB18_BITD:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:AFM-B05","text":"Quantitative critique of the soul → difference between soul and spirit → genetic task of a non-thingly explanation of finitude.","refs":["CH_GB18_A_17:AF4","CH_GB18_A_17:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_22:MME-01","text":"The map of quantity is redrawn from a taxonomy of two kinds of magnitude into a field of reciprocal determinations of form.","refs":["CH_GB18_A_16:ME1","CH_GB18_A_16:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MME-02","text":"Inside and outside, force and manifestation, unity and plurality lose their status as stable opposites and become points of transition within a single mediation.","refs":["CH_GB18_BITD:SD2","CH_GB18_A_16:SD7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MME-03","text":"The distinction between soul and spirit subordinates the quantitative difference and classifies quantification as a limited form of validity of immediate being.","refs":["CH_GB18_A_17:ME1","CH_GB18_A_17:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MME-04","text":"The question of duration is replaced by the question of how finite determinations can emerge without being treated as properties of a pre-existing thing.","refs":["CH_GB18_A_17:ME2","CH_GB18_A_17:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_22:ALT-B01","text":"Surface level — Degree, number, extensive magnitude, intensive unity, force, manifestation, soul, and spirit are treated as different points of entry into the same problem.","refs":["CH_GB18_BITD:ALT1","CH_GB18_A_17:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:ALT-B02","text":"Structural level — Determinacy arises through the mediation of unity and plurality, inwardness and externality, qualitative bearership and quantitative difference.","refs":["CH_GB18_BITD:ALT2","CH_GB18_A_16:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:ALT-B03","text":"Metastrategic level — The procedure does not replace exclusive alternatives with harmony, but with a recursive reconstruction that exposes every one-sided position as an abstracted moment.","refs":["CH_GB18_BITD:ALT3","CH_GB18_A_16:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:ALT-B04","text":"Ontological / Temporal level — The something possesses quantitative determinations, spirit transcends their categories, and finitude is posited as an emergence to be explained from the eternal nature of spirit.","refs":["CH_GB18_BITD:ALT4","CH_GB18_A_17:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:ALT-B05","text":"Methodological / Performative level — The argument itself enacts its thesis by destabilizing every concept attained through its own mediation and transferring it into a higher order of determination.","refs":["CH_GB18_BITD:FGS6","CH_GB18_A_17:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_22:FL-01","text":"The indifference of the qualitative something toward its quantum remains tension-filled, because this something simultaneously first emerges from the negative identity of quantitative differences.","refs":["CH_GB18_BITD:MRT6","CH_GB18_BITD:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:FL-02","text":"The dynamic perspective is initially privileged over the mechanical, but later itself treated as inadequate because it cannot explain the difference between soul-thing and spirit.","refs":["CH_GB18_A_16:D1","CH_GB18_A_16:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MP-01","text":"The concept of intensity mutates at the boundary between soul and spirit: what counts for immediately existent being as a degree of reality is no longer a permissible categorical determination for spirit.","refs":["CH_GB18_A_17:A5","CH_GB18_A_17:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MP-02","text":"The transition from quantitative negation to spiritual ontology remains productively open, because the production of existence, consciousness, and finitude is demanded but not concretely carried out.","refs":["CH_GB18_A_17:A11","CH_GB18_A_17:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_22:HSI-01","text":"Reality appears as a machine of mediation, in which every unity receives its determinacy only through what it excludes, contains, or produces.","refs":["CH_GB18_BITD:D1","CH_GB18_BITD:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:HSI-02","text":"The subject initially appears as a quantitatively gradable soul-thing, but as spirit becomes a non-thingly source of finite determinations.","refs":["CH_GB18_A_17:D1","CH_GB18_A_17:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:HSI-03","text":"What remains possible is no escape from mediation, but only its recoding: quantity can make its own limit visible without itself resolving the task of non-quantitative determination of spirit.","refs":["CH_GB18_A_17:D6","CH_GB18_A_17:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_22:MRT-B01","text":"The global axioms suffice to reconstruct the movement from the identity of extensive and intensive magnitude through qualitative negative identity to the categorical difference between soul and spirit.","refs":["CH_GB18_BITD:MRT1","CH_GB18_A_17:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MRT-B02","text":"The reconstruction is strongest where it excludes pure intensity, pure extensity, and thing-like determination of spirit as systematically untenable limit forms.","refs":["CH_GB18_A_16:MRT7","CH_GB18_A_17:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MRT-B03","text":"What remains underdetermined is the positive genetic explanation of how existence, consciousness, and finitude emerge from the eternal nature of spirit without lapsing back into thinghood.","refs":["CH_GB18_A_17:MRT3","CH_GB18_A_17:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_22:MRT-B04","text":"Cluster coherence therefore does not depend on a final resolution of all tensions, but on the precise stratification of their domains of validity: quantum, quality, soul, and spirit must not collapse into one another.","refs":["CH_GB18_BITD:MRT5","CH_GB18_A_17:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_22@R001","source_variant_id":"canonical:CL_GB18_22:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 64–66","context":"b. Identität der extensiven und intensiven Größe. · Anmerkung 1. · Anmerkung 2."},"title_language_code":"en"},{"id":"CL_GB18_23","layer":"CL","title":"Chapters 67–69","order":23,"parents":["CH_GB18_CDVN","CH_GB18_BEGD","CH_GB18_BDQU"],"revision":"CL_GB18_23@R001","sha256":"b41ec3fb81955bee3becd297beddfd90fae5b72488c669d21fa720f19f813b92","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_23:AS-B01","text":"Das Cluster rekonstruiert Quantität als Bestimmtheit, deren Grenze nicht ruhend begrenzt, sondern ihre eigene Negation und Veränderbarkeit erzeugt.","refs":["CH_GB18_CDVN:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AS-B02","text":"Das Andere der quantitativen Grenze erscheint nicht als qualitativ fremdes Außen, sondern als Fortsetzung derselben Quantität in einem anderen Quantum.","refs":["CH_GB18_BEGD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AS-B03","text":"Endlichkeit und Unendlichkeit werden als ineinander verschränkte Funktionen einer Grenze bestimmt, die nur besteht, indem sie über sich hinausgeht und zu sich zurückkehrt.","refs":["CH_GB18_BEGD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AS-B04","text":"Der quantitativ-unendliche Progress ist die notwendige Erscheinungsform dieser Selbstüberschreitung, aber nicht ihre Auflösung; jede erreichte Unendlichkeit wird erneut als Grenze gesetzt.","refs":["CH_GB18_BDQU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AS-B05","text":"Die Bewegung ist rekursiv und negativ: Quantum → Jenseits → anderes Quantum → neue Grenze → erneutes Jenseits; ihre Schließung besteht als Diagnose einer fortgesetzten schlechten Unendlichkeit.","refs":["CH_GB18_BDQU:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_23:GA-01","text":"[Persistent] Quantität ist keine ruhende Größe, sondern aufgehobene Bestimmtheit, deren Grenze sich gegen ihre eigene Bestimmung gleichgültig verhält.","refs":["CH_GB18_CDVN:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-02","text":"[Persistent] Die Grenze des Quantums enthält ihre Selbstnegation und ist daher nur als werdende, nicht als endgültige Grenze bestimmt.","refs":["CH_GB18_CDVN:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-03","text":"[Mutating] Das Andere des Quantums mutiert vom Resultat der Selbstüberschreitung zur Kontinuitätsform, in der Quantität sich in ihrem Anderssein erhält.","refs":["CH_GB18_BEGD:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-04","text":"[Emergent] Endlichkeit und Unendlichkeit sind keine getrennten Regionen, sondern doppelte Bestimmungen derselben quantitativen Selbstbeziehung.","refs":["CH_GB18_BEGD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-05","text":"[Persistent] Die Äußerlichkeit des Quantums gehört seiner eigenen Bestimmung an und ist nicht äußerer Anstoß einer ansonsten stabilen Größe.","refs":["CH_GB18_BDQU:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-06","text":"[Mutating] Der unendliche Progress verwandelt die immanente Selbstüberschreitung in eine Serie, deren Wiederholung zugleich Kontinuität erzeugt und wirkliche Aufhebung verhindert.","refs":["CH_GB18_BDQU:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-07","text":"[Terminal] Quantitative Unendlichkeit ist keine positive erreichte Bestimmung, sondern die rekursive Dauerform eines ungelösten Widerspruchs von Grenze und Jenseits.","refs":["CH_GB18_BDQU:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-08","text":"[Attractor] Der Grenz-Jenseits-Widerspruch organisiert alle Bewegungen des Clusters, weil jede Negation sich wieder als quantitative Grenze und jedes Jenseits wieder als Quantum setzt.","refs":["CH_GB18_BDQU:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_23:RMD-01","text":"Die Grenze bleibt identisch als negative Bestimmtheit, mutiert jedoch von der werdenden Grenze zur rekursiv wiedergesetzten Grenze des unendlichen Progresses.","refs":["CH_GB18_CDVN:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:RMD-02","text":"Das Andere wiederholt sich funktional, wechselt aber seine Valenz: Es ist zunächst hervorgebrachtes anderes Quantum, dann Kontinuität der Quantität und schließlich das Jenseits, das erneut Grenze wird.","refs":["CH_GB18_CDVN:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:RMD-03","text":"Unendlichkeit mutiert von der im Quantum gesetzten Negation seiner Grenze zur schlechten Unendlichkeit, in der diese Negation keine qualitative Selbstvollendung erreicht.","refs":["CH_GB18_BEGD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:RMD-04","text":"Kontinuität verschiebt ihre Funktion von der Vermittlung zwischen Quantum und Anderssein zum Mechanismus, der die Flucht von Grenze und Jenseits gerade als Bindung reproduziert.","refs":["CH_GB18_BDQU:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_23:CGD-01","text":"Die Differenz von extensiver und intensiver Größe bleibt eine lokale Bestimmung, weil sie auf Clusterebene in die allgemeinere Architektur der immanenten quantitativen Negativität absorbiert wird.","refs":["CH_GB18_CDVN:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:CGD-02","text":"Die Unterscheidung zwischen qualitativer und quantitativer Unendlichkeit skaliert aufwärts, weil sie die Grenze markiert, an der quantitative Selbstbeziehung keine qualitative Vollendung erzeugt.","refs":["CH_GB18_BEGD:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:CGD-03","text":"Unendlich-Großes und Unendlich-Kleines bleiben lokale Erscheinungsformen, werden aber clusterweit als symmetrische Träger desselben ungelösten Grenz-Jenseits-Widerspruchs lesbar.","refs":["CH_GB18_BDQU:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_23:GNX-01","text":"Das Cluster schließt eine Quantität aus, die als selbstidentische, in sich ruhende und von ihrer Negation unberührte Bestimmtheit bestehen könnte.","refs":["CH_GB18_CDVN:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GNX-02","text":"Es schließt ein Jenseits aus, das qualitativ fremd, außerhalb der Quantität oder unabhängig von der fortgesetzten Rückkehr in eine neue Grenze wäre.","refs":["CH_GB18_BDQU:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GNX-03","text":"Es verwirft ein Fortschrittsmodell, in dem bloße quantitative Wiederholung als wirkliche Annäherung an positive Unendlichkeit gelten könnte.","refs":["CH_GB18_BDQU:NX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_23:DBN-01","text":"Unzulässig ist die Annahme, Veränderung komme einer quantitativen Bestimmtheit von außen zu; die Bewegungsquelle muss als ihre eigene Negativität bestimmt sein.","refs":["CH_GB18_CDVN:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:DBN-02","text":"Unzulässig ist ein Endzustand, in dem das Hinaus über die Grenze seine Beziehung zur Grenze verliert, denn jedes Jenseits muss wieder quantitative Bestimmtheit annehmen.","refs":["CH_GB18_BDQU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:DBN-03","text":"Unzulässig ist eine Versöhnung von Endlichkeit und Unendlichkeit durch Akkumulation, weil deren quantitative Vermittlung die qualitative Differenz gerade erhält.","refs":["CH_GB18_BDQU:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_23:BSA-01","text":"Die Architektur wird durch die Abwesenheit einer positiven, gegenwärtigen und nichtquantitativen Unendlichkeit innerhalb des quantitativen Feldes organisiert.","refs":["CH_GB18_BDQU:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:BSA-02","text":"Nicht verfügbar ist eine Identität, die ohne ihre eigene Überschreitung, ohne Anderssein und ohne Rückkehr der Negation bestehen könnte.","refs":["CH_GB18_CDVN:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_23:XD-01","text":"Die immanente Veränderbarkeit der Grenze und die Kontinuität des Andersseins erzeugen zusammen eine Identität, die nur als Erhaltung durch Selbstveränderung existiert.","refs":["CL_GB18_23:GA-01","CL_GB18_23:GA-03","CH_GB18_CDVN:SD1","CH_GB18_BEGD:SD2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_23:XD-02","text":"Die Doppelbestimmung von Endlichkeit und Unendlichkeit verhindert, dass der Progress als bloße äußere Reihe von Quanta verstanden werden kann; er ist die Erscheinung einer gesetzten Selbstbeziehung.","refs":["CL_GB18_23:GA-04","CL_GB18_23:GA-06","CH_GB18_BEGD:D8","CH_GB18_BEGD:ME5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_23:XD-03","text":"Weil das Jenseits zugleich Negation und neues Quantum ist, verwandelt jede versuchte Flucht aus der Grenze die Fluchtbedingung in eine weitere Grenze.","refs":["CL_GB18_23:GA-05","CL_GB18_23:GA-08","CH_GB18_BDQU:D1","CH_GB18_BDQU:D3"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_23:XD-04","text":"Die quantitative Unendlichkeit wird als negative Produktivität bestimmt: Sie erzeugt unaufhörlich neue Bestimmungen, ohne die Bestimmungsform des Quantums verlassen zu können.","refs":["CL_GB18_23:GA-06","CL_GB18_23:GA-07","CH_GB18_BDQU:SD3","CH_GB18_BDQU:DNX6"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_23:BSD-01","text":"Quantität erscheint auf Clusterebene als ontologische Zeitform der Perennierung: Nicht ein Sein dauert fort, sondern eine Grenze setzt ihre eigene Überholung fort.","refs":["CH_GB18_BDQU:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:BSD-02","text":"Der Progress ist keine Entwicklung zu höherer Bestimmung, sondern eine rekursive Reproduktion des Mangels an qualitativer Selbstvollendung.","refs":["CH_GB18_BDQU:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:BSD-03","text":"Die größte und die kleinste quantitative Bestimmung konvergieren strukturell, weil beide die Grenze des Quantums maximieren, ohne dessen Form zu transzendieren.","refs":["CH_GB18_BDQU:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:BSD-04","text":"Die Architektur erzeugt eine negative Dialektik der Kontinuität: Vermittlung erhält den Zusammenhang der Gegensätze, aber gerade dadurch ihre Unaufhebbarkeit.","refs":["CH_GB18_BDQU:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_23:RLE-01","text":"Die zentrale Schleife lautet: aufgehobene Bestimmtheit → Selbstnegation → Anderssein als Quantum → neue Grenze → erneute Selbstnegation.","refs":["CH_GB18_CDVN:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:RLE-02","text":"Der begriffliche Attraktor ist die Grenze, weil sie zugleich Endlichkeit setzt, ihr eigenes Jenseits produziert und als neue Grenze wiederkehrt.","refs":["CH_GB18_BDQU:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:RLE-03","text":"Die Eskalation verläuft nicht von endlich zu unendlich, sondern von der immanenten Negation über den Progress zur Einsicht, dass Wiederholung keine positive Unendlichkeit hervorbringt.","refs":["CH_GB18_BDQU:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_23:FGS-B01","text":"Aufgehobene quantitative Bestimmtheit + gleichgültige Grenze → Grenze enthält ihre eigene Negation.","refs":["CH_GB18_CDVN:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:FGS-B02","text":"Selbstnegierende Grenze + Kontinuität mit dem Anderssein → anderes Quantum als Erhaltung der Quantität im Wandel.","refs":["CH_GB18_BEGD:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:FGS-B03","text":"Anderes Quantum + Rückkehr des Jenseits in Quantität → neue Grenze mit erneutem Jenseits.","refs":["CH_GB18_BDQU:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:FGS-B04","text":"Rekursion von Grenze und Jenseits + Ausbleiben qualitativer Selbstvollendung → schlechte quantitative Unendlichkeit.","refs":["CH_GB18_BDQU:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_23:AFM-B01","text":"Aufgehobene Bestimmtheit → Grenze als immanente Negation.","refs":["CH_GB18_CDVN:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AFM-B02","text":"Immanente Negation → Selbstüberschreitung in ein anderes Quantum.","refs":["CH_GB18_CDVN:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AFM-B03","text":"Anderes Quantum → Kontinuität der Quantität in ihrem Anderssein.","refs":["CH_GB18_BEGD:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AFM-B04","text":"Kontinuität im Anderssein → Verschränkung von Endlichkeit und Unendlichkeit.","refs":["CH_GB18_BEGD:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AFM-B05","text":"Verschränkung → quantitativ-unendlicher Progress → Wiedereinsetzung jeder Unendlichkeit als Grenze → schlechte Unendlichkeit.","refs":["CH_GB18_BDQU:D2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_23:MME-01","text":"Quantität wird von einer statischen Größenordnung zu einer prozessualen Form der Selbstdifferenzierung umkartiert.","refs":["CH_GB18_CDVN:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MME-02","text":"Das Andere wird vom äußeren Gegenpol zur immanenten Fortsetzung der Quantität reklassifiziert.","refs":["CH_GB18_BEGD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MME-03","text":"Unendlichkeit wird von einem erreichbaren Jenseits zu einer Bewegungsform des fortbestehenden quantitativen Widerspruchs umkartiert.","refs":["CH_GB18_BDQU:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MME-04","text":"Fortschritt wird als rekursive Wiederholung reklassifiziert, deren Serienform nicht als tatsächliches Weiterkommen gelten kann.","refs":["CH_GB18_BDQU:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_23:ALT-B01","text":"Surface level — Quantitative Veränderung besteht im Übergang eines Quantums in ein anderes Quantum und in der Wiederkehr dieser Veränderung als Progress.","refs":["CH_GB18_BEGD:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:ALT-B02","text":"Structural level — Grenze, Jenseits, Kontinuität und Äußerlichkeit bilden keine getrennten Momente, sondern einen rekursiven Vermittlungsmechanismus.","refs":["CH_GB18_BDQU:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:ALT-B03","text":"Metastrategic level — Das Cluster wendet den Begriff des Fortschritts gegen seine lineare Lesart und bestimmt Fortschritt als Wiederholung eines nicht aufgelösten Widerspruchs.","refs":["CH_GB18_BDQU:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:ALT-B04","text":"Ontological / Temporal level — Sein ist quantitative Kontinuität im Anderssein; Zeit ist die perennierende Wiedereinsetzung einer Grenze durch ihre eigene Negation.","refs":["CH_GB18_BEGD:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihren Gegenstand, indem sie jede erreichte Bestimmung als Ausgangspunkt einer weiteren begrifflichen Rückkehr behandelt.","refs":["CH_GB18_BDQU:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_23:FL-01","text":"Die Gleichgültigkeit des Quantums gegen seine Grenze steht in Spannung zur Notwendigkeit, dass gerade diese Grenze seine fortgesetzte Veränderung organisiert.","refs":["CH_GB18_CDVN:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:FL-02","text":"Kontinuität mit dem Anderssein und qualitative Differenz zum Unendlichen müssen zugleich gelten: Die erste verhindert äußere Trennung, die zweite verhindert Vollendung im Progress.","refs":["CH_GB18_BDQU:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MP-01","text":"Der Begriff des Anderen mutiert von einem hervorgebrachten Resultat in eine Vermittlungsform und schließlich in ein Jenseits, das als Quantum zurückkehrt.","refs":["CH_GB18_BDQU:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MP-02","text":"Der Begriff der Unendlichkeit mutiert von immanenter Negation der Endlichkeit zu deren schlechte Wiederholungsform, ohne dass eine positive Alternative bestimmt wird.","refs":["CH_GB18_BDQU:MRT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_23:HSI-01","text":"Die Realität erscheint als Maschine von Grenzen, die ihre eigene Außenseite produzieren und diese Außenseite nur als erneute Grenze zurückerhalten.","refs":["CH_GB18_BDQU:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:HSI-02","text":"Das Subjekt oder Für-sich-Sein erscheint nicht als beziehungslos abgeschlossene Einheit, sondern als Gleichgültigkeit, die nur innerhalb ihrer Beziehung zu Grenze und Anderssein besteht.","refs":["CH_GB18_BEGD:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:HSI-03","text":"Zeit erscheint als endlose Wiederkehr einer nicht vollendbaren Negation, nicht als sukzessive Annäherung an ein positives Ziel.","refs":["CH_GB18_BDQU:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_23:MRT-B01","text":"Die globalen Axiome reichen aus, um die Bewegung von aufgehobener Bestimmtheit über Selbstüberschreitung und Kontinuität bis zur Diagnose der schlechten Unendlichkeit zu rekonstruieren.","refs":["CH_GB18_CDVN:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MRT-B02","text":"Unterbestimmt bleibt die positive Bestimmung einer qualitativen Unendlichkeit, weil das Cluster ihre Nicht-Erreichbarkeit innerhalb quantitativer Rekursion zeigt, aber keinen Übergang aus ihr konstruiert.","refs":["CH_GB18_BDQU:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MRT-B03","text":"Die Architektur ist kohärent, wenn Unendlichkeit nicht als Endpunkt, sondern als rekursive Form der Grenzaufhebung verstanden wird; ihre produktive Unabgeschlossenheit ist zugleich ihre notwendige Grenze.","refs":["CH_GB18_CDVN:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121530118538Z_af0208be","language_code":"en","language_name":"English","title":"Chapters 67–69","source_sha256":"b41ec3fb81955bee3becd297beddfd90fae5b72488c669d21fa720f19f813b92","sha256":"c5e22ec400859aa43125bb6584b23ca0fa87c386ae97fb0c29bf546d402e01f4","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:15:30.119677+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_23:AS-B01","text":"The cluster reconstructs quantity as determinacy whose limit does not limit in repose, but produces its own negation and mutability.","refs":["CH_GB18_CDVN:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AS-B02","text":"The other of the quantitative limit appears not as a qualitatively alien externality, but as the continuation of the same quantity in another quantum.","refs":["CH_GB18_BEGD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AS-B03","text":"Finitude and infinity are determined as interwoven functions of a limit that exists only by going beyond itself and returning to itself.","refs":["CH_GB18_BEGD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AS-B04","text":"The quantitative infinite progress is the necessary form of appearance of this self-transcendence, but not its resolution; every attained infinity is posited anew as a limit.","refs":["CH_GB18_BDQU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AS-B05","text":"The movement is recursive and negative: quantum → beyond → other quantum → new limit → renewed beyond; its closure consists as the diagnosis of a continued bad infinity.","refs":["CH_GB18_BDQU:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_23:GA-01","text":"[Persistent] Quantity is not a resting magnitude, but sublated determinacy, whose limit behaves indifferently toward its own determination.","refs":["CH_GB18_CDVN:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-02","text":"[Persistent] The limit of the quantum contains its self-negation and is therefore determined only as a becoming, not as a final limit.","refs":["CH_GB18_CDVN:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-03","text":"[Mutating] The other of the quantum mutates from the result of self-transcendence into the form of continuity in which quantity preserves itself in its otherness.","refs":["CH_GB18_BEGD:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-04","text":"[Emergent] Finitude and infinity are not separate regions, but double determinations of the same quantitative self-relation.","refs":["CH_GB18_BEGD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-05","text":"[Persistent] The externality of the quantum belongs to its own determination and is not an external impetus affecting an otherwise stable magnitude.","refs":["CH_GB18_BDQU:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-06","text":"[Mutating] Infinite progress transforms immanent self-transcendence into a series whose repetition both produces continuity and prevents actual sublation.","refs":["CH_GB18_BDQU:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-07","text":"[Terminal] Quantitative infinity is not a positive attained determination, but the recursive enduring form of an unresolved contradiction between limit and beyond.","refs":["CH_GB18_BDQU:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GA-08","text":"[Attractor] The limit-beyond contradiction organizes all movements of the cluster, because every negation posits itself again as a quantitative limit and every beyond again as a quantum.","refs":["CH_GB18_BDQU:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_23:RMD-01","text":"The limit remains identical as negative determinacy, but mutates from the becoming limit into the recursively re-posited limit of infinite progress.","refs":["CH_GB18_CDVN:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:RMD-02","text":"The other repeats itself functionally, but changes its valence: it is initially a produced other quantum, then the continuity of quantity, and finally the beyond that becomes limit anew.","refs":["CH_GB18_CDVN:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:RMD-03","text":"Infinity mutates from the negation of its limit posited in the quantum into bad infinity, in which this negation attains no qualitative self-completion.","refs":["CH_GB18_BEGD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:RMD-04","text":"Continuity displaces its function from mediation between quantum and otherness to the mechanism that reproduces the flight of limit and beyond precisely as binding.","refs":["CH_GB18_BDQU:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_23:CGD-01","text":"The difference between extensive and intensive magnitude remains a local determination, because at the cluster level it is absorbed into the more general architecture of immanent quantitative negativity.","refs":["CH_GB18_CDVN:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:CGD-02","text":"The distinction between qualitative and quantitative infinity scales upward, because it marks the limit at which quantitative self-relation produces no qualitative completion.","refs":["CH_GB18_BEGD:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:CGD-03","text":"The infinitely great and the infinitely small remain local forms of appearance, but become legible across the cluster as symmetrical bearers of the same unresolved limit-beyond contradiction.","refs":["CH_GB18_BDQU:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_23:GNX-01","text":"The cluster excludes a quantity that could subsist as self-identical, resting within itself, and untouched by its negation.","refs":["CH_GB18_CDVN:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GNX-02","text":"It excludes a beyond that would be qualitatively alien, outside quantity, or independent of continued return into a new limit.","refs":["CH_GB18_BDQU:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:GNX-03","text":"It rejects a model of progress in which mere quantitative repetition could count as actual approximation to positive infinity.","refs":["CH_GB18_BDQU:NX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_23:DBN-01","text":"Inadmissible is the assumption that change comes to a quantitative determinacy from outside; the source of movement must be determined as its own negativity.","refs":["CH_GB18_CDVN:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:DBN-02","text":"Inadmissible is a final state in which going beyond the limit loses its relation to the limit, for every beyond must again assume quantitative determinacy.","refs":["CH_GB18_BDQU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:DBN-03","text":"Inadmissible is a reconciliation of finitude and infinity through accumulation, because its quantitative mediation preserves precisely the qualitative difference.","refs":["CH_GB18_BDQU:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_23:BSA-01","text":"The architecture is organized through the absence of a positive, present, and non-quantitative infinity within the quantitative field.","refs":["CH_GB18_BDQU:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:BSA-02","text":"Unavailable is an identity that could subsist without its own transcendence, without otherness, and without the return of negation.","refs":["CH_GB18_CDVN:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_23:XD-01","text":"The immanent mutability of the limit and the continuity of otherness together produce an identity that exists only as preservation through self-change.","refs":["CL_GB18_23:GA-01","CL_GB18_23:GA-03","CH_GB18_CDVN:SD1","CH_GB18_BEGD:SD2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_23:XD-02","text":"The double determination of finitude and infinity prevents progress from being understood as a merely external series of quanta; it is the appearance of a posited self-relation.","refs":["CL_GB18_23:GA-04","CL_GB18_23:GA-06","CH_GB18_BEGD:D8","CH_GB18_BEGD:ME5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_23:XD-03","text":"Because the beyond is at once negation and new quantum, every attempted flight from the limit transforms the condition of flight into a further limit.","refs":["CL_GB18_23:GA-05","CL_GB18_23:GA-08","CH_GB18_BDQU:D1","CH_GB18_BDQU:D3"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_23:XD-04","text":"Quantitative infinity is determined as negative productivity: it incessantly produces new determinations without being able to leave the form of the quantum.","refs":["CL_GB18_23:GA-06","CL_GB18_23:GA-07","CH_GB18_BDQU:SD3","CH_GB18_BDQU:DNX6"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_23:BSD-01","text":"At the cluster level, quantity appears as an ontological temporal form of perduration: it is not a being that endures, but a limit that perpetuates its own overcoming.","refs":["CH_GB18_BDQU:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:BSD-02","text":"Progress is not a development toward higher determination, but a recursive reproduction of the lack of qualitative self-completion.","refs":["CH_GB18_BDQU:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:BSD-03","text":"The greatest and the smallest quantitative determination converge structurally, because both maximize the limit of the quantum without transcending its form.","refs":["CH_GB18_BDQU:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:BSD-04","text":"The architecture produces a negative dialectic of continuity: mediation preserves the connection of the opposites, but thereby precisely their insurmountability.","refs":["CH_GB18_BDQU:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_23:RLE-01","text":"The central loop is: sublated determinacy → self-negation → otherness as quantum → new limit → renewed self-negation.","refs":["CH_GB18_CDVN:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:RLE-02","text":"The conceptual attractor is the limit, because it simultaneously posits finitude, produces its own beyond, and returns as a new limit.","refs":["CH_GB18_BDQU:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:RLE-03","text":"Escalation proceeds not from finite to infinite, but from immanent negation through progress to the insight that repetition produces no positive infinity.","refs":["CH_GB18_BDQU:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_23:FGS-B01","text":"Sublated quantitative determinacy + indifferent limit → limit contains its own negation.","refs":["CH_GB18_CDVN:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:FGS-B02","text":"Self-negating limit + continuity with otherness → other quantum as preservation of quantity in change.","refs":["CH_GB18_BEGD:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:FGS-B03","text":"Other quantum + return of the beyond into quantity → new limit with renewed beyond.","refs":["CH_GB18_BDQU:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:FGS-B04","text":"Recursion of limit and beyond + absence of qualitative self-completion → bad quantitative infinity.","refs":["CH_GB18_BDQU:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_23:AFM-B01","text":"Sublated determinacy → limit as immanent negation.","refs":["CH_GB18_CDVN:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AFM-B02","text":"Immanent negation → self-transcendence into another quantum.","refs":["CH_GB18_CDVN:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AFM-B03","text":"Other quantum → continuity of quantity in its otherness.","refs":["CH_GB18_BEGD:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AFM-B04","text":"Continuity in otherness → interweaving of finitude and infinity.","refs":["CH_GB18_BEGD:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:AFM-B05","text":"Interweaving → quantitative infinite progress → re-positing of every infinity as limit → bad infinity.","refs":["CH_GB18_BDQU:D2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_23:MME-01","text":"Quantity is remapped from a static order of magnitude into a processual form of self-differentiation.","refs":["CH_GB18_CDVN:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MME-02","text":"The other is reclassified from the external counterpole into the immanent continuation of quantity.","refs":["CH_GB18_BEGD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MME-03","text":"Infinity is remapped from an attainable beyond into a form of movement of the persisting quantitative contradiction.","refs":["CH_GB18_BDQU:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MME-04","text":"Progress is reclassified as recursive repetition, whose serial form cannot count as actual advance.","refs":["CH_GB18_BDQU:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_23:ALT-B01","text":"Surface level — Quantitative change consists in the transition of one quantum into another quantum and in the return of this change as progress.","refs":["CH_GB18_BEGD:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:ALT-B02","text":"Structural level — Limit, beyond, continuity, and externality do not form separate moments, but a recursive mechanism of mediation.","refs":["CH_GB18_BDQU:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:ALT-B03","text":"Metastrategic level — The cluster turns the concept of progress against its linear reading and determines progress as repetition of an unresolved contradiction.","refs":["CH_GB18_BDQU:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:ALT-B04","text":"Ontological / Temporal level — Being is quantitative continuity in otherness; time is the perduring re-positing of a limit through its own negation.","refs":["CH_GB18_BEGD:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:ALT-B05","text":"Methodological / Performative level — The exposition enacts its object by treating every attained determination as the point of departure for a further conceptual return.","refs":["CH_GB18_BDQU:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_23:FL-01","text":"The indifference of the quantum toward its limit stands in tension with the necessity that precisely this limit organizes its continued change.","refs":["CH_GB18_CDVN:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:FL-02","text":"Continuity with otherness and qualitative difference from the infinite must both hold: the former prevents external separation, the latter prevents completion in progress.","refs":["CH_GB18_BDQU:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MP-01","text":"The concept of the other mutates from a produced result into a form of mediation and finally into a beyond that returns as quantum.","refs":["CH_GB18_BDQU:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MP-02","text":"The concept of infinity mutates from the immanent negation of finitude into its bad form of repetition, without a positive alternative being determined.","refs":["CH_GB18_BDQU:MRT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_23:HSI-01","text":"Reality appears as a machine of limits that produce their own outside and receive this outside back only as a renewed limit.","refs":["CH_GB18_BDQU:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:HSI-02","text":"The subject or being-for-self appears not as a relationally closed unit, but as indifference that exists only within its relation to limit and otherness.","refs":["CH_GB18_BEGD:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:HSI-03","text":"Time appears as the endless return of a negation incapable of completion, not as successive approximation to a positive goal.","refs":["CH_GB18_BDQU:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_23:MRT-B01","text":"The global axioms suffice to reconstruct the movement from sublated determinacy through self-transcendence and continuity to the diagnosis of bad infinity.","refs":["CH_GB18_CDVN:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MRT-B02","text":"The positive determination of a qualitative infinity remains underdetermined, because the cluster shows its unattainability within quantitative recursion but constructs no transition out of it.","refs":["CH_GB18_BDQU:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_23:MRT-B03","text":"The architecture is coherent if infinity is understood not as an endpoint, but as a recursive form of the sublation of the limit; its productive incompleteness is at once its necessary limit.","refs":["CH_GB18_CDVN:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_23@R001","source_variant_id":"canonical:CL_GB18_23:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 67–69","context":"c. Die Veränderung des Quantums. · a. Begriff derselben. · b. Der quantitative unendliche Progreß."},"title_language_code":"en"},{"id":"CL_GB18_24","layer":"CL","title":"Chapters 70–72","order":24,"parents":["CH_GB18_A_18","CH_GB18_A_19","CH_GB18_CDUD"],"revision":"CL_GB18_24@R001","sha256":"090b1ecbae75d913bcc14baab64944e0e402787fdab0f26299e3d27ce00ecfe8","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_24:AS-B01","text":"Der Cluster bestimmt Unendlichkeit zunächst als Problem einer Grenze, deren äußerliches Überschreiten die Grenze nicht beseitigt, sondern in veränderter Gestalt reproduziert.","refs":["CH_GB18_A_18:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B02","text":"Das als selbständiges Jenseits gesetzte Unendliche bleibt endlich, weil es nur als Gegenposition zum Endlichen besteht und von dessen Grenze abhängt.","refs":["CH_GB18_A_18:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B03","text":"Die kosmologische Antinomie macht sichtbar, dass sowohl Begrenzung als auch Unbegrenztheit ihre eigenen Resultate voraussetzen und damit dieselbe Grenzbewegung zirkulär vollziehen.","refs":["CH_GB18_A_19:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B04","text":"Die Verlagerung des Widerspruchs in Bewußtsein oder Subjektivität suspendiert dessen objektive Struktur nicht, sondern verschiebt nur den Ort seiner Erscheinung.","refs":["CH_GB18_A_19:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B05","text":"Das schlechte Unendliche wird auf der Ebene des Quantums nicht bloß verworfen, sondern als notwendige Form einer zunächst äußerlich gewordenen Bestimmtheit bestimmt.","refs":["CH_GB18_CDUD:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B06","text":"Weil das Jenseits selbst Quantum ist, kann es nicht als absolutes Außen bestehen; seine Begrenzung nimmt die Äußerlichkeit in die quantitative Bewegung zurück.","refs":["CH_GB18_CDUD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B07","text":"Die Rückkehr aus der äußeren Unendlichkeit stellt keine vorquantitative Qualität wieder her, sondern erzeugt qualitative Bestimmtheit als Verhältnis voneinander abhängiger Quanta.","refs":["CH_GB18_CDUD:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B08","text":"Die Schließung des Clusters besteht in einer relationalen Unendlichkeit, in der ein Bestimmtes nur durch die Vermittlung seiner Äußerlichkeit bei sich ist.","refs":["CH_GB18_CDUD:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_24:GA-01","text":"[Persistent] Jede gesetzte Grenze enthält ein Jenseits, durch das sie ihre behauptete Selbständigkeit untergräbt.","refs":["CH_GB18_A_19:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-02","text":"[Persistent] Ein bloßer quantitativer Progress bleibt schlechte Unendlichkeit, sofern jede Aufhebung nur eine neue Grenze erzeugt.","refs":["CH_GB18_A_18:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-03","text":"[Mutating] Der unendliche Progreß verändert seinen Status von einem Symptom mißlungener Vermittlung zu einem notwendigen Durchgang, sobald seine Äußerlichkeit als immanentes Moment des Quantums begriffen wird.","refs":["CH_GB18_CDUD:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-04","text":"[Persistent] Ein Jenseits besitzt keine selbständige Realität, weil es allein durch seine Beziehung auf das Begrenzte bestimmt wird.","refs":["CH_GB18_A_19:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-05","text":"[Emergent] Zirkuläre Beweise sind nicht bloß methodische Fehler, sondern argumentative Vollzüge derselben unaufgelösten Grenzstruktur, die sie demonstrativ entscheiden sollen.","refs":["CH_GB18_A_19:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-06","text":"[Mutating] Negation der Negation bedeutet nicht die Flucht aus dem Negativen, sondern die Umwandlung der Äußerlichkeit in ein eigenes Moment der Bestimmtheit.","refs":["CH_GB18_CDUD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-07","text":"[Emergent] Qualität erscheint nicht als Gegenprinzip zur Quantität, sondern als vermittelte Selbstbestimmung der Quantität durch ihre Relation.","refs":["CH_GB18_CDUD:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-08","text":"[Terminal] Identität ist nur als durch Selbstverschiedenheit vermittelte Einheit möglich und nicht als unmittelbare Selbstgleichheit.","refs":["CH_GB18_CDUD:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-09","text":"[Attractor] Der Geist bezeichnet die Fähigkeit, Widerspruch nicht bloß zu erleiden oder zu verlagern, sondern ihn begrifflich aufzuheben.","refs":["CH_GB18_A_19:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-10","text":"[Attractor] Das wahre Unendliche ist die Selbstaufhebung jener Form, die Endliches und Unendliches als dauerhafte äußere Gegensätze fixiert.","refs":["CH_GB18_A_18:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_24:RMD-01","text":"Die Grenze behält ihre stabile Identität als Bestimmtheit, erweitert aber ihren Geltungsbereich von äußerer Größe über moralische und kosmologische Totalität bis zur Selbstbestimmung des Quantums.","refs":["CH_GB18_A_19:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RMD-02","text":"Das Jenseits wiederkehrt funktional als Gegenbestimmung der Grenze, mutiert jedoch von einem vermeintlich selbständigen Außen zu einem selbst begrenzbaren Quantum.","refs":["CH_GB18_CDUD:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RMD-03","text":"Der schlechte unendliche Progress erscheint zunächst als blockierte Wiederholung, wird aber später als die erste Gestalt einer Bewegung absorbiert, die ihre eigene Äußerlichkeit zurücknimmt.","refs":["CH_GB18_A_18:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RMD-04","text":"Die Negation der Negation verschiebt sich von einer in Anspruch genommenen Forderung wahrhafter Unendlichkeit zu dem im Quantum selbst wirksamen Mechanismus der Vermittlung.","refs":["CH_GB18_A_18:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RMD-05","text":"Der Widerspruch mutiert von einer transzendental verlagerten Schwierigkeit zu einer immanenten Bestimmung der Welt und schließlich zu einer aufhebbare Selbstbeziehung.","refs":["CH_GB18_A_19:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RMD-06","text":"Beziehung tritt nicht mehr als äußerliche Vergleichsform auf, sondern als die Weise, in der Quanta überhaupt ihre qualitative Bestimmtheit erhalten.","refs":["CH_GB18_CDUD:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_24:CGD-01","text":"Die Unterscheidung äußerer Maßlosigkeit und innerer Inhaltsleere bleibt als lokale Diagnose bestimmter Formen von Erhabenheit erhalten, wird aber auf der Clusterebene der allgemeinen Form äußerlicher Unendlichkeit untergeordnet.","refs":["CH_GB18_A_18:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:CGD-02","text":"Die je besondere Zirkularität der zeitlichen und räumlichen Antinomiebeweise ist lokal, während ihr gegenwärtiger systemischer Wert in der Offenlegung eines allgemeinen Zusammenhangs von Voraussetzung und Resultat liegt.","refs":["CH_GB18_A_19:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:CGD-03","text":"Die Opposition von Wille und Natur bleibt eine spezifische Konfiguration, wird aber nur dort clustertragend, wo sie als Modell einer Einheit gilt, die ihre Unterschiede nicht äußerlich nebeneinander bestehen lassen kann.","refs":["CH_GB18_A_18:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:CGD-04","text":"Die technische Ableitung des quantitativen Verhältnisses bleibt eine lokale Logik des Quantums, während die höhere Struktur in der Reorganisation von Qualität als relationaler Selbstbestimmung liegt.","refs":["CH_GB18_CDUD:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_24:GNX-01","text":"Unendlichkeit wird gegen ihre Gleichsetzung mit bloßer Addition, numerischer Ausdehnung oder kumulativer Unabschließbarkeit bestimmt.","refs":["CH_GB18_A_18:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GNX-02","text":"Die subjektive Verlagerung eines Widerspruchs wird ausgeschlossen, weil sie keine Aufhebung seiner objektiven Bewegungsform leistet.","refs":["CH_GB18_A_19:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GNX-03","text":"Selbstbestimmung darf weder unmittelbare Innerlichkeit noch Abstraktion von Äußerlichkeit sein, sondern muß durch Vermittlung hindurchgehen.","refs":["CH_GB18_CDUD:DNX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GNX-04","text":"Beweisformen, die ihre Voraussetzungen außerhalb ihrer Resultate halten wollen, werden als unzulässig zurückgewiesen.","refs":["CH_GB18_A_19:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GNX-05","text":"Moralität wird nicht als ewige Dauerform eines äußerlich fixierten Kampfes zugelassen.","refs":["CH_GB18_A_18:NX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_24:DBN-01","text":"Ausgeschlossen ist ein endgültiges Jenseits, das als dauerhaftes Außen des Endlichen existieren und dennoch dessen Wahrheit bestimmen könnte.","refs":["CH_GB18_A_18:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:DBN-02","text":"Ausgeschlossen ist eine widerspruchsfreie Weltgegebenheit, die dem Denken als fertige Totalität vorausläge.","refs":["CH_GB18_A_19:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:DBN-03","text":"Ausgeschlossen ist ein neutrales Außen von Zeit, Raum oder Quantität, das durch Beziehung unberührt bliebe.","refs":["CH_GB18_A_19:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:DBN-04","text":"Ausgeschlossen ist eine Beziehung, die selbständigen Entitäten erst nachträglich hinzugefügt werden könnte.","refs":["CH_GB18_CDUD:DNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_24:BSA-01","text":"Die Abwesenheit eines äußersten Jenseits organisiert die gesamte Bewegungslogik: Kein Außen bleibt dem Prozeß der Begrenzung und Rücknahme entzogen.","refs":["CH_GB18_CDUD:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:BSA-02","text":"Verwehrt ist eine unmittelbare Identität, die ihre Andersheit nicht negiert, vermittelt und als eigenes Moment bewahrt.","refs":["CH_GB18_CDUD:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:BSA-03","text":"Unzulässig ist ein Denken, das den Widerspruch entweder vollständig der Welt abspricht oder ihn im Geist als dauerhafte Unauflösbarkeit konserviert.","refs":["CH_GB18_A_19:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_24:XD-01","text":"Die Kritik der Antinomiebeweise und die Kritik des quantitativen Progresses konvergieren darin, daß beide die Wiederholung einer vorausgesetzten Grenze als deren angebliche Überwindung ausgeben.","refs":["CL_GB18_24:GA-02","CL_GB18_24:GA-05","CH_GB18_A_19:SD2","CH_GB18_A_18:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:XD-02","text":"Das Quantum liefert die immanente Umkehrung der früheren Kritik: Das Jenseits wird nicht durch ein größeres Jenseits überwunden, sondern dadurch, daß seine Äußerlichkeit selbst als quantitative Bestimmung begriffen wird.","refs":["CL_GB18_24:GA-03","CL_GB18_24:GA-06","CH_GB18_A_18:SD4","CH_GB18_CDUD:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:XD-03","text":"Widerspruch wird nur dort produktiv, wo er nicht bloß als Weltverfall erlitten oder als subjektiver Schein verlegt wird, sondern die Äußerlichkeit einer Bestimmung in deren Selbstverhältnis überführt.","refs":["CL_GB18_24:GA-06","CL_GB18_24:GA-09","CH_GB18_A_19:A10","CH_GB18_CDUD:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:XD-04","text":"Die moralische Sehnsucht nach Vollendung und die kosmologische Suche nach einer abgeschlossenen Totalität sind verschiedene Ausdrucksformen derselben Unfähigkeit, Einheit ohne äußeres Ziel zu denken.","refs":["CL_GB18_24:GA-02","CL_GB18_24:GA-04","CH_GB18_A_18:SD1","CH_GB18_A_19:SNX1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:XD-05","text":"Die Wiederherstellung von Qualität kann nicht als Rückkehr zu isolierter Bestimmtheit erfolgen, weil jedes Quantum nur im Verhältnis zu anderem Quantum bestimmt ist.","refs":["CL_GB18_24:GA-07","CL_GB18_24:GA-08","CH_GB18_CDUD:SD3","CH_GB18_CDUD:A13"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:XD-06","text":"Moralischer Fortschritt und kosmologische Unendlichkeit verlieren ihren Status als positive Teleologien, sobald beide als Formen eines durch äußere Vollendung stabilisierten Mangels lesbar werden.","refs":["CL_GB18_24:GA-02","CL_GB18_24:GA-10","CH_GB18_A_18:ME3","CH_GB18_A_19:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_24:BSD-01","text":"Die Geltung eines Begriffs entscheidet sich nicht an einem äußerlich vorliegenden Resultat, sondern daran, ob sein Vollzug die Voraussetzungen, die er benötigt, immanent erzeugt und transformiert.","refs":["CL_GB18_24:GA-05","CL_GB18_24:GA-06","CH_GB18_A_19:ME2","CH_GB18_CDUD:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:BSD-02","text":"Zeitliche, räumliche, moralische und quantitative Unendlichkeit werden als Varianten einer einzigen Differenz reorganisiert: zwischen äußerer Fortsetzung und immanenter Selbstvermittlung.","refs":["CL_GB18_24:GA-03","CL_GB18_24:GA-08","CH_GB18_A_18:ALT4","CH_GB18_CDUD:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:BSD-03","text":"Das Subjekt verliert die Gestalt eines abstrakten Überschreiters und gewinnt nur als widerspruchsfähige Instanz begriffliche Handlungsmacht.","refs":["CL_GB18_24:GA-09","CL_GB18_24:GA-10","CH_GB18_A_18:A5","CH_GB18_A_19:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:BSD-04","text":"Realität wird als Prozess bestimmt, in dem ein Bestimmtes gerade durch die Rückkehr aus seiner eigenen Äußerlichkeit bei sich ist.","refs":["CL_GB18_24:GA-07","CL_GB18_24:GA-09","CH_GB18_CDUD:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:BSD-05","text":"Quantitative Relation erscheint nicht als nachträgliche Ordnung bereits bestimmter Größen, sondern als ontologische Form ihrer gegenseitigen Bestimmtheit.","refs":["CL_GB18_24:GA-07","CL_GB18_24:GA-08","CH_GB18_A_19:ME5","CH_GB18_CDUD:D8"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_24:RLE-01","text":"Grenze → Jenseits → erneute Grenze bildet die negative Rekursionsschleife, in der der schlechte Progress seine eigene Voraussetzung reproduziert.","refs":["CH_GB18_A_19:A2","CH_GB18_A_18:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RLE-02","text":"Der Beweis einer Grenze setzt den Endpunkt voraus, während der Beweis ihrer Unendlichkeit eine endlose Bedingtheit voraussetzt; beide Pfade kehren in ihre unbewiesene Ausgangsbestimmung zurück.","refs":["CH_GB18_A_19:D1","CH_GB18_A_19:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RLE-03","text":"Die Eskalation kippt, sobald die äußerliche Bestimmtheit nicht mehr als fremdes Nichtsein behandelt, sondern als Quantum des Quantums selbst begriffen wird.","refs":["CH_GB18_CDUD:D1","CH_GB18_CDUD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RLE-04","text":"Negation des Quantums → Negation dieser Negation → vermittelte Fürsichbestimmung bildet die positive Schleife, welche die Wiederholung in Selbstvermittlung transformiert.","refs":["CH_GB18_CDUD:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RLE-05","text":"Der Attraktor des Clusters ist die vermittelte Identität: Ein Bestimmtes bleibt nur bei sich, indem es seine Selbstverschiedenheit als innere Bedingung seiner Einheit durchläuft.","refs":["CH_GB18_CDUD:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_24:FGS-B01","text":"Äußerliche Grenze → quantitatives Überschreiten → Wiederkehr der Grenze → schlechte Unendlichkeit.","refs":["CH_GB18_A_18:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FGS-B02","text":"Kosmologische Alternative → zirkuläre Voraussetzung beider Seiten → Enthüllung ihrer gemeinsamen Grenzlogik.","refs":["CH_GB18_A_19:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FGS-B03","text":"Transzendentale Verlagerung → Erhaltung des Widerspruchs im Bewußtsein → Kritik der bloßen Subjektivierung.","refs":["CH_GB18_A_19:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FGS-B04","text":"Quantum mit äußerlicher Bestimmtheit → Jenseits als Quantum → Begrenzung des Jenseits → Rücknahme des Außen.","refs":["CH_GB18_CDUD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FGS-B05","text":"Erste Negation → Negation der Negation → Äußerlichkeit als eigenes Moment → vermittelte Fürsichbestimmung.","refs":["CH_GB18_CDUD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FGS-B06","text":"Vermittelte Fürsichbestimmung → Repulsion in mehrere Quanta → Verhältnis → qualitative Einheit der Relation.","refs":["CH_GB18_CDUD:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_24:AFM-B01","text":"Bildhafte oder moralische Unendlichkeit → Diagnose der Wiederholung → Antinomie als Grenzlogik → Kritik der subjektiven Verlagerung → Selbstquantifizierung des Jenseits → Negation der Negation → relationale Selbstbestimmung.","refs":["CH_GB18_CDUD:ME1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_24:MME-01","text":"Quantitative Größe wird von einem Index der Unendlichkeit zu einer Form ihrer anfänglichen Verfehlung und möglichen Vermittlung umkartiert.","refs":["CH_GB18_A_18:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MME-02","text":"Zeitliche und räumliche Antinomien erscheinen nicht mehr als getrennte Probleme, sondern als Varianten derselben Bewegung von Grenze und Jenseits.","refs":["CH_GB18_A_19:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MME-03","text":"Das Unendliche wird vom transzendenten Gegenstand zu einem immanenten Vermittlungsmoment der quantitativen Bestimmtheit reklassifiziert.","refs":["CH_GB18_CDUD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MME-04","text":"Quanta werden nicht mehr als isolierte Größen kartiert, sondern als relationale Momente einer Einheit, die ihre Bestimmtheit erst im Verhältnis gewinnt.","refs":["CH_GB18_CDUD:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MME-05","text":"Beweise werden von Instrumenten äußerlicher Rechtfertigung zu diagnostischen Orten, an denen die im Resultat wirksamen Voraussetzungen sichtbar werden.","refs":["CH_GB18_A_19:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_24:ALT-B01","text":"Surface level — Untersucht werden unendliche Zahlen, Räume, Zeiten, Weltgrößen, moralische Vollendung und das unendliche Quantum.","refs":["CH_GB18_A_18:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:ALT-B02","text":"Structural level — Jede bestimmte Grenze erzeugt ihr Jenseits, das sie negiert und zugleich als neue Bestimmung reproduziert.","refs":["CH_GB18_A_19:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:ALT-B03","text":"Metastrategic level — Philosophische Systeme werden danach unterschieden, ob sie Widerspruch vermitteln oder ihn als Erhabenheit, Streben, Beweisresultat oder subjektiven Schein konservieren.","refs":["CH_GB18_A_18:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:ALT-B04","text":"Ontological / Temporal level — Unendlichkeit bezeichnet keine entfernte Endposition, sondern die Selbstbewegung, in der Quantität ihre äußere Bestimmtheit als eigenes Moment zurücknimmt.","refs":["CH_GB18_CDUD:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:ALT-B05","text":"Methodological / Performative level — Die Kritik vollzieht ihre These dadurch, daß sie argumentative Formen auf die von ihnen verdeckten Voraussetzungen zurückführt.","refs":["CH_GB18_A_19:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_24:FL-01","text":"Der unendliche Progreß wird einerseits als schlechte Wiederholung verworfen, andererseits als Träger der Negation der Negation bestimmt; die Kohärenz hängt daran, ob zwischen äußerem Fortschreiten und immanenter Selbstaufhebung scharf unterschieden wird.","refs":["CH_GB18_A_18:A1","CH_GB18_CDUD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FL-02","text":"Die Welt besitzt den Widerspruch, kann ihn aber nicht tragen, während der Geist ihn aufheben soll; die genaue Vermittlung zwischen Weltwiderspruch und geistiger Auflösung bleibt nur behauptet.","refs":["CH_GB18_A_19:A10","CH_GB18_A_19:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FL-03","text":"Zeit wird als reine Quantität bestimmt, doch die Analyse der Antinomie operiert zugleich mit qualitativen Endpunkten, deren Status zwischen Kritikobjekt und notwendiger Bestimmung oszilliert.","refs":["CH_GB18_A_19:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FL-04","text":"Die relationale Einheit wird als Resultat der Repulsion gesetzt, obwohl offenbleibt, wie sie ihre abschließende Form behalten kann, ohne erneut zu einer äußerlichen Ordnung der Quanta zu werden.","refs":["CH_GB18_CDUD:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MP-01","text":"Das Jenseits mutiert von der vermeintlich absoluten Außenposition zu einer selbst quantitativen und daher begrenzbaren Bestimmung.","refs":["CH_GB18_CDUD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MP-02","text":"Negation mutiert von der ersten Aufhebung unmittelbarer Bestimmtheit zur Negation der Negation, die Äußerlichkeit in vermittelte Einheit überführt.","refs":["CH_GB18_A_18:A10","CH_GB18_CDUD:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MP-03","text":"Qualität mutiert von einem durch Quantifizierung scheinbar verlorenen Gegenprinzip zu der durch quantitative Relation erzeugten Selbstbestimmung.","refs":["CH_GB18_A_18:AS5","CH_GB18_CDUD:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MP-04","text":"Das Subjekt mutiert vom abstrakten reinen Ich zur widerspruchsfähigen Instanz, deren Bestimmung nicht in Abstraktion, sondern in begrifflicher Aufhebung liegt.","refs":["CH_GB18_A_18:A5","CH_GB18_A_19:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_24:HSI-01","text":"Realität erscheint als eine Maschine gesetzter Grenzen, deren jede ihre eigene Überschreitung produziert und erst durch deren immanente Rücknahme bestimmt wird.","refs":["CH_GB18_A_19:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:HSI-02","text":"Das Bestimmte ist keine geschlossene Einheit, sondern eine durch ihre Äußerlichkeit vermittelte Selbstbeziehung.","refs":["CH_GB18_CDUD:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:HSI-03","text":"Zeit ist nicht bloß ein Behälter des Fortschreitens, sondern die quantitative Form, in der jeder feste Endpunkt seine eigene Aufhebung enthält.","refs":["CH_GB18_A_19:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:HSI-04","text":"Handlungsmacht bleibt nur als Fähigkeit möglich, Widerspruch nicht durch äußeres Überschreiten zu verlängern, sondern die eigene Äußerlichkeit in vermittelte Bestimmtheit umzuwandeln.","refs":["CH_GB18_A_19:A11","CH_GB18_CDUD:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_24:MRT-B01","text":"Die extrahierten Axiome reichen aus, um den Übergang von äußerer Grenze über schlechte Unendlichkeit und Antinomie bis zur relationalen Selbstbestimmung des Quantums zu rekonstruieren.","refs":["CH_GB18_CDUD:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MRT-B02","text":"Unterbestimmt bleibt der konkrete begriffliche Vollzug, durch den die dem Geist zugeschriebene Aufhebung des Widerspruchs über die formale Möglichkeit hinaus realisiert wird.","refs":["CH_GB18_A_19:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MRT-B03","text":"Die Architektur bleibt kohärent, sofern quantitative Wiederholung, abstrakte Gegenüberstellung und äußerliche Einheit als Varianten derselben unaufgehobenen Negativität behandelt werden.","refs":["CH_GB18_A_18:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MRT-B04","text":"Die Rekonstruktion hängt irreduzibel von der komprimierten Gleichsetzung von Unendlichkeit, Qualität und Fürsichsein ab; diese Verdichtung ist zugleich ihre größte systematische Produktivität und ihre stärkste Belastungszone.","refs":["CH_GB18_CDUD:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MRT-B05","text":"Die tatsächliche Bewegung bleibt erhalten, wenn der Übergang vom Widerspruch über die Negation der Negation zur relationalen Bestimmtheit nicht als lineare Abfolge, sondern als Rücknahme einer reproduzierten Äußerlichkeit gelesen wird.","refs":["CH_GB18_CDUD:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121601076217Z_642eba0b","language_code":"en","language_name":"English","title":"Chapters 70–72","source_sha256":"090b1ecbae75d913bcc14baab64944e0e402787fdab0f26299e3d27ce00ecfe8","sha256":"8c2299c13d9a3850a451c033ce756daf224b44175c9cf4c57ad9bea3a91e9d43","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:16:01.077831+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_24:AS-B01","text":"The cluster initially determines infinity as a problem of a limit whose external transgression does not abolish the limit but reproduces it in altered form.","refs":["CH_GB18_A_18:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B02","text":"The infinite posited as an independent beyond remains finite because it exists only as a counter-position to the finite and depends on its limit.","refs":["CH_GB18_A_18:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B03","text":"The cosmological antinomy makes visible that both limitation and limitlessness presuppose their own results and thereby circularly enact the same movement of the limit.","refs":["CH_GB18_A_19:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B04","text":"The displacement of contradiction into consciousness or subjectivity does not suspend its objective structure, but merely shifts the site of its appearance.","refs":["CH_GB18_A_19:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B05","text":"At the level of the quantum, bad infinity is not merely rejected, but determined as a necessary form of a determinacy that has initially become external.","refs":["CH_GB18_CDUD:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B06","text":"Because the beyond is itself quantum, it cannot subsist as an absolute outside; its limitation takes externality back into quantitative movement.","refs":["CH_GB18_CDUD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B07","text":"The return from external infinity does not restore a pre-quantitative quality, but produces qualitative determinacy as the relation of mutually dependent quanta.","refs":["CH_GB18_CDUD:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:AS-B08","text":"The closure of the cluster consists in a relational infinity in which a determinate is with itself only through the mediation of its externality.","refs":["CH_GB18_CDUD:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_24:GA-01","text":"[Persistent] Every posited limit contains a beyond through which it undermines its asserted independence.","refs":["CH_GB18_A_19:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-02","text":"[Persistent] Mere quantitative progress remains bad infinity insofar as every sublation generates only a new limit.","refs":["CH_GB18_A_18:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-03","text":"[Mutating] Infinite progress changes its status from a symptom of failed mediation to a necessary passage as soon as its externality is comprehended as an immanent moment of the quantum.","refs":["CH_GB18_CDUD:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-04","text":"[Persistent] A beyond possesses no independent reality because it is determined solely through its relation to what is limited.","refs":["CH_GB18_A_19:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-05","text":"[Emergent] Circular proofs are not merely methodological errors, but argumentative enactments of the same unresolved structure of the limit that they are supposed demonstratively to decide.","refs":["CH_GB18_A_19:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-06","text":"[Mutating] Negation of negation does not mean flight from the negative, but the transformation of externality into a moment proper to determinacy.","refs":["CH_GB18_CDUD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-07","text":"[Emergent] Quality appears not as a counter-principle to quantity, but as quantity's mediated self-determination through its relation.","refs":["CH_GB18_CDUD:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-08","text":"[Terminal] Identity is possible only as unity mediated through self-difference, and not as immediate self-sameness.","refs":["CH_GB18_CDUD:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-09","text":"[Attractor] Spirit designates the capacity not merely to suffer or displace contradiction, but to sublate it conceptually.","refs":["CH_GB18_A_19:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GA-10","text":"[Attractor] True infinity is the self-sublation of that form which fixes finite and infinite as enduring external opposites.","refs":["CH_GB18_A_18:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_24:RMD-01","text":"The limit retains its stable identity as determinacy, but extends its scope from external magnitude through moral and cosmological totality to the self-determination of the quantum.","refs":["CH_GB18_A_19:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RMD-02","text":"The beyond recurs functionally as the counter-determination of the limit, yet mutates from a supposedly independent outside into a quantum itself capable of being limited.","refs":["CH_GB18_CDUD:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RMD-03","text":"Bad infinite progress initially appears as blocked repetition, but is later absorbed as the first form of a movement that retracts its own externality.","refs":["CH_GB18_A_18:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RMD-04","text":"Negation of negation shifts from a claimed demand of true infinity to the mechanism of mediation operative within the quantum itself.","refs":["CH_GB18_A_18:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RMD-05","text":"Contradiction mutates from a transcendentally displaced difficulty into an immanent determination of the world and finally into a self-relation capable of sublation.","refs":["CH_GB18_A_19:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RMD-06","text":"Relation no longer appears as an external form of comparison, but as the manner in which quanta receive their qualitative determinacy at all.","refs":["CH_GB18_CDUD:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_24:CGD-01","text":"The distinction between external excessiveness and internal emptiness of content remains as a local diagnosis of particular forms of sublimity, but at the cluster level is subordinated to the general form of external infinity.","refs":["CH_GB18_A_18:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:CGD-02","text":"The respective particular circularity of the temporal and spatial antinomy proofs is local, whereas their present systemic value lies in disclosing a general connection between presupposition and result.","refs":["CH_GB18_A_19:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:CGD-03","text":"The opposition of will and nature remains a specific configuration, but becomes cluster-bearing only where it counts as a model of a unity that cannot allow its differences to subsist externally alongside one another.","refs":["CH_GB18_A_18:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:CGD-04","text":"The technical derivation of quantitative relation remains a local logic of the quantum, whereas the higher structure lies in the reorganization of quality as relational self-determination.","refs":["CH_GB18_CDUD:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_24:GNX-01","text":"Infinity is determined against its equation with mere addition, numerical extension, or cumulative interminability.","refs":["CH_GB18_A_18:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GNX-02","text":"The subjective displacement of a contradiction is excluded because it accomplishes no sublation of its objective form of movement.","refs":["CH_GB18_A_19:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GNX-03","text":"Self-determination may be neither immediate inwardness nor abstraction from externality, but must pass through mediation.","refs":["CH_GB18_CDUD:DNX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GNX-04","text":"Forms of proof that seek to keep their presuppositions outside their results are rejected as inadmissible.","refs":["CH_GB18_A_19:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:GNX-05","text":"Morality is not admitted as an eternal enduring form of an externally fixed struggle.","refs":["CH_GB18_A_18:NX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_24:DBN-01","text":"Excluded is a final beyond that could exist as an enduring outside of the finite and yet determine its truth.","refs":["CH_GB18_A_18:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:DBN-02","text":"Excluded is a contradiction-free givenness of the world that would precede thought as a finished totality.","refs":["CH_GB18_A_19:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:DBN-03","text":"Excluded is a neutral outside of time, space, or quantity that would remain untouched by relation.","refs":["CH_GB18_A_19:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:DBN-04","text":"Excluded is a relation that could be subsequently added to independent entities.","refs":["CH_GB18_CDUD:DNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_24:BSA-01","text":"The absence of an ultimate beyond organizes the entire logic of movement: no outside remains exempt from the process of limitation and retraction.","refs":["CH_GB18_CDUD:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:BSA-02","text":"Denied is an immediate identity that does not negate, mediate, and preserve its otherness as its own moment.","refs":["CH_GB18_CDUD:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:BSA-03","text":"Inadmissible is a thought that either completely denies contradiction to the world or preserves it in spirit as enduring irresolvability.","refs":["CH_GB18_A_19:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_24:XD-01","text":"The critique of the antinomy proofs and the critique of quantitative progress converge in that both present the repetition of a presupposed limit as its alleged overcoming.","refs":["CL_GB18_24:GA-02","CL_GB18_24:GA-05","CH_GB18_A_19:SD2","CH_GB18_A_18:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:XD-02","text":"The quantum supplies the immanent reversal of the earlier critique: the beyond is not overcome by a greater beyond, but by comprehending its externality itself as quantitative determinacy.","refs":["CL_GB18_24:GA-03","CL_GB18_24:GA-06","CH_GB18_A_18:SD4","CH_GB18_CDUD:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:XD-03","text":"Contradiction becomes productive only where it is neither merely suffered as the decay of the world nor relocated as subjective appearance, but transfers the externality of a determinacy into its self-relation.","refs":["CL_GB18_24:GA-06","CL_GB18_24:GA-09","CH_GB18_A_19:A10","CH_GB18_CDUD:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:XD-04","text":"The moral longing for completion and the cosmological search for a closed totality are different expressions of the same incapacity to think unity without an external goal.","refs":["CL_GB18_24:GA-02","CL_GB18_24:GA-04","CH_GB18_A_18:SD1","CH_GB18_A_19:SNX1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:XD-05","text":"The restoration of quality cannot occur as a return to isolated determinacy, because every quantum is determined only in relation to another quantum.","refs":["CL_GB18_24:GA-07","CL_GB18_24:GA-08","CH_GB18_CDUD:SD3","CH_GB18_CDUD:A13"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:XD-06","text":"Moral progress and cosmological infinity lose their status as positive teleologies as soon as both become readable as forms of a deficiency stabilized by external completion.","refs":["CL_GB18_24:GA-02","CL_GB18_24:GA-10","CH_GB18_A_18:ME3","CH_GB18_A_19:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_24:BSD-01","text":"The validity of a concept is decided not by an externally given result, but by whether its enactment immanently generates and transforms the presuppositions it requires.","refs":["CL_GB18_24:GA-05","CL_GB18_24:GA-06","CH_GB18_A_19:ME2","CH_GB18_CDUD:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:BSD-02","text":"Temporal, spatial, moral, and quantitative infinity are reorganized as variants of a single difference: between external continuation and immanent self-mediation.","refs":["CL_GB18_24:GA-03","CL_GB18_24:GA-08","CH_GB18_A_18:ALT4","CH_GB18_CDUD:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:BSD-03","text":"The subject loses the form of an abstract transgressor and gains conceptual agency only as an instance capable of contradiction.","refs":["CL_GB18_24:GA-09","CL_GB18_24:GA-10","CH_GB18_A_18:A5","CH_GB18_A_19:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:BSD-04","text":"Reality is determined as a process in which a determinate is with itself precisely through the return from its own externality.","refs":["CL_GB18_24:GA-07","CL_GB18_24:GA-09","CH_GB18_CDUD:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_24:BSD-05","text":"Quantitative relation appears not as a subsequent ordering of already determinate magnitudes, but as the ontological form of their reciprocal determinacy.","refs":["CL_GB18_24:GA-07","CL_GB18_24:GA-08","CH_GB18_A_19:ME5","CH_GB18_CDUD:D8"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_24:RLE-01","text":"Limit → beyond → renewed limit forms the negative recursive loop in which bad progress reproduces its own presupposition.","refs":["CH_GB18_A_19:A2","CH_GB18_A_18:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RLE-02","text":"The proof of a limit presupposes the endpoint, whereas the proof of its infinity presupposes endless conditionedness; both paths return to their unproven initial determination.","refs":["CH_GB18_A_19:D1","CH_GB18_A_19:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RLE-03","text":"The escalation overturns as soon as external determinacy is no longer treated as alien non-being, but comprehended as quantum of the quantum itself.","refs":["CH_GB18_CDUD:D1","CH_GB18_CDUD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RLE-04","text":"Negation of the quantum → negation of this negation → mediated determination-for-self forms the positive loop that transforms repetition into self-mediation.","refs":["CH_GB18_CDUD:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:RLE-05","text":"The attractor of the cluster is mediated identity: a determinate remains with itself only by passing through its self-difference as the inner condition of its unity.","refs":["CH_GB18_CDUD:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_24:FGS-B01","text":"External limit → quantitative transgression → return of the limit → bad infinity.","refs":["CH_GB18_A_18:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FGS-B02","text":"Cosmological alternative → circular presupposition of both sides → disclosure of their shared logic of the limit.","refs":["CH_GB18_A_19:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FGS-B03","text":"Transcendental displacement → preservation of contradiction in consciousness → critique of mere subjectivization.","refs":["CH_GB18_A_19:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FGS-B04","text":"Quantum with external determinacy → beyond as quantum → limitation of the beyond → retraction of the outside.","refs":["CH_GB18_CDUD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FGS-B05","text":"First negation → negation of negation → externality as its own moment → mediated determination-for-self.","refs":["CH_GB18_CDUD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FGS-B06","text":"Mediated determination-for-self → repulsion into several quanta → relation → qualitative unity of relation.","refs":["CH_GB18_CDUD:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_24:AFM-B01","text":"Figurative or moral infinity → diagnosis of repetition → antinomy as logic of the limit → critique of subjective displacement → self-quantification of the beyond → negation of negation → relational self-determination.","refs":["CH_GB18_CDUD:ME1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_24:MME-01","text":"Quantitative magnitude is remapped from an index of infinity into a form of its initial failure and possible mediation.","refs":["CH_GB18_A_18:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MME-02","text":"Temporal and spatial antinomies no longer appear as separate problems, but as variants of the same movement of limit and beyond.","refs":["CH_GB18_A_19:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MME-03","text":"The infinite is reclassified from a transcendent object into an immanent moment of mediation of quantitative determinacy.","refs":["CH_GB18_CDUD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MME-04","text":"Quanta are no longer mapped as isolated magnitudes, but as relational moments of a unity that attains its determinacy only in relation.","refs":["CH_GB18_CDUD:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MME-05","text":"Proofs are transformed from instruments of external justification into diagnostic sites where the presuppositions operative in the result become visible.","refs":["CH_GB18_A_19:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_24:ALT-B01","text":"Surface level — Infinite numbers, spaces, times, magnitudes of the world, moral completion, and the infinite quantum are examined.","refs":["CH_GB18_A_18:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:ALT-B02","text":"Structural level — Every determinate limit produces its beyond, which negates it and at the same time reproduces it as a new determination.","refs":["CH_GB18_A_19:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:ALT-B03","text":"Metastrategic level — Philosophical systems are distinguished according to whether they mediate contradiction or preserve it as sublimity, striving, result of proof, or subjective appearance.","refs":["CH_GB18_A_18:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:ALT-B04","text":"Ontological / Temporal level — Infinity does not designate a distant final position, but the self-movement in which quantity retracts its external determinacy as its own moment.","refs":["CH_GB18_CDUD:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:ALT-B05","text":"Methodological / Performative level — The critique enacts its thesis by tracing argumentative forms back to the presuppositions concealed by them.","refs":["CH_GB18_A_19:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_24:FL-01","text":"Infinite progress is on the one hand rejected as bad repetition and on the other determined as the bearer of negation of negation; coherence depends on whether external progression and immanent self-sublation are sharply distinguished.","refs":["CH_GB18_A_18:A1","CH_GB18_CDUD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FL-02","text":"The world possesses contradiction but cannot bear it, whereas spirit is supposed to sublate it; the precise mediation between contradiction in the world and spiritual resolution remains merely asserted.","refs":["CH_GB18_A_19:A10","CH_GB18_A_19:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FL-03","text":"Time is determined as pure quantity, yet the analysis of the antinomy simultaneously operates with qualitative endpoints whose status oscillates between object of critique and necessary determination.","refs":["CH_GB18_A_19:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:FL-04","text":"Relational unity is posited as the result of repulsion, although it remains open how it can retain its conclusive form without again becoming an external ordering of quanta.","refs":["CH_GB18_CDUD:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MP-01","text":"The beyond mutates from the supposedly absolute external position into a determination that is itself quantitative and therefore limitable.","refs":["CH_GB18_CDUD:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MP-02","text":"Negation mutates from the first sublation of immediate determinacy to negation of negation, which transfers externality into mediated unity.","refs":["CH_GB18_A_18:A10","CH_GB18_CDUD:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MP-03","text":"Quality mutates from a counter-principle apparently lost through quantification into the self-determination generated through quantitative relation.","refs":["CH_GB18_A_18:AS5","CH_GB18_CDUD:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MP-04","text":"The subject mutates from the abstract pure I into an instance capable of contradiction, whose determination lies not in abstraction but in conceptual sublation.","refs":["CH_GB18_A_18:A5","CH_GB18_A_19:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_24:HSI-01","text":"Reality appears as a machine of posited limits, each of which produces its own transgression and is determined only through its immanent retraction.","refs":["CH_GB18_A_19:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:HSI-02","text":"The determinate is not a closed unity, but a self-relation mediated through its externality.","refs":["CH_GB18_CDUD:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:HSI-03","text":"Time is not merely a container of progression, but the quantitative form in which every fixed endpoint contains its own sublation.","refs":["CH_GB18_A_19:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:HSI-04","text":"Agency remains possible only as the capacity not to prolong contradiction through external transgression, but to transform one's own externality into mediated determinacy.","refs":["CH_GB18_A_19:A11","CH_GB18_CDUD:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_24:MRT-B01","text":"The extracted axioms suffice to reconstruct the transition from external limit through bad infinity and antinomy to the relational self-determination of the quantum.","refs":["CH_GB18_CDUD:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MRT-B02","text":"What remains underdetermined is the concrete conceptual enactment through which the sublation of contradiction attributed to spirit is realized beyond formal possibility.","refs":["CH_GB18_A_19:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MRT-B03","text":"The architecture remains coherent insofar as quantitative repetition, abstract opposition, and external unity are treated as variants of the same unsublated negativity.","refs":["CH_GB18_A_18:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MRT-B04","text":"The reconstruction irreducibly depends on the compressed equation of infinity, quality, and being-for-self; this condensation is at once its greatest systematic productivity and its strongest zone of strain.","refs":["CH_GB18_CDUD:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_24:MRT-B05","text":"The actual movement is preserved if the transition from contradiction through negation of negation to relational determinacy is read not as a linear sequence, but as the retraction of a reproduced externality.","refs":["CH_GB18_CDUD:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_24@R001","source_variant_id":"canonical:CL_GB18_24:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 70–72","context":"Anmerkung 1. · Anmerkung 2. · c. Die Unendlichkeit des Quantums."},"title_language_code":"en"},{"id":"CL_GB18_25","layer":"CL","title":"Chapters 73–75","order":25,"parents":["CH_GB18_A1DB","CH_GB18_A2DZ","CH_GB18_A3NA"],"revision":"CL_GB18_25@R001","sha256":"014dbbab92fa57c7c75f0466f64535141b5327e8a580946c1ad0863bcbe0bedc","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_25:AS-01","text":"Das System bearbeitet den Widerspruch, dass mathematische Verfahren exakte Resultate erzeugen, obwohl ihre Operationen und Selektionsregeln begrifflich unzureichend gerechtfertigt bleiben.","refs":["CH_GB18_A1DB:AS1","CH_GB18_A2DZ:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-02","text":"Es bestimmt mathematische Legitimität neu als Übereinstimmung formaler Operationen mit einer affirmativen qualitativen Größenrelation, die im Gegenstand unabhängig nachgewiesen werden muss.","refs":["CH_GB18_A1DB:A5","CH_GB18_A2DZ:A11","CH_GB18_A3NA:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-03","text":"Das Unendlichkleine verliert den Rang eines positiven Gegenstands und wird zum negativen Index einer noch nicht explizierten relationalen, funktionalen oder dimensionalen Vermittlung.","refs":["CH_GB18_A2DZ:A15","CH_GB18_A3NA:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-04","text":"Die Anwendung ist nicht äußerer Vollzug einer fertigen Theorie, sondern konstitutiver Ort, an dem Gegenstand, Zweck, Typisierung und Geltungsbedingungen des Verfahrens hervortreten.","refs":["CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:A4","CH_GB18_A3NA:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-05","text":"Die Bewegung führt von der Aufhebung selbständiger Quanta über Potenzenverhältnisse zur geometrischen Dimensionstypisierung und damit von negativer Unendlichkeit zur affirmativen Bestimmung des operativen Übergangs.","refs":["CH_GB18_A1DB:AS5","CH_GB18_A3NA:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-06","text":"Das Argument arbeitet rekursiv und mutationsgetrieben: Jeder Rückfall in endliche Quantität, formale Homogenität oder äußerliche Aggregation erzwingt eine erneute Rekonstruktion der qualitativen Relation.","refs":["CH_GB18_A2DZ:AS6","CH_GB18_A1DB:A14","CH_GB18_A3NA:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-07","text":"Die relative Schließung besteht in der Trennung formaler Erzeugung, gegenständlicher Bedeutungszuweisung, unabhängigen Relationsbeweises und ontologischer Existenzbehauptung.","refs":["CH_GB18_A2DZ:A12","CH_GB18_A1DB:NX10","CH_GB18_A3NA:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-08","text":"Diese Schließung bleibt bedingt, weil weder die vollständige Rückführung aller Funktionsformen auf Potenzenverhältnisse noch die allgemeine Überführung variabler Kontinua in typisierte Produktstrukturen demonstriert wird.","refs":["CH_GB18_A2DZ:SNX4","CH_GB18_A2DZ:MRT8","CH_GB18_A3NA:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_25:GA-01","text":"[Persistent] Die Richtigkeit oder historische Brauchbarkeit eines Resultats ersetzt weder die Notwendigkeit des erzeugenden Verfahrens noch den Beweis seines Gegenstandsverhältnisses.","refs":["CH_GB18_A1DB:A1","CH_GB18_A2DZ:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-02","text":"[Attractor] Der affirmative Grund mathematischer Bestimmtheit ist eine qualitative Relation, in der quantitative Momente ihre Bedeutung durch gegenseitige Bestimmung erhalten.","refs":["CH_GB18_A1DB:A6","CH_GB18_A2DZ:A5","CH_GB18_A3NA:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-03","text":"[Mutating] Quantität bleibt nach Aufhebung ihrer Selbständigkeit nicht als verschwindendes Ding, sondern als unselbständiges Moment eines Verhältnisses erhalten.","refs":["CH_GB18_A1DB:AS4","CH_GB18_A2DZ:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-04","text":"[Mutating] Unendlichkeit wandelt sich vom äußeren Progress oder extremen Quantum zur immanenten Vollständigkeit einer Relation und zur Invarianz qualitativer Bestimmung.","refs":["CH_GB18_A1DB:A4","CH_GB18_A2DZ:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-05","text":"[Persistent] Das Potenzenverhältnis bildet den spezifischen qualitativen Grund des Differential- und Integralkalküls, nicht Veränderlichkeit, Kontinuität oder Kleinheit als solche.","refs":["CH_GB18_A1DB:A10","CH_GB18_A2DZ:A6","CH_GB18_A2DZ:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-06","text":"[Emergent] Formale Erzeugung und konkrete Interpretation sind getrennte Beweisordnungen; keine Operation erzeugt ihre Gegenstandssemantik allein aus ihrer Syntax.","refs":["CH_GB18_A2DZ:A12","CH_GB18_A2DZ:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-07","text":"[Emergent] Die Anwendung ist konstitutive Erkenntnisquelle, weil erst sie das formale Verhältnis typisiert, seinen Zweck selektiert und seine konkrete Geltung validiert.","refs":["CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:A11","CH_GB18_A2DZ:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-08","text":"[Mutating] Das Infinitesimale ist keine positive Zwischenentität, sondern eine negative Anzeige dafür, dass eine qualitative Operationsbestimmung noch verdeckt ist.","refs":["CH_GB18_A1DB:SNX2","CH_GB18_A2DZ:SNX2","CH_GB18_A3NA:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-09","text":"[Emergent] Analytische Bestimmung, geometrische oder physische Interpretation und reale Existenz gehören verschiedenen Begründungsordnungen an.","refs":["CH_GB18_A1DB:A15","CH_GB18_A2DZ:NX10","CH_GB18_A3NA:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-10","text":"[Emergent] Diskrete Elemente können die Größe eines Kontinuierlichen bestimmen, ohne seine kontinuierliche Existenz ontologisch zusammenzusetzen.","refs":["CH_GB18_A3NA:NX2","CH_GB18_A3NA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-11","text":"[Mutating] Eine formal identische arithmetische Operation kann je nach Typisierung ihrer Operanden entweder quantitativ homogen bleiben oder einen qualitativen Dimensionsübergang vollziehen.","refs":["CH_GB18_A3NA:A1","CH_GB18_A3NA:A8","CH_GB18_A3NA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-12","text":"[Persistent] Weglassung, Diskretisierung und Auswahl sind nur legitim, wenn sie durch qualitative Funktionslosigkeit oder die vollständige Erfassung eines invarianten Bestimmungsmoments begründet werden.","refs":["CH_GB18_A1DB:A13","CH_GB18_A2DZ:D2","CH_GB18_A3NA:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-13","text":"[Terminal] Mathematische Exaktheit entsteht durch die Erhaltung und gegenständliche Validierung einer qualitativen Relation, nicht durch verschwindende Größen, unendliche Aggregation oder ungeprüfte formale Übertragung.","refs":["CH_GB18_A1DB:SD1","CH_GB18_A2DZ:FGS7","CH_GB18_A3NA:D13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_25:RMD-01","text":"Das Potenzenverhältnis bewahrt seine Identität als spezifischer Kalkülgrund, erweitert seine Funktion jedoch vom Differentialbegriff zur Regel qualitativer Invarianz durch quantitative Veränderungen hindurch.","refs":["CH_GB18_A1DB:A10","CH_GB18_A2DZ:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-02","text":"Unendlichkeit kehrt funktional verschieden wieder: als schlechte Unabschließbarkeit, als immanente Vollständigkeit, als fehlende endliche Darstellung und als illegitime Verdeckung eines Qualitätsübergangs.","refs":["CH_GB18_A1DB:SNX3","CH_GB18_A3NA:SD5","CH_GB18_A3NA:ME7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-03","text":"Das Differential mutiert vom vermeintlich kleinen selbständigen Quantum zum Verhältnis von Entwicklungsfunktionen und schließlich zum typisierungsbedürftigen Ausdruck eines Gegenstandsmoments.","refs":["CH_GB18_A1DB:A11","CH_GB18_A2DZ:D6","CH_GB18_A2DZ:ME8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-04","text":"Die Anwendung wird von einer nachgeordneten Verwendung zur begriffserzeugenden und validierenden Instanz umgekehrt.","refs":["CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-05","text":"Die Reihe verliert ihren privilegierten Status als Träger des Unendlichen und bleibt nur als mangelhafte Darstellung, technisches Hilfsmittel oder Index fehlender endlicher Schließung bestehen.","refs":["CH_GB18_A1DB:NX4","CH_GB18_A2DZ:NX5","CH_GB18_A3NA:D11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-06","text":"Summation erfährt eine Valenzumkehr: Als äußerliche Aggregation ist sie dimensionsunfähig, als Erscheinungsform geometrisch typisierter Multiplikation kann sie einen qualitativen Übergang ausdrücken.","refs":["CH_GB18_A3NA:A4","CH_GB18_A3NA:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-07","text":"Das Untheilbare wird aus einer Zusammensetzungsontologie verdrängt und in die höhere Struktur eines invarianten Größenbestimmungsmoments absorbiert.","refs":["CH_GB18_A3NA:A12","CH_GB18_A3NA:SD4","CH_GB18_A3NA:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-08","text":"Das Infinitesimale vollzieht eine terminale Transformation: Sobald der qualitative Übergang affirmativ als Relation, Typisierung oder Multiplikation bestimmt ist, verschwindet seine positive Grundlegungsfunktion.","refs":["CH_GB18_A3NA:A5","CH_GB18_A3NA:D13","CH_GB18_A3NA:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_25:CGD-01","text":"Die einzelnen historischen Begründungen durch Grenzen, Nullen oder Reihen bleiben lokale Diagnosen; nach oben skaliert allein das Muster, dass nichtbegriffliche Grundlegungen endliche Quantitätsbestimmungen wieder einführen.","refs":["CH_GB18_A1DB:D9","CH_GB18_A1DB:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:CGD-02","text":"Tangenten-, Ordinaten- und Flächenkonstruktionen bleiben gegenstandsspezifische Fälle; clustertragend ist die Forderung nach einem unabhängigen Nachweis der Relation zwischen formalem Ergebnis und Gegenstandsmoment.","refs":["CH_GB18_A2DZ:D7","CH_GB18_A2DZ:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:CGD-03","text":"Cavalieris Schnitte und einzelne Produktzerlegungen bleiben lokale Verfahren; global fortbesteht die Trennung diskreter Größenbestimmung von kontinuierlicher Existenz.","refs":["CH_GB18_A3NA:D7","CH_GB18_A3NA:D1","CH_GB18_A3NA:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:CGD-04","text":"Das Potenzenverhältnis bleibt der spezifische Kalkülgrund, wird auf Clusterebene aber der umfassenderen Regel untergeordnet, dass Relationen zwischen qualitativ verschiedenen Größen ausdrücklich typisiert werden müssen.","refs":["CH_GB18_A1DB:A10","CH_GB18_A3NA:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:CGD-05","text":"Die Begrenzung geometrischer Produktion auf drei Dimensionen bleibt eine lokale raumontologische Voraussetzung und wird nicht zum globalen Axiom der qualitativen Größenbestimmung erhoben.","refs":["CH_GB18_A3NA:MRT8","CH_GB18_A3NA:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:CGD-06","text":"Die unvollständige Rückführung allgemeiner Funktionsformen und variabler Summationen bleibt als lokale Unterbestimmtheit bestehen; sie begrenzt die Reichweite, hebt aber die gemeinsame Begründungsarchitektur nicht auf.","refs":["CH_GB18_A2DZ:MRT8","CH_GB18_A3NA:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_25:GNX-01","text":"Das System schließt Erfolgslegitimation aus: Ein richtiges Resultat kann kein widersprüchliches oder gegenstandslos interpretiertes Verfahren rechtfertigen.","refs":["CH_GB18_A1DB:NX1","CH_GB18_A2DZ:DNX4"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-02","text":"Das wahrhafte mathematische Unendliche ist weder größtes oder kleinstes Quantum noch positiv vorhandenes Unendlichkleines.","refs":["CH_GB18_A1DB:NX2","CH_GB18_A2DZ:NX3"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-03","text":"Unabschließbarkeit, unendliche Reihe und unbegrenzte Annäherung liefern keine affirmative Gegenwart der gesuchten Bestimmung.","refs":["CH_GB18_A1DB:DNX2","CH_GB18_A2DZ:NX11"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-04","text":"Veränderlichkeit, Funktion und Kontinuität werden als zu allgemeine Kategorien ausgeschlossen, sofern sie das spezifische qualitative Verhältnis nicht bestimmen.","refs":["CH_GB18_A2DZ:A7","CH_GB18_A2DZ:NX4"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-05","text":"Ein sich selbst interpretierender Formalismus ist ausgeschlossen; weder Differentialquotient noch abgeleitete Funktion enthält automatisch seine konkrete Bedeutung.","refs":["CH_GB18_A2DZ:SNX1","CH_GB18_A2DZ:NX7","CH_GB18_A2DZ:NX10"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-06","text":"Kontinuität kann weder aus diskreten Elementen zusammengesetzt noch durch deren kardinale Akkumulation erzeugt werden.","refs":["CH_GB18_A3NA:NX2","CH_GB18_A3NA:DNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-07","text":"Formale Ableitbarkeit begründet weder physische Existenz noch kausale Wirksamkeit oder ontologische Zusammensetzung.","refs":["CH_GB18_A1DB:DNX6","CH_GB18_A2DZ:NX10","CH_GB18_A3NA:D1"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_25:DBN-01","text":"Falsch sein muss das Modell, nach dem quantitative Momente ihre Selbständigkeit während des qualitativen Übergangs unverändert bewahren.","refs":["CH_GB18_A1DB:A3","CH_GB18_A1DB:D2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:DBN-02","text":"Unzulässig ist die Annahme, formale Homogenität bewahre von selbst die qualitative Funktion, Dimension oder Gegenstandsbedeutung ihrer Glieder.","refs":["CH_GB18_A2DZ:DNX3","CH_GB18_A3NA:DNX3"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:DBN-03","text":"Das System kann die Anwendung nicht als äußerlichen Zusatz zulassen, weil damit Zweck, Selektionsregel und semantische Validierung des Kalküls grundlos würden.","refs":["CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:SD2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:DBN-04","text":"Die Genese des Kontinuierlichen aus summierten Bestandteilen muss ausgeschlossen bleiben, damit diskrete Verfahren als Bestimmungen und nicht als ontologische Zusammensetzung lesbar werden.","refs":["CH_GB18_A3NA:SNX1","CH_GB18_A3NA:D1"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:DBN-05","text":"Ein automatischer Übergang von mathematischer Syntax zu qualitativer, geometrischer oder physischer Realität darf nicht verfügbar sein, ohne die gestufte Beweisarchitektur aufzulösen.","refs":["CH_GB18_A1DB:SNX4","CH_GB18_A2DZ:SNX3","CH_GB18_A3NA:SNX3"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_25:BSA-01","text":"Die tiefste nicht verfügbare Figur ist ein infinitesimales Mittelwesen, das zugleich selbständiges Quantum und reines Relationsmoment sowie zugleich niedere und höhere Dimension wäre.","refs":["CH_GB18_A1DB:SNX2","CH_GB18_A3NA:DNX1","CH_GB18_A3NA:SNX5"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:BSA-02","text":"Das System ist um die Abwesenheit eines äußeren Jenseits organisiert; jede Verlagerung der Bestimmung in einen unerreichten Progress reproduziert Endlichkeit.","refs":["CH_GB18_A1DB:SNX3","CH_GB18_A1DB:D5"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:BSA-03","text":"Nicht verfügbar ist eine unmittelbare Identität von formaler Operation, mathematischer Bedeutung und realer Existenz; ihre Differenz erzeugt die gesamte Vermittlungsarbeit des Systems.","refs":["CH_GB18_A2DZ:SNX3","CH_GB18_A1DB:SNX4"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:BSA-04","text":"Die Totalität unendlich vieler Elemente und eine überall verfügbare endliche Darstellung bleiben ausgeschlossen, ohne dass dadurch gesetzliche Bestimmtheit oder Exaktheit unmöglich wird.","refs":["CH_GB18_A3NA:SNX2","CH_GB18_A3NA:DNX7","CH_GB18_A3NA:SD6"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_25:XD-01","text":"Die qualitative Relation ist zugleich ontologischer Ersatz für selbständige Infinitesimalgrößen und epistemisches Kriterium dafür, wann ein formal erzeugter Koeffizient bestimmte Bedeutung besitzt.","refs":["CL_GB18_25:GA-02","CL_GB18_25:GA-05","CL_GB18_25:GA-06","CH_GB18_A1DB:D2","CH_GB18_A2DZ:SD1"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_25:XD-02","text":"Weil Anwendung und Operandentypisierung konstitutiv sind, kann die allgemeine Theorie nur rückwirkend aus bereits qualitativ strukturierten Gegenstandsoperationen abstrahiert werden.","refs":["CL_GB18_25:GA-06","CL_GB18_25:GA-07","CL_GB18_25:GA-11","CH_GB18_A2DZ:AS2","CH_GB18_A3NA:SD3","CH_GB18_A2DZ:SD2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_25:XD-03","text":"Das Unendlichkleine bezeichnet in Analysis und Geometrie denselben strukturellen Mangel: Eine qualitative Vermittlung ist operativ wirksam, aber noch als quantitative Zwischenentität fehlgedeutet.","refs":["CL_GB18_25:GA-04","CL_GB18_25:GA-08","CL_GB18_25:GA-11","CH_GB18_A1DB:SNX2","CH_GB18_A3NA:SD1","CH_GB18_A3NA:AS4"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:XD-04","text":"Weglassung analytischer Glieder und diskrete Erfassung kontinuierlicher Größen folgen derselben Selektionslogik: Erhalten wird das funktions- oder verhältnisbestimmende Moment, nicht jedes formal erzeugbare Element.","refs":["CL_GB18_25:GA-10","CL_GB18_25:GA-12","CH_GB18_A1DB:A13","CH_GB18_A3NA:SD4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_25:XD-05","text":"Differential- und Integralrechnung sind formal invers, epistemisch aber asymmetrisch, weil jede Richtung eine eigene Identifikation des entsprechenden Gegenstandsmoments verlangt.","refs":["CL_GB18_25:GA-06","CL_GB18_25:GA-07","CH_GB18_A2DZ:SD3","CH_GB18_A2DZ:A11","CH_GB18_A2DZ:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_25:XD-06","text":"Die rechnerische Diskretisierung eines Kontinuierlichen ist genau dann legitim, wenn sie ein invariantes Maß erfasst und nicht als Behauptung über die ontologische Zusammensetzung des Gegenstands auftritt.","refs":["CL_GB18_25:GA-09","CL_GB18_25:GA-10","CL_GB18_25:GA-12","CH_GB18_A3NA:SD2","CH_GB18_A2DZ:ALT2","CH_GB18_A3NA:SD4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_25:XD-07","text":"Die formale Ableitung physikalisch benannter Funktionen oder geometrischer Elemente wird zur ontologischen Fiktion, sobald die zusätzliche Gegenstandszuschreibung als Resultat der Rechnung ausgegeben wird.","refs":["CL_GB18_25:GA-06","CL_GB18_25:GA-09","CH_GB18_A1DB:SD5","CH_GB18_A2DZ:ME9"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:XD-08","text":"Die spezifische Bindung des Kalküls an Potenzenverhältnisse steht in produktiver Spannung zur umfassenderen These, dass erst die Typisierung formal gleicher Operationen ihre qualitative Funktion festlegt.","refs":["CL_GB18_25:GA-05","CL_GB18_25:GA-11","CH_GB18_A2DZ:MRT5","CH_GB18_A3NA:MRT6"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:XD-09","text":"Vollständige mathematische Bestimmtheit verlangt weder unendliche Aufzählung noch überall einen endlichen Ausdruck, sofern das erzeugende Verhältnis oder Fortbestimmungsgesetz gegenwärtig erfasst ist.","refs":["CL_GB18_25:GA-04","CL_GB18_25:GA-12","CL_GB18_25:GA-13","CH_GB18_A1DB:A9","CH_GB18_A3NA:SD6","CH_GB18_A3NA:A15"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_25:BSD-01","text":"Die erzeugte Ontologie ist relational und typisiert: Größen sind keine isolierten Träger fester Bedeutung, sondern Momente, deren Sein durch Potenzstufe, Dimension, Funktion und Gegenstandsrelation bestimmt wird.","refs":["CL_GB18_25:GA-02","CL_GB18_25:GA-03","CL_GB18_25:GA-11","CH_GB18_A1DB:SD2","CH_GB18_A2DZ:SD6","CH_GB18_A3NA:A16"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_25:BSD-02","text":"Erkenntnis wird als gestufter Prozess rekonstruiert: formale Erzeugung liefert ein Verhältnis, Typisierung bestimmt seine qualitative Funktion und ein unabhängiger Gegenstandsbeweis validiert seine konkrete Bedeutung.","refs":["CL_GB18_25:GA-06","CL_GB18_25:GA-07","CH_GB18_A2DZ:AS4","CH_GB18_A2DZ:A12","CH_GB18_A3NA:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_25:BSD-03","text":"Zeitlichkeit spaltet sich in schlechte Unendlichkeit als hinausgeschobene Vollendung und wahrhafte Unendlichkeit als gegenwärtige relationale Geschlossenheit; mathematische Exaktheit hängt an der zweiten Struktur.","refs":["CL_GB18_25:GA-04","CL_GB18_25:GA-13","CH_GB18_A1DB:ALT4","CH_GB18_A1DB:DNX2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_25:BSD-04","text":"Theorie besitzt eine retroaktive Genealogie: Gegenständliche Problemlösungen gehen der abstrakten Grundlegung sachlich voraus, während die Theorie ihre gemeinsame Relationsform erst nachträglich expliziert.","refs":["CL_GB18_25:GA-07","CH_GB18_A2DZ:D1","CH_GB18_A2DZ:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_25:BSD-05","text":"Physische Kausalität und geometrische Existenz sind keine Nebenprodukte mathematischer Ableitung, sondern zusätzliche Bestimmungen mit eigener Beweislast.","refs":["CL_GB18_25:GA-09","CH_GB18_A1DB:DNX6","CH_GB18_A2DZ:D12","CH_GB18_A3NA:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_25:BSD-06","text":"Exaktheit wird von Vollständigkeit der Enumeration und Anschaulichkeit der Zerlegung entkoppelt; sie beruht auf der vollständigen Erfassung des maßgebenden Gesetzes oder invarianten Moments.","refs":["CL_GB18_25:GA-10","CL_GB18_25:GA-12","CL_GB18_25:GA-13","CH_GB18_A3NA:AS6","CH_GB18_A3NA:SD6","CH_GB18_A3NA:SD4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_25:RLE-01","text":"Der zentrale Rechtfertigungszyklus verläuft von formalem Erfolg über die Entdeckung begrifflicher Unterbestimmtheit zur qualitativen Rekonstruktion, von dort zur Anwendung und durch diese zurück zur korrigierten Theorie.","refs":["CH_GB18_A1DB:AS1","CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RLE-02","text":"Jeder Versuch, das aufgehobene Quantum als kleines endliches Quantum weiterzuverwenden, erzeugt den Rückfall in Vernachlässigung oder Annäherung und erneuert damit das ursprüngliche Rechtfertigungsdefizit.","refs":["CH_GB18_A1DB:A14","CH_GB18_A1DB:FGS7","CH_GB18_A1DB:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RLE-03","text":"Die Anwendung-Theorie-Schleife ist retroaktiv: Anwendungen liefern die sachliche Struktur, die Theorie abstrahiert sie, und die abstrahierte Struktur prüft anschließend die Legitimität weiterer Anwendungen.","refs":["CH_GB18_A2DZ:A4","CH_GB18_A2DZ:SD2","CH_GB18_A2DZ:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RLE-04","text":"Die Typisierungsschleife führt von formaler Homogenisierung zur Wiederkehr qualitativer Differenz, erzwingt eine gegenständliche Typisierung und bestimmt dadurch rückwirkend die Bedeutung der formalen Operation.","refs":["CH_GB18_A3NA:A1","CH_GB18_A3NA:A2","CH_GB18_A3NA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RLE-05","text":"Die Aggregationseskalation verläuft von äußerlicher Summe über Dimensionsdefizit zur infinitesimalen Nothilfe und endet erst mit der Freilegung einer bereits wirksamen typisierten Multiplikation.","refs":["CH_GB18_A3NA:A4","CH_GB18_A3NA:AS4","CH_GB18_A3NA:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RLE-06","text":"Der gemeinsame Attraktor ist die immanente qualitative Invariante: Potenzenverhältnis, Proportionalität und maßgebendes geometrisches Moment sind verschiedene Gestalten derselben Forderung nach vollständiger relationaler Bestimmung.","refs":["CH_GB18_A2DZ:D3","CH_GB18_A2DZ:A11","CH_GB18_A3NA:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_25:FGS-B01","text":"Exakter Erfolg plus begrifflich widersprüchliche Operation erzeugt ein Rechtfertigungsdefizit, das weder historische Brauchbarkeit noch bloße Ergebnisrichtigkeit schließen kann.","refs":["CH_GB18_A1DB:AS1","CH_GB18_A2DZ:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B02","text":"Die Negation des selbständigen Quantums erhält seine Bestimmtheit als qualitatives Relationsmoment, statt sie in einem extrem kleinen Gegenstand zu konservieren.","refs":["CH_GB18_A1DB:A3","CH_GB18_A1DB:A5","CH_GB18_A2DZ:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B03","text":"Das qualitative Relationsmoment konkretisiert sich im Kalkül als Potenzenverhältnis zwischen ursprünglicher Funktion und Entwicklungsfunktion.","refs":["CH_GB18_A1DB:A10","CH_GB18_A2DZ:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B04","text":"Die formale Ableitung erzeugt zunächst nur ein Verhältnis; dessen konkrete Bedeutung entsteht durch Anwendung, Typisierung und unabhängigen Proportionalitätsbeweis.","refs":["CH_GB18_A2DZ:AS4","CH_GB18_A2DZ:A11","CH_GB18_A2DZ:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B05","text":"Die geometrische Anwendung bricht die analytische Homogenität auf, indem sie Zahloperationen nach Dimension und Figuration qualitativ typisiert.","refs":["CH_GB18_A3NA:AS2","CH_GB18_A3NA:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B06","text":"Wo äußerliche Aggregation den Dimensionsübergang nicht leisten kann, erscheint das Infinitesimale als negative Ersatzfigur für eine verdeckte typisierte Multiplikation.","refs":["CH_GB18_A3NA:D2","CH_GB18_A3NA:AS5","CH_GB18_A3NA:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B07","text":"Die Explikation des invarianten Bestimmungsmoments legitimiert Weglassung und Diskretisierung, ohne daraus selbständige infinitesimale Entitäten oder eine Zusammensetzungsontologie abzuleiten.","refs":["CH_GB18_A1DB:A13","CH_GB18_A3NA:SD4","CH_GB18_A3NA:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B08","text":"Die Maschine schließt relativ durch die Trennung von formaler Erzeugung, qualitativer Typisierung, gegenständlicher Validierung und realer Existenz, bleibt aber hinsichtlich ihrer universalen Reichweite offen.","refs":["CH_GB18_A2DZ:ALT2","CH_GB18_A2DZ:SNX4","CH_GB18_A2DZ:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_25:AFM-B01","text":"Exakter Kalkül bei begrifflicher Unterbestimmtheit → Kritik der Erfolgslegitimation → Aufhebung des selbständigen Quantums → qualitative Relation → Potenzenverhältnis → Rückgang auf Anwendungen → Trennung von formaler Erzeugung und Gegenstandsbeweis → dimensionale Typisierung → Entlarvung des Infinitesimalen → invariante Größenbestimmung.","refs":["CH_GB18_A1DB:AS2","CH_GB18_A2DZ:A4","CH_GB18_A3NA:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AFM-B02","text":"Äußerliche Progression oder Aggregation → fehlende qualitative Vermittlung → negative infinitesimale Nothilfe → Rückkehr zum Gegenstandsverhältnis → Explikation der affirmativen Operation → begrenzte methodische Schließung ohne ontologische Zwischenentität.","refs":["CH_GB18_A1DB:A8","CH_GB18_A3NA:A5","CH_GB18_A3NA:D13","CH_GB18_A2DZ:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_25:MME-01","text":"Der Gegensatz von endlich und unendlich wird durch die Unterscheidung zwischen selbständigem Quantum, äußerem Progress und immanentem qualitativem Verhältnis ersetzt.","refs":["CH_GB18_A1DB:ME1","CH_GB18_A1DB:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-02","text":"Der Differentialquotient wird von einer selbstgenügsamen infinitesimalen Gleichung zu einem formal erzeugten, gegenständlich noch zu interpretierenden Verhältnis umklassifiziert.","refs":["CH_GB18_A2DZ:D6","CH_GB18_A2DZ:ME8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-03","text":"Die Anwendung wechselt von der Peripherie ins Zentrum der Begriffsbildung und wird zur Quelle von Zweck, Semantik und Geltungsprüfung.","refs":["CH_GB18_A2DZ:ME1","CH_GB18_A2DZ:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-04","text":"Diskretion und Kontinuität bilden keinen unmittelbaren ontologischen Gegensatz mehr, sondern verschiedene Ebenen von Größenbestimmung und Gegenstandsexistenz.","refs":["CH_GB18_A3NA:ME4","CH_GB18_A3NA:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-05","text":"Summation, Multiplikation und Differentiation werden nicht länger allein durch ihre formale Gestalt klassifiziert, sondern durch die qualitative Funktion und Typisierung ihrer Operanden.","refs":["CH_GB18_A3NA:ME2","CH_GB18_A3NA:SD3","CH_GB18_A2DZ:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-06","text":"Die unendliche Elementanzahl verliert operative Priorität und wird durch eine begrenzte Erstreckungsgröße oder ein gesetzlich bestimmtes Fortbestimmungsverhältnis ersetzt.","refs":["CH_GB18_A3NA:A10","CH_GB18_A3NA:ME5","CH_GB18_A3NA:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-07","text":"Die strategische Landschaft wird von der Suche nach infinitesimalen Gegenständen auf die Identifikation invariantenbestimmender Relationen, Typisierungen und Beweisübergänge umgezeichnet.","refs":["CH_GB18_A3NA:ME1","CH_GB18_A3NA:SD4","CH_GB18_A2DZ:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_25:ALT-B01","text":"Auf der Oberflächenebene werden mathematisches Unendliches, Differential- und Integraloperationen, Reihen, Tangenten, Flächen, Untheilbare und Dimensionsübergänge untersucht.","refs":["CH_GB18_A1DB:ALT1","CH_GB18_A2DZ:ALT1","CH_GB18_A3NA:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:ALT-B02","text":"Auf der strukturellen Ebene operiert das System durch die Umwandlung selbständiger Quanta in typisierte Relationsmomente sowie durch die Trennung formaler Erzeugung, Anwendung und Gegenstandsbeweis.","refs":["CH_GB18_A1DB:ALT2","CH_GB18_A2DZ:ALT2","CH_GB18_A3NA:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:ALT-B03","text":"Auf der metastrategischen Ebene wird Grundlegung von abstrakter Theorie auf konkrete Problemlösung, relationale Invarianz und nachträgliche Prinzipienbildung umgestellt.","refs":["CH_GB18_A2DZ:ALT3","CH_GB18_A3NA:ALT3","CH_GB18_A2DZ:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:ALT-B04","text":"Auf der ontologischen und zeitlichen Ebene ist Realität relational typisiert, das Kontinuierliche vorausgesetzt und wahrhafte Unendlichkeit als gegenwärtige immanente Bestimmung statt als unerreichter Progress gefasst.","refs":["CH_GB18_A3NA:ALT4","CH_GB18_A1DB:ALT4","CH_GB18_A1DB:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:ALT-B05","text":"Auf der methodologischen und performativen Ebene vollzieht die rekursive Form selbst die behauptete Bewegung, indem jede negative Demontage eines falschen Grundes eine affirmative Relationsbestimmung erzwingt.","refs":["CH_GB18_A2DZ:AS6","CH_GB18_A3NA:AS7","CH_GB18_A3NA:FGS14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_25:FL-01","text":"Differentiale sollen ausschließlich als Relationsmomente Bedeutung besitzen, während die rechnerische Praxis weiterhin ihre getrennte symbolische Behandlung verlangt.","refs":["CH_GB18_A1DB:MRT6","CH_GB18_A1DB:A11"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:FL-02","text":"Die Grundlegung aus Anwendungen beansprucht begriffliche Notwendigkeit, gewinnt ihre Allgemeinheit aber teilweise aus exemplarischer Induktion und historischer Rekonstruktion.","refs":["CH_GB18_A2DZ:MRT5","CH_GB18_A2DZ:MRT9"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:FL-03","text":"Die Zurückweisung des Zuwachses als Grundbegriff kollidiert mit seiner Wiederaufnahme als endliches Beweis- und Darstellungsmittel.","refs":["CH_GB18_A2DZ:MRT6","CH_GB18_A2DZ:D8"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:FL-04","text":"Die diskrete Bestimmung des Kontinuierlichen bleibt instabil, weil das Kontinuierliche einerseits diskret an ihm selbst bestimmt, andererseits aber nicht aus diskreten Elementen zusammengesetzt werden soll.","refs":["CH_GB18_A3NA:MRT5","CH_GB18_A3NA:NX2"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:FL-05","text":"Die qualitative Produktivität geometrischer Multiplikation wird nicht aus der homogenen Arithmetik selbst abgeleitet, sondern tritt durch eine zusätzliche Typisierung der Operanden ein.","refs":["CH_GB18_A3NA:MRT6","CH_GB18_A3NA:SD3"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:MP-01","text":"Der erste Mutationspunkt liegt in der Aufhebung des Quantums: Negation bedeutet nicht Verschwinden aller Bestimmtheit, sondern Übergang von Selbständigkeit zu relationaler Funktion.","refs":["CH_GB18_A1DB:A3","CH_GB18_A1DB:A5"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:MP-02","text":"Der zweite Mutationspunkt verlagert den Differentialbegriff vom unendlich kleinen Zuwachs auf das Verhältnis qualitativ verschiedener Potenzenstufen.","refs":["CH_GB18_A1DB:NX7","CH_GB18_A2DZ:A6"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:MP-03","text":"Der dritte Mutationspunkt kehrt die Stellung der Anwendung um: Sie wird vom abgeleiteten Gebrauch zum sachlichen Grund der abstrakten Theorie.","refs":["CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:ME1"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:MP-04","text":"Der vierte Mutationspunkt verwandelt scheinbare Summation in typisierte Multiplikation und ersetzt den infinitesimalen Dimensionssprung durch eine affirmative Operation.","refs":["CH_GB18_A3NA:A6","CH_GB18_A3NA:D3"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:MP-05","text":"Der fünfte Mutationspunkt differenziert Unendlichkeit in immanente Relationsvollständigkeit, fehlende endliche Darstellung und illegitime Verdeckung eines qualitativen Übergangs.","refs":["CH_GB18_A1DB:SNX3","CH_GB18_A3NA:SD5","CH_GB18_A3NA:ME7"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_25:HSI-01","text":"Die Realität erscheint als geschichtete Relationsmaschine, in der formale Größen ihre Wirksamkeit erst durch Potenzstufe, Dimension, Funktion und Gegenstandszuordnung erhalten.","refs":["CH_GB18_A2DZ:SD6","CH_GB18_A3NA:A16","CH_GB18_A3NA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:HSI-02","text":"Das erkennende Subjekt ist kein äußerer Betrachter unendlich kleiner Dinge, sondern die Instanz, die formale Operation, qualitative Typisierung und gegenständlichen Beweis auseinanderhalten und vermitteln muss.","refs":["CH_GB18_A1DB:NX3","CH_GB18_A2DZ:A12","CH_GB18_A2DZ:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:HSI-03","text":"Die vorausgesetzte Zeit ist doppelt: Schlechte Unendlichkeit verschiebt Vollendung unbegrenzt, während die qualitative Relation ihre Negation und Bestimmtheit gegenwärtig in sich enthält.","refs":["CH_GB18_A1DB:DNX2","CH_GB18_A1DB:A9","CH_GB18_A1DB:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:HSI-04","text":"Möglich bleibt eine Navigation durch Identifikation invariantenbestimmender Relationen; ausgeschlossen bleibt die Flucht in infinitesimale Entitäten, bloße Aggregation oder ungeprüfte Übertragung formaler Resultate auf Realität.","refs":["CH_GB18_A3NA:SD4","CH_GB18_A2DZ:SNX2","CH_GB18_A1DB:DNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_25:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung vom Rechtfertigungsdefizit über die qualitative Relationsbestimmung bis zur typisierten Anwendung und zur Kritik infinitesimaler Zusammensetzungsmodelle zu rekonstruieren.","refs":["CH_GB18_A1DB:MRT1","CH_GB18_A2DZ:MRT1","CH_GB18_A3NA:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MRT-B02","text":"Die Architektur ist am stärksten, wo sie selbständige Quanta in Relationsmomente überführt, formale Erzeugung von Bedeutungsbeweis trennt und diskrete Bestimmung von kontinuierlicher Existenz unterscheidet.","refs":["CH_GB18_A1DB:MRT4","CH_GB18_A2DZ:MRT4","CH_GB18_A3NA:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MRT-B03","text":"Unterbestimmt bleiben die universale Reduktion sämtlicher Funktionsformen auf Potenzenverhältnisse und die allgemeine Formalisierung variabler geometrischer Summationen als Multiplikationsstrukturen.","refs":["CH_GB18_A2DZ:MRT8","CH_GB18_A3NA:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MRT-B04","text":"Das System ist auf Clusterebene kohärent, sofern qualitative Relation, formale Darstellung, gegenständliche Interpretation und reale Existenz strikt unterschieden werden.","refs":["CH_GB18_A1DB:MRT3","CH_GB18_A2DZ:MRT3","CH_GB18_A3NA:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MRT-B05","text":"Die Rekonstruktion hängt wesentlich von rekursiver Rückkehr ab: Wiederholte Negationen von Kleinheit, Progress, Aggregation und formaler Selbstgenügsamkeit erzeugen schrittweise die positive Architektur der qualitativen Bestimmung.","refs":["CH_GB18_A1DB:A14","CH_GB18_A2DZ:SNX1","CH_GB18_A3NA:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MRT-B06","text":"Axiomatischer Reduktion widersteht die produktive Spannung zwischen der Spezifität des Potenzenverhältnisses und der umfassenderen Typisierungsthese; sie muss erhalten bleiben, weil sie den Übergang vom Kalkül zur allgemeinen qualitativen Größenbestimmung ermöglicht.","refs":["CH_GB18_A1DB:A10","CH_GB18_A3NA:A16","CH_GB18_A3NA:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121643171293Z_d6d229df","language_code":"en","language_name":"English","title":"Chapters 73–75","source_sha256":"014dbbab92fa57c7c75f0466f64535141b5327e8a580946c1ad0863bcbe0bedc","sha256":"0c31beb0f85b9e86a32a59b82ea6529d4000554eca58dd222e2f4e43385f0ed9","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:16:43.173070+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_25:AS-01","text":"The system addresses the contradiction that mathematical procedures produce exact results although their operations and selection rules remain conceptually inadequately justified.","refs":["CH_GB18_A1DB:AS1","CH_GB18_A2DZ:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-02","text":"It redefines mathematical legitimacy as the correspondence of formal operations with an affirmative qualitative magnitude-relation that must be independently demonstrated in the object.","refs":["CH_GB18_A1DB:A5","CH_GB18_A2DZ:A11","CH_GB18_A3NA:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-03","text":"The infinitesimal loses the status of a positive object and becomes the negative index of a relational, functional, or dimensional mediation not yet made explicit.","refs":["CH_GB18_A2DZ:A15","CH_GB18_A3NA:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-04","text":"Application is not the external execution of a completed theory, but the constitutive site at which the object, purpose, typification, and conditions of validity of the procedure emerge.","refs":["CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:A4","CH_GB18_A3NA:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-05","text":"The movement leads from the sublation of independent quanta through power-relations to geometric dimensional typification, and thus from negative infinity to the affirmative determination of the operative transition.","refs":["CH_GB18_A1DB:AS5","CH_GB18_A3NA:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-06","text":"The argument operates recursively and is mutation-driven: every relapse into finite quantity, formal homogeneity, or external aggregation compels a renewed reconstruction of the qualitative relation.","refs":["CH_GB18_A2DZ:AS6","CH_GB18_A1DB:A14","CH_GB18_A3NA:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-07","text":"The relative closure consists in the separation of formal generation, objective attribution of meaning, independent proof of the relation, and ontological assertion of existence.","refs":["CH_GB18_A2DZ:A12","CH_GB18_A1DB:NX10","CH_GB18_A3NA:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AS-08","text":"This closure remains conditioned because neither the complete reduction of all functional forms to power-relations nor the general transformation of variable continua into typified product structures is demonstrated.","refs":["CH_GB18_A2DZ:SNX4","CH_GB18_A2DZ:MRT8","CH_GB18_A3NA:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_25:GA-01","text":"[Persistent] The correctness or historical usefulness of a result replaces neither the necessity of the generating procedure nor the proof of its relation to the object.","refs":["CH_GB18_A1DB:A1","CH_GB18_A2DZ:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-02","text":"[Attractor] The affirmative ground of mathematical determinacy is a qualitative relation in which quantitative moments receive their meaning through mutual determination.","refs":["CH_GB18_A1DB:A6","CH_GB18_A2DZ:A5","CH_GB18_A3NA:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-03","text":"[Mutating] After the sublation of its independence, quantity remains not as a vanishing thing, but as a dependent moment of a relation.","refs":["CH_GB18_A1DB:AS4","CH_GB18_A2DZ:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-04","text":"[Mutating] Infinity transforms from external progress or extreme quantum into the immanent completeness of a relation and the invariance of qualitative determination.","refs":["CH_GB18_A1DB:A4","CH_GB18_A2DZ:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-05","text":"[Persistent] The power-relation constitutes the specific qualitative ground of differential and integral calculus, not variability, continuity, or smallness as such.","refs":["CH_GB18_A1DB:A10","CH_GB18_A2DZ:A6","CH_GB18_A2DZ:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-06","text":"[Emergent] Formal generation and concrete interpretation are distinct orders of proof; no operation generates its object's semantics solely from its syntax.","refs":["CH_GB18_A2DZ:A12","CH_GB18_A2DZ:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-07","text":"[Emergent] Application is a constitutive source of cognition because only it typifies the formal relation, selects its purpose, and validates its concrete validity.","refs":["CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:A11","CH_GB18_A2DZ:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-08","text":"[Mutating] The infinitesimal is not a positive intermediate entity, but a negative indication that a qualitative determination of operation is still concealed.","refs":["CH_GB18_A1DB:SNX2","CH_GB18_A2DZ:SNX2","CH_GB18_A3NA:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-09","text":"[Emergent] Analytical determination, geometrical or physical interpretation, and real existence belong to different orders of justification.","refs":["CH_GB18_A1DB:A15","CH_GB18_A2DZ:NX10","CH_GB18_A3NA:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-10","text":"[Emergent] Discrete elements can determine the magnitude of a continuum without ontologically composing its continuous existence.","refs":["CH_GB18_A3NA:NX2","CH_GB18_A3NA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-11","text":"[Mutating] A formally identical arithmetical operation can, depending on the typification of its operands, either remain quantitatively homogeneous or undergo a qualitative dimensional transition.","refs":["CH_GB18_A3NA:A1","CH_GB18_A3NA:A8","CH_GB18_A3NA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-12","text":"[Persistent] Omission, discretization, and selection are legitimate only when grounded in qualitative functional irrelevance or the complete apprehension of an invariant moment of determination.","refs":["CH_GB18_A1DB:A13","CH_GB18_A2DZ:D2","CH_GB18_A3NA:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:GA-13","text":"[Terminal] Mathematical exactness arises through the preservation and objective validation of a qualitative relation, not through vanishing magnitudes, infinite aggregation, or unexamined formal transfer.","refs":["CH_GB18_A1DB:SD1","CH_GB18_A2DZ:FGS7","CH_GB18_A3NA:D13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_25:RMD-01","text":"The power-relation preserves its identity as a specific ground of calculus, but expands its function from the differential concept to the rule of qualitative invariance through quantitative changes.","refs":["CH_GB18_A1DB:A10","CH_GB18_A2DZ:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-02","text":"Infinity recurs in functionally different ways: as bad unclosedness, as immanent completeness, as the absence of finite representation, and as the illegitimate concealment of a qualitative transition.","refs":["CH_GB18_A1DB:SNX3","CH_GB18_A3NA:SD5","CH_GB18_A3NA:ME7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-03","text":"The differential mutates from the purportedly small independent quantum into the relation of developmental functions, and finally into an expression of an objective moment requiring typification.","refs":["CH_GB18_A1DB:A11","CH_GB18_A2DZ:D6","CH_GB18_A2DZ:ME8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-04","text":"Application is reversed from a subordinate use into a concept-generating and validating instance.","refs":["CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-05","text":"The series loses its privileged status as bearer of the infinite and remains only as a deficient representation, technical aid, or index of absent finite closure.","refs":["CH_GB18_A1DB:NX4","CH_GB18_A2DZ:NX5","CH_GB18_A3NA:D11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-06","text":"Summation undergoes a reversal of valence: as external aggregation it is incapable of dimension, but as a manifestation of geometrically typified multiplication it can express a qualitative transition.","refs":["CH_GB18_A3NA:A4","CH_GB18_A3NA:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-07","text":"The indivisible is displaced from an ontology of composition and absorbed into the higher structure of an invariant moment of magnitude-determination.","refs":["CH_GB18_A3NA:A12","CH_GB18_A3NA:SD4","CH_GB18_A3NA:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RMD-08","text":"The infinitesimal undergoes a terminal transformation: once the qualitative transition is affirmatively determined as relation, typification, or multiplication, its positive grounding function disappears.","refs":["CH_GB18_A3NA:A5","CH_GB18_A3NA:D13","CH_GB18_A3NA:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_25:CGD-01","text":"The individual historical justifications through limits, zeros, or series remain local diagnoses; only the pattern scales upward that non-conceptual foundations reintroduce finite determinations of quantity.","refs":["CH_GB18_A1DB:D9","CH_GB18_A1DB:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:CGD-02","text":"Constructions of tangents, ordinates, and areas remain object-specific cases; what bears the cluster is the demand for an independent demonstration of the relation between formal result and objective moment.","refs":["CH_GB18_A2DZ:D7","CH_GB18_A2DZ:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:CGD-03","text":"Cavalieri's sections and individual product decompositions remain local procedures; the separation of discrete magnitude-determination from continuous existence persists globally.","refs":["CH_GB18_A3NA:D7","CH_GB18_A3NA:D1","CH_GB18_A3NA:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:CGD-04","text":"The power-relation remains the specific ground of calculus, but at the cluster level is subordinated to the broader rule that relations between qualitatively different magnitudes must be explicitly typified.","refs":["CH_GB18_A1DB:A10","CH_GB18_A3NA:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:CGD-05","text":"The limitation of geometrical production to three dimensions remains a local spatial-ontological presupposition and is not elevated into the global axiom of qualitative magnitude-determination.","refs":["CH_GB18_A3NA:MRT8","CH_GB18_A3NA:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:CGD-06","text":"The incomplete reduction of general functional forms and variable summations remains as local underdetermination; it limits the scope but does not abolish the shared architecture of justification.","refs":["CH_GB18_A2DZ:MRT8","CH_GB18_A3NA:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_25:GNX-01","text":"The system excludes legitimation by success: a correct result cannot justify a contradictory procedure or one interpreted without an object.","refs":["CH_GB18_A1DB:NX1","CH_GB18_A2DZ:DNX4"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-02","text":"True mathematical infinity is neither the greatest or smallest quantum nor a positively existing infinitesimal.","refs":["CH_GB18_A1DB:NX2","CH_GB18_A2DZ:NX3"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-03","text":"Unclosedness, infinite series, and unlimited approximation provide no affirmative presence of the sought determination.","refs":["CH_GB18_A1DB:DNX2","CH_GB18_A2DZ:NX11"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-04","text":"Variability, function, and continuity are excluded as overly general categories insofar as they do not determine the specific qualitative relation.","refs":["CH_GB18_A2DZ:A7","CH_GB18_A2DZ:NX4"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-05","text":"A self-interpreting formalism is excluded; neither differential quotient nor derived function automatically contains its concrete meaning.","refs":["CH_GB18_A2DZ:SNX1","CH_GB18_A2DZ:NX7","CH_GB18_A2DZ:NX10"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-06","text":"Continuity can neither be composed from discrete elements nor generated through their cardinal accumulation.","refs":["CH_GB18_A3NA:NX2","CH_GB18_A3NA:DNX2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:GNX-07","text":"Formal derivability grounds neither physical existence nor causal efficacy or ontological composition.","refs":["CH_GB18_A1DB:DNX6","CH_GB18_A2DZ:NX10","CH_GB18_A3NA:D1"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_25:DBN-01","text":"False must be the model according to which quantitative moments preserve their independence unchanged during the qualitative transition.","refs":["CH_GB18_A1DB:A3","CH_GB18_A1DB:D2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:DBN-02","text":"Inadmissible is the assumption that formal homogeneity of itself preserves the qualitative function, dimension, or objective meaning of its terms.","refs":["CH_GB18_A2DZ:DNX3","CH_GB18_A3NA:DNX3"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:DBN-03","text":"The system cannot permit application as an external addition, because purpose, selection rule, and semantic validation of the calculus would thereby become groundless.","refs":["CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:SD2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:DBN-04","text":"The genesis of the continuum from summed components must remain excluded, so that discrete procedures may be read as determinations and not as ontological composition.","refs":["CH_GB18_A3NA:SNX1","CH_GB18_A3NA:D1"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:DBN-05","text":"An automatic transition from mathematical syntax to qualitative, geometrical, or physical reality must not be available without dissolving the graduated architecture of proof.","refs":["CH_GB18_A1DB:SNX4","CH_GB18_A2DZ:SNX3","CH_GB18_A3NA:SNX3"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_25:BSA-01","text":"The deepest unavailable figure is an infinitesimal intermediate being that would at once be independent quantum and pure relational moment, as well as lower and higher dimension.","refs":["CH_GB18_A1DB:SNX2","CH_GB18_A3NA:DNX1","CH_GB18_A3NA:SNX5"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:BSA-02","text":"The system is organized around the absence of an external beyond; every displacement of determination into an unattained progress reproduces finitude.","refs":["CH_GB18_A1DB:SNX3","CH_GB18_A1DB:D5"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:BSA-03","text":"Unavailable is an immediate identity of formal operation, mathematical meaning, and real existence; their difference generates the system's entire work of mediation.","refs":["CH_GB18_A2DZ:SNX3","CH_GB18_A1DB:SNX4"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:BSA-04","text":"The totality of infinitely many elements and an everywhere available finite representation remain excluded, without thereby making lawful determinacy or exactness impossible.","refs":["CH_GB18_A3NA:SNX2","CH_GB18_A3NA:DNX7","CH_GB18_A3NA:SD6"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_25:XD-01","text":"The qualitative relation is at once an ontological substitute for independent infinitesimal magnitudes and an epistemic criterion for when a formally generated coefficient possesses determinate meaning.","refs":["CL_GB18_25:GA-02","CL_GB18_25:GA-05","CL_GB18_25:GA-06","CH_GB18_A1DB:D2","CH_GB18_A2DZ:SD1"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_25:XD-02","text":"Because application and operand typification are constitutive, general theory can be abstracted only retroactively from already qualitatively structured objective operations.","refs":["CL_GB18_25:GA-06","CL_GB18_25:GA-07","CL_GB18_25:GA-11","CH_GB18_A2DZ:AS2","CH_GB18_A3NA:SD3","CH_GB18_A2DZ:SD2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_25:XD-03","text":"In analysis and geometry, the infinitesimal designates the same structural deficiency: a qualitative mediation is operatively effective, but is still misinterpreted as a quantitative intermediate entity.","refs":["CL_GB18_25:GA-04","CL_GB18_25:GA-08","CL_GB18_25:GA-11","CH_GB18_A1DB:SNX2","CH_GB18_A3NA:SD1","CH_GB18_A3NA:AS4"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:XD-04","text":"The omission of analytical terms and the discrete apprehension of continuous magnitudes follow the same logic of selection: what is retained is the function- or relation-determining moment, not every formally generable element.","refs":["CL_GB18_25:GA-10","CL_GB18_25:GA-12","CH_GB18_A1DB:A13","CH_GB18_A3NA:SD4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_25:XD-05","text":"Differential and integral calculus are formally inverse, but epistemically asymmetric, because each direction requires its own identification of the corresponding objective moment.","refs":["CL_GB18_25:GA-06","CL_GB18_25:GA-07","CH_GB18_A2DZ:SD3","CH_GB18_A2DZ:A11","CH_GB18_A2DZ:A14"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_25:XD-06","text":"The computational discretization of a continuum is legitimate precisely when it apprehends an invariant measure and does not appear as an assertion about the ontological composition of the object.","refs":["CL_GB18_25:GA-09","CL_GB18_25:GA-10","CL_GB18_25:GA-12","CH_GB18_A3NA:SD2","CH_GB18_A2DZ:ALT2","CH_GB18_A3NA:SD4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_25:XD-07","text":"The formal derivation of physically named functions or geometrical elements becomes ontological fiction as soon as the additional attribution to the object is presented as the result of calculation.","refs":["CL_GB18_25:GA-06","CL_GB18_25:GA-09","CH_GB18_A1DB:SD5","CH_GB18_A2DZ:ME9"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_25:XD-08","text":"The calculus's specific binding to power-relations stands in productive tension with the broader thesis that only the typification of formally identical operations determines their qualitative function.","refs":["CL_GB18_25:GA-05","CL_GB18_25:GA-11","CH_GB18_A2DZ:MRT5","CH_GB18_A3NA:MRT6"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:XD-09","text":"Complete mathematical determinacy requires neither infinite enumeration nor a finite expression everywhere, provided that the generating relation or law of continued determination is presently apprehended.","refs":["CL_GB18_25:GA-04","CL_GB18_25:GA-12","CL_GB18_25:GA-13","CH_GB18_A1DB:A9","CH_GB18_A3NA:SD6","CH_GB18_A3NA:A15"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_25:BSD-01","text":"The generated ontology is relational and typified: magnitudes are not isolated bearers of fixed meaning, but moments whose being is determined by power level, dimension, function, and relation to the object.","refs":["CL_GB18_25:GA-02","CL_GB18_25:GA-03","CL_GB18_25:GA-11","CH_GB18_A1DB:SD2","CH_GB18_A2DZ:SD6","CH_GB18_A3NA:A16"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_25:BSD-02","text":"Cognition is reconstructed as a graduated process: formal generation yields a relation, typification determines its qualitative function, and an independent proof of the object validates its concrete meaning.","refs":["CL_GB18_25:GA-06","CL_GB18_25:GA-07","CH_GB18_A2DZ:AS4","CH_GB18_A2DZ:A12","CH_GB18_A3NA:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_25:BSD-03","text":"Temporality divides into bad infinity as deferred completion and true infinity as present relational closure; mathematical exactness depends on the second structure.","refs":["CL_GB18_25:GA-04","CL_GB18_25:GA-13","CH_GB18_A1DB:ALT4","CH_GB18_A1DB:DNX2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_25:BSD-04","text":"Theory possesses a retroactive genealogy: objective solutions to problems precede abstract grounding in the matter itself, while theory only subsequently makes their common relational form explicit.","refs":["CL_GB18_25:GA-07","CH_GB18_A2DZ:D1","CH_GB18_A2DZ:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_25:BSD-05","text":"Physical causality and geometrical existence are not by-products of mathematical derivation, but additional determinations with their own burden of proof.","refs":["CL_GB18_25:GA-09","CH_GB18_A1DB:DNX6","CH_GB18_A2DZ:D12","CH_GB18_A3NA:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_25:BSD-06","text":"Exactness is decoupled from completeness of enumeration and intuitiveness of decomposition; it rests on the complete apprehension of the governing law or invariant moment.","refs":["CL_GB18_25:GA-10","CL_GB18_25:GA-12","CL_GB18_25:GA-13","CH_GB18_A3NA:AS6","CH_GB18_A3NA:SD6","CH_GB18_A3NA:SD4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_25:RLE-01","text":"The central cycle of justification proceeds from formal success through the discovery of conceptual underdetermination to qualitative reconstruction, thence to application, and through it back to corrected theory.","refs":["CH_GB18_A1DB:AS1","CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RLE-02","text":"Every attempt to continue using the sublated quantum as a small finite quantum produces relapse into neglect or approximation and thereby renews the original deficit of justification.","refs":["CH_GB18_A1DB:A14","CH_GB18_A1DB:FGS7","CH_GB18_A1DB:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RLE-03","text":"The application-theory loop is retroactive: applications provide the material structure, theory abstracts it, and the abstracted structure subsequently tests the legitimacy of further applications.","refs":["CH_GB18_A2DZ:A4","CH_GB18_A2DZ:SD2","CH_GB18_A2DZ:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RLE-04","text":"The typification loop leads from formal homogenization to the return of qualitative difference, compels an objective typification, and thereby retroactively determines the meaning of the formal operation.","refs":["CH_GB18_A3NA:A1","CH_GB18_A3NA:A2","CH_GB18_A3NA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RLE-05","text":"The aggregation escalation proceeds from external sum through dimensional deficit to infinitesimal emergency aid and ends only with the disclosure of an already effective typified multiplication.","refs":["CH_GB18_A3NA:A4","CH_GB18_A3NA:AS4","CH_GB18_A3NA:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:RLE-06","text":"The shared attractor is the immanent qualitative invariant: power-relation, proportionality, and the governing geometrical moment are different forms of the same demand for complete relational determination.","refs":["CH_GB18_A2DZ:D3","CH_GB18_A2DZ:A11","CH_GB18_A3NA:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_25:FGS-B01","text":"Exact success plus a conceptually contradictory operation produces a deficit of justification that neither historical usefulness nor mere correctness of result can close.","refs":["CH_GB18_A1DB:AS1","CH_GB18_A2DZ:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B02","text":"The negation of the independent quantum preserves its determinacy as a qualitative relational moment, instead of conserving it in an extremely small object.","refs":["CH_GB18_A1DB:A3","CH_GB18_A1DB:A5","CH_GB18_A2DZ:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B03","text":"The qualitative relational moment becomes concrete in calculus as a power-relation between original function and developmental function.","refs":["CH_GB18_A1DB:A10","CH_GB18_A2DZ:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B04","text":"Formal derivation initially generates only a relation; its concrete meaning arises through application, typification, and independent proof of proportionality.","refs":["CH_GB18_A2DZ:AS4","CH_GB18_A2DZ:A11","CH_GB18_A2DZ:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B05","text":"Geometrical application breaks open analytical homogeneity by qualitatively typifying number operations according to dimension and figuration.","refs":["CH_GB18_A3NA:AS2","CH_GB18_A3NA:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B06","text":"Where external aggregation cannot accomplish the dimensional transition, the infinitesimal appears as a negative substitute figure for a concealed typified multiplication.","refs":["CH_GB18_A3NA:D2","CH_GB18_A3NA:AS5","CH_GB18_A3NA:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B07","text":"The explication of the invariant moment of determination legitimates omission and discretization without deriving from them independent infinitesimal entities or an ontology of composition.","refs":["CH_GB18_A1DB:A13","CH_GB18_A3NA:SD4","CH_GB18_A3NA:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:FGS-B08","text":"The machine closes relatively through the separation of formal generation, qualitative typification, objective validation, and real existence, but remains open with respect to its universal scope.","refs":["CH_GB18_A2DZ:ALT2","CH_GB18_A2DZ:SNX4","CH_GB18_A2DZ:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_25:AFM-B01","text":"Exact calculus under conceptual underdetermination → critique of legitimation by success → sublation of the independent quantum → qualitative relation → power-relation → return to applications → separation of formal generation and proof of the object → dimensional typification → unmasking of the infinitesimal → invariant magnitude-determination.","refs":["CH_GB18_A1DB:AS2","CH_GB18_A2DZ:A4","CH_GB18_A3NA:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:AFM-B02","text":"External progression or aggregation → absent qualitative mediation → negative infinitesimal emergency aid → return to relation to the object → explication of the affirmative operation → limited methodological closure without ontological intermediate entity.","refs":["CH_GB18_A1DB:A8","CH_GB18_A3NA:A5","CH_GB18_A3NA:D13","CH_GB18_A2DZ:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_25:MME-01","text":"The opposition between finite and infinite is replaced by the distinction between independent quantum, external progress, and immanent qualitative relation.","refs":["CH_GB18_A1DB:ME1","CH_GB18_A1DB:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-02","text":"The differential quotient is reclassified from a self-sufficient infinitesimal equation into a formally generated relation still requiring objective interpretation.","refs":["CH_GB18_A2DZ:D6","CH_GB18_A2DZ:ME8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-03","text":"Application shifts from the periphery into the center of concept-formation and becomes the source of purpose, semantics, and examination of validity.","refs":["CH_GB18_A2DZ:ME1","CH_GB18_A2DZ:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-04","text":"Discreteness and continuity no longer form an immediate ontological opposition, but different levels of magnitude-determination and object-existence.","refs":["CH_GB18_A3NA:ME4","CH_GB18_A3NA:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-05","text":"Summation, multiplication, and differentiation are no longer classified solely through their formal shape, but through the qualitative function and typification of their operands.","refs":["CH_GB18_A3NA:ME2","CH_GB18_A3NA:SD3","CH_GB18_A2DZ:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-06","text":"The infinite number of elements loses operative priority and is replaced by a limited magnitude of extension or a lawfully determined relation of continued determination.","refs":["CH_GB18_A3NA:A10","CH_GB18_A3NA:ME5","CH_GB18_A3NA:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MME-07","text":"The strategic landscape is redrawn from the search for infinitesimal objects toward the identification of invariant-determining relations, typifications, and transitions of proof.","refs":["CH_GB18_A3NA:ME1","CH_GB18_A3NA:SD4","CH_GB18_A2DZ:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_25:ALT-B01","text":"At the surface level, mathematical infinity, differential and integral operations, series, tangents, areas, indivisibles, and dimensional transitions are investigated.","refs":["CH_GB18_A1DB:ALT1","CH_GB18_A2DZ:ALT1","CH_GB18_A3NA:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:ALT-B02","text":"At the structural level, the system operates through the transformation of independent quanta into typified relational moments and through the separation of formal generation, application, and proof of the object.","refs":["CH_GB18_A1DB:ALT2","CH_GB18_A2DZ:ALT2","CH_GB18_A3NA:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:ALT-B03","text":"At the metastrategic level, grounding is shifted from abstract theory to concrete problem-solving, relational invariance, and subsequent formation of principles.","refs":["CH_GB18_A2DZ:ALT3","CH_GB18_A3NA:ALT3","CH_GB18_A2DZ:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:ALT-B04","text":"At the ontological and temporal level, reality is relationally typified, the continuum is presupposed, and true infinity is conceived as present immanent determination rather than unattained progress.","refs":["CH_GB18_A3NA:ALT4","CH_GB18_A1DB:ALT4","CH_GB18_A1DB:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:ALT-B05","text":"At the methodological and performative level, the recursive form itself enacts the asserted movement, in that every negative dismantling of a false ground compels an affirmative relational determination.","refs":["CH_GB18_A2DZ:AS6","CH_GB18_A3NA:AS7","CH_GB18_A3NA:FGS14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_25:FL-01","text":"Differentials are supposed to possess meaning exclusively as relational moments, while computational practice continues to require their separate symbolic treatment.","refs":["CH_GB18_A1DB:MRT6","CH_GB18_A1DB:A11"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:FL-02","text":"Grounding from applications claims conceptual necessity, but partly derives its universality from exemplary induction and historical reconstruction.","refs":["CH_GB18_A2DZ:MRT5","CH_GB18_A2DZ:MRT9"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:FL-03","text":"The rejection of increment as a basic concept conflicts with its reintroduction as a finite means of proof and representation.","refs":["CH_GB18_A2DZ:MRT6","CH_GB18_A2DZ:D8"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:FL-04","text":"The discrete determination of the continuum remains unstable because the continuum is to be determined discretely in itself on the one hand, but not composed of discrete elements on the other.","refs":["CH_GB18_A3NA:MRT5","CH_GB18_A3NA:NX2"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:FL-05","text":"The qualitative productivity of geometrical multiplication is not derived from homogeneous arithmetic itself, but enters through an additional typification of the operands.","refs":["CH_GB18_A3NA:MRT6","CH_GB18_A3NA:SD3"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:MP-01","text":"The first mutation point lies in the sublation of the quantum: negation does not mean the disappearance of all determinacy, but transition from independence to relational function.","refs":["CH_GB18_A1DB:A3","CH_GB18_A1DB:A5"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:MP-02","text":"The second mutation point shifts the differential concept from the infinitely small increment to the relation of qualitatively different power levels.","refs":["CH_GB18_A1DB:NX7","CH_GB18_A2DZ:A6"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:MP-03","text":"The third mutation point reverses the status of application: it becomes from derivative use the material ground of abstract theory.","refs":["CH_GB18_A2DZ:AS2","CH_GB18_A2DZ:ME1"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:MP-04","text":"The fourth mutation point transforms apparent summation into typified multiplication and replaces the infinitesimal dimensional leap with an affirmative operation.","refs":["CH_GB18_A3NA:A6","CH_GB18_A3NA:D3"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_25:MP-05","text":"The fifth mutation point differentiates infinity into immanent relational completeness, absent finite representation, and illegitimate concealment of a qualitative transition.","refs":["CH_GB18_A1DB:SNX3","CH_GB18_A3NA:SD5","CH_GB18_A3NA:ME7"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_25:HSI-01","text":"Reality appears as a layered machine of relations in which formal magnitudes acquire their efficacy only through power level, dimension, function, and attribution to an object.","refs":["CH_GB18_A2DZ:SD6","CH_GB18_A3NA:A16","CH_GB18_A3NA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:HSI-02","text":"The cognizing subject is not an external observer of infinitely small things, but the instance that must distinguish and mediate formal operation, qualitative typification, and objective proof.","refs":["CH_GB18_A1DB:NX3","CH_GB18_A2DZ:A12","CH_GB18_A2DZ:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:HSI-03","text":"The presupposed time is twofold: bad infinity postpones completion without limit, whereas the qualitative relation contains its negation and determinacy presently within itself.","refs":["CH_GB18_A1DB:DNX2","CH_GB18_A1DB:A9","CH_GB18_A1DB:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:HSI-04","text":"Navigation through the identification of invariant-determining relations remains possible; escape into infinitesimal entities, mere aggregation, or unexamined transfer of formal results to reality remains excluded.","refs":["CH_GB18_A3NA:SD4","CH_GB18_A2DZ:SNX2","CH_GB18_A1DB:DNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_25:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from the deficit of justification through qualitative relational determination to typified application and the critique of infinitesimal compositional models.","refs":["CH_GB18_A1DB:MRT1","CH_GB18_A2DZ:MRT1","CH_GB18_A3NA:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MRT-B02","text":"The architecture is strongest where it transforms independent quanta into relational moments, separates formal generation from proof of meaning, and distinguishes discrete determination from continuous existence.","refs":["CH_GB18_A1DB:MRT4","CH_GB18_A2DZ:MRT4","CH_GB18_A3NA:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MRT-B03","text":"The universal reduction of all functional forms to power-relations and the general formalization of variable geometrical summations as multiplication structures remain underdetermined.","refs":["CH_GB18_A2DZ:MRT8","CH_GB18_A3NA:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MRT-B04","text":"The system is coherent at the cluster level insofar as qualitative relation, formal representation, objective interpretation, and real existence are strictly distinguished.","refs":["CH_GB18_A1DB:MRT3","CH_GB18_A2DZ:MRT3","CH_GB18_A3NA:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MRT-B05","text":"The reconstruction depends essentially on recursive return: repeated negations of smallness, progress, aggregation, and formal self-sufficiency gradually generate the positive architecture of qualitative determination.","refs":["CH_GB18_A1DB:A14","CH_GB18_A2DZ:SNX1","CH_GB18_A3NA:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_25:MRT-B06","text":"The productive tension between the specificity of the power-relation and the broader typification thesis resists axiomatic reduction; it must be preserved because it enables the transition from calculus to general qualitative magnitude-determination.","refs":["CH_GB18_A1DB:A10","CH_GB18_A3NA:A16","CH_GB18_A3NA:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_25@R001","source_variant_id":"canonical:CL_GB18_25:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 73–75","context":"Anmerkung 1. Die Begriffsbestimmtheit des mathematischen Unendlichen. · Anmerkung 2.Der Zweck des Differentialkalkuls aus seiner Anwendung abgeleitet. · Anmerkung 3. Noch andere mit der qualitativen Größenbestimmtheit zusammenhängende Formen."},"title_language_code":"en"},{"id":"CL_GB18_26","layer":"CL","title":"Chapters 76–78","order":26,"parents":["CH_GB18_DDVL","CH_GB18_BDUV","CH_GB18_CPL0"],"revision":"CL_GB18_26@R001","sha256":"6d42cad5143da5b4c869dca0911aff8d76637ab9d950b92ebbc81140e94e7376","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_26:BAS-01","text":"Das Cluster rekonstruiert, wie die äußerliche Veränderlichkeit des Quantums nur dann begriffen werden kann, wenn sie als interne Bestimmung eines Verhältnisses erscheint.","refs":["CH_GB18_DDVL:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-02","text":"Seine globale These lautet, daß ein Verhältnis seine Seiten nicht nachträglich verbindet, sondern deren quantitative Bestimmtheit erst als gemeinsame Grenze erzeugt.","refs":["CH_GB18_DDVL:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-03","text":"Das direkte Verhältniß eröffnet diese Bewegung, scheitert jedoch daran, daß Einheit und Anzahl vertauschbare Rollen bleiben und der Exponent daher keine bestimmte qualitative Einheit trägt.","refs":["CH_GB18_DDVL:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-04","text":"Das umgekehrte Verhältniß setzt den Mangel der direkten Form frei, indem die Veränderung jeder Seite zur negativen Bestimmung der anderen wird.","refs":["CH_GB18_BDUV:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-05","text":"Das Potenzenverhältniß überführt diese negative Gegenseitigkeit in eine Selbstbeziehung, in der das Quantum sein Andersseyn selbst begrenzt und bestimmt.","refs":["CH_GB18_CPL0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-06","text":"Der Argumenttyp ist nicht additiv, sondern rekursiv: Jede Verhältnisform legt die Unzulänglichkeit ihrer eigenen Bestimmung offen und erzeugt daraus ihre bestimmte Nachfolgeform.","refs":["CH_GB18_CPL0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-07","text":"Die gerichtete Bewegung führt von äußerlicher Relation über negative Vermittlung zu einer qualitativen Selbstbestimmung der Quantität, deren kategoriale Schließung das Maß bildet.","refs":["CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-08","text":"Die drei Verhältnisformen bilden daher keine bloße Reihenfolge mathematischer Operationen, sondern eine Spirale zunehmender Selbstbestimmung des Quantums.","refs":["CH_GB18_CPL0:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_26:GA-01","text":"[Persistent] Ein Quantum besitzt seine bestimmte Geltung nicht unabhängig, sondern nur in einer Beziehung, die seine Bestimmtheit vermittelt.","refs":["CH_GB18_DDVL:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-02","text":"[Mutating] Der Exponent ist die gemeinsame Bestimmtheit des Verhältnisses, deren Funktion vom Quotienten über das Produkt zur qualitativen Selbstbestimmung mutiert.","refs":["CH_GB18_DDVL:A3","CH_GB18_BDUV:A1","CH_GB18_CPL0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-03","text":"[Persistent] Verhältnisglieder bleiben als Quanta nur erhalten, indem ihre angebliche Selbstständigkeit zur Funktion eines gemeinsamen Verhältnisses entwirklicht wird.","refs":["CH_GB18_DDVL:D3","CH_GB18_BDUV:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-04","text":"[Mutating] Einheit und Anzahl wechseln von vertauschbaren Rollen über wechselseitige Negationen zu Momenten einer Einheit, die ihre Anzahl selbst enthält.","refs":["CH_GB18_DDVL:AS5","CH_GB18_BDUV:A5","CH_GB18_CPL0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-05","text":"[Emergent] Quantitative Veränderung ist nicht äußerlicher Wechsel, sondern wird schrittweise als immanente Selbstbestimmung des Verhältnisses bestimmt.","refs":["CH_GB18_BDUV:D1","CH_GB18_CPL0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-06","text":"[Attractor] Die Grenze ist die negative Einheit, in der die Seiten zugleich begrenzt, vermittelt und als Momente eines Ansichseins erhalten werden.","refs":["CH_GB18_BDUV:A7","CH_GB18_BDUV:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-07","text":"[Mutating] Das scheinbar unerreichbare Jenseits des Exponenten verliert den Status eines äußeren Unendlichen und wird als gegenwärtige affirmative Einheit bestimmt.","refs":["CH_GB18_BDUV:A9","CH_GB18_BDUV:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-08","text":"[Emergent] Andersseyn ist nur dann wahr, wenn die Negation des Quantums als Kontinuität seiner Selbstbeziehung in seinem Anderen besteht.","refs":["CH_GB18_CPL0:A7","CH_GB18_CPL0:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-09","text":"[Terminal] Die Totalität von Qualität und Quantität entsteht nur durch einen doppelten Übergang, nicht durch die unmittelbare Gleichsetzung beider Bestimmungen.","refs":["CH_GB18_CPL0:A12","CH_GB18_CPL0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-10","text":"[Terminal] Maß ist die Form, in der Quantität ihre gleichgültige Äußerlichkeit aufhebt und dadurch als qualitative Bestimmtheit abschließt.","refs":["CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-11","text":"[Attractor] Die Gleichsetzung eines Verhältnisglieds mit seinem Ansichsein vernichtet nicht nur das Gegenüber, sondern die Verhältnisform selbst.","refs":["CH_GB18_BDUV:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_26:RMD-01","text":"Das Quantum kehrt als Träger der Bewegung wieder, mutiert jedoch von einem äußerlich bestimmten Quantum zu einer Selbstbeziehung, die ihre Äußerlichkeit selbst erzeugt.","refs":["CH_GB18_DDVL:D1","CH_GB18_CPL0:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-02","text":"Der Exponent wird vom unbestimmt orientierten Quotienten über das Produkt der gegensätzlichen Seiten zur qualitativen Bestimmung der Potenz verschoben.","refs":["CH_GB18_DDVL:D4","CH_GB18_BDUV:A1","CH_GB18_CPL0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-03","text":"Einheit und Anzahl behalten keine stabile Identität, sondern werden zuerst vertauschbar, dann negativ wechselseitig und schließlich als Einheit der Anzahl absorbiert.","refs":["CH_GB18_DDVL:AS5","CH_GB18_BDUV:A5","CH_GB18_CPL0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-04","text":"Die Grenze mutiert von einer gemeinsamen Bestimmtheit über negative Schranke zur kontinuierlichen Vermittlung des Quantums mit seinem Andersseyn.","refs":["CH_GB18_DDVL:A2","CH_GB18_BDUV:D4","CH_GB18_CPL0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-05","text":"Veränderung wird von einer Modifikation einer Seite über notwendige Gegenveränderung zur selbstbegrenzten Bewegung des Quantums eskaliert.","refs":["CH_GB18_DDVL:D2","CH_GB18_BDUV:D2","CH_GB18_CPL0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-06","text":"Die Unendlichkeit erscheint zunächst als schlechte Annäherung an eine Grenze und wird dann in die Gegenwart des Exponenten zurückgenommen.","refs":["CH_GB18_BDUV:D5","CH_GB18_BDUV:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-07","text":"Direkte und umgekehrte Verhältnisse verschwinden nicht, sondern werden als unzureichende Vorformen in die Maßbestimmung des Potenzenverhältnisses absorbiert.","refs":["CH_GB18_CPL0:NX8","CH_GB18_CPL0:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_26:CGD-01","text":"Die Vertauschbarkeit von Einheit und Anzahl ist als Mangel des direkten Verhältnisses lokal, skaliert aber zur globalen Forderung, daß der Exponent seine eigenen Momente bestimmen muß.","refs":["CH_GB18_DDVL:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:CGD-02","text":"Die wechselseitige Wertbestimmung der Seiten gehört zunächst dem umgekehrten Verhältniß an, wird auf Clusterebene jedoch zur allgemeinen Entselbständigung jedes Verhältnisglieds.","refs":["CH_GB18_BDUV:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:CGD-03","text":"Die Einheit der Anzahl ist die spezifische Konstruktion des Potenzenverhältnisses, fungiert aber als gegenwärtige Lösung des gesamten Problems relationaler Quantität.","refs":["CH_GB18_CPL0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:CGD-04","text":"Die drei Verhältnisformen sind nicht gleichrangige Fälle, sondern notwendige Phasen einer Eskalation von äußerlicher Beziehung zu Selbstvermittlung.","refs":["CH_GB18_DDVL:SD4","CH_GB18_BDUV:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:CGD-05","text":"Die mathematische Bestimmung einzelner Quotienten, Produkte oder Potenzen bleibt untere Ebene; auf Clusterebene trägt allein ihre Funktion bei der Erzeugung qualitativer Selbstbestimmung.","refs":["CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_26:GNX-01","text":"Ausgeschlossen wird die Auffassung des Verhältnisses als äußerliche Verbindung bereits vollständig bestimmter Quanta.","refs":["CH_GB18_DDVL:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GNX-02","text":"Ausgeschlossen wird ein Exponent, der als bloßer Zahlenwert fungiert und keine qualitative Vermittlungsfunktion besitzt.","refs":["CH_GB18_BDUV:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GNX-03","text":"Ausgeschlossen wird ein Verhältnisglied, das seinen Wert unabhängig vom anderen Glied und vom Exponenten besitzen könnte.","refs":["CH_GB18_BDUV:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GNX-04","text":"Ausgeschlossen wird ein Jenseits, das von der endlichen Bewegung getrennt bliebe und nur als unendlicher Progress erreichbar wäre.","refs":["CH_GB18_BDUV:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GNX-05","text":"Ausgeschlossen wird eine Totalität, in der Quantität und Qualität als unvermittelte, selbständige Bereiche fortbestehen.","refs":["CH_GB18_CPL0:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_26:DBN-01","text":"Das Cluster disqualifiziert ein atomistisches Gesamtmodell, in dem relationale Bestimmtheit und volle Selbstständigkeit der Relata unmittelbar vereinbar wären.","refs":["CH_GB18_DDVL:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:DBN-02","text":"Es disqualifiziert eine Erklärung, die qualitative Bestimmtheit einer bereits fertigen quantitativen Bewegung äußerlich hinzufügt.","refs":["CH_GB18_BDUV:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:DBN-03","text":"Es disqualifiziert jede Totalität, die durch nur einen Übergang oder durch eine einseitige Identität hergestellt werden soll.","refs":["CH_GB18_CPL0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:DBN-04","text":"Es disqualifiziert die Vollendung des Verhältnisses in einer seiner Seiten, weil deren absolute Selbstgleichheit die Bedingung des Verhältnisses zerstört.","refs":["CH_GB18_BDUV:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_26:BSA-01","text":"Unverfügbar bleibt eine unmittelbare Versöhnung von quantitativer Variation und qualitativer Einheit ohne vermittelnde Negation.","refs":["CH_GB18_DDVL:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BSA-02","text":"Unverfügbare Letztbegründung ist jede Äußerlichkeit, die nicht als eigene Bestimmung des Quantums zurückgewonnen werden kann.","refs":["CH_GB18_CPL0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BSA-03","text":"Unmöglich ist ein Andersseyn, das sich nicht als Rückkehr zur Selbstbeziehung artikuliert.","refs":["CH_GB18_CPL0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BSA-04","text":"Unzulässig ist ein absolut selbstidentisches Verhältnisglied, das seine Selbstständigkeit bewahrt und zugleich Verhältnisglied bleibt.","refs":["CH_GB18_BDUV:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_26:XD-01","text":"Die Mutation des Exponenten vom Quotienten über das Produkt zur Potenz zeigt, daß seine Wahrheit nicht in einem festen Wert, sondern in der Erzeugung und Vermittlung seiner eigenen Momente liegt.","refs":["CL_GB18_26:GA-02","CL_GB18_26:GA-04","CH_GB18_DDVL:D4","CH_GB18_BDUV:A1","CH_GB18_CPL0:A5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_26:XD-02","text":"Die Entwicklung der Veränderung beweist, daß Quantität nur dann qualitativ bestimmt ist, wenn ihre Veränderlichkeit nicht von außen erfolgt, sondern ihre eigene Grenze hervorbringt.","refs":["CL_GB18_26:GA-05","CL_GB18_26:GA-06","CH_GB18_DDVL:D2","CH_GB18_BDUV:D1","CH_GB18_CPL0:D2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_26:XD-03","text":"Das Ganze kann weder Addition seiner Seiten noch erfüllte Selbstidentität einer Seite sein, sondern besteht nur in der Negation, welche beide Seiten als Momente erhält.","refs":["CL_GB18_26:GA-03","CL_GB18_26:GA-06","CL_GB18_26:GA-11","CH_GB18_BDUV:A8","CH_GB18_BDUV:SD2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_26:XD-04","text":"Die Aufhebung der schlechten Unendlichkeit und die Kontinuität der Grenze im Andersseyn bilden zusammen die Bedingung, unter der ein Jenseits als immanente Selbstvermittlung lesbar wird.","refs":["CL_GB18_26:GA-07","CL_GB18_26:GA-08","CH_GB18_BDUV:D6","CH_GB18_CPL0:A7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_26:XD-05","text":"Die Maßbestimmung kann nur erscheinen, weil die erste Identität von Qualität und Quantität als einseitig scheitert und durch den Rückgang in Qualität aufgehoben wird.","refs":["CL_GB18_26:GA-09","CL_GB18_26:GA-10","CH_GB18_CPL0:D8","CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_26:BSD-01","text":"Quantität wird auf Clusterebene zu einer Ontologie der vermittelten Äußerlichkeit: Sie ist nur, indem sie ihre Fremdheit als eigene Bestimmung hervorbringt.","refs":["CL_GB18_26:GA-01","CL_GB18_26:GA-05","CL_GB18_26:GA-08","CH_GB18_DDVL:SD1","CH_GB18_CPL0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_26:BSD-02","text":"Die Zeitform des Systems ist nicht linearer Fortschritt, sondern rekursive Rückkehr: scheinbare Annäherung wird als gegenwärtige Einheit reklassifiziert.","refs":["CL_GB18_26:GA-07","CL_GB18_26:GA-08","CH_GB18_BDUV:SD3","CH_GB18_CPL0:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_26:BSD-03","text":"Wissenschaftliche Bestimmung wird als immanente Kritik organisiert: Eine Form wird nicht verworfen, weil sie falsch wäre, sondern weil sie ihre eigene Bestimmung nicht vollständig realisiert.","refs":["CL_GB18_26:GA-02","CL_GB18_26:GA-09","CH_GB18_DDVL:ALT3","CH_GB18_CPL0:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_26:BSD-04","text":"Totalität besitzt keinen substantiellen Bestand neben ihren Momenten, sondern existiert nur als deren negative Vermittlung und reziproke Aufhebung.","refs":["CL_GB18_26:GA-03","CL_GB18_26:GA-06","CL_GB18_26:GA-09","CH_GB18_BDUV:SD2","CH_GB18_CPL0:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_26:BSD-05","text":"Maß ist keine weitere Größe neben anderen Größen, sondern die kategoriale Schließung, in der quantitative Äußerlichkeit als Qualität zurückkehrt.","refs":["CL_GB18_26:GA-09","CL_GB18_26:GA-10","CH_GB18_CPL0:ME5","CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_26:RLE-01","text":"Die zentrale Eskalationsbahn verläuft vom vertauschbaren Rollenverhältnis über den Exponenten als negative Grenze zur Einheit, in der Anzahl selbst Einheit wird.","refs":["CH_GB18_DDVL:FGS5","CH_GB18_BDUV:A4","CH_GB18_CPL0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RLE-02","text":"Die Seiten erzeugen eine rekursive Schleife: Jede erhält ihren Wert aus dem Mangel an der anderen, während ihre Negation die Einheit des Exponenten erhält.","refs":["CH_GB18_BDUV:A5","CH_GB18_BDUV:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RLE-03","text":"Der Exponent fungiert als Attraktor, weil jede Phase seine Funktion verändert, aber keine Phase die Bestimmtheit des Verhältnisses ohne ihn tragen kann.","refs":["CH_GB18_DDVL:A3","CH_GB18_BDUV:A7","CH_GB18_CPL0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RLE-04","text":"Die schlechte Unendlichkeit ist eine produktive Schleife: Ihr endloser Progress erzwingt die Einsicht, daß das gesuchte Jenseits bereits im Exponenten gegenwärtig ist.","refs":["CH_GB18_BDUV:D5","CH_GB18_BDUV:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RLE-05","text":"Qualität und Quantität bilden eine zweite Schleife, in der der Übergang zur Quantität nur als Rückkehr in Qualität zur Totalität werden kann.","refs":["CH_GB18_CPL0:A12","CH_GB18_CPL0:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_26:FGS-B01","text":"Äußerliches Quantum → Beziehung auf ein anderes Quantum → gemeinsame Bestimmtheit als Exponent.","refs":["CH_GB18_DDVL:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FGS-B02","text":"Gemeinsamer Exponent → Artikulation in Einheit und Anzahl → Seiten als unvollständige Funktionsmomente.","refs":["CH_GB18_DDVL:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FGS-B03","text":"Vertauschbare Rollen → Verlust bestimmter qualitativer Einheit → Negation der selbständigen Seitenwerte.","refs":["CH_GB18_DDVL:FGS5","CH_GB18_BDUV:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FGS-B04","text":"Negative Gegenseitigkeit → Exponent als Grenze und Ansichsein → Selbstbegrenzung des Quantums im Andersseyn.","refs":["CH_GB18_BDUV:A7","CH_GB18_CPL0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FGS-B05","text":"Selbstbegrenztes Andersseyn → qualitativer Exponent → doppelter Übergang von Qualität und Quantität.","refs":["CH_GB18_CPL0:A12","CH_GB18_CPL0:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FGS-B06","text":"Doppelte Vermittlung → aufgehobene gleichgültige Äußerlichkeit → Maß.","refs":["CH_GB18_CPL0:FGS8","CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_26:AFM-B01","text":"Äußerliches Quantum → relationale Bestimmtheit → Exponent als gemeinsame Grenze.","refs":["CH_GB18_DDVL:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:AFM-B02","text":"Gemeinsame Grenze → Vertauschbarkeit von Einheit und Anzahl → Unzulänglichkeit des direkten Verhältnisses.","refs":["CH_GB18_DDVL:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:AFM-B03","text":"Unzulänglicher Quotient → gegenläufige Veränderung → Exponent als negative Einheit und Produkt.","refs":["CH_GB18_BDUV:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:AFM-B04","text":"Negative Einheit → Selbstbeziehung des Quantums im Andersseyn → Potenzenverhältniß.","refs":["CH_GB18_BDUV:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:AFM-B05","text":"Potenzenverhältniß → doppelter Übergang von Qualität und Quantität → Maß.","refs":["CH_GB18_CPL0:AF3","CH_GB18_CPL0:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_26:MME-01","text":"Verhältnis wird von einer äußeren Vergleichsoperation zu einer Form umklassifiziert, in der Relata erst durch ihre Beziehung bestimmte Geltung erhalten.","refs":["CH_GB18_DDVL:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MME-02","text":"Der Exponent wird von einem neutralen Rechenwert zu einer Instanz verschoben, deren qualitative Legitimität an ihrer Vermittlung von Einheit und Anzahl geprüft wird.","refs":["CH_GB18_DDVL:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MME-03","text":"Die Seiten werden von vorgegebenen Größen zu wechselseitig erzeugten und begrenzten Verhältnisfunktionen reklassifiziert.","refs":["CH_GB18_BDUV:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MME-04","text":"Das Gegensatzpaar von endlichem Diesseits und unendlichem Jenseits bricht zusammen, weil das Jenseits als gegenwärtige affirmative Einheit bestimmt wird.","refs":["CH_GB18_BDUV:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MME-05","text":"Quantität und Qualität erscheinen nicht als getrennte ontologische Bereiche, sondern als Momente einer reziproken Übergangsstruktur.","refs":["CH_GB18_CPL0:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MME-06","text":"Maß kartiert das begriffliche Feld neu, weil es quantitative Bestimmtheit und qualitative Geltung als Resultat einer gemeinsamen Vermittlung fasst.","refs":["CH_GB18_CPL0:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_26:ALT-B01","text":"Auf der Oberflächenebene werden direkte, umgekehrte und potenzielle Verhältnisse als unterschiedliche Bestimmungen zweier oder mehrerer Quanta behandelt.","refs":["CH_GB18_DDVL:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:ALT-B02","text":"Auf der strukturellen Ebene werden die Seiten durch eine gemeinsame Grenze organisiert, die ihre Selbstständigkeit negiert und ihre Einheit vermittelt.","refs":["CH_GB18_BDUV:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:ALT-B03","text":"Auf der metastrategischen Ebene ersetzt das Cluster die Akzeptanz fester Größen durch die Prüfung der Vermittlung, durch welche Größen erst Verhältnisgeltung erhalten.","refs":["CH_GB18_BDUV:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:ALT-B04","text":"Auf der ontologischen und temporalen Ebene wird unmittelbares Daseyn als Bewegung begriffen, die in ihr Andersseyn übergeht und nur durch Rückkehr in sich bestimmt bleibt.","refs":["CH_GB18_CPL0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:ALT-B05","text":"Auf der methodologischen und performativen Ebene vollzieht die Rekonstruktion selbst die behauptete Bewegung, indem sie jede Bestimmung nur aus ihrer eigenen Unzulänglichkeit fortführt.","refs":["CH_GB18_CPL0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_26:FL-01","text":"Der Exponent ist instabil, weil er zunächst als beliebig gesetztes Quantum erscheint, später jedoch die notwendige immanente Grenze des Verhältnisses tragen soll.","refs":["CH_GB18_BDUV:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FL-02","text":"Der Exponent oszilliert zwischen endlichem Quantum und affirmativer Unendlichkeit; diese Spannung wird nicht beseitigt, sondern durch Vermittlung funktional gemacht.","refs":["CH_GB18_BDUV:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FL-03","text":"Das Potenzenverhältniß bleibt spannungsreich, weil es zugleich als äußere Veränderung erscheint und als vollständige Realisierung des Begriffs gelten soll.","refs":["CH_GB18_CPL0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FL-04","text":"Die Bestimmung der Quantität als Wahrheit der Qualität darf die Unterscheidung beider nicht auflösen, ohne die doppelte Vermittlung zu zerstören.","refs":["CH_GB18_CPL0:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MP-01","text":"Der Quotient mutiert im Übergang zum umgekehrten Verhältniß zum Produkt, weil die vertauschbaren Rollen der direkten Form keine bestimmte qualitative Orientierung tragen.","refs":["CH_GB18_DDVL:D4","CH_GB18_BDUV:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MP-02","text":"Der Exponent mutiert von der negativen Grenze der wechselseitigen Seitenbestimmung zur qualitativen Bestimmung einer Potenz.","refs":["CH_GB18_BDUV:A4","CH_GB18_CPL0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MP-03","text":"Die Grenze mutiert von einer negativen Schranke zu einer Kontinuität des Quantums in seinem Andersseyn.","refs":["CH_GB18_BDUV:D4","CH_GB18_CPL0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MP-04","text":"Äußerlichkeit kehrt ihre Valenz um: Was zuerst als gleichgültige Veränderbarkeit erscheint, wird am Ende als eigenes Bestimmen des Quantums lesbar.","refs":["CH_GB18_CPL0:A10","CH_GB18_CPL0:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_26:HSI-01","text":"Die Realität erscheint als Maschine vermittelte Äußerlichkeit: Ihre Bestimmtheiten bestehen nicht vor ihren Relationen, sondern nur als Selbstbestimmung durch Andersseyn.","refs":["CH_GB18_CPL0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:HSI-02","text":"Ein eigenständiges Subjekt wird nicht eingeführt; die Trägerfigur des Systems ist das Quantum, das nur als durch seine Grenze vermittelte Selbstbeziehung besteht.","refs":["CH_GB18_CPL0:A1","CH_GB18_CPL0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:HSI-03","text":"Zeit erscheint als Rückkehrstruktur, in der ein scheinbar fernes Jenseits nicht erreicht, sondern als bereits gegenwärtige Einheit begriffen wird.","refs":["CH_GB18_BDUV:SD3","CH_GB18_CPL0:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:HSI-04","text":"Erkenntnis bleibt nur möglich als immanente Navigation durch Formen, deren eigener Mangel den Übergang zu ihrer bestimmten Nachfolge erzeugt.","refs":["CH_GB18_DDVL:ALT3","CH_GB18_CPL0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_26:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung dieses Clusters vom direkten Verhältnis über negative Vermittlung zur Maßbestimmung zu rekonstruieren.","refs":["CH_GB18_CPL0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MRT-B02","text":"Unterbestimmt bleibt die formal-mathematische Operation der Potenz, weil sie kategorial bestimmt wird und nicht als algebraische Technik ausgeführt ist.","refs":["CH_GB18_CPL0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MRT-B03","text":"Die Kohärenz der Rekonstruktion hängt daran, Qualität als unmittelbare Bestimmung von der qualitativen Bestimmtheit der Quantität zu unterscheiden.","refs":["CH_GB18_CPL0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MRT-B04","text":"Die stärkste Architektur liegt in der doppelten Vermittlung, weil sie die einseitige Identität von Qualität und Quantität in eine notwendige Rückkehrstruktur überführt.","refs":["CH_GB18_CPL0:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MRT-B05","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung nur, wenn Maß nicht als unmittelbare Endform, sondern als Resultat der Rückkehr aus der quantitativen Äußerlichkeit in Qualität verstanden wird.","refs":["CH_GB18_CPL0:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121715093062Z_6ba6cc7f","language_code":"en","language_name":"English","title":"Chapters 76–78","source_sha256":"6d42cad5143da5b4c869dca0911aff8d76637ab9d950b92ebbc81140e94e7376","sha256":"24c916810ca0f2be3e2abfbf0a0dc66e140869c75bb5e2932a4ddef2863fe3f5","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:17:15.094637+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_26:BAS-01","text":"The cluster reconstructs how the external mutability of quantum can be comprehended only if it appears as an internal determination of a relation.","refs":["CH_GB18_DDVL:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-02","text":"Its global thesis is that a relation does not subsequently connect its sides, but first produces their quantitative determinacy as a common limit.","refs":["CH_GB18_DDVL:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-03","text":"The direct relation opens this movement, yet fails because unit and number remain interchangeable roles and the exponent therefore bears no determinate qualitative unit.","refs":["CH_GB18_DDVL:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-04","text":"The inverse relation releases the deficiency of the direct form, in that the alteration of each side becomes the negative determination of the other.","refs":["CH_GB18_BDUV:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-05","text":"The power relation transforms this negative reciprocity into a self-relation in which quantum itself limits and determines its otherness.","refs":["CH_GB18_CPL0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-06","text":"The type of argument is not additive but recursive: each form of relation exposes the inadequacy of its own determination and thereby generates its determinate succeeding form.","refs":["CH_GB18_CPL0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-07","text":"The directed movement leads from external relation through negative mediation to a qualitative self-determination of quantity, whose categorial closure constitutes measure.","refs":["CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BAS-08","text":"The three forms of relation therefore constitute not a mere sequence of mathematical operations, but a spiral of increasing self-determination of quantum.","refs":["CH_GB18_CPL0:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_26:GA-01","text":"[Persistent] A quantum possesses its determinate validity not independently, but only in a relation that mediates its determinacy.","refs":["CH_GB18_DDVL:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-02","text":"[Mutating] The exponent is the common determinacy of the relation, whose function mutates from quotient through product to qualitative self-determination.","refs":["CH_GB18_DDVL:A3","CH_GB18_BDUV:A1","CH_GB18_CPL0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-03","text":"[Persistent] Terms of relation are preserved as quanta only insofar as their alleged independence is actualized away into a function of a common relation.","refs":["CH_GB18_DDVL:D3","CH_GB18_BDUV:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-04","text":"[Mutating] Unit and number shift from interchangeable roles through reciprocal negations to moments of a unit that itself contains its number.","refs":["CH_GB18_DDVL:AS5","CH_GB18_BDUV:A5","CH_GB18_CPL0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-05","text":"[Emergent] Quantitative alteration is not external change, but is progressively determined as the immanent self-determination of the relation.","refs":["CH_GB18_BDUV:D1","CH_GB18_CPL0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-06","text":"[Attractor] The limit is the negative unity in which the sides are at once limited, mediated, and preserved as moments of an in-itself.","refs":["CH_GB18_BDUV:A7","CH_GB18_BDUV:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-07","text":"[Mutating] The seemingly unattainable beyond of the exponent loses the status of an external infinite and is determined as present affirmative unity.","refs":["CH_GB18_BDUV:A9","CH_GB18_BDUV:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-08","text":"[Emergent] Otherness is true only if the negation of quantum exists as the continuity of its self-relation in its other.","refs":["CH_GB18_CPL0:A7","CH_GB18_CPL0:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-09","text":"[Terminal] The totality of quality and quantity arises only through a double transition, not through the immediate equation of both determinations.","refs":["CH_GB18_CPL0:A12","CH_GB18_CPL0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-10","text":"[Terminal] Measure is the form in which quantity sublates its indifferent externality and thereby concludes as qualitative determinacy.","refs":["CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GA-11","text":"[Attractor] The equation of a term of relation with its in-itself destroys not only the counterpart but the form of relation itself.","refs":["CH_GB18_BDUV:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_26:RMD-01","text":"Quantum recurs as the bearer of movement, but mutates from an externally determined quantum into a self-relation that itself generates its externality.","refs":["CH_GB18_DDVL:D1","CH_GB18_CPL0:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-02","text":"The exponent is displaced from the indeterminately oriented quotient through the product of the opposed sides to the qualitative determination of power.","refs":["CH_GB18_DDVL:D4","CH_GB18_BDUV:A1","CH_GB18_CPL0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-03","text":"Unit and number retain no stable identity, but first become interchangeable, then negatively reciprocal, and finally are absorbed as the unity of number.","refs":["CH_GB18_DDVL:AS5","CH_GB18_BDUV:A5","CH_GB18_CPL0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-04","text":"The limit mutates from a common determinacy through negative restriction to the continuous mediation of quantum with its otherness.","refs":["CH_GB18_DDVL:A2","CH_GB18_BDUV:D4","CH_GB18_CPL0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-05","text":"Alteration is escalated from a modification of one side through necessary counter-alteration to the self-limiting movement of quantum.","refs":["CH_GB18_DDVL:D2","CH_GB18_BDUV:D2","CH_GB18_CPL0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-06","text":"Infinity initially appears as a bad approximation to a limit and is then taken back into the presence of the exponent.","refs":["CH_GB18_BDUV:D5","CH_GB18_BDUV:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RMD-07","text":"Direct and inverse relations do not disappear, but are absorbed as inadequate preliminary forms into the determination of measure of the power relation.","refs":["CH_GB18_CPL0:NX8","CH_GB18_CPL0:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_26:CGD-01","text":"The interchangeability of unit and number is local as a deficiency of the direct relation, but scales into the global requirement that the exponent must determine its own moments.","refs":["CH_GB18_DDVL:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:CGD-02","text":"The reciprocal value-determination of the sides initially belongs to the inverse relation, but at the cluster level becomes the general deprivation of independence of every term of relation.","refs":["CH_GB18_BDUV:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:CGD-03","text":"The unity of number is the specific construction of the power relation, but functions as the present solution to the entire problem of relational quantity.","refs":["CH_GB18_CPL0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:CGD-04","text":"The three forms of relation are not cases of equal rank, but necessary phases of an escalation from external relation to self-mediation.","refs":["CH_GB18_DDVL:SD4","CH_GB18_BDUV:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:CGD-05","text":"The mathematical determination of individual quotients, products, or powers remains at the lower level; at the cluster level, only their function in producing qualitative self-determination is operative.","refs":["CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_26:GNX-01","text":"Excluded is the conception of relation as an external connection of already fully determined quanta.","refs":["CH_GB18_DDVL:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GNX-02","text":"Excluded is an exponent that functions as a mere numerical value and possesses no qualitative mediating function.","refs":["CH_GB18_BDUV:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GNX-03","text":"Excluded is a term of relation that could possess its value independently of the other term and of the exponent.","refs":["CH_GB18_BDUV:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GNX-04","text":"Excluded is a beyond that would remain separated from finite movement and be attainable only as infinite progress.","refs":["CH_GB18_BDUV:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:GNX-05","text":"Excluded is a totality in which quantity and quality persist as unmediated, independent domains.","refs":["CH_GB18_CPL0:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_26:DBN-01","text":"The cluster disqualifies an atomistic overall model in which relational determinacy and the full independence of the relata would be immediately compatible.","refs":["CH_GB18_DDVL:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:DBN-02","text":"It disqualifies an explanation that externally adds qualitative determinacy to an already completed quantitative movement.","refs":["CH_GB18_BDUV:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:DBN-03","text":"It disqualifies every totality that is supposed to be produced through only one transition or through a one-sided identity.","refs":["CH_GB18_CPL0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:DBN-04","text":"It disqualifies the completion of relation in one of its sides, because their absolute self-equality destroys the condition of relation.","refs":["CH_GB18_BDUV:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_26:BSA-01","text":"Unavailable remains an immediate reconciliation of quantitative variation and qualitative unity without mediating negation.","refs":["CH_GB18_DDVL:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BSA-02","text":"Unavailable ultimate grounding is every externality that cannot be regained as quantum's own determination.","refs":["CH_GB18_CPL0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BSA-03","text":"Impossible is an otherness that does not articulate itself as a return to self-relation.","refs":["CH_GB18_CPL0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:BSA-04","text":"Impermissible is an absolutely self-identical term of relation that preserves its independence and yet remains a term of relation.","refs":["CH_GB18_BDUV:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_26:XD-01","text":"The mutation of the exponent from quotient through product to power shows that its truth lies not in a fixed value, but in the production and mediation of its own moments.","refs":["CL_GB18_26:GA-02","CL_GB18_26:GA-04","CH_GB18_DDVL:D4","CH_GB18_BDUV:A1","CH_GB18_CPL0:A5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_26:XD-02","text":"The development of alteration proves that quantity is qualitatively determined only when its mutability does not occur from outside, but brings forth its own limit.","refs":["CL_GB18_26:GA-05","CL_GB18_26:GA-06","CH_GB18_DDVL:D2","CH_GB18_BDUV:D1","CH_GB18_CPL0:D2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_26:XD-03","text":"The whole can be neither the addition of its sides nor the fulfilled self-identity of one side, but consists only in the negation that preserves both sides as moments.","refs":["CL_GB18_26:GA-03","CL_GB18_26:GA-06","CL_GB18_26:GA-11","CH_GB18_BDUV:A8","CH_GB18_BDUV:SD2"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_26:XD-04","text":"The sublation of bad infinity and the continuity of the limit in otherness together form the condition under which a beyond becomes legible as immanent self-mediation.","refs":["CL_GB18_26:GA-07","CL_GB18_26:GA-08","CH_GB18_BDUV:D6","CH_GB18_CPL0:A7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_26:XD-05","text":"The determination of measure can appear only because the first identity of quality and quantity fails as one-sided and is sublated through the return into quality.","refs":["CL_GB18_26:GA-09","CL_GB18_26:GA-10","CH_GB18_CPL0:D8","CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_26:BSD-01","text":"At the cluster level, quantity becomes an ontology of mediated externality: it is only by bringing forth its alienness as its own determination.","refs":["CL_GB18_26:GA-01","CL_GB18_26:GA-05","CL_GB18_26:GA-08","CH_GB18_DDVL:SD1","CH_GB18_CPL0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_26:BSD-02","text":"The temporal form of the system is not linear progress but recursive return: apparent approximation is reclassified as present unity.","refs":["CL_GB18_26:GA-07","CL_GB18_26:GA-08","CH_GB18_BDUV:SD3","CH_GB18_CPL0:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_26:BSD-03","text":"Scientific determination is organized as immanent critique: a form is not rejected because it would be false, but because it does not fully realize its own determination.","refs":["CL_GB18_26:GA-02","CL_GB18_26:GA-09","CH_GB18_DDVL:ALT3","CH_GB18_CPL0:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_26:BSD-04","text":"Totality has no substantial subsistence alongside its moments, but exists only as their negative mediation and reciprocal sublation.","refs":["CL_GB18_26:GA-03","CL_GB18_26:GA-06","CL_GB18_26:GA-09","CH_GB18_BDUV:SD2","CH_GB18_CPL0:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_26:BSD-05","text":"Measure is not a further magnitude alongside other magnitudes, but the categorial closure in which quantitative externality returns as quality.","refs":["CL_GB18_26:GA-09","CL_GB18_26:GA-10","CH_GB18_CPL0:ME5","CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_26:RLE-01","text":"The central path of escalation runs from the relation of interchangeable roles through the exponent as negative limit to the unity in which number itself becomes unit.","refs":["CH_GB18_DDVL:FGS5","CH_GB18_BDUV:A4","CH_GB18_CPL0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RLE-02","text":"The sides produce a recursive loop: each receives its value from the deficiency in the other, while their negation preserves the unity of the exponent.","refs":["CH_GB18_BDUV:A5","CH_GB18_BDUV:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RLE-03","text":"The exponent functions as an attractor because each phase changes its function, but no phase can bear the determinacy of the relation without it.","refs":["CH_GB18_DDVL:A3","CH_GB18_BDUV:A7","CH_GB18_CPL0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RLE-04","text":"Bad infinity is a productive loop: its endless progress compels the insight that the sought beyond is already present in the exponent.","refs":["CH_GB18_BDUV:D5","CH_GB18_BDUV:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:RLE-05","text":"Quality and quantity form a second loop in which the transition to quantity can become totality only as a return into quality.","refs":["CH_GB18_CPL0:A12","CH_GB18_CPL0:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_26:FGS-B01","text":"External quantum → relation to another quantum → common determinacy as exponent.","refs":["CH_GB18_DDVL:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FGS-B02","text":"Common exponent → articulation into unit and number → sides as incomplete functional moments.","refs":["CH_GB18_DDVL:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FGS-B03","text":"Interchangeable roles → loss of determinate qualitative unit → negation of the independent values of the sides.","refs":["CH_GB18_DDVL:FGS5","CH_GB18_BDUV:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FGS-B04","text":"Negative reciprocity → exponent as limit and in-itself → self-limitation of quantum in otherness.","refs":["CH_GB18_BDUV:A7","CH_GB18_CPL0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FGS-B05","text":"Self-limited otherness → qualitative exponent → double transition of quality and quantity.","refs":["CH_GB18_CPL0:A12","CH_GB18_CPL0:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FGS-B06","text":"Double mediation → sublated indifferent externality → measure.","refs":["CH_GB18_CPL0:FGS8","CH_GB18_CPL0:D9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_26:AFM-B01","text":"External quantum → relational determinacy → exponent as common limit.","refs":["CH_GB18_DDVL:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:AFM-B02","text":"Common limit → interchangeability of unit and number → inadequacy of the direct relation.","refs":["CH_GB18_DDVL:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:AFM-B03","text":"Inadequate quotient → countervailing alteration → exponent as negative unity and product.","refs":["CH_GB18_BDUV:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:AFM-B04","text":"Negative unity → self-relation of quantum in otherness → power relation.","refs":["CH_GB18_BDUV:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:AFM-B05","text":"Power relation → double transition of quality and quantity → measure.","refs":["CH_GB18_CPL0:AF3","CH_GB18_CPL0:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_26:MME-01","text":"Relation is reclassified from an external operation of comparison into a form in which relata first receive determinate validity through their relation.","refs":["CH_GB18_DDVL:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MME-02","text":"The exponent is displaced from a neutral computational value into an instance whose qualitative legitimacy is tested by its mediation of unit and number.","refs":["CH_GB18_DDVL:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MME-03","text":"The sides are reclassified from pregiven magnitudes into reciprocally generated and limited relational functions.","refs":["CH_GB18_BDUV:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MME-04","text":"The opposition between finite here and infinite beyond collapses because the beyond is determined as present affirmative unity.","refs":["CH_GB18_BDUV:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MME-05","text":"Quantity and quality appear not as separate ontological domains, but as moments of a structure of reciprocal transition.","refs":["CH_GB18_CPL0:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MME-06","text":"Measure remaps the conceptual field because it comprehends quantitative determinacy and qualitative validity as the result of a common mediation.","refs":["CH_GB18_CPL0:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_26:ALT-B01","text":"At the surface level, direct, inverse, and power relations are treated as different determinations of two or more quanta.","refs":["CH_GB18_DDVL:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:ALT-B02","text":"At the structural level, the sides are organized by a common limit that negates their independence and mediates their unity.","refs":["CH_GB18_BDUV:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:ALT-B03","text":"At the metastrategic level, the cluster replaces the acceptance of fixed magnitudes with an examination of the mediation through which magnitudes first receive relational validity.","refs":["CH_GB18_BDUV:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:ALT-B04","text":"At the ontological and temporal level, immediate being is comprehended as a movement that passes over into its otherness and remains determined only through return into itself.","refs":["CH_GB18_CPL0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:ALT-B05","text":"At the methodological and performative level, the reconstruction itself carries out the asserted movement by continuing each determination only from its own inadequacy.","refs":["CH_GB18_CPL0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_26:FL-01","text":"The exponent is unstable because it initially appears as an arbitrarily posited quantum, yet is later supposed to bear the necessary immanent limit of the relation.","refs":["CH_GB18_BDUV:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FL-02","text":"The exponent oscillates between finite quantum and affirmative infinity; this tension is not eliminated, but rendered functional through mediation.","refs":["CH_GB18_BDUV:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FL-03","text":"The power relation remains tension-laden because it appears at once as external alteration and is supposed to count as the complete realization of the concept.","refs":["CH_GB18_CPL0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:FL-04","text":"The determination of quantity as the truth of quality must not dissolve the distinction between the two without destroying the double mediation.","refs":["CH_GB18_CPL0:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MP-01","text":"The quotient mutates in the transition to the inverse relation into the product, because the interchangeable roles of the direct form bear no determinate qualitative orientation.","refs":["CH_GB18_DDVL:D4","CH_GB18_BDUV:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MP-02","text":"The exponent mutates from the negative limit of reciprocal side-determination to the qualitative determination of a power.","refs":["CH_GB18_BDUV:A4","CH_GB18_CPL0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MP-03","text":"The limit mutates from a negative restriction into a continuity of quantum in its otherness.","refs":["CH_GB18_BDUV:D4","CH_GB18_CPL0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MP-04","text":"Externality reverses its valence: what first appears as indifferent mutability becomes legible in the end as quantum's own determining.","refs":["CH_GB18_CPL0:A10","CH_GB18_CPL0:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_26:HSI-01","text":"Reality appears as a machine of mediated externality: its determinacies do not subsist prior to their relations, but only as self-determination through otherness.","refs":["CH_GB18_CPL0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:HSI-02","text":"No independent subject is introduced; the bearer-figure of the system is quantum, which exists only as self-relation mediated through its limit.","refs":["CH_GB18_CPL0:A1","CH_GB18_CPL0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:HSI-03","text":"Time appears as a structure of return in which a seemingly distant beyond is not attained, but comprehended as an already present unity.","refs":["CH_GB18_BDUV:SD3","CH_GB18_CPL0:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:HSI-04","text":"Cognition remains possible only as immanent navigation through forms whose own deficiency generates the transition to their determinate succession.","refs":["CH_GB18_DDVL:ALT3","CH_GB18_CPL0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_26:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement of this cluster from direct relation through negative mediation to the determination of measure.","refs":["CH_GB18_CPL0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MRT-B02","text":"The formal-mathematical operation of power remains underdetermined because it is categorically determined and not carried out as an algebraic technique.","refs":["CH_GB18_CPL0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MRT-B03","text":"The coherence of the reconstruction depends on distinguishing quality as immediate determination from the qualitative determinacy of quantity.","refs":["CH_GB18_CPL0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MRT-B04","text":"The strongest architecture lies in double mediation because it transforms the one-sided identity of quality and quantity into a necessary structure of return.","refs":["CH_GB18_CPL0:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_26:MRT-B05","text":"The reconstruction preserves the actual movement only if measure is understood not as an immediate final form, but as the result of the return from quantitative externality into quality.","refs":["CH_GB18_CPL0:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_26@R001","source_variant_id":"canonical:CL_GB18_26:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 76–78","context":"A. Das direkte Verhältniß. · B. Das umgekehrte Verhältniß. · C. Potenzverhältniß."},"title_language_code":"en"},{"id":"CL_GB18_27","layer":"CL","title":"Chapters 79–81","order":27,"parents":["CH_GB18_A_20","CH_GB18_DADM","CH_GB18_DSQ0"],"revision":"CL_GB18_27@R001","sha256":"213c6bb9c54da2172c8809fdb9034ead3c9affbf283e8efc6d4b383d49440a69","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_27:AS-01","text":"Das Clusterproblem besteht darin, quantitative Veränderung zugleich als zunächst gleichgültig und als Träger qualitativen Untergangs zu bestimmen, ohne sie zu einer bloß äußeren Skala zu verflachen.","refs":["CH_GB18_DSQ0:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-02","text":"Die Neubestimmung verlegt Quantität in die Vermittlungsform des Maßes, in der sie nur als Moment qualitativer Bestimmtheit und nicht als selbständiges Erklärungsprinzip gilt.","refs":["CH_GB18_DADM:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-03","text":"Die tragende Unterscheidung trennt quantitative Bestimmtheit von begrifflicher Bestimmtheit, ohne Quantität deshalb vollständig zu eliminieren: Sie bleibt im Maß real, verliert aber jede Befugnis, den Begriff von außen zu formen.","refs":["CH_GB18_A_20:AS3","CH_GB18_DSQ0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-04","text":"Der Beweisgang zeigt, dass wiederholte äußerliche Änderungen ihre Gleichgültigkeit verlieren, sobald sie die immanente Einheit eines Daseins betreffen, und dass Wahrheit daher die Erhaltung des Unterschieds in Vermittlung verlangt.","refs":["CH_GB18_DSQ0:D2","CH_GB18_DADM:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-05","text":"Die gerichtete Bewegung führt von äußerer Quantifizierung über spezifische Maßgrenzen und qualitative Umschläge zur Selbstvermittlung des Maßes und damit zum Übergang in das Wesen.","refs":["CH_GB18_DSQ0:FGS4","CH_GB18_DADM:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-06","text":"Die Bewegung ist kumulativ und rekursiv: Jede zunächst gleichgültige quantitative Variation kehrt als Bedingung eines qualitativen Ganzen wieder, während die vermittelte Beziehung ihre eigene Unmittelbarkeit umbildet.","refs":["CH_GB18_DSQ0:A6","CH_GB18_DADM:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-07","text":"Die Schließung ist keine Mathematisierung des Ganzen, weil quantitative Gesetzlichkeit im Geistigen keinen freien Eigenbereich besitzt und symbolische Bezeichnungen nach gelungener Begriffsbestimmung ihren Erkenntnisrang verlieren.","refs":["CH_GB18_DADM:A14","CH_GB18_A_20:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-08","text":"Das Cluster schließt mit einem Selbstbegründungskriterium: Philosophische Form ist nur dort gültig, wo ihre Begriffsbestimmtheit unabhängig von äußerer Darstellung ausgewiesen ist.","refs":["CH_GB18_A_20:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_27:GA-01","text":"[Persistent] Das Unendliche und jede höhere begriffliche Bestimmung verlangen eine affirmative qualitative Bestimmung; die Negation quantitativer Endlichkeit genügt nicht.","refs":["CH_GB18_A_20:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-02","text":"[Persistent] Maß ist die unmittelbare Einheit von Qualität und Quantität, in der Quantität ihre bloße Gleichgültigkeit verliert, ohne als Moment zu verschwinden.","refs":["CH_GB18_DADM:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-03","text":"[Mutating] Äußerlichkeit wird nur dann begrifflich tragfähig, wenn sie sich auf sich selbst bezieht und ihre eigene bloße Äußerlichkeit aufhebt.","refs":["CH_GB18_DADM:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-04","text":"[Persistent] Quantitative Variation ist nur innerhalb einer immanenten Maßgrenze legitim; an dieser Grenze wird ihre Fortsetzung qualitativ wirksam.","refs":["CH_GB18_DSQ0:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-05","text":"[Emergent] Das Maßlose ist keine äußere Gegenmacht des Maßes, sondern dessen immanente Negativität, durch die die Selbständigkeit einzelner Maße in Übergang übergeht.","refs":["CH_GB18_DADM:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-06","text":"[Attractor] Symbolische, numerische oder vergleichende Formen besitzen nur abgeleitete Geltung: Sie sind nur zulässig, wenn ihre Begriffsbestimmtheit zuvor ausgewiesen ist, und werden nach diesem Nachweis entbehrlich.","refs":["CH_GB18_A_20:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-07","text":"[Terminal] Der Übergang in das Wesen ist die Selbstvermittlung des Maßes durch die Aufhebung seiner Unmittelbarkeit, nicht der Abbruch seiner Bewegung.","refs":["CH_GB18_DADM:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-08","text":"[Persistent] Die Reichweite quantitativer Erklärung sinkt mit wachsender Konkretion; was im Mechanischen gesetzmäßig erscheint, kann Organisches und Geistiges nicht unmittelbar bestimmen.","refs":["CH_GB18_DADM:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-09","text":"[Attractor] Konkrete Wahrheit besteht weder in unterschiedsloser Einheit noch in isolierter Differenz, sondern in der Bewahrung des Unterschieds als Moment einer vermittelten Einheit.","refs":["CH_GB18_DADM:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_27:RMD-01","text":"Das Quantum kehrt nicht mit stabiler Funktion wieder: Als äußerlicher Unterschied ist es für den Begriff oberflächlich; als Maß wird es zur immanenten Bestimmtheit eines bestimmten Daseins.","refs":["CH_GB18_A_20:NX3","CH_GB18_DSQ0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RMD-02","text":"Äußerlichkeit mutiert von einer zu überwindenden Fremdform zu einer Selbstbeziehung: Nicht die Abschaffung des Äußeren, sondern dessen Rückkehr in die eigene Bestimmtheit bildet die Vermittlungsoperation.","refs":["CH_GB18_DADM:AS2","CH_GB18_DADM:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RMD-03","text":"Die Kritik des negativen Unendlichen wird funktional in die Bestimmung des Maßlosen verschoben: Das Maßlose ist nicht mit dem Unendlichen identisch, übernimmt aber die Aufgabe, eine bloß äußerliche Begrenzung zu sprengen.","refs":["CH_GB18_A_20:AS2","CH_GB18_DADM:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RMD-04","text":"Zahlen und Potenzen verlieren den Anspruch, wesentliche Unterschiede selbst auszudrücken, während Größe im spezifischen Quantum als konstitutive Bestimmtheit des Daseins wiederkehrt.","refs":["CH_GB18_A_20:A8","CH_GB18_DSQ0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RMD-05","text":"Die historische Bewegung von numerischen Bezeichnungen zu selbstständigen Gedankenbestimmungen wird nicht aufgehoben, sondern regionalisiert: Quantität bleibt erklärungskräftig, jedoch nur innerhalb begrenzter Gegenstandsbereiche.","refs":["CH_GB18_A_20:A9","CH_GB18_DADM:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_27:CGD-01","text":"Die Kritik bestimmter Potenzfolgen bleibt lokal, doch ihr gültiger Ertrag skaliert als allgemeine Regel: Keine quantitative Entwicklungsordnung darf als Begriffsdifferenz ausgegeben werden.","refs":["CH_GB18_A_20:D3","CH_GB18_A_20:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:CGD-02","text":"Die Sorites-Figur bleibt ein lokaler Prüfstein, wird auf Clusterebene jedoch zum allgemeinen Modell dafür, dass quantitative Wiederholung ihre ontologische Funktion mit der erreichten Grenze verändert.","refs":["CH_GB18_DSQ0:NX4","CH_GB18_DSQ0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:CGD-03","text":"Die Kritik von Substanz, Modus und Pantheismus ist lokal-historisch, aber ihre höhere Regel ist global: Jede Einheit, die Differenz bloß auslöscht, verfehlt konkrete Vermittlung.","refs":["CH_GB18_DADM:D5","CH_GB18_DADM:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:CGD-04","text":"Die konkrete Bestimmung einzelner Maßgrenzen verbleibt auf der unteren Ebene besonderer Gegenstände; die Clusterebene bestimmt nur, dass solche Grenzen immanent sein müssen und nicht aus einem äußeren Grundmaß folgen.","refs":["CH_GB18_DSQ0:MRT2","CH_GB18_DADM:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_27:GNX-01","text":"Ausgeschlossen ist ein äußeres quantitatives Schema, das dem Begriff seine Wahrheit verleiht oder begriffliche Selbstbestimmung ersetzt.","refs":["CH_GB18_A_20:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GNX-02","text":"Ausgeschlossen ist eine Philosophie, in der symbolische Verfügbarkeit die fehlende Selbstbestimmung kompensiert und begriffliche Arbeit durch Zeichenökonomie ersetzt.","refs":["CH_GB18_A_20:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GNX-03","text":"Ausgeschlossen ist ein universeller äußerer Maßstab, aus dem die ursprünglichen Maße besonderer Dinge deduzierbar wären.","refs":["CH_GB18_DSQ0:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GNX-04","text":"Ausgeschlossen ist die Annahme unbegrenzter quantitativer Veränderung, innerhalb deren ein Dasein notwendig dasselbe bliebe.","refs":["CH_GB18_DSQ0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GNX-05","text":"Ausgeschlossen sind sowohl metaphysische Einheiten, die Differenz annullieren, als auch wissenschaftliche Verallgemeinerungen, die quantitative Gesetzlichkeit unmittelbar auf konkrete Natur und Geist übertragen.","refs":["CH_GB18_DADM:NX3","CH_GB18_DADM:NX7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_27:DBN-01","text":"Das System kann keinen externen Maßstab zulassen, der Begriffsbestimmung ersetzt oder nachträglich legitimiert; Wahrheit muss aus der Selbstbestimmung des Gegenstands hervorgehen.","refs":["CH_GB18_A_20:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:DBN-02","text":"Das System kann keine unmittelbare Einheit anerkennen, die ohne innere Differenz und erzwungene Vermittlung bestünde.","refs":["CH_GB18_DADM:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:DBN-03","text":"Das System kann weder ein unmittelbar verfügbares Wesen noch eine universale mathematische Erklärung konkreter Wirklichkeit zulassen; beides würde Vermittlung durch äußere Abstraktion ersetzen.","refs":["CH_GB18_DADM:NX6","CH_GB18_DADM:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_27:BSA-01","text":"Nicht verfügbar ist ein gemeinsames äußeres Medium, in dem Quantum, Begriff, Natur und Geist ohne kategoriale Transformation unmittelbar kommensurabel wären.","refs":["CH_GB18_A_20:SNX3","CH_GB18_DSQ0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:BSA-02","text":"Unzulässig ist eine endgültige Einheit ohne Selbstbeziehung des Unterschieds; jede solche Einheit fällt entweder in starre Substanz oder in maßlose Zerstreuung zurück.","refs":["CH_GB18_DADM:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:BSA-03","text":"Nicht zulässig ist eine Kausalität der bloßen Addition; quantitative Summation muss als Wirksamkeit eines immanenten Maßes verstanden werden.","refs":["CH_GB18_DSQ0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_27:XD-01","text":"Quantität wird weder verworfen noch zum Modell des Begriffs erhoben: Sie ist nur als immanentes Moment des Maßes gültig und bleibt als äußere Begriffsschablone kategorial unangemessen.","refs":["CL_GB18_27:GA-02","CL_GB18_27:GA-03","CL_GB18_27:GA-06","CH_GB18_A_20:NX3","CH_GB18_DSQ0:A2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:XD-02","text":"Äußerer Vergleichsmaßstab und symbolische Form gehören derselben abgeleiteten Geltungsweise an: Beide können operativ vergleichen oder bezeichnen, aber weder die spezifische Bestimmtheit eines Gegenstands noch die Wahrheit des Begriffs erzeugen.","refs":["CL_GB18_27:GA-04","CL_GB18_27:GA-06","CH_GB18_A_20:SNX2","CH_GB18_DSQ0:D5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:XD-03","text":"Die qualitative Schwelle ist keine Unterbrechung der quantitativen Bewegung von außen, sondern deren immanente Umkehrung: Fortgesetzte Variation legt die Negativität frei, die in der Selbständigkeit des Maßes schon wirksam war.","refs":["CL_GB18_27:GA-04","CL_GB18_27:GA-05","CH_GB18_DSQ0:SD1","CH_GB18_DADM:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:XD-04","text":"Die Kritik äußerer Zahlenschemata und die Kritik abstrakter Substanz bilden eine einzige Grenzoperation, weil beide Vermittlung entweder durch Formalisierung oder durch Auslöschung des Unterschieds suspendieren.","refs":["CL_GB18_27:GA-06","CL_GB18_27:GA-09","CH_GB18_DADM:SD2","CH_GB18_A_20:SNX1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:XD-05","text":"Die Begrenzung quantitativer Gesetzlichkeit auf bestimmte Realisationsbereiche verhindert zugleich zwei Fehlschlüsse: dass Mechanismus das Modell aller Wirklichkeit sei und dass Geist als frei bestimmbar durch Maßgesetze erscheine.","refs":["CL_GB18_27:GA-08","CH_GB18_DADM:SD3","CH_GB18_DADM:A14"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_27:BSD-01","text":"Quantität erhält einen doppelten ontologischen Status: Als äußerliche Form bleibt sie abstrakt, als in Maß rückkehrende Äußerlichkeit wird sie Träger qualitativer Wirklichkeit.","refs":["CL_GB18_27:GA-02","CL_GB18_27:GA-03","CL_GB18_27:GA-04","CH_GB18_DSQ0:SD1","CH_GB18_DADM:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:BSD-02","text":"Zeit wird als kumulative Wirksamkeit bestimmt: Was in der Einzelvariation indifferent erscheint, wird durch Wiederholung zur immanenten Vermittlung von Untergang oder Qualitätswechsel.","refs":["CL_GB18_27:GA-04","CL_GB18_27:GA-05","CH_GB18_DSQ0:SD2","CH_GB18_DSQ0:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:BSD-03","text":"Erkenntnis wird von der Anschaulichkeit eines Zeichens auf die Prüfung verlegt, ob eine Form ihre Bestimmtheit selbst tragen kann; legitime Abstraktion bleibt deshalb möglich, aber nicht selbstbegründend.","refs":["CL_GB18_27:GA-06","CH_GB18_A_20:SD5","CH_GB18_DSQ0:MRT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:BSD-04","text":"Das System erzeugt eine gestufte Ontologie der Erklärbarkeit: Mechanische Regelmäßigkeit ist keine universale Metaphysik, sondern die maximale Realisation einer Form, deren Geltung mit organischer und geistiger Konkretion abnimmt.","refs":["CL_GB18_27:GA-08","CH_GB18_DADM:ME4","CH_GB18_DADM:A14"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_27:RLE-01","text":"Quantitative Variation → Wiederholung → Summation → Maßgrenze → qualitativer Umschlag → neues Dasein bildet die zentrale rekursive Schleife der zeitlichen Bewegung.","refs":["CH_GB18_DSQ0:A6","CH_GB18_DSQ0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RLE-02","text":"Symbolischer Ausdruck → Forderung begrifflicher Ausweisung → Selbstbezeichnung des Begriffs → Überflüssigkeit des Symbols → Diagnose begrifflicher Ersparnis bildet die epistemische Schleife.","refs":["CH_GB18_A_20:A12","CH_GB18_A_20:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RLE-03","text":"Unmittelbares Maß → spezifische Maßverhältnisse → Maßlosigkeit → umgekehrtes Verhältnis → Reflexion → Wesen bildet den ontologischen Eskalationspfad.","refs":["CH_GB18_DADM:FGS3","CH_GB18_DADM:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RLE-04","text":"Selbstbezügliche Bestimmtheit ist der begriffliche Attraktor, auf den sowohl die Kritik äußerer Quantifizierung als auch die Entwicklung des Maßes konvergieren.","refs":["CH_GB18_DADM:AS2","CH_GB18_A_20:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_27:FGS-B01","text":"Äußere Quantifizierung oder symbolische Staffelung → Kategorienprüfung → Nachweis, dass Formähnlichkeit keine Begriffsbestimmtheit erzeugt.","refs":["CH_GB18_A_20:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FGS-B02","text":"Quantum als gleichgültige Grenze → Differenz von spezifischem und äußerlich variablem Quantum → Maß als innere Struktur eines Daseins.","refs":["CH_GB18_DSQ0:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FGS-B03","text":"Äußerliche Variation → Wiederholung und Summation → Überschreitung der spezifischen Grenze → qualitative Veränderung oder Untergang.","refs":["CH_GB18_DSQ0:FGS4","CH_GB18_DSQ0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FGS-B04","text":"Selbständigkeit spezifischer Maße → Maßlosigkeit als immanente Negativität → Reflexion der Unmittelbarkeit → Übergang in das Wesen.","refs":["CH_GB18_DADM:FGS4","CH_GB18_DADM:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FGS-B05","text":"Ausgewiesene Begriffsbestimmtheit → Entmachtung äußerer Symbole und Maßstäbe → regionale Begrenzung quantitativer Erklärung → Vorrang selbstvermittelter Form.","refs":["CH_GB18_A_20:A12","CH_GB18_DADM:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_27:AFM-B01","text":"Äußeres Quantum und numerische Staffelung → Trennung quantitativer von begrifflicher Differenz → Ausschluss der Zahl als unmittelbarer Begriffsform.","refs":["CH_GB18_A_20:FGS2","CH_GB18_DSQ0:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AFM-B02","text":"Quantitative Gleichgültigkeit → Maß als vermittelte Einheit → Aufhebung der bloßen Gegenüberstellung von Qualität und Quantität.","refs":["CH_GB18_DADM:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AFM-B03","text":"Immanente Maßgrenze → begrenzte Variabilität → Wiederholung quantitativer Änderungen → qualitative Wirksamkeit der Grenze.","refs":["CH_GB18_DSQ0:D1","CH_GB18_DSQ0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AFM-B04","text":"Spezifische Maßverhältnisse → Maßlosigkeit → Selbstvermittlung der Unmittelbarkeit → Wesen.","refs":["CH_GB18_DADM:D4","CH_GB18_DADM:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AFM-B05","text":"Regionale Realisation des Maßes → Begrenzung seiner Gesetzlichkeit im Geistigen → Selbstbegründung des Begriffs statt äußerer Darstellung.","refs":["CH_GB18_DADM:AF4","CH_GB18_A_20:A13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_27:MME-01","text":"Symbolischer Gebrauch und philosophische Form werden als getrennte Geltungsweisen kartiert: Das Zeichen kann bezeichnen, ohne deshalb Wahrheit zu begründen.","refs":["CH_GB18_A_20:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MME-02","text":"Der Gegensatz zwischen gradueller und sprunghafter Veränderung wird in eine Einheit kontinuierlicher Akkumulation und qualitativen Umschlags umgeordnet.","refs":["CH_GB18_DSQ0:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MME-03","text":"Der Gegensatz zwischen natürlichem Maß und konventionellem Maßstab wird in immanente Gegenstandsbestimmtheit und äußere Vergleichung zerlegt.","refs":["CH_GB18_DSQ0:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MME-04","text":"Die Karte quantitativer Erklärung wird regional gestaffelt: Das Mechanische bildet ihren stärksten Bereich, das Organische unterordnet sie höheren Verhältnissen, und das Geistige entzieht sich eigenen Maßgesetzen.","refs":["CH_GB18_DADM:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_27:ALT-B01","text":"Surface level — Das spezifische Quantum erscheint als unmittelbare Gestalt des Maßes, in der Größe nicht bloß verglichen, sondern als Bestimmtheit eines Daseins begriffen wird.","refs":["CH_GB18_DSQ0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:ALT-B02","text":"Structural level — Das Maß organisiert Dasein durch die Differenz einer tragenden Größenbestimmung und einer äußerlich beweglichen Größenbestimmung.","refs":["CH_GB18_DSQ0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:ALT-B03","text":"Metastrategic level — Philosophische Geltung wird vom Ausdrucksmittel auf den Nachweis begrifflicher Selbstbestimmung verlegt.","refs":["CH_GB18_A_20:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:ALT-B04","text":"Ontological / Temporal level — Wirklichkeit wird als Prozess bestimmt, in dem Unmittelbarkeit ihre eigene Negativität durchläuft und dadurch reflektierte Einheit wird.","refs":["CH_GB18_DADM:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:ALT-B05","text":"Methodological / Performative level — Die Methode vollzieht ihre eigene These, indem sie quantitative Abstraktion nicht verwirft, sondern als abstraktes Moment einer Maßrelation bestimmt und begrenzt.","refs":["CH_GB18_DSQ0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_27:FL-01","text":"Die universale logische Bewegung des Maßes zum Wesen steht unter Spannung zu der Behauptung, dass ihre konkrete Realisation außerhalb des Mechanismus zunehmend eingeschränkt ist.","refs":["CH_GB18_DADM:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FL-02","text":"Der qualitative Umschlag wird als notwendige Folge kumulativer Veränderung behauptet, doch der konkrete Vermittlungsmechanismus zwischen Summation und neuer Qualität bleibt unterbestimmt.","refs":["CH_GB18_DSQ0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FL-03","text":"Das Cluster kritisiert quantitative Entwicklungsordnungen als inadäquate Begriffsmodelle, ist aber zugleich auf Quantität als unverzichtbares Moment der Maßbewegung angewiesen.","refs":["CH_GB18_A_20:SD1","CH_GB18_DADM:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MP-01","text":"Quantum mutiert von einer gleichgültigen äußeren Grenze zu einer auf sich bezogenen Äußerlichkeit, deren Veränderbarkeit nur innerhalb einer qualitativen Bestimmtheit besteht.","refs":["CH_GB18_DSQ0:A2","CH_GB18_DADM:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MP-02","text":"Das Maßlose mutiert von der scheinbaren Negation des Maßes zu dessen eigener Negativität und übernimmt damit die Übergangsfunktion, die bloße negative Unendlichkeitsbestimmung nicht erfüllen kann.","refs":["CH_GB18_A_20:AS2","CH_GB18_DADM:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_27:HSI-01","text":"Realität erscheint als Maßmaschine: Jedes bestimmte Dasein trägt eine eigene tragende Größenordnung, innerhalb deren Veränderung möglich ist und an deren Umschlag seine bisherige Qualität zerfällt.","refs":["CH_GB18_DSQ0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:HSI-02","text":"Das Subjekt erscheint nicht als äußerer Vermesser einer vollständig quantifizierbaren Welt, sondern als Erkenntnisinstanz, deren Trennung von qualitativer Wirklichkeit selbst als unzulässige Abstraktion sichtbar wird.","refs":["CH_GB18_DSQ0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:HSI-03","text":"Zeit erscheint als Wiederholung mit Schwellencharakter: Sie akkumuliert zunächst unauffällige Differenzen, bis ihre Fortsetzung die bisherige Form qualitativ transformiert; geistige Wirklichkeit bleibt dabei einer vollständigen Maßgesetzlichkeit entzogen.","refs":["CH_GB18_DSQ0:ALT4","CH_GB18_DADM:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_27:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Grundbewegung vom Quantum als Gleichgültigkeit über Maß und qualitative Grenze zur Selbstvermittlung des Maßes zu rekonstruieren.","refs":["CH_GB18_DSQ0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MRT-B02","text":"Unterbestimmt bleibt die konkrete Bestimmung spezifischer Maßgrenzen einzelner Daseine; die Architektur fordert Immanenz, liefert aber keine allgemeine Ableitungsregel für ihre empirische Bestimmung.","refs":["CH_GB18_DSQ0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MRT-B03","text":"Die Clusterarchitektur ist kohärent, sofern der Unterschied zwischen an sich und gesetzt die Bewegung von unmittelbarer Einheit zu reflektierter Einheit trägt.","refs":["CH_GB18_DADM:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MRT-B04","text":"Der stärkste und zugleich nicht weiter reduzierbare Rest liegt in der Forderung, dass jede konkrete Begriffs- und Maßbestimmung ihre eigene Vermittlung ausweisen muss; der formale Übergangskriterium selbst bleibt dabei unvollständig expliziert.","refs":["CH_GB18_DADM:MRT3","CH_GB18_A_20:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121746406758Z_8e3b9e30","language_code":"en","language_name":"English","title":"Chapters 79–81","source_sha256":"213c6bb9c54da2172c8809fdb9034ead3c9affbf283e8efc6d4b383d49440a69","sha256":"4ba80c86388df6cccd3495900ad078bcb11c03d26d72743b789f64c6f916f239","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:17:46.409046+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_27:AS-01","text":"The cluster problem consists in determining quantitative change simultaneously as initially indifferent and as the bearer of qualitative dissolution, without flattening it into a merely external scale.","refs":["CH_GB18_DSQ0:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-02","text":"The redefinition relocates quantity into the mediating form of measure, in which it counts only as a moment of qualitative determinacy and not as an independent explanatory principle.","refs":["CH_GB18_DADM:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-03","text":"The supporting distinction separates quantitative determinacy from conceptual determinacy without thereby eliminating quantity entirely: it remains real in measure, but loses every entitlement to shape the Concept from without.","refs":["CH_GB18_A_20:AS3","CH_GB18_DSQ0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-04","text":"The course of proof shows that repeated external changes lose their indifference as soon as they concern the immanent unity of a determinate being, and that truth therefore requires the preservation of difference in mediation.","refs":["CH_GB18_DSQ0:D2","CH_GB18_DADM:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-05","text":"The directed movement leads from external quantification, through specific limits of measure and qualitative reversals, to the self-mediation of measure and thereby to the transition into essence.","refs":["CH_GB18_DSQ0:FGS4","CH_GB18_DADM:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-06","text":"The movement is cumulative and recursive: every initially indifferent quantitative variation returns as the condition of a qualitative whole, while the mediated relation transforms its own immediacy.","refs":["CH_GB18_DSQ0:A6","CH_GB18_DADM:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-07","text":"The closure is not a mathematization of the whole, because quantitative lawfulness possesses no free sphere of its own in the spiritual, and symbolic designations lose their cognitive rank after the successful determination of the Concept.","refs":["CH_GB18_DADM:A14","CH_GB18_A_20:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AS-08","text":"The cluster concludes with a criterion of self-grounding: philosophical form is valid only where its conceptual determinacy is demonstrated independently of external presentation.","refs":["CH_GB18_A_20:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_27:GA-01","text":"[Persistent] The infinite and every higher conceptual determination require an affirmative qualitative determination; the negation of quantitative finitude does not suffice.","refs":["CH_GB18_A_20:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-02","text":"[Persistent] Measure is the immediate unity of quality and quantity, in which quantity loses its mere indifference without disappearing as a moment.","refs":["CH_GB18_DADM:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-03","text":"[Mutating] Externality becomes conceptually tenable only when it relates to itself and sublates its own mere externality.","refs":["CH_GB18_DADM:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-04","text":"[Persistent] Quantitative variation is legitimate only within an immanent limit of measure; at this limit, its continuation becomes qualitatively effective.","refs":["CH_GB18_DSQ0:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-05","text":"[Emergent] The measureless is not an external counterforce to measure, but its immanent negativity, through which the self-subsistence of individual measures passes over into transition.","refs":["CH_GB18_DADM:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-06","text":"[Attractor] Symbolic, numerical, or comparative forms possess only derivative validity: they are permissible only when their conceptual determinacy has previously been demonstrated, and become dispensable after this demonstration.","refs":["CH_GB18_A_20:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-07","text":"[Terminal] The transition into essence is the self-mediation of measure through the sublation of its immediacy, not the interruption of its movement.","refs":["CH_GB18_DADM:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-08","text":"[Persistent] The scope of quantitative explanation declines with increasing concreteness; what appears law-governed in the mechanical cannot directly determine the organic and the spiritual.","refs":["CH_GB18_DADM:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GA-09","text":"[Attractor] Concrete truth consists neither in undifferentiated unity nor in isolated difference, but in the preservation of difference as a moment of a mediated unity.","refs":["CH_GB18_DADM:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_27:RMD-01","text":"Quantum does not recur with a stable function: as an external difference it is superficial for the Concept; as measure it becomes the immanent determinacy of a determinate being.","refs":["CH_GB18_A_20:NX3","CH_GB18_DSQ0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RMD-02","text":"Externality mutates from an alien form to be overcome into a self-relation: not the abolition of the external, but its return into its own determinacy, constitutes the operation of mediation.","refs":["CH_GB18_DADM:AS2","CH_GB18_DADM:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RMD-03","text":"The critique of the negative infinite is functionally displaced into the determination of the measureless: the measureless is not identical with the infinite, but assumes the task of bursting a merely external limitation.","refs":["CH_GB18_A_20:AS2","CH_GB18_DADM:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RMD-04","text":"Numbers and powers lose the claim to express essential differences themselves, while magnitude recurs in the specific quantum as a constitutive determinacy of determinate being.","refs":["CH_GB18_A_20:A8","CH_GB18_DSQ0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RMD-05","text":"The historical movement from numerical designations to independent determinations of thought is not sublated, but regionalized: quantity remains explanatorily powerful, though only within delimited domains of objects.","refs":["CH_GB18_A_20:A9","CH_GB18_DADM:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_27:CGD-01","text":"The critique of certain sequences of powers remains local, yet its valid yield scales as a general rule: no quantitative order of development may be presented as a conceptual difference.","refs":["CH_GB18_A_20:D3","CH_GB18_A_20:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:CGD-02","text":"The sorites figure remains a local touchstone, but at the cluster level it becomes the general model showing that quantitative repetition changes its ontological function with the limit attained.","refs":["CH_GB18_DSQ0:NX4","CH_GB18_DSQ0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:CGD-03","text":"The critique of substance, mode, and pantheism is local-historical, but its higher rule is global: every unity that merely effaces difference misses concrete mediation.","refs":["CH_GB18_DADM:D5","CH_GB18_DADM:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:CGD-04","text":"The concrete determination of individual limits of measure remains at the lower level of particular objects; the cluster level determines only that such limits must be immanent and must not follow from an external fundamental measure.","refs":["CH_GB18_DSQ0:MRT2","CH_GB18_DADM:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_27:GNX-01","text":"Excluded is an external quantitative schema that confers its truth upon the Concept or replaces conceptual self-determination.","refs":["CH_GB18_A_20:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GNX-02","text":"Excluded is a philosophy in which symbolic availability compensates for absent self-determination and replaces conceptual labour with an economy of signs.","refs":["CH_GB18_A_20:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GNX-03","text":"Excluded is a universal external standard from which the original measures of particular things would be deducible.","refs":["CH_GB18_DSQ0:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GNX-04","text":"Excluded is the assumption of unlimited quantitative change within which a determinate being would necessarily remain the same.","refs":["CH_GB18_DSQ0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:GNX-05","text":"Excluded are both metaphysical unities that annul difference and scientific generalizations that directly transfer quantitative lawfulness to concrete nature and spirit.","refs":["CH_GB18_DADM:NX3","CH_GB18_DADM:NX7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_27:DBN-01","text":"The system cannot permit an external standard that replaces or retrospectively legitimates conceptual determination; truth must emerge from the self-determination of the object.","refs":["CH_GB18_A_20:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:DBN-02","text":"The system cannot recognize an immediate unity that exists without inner difference and compelled mediation.","refs":["CH_GB18_DADM:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:DBN-03","text":"The system can permit neither an immediately available essence nor a universal mathematical explanation of concrete actuality; both would replace mediation with external abstraction.","refs":["CH_GB18_DADM:NX6","CH_GB18_DADM:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_27:BSA-01","text":"Unavailable is a common external medium in which quantum, Concept, nature, and spirit would be immediately commensurable without categorical transformation.","refs":["CH_GB18_A_20:SNX3","CH_GB18_DSQ0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:BSA-02","text":"Impermissible is a final unity without the self-relation of difference; every such unity falls back either into rigid substance or into measureless dispersal.","refs":["CH_GB18_DADM:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:BSA-03","text":"Impermissible is a causality of mere addition; quantitative summation must be understood as the efficacy of an immanent measure.","refs":["CH_GB18_DSQ0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_27:XD-01","text":"Quantity is neither rejected nor elevated into the model of the Concept: it is valid only as an immanent moment of measure and remains categorically inappropriate as an external conceptual template.","refs":["CL_GB18_27:GA-02","CL_GB18_27:GA-03","CL_GB18_27:GA-06","CH_GB18_A_20:NX3","CH_GB18_DSQ0:A2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:XD-02","text":"External comparative standard and symbolic form belong to the same derivative mode of validity: both can compare or designate operationally, but can produce neither the specific determinacy of an object nor the truth of the Concept.","refs":["CL_GB18_27:GA-04","CL_GB18_27:GA-06","CH_GB18_A_20:SNX2","CH_GB18_DSQ0:D5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:XD-03","text":"The qualitative threshold is not an interruption of quantitative movement from without, but its immanent reversal: continued variation exposes the negativity that was already operative in the self-subsistence of measure.","refs":["CL_GB18_27:GA-04","CL_GB18_27:GA-05","CH_GB18_DSQ0:SD1","CH_GB18_DADM:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:XD-04","text":"The critique of external numerical schemata and the critique of abstract substance constitute a single operation of delimitation, because both suspend mediation either through formalization or through the effacement of difference.","refs":["CL_GB18_27:GA-06","CL_GB18_27:GA-09","CH_GB18_DADM:SD2","CH_GB18_A_20:SNX1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:XD-05","text":"The restriction of quantitative lawfulness to certain domains of realization simultaneously prevents two false inferences: that mechanism is the model of all actuality, and that spirit appears freely determinable by laws of measure.","refs":["CL_GB18_27:GA-08","CH_GB18_DADM:SD3","CH_GB18_DADM:A14"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_27:BSD-01","text":"Quantity receives a dual ontological status: as an external form it remains abstract; as externality returning into measure it becomes the bearer of qualitative actuality.","refs":["CL_GB18_27:GA-02","CL_GB18_27:GA-03","CL_GB18_27:GA-04","CH_GB18_DSQ0:SD1","CH_GB18_DADM:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:BSD-02","text":"Time is determined as cumulative efficacy: what appears indifferent in individual variation becomes, through repetition, the immanent mediation of dissolution or qualitative change.","refs":["CL_GB18_27:GA-04","CL_GB18_27:GA-05","CH_GB18_DSQ0:SD2","CH_GB18_DSQ0:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:BSD-03","text":"Cognition is shifted from the intuitiveness of a sign to the examination of whether a form can bear its own determinacy; legitimate abstraction therefore remains possible, but is not self-grounding.","refs":["CL_GB18_27:GA-06","CH_GB18_A_20:SD5","CH_GB18_DSQ0:MRT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_27:BSD-04","text":"The system generates a graduated ontology of explicability: mechanical regularity is not a universal metaphysics, but the maximal realization of a form whose validity diminishes with organic and spiritual concreteness.","refs":["CL_GB18_27:GA-08","CH_GB18_DADM:ME4","CH_GB18_DADM:A14"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_27:RLE-01","text":"Quantitative variation → repetition → summation → limit of measure → qualitative reversal → new determinate being forms the central recursive loop of temporal movement.","refs":["CH_GB18_DSQ0:A6","CH_GB18_DSQ0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RLE-02","text":"Symbolic expression → demand for conceptual demonstration → self-designation of the Concept → superfluity of the symbol → diagnosis of conceptual economy forms the epistemic loop.","refs":["CH_GB18_A_20:A12","CH_GB18_A_20:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RLE-03","text":"Immediate measure → specific relations of measure → measurelessness → inverse relation → reflection → essence forms the ontological escalation path.","refs":["CH_GB18_DADM:FGS3","CH_GB18_DADM:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:RLE-04","text":"Self-relating determinacy is the conceptual attractor toward which both the critique of external quantification and the development of measure converge.","refs":["CH_GB18_DADM:AS2","CH_GB18_A_20:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_27:FGS-B01","text":"External quantification or symbolic gradation → examination of categories → demonstration that formal similarity produces no conceptual determinacy.","refs":["CH_GB18_A_20:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FGS-B02","text":"Quantum as indifferent limit → distinction between specific and externally variable quantum → measure as the inner structure of a determinate being.","refs":["CH_GB18_DSQ0:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FGS-B03","text":"External variation → repetition and summation → transgression of the specific limit → qualitative change or dissolution.","refs":["CH_GB18_DSQ0:FGS4","CH_GB18_DSQ0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FGS-B04","text":"Self-subsistence of specific measures → measurelessness as immanent negativity → reflection of immediacy → transition into essence.","refs":["CH_GB18_DADM:FGS4","CH_GB18_DADM:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FGS-B05","text":"Demonstrated conceptual determinacy → disempowerment of external symbols and standards → regional limitation of quantitative explanation → priority of self-mediated form.","refs":["CH_GB18_A_20:A12","CH_GB18_DADM:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_27:AFM-B01","text":"External quantum and numerical gradation → separation of quantitative from conceptual difference → exclusion of number as an immediate form of the Concept.","refs":["CH_GB18_A_20:FGS2","CH_GB18_DSQ0:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AFM-B02","text":"Quantitative indifference → measure as mediated unity → sublation of the mere opposition between quality and quantity.","refs":["CH_GB18_DADM:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AFM-B03","text":"Immanent limit of measure → limited variability → repetition of quantitative changes → qualitative efficacy of the limit.","refs":["CH_GB18_DSQ0:D1","CH_GB18_DSQ0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AFM-B04","text":"Specific relations of measure → measurelessness → self-mediation of immediacy → essence.","refs":["CH_GB18_DADM:D4","CH_GB18_DADM:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:AFM-B05","text":"Regional realization of measure → limitation of its lawfulness in the spiritual → self-grounding of the Concept instead of external presentation.","refs":["CH_GB18_DADM:AF4","CH_GB18_A_20:A13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_27:MME-01","text":"Symbolic use and philosophical form are mapped as distinct modes of validity: the sign can designate without thereby grounding truth.","refs":["CH_GB18_A_20:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MME-02","text":"The opposition between gradual and abrupt change is reordered into a unity of continuous accumulation and qualitative reversal.","refs":["CH_GB18_DSQ0:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MME-03","text":"The opposition between natural measure and conventional standard is decomposed into immanent determinacy of the object and external comparison.","refs":["CH_GB18_DSQ0:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MME-04","text":"The map of quantitative explanation is regionally graduated: the mechanical forms its strongest domain, the organic subordinates it to higher relations, and the spiritual withdraws from laws of measure proper to itself.","refs":["CH_GB18_DADM:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_27:ALT-B01","text":"Surface level — Specific quantum appears as the immediate shape of measure, in which magnitude is not merely compared but comprehended as the determinacy of a determinate being.","refs":["CH_GB18_DSQ0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:ALT-B02","text":"Structural level — Measure organizes determinate being through the difference between a supporting determination of magnitude and an externally mobile determination of magnitude.","refs":["CH_GB18_DSQ0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:ALT-B03","text":"Metastrategic level — Philosophical validity is shifted from the means of expression to the demonstration of conceptual self-determination.","refs":["CH_GB18_A_20:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:ALT-B04","text":"Ontological / Temporal level — Actuality is determined as a process in which immediacy traverses its own negativity and thereby becomes reflected unity.","refs":["CH_GB18_DADM:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:ALT-B05","text":"Methodological / Performative level — The method enacts its own thesis by not rejecting quantitative abstraction, but determining and delimiting it as an abstract moment of a relation of measure.","refs":["CH_GB18_DSQ0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_27:FL-01","text":"The universal logical movement of measure toward essence stands in tension with the claim that its concrete realization is increasingly restricted outside mechanism.","refs":["CH_GB18_DADM:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FL-02","text":"The qualitative reversal is asserted as a necessary consequence of cumulative change, yet the concrete mechanism of mediation between summation and new quality remains underdetermined.","refs":["CH_GB18_DSQ0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:FL-03","text":"The cluster criticizes quantitative orders of development as inadequate models of the Concept, but is at the same time dependent on quantity as an indispensable moment of the movement of measure.","refs":["CH_GB18_A_20:SD1","CH_GB18_DADM:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MP-01","text":"Quantum mutates from an indifferent external limit into a self-related externality whose alterability exists only within a qualitative determinacy.","refs":["CH_GB18_DSQ0:A2","CH_GB18_DADM:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MP-02","text":"The measureless mutates from the apparent negation of measure into its own negativity and thereby assumes the transitional function that a merely negative determination of infinity cannot fulfill.","refs":["CH_GB18_A_20:AS2","CH_GB18_DADM:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_27:HSI-01","text":"Reality appears as a machine of measure: every determinate being bears its own supporting order of magnitude, within which change is possible and at whose reversal its previous quality disintegrates.","refs":["CH_GB18_DSQ0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:HSI-02","text":"The subject appears not as an external measurer of a fully quantifiable world, but as an instance of cognition whose separation from qualitative actuality itself becomes visible as an impermissible abstraction.","refs":["CH_GB18_DSQ0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:HSI-03","text":"Time appears as repetition with a threshold character: it accumulates initially inconspicuous differences until its continuation qualitatively transforms the previous form; spiritual actuality remains exempt from a complete lawfulness of measure.","refs":["CH_GB18_DSQ0:ALT4","CH_GB18_DADM:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_27:MRT-B01","text":"The extracted axioms suffice to reconstruct the basic movement from quantum as indifference, through measure and qualitative limit, to the self-mediation of measure.","refs":["CH_GB18_DSQ0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MRT-B02","text":"The concrete determination of the specific limits of measure of individual determinate beings remains underdetermined; the architecture demands immanence, but provides no general rule of derivation for their empirical determination.","refs":["CH_GB18_DSQ0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MRT-B03","text":"The cluster architecture is coherent insofar as the distinction between in itself and posited bears the movement from immediate unity to reflected unity.","refs":["CH_GB18_DADM:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_27:MRT-B04","text":"The strongest and at the same time irreducible remainder lies in the requirement that every concrete determination of Concept and measure must demonstrate its own mediation; the formal criterion of transition itself remains incompletely explicated.","refs":["CH_GB18_DADM:MRT3","CH_GB18_A_20:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_27@R001","source_variant_id":"canonical:CL_GB18_27:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 79–81","context":"Anmerkung. · Dritter Abschnitt. Das Maaß. · A. Das specifische Quantum."},"title_language_code":"en"},{"id":"CL_GB18_28","layer":"CL","title":"Chapters 82–84","order":28,"parents":["CH_GB18_BSM0","CH_GB18_DIER","CH_GB18_BDSM"],"revision":"CL_GB18_28@R001","sha256":"f21f98244d89466a4ea568997fcc42d94ba8d57abcc65da5f365f4596c09a0e1","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_28:AS-01","text":"Das zentrale Problem ist, das Maaß gegen ein bloß äußerlich gegebenes Quantum zu bestimmen und dadurch seine qualitative Eigenlogik sichtbar zu machen.","refs":["CH_GB18_BSM0:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AS-02","text":"Die anfängliche Regel erscheint als bestimmte Einheit gegenüber einem Quantum, wird jedoch durch ihre Beziehung zu diesem Anderen in eine spezifische Maßbestimmung überführt.","refs":["CH_GB18_DIER:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AS-03","text":"Die äußerliche Vergleichung erweist sich als notwendige, aber unzureichende Ausgangsform, weil sie die innere Bestimmtheit des Maaßes noch als Willkür behandelt.","refs":["CH_GB18_DIER:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AS-04","text":"Auf der Clusterebene wird das Maaß als qualitative Bestimmung äußerlicher Quantität rekonstituiert, nicht als zusätzliche Größe neben ihr.","refs":["CH_GB18_BDSM:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AS-05","text":"Die Bewegung ist rekursiv und mutationsgetrieben: Die Regel wird auf ihr Anderes bezogen, die Einheit wird selbst quantifizierbar, und die äußerliche Reihe erzeugt eine qualitativ anders gesetzte Reihe.","refs":["CH_GB18_DIER:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AS-06","text":"Die Schließung besteht in einer gegliederten Einheit von Regel, bestimmender Quantität, qualitativer Relation und einer daraus hervorgehenden Gesetzlichkeit der Äußerlichkeit.","refs":["CH_GB18_BSM0:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_28:GA-01","text":"[Persistent] Das Maaß ist keine bloße Quantität, sondern eine qualitative Bestimmung, durch die Quantität erst als Maaß bestimmt wird.","refs":["CH_GB18_BSM0:A1","CH_GB18_BDSM:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-02","text":"[Mutating] Die Regel beginnt als äußerliche Vergleichsinstanz und mutiert zur spezifischen Beziehung einer Bestimmung auf ihr eigenes Anderes.","refs":["CH_GB18_DIER:A5","CH_GB18_DIER:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-03","text":"[Persistent] Das Maaß setzt ein äußerliches Quantum voraus, enthält aber zugleich eine immanente Bestimmung, die dieses Quantum qualitativ organisiert.","refs":["CH_GB18_BSM0:A4","CH_GB18_BDSM:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-04","text":"[Emergent] Äußerliche Messung wird auf der höheren Ebene als vermitteltes Verhältnis rekonstruiert, in dem Quantität und Qualität nicht mehr getrennt auftreten.","refs":["CH_GB18_DIER:D4","CH_GB18_BDSM:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-05","text":"[Mutating] Die Einheit verliert ihre absolute Selbstständigkeit, weil sie selbst wieder als Anzahl anderer Einheiten bestimmt werden kann.","refs":["CH_GB18_DIER:A6","CH_GB18_DIER:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-06","text":"[Emergent] Das qualitative Moment des Maaßes erscheint als Potenzbestimmung, die das Quantum nicht additiv, sondern nach einer eigenen Gesetzlichkeit nimmt.","refs":["CH_GB18_BDSM:A7","CH_GB18_BDSM:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-07","text":"[Terminal] Die arithmetische Veränderung des äußerlichen Quantums ist nur die Ausgangsreihe einer zweiten, qualitativ bestimmten Reihe.","refs":["CH_GB18_BDSM:A9","CH_GB18_BDSM:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-08","text":"[Attractor] Das Maaß konvergiert auf ein Fürsichsein in der Äußerlichkeit: Es bleibt auf äußere Quantität bezogen, bestimmt deren Gesetzlichkeit aber aus einer immanenten Qualität.","refs":["CH_GB18_BDSM:SD6","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-09","text":"[Persistent] Qualität und Quantität sind keine getrennten Bestandteile, sondern gegeneinander bestimmte Seiten einer einzigen Maßstruktur.","refs":["CH_GB18_BSM0:A5","CH_GB18_DIER:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-10","text":"[Terminal] Die qualitative Maßbestimmung erzeugt eine Differenz der Gesetzlichkeiten, in der die arithmetische und die Potenzenreihe nicht notwendig kommensurabel sind.","refs":["CH_GB18_BDSM:D6","CH_GB18_BDSM:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_28:RMD-01","text":"Die Regel kehrt in allen Einheiten wieder, verschiebt sich jedoch von einer äußeren Norm zu einer relationalen und schließlich qualitativen Gesetzlichkeit.","refs":["CH_GB18_BSM0:A2","CH_GB18_BDSM:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-02","text":"Das Quantum wiederholt sich zunächst als gemessener Gegenstand, dann als das Andere der Regel und schließlich als spezifisch verändertes Quantum.","refs":["CH_GB18_DIER:A3","CH_GB18_BDSM:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-03","text":"Die Einheit bleibt erhalten, verliert aber ihre unmittelbare Absolutheit, sobald sie selbst in eine Anzahl und damit in eine weitere Maßrelation übergeht.","refs":["CH_GB18_DIER:A7","CH_GB18_DIER:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-04","text":"Quantität und Qualität kehren nicht identisch wieder: Quantität wird vom Ausgangsmaterial zur Trägerin qualitativer Bestimmtheit, während Qualität zur operativen Form der Quantitätsveränderung wird.","refs":["CH_GB18_BSM0:SD2","CH_GB18_BDSM:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-05","text":"Die arithmetische Reihe wird auf der Clusterebene absorbiert: Sie bleibt als Träger der Bewegung bestehen, verliert aber den Status einer vollständigen Erklärung.","refs":["CH_GB18_BDSM:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-06","text":"Der Verhältnisexponent verschiebt sich vom scheinbaren Zahlenquotienten zum qualitativen Prinzip, das die Reihe überhaupt erst spezifisch macht.","refs":["CH_GB18_BDSM:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-07","text":"Die äußerliche Regel verschwindet nicht, sondern wird in der höheren Struktur als Ort einer immanenten qualitativen Gesetzlichkeit aufgehoben.","refs":["CH_GB18_BDSM:SD6","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_28:CGD-01","text":"Die konkrete Zerlegung einer Einheit in kleinere Einheiten bleibt ein lokaler Mechanismus; auf der Clusterebene zählt daraus nur die Relativierung jeder unmittelbaren Maßselbstständigkeit.","refs":["CH_GB18_DIER:A7","CH_GB18_DIER:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:CGD-02","text":"Die genaue mathematische Form der Potenzenreihe gehört der unteren Ebene an; global tragend ist die Differenz zwischen arithmetischer Eingangsreihe und qualitativer Folgereihe.","refs":["CH_GB18_BDSM:MRT3","CH_GB18_BDSM:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:CGD-03","text":"Die Unterscheidung von Intensität und Extensität ist lokal ein Argument gegen eine falsche qualitative Gleichsetzung; auf der Clusterebene wird sie in die allgemeinere Differenz von äußerlicher Form und immanenter Bestimmung aufgenommen.","refs":["CH_GB18_BDSM:AS4","CH_GB18_BDSM:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:CGD-04","text":"Die drei Kapitelmechanismen skalieren zu einer gemeinsamen Architektur, sobald Regel, Quantifizierung und Potenzbestimmung als aufeinanderfolgende Transformationen desselben Maaßes gelesen werden.","refs":["CH_GB18_BSM0:A8","CH_GB18_BDSM:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:CGD-05","text":"Die konkrete Willkür einer Maßeinheit wird auf der höheren Ebene nicht als Einzelfall behandelt, sondern als notwendiger Übergang von äußerlicher Setzung zu relationaler Spezifikation.","refs":["CH_GB18_DIER:A6","CH_GB18_DIER:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:CGD-06","text":"Was nach oben skaliert, ist nicht die einzelne Messoperation, sondern die Umwandlung einer zunächst äußerlichen Bestimmung in eine qualitative Gesetzlichkeit des Quantums.","refs":["CH_GB18_DIER:ME1","CH_GB18_BDSM:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_28:GNX-01","text":"Das Maaß wird gegen das bloße Quantum abgegrenzt; eine reine Menge kann die Maßbestimmung nicht abschließen.","refs":["CH_GB18_BSM0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GNX-02","text":"Eine äußerliche Regel allein gilt nicht als vollständiges Maaß, weil ihr die spezifische Bestimmung des Quantums fehlt.","refs":["CH_GB18_BSM0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GNX-03","text":"Die spezifische Quantität ist kein vom äußerlichen Quantum unabhängiges Gegenquantum, sondern dessen qualitative Bestimmung.","refs":["CH_GB18_BSM0:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GNX-04","text":"Die Maßseiten sind weder bloß quantitative Größen noch additiv nebeneinandergestellte Bestandteile.","refs":["CH_GB18_BSM0:NX4","CH_GB18_BSM0:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GNX-05","text":"Eine vollständig kommensurable Zahlenordnung wird als unzureichend ausgeschlossen, sobald das Maaß als qualitative Potenzbestimmung erscheint.","refs":["CH_GB18_BDSM:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_28:DBN-01","text":"Das System kann nicht bestehen, wenn Messung als neutrale Anwendung einer bereits vollständig bestimmten Einheit gilt.","refs":["CH_GB18_DIER:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:DBN-02","text":"Unzulässig ist ein Modell, in dem Regel und Quantum unabhängig voneinander vorliegen und erst nachträglich äußerlich verbunden werden.","refs":["CH_GB18_DIER:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:DBN-03","text":"Unzulässig ist eine Ontologie bloßer Mengen, in der Veränderung vollständig durch Addition, Subtraktion oder numerische Proportion erklärt wird.","refs":["CH_GB18_BDSM:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:DBN-04","text":"Das System disqualifiziert jede Auffassung, nach der qualitative Bestimmung nur eine anders benannte numerische Relation wäre.","refs":["CH_GB18_BDSM:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:DBN-05","text":"Die Beständigkeit des Maaßes setzt voraus, dass äußerliche Abhängigkeit und qualitative Eigenständigkeit zugleich gelten, ohne in getrennte Substanzen auseinanderzufallen.","refs":["CH_GB18_BDSM:DNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_28:BSA-01","text":"Eine maßlose reine Quantität ist als letzte Erklärung nicht verfügbar.","refs":["CH_GB18_BSM0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSA-02","text":"Eine äußerliche Norm ohne innere Spezifikation kann nicht als vollständige Identität von Regel und Quantum fungieren.","refs":["CH_GB18_BSM0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSA-03","text":"Die Möglichkeit, die Maßseiten als voneinander unabhängige Größen zu behandeln, wird strukturell versperrt.","refs":["CH_GB18_BSM0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSA-04","text":"Das System umkreist die unmögliche Alternative einer reinen Äußerlichkeit ohne immanente Bestimmung und einer reinen Immanenz ohne quantitative Entäußerung.","refs":["CH_GB18_DIER:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_28:XD-01","text":"Die Verbindung von äußerlicher Regel und spezifischer Maßqualität verwandelt die Regel von einer Vergleichsnorm in eine qualitative Gesetzlichkeit des von ihr bestimmten Quantums.","refs":["CL_GB18_28:GA-02","CL_GB18_28:GA-03","CL_GB18_28:GA-04","CH_GB18_DIER:A8","CH_GB18_BDSM:A1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-02","text":"Die Relativierung der Einheit und die Potenzbestimmung des Quantums erzeugen eine gemeinsame Logik, in der jede Maßsetzung zugleich Selbstbezug und Veränderung des Anderen ist.","refs":["CL_GB18_28:GA-05","CL_GB18_28:GA-06","CH_GB18_DIER:D2","CH_GB18_BDSM:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-03","text":"Die arithmetische Progression erhält erst durch die qualitative Reaktion des Maaßes den Status einer erzeugenden, aber untergeordneten Ausgangsreihe.","refs":["CL_GB18_28:GA-06","CL_GB18_28:GA-07","CL_GB18_28:GA-10","CH_GB18_BDSM:A9","CH_GB18_BDSM:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-04","text":"Die Spannung zwischen willkürlicher Einheit und immanenter Spezifikation wird produktiv, weil die anfängliche Willkür den Übergang zur relationalen Bestimmung eröffnet.","refs":["CL_GB18_28:GA-02","CL_GB18_28:GA-05","CH_GB18_DIER:SD1","CH_GB18_DIER:A9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-05","text":"Aus der Verbindung von qualitativer Einheit und quantitativer Vielheit folgt, dass das Maaß nicht als Addition, sondern als vermittelte Relation zweier Bestimmungsweisen operiert.","refs":["CL_GB18_28:GA-04","CL_GB18_28:GA-09","CH_GB18_DIER:SD2","CH_GB18_BSM0:NX5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-06","text":"Die Inkommensurabilität der Folgereihe ist kein äußerer Defekt, sondern die operative Folge davon, dass Qualität die arithmetische Veränderung anders nimmt.","refs":["CL_GB18_28:GA-06","CL_GB18_28:GA-10","CH_GB18_BDSM:D7","CH_GB18_BDSM:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-07","text":"Die drei Eingabeeinheiten konvergieren auf eine Maßstruktur, in der Äußerlichkeit nicht beseitigt, sondern zum Medium des Fürsichseins umcodiert wird.","refs":["CL_GB18_28:GA-02","CL_GB18_28:GA-08","CH_GB18_BDSM:SD6","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_28:BSD-01","text":"Das Maaß ist auf dieser Ebene keine beschreibende Kategorie, sondern eine Transformationsmaschine, die äußerliche Quantität in qualitative Gesetzlichkeit überführt.","refs":["CH_GB18_BDSM:SD4","CH_GB18_BDSM:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSD-02","text":"Realität erscheint als gegliederte Relation zweier Gesetzlichkeiten: einer äußerlich sukzessiven und einer qualitativ bestimmenden, die deren Verlauf organisiert.","refs":["CH_GB18_BDSM:FGS7","CH_GB18_BDSM:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSD-03","text":"Identität wird nicht als unmittelbare Gleichheit, sondern als Stabilität einer vermittelten Differenz von Regel, Quantum und qualitativer Bestimmung erzeugt.","refs":["CH_GB18_BSM0:ALT4","CH_GB18_BSM0:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSD-04","text":"Zeitliche oder sukzessive Veränderung erhält eine doppelte Struktur: äußerlich folgt sie einer arithmetischen Reihe, qualitativ jedoch einer davon abweichenden Potenzreihe.","refs":["CH_GB18_BDSM:ALT4","CH_GB18_BDSM:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSD-05","text":"Methodisch muss nicht nur gefragt werden, welches Quantum vorliegt, sondern wie es durch die Maßrelation genommen und qualitativ bestimmt wird.","refs":["CH_GB18_BDSM:D8","CH_GB18_BDSM:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSD-06","text":"Die terminale Konsequenz ist eine Gesetzlichkeit der Äußerlichkeit, in der das Äußere nicht länger als Gegenpol des Inneren, sondern als dessen vermittelter Vollzug erscheint.","refs":["CH_GB18_BDSM:AF7","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_28:RLE-01","text":"Äußerliche Regel → Gegenüberstehendes Quantum → Messung → Relativierung der Einheit → Selbstbezug der Regel → spezifisches Maaß.","refs":["CH_GB18_DIER:AF1","CH_GB18_DIER:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RLE-02","text":"Einheit → Anzahl von Einheiten → erneute Quantifizierbarkeit der Einheit → Auflösung ihrer unmittelbaren Selbstständigkeit → relationale Maßbestimmung.","refs":["CH_GB18_DIER:FGS2","CH_GB18_DIER:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RLE-03","text":"Äußerliche arithmetische Veränderung → qualitative Reaktion → Potenzreihe → Nichtkommensurabilität → qualitative Gesetzlichkeit der Quantität.","refs":["CH_GB18_BDSM:FGS5","CH_GB18_BDSM:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RLE-04","text":"Der Begriff des Maaßes wird zum Attraktor, auf den Regel, Quantum, Einheit, Qualität und Potenzbestimmung zulaufen, nachdem sie ihre isolierte Funktion verloren haben.","refs":["CH_GB18_BSM0:D4","CH_GB18_BDSM:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RLE-05","text":"Die zentrale rekursive Schleife lautet: Das Maaß hängt vom äußerlichen Quantum ab, bestimmt dieses aber durch eine Qualität, die nur innerhalb dieser Abhängigkeit wirksam werden kann.","refs":["CH_GB18_BDSM:D3","CH_GB18_BDSM:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_28:FGS-B01","text":"Äußerliche Regel + äußerliches Quantum → äußerliche Vergleichung als notwendige Anfangsform.","refs":["CH_GB18_DIER:FGS1","CH_GB18_DIER:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FGS-B02","text":"Äußerliche Vergleichung → Relativierung der Einheit → Bezug der Regel auf ihr eigenes Anderes.","refs":["CH_GB18_DIER:FGS2","CH_GB18_DIER:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FGS-B03","text":"Bezug auf das eigene Andere → spezifisches Maaß → qualitative Bestimmung des äußerlichen Quantums.","refs":["CH_GB18_DIER:FGS3","CH_GB18_BDSM:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FGS-B04","text":"Äußerliches Quantum → arithmetische Reihe; qualitative Maßbestimmung → Potenzenreihe; Differenz beider Reihen → qualitative Gesetzlichkeit.","refs":["CH_GB18_BDSM:FGS5","CH_GB18_BDSM:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FGS-B05","text":"Regel + relationale Einheit + qualitative Potenzbestimmung → Fürsichsein in der Äußerlichkeit.","refs":["CH_GB18_BDSM:FGS8","CH_GB18_BDSM:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_28:AFM-B01","text":"Bloßes Quantum → äußerliche Regel → äußerliche Vergleichung → Relativierung der Einheit → Selbstbezug der Regel → spezifisches Maaß → qualitative Bestimmung → Potenzreihe → Fürsichsein in der Äußerlichkeit.","refs":["CH_GB18_DIER:AF1","CH_GB18_BDSM:AF7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AFM-B02","text":"Äußerliche Gleichgültigkeit → relationale Vermittlung → qualitative Reaktion → Abweichung von der arithmetischen Reihe → terminale Gesetzlichkeit des Maaßes.","refs":["CH_GB18_BDSM:AF1","CH_GB18_BDSM:AF7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_28:MME-01","text":"Das Quantum wird vom selbständigen Ausgangspunkt zur äußerlich gegebenen, durch eine qualitative Maßbestimmung organisierten Seite umklassifiziert.","refs":["CH_GB18_BSM0:ME1","CH_GB18_BDSM:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MME-02","text":"Die Regel wird von einer äußeren Vergleichsoperation zu einer relationalen und schließlich immanenten Gesetzlichkeit umkartiert.","refs":["CH_GB18_DIER:ME1","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MME-03","text":"Der Gegensatz von Quantität und Qualität bricht als äußerlicher Gegensatz zusammen und wird als Verhältnis zweier Seiten derselben Maßbestimmung neu geordnet.","refs":["CH_GB18_BSM0:ME3","CH_GB18_BDSM:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MME-04","text":"Die arithmetische Reihe verliert den Status einer vollständigen Erklärung; sie wird zur sichtbaren Oberfläche einer qualitativ anders strukturierten Reihe.","refs":["CH_GB18_BDSM:ME4","CH_GB18_BDSM:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MME-05","text":"Die neue strategische Karte verlangt, Maßbestimmungen nach ihrer Vermittlungsweise zu lesen, nicht nach isolierten Werten oder äußerlichen Zahlen.","refs":["CH_GB18_BDSM:D8","CH_GB18_BDSM:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_28:ALT-B01","text":"Auf der Oberflächenebene wird eine äußerliche Größe durch Regel, Quantum und spezifische Bestimmung des Maaßes organisiert.","refs":["CH_GB18_BSM0:ALT1","CH_GB18_BDSM:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:ALT-B02","text":"Auf der Strukturebene bildet das Maaß ein vermitteltes Verhältnis, in dem Regel, Einheit, Quantum und qualitative Bestimmung wechselseitig voneinander abhängen.","refs":["CH_GB18_BSM0:ALT2","CH_GB18_BDSM:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:ALT-B03","text":"Auf der metastrategischen Ebene ersetzt das System die isolierte Betrachtung von Größen durch die Analyse ihrer relationalen und qualitativen Erzeugung.","refs":["CH_GB18_BSM0:ALT3","CH_GB18_BDSM:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:ALT-B04","text":"Auf der ontologisch-temporalen Ebene erscheint Identität als gegliederte Einheit, während Veränderung gleichzeitig arithmetisch äußerlich und qualitativ potenziell verläuft.","refs":["CH_GB18_BSM0:ALT4","CH_GB18_BDSM:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:ALT-B05","text":"Auf der methodologisch-performativen Ebene vollzieht die Darstellung selbst den Übergang von äußerlicher Setzung über relationale Vermittlung zu qualitativer Bestimmung.","refs":["CH_GB18_BSM0:MRT6","CH_GB18_BDSM:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_28:FL-01","text":"[Tension] Das Maaß beginnt als äußerliche Regel, soll aber als immanente qualitative Bestimmung gelten; seine Einheit hängt daher von einer Überschreitung seiner eigenen Anfangsform ab.","refs":["CH_GB18_BSM0:MRT5","CH_GB18_BDSM:MRT8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FL-02","text":"[Tension] Das qualitative Prinzip wird als Potenzbestimmung behauptet, bleibt aber hinsichtlich der konkreten mathematischen Reihe und ihres exakten Verhältnisses unterbestimmt.","refs":["CH_GB18_BDSM:MRT3","CH_GB18_BDSM:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FL-03","text":"[Tension] Das Maß hängt von äußerlicher Quantität ab und überschreitet zugleich deren Gesetzlichkeit durch eine nicht notwendig kommensurable qualitative Bestimmung.","refs":["CH_GB18_BDSM:MRT8","CH_GB18_BDSM:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FL-04","text":"[Tension] Die Einheit ist zunächst willkürlich gesetzt, gewinnt ihre Spezifikation aber gerade durch die Relation zu dem, worauf sie angewandt wird.","refs":["CH_GB18_DIER:MRT5","CH_GB18_DIER:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MP-01","text":"[Mutationspunkt] Die Regel mutiert von einer äußerlich bestimmten Einheit zu einem Selbstbezug auf ihr eigenes Anderes.","refs":["CH_GB18_DIER:AS5","CH_GB18_DIER:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MP-02","text":"[Mutationspunkt] Das Quantum mutiert vom unabhängigen Gegenstand der Messung zur bestimmten Form des Anderen und schließlich zum qualitativ veränderten Quantum.","refs":["CH_GB18_DIER:D5","CH_GB18_BDSM:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MP-03","text":"[Mutationspunkt] Der Exponent mutiert vom scheinbaren Quotienten zum qualitativen Prinzip, das die quantitative Reihe in eine andere Gesetzlichkeit überführt.","refs":["CH_GB18_BDSM:AF4","CH_GB18_BDSM:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MP-04","text":"[Mutationspunkt] Äußerlichkeit kehrt ihre Valenz um: Sie ist zunächst Mangel an Innerlichkeit und wird schließlich zum Ort des Fürsichseins.","refs":["CH_GB18_BDSM:ME5","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_28:HSI-01","text":"Das System hält Realität implizit für eine Maßmaschine, in der äußerliche Größen durch relationale und qualitative Bestimmungen erzeugt werden.","refs":["CH_GB18_BSM0:SD1","CH_GB18_BDSM:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:HSI-02","text":"Die betrachtende Instanz kann nicht als souveräner Setzer isolierter Einheiten auftreten, sondern muss die Vermittlung verfolgen, durch die eine Einheit bestimmt und verändert wird.","refs":["CH_GB18_DIER:DNX3","CH_GB18_DIER:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:HSI-03","text":"Die Zeitstruktur des Systems ist doppelt: Eine äußerliche Folge schreitet arithmetisch fort, während eine qualitative Potenzbewegung ihre innere Gesetzlichkeit verändert.","refs":["CH_GB18_BDSM:A9","CH_GB18_BDSM:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:HSI-04","text":"Möglich bleibt als Handlung nur eine Navigation innerhalb der Maßrelation: Das äußerliche Quantum wird nicht beseitigt, sondern durch die Bestimmung seiner qualitativen Aufnahme transformiert.","refs":["CH_GB18_BDSM:D8","CH_GB18_BDSM:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_28:MRT-B01","text":"Die globale Rekonstruktion ist hinreichend, wenn das Maaß als Übergang von äußerlicher Regel über relationale Vermittlung zu qualitativer Gesetzlichkeit bestimmt wird.","refs":["CH_GB18_BSM0:MRT1","CH_GB18_BDSM:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MRT-B02","text":"Unterbestimmt bleiben die konkrete Gestalt der Maßeinheit, die exakte Potenzenfolge und die mathematische Form der Inkommensurabilität.","refs":["CH_GB18_BSM0:MRT2","CH_GB18_BDSM:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MRT-B03","text":"Die Kohärenz hängt davon ab, die anfängliche Äußerlichkeit als notwendige Durchgangsform und nicht als abschließende Bestimmung zu lesen.","refs":["CH_GB18_DIER:MRT3","CH_GB18_BDSM:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MRT-B04","text":"Die stärkste Stelle der Architektur ist die Umwandlung des scheinbar numerischen Exponenten in ein qualitatives Prinzip, das eine zweite Gesetzlichkeit erzeugt.","refs":["CH_GB18_BDSM:MRT5","CH_GB18_BDSM:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MRT-B05","text":"Unverzichtbar bleibt die doppelte Bestimmung des Maaßes: Es muss äußerlich auf ein Quantum bezogen und zugleich immanent als qualitative Einheit dieses Bezugs erzeugt werden.","refs":["CH_GB18_BSM0:SD1","CH_GB18_BDSM:MRT8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MRT-B06","text":"Die minimale hinreichende Architektur lautet: äußerliche Regel → relatives Quantum → qualitative Maßbestimmung → Potenzdifferenz → Fürsichsein in der Äußerlichkeit.","refs":["CH_GB18_BDSM:AF1","CH_GB18_BDSM:AF7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121817172669Z_f31e1319","language_code":"en","language_name":"English","title":"Chapters 82–84","source_sha256":"f21f98244d89466a4ea568997fcc42d94ba8d57abcc65da5f365f4596c09a0e1","sha256":"b663ce3fe4bb74a3609e5d53e9fb7d7d3500d5e1c4183f668a5a8a15237f742e","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:18:17.173632+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_28:AS-01","text":"The central problem is to determine measure against a merely externally given quantum and thereby make its qualitative inner logic visible.","refs":["CH_GB18_BSM0:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AS-02","text":"The initial rule appears as a determinate unit vis-à-vis a quantum, but through its relation to this other it is transformed into a specific determination of measure.","refs":["CH_GB18_DIER:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AS-03","text":"External comparison proves to be a necessary but insufficient initial form, because it still treats the inner determinacy of measure as arbitrariness.","refs":["CH_GB18_DIER:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AS-04","text":"At the cluster level, measure is reconstituted as the qualitative determination of external quantity, not as an additional magnitude alongside it.","refs":["CH_GB18_BDSM:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AS-05","text":"The movement is recursive and mutation-driven: the rule is related to its other, the unit itself becomes quantifiable, and the external series produces a qualitatively otherwise posited series.","refs":["CH_GB18_DIER:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AS-06","text":"The closure consists in an articulated unity of rule, determining quantity, qualitative relation, and a lawfulness of externality emerging from it.","refs":["CH_GB18_BSM0:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_28:GA-01","text":"[Persistent] Measure is not mere quantity, but a qualitative determination through which quantity is first determined as measure.","refs":["CH_GB18_BSM0:A1","CH_GB18_BDSM:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-02","text":"[Mutating] The rule begins as an external instance of comparison and mutates into the specific relation of a determination to its own other.","refs":["CH_GB18_DIER:A5","CH_GB18_DIER:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-03","text":"[Persistent] Measure presupposes an external quantum, but at the same time contains an immanent determination that qualitatively organizes this quantum.","refs":["CH_GB18_BSM0:A4","CH_GB18_BDSM:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-04","text":"[Emergent] External measurement is reconstructed at the higher level as a mediated relation in which quantity and quality no longer appear separately.","refs":["CH_GB18_DIER:D4","CH_GB18_BDSM:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-05","text":"[Mutating] The unit loses its absolute self-subsistence because it can itself again be determined as a number of other units.","refs":["CH_GB18_DIER:A6","CH_GB18_DIER:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-06","text":"[Emergent] The qualitative moment of measure appears as a power determination, which takes the quantum not additively but according to a lawfulness of its own.","refs":["CH_GB18_BDSM:A7","CH_GB18_BDSM:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-07","text":"[Terminal] The arithmetic alteration of the external quantum is only the initial series of a second, qualitatively determined series.","refs":["CH_GB18_BDSM:A9","CH_GB18_BDSM:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-08","text":"[Attractor] Measure converges upon being-for-self in externality: it remains related to external quantity, but determines its lawfulness from an immanent quality.","refs":["CH_GB18_BDSM:SD6","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-09","text":"[Persistent] Quality and quantity are not separate components, but sides determined in relation to one another of a single structure of measure.","refs":["CH_GB18_BSM0:A5","CH_GB18_DIER:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GA-10","text":"[Terminal] The qualitative determination of measure produces a difference of lawfulnesses in which the arithmetic and power series are not necessarily commensurable.","refs":["CH_GB18_BDSM:D6","CH_GB18_BDSM:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_28:RMD-01","text":"The rule recurs in all units, but shifts from an external norm to a relational and finally qualitative lawfulness.","refs":["CH_GB18_BSM0:A2","CH_GB18_BDSM:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-02","text":"The quantum is repeated first as the object measured, then as the other of the rule, and finally as specifically altered quantum.","refs":["CH_GB18_DIER:A3","CH_GB18_BDSM:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-03","text":"The unit is preserved, but loses its immediate absoluteness as soon as it itself passes over into a number and thereby into a further relation of measure.","refs":["CH_GB18_DIER:A7","CH_GB18_DIER:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-04","text":"Quantity and quality do not recur identically: quantity becomes, from the initial material, the bearer of qualitative determinacy, while quality becomes the operative form of quantitative alteration.","refs":["CH_GB18_BSM0:SD2","CH_GB18_BDSM:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-05","text":"The arithmetic series is absorbed at the cluster level: it remains as the bearer of the movement, but loses the status of a complete explanation.","refs":["CH_GB18_BDSM:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-06","text":"The ratio exponent shifts from the apparent numerical quotient to the qualitative principle that first makes the series specific.","refs":["CH_GB18_BDSM:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RMD-07","text":"The external rule does not disappear, but is sublated in the higher structure as the locus of an immanent qualitative lawfulness.","refs":["CH_GB18_BDSM:SD6","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_28:CGD-01","text":"The concrete division of a unit into smaller units remains a local mechanism; at the cluster level, what matters from this is only the relativization of every immediate self-subsistence of measure.","refs":["CH_GB18_DIER:A7","CH_GB18_DIER:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:CGD-02","text":"The exact mathematical form of the power series belongs to the lower level; globally decisive is the difference between the arithmetic input series and the qualitative consequent series.","refs":["CH_GB18_BDSM:MRT3","CH_GB18_BDSM:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:CGD-03","text":"The distinction between intensity and extensity is locally an argument against a false qualitative equation; at the cluster level, it is incorporated into the more general difference between external form and immanent determination.","refs":["CH_GB18_BDSM:AS4","CH_GB18_BDSM:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:CGD-04","text":"The three chapter mechanisms scale into a common architecture once rule, quantification, and power determination are read as successive transformations of the same measure.","refs":["CH_GB18_BSM0:A8","CH_GB18_BDSM:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:CGD-05","text":"The concrete arbitrariness of a unit of measure is not treated at the higher level as an individual case, but as the necessary transition from external positing to relational specification.","refs":["CH_GB18_DIER:A6","CH_GB18_DIER:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:CGD-06","text":"What scales upward is not the individual operation of measurement, but the transformation of an initially external determination into a qualitative lawfulness of the quantum.","refs":["CH_GB18_DIER:ME1","CH_GB18_BDSM:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_28:GNX-01","text":"Measure is demarcated from mere quantum; a pure amount cannot complete the determination of measure.","refs":["CH_GB18_BSM0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GNX-02","text":"An external rule alone does not count as complete measure, because it lacks the specific determination of the quantum.","refs":["CH_GB18_BSM0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GNX-03","text":"Specific quantity is not a counter-quantum independent of the external quantum, but its qualitative determination.","refs":["CH_GB18_BSM0:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GNX-04","text":"The sides of measure are neither merely quantitative magnitudes nor components additively juxtaposed.","refs":["CH_GB18_BSM0:NX4","CH_GB18_BSM0:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:GNX-05","text":"A fully commensurable numerical order is excluded as insufficient once measure appears as a qualitative power determination.","refs":["CH_GB18_BDSM:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_28:DBN-01","text":"The system cannot subsist if measurement is regarded as the neutral application of an already completely determined unit.","refs":["CH_GB18_DIER:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:DBN-02","text":"Impermissible is a model in which rule and quantum are present independently of one another and are only subsequently externally connected.","refs":["CH_GB18_DIER:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:DBN-03","text":"Impermissible is an ontology of mere amounts, in which alteration is completely explained by addition, subtraction, or numerical proportion.","refs":["CH_GB18_BDSM:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:DBN-04","text":"The system disqualifies every conception according to which qualitative determination would be only a differently named numerical relation.","refs":["CH_GB18_BDSM:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:DBN-05","text":"The permanence of measure presupposes that external dependence and qualitative self-subsistence hold simultaneously, without falling apart into separate substances.","refs":["CH_GB18_BDSM:DNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_28:BSA-01","text":"A measureless pure quantity is unavailable as a final explanation.","refs":["CH_GB18_BSM0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSA-02","text":"An external norm without inner specification cannot function as a complete identity of rule and quantum.","refs":["CH_GB18_BSM0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSA-03","text":"The possibility of treating the sides of measure as magnitudes independent of one another is structurally blocked.","refs":["CH_GB18_BSM0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSA-04","text":"The system circles around the impossible alternative of a pure externality without immanent determination and a pure immanence without quantitative externalization.","refs":["CH_GB18_DIER:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_28:XD-01","text":"The connection of external rule and specific qualitative measure transforms the rule from a norm of comparison into a qualitative lawfulness of the quantum determined by it.","refs":["CL_GB18_28:GA-02","CL_GB18_28:GA-03","CL_GB18_28:GA-04","CH_GB18_DIER:A8","CH_GB18_BDSM:A1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-02","text":"The relativization of the unit and the power determination of the quantum produce a common logic in which every positing of measure is simultaneously self-relation and alteration of the other.","refs":["CL_GB18_28:GA-05","CL_GB18_28:GA-06","CH_GB18_DIER:D2","CH_GB18_BDSM:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-03","text":"Arithmetic progression attains the status of a generative but subordinate initial series only through the qualitative reaction of measure.","refs":["CL_GB18_28:GA-06","CL_GB18_28:GA-07","CL_GB18_28:GA-10","CH_GB18_BDSM:A9","CH_GB18_BDSM:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-04","text":"The tension between arbitrary unit and immanent specification becomes productive, because the initial arbitrariness opens the transition to relational determination.","refs":["CL_GB18_28:GA-02","CL_GB18_28:GA-05","CH_GB18_DIER:SD1","CH_GB18_DIER:A9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-05","text":"From the connection of qualitative unity and quantitative multiplicity follows that measure operates not as addition, but as the mediated relation of two modes of determination.","refs":["CL_GB18_28:GA-04","CL_GB18_28:GA-09","CH_GB18_DIER:SD2","CH_GB18_BSM0:NX5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-06","text":"The incommensurability of the consequent series is not an external defect, but the operative consequence of quality taking arithmetic alteration differently.","refs":["CL_GB18_28:GA-06","CL_GB18_28:GA-10","CH_GB18_BDSM:D7","CH_GB18_BDSM:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_28:XD-07","text":"The three input units converge upon a structure of measure in which externality is not eliminated, but recoded as the medium of being-for-self.","refs":["CL_GB18_28:GA-02","CL_GB18_28:GA-08","CH_GB18_BDSM:SD6","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_28:BSD-01","text":"At this level, measure is not a descriptive category, but a transformation machine that converts external quantity into qualitative lawfulness.","refs":["CH_GB18_BDSM:SD4","CH_GB18_BDSM:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSD-02","text":"Reality appears as an articulated relation of two lawfulnesses: one externally successive and one qualitatively determining, which organizes its course.","refs":["CH_GB18_BDSM:FGS7","CH_GB18_BDSM:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSD-03","text":"Identity is produced not as immediate equality, but as the stability of a mediated difference of rule, quantum, and qualitative determination.","refs":["CH_GB18_BSM0:ALT4","CH_GB18_BSM0:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSD-04","text":"Temporal or successive alteration acquires a double structure: externally it follows an arithmetic series, but qualitatively a divergent power series.","refs":["CH_GB18_BDSM:ALT4","CH_GB18_BDSM:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSD-05","text":"Methodologically, one must ask not only which quantum is present, but how it is taken through the relation of measure and qualitatively determined.","refs":["CH_GB18_BDSM:D8","CH_GB18_BDSM:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:BSD-06","text":"The terminal consequence is a lawfulness of externality in which the external no longer appears as the opposite pole of the inner, but as its mediated enactment.","refs":["CH_GB18_BDSM:AF7","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_28:RLE-01","text":"External rule → opposing quantum → measurement → relativization of the unit → self-relation of the rule → specific measure.","refs":["CH_GB18_DIER:AF1","CH_GB18_DIER:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RLE-02","text":"Unit → number of units → renewed quantifiability of the unit → dissolution of its immediate self-subsistence → relational determination of measure.","refs":["CH_GB18_DIER:FGS2","CH_GB18_DIER:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RLE-03","text":"External arithmetic alteration → qualitative reaction → power series → non-commensurability → qualitative lawfulness of quantity.","refs":["CH_GB18_BDSM:FGS5","CH_GB18_BDSM:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RLE-04","text":"The concept of measure becomes the attractor toward which rule, quantum, unit, quality, and power determination tend after they have lost their isolated function.","refs":["CH_GB18_BSM0:D4","CH_GB18_BDSM:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:RLE-05","text":"The central recursive loop reads: measure depends on the external quantum, but determines it through a quality that can become effective only within this dependence.","refs":["CH_GB18_BDSM:D3","CH_GB18_BDSM:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_28:FGS-B01","text":"External rule + external quantum → external comparison as necessary initial form.","refs":["CH_GB18_DIER:FGS1","CH_GB18_DIER:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FGS-B02","text":"External comparison → relativization of the unit → relation of the rule to its own other.","refs":["CH_GB18_DIER:FGS2","CH_GB18_DIER:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FGS-B03","text":"Relation to its own other → specific measure → qualitative determination of the external quantum.","refs":["CH_GB18_DIER:FGS3","CH_GB18_BDSM:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FGS-B04","text":"External quantum → arithmetic series; qualitative determination of measure → power series; difference of both series → qualitative lawfulness.","refs":["CH_GB18_BDSM:FGS5","CH_GB18_BDSM:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FGS-B05","text":"Rule + relational unit + qualitative power determination → being-for-self in externality.","refs":["CH_GB18_BDSM:FGS8","CH_GB18_BDSM:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_28:AFM-B01","text":"Mere quantum → external rule → external comparison → relativization of the unit → self-relation of the rule → specific measure → qualitative determination → power series → being-for-self in externality.","refs":["CH_GB18_DIER:AF1","CH_GB18_BDSM:AF7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:AFM-B02","text":"External indifference → relational mediation → qualitative reaction → divergence from the arithmetic series → terminal lawfulness of measure.","refs":["CH_GB18_BDSM:AF1","CH_GB18_BDSM:AF7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_28:MME-01","text":"The quantum is reclassified from the self-subsistent starting point into the externally given side organized by a qualitative determination of measure.","refs":["CH_GB18_BSM0:ME1","CH_GB18_BDSM:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MME-02","text":"The rule is remapped from an external operation of comparison into a relational and finally immanent lawfulness.","refs":["CH_GB18_DIER:ME1","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MME-03","text":"The opposition of quantity and quality collapses as an external opposition and is reordered as the relation of two sides of the same determination of measure.","refs":["CH_GB18_BSM0:ME3","CH_GB18_BDSM:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MME-04","text":"The arithmetic series loses the status of a complete explanation; it becomes the visible surface of a qualitatively otherwise structured series.","refs":["CH_GB18_BDSM:ME4","CH_GB18_BDSM:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MME-05","text":"The new strategic map requires determinations of measure to be read according to their mode of mediation, not according to isolated values or external numbers.","refs":["CH_GB18_BDSM:D8","CH_GB18_BDSM:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_28:ALT-B01","text":"At the surface level, an external magnitude is organized through rule, quantum, and specific determination of measure.","refs":["CH_GB18_BSM0:ALT1","CH_GB18_BDSM:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:ALT-B02","text":"At the structural level, measure forms a mediated relation in which rule, unit, quantum, and qualitative determination reciprocally depend on one another.","refs":["CH_GB18_BSM0:ALT2","CH_GB18_BDSM:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:ALT-B03","text":"At the metastrategic level, the system replaces the isolated consideration of magnitudes with the analysis of their relational and qualitative generation.","refs":["CH_GB18_BSM0:ALT3","CH_GB18_BDSM:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:ALT-B04","text":"At the ontological-temporal level, identity appears as articulated unity, while alteration proceeds simultaneously arithmetically externally and qualitatively potentially.","refs":["CH_GB18_BSM0:ALT4","CH_GB18_BDSM:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:ALT-B05","text":"At the methodological-performative level, the presentation itself enacts the transition from external positing through relational mediation to qualitative determination.","refs":["CH_GB18_BSM0:MRT6","CH_GB18_BDSM:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_28:FL-01","text":"[Tension] Measure begins as an external rule, but is to count as an immanent qualitative determination; its unity therefore depends on a surpassing of its own initial form.","refs":["CH_GB18_BSM0:MRT5","CH_GB18_BDSM:MRT8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FL-02","text":"[Tension] The qualitative principle is asserted as a power determination, but remains underdetermined with regard to the concrete mathematical series and its exact relation.","refs":["CH_GB18_BDSM:MRT3","CH_GB18_BDSM:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FL-03","text":"[Tension] Measure depends on external quantity and at the same time surpasses its lawfulness through a qualitative determination that is not necessarily commensurable.","refs":["CH_GB18_BDSM:MRT8","CH_GB18_BDSM:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:FL-04","text":"[Tension] The unit is initially posited arbitrarily, but gains its specification precisely through the relation to that to which it is applied.","refs":["CH_GB18_DIER:MRT5","CH_GB18_DIER:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MP-01","text":"[Mutation point] The rule mutates from an externally determined unit into a self-relation to its own other.","refs":["CH_GB18_DIER:AS5","CH_GB18_DIER:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MP-02","text":"[Mutation point] The quantum mutates from the independent object of measurement into the determined form of the other and finally into the qualitatively altered quantum.","refs":["CH_GB18_DIER:D5","CH_GB18_BDSM:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MP-03","text":"[Mutation point] The exponent mutates from the apparent quotient into the qualitative principle that transfers the quantitative series into another lawfulness.","refs":["CH_GB18_BDSM:AF4","CH_GB18_BDSM:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MP-04","text":"[Mutation point] Externality reverses its valence: initially it is a lack of inwardness and finally becomes the locus of being-for-self.","refs":["CH_GB18_BDSM:ME5","CH_GB18_BDSM:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_28:HSI-01","text":"The system implicitly takes reality to be a measure machine in which external magnitudes are generated through relational and qualitative determinations.","refs":["CH_GB18_BSM0:SD1","CH_GB18_BDSM:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:HSI-02","text":"The observing instance cannot appear as a sovereign positior of isolated units, but must follow the mediation through which a unit is determined and altered.","refs":["CH_GB18_DIER:DNX3","CH_GB18_DIER:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:HSI-03","text":"The temporal structure of the system is double: an external succession progresses arithmetically, while a qualitative movement of powers alters its inner lawfulness.","refs":["CH_GB18_BDSM:A9","CH_GB18_BDSM:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:HSI-04","text":"Only navigation within the relation of measure remains possible as action: the external quantum is not eliminated, but transformed through the determination of its qualitative reception.","refs":["CH_GB18_BDSM:D8","CH_GB18_BDSM:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_28:MRT-B01","text":"The global reconstruction is sufficient if measure is determined as the transition from external rule through relational mediation to qualitative lawfulness.","refs":["CH_GB18_BSM0:MRT1","CH_GB18_BDSM:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MRT-B02","text":"The concrete shape of the unit of measure, the exact sequence of powers, and the mathematical form of incommensurability remain underdetermined.","refs":["CH_GB18_BSM0:MRT2","CH_GB18_BDSM:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MRT-B03","text":"Coherence depends on reading the initial externality as a necessary transitional form and not as a conclusive determination.","refs":["CH_GB18_DIER:MRT3","CH_GB18_BDSM:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MRT-B04","text":"The strongest point of the architecture is the transformation of the seemingly numerical exponent into a qualitative principle that produces a second lawfulness.","refs":["CH_GB18_BDSM:MRT5","CH_GB18_BDSM:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MRT-B05","text":"Indispensable remains the double determination of measure: it must be related externally to a quantum and at the same time generated immanently as the qualitative unity of this relation.","refs":["CH_GB18_BSM0:SD1","CH_GB18_BDSM:MRT8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_28:MRT-B06","text":"The minimally sufficient architecture reads: external rule → relative quantum → qualitative determination of measure → power difference → being-for-self in externality.","refs":["CH_GB18_BDSM:AF1","CH_GB18_BDSM:AF7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_28@R001","source_variant_id":"canonical:CL_GB18_28:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 82–84","context":"B. Specificirendes Maaß. · a. Die Regel. · b. Das specificirende Maaß."},"title_language_code":"en"},{"id":"CL_GB18_29","layer":"CL","title":"Chapters 85–87","order":29,"parents":["CH_GB18_A_21","CH_GB18_CVLB","CH_GB18_A_22"],"revision":"CL_GB18_29@R001","sha256":"fc0c243d15c9971d30b8e30034f53dc210385dc7579259520be3ae6db3b4c44e","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_29:AS-B01","text":"Das Cluster rekonstruiert Maß als die Instanz, in der quantitative Verhältnisse nur durch qualitative Bestimmtheit Realität, Veränderlichkeit und Gesetzeskraft erhalten.","refs":["CH_GB18_CVLB:AS1","CH_GB18_A_22:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B02","text":"Sein Ausgangsproblem ist die scheinbare Äußerlichkeit eines Quantums, das zunächst als gleichförmiges Medium, abstraktes Verhältnis oder empirische Zahl erscheint.","refs":["CH_GB18_A_21:AS2","CH_GB18_CVLB:A3","CH_GB18_A_22:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B03","text":"Die gerichtete Bewegung zerstört die Annahme, dass quantitative Veränderung als direkte Übertragung, bloße Ersetzung oder formal austauschbares Verhältnis erklärt werden kann.","refs":["CH_GB18_A_21:NX1","CH_GB18_CVLB:NX5","CH_GB18_A_22:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B04","text":"Die Korrektur erfolgt durch die Bestimmung aller beteiligten Seiten als spezifische Quanta, deren quantitative Stellung aus einer asymmetrischen qualitativen Relation hervorgeht.","refs":["CH_GB18_A_21:A11","CH_GB18_CVLB:A5","CH_GB18_A_22:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B05","text":"Das Cluster wird dadurch zu einem spiralförmigen Argument: Äußerlichkeit wird vorausgesetzt, durch spezifische Aufnahme und qualitative Differenz negiert und als Moment eines realisierten Maßes wiedergewonnen.","refs":["CH_GB18_A_21:FGS1","CH_GB18_CVLB:FGS3","CH_GB18_A_22:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B06","text":"Die mathematische Form erscheint nicht als äußerer Zusatz, sondern als abgestufter Ausdruck der Fähigkeit eines Verhältnisses, qualitative Bestimmtheit im Quantum zu realisieren.","refs":["CH_GB18_CVLB:AS6","CH_GB18_CVLB:SD5","CH_GB18_A_22:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B07","text":"Das konkrete Feld der Temperatur wird in eine allgemeine Ontologie und Methodologie des Maßes überführt: Medium, Körper, Raum, Zeit und Bewegung sind nur als wechselseitig spezifizierende Seiten bestimmbar.","refs":["CH_GB18_A_21:ME1","CH_GB18_CVLB:ME4","CH_GB18_A_22:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B08","text":"Die Schließung besteht nicht in einer letzten Formel, sondern in der Forderung, dass wahre quantitative Gesetzlichkeit ihre Exponenten, Rollen und Asymmetrien aus dem Begriff der bezogenen Qualitäten ausweisen muss.","refs":["CH_GB18_CVLB:A18","CH_GB18_A_22:A15","CH_GB18_A_22:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_29:GA-01","text":"[Persistent] Maß ist keine äußerliche Vergleichsregel, sondern die qualitative Einheit eines quantitativen Verhältnisses.","refs":["CH_GB18_A_21:SD1","CH_GB18_CVLB:A7","CH_GB18_A_22:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-02","text":"[Mutating] Das äußerliche Quantum ist notwendiger Ausgangspunkt, verliert aber als bloße Äußerlichkeit seine Selbständigkeit, sobald es spezifiziert wird.","refs":["CH_GB18_A_21:A10","CH_GB18_CVLB:A2","CH_GB18_CVLB:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-03","text":"[Persistent] Jede Maßrelation verbindet Seiten, die zugleich quantitativ vergleichbar und qualitativ nicht austauschbar sind.","refs":["CH_GB18_A_21:A11","CH_GB18_CVLB:A4","CH_GB18_A_22:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-04","text":"[Attractor] Quantitative Veränderung ist nur dann wahrhaft bestimmt, wenn sie eine Veränderung des Quantums als qualitativer Gestalt vollzieht.","refs":["CH_GB18_A_21:SD3","CH_GB18_CVLB:A11","CH_GB18_CVLB:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-05","text":"[Emergent] Die Asymmetrie der Maßseiten ist ontologisch produziert: eine Seite fungiert als extensive Äußerlichkeit oder Anzahl, die andere als intensive Einheit oder Negativität.","refs":["CH_GB18_CVLB:A14","CH_GB18_CVLB:A15","CH_GB18_A_22:A3","CH_GB18_A_22:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-06","text":"[Mutating] Die Potenzform eines Verhältnisses ist keine neutrale Schreibweise, sondern der quantitative Ausdruck des Grades, in dem eine qualitative Beziehung realisiert ist.","refs":["CH_GB18_CVLB:A18","CH_GB18_CVLB:D8","CH_GB18_A_22:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-07","text":"[Terminal] Empirische Geltung und mathematische Formulierung reichen nicht zur begrifflichen Notwendigkeit eines Gesetzes; diese verlangt die Herleitung des Quantitativen aus seinen qualitativen Momenten.","refs":["CH_GB18_A_22:A14","CH_GB18_A_22:A15","CH_GB18_A_22:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-08","text":"[Attractor] Eine Wissenschaft der Natur ist wesentlich Wissenschaft der Maße, weil ihre Gegenstände nicht aus isolierten Daten, sondern aus begrifflich gegliederten Relationsformen bestehen.","refs":["CH_GB18_A_22:A12","CH_GB18_A_22:SD1","CH_GB18_A_22:ALT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_29:RMD-01","text":"Das äußere Medium kehrt als notwendige Voraussetzung wieder, mutiert aber vom scheinbar homogenen Temperaturträger zur selbst spezifischen Maßseite und schließlich zur extensiven Raumseite.","refs":["CH_GB18_A_21:A2","CH_GB18_A_21:A10","CH_GB18_A_22:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RMD-02","text":"Die spezifische Wärme des Körpers verschwindet als lokaler Gegenstand, nachdem sie die übergeordnete Funktion erfüllt hat, jede quantitative Aufnahme als immanente qualitative Selbstbestimmung auszuweisen.","refs":["CH_GB18_A_21:A6","CH_GB18_A_21:A8","CH_GB18_A_21:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RMD-03","text":"Das Verhältnis zweier spezifischer Quanta erweitert sich zur allgemeinen Struktur asymmetrischer Qualitäten und wird im Raum-Zeit-Verhältnis als Anzahl und Einheit konkretisiert.","refs":["CH_GB18_A_21:A11","CH_GB18_CVLB:D4","CH_GB18_A_22:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RMD-04","text":"Die Potenz wandert von der abstrakten Hierarchie mathematischer Formen in die Klassifikation unterschiedlicher Bewegungsweisen und erhält dadurch ontologische statt bloß formaler Bedeutung.","refs":["CH_GB18_CVLB:A18","CH_GB18_CVLB:SD3","CH_GB18_A_22:D2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_29:CGD-01","text":"Die unterschiedlichen Wärmekapazitäten einzelner Körper bleiben lokale Evidenz; auf Clusterebene zählt allein ihre Funktion, die Nichtidentität äußerer Einwirkung und innerer Maßbestimmung zu erzwingen.","refs":["CH_GB18_A_21:A6","CH_GB18_A_21:D1","CH_GB18_A_21:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:CGD-02","text":"Die Unterscheidung direkter, quadratischer und kubischer Verhältnisse skaliert über die mathematischen Beispiele hinaus, weil sie eine Hierarchie qualitativer Realisationsgrade des Maßes trägt.","refs":["CH_GB18_CVLB:FGS6","CH_GB18_CVLB:ME5","CH_GB18_A_22:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:CGD-03","text":"Die besonderen Bewegungsgesetze bleiben lokale Anwendungen; global tragend ist, dass quantitative Gesetze nur als Exposition der qualitativen Art einer Beziehung gelten.","refs":["CH_GB18_A_22:A6","CH_GB18_A_22:D3","CH_GB18_A_22:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:CGD-04","text":"Die Kritik an Newtons Beweisapparat wird nicht als historische Nebenbehauptung bewahrt, sondern als methodische Grenze jeder Mathematik, die ihre Gesetze voraussetzt, statt sie begrifflich zu erzeugen.","refs":["CH_GB18_A_22:A16","CH_GB18_A_22:D8","CH_GB18_A_22:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_29:GNX-01","text":"Das Cluster verwirft den linearen Kausalismus, nach dem ein äußeres Quantum seine quantitative Form unverändert in einen besonderen Gegenstand überträgt.","refs":["CH_GB18_A_21:NX1","CH_GB18_A_21:DNX1","CH_GB18_A_21:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GNX-02","text":"Es verwirft ebenso eine Mathematik neutraler Verhältnisse, in der Zähler und Nenner, Potenz und Wurzel oder Raum und Zeit ohne qualitative Funktionsdifferenz vertauschbar wären.","refs":["CH_GB18_CVLB:A14","CH_GB18_CVLB:SNX4","CH_GB18_A_22:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GNX-03","text":"Es schließt den Schluss aus, empirische Übereinstimmung oder analytische Komplexität könne bereits begriffliche Notwendigkeit ersetzen.","refs":["CH_GB18_A_22:A14","CH_GB18_A_22:NX7","CH_GB18_A_22:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_29:DBN-01","text":"Unzulässig ist ein Modell fertiger Größen, deren Eigenschaften vor ihrer Relation bestehen und deren Verhältnis erst nachträglich hinzugefügt wird.","refs":["CH_GB18_A_21:DNX5","CH_GB18_CVLB:DNX2","CH_GB18_A_22:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:DBN-02","text":"Unzulässig ist ein Begriff von Veränderung, der nur Sukzession, Austausch oder Skalierung kennt und deshalb die qualitative Umgestaltung des Quantums verfehlt.","refs":["CH_GB18_A_21:SD3","CH_GB18_CVLB:NX5","CH_GB18_CVLB:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:DBN-03","text":"Unzulässig ist eine Wissenschaftsform, die mathematische Allgemeinheit mit begrifflicher Erzeugung verwechselt und ihre Voraussetzungen im Beweis unsichtbar macht.","refs":["CH_GB18_CVLB:DNX5","CH_GB18_A_22:A16","CH_GB18_A_22:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_29:BSA-01","text":"Das Cluster organisiert sich um die Unmöglichkeit einer reinen Quantität, die vollständig bestimmt wäre, ohne bereits qualitative Spezifikation zu enthalten.","refs":["CH_GB18_A_21:SNX3","CH_GB18_CVLB:SNX1","CH_GB18_A_22:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:BSA-02","text":"Es umkreist die nicht verfügbare Möglichkeit einer vollständig ausgeführten begrifflichen Ableitung konkreter Potenzexponenten aus den Qualitäten der bezogenen Momente.","refs":["CH_GB18_A_22:SNX3","CH_GB18_A_22:MRT2","CH_GB18_A_22:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:BSA-03","text":"Es verweigert eine abschließende Außenperspektive auf Maß, weil jede Messrelation selbst als spezifische, asymmetrische und veränderliche Bestimmung in das Gemessene eingelassen ist.","refs":["CH_GB18_A_21:SNX1","CH_GB18_CVLB:A8","CH_GB18_CVLB:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_29:XD-01","text":"Die Temperaturrelation liefert den konkreten Beweis dafür, dass die allgemeine Theorie des realisierten Maßes keine abstrakte Formel bleibt: Ein gemeinsames Quantum wird nur durch differente qualitative Aufnahme zu verschiedenen Maßbestimmungen.","refs":["CL_GB18_29:GA-01","CL_GB18_29:GA-02","CL_GB18_29:GA-03","CH_GB18_A_21:D1","CH_GB18_CVLB:D3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_29:XD-02","text":"Die Raum-Zeit-Gesetze radikalisieren die Temperaturanalyse, indem sie die Differenz spezifischer Quanta nicht nur als Aufnahmeverschiedenheit, sondern als notwendige Rollenverteilung von Anzahl und Einheit bestimmen.","refs":["CL_GB18_29:GA-03","CL_GB18_29:GA-05","CH_GB18_A_21:A11","CH_GB18_CVLB:A15","CH_GB18_A_22:D1"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_29:XD-03","text":"Die Hierarchie direkter, quadratischer und höherer Potenzverhältnisse wird erst durch die Verbindung der allgemeinen Maßlogik mit den Bewegungsarten operativ: Potenzexponenten klassifizieren Grade begrifflicher Freiheit.","refs":["CL_GB18_29:GA-05","CL_GB18_29:GA-06","CH_GB18_CVLB:SD3","CH_GB18_A_22:D2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_29:XD-04","text":"Die lokale Kritik der festen Temperaturproportionalität und die Kritik mathematischer Scheinbeweise konvergieren in einer gemeinsamen Negation: Kein quantitatives Gesetz darf seine qualitative Bedingtheit verbergen.","refs":["CL_GB18_29:GA-04","CL_GB18_29:GA-07","CH_GB18_A_21:NX3","CH_GB18_A_22:NX7"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_29:BSD-01","text":"Realität erscheint als Feld wechselseitiger Spezifikation, in dem äußere Einwirkung nur durch immanente Maßform Wirkung erhält und das Innere nur in einer äußeren Relation bestimmt ist.","refs":["CH_GB18_A_21:SD2","CH_GB18_CVLB:A6","CH_GB18_A_22:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:BSD-02","text":"Zeit wird nicht als neutrale Abfolge, sondern als negative Einheit bestimmt, durch die extensive Äußerlichkeit in ein gerichtetes und asymmetrisches Maßverhältnis überführt wird.","refs":["CH_GB18_CVLB:A14","CH_GB18_A_22:A4","CH_GB18_A_22:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:BSD-03","text":"Handlungsmacht oder Freiheit ist nicht subjektive Willkür, sondern der Grad, in dem eine Relation ihre Momente als begrifflich bestimmte Maßseiten realisiert.","refs":["CH_GB18_A_22:A6","CH_GB18_A_22:D2","CH_GB18_A_22:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:BSD-04","text":"Wissenschaftliche Erkenntnis wird als Prüfung der Herkunft von Exponenten, Verhältnissen und Formeln reorganisiert und nicht mehr als bloße Erweiterung empirischer Reichweite oder Rechenmacht.","refs":["CH_GB18_CVLB:ME5","CH_GB18_A_22:A15","CH_GB18_A_22:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_29:RLE-01","text":"Die zentrale Schleife lautet: äußerliches Quantum → spezifische Aufnahme → Veränderung der spezifischen Gestalt → Rückkehr des Quantums als qualitativ bestimmtes Maß.","refs":["CH_GB18_A_21:FGS2","CH_GB18_A_21:FGS4","CH_GB18_A_21:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RLE-02","text":"Der Attraktor des Clusters ist das aufgehobene Quantum: Es darf weder verschwinden noch als selbständige Äußerlichkeit bestehen bleiben, sondern muss zugleich erhalten und umcodiert werden.","refs":["CH_GB18_CVLB:A2","CH_GB18_CVLB:A8","CH_GB18_CVLB:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RLE-03","text":"Die Eskalation verläuft von der empirisch beobachtbaren Abweichung der Temperaturaufnahme über die allgemeine Differenz extensiver und intensiver Seiten zur ontologischen Klassifikation der Bewegung.","refs":["CH_GB18_A_21:A7","CH_GB18_CVLB:A14","CH_GB18_A_22:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RLE-04","text":"Die Kritik des direkten Verhältnisses markiert keinen Abbruch, sondern eine rekursive Schwelle, an der eine notwendige Abstraktion in ihre begrifflich reicheren Potenzformen übergeht.","refs":["CH_GB18_CVLB:A17","CH_GB18_CVLB:MRT6","CH_GB18_CVLB:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_29:FGS-B01","text":"Ein äußerliches Quantum wird als vorläufig selbständige Größe gesetzt, damit seine Unzulänglichkeit als bloße Äußerlichkeit sichtbar werden kann.","refs":["CH_GB18_A_21:FGS1","CH_GB18_CVLB:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:FGS-B02","text":"Eine qualitative Seite nimmt das Quantum nicht passiv auf, sondern spezifiziert es gemäß ihrem immanenten Maß und erzeugt dadurch differente quantitative Erscheinungen.","refs":["CH_GB18_A_21:FGS2","CH_GB18_CVLB:FGS3","CH_GB18_CVLB:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:FGS-B03","text":"Die Spezifikation verwandelt Veränderung von einer bloßen Größenfolge in eine Veränderung des Quantums als solchen und damit in qualitative Gestaltbildung.","refs":["CH_GB18_A_21:FGS5","CH_GB18_CVLB:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:FGS-B04","text":"Die qualitativen Seiten werden als asymmetrische Funktionen von Äußerlichkeit und Einheit formalisiert, wodurch Anzahl, Wurzel, Potenz und Exponent ontologische Rollen erhalten.","refs":["CH_GB18_CVLB:FGS5","CH_GB18_CVLB:A15","CH_GB18_CVLB:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:FGS-B05","text":"Ein Gesetz besitzt begriffliche Geltung nur, wenn seine quantitative Form aus dieser qualitativen Asymmetrie hervorgebracht und nicht aus Beobachtung oder Formelgebrauch vorausgesetzt wird.","refs":["CH_GB18_A_22:FGS5","CH_GB18_A_22:FGS6","CH_GB18_A_22:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_29:AFM-B01","text":"Scheinbar gleichförmige äußere Einwirkung wird als Problem gesetzt, weil sie die differentielle Aufnahme besonderer Körper nicht erklärt.","refs":["CH_GB18_A_21:AS2","CH_GB18_A_21:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AFM-B02","text":"Die differentielle Aufnahme erzwingt die Reifikation immanenter Maßbestimmung und zerstört die Vorstellung einer direkten Proportionalität.","refs":["CH_GB18_A_21:D1","CH_GB18_A_21:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AFM-B03","text":"Das Verhältnis wird als Einheit zweier spezifischer Quanta rekonstruiert, deren Verschiedenheit weder äußerlich noch symmetrisch ist.","refs":["CH_GB18_A_21:FGS6","CH_GB18_CVLB:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AFM-B04","text":"Die Asymmetrie wird in extensive Äußerlichkeit und intensive Einheit übersetzt und als gestufte Potenzstruktur formalisierbar gemacht.","refs":["CH_GB18_CVLB:A14","CH_GB18_CVLB:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AFM-B05","text":"Die Potenzstruktur wird auf Raum, Zeit und Bewegungsarten übertragen, sodass Gesetzesformen als Grade begrifflich bestimmter Freiheit erscheinen.","refs":["CH_GB18_A_22:FGS2","CH_GB18_A_22:FGS3","CH_GB18_A_22:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AFM-B06","text":"Die wissenschaftliche Schließung trennt empirische Bestätigung und mathematische Darstellung von der begrifflichen Erzeugung der Gesetzesform.","refs":["CH_GB18_A_22:SD1","CH_GB18_A_22:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_29:MME-01","text":"Quantität wird von einer neutralen Skala zu einer doppelt codierten Realität umkartiert: Sie ist äußerlich vergleichbar und zugleich Träger spezifischer qualitativer Bestimmung.","refs":["CH_GB18_CVLB:A5","CH_GB18_CVLB:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MME-02","text":"Die Differenz zwischen Allgemeinem und Besonderem wird umgeordnet: Das allgemeine Medium existiert nicht vor seinen spezifischen Aufnahmen, sondern wird durch sie konkret bestimmt.","refs":["CH_GB18_A_21:SD2","CH_GB18_A_21:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MME-03","text":"Mathematik wird von einem universalen Beweisapparat zu einer hierarchisch prüfbaren Sprache der Maße reklassifiziert.","refs":["CH_GB18_CVLB:SD5","CH_GB18_A_22:A12","CH_GB18_A_22:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MME-04","text":"Naturgesetzlichkeit wird von der Ordnung beobachteter Regelmäßigkeiten zur begrifflich begründeten Architektonik qualitativer Beziehungen verschoben.","refs":["CH_GB18_A_22:D5","CH_GB18_A_22:SD2","CH_GB18_A_22:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_29:ALT-B01","text":"Surface level — Temperatur, Wärmekapazität, Geschwindigkeit, Fall und Himmelsbewegung fungieren als konkrete Felder, in denen quantitative Verhältnisse ihre qualitative Bedingtheit offenlegen.","refs":["CH_GB18_A_21:ALT1","CH_GB18_A_22:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:ALT-B02","text":"Structural level — Maß organisiert äußere Einwirkung, immanente Aufnahme, qualitative Asymmetrie, Potenzform und Gesetzesbildung als eine einzige Vermittlungsarchitektur.","refs":["CH_GB18_A_21:ALT2","CH_GB18_CVLB:ALT2","CH_GB18_A_22:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:ALT-B03","text":"Metastrategic level — Das Cluster ersetzt die Frage nach formaler Berechenbarkeit durch die Frage, ob eine Formel die qualitative Herkunft ihrer quantitativen Bestimmungen ausweist.","refs":["CH_GB18_A_21:ALT3","CH_GB18_CVLB:ALT3","CH_GB18_A_22:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:ALT-B04","text":"Ontological / Temporal level — Realität ist veränderliche Selbstspezifikation; Raum und Zeit bilden keine unabhängigen Variablen, sondern asymmetrische Momente eines Maßprozesses.","refs":["CH_GB18_A_21:ALT4","CH_GB18_CVLB:ALT4","CH_GB18_A_22:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:ALT-B05","text":"Methodological / Performative level — Die Argumentform vollzieht ihre These, indem sie jede scheinbar ausreichende Formel als Durchgangsstufe behandelt und ihre Voraussetzungen im Begriff der Relation zurückfordert.","refs":["CH_GB18_CVLB:MRT6","CH_GB18_A_22:FGS6","CH_GB18_A_22:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_29:FL-01","text":"Die Architektur benötigt das äußerliche Quantum als Voraussetzung, kann ihm aber keine bleibende Selbständigkeit zugestehen; ihre Einheit entsteht aus dieser nie vollständig stillstellbaren Spannung.","refs":["CH_GB18_CVLB:A3","CH_GB18_CVLB:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:FL-02","text":"Die begriffliche Vorrangstellung höherer Potenzen bleibt behauptet, ohne dass die konkrete Erzeugung ihrer Exponenten aus der qualitativen Differenz vollständig ausgeführt wird.","refs":["CH_GB18_CVLB:MRT3","CH_GB18_A_22:SNX3","CH_GB18_A_22:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MP-01","text":"Das Quantum mutiert von äußerem Medium über spezifisches Quantum zu aufgehobenem Moment einer qualitativen Maßrelation.","refs":["CH_GB18_A_21:A2","CH_GB18_A_21:FGS6","CH_GB18_CVLB:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MP-02","text":"Die mathematische Relation mutiert von direkter Proportionalität über gestufte Potenzform zur Forderung begrifflicher Gesetzesbegründung.","refs":["CH_GB18_A_21:NX3","CH_GB18_CVLB:FGS6","CH_GB18_A_22:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MP-03","text":"Freiheit mutiert von einer Bezeichnung verschiedener Bewegungsarten zu einem Kriterium für den Grad, in dem ein Maßverhältnis seine qualitative Wahrheit realisiert.","refs":["CH_GB18_A_22:A6","CH_GB18_A_22:D2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_29:HSI-01","text":"Die Realität erscheint als Maschine der Spezifikation, in der jedes äußere Quantum nur durch die inneren Maßformen seiner Relata konkrete Wirkung erhält.","refs":["CH_GB18_A_21:SD2","CH_GB18_A_21:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:HSI-02","text":"Das Subjekt wird nicht als autonomer Beobachter modelliert, sondern als immanente Einheit oder Negativität, die Äußerlichkeit in eine bestimmte Relation überführt.","refs":["CH_GB18_CVLB:A14","CH_GB18_A_22:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:HSI-03","text":"Zeit ist die negative Bedingung, durch die quantitative Ausdehnung nicht indifferent bleibt, sondern in gerichtete Veränderung und Maßbildung übergeht.","refs":["CH_GB18_CVLB:A13","CH_GB18_A_22:A4","CH_GB18_A_22:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:HSI-04","text":"Erkenntnis ist Navigation innerhalb eines gestuften Feldes von Erscheinung, Formel und Begriff, dessen gültige Passage nur durch die Rückführung quantitativer Formen auf qualitative Beziehungen möglich ist.","refs":["CH_GB18_A_22:SD1","CH_GB18_A_22:SD3","CH_GB18_A_22:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_29:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Clusterbewegung von äußerlicher Quantität über Spezifikation und asymmetrisches Verhältnis bis zur begrifflichen Gesetzesforderung zu rekonstruieren.","refs":["CH_GB18_A_21:MRT1","CH_GB18_CVLB:MRT1","CH_GB18_A_22:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MRT-B02","text":"Die Rekonstruktion ist kohärent, sofern Äußerlichkeit nicht als widerlegte Fiktion, sondern als notwendige und zugleich aufgehobene Ausgangsbedingung gelesen wird.","refs":["CH_GB18_A_21:MRT3","CH_GB18_CVLB:MRT5","CH_GB18_A_22:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MRT-B03","text":"Unterbestimmt bleibt die konkrete Brücke zwischen qualitativer Differenz und bestimmten Potenzexponenten; gerade diese Lücke begrenzt die Reichweite der beanspruchten begrifflichen Herleitung.","refs":["CH_GB18_CVLB:MRT3","CH_GB18_A_22:MRT2","CH_GB18_A_22:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MRT-B04","text":"Die stärkste und unverzichtbare Architekturleistung liegt in der rekursiven Umwandlung des Quantitativen: Es wird weder eliminiert noch verselbständigt, sondern als Träger qualitativer Maßbestimmung bewahrt.","refs":["CH_GB18_A_21:MRT4","CH_GB18_CVLB:SD1","CH_GB18_A_22:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121842339728Z_d5bc5f8c","language_code":"en","language_name":"English","title":"Chapters 85–87","source_sha256":"fc0c243d15c9971d30b8e30034f53dc210385dc7579259520be3ae6db3b4c44e","sha256":"8983d164403ae948c65a91b78747c927f645269bd35a0ab6b72a4276f7e01dfe","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:18:42.344088+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_29:AS-B01","text":"The cluster reconstructs measure as the instance in which quantitative relations acquire reality, changeability, and legal force only through qualitative determinacy.","refs":["CH_GB18_CVLB:AS1","CH_GB18_A_22:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B02","text":"Its initial problem is the apparent externality of a quantum, which initially appears as a homogeneous medium, abstract relation, or empirical number.","refs":["CH_GB18_A_21:AS2","CH_GB18_CVLB:A3","CH_GB18_A_22:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B03","text":"Directed motion destroys the assumption that quantitative change can be explained as direct transmission, mere replacement, or a formally interchangeable relation.","refs":["CH_GB18_A_21:NX1","CH_GB18_CVLB:NX5","CH_GB18_A_22:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B04","text":"The correction occurs through the determination of all participating sides as specific quanta, whose quantitative position proceeds from an asymmetric qualitative relation.","refs":["CH_GB18_A_21:A11","CH_GB18_CVLB:A5","CH_GB18_A_22:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B05","text":"The cluster thereby becomes a spiral-shaped argument: externality is presupposed, negated through specific reception and qualitative difference, and regained as a moment of realized measure.","refs":["CH_GB18_A_21:FGS1","CH_GB18_CVLB:FGS3","CH_GB18_A_22:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B06","text":"The mathematical form appears not as an external addition, but as a graduated expression of a relation's capacity to realize qualitative determinacy in quantum.","refs":["CH_GB18_CVLB:AS6","CH_GB18_CVLB:SD5","CH_GB18_A_22:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B07","text":"The concrete field of temperature is transferred into a general ontology and methodology of measure: medium, body, space, time, and motion are determinable only as mutually specifying sides.","refs":["CH_GB18_A_21:ME1","CH_GB18_CVLB:ME4","CH_GB18_A_22:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AS-B08","text":"The closure consists not in a final formula, but in the demand that true quantitative lawfulness must disclose its exponents, roles, and asymmetries from the concept of related qualities.","refs":["CH_GB18_CVLB:A18","CH_GB18_A_22:A15","CH_GB18_A_22:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_29:GA-01","text":"[Persistent] Measure is not an external rule of comparison, but the qualitative unity of a quantitative relation.","refs":["CH_GB18_A_21:SD1","CH_GB18_CVLB:A7","CH_GB18_A_22:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-02","text":"[Mutating] The external quantum is a necessary point of departure, but loses its independence as mere externality as soon as it is specified.","refs":["CH_GB18_A_21:A10","CH_GB18_CVLB:A2","CH_GB18_CVLB:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-03","text":"[Persistent] Every relation of measure connects sides that are at once quantitatively comparable and qualitatively non-interchangeable.","refs":["CH_GB18_A_21:A11","CH_GB18_CVLB:A4","CH_GB18_A_22:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-04","text":"[Attractor] Quantitative change is truly determinate only when it effectuates a change of quantum as a qualitative shape.","refs":["CH_GB18_A_21:SD3","CH_GB18_CVLB:A11","CH_GB18_CVLB:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-05","text":"[Emergent] The asymmetry of the sides of measure is ontologically produced: one side functions as extensive externality or number, the other as intensive unity or negativity.","refs":["CH_GB18_CVLB:A14","CH_GB18_CVLB:A15","CH_GB18_A_22:A3","CH_GB18_A_22:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-06","text":"[Mutating] The power form of a relation is not neutral notation, but the quantitative expression of the degree to which a qualitative relation is realized.","refs":["CH_GB18_CVLB:A18","CH_GB18_CVLB:D8","CH_GB18_A_22:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-07","text":"[Terminal] Empirical validity and mathematical formulation do not suffice for the conceptual necessity of a law; this requires the derivation of the quantitative from its qualitative moments.","refs":["CH_GB18_A_22:A14","CH_GB18_A_22:A15","CH_GB18_A_22:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GA-08","text":"[Attractor] A science of nature is essentially a science of measures, because its objects consist not of isolated data but of conceptually articulated relational forms.","refs":["CH_GB18_A_22:A12","CH_GB18_A_22:SD1","CH_GB18_A_22:ALT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_29:RMD-01","text":"The external medium recurs as a necessary presupposition, but mutates from an apparently homogeneous bearer of temperature into a self-specific side of measure and finally into the extensive side of space.","refs":["CH_GB18_A_21:A2","CH_GB18_A_21:A10","CH_GB18_A_22:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RMD-02","text":"The specific heat of the body disappears as a local object after fulfilling the higher-order function of demonstrating every quantitative reception as immanent qualitative self-determination.","refs":["CH_GB18_A_21:A6","CH_GB18_A_21:A8","CH_GB18_A_21:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RMD-03","text":"The relation of two specific quanta expands into the general structure of asymmetric qualities and is concretized in the space-time relation as number and unity.","refs":["CH_GB18_A_21:A11","CH_GB18_CVLB:D4","CH_GB18_A_22:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RMD-04","text":"Power migrates from the abstract hierarchy of mathematical forms into the classification of different modes of motion, thereby acquiring ontological rather than merely formal significance.","refs":["CH_GB18_CVLB:A18","CH_GB18_CVLB:SD3","CH_GB18_A_22:D2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_29:CGD-01","text":"The differing heat capacities of individual bodies remain local evidence; at the cluster level, only their function of compelling the non-identity of external effect and inner determination of measure counts.","refs":["CH_GB18_A_21:A6","CH_GB18_A_21:D1","CH_GB18_A_21:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:CGD-02","text":"The distinction between direct, quadratic, and cubic relations scales beyond the mathematical examples because it bears a hierarchy of qualitative degrees of realization of measure.","refs":["CH_GB18_CVLB:FGS6","CH_GB18_CVLB:ME5","CH_GB18_A_22:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:CGD-03","text":"The particular laws of motion remain local applications; globally decisive is that quantitative laws count only as exposition of the qualitative kind of a relation.","refs":["CH_GB18_A_22:A6","CH_GB18_A_22:D3","CH_GB18_A_22:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:CGD-04","text":"The critique of Newton's apparatus of proof is preserved not as a historical subsidiary claim, but as the methodological limit of every mathematics that presupposes its laws instead of conceptually generating them.","refs":["CH_GB18_A_22:A16","CH_GB18_A_22:D8","CH_GB18_A_22:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_29:GNX-01","text":"The cluster rejects linear causalism, according to which an external quantum transmits its quantitative form unchanged into a particular object.","refs":["CH_GB18_A_21:NX1","CH_GB18_A_21:DNX1","CH_GB18_A_21:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GNX-02","text":"It likewise rejects a mathematics of neutral relations in which numerator and denominator, power and root, or space and time would be interchangeable without qualitative functional difference.","refs":["CH_GB18_CVLB:A14","CH_GB18_CVLB:SNX4","CH_GB18_A_22:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:GNX-03","text":"It excludes the inference that empirical agreement or analytical complexity could already replace conceptual necessity.","refs":["CH_GB18_A_22:A14","CH_GB18_A_22:NX7","CH_GB18_A_22:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_29:DBN-01","text":"Inadmissible is a model of finished magnitudes whose properties exist before their relation and whose relation is only subsequently added.","refs":["CH_GB18_A_21:DNX5","CH_GB18_CVLB:DNX2","CH_GB18_A_22:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:DBN-02","text":"Inadmissible is a concept of change that knows only succession, exchange, or scaling and therefore misses the qualitative transformation of quantum.","refs":["CH_GB18_A_21:SD3","CH_GB18_CVLB:NX5","CH_GB18_CVLB:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:DBN-03","text":"Inadmissible is a form of science that confuses mathematical universality with conceptual generation and renders its presuppositions invisible in proof.","refs":["CH_GB18_CVLB:DNX5","CH_GB18_A_22:A16","CH_GB18_A_22:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_29:BSA-01","text":"The cluster organizes itself around the impossibility of a pure quantity that would be fully determinate without already containing qualitative specification.","refs":["CH_GB18_A_21:SNX3","CH_GB18_CVLB:SNX1","CH_GB18_A_22:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:BSA-02","text":"It circles the unavailable possibility of a fully executed conceptual derivation of concrete power exponents from the qualities of the related moments.","refs":["CH_GB18_A_22:SNX3","CH_GB18_A_22:MRT2","CH_GB18_A_22:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:BSA-03","text":"It refuses a conclusive external perspective upon measure, because every relation of measurement is itself embedded in what is measured as a specific, asymmetric, and changeable determination.","refs":["CH_GB18_A_21:SNX1","CH_GB18_CVLB:A8","CH_GB18_CVLB:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_29:XD-01","text":"The temperature relation provides the concrete proof that the general theory of realized measure does not remain an abstract formula: a common quantum becomes different determinations of measure only through differential qualitative reception.","refs":["CL_GB18_29:GA-01","CL_GB18_29:GA-02","CL_GB18_29:GA-03","CH_GB18_A_21:D1","CH_GB18_CVLB:D3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_29:XD-02","text":"The laws of space and time radicalize the analysis of temperature by determining the difference of specific quanta not merely as a difference in reception, but as a necessary distribution of the roles of number and unity.","refs":["CL_GB18_29:GA-03","CL_GB18_29:GA-05","CH_GB18_A_21:A11","CH_GB18_CVLB:A15","CH_GB18_A_22:D1"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_29:XD-03","text":"The hierarchy of direct, quadratic, and higher power relations becomes operative only through the connection of the general logic of measure with types of motion: power exponents classify degrees of conceptual freedom.","refs":["CL_GB18_29:GA-05","CL_GB18_29:GA-06","CH_GB18_CVLB:SD3","CH_GB18_A_22:D2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_29:XD-04","text":"The local critique of fixed temperature proportionality and the critique of mathematical pseudo-proofs converge in a common negation: no quantitative law may conceal its qualitative conditionedness.","refs":["CL_GB18_29:GA-04","CL_GB18_29:GA-07","CH_GB18_A_21:NX3","CH_GB18_A_22:NX7"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_29:BSD-01","text":"Reality appears as a field of reciprocal specification in which external effect obtains efficacy only through immanent form of measure, and the inner is determined only in an external relation.","refs":["CH_GB18_A_21:SD2","CH_GB18_CVLB:A6","CH_GB18_A_22:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:BSD-02","text":"Time is determined not as neutral succession, but as negative unity, through which extensive externality is transferred into a directed and asymmetric relation of measure.","refs":["CH_GB18_CVLB:A14","CH_GB18_A_22:A4","CH_GB18_A_22:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:BSD-03","text":"Agency or freedom is not subjective arbitrariness, but the degree to which a relation realizes its moments as conceptually determined sides of measure.","refs":["CH_GB18_A_22:A6","CH_GB18_A_22:D2","CH_GB18_A_22:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:BSD-04","text":"Scientific cognition is reorganized as examination of the origin of exponents, relations, and formulas, and no longer as mere expansion of empirical scope or computational power.","refs":["CH_GB18_CVLB:ME5","CH_GB18_A_22:A15","CH_GB18_A_22:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_29:RLE-01","text":"The central loop is: external quantum → specific reception → change of specific shape → return of quantum as qualitatively determined measure.","refs":["CH_GB18_A_21:FGS2","CH_GB18_A_21:FGS4","CH_GB18_A_21:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RLE-02","text":"The attractor of the cluster is the sublated quantum: it may neither disappear nor remain as an independent externality, but must be simultaneously preserved and recoded.","refs":["CH_GB18_CVLB:A2","CH_GB18_CVLB:A8","CH_GB18_CVLB:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RLE-03","text":"The escalation proceeds from the empirically observable deviation in temperature reception through the general difference of extensive and intensive sides to the ontological classification of motion.","refs":["CH_GB18_A_21:A7","CH_GB18_CVLB:A14","CH_GB18_A_22:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:RLE-04","text":"The critique of the direct relation marks not a break, but a recursive threshold at which a necessary abstraction passes into its conceptually richer power forms.","refs":["CH_GB18_CVLB:A17","CH_GB18_CVLB:MRT6","CH_GB18_CVLB:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_29:FGS-B01","text":"An external quantum is posited as a provisionally independent magnitude so that its inadequacy as mere externality can become visible.","refs":["CH_GB18_A_21:FGS1","CH_GB18_CVLB:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:FGS-B02","text":"A qualitative side does not receive the quantum passively, but specifies it according to its immanent measure and thereby produces differential quantitative appearances.","refs":["CH_GB18_A_21:FGS2","CH_GB18_CVLB:FGS3","CH_GB18_CVLB:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:FGS-B03","text":"Specification transforms change from a mere sequence of magnitudes into a change of quantum as such, and thus into qualitative formation of shape.","refs":["CH_GB18_A_21:FGS5","CH_GB18_CVLB:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:FGS-B04","text":"The qualitative sides are formalized as asymmetric functions of externality and unity, whereby number, root, power, and exponent receive ontological roles.","refs":["CH_GB18_CVLB:FGS5","CH_GB18_CVLB:A15","CH_GB18_CVLB:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:FGS-B05","text":"A law possesses conceptual validity only if its quantitative form is produced from this qualitative asymmetry and is not presupposed from observation or use of formulae.","refs":["CH_GB18_A_22:FGS5","CH_GB18_A_22:FGS6","CH_GB18_A_22:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_29:AFM-B01","text":"Apparently uniform external effect is posited as a problem because it does not explain the differential reception of particular bodies.","refs":["CH_GB18_A_21:AS2","CH_GB18_A_21:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AFM-B02","text":"Differential reception compels the reification of immanent determination of measure and destroys the idea of direct proportionality.","refs":["CH_GB18_A_21:D1","CH_GB18_A_21:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AFM-B03","text":"The relation is reconstructed as the unity of two specific quanta, whose difference is neither external nor symmetrical.","refs":["CH_GB18_A_21:FGS6","CH_GB18_CVLB:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AFM-B04","text":"The asymmetry is translated into extensive externality and intensive unity and made formalizable as a graduated power structure.","refs":["CH_GB18_CVLB:A14","CH_GB18_CVLB:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AFM-B05","text":"The power structure is transferred to space, time, and types of motion, so that forms of law appear as degrees of conceptually determined freedom.","refs":["CH_GB18_A_22:FGS2","CH_GB18_A_22:FGS3","CH_GB18_A_22:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:AFM-B06","text":"Scientific closure separates empirical confirmation and mathematical representation from the conceptual generation of the form of law.","refs":["CH_GB18_A_22:SD1","CH_GB18_A_22:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_29:MME-01","text":"Quantity is remapped from a neutral scale into a doubly coded reality: it is externally comparable and at the same time the bearer of specific qualitative determination.","refs":["CH_GB18_CVLB:A5","CH_GB18_CVLB:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MME-02","text":"The difference between universal and particular is reordered: the universal medium does not exist prior to its specific receptions, but is concretely determined through them.","refs":["CH_GB18_A_21:SD2","CH_GB18_A_21:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MME-03","text":"Mathematics is reclassified from a universal apparatus of proof into a hierarchically examinable language of measures.","refs":["CH_GB18_CVLB:SD5","CH_GB18_A_22:A12","CH_GB18_A_22:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MME-04","text":"Natural lawfulness is displaced from the order of observed regularities to the conceptually grounded architectonics of qualitative relations.","refs":["CH_GB18_A_22:D5","CH_GB18_A_22:SD2","CH_GB18_A_22:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_29:ALT-B01","text":"Surface level — Temperature, heat capacity, velocity, fall, and celestial motion function as concrete fields in which quantitative relations disclose their qualitative conditionedness.","refs":["CH_GB18_A_21:ALT1","CH_GB18_A_22:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:ALT-B02","text":"Structural level — Measure organizes external effect, immanent reception, qualitative asymmetry, power form, and law formation as a single architecture of mediation.","refs":["CH_GB18_A_21:ALT2","CH_GB18_CVLB:ALT2","CH_GB18_A_22:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:ALT-B03","text":"Metastrategic level — The cluster replaces the question of formal calculability with the question whether a formula discloses the qualitative origin of its quantitative determinations.","refs":["CH_GB18_A_21:ALT3","CH_GB18_CVLB:ALT3","CH_GB18_A_22:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:ALT-B04","text":"Ontological / Temporal level — Reality is changeable self-specification; space and time do not constitute independent variables, but asymmetric moments of a process of measure.","refs":["CH_GB18_A_21:ALT4","CH_GB18_CVLB:ALT4","CH_GB18_A_22:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:ALT-B05","text":"Methodological / Performative level — The form of argument performs its thesis by treating every apparently sufficient formula as a transitional stage and reclaiming its presuppositions in the concept of relation.","refs":["CH_GB18_CVLB:MRT6","CH_GB18_A_22:FGS6","CH_GB18_A_22:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_29:FL-01","text":"The architecture requires the external quantum as a presupposition, but cannot grant it lasting independence; its unity arises from this tension that can never be fully immobilized.","refs":["CH_GB18_CVLB:A3","CH_GB18_CVLB:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:FL-02","text":"The conceptual priority of higher powers remains asserted without the concrete generation of their exponents from qualitative difference being fully carried out.","refs":["CH_GB18_CVLB:MRT3","CH_GB18_A_22:SNX3","CH_GB18_A_22:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MP-01","text":"Quantum mutates from external medium through specific quantum into a sublated moment of a qualitative relation of measure.","refs":["CH_GB18_A_21:A2","CH_GB18_A_21:FGS6","CH_GB18_CVLB:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MP-02","text":"The mathematical relation mutates from direct proportionality through graduated power form to the demand for conceptual grounding of law.","refs":["CH_GB18_A_21:NX3","CH_GB18_CVLB:FGS6","CH_GB18_A_22:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MP-03","text":"Freedom mutates from a designation for different types of motion into a criterion for the degree to which a relation of measure realizes its qualitative truth.","refs":["CH_GB18_A_22:A6","CH_GB18_A_22:D2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_29:HSI-01","text":"Reality appears as a machine of specification in which every external quantum obtains concrete efficacy only through the inner forms of measure of its relata.","refs":["CH_GB18_A_21:SD2","CH_GB18_A_21:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:HSI-02","text":"The subject is modeled not as an autonomous observer, but as immanent unity or negativity that transfers externality into a determinate relation.","refs":["CH_GB18_CVLB:A14","CH_GB18_A_22:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:HSI-03","text":"Time is the negative condition through which quantitative extension does not remain indifferent, but passes into directed change and measure formation.","refs":["CH_GB18_CVLB:A13","CH_GB18_A_22:A4","CH_GB18_A_22:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:HSI-04","text":"Cognition is navigation within a graduated field of appearance, formula, and concept, whose valid passage is possible only through the reduction of quantitative forms to qualitative relations.","refs":["CH_GB18_A_22:SD1","CH_GB18_A_22:SD3","CH_GB18_A_22:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_29:MRT-B01","text":"The extracted axioms suffice to reconstruct the cluster movement from external quantity through specification and asymmetric relation to the conceptual demand for law.","refs":["CH_GB18_A_21:MRT1","CH_GB18_CVLB:MRT1","CH_GB18_A_22:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MRT-B02","text":"The reconstruction is coherent provided that externality is read not as a refuted fiction, but as a necessary and at once sublated initial condition.","refs":["CH_GB18_A_21:MRT3","CH_GB18_CVLB:MRT5","CH_GB18_A_22:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MRT-B03","text":"What remains underdetermined is the concrete bridge between qualitative difference and determinate power exponents; precisely this gap limits the scope of the claimed conceptual derivation.","refs":["CH_GB18_CVLB:MRT3","CH_GB18_A_22:MRT2","CH_GB18_A_22:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_29:MRT-B04","text":"The strongest and indispensable architectural achievement lies in the recursive transformation of the quantitative: it is neither eliminated nor rendered independent, but preserved as the bearer of qualitative determination of measure.","refs":["CH_GB18_A_21:MRT4","CH_GB18_CVLB:SD1","CH_GB18_A_22:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_29@R001","source_variant_id":"canonical:CL_GB18_29:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 85–87","context":"Anmerkung. · c. Verhältniß beider Seiten als Qualitäten. · Anmerkung."},"title_language_code":"en"},{"id":"CL_GB18_30","layer":"CL","title":"Chapters 88–90","order":30,"parents":["CH_GB18_CDFR","CH_GB18_DVLS","CH_GB18_VZM0"],"revision":"CL_GB18_30@R001","sha256":"499fc9f09cf6e0239a44cf1f5a93b61b1691d20e86eacc6f9b125951fc117c6a","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_30:BAS-01","text":"Das System bestimmt das Maaß nicht als Eigenschaft eines fertigen Dinges, sondern als Problem der Erzeugung realer Selbstständigkeit aus Beziehungen von Quantis.","refs":["CH_GB18_DVLS:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BAS-02","text":"Seine globale These lautet, daß quantitative Verhältnisse nicht hinter, sondern in der materiellen Qualität wirksam sind und diese erst als relationale Bestimmtheit hervorbringen.","refs":["CH_GB18_DVLS:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BAS-03","text":"Das Argument rekonstruiert eine Bewegung, in der unmittelbare Quanta als Exponenten, Exponenten als Maaßmomente und Maaßmomente als Formen realen Fürsichseyns umcodiert werden.","refs":["CH_GB18_CDFR:A7","CH_GB18_DVLS:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BAS-04","text":"Die Bewegung ist weder linear noch bloß kumulativ: Sie verläuft von äußerlicher Unmittelbarkeit über Verbindung, gegenseitige Specifikation und Serienbildung zu qualitativen Knoten und negativer Selbstbeziehung.","refs":["CH_GB18_DVLS:AS4","CH_GB18_DVLS:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BAS-05","text":"Die Verbindung selbstständiger Maaße transformiert äußerliche Addition in eine Veränderung der Exponenten und damit der qualitativen Natur der verbundenen Etwas.","refs":["CH_GB18_VZM0:AS4","CH_GB18_VZM0:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BAS-06","text":"Die Schließung des Systems besteht nicht in einer stabilen Identität, sondern in der Unendlichkeit des Maaßes, worin Ausschließung als negative Beziehung des Selbstständigen auf sich selbst zurückkehrt.","refs":["CH_GB18_DVLS:A15","CH_GB18_DVLS:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_30:GA-01","text":"[Persistent] Das Maaß ist kein Quantum neben Qualität, sondern das Verhältnis, in dem quantitative Seiten die Qualität realer Etwas bestimmen.","refs":["CH_GB18_DVLS:A1","CH_GB18_VZM0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-02","text":"[Mutating] Das Quantum bleibt unmittelbar und äußerlich, wird aber als Exponent zum inneren Bestimmtheitsmoment eines Maaßverhältnisses.","refs":["CH_GB18_CDFR:A7","CH_GB18_VZM0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-03","text":"[Persistent] Qualität besitzt keinen isolierten Träger; sie ist die durch quantitative Beziehung erzeugte Bestimmtheit materieller Selbstständigkeit.","refs":["CH_GB18_DVLS:A2","CH_GB18_DVLS:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-04","text":"[Mutating] Selbstständigkeit entsteht zunächst als negative Einheit eines Maaßganzen und erweitert sich dann zur relationalen Selbstbestimmung gegenüber anderen Maaßen.","refs":["CH_GB18_CDFR:A11","CH_GB18_DVLS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-05","text":"[Emergent] Verbindung ist keine Addition fertiger Größen, sondern gegenseitige Specifikation, in der der äußerliche Quantumszusatz die Maaßbestimmungen verändert.","refs":["CH_GB18_VZM0:A11","CH_GB18_VZM0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-06","text":"[Attractor] Negative Einheit ist die operative Form, in der Unmittelbarkeit und immanente Specifikation weder getrennt bleiben noch unmittelbar zusammenfallen.","refs":["CH_GB18_CDFR:A10","CH_GB18_CDFR:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-07","text":"[Emergent] Quantitative Kontinuität erzeugt keine homogene Reihe, sondern eine Knotenstruktur, in der spezifische Selbstständigkeiten qualitativ hervortreten.","refs":["CH_GB18_DVLS:A12","CH_GB18_DVLS:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-08","text":"[Terminal] Maaßlosigkeit ist nicht der Abbruch des Maaßes, sondern dessen Umschlag in die Unendlichkeit negativer Selbstbeziehung.","refs":["CH_GB18_DVLS:D7","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-09","text":"[Attractor] Das Andere eines Maaßes ist niemals bloß äußerlich, weil es als anderes Maaß die eigene qualitative Bestimmtheit mitproduziert.","refs":["CH_GB18_DVLS:A8","CH_GB18_VZM0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-10","text":"[Terminal] Materialität erscheint als Bestand maaßbestimmter Selbstständigkeiten und nicht als von Verhältnissen unabhängiger Grundstoff.","refs":["CH_GB18_CDFR:ME5","CH_GB18_DVLS:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_30:RMD-01","text":"Das specifische Maaß kehrt als stabile Identität wieder, verschiebt sich jedoch vom Potenzenverhältniß der Seiten zur relationalen Bestimmung materieller Dinge.","refs":["CH_GB18_CDFR:A1","CH_GB18_DVLS:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-02","text":"Das direkte Verhältniß mutiert von einem äußerlich-unmittelbaren Quotienten zu einem untergeordneten Moment, dessen Wahrheit erst im specifischen und relationalen Maaß liegt.","refs":["CH_GB18_CDFR:NX5","CH_GB18_CDFR:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-03","text":"Der Exponent behält seine quantitative Form, verändert aber seine Funktion: Er wird von einem empirischen Koefficienten zum Ort qualitativer Specifikation.","refs":["CH_GB18_CDFR:A7","CH_GB18_VZM0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-04","text":"Das selbstständige Etwas mutiert von der negativen Einheit eines einzelnen Maaßganzen zum Knoten einer Reihe wechselseitig bestimmender Maaße.","refs":["CH_GB18_CDFR:A12","CH_GB18_DVLS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-05","text":"Selbsterhaltung kehrt nicht als Beharrung wieder, sondern als Umkehrung: Das Maaß erhält sich nur durch die Veränderung seiner eigenen Bestimmtheit.","refs":["CH_GB18_VZM0:A10","CH_GB18_VZM0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-06","text":"Die quantitative Reihe wird in eine Knotenlinie absorbiert; Kontinuität bleibt als Träger erhalten, erhält aber ihre Wahrheit erst in qualitativen Unterbrechungen.","refs":["CH_GB18_DVLS:A12","CH_GB18_DVLS:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-07","text":"Unendlichkeit erscheint nicht als Addition weiterer Maaße, sondern als terminale Transformation der Reihe in negative Selbstbeziehung.","refs":["CH_GB18_DVLS:A13","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_30:CGD-01","text":"Die konkrete Bestimmung des empirischen Koefficienten bleibt lokal, während seine Herabstufung vom Erklärungsgrund zum begrenzten Maaßmoment auf die Clusterebene skaliert.","refs":["CH_GB18_CDFR:SD4","CH_GB18_CDFR:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:CGD-02","text":"Die asymmetrische Verbindung von Gewicht und Volumen bleibt als Fallstruktur lokal, skaliert jedoch als allgemeine Regel, daß quantitative Seiten eines Maaßes nicht gleichartig additiv behandelt werden können.","refs":["CH_GB18_VZM0:D4","CH_GB18_VZM0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:CGD-03","text":"Die Verbindung zweier Maaße bildet die lokale Ausgangsform, deren höherstufige Konsequenz die Serie von Beziehungen und Maaßen ist.","refs":["CH_GB18_VZM0:AS1","CH_GB18_VZM0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:CGD-04","text":"Die relationale Erzeugung qualitativer Identität ist keine lokale Konsequenz einzelner Verbindungen, sondern die globale Bestimmung des Etwas im gesamten System.","refs":["CH_GB18_DVLS:D3","CH_GB18_VZM0:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:CGD-05","text":"Die negative Einheit und ihre Repulsion überschreiten die lokale Analyse eines Maaßganzen, weil sie die allgemeine Form relationaler Selbstständigkeit begründen.","refs":["CH_GB18_CDFR:A10","CH_GB18_CDFR:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:CGD-06","text":"Knotenlinie, Maaßlosigkeit und Unendlichkeit bilden die übergeordnete Architektur, in der unmittelbare Maaßverbindungen ihre bloß lokale Geltung verlieren.","refs":["CH_GB18_DVLS:D6","CH_GB18_DVLS:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_30:GNX-01","text":"Zurückgewiesen wird ein arithmetisches Modell, das specifische Maaßbestimmung als bloß äußerliches Fortschreiten von Quantitäten behandelt.","refs":["CH_GB18_CDFR:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GNX-02","text":"Zurückgewiesen wird eine Qualität, die vor ihrer Beziehung auf andere Qualität, Größe und Maaßverhältnisse schon vollständig bestimmt wäre.","refs":["CH_GB18_CDFR:NX2","CH_GB18_DVLS:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GNX-03","text":"Zurückgewiesen wird ein äußerliches Verhältniß, das die qualitative Bestimmtheit seiner Seiten unberührt ließe.","refs":["CH_GB18_DVLS:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GNX-04","text":"Zurückgewiesen wird eine symmetrische Additivität, in der sämtliche quantitativen Seiten verbundener Dinge gleichermaßen summierbar wären.","refs":["CH_GB18_VZM0:NX1","CH_GB18_VZM0:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GNX-05","text":"Zurückgewiesen wird ein homogener quantitativer Fortgang ohne qualitative Knoten, Sprünge und Ausschließungen.","refs":["CH_GB18_DVLS:NX5","CH_GB18_DVLS:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GNX-06","text":"Zurückgewiesen wird ein Raum, der als selbständiger Behälter die Bestimmungen materieller Dinge unverändert bewahrte.","refs":["CH_GB18_VZM0:NX7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_30:DBN-01","text":"Ausgeschlossen ist ein nichtrelationaler Grund der Dinge, denn jedes Maaß erhält seine Bestimmtheit nur durch andere Maaßverhältnisse.","refs":["CH_GB18_DVLS:SNX1","CH_GB18_VZM0:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:DBN-02","text":"Ausgeschlossen ist die vollständige Ableitung empirischer Größen aus qualitativer Specifikation, weil der Koefficient als notwendiges, aber begrifflich nicht vollständig verfügbares Moment verbleibt.","refs":["CH_GB18_CDFR:SNX3","CH_GB18_CDFR:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:DBN-03","text":"Ausgeschlossen ist eine Selbsterhaltung ohne innere Negation, Vermittlung und qualitative Veränderung.","refs":["CH_GB18_VZM0:DNX4","CH_GB18_CDFR:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:DBN-04","text":"Ausgeschlossen ist ein positiver Endpunkt der Maaßreihe, an dem Selbstständigkeit ohne Ausschließung und negative Rückbeziehung bestünde.","refs":["CH_GB18_DVLS:SNX3","CH_GB18_DVLS:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_30:BSA-01","text":"Unverfügbar bleibt eine schlechthin erste Unmittelbarkeit, die nicht bereits als Moment eines Maaßverhältnisses und seiner Negation bestimmt wäre.","refs":["CH_GB18_CDFR:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BSA-02","text":"Unmöglich bleibt ein finales Fürsichseyn, das seine eigene Selbstentzweiung, Veränderbarkeit und Beziehung auf Anderes nicht mehr enthielte.","refs":["CH_GB18_CDFR:SNX2","CH_GB18_VZM0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BSA-03","text":"Versperrt bleibt eine Wirklichkeit, deren innere Bestimmung und äußere Veränderung vollständig getrennt, äußerlich und folgenlos zueinander wären.","refs":["CH_GB18_DVLS:SNX2","CH_GB18_VZM0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_30:XD-01","text":"Die Verbindung zweier Maaße zeigt, daß äußerliche Addition nur als Ausgangspunkt fungiert: Indem der Zusatz selbst als Exponent eines Maaßes bestimmt ist, wird Addition zur Veränderung der Maaßform. ; Trace Type — Composite","refs":["CL_GB18_30:GA-02","CL_GB18_30:GA-05","CH_GB18_VZM0:A11","CH_GB18_VZM0:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:XD-02","text":"Der empirische Koefficient besitzt Erklärungskraft nur als begrenzter Exponent innerhalb einer relational erzeugten Qualität; isoliert kann er die qualitative Natur weder begründen noch erschöpfen. ; Trace Type — Composite","refs":["CL_GB18_30:GA-02","CL_GB18_30:GA-03","CH_GB18_CDFR:NX3","CH_GB18_DVLS:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:XD-03","text":"Die Repulsion des Maaßganzen erzeugt keine bloße Vielheit, sondern die Bedingung dafür, daß Selbstständigkeit durch Beziehungen auf viele andere Maaße specifisch wird. ; Trace Type — Composite","refs":["CL_GB18_30:GA-04","CL_GB18_30:GA-09","CH_GB18_CDFR:A12","CH_GB18_DVLS:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:XD-04","text":"Die Knotenlinie ist die Form, in der die Veränderung einzelner Exponenten und die Serienbildung vieler Maaße als derselbe Übergang von quantitativer Variation zu qualitativer Neubestimmung sichtbar werden. ; Trace Type — Composite","refs":["CL_GB18_30:GA-05","CL_GB18_30:GA-07","CH_GB18_VZM0:AS6","CH_GB18_DVLS:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:XD-05","text":"Maaßlosigkeit bezeichnet nicht das Verschwinden des Maaßes, sondern die Konsequenz seiner negativen Einheit, wenn die Reihe der Ausschließungen in Selbstbeziehung umschlägt. ; Trace Type — Tension","refs":["CL_GB18_30:GA-06","CL_GB18_30:GA-08","CH_GB18_CDFR:SD2","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_30:BSD-01","text":"Materie wird ontologisch als zeitweilige Stabilisierung relationaler Maaßbestimmungen bestimmt; sie ist kein vorausliegender Träger, sondern eine Form des Bestehens im Verhältnis.","refs":["CL_GB18_30:GA-01","CL_GB18_30:GA-03","CL_GB18_30:GA-10","CH_GB18_CDFR:ME5","CH_GB18_DVLS:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:BSD-02","text":"Kausalität wird als rekursive Umformung lesbar: Dasjenige, was einem Maaß äußerlich begegnet, wird durch seine negative Reaktion zum Moment seiner eigenen inneren Bestimmung.","refs":["CL_GB18_30:GA-05","CL_GB18_30:GA-06","CH_GB18_VZM0:A10","CH_GB18_VZM0:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:BSD-03","text":"Empirische Zahlen verlieren den Status eines letzten Grundes und erhalten den Status von Indexen einer Maaßstruktur, deren qualitative Notwendigkeit sie anzeigen, aber nicht vollständig ableiten.","refs":["CL_GB18_30:GA-02","CL_GB18_30:GA-03","CH_GB18_CDFR:SD4","CH_GB18_CDFR:ME2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:BSD-04","text":"Zeitliche Entwicklung wird nicht als gleichförmige Fortschreibung bestimmt, sondern als Verhältnis von Kontinuität, Schwelle, Umschlag und rückwirkender Neubestimmung.","refs":["CL_GB18_30:GA-05","CL_GB18_30:GA-07","CL_GB18_30:GA-08","CH_GB18_DVLS:SD3","CH_GB18_VZM0:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:BSD-05","text":"Das System schließt nicht durch einen positiven Endzustand, sondern dadurch, daß jede Selbstständigkeit ihre Wahrheit in der negativen Beziehung auf sich und auf anderes zurückfindet.","refs":["CL_GB18_30:GA-04","CL_GB18_30:GA-06","CL_GB18_30:GA-08","CH_GB18_DVLS:SD4","CH_GB18_VZM0:SNX4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_30:RLE-01","text":"Quantum → Exponent → negative Reaktion des Maaßes → Veränderung des Exponenten → erneuerte qualitative Bestimmtheit bildet die elementare rekursive Schleife.","refs":["CH_GB18_CDFR:A7","CH_GB18_VZM0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RLE-02","text":"Selbstständigkeit → Repulsion → Beziehung auf viele Andere → specifische Bestimmung → erneuerte Selbstständigkeit bildet die Schleife relationaler Individualisierung.","refs":["CH_GB18_CDFR:A12","CH_GB18_DVLS:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RLE-03","text":"Selbsterhaltung → Negation äußerlicher Veränderung → qualitative Veränderung → fortgesetzte Selbsterhaltung bildet die Umkehrung, in der Identität nur als Selbstmodifikation fortbesteht.","refs":["CH_GB18_VZM0:A10","CH_GB18_VZM0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RLE-04","text":"Quantitative Reihe → qualitative Unterbrechung → Knotenlinie → Maaßlosigkeit → negative Selbstbeziehung bildet den Eskalationspfad des Maaßes.","refs":["CH_GB18_DVLS:A12","CH_GB18_DVLS:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RLE-05","text":"Negative Einheit fungiert als begrifflicher Attraktor, weil direkte Verhältnisse, empirische Exponenten, Verbindungen und Reihen nur durch ihre Einordnung in vermittelte Selbstbeziehung ihre Wahrheit erhalten.","refs":["CH_GB18_CDFR:A10","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_30:FGS-B01","text":"Das Schema setzt das Etwas als Maaßverhältniß: qualitative Bestimmtheit ist die Form, in der Quanta nicht bloß vorhanden, sondern wechselseitig wirksam sind.","refs":["CH_GB18_VZM0:A1","CH_GB18_VZM0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FGS-B02","text":"Unmittelbares Quantum → Exponent → begrenztes Fürsichseynsmoment: Das Äußerliche wird nicht gelöscht, sondern in die Maaßform aufgenommen.","refs":["CH_GB18_CDFR:A7","CH_GB18_CDFR:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FGS-B03","text":"Äußere Verbindung zweier Maaße → negative Selbsterhaltung → Veränderung der Exponenten → Veränderung der qualitativen Natur.","refs":["CH_GB18_VZM0:A10","CH_GB18_VZM0:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FGS-B04","text":"Beziehung auf viele Andere → Serie direkter Verhältnisse → ausschließende Maaße → Wahlverwandschaft spezifischer Selbstständigkeiten.","refs":["CH_GB18_DVLS:A8","CH_GB18_DVLS:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FGS-B05","text":"Quantitative Variation → qualitative Knoten → Maaßlosigkeit: Die Reihe produziert ihre eigene Unterbrechung als immanente Form.","refs":["CH_GB18_DVLS:D6","CH_GB18_DVLS:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FGS-B06","text":"Maaßlosigkeit → Einheit der Ausschließenden → negative Selbstbeziehung: Das Maaß schließt sich nur als Selbstentzweiung.","refs":["CH_GB18_DVLS:D8","CH_GB18_CDFR:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_30:AFM-B01","text":"Unmittelbares Quantum → Exponent → specifisches Maaß → negative Einheit → reales Fürsichseyn.","refs":["CH_GB18_CDFR:A7","CH_GB18_CDFR:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:AFM-B02","text":"Getrennte Maaße → Verbindung → asymmetrische Addition → Veränderung der Exponenten → veränderte qualitative Natur.","refs":["CH_GB18_VZM0:AS1","CH_GB18_VZM0:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:AFM-B03","text":"Selbstständiges Maaß → Beziehung auf viele Andere → Reihe von Maaßen → ausschließende Wahlverwandschaft.","refs":["CH_GB18_DVLS:A7","CH_GB18_DVLS:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:AFM-B04","text":"Quantitative Reihe → qualitative Unterbrechung → Knotenlinie → Maaßlosigkeit → Unendlichkeit des Maaßes.","refs":["CH_GB18_DVLS:D6","CH_GB18_DVLS:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:AFM-B05","text":"Unendlichkeit des Maaßes → Einheit der Ausschließenden → negative Beziehung des Selbstständigen auf sich selbst.","refs":["CH_GB18_DVLS:A14","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_30:MME-01","text":"Qualität und Quantum werden von getrennten Sphären zu gegensätzlichen, aber untrennbaren Momenten eines Maaßprozesses umkartiert.","refs":["CH_GB18_CDFR:ME1","CH_GB18_VZM0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MME-02","text":"Das Ding erscheint nicht als Träger fertiger Eigenschaften, sondern als Knotenpunkt einer Serie von Beziehungen zwischen Maaßen.","refs":["CH_GB18_DVLS:ME2","CH_GB18_DVLS:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MME-03","text":"Materialität und Raum werden asymmetrisch neu bestimmt: Die materielle Menge besitzt additive Stabilität, während die ideelle Seite die innere Veränderlichkeit des Maaßes sichtbar macht.","refs":["CH_GB18_VZM0:D4","CH_GB18_VZM0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MME-04","text":"Der empirische Koefficient wird von einem vermeintlichen Erklärungsgrund zu einem indexikalischen Moment innerhalb einer übergeordneten Maaßarchitektur umklassifiziert.","refs":["CH_GB18_CDFR:ME2","CH_GB18_CDFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MME-05","text":"Unendlichkeit wird von äußerlicher Endlosigkeit zu der negativen Selbstbeziehung, die die Ausschließung von Maaßen immanent vollendet.","refs":["CH_GB18_DVLS:ME5","CH_GB18_DVLS:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_30:ALT-B01","text":"Auf der Oberflächenebene behandelt das System Fallbewegung, Gewicht, Volumen, Verbindung und quantitative Veränderung als Fälle eines problematischen Maaßverhältnisses.","refs":["CH_GB18_VZM0:AS5","CH_GB18_VZM0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:ALT-B02","text":"Auf der Strukturebene vermittelt das Maaß immanente Specifikation, äußerliche Quantität, negative Selbsterhaltung, Serienbildung und qualitative Knoten.","refs":["CH_GB18_CDFR:ALT2","CH_GB18_DVLS:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:ALT-B03","text":"Auf der metastrategischen Ebene wird Erklärung von der Suche nach isolierten Gründen auf die Rekonstruktion der Verhältnisse und der Verhältnisse dieser Verhältnisse verschoben.","refs":["CH_GB18_DVLS:ALT3","CH_GB18_CDFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:ALT-B04","text":"Auf der ontologischen und temporalen Ebene besitzt das Seiende keine ruhende Selbstidentität, weil es sich nur durch negative Selbstbeziehung, Veränderung und Repulsion erhält.","refs":["CH_GB18_DVLS:A15","CH_GB18_VZM0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:ALT-B05","text":"Auf der methodologischen und performativen Ebene vollzieht die Darstellung selbst die behauptete Bewegung, indem sie von unmittelbarer Quantität zu ihrer immanenten Negation und relationalen Neubestimmung übergeht.","refs":["CH_GB18_VZM0:AS7","CH_GB18_VZM0:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_30:FL-01","text":"Äußerliche Unmittelbarkeit muß als Moment des Maaßes erhalten bleiben, darf aber nicht als selbstständiger Grund seiner qualitativen Wahrheit gelten.","refs":["CH_GB18_CDFR:A4","CH_GB18_CDFR:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FL-02","text":"Selbstständige Dinge werden zunächst als getrennt vorausgesetzt, erhalten ihre spezifische Qualität jedoch erst durch Verhältnisse, die ihre vorausgesetzte Selbstständigkeit destabilisieren.","refs":["CH_GB18_DVLS:A5","CH_GB18_DVLS:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FL-03","text":"Selbsterhaltung und Veränderung sind zugleich notwendig und gegenläufig: Das Maaß bleibt nur dasselbe, indem es seine qualitative Bestimmtheit verändert.","refs":["CH_GB18_VZM0:D3","CH_GB18_VZM0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FL-04","text":"Die Maaßreihe muß zugleich quantitativ kontinuierlich und qualitativ diskontinuierlich sein; ihre Einheit wird nur als Knotenstruktur behauptet.","refs":["CH_GB18_DVLS:SD3","CH_GB18_DVLS:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MP-01","text":"Der Exponent ist ein Mutationspunkt, weil er von einem unmittelbaren Quantum zu einem qualitativen Bestimmtheitsmoment des Maaßes übergeht.","refs":["CH_GB18_CDFR:A7","CH_GB18_VZM0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MP-02","text":"Das direkte Verhältniß ist ein Mutationspunkt, weil es zunächst als unmittelbare Verhältnisform erscheint und dann dem specifischen Maaß untergeordnet wird.","refs":["CH_GB18_CDFR:NX5","CH_GB18_CDFR:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MP-03","text":"Das Andere ist ein Mutationspunkt, weil es sich von einem äußerlich gegenüberstehenden Quantum zu einem selbst exponentiell bestimmten Maaßverhältniß wandelt.","refs":["CH_GB18_VZM0:A9","CH_GB18_VZM0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MP-04","text":"Maaßlosigkeit ist ein Mutationspunkt, weil sie nicht das Ende der Maaßbestimmung, sondern deren Umschlag in negative Unendlichkeit markiert.","refs":["CH_GB18_DVLS:A13","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_30:HSI-01","text":"Die Realität erscheint als verteilte Maschine von Maaßverhältnissen, in der Quantitäten nur als gegenseitig wirksame Exponenten reale Bedeutung erlangen.","refs":["CH_GB18_DVLS:A1","CH_GB18_DVLS:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:HSI-02","text":"Das Etwas erscheint als temporärer Knoten negativer Einheit, der sich nur erhält, indem er sich gegen Anderes bestimmt, repulsirt und verändert.","refs":["CH_GB18_CDFR:A12","CH_GB18_DVLS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:HSI-03","text":"Zeit erscheint als Knotenzeit: Quantitative Fortsetzung wird erst durch qualitative Schwellen, Umschläge und negative Rückbeziehung geschichtlich wirksam.","refs":["CH_GB18_DVLS:D6","CH_GB18_DVLS:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:HSI-04","text":"Intervention bleibt nur innerhalb der Verhältnisse möglich, weil jede äußerliche Veränderung bereits als mögliche Umformung der Maaßbestimmung fungiert.","refs":["CH_GB18_VZM0:A10","CH_GB18_VZM0:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_30:MRT-B01","text":"Die globalen Axiome reichen aus, um den Übergang vom unmittelbaren Quantum über Exponent, negative Einheit und Verbindung zur Reihe, Knotenlinie und Unendlichkeit zu rekonstruieren.","refs":["CH_GB18_CDFR:MRT1","CH_GB18_DVLS:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MRT-B02","text":"Unterbestimmt bleiben die konkrete Herkunft empirischer Koefficienten, die stofflichen Bedingungen besonderer Verbindungen und das genaue Kriterium des Umschlags in qualitative Knoten.","refs":["CH_GB18_CDFR:MRT2","CH_GB18_VZM0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MRT-B03","text":"Die Kohärenz des Clusters hängt daran, daß Äußerlichkeit weder eliminiert noch als unabhängiger Grund anerkannt wird.","refs":["CH_GB18_CDFR:MRT3","CH_GB18_DVLS:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MRT-B04","text":"Die stärkste Architekturstelle liegt in der Umwandlung des Quantums vom empirisch-unmittelbaren Gegebenen in einen Exponenten, dessen Veränderung qualitative und materielle Folgen erzeugt.","refs":["CH_GB18_CDFR:MRT4","CH_GB18_VZM0:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MRT-B05","text":"Die Rekonstruktion bleibt auf die ungelöste Spannung angewiesen, daß das Maaß sich erhält, indem es sich verändert, und daß seine vollständige Selbstbeziehung nur als fortgesetzte Selbstentzweiung möglich ist.","refs":["CH_GB18_VZM0:MRT6","CH_GB18_CDFR:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121913138003Z_1ca03d7f","language_code":"en","language_name":"English","title":"Chapters 88–90","source_sha256":"499fc9f09cf6e0239a44cf1f5a93b61b1691d20e86eacc6f9b125951fc117c6a","sha256":"22b625892420549c918c19822a5a9128ff30bb83d0870c4862488458f6a7d075","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:19:13.139022+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_30:BAS-01","text":"The system determines Measure not as a property of a finished thing, but as the problem of the production of real self-subsistence from relations of quanta.","refs":["CH_GB18_DVLS:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BAS-02","text":"Its global thesis is that quantitative relations are effective not behind, but within material quality, and first bring this forth as relational determinacy.","refs":["CH_GB18_DVLS:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BAS-03","text":"The argument reconstructs a movement in which immediate quanta are recoded as exponents, exponents as moments of Measure, and moments of Measure as forms of real being-for-self.","refs":["CH_GB18_CDFR:A7","CH_GB18_DVLS:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BAS-04","text":"The movement is neither linear nor merely cumulative: it proceeds from external immediacy through combination, reciprocal specification, and series-formation to qualitative nodes and negative self-relation.","refs":["CH_GB18_DVLS:AS4","CH_GB18_DVLS:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BAS-05","text":"The combination of self-subsistent Measures transforms external addition into a change in the exponents and thus in the qualitative nature of the combined somethings.","refs":["CH_GB18_VZM0:AS4","CH_GB18_VZM0:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BAS-06","text":"The closure of the system consists not in a stable identity, but in the infinity of Measure, wherein exclusion returns as the negative relation of the self-subsistent to itself.","refs":["CH_GB18_DVLS:A15","CH_GB18_DVLS:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_30:GA-01","text":"[Persistent] Measure is not a quantum alongside quality, but the relation in which quantitative sides determine the quality of real somethings.","refs":["CH_GB18_DVLS:A1","CH_GB18_VZM0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-02","text":"[Mutating] Quantum remains immediate and external, but as exponent becomes the inner moment of determinacy of a Measure-relation.","refs":["CH_GB18_CDFR:A7","CH_GB18_VZM0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-03","text":"[Persistent] Quality possesses no isolated bearer; it is the determinacy of material self-subsistence produced through quantitative relation.","refs":["CH_GB18_DVLS:A2","CH_GB18_DVLS:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-04","text":"[Mutating] Self-subsistence initially arises as the negative unity of a whole of Measure and then expands into relational self-determination vis-à-vis other Measures.","refs":["CH_GB18_CDFR:A11","CH_GB18_DVLS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-05","text":"[Emergent] Combination is not the addition of finished magnitudes, but reciprocal specification, in which the external addition of quantum alters the determinations of Measure.","refs":["CH_GB18_VZM0:A11","CH_GB18_VZM0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-06","text":"[Attractor] Negative unity is the operative form in which immediacy and immanent specification neither remain separate nor immediately coincide.","refs":["CH_GB18_CDFR:A10","CH_GB18_CDFR:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-07","text":"[Emergent] Quantitative continuity produces not a homogeneous series, but a nodal structure in which specific self-subsistences emerge qualitatively.","refs":["CH_GB18_DVLS:A12","CH_GB18_DVLS:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-08","text":"[Terminal] Measurelessness is not the termination of Measure, but its transition into the infinity of negative self-relation.","refs":["CH_GB18_DVLS:D7","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-09","text":"[Attractor] The other of a Measure is never merely external, because as another Measure it co-produces its own qualitative determinacy.","refs":["CH_GB18_DVLS:A8","CH_GB18_VZM0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GA-10","text":"[Terminal] Materiality appears as a stock of Measure-determined self-subsistences and not as a basic substance independent of relations.","refs":["CH_GB18_CDFR:ME5","CH_GB18_DVLS:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_30:RMD-01","text":"Specific Measure recurs as stable identity, yet shifts from the ratio of powers of the sides to the relational determination of material things.","refs":["CH_GB18_CDFR:A1","CH_GB18_DVLS:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-02","text":"The direct ratio mutates from an externally immediate quotient into a subordinate moment whose truth lies only in specific and relational Measure.","refs":["CH_GB18_CDFR:NX5","CH_GB18_CDFR:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-03","text":"The exponent retains its quantitative form, but changes its function: it becomes from an empirical coefficient the site of qualitative specification.","refs":["CH_GB18_CDFR:A7","CH_GB18_VZM0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-04","text":"The self-subsistent something mutates from the negative unity of an individual whole of Measure into the node of a series of reciprocally determining Measures.","refs":["CH_GB18_CDFR:A12","CH_GB18_DVLS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-05","text":"Self-preservation recurs not as persistence, but as reversal: Measure preserves itself only through the alteration of its own determinacy.","refs":["CH_GB18_VZM0:A10","CH_GB18_VZM0:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-06","text":"The quantitative series is absorbed into a nodal line; continuity is retained as bearer, but receives its truth only in qualitative interruptions.","refs":["CH_GB18_DVLS:A12","CH_GB18_DVLS:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RMD-07","text":"Infinity appears not as the addition of further Measures, but as the terminal transformation of the series into negative self-relation.","refs":["CH_GB18_DVLS:A13","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_30:CGD-01","text":"The concrete determination of the empirical coefficient remains local, whereas its demotion from explanatory ground to limited moment of Measure scales to the cluster level.","refs":["CH_GB18_CDFR:SD4","CH_GB18_CDFR:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:CGD-02","text":"The asymmetric combination of weight and volume remains local as a case structure, yet scales as the general rule that the quantitative sides of a Measure cannot be treated as homogeneously additive.","refs":["CH_GB18_VZM0:D4","CH_GB18_VZM0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:CGD-03","text":"The combination of two Measures forms the local initial form, whose higher-level consequence is the series of relations and Measures.","refs":["CH_GB18_VZM0:AS1","CH_GB18_VZM0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:CGD-04","text":"The relational production of qualitative identity is not a local consequence of individual combinations, but the global determination of the something in the entire system.","refs":["CH_GB18_DVLS:D3","CH_GB18_VZM0:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:CGD-05","text":"Negative unity and its repulsion exceed the local analysis of a whole of Measure, because they ground the general form of relational self-subsistence.","refs":["CH_GB18_CDFR:A10","CH_GB18_CDFR:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:CGD-06","text":"Nodal line, measurelessness, and infinity form the higher-order architecture in which immediate Measure-combinations lose their merely local validity.","refs":["CH_GB18_DVLS:D6","CH_GB18_DVLS:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_30:GNX-01","text":"Rejected is an arithmetical model that treats specific determination of Measure as merely external progression of quantities.","refs":["CH_GB18_CDFR:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GNX-02","text":"Rejected is a quality that would already be completely determined prior to its relation to other quality, magnitude, and Measure-relations.","refs":["CH_GB18_CDFR:NX2","CH_GB18_DVLS:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GNX-03","text":"Rejected is an external ratio that would leave the qualitative determinacy of its sides untouched.","refs":["CH_GB18_DVLS:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GNX-04","text":"Rejected is a symmetrical additivity in which all quantitative sides of combined things would be equally summable.","refs":["CH_GB18_VZM0:NX1","CH_GB18_VZM0:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GNX-05","text":"Rejected is a homogeneous quantitative progression without qualitative nodes, leaps, and exclusions.","refs":["CH_GB18_DVLS:NX5","CH_GB18_DVLS:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:GNX-06","text":"Rejected is a space that, as a self-subsistent container, would preserve the determinations of material things unchanged.","refs":["CH_GB18_VZM0:NX7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_30:DBN-01","text":"Excluded is a non-relational ground of things, for every Measure receives its determinacy only through other Measure-relations.","refs":["CH_GB18_DVLS:SNX1","CH_GB18_VZM0:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:DBN-02","text":"Excluded is the complete derivation of empirical magnitudes from qualitative specification, because the coefficient remains a necessary but conceptually not fully available moment.","refs":["CH_GB18_CDFR:SNX3","CH_GB18_CDFR:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:DBN-03","text":"Excluded is self-preservation without inner negation, mediation, and qualitative alteration.","refs":["CH_GB18_VZM0:DNX4","CH_GB18_CDFR:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:DBN-04","text":"Excluded is a positive endpoint of the series of Measures at which self-subsistence would exist without exclusion and negative self-relation.","refs":["CH_GB18_DVLS:SNX3","CH_GB18_DVLS:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_30:BSA-01","text":"Unavailable remains an absolutely first immediacy that would not already be determined as a moment of a Measure-relation and its negation.","refs":["CH_GB18_CDFR:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BSA-02","text":"Impossible remains a final being-for-self that would no longer contain its own self-division, alterability, and relation to otherness.","refs":["CH_GB18_CDFR:SNX2","CH_GB18_VZM0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:BSA-03","text":"Blocked remains a reality whose inner determination and external alteration would be completely separated, external, and inconsequential to one another.","refs":["CH_GB18_DVLS:SNX2","CH_GB18_VZM0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_30:XD-01","text":"The combination of two Measures shows that external addition functions only as a starting point: insofar as the addition itself is determined as the exponent of a Measure, addition becomes alteration of the Measure-form. ; Trace Type — Composite","refs":["CL_GB18_30:GA-02","CL_GB18_30:GA-05","CH_GB18_VZM0:A11","CH_GB18_VZM0:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:XD-02","text":"The empirical coefficient possesses explanatory force only as a limited exponent within a relationally produced quality; in isolation, it can neither ground nor exhaust qualitative nature. ; Trace Type — Composite","refs":["CL_GB18_30:GA-02","CL_GB18_30:GA-03","CH_GB18_CDFR:NX3","CH_GB18_DVLS:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:XD-03","text":"The repulsion of the whole of Measure produces not a mere multiplicity, but the condition under which self-subsistence becomes specific through relations to many other Measures. ; Trace Type — Composite","refs":["CL_GB18_30:GA-04","CL_GB18_30:GA-09","CH_GB18_CDFR:A12","CH_GB18_DVLS:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:XD-04","text":"The nodal line is the form in which the alteration of individual exponents and the series-formation of many Measures become visible as the same transition from quantitative variation to qualitative redetermination. ; Trace Type — Composite","refs":["CL_GB18_30:GA-05","CL_GB18_30:GA-07","CH_GB18_VZM0:AS6","CH_GB18_DVLS:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:XD-05","text":"Measurelessness designates not the disappearance of Measure, but the consequence of its negative unity when the series of exclusions transitions into self-relation. ; Trace Type — Tension","refs":["CL_GB18_30:GA-06","CL_GB18_30:GA-08","CH_GB18_CDFR:SD2","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_30:BSD-01","text":"Matter is determined ontologically as the temporary stabilization of relational determinations of Measure; it is not a pre-existing bearer, but a form of subsistence in relation.","refs":["CL_GB18_30:GA-01","CL_GB18_30:GA-03","CL_GB18_30:GA-10","CH_GB18_CDFR:ME5","CH_GB18_DVLS:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:BSD-02","text":"Causality becomes legible as recursive transformation: that which encounters a Measure externally becomes, through its negative reaction, a moment of its own inner determination.","refs":["CL_GB18_30:GA-05","CL_GB18_30:GA-06","CH_GB18_VZM0:A10","CH_GB18_VZM0:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:BSD-03","text":"Empirical numbers lose the status of an ultimate ground and receive the status of indices of a Measure-structure, whose qualitative necessity they indicate but do not fully derive.","refs":["CL_GB18_30:GA-02","CL_GB18_30:GA-03","CH_GB18_CDFR:SD4","CH_GB18_CDFR:ME2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:BSD-04","text":"Temporal development is determined not as uniform continuation, but as a relation of continuity, threshold, transition, and retroactive redetermination.","refs":["CL_GB18_30:GA-05","CL_GB18_30:GA-07","CL_GB18_30:GA-08","CH_GB18_DVLS:SD3","CH_GB18_VZM0:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_30:BSD-05","text":"The system closes not through a positive final state, but through every self-subsistence finding its truth in the negative relation to itself and to otherness.","refs":["CL_GB18_30:GA-04","CL_GB18_30:GA-06","CL_GB18_30:GA-08","CH_GB18_DVLS:SD4","CH_GB18_VZM0:SNX4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_30:RLE-01","text":"Quantum → exponent → negative reaction of Measure → alteration of the exponent → renewed qualitative determinacy forms the elementary recursive loop.","refs":["CH_GB18_CDFR:A7","CH_GB18_VZM0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RLE-02","text":"Self-subsistence → repulsion → relation to many others → specific determination → renewed self-subsistence forms the loop of relational individualization.","refs":["CH_GB18_CDFR:A12","CH_GB18_DVLS:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RLE-03","text":"Self-preservation → negation of external alteration → qualitative alteration → continued self-preservation forms the reversal in which identity persists only as self-modification.","refs":["CH_GB18_VZM0:A10","CH_GB18_VZM0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RLE-04","text":"Quantitative series → qualitative interruption → nodal line → measurelessness → negative self-relation forms the escalation path of Measure.","refs":["CH_GB18_DVLS:A12","CH_GB18_DVLS:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:RLE-05","text":"Negative unity functions as a conceptual attractor, because direct ratios, empirical exponents, combinations, and series receive their truth only through their placement within mediated self-relation.","refs":["CH_GB18_CDFR:A10","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_30:FGS-B01","text":"The schema posits the something as a Measure-relation: qualitative determinacy is the form in which quanta are not merely present, but reciprocally effective.","refs":["CH_GB18_VZM0:A1","CH_GB18_VZM0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FGS-B02","text":"Immediate quantum → exponent → limited moment of being-for-self: the external is not erased, but incorporated into the Measure-form.","refs":["CH_GB18_CDFR:A7","CH_GB18_CDFR:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FGS-B03","text":"External combination of two Measures → negative self-preservation → alteration of the exponents → alteration of qualitative nature.","refs":["CH_GB18_VZM0:A10","CH_GB18_VZM0:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FGS-B04","text":"Relation to many others → series of direct ratios → excluding Measures → elective affinity of specific self-subsistences.","refs":["CH_GB18_DVLS:A8","CH_GB18_DVLS:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FGS-B05","text":"Quantitative variation → qualitative nodes → measurelessness: the series produces its own interruption as an immanent form.","refs":["CH_GB18_DVLS:D6","CH_GB18_DVLS:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FGS-B06","text":"Measurelessness → unity of the excluding → negative self-relation: Measure closes itself only as self-division.","refs":["CH_GB18_DVLS:D8","CH_GB18_CDFR:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_30:AFM-B01","text":"Immediate quantum → exponent → specific Measure → negative unity → real being-for-self.","refs":["CH_GB18_CDFR:A7","CH_GB18_CDFR:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:AFM-B02","text":"Separate Measures → combination → asymmetric addition → alteration of the exponents → altered qualitative nature.","refs":["CH_GB18_VZM0:AS1","CH_GB18_VZM0:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:AFM-B03","text":"Self-subsistent Measure → relation to many others → series of Measures → excluding elective affinity.","refs":["CH_GB18_DVLS:A7","CH_GB18_DVLS:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:AFM-B04","text":"Quantitative series → qualitative interruption → nodal line → measurelessness → infinity of Measure.","refs":["CH_GB18_DVLS:D6","CH_GB18_DVLS:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:AFM-B05","text":"Infinity of Measure → unity of the excluding → negative relation of the self-subsistent to itself.","refs":["CH_GB18_DVLS:A14","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_30:MME-01","text":"Quality and quantum are remapped from separate spheres into opposed yet inseparable moments of a process of Measure.","refs":["CH_GB18_CDFR:ME1","CH_GB18_VZM0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MME-02","text":"The thing appears not as bearer of finished properties, but as the nodal point of a series of relations between Measures.","refs":["CH_GB18_DVLS:ME2","CH_GB18_DVLS:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MME-03","text":"Materiality and space are asymmetrically redetermined: material quantity possesses additive stability, while the ideal side makes the inner alterability of Measure visible.","refs":["CH_GB18_VZM0:D4","CH_GB18_VZM0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MME-04","text":"The empirical coefficient is reclassified from a purported explanatory ground into an indexical moment within a higher-order architecture of Measure.","refs":["CH_GB18_CDFR:ME2","CH_GB18_CDFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MME-05","text":"Infinity is transformed from external endlessness into the negative self-relation that immanently completes the exclusion of Measures.","refs":["CH_GB18_DVLS:ME5","CH_GB18_DVLS:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_30:ALT-B01","text":"At the surface level, the system treats falling motion, weight, volume, combination, and quantitative alteration as cases of a problematic Measure-relation.","refs":["CH_GB18_VZM0:AS5","CH_GB18_VZM0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:ALT-B02","text":"At the structural level, Measure mediates immanent specification, external quantity, negative self-preservation, series-formation, and qualitative nodes.","refs":["CH_GB18_CDFR:ALT2","CH_GB18_DVLS:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:ALT-B03","text":"At the metastrategic level, explanation is displaced from the search for isolated grounds to the reconstruction of relations and the relations of these relations.","refs":["CH_GB18_DVLS:ALT3","CH_GB18_CDFR:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:ALT-B04","text":"At the ontological and temporal level, that which is has no resting self-identity, because it preserves itself only through negative self-relation, alteration, and repulsion.","refs":["CH_GB18_DVLS:A15","CH_GB18_VZM0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:ALT-B05","text":"At the methodological and performative level, the presentation itself enacts the asserted movement by proceeding from immediate quantity to its immanent negation and relational redetermination.","refs":["CH_GB18_VZM0:AS7","CH_GB18_VZM0:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_30:FL-01","text":"External immediacy must be preserved as a moment of Measure, but may not count as the self-subsistent ground of its qualitative truth.","refs":["CH_GB18_CDFR:A4","CH_GB18_CDFR:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FL-02","text":"Self-subsistent things are initially presupposed as separate, but receive their specific quality only through relations that destabilize their presupposed self-subsistence.","refs":["CH_GB18_DVLS:A5","CH_GB18_DVLS:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FL-03","text":"Self-preservation and alteration are at once necessary and opposed: Measure remains the same only by altering its qualitative determinacy.","refs":["CH_GB18_VZM0:D3","CH_GB18_VZM0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:FL-04","text":"The series of Measures must be quantitatively continuous and qualitatively discontinuous at once; its unity is asserted only as a nodal structure.","refs":["CH_GB18_DVLS:SD3","CH_GB18_DVLS:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MP-01","text":"The exponent is a mutation point because it passes from an immediate quantum to a qualitative moment of determinacy of Measure.","refs":["CH_GB18_CDFR:A7","CH_GB18_VZM0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MP-02","text":"The direct ratio is a mutation point because it initially appears as an immediate form of ratio and is then subordinated to specific Measure.","refs":["CH_GB18_CDFR:NX5","CH_GB18_CDFR:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MP-03","text":"The other is a mutation point because it transforms from an externally opposed quantum into a Measure-relation itself determined exponentially.","refs":["CH_GB18_VZM0:A9","CH_GB18_VZM0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MP-04","text":"Measurelessness is a mutation point because it marks not the end of determination of Measure, but its transition into negative infinity.","refs":["CH_GB18_DVLS:A13","CH_GB18_DVLS:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_30:HSI-01","text":"Reality appears as a distributed machine of Measure-relations, in which quantities attain real significance only as reciprocally effective exponents.","refs":["CH_GB18_DVLS:A1","CH_GB18_DVLS:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:HSI-02","text":"The something appears as a temporary node of negative unity, which preserves itself only by determining itself against, repelling, and altering itself in relation to otherness.","refs":["CH_GB18_CDFR:A12","CH_GB18_DVLS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:HSI-03","text":"Time appears as nodal time: quantitative continuation becomes historically effective only through qualitative thresholds, transitions, and negative self-relation.","refs":["CH_GB18_DVLS:D6","CH_GB18_DVLS:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:HSI-04","text":"Intervention remains possible only within relations, because every external alteration already functions as a possible transformation of the determination of Measure.","refs":["CH_GB18_VZM0:A10","CH_GB18_VZM0:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_30:MRT-B01","text":"The global axioms suffice to reconstruct the transition from immediate quantum through exponent, negative unity, and combination to the series, nodal line, and infinity.","refs":["CH_GB18_CDFR:MRT1","CH_GB18_DVLS:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MRT-B02","text":"The concrete origin of empirical coefficients, the material conditions of particular combinations, and the precise criterion of transition into qualitative nodes remain underdetermined.","refs":["CH_GB18_CDFR:MRT2","CH_GB18_VZM0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MRT-B03","text":"The coherence of the cluster depends on externality being neither eliminated nor acknowledged as an independent ground.","refs":["CH_GB18_CDFR:MRT3","CH_GB18_DVLS:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MRT-B04","text":"The strongest architectural point lies in the transformation of quantum from the empirically immediate given into an exponent whose alteration produces qualitative and material consequences.","refs":["CH_GB18_CDFR:MRT4","CH_GB18_VZM0:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_30:MRT-B05","text":"The reconstruction remains dependent on the unresolved tension that Measure preserves itself by altering itself, and that its complete self-relation is possible only as continued self-division.","refs":["CH_GB18_VZM0:MRT6","CH_GB18_CDFR:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_30@R001","source_variant_id":"canonical:CL_GB18_30:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 88–90","context":"C. Das Fürsichseyn im Maaße. · A. Das Verhältniß selbstständiger Maaße. · a. Verbindung zweier Maaße."},"title_language_code":"en"},{"id":"CL_GB18_31","layer":"CL","title":"Chapters 91–93","order":31,"parents":["CH_GB18_BDMA","CH_GB18_CWAH","CH_GB18_A_23"],"revision":"CL_GB18_31@R001","sha256":"92a09b778f5b03224087e478bfe748fbb6570701be923a05ffdf08449bc2f742","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_31:AS-01","text":"Das System muss erklären, wie selbstständige und chemische Bestimmtheit relational erzeugt werden kann, ohne in äußerlich-gleichgültige Quantität oder isolierte Qualität zu zerfallen.","refs":["CH_GB18_BDMA:AS1","CH_GB18_A_23:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-02","text":"Qualität wird deshalb als geordnete quantitative Verhaltensweise rekonstruiert, deren Träger nur durch Beziehungen zu mehreren anderen Trägern bestimmt sind.","refs":["CH_GB18_BDMA:A5","CH_GB18_A_23:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-03","text":"Die einzelne Relation wird zur Reihe erweitert und durch Invarianzen zwischen Reihen auf eine relationale Einheit zweiter Ordnung gebracht.","refs":["CH_GB18_BDMA:A4","CH_GB18_BDMA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-04","text":"Diese Reihenordnung erzeugt Ausschließlichkeit zunächst durch die Negation neutraler Beziehungen und sodann durch den diskontinuierlich wirkenden Exponenten der Maßbestimmung.","refs":["CH_GB18_BDMA:AS6","CH_GB18_CWAH:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-05","text":"Dieselbe Quantität, die Ausschluss erzeugt, unterläuft ihn durch kombinierbare Mengen, alternative Neutralisationspartner und situationsabhängige Massenwirksamkeit.","refs":["CH_GB18_CWAH:A11","CH_GB18_A_23:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-06","text":"Die empirische Zuspitzung trennt daher die Geltung der Proportionsgesetze von atomistischen, korpuskularen und elektrochemischen Ontologien, die die zu erklärenden Differenzen tilgen.","refs":["CH_GB18_A_23:D4","CH_GB18_A_23:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-07","text":"Der Übergang zu spezifischen Gewichten erweitert das Maaß von Beziehungen zwischen getrennten Stoffen auf untrennbare Maßmomente und veränderliche Mischungsrelationen innerhalb eines Körpers.","refs":["CH_GB18_A_23:AS7","CH_GB18_A_23:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-08","text":"Die Bewegung ist rekursiv und mutationsgetrieben: Relation wird Reihe, Reihe wird Maß, Maß wird Ausschluss, Ausschluss wird erneut relativiert; die Schließung besteht nur in der offenen Forderung eines immanenten Regelprinzips.","refs":["CH_GB18_CWAH:SD5","CH_GB18_A_23:A18"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_31:GA-01","text":"[Persistent] Qualitative Bestimmtheit besteht nicht vor ihren Beziehungen, sondern wird als spezifische Differenz innerhalb eines Systems anderer Bestimmtheiten erzeugt.","refs":["CH_GB18_BDMA:A5","CH_GB18_CWAH:A1","CH_GB18_A_23:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-02","text":"[Persistent] Eine einzelne Relation ist zur Bestimmung eines Maaßes unzureichend; dessen Eigentümlichkeit verlangt eine Reihe möglicher Beziehungen zu differenten Anderen.","refs":["CH_GB18_BDMA:A4","CH_GB18_CWAH:A3","CH_GB18_A_23:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-03","text":"[Persistent] Eine Zahl besitzt nur als Exponent innerhalb einer Relation Bedeutung und kann zugleich Einheit, Relationsausdruck und Vergleichungsgröße sein.","refs":["CH_GB18_BDMA:A7","CH_GB18_A_23:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-04","text":"[Emergent] Vergleichbarkeit entsteht durch eine Invarianz zwischen ganzen Reihen und nicht durch einen den verglichenen Gliedern äußerlich vorgegebenen Maßstab.","refs":["CH_GB18_BDMA:A6","CH_GB18_A_23:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-05","text":"[Mutating] Selbstständigkeit mutiert von scheinbarer Beziehungsfreiheit zur Fähigkeit, eine bestimmte Relationsordnung zu behaupten; chemische Isoliertheit erscheint entsprechend als aufzuhebende Unselbstständigkeit.","refs":["CH_GB18_BDMA:SD3","CH_GB18_A_23:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-06","text":"[Attractor] Quantität und Qualität sind keine unabhängigen Ordnungen: Quantität trägt qualitative Spezifikation, ohne sie durch bloße Menge erschöpfend zu erklären.","refs":["CH_GB18_BDMA:D6","CH_GB18_CWAH:SD1","CH_GB18_A_23:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-07","text":"[Mutating] Neutralität und quantitative Gleichgültigkeit sichern zunächst relationale Erhaltung, werden aber später zu Mechanismen, welche qualitative Ausschließlichkeit wieder auflösen.","refs":["CH_GB18_BDMA:A1","CH_GB18_CWAH:AS6","CH_GB18_CWAH:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-08","text":"[Mutating] Ausschließlichkeit entsteht aus vermittelter Negativität, wird als Diskontinuität des Maaßexponenten reformuliert und schließlich durch alternative Kombinationen und äußere Umstände konditioniert.","refs":["CH_GB18_BDMA:A11","CH_GB18_CWAH:A10","CH_GB18_A_23:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-09","text":"[Emergent] Empirische Proportionsgesetze besitzen methodische Autonomie gegenüber Ontologien ihrer vermeintlichen Träger, bleiben aber ohne immanentes Erzeugungsprinzip systematisch unvollständig.","refs":["CH_GB18_A_23:D4","CH_GB18_A_23:SD2","CH_GB18_A_23:D10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-10","text":"[Mutating] Maaß erweitert sich von Verhältnissen zwischen selbstständig erscheinenden Stoffen zu untrennbaren Momenten eines Körpers und zu nichtadditiven Gesetzlichkeiten kontinuierlicher Mischungen.","refs":["CH_GB18_A_23:SD4","CH_GB18_A_23:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-11","text":"[Terminal] Die Architektur endet nicht in einem positiven Auswahlgesetz, sondern in der bestimmten Abwesenheit eines immanenten Prinzips für Affinitäts-, Proportions- und Mischungsreihen.","refs":["CH_GB18_CWAH:SNX5","CH_GB18_A_23:A18","CH_GB18_A_23:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_31:RMD-01","text":"Relationale Bestimmtheit bewahrt stabile Identität, wechselt aber vom abstrakten Fürsichbestimmtsein des Maaßes zur chemischen These, dass Stoffe nur als Maßmomente existieren.","refs":["CH_GB18_BDMA:A8","CH_GB18_A_23:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-02","text":"Die Reihe erweitert ihre Funktion von der Darstellung einer einzelnen Maaßeigentümlichkeit über Gegenreihen möglicher Affinitäten bis zu empirischen Proportions- und Mischungsreihen.","refs":["CH_GB18_BDMA:AS3","CH_GB18_CWAH:A6","CH_GB18_A_23:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-03","text":"Der Exponent mutiert vom Glied einer Vergleichungsordnung zum ausschließenden Diskontinuitätsoperator und anschließend zum veränderlichen Ausdruck spezifischer Gewichts- und Mischungsverhältnisse.","refs":["CH_GB18_BDMA:A7","CH_GB18_CWAH:A10","CH_GB18_A_23:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-04","text":"Neutralisation kehrt ihre Valenz um: Sie erhält zunächst Selbstständigkeit in gleichgültiger Verbindung, dient dann als Maß der Affinität und wird schließlich zum Ort kombinatorischer Unterminierung des Ausschlusses.","refs":["CH_GB18_BDMA:A1","CH_GB18_CWAH:A9","CH_GB18_CWAH:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-05","text":"Ausschluss durchläuft eine serielle Mutation von der Negation der Negation über diskontinuierliches Mehr oder Weniger bis zum nur bedingt auftretenden Effekt von Masse und Umständen.","refs":["CH_GB18_BDMA:A11","CH_GB18_CWAH:A10","CH_GB18_A_23:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-06","text":"Quantität wiederholt sich funktional als Träger der Qualität, Medium der Vergleichbarkeit, Erzeuger des Ausschlusses und Mechanismus seiner erneuten Relativierung.","refs":["CH_GB18_BDMA:A9","CH_GB18_CWAH:SD1","CH_GB18_A_23:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-07","text":"Qualität wird aus einer vermeintlichen Innerlichkeit in die Ordnung relationaler Exponenten verlagert, kehrt jedoch als irreduzibler Rest zurück, sobald mengenmäßige und elektrochemische Reduktionen scheitern.","refs":["CH_GB18_BDMA:ME2","CH_GB18_A_23:A15","CH_GB18_A_23:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-08","text":"Das geschlossene Maßsystem verschwindet als vorhandene Struktur und bleibt als Attraktor bestehen, der Reihen ordnen soll, ohne bereits durch eine einheitliche Rechenregel verfügbar zu sein.","refs":["CH_GB18_A_23:D10","CH_GB18_A_23:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_31:CGD-01","text":"Chemische und musikalische Beispiele bleiben lokale Realisierungen; auf Clusterebene skaliert allein ihre gemeinsame Struktur aus serieller Relation, quantitativ fundierter Qualität und nichttrivialer Auswahl.","refs":["CH_GB18_CWAH:ME5","CH_GB18_A_23:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:CGD-02","text":"Berthollets Massenbegriff, Atomismus und Elektrochemismus bleiben lokale Theorieziele; nach oben skaliert das Kriterium, dass eine Erklärung empirische Invarianzen bewahren muss, ohne spezifische Differenzen zu annullieren.","refs":["CH_GB18_A_23:AS4","CH_GB18_A_23:AS5","CH_GB18_A_23:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:CGD-03","text":"Die Identität extensiver und intensiver Größe ist ein lokaler Übergangsmechanismus; global tragend ist die daraus folgende Unmöglichkeit, Ausschließlichkeit durch bloße quantitative Umbenennung zu sichern.","refs":["CH_GB18_CWAH:A8","CH_GB18_CWAH:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:CGD-04","text":"Die Reihenbildung skaliert vollständig nach oben, weil sie Selbstbestimmung, Vergleichbarkeit, Mehrfachbeziehung und empirische Proportionsgesetzlichkeit in einer gemeinsamen Architektur verbindet.","refs":["CH_GB18_BDMA:D3","CH_GB18_A_23:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:CGD-05","text":"Spezifische Schwere ersetzt die Affinitätsarchitektur nicht, sondern markiert deren Domänenerweiterung von diskreten Gegenrelationen zu untrennbaren und kontinuierlich veränderlichen Maßmomenten.","refs":["CH_GB18_A_23:A16","CH_GB18_A_23:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:CGD-06","text":"Das konkrete Auswahl- und Reihengesetz bleibt auf der unteren Ebene ausdrücklich unterbestimmt und darf auf Clusterebene nicht als bereits gewonnene Synthese umcodiert werden.","refs":["CH_GB18_CWAH:MRT2","CH_GB18_A_23:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_31:GNX-01","text":"Qualitative Identität ist weder isolierte Stoffeigenschaft noch unmittelbare Einfachheit, sondern kann nur als relationale Differenz und Reihenfunktion bestimmt werden. ; Trace Type — Negative","refs":["CH_GB18_CWAH:NX1","CH_GB18_A_23:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GNX-02","text":"Weder eine einzelne Verhältnißzahl noch ein äußerlich gesetzter Maßstab kann die Eigentümlichkeit oder Vergleichbarkeit selbstständiger Maaße vollständig ausdrücken. ; Trace Type — Negative","refs":["CH_GB18_BDMA:NX1","CH_GB18_BDMA:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GNX-03","text":"Quantitative Kontinuität, Intensitätssteigerung und kombinierbare Menge liefern für sich kein Prinzip qualitativer Ausschließlichkeit. ; Trace Type — Negative","refs":["CH_GB18_CWAH:NX3","CH_GB18_CWAH:NX5","CH_GB18_CWAH:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GNX-04","text":"Atomistische Lagerung, korpuskulare Juxtaposition und elektrische Neutralisation sind ausgeschlossen, sofern sie die spezifische Differenz chemischer Verbindung durch ein fremdes Modell ersetzen. ; Trace Type — Negative","refs":["CH_GB18_A_23:NX8","CH_GB18_A_23:NX9","CH_GB18_A_23:NX10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GNX-05","text":"Ein endgültiges Auswahlprinzip ist weder aus Sättigungszahlen noch aus Massenwirksamkeit, Umständen oder bloßen Proportionsreihen ableitbar. ; Trace Type — Negative","refs":["CH_GB18_A_23:NX5","CH_GB18_A_23:DNX3","CH_GB18_CWAH:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_31:DBN-01","text":"Damit die Architektur Bestand hat, muss die Vorstellung falsch sein, Beziehungen träten nachträglich zu bereits vollständig bestimmten Trägern hinzu. ; Trace Type — Negative","refs":["CH_GB18_BDMA:DNX2","CH_GB18_A_23:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:DBN-02","text":"Ebenfalls unzulässig ist die Annahme, Zahlen seien begriffslose Daten; sie müssen als funktionsabhängige Exponenten einer Relationsordnung lesbar sein. ; Trace Type — Negative","refs":["CH_GB18_BDMA:D5","CH_GB18_A_23:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:DBN-03","text":"Die Geltung eines Proportionsgesetzes darf keine bestimmte Ontologie seiner Träger erzwingen, weil sonst empirische Invarianz mit hypothetischem Erklärungsbild verwechselt würde. ; Trace Type — Negative","refs":["CH_GB18_A_23:SD2","CH_GB18_A_23:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:DBN-04","text":"Nicht zugelassen werden kann eine abschließende Versöhnung von Gleichgültigkeit und Ausschließlichkeit, da gerade ihr erneuter Umschlag die Fortbewegung des Systems erzeugt. ; Trace Type — Negative","refs":["CH_GB18_CWAH:SNX4","CH_GB18_CWAH:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_31:BSA-01","text":"Die tiefste strukturierende Abwesenheit ist das nicht verfügbare immanente Gesetz, das Reiheninvarianz, konkrete Affinitätswahl und nichtadditive Mischung aus einem gemeinsamen Prinzip erzeugen könnte. ; Trace Type — Negative","refs":["CH_GB18_A_23:A18","CH_GB18_A_23:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:BSA-02","text":"Ontologisch unstatthaft ist eine schlechthin unmittelbare Qualität, die vor Relation, Reihe, Vergleichung und quantitativer Artikulation vollständig bestimmt wäre. ; Trace Type — Negative","refs":["CH_GB18_BDMA:SNX1","CH_GB18_CWAH:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:BSA-03","text":"Unverfügbar bleibt ein absoluter Vorrang, der weder maßförmig vermittelt noch durch Bedingungen relativiert wäre und dennoch eine bestimmte Verbindung notwendig auswählte. ; Trace Type — Negative","refs":["CH_GB18_BDMA:SNX2","CH_GB18_CWAH:SNX5","CH_GB18_A_23:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_31:XD-01","text":"Serielle Qualität verwandelt jeden vermeintlich selbstständigen Träger in einen Knoten von Gegenreihen, dessen Identität zugleich durch eigene Exponenten und durch seine Funktion in fremden Reihen bestimmt ist. ; Trace Type — Composite","refs":["CL_GB18_31:GA-01","CL_GB18_31:GA-02","CL_GB18_31:GA-03","CH_GB18_BDMA:D2","CH_GB18_CWAH:SD4","CH_GB18_A_23:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:XD-02","text":"Die Möglichkeit mehrerer Neutralisationspartner trennt die stabile Sättigungsordnung von der instabilen Präferenzordnung: Proportionsgesetzlichkeit bestimmt mögliche Verbindungen, aber nicht allein deren tatsächlichen Vorrang. ; Trace Type — Composite","refs":["CL_GB18_31:GA-02","CL_GB18_31:GA-08","CL_GB18_31:GA-09","CH_GB18_CWAH:D6","CH_GB18_A_23:D2","CH_GB18_A_23:NX5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:XD-03","text":"Maaß erzeugt Ausschließlichkeit nur prekär, weil sein diskontinuierlicher Exponent innerhalb desselben quantitativen Feldes operiert, das alternative Portionierungen, Partner und Umstände zulässt. ; Trace Type — Tension","refs":["CL_GB18_31:GA-06","CL_GB18_31:GA-07","CL_GB18_31:GA-08","CH_GB18_BDMA:A11","CH_GB18_CWAH:A11","CH_GB18_A_23:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:XD-04","text":"Reiheninvarianz begründet Vergleichbarkeit und empirische Gesetzlichkeit, unterbestimmt jedoch die Ontologie der verglichenen Träger; deshalb kann dasselbe Gesetz konkurrierende oder unzureichende Erklärungsbilder überdauern. ; Trace Type — Composite","refs":["CL_GB18_31:GA-04","CL_GB18_31:GA-09","CH_GB18_BDMA:A6","CH_GB18_A_23:A8","CH_GB18_A_23:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:XD-05","text":"Nach Berthollets Darstellung verändern Masse und Umstände die Wirksamkeit und den beobachteten Ausschluss, ohne die zugrunde liegenden Sättigungsproportionen zu verändern; beobachtete Auswahl und formale Maßordnung fallen daher auseinander. ; Trace Type — Tension","refs":["CL_GB18_31:GA-08","CL_GB18_31:GA-09","CH_GB18_A_23:A8","CH_GB18_A_23:A9","CH_GB18_A_23:NX7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:XD-06","text":"Die Erweiterung zu spezifischen Gewichten zeigt, dass diskrete Stoffreihen und kontinuierliche Mischungsverhältnisse dieselbe Forderung nach einem immanenten Erzeugungsprinzip teilen, ohne derselben einfachen Rechenform zu gehorchen. ; Trace Type — Composite","refs":["CL_GB18_31:GA-10","CL_GB18_31:GA-11","CH_GB18_BDMA:SD1","CH_GB18_A_23:SD4","CH_GB18_A_23:D9"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_31:BSD-01","text":"Das als selbstständig gesetzte Seiende wird zu einem relationalen Funktionsknoten: Seine Identität ist die stabile Organisationsform seiner Verhältnisse und nicht ein beziehungsloser Kern.","refs":["CL_GB18_31:GA-01","CL_GB18_31:GA-03","CL_GB18_31:GA-05","CH_GB18_BDMA:SD3","CH_GB18_CWAH:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:BSD-02","text":"Kausalität wird geschichtet in relationale Möglichkeit, maßförmige Spezifikation, qualitative Priorität und situationsabhängige Aktualisierung; keine dieser Schichten kann allein die Wahlverwandtschaft erzeugen.","refs":["CL_GB18_31:GA-06","CL_GB18_31:GA-08","CL_GB18_31:GA-09","CH_GB18_A_23:SD3","CH_GB18_A_23:D7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:BSD-03","text":"Epistemisch ist die Kenntnis exakter Reihen schwächer als die Kenntnis ihres Erzeugungsgesetzes, aber stärker als spekulative Ontologien, welche die empirisch bestimmten Differenzen nicht bewahren.","refs":["CL_GB18_31:GA-09","CL_GB18_31:GA-11","CH_GB18_A_23:ALT5","CH_GB18_A_23:SD6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:BSD-04","text":"Die logische Zeit des Systems ist keine lineare Sukzession, sondern eine Folge wiederholter Umschläge, in denen jede gewonnene Bestimmung durch ihre eigene quantitative Vermittlung destabilisiert und auf höherer Ebene rekonstruiert wird.","refs":["CL_GB18_31:GA-06","CL_GB18_31:GA-07","CL_GB18_31:GA-08","CH_GB18_CWAH:D7","CH_GB18_CWAH:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:BSD-05","text":"Methodisch erzeugt das System eine offene Schließung: Es bestimmt, welche Erklärungen unzulänglich sind und welche Form ein hinreichendes Gesetz besitzen müsste, ohne dieses Gesetz selbst bereitzustellen.","refs":["CL_GB18_31:GA-09","CL_GB18_31:GA-11","CH_GB18_A_23:ALT3","CH_GB18_A_23:MRT6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_31:RLE-01","text":"Relationale Bestimmung erzeugt eine Schleife: Ein Glied wird durch andere bestimmt, fungiert ihnen gegenüber selbst als Einheit und kehrt dadurch als Bedingung der Ordnung zurück, die es bestimmt.","refs":["CH_GB18_BDMA:A7","CH_GB18_CWAH:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RLE-02","text":"Die Eskalation vom Einzelexponenten zur Reihe und von der Reihe zur Invarianz zwischen Reihen verwandelt bloße Relation in eine rekursive Maaßordnung zweiter Stufe.","refs":["CH_GB18_BDMA:AS2","CH_GB18_BDMA:AS4","CH_GB18_BDMA:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RLE-03","text":"Neutralität bildet mit Ausschließlichkeit eine Rückkopplung: Gleichgültige Verbindung erzeugt negative Einheit, deren quantitativer Grund wiederum alternative Verbindungen freigibt.","refs":["CH_GB18_BDMA:AS6","CH_GB18_CWAH:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RLE-04","text":"Quantität, Qualität und Maaß bilden keinen Dreischritt mit Endpunkt, sondern eine Spirale, in der jede Bestimmung die nächste hervorbringt und durch diese begrenzt wird.","refs":["CH_GB18_CWAH:AS6","CH_GB18_CWAH:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RLE-05","text":"Die Theoriekritik verläuft rekursiv: Ein Modell wird an den Proportionsgesetzen geprüft, verliert seinen Anspruch bei Tilgung spezifischer Differenzen und erneuert damit die Forderung nach einer immanenteren Theorie.","refs":["CH_GB18_A_23:SD2","CH_GB18_A_23:SD6","CH_GB18_A_23:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RLE-06","text":"Der begriffliche Attraktor ist ein Maßsystem, das abstrakte Reihen, konkrete Affinitäten und Mischungsrelationen integriert; jede Domänenerweiterung nähert sich ihm, ohne ihn abzuschließen.","refs":["CH_GB18_A_23:A18","CH_GB18_A_23:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_31:FGS-B01","text":"Isolierte Qualität → relationale Unselbstständigkeit → spezifische Bestimmung durch Verhalten zu anderem.","refs":["CH_GB18_CWAH:NX1","CH_GB18_A_23:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FGS-B02","text":"Einzelrelation → unzureichender Exponent → Vervielfältigung der Partner → Exponentenreihe und Gegenreihe.","refs":["CH_GB18_BDMA:A4","CH_GB18_CWAH:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FGS-B03","text":"Reihenbildung → Verhältnis zwischen Exponenten → konstante Invarianz → Vergleichbarkeit und Proportionsgesetzlichkeit.","refs":["CH_GB18_BDMA:A6","CH_GB18_A_23:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FGS-B04","text":"Neutrale Vermittlung → doppelte Negation → ausschließende Einheit → diskontinuierlicher Maaßexponent → Wahlverwandtschaft.","refs":["CH_GB18_BDMA:A11","CH_GB18_CWAH:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FGS-B05","text":"Ausschließender Exponent → alternative Portionierung und Mehrfachneutralisation → Massen- und Umstandsbedingtheit → erneute Relativierung des Ausschlusses.","refs":["CH_GB18_CWAH:A11","CH_GB18_A_23:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FGS-B06","text":"Fortbestehende Proportionsgesetze + Scheitern reduktiver Ontologien + Erweiterung zu Mischungsmaßen → offene Forderung eines immanenten, nicht bloß additiven Maßsystems.","refs":["CH_GB18_A_23:SD2","CH_GB18_A_23:A17","CH_GB18_A_23:A18"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_31:AFM-B01","text":"Isolierte Bestimmtheit → relationale Neubestimmung → serielle Expansion → Invarianz zwischen Reihen → quantitative Trägerschaft der Qualität → ausschließender Maaßexponent → Wahlverwandtschaft → kombinatorische und situative Relativierung.","refs":["CH_GB18_BDMA:AF1","CH_GB18_BDMA:AF6","CH_GB18_CWAH:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AFM-B02","text":"Empirische Proportionsreihen → Trennung von Gesetz und Trägerbild → Kritik reduktiver Modelle → Rückkehr irreduzibler Qualität → Erweiterung zu spezifischen Gewichten und Mischungen → offene Forderung eines Maßsystems.","refs":["CH_GB18_A_23:AF1","CH_GB18_A_23:ME6","CH_GB18_A_23:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_31:MME-01","text":"Qualität wird von einer inneren Eigenschaft zu einer invarianten, aber mutationsfähigen Ordnung quantitativer Beziehungen umkartiert.","refs":["CH_GB18_BDMA:SD2","CH_GB18_A_23:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MME-02","text":"Die Opposition zwischen qualitativer Innerlichkeit und quantitativer Äußerlichkeit kollabiert; an ihre Stelle tritt die Unterscheidung zwischen bloßer Menge, maßförmiger Spezifikation und irreduzibler qualitativer Priorität.","refs":["CH_GB18_BDMA:ME2","CH_GB18_A_23:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MME-03","text":"Vergleichbarkeit und Auswahl werden getrennt: Gemeinsame Reiheninvarianz ermöglicht Vergleichung, entscheidet aber noch nicht, welche mögliche Verbindung ausschließend aktualisiert wird.","refs":["CH_GB18_BDMA:ME3","CH_GB18_CWAH:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MME-04","text":"Empirisches Gesetz und erklärende Ontologie werden entkoppelt, wodurch Zahlenreihen als Prüfmaßstab konkurrierender Modelle statt als Beweis atomarer oder elektrischer Trägerbilder fungieren.","refs":["CH_GB18_A_23:ME2","CH_GB18_A_23:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MME-05","text":"Das Feld des Maaßes umfasst nun sowohl Beziehungen zwischen selbstständig erscheinenden Gliedern als auch untrennbare und kontinuierlich veränderliche Momente innerhalb eines Körpers.","refs":["CH_GB18_A_23:SD4","CH_GB18_A_23:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_31:ALT-B01","text":"[Surface level] Sättigung, Neutralisation, Wahlverwandtschaft, chemische Masse, Proportionsgesetze, Atomismus, Elektrochemismus und spezifische Gewichte bilden die expliziten Gegenstände.","refs":["CH_GB18_A_23:ALT1","CH_GB18_A_23:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:ALT-B02","text":"[Structural level] Gegenreihen, Exponenten, Neutralisationsquanten, Invarianzen und situationsabhängige Wirksamkeiten bilden ein verteiltes System, in dem Qualität erzeugt und Auswahl zugleich destabilisiert wird.","refs":["CH_GB18_CWAH:ALT2","CH_GB18_A_23:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:ALT-B03","text":"[Metastrategic level] Interpretation wird zur Prüfung, ob ein Modell empirische Regelmäßigkeit bewahrt, relationale Differenz erklärt und den Ausschluss nicht durch bloße Umbenennung voraussetzt.","refs":["CH_GB18_CWAH:ALT3","CH_GB18_A_23:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:ALT-B04","text":"[Ontological / Temporal level] Realität besteht aus relational bestimmten Maßmomenten, deren Formen durch wiederholte Umschläge zwischen Gleichgültigkeit, Spezifikation und Ausschluss zeitlich-logisch werden.","refs":["CH_GB18_BDMA:ALT4","CH_GB18_CWAH:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:ALT-B05","text":"[Methodological / Performative level] Die Form des Systems vollzieht seine These, indem jede zunächst zureichende Bestimmung durch ihren eigenen Anwendungsbereich widerlegt, erweitert und auf eine komplexere Relationsordnung gebracht wird.","refs":["CH_GB18_CWAH:D7","CH_GB18_CWAH:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_31:FL-01","text":"Selbstständigkeit soll erhalten bleiben, obwohl ihre spezifische Bestimmtheit ausschließlich in äußerlich gegliederten Beziehungen und Reihen liegt. ; Trace Type — Tension","refs":["CH_GB18_BDMA:MRT6","CH_GB18_BDMA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FL-02","text":"Der Maaßexponent soll Ausschließlichkeit sichern, doch die Gleichgültigkeit alternativer Neutralisationspartner relativiert genau den durch ihn erzeugten Ausschluss. ; Trace Type — Tension","refs":["CH_GB18_CWAH:D5","CH_GB18_CWAH:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FL-03","text":"Berthollets Externalisierung des beobachteten Ausschlusses kollidiert mit der Behauptung, dass mit dem Qualitativen eine nicht bloß quantitative Ordnung beginnt. ; Trace Type — Tension","refs":["CH_GB18_A_23:MRT3","CH_GB18_A_23:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FL-04","text":"Die methodische Autonomie der Proportionsgesetze schützt sie vor spekulativen Ontologien, liefert aber selbst keine positive Theorie der spezifischen qualitativen Differenz. ; Trace Type — Tension","refs":["CH_GB18_A_23:SD2","CH_GB18_A_23:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MP-01","text":"Die einzelne Verhältnißzahl mutiert von der vermeintlich adäquaten Maaßbestimmung zum unzureichenden Glied einer ganzen Exponentenreihe. ; Trace Type — Tension","refs":["CH_GB18_BDMA:AS2","CH_GB18_BDMA:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MP-02","text":"Neutralität mutiert von der Bedingung relationaler Selbsterhaltung zum Ausgangspunkt ausschließender Negativität und schließlich zum Mechanismus erneuter Indifferenz. ; Trace Type — Tension","refs":["CH_GB18_BDMA:A1","CH_GB18_BDMA:AS6","CH_GB18_CWAH:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MP-03","text":"Maaß mutiert von einer konstanten Reiheninvarianz zum ausschließenden Diskontinuitätsoperator und weiter zu einem offenen Problem konkreter Affinitätswahl. ; Trace Type — Tension","refs":["CH_GB18_BDMA:AF4","CH_GB18_CWAH:A10","CH_GB18_CWAH:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MP-04","text":"Mit der spezifischen Schwere wechselt Maaß seine Domäne von Relationen getrennter Stoffe zu untrennbaren Körpermomenten, ohne dass die frühere Affinitätslogik einfach übertragen werden könnte. ; Trace Type — Tension","refs":["CH_GB18_A_23:SD4","CH_GB18_A_23:A16"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_31:HSI-01","text":"Realität erscheint als rekursives Netz von Maaßreihen, in dem jedes Glied zugleich bestimmte Einheit, Exponent für anderes und Moment übergreifender Vergleichungsordnungen ist.","refs":["CH_GB18_BDMA:A7","CH_GB18_BDMA:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:HSI-02","text":"Das selbstständige Glied ist kein geschlossenes Teilchen, sondern ein relationales Zentrum, das nur durch die Stabilität und Differenz seiner Verhaltensweisen besteht.","refs":["CH_GB18_BDMA:SD3","CH_GB18_CWAH:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:HSI-03","text":"Die vorausgesetzte Zeit ist spiralförmig: Bestimmungen kehren verändert wieder, weil Quantität Qualität erzeugt, Maaß sie ausschließt und quantitative Gleichgültigkeit den Ausschluss erneut öffnet.","refs":["CH_GB18_CWAH:SD5","CH_GB18_CWAH:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:HSI-04","text":"Möglich bleibt eine Navigation durch Rekonstruktion von Reiheninvarianzen, Prüfung erklärender Modelle und Unterscheidung formaler Möglichkeit von tatsächlicher Auswahl; unmöglich bleibt die Verfügung über ein absolutes Wahlgesetz.","refs":["CH_GB18_BDMA:ALT3","CH_GB18_A_23:ALT3","CH_GB18_CWAH:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_31:MRT-B01","text":"Die Architektur ist auf Clusterebene rekonstruierbar, wenn relationale Qualität, serielle Exponentenordnung, Reiheninvarianz, instabile Ausschließlichkeit und offene Gesetzesforderung gemeinsam erhalten bleiben.","refs":["CH_GB18_BDMA:MRT1","CH_GB18_CWAH:MRT1","CH_GB18_A_23:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MRT-B02","text":"Ihre stärkste Verbindung liegt in der Ableitung qualitativer Bestimmtheit aus ganzen Verhältnisreihen und in der Trennung empirischer Proportionsgesetze von reduktiven Trägerontologien.","refs":["CH_GB18_BDMA:MRT5","CH_GB18_A_23:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MRT-B03","text":"Unterbestimmt bleibt, wodurch eine bestimmte Affinität gegenüber anderen Möglichkeiten tatsächlich Vorrang erhält und ob beobachteter Ausschluss qualitativ wesentlich oder nur bedingt ist.","refs":["CH_GB18_CWAH:MRT2","CH_GB18_A_23:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MRT-B04","text":"Ebenfalls unterbestimmt bleiben die Bedingungen der Reihenabgrenzung, der tatsächlichen Invarianz zwischen Reihen und der gemeinsamen Erzeugung diskreter Affinitäts- und kontinuierlicher Mischungsmaße.","refs":["CH_GB18_BDMA:MRT3","CH_GB18_BDMA:MRT4","CH_GB18_A_23:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MRT-B05","text":"Die Kohärenz ist bedingt, aber nicht mangelhaft: Sie hängt davon ab, Gleichgültigkeit und Ausschließlichkeit als produktive Gegenwirkungen derselben quantitativen Vermittlung statt als endgültig versöhnte Bestimmungen zu behandeln.","refs":["CH_GB18_CWAH:MRT3","CH_GB18_CWAH:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MRT-B06","text":"Der axiomatischen Reduktion widersteht die konkrete naturwissenschaftliche Bestimmung des immanenten Maßprinzips; die Rekonstruktion bewahrt das System nur, wenn sie diese Nichtverfügbarkeit als terminale Struktur und nicht als bereits gelöste Aufgabe erhält.","refs":["CH_GB18_CWAH:DNX7","CH_GB18_A_23:A18","CH_GB18_A_23:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T121952403480Z_a6abc2f5","language_code":"en","language_name":"English","title":"Chapters 91–93","source_sha256":"92a09b778f5b03224087e478bfe748fbb6570701be923a05ffdf08449bc2f742","sha256":"58fbf6347119fb7a075971ebee821e6a8f71bd3f36a1984802e7048d936a3277","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:19:52.404795+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_31:AS-01","text":"The system must explain how self-subsistence and chemical determinacy can be relationally produced without disintegrating into externally indifferent quantity or isolated quality.","refs":["CH_GB18_BDMA:AS1","CH_GB18_A_23:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-02","text":"Quality is therefore reconstructed as an ordered quantitative mode of behaviour, whose bearers are determined only through relations to several other bearers.","refs":["CH_GB18_BDMA:A5","CH_GB18_A_23:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-03","text":"The individual relation is expanded into a series and, through invariances between series, brought to a relational unity of the second order.","refs":["CH_GB18_BDMA:A4","CH_GB18_BDMA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-04","text":"This serial order initially produces exclusivity through the negation of neutral relations and then through the discontinuously operative exponent of determination of measure.","refs":["CH_GB18_BDMA:AS6","CH_GB18_CWAH:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-05","text":"The same quantity that produces exclusion undermines it through combinable quantities, alternative partners of neutralization, and context-dependent effectiveness of mass.","refs":["CH_GB18_CWAH:A11","CH_GB18_A_23:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-06","text":"The empirical sharpening therefore separates the validity of the laws of proportion from atomistic, corpuscular, and electrochemical ontologies that efface the differences to be explained.","refs":["CH_GB18_A_23:D4","CH_GB18_A_23:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-07","text":"The transition to specific gravities extends measure from relations between separate substances to inseparable moments of measure and variable relations of mixture within one body.","refs":["CH_GB18_A_23:AS7","CH_GB18_A_23:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AS-08","text":"The movement is recursive and mutation-driven: relation becomes series, series becomes measure, measure becomes exclusion, exclusion is again relativized; closure consists only in the open demand for an immanent principle of rule.","refs":["CH_GB18_CWAH:SD5","CH_GB18_A_23:A18"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_31:GA-01","text":"[Persistent] Qualitative determinacy does not exist prior to its relations, but is produced as specific difference within a system of other determinacies.","refs":["CH_GB18_BDMA:A5","CH_GB18_CWAH:A1","CH_GB18_A_23:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-02","text":"[Persistent] A single relation is insufficient for the determination of a measure; its peculiarity requires a series of possible relations to different others.","refs":["CH_GB18_BDMA:A4","CH_GB18_CWAH:A3","CH_GB18_A_23:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-03","text":"[Persistent] A number has significance only as an exponent within a relation and can at once be unity, expression of relation, and magnitude of comparison.","refs":["CH_GB18_BDMA:A7","CH_GB18_A_23:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-04","text":"[Emergent] Comparability arises through an invariance between whole series and not through a standard externally prescribed to the compared terms.","refs":["CH_GB18_BDMA:A6","CH_GB18_A_23:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-05","text":"[Mutating] Self-subsistence mutates from apparent freedom from relation into the capacity to maintain a determinate relational order; chemical isolation correspondingly appears as a non-self-subsistence to be sublated.","refs":["CH_GB18_BDMA:SD3","CH_GB18_A_23:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-06","text":"[Attractor] Quantity and quality are not independent orders: quantity bears qualitative specification without exhaustively explaining it through mere magnitude.","refs":["CH_GB18_BDMA:D6","CH_GB18_CWAH:SD1","CH_GB18_A_23:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-07","text":"[Mutating] Neutrality and quantitative indifference initially secure relational preservation, but later become mechanisms that dissolve qualitative exclusivity again.","refs":["CH_GB18_BDMA:A1","CH_GB18_CWAH:AS6","CH_GB18_CWAH:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-08","text":"[Mutating] Exclusivity arises from mediated negativity, is reformulated as the discontinuity of the exponent of measure, and is finally conditioned by alternative combinations and external circumstances.","refs":["CH_GB18_BDMA:A11","CH_GB18_CWAH:A10","CH_GB18_A_23:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-09","text":"[Emergent] Empirical laws of proportion possess methodological autonomy vis-à-vis ontologies of their supposed bearers, but remain systematically incomplete without an immanent generative principle.","refs":["CH_GB18_A_23:D4","CH_GB18_A_23:SD2","CH_GB18_A_23:D10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-10","text":"[Mutating] Measure expands from relations between apparently self-subsistent substances to inseparable moments of a body and to non-additive regularities of continuous mixtures.","refs":["CH_GB18_A_23:SD4","CH_GB18_A_23:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GA-11","text":"[Terminal] The architecture ends not in a positive law of selection, but in the determinate absence of an immanent principle for series of affinity, proportion, and mixture.","refs":["CH_GB18_CWAH:SNX5","CH_GB18_A_23:A18","CH_GB18_A_23:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_31:RMD-01","text":"Relational determinacy preserves stable identity, but shifts from the abstract being-determined-for-itself of measure to the chemical thesis that substances exist only as moments of measure.","refs":["CH_GB18_BDMA:A8","CH_GB18_A_23:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-02","text":"The series expands its function from the presentation of a single peculiarity of measure through counter-series of possible affinities to empirical series of proportions and mixtures.","refs":["CH_GB18_BDMA:AS3","CH_GB18_CWAH:A6","CH_GB18_A_23:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-03","text":"The exponent mutates from a member of an order of comparison into an excluding operator of discontinuity and subsequently into the variable expression of relations of specific gravity and mixture.","refs":["CH_GB18_BDMA:A7","CH_GB18_CWAH:A10","CH_GB18_A_23:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-04","text":"Neutralization reverses its valence: it initially preserves self-subsistence in indifferent combination, then serves as the measure of affinity, and finally becomes the site of combinatorial undermining of exclusion.","refs":["CH_GB18_BDMA:A1","CH_GB18_CWAH:A9","CH_GB18_CWAH:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-05","text":"Exclusion undergoes a serial mutation from the negation of negation through discontinuous more or less to the only conditionally occurring effect of mass and circumstances.","refs":["CH_GB18_BDMA:A11","CH_GB18_CWAH:A10","CH_GB18_A_23:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-06","text":"Quantity functionally recurs as bearer of quality, medium of comparability, producer of exclusion, and mechanism of its renewed relativization.","refs":["CH_GB18_BDMA:A9","CH_GB18_CWAH:SD1","CH_GB18_A_23:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-07","text":"Quality is displaced from a supposed inwardness into the order of relational exponents, but returns as an irreducible remainder once quantitative and electrochemical reductions fail.","refs":["CH_GB18_BDMA:ME2","CH_GB18_A_23:A15","CH_GB18_A_23:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RMD-08","text":"The closed system of measure disappears as an existing structure and remains as an attractor that is to order series without already being available through a uniform rule of calculation.","refs":["CH_GB18_A_23:D10","CH_GB18_A_23:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_31:CGD-01","text":"Chemical and musical examples remain local realizations; at the cluster level, only their common structure of serial relation, quantitatively grounded quality, and non-trivial selection scales upward.","refs":["CH_GB18_CWAH:ME5","CH_GB18_A_23:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:CGD-02","text":"Berthollet's concept of mass, atomism, and electrochemism remain local theoretical targets; what scales upward is the criterion that an explanation must preserve empirical invariances without annulling specific differences.","refs":["CH_GB18_A_23:AS4","CH_GB18_A_23:AS5","CH_GB18_A_23:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:CGD-03","text":"The identity of extensive and intensive magnitude is a local transitional mechanism; globally load-bearing is the consequent impossibility of securing exclusivity through mere quantitative renaming.","refs":["CH_GB18_CWAH:A8","CH_GB18_CWAH:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:CGD-04","text":"The formation of series scales fully upward because it joins self-determination, comparability, multiple relation, and empirical lawfulness of proportion in a common architecture.","refs":["CH_GB18_BDMA:D3","CH_GB18_A_23:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:CGD-05","text":"Specific gravity does not replace the architecture of affinity, but marks its extension of domain from discrete counter-relations to inseparable and continuously variable moments of measure.","refs":["CH_GB18_A_23:A16","CH_GB18_A_23:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:CGD-06","text":"The concrete law of selection and series remains expressly underdetermined at the lower level and must not be recoded at the cluster level as an already achieved synthesis.","refs":["CH_GB18_CWAH:MRT2","CH_GB18_A_23:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_31:GNX-01","text":"Qualitative identity is neither an isolated property of substance nor immediate simplicity, but can be determined only as relational difference and serial function. ; Trace Type — Negative","refs":["CH_GB18_CWAH:NX1","CH_GB18_A_23:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GNX-02","text":"Neither a single ratio-number nor an externally posited standard can fully express the peculiarity or comparability of self-subsistent measures. ; Trace Type — Negative","refs":["CH_GB18_BDMA:NX1","CH_GB18_BDMA:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GNX-03","text":"Quantitative continuity, increase of intensity, and combinable magnitude do not by themselves furnish a principle of qualitative exclusivity. ; Trace Type — Negative","refs":["CH_GB18_CWAH:NX3","CH_GB18_CWAH:NX5","CH_GB18_CWAH:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GNX-04","text":"Atomistic arrangement, corpuscular juxtaposition, and electrical neutralization are excluded insofar as they replace the specific difference of chemical combination with an alien model. ; Trace Type — Negative","refs":["CH_GB18_A_23:NX8","CH_GB18_A_23:NX9","CH_GB18_A_23:NX10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:GNX-05","text":"A definitive principle of selection can be derived neither from saturation numbers nor from effectiveness of mass, circumstances, or mere series of proportions. ; Trace Type — Negative","refs":["CH_GB18_A_23:NX5","CH_GB18_A_23:DNX3","CH_GB18_CWAH:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_31:DBN-01","text":"For the architecture to hold, the notion that relations are subsequently added to already fully determined bearers must be false. ; Trace Type — Negative","refs":["CH_GB18_BDMA:DNX2","CH_GB18_A_23:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:DBN-02","text":"Equally inadmissible is the assumption that numbers are conceptless data; they must be legible as function-dependent exponents of a relational order. ; Trace Type — Negative","refs":["CH_GB18_BDMA:D5","CH_GB18_A_23:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:DBN-03","text":"The validity of a law of proportion must not compel a determinate ontology of its bearers, because otherwise empirical invariance would be confused with a hypothetical explanatory image. ; Trace Type — Negative","refs":["CH_GB18_A_23:SD2","CH_GB18_A_23:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:DBN-04","text":"A conclusive reconciliation of indifference and exclusivity cannot be admitted, since precisely their renewed reversal generates the movement of the system. ; Trace Type — Negative","refs":["CH_GB18_CWAH:SNX4","CH_GB18_CWAH:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_31:BSA-01","text":"The deepest structuring absence is the unavailable immanent law that could produce serial invariance, concrete selection of affinity, and non-additive mixture from a common principle. ; Trace Type — Negative","refs":["CH_GB18_A_23:A18","CH_GB18_A_23:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:BSA-02","text":"Ontologically impermissible is an absolutely immediate quality that would be fully determined prior to relation, series, comparison, and quantitative articulation. ; Trace Type — Negative","refs":["CH_GB18_BDMA:SNX1","CH_GB18_CWAH:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:BSA-03","text":"Unavailable remains an absolute priority that would be neither mediated in the form of measure nor relativized by conditions and yet would necessarily select a determinate combination. ; Trace Type — Negative","refs":["CH_GB18_BDMA:SNX2","CH_GB18_CWAH:SNX5","CH_GB18_A_23:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_31:XD-01","text":"Serial quality transforms every supposedly self-subsistent bearer into a node of counter-series, whose identity is determined at once by its own exponents and by its function in alien series. ; Trace Type — Composite","refs":["CL_GB18_31:GA-01","CL_GB18_31:GA-02","CL_GB18_31:GA-03","CH_GB18_BDMA:D2","CH_GB18_CWAH:SD4","CH_GB18_A_23:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:XD-02","text":"The possibility of several partners of neutralization separates the stable order of saturation from the unstable order of preference: lawfulness of proportion determines possible combinations, but not by itself their actual priority. ; Trace Type — Composite","refs":["CL_GB18_31:GA-02","CL_GB18_31:GA-08","CL_GB18_31:GA-09","CH_GB18_CWAH:D6","CH_GB18_A_23:D2","CH_GB18_A_23:NX5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:XD-03","text":"Measure produces exclusivity only precariously because its discontinuous exponent operates within the same quantitative field that permits alternative portionings, partners, and circumstances. ; Trace Type — Tension","refs":["CL_GB18_31:GA-06","CL_GB18_31:GA-07","CL_GB18_31:GA-08","CH_GB18_BDMA:A11","CH_GB18_CWAH:A11","CH_GB18_A_23:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:XD-04","text":"Serial invariance grounds comparability and empirical lawfulness, but underdetermines the ontology of the compared bearers; therefore the same law can outlast competing or insufficient explanatory images. ; Trace Type — Composite","refs":["CL_GB18_31:GA-04","CL_GB18_31:GA-09","CH_GB18_BDMA:A6","CH_GB18_A_23:A8","CH_GB18_A_23:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:XD-05","text":"According to Berthollet's account, mass and circumstances alter effectiveness and observed exclusion without altering the underlying proportions of saturation; observed selection and formal order of measure therefore diverge. ; Trace Type — Tension","refs":["CL_GB18_31:GA-08","CL_GB18_31:GA-09","CH_GB18_A_23:A8","CH_GB18_A_23:A9","CH_GB18_A_23:NX7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:XD-06","text":"The extension to specific gravities shows that discrete series of substances and continuous relations of mixture share the same demand for an immanent generative principle without obeying the same simple form of calculation. ; Trace Type — Composite","refs":["CL_GB18_31:GA-10","CL_GB18_31:GA-11","CH_GB18_BDMA:SD1","CH_GB18_A_23:SD4","CH_GB18_A_23:D9"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_31:BSD-01","text":"The being posited as self-subsistent becomes a relational functional node: its identity is the stable organizational form of its relations and not a relationless core.","refs":["CL_GB18_31:GA-01","CL_GB18_31:GA-03","CL_GB18_31:GA-05","CH_GB18_BDMA:SD3","CH_GB18_CWAH:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:BSD-02","text":"Causality is stratified into relational possibility, specification in the form of measure, qualitative priority, and context-dependent actualization; none of these strata can by itself produce elective affinity.","refs":["CL_GB18_31:GA-06","CL_GB18_31:GA-08","CL_GB18_31:GA-09","CH_GB18_A_23:SD3","CH_GB18_A_23:D7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:BSD-03","text":"Epistemically, knowledge of exact series is weaker than knowledge of their generative law, but stronger than speculative ontologies that do not preserve empirically determined differences.","refs":["CL_GB18_31:GA-09","CL_GB18_31:GA-11","CH_GB18_A_23:ALT5","CH_GB18_A_23:SD6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:BSD-04","text":"The logical time of the system is not a linear succession, but a sequence of repeated reversals in which every acquired determination is destabilized by its own quantitative mediation and reconstructed at a higher level.","refs":["CL_GB18_31:GA-06","CL_GB18_31:GA-07","CL_GB18_31:GA-08","CH_GB18_CWAH:D7","CH_GB18_CWAH:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_31:BSD-05","text":"Methodologically, the system produces an open closure: it determines which explanations are inadequate and what form a sufficient law would have to possess, without itself providing this law.","refs":["CL_GB18_31:GA-09","CL_GB18_31:GA-11","CH_GB18_A_23:ALT3","CH_GB18_A_23:MRT6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_31:RLE-01","text":"Relational determination produces a loop: one member is determined by others, itself functions as unity in relation to them, and thereby returns as a condition of the order that determines it.","refs":["CH_GB18_BDMA:A7","CH_GB18_CWAH:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RLE-02","text":"The escalation from the single exponent to the series and from the series to invariance between series transforms mere relation into a recursive second-order order of measure.","refs":["CH_GB18_BDMA:AS2","CH_GB18_BDMA:AS4","CH_GB18_BDMA:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RLE-03","text":"Neutrality forms a feedback loop with exclusivity: indifferent combination produces negative unity, whose quantitative ground in turn releases alternative combinations.","refs":["CH_GB18_BDMA:AS6","CH_GB18_CWAH:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RLE-04","text":"Quantity, quality, and measure do not form a three-step sequence with an endpoint, but a spiral in which each determination brings forth the next and is limited by it.","refs":["CH_GB18_CWAH:AS6","CH_GB18_CWAH:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RLE-05","text":"The critique of theory proceeds recursively: a model is tested against the laws of proportion, loses its claim when it effaces specific differences, and thereby renews the demand for a more immanent theory.","refs":["CH_GB18_A_23:SD2","CH_GB18_A_23:SD6","CH_GB18_A_23:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:RLE-06","text":"The conceptual attractor is a system of measure that integrates abstract series, concrete affinities, and relations of mixture; every extension of domain approaches it without completing it.","refs":["CH_GB18_A_23:A18","CH_GB18_A_23:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_31:FGS-B01","text":"Isolated quality → relational non-self-subsistence → specific determination through behaviour toward what is other.","refs":["CH_GB18_CWAH:NX1","CH_GB18_A_23:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FGS-B02","text":"Individual relation → insufficient exponent → multiplication of partners → series of exponents and counter-series.","refs":["CH_GB18_BDMA:A4","CH_GB18_CWAH:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FGS-B03","text":"Formation of series → relation between exponents → constant invariance → comparability and lawfulness of proportion.","refs":["CH_GB18_BDMA:A6","CH_GB18_A_23:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FGS-B04","text":"Neutral mediation → double negation → excluding unity → discontinuous exponent of measure → elective affinity.","refs":["CH_GB18_BDMA:A11","CH_GB18_CWAH:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FGS-B05","text":"Excluding exponent → alternative portioning and multiple neutralization → conditioning by mass and circumstances → renewed relativization of exclusion.","refs":["CH_GB18_CWAH:A11","CH_GB18_A_23:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FGS-B06","text":"Persisting laws of proportion + failure of reductive ontologies + extension to measures of mixture → open demand for an immanent, not merely additive system of measure.","refs":["CH_GB18_A_23:SD2","CH_GB18_A_23:A17","CH_GB18_A_23:A18"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_31:AFM-B01","text":"Isolated determinacy → relational re-determination → serial expansion → invariance between series → quantitative bearing of quality → excluding exponent of measure → elective affinity → combinatorial and situational relativization.","refs":["CH_GB18_BDMA:AF1","CH_GB18_BDMA:AF6","CH_GB18_CWAH:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:AFM-B02","text":"Empirical series of proportions → separation of law and image of bearer → critique of reductive models → return of irreducible quality → extension to specific gravities and mixtures → open demand for a system of measure.","refs":["CH_GB18_A_23:AF1","CH_GB18_A_23:ME6","CH_GB18_A_23:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_31:MME-01","text":"Quality is remapped from an inner property into an invariant yet mutation-capable order of quantitative relations.","refs":["CH_GB18_BDMA:SD2","CH_GB18_A_23:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MME-02","text":"The opposition between qualitative inwardness and quantitative externality collapses; in its place arises the distinction between mere magnitude, specification in the form of measure, and irreducible qualitative priority.","refs":["CH_GB18_BDMA:ME2","CH_GB18_A_23:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MME-03","text":"Comparability and selection are separated: common serial invariance enables comparison, but does not yet decide which possible combination is actualized exclusively.","refs":["CH_GB18_BDMA:ME3","CH_GB18_CWAH:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MME-04","text":"Empirical law and explanatory ontology are decoupled, whereby numerical series function as a criterion for testing competing models rather than as proof of atomic or electrical images of bearers.","refs":["CH_GB18_A_23:ME2","CH_GB18_A_23:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MME-05","text":"The field of measure now includes both relations between apparently self-subsistent members and inseparable and continuously variable moments within one body.","refs":["CH_GB18_A_23:SD4","CH_GB18_A_23:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_31:ALT-B01","text":"[Surface level] Saturation, neutralization, elective affinity, chemical mass, laws of proportion, atomism, electrochemism, and specific gravities constitute the explicit objects.","refs":["CH_GB18_A_23:ALT1","CH_GB18_A_23:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:ALT-B02","text":"[Structural level] Counter-series, exponents, quantities of neutralization, invariances, and context-dependent effects constitute a distributed system in which quality is produced and selection is simultaneously destabilized.","refs":["CH_GB18_CWAH:ALT2","CH_GB18_A_23:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:ALT-B03","text":"[Metastrategic level] Interpretation becomes the test of whether a model preserves empirical regularity, explains relational difference, and does not presuppose exclusion through mere renaming.","refs":["CH_GB18_CWAH:ALT3","CH_GB18_A_23:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:ALT-B04","text":"[Ontological / Temporal level] Reality consists of relationally determined moments of measure, whose forms become temporal-logical through repeated reversals between indifference, specification, and exclusion.","refs":["CH_GB18_BDMA:ALT4","CH_GB18_CWAH:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:ALT-B05","text":"[Methodological / Performative level] The form of the system enacts its thesis by refuting, extending, and bringing every initially sufficient determination to a more complex relational order through its own domain of application.","refs":["CH_GB18_CWAH:D7","CH_GB18_CWAH:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_31:FL-01","text":"Self-subsistence is to be preserved although its specific determinacy lies exclusively in externally articulated relations and series. ; Trace Type — Tension","refs":["CH_GB18_BDMA:MRT6","CH_GB18_BDMA:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FL-02","text":"The exponent of measure is to secure exclusivity, yet the indifference of alternative partners of neutralization relativizes precisely the exclusion produced by it. ; Trace Type — Tension","refs":["CH_GB18_CWAH:D5","CH_GB18_CWAH:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FL-03","text":"Berthollet's externalization of observed exclusion collides with the assertion that a non-merely-quantitative order begins with the qualitative. ; Trace Type — Tension","refs":["CH_GB18_A_23:MRT3","CH_GB18_A_23:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:FL-04","text":"The methodological autonomy of the laws of proportion protects them from speculative ontologies, but itself supplies no positive theory of specific qualitative difference. ; Trace Type — Tension","refs":["CH_GB18_A_23:SD2","CH_GB18_A_23:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MP-01","text":"The individual ratio-number mutates from the supposedly adequate determination of measure into the insufficient member of a whole series of exponents. ; Trace Type — Tension","refs":["CH_GB18_BDMA:AS2","CH_GB18_BDMA:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MP-02","text":"Neutrality mutates from the condition of relational self-preservation into the point of departure of excluding negativity and finally into the mechanism of renewed indifference. ; Trace Type — Tension","refs":["CH_GB18_BDMA:A1","CH_GB18_BDMA:AS6","CH_GB18_CWAH:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MP-03","text":"Measure mutates from a constant serial invariance into an excluding operator of discontinuity and further into an open problem of concrete selection of affinity. ; Trace Type — Tension","refs":["CH_GB18_BDMA:AF4","CH_GB18_CWAH:A10","CH_GB18_CWAH:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MP-04","text":"With specific gravity, measure changes its domain from relations of separate substances to inseparable moments of bodies, without the earlier logic of affinity being simply transferable. ; Trace Type — Tension","refs":["CH_GB18_A_23:SD4","CH_GB18_A_23:A16"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_31:HSI-01","text":"Reality appears as a recursive network of series of measure in which every member is at once determinate unity, exponent for what is other, and moment of overarching orders of comparison.","refs":["CH_GB18_BDMA:A7","CH_GB18_BDMA:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:HSI-02","text":"The self-subsistent member is not a closed particle, but a relational centre that exists only through the stability and difference of its modes of behaviour.","refs":["CH_GB18_BDMA:SD3","CH_GB18_CWAH:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:HSI-03","text":"The presupposed time is spiral-shaped: determinations return in altered form because quantity produces quality, measure excludes it, and quantitative indifference reopens exclusion.","refs":["CH_GB18_CWAH:SD5","CH_GB18_CWAH:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:HSI-04","text":"Navigation remains possible through reconstruction of serial invariances, testing of explanatory models, and distinction between formal possibility and actual selection; unavailable remains command over an absolute law of selection.","refs":["CH_GB18_BDMA:ALT3","CH_GB18_A_23:ALT3","CH_GB18_CWAH:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_31:MRT-B01","text":"The architecture is reconstructible at the cluster level if relational quality, serial order of exponents, serial invariance, unstable exclusivity, and the open demand for law are jointly preserved.","refs":["CH_GB18_BDMA:MRT1","CH_GB18_CWAH:MRT1","CH_GB18_A_23:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MRT-B02","text":"Its strongest connection lies in the derivation of qualitative determinacy from whole series of ratios and in the separation of empirical laws of proportion from reductive ontologies of bearers.","refs":["CH_GB18_BDMA:MRT5","CH_GB18_A_23:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MRT-B03","text":"What remains underdetermined is what actually gives a determinate affinity priority over other possibilities and whether observed exclusion is qualitatively essential or only conditional.","refs":["CH_GB18_CWAH:MRT2","CH_GB18_A_23:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MRT-B04","text":"Also underdetermined remain the conditions of delimiting series, of actual invariance between series, and of the common generation of discrete measures of affinity and continuous measures of mixture.","refs":["CH_GB18_BDMA:MRT3","CH_GB18_BDMA:MRT4","CH_GB18_A_23:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MRT-B05","text":"The coherence is conditional but not deficient: it depends on treating indifference and exclusivity as productive counter-effects of the same quantitative mediation rather than as definitively reconciled determinations.","refs":["CH_GB18_CWAH:MRT3","CH_GB18_CWAH:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_31:MRT-B06","text":"The concrete scientific determination of the immanent principle of measure resists axiomatic reduction; reconstruction preserves the system only if it retains this unavailability as a terminal structure and not as an already solved task.","refs":["CH_GB18_CWAH:DNX7","CH_GB18_A_23:A18","CH_GB18_A_23:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_31@R001","source_variant_id":"canonical:CL_GB18_31:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 91–93","context":"b. Das Maaß als Reihe von Maaßverhältnissen. · c. Wahlverwandtschaft. · Anmerkung."},"title_language_code":"en"},{"id":"CL_GB18_32","layer":"CL","title":"Chapters 94–96","order":32,"parents":["CH_GB18_BKVM","CH_GB18_A_24","CH_GB18_CDM0"],"revision":"CL_GB18_32@R001","sha256":"66f0e6d1a2d562286cbbba15b94b093f1021efc3874366bd60e557a9acd4f297","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_32:AS-B01","text":"Das Problem besteht darin, quantitative Veränderung so zu bestimmen, dass sie weder in bloßer Stetigkeit aufgeht noch als äußerliche Ursache qualitativer Differenz erscheint.","refs":["CH_GB18_BKVM:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:AS-B02","text":"Das Maaß wird als immanente Einheit von Qualität und Quantität rekonstruiert, deren quantitative Selbstäußerlichkeit eine Knotenlinie qualitativ verschiedener Verhältnisse produziert.","refs":["CH_GB18_BKVM:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:AS-B03","text":"Die Bewegung ist rekursiv: quantitative Variation erhält eine Qualität zunächst indifferent, überschreitet dann einen Maßpunkt, erzeugt einen Sprung und setzt die neue Qualität erneut der quantitativen Veränderung aus.","refs":["CH_GB18_BKVM:AS4","CH_GB18_BKVM:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:AS-B04","text":"Die Kritik der Allmählichkeit verhindert, dass qualitative Neuheit als bloß unbemerkte Vorform oder als graduelle Verlängerung des Vorhergehenden erklärt wird.","refs":["CH_GB18_A_24:AS4","CH_GB18_BKVM:NX8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:AS-B05","text":"Die unendliche Knotenlinie schließt sich nicht in einer letzten Qualität, sondern in der Rückkehr der wechselnden Maaße zu einem sich durch ihre Unterschiede erhaltenden Substrat.","refs":["CH_GB18_CDM0:AS5","CH_GB18_CDM0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:AS-B06","text":"Die Clusterarchitektur überführt das Maaß von einer selbstständigen qualitativen Bestimmung in eine Übergangsmaschine, deren Realisierung zugleich seine Herabsetzung zu einem Moment einer umfassenderen Einheit ist.","refs":["CH_GB18_CDM0:AS6","CH_GB18_CDM0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_32:GA-01","text":"[Persistent] Maaß ist keine äußerliche Zuordnung von Quantität und Qualität, sondern ihre immanente Einheit, in der jede Seite die andere bestimmen und aufheben kann.","refs":["CH_GB18_CDM0:A1","CH_GB18_CDM0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:GA-02","text":"[Persistent] Quantitative Kontinuität ist die Bedingung der Fortsetzung eines Verhältnisses, aber keine hinreichende Erklärung seiner qualitativen Identität.","refs":["CH_GB18_BKVM:D9","CH_GB18_A_24:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:GA-03","text":"[Mutating] Das Maaß produziert aus seiner eigenen Selbstäußerlichkeit mehrere Maaßverhältnisse auf demselben Substrat und verwandelt damit quantitative Variation in eine Knotenlinie.","refs":["CH_GB18_BKVM:AS3","CH_GB18_BKVM:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:GA-04","text":"[Attractor] Der Maßpunkt ist die immanente Schwelle, an der ein Quantum seine Gleichgültigkeit verliert und als spezifische Bestimmung wirksam wird.","refs":["CH_GB18_BKVM:A14","CH_GB18_A_24:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:GA-05","text":"[Persistent] Der qualitative Sprung ist keine Aufhebung der quantitativen Reihe, sondern deren Umschlag in eine neue Bestimmung innerhalb fortgesetzter Veränderung.","refs":["CH_GB18_A_24:D3","CH_GB18_BKVM:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:GA-06","text":"[Emergent] Das Maaßlose ist nicht Bestimmungslosigkeit, sondern die negative Übergangsform, in der ein bisheriges Maaß seine Geltung verliert und ein neues spezifisches Verhältnis hervortritt.","refs":["CH_GB18_CDM0:AS2","CH_GB18_CDM0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:GA-07","text":"[Mutating] Jede qualitative Selbstständigkeit wird durch die Wiederholung des Umschlags zu einem Zustand eines fortbestehenden Substrats relativiert.","refs":["CH_GB18_CDM0:D6","CH_GB18_CDM0:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:GA-08","text":"[Terminal] Die Vollendung der Maaßlogik besteht nicht in einem letzten Maaß, sondern in der Einsicht, dass jedes Maaß nur Moment einer sich selbst erhaltenden Einheit ist.","refs":["CH_GB18_CDM0:SNX3","CH_GB18_CDM0:D9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_32:RMD-01","text":"Die Knotenlinie bleibt als stabile Identität erhalten, mutiert jedoch von einer Reihe qualitativer Umschläge zu einer Struktur, in der die Reihe selbst auf die Einheit ihres Substrats zurückverweist.","refs":["CH_GB18_BKVM:SD5","CH_GB18_CDM0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:RMD-02","text":"Der Sprung kehrt funktional wieder: zunächst als Grenzereignis einer einzelnen Qualität, dann als allgemeine Struktur von Natur, Moral und Staat.","refs":["CH_GB18_BKVM:AS5","CH_GB18_A_24:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:RMD-03","text":"Das Maaßlose kehrt nicht als bloßer Gegensatz des Maaßes wieder, sondern als dessen produktive Selbstnegation und Übergang in ein neues Maaßverhältnis.","refs":["CH_GB18_CDM0:A5","CH_GB18_CDM0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:RMD-04","text":"Das Substrat verschiebt seine Funktion von der qualitativen Grundlage der Maaßreihe zur Instanz, welche die Selbstständigkeit der einzelnen Maaße absorbiert.","refs":["CH_GB18_BKVM:A8","CH_GB18_CDM0:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_32:CGD-01","text":"Die Bestimmung einzelner quantitativer Mischungs-, Größen- oder Wahlverwandtschaftsverhältnisse bleibt lokal, weil sie die konkrete Zusammensetzung eines Maaßes beschreibt, nicht die generative Logik der Maaßreihe.","refs":["CH_GB18_BKVM:A4","CH_GB18_CDM0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:CGD-02","text":"Auf Clusterebene trägt allein die Beziehung zwischen quantitativer Fortsetzung, Maßpunkt, qualitativem Sprung und erneuter Maaßlosigkeit die Gesamtarchitektur.","refs":["CH_GB18_BKVM:FGS3","CH_GB18_CDM0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:CGD-03","text":"Die Ausdehnung auf moralische und staatliche Übergänge ist kein zusätzlicher Gegenstandsbereich, sondern der Nachweis, dass die Maßlogik nicht an Naturverhältnisse gebunden bleibt.","refs":["CH_GB18_A_24:SD5","CH_GB18_A_24:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_32:GNX-01","text":"Ausgeschlossen wird ein Modell, in dem quantitative Nähe bereits qualitative Identität oder Vorhandensein der künftigen Qualität bedeutet.","refs":["CH_GB18_BKVM:NX6","CH_GB18_A_24:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:GNX-02","text":"Ausgeschlossen wird eine Erklärung, die qualitative Neuheit durch eine unendliche Verlängerung gradueller Zwischenstufen ersetzt.","refs":["CH_GB18_BKVM:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:GNX-03","text":"Ausgeschlossen wird sowohl die absolute Unabhängigkeit einzelner Qualitäten als auch die Vorstellung eines rein quantitativen Progresses ohne qualitative Umschläge.","refs":["CH_GB18_CDM0:NX6","CH_GB18_CDM0:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_32:DBN-01","text":"Damit die Maaßlogik Bestand hat, darf qualitative Differenz weder als äußerlich hinzugefügte Bestimmung noch als bloß epistemisch unbemerkter Grad erscheinen.","refs":["CH_GB18_BKVM:DNX1","CH_GB18_A_24:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:DBN-02","text":"Unzulässig ist ein Substrat, das außerhalb seiner eigenen Spezifikation unverändert bliebe; seine Identität muss gerade durch qualitative Wechsel hindurch bestehen.","refs":["CH_GB18_BKVM:DNX4","CH_GB18_CDM0:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:DBN-03","text":"Unzulässig ist ein letztes Maaß, weil jede spezifische Bestimmung durch ihre quantitative Veränderbarkeit bereits den Übergang über sich hinaus enthält.","refs":["CH_GB18_BKVM:DNX7","CH_GB18_CDM0:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_32:BSA-01","text":"Verneint wird die Möglichkeit einer Realität, in der Veränderung vollständig als homogene Skala gradueller Unterschiede verfügbar wäre.","refs":["CH_GB18_BKVM:SNX1","CH_GB18_A_24:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:BSA-02","text":"Verneint wird die Möglichkeit einer endgültigen qualitativen Selbstständigkeit, weil jede Qualität zugleich durch Quantität bedroht, vermittelt und zu einem Zustand herabgesetzt wird.","refs":["CH_GB18_CDM0:NX2","CH_GB18_CDM0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_32:XD-01","text":"Die Knotenlinie erhält ihre volle Funktion erst dadurch, dass die qualitative Sprunghaftigkeit zugleich als allgemein übertragbare Maßstruktur und als Rückkehrbewegung eines gemeinsamen Substrats bestimmt wird.","refs":["CL_GB18_32:GA-03","CL_GB18_32:GA-05","CL_GB18_32:GA-07","CH_GB18_A_24:SD5","CH_GB18_CDM0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_32:XD-02","text":"Die Kritik der Allmählichkeit wird durch die Bestimmung des Maaßlosen verschärft: Nicht nur erklärt Gradualismus keinen Sprung, sondern er verkennt die negative Übergangsarbeit, durch die ein Maaß seine Geltung verliert.","refs":["CL_GB18_32:GA-06","CH_GB18_A_24:D4","CH_GB18_CDM0:FGS2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_32:XD-03","text":"Die allgemeine Geltung der Maßlogik erzeugt keine Gleichförmigkeit der Bereiche, sondern verschiebt Natur, Moral und Staat in denselben Typus schwellenabhängiger Transformation.","refs":["CL_GB18_32:GA-04","CL_GB18_32:GA-05","CH_GB18_A_24:ME5","CH_GB18_A_24:A9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_32:XD-04","text":"Die Identität des Gegenstands wird vom Erhalt einer bestimmten Qualität auf die Kontinuität eines Substrats durch wechselnde qualitative Zustände verlagert.","refs":["CL_GB18_32:GA-07","CL_GB18_32:GA-08","CH_GB18_CDM0:D7","CH_GB18_CDM0:ME5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_32:BSD-01","text":"Realität erscheint als gestufte Transformationsordnung, in der quantitative Prozesse nicht unterhalb der Qualität liegen, sondern deren immanente Produktions- und Zerstörungsbedingungen bilden.","refs":["CH_GB18_CDM0:SD3","CH_GB18_CDM0:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:BSD-02","text":"Zeit wird als nichtlinearer Fortgang bestimmt: Sie ist quantitative Kontinuität, qualitative Unterbrechung und rekursive Rückkehr zugleich.","refs":["CH_GB18_A_24:ALT4","CH_GB18_CDM0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:BSD-03","text":"Handlungsmacht kann nicht als bloße Steigerung innerhalb bestehender Bestimmungen begriffen werden, weil Größenveränderungen die Form des Handelns, der Moral und der politischen Ordnung umkehren können.","refs":["CH_GB18_A_24:A9","CH_GB18_A_24:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_32:RLE-01","text":"Die zentrale Schleife lautet: Maaß → quantitative Variation → Gleichgültigkeitsbereich → Maßpunkt → Sprung → neues Maaß → erneute Variation.","refs":["CH_GB18_BKVM:FGS3","CH_GB18_CDM0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:RLE-02","text":"Das Maaßlose fungiert als Attraktor negativer Produktion, weil jedes Maaß im Vollzug seiner Veränderung notwendig in die Bestimmung übergeht, die es überschreitet.","refs":["CH_GB18_CDM0:FGS2","CH_GB18_CDM0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:RLE-03","text":"Die Eskalation endet nicht bei der Vervielfältigung der Maaße, sondern bei ihrer Reorganisation als Zustände eines Substrats, das die Reihe trägt und ihre Selbstständigkeit entzieht.","refs":["CH_GB18_CDM0:D6","CH_GB18_CDM0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_32:FGS-B01","text":"Qualität-Quantität-Einheit → quantitative Selbstäußerlichkeit → mehrere Maaßverhältnisse auf gemeinsamem Substrat.","refs":["CH_GB18_BKVM:A8","CH_GB18_BKVM:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:FGS-B02","text":"Quantitative Variation → relative qualitative Gleichgültigkeit → spezifischer Maßpunkt → qualitativer Sprung.","refs":["CH_GB18_BKVM:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:FGS-B03","text":"Qualitativer Sprung → Maaßlosigkeit gegenüber dem Vorherigen → neues spezifisches Maaßverhältnis → Wiederholung der Knotenlinie.","refs":["CH_GB18_CDM0:A7","CH_GB18_CDM0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:FGS-B04","text":"Unendliche Wiederholung → gegenseitige Aufhebung von Qualität und Quantität → Rückkehr der Einheit → Substratkontinuität → Herabsetzung des Maaßes zum Moment.","refs":["CH_GB18_CDM0:FGS5","CH_GB18_CDM0:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_32:AFM-B01","text":"Ausschließendes Maaßverhältnis → quantitative Affinität und innere Trennbarkeit → Selbstabstoßung des Maaßes.","refs":["CH_GB18_BKVM:FGS1","CH_GB18_BKVM:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:AFM-B02","text":"Selbstabstoßung → Knotenlinie mehrerer Maaße → quantitative Veränderung innerhalb qualitativer Indifferenzbereiche.","refs":["CH_GB18_BKVM:FGS2","CH_GB18_BKVM:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:AFM-B03","text":"Maßpunkt → qualitativer Sprung → Kritik der Allmählichkeit als Tilgung wirklichen Werdens.","refs":["CH_GB18_A_24:FGS3","CH_GB18_A_24:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:AFM-B04","text":"Maaßlosigkeit → unendliche Knotenreihe → Rückkehr zum Substrat → Entselbstständigung des Maaßes.","refs":["CH_GB18_CDM0:AF1","CH_GB18_CDM0:D9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_32:MME-01","text":"Quantitative Reihen werden als gegliederte Felder von Schwellen kartiert und verlieren ihren Status als homogenes Kontinuum.","refs":["CH_GB18_A_24:ME1","CH_GB18_A_24:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:MME-02","text":"Qualitäten werden von isolierten Wesenheiten zu temporären Zuständen eines gemeinsamen, sich erhaltenden Substrats umklassifiziert.","refs":["CH_GB18_CDM0:ME4","CH_GB18_CDM0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:MME-03","text":"Die Alternative zwischen Kontinuität und Diskontinuität zerfällt, weil Kontinuität die Trägerstruktur und Diskontinuität die spezifische Form qualitativen Werdens bildet.","refs":["CH_GB18_BKVM:SD2","CH_GB18_A_24:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_32:ALT-B01","text":"Surface level — Größenveränderung kann eine bestehende Qualität verändern, aufheben oder in ihr Gegenteil verkehren.","refs":["CH_GB18_CDM0:D1","CH_GB18_CDM0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:ALT-B02","text":"Structural level — Maaß, Maßpunkt, Knotenlinie und Substrat bilden eine Vermittlungsarchitektur, in der quantitative und qualitative Bestimmungen ineinander übergehen.","refs":["CH_GB18_CDM0:ALT2","CH_GB18_CDM0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:ALT-B03","text":"Metastrategic level — Das System ersetzt die Frage nach gradueller Zunahme durch die Frage nach den immanenten Grenzen, an denen eine Ordnung ihre eigene qualitative Geltung verliert.","refs":["CH_GB18_A_24:ALT3","CH_GB18_A_24:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:ALT-B04","text":"Ontological / Temporal level — Wirklichkeit ist ein unendlicher Wechsel von quantitativer Fortsetzung und qualitativer Unterbrechung, dessen Identität nicht starre Qualität, sondern rückkehrende Einheit ist.","refs":["CH_GB18_CDM0:AS4","CH_GB18_CDM0:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:ALT-B05","text":"Methodological / Performative level — Die Form vollzieht ihre These, indem sie den Begriff des Maaßes zunächst ausdifferenziert, dann durch wiederholte Umschläge entgrenzt und schließlich in eine übergeordnete Einheit zurücknimmt.","refs":["CH_GB18_CDM0:AF1","CH_GB18_CDM0:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_32:FL-01","text":"Die Konstruktion verlangt zugleich, dass die neue Qualität quantitativ vermittelt ist und dass sie nicht aus der vorhergehenden Qualität hervorgeht.","refs":["CH_GB18_BKVM:MRT6","CH_GB18_BKVM:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:FL-02","text":"Die Knotenreihe muss als unendlicher Fortschritt auftreten und zugleich als Rückkehr der Maaßeinheit in sich selbst bestimmt werden.","refs":["CH_GB18_CDM0:MRT6","CH_GB18_CDM0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:FL-03","text":"Das Substrat soll durch qualitative Wechsel produktiv bestimmt sein, muss aber als dasselbe fortbestehen, damit die Maaße zu seinen Zuständen herabgesetzt werden können.","refs":["CH_GB18_BKVM:MRT5","CH_GB18_CDM0:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:MP-01","text":"Das Maaß mutiert von der qualitativen Grundlage der Selbstabstoßung zu einem bloßen Moment des Substrats, das es zunächst selbst erzeugt zu haben scheint.","refs":["CH_GB18_BKVM:A9","CH_GB18_CDM0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:MP-02","text":"Das Maaßlose mutiert von abstrakter quantitativer Gleichgültigkeit zu einer produktiven Bestimmung, die den Übergang in neue Qualität trägt.","refs":["CH_GB18_CDM0:A5","CH_GB18_CDM0:A6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_32:HSI-01","text":"Die Realität erscheint als eine Maschine von Schwellen, in der quantitative Bewegungen qualitative Gestalten erzeugen, zerstören und erneut hervorbringen.","refs":["CH_GB18_BKVM:SD1","CH_GB18_CDM0:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:HSI-02","text":"Das Subjekt oder der Gegenstand erscheint nicht als unveränderliche Substanz, sondern als sich durch Zustandswechsel erhaltende Einheit.","refs":["CH_GB18_CDM0:D7","CH_GB18_CDM0:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:HSI-03","text":"Zeit ist weder bloß linear noch bloß zyklisch, sondern eine Spiralstruktur, in der Wiederholung qualitative Differenz erzeugt und Differenz in eine erneuerte Einheit zurückkehrt.","refs":["CH_GB18_BKVM:A17","CH_GB18_CDM0:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_32:MRT-B01","text":"Die rekonstruierten Axiome sind hinreichend, sofern Maaß als Einheit, Maßpunkt als Umschlag, Maaßlosigkeit als negative Übergangsform und Substrat als Rückkehrinstanz gemeinsam gesetzt werden.","refs":["CH_GB18_CDM0:MRT1","CH_GB18_CDM0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:MRT-B02","text":"Unterbestimmt bleibt die konkrete Bestimmung einzelner Maßpunkte, weil die Architektur ihre Notwendigkeit ausweist, aber ihre empirische oder sachlogische Spezifikation nicht vollständig liefert.","refs":["CH_GB18_A_24:MRT2","CH_GB18_CDM0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_32:MRT-B03","text":"Die stärkste Rekonstruktionsleistung liegt in der Verbindung von Sprung und Kontinuität; ihre irreduzible Spannung liegt in der Gleichzeitigkeit realer qualitativer Differenz und substantieller Selbigkeit.","refs":["CH_GB18_BKVM:MRT4","CH_GB18_CDM0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 94–96","context":"B. Knotenlinie von Maaßverhältnissen. · Anmerkung. · C. Das Maaßlose."},"title_language_code":"en"},{"id":"CL_GB18_33","layer":"CL","title":"Chapters 97–99","order":33,"parents":["CH_GB18_DAI0","CH_GB18_BDIA","CH_GB18_A_25"],"revision":"CL_GB18_33@R001","sha256":"332bda10608d4f56f0b5df3b256ddbf51e6efe550f4ebae049fa5cc639471c65","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_33:AS-01","text":"Das Cluster löst das Problem, wie eine Einheit Unterschiede tragen kann, ohne sie lediglich als äußerliche Zustände eines vorausgesetzten Substrats zu beherbergen.","refs":["CH_GB18_DAI0:AS4","CH_GB18_BDIA:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AS-02","text":"Die absolute Indifferenz wird von abstrakter Bestimmungslosigkeit zu einer Einheit umbestimmt, die erst als Resultat ihrer Negation und Vermittlung konkret ist.","refs":["CH_GB18_DAI0:AS3","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AS-03","text":"Quantität ist weder hinreichende Bestimmung noch neutrale Vergleichsform, sondern das Feld, in dem äußerliche Bestimmtheit in ein negatives Verhältnis übergeht.","refs":["CH_GB18_DAI0:AS2","CH_GB18_BDIA:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AS-04","text":"Das umgekehrte Verhältnis macht sichtbar, dass untrennbare qualitative Faktoren keine dauerhafte quantitative Selbständigkeit besitzen und deshalb die Indifferenz als Widerspruch destabilisieren.","refs":["CH_GB18_BDIA:AS4","CH_GB18_BDIA:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AS-05","text":"Die Kräfteanalyse fungiert als immanenter Belastungstest: Eine Theorie, deren Faktoren die fortdauernde Bewegung aufheben müssten, kann deren Umschlag nicht erklären.","refs":["CH_GB18_A_25:AS1","CH_GB18_A_25:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AS-06","text":"Die Bewegung ist rekursiv: Äußerliche Bestimmung hebt sich auf, kehrt als leeres Unterscheiden zurück und schließt sich als negative Einheit statt als ruhende Indifferenz.","refs":["CH_GB18_DAI0:AS5","CH_GB18_BDIA:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_33:GA-01","text":"[Persistent] Konkrete Einheit besteht nur, sofern Differenz als Negation und Verhältnis in ihr selbst vermittelt bleibt.","refs":["CH_GB18_DAI0:A11","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-02","text":"[Mutating] Indifferenz mutiert vom nur an sich vorausgesetzten Substrat zum Resultat einer eigenen Selbstvermittlung.","refs":["CH_GB18_BDIA:AS2","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-03","text":"[Persistent] Qualitative Faktoren besitzen Realität nur in wechselseitiger Bezogenheit und können daher nicht als unabhängige Größen fortbestehen.","refs":["CH_GB18_BDIA:A7","CH_GB18_A_25:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-04","text":"[Mutating] Quantität wandelt sich von äußerlicher Aufnahmefähigkeit in die Form, durch welche der innere Widerspruch der Faktoren manifest wird.","refs":["CH_GB18_DAI0:AS2","CH_GB18_BDIA:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-05","text":"[Attractor] Das umgekehrte Verhältnis ist keine positive Kausalformel, sondern eine negative Prüfgestalt, die die Unzulänglichkeit äußerlicher Bewegungsmodelle enthüllt.","refs":["CH_GB18_BDIA:A6","CH_GB18_A_25:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-06","text":"[Emergent] Erklärung gilt nur, wenn sie den Übergang ihrer Bestimmungen immanent erzeugt und nicht die Fortdauer des Faktums gegen die Konsequenz ihrer Kategorien festhält.","refs":["CH_GB18_A_25:A4","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-07","text":"[Persistent] Weder Gleichgewicht noch dauerhaftes Übergewicht stabilisieren die Faktoren: Gleichheit löscht den Unterschied, Übergewicht die Gegenbestimmung.","refs":["CH_GB18_BDIA:A13","CH_GB18_BDIA:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-08","text":"[Terminal] Als Totalität ihrer Faktoren wird Indifferenz notwendig zum Widerspruch, der sich zur immanent negativen Einheit bestimmt.","refs":["CH_GB18_BDIA:A14","CH_GB18_BDIA:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-09","text":"[Attractor] Das Maß erscheint als verlorene Einheit von Qualität und Quantität, deren Zerfall jede abstrakte Indifferenz als unzureichend ausweist.","refs":["CH_GB18_A_25:A10","CH_GB18_A_25:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_33:RMD-01","text":"Bestimmtheit kehrt zunächst als äußerlicher Zustand, dann als Faktorenunterschied und zuletzt als kritisierte äußerliche Quantifizierung wieder; ihre Funktion verschiebt sich von Erscheinung zu diagnostischem Defekt.","refs":["CH_GB18_DAI0:AS4","CH_GB18_BDIA:AS4","CH_GB18_A_25:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RMD-02","text":"Indifferenz behält die Funktion der Einheit, mutiert jedoch von ungesetzter Vermittlung über widersprüchliche Totalität zur Diagnose abstrakter Substanz.","refs":["CH_GB18_BDIA:AS2","CH_GB18_BDIA:A14","CH_GB18_A_25:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RMD-03","text":"Quantität wandert von äußerlicher Bestimmbarkeit über negative Gegenseitigkeit zur destruktiven Abstraktion, sobald sie qualitativen Unterschied ersetzen soll.","refs":["CH_GB18_DAI0:AS2","CH_GB18_BDIA:AS3","CH_GB18_A_25:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RMD-04","text":"Negation mutiert von der Aufhebung unmittelbarer Kategorien zur Selbstaufhebung des Widerspruchs und schließlich zur Formalismusdiagnose einer widersprüchlichen Theorie.","refs":["CH_GB18_DAI0:AS3","CH_GB18_BDIA:AS6","CH_GB18_A_25:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RMD-05","text":"Das umgekehrte Verhältnis bleibt als Form erhalten, kehrt seine Valenz aber um: Innerhalb der Indifferenz exponiert es Widerspruch, als äußerliche Krafttheorie produziert es Erklärungsausfall.","refs":["CH_GB18_BDIA:A6","CH_GB18_A_25:AS1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_33:CGD-01","text":"Die bloße Fähigkeit der reinen Quantität, Bestimmungen äußerlich aufzunehmen, bleibt ein lokaler Ausgangsmechanismus und wird auf Clusterebene durch die Frage ihrer immanenten Vermittlung überholt.","refs":["CH_GB18_DAI0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:CGD-02","text":"Die Reduktion der Maaßverhältnisse und die feste Grenze des Substrats sind lokale Bedingungen; global entscheidend ist, dass diese Bedingungen die Bewegung der Momente noch nicht selbst bestimmen.","refs":["CH_GB18_BDIA:A1","CH_GB18_BDIA:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:CGD-03","text":"Die Analyse der Kräfte bleibt als Fall lokal, skaliert jedoch zu einem allgemeinen Kriterium dafür, ob eine Theorie qualitative Relationalität unzulässig in quantitative Faktoren übersetzt.","refs":["CH_GB18_A_25:ME2","CH_GB18_A_25:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:CGD-04","text":"Auf der Clusterebene trägt allein die gemeinsame These, dass äußere Zusammensetzung keinen immanenten Übergang erklären kann und daher in negative Selbstbeziehung übergehen muss.","refs":["CH_GB18_DAI0:A11","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_33:GNX-01","text":"Ausgeschlossen wird eine Indifferenz, die als passives Substrat unter ihren Bestimmungen verharrt und keine Selbstvermittlung vollzieht.","refs":["CH_GB18_DAI0:NX6","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GNX-02","text":"Ausgeschlossen wird die unabhängige quantitative Selbständigkeit qualitativ korrelierter Faktoren.","refs":["CH_GB18_BDIA:AS4","CH_GB18_A_25:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GNX-03","text":"Ausgeschlossen wird die Neutralisierung des Widerspruchs durch Gleichgewicht oder durch ein bloß zeitliches Nacheinander äußerlicher Übergewichte.","refs":["CH_GB18_BDIA:A13","CH_GB18_A_25:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GNX-04","text":"Ausgeschlossen wird die Koexistenz eines empirisch festgehaltenen Faktums mit einer Theorie, deren eigene Konsequenz dieses Faktum negiert.","refs":["CH_GB18_A_25:AS4","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_33:DBN-01","text":"Falsch sein muss, dass qualitative Abhängigkeit und quantitativ unabhängiges Mehr zugleich bestehen können.","refs":["CH_GB18_A_25:DNX1","CH_GB18_BDIA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:DBN-02","text":"Falsch sein muss, dass abstrakte Einheit durch einen nachträglich addierten quantitativen Unterschied zur konkreten Substanz wird.","refs":["CH_GB18_A_25:A8","CH_GB18_A_25:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:DBN-03","text":"Ausgeschlossen bleibt eine Einheit, die vor Negation vollständig gegeben wäre oder als endgültige Indifferenz fixiert werden könnte.","refs":["CH_GB18_DAI0:SNX3","CH_GB18_BDIA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_33:BSA-01","text":"Unverfügbar ist eine Substanz, die Unterschiede lediglich absorbiert und dennoch ihre konkrete Differenzierung aus sich selbst hervorbringen soll.","refs":["CH_GB18_A_25:SNX3","CH_GB18_A_25:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:BSA-02","text":"Unverfügbar ist ein stabiles Ganzes, dessen abhängige Momente zugleich als selbständige Ursachen auftreten und dessen Übergänge dennoch erklärbar bleiben sollen.","refs":["CH_GB18_A_25:SNX1","CH_GB18_A_25:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:BSA-03","text":"Unverfügbar ist die Wiederherstellung einer unmittelbaren Einheit von Qualität und Quantität, nachdem beide nur noch äußerlich getrennt bestimmt worden sind.","refs":["CH_GB18_A_25:SNX4","CH_GB18_A_25:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_33:XD-01","text":"Der äußerliche Zustand der Bestimmtheit und die äußerlich gesteuerte Bewegung der Faktoren bezeichnen denselben Mangel: Die Einheit kann ihre Veränderungen nicht erklären, solange sie nur Substrat bleibt.","refs":["CL_GB18_33:GA-02","CL_GB18_33:GA-06","CH_GB18_DAI0:AS4","CH_GB18_BDIA:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_33:XD-02","text":"Das umgekehrte Verhältnis besitzt eine doppelte Funktion: Als immanente Negativform legt es die Instabilität der Indifferenz frei; als äußerliche Erklärung transformiert es Gegenstandsbewegung in unverbundene Wechsel.","refs":["CL_GB18_33:GA-05","CL_GB18_33:GA-08","CH_GB18_BDIA:A6","CH_GB18_A_25:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_33:XD-03","text":"Die Kritik an der Krafttheorie wird zur kategorialen Diagnose: Wo qualitativer Gegensatz quantifiziert wird, verliert die Theorie zugleich den Umschlag der Bewegung und das Maß.","refs":["CL_GB18_33:GA-06","CL_GB18_33:GA-09","CH_GB18_A_25:D3","CH_GB18_A_25:D7"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_33:BSD-01","text":"Kausalität wird als immanente Selbsttransformation relationaler Bestimmungen bestimmt; bloße Aufeinanderfolge oder äußeres Kräftegleichgewicht besitzt keinen erklärenden Status.","refs":["CL_GB18_33:GA-01","CL_GB18_33:GA-06","CH_GB18_DAI0:A11","CH_GB18_A_25:A4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_33:BSD-02","text":"Realität erscheint als Totalität, in der jede Seite die ganze Einheit enthält und deshalb weder isoliert noch durch Addition anderer Seiten bestimmt werden kann.","refs":["CL_GB18_33:GA-03","CL_GB18_33:GA-08","CH_GB18_BDIA:A8","CH_GB18_BDIA:A9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_33:BSD-03","text":"Methodisch wird Erklärung von empirischer Treffgenauigkeit getrennt: Eine Gesetzesform gilt nur, wenn ihre Kategorien die Wirklichkeit, die sie beschreibt, nicht selbst zerstören.","refs":["CL_GB18_33:GA-05","CL_GB18_33:GA-06","CH_GB18_A_25:SD2","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_33:RLE-01","text":"Die zentrale Schleife verläuft von äußerlicher Bestimmung über Selbstaufhebung zu leerem Unterscheiden und von dort zur selbstvermittelten Indifferenz.","refs":["CH_GB18_DAI0:AS5","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RLE-02","text":"Das umgekehrte Verhältnis eskaliert von der festen Grenze zur quantitativen Gegenseitigkeit und endet in der doppelten Unmöglichkeit von Gleichgewicht und Übergewicht.","refs":["CH_GB18_BDIA:AS3","CH_GB18_BDIA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RLE-03","text":"Der Erklärungsausfall erzeugt eine Rückkopplung: Jede fremde Vermittlung, die den Umschlag retten soll, dokumentiert gerade den Verlust immanenter Erklärung.","refs":["CH_GB18_A_25:AS3","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RLE-04","text":"Das Maß wirkt als negativer Attraktor: Seine Auflösung zieht die Kritik äußerlicher Quantifizierung an und verweist auf eine Einheit, die weder abstrakt noch unmittelbar wiederherstellbar ist.","refs":["CH_GB18_A_25:A10","CH_GB18_A_25:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_33:FGS-B01","text":"Abstrakte Gleichgültigkeit des Seins + äußerliche Aufnahmefähigkeit der Quantität → Bestimmtheit ohne immanenten Zusammenhang.","refs":["CH_GB18_DAI0:AS1","CH_GB18_DAI0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:FGS-B02","text":"Äußerlicher Zustand des Substrats + feste Grenze des Ganzen → negative Abhängigkeit der Unterschiede.","refs":["CH_GB18_DAI0:AS4","CH_GB18_BDIA:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:FGS-B03","text":"Umgekehrtes Verhältnis + qualitative Untrennbarkeit → Unmöglichkeit stabiler quantitativer Selbständigkeit.","refs":["CH_GB18_BDIA:AS3","CH_GB18_BDIA:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:FGS-B04","text":"Selbstaufhebung der indifferenten Totalität + Kritik äußerlicher Erklärung → negative Einheit als Bedingung begrifflicher Bewegung.","refs":["CH_GB18_BDIA:A14","CH_GB18_A_25:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_33:AFM-B01","text":"Abstrakte Gleichgültigkeit → äußerliche Bestimmbarkeit → Indifferenz als Substrat → umgekehrtes Verhältnis → Widerspruch der Faktoren → negative Einheit.","refs":["CH_GB18_DAI0:AS1","CH_GB18_BDIA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AFM-B02","text":"Krafttheorie als äußerliche Erklärung → Verlust der immanenten Gegenstandsbewegung → Formalismusdiagnose → Kritik abstrakter Substanz → Maß als verlorener Attraktor.","refs":["CH_GB18_A_25:SD1","CH_GB18_A_25:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_33:MME-01","text":"Quantität wird von einer äußerlichen Vergleichsform zu einer Erscheinungsform qualitativer Negativität und möglicher Begriffszerstörung umkartiert.","refs":["CH_GB18_BDIA:ME1","CH_GB18_A_25:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MME-02","text":"Das Kräftepaar wird nicht mehr als Erklärungseinheit der Bewegung behandelt, sondern als Prüfstein für die unzulässige Verselbständigung wechselseitig bestimmter Momente.","refs":["CH_GB18_A_25:ME2","CH_GB18_A_25:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MME-03","text":"Die spinozistische Indifferenz wird von konkreter Einheit zu abstrakter Endform einer Abstraktion reklassifiziert, weil ihre Unterschiede nur äußerlich hinzutreten.","refs":["CH_GB18_A_25:ME5","CH_GB18_A_25:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_33:ALT-B01","text":"Surface level — Unbestimmtes Sein, Quantität, Substrat, Faktoren, elliptische Bewegung und Kraftverhältnisse bilden die expliziten Gegenstände der Analyse.","refs":["CH_GB18_A_25:ALT1","CH_GB18_BDIA:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:ALT-B02","text":"Structural level — Der wiederkehrende Mechanismus ist die Verwandlung qualitativ korrelierter Momente in äußerlich quantitative Faktoren und deren notwendige Destabilisierung.","refs":["CH_GB18_A_25:ALT2","CH_GB18_BDIA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:ALT-B03","text":"Metastrategic level — Erklärung wird von empirischer Anpassung auf die immanente Erzeugung jener Übergänge umgestellt, die eine Theorie beansprucht zu erklären.","refs":["CH_GB18_A_25:ALT3","CH_GB18_A_25:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:ALT-B04","text":"Ontological / Temporal level — Zeitliche Abfolge wird nicht als Ursache anerkannt; Realität ist vielmehr negative Selbstbewegung einer Einheit, die ihre Unterschiede nicht äußerlich behalten kann.","refs":["CH_GB18_A_25:ALT4","CH_GB18_BDIA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:ALT-B05","text":"Methodological / Performative level — Die Form vollzieht ihre These, indem sie die äußerliche Nebeneinanderstellung von Faktum und Erklärung selbst als Symptom des kritisierten Formalismus behandelt.","refs":["CH_GB18_A_25:AS4","CH_GB18_A_25:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_33:FL-01","text":"Die Indifferenz ist spannungsvoll zugleich als zunächst ungesetzte Vermittlung und als Resultat vollzogener Selbstvermittlung bestimmt; diese Differenz ist produktiv, weil sie die Bewegung vom Substrat zur negativen Einheit erzwingt.","refs":["CH_GB18_BDIA:AS2","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:FL-02","text":"Das umgekehrte Verhältnis oszilliert zwischen notwendiger Negativform und kritisiertem Formalismus; die Architektur benötigt diese Spannung, um immanente Relation von äußerlicher Kausalmodellierung zu unterscheiden.","refs":["CH_GB18_BDIA:A6","CH_GB18_A_25:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:FL-03","text":"Der Übergang von qualitativer Abhängigkeit zur Unmöglichkeit quantitativen Übergewichts bleibt ein tragender, aber nicht weiter begründeter Kompressionspunkt.","refs":["CH_GB18_A_25:MRT5","CH_GB18_BDIA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MP-01","text":"Der entscheidende Mutationspunkt liegt im Übergang vom Substrat, das Bestimmungen trägt, zur Indifferenz, die als Widerspruch ihre Bestimmtheit selbst aufhebt.","refs":["CH_GB18_DAI0:AS6","CH_GB18_BDIA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MP-02","text":"Ein zweiter Mutationspunkt verschiebt die physikalische Kritik in eine ontologische Kritik abstrakter Substanz und der Auflösung des Maßes.","refs":["CH_GB18_A_25:D6","CH_GB18_A_25:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_33:HSI-01","text":"Realität erscheint als relationale Totalität, deren Seiten nur als gegenseitig konstituierende Momente wirklich sind und deren scheinbare Selbständigkeit ihren Widerspruch erzeugt.","refs":["CH_GB18_BDIA:A8","CH_GB18_BDIA:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:HSI-02","text":"Das Subjektbild bleibt negativ: Indifferenz ist nicht selbstunterscheidendes Subjekt, kann aber auch nicht als passives Beharren bestehen, sondern muss sich als vermittelte Einheit transformieren.","refs":["CH_GB18_A_25:NX6","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:HSI-03","text":"Zeit ist keine Serie äußerlicher Wechsel, sondern die notwendige Selbstnegation einer Relation; begriffliche Navigation besteht darin, den immanenten Ursprung des Übergangs auszuweisen.","refs":["CH_GB18_A_25:ALT4","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_33:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Clusterbewegung von abstrakter Gleichgültigkeit über äußere Faktorenrelation zur negativen Einheit zu rekonstruieren.","refs":["CH_GB18_BDIA:MRT1","CH_GB18_BDIA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MRT-B02","text":"Unterbestimmt bleibt die positive Begriffsform, durch welche Umschlag und Bewegung jenseits der Kritik äußerlicher Faktoren tatsächlich immanent erzeugt werden.","refs":["CH_GB18_A_25:MRT3","CH_GB18_BDIA:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MRT-B03","text":"Die Architektur ist kohärent, sofern quantitative Differenz von qualitativer Gegenseitigkeit abhängig bleibt und weder Gleichgewicht noch Übergewicht als Lösung gelten.","refs":["CH_GB18_BDIA:MRT3","CH_GB18_BDIA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MRT-B04","text":"Der irreduzible Rest liegt in der komprimierten Vermittlung zwischen physikalischer Kräfteanalyse, Indifferenzkritik und Maßdiagnose; diese Verdichtung ist zugleich Stärke und Bruchstelle des Clusters.","refs":["CH_GB18_A_25:MRT6","CH_GB18_A_25:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122018474180Z_634ee0c7","language_code":"en","language_name":"English","title":"Chapters 97–99","source_sha256":"332bda10608d4f56f0b5df3b256ddbf51e6efe550f4ebae049fa5cc639471c65","sha256":"a112e30c4a2bbfa8bc400b95fda3b31b1b7732e11594ebd4e9744a04db500997","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:20:18.475720+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_33:AS-01","text":"The cluster resolves the problem of how a unity can bear differences without merely housing them as external states of a presupposed substrate.","refs":["CH_GB18_DAI0:AS4","CH_GB18_BDIA:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AS-02","text":"Absolute indifference is re-determined from abstract indeterminacy into a unity that is concrete only as the result of its negation and mediation.","refs":["CH_GB18_DAI0:AS3","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AS-03","text":"Quantity is neither sufficient determination nor a neutral form of comparison, but the field in which external determinacy passes into a negative relation.","refs":["CH_GB18_DAI0:AS2","CH_GB18_BDIA:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AS-04","text":"The inverse relation makes visible that inseparable qualitative factors possess no enduring quantitative independence and therefore destabilize indifference as contradiction.","refs":["CH_GB18_BDIA:AS4","CH_GB18_BDIA:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AS-05","text":"The analysis of forces functions as an immanent stress test: a theory whose factors would have to sublate continuing movement cannot explain its reversal.","refs":["CH_GB18_A_25:AS1","CH_GB18_A_25:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AS-06","text":"The movement is recursive: external determination sublates itself, returns as empty distinguishing, and closes itself as negative unity rather than as resting indifference.","refs":["CH_GB18_DAI0:AS5","CH_GB18_BDIA:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_33:GA-01","text":"[Persistent] Concrete unity exists only insofar as difference remains mediated within it itself as negation and relation.","refs":["CH_GB18_DAI0:A11","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-02","text":"[Mutating] Indifference mutates from a substrate merely presupposed in itself into the result of its own self-mediation.","refs":["CH_GB18_BDIA:AS2","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-03","text":"[Persistent] Qualitative factors possess reality only in reciprocal relatedness and therefore cannot persist as independent magnitudes.","refs":["CH_GB18_BDIA:A7","CH_GB18_A_25:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-04","text":"[Mutating] Quantity transforms from external receptivity into the form through which the inner contradiction of the factors becomes manifest.","refs":["CH_GB18_DAI0:AS2","CH_GB18_BDIA:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-05","text":"[Attractor] The inverse relation is not a positive causal formula, but a negative test-form that reveals the inadequacy of external models of movement.","refs":["CH_GB18_BDIA:A6","CH_GB18_A_25:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-06","text":"[Emergent] Explanation is valid only if it immanently generates the transition of its determinations and does not maintain the persistence of the fact against the consequence of its categories.","refs":["CH_GB18_A_25:A4","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-07","text":"[Persistent] Neither equilibrium nor enduring preponderance stabilizes the factors: equality eliminates the difference, preponderance the counter-determination.","refs":["CH_GB18_BDIA:A13","CH_GB18_BDIA:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-08","text":"[Terminal] As the totality of its factors, indifference necessarily becomes contradiction, which determines itself as immanently negative unity.","refs":["CH_GB18_BDIA:A14","CH_GB18_BDIA:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GA-09","text":"[Attractor] Measure appears as the lost unity of quality and quantity, whose disintegration demonstrates every abstract indifference to be inadequate.","refs":["CH_GB18_A_25:A10","CH_GB18_A_25:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_33:RMD-01","text":"Determinacy recurs first as an external state, then as a difference of factors, and finally as criticized external quantification; its function shifts from appearance to diagnostic defect.","refs":["CH_GB18_DAI0:AS4","CH_GB18_BDIA:AS4","CH_GB18_A_25:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RMD-02","text":"Indifference retains the function of unity, but mutates from unposited mediation through contradictory totality into the diagnosis of abstract substance.","refs":["CH_GB18_BDIA:AS2","CH_GB18_BDIA:A14","CH_GB18_A_25:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RMD-03","text":"Quantity moves from external determinability through negative reciprocity to destructive abstraction, as soon as it is meant to replace qualitative difference.","refs":["CH_GB18_DAI0:AS2","CH_GB18_BDIA:AS3","CH_GB18_A_25:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RMD-04","text":"Negation mutates from the sublation of immediate categories to the self-sublation of contradiction and finally to the diagnosis of formalism in a contradictory theory.","refs":["CH_GB18_DAI0:AS3","CH_GB18_BDIA:AS6","CH_GB18_A_25:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RMD-05","text":"The inverse relation is retained as form, but reverses its valence: within indifference it exposes contradiction; as an external theory of forces it produces explanatory failure.","refs":["CH_GB18_BDIA:A6","CH_GB18_A_25:AS1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_33:CGD-01","text":"The mere capacity of pure quantity to receive determinations externally remains a local initial mechanism and is superseded at the cluster level by the question of its immanent mediation.","refs":["CH_GB18_DAI0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:CGD-02","text":"The reduction of relations of measure and the fixed limit of the substrate are local conditions; globally decisive is that these conditions do not yet themselves determine the movement of the moments.","refs":["CH_GB18_BDIA:A1","CH_GB18_BDIA:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:CGD-03","text":"The analysis of forces remains local as a case, but scales into a general criterion for whether a theory impermissibly translates qualitative relationality into quantitative factors.","refs":["CH_GB18_A_25:ME2","CH_GB18_A_25:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:CGD-04","text":"At the cluster level, only the shared thesis bears weight: that external composition cannot explain an immanent transition and must therefore pass into negative self-relation.","refs":["CH_GB18_DAI0:A11","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_33:GNX-01","text":"Excluded is an indifference that remains as a passive substrate beneath its determinations and accomplishes no self-mediation.","refs":["CH_GB18_DAI0:NX6","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GNX-02","text":"Excluded is the independent quantitative self-subsistence of qualitatively correlated factors.","refs":["CH_GB18_BDIA:AS4","CH_GB18_A_25:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GNX-03","text":"Excluded is the neutralization of contradiction through equilibrium or through a merely temporal succession of external preponderances.","refs":["CH_GB18_BDIA:A13","CH_GB18_A_25:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:GNX-04","text":"Excluded is the coexistence of an empirically maintained fact with a theory whose own consequence negates that fact.","refs":["CH_GB18_A_25:AS4","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_33:DBN-01","text":"It must be false that qualitative dependence and quantitatively independent excess can coexist.","refs":["CH_GB18_A_25:DNX1","CH_GB18_BDIA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:DBN-02","text":"It must be false that abstract unity becomes concrete substance through a subsequently added quantitative difference.","refs":["CH_GB18_A_25:A8","CH_GB18_A_25:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:DBN-03","text":"Excluded remains a unity that would be fully given before negation or could be fixed as final indifference.","refs":["CH_GB18_DAI0:SNX3","CH_GB18_BDIA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_33:BSA-01","text":"Unavailable is a substance that merely absorbs differences and yet is supposed to produce its concrete differentiation from itself.","refs":["CH_GB18_A_25:SNX3","CH_GB18_A_25:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:BSA-02","text":"Unavailable is a stable whole whose dependent moments at the same time appear as independent causes and whose transitions are nevertheless supposed to remain explicable.","refs":["CH_GB18_A_25:SNX1","CH_GB18_A_25:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:BSA-03","text":"Unavailable is the restoration of an immediate unity of quality and quantity after both have been determined as only externally separated.","refs":["CH_GB18_A_25:SNX4","CH_GB18_A_25:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_33:XD-01","text":"The external state of determinacy and the externally controlled movement of the factors designate the same deficiency: unity cannot explain its changes so long as it remains merely substrate.","refs":["CL_GB18_33:GA-02","CL_GB18_33:GA-06","CH_GB18_DAI0:AS4","CH_GB18_BDIA:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_33:XD-02","text":"The inverse relation possesses a double function: as an immanent negative form, it lays bare the instability of indifference; as an external explanation, it transforms the movement of the object into unconnected alternations.","refs":["CL_GB18_33:GA-05","CL_GB18_33:GA-08","CH_GB18_BDIA:A6","CH_GB18_A_25:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_33:XD-03","text":"The critique of the theory of forces becomes a categorial diagnosis: where qualitative opposition is quantified, the theory loses at once both the reversal of movement and measure.","refs":["CL_GB18_33:GA-06","CL_GB18_33:GA-09","CH_GB18_A_25:D3","CH_GB18_A_25:D7"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_33:BSD-01","text":"Causality is determined as immanent self-transformation of relational determinations; mere succession or external equilibrium of forces possesses no explanatory status.","refs":["CL_GB18_33:GA-01","CL_GB18_33:GA-06","CH_GB18_DAI0:A11","CH_GB18_A_25:A4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_33:BSD-02","text":"Reality appears as a totality in which each side contains the whole unity and therefore can be determined neither in isolation nor through the addition of other sides.","refs":["CL_GB18_33:GA-03","CL_GB18_33:GA-08","CH_GB18_BDIA:A8","CH_GB18_BDIA:A9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_33:BSD-03","text":"Methodologically, explanation is separated from empirical accuracy: a law-form is valid only if its categories do not themselves destroy the reality it describes.","refs":["CL_GB18_33:GA-05","CL_GB18_33:GA-06","CH_GB18_A_25:SD2","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_33:RLE-01","text":"The central loop proceeds from external determination through self-sublation to empty distinguishing, and from there to self-mediated indifference.","refs":["CH_GB18_DAI0:AS5","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RLE-02","text":"The inverse relation escalates from the fixed limit to quantitative reciprocity and ends in the double impossibility of equilibrium and preponderance.","refs":["CH_GB18_BDIA:AS3","CH_GB18_BDIA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RLE-03","text":"Explanatory failure generates feedback: every alien mediation that is meant to rescue the reversal documents precisely the loss of immanent explanation.","refs":["CH_GB18_A_25:AS3","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:RLE-04","text":"Measure acts as a negative attractor: its dissolution draws the critique of external quantification toward itself and points to a unity that can be restored neither abstractly nor immediately.","refs":["CH_GB18_A_25:A10","CH_GB18_A_25:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_33:FGS-B01","text":"Abstract indifference of being + external receptivity of quantity → determinacy without immanent connection.","refs":["CH_GB18_DAI0:AS1","CH_GB18_DAI0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:FGS-B02","text":"External state of the substrate + fixed limit of the whole → negative dependence of differences.","refs":["CH_GB18_DAI0:AS4","CH_GB18_BDIA:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:FGS-B03","text":"Inverse relation + qualitative inseparability → impossibility of stable quantitative independence.","refs":["CH_GB18_BDIA:AS3","CH_GB18_BDIA:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:FGS-B04","text":"Self-sublation of the indifferent totality + critique of external explanation → negative unity as the condition of conceptual movement.","refs":["CH_GB18_BDIA:A14","CH_GB18_A_25:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_33:AFM-B01","text":"Abstract indifference → external determinability → indifference as substrate → inverse relation → contradiction of the factors → negative unity.","refs":["CH_GB18_DAI0:AS1","CH_GB18_BDIA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:AFM-B02","text":"Theory of forces as external explanation → loss of the immanent movement of the object → diagnosis of formalism → critique of abstract substance → measure as lost attractor.","refs":["CH_GB18_A_25:SD1","CH_GB18_A_25:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_33:MME-01","text":"Quantity is remapped from an external form of comparison into a mode of appearance of qualitative negativity and possible destruction of the concept.","refs":["CH_GB18_BDIA:ME1","CH_GB18_A_25:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MME-02","text":"The pair of forces is no longer treated as the explanatory unity of movement, but as a touchstone for the impermissible autonomization of reciprocally determined moments.","refs":["CH_GB18_A_25:ME2","CH_GB18_A_25:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MME-03","text":"Spinozist indifference is reclassified from concrete unity into the abstract final form of an abstraction, because its differences are only externally added.","refs":["CH_GB18_A_25:ME5","CH_GB18_A_25:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_33:ALT-B01","text":"Surface level — Indeterminate being, quantity, substrate, factors, elliptical movement, and relations of force constitute the explicit objects of analysis.","refs":["CH_GB18_A_25:ALT1","CH_GB18_BDIA:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:ALT-B02","text":"Structural level — The recurring mechanism is the transformation of qualitatively correlated moments into externally quantitative factors and their necessary destabilization.","refs":["CH_GB18_A_25:ALT2","CH_GB18_BDIA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:ALT-B03","text":"Metastrategic level — Explanation is shifted from empirical adjustment to the immanent generation of those transitions that a theory claims to explain.","refs":["CH_GB18_A_25:ALT3","CH_GB18_A_25:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:ALT-B04","text":"Ontological / Temporal level — Temporal succession is not recognized as cause; reality is rather the negative self-movement of a unity that cannot retain its differences externally.","refs":["CH_GB18_A_25:ALT4","CH_GB18_BDIA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:ALT-B05","text":"Methodological / Performative level — The form enacts its thesis by treating the external juxtaposition of fact and explanation itself as a symptom of the criticized formalism.","refs":["CH_GB18_A_25:AS4","CH_GB18_A_25:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_33:FL-01","text":"Indifference is tensely determined at once as initially unposited mediation and as the result of accomplished self-mediation; this difference is productive because it compels the movement from substrate to negative unity.","refs":["CH_GB18_BDIA:AS2","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:FL-02","text":"The inverse relation oscillates between necessary negative form and criticized formalism; the architecture requires this tension in order to distinguish immanent relation from external causal modelling.","refs":["CH_GB18_BDIA:A6","CH_GB18_A_25:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:FL-03","text":"The transition from qualitative dependence to the impossibility of quantitative preponderance remains a load-bearing but not further justified point of compression.","refs":["CH_GB18_A_25:MRT5","CH_GB18_BDIA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MP-01","text":"The decisive mutation point lies in the transition from the substrate that bears determinations to indifference that, as contradiction, sublates its own determinacy.","refs":["CH_GB18_DAI0:AS6","CH_GB18_BDIA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MP-02","text":"A second mutation point shifts the physical critique into an ontological critique of abstract substance and of the dissolution of measure.","refs":["CH_GB18_A_25:D6","CH_GB18_A_25:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_33:HSI-01","text":"Reality appears as a relational totality whose sides are real only as reciprocally constituting moments and whose apparent independence produces their contradiction.","refs":["CH_GB18_BDIA:A8","CH_GB18_BDIA:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:HSI-02","text":"The image of the subject remains negative: indifference is not a self-distinguishing subject, but neither can it persist as passive abiding; rather, it must transform itself into mediated unity.","refs":["CH_GB18_A_25:NX6","CH_GB18_DAI0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:HSI-03","text":"Time is not a series of external alternations, but the necessary self-negation of a relation; conceptual navigation consists in demonstrating the immanent origin of the transition.","refs":["CH_GB18_A_25:ALT4","CH_GB18_A_25:A5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_33:MRT-B01","text":"The extracted axioms suffice to reconstruct the cluster movement from abstract indifference through external relation of factors to negative unity.","refs":["CH_GB18_BDIA:MRT1","CH_GB18_BDIA:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MRT-B02","text":"What remains underdetermined is the positive conceptual form through which reversal and movement are actually generated immanently beyond the critique of external factors.","refs":["CH_GB18_A_25:MRT3","CH_GB18_BDIA:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MRT-B03","text":"The architecture is coherent insofar as quantitative difference remains dependent on qualitative reciprocity and neither equilibrium nor preponderance counts as a solution.","refs":["CH_GB18_BDIA:MRT3","CH_GB18_BDIA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_33:MRT-B04","text":"The irreducible remainder lies in the compressed mediation between physical analysis of forces, critique of indifference, and diagnosis of measure; this condensation is at once the strength and the breaking point of the cluster.","refs":["CH_GB18_A_25:MRT6","CH_GB18_A_25:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_33@R001","source_variant_id":"canonical:CL_GB18_33:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 97–99","context":"A. Die absolute Indifferenz. · B. Die Indifferenz als umgekehrtes Verhältniß ihrer Faktoren. · Anmerkung."},"title_language_code":"en"},{"id":"CL_GB18_34","layer":"CL","title":"Chapters 100–102","order":34,"parents":["CH_GB18_CBDW","CH_GB18_ZBDW","CH_GB18_EADW"],"revision":"CL_GB18_34@R001","sha256":"757ab35f88d3da62db59b8e34e81e19042a62db95586c5bd62482a50643f4030","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_34:AS-01","text":"Das System bestimmt die Schwelle vom Seyn zum Wesen als Problem einer Unmittelbarkeit, deren letzte Form, die Indifferenz, ihre eigene Wahrheit nicht tragen kann.","refs":["CH_GB18_CBDW:AS1","CH_GB18_ZBDW:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-02","text":"Die zunächst äußerlich scheinende Vermittlung wird als Eigenbewegung des Seyns rekonstruiert; Wesen tritt weder hinzu noch wird es von außen erkannt.","refs":["CH_GB18_CBDW:AS2","CH_GB18_ZBDW:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-03","text":"Der Übergang vollzieht sich durch einen Widerspruch, in dem vorausgesetzte Einheit und gesetzte Bestimmtheit einander nicht äußerlich begrenzen, sondern ihre Selbstnegation erzwingen.","refs":["CH_GB18_CBDW:AS3","CH_GB18_CBDW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-04","text":"Negative Totalität ist die Umschlagform, in der die Selbstabstoßung der Indifferenz zur Reflexion des Wesens mutiert.","refs":["CH_GB18_CBDW:AS4","CH_GB18_ZBDW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-05","text":"Die abgestoßenen Bestimmungen werden nicht vernichtet, sondern als gesetzte, relationale und in der Einheit aufgehobene Momente reklassifiziert.","refs":["CH_GB18_CBDW:AS5","CH_GB18_ZBDW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-06","text":"Das Wesen erzeugt durch seine Reflexion ein Gegenüber, das als Schein weder unabhängiges Sein noch bloße Täuschung ist, sondern seine eigene gesetzte Äußerlichkeit.","refs":["CH_GB18_EADW:A4","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-07","text":"Reflexive Selbstsetzung verdichtet sich zum Grund und eröffnet dadurch Existenz, Erscheinung und schließlich die Perspektive eines dem Ansich gleichen Daseyns.","refs":["CH_GB18_EADW:A9","CH_GB18_ZBDW:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-08","text":"Die Bewegung ist rekursiv und spiralförmig: Unmittelbarkeit wird nicht einfach verlassen, sondern als aufgehobenes, zeitlos vergangenes Seyn in die Selbstvermittlung des Wesens integriert.","refs":["CH_GB18_ZBDW:A3","CH_GB18_EADW:A3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_34:GA-01","text":"[Persistent] Das Wesen ist die Wahrheit des Seyns nur als dessen aufgehobene und vermittelte Gestalt, nicht als ein hinter dem Seyn ruhender Bestand.","refs":["CH_GB18_ZBDW:A1","CH_GB18_EADW:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-02","text":"[Mutating] Negativität mutiert von der Selbstabstoßung der Indifferenz zur Reflexion des Wesens und wird dadurch aus destruktiver Unverträglichkeit zu produktiver Selbstbestimmung.","refs":["CH_GB18_CBDW:A12","CH_GB18_ZBDW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-03","text":"[Persistent] Bestimmungen besitzen keine selbstständige Geltung, sondern bestehen ausschließlich als gesetzte Relationen auf Einheit, andere Bestimmungen und ihre eigene Negation.","refs":["CH_GB18_CBDW:A15","CH_GB18_ZBDW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-04","text":"[Mutating] Unterschied verliert die Form äußerlicher Quantität und wird zur immanenten Selbstunterscheidung einer reflexiven Einheit.","refs":["CH_GB18_CBDW:A9","CH_GB18_EADW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-05","text":"[Attractor] Identität ist kein ursprünglicher Besitz, sondern das Resultat einer Bewegung, in der die Einheit aus ihrer Selbstnegation zu sich zurückkehrt.","refs":["CH_GB18_CBDW:AS7","CH_GB18_ZBDW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-06","text":"[Emergent] Schein ist die notwendige Form des Gegenübers, sofern das Wesen seine Differenz nur als eigene Setzung hervorbringen kann.","refs":["CH_GB18_EADW:A4","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-07","text":"[Emergent] Der Grund ist keine verborgene Substanz, sondern die Reflexion des Bestimmens, durch welche das Wesen seine Selbstvermittlung in Existenz und Erscheinung entfaltet.","refs":["CH_GB18_EADW:A9","CH_GB18_EADW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-08","text":"[Persistent] Äußerliche Reflexion und abstrahierende Negation sind zur Wahrheitsbestimmung untauglich, weil sie Unterschiede voraussetzen, statt deren immanente Erzeugung zu begreifen.","refs":["CH_GB18_CBDW:A6","CH_GB18_ZBDW:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-09","text":"[Terminal] Existenz und Erscheinung sind keine Abfälle des Wesens, sondern Stufen seiner Selbstoffenbarung und seiner Fortbewegung zur Wirklichkeit.","refs":["CH_GB18_ZBDW:AS6","CH_GB18_EADW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-10","text":"[Attractor] Der Begriff fungiert als terminaler Attraktor, weil das Wesen seine eigene Wahrheit nur vollendet, indem es ein seinem Ansichseyn gleiches Daseyn setzt.","refs":["CH_GB18_ZBDW:A12","CH_GB18_ZBDW:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_34:RMD-01","text":"Die absolute Indifferenz kehrt nicht als bleibende Kategorie wieder, sondern verschwindet nach ihrer strukturellen Arbeit als lokale Form der Unmittelbarkeit und hinterlässt die Notwendigkeit immanenter Negativität.","refs":["CH_GB18_CBDW:A1","CH_GB18_CBDW:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-02","text":"Der quantitative Unterschied wird von einer äußeren Differenz der Faktoren in eine reflexiv gesetzte Differenz überführt, die nur innerhalb der Einheit gültig ist.","refs":["CH_GB18_CBDW:A9","CH_GB18_EADW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-03","text":"Selbstabstoßung bleibt funktional erhalten, mutiert jedoch zur Reflexion: Was zunächst Unverträglichkeit mit sich selbst ist, wird zur produktiven Setzung von Wesensbestimmungen.","refs":["CH_GB18_CBDW:A12","CH_GB18_ZBDW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-04","text":"Die Bestimmung verschiebt sich von relativierten Momenten der negativen Totalität zu Wesenheiten, deren Bestimmtheit zugleich Gesetztseyn und Reflexion-in-sich ist.","refs":["CH_GB18_CBDW:A14","CH_GB18_EADW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-05","text":"Identität behält ihre Funktion als Einheit bei, verliert aber ihre Valenz unmittelbarer Selbstgleichheit und wird zur resultierenden Rückkehr aus gesetzter Differenz.","refs":["CH_GB18_CBDW:AS7","CH_GB18_ZBDW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-06","text":"Das Gegenüber mutiert von einem äußerlichen Anderen zu Schein; seine Opposition gegen das Wesen bleibt wirksam, wird aber als Selbstsetzung des Wesens absorbiert.","refs":["CH_GB18_EADW:A4","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-07","text":"Das Seyn verschwindet nicht schlechthin, sondern wird als aufgehobenes und zeitlos vergangenes Seyn in die Reflexionsbewegung des Wesens überführt.","refs":["CH_GB18_ZBDW:A3","CH_GB18_EADW:A1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_34:CGD-01","text":"Die quantitative Differenz der Indifferenz bleibt ein lokaler Mechanismus der Ausgangssphäre; auf Clusterebene bleibt davon nur die allgemeine Unzulänglichkeit äußerlicher Differenzbestimmung erhalten.","refs":["CH_GB18_CBDW:A9","CH_GB18_CBDW:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:CGD-02","text":"Die absolute Indifferenz ist als Name einer bestimmten Seynsform lokal, ihr Widerspruch wird jedoch zur globalen Formregel, nach der jede vorausgesetzte Einheit ihre Vermittlung hervorbringen muß.","refs":["CH_GB18_CBDW:A1","CH_GB18_CBDW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:CGD-03","text":"Die einzelnen Reflexionsbestimmungen bleiben auf der unteren Ebene inhaltlich unterbestimmt; auf Clusterebene skaliert allein ihre generative Funktion als Einheit von Gesetztseyn und Reflexion-in-sich.","refs":["CH_GB18_EADW:A7","CH_GB18_EADW:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:CGD-04","text":"Existenz und Erscheinung sind noch keine vollständig ausgearbeitete Wirklichkeitslogik, aber sie markieren auf Clusterebene die notwendige Externalisierung der immanenten Selbstvermittlung.","refs":["CH_GB18_EADW:A10","CH_GB18_EADW:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:CGD-05","text":"Das zeitlos vergangene Seyn ist keine lokale Metapher der Vergangenheit, sondern eine skalierende Regel gegen jede chronologische Lesart des Übergangs.","refs":["CH_GB18_ZBDW:A3","CH_GB18_ZBDW:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_34:GNX-01","text":"Ausgeschlossen wird ein Wesen, das als fertiger Bestand hinter oder jenseits des Seyns liegt und von einem äußeren Erkennen freigelegt werden könnte.","refs":["CH_GB18_CBDW:DNX1","CH_GB18_ZBDW:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GNX-02","text":"Ausgeschlossen wird eine Einheit, die ihre Unterschiede nur äußerlich neben sich duldet und deren Identität vor ihrer Selbstvermittlung vollständig wäre.","refs":["CH_GB18_CBDW:DNX2","CH_GB18_CBDW:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GNX-03","text":"Ausgeschlossen wird ein selbstständiges Außen der Bestimmungen, weil alle Differenz als Moment, Setzung oder Schein innerhalb der Einheit bestimmt wird.","refs":["CH_GB18_CBDW:NX8","CH_GB18_EADW:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GNX-04","text":"Ausgeschlossen wird ein lineares Modell des Übergangs, in dem Seyn und Wesen als zeitlich oder äußerlich aufeinanderfolgende Zustände auftreten.","refs":["CH_GB18_CBDW:DNX5","CH_GB18_ZBDW:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GNX-05","text":"Ausgeschlossen wird eine Negation, die bloß entfernt oder entleert; nur Negativität, die sich auf sich selbst bezieht und Bestimmung setzt, besitzt ontologische Kraft.","refs":["CH_GB18_ZBDW:DNX3","CH_GB18_ZBDW:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_34:DBN-01","text":"Falsch sein muß, daß unvermittelte Unmittelbarkeit als dauerhafte Grundlage der Ontologie fungieren kann.","refs":["CH_GB18_CBDW:SNX2","CH_GB18_ZBDW:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:DBN-02","text":"Falsch sein muß, daß Einheit und Differenz in einer äußeren Koexistenz verharren können, ohne sich wechselseitig als Setzung und Aufhebung hervorzubringen.","refs":["CH_GB18_CBDW:DNX2","CH_GB18_ZBDW:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:DBN-03","text":"Falsch sein muß, daß Negation bloßer Verlust bleibt; sie muß zugleich Selbstbeziehung, Differenzproduktion und Aufhebung des Andersseyns leisten.","refs":["CH_GB18_ZBDW:D4","CH_GB18_ZBDW:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:DBN-04","text":"Falsch sein muß, daß Erscheinung eine Wirklichkeit außerhalb oder unterhalb des Wesens verdeckt, denn Erscheinung ist die gesetzte Äußerlichkeit seiner Selbstoffenbarung.","refs":["CH_GB18_ZBDW:SNX3","CH_GB18_EADW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:DBN-05","text":"Falsch sein muß, daß Grund eine ruhende Ursache oder ein verborgenes Substrat ist; Grund existiert nur im Vollzug seiner Vermittlung in Existenz und Erscheinung.","refs":["CH_GB18_EADW:DNX5","CH_GB18_EADW:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_34:BSA-01","text":"Nicht verfügbar ist ein äußerer Ort der Vermittlung, von dem aus Einheit, Differenz oder Wahrheit konstituiert werden könnten.","refs":["CH_GB18_CBDW:SNX1","CH_GB18_ZBDW:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:BSA-02","text":"Nicht verfügbar ist ein ursprünglicher, selbstgenügsamer Besitz von Identität, weil Identität nur als Ergebnis der Rückkehr aus eigener Negativität besteht.","refs":["CH_GB18_CBDW:SNX5","CH_GB18_CBDW:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:BSA-03","text":"Unzulässig ist ein endgültig ruhender Grund, der unabhängig von Selbstnegation, Selbstsetzung und Erscheinung fortbestehen könnte.","refs":["CH_GB18_ZBDW:SNX1","CH_GB18_EADW:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:BSA-04","text":"Nicht verfügbar ist eine letzte Opposition von Wesen und Schein, weil der Schein nur die Selbstentgegensetzung des Wesens bezeichnet.","refs":["CH_GB18_EADW:SNX4","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_34:XD-01","text":"Die negative Totalität und die Reflexion bilden eine einheitliche Bewegungsform: Selbstabstoßung liefert die logische Form, Reflexion artikuliert diese Form als produktive Selbstsetzung. ; Trace Type — Composite","refs":["CL_GB18_34:GA-02","CL_GB18_34:GA-03","CH_GB18_CBDW:A12","CH_GB18_ZBDW:A7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:XD-02","text":"Die Umwandlung des Unterschieds in gesetzte Relativität und die Umdeutung des Gegenübers zum Schein schließen jede ontologische Außenposition aus. ; Trace Type — Composite","refs":["CL_GB18_34:GA-03","CL_GB18_34:GA-04","CL_GB18_34:GA-06","CH_GB18_CBDW:A15","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:XD-03","text":"Das Wesen bewahrt das Seyn nicht als fortbestehendes Seiendes, sondern als aufgehobene Vergangenheit seiner eigenen Reflexionsform; Erhaltung und Aufhebung fallen zusammen. ; Trace Type — Tension","refs":["CL_GB18_34:GA-01","CL_GB18_34:GA-05","CH_GB18_ZBDW:A3","CH_GB18_EADW:A3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:XD-04","text":"Der Grund reklassifiziert das Verhältnis von Innerem und Äußerem: Er ist nicht der innere Pol gegen Existenz, sondern die Operation, durch welche Wesen erst in Erscheinung tritt. ; Trace Type — Composite","refs":["CL_GB18_34:GA-07","CL_GB18_34:GA-09","CH_GB18_EADW:A9","CH_GB18_EADW:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:XD-05","text":"Erkenntnis verliert die Stellung einer äußerlich vermittelnden Instanz und erscheint als Vollzugsform einer ontologischen Selbstvermittlung des Seyns. ; Trace Type — Composite","refs":["CL_GB18_34:GA-01","CL_GB18_34:GA-08","CH_GB18_ZBDW:AS2","CH_GB18_ZBDW:AS3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_34:BSD-01","text":"Das Wesen bezeichnet keine Region des Seins, sondern einen Operator, der das Scheitern der Unmittelbarkeit in die Produktion reflektierter Bestimmtheit übersetzt.","refs":["CL_GB18_34:GA-01","CL_GB18_34:GA-02","CH_GB18_CBDW:D10","CH_GB18_ZBDW:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:BSD-02","text":"Ontologie wird von einer Lehre selbstständiger Bestände zu einer Logik der Selbstsetzung umgebildet, in der Bestimmtheit nur als immanente Relation existiert.","refs":["CL_GB18_34:GA-03","CL_GB18_34:GA-04","CH_GB18_CBDW:SD5","CH_GB18_ZBDW:ME3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:BSD-03","text":"Wirklichkeit entsteht nicht jenseits der Erscheinung, sondern dort, wo Wesen, gesetzte Äußerlichkeit und reflektierte Einheit als dieselbe Selbstoffenbarung lesbar werden.","refs":["CL_GB18_34:GA-06","CL_GB18_34:GA-09","CH_GB18_ZBDW:SD5","CH_GB18_ZBDW:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:BSD-04","text":"Zeit wird logisch umcodiert: Das Vergangenseyn des Seyns bezeichnet keine frühere Epoche, sondern seine aufgehobene Gegenwart im Wesen.","refs":["CL_GB18_34:GA-01","CL_GB18_34:GA-05","CH_GB18_ZBDW:A3","CH_GB18_ZBDW:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:BSD-05","text":"Der Begriff ist keine äußerliche höhere Stufe, sondern die notwendige Selbstüberschreitung eines Wesens, das sein Ansich nur durch gleiches Daseyn vollenden kann.","refs":["CL_GB18_34:GA-10","CH_GB18_ZBDW:A12","CH_GB18_ZBDW:DNX6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_34:RLE-01","text":"Der Hauptzyklus lautet: äußerliche Differenz → immanenter Widerspruch → negative Totalität → Reflexion → gesetzte Bestimmung → Grund → Erscheinung.","refs":["CH_GB18_CBDW:AF1","CH_GB18_EADW:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RLE-02","text":"Die Einheit zirkuliert zwischen Voraussetzung und Resultat: Sie muß als Ansich vorausgesetzt werden, um sich durch dessen Aufhebung erst als vermittelte Identität hervorzubringen.","refs":["CH_GB18_CBDW:SD4","CH_GB18_CBDW:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RLE-03","text":"Der Unterschied spiralt von äußerlicher Quantität über negative Relativität zur Selbstunterscheidung des Wesens und kehrt als Schein in dessen Einheit zurück.","refs":["CH_GB18_CBDW:SD3","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RLE-04","text":"Grund und Erscheinung bilden eine operative Schleife: Der Grund setzt Erscheinung, während Erscheinung die Existenzform sichtbar macht, in der Grund überhaupt bestimmbar wird.","refs":["CH_GB18_EADW:D5","CH_GB18_EADW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RLE-05","text":"Der Begriff wirkt als Attraktor, weil jede abgeschlossene Selbstbeziehung des Wesens erneut die Forderung erzeugt, sich als seinem Ansich gleiches Daseyn zu setzen.","refs":["CH_GB18_ZBDW:A12","CH_GB18_ZBDW:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_34:FGS-B01","text":"Absolute Indifferenz + äußerliche quantitative Differenz → Unzulänglichkeit der Unmittelbarkeit.","refs":["CH_GB18_CBDW:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B02","text":"Ansichseyende Totalität + gesetzte Bestimmtheit → immanenter Widerspruch.","refs":["CH_GB18_CBDW:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B03","text":"Widerspruch → negative Totalität → Selbstabstoßung → Verlust selbstständiger Bestimmungen.","refs":["CH_GB18_CBDW:FGS3","CH_GB18_CBDW:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B04","text":"Verlust der Selbstständigkeit → Bestimmungen als relationale Momente → vermittelte Einheit.","refs":["CH_GB18_CBDW:FGS6","CH_GB18_CBDW:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B05","text":"Vermittelte Einheit → Wesen als zeitlos vergangenes Seyn → Reflexion als eigene Negativität.","refs":["CH_GB18_CBDW:FGS8","CH_GB18_ZBDW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B06","text":"Reflexion → Selbstsetzung von Wesensbestimmungen → Schein als eigenes Gegenüber → Grund.","refs":["CH_GB18_EADW:AS4","CH_GB18_EADW:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B07","text":"Grund → Existenz und Erscheinung → Wirklichkeit als Selbstoffenbarung → Daseyn, das dem Ansich gleich wird.","refs":["CH_GB18_EADW:A10","CH_GB18_ZBDW:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_34:AFM-B01","text":"Unmittelbares Seyn → Unzulänglichkeit der Indifferenz → Widerspruch der vorausgesetzten Einheit → negative Totalität → Selbstabstoßung → Wesen als Reflexion → Selbstsetzung der Bestimmungen → Grund → Existenz und Erscheinung → Wirklichkeit → Begriff.","refs":["CH_GB18_ZBDW:AF1","CH_GB18_ZBDW:AF6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AFM-B02","text":"Die Schließung bleibt nicht statisch: Jede erreichte Einheit gilt nur, sofern sie ihr eigenes Vorausgesetztsein aufgehoben und in gesetzte Vermittlung zurückgeführt hat.","refs":["CH_GB18_CBDW:SD4","CH_GB18_ZBDW:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_34:MME-01","text":"Die Trennung von epistemischem Weg und ontologischer Bewegung bricht zusammen, weil Erkenntnis als Erscheinungsform der Selbstbewegung des Seyns lesbar wird.","refs":["CH_GB18_ZBDW:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MME-02","text":"Negation wird in zwei inkompatible Modi geschieden: äußerliche Abstraktion produziert leere Restbestände, immanente Negativität erzeugt Wesen und Bestimmtheit.","refs":["CH_GB18_ZBDW:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MME-03","text":"Bestimmtheit wird nicht länger als Grenze durch ein Anderes kartiert, sondern als Selbstunterscheidung, die in der Einheit aufgehoben bleibt.","refs":["CH_GB18_ZBDW:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MME-04","text":"Erscheinung wird von Oberfläche oder Abfall zu einer notwendigen Form, in der das Wesen seine eigene Äußerlichkeit setzt und offenbart.","refs":["CH_GB18_ZBDW:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MME-05","text":"Der Übergang von Seyn über Wesen zum Begriff wird als eine einzige rekursive Selbstentfaltung statt als Folge äußerer Kategorienwechsel kartiert.","refs":["CH_GB18_ZBDW:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_34:ALT-B01","text":"Surface level — Die absolute Indifferenz, das Wesen, der Schein, der Grund, Existenz und Erscheinung erscheinen als Stationen einer zusammenhängenden Bewegungslogik.","refs":["CH_GB18_CBDW:ALT1","CH_GB18_EADW:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:ALT-B02","text":"Structural level — Die tragende Struktur ist die Umwandlung jeder vorausgesetzten Selbstständigkeit in gesetzte, relationale und reflexiv aufgehobene Bestimmtheit.","refs":["CH_GB18_CBDW:ALT2","CH_GB18_EADW:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:ALT-B03","text":"Metastrategic level — Die Analyse entzieht äußerlicher Reflexion und abstraktiver Negation die Kompetenz zur Wahrheitsbestimmung und erzwingt immanente Selbstvermittlung als Methode.","refs":["CH_GB18_CBDW:ALT3","CH_GB18_ZBDW:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:ALT-B04","text":"Ontological / Temporal level — Realität ist weder unmittelbare Gegenwart noch vergangener Bestand, sondern die zeitlos-logische Rückkehr des Seyns in seine reflektierte Selbstbeziehung.","refs":["CH_GB18_ZBDW:ALT4","CH_GB18_ZBDW:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie jeden äußeren Übergang als resultierende Umformung der vorherigen Bestimmung lesbar macht.","refs":["CH_GB18_CBDW:AS8","CH_GB18_ZBDW:AS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_34:FL-01","text":"Die Einheit ist zugleich vorausgesetzte Totalität und erst resultierende Selbstidentität; ihre Priorität bleibt notwendig doppeldeutig.","refs":["CH_GB18_CBDW:MRT5","CH_GB18_CBDW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FL-02","text":"Das Seyn wird als aufgehoben behauptet, bleibt jedoch als Wesen und als zeitlos vergangene Gestalt wirksam; vollständiges Verschwinden und strukturelle Erhaltung stehen in Spannung.","refs":["CH_GB18_CBDW:MRT6","CH_GB18_ZBDW:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FL-03","text":"Das Wesen soll gegen äußeres Andersseyn gleichgültig sein, muß aber durch Selbstunterscheidung ein Gegenüber, Bestimmungen und Erscheinung hervorbringen.","refs":["CH_GB18_ZBDW:MRT5","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MP-01","text":"Die Indifferenz mutiert am Punkt ihres Widerspruchs: Das passive Gleichgewicht wird als negative Totalität und Selbstabstoßung umcodiert.","refs":["CH_GB18_CBDW:A10","CH_GB18_CBDW:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MP-02","text":"Negativität mutiert am Übergang zum Wesen von einer Selbstunverträglichkeit zu einer Reflexion, die Bestimmungen nicht verliert, sondern setzt.","refs":["CH_GB18_CBDW:A12","CH_GB18_ZBDW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MP-03","text":"Das Gegenüber mutiert am Punkt des Scheins: Es bleibt als Opposition wirksam, wird aber als Erzeugnis der eigenen Tätigkeit des Wesens reklassifiziert.","refs":["CH_GB18_EADW:AS3","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MP-04","text":"Der Grund mutiert von der Erwartung eines verborgenen Fundaments zu einer Vermittlungsoperation, die nur im Übergang zu Existenz und Erscheinung besteht.","refs":["CH_GB18_EADW:A9","CH_GB18_EADW:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_34:HSI-01","text":"Realität erscheint als selbstnegative Maschine, die jede unmittelbare Einheit nur bewahrt, indem sie sie in Differenz, Relation und vermittelte Rückkehr auflöst.","refs":["CH_GB18_CBDW:A11","CH_GB18_CBDW:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:HSI-02","text":"Das erkennende Subjekt ist keine souveräne Instanz der Vermittlung, sondern eine abgeleitete Erscheinungsform einer Selbstbewegung, die dem Gegenstand selbst zugeschrieben wird.","refs":["CH_GB18_ZBDW:D2","CH_GB18_ZBDW:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:HSI-03","text":"Zeit erscheint als nicht-chronologische Erinnerung: Das Wesen ist das vergangene Seyn nur, weil dieses Vergangenseyn logisch in der Gegenwart seiner Aufhebung fortwirkt.","refs":["CH_GB18_ZBDW:A3","CH_GB18_ZBDW:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:HSI-04","text":"Handlungs- und Erkenntnisraum bleibt nur dort möglich, wo Äußerlichkeit nicht als unabhängiges Außen behandelt wird, sondern als zu lesende Selbstsetzung einer immanenten Bewegung.","refs":["CH_GB18_EADW:SD1","CH_GB18_ZBDW:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_34:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von Indifferenz über negative Totalität, Reflexion und Grund zu Existenz, Erscheinung und Begriff zu rekonstruieren.","refs":["CH_GB18_CBDW:MRT1","CH_GB18_ZBDW:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MRT-B02","text":"Unterbestimmt bleiben die positiven Inhalte der einzelnen Reflexionsbestimmungen sowie die konkrete Ausarbeitung der Existenz-, Erscheinungs- und Begriffslogik.","refs":["CH_GB18_CBDW:MRT2","CH_GB18_EADW:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MRT-B03","text":"Die stärkste Architektur liegt in der Kopplung von Selbstnegation und produktiver Setzung: Aufhebung vernichtet nicht, sondern erzeugt die Form ihrer eigenen Vermittlung.","refs":["CH_GB18_CBDW:MRT4","CH_GB18_EADW:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MRT-B04","text":"Die Rekonstruktion bleibt nur dann kohärent, wenn die Spannungen zwischen vorausgesetzter und resultierender Einheit, aufgehobenem und erhaltenem Seyn sowie Schein und Selbstsetzung als produktive Bedingungen gelesen werden.","refs":["CH_GB18_CBDW:MRT5","CH_GB18_EADW:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122054062999Z_7d668e0f","language_code":"en","language_name":"English","title":"Chapters 100–102","source_sha256":"757ab35f88d3da62db59b8e34e81e19042a62db95586c5bd62482a50643f4030","sha256":"840c91cd3affa12069bca8a8827fb6c45a342e81ea506971a975cc450e0e4167","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:20:54.064049+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_34:AS-01","text":"The system determines the threshold from Being to Essence as a problem of an immediacy whose final form, indifference, cannot sustain its own truth.","refs":["CH_GB18_CBDW:AS1","CH_GB18_ZBDW:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-02","text":"The mediation that initially appears external is reconstructed as the self-movement of Being; Essence neither enters in addition nor is it cognized from outside.","refs":["CH_GB18_CBDW:AS2","CH_GB18_ZBDW:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-03","text":"The transition takes place through a contradiction in which presupposed unity and posited determinacy do not externally limit one another, but compel their self-negation.","refs":["CH_GB18_CBDW:AS3","CH_GB18_CBDW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-04","text":"Negative totality is the form of reversal in which the self-repulsion of indifference mutates into the reflection of Essence.","refs":["CH_GB18_CBDW:AS4","CH_GB18_ZBDW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-05","text":"The repelled determinations are not annihilated, but reclassified as posited, relational moments sublated in unity.","refs":["CH_GB18_CBDW:AS5","CH_GB18_ZBDW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-06","text":"Through its reflection, Essence produces an opposite that, as semblance, is neither independent being nor mere deception, but its own posited externality.","refs":["CH_GB18_EADW:A4","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-07","text":"Reflexive self-positing condenses into Ground and thereby opens existence, appearance, and finally the perspective of a determinate being equal to the in-itself.","refs":["CH_GB18_EADW:A9","CH_GB18_ZBDW:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AS-08","text":"The movement is recursive and spiral-shaped: immediacy is not simply abandoned, but integrated into the self-mediation of Essence as sublated, timelessly past Being.","refs":["CH_GB18_ZBDW:A3","CH_GB18_EADW:A3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_34:GA-01","text":"[Persistent] Essence is the truth of Being only as its sublated and mediated form, not as a substrate resting behind Being.","refs":["CH_GB18_ZBDW:A1","CH_GB18_EADW:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-02","text":"[Mutating] Negativity mutates from the self-repulsion of indifference into the reflection of Essence, and thereby from destructive incompatibility into productive self-determination.","refs":["CH_GB18_CBDW:A12","CH_GB18_ZBDW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-03","text":"[Persistent] Determinations possess no independent validity, but subsist exclusively as posited relations to unity, other determinations, and their own negation.","refs":["CH_GB18_CBDW:A15","CH_GB18_ZBDW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-04","text":"[Mutating] Difference loses the form of external quantity and becomes the immanent self-differentiation of a reflexive unity.","refs":["CH_GB18_CBDW:A9","CH_GB18_EADW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-05","text":"[Attractor] Identity is not an original possession, but the result of a movement in which unity returns to itself from its self-negation.","refs":["CH_GB18_CBDW:AS7","CH_GB18_ZBDW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-06","text":"[Emergent] Semblance is the necessary form of the opposite, insofar as Essence can bring forth its difference only as its own positing.","refs":["CH_GB18_EADW:A4","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-07","text":"[Emergent] Ground is not a hidden substance, but the reflection of determining through which Essence unfolds its self-mediation into existence and appearance.","refs":["CH_GB18_EADW:A9","CH_GB18_EADW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-08","text":"[Persistent] External reflection and abstracting negation are incapable of determining truth, because they presuppose differences instead of comprehending their immanent generation.","refs":["CH_GB18_CBDW:A6","CH_GB18_ZBDW:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-09","text":"[Terminal] Existence and appearance are not refuse of Essence, but stages of its self-revelation and its progression toward actuality.","refs":["CH_GB18_ZBDW:AS6","CH_GB18_EADW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GA-10","text":"[Attractor] The Concept functions as a terminal attractor because Essence consummates its own truth only by positing a determinate being equal to its being-in-itself.","refs":["CH_GB18_ZBDW:A12","CH_GB18_ZBDW:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_34:RMD-01","text":"Absolute indifference does not recur as an enduring category, but disappears after its structural work as a local form of immediacy and leaves behind the necessity of immanent negativity.","refs":["CH_GB18_CBDW:A1","CH_GB18_CBDW:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-02","text":"Quantitative difference is transferred from an external difference of factors into a reflexively posited difference that is valid only within unity.","refs":["CH_GB18_CBDW:A9","CH_GB18_EADW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-03","text":"Self-repulsion remains functionally preserved, yet mutates into reflection: what is initially incompatibility with itself becomes the productive positing of essential determinations.","refs":["CH_GB18_CBDW:A12","CH_GB18_ZBDW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-04","text":"Determination shifts from relativized moments of negative totality to essentialities whose determinacy is at once positedness and reflection-into-itself.","refs":["CH_GB18_CBDW:A14","CH_GB18_EADW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-05","text":"Identity retains its function as unity, but loses the valence of immediate self-equality and becomes the resulting return from posited difference.","refs":["CH_GB18_CBDW:AS7","CH_GB18_ZBDW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-06","text":"The opposite mutates from an external other into semblance; its opposition to Essence remains effective, but is absorbed as the self-positing of Essence.","refs":["CH_GB18_EADW:A4","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RMD-07","text":"Being does not disappear absolutely, but is transferred into the movement of reflection of Essence as sublated and timelessly past Being.","refs":["CH_GB18_ZBDW:A3","CH_GB18_EADW:A1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_34:CGD-01","text":"The quantitative difference of indifference remains a local mechanism of the initial sphere; at the cluster level, only the general insufficiency of external determination of difference remains.","refs":["CH_GB18_CBDW:A9","CH_GB18_CBDW:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:CGD-02","text":"Absolute indifference is local as the name of a determinate form of Being; its contradiction, however, becomes the global formal rule according to which every presupposed unity must bring forth its mediation.","refs":["CH_GB18_CBDW:A1","CH_GB18_CBDW:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:CGD-03","text":"The individual determinations of reflection remain substantively underdetermined at the lower level; at the cluster level, only their generative function as unity of positedness and reflection-into-itself scales.","refs":["CH_GB18_EADW:A7","CH_GB18_EADW:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:CGD-04","text":"Existence and appearance are not yet a fully elaborated logic of actuality, but at the cluster level they mark the necessary externalization of immanent self-mediation.","refs":["CH_GB18_EADW:A10","CH_GB18_EADW:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:CGD-05","text":"Timelessly past Being is not a local metaphor of the past, but a scaling rule against every chronological reading of the transition.","refs":["CH_GB18_ZBDW:A3","CH_GB18_ZBDW:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_34:GNX-01","text":"Excluded is an Essence that lies as a finished substrate behind or beyond Being and could be uncovered by an external cognition.","refs":["CH_GB18_CBDW:DNX1","CH_GB18_ZBDW:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GNX-02","text":"Excluded is a unity that merely tolerates its differences externally alongside itself and whose identity would be complete before its self-mediation.","refs":["CH_GB18_CBDW:DNX2","CH_GB18_CBDW:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GNX-03","text":"Excluded is an independent outside of determinations, because all difference is determined as moment, positing, or semblance within unity.","refs":["CH_GB18_CBDW:NX8","CH_GB18_EADW:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GNX-04","text":"Excluded is a linear model of transition in which Being and Essence occur as temporally or externally successive states.","refs":["CH_GB18_CBDW:DNX5","CH_GB18_ZBDW:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:GNX-05","text":"Excluded is a negation that merely removes or empties; only negativity that relates to itself and posits determination possesses ontological force.","refs":["CH_GB18_ZBDW:DNX3","CH_GB18_ZBDW:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_34:DBN-01","text":"It must be false that unmediated immediacy can function as the enduring foundation of ontology.","refs":["CH_GB18_CBDW:SNX2","CH_GB18_ZBDW:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:DBN-02","text":"It must be false that unity and difference can remain in an external coexistence without mutually bringing one another forth as positing and sublation.","refs":["CH_GB18_CBDW:DNX2","CH_GB18_ZBDW:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:DBN-03","text":"It must be false that negation remains mere loss; it must at once accomplish self-relation, the production of difference, and the sublation of other-being.","refs":["CH_GB18_ZBDW:D4","CH_GB18_ZBDW:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:DBN-04","text":"It must be false that appearance conceals an actuality outside or beneath Essence, for appearance is the posited externality of its self-revelation.","refs":["CH_GB18_ZBDW:SNX3","CH_GB18_EADW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:DBN-05","text":"It must be false that Ground is a resting cause or a hidden substrate; Ground exists only in the enactment of its mediation into existence and appearance.","refs":["CH_GB18_EADW:DNX5","CH_GB18_EADW:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_34:BSA-01","text":"Unavailable is an external site of mediation from which unity, difference, or truth could be constituted.","refs":["CH_GB18_CBDW:SNX1","CH_GB18_ZBDW:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:BSA-02","text":"Unavailable is an original, self-sufficient possession of identity, because identity exists only as the result of the return from its own negativity.","refs":["CH_GB18_CBDW:SNX5","CH_GB18_CBDW:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:BSA-03","text":"Impermissible is an ultimately resting Ground that could persist independently of self-negation, self-positing, and appearance.","refs":["CH_GB18_ZBDW:SNX1","CH_GB18_EADW:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:BSA-04","text":"Unavailable is an ultimate opposition of Essence and semblance, because semblance designates only the self-opposition of Essence.","refs":["CH_GB18_EADW:SNX4","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_34:XD-01","text":"Negative totality and reflection form a unified form of movement: self-repulsion supplies the logical form, reflection articulates this form as productive self-positing. ; Trace Type — Composite","refs":["CL_GB18_34:GA-02","CL_GB18_34:GA-03","CH_GB18_CBDW:A12","CH_GB18_ZBDW:A7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:XD-02","text":"The transformation of difference into posited relativity and the reinterpretation of the opposite as semblance exclude every ontological external position. ; Trace Type — Composite","refs":["CL_GB18_34:GA-03","CL_GB18_34:GA-04","CL_GB18_34:GA-06","CH_GB18_CBDW:A15","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:XD-03","text":"Essence preserves Being not as persisting being, but as the sublated past of its own form of reflection; preservation and sublation coincide. ; Trace Type — Tension","refs":["CL_GB18_34:GA-01","CL_GB18_34:GA-05","CH_GB18_ZBDW:A3","CH_GB18_EADW:A3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:XD-04","text":"Ground reclassifies the relation of inner and outer: it is not the inner pole opposed to existence, but the operation through which Essence first enters into appearance. ; Trace Type — Composite","refs":["CL_GB18_34:GA-07","CL_GB18_34:GA-09","CH_GB18_EADW:A9","CH_GB18_EADW:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:XD-05","text":"Cognition loses the position of an externally mediating instance and appears as a mode of enactment of an ontological self-mediation of Being. ; Trace Type — Composite","refs":["CL_GB18_34:GA-01","CL_GB18_34:GA-08","CH_GB18_ZBDW:AS2","CH_GB18_ZBDW:AS3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_34:BSD-01","text":"Essence designates no region of being, but an operator that translates the failure of immediacy into the production of reflected determinacy.","refs":["CL_GB18_34:GA-01","CL_GB18_34:GA-02","CH_GB18_CBDW:D10","CH_GB18_ZBDW:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:BSD-02","text":"Ontology is transformed from a doctrine of independent substrates into a logic of self-positing in which determinacy exists only as immanent relation.","refs":["CL_GB18_34:GA-03","CL_GB18_34:GA-04","CH_GB18_CBDW:SD5","CH_GB18_ZBDW:ME3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:BSD-03","text":"Actuality does not arise beyond appearance, but where Essence, posited externality, and reflected unity become readable as the same self-revelation.","refs":["CL_GB18_34:GA-06","CL_GB18_34:GA-09","CH_GB18_ZBDW:SD5","CH_GB18_ZBDW:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:BSD-04","text":"Time is logically recoded: the past-being of Being designates no earlier epoch, but its sublated presence in Essence.","refs":["CL_GB18_34:GA-01","CL_GB18_34:GA-05","CH_GB18_ZBDW:A3","CH_GB18_ZBDW:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_34:BSD-05","text":"The Concept is not an external higher stage, but the necessary self-transcendence of an Essence that can consummate its in-itself only through an equal determinate being.","refs":["CL_GB18_34:GA-10","CH_GB18_ZBDW:A12","CH_GB18_ZBDW:DNX6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_34:RLE-01","text":"The principal cycle is: external difference → immanent contradiction → negative totality → reflection → posited determination → Ground → appearance.","refs":["CH_GB18_CBDW:AF1","CH_GB18_EADW:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RLE-02","text":"Unity circulates between presupposition and result: it must be presupposed as in-itself in order to bring itself forth as mediated identity only through the sublation of this in-itself.","refs":["CH_GB18_CBDW:SD4","CH_GB18_CBDW:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RLE-03","text":"Difference spirals from external quantity through negative relativity to the self-differentiation of Essence and returns as semblance into its unity.","refs":["CH_GB18_CBDW:SD3","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RLE-04","text":"Ground and appearance form an operative loop: Ground posits appearance, while appearance makes visible the form of existence in which Ground becomes determinable at all.","refs":["CH_GB18_EADW:D5","CH_GB18_EADW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:RLE-05","text":"The Concept acts as an attractor because every completed self-relation of Essence anew generates the demand to posit itself as a determinate being equal to its in-itself.","refs":["CH_GB18_ZBDW:A12","CH_GB18_ZBDW:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_34:FGS-B01","text":"Absolute indifference + external quantitative difference → insufficiency of immediacy.","refs":["CH_GB18_CBDW:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B02","text":"Totality existing in itself + posited determinacy → immanent contradiction.","refs":["CH_GB18_CBDW:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B03","text":"Contradiction → negative totality → self-repulsion → loss of independent determinations.","refs":["CH_GB18_CBDW:FGS3","CH_GB18_CBDW:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B04","text":"Loss of independence → determinations as relational moments → mediated unity.","refs":["CH_GB18_CBDW:FGS6","CH_GB18_CBDW:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B05","text":"Mediated unity → Essence as timelessly past Being → reflection as its own negativity.","refs":["CH_GB18_CBDW:FGS8","CH_GB18_ZBDW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B06","text":"Reflection → self-positing of essential determinations → semblance as its own opposite → Ground.","refs":["CH_GB18_EADW:AS4","CH_GB18_EADW:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FGS-B07","text":"Ground → existence and appearance → actuality as self-revelation → determinate being that becomes equal to the in-itself.","refs":["CH_GB18_EADW:A10","CH_GB18_ZBDW:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_34:AFM-B01","text":"Immediate Being → insufficiency of indifference → contradiction of presupposed unity → negative totality → self-repulsion → Essence as reflection → self-positing of determinations → Ground → existence and appearance → actuality → Concept.","refs":["CH_GB18_ZBDW:AF1","CH_GB18_ZBDW:AF6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:AFM-B02","text":"The closure does not remain static: every attained unity is valid only insofar as it has sublated its own presupposedness and led it back into posited mediation.","refs":["CH_GB18_CBDW:SD4","CH_GB18_ZBDW:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_34:MME-01","text":"The separation of epistemic path and ontological movement collapses, because cognition becomes readable as a form of appearance of the self-movement of Being.","refs":["CH_GB18_ZBDW:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MME-02","text":"Negation is divided into two incompatible modes: external abstraction produces empty residues, immanent negativity generates Essence and determinacy.","refs":["CH_GB18_ZBDW:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MME-03","text":"Determinacy is no longer mapped as a boundary imposed by an other, but as self-differentiation that remains sublated in unity.","refs":["CH_GB18_ZBDW:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MME-04","text":"Appearance is transformed from surface or refuse into a necessary form in which Essence posits and reveals its own externality.","refs":["CH_GB18_ZBDW:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MME-05","text":"The transition from Being through Essence to the Concept is mapped as a single recursive self-unfolding rather than as a sequence of external changes of categories.","refs":["CH_GB18_ZBDW:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_34:ALT-B01","text":"Surface level — Absolute indifference, Essence, semblance, Ground, existence, and appearance appear as stations of a coherent logic of movement.","refs":["CH_GB18_CBDW:ALT1","CH_GB18_EADW:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:ALT-B02","text":"Structural level — The supporting structure is the transformation of every presupposed independence into posited, relational, and reflexively sublated determinacy.","refs":["CH_GB18_CBDW:ALT2","CH_GB18_EADW:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:ALT-B03","text":"Metastrategic level — The analysis deprives external reflection and abstractive negation of the competence to determine truth and compels immanent self-mediation as method.","refs":["CH_GB18_CBDW:ALT3","CH_GB18_ZBDW:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:ALT-B04","text":"Ontological / Temporal level — Reality is neither immediate presence nor past substrate, but the timeless-logical return of Being into its reflected self-relation.","refs":["CH_GB18_ZBDW:ALT4","CH_GB18_ZBDW:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:ALT-B05","text":"Methodological / Performative level — The presentation enacts its thesis by making every external transition readable as a resulting transformation of the preceding determination.","refs":["CH_GB18_CBDW:AS8","CH_GB18_ZBDW:AS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_34:FL-01","text":"Unity is at once presupposed totality and only resulting self-identity; its priority remains necessarily ambiguous.","refs":["CH_GB18_CBDW:MRT5","CH_GB18_CBDW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FL-02","text":"Being is asserted as sublated, yet remains effective as Essence and as a timelessly past form; complete disappearance and structural preservation stand in tension.","refs":["CH_GB18_CBDW:MRT6","CH_GB18_ZBDW:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:FL-03","text":"Essence is supposed to be indifferent toward external otherness, yet it must bring forth, through self-differentiation, an opposite, determinations, and appearance.","refs":["CH_GB18_ZBDW:MRT5","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MP-01","text":"Indifference mutates at the point of its contradiction: passive equilibrium is recoded as negative totality and self-repulsion.","refs":["CH_GB18_CBDW:A10","CH_GB18_CBDW:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MP-02","text":"At the transition to Essence, negativity mutates from self-incompatibility into a reflection that does not lose determinations, but posits them.","refs":["CH_GB18_CBDW:A12","CH_GB18_ZBDW:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MP-03","text":"The opposite mutates at the point of semblance: it remains effective as opposition, but is reclassified as the product of Essence's own activity.","refs":["CH_GB18_EADW:AS3","CH_GB18_EADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MP-04","text":"Ground mutates from the expectation of a hidden foundation into an operation of mediation that exists only in the transition to existence and appearance.","refs":["CH_GB18_EADW:A9","CH_GB18_EADW:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_34:HSI-01","text":"Reality appears as a self-negative machine that preserves every immediate unity only by dissolving it into difference, relation, and mediated return.","refs":["CH_GB18_CBDW:A11","CH_GB18_CBDW:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:HSI-02","text":"The cognizing subject is not a sovereign instance of mediation, but a derived form of appearance of a self-movement attributed to the object itself.","refs":["CH_GB18_ZBDW:D2","CH_GB18_ZBDW:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:HSI-03","text":"Time appears as non-chronological remembrance: Essence is past Being only because this past-being remains logically effective in the present of its sublation.","refs":["CH_GB18_ZBDW:A3","CH_GB18_ZBDW:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:HSI-04","text":"The sphere of action and cognition remains possible only where externality is not treated as an independent outside, but as the self-positing of an immanent movement to be read.","refs":["CH_GB18_EADW:SD1","CH_GB18_ZBDW:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_34:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from indifference through negative totality, reflection, and Ground to existence, appearance, and the Concept.","refs":["CH_GB18_CBDW:MRT1","CH_GB18_ZBDW:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MRT-B02","text":"The positive contents of the individual determinations of reflection, as well as the concrete elaboration of the logic of existence, appearance, and the Concept, remain underdetermined.","refs":["CH_GB18_CBDW:MRT2","CH_GB18_EADW:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MRT-B03","text":"The strongest architecture lies in the coupling of self-negation and productive positing: sublation does not annihilate, but produces the form of its own mediation.","refs":["CH_GB18_CBDW:MRT4","CH_GB18_EADW:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_34:MRT-B04","text":"The reconstruction remains coherent only if the tensions between presupposed and resulting unity, sublated and preserved Being, as well as semblance and self-positing, are read as productive conditions.","refs":["CH_GB18_CBDW:MRT5","CH_GB18_EADW:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_34@R001","source_variant_id":"canonical:CL_GB18_34:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 100–102","context":"C. Übergang in das Wesen. · Zweites Buch Das Wesen. · Erster Abschnitt. Das Wesen als Reflexion in ihm selbst."},"title_language_code":"en"},{"id":"CL_GB18_35","layer":"CL","title":"Chapters 103–105","order":35,"parents":["CH_GB18_DWUD","CH_GB18_BDS0","CH_GB18_CDR0"],"revision":"CL_GB18_35@R001","sha256":"13105f8d7036030030f945b60570d2935f9c3380958f2dff43ecd17dcb314b9b","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_35:AS-01","text":"Die Clusterbewegung bestimmt, wie das Wesen aus aufgehobenem Seyn hervorgeht, ohne dieses Seyn als unabhängigen Grund oder als dauerhaftes Gegenüber zu bewahren.","refs":["CH_GB18_DWUD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AS-02","text":"Die anfängliche Differenz von Wesen und Seyn wird nicht als ontologische Zweiheit stabilisiert, sondern als vorläufige Form einer Negativität rekonstruiert, die ihre Andersheit in sich zurücknimmt.","refs":["CH_GB18_DWUD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AS-03","text":"Der Schein fungiert als kritische Schwelle: Er bewahrt Unmittelbarkeit nur als nichtiges Moment und verwandelt deren scheinbare Selbständigkeit in reflektierte Abhängigkeit.","refs":["CH_GB18_BDS0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AS-04","text":"Die Bewegung eskaliert von äußerlicher Unterscheidung über absolute Negativität zu einer Reflexion, die ihre Voraussetzungen selbst setzt, voraussetzt und aufhebt.","refs":["CH_GB18_CDR0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AS-05","text":"Die Schließung besteht nicht in einem letzten positiven Grund, sondern in bestimmender Reflexion als expliziter Selbstproduktion und Selbstaufhebung ihrer eigenen Grundlage.","refs":["CH_GB18_CDR0:D9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_35:GA-01","text":"[Persistent] Das Wesen ist nur als Negativität wirklich; seine Gleichheit mit sich ist keine ruhende Identität, sondern die Form seiner Selbstvermittlung.","refs":["CH_GB18_DWUD:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-02","text":"[Mutating] Unmittelbarkeit mutiert vom erhaltenen Rest des aufgehobenen Seyns über reflektierte Unmittelbarkeit zu einem gesetzten und aufhebbaren Moment der Reflexion.","refs":["CH_GB18_DWUD:AS2","CH_GB18_BDS0:A3","CH_GB18_CDR0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-03","text":"[Persistent] Andersheit besitzt keine selbständige Außenstellung, sondern besteht ausschließlich als immanente Negation und als Negation der Negation.","refs":["CH_GB18_CDR0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-04","text":"[Emergent] Der Schein ist weder bloßes Unwesen noch äußerer Erscheinungsbereich, sondern die Weise, in der das Wesen seine aufgehobene Unmittelbarkeit als eigenes Moment exponiert.","refs":["CH_GB18_DWUD:A18","CH_GB18_BDS0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-05","text":"[Attractor] Reflexion ist die Selbstbewegung einer Negativität, die kein fremdes Objekt negiert, sondern ihr eigenes Negatives erzeugt, zurücknimmt und dadurch bestimmt.","refs":["CH_GB18_CDR0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-06","text":"[Mutating] Die Unterscheidung von Wesentlichem und Unwesentlichem verliert ihren klassifikatorischen Status und wird zur vorläufigen Erscheinungsform einer sich selbst entkräftenden Bestimmung.","refs":["CH_GB18_DWUD:A10","CH_GB18_BDS0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-07","text":"[Terminal] Bestimmende Reflexion ist keine Rückkehr zu einer ursprünglichen Grundlage, sondern die Operation, durch welche die Reflexion ihre selbstgesetzte Voraussetzung als ihr eigenes Resultat aufhebt.","refs":["CH_GB18_CDR0:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-08","text":"[Attractor] Jeder scheinbare Grund wird innerhalb der Bewegung als erzeugte Voraussetzung lesbar und verliert dadurch den Rang eines unabhängigen Ursprungs.","refs":["CH_GB18_CDR0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_35:RMD-01","text":"Unmittelbarkeit bleibt als Begriff persistent, wechselt jedoch ihre Funktion von bewahrtem Aufhebungsrest zu Gleichheit der Negation mit sich selbst und schließlich zu einer nur reflexiv geltenden Voraussetzung.","refs":["CH_GB18_DWUD:AS2","CH_GB18_CDR0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RMD-02","text":"Der Schein mutiert vom nichtigen Unwesen über das eigene Scheinen des Wesens zur unmittelbaren Reflexion und verliert damit jeden Status eines bloß äußerlichen Restphänomens.","refs":["CH_GB18_DWUD:A17","CH_GB18_BDS0:A9","CH_GB18_CDR0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RMD-03","text":"Andersheit wird zunächst als Gleichrangigkeit zweier Unmittelbarkeiten exponiert, dann als innere Negativität absorbiert und schließlich als Negation mit Negation bestimmt.","refs":["CH_GB18_DWUD:A7","CH_GB18_CDR0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RMD-04","text":"Negation verschiebt sich von der Aufhebung des Seyns zur produktiven Selbstdifferenzierung des Wesens; ihre Funktion ist nicht Vernichtung, sondern Erzeugung reflektierter Bestimmtheit.","refs":["CH_GB18_DWUD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RMD-05","text":"Die Voraussetzung wandert von einem scheinbar vorausliegenden Unmittelbaren zu einem von der Reflexion erzeugten und wieder entzogenen Funktionsmoment.","refs":["CH_GB18_CDR0:D8","CH_GB18_CDR0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_35:CGD-01","text":"Die Austauschbarkeit von Wesentlichem und Unwesentlichem bei gleichem Inhalt bleibt eine lokale Diagnose der äußerlichen Setzung; auf Clusterebene wird sie als Symptom der Unmöglichkeit jedes inhaltsimmanenten Wesentlichkeitskriteriums lesbar.","refs":["CH_GB18_DWUD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:CGD-02","text":"Die absolute Negativität des Seyns ist nicht bloß eine lokale Bestimmung des Wesens, sondern die globale Bedingung dafür, dass Schein, Unmittelbarkeit und Reflexion als interne Momente einer Bewegung erscheinen können.","refs":["CH_GB18_DWUD:A13","CH_GB18_BDS0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:CGD-03","text":"Die Kritik an skeptischem und idealistischem gegebenem Inhalt bleibt lokal an bestimmte philosophische Positionen gebunden, skaliert aber zur allgemeinen Zurückweisung jeder vorreflexiv verfügbaren Bestimmtheit.","refs":["CH_GB18_BDS0:D3","CH_GB18_CDR0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:CGD-04","text":"Die Dreiteilung in setzende, äußerliche und bestimmende Reflexion ist nicht als lokale Typologie zu behandeln, sondern als operative Sequenz, in der sich Selbstsetzung, Voraussetzen und Aufhebung gegenseitig erzeugen.","refs":["CH_GB18_CDR0:A15","CH_GB18_CDR0:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_35:GNX-01","text":"Ausgeschlossen wird ein Zwei-Welten-Modell, in dem Wesen und Erscheinung als stabile, getrennte Sphären mit eigener Selbständigkeit bestehen.","refs":["CH_GB18_DWUD:DNX2","CH_GB18_BDS0:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GNX-02","text":"Ausgeschlossen wird ein ursprüngliches Substrat, das der Reflexion vorausliegt und von ihrer Selbstbewegung unberührt bleibt.","refs":["CH_GB18_CDR0:A10","CH_GB18_CDR0:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GNX-03","text":"Ausgeschlossen wird ein Inhalt, der seine Wesentlichkeit aus sich selbst trägt oder als unmittelbar gegebene Bestimmtheit der Reflexion vorausliegt.","refs":["CH_GB18_DWUD:NX4","CH_GB18_BDS0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GNX-04","text":"Ausgeschlossen wird eine Negativität, die bloß vernichtet; Nichtigkeit kann nur als Moment eines fortbestehenden und sich selbst reflektierenden Wesens gelten.","refs":["CH_GB18_BDS0:A7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_35:DBN-01","text":"Das System setzt die Unwahrheit jedes ersten Grundes voraus: Ein Ursprung kann nicht bestehen, wenn er nicht selbst als Resultat einer Negationsbewegung rekonstruiert werden kann.","refs":["CH_GB18_CDR0:DNX1","CH_GB18_CDR0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:DBN-02","text":"Das System kann keine Andersheit zulassen, die außerhalb der Negation fortbesteht, weil eine solche Exteriorität die Selbstvermittlung des Wesens in eine Relation zu einem fremden Sein zurückverwandeln würde.","refs":["CH_GB18_CDR0:DNX3","CH_GB18_CDR0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:DBN-03","text":"Das System kann Bestimmtheit nicht aus unabhängig gegebenem Material erklären; sie muss als gesetzte, vorausgesetzte und aufgehobene Form der Reflexion hervorgebracht werden.","refs":["CH_GB18_BDS0:A4","CH_GB18_CDR0:DNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_35:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist ein positives Außen, das der Reflexion Widerstand leistet, ohne bereits Moment ihrer eigenen Negativität zu sein.","refs":["CH_GB18_CDR0:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:BSA-02","text":"Nicht verfügbar ist eine ruhende Grundlage hinter dem Schein; jede vermeintlich letzte Basis wird als Vollzug des Scheinens und der Reflexion absorbiert.","refs":["CH_GB18_BDS0:SNX3","CH_GB18_CDR0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:BSA-03","text":"Unzulässig ist eine lineare Genesis, in der ein positives Sein zunächst gegeben wäre und erst nachträglich negiert würde; Werden ist nur als Rückkehr von Nichts zu Nichts tragfähig.","refs":["CH_GB18_CDR0:DNX4","CH_GB18_CDR0:AS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_35:XD-01","text":"Der Schein wird zur operativen Schnittstelle zwischen aufgehobener Unmittelbarkeit und bestimmender Reflexion: Er bewahrt Bestimmtheit nur als abhängiges Moment und macht sie dadurch für Selbstbestimmung verfügbar.","refs":["CL_GB18_35:GA-02","CL_GB18_35:GA-04","CL_GB18_35:GA-07","CH_GB18_DWUD:A18","CH_GB18_BDS0:A4","CH_GB18_CDR0:D9"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_35:XD-02","text":"Die äußerliche Setzung von Wesentlichem und Unwesentlichem wird auf Clusterebene in das Modell der Voraussetzung überführt: Was zunächst äußerlich klassifiziert wird, erscheint später als von der Reflexion erzeugte und aufhebbare Bedingung.","refs":["CL_GB18_35:GA-06","CL_GB18_35:GA-08","CH_GB18_DWUD:A10","CH_GB18_CDR0:SD4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_35:XD-03","text":"Unmittelbar gegebener Inhalt und ursprüngliches Substrat erweisen sich als homologe Fehlmodelle, weil beide eine Bestimmtheit unterstellen, die vor ihrer reflexiven Vermittlung verfügbar wäre.","refs":["CL_GB18_35:GA-02","CL_GB18_35:GA-08","CH_GB18_BDS0:AS2","CH_GB18_CDR0:A10"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_35:BSD-01","text":"Realität erscheint auf dieser Ebene nicht als geschichtete Ordnung von Sein, Wesen und Erscheinung, sondern als ein einziges Feld selbstaufhebender Bestimmungen mit verschiedenen Reflexionsgraden.","refs":["CL_GB18_35:GA-01","CL_GB18_35:GA-03","CL_GB18_35:GA-05","CH_GB18_CDR0:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_35:BSD-02","text":"Zeitlichkeit verliert die Form eines ersten Anfangs und einer nachfolgenden Vermittlung; das Frühere gilt nur noch als retrospektiv erzeugte Voraussetzung einer gegenwärtigen Reflexionsbewegung.","refs":["CL_GB18_35:GA-02","CL_GB18_35:GA-08","CH_GB18_CDR0:SD1","CH_GB18_CDR0:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_35:BSD-03","text":"Methodisch wird jede Erklärung gezwungen, ihre vorausgesetzten Gründe als Produkte der Bewegung auszuweisen, die sie erklären soll; Analyse wird damit Rekonstruktion von Selbstsetzung und Selbstentzug.","refs":["CL_GB18_35:GA-07","CL_GB18_35:GA-08","CH_GB18_CDR0:FGS6","CH_GB18_BDS0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_35:RLE-01","text":"Die zentrale Schleife lautet: Negation erzeugt reflektierte Unmittelbarkeit, diese erscheint als Voraussetzung, die Voraussetzung wird aufgehoben, und ihre Aufhebung erzeugt bestimmende Reflexion.","refs":["CH_GB18_CDR0:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RLE-02","text":"Die Eskalation verläuft von der äußerlichen Differenz des Wesentlichen und Unwesentlichen über den Schein als nichtige Unmittelbarkeit zur Reflexion, die ihre Differenzen als eigene Momente erzeugt.","refs":["CH_GB18_DWUD:FGS4","CH_GB18_BDS0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RLE-03","text":"Der begriffliche Attraktor ist die Negation der Negation: Sie verhindert sowohl die Rückkehr zu einem positiven Außen als auch den Zerfall der Bewegung in bloße Nichtigkeit.","refs":["CH_GB18_CDR0:A6","CH_GB18_CDR0:D1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_35:FGS-B01","text":"Aufgehobenes Seyn → bewahrte Unmittelbarkeit → vorläufige Gegenüberstellung von Wesen und Seyn.","refs":["CH_GB18_DWUD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FGS-B02","text":"Äußerliche Unterscheidung → Wesentliches und Unwesentliches → Austauschbarkeit der Bestimmungen bei gleichem Inhalt.","refs":["CH_GB18_DWUD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FGS-B03","text":"Nicht-Erhaltung des Anderen → Unwesen → Schein → reflektierte Unmittelbarkeit.","refs":["CH_GB18_DWUD:A17","CH_GB18_BDS0:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FGS-B04","text":"Schein als Sein der Negation → Negation der Negation → Wesen als Reflexion.","refs":["CH_GB18_CDR0:A7","CH_GB18_CDR0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FGS-B05","text":"Absolute Reflexion → Setzung → Voraussetzung → Aufhebung der Voraussetzung → bestimmende Reflexion.","refs":["CH_GB18_CDR0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_35:AFM-B01","text":"Unmittelbares Seyn → aufgehobenes Seyn → Wesen als negative Gleichheit mit sich.","refs":["CH_GB18_DWUD:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AFM-B02","text":"Negative Gleichheit → äußerliche Differenz von Wesentlichem und Unwesentlichem → Entkräftung eines inhaltsimmanenten Kriteriums.","refs":["CH_GB18_DWUD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AFM-B03","text":"Entkräftete Andersheit → Unwesen → Schein als nichtige, aber bestimmte Unmittelbarkeit.","refs":["CH_GB18_DWUD:D6","CH_GB18_BDS0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AFM-B04","text":"Schein → immanente Selbstgliederung des Wesens → Reflexion als Negation der Negation.","refs":["CH_GB18_BDS0:SD1","CH_GB18_CDR0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AFM-B05","text":"Reflexion → Selbstsetzung → vorausgesetzte Unmittelbarkeit → Aufhebung der Voraussetzung → bestimmende Selbstbeziehung.","refs":["CH_GB18_CDR0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_35:MME-01","text":"Die Karte verschiebt sich von einer Ontologie zweier Bereiche zu einer Logik immanenter Differenzierung, in der Wesen und Schein keine getrennten Regionen mehr markieren.","refs":["CH_GB18_BDS0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MME-02","text":"Unmittelbarkeit wird nicht mehr als Alternative zur Vermittlung kartiert, sondern als deren reflektiertes Resultat und als Moment ihrer eigenen Negativität.","refs":["CH_GB18_BDS0:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MME-03","text":"Die strategische Frage verlagert sich von der Identifikation eines wesentlichen Inhalts zur Analyse der Operationen, durch die Bestimmtheit gesetzt, vorausgesetzt und entzogen wird.","refs":["CH_GB18_DWUD:ME5","CH_GB18_CDR0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_35:ALT-B01","text":"Surface level — Seyn erscheint als aufgehoben, nichtig und scheinbar unmittelbar; das Wesen erscheint als dessen eigenes Scheinen und schließlich als Reflexion.","refs":["CH_GB18_BDS0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:ALT-B02","text":"Structural level — Die gesamte Architektur wird durch Aufhebung, Negation der Negation, reflektierte Unmittelbarkeit und die Selbstproduktion von Voraussetzungen organisiert.","refs":["CH_GB18_CDR0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:ALT-B03","text":"Metastrategic level — Jede Berufung auf einen gegebenen Inhalt oder einen ersten Grund wird nicht bloß widerlegt, sondern als noch nicht reflektierte Voraussetzung in die Bewegung selbst zurückgeführt.","refs":["CH_GB18_BDS0:ALT3","CH_GB18_CDR0:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:ALT-B04","text":"Ontological / Temporal level — Realität besitzt keinen ersten ruhenden Grund und keine lineare Entstehungsfolge, sondern besteht als rückkehrende Bewegung, die ihre Bedingungen nachträglich erzeugt.","refs":["CH_GB18_CDR0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:ALT-B05","text":"Methodological / Performative level — Die Form des Arguments vollzieht seine These, indem jede anfänglich ausgesonderte Bestimmung als eigenes Moment der Reflexion wiederkehrt und dadurch ihre anfängliche Selbständigkeit verliert.","refs":["CH_GB18_BDS0:A8","CH_GB18_CDR0:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_35:FL-01","text":"Der Schein muss zugleich nichtig und bestimmt sein; seine Bestimmtheit kann nur bestehen, indem sie unmittelbar als unselbständiges Moment des Wesens zurückgenommen wird.","refs":["CH_GB18_BDS0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FL-02","text":"Die Behauptung absoluter Selbstvermittlung bleibt gespannt gegenüber der eingeräumten Mannigfaltigkeit eines gegebenen Inhalts, dessen positive Erzeugung im Material nicht vollständig ausgearbeitet wird.","refs":["CH_GB18_BDS0:MRT3","CH_GB18_BDS0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FL-03","text":"Die Selbstgenügsamkeit der absoluten Reflexion kollidiert produktiv mit der Notwendigkeit, ein vorausgesetztes Unmittelbares einzuführen; die Spannung treibt die Passage zur bestimmenden Reflexion an.","refs":["CH_GB18_CDR0:MRT6","CH_GB18_CDR0:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MP-01","text":"Unmittelbarkeit mutiert an der Schwelle vom Seynrest zur reflektierten Gleichheit der Negation; derselbe Ausdruck wechselt damit von ontologischem Anschein zu prozessualem Resultat.","refs":["CH_GB18_DWUD:AS2","CH_GB18_CDR0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MP-02","text":"Äußerliche Reflexion ist ein notwendiger Mutationspunkt, weil die Reflexion ihre Voraussetzung nur aufheben kann, indem sie zunächst als voraussetzende Bewegung fortbesteht.","refs":["CH_GB18_CDR0:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_35:HSI-01","text":"Die Realität erscheint implizit als Maschine rekursiver Selbstdifferenzierung, die keine äußeren Materialien verarbeitet, sondern ihre scheinbaren Materialien als eigene Negativitätsformen produziert.","refs":["CH_GB18_CDR0:SD2","CH_GB18_CDR0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:HSI-02","text":"Ein mögliches Subjekt kann innerhalb dieser Architektur nicht als äußerer Träger oder souveräner Ursprung fungieren, sondern nur als nachträglich bestimmbares Moment von Setzung, Voraussetzung und Reflexion.","refs":["CH_GB18_CDR0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:HSI-03","text":"Zeit erscheint nicht als geradliniger Ablauf, sondern als Rückkehrstruktur, in der jede Grundlage erst durch die Bewegung entsteht, die sie scheinbar voraussetzt.","refs":["CH_GB18_CDR0:A11","CH_GB18_CDR0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_35:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Clusterbewegung von aufgehobenem Seyn über Schein zu Reflexion und von dort zu Selbstsetzung, Voraussetzung und bestimmender Reflexion zu rekonstruieren.","refs":["CH_GB18_CDR0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MRT-B02","text":"Unterbestimmt bleibt die positive Genesis mannigfaltiger Bestimmtheit, weil deren gegebene Form kritisiert und ihre reflexive Abhängigkeit bestimmt wird, ohne ihre vollständige Produktion auszudifferenzieren.","refs":["CH_GB18_BDS0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MRT-B03","text":"Die Architektur ist kohärent, sofern Unmittelbarkeit durchgehend als Resultat, Moment oder Voraussetzung der Negativität gelesen wird; sie wird instabil, sobald Unmittelbarkeit erneut als unabhängiger Ursprung gilt.","refs":["CH_GB18_CDR0:MRT4","CH_GB18_CDR0:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122120665517Z_d7efb6f1","language_code":"en","language_name":"English","title":"Chapters 103–105","source_sha256":"13105f8d7036030030f945b60570d2935f9c3380958f2dff43ecd17dcb314b9b","sha256":"6f46708d7e84bba7f4a1c70da5702f584ee11ca963d8d22dc797ef4f9f89bfe6","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:21:20.666614+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_35:AS-01","text":"The cluster movement determines how essence emerges from sublated Seyn, without preserving this Seyn as an independent ground or as an enduring counterpart.","refs":["CH_GB18_DWUD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AS-02","text":"The initial difference between essence and Seyn is not stabilized as an ontological duality, but reconstructed as a provisional form of a negativity that takes its otherness back into itself.","refs":["CH_GB18_DWUD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AS-03","text":"Semblance functions as a critical threshold: it preserves immediacy only as a null moment and transforms its apparent independence into reflected dependence.","refs":["CH_GB18_BDS0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AS-04","text":"The movement escalates from external distinction through absolute negativity to a reflection that itself posits, presupposes, and sublates its presuppositions.","refs":["CH_GB18_CDR0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AS-05","text":"The closure does not consist in a final positive ground, but in determining reflection as the explicit self-production and self-sublation of its own basis.","refs":["CH_GB18_CDR0:D9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_35:GA-01","text":"[Persistent] Essence is actual only as negativity; its equality with itself is not a resting identity, but the form of its self-mediation.","refs":["CH_GB18_DWUD:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-02","text":"[Mutating] Immediacy mutates from the preserved remainder of sublated Seyn, through reflected immediacy, into a posited and sublatable moment of reflection.","refs":["CH_GB18_DWUD:AS2","CH_GB18_BDS0:A3","CH_GB18_CDR0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-03","text":"[Persistent] Otherness possesses no independent external position, but consists exclusively as immanent negation and as negation of negation.","refs":["CH_GB18_CDR0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-04","text":"[Emergent] Semblance is neither mere non-essence nor an external sphere of appearance, but the manner in which essence exposes its sublated immediacy as its own moment.","refs":["CH_GB18_DWUD:A18","CH_GB18_BDS0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-05","text":"[Attractor] Reflection is the self-movement of a negativity that does not negate a foreign object, but produces, takes back, and thereby determines its own negative.","refs":["CH_GB18_CDR0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-06","text":"[Mutating] The distinction between the essential and the inessential loses its classificatory status and becomes the provisional form of appearance of a determination that invalidates itself.","refs":["CH_GB18_DWUD:A10","CH_GB18_BDS0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-07","text":"[Terminal] Determining reflection is not a return to an original basis, but the operation through which reflection sublates its self-posited presupposition as its own result.","refs":["CH_GB18_CDR0:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GA-08","text":"[Attractor] Every apparent ground becomes legible within the movement as a produced presupposition and thereby loses the rank of an independent origin.","refs":["CH_GB18_CDR0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_35:RMD-01","text":"Immediacy remains persistent as a concept, but changes its function from a preserved remainder of sublation to the equality of negation with itself and finally to a presupposition valid only reflectively.","refs":["CH_GB18_DWUD:AS2","CH_GB18_CDR0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RMD-02","text":"Semblance mutates from null non-essence, through the essence's own shining, into immediate reflection, and thereby loses every status as a merely external residual phenomenon.","refs":["CH_GB18_DWUD:A17","CH_GB18_BDS0:A9","CH_GB18_CDR0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RMD-03","text":"Otherness is initially exposed as the equal standing of two immediacies, then absorbed as inner negativity, and finally determined as negation with negation.","refs":["CH_GB18_DWUD:A7","CH_GB18_CDR0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RMD-04","text":"Negation shifts from the sublation of Seyn to the productive self-differentiation of essence; its function is not annihilation, but the production of reflected determinacy.","refs":["CH_GB18_DWUD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RMD-05","text":"The presupposition moves from an apparently antecedent immediate to a functional moment produced and again withdrawn by reflection.","refs":["CH_GB18_CDR0:D8","CH_GB18_CDR0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_35:CGD-01","text":"The interchangeability of the essential and the inessential with the same content remains a local diagnosis of external positing; at the cluster level it becomes legible as a symptom of the impossibility of every criterion of essentiality immanent to content.","refs":["CH_GB18_DWUD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:CGD-02","text":"The absolute negativity of Seyn is not merely a local determination of essence, but the global condition under which semblance, immediacy, and reflection can appear as internal moments of a movement.","refs":["CH_GB18_DWUD:A13","CH_GB18_BDS0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:CGD-03","text":"The critique of sceptical and idealist given content remains locally bound to particular philosophical positions, but scales into the general rejection of every prereflectively available determinacy.","refs":["CH_GB18_BDS0:D3","CH_GB18_CDR0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:CGD-04","text":"The tripartition into positing, external, and determining reflection is not to be treated as a local typology, but as an operative sequence in which self-positing, presupposing, and sublation mutually produce one another.","refs":["CH_GB18_CDR0:A15","CH_GB18_CDR0:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_35:GNX-01","text":"Excluded is a two-world model in which essence and appearance subsist as stable, separate spheres with their own independence.","refs":["CH_GB18_DWUD:DNX2","CH_GB18_BDS0:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GNX-02","text":"Excluded is an original substrate that precedes reflection and remains untouched by its self-movement.","refs":["CH_GB18_CDR0:A10","CH_GB18_CDR0:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GNX-03","text":"Excluded is a content that bears its essentiality from itself or precedes reflection as immediately given determinacy.","refs":["CH_GB18_DWUD:NX4","CH_GB18_BDS0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:GNX-04","text":"Excluded is a negativity that merely annihilates; nullity can count only as a moment of an enduring and self-reflecting essence.","refs":["CH_GB18_BDS0:A7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_35:DBN-01","text":"The system presupposes the untruth of every first ground: an origin cannot subsist unless it can itself be reconstructed as the result of a movement of negation.","refs":["CH_GB18_CDR0:DNX1","CH_GB18_CDR0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:DBN-02","text":"The system cannot admit an otherness that persists outside negation, because such exteriority would transform the self-mediation of essence back into a relation to a foreign being.","refs":["CH_GB18_CDR0:DNX3","CH_GB18_CDR0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:DBN-03","text":"The system cannot explain determinacy from independently given material; it must be produced as a posited, presupposed, and sublated form of reflection.","refs":["CH_GB18_BDS0:A4","CH_GB18_CDR0:DNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_35:BSA-01","text":"The most deeply excluded possibility is a positive outside that resists reflection without already being a moment of its own negativity.","refs":["CH_GB18_CDR0:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:BSA-02","text":"Unavailable is a resting foundation behind semblance; every supposedly final basis is absorbed as the enactment of shining and reflection.","refs":["CH_GB18_BDS0:SNX3","CH_GB18_CDR0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:BSA-03","text":"Inadmissible is a linear genesis in which a positive being would first be given and only subsequently negated; becoming is viable only as the return from nothing to nothing.","refs":["CH_GB18_CDR0:DNX4","CH_GB18_CDR0:AS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_35:XD-01","text":"Semblance becomes the operative interface between sublated immediacy and determining reflection: it preserves determinacy only as a dependent moment and thereby makes it available for self-determination.","refs":["CL_GB18_35:GA-02","CL_GB18_35:GA-04","CL_GB18_35:GA-07","CH_GB18_DWUD:A18","CH_GB18_BDS0:A4","CH_GB18_CDR0:D9"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_35:XD-02","text":"The external positing of the essential and the inessential is transferred at the cluster level into the model of presupposition: what is initially classified externally later appears as a condition produced and sublatable by reflection.","refs":["CL_GB18_35:GA-06","CL_GB18_35:GA-08","CH_GB18_DWUD:A10","CH_GB18_CDR0:SD4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_35:XD-03","text":"Immediately given content and original substrate prove to be homologous erroneous models, because both presuppose a determinacy that would be available prior to its reflective mediation.","refs":["CL_GB18_35:GA-02","CL_GB18_35:GA-08","CH_GB18_BDS0:AS2","CH_GB18_CDR0:A10"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_35:BSD-01","text":"At this level, reality appears not as a stratified order of being, essence, and appearance, but as a single field of self-sublating determinations with different degrees of reflection.","refs":["CL_GB18_35:GA-01","CL_GB18_35:GA-03","CL_GB18_35:GA-05","CH_GB18_CDR0:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_35:BSD-02","text":"Temporality loses the form of a first beginning and subsequent mediation; the earlier counts only as a retrospectively produced presupposition of a present movement of reflection.","refs":["CL_GB18_35:GA-02","CL_GB18_35:GA-08","CH_GB18_CDR0:SD1","CH_GB18_CDR0:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_35:BSD-03","text":"Methodologically, every explanation is compelled to exhibit its presupposed grounds as products of the movement it is meant to explain; analysis thereby becomes reconstruction of self-positing and self-withdrawal.","refs":["CL_GB18_35:GA-07","CL_GB18_35:GA-08","CH_GB18_CDR0:FGS6","CH_GB18_BDS0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_35:RLE-01","text":"The central loop is: negation produces reflected immediacy, this appears as presupposition, the presupposition is sublated, and its sublation produces determining reflection.","refs":["CH_GB18_CDR0:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RLE-02","text":"The escalation proceeds from the external difference of the essential and the inessential, through semblance as null immediacy, to reflection, which produces its differences as its own moments.","refs":["CH_GB18_DWUD:FGS4","CH_GB18_BDS0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:RLE-03","text":"The conceptual attractor is the negation of negation: it prevents both the return to a positive outside and the disintegration of the movement into mere nullity.","refs":["CH_GB18_CDR0:A6","CH_GB18_CDR0:D1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_35:FGS-B01","text":"Sublated Seyn → preserved immediacy → provisional juxtaposition of essence and Seyn.","refs":["CH_GB18_DWUD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FGS-B02","text":"External distinction → essential and inessential → interchangeability of determinations with the same content.","refs":["CH_GB18_DWUD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FGS-B03","text":"Non-preservation of the other → non-essence → semblance → reflected immediacy.","refs":["CH_GB18_DWUD:A17","CH_GB18_BDS0:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FGS-B04","text":"Semblance as the being of negation → negation of negation → essence as reflection.","refs":["CH_GB18_CDR0:A7","CH_GB18_CDR0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FGS-B05","text":"Absolute reflection → positing → presupposition → sublation of presupposition → determining reflection.","refs":["CH_GB18_CDR0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_35:AFM-B01","text":"Immediate Seyn → sublated Seyn → essence as negative equality with itself.","refs":["CH_GB18_DWUD:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AFM-B02","text":"Negative equality → external difference of essential and inessential → invalidation of a criterion immanent to content.","refs":["CH_GB18_DWUD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AFM-B03","text":"Invalidated otherness → non-essence → semblance as null, yet determinate, immediacy.","refs":["CH_GB18_DWUD:D6","CH_GB18_BDS0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AFM-B04","text":"Semblance → immanent self-articulation of essence → reflection as negation of negation.","refs":["CH_GB18_BDS0:SD1","CH_GB18_CDR0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:AFM-B05","text":"Reflection → self-positing → presupposed immediacy → sublation of presupposition → determining self-relation.","refs":["CH_GB18_CDR0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_35:MME-01","text":"The map shifts from an ontology of two domains to a logic of immanent differentiation, in which essence and semblance no longer mark separate regions.","refs":["CH_GB18_BDS0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MME-02","text":"Immediacy is no longer mapped as an alternative to mediation, but as its reflected result and as a moment of its own negativity.","refs":["CH_GB18_BDS0:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MME-03","text":"The strategic question shifts from the identification of an essential content to the analysis of the operations through which determinacy is posited, presupposed, and withdrawn.","refs":["CH_GB18_DWUD:ME5","CH_GB18_CDR0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_35:ALT-B01","text":"Surface level — Seyn appears as sublated, null, and apparently immediate; essence appears as its own shining and finally as reflection.","refs":["CH_GB18_BDS0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:ALT-B02","text":"Structural level — The entire architecture is organized through sublation, negation of negation, reflected immediacy, and the self-production of presuppositions.","refs":["CH_GB18_CDR0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:ALT-B03","text":"Metastrategic level — Every appeal to a given content or a first ground is not merely refuted, but led back into the movement itself as a presupposition not yet reflected.","refs":["CH_GB18_BDS0:ALT3","CH_GB18_CDR0:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:ALT-B04","text":"Ontological / Temporal level — Reality possesses no first resting ground and no linear sequence of emergence, but consists as a returning movement that retrospectively produces its conditions.","refs":["CH_GB18_CDR0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:ALT-B05","text":"Methodological / Performative level — The form of the argument enacts its thesis by having every initially segregated determination return as reflection's own moment and thereby lose its initial independence.","refs":["CH_GB18_BDS0:A8","CH_GB18_CDR0:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_35:FL-01","text":"Semblance must be both null and determinate; its determinacy can subsist only by being immediately taken back as a dependent moment of essence.","refs":["CH_GB18_BDS0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FL-02","text":"The assertion of absolute self-mediation remains in tension with the acknowledged multiplicity of a given content, whose positive production is not fully elaborated in the material.","refs":["CH_GB18_BDS0:MRT3","CH_GB18_BDS0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:FL-03","text":"The self-sufficiency of absolute reflection productively collides with the necessity of introducing a presupposed immediate; the tension drives the passage toward determining reflection.","refs":["CH_GB18_CDR0:MRT6","CH_GB18_CDR0:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MP-01","text":"Immediacy mutates at the threshold from the remainder of Seyn to the reflected equality of negation; the same expression thereby shifts from ontological appearance to procedural result.","refs":["CH_GB18_DWUD:AS2","CH_GB18_CDR0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MP-02","text":"External reflection is a necessary mutation point, because reflection can sublate its presupposition only by initially persisting as a presupposing movement.","refs":["CH_GB18_CDR0:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_35:HSI-01","text":"Reality appears implicitly as a machine of recursive self-differentiation that processes no external materials, but produces its apparent materials as forms of its own negativity.","refs":["CH_GB18_CDR0:SD2","CH_GB18_CDR0:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:HSI-02","text":"Within this architecture, a possible subject cannot function as an external bearer or sovereign origin, but only as a retrospectively determinable moment of positing, presupposition, and reflection.","refs":["CH_GB18_CDR0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:HSI-03","text":"Time appears not as a linear course, but as a return structure in which every foundation first arises through the movement that apparently presupposes it.","refs":["CH_GB18_CDR0:A11","CH_GB18_CDR0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_35:MRT-B01","text":"The extracted axioms suffice to reconstruct the cluster movement from sublated Seyn through semblance to reflection, and from there to self-positing, presupposition, and determining reflection.","refs":["CH_GB18_CDR0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MRT-B02","text":"The positive genesis of manifold determinacy remains underdetermined, because its given form is criticized and its reflective dependence determined without differentiating its complete production.","refs":["CH_GB18_BDS0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_35:MRT-B03","text":"The architecture is coherent insofar as immediacy is throughout read as a result, moment, or presupposition of negativity; it becomes unstable as soon as immediacy again counts as an independent origin.","refs":["CH_GB18_CDR0:MRT4","CH_GB18_CDR0:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_35@R001","source_variant_id":"canonical:CL_GB18_35:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 103–105","context":"A. Das Wesentliche und das Unwesentliche. · B. Der Schein. · C. Die Reflexion."},"title_language_code":"en"},{"id":"CL_GB18_36","layer":"CL","title":"Chapters 106–108","order":36,"parents":["CH_GB18_1DSR","CH_GB18_2DUR","CH_GB18_3BR0"],"revision":"CL_GB18_36@R001","sha256":"e7992cb99001d47c3f4f8d6b7288bdf91e7aa31d3295c92d9f19fb6640d3cdef","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_36:BAS-01","text":"Das Problem des Clusters besteht darin, dass Unmittelbarkeit als Anfang erscheinen muss, obwohl sie nur als rückläufiger Effekt selbstnegativer Reflexion besteht.","refs":["CH_GB18_1DSR:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BAS-02","text":"Seine Grundthese bestimmt Reflexion als Bewegung, in der Negativität sich selbst aufhebt, als Gleichheit mit sich zurückkehrt und dadurch erst Unmittelbarkeit erzeugt.","refs":["CH_GB18_1DSR:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BAS-03","text":"Die Bewegung ist rekursiv: Setzen erzeugt Voraussetzung, Voraussetzung kehrt als gesetzte Negativität zurück, und die Unterscheidung ihrer Momente wird zur Selbstbewegung.","refs":["CH_GB18_1DSR:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BAS-04","text":"Die zunächst äußere Reflexion wird nicht verworfen, sondern als notwendige Erscheinungsform einer immanenten Bestimmung überführt.","refs":["CH_GB18_2DUR:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BAS-05","text":"Die Schließung des Clusters liegt in der Reflexionsbestimmung, deren Anderssein nicht außerhalb ihrer besteht, sondern als ihre eigene Negation auf sie zurückbezogen wird.","refs":["CH_GB18_3BR0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BAS-06","text":"Diese Schließung bleibt instabil, weil die Bestimmungen zugleich als selbständige Wesenheiten und als wechselseitig vorausgesetzte Momente bestehen müssen.","refs":["CH_GB18_2DUR:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_36:GA-01","text":"[Persistent] Negativität ist nicht Mangel an Sein, sondern die selbstbezügliche Operation, durch welche Reflexion ihre eigene Gleichheit erzeugt.","refs":["CH_GB18_1DSR:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-02","text":"[Persistent] Unmittelbarkeit ist kein vorausliegender Grund, sondern reflektiertes Gesetztsein, das nur als Rückkehr der Negativität besteht.","refs":["CH_GB18_1DSR:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-03","text":"[Mutating] Setzen und Voraussetzen sind keine getrennten Akte, sondern gegenläufige Funktionen derselben reflektierenden Bewegung.","refs":["CH_GB18_1DSR:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-04","text":"[Mutating] Äußere Reflexion enthält ihre immanente Wahrheit, weil ihr vorgefundenes Anderes erst durch ihre eigene Operation als Voraussetzung erscheint.","refs":["CH_GB18_2DUR:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-05","text":"[Emergent] Bestimmende Reflexion entsteht nur aus der Einheit von setzender und äußerer Reflexion; keine der beiden Formen kann die Bestimmung allein vollenden.","refs":["CH_GB18_3BR0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-06","text":"[Persistent] Gesetztsein besteht nur als aufgehobenes Anderssein und gewinnt seine Wirklichkeit ausschließlich in der Rückkehr auf sich.","refs":["CH_GB18_3BR0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-07","text":"[Emergent] Reflexionsbestimmung hat ihren Bestand nicht im Sein, sondern im Reflektiertsein der Negation in sich selbst.","refs":["CH_GB18_3BR0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-08","text":"[Attractor] Anderssein wird nicht beseitigt, sondern als eigene aufgehobene Negation in die Selbstbeziehung der Bestimmung integriert.","refs":["CH_GB18_3BR0:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-09","text":"[Terminal] Wesen ist kein Hinterraum der Bestimmungen, sondern deren Status als aufgehobene und auf sich zurückkehrende Negativität.","refs":["CH_GB18_3BR0:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_36:RMD-01","text":"Negativität bleibt als Selbstbeziehung identisch, mutiert jedoch von der Selbstnegation der Reflexion zur Bedingung, unter der bestimmte Reflexionsformen Bestand gewinnen.","refs":["CH_GB18_1DSR:AS2","CH_GB18_3BR0:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RMD-02","text":"Unmittelbarkeit verschiebt sich von gesetzter Rückkehr über vorausgesetztes Gegenüber zu wesentlicher Unmittelbarkeit und verliert damit endgültig den Status eines ersten Positiven.","refs":["CH_GB18_1DSR:A8","CH_GB18_2DUR:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RMD-03","text":"Voraussetzen mutiert von der Umkehrung des Setzens zur absoluten Form, in der äußere und setzende Reflexion ihre Trennung aufheben.","refs":["CH_GB18_1DSR:A11","CH_GB18_3BR0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RMD-04","text":"Das Andere erscheint zunächst als erzeugtes Gegenüber, wird dann aber als internes Anderssein der Reflexionsbestimmung absorbiert.","refs":["CH_GB18_1DSR:AS6","CH_GB18_3BR0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RMD-05","text":"Wesen verschiebt sich von Rückkehrbewegung zu einer im Status der Bestimmungen wirksamen Selbstvermittlung; es existiert nur als deren aufgehobene Negativität.","refs":["CH_GB18_1DSR:D4","CH_GB18_3BR0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RMD-06","text":"Die reflektierende Urteilskraft bleibt eine lokale Gestalt der äußeren Reflexion und wird in die allgemeinere Maschine der Wesensbestimmung absorbiert.","refs":["CH_GB18_2DUR:A11","CH_GB18_2DUR:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_36:CGD-01","text":"Die Kantische Differenz von reflektierender und bestimmender Urteilskraft bleibt auf der unteren Ebene ein exemplarischer Sonderfall; auf Clusterebene zählt nur ihre Einordnung in die allgemeine Reflexionsmaschine.","refs":["CH_GB18_2DUR:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:CGD-02","text":"Der Schein eines ursprünglichen Anfangs gehört zur lokalen Auslösung der Bewegung, wird auf Clusterebene jedoch als notwendiger Effekt retrospektiver Setzung umcodiert.","refs":["CH_GB18_1DSR:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:CGD-03","text":"Die Requalifikation jeder Voraussetzung als Resultat aufgehobenen Setzens skaliert über die einzelnen Reflexionsformen hinaus und wird zum globalen Organisationsprinzip.","refs":["CH_GB18_2DUR:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:CGD-04","text":"Die Unterscheidung von Qualität und Reflexionsbestimmung ist lokal begrifflich, erhält aber globale Funktion, weil sie den Übergang vom Sein als Boden zur Selbstreflexion als Bestand erklärt.","refs":["CH_GB18_3BR0:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:CGD-05","text":"Äußere Reflexion ist auf der unteren Ebene eine bestimmte Ausgangsform, auf Clusterebene aber die notwendige Differenzform, durch die Immanenz ihre eigene Vermittlung sichtbar macht.","refs":["CH_GB18_2DUR:NX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_36:GNX-01","text":"Ausgeschlossen ist ein unabhängiger Grund, der der Reflexion vorausliegt und ihre Bewegung von außen trägt.","refs":["CH_GB18_1DSR:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GNX-02","text":"Ausgeschlossen ist eine ursprüngliche, reflexionslose Unmittelbarkeit, die als erstes Positives fungieren könnte.","refs":["CH_GB18_1DSR:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GNX-03","text":"Ausgeschlossen ist eine lineare Ordnung von Anfang, Übergang und Resultat, weil jedes Vorausgesetzte nur als aufgehobenes Gesetztsein besteht.","refs":["CH_GB18_1DSR:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GNX-04","text":"Ausgeschlossen ist ein Erkenntnismodell, in dem Reflexion einem in sich fertigen Gegenstand nachträgliche Prädikate hinzufügt.","refs":["CH_GB18_2DUR:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GNX-05","text":"Ausgeschlossen ist ein irreduzibel äußeres Anderssein, das sich der Rücknahme in die Selbstbeziehung der Reflexion entzöge.","refs":["CH_GB18_3BR0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_36:DBN-01","text":"Falsch sein muss jedes Modell, das Bestimmungen durch einen positiven und ihnen äußerlichen Seinsgrund dauerhaft absichert.","refs":["CH_GB18_3BR0:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:DBN-02","text":"Falsch sein muss die Annahme zweier selbständiger Bereiche von Wesen und Erscheinung, zwischen denen lediglich äußere Vermittlung stattfände.","refs":["CH_GB18_2DUR:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:DBN-03","text":"Falsch sein muss eine endgültige Trennung von Setzen und Voraussetzen, weil ihre Differenz nur die doppelte Funktion derselben Rückkehr markiert.","refs":["CH_GB18_1DSR:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:DBN-04","text":"Falsch sein muss eine finale Ruhe reflektierter Bestimmungen, da ihr Anspruch auf Selbständigkeit stets durch wechselseitige Voraussetzung unterlaufen wird.","refs":["CH_GB18_2DUR:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_36:BSA-01","text":"Nicht verfügbar ist ein nicht gesetzter Anfang, der der Reflexion als schlechthin unvermittelte Grundlage vorausliegen könnte.","refs":["CH_GB18_1DSR:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSA-02","text":"Nicht verfügbar ist eine reine Immanenz, die das Moment des Anderen restlos tilgt; die Selbstbeziehung benötigt die wiederkehrende Differenz.","refs":["CH_GB18_1DSR:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSA-03","text":"Nicht zulässig ist eine Bestimmung, deren Identität ohne Aufhebung ihres eigenen Gesetztseins begriffen werden könnte.","refs":["CH_GB18_3BR0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_36:XD-01","text":"Das Vorgefundene erhält seinen Status als Gegenstand nicht vor der Reflexion, sondern durch die Operation, in der Setzung sich aufhebt und ihr eigenes Resultat als Voraussetzung ausstellt; Gegebenheit ist daher ein erzeugter Modus von Gegenständlichkeit. ; Trace Type — Composite","refs":["CL_GB18_36:GA-02","CL_GB18_36:GA-03","CL_GB18_36:GA-04","CH_GB18_1DSR:AS4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_36:XD-02","text":"Die äußerliche Reflexion ist nicht bloß eine defiziente Vorstufe, sondern die notwendige Differenzform, durch deren Aufhebung bestimmende Reflexion als vollständige Selbstvermittlung entsteht. ; Trace Type — Composite","refs":["CL_GB18_36:GA-04","CL_GB18_36:GA-05","CH_GB18_1DSR:AS6","CH_GB18_3BR0:A1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_36:XD-03","text":"Die Stabilität reflektierter Bestimmungen ist zugleich ihre Instabilität: Ihr Anspruch auf Wesenheit fixiert sie, aber gerade diese Fixierung internalisiert das Negative und erzwingt ihre Vermittlung. ; Trace Type — Tension","refs":["CL_GB18_36:GA-07","CL_GB18_36:GA-08","CH_GB18_2DUR:D7","CH_GB18_3BR0:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_36:XD-04","text":"Produktive Negation bedeutet weder Vernichtung noch bloße Abstraktion, sondern die Aufhebung von Fremdheit durch Selbstgleichheit; erst dadurch kann Bestimmung als wesentlich gelten. ; Trace Type — Composite","refs":["CL_GB18_36:GA-01","CL_GB18_36:GA-07","CH_GB18_2DUR:D3","CH_GB18_3BR0:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_36:XD-05","text":"Die logische Zeit des Systems ist retrospektiv: Was als Anfang erscheint, wird erst durch seine spätere Rückkehr als Anfang bestimmt. ; Trace Type — Composite","refs":["CL_GB18_36:GA-02","CL_GB18_36:GA-03","CH_GB18_1DSR:D2","CH_GB18_3BR0:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_36:BSD-01","text":"Realität erscheint als Feld erzeugter Gegenüberstellungen, in dem Gegenstand und Reflexion keine getrennten Seiten, sondern interne Differenzen einer Selbstvermittlung sind.","refs":["CH_GB18_2DUR:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSD-02","text":"Zeitlichkeit wird von einer Ordnung ursprünglicher Priorität in eine Ordnung logischer Rückläufigkeit transformiert, in der Bedingung und Resultat sich wechselseitig erzeugen.","refs":["CH_GB18_2DUR:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSD-03","text":"Erkenntnis wird nicht als Zuschreibung äußerer Bestimmungen, sondern als Vollzug begriffen, in dem die Bestimmungen das eigentliche Sein des Gegenstandes artikulieren.","refs":["CH_GB18_2DUR:DNX2","CH_GB18_2DUR:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSD-04","text":"Freiheit der Bestimmungen besteht nicht in ihrer Ablösung von Vermittlung, sondern in ihrer Fixierung durch eine Negativität, die vollständig auf sich zurückgeführt ist.","refs":["CH_GB18_3BR0:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSD-05","text":"Das System erzeugt eine Ontologie wesentlicher Differenzen, in der jede bestimmte Seite nur durch ihre immanente Beziehung auf ihre eigene Negation wirklich ist.","refs":["CH_GB18_3BR0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_36:RLE-01","text":"Die primäre Schleife verläuft von Selbstnegation über Unmittelbarkeit und Gesetztsein zum Voraussetzen und kehrt von dort als absoluter Gegenstoß in die Selbstbewegung zurück.","refs":["CH_GB18_1DSR:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RLE-02","text":"Die Schleife der Äußerlichkeit bestimmt das Unmittelbare als Anderes, negiert dessen Fremdheit und lässt es als wesentliche Unmittelbarkeit mit der Reflexion zusammengehen.","refs":["CH_GB18_2DUR:FGS3","CH_GB18_2DUR:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RLE-03","text":"Die Eskalation zur bestimmenden Reflexion setzt ein, wenn die Einheit von äußerer und setzender Reflexion nicht als Addition, sondern als absolutes Voraussetzen begriffen wird.","refs":["CH_GB18_3BR0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RLE-04","text":"Der Attraktor der Bestimmungen besteht in ihrer paradoxen Fixierung: Sie erscheinen selbständig, können diese Selbständigkeit aber nur durch die Vermittlung behaupten, die sie verdecken.","refs":["CH_GB18_2DUR:SD4","CH_GB18_2DUR:AF6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_36:FGS-B01","text":"Selbstbezügliche Negativität → Selbstnegation → aufgehobene Negativität als Gleichheit mit sich.","refs":["CH_GB18_1DSR:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FGS-B02","text":"Gleichheit mit sich → Unmittelbarkeit als Gesetztsein → Rückkehrbedürftigkeit des Gesetzten.","refs":["CH_GB18_1DSR:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FGS-B03","text":"Selbstaufhebendes Setzen → erzeugte Voraussetzung → Unmittelbarkeit als negatives Gegenüber der Reflexion.","refs":["CH_GB18_2DUR:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FGS-B04","text":"Negatives Gegenüber → Negation seiner Fremdheit → wesentliche Unmittelbarkeit als immanente Wahrheit äußerer Reflexion.","refs":["CH_GB18_2DUR:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FGS-B05","text":"Einheit von äußerer und setzender Reflexion → absolutes Voraussetzen → in sich reflektierte Negation mit eigenem Bestand.","refs":["CH_GB18_3BR0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FGS-B06","text":"In sich reflektierte Negation → Anderssein als eigene Negation → Reflexionsbestimmung als bestimmter Schein des Wesens.","refs":["CH_GB18_3BR0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_36:AFM-B01","text":"Schein eines Anfangs → Selbstbezüglichkeit der Negativität → Rücknahme des scheinbar gegebenen Ursprungs.","refs":["CH_GB18_1DSR:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:AFM-B02","text":"Rücknahme des Ursprungs → Gesetztsein → Voraussetzung als aufgehobenes Resultat des Setzens.","refs":["CH_GB18_2DUR:D1","CH_GB18_2DUR:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:AFM-B03","text":"Voraussetzung → Bestimmung des Unmittelbaren als Anderes → Negation der eigenen Bestimmung dieser Fremdheit.","refs":["CH_GB18_2DUR:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:AFM-B04","text":"Aufhebung der Fremdheit → wesentliche Unmittelbarkeit → immanente Bestimmung des Wesens.","refs":["CH_GB18_2DUR:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:AFM-B05","text":"Immanente Bestimmung → Reflexionsbestimmung → Negativität als selbsttragender Bestand.","refs":["CH_GB18_3BR0:AF4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:AFM-B06","text":"Internalisierung des Andersseins → unendliche Beziehung auf sich → bestimmter Schein als stabile, aber vermittelte Differenz.","refs":["CH_GB18_3BR0:AF6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_36:MME-01","text":"Der Anfang wird von einer ursprünglichen Gegebenheit zu einem retrospektiv erzeugten Effekt der Rückkehr umkartiert.","refs":["CH_GB18_1DSR:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MME-02","text":"Die Gegenüberstellung von Gegenstand und Reflexion zerfällt als äußere Opposition und wird als interne Differenz einer Selbstvermittlungsbewegung lesbar.","refs":["CH_GB18_2DUR:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MME-03","text":"Dasein wird vom positiven Grundbestand zur reduzierten Form des Gesetztseins im Wesen umklassifiziert.","refs":["CH_GB18_3BR0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MME-04","text":"Negation wird vom Moment des Verschwindens zum Träger wesentlicher Beständigkeit umgeordnet.","refs":["CH_GB18_3BR0:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MME-05","text":"Anderssein wird von äußerer Gegenposition zur immanenten Struktur jeder Reflexionsbestimmung reklassifiziert.","refs":["CH_GB18_3BR0:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_36:ALT-B01","text":"Surface level — Das explizite Feld des Clusters umfasst Schein, Unmittelbarkeit, Gesetztsein, Voraussetzung, Wesen und Reflexionsbestimmung.","refs":["CH_GB18_3BR0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:ALT-B02","text":"Structural level — Setzen, Aufheben und Voraussetzen bilden keine aufeinanderfolgenden Operationen, sondern eine rekursive Maschine der Erzeugung und Rücknahme von Bestimmtheit.","refs":["CH_GB18_2DUR:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:ALT-B03","text":"Metastrategic level — Das System disqualifiziert gleichermaßen Erklärungen aus unmittelbarer Gegebenheit und aus isoliertem subjektivem Setzen.","refs":["CH_GB18_3BR0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:ALT-B04","text":"Ontological / Temporal level — Ontologische Priorität erscheint als nachträgliche Setzung; Identität besteht als fortgesetzte Rückkehr aus Anderssein in sich.","refs":["CH_GB18_2DUR:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie jeden scheinbaren Ausgangspunkt auf die Operation zurückführt, die ihn erst erzeugt.","refs":["CH_GB18_1DSR:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_36:FL-01","text":"Die Unmittelbarkeit muss zunächst als selbstbezügliches Reales gelten, obwohl sie systematisch nur als nachträgliches Resultat reflexiver Vermittlung Bestand hat.","refs":["CH_GB18_2DUR:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FL-02","text":"Reflektierte Bestimmungen müssen zugleich als wesentliche Selbständigkeiten und als wechselseitig vorausgesetzte Momente auftreten; ihre Eigenständigkeit ist daher konstitutiv prekär.","refs":["CH_GB18_2DUR:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FL-03","text":"Die Freiheit der Reflexionsbestimmungen bleibt spannungsvoll, weil sie vollständige Abhängigkeit von absoluter Reflexion voraussetzt.","refs":["CH_GB18_3BR0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MP-01","text":"Unmittelbarkeit mutiert vom Resultat der Selbstnegation zur Voraussetzung äußerer Reflexion und wird schließlich als wesentliche Unmittelbarkeit requalifiziert.","refs":["CH_GB18_1DSR:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MP-02","text":"Voraussetzen mutiert von einer scheinbaren Vorfindlichkeit zur Selbstabstoßung der Reflexion, durch welche diese ihre eigene Bestimmtheit als Gegenüber hervorbringt.","refs":["CH_GB18_2DUR:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MP-03","text":"Negation mutiert von Aufhebung und Rückkehr zur Trägerform stabiler Bestimmung; sie wird dadurch zugleich destruktiv und konstitutiv.","refs":["CH_GB18_3BR0:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MP-04","text":"Anderssein mutiert vom äußerlichen Gegenstand zur eigenen aufgehobenen Negation der Reflexionsbestimmung.","refs":["CH_GB18_3BR0:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_36:HSI-01","text":"Die Realität erscheint als Maschine erzeugter Gegenüber, in der jedes Negative nur als Relation innerhalb einer Selbstvermittlung existiert.","refs":["CH_GB18_2DUR:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:HSI-02","text":"Das Subjekt ist keine vorausgesetzte Instanz, sondern die performative Stelle, an der Setzen, Aufheben und Voraussetzen als dieselbe Selbstbewegung lesbar werden.","refs":["CH_GB18_3BR0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:HSI-03","text":"Zeit ist keine Abfolge unabhängiger Zustände, sondern die rückläufige Ordnung, in der Bestimmung durch die Rückkehr aus ihrem Anderssein entsteht.","refs":["CH_GB18_3BR0:AF6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_36:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Überführung von setzender und äußerer Reflexion in bestimmende Reflexion als zentrale Clustermaschine zu rekonstruieren.","refs":["CH_GB18_3BR0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MRT-B02","text":"Unterbestimmt bleibt, wie die Einheit von setzender und äußerer Reflexion ihre eigene Einheit begründet, ohne diese bereits als absolutes Voraussetzen vorauszusetzen.","refs":["CH_GB18_3BR0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MRT-B03","text":"Die Rekonstruktion bleibt nur kohärent, wenn Gesetztsein zugleich als notwendige Unmittelbarkeit und als aufzuhebendes Moment behandelt wird.","refs":["CH_GB18_3BR0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MRT-B04","text":"Die stärkste Stelle der Architektur ist die Umkehrung von Gegebenheit in erzeugte Voraussetzung; ihr irreduzibler Rest liegt in der nicht vollständig vermittelten Spannung zwischen äußerer Form und absoluter Reflexion.","refs":["CH_GB18_2DUR:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122151088014Z_3036df71","language_code":"en","language_name":"English","title":"Chapters 106–108","source_sha256":"e7992cb99001d47c3f4f8d6b7288bdf91e7aa31d3295c92d9f19fb6640d3cdef","sha256":"9a972538c84c479cecb2917eb95392680f7dc368c5342611dc1c1b9de9e7bd22","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:21:51.090030+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_36:BAS-01","text":"The problem of the cluster consists in the fact that immediacy must appear as the beginning, although it exists only as a retroactive effect of self-negating reflection.","refs":["CH_GB18_1DSR:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BAS-02","text":"Its basic thesis determines reflection as a movement in which negativity sublates itself, returns as equality with itself, and thereby first produces immediacy.","refs":["CH_GB18_1DSR:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BAS-03","text":"The movement is recursive: positing produces presupposition, presupposition returns as posited negativity, and the distinction of its moments becomes self-movement.","refs":["CH_GB18_1DSR:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BAS-04","text":"Initially external reflection is not discarded, but transposed as the necessary form of appearance of an immanent determination.","refs":["CH_GB18_2DUR:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BAS-05","text":"The closure of the cluster lies in the determination of reflection, whose otherness does not exist outside it, but is related back to it as its own negation.","refs":["CH_GB18_3BR0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BAS-06","text":"This closure remains unstable because the determinations must exist simultaneously as independent essences and as mutually presupposed moments.","refs":["CH_GB18_2DUR:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_36:GA-01","text":"[Persistent] Negativity is not a lack of being, but the self-relating operation through which reflection produces its own equality.","refs":["CH_GB18_1DSR:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-02","text":"[Persistent] Immediacy is not an antecedent ground, but reflected positedness, which exists only as the return of negativity.","refs":["CH_GB18_1DSR:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-03","text":"[Mutating] Positing and presupposing are not separate acts, but opposing functions of the same reflecting movement.","refs":["CH_GB18_1DSR:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-04","text":"[Mutating] External reflection contains its immanent truth because the other it finds is first made to appear as presupposition through its own operation.","refs":["CH_GB18_2DUR:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-05","text":"[Emergent] Determining reflection arises only from the unity of positing and external reflection; neither of the two forms can complete determination on its own.","refs":["CH_GB18_3BR0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-06","text":"[Persistent] Positedness exists only as sublated otherness and gains its actuality exclusively in the return to itself.","refs":["CH_GB18_3BR0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-07","text":"[Emergent] The determination of reflection has its subsistence not in being, but in the negativity's being reflected into itself.","refs":["CH_GB18_3BR0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-08","text":"[Attractor] Otherness is not eliminated, but integrated into the self-relation of determination as its own sublated negation.","refs":["CH_GB18_3BR0:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GA-09","text":"[Terminal] Essence is not a backstage of determinations, but their status as sublated negativity returning to itself.","refs":["CH_GB18_3BR0:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_36:RMD-01","text":"Negativity remains identical as self-relation, yet mutates from the self-negation of reflection into the condition under which determinate forms of reflection attain subsistence.","refs":["CH_GB18_1DSR:AS2","CH_GB18_3BR0:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RMD-02","text":"Immediacy shifts from posited return through presupposed counterpart to essential immediacy, and thereby definitively loses the status of a first positive.","refs":["CH_GB18_1DSR:A8","CH_GB18_2DUR:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RMD-03","text":"Presupposing mutates from the reversal of positing into the absolute form in which external and positing reflection sublate their separation.","refs":["CH_GB18_1DSR:A11","CH_GB18_3BR0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RMD-04","text":"The other initially appears as a produced counterpart, but is then absorbed as internal otherness of the determination of reflection.","refs":["CH_GB18_1DSR:AS6","CH_GB18_3BR0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RMD-05","text":"Essence shifts from a movement of return to a self-mediation operative in the status of determinations; it exists only as their sublated negativity.","refs":["CH_GB18_1DSR:D4","CH_GB18_3BR0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RMD-06","text":"Reflective judgment remains a local configuration of external reflection and is absorbed into the more general machine of the determination of essence.","refs":["CH_GB18_2DUR:A11","CH_GB18_2DUR:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_36:CGD-01","text":"The Kantian difference between reflective and determining judgment remains, at the lower level, an exemplary special case; at the cluster level, only its classification within the general machine of reflection counts.","refs":["CH_GB18_2DUR:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:CGD-02","text":"The semblance of an original beginning belongs to the local triggering of the movement, but at the cluster level is recoded as a necessary effect of retrospective positing.","refs":["CH_GB18_1DSR:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:CGD-03","text":"The requalification of every presupposition as the result of sublated positing scales beyond the individual forms of reflection and becomes the global principle of organization.","refs":["CH_GB18_2DUR:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:CGD-04","text":"The distinction between quality and determination of reflection is locally conceptual, but acquires a global function because it explains the transition from being as ground to self-reflection as subsistence.","refs":["CH_GB18_3BR0:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:CGD-05","text":"At the lower level, external reflection is a determinate initial form, but at the cluster level it is the necessary form of difference through which immanence makes its own mediation visible.","refs":["CH_GB18_2DUR:NX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_36:GNX-01","text":"Excluded is an independent ground that precedes reflection and sustains its movement from outside.","refs":["CH_GB18_1DSR:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GNX-02","text":"Excluded is an original, reflectionless immediacy that could function as a first positive.","refs":["CH_GB18_1DSR:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GNX-03","text":"Excluded is a linear order of beginning, transition, and result, because every presupposed element exists only as sublated positedness.","refs":["CH_GB18_1DSR:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GNX-04","text":"Excluded is a model of cognition in which reflection subsequently adds predicates to an object complete in itself.","refs":["CH_GB18_2DUR:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:GNX-05","text":"Excluded is an irreducibly external otherness that would evade withdrawal into the self-relation of reflection.","refs":["CH_GB18_3BR0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_36:DBN-01","text":"Every model that permanently secures determinations through a positive ground of being external to them must be false.","refs":["CH_GB18_3BR0:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:DBN-02","text":"The assumption of two independent spheres of essence and appearance, between which merely external mediation would take place, must be false.","refs":["CH_GB18_2DUR:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:DBN-03","text":"A final separation of positing and presupposing must be false, because their difference marks only the double function of the same return.","refs":["CH_GB18_1DSR:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:DBN-04","text":"A final repose of reflected determinations must be false, since their claim to independence is always undermined by mutual presupposition.","refs":["CH_GB18_2DUR:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_36:BSA-01","text":"Unavailable is an unposited beginning that could precede reflection as an absolutely unmediated foundation.","refs":["CH_GB18_1DSR:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSA-02","text":"Unavailable is a pure immanence that completely effaces the moment of the other; self-relation requires recurrent difference.","refs":["CH_GB18_1DSR:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSA-03","text":"Inadmissible is a determination whose identity could be conceived without the sublation of its own positedness.","refs":["CH_GB18_3BR0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_36:XD-01","text":"What is found receives its status as object not before reflection, but through the operation in which positing sublates itself and exhibits its own result as presupposition; givenness is therefore a produced mode of objecthood. ; Trace Type — Composite","refs":["CL_GB18_36:GA-02","CL_GB18_36:GA-03","CL_GB18_36:GA-04","CH_GB18_1DSR:AS4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_36:XD-02","text":"External reflection is not merely a deficient preliminary stage, but the necessary form of difference through whose sublation determining reflection arises as complete self-mediation. ; Trace Type — Composite","refs":["CL_GB18_36:GA-04","CL_GB18_36:GA-05","CH_GB18_1DSR:AS6","CH_GB18_3BR0:A1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_36:XD-03","text":"The stability of reflected determinations is at the same time their instability: their claim to essentiality fixes them, but precisely this fixation internalizes the negative and compels their mediation. ; Trace Type — Tension","refs":["CL_GB18_36:GA-07","CL_GB18_36:GA-08","CH_GB18_2DUR:D7","CH_GB18_3BR0:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_36:XD-04","text":"Productive negation means neither annihilation nor mere abstraction, but the sublation of alienness through self-equality; only thereby can determination count as essential. ; Trace Type — Composite","refs":["CL_GB18_36:GA-01","CL_GB18_36:GA-07","CH_GB18_2DUR:D3","CH_GB18_3BR0:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_36:XD-05","text":"The logical time of the system is retrospective: what appears as beginning is determined as beginning only through its later return. ; Trace Type — Composite","refs":["CL_GB18_36:GA-02","CL_GB18_36:GA-03","CH_GB18_1DSR:D2","CH_GB18_3BR0:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_36:BSD-01","text":"Reality appears as a field of produced confrontations, in which object and reflection are not separate sides, but internal differences of a self-mediation.","refs":["CH_GB18_2DUR:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSD-02","text":"Temporality is transformed from an order of original priority into an order of logical retroactivity, in which condition and result mutually produce one another.","refs":["CH_GB18_2DUR:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSD-03","text":"Cognition is understood not as the attribution of external determinations, but as the enactment in which the determinations articulate the actual being of the object.","refs":["CH_GB18_2DUR:DNX2","CH_GB18_2DUR:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSD-04","text":"The freedom of determinations consists not in their detachment from mediation, but in their fixation through a negativity completely brought back to itself.","refs":["CH_GB18_3BR0:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:BSD-05","text":"The system produces an ontology of essential differences, in which every determinate side is actual only through its immanent relation to its own negation.","refs":["CH_GB18_3BR0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_36:RLE-01","text":"The primary loop runs from self-negation through immediacy and positedness to presupposing, and returns from there as an absolute counter-thrust into self-movement.","refs":["CH_GB18_1DSR:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RLE-02","text":"The loop of externality determines the immediate as other, negates its alienness, and lets it coincide with reflection as essential immediacy.","refs":["CH_GB18_2DUR:FGS3","CH_GB18_2DUR:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RLE-03","text":"The escalation to determining reflection begins when the unity of external and positing reflection is conceived not as addition, but as absolute presupposing.","refs":["CH_GB18_3BR0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:RLE-04","text":"The attractor of determinations consists in their paradoxical fixation: they appear independent, but can assert this independence only through the mediation that they conceal.","refs":["CH_GB18_2DUR:SD4","CH_GB18_2DUR:AF6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_36:FGS-B01","text":"Self-relating negativity → self-negation → sublated negativity as equality with itself.","refs":["CH_GB18_1DSR:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FGS-B02","text":"Equality with itself → immediacy as positedness → the posited's need for return.","refs":["CH_GB18_1DSR:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FGS-B03","text":"Self-sublating positing → produced presupposition → immediacy as the negative counterpart of reflection.","refs":["CH_GB18_2DUR:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FGS-B04","text":"Negative counterpart → negation of its alienness → essential immediacy as the immanent truth of external reflection.","refs":["CH_GB18_2DUR:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FGS-B05","text":"Unity of external and positing reflection → absolute presupposing → negativity reflected into itself with its own subsistence.","refs":["CH_GB18_3BR0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FGS-B06","text":"Negativity reflected into itself → otherness as its own negation → determination of reflection as determinate semblance of essence.","refs":["CH_GB18_3BR0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_36:AFM-B01","text":"Semblance of a beginning → self-relation of negativity → withdrawal of the seemingly given origin.","refs":["CH_GB18_1DSR:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:AFM-B02","text":"Withdrawal of the origin → positedness → presupposition as the sublated result of positing.","refs":["CH_GB18_2DUR:D1","CH_GB18_2DUR:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:AFM-B03","text":"Presupposition → determination of the immediate as other → negation of the determination of this alienness itself.","refs":["CH_GB18_2DUR:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:AFM-B04","text":"Sublation of alienness → essential immediacy → immanent determination of essence.","refs":["CH_GB18_2DUR:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:AFM-B05","text":"Immanent determination → determination of reflection → negativity as self-sustaining subsistence.","refs":["CH_GB18_3BR0:AF4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:AFM-B06","text":"Internalization of otherness → infinite relation to itself → determinate semblance as stable but mediated difference.","refs":["CH_GB18_3BR0:AF6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_36:MME-01","text":"The beginning is remapped from an original givenness into a retrospectively produced effect of return.","refs":["CH_GB18_1DSR:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MME-02","text":"The confrontation of object and reflection disintegrates as an external opposition and becomes legible as the internal difference of a movement of self-mediation.","refs":["CH_GB18_2DUR:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MME-03","text":"Existence is reclassified from a positive basic stock into the reduced form of positedness in essence.","refs":["CH_GB18_3BR0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MME-04","text":"Negation is reassigned from the moment of vanishing to the bearer of essential persistence.","refs":["CH_GB18_3BR0:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MME-05","text":"Otherness is reclassified from external counterposition into the immanent structure of every determination of reflection.","refs":["CH_GB18_3BR0:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_36:ALT-B01","text":"Surface level — The explicit field of the cluster encompasses semblance, immediacy, positedness, presupposition, essence, and determination of reflection.","refs":["CH_GB18_3BR0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:ALT-B02","text":"Structural level — Positing, sublating, and presupposing form not successive operations, but a recursive machine of the production and withdrawal of determinacy.","refs":["CH_GB18_2DUR:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:ALT-B03","text":"Metastrategic level — The system equally disqualifies explanations from immediate givenness and from isolated subjective positing.","refs":["CH_GB18_3BR0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:ALT-B04","text":"Ontological / Temporal level — Ontological priority appears as subsequent positing; identity exists as continuing return from otherness into itself.","refs":["CH_GB18_2DUR:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:ALT-B05","text":"Methodological / Performative level — The exposition enacts its thesis by tracing every apparent point of departure back to the operation that first produces it.","refs":["CH_GB18_1DSR:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_36:FL-01","text":"Immediacy must initially count as self-relating reality, although systematically it has subsistence only as the subsequent result of reflexive mediation.","refs":["CH_GB18_2DUR:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FL-02","text":"Reflected determinations must appear simultaneously as essential independences and as mutually presupposed moments; their autonomy is therefore constitutively precarious.","refs":["CH_GB18_2DUR:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:FL-03","text":"The freedom of determinations of reflection remains tension-filled because it presupposes complete dependence on absolute reflection.","refs":["CH_GB18_3BR0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MP-01","text":"Immediacy mutates from the result of self-negation into the presupposition of external reflection and is finally requalified as essential immediacy.","refs":["CH_GB18_1DSR:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MP-02","text":"Presupposing mutates from an apparent foundness into the self-repulsion of reflection, through which it brings forth its own determinacy as a counterpart.","refs":["CH_GB18_2DUR:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MP-03","text":"Negation mutates from sublation and return into the bearer-form of stable determination; it thereby becomes both destructive and constitutive.","refs":["CH_GB18_3BR0:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MP-04","text":"Otherness mutates from the external object into the determination of reflection's own sublated negation.","refs":["CH_GB18_3BR0:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_36:HSI-01","text":"Reality appears as a machine of produced counterparts, in which every negative exists only as a relation within a self-mediation.","refs":["CH_GB18_2DUR:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:HSI-02","text":"The subject is not a presupposed instance, but the performative site at which positing, sublating, and presupposing become legible as the same self-movement.","refs":["CH_GB18_3BR0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:HSI-03","text":"Time is not a succession of independent states, but the retroactive order in which determination arises through return from its otherness.","refs":["CH_GB18_3BR0:AF6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_36:MRT-B01","text":"The extracted axioms suffice to reconstruct the transposition of positing and external reflection into determining reflection as the central cluster-machine.","refs":["CH_GB18_3BR0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MRT-B02","text":"It remains underdetermined how the unity of positing and external reflection grounds its own unity without already presupposing it as absolute presupposing.","refs":["CH_GB18_3BR0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MRT-B03","text":"The reconstruction remains coherent only if positedness is treated simultaneously as necessary immediacy and as a moment to be sublated.","refs":["CH_GB18_3BR0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_36:MRT-B04","text":"The strongest point of the architecture is the reversal of givenness into produced presupposition; its irreducible remainder lies in the not fully mediated tension between external form and absolute reflection.","refs":["CH_GB18_2DUR:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_36@R001","source_variant_id":"canonical:CL_GB18_36:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 106–108","context":"1. Die setzende Reflexion. · 2. Die äußere Reflexion. · 3. Bestimmende Reflexion."},"title_language_code":"en"},{"id":"CL_GB18_37","layer":"CL","title":"Chapters 109–111","order":37,"parents":["CH_GB18_A_26","CH_GB18_DIT0","CH_GB18_A_27"],"revision":"CL_GB18_37@R001","sha256":"77852d6af1cf71064dfe002c08495a6107087ae4ae2cc127c5b224daa01a773b","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_37:AS-B01","text":"Das Cluster rekonstruiert Identität nicht als ursprüngliche Gleichheit, sondern als Problem einer Reflexion, die ihre eigene Negativität und die aus ihr hervorgehende Differenz enthalten muss.","refs":["CH_GB18_A_27:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AS-B02","text":"Die zentrale Behauptung lautet, dass wesentliche Identität nur als Resultat immanenter Selbstaufhebung besteht und daher weder abstrakte Tautologie noch äußerlich vermittelte Einheit sein kann.","refs":["CH_GB18_DIT0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AS-B03","text":"Das Argument wird zur immanenten Kritik äußerer Reflexion und äußerlicher Gesetzesform, weil beide die Selbstbewegung der Bestimmungen in feste, voneinander getrennte Prädikate umformen.","refs":["CH_GB18_A_27:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AS-B04","text":"Seine Bewegung ist spiralförmig: aufgehobene Unmittelbarkeit wird Identität, Identität setzt Nichtidentität, der Unterschied wird absolut, und die Rückkehr erzeugt bestimmte Identität als Moment.","refs":["CH_GB18_A_27:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AS-B05","text":"Die einzige Schließung dieser Ebene liegt nicht in einem widerspruchslosen Endzustand, sondern in der Einsicht, dass Identität ihre Geltung nur durch die fortwirkende Negativität ihres Unterschieds erhält.","refs":["CH_GB18_A_27:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_37:GA-01","text":"[Persistent] Das Wesen ist keine vorausliegende Substanz, sondern aufgehobene Unmittelbarkeit, deren eigenes Seyn als Negativität fungiert.","refs":["CH_GB18_DIT0:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-02","text":"[Persistent] Wesentliche Identität ist Selbstherstellung aus und in sich selbst und empfängt ihre Einheit nicht aus einem äußerlichen Anderen.","refs":["CH_GB18_DIT0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-03","text":"[Mutating] Identität ist zunächst die ganze Reflexion, wird aber nur bestimmt, indem sie sich als eigenes Nichtsein und als gesetztes Moment setzt.","refs":["CH_GB18_A_27:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-04","text":"[Attractor] Absolute Negativität hebt nicht bloß ein Anderes auf, sondern negiert sich selbst und erzeugt dadurch Selbstbeziehung, Unterschied und Rückkehr.","refs":["CH_GB18_A_27:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-05","text":"[Persistent] Unterschied ist kein äußerlich bleibendes Gegenüber, sondern selbstbezügliche Negativität, deren äußerer Schein im Vollzug der Aufhebung verschwindet.","refs":["CH_GB18_A_27:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-06","text":"[Emergent] Die Wahrheit von Identität liegt nicht in isolierter Selbstgleichheit, sondern im Zusammenhang von Differenz, Gegensatz, Widerspruch und Grund.","refs":["CH_GB18_A_26:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-07","text":"[Mutating] Die Überführung von Reflexionsbestimmungen in allgemeine Denkgesetze veräußerlicht ihre immanente Beziehung, weil sie ein Subjekt wie „Alles“ oder „A“ voraussetzt.","refs":["CH_GB18_A_26:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-08","text":"[Terminal] Widerspruch ist kein Fehler am Rand der Bestimmung, sondern die Operation, durch die ihre isolierte Form zerfällt und in ihren Grund zurückkehrt.","refs":["CH_GB18_A_26:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_37:RMD-01","text":"Unmittelbarkeit kehrt wieder, mutiert jedoch von vermeintlichem Anfang zu einem Resultat der Reflexion und darf daher nicht als vorreflexive Grundlage gelesen werden.","refs":["CH_GB18_DIT0:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:RMD-02","text":"Identität verschiebt sich von einfacher Sichselbstgleichheit zu einer Struktur, die ihre eigene Nichtidentität produziert, ohne in eine äußerliche Zweiheit auseinanderzufallen.","refs":["CH_GB18_A_27:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:RMD-03","text":"Unterschied wird von gleichgültiger Verschiedenheit zu absolutem Unterschied transformiert, dessen Selbstidentität gerade in seiner Nichtidentität besteht.","refs":["CH_GB18_A_27:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:RMD-04","text":"Die Satzform wiederholt die Reflexionsbeziehung nicht neutral, sondern verlagert sie in die Sphäre äußerlicher Prädikation und damit in ein wiederkehrendes Modell des Seins.","refs":["CH_GB18_A_26:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_37:CGD-01","text":"Die Bestimmung von Identität als aufgehobener Unmittelbarkeit bleibt ein lokaler Ausgangsmechanismus, während das Cluster ihre notwendige Selbstdifferenzierung als übergreifende Generationsregel ausweist.","refs":["CH_GB18_DIT0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:CGD-02","text":"Die Kritik einzelner Denkgesetze bleibt lokal, doch auf Clusterebene wird sichtbar, dass jede isolierte Gesetzesform eine Veräußerlichung derselben immanenten Reflexionsbewegung ist.","refs":["CH_GB18_A_26:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:CGD-03","text":"Die Unterscheidung zwischen Identität als ganzer Reflexion und als bestimmtem Moment skaliert zur Regel, die den scheinbaren Widerspruch zwischen absoluter und bestimmter Identität ordnet.","refs":["CH_GB18_A_27:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_37:GNX-01","text":"Ausgeschlossen wird jede abstrakte Identität, die ohne eigene Negativität, Selbstaufhebung und Differenz als gültige Grundform bestehen soll.","refs":["CH_GB18_DIT0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GNX-02","text":"Ausgeschlossen wird ein äußerliches Erkenntnismodell, das Identität und Unterschied zuerst trennt und ihre Beziehung anschließend durch Reflexion, Gesetz oder Subjekt künstlich hinzufügt.","refs":["CH_GB18_A_27:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GNX-03","text":"Ausgeschlossen wird die Behandlung des Widerspruchs als bloße Unvereinbarkeitsregel, weil sie die Übergangsleistung der Negativität stillstellt.","refs":["CH_GB18_A_26:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_37:DBN-01","text":"Damit die Architektur trägt, darf kein unabhängiges Anderes außerhalb der Identität als letzter Grund des Unterschieds bestehen bleiben.","refs":["CH_GB18_A_27:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:DBN-02","text":"Damit wesentliche Identität möglich bleibt, darf Negation nicht als äußerlicher Vorgang begriffen werden, dessen Resultat dem Negieren äußerlich gegenübersteht.","refs":["CH_GB18_A_27:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_37:BSA-01","text":"Nicht verfügbar ist ein letzter unmittelbarer Anfangssatz, der vor der Bewegung seiner eigenen Bestimmung als selbständige Wahrheit gelten könnte.","refs":["CH_GB18_A_26:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:BSA-02","text":"Unzulässig ist ein ontologischer Grund jenseits von Identität und Unterschied, weil ein solcher Grund die immanente Selbstbegründung der Reflexion wieder durch äußere Positivität ersetzt.","refs":["CH_GB18_A_27:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_37:XD-01","text":"Die Selbstherstellung der wesentlichen Identität und die Kritik der äußeren Reflexion ergeben zusammen, dass Erkenntnis nicht eine fertige Identität aufnimmt, sondern die Selbstbewegung ihrer Negativität nachzeichnen muss.","refs":["CL_GB18_37:GA-02","CL_GB18_37:GA-04","CL_GB18_37:GA-07","CH_GB18_DIT0:SD3","CH_GB18_A_27:SD5"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_37:XD-02","text":"Die allgemeine Gesetzesform scheitert nicht nur an der Vielfalt von Identität und Unterschied, sondern daran, dass sie eine bereits immanente Beziehung als Eigenschaft eines vorausgesetzten Seienden darstellt.","refs":["CL_GB18_37:GA-05","CL_GB18_37:GA-07","CH_GB18_A_26:D5","CH_GB18_A_27:ME5"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_37:XD-03","text":"Die bestimmte Identität ist kein Rückfall in abstrakte Gleichheit, sondern die Form, in der absolute Nichtidentität als selbstgesetztes Moment in die Reflexion zurückkehrt.","refs":["CL_GB18_37:GA-03","CL_GB18_37:GA-04","CH_GB18_A_27:A12","CH_GB18_A_27:A14"],"deep_refs":[],"trace_type":"Tension.","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_37:BSD-01","text":"Das Cluster ersetzt eine Ontologie stabiler Eigenschaften durch eine Ontologie selbstnegativer Relationen, in der jede Bestimmung nur als Übergang zu ihrer eigenen Gegenbestimmung wirklich ist.","refs":["CL_GB18_37:GA-04","CL_GB18_37:GA-05","CL_GB18_37:GA-08","CH_GB18_A_27:A4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_37:BSD-02","text":"Subjekt, Prädikat und Gesetz erscheinen nicht mehr als neutrale logische Formen, sondern als mögliche Mechanismen, durch die immanente Reflexion in äußerliches Sein zurückübersetzt wird.","refs":["CL_GB18_37:GA-07","CH_GB18_A_26:NX4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_37:BSD-03","text":"Der Übergang von Identität zu Unterschied ist keine zeitliche Abfolge zwischen fertigen Zuständen, sondern die zugleich ontologische und methodische Bedingung, unter der Bestimmtheit überhaupt hervorgebracht wird.","refs":["CL_GB18_37:GA-03","CL_GB18_37:GA-04","CH_GB18_A_27:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_37:RLE-01","text":"Der zentrale Rekursionskreis lautet: aufgehobene Unmittelbarkeit erzeugt Negativität; Negativität setzt Unterschied; Unterschied negiert seine Äußerlichkeit; die Rückkehr erzeugt bestimmte Identität.","refs":["CH_GB18_A_27:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:RLE-02","text":"Der Attraktor des Clusters ist die Selbstbeziehung, weil sowohl Identität als auch Unterschied nur dadurch bestehen, dass ihre Negativität auf sich selbst zurückschlägt.","refs":["CH_GB18_A_27:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:RLE-03","text":"Die Eskalation verläuft von der Kritik äußerer Abstraktion zur Aufdeckung, dass deren Trennung von Identität und Unterschied selbst nur ein abgeleitetes Moment immanenter Bewegung ist.","refs":["CH_GB18_A_27:FGS1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_37:FGS-B01","text":"Aufgehobene Unmittelbarkeit → eigene Negativität → Tilgung des selbständigen Anderen.","refs":["CH_GB18_DIT0:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:FGS-B02","text":"Eigene Negativität → Sichselbstgleichheit → wesentliche Identität als Selbstherstellung.","refs":["CH_GB18_DIT0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:FGS-B03","text":"Wesentliche Identität → Setzen des eigenen Nichtseins → reiner Unterschied → Selbstidentität der Nichtidentität.","refs":["CH_GB18_A_27:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:FGS-B04","text":"Bestimmte Identität → äußerliche Gesetzesform → Reaktivierung des Seins → Widerspruch der isolierten Bestimmungen → Rückkehr in den immanenten Zusammenhang.","refs":["CH_GB18_A_26:AF3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_37:AFM-B01","text":"Aufgehobene Unmittelbarkeit → absolute Negativität.","refs":["CH_GB18_DIT0:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AFM-B02","text":"Absolute Negativität → Sichselbstgleichheit → wesentliche Identität.","refs":["CH_GB18_DIT0:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AFM-B03","text":"Wesentliche Identität → Selbstnegation → reiner Unterschied.","refs":["CH_GB18_A_27:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AFM-B04","text":"Reiner Unterschied → absolute Nichtidentität → Rückkehr der Identität als bestimmtes Moment.","refs":["CH_GB18_A_27:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AFM-B05","text":"Bestimmte Identität → Kritik äußerer Reflexion und isolierter Gesetze → Wiedergewinnung der immanenten Übergangsbewegung.","refs":["CH_GB18_A_26:AF4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_37:MME-01","text":"Identität wird von einem logischen Grundsatz zu einer erzeugten Resultatform umkartiert, deren Einfachheit nur als verdichtete Selbstaufhebung besteht.","refs":["CH_GB18_DIT0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MME-02","text":"Das Andere wird von einer unabhängigen Außeninstanz zu einem gesetzten Moment der Negativität umklassifiziert, das keine letzte ontologische Eigenständigkeit behält.","refs":["CH_GB18_A_27:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MME-03","text":"Widerspruch wird von einer Grenze korrekten Denkens zu einer produktiven Kartierungsregel, die den Übergang zwischen Bestimmungen sichtbar macht.","refs":["CH_GB18_A_27:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_37:ALT-B01","text":"Surface level — Gegenstand ist die Bestimmung von Identität, Unterschied, Negation und den Sätzen, die diese Bestimmungen als allgemeine Denkgesetze aussprechen.","refs":["CH_GB18_A_26:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:ALT-B02","text":"Structural level — Selbstbeziehung, Negativität, Aufhebung und Rückkehr organisieren die Bestimmungen als nichtlineares System gegenseitiger Erzeugung.","refs":["CH_GB18_A_27:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:ALT-B03","text":"Metastrategic level — Erkenntnis wird von äußerlicher Beschreibung und Gesetzesaufzählung auf die immanente Rekonstruktion des Übergangs umgestellt.","refs":["CH_GB18_A_26:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:ALT-B04","text":"Ontological / Temporal level — Sein erscheint als widersprüchliche Übergangsbewegung, nicht als ruhendes Substrat, dem Eigenschaften von außen beigelegt werden.","refs":["CH_GB18_A_27:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie jede festgehaltene Identität in die Bewegung überführt, die ihre eigene isolierte Form aufhebt.","refs":["CH_GB18_A_26:FGS9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_37:FL-01","text":"Die Architektur verlangt, dass Andersseyn vollständig aufgehoben wird, muss aber zugleich aus dieser Aufhebung den reinen Unterschied als fortbestehendes Resultat bestimmen.","refs":["CH_GB18_DIT0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:FL-02","text":"Die Identität oszilliert zwischen dem Ganzen der Reflexion und einem bestimmten Moment derselben, weshalb ihre Einheit nur durch Ebenendifferenz und nicht durch Bedeutungsidentität gesichert ist.","refs":["CH_GB18_A_27:NX8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:FL-03","text":"Die Behauptung einer inneren Satzform kollidiert produktiv mit der Notwendigkeit eines äußerlichen Subjekts für die allgemeine Gesetzesform.","refs":["CH_GB18_A_26:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MP-01","text":"Die Unmittelbarkeit mutiert vom vermeintlichen Anfang in die Reflexionsform eines bereits vollzogenen Aufhebungsprozesses.","refs":["CH_GB18_DIT0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MP-02","text":"Unterschied mutiert von äußerlich getrennter Verschiedenheit zu absoluter Nichtidentität, die gerade dadurch mit sich identisch wird.","refs":["CH_GB18_A_27:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MP-03","text":"Widerspruch mutiert von der Aufhebung isolierter Denkgesetze zur positiven Bewegungsform, durch die Bestimmungen ihren Grund erzeugen.","refs":["CH_GB18_A_26:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_37:HSI-01","text":"Realität erscheint als Maschine der Selbstvermittlung, die jede scheinbar feste Einheit durch ihre eigene Negativität erzeugt, differenziert und in sich zurücknimmt.","refs":["CH_GB18_A_26:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:HSI-02","text":"Das Subjekt ist keine äußere Instanz der Ordnung, sondern eine problematische Form der Veräußerlichung, sofern es als Träger immanenter Reflexionsbestimmungen fungiert.","refs":["CH_GB18_A_26:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:HSI-03","text":"Zeit ist keine Abfolge äußerer Zustände, sondern die logische Temporalität von Selbstaufhebung, Übergang und Rückkehr, in der Bestimmung nur als Bewegung besteht.","refs":["CH_GB18_A_26:ALT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_37:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Architektur von aufgehobener Unmittelbarkeit über absolute Negativität, Unterschied und bestimmte Identität bis zur Kritik äußerlicher Gesetzesform zu rekonstruieren.","refs":["CH_GB18_A_27:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MRT-B02","text":"Unterbestimmt bleibt der konkrete Ausweis, durch den die immanente Betrachtung den behaupteten Übergang jeder Bestimmung in ihr Gegenteil vollzieht.","refs":["CH_GB18_A_27:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MRT-B03","text":"Die Rekonstruktion bleibt nur kohärent, wenn absolute Identität, absolute Nichtidentität und bestimmte Gleichheit nicht als konkurrierende Behauptungen derselben Ebene, sondern als Momente einer gestuften Reflexionsmaschine gelesen werden.","refs":["CH_GB18_A_27:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122212642617Z_f29b8158","language_code":"en","language_name":"English","title":"Chapters 109–111","source_sha256":"77852d6af1cf71064dfe002c08495a6107087ae4ae2cc127c5b224daa01a773b","sha256":"bb2beb0f8a24b8421bd27617995390d663d21e307ea344a09f5381a8349bc6c9","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:22:12.644155+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_37:AS-B01","text":"The cluster reconstructs identity not as original equality, but as the problem of a reflection that must contain its own negativity and the difference emerging from it.","refs":["CH_GB18_A_27:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AS-B02","text":"The central claim is that essential identity exists only as the result of immanent self-sublation and therefore can be neither abstract tautology nor externally mediated unity.","refs":["CH_GB18_DIT0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AS-B03","text":"The argument becomes an immanent critique of external reflection and external form of law, because both transform the self-movement of determinations into fixed predicates separated from one another.","refs":["CH_GB18_A_27:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AS-B04","text":"Its movement is spiral-shaped: sublated immediacy becomes identity, identity posits non-identity, difference becomes absolute, and the return produces determinate identity as a moment.","refs":["CH_GB18_A_27:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AS-B05","text":"The sole closure of this level lies not in a contradiction-free final state, but in the insight that identity obtains its validity only through the continuing negativity of its difference.","refs":["CH_GB18_A_27:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_37:GA-01","text":"[Persistent] Essence is not a pre-existing substance, but sublated immediacy, whose own Being (Seyn) functions as negativity.","refs":["CH_GB18_DIT0:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-02","text":"[Persistent] Essential identity is self-production out of and within itself and does not receive its unity from an external other.","refs":["CH_GB18_DIT0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-03","text":"[Mutating] Identity is initially the whole of reflection, but becomes determinate only by positing itself as its own non-being and as a posited moment.","refs":["CH_GB18_A_27:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-04","text":"[Attractor] Absolute negativity does not merely sublate an other, but negates itself and thereby produces self-relation, difference, and return.","refs":["CH_GB18_A_27:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-05","text":"[Persistent] Difference is not an externally enduring counterpart, but self-relating negativity, whose external semblance disappears in the enactment of sublation.","refs":["CH_GB18_A_27:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-06","text":"[Emergent] The truth of identity lies not in isolated self-sameness, but in the connection of difference, opposition, contradiction, and ground.","refs":["CH_GB18_A_26:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-07","text":"[Mutating] The transformation of determinations of reflection into universal laws of thought externalizes their immanent relation, because it presupposes a subject such as “Everything” or “A”.","refs":["CH_GB18_A_26:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GA-08","text":"[Terminal] Contradiction is not an error at the margin of determination, but the operation through which its isolated form disintegrates and returns to its ground.","refs":["CH_GB18_A_26:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_37:RMD-01","text":"Immediacy recurs, but mutates from an alleged beginning into a result of reflection and must therefore not be read as a pre-reflective foundation.","refs":["CH_GB18_DIT0:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:RMD-02","text":"Identity shifts from simple self-sameness to a structure that produces its own non-identity without disintegrating into an external duality.","refs":["CH_GB18_A_27:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:RMD-03","text":"Difference is transformed from indifferent diversity into absolute difference, whose self-identity consists precisely in its non-identity.","refs":["CH_GB18_A_27:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:RMD-04","text":"The propositional form does not repeat the relation of reflection neutrally, but displaces it into the sphere of external predication and thereby into a recurring model of being.","refs":["CH_GB18_A_26:FGS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_37:CGD-01","text":"The determination of identity as sublated immediacy remains a local mechanism of departure, whereas the cluster identifies its necessary self-differentiation as an overarching generative rule.","refs":["CH_GB18_DIT0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:CGD-02","text":"The critique of individual laws of thought remains local, yet at the cluster level it becomes visible that every isolated law-form is an externalization of the same immanent movement of reflection.","refs":["CH_GB18_A_26:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:CGD-03","text":"The distinction between identity as whole reflection and as a determinate moment scales into the rule that orders the apparent contradiction between absolute and determinate identity.","refs":["CH_GB18_A_27:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_37:GNX-01","text":"Excluded is every abstract identity that is supposed to persist as a valid basic form without its own negativity, self-sublation, and difference.","refs":["CH_GB18_DIT0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GNX-02","text":"Excluded is an external model of cognition that first separates identity and difference and subsequently adds their relation artificially through reflection, law, or subject.","refs":["CH_GB18_A_27:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:GNX-03","text":"Excluded is the treatment of contradiction as a mere rule of incompatibility, because it arrests the transitional operation of negativity.","refs":["CH_GB18_A_26:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_37:DBN-01","text":"For the architecture to hold, no independent other outside identity may remain as the ultimate ground of difference.","refs":["CH_GB18_A_27:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:DBN-02","text":"For essential identity to remain possible, negation must not be conceived as an external process whose result stands externally opposed to the act of negating.","refs":["CH_GB18_A_27:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_37:BSA-01","text":"Unavailable is an ultimate immediate opening proposition that could count as independent truth prior to the movement of its own determination.","refs":["CH_GB18_A_26:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:BSA-02","text":"Impermissible is an ontological ground beyond identity and difference, because such a ground would again replace the immanent self-grounding of reflection with external positivity.","refs":["CH_GB18_A_27:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_37:XD-01","text":"The self-production of essential identity and the critique of external reflection together entail that cognition does not apprehend a finished identity, but must retrace the self-movement of its negativity.","refs":["CL_GB18_37:GA-02","CL_GB18_37:GA-04","CL_GB18_37:GA-07","CH_GB18_DIT0:SD3","CH_GB18_A_27:SD5"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_37:XD-02","text":"The universal law-form fails not merely because of the diversity of identity and difference, but because it represents an already immanent relation as a property of a presupposed being.","refs":["CL_GB18_37:GA-05","CL_GB18_37:GA-07","CH_GB18_A_26:D5","CH_GB18_A_27:ME5"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_37:XD-03","text":"Determinate identity is not a relapse into abstract equality, but the form in which absolute non-identity returns into reflection as a self-posited moment.","refs":["CL_GB18_37:GA-03","CL_GB18_37:GA-04","CH_GB18_A_27:A12","CH_GB18_A_27:A14"],"deep_refs":[],"trace_type":"Tension.","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_37:BSD-01","text":"The cluster replaces an ontology of stable properties with an ontology of self-negative relations, in which every determination is actual only as transition to its own counter-determination.","refs":["CL_GB18_37:GA-04","CL_GB18_37:GA-05","CL_GB18_37:GA-08","CH_GB18_A_27:A4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_37:BSD-02","text":"Subject, predicate, and law no longer appear as neutral logical forms, but as possible mechanisms through which immanent reflection is translated back into external being.","refs":["CL_GB18_37:GA-07","CH_GB18_A_26:NX4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_37:BSD-03","text":"The transition from identity to difference is not a temporal sequence between finished states, but the simultaneously ontological and methodological condition under which determinacy is produced at all.","refs":["CL_GB18_37:GA-03","CL_GB18_37:GA-04","CH_GB18_A_27:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_37:RLE-01","text":"The central recursive circuit is as follows: sublated immediacy produces negativity; negativity posits difference; difference negates its externality; the return produces determinate identity.","refs":["CH_GB18_A_27:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:RLE-02","text":"The attractor of the cluster is self-relation, because both identity and difference exist only by virtue of their negativity rebounding upon itself.","refs":["CH_GB18_A_27:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:RLE-03","text":"The escalation proceeds from the critique of external abstraction to the disclosure that its separation of identity and difference is itself only a derived moment of immanent movement.","refs":["CH_GB18_A_27:FGS1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_37:FGS-B01","text":"Sublated immediacy → own negativity → elimination of the independent other.","refs":["CH_GB18_DIT0:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:FGS-B02","text":"Own negativity → self-sameness → essential identity as self-production.","refs":["CH_GB18_DIT0:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:FGS-B03","text":"Essential identity → positing of its own non-being → pure difference → self-identity of non-identity.","refs":["CH_GB18_A_27:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:FGS-B04","text":"Determinate identity → external law-form → reactivation of being → contradiction of isolated determinations → return into the immanent connection.","refs":["CH_GB18_A_26:AF3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_37:AFM-B01","text":"Sublated immediacy → absolute negativity.","refs":["CH_GB18_DIT0:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AFM-B02","text":"Absolute negativity → self-sameness → essential identity.","refs":["CH_GB18_DIT0:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AFM-B03","text":"Essential identity → self-negation → pure difference.","refs":["CH_GB18_A_27:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AFM-B04","text":"Pure difference → absolute non-identity → return of identity as a determinate moment.","refs":["CH_GB18_A_27:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:AFM-B05","text":"Determinate identity → critique of external reflection and isolated laws → recovery of the immanent movement of transition.","refs":["CH_GB18_A_26:AF4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_37:MME-01","text":"Identity is remapped from a logical principle into a produced resultant form, whose simplicity exists only as condensed self-sublation.","refs":["CH_GB18_DIT0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MME-02","text":"The other is reclassified from an independent external instance into a posited moment of negativity that retains no final ontological independence.","refs":["CH_GB18_A_27:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MME-03","text":"Contradiction is remapped from a limit of correct thinking into a productive rule of mapping that makes the transition between determinations visible.","refs":["CH_GB18_A_27:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_37:ALT-B01","text":"Surface level — The object is the determination of identity, difference, negation, and the propositions that articulate these determinations as universal laws of thought.","refs":["CH_GB18_A_26:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:ALT-B02","text":"Structural level — Self-relation, negativity, sublation, and return organize the determinations as a nonlinear system of reciprocal generation.","refs":["CH_GB18_A_27:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:ALT-B03","text":"Metastrategic level — Cognition is shifted from external description and enumeration of laws to the immanent reconstruction of transition.","refs":["CH_GB18_A_26:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:ALT-B04","text":"Ontological / Temporal level — Being appears as a contradictory movement of transition, not as a resting substrate to which properties are externally attached.","refs":["CH_GB18_A_27:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:ALT-B05","text":"Methodological / Performative level — The presentation enacts its thesis by transferring every fixed identity into the movement that sublates its own isolated form.","refs":["CH_GB18_A_26:FGS9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_37:FL-01","text":"The architecture requires that otherness (Andersseyn) be completely sublated, yet must simultaneously determine pure difference from this sublation as an enduring result.","refs":["CH_GB18_DIT0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:FL-02","text":"Identity oscillates between the whole of reflection and a determinate moment thereof, which is why its unity is secured only through difference of level and not through identity of meaning.","refs":["CH_GB18_A_27:NX8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:FL-03","text":"The assertion of an inner propositional form collides productively with the necessity of an external subject for the universal law-form.","refs":["CH_GB18_A_26:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MP-01","text":"Immediacy mutates from the alleged beginning into the reflective form of an already accomplished process of sublation.","refs":["CH_GB18_DIT0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MP-02","text":"Difference mutates from externally separated diversity into absolute non-identity, which becomes identical with itself precisely thereby.","refs":["CH_GB18_A_27:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MP-03","text":"Contradiction mutates from the sublation of isolated laws of thought into the positive form of movement through which determinations produce their ground.","refs":["CH_GB18_A_26:ME6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_37:HSI-01","text":"Reality appears as a machine of self-mediation that produces, differentiates, and takes back into itself every seemingly fixed unity through its own negativity.","refs":["CH_GB18_A_26:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:HSI-02","text":"The subject is not an external instance of order, but a problematic form of externalization insofar as it functions as the bearer of immanent determinations of reflection.","refs":["CH_GB18_A_26:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:HSI-03","text":"Time is not a sequence of external states, but the logical temporality of self-sublation, transition, and return, in which determination exists only as movement.","refs":["CH_GB18_A_26:ALT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_37:MRT-B01","text":"The extracted axioms suffice to reconstruct the architecture from sublated immediacy through absolute negativity, difference, and determinate identity to the critique of external law-form.","refs":["CH_GB18_A_27:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MRT-B02","text":"What remains underdetermined is the concrete demonstration through which immanent consideration enacts the asserted transition of every determination into its opposite.","refs":["CH_GB18_A_27:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_37:MRT-B03","text":"The reconstruction remains coherent only if absolute identity, absolute non-identity, and determinate equality are read not as competing claims on the same level, but as moments of a stratified machine of reflection.","refs":["CH_GB18_A_27:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_37@R001","source_variant_id":"canonical:CL_GB18_37:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 109–111","context":"Anmerkung. · A. Die Identität. · Anmerkung 1."},"title_language_code":"en"},{"id":"CL_GB18_38","layer":"CL","title":"Chapters 112–114","order":38,"parents":["CH_GB18_A_28","CH_GB18_1DAU","CH_GB18_2DV0"],"revision":"CL_GB18_38@R001","sha256":"44ac690046fde55c3ff559d5ac936f169af264068ced42404f2a71aa1105d9a0","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_38:AS-01","text":"Das System prüft den Anspruch, abstrakte Selbstgleichheit könne als erstes und ruhendes Denkgesetz fungieren, und bestimmt diesen Anspruch als unzureichenden Anfang.","refs":["CH_GB18_A_28:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-02","text":"Die Leere der abstrakten Identität ist keine bloße Inhaltsarmut, sondern ein Vollzugsdefekt: Ihre Abgrenzung gegen Verschiedenheit führt das Ausgeschlossene in ihre eigene Form zurück.","refs":["CH_GB18_A_28:AS2","CH_GB18_A_28:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-03","text":"Was zunächst als Fehler der Identität erscheint, wird zum ontologischen Prinzip umgestellt: Unterschied entsteht nicht äußerlich zwischen Bestehendem, sondern als immanente Bestimmung der Reflexion.","refs":["CH_GB18_1DAU:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-04","text":"Der absolute Unterschied zwingt Identität und Unterschied in eine wechselseitige Binnenrelation, in der Identität nicht verschwindet, sondern zum immanenten Anderen des Unterschieds wird.","refs":["CH_GB18_1DAU:AS3","CH_GB18_1DAU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-05","text":"Die Einheit von Identität und Unterschied erzeugt bestimmten Unterschied; sobald beide Momente als Reflexionen in sich bestimmt sind, geht dieser in Verschiedenheit über.","refs":["CH_GB18_1DAU:AS5","CH_GB18_1DAU:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-06","text":"Verschiedenheit externalisiert sich als Gleichheit und Ungleichheit, deren Sinn nicht den Dingen selbst zukommt, sondern durch vergleichende Setzung erzeugt wird.","refs":["CH_GB18_2DV0:A7","CH_GB18_2DV0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-07","text":"Die versuchte Isolierung von Gleichheit und Ungleichheit zerstört ihre relationale Bestimmtheit und setzt die negative Einheit frei, die sie getragen hat.","refs":["CH_GB18_2DV0:A10","CH_GB18_2DV0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-08","text":"Die Bewegung schließt nicht in einer ruhenden Identität, sondern in der notwendigen Transformation äußerlicher Verschiedenheit in Gegensatz; ihre Form ist rekursiv, eskalierend und negativ-produktiv.","refs":["CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_38:GA-01","text":"[Attractor] Identität ist nur wahr als Einheit mit Verschiedenheit; isolierte Selbstgleichheit ist eine unvollständige Abstraktion.","refs":["CH_GB18_A_28:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-02","text":"[Persistent] Negativität ist nicht äußerliche Verneinung, sondern die immanente Selbstbeziehung, durch die Reflexion, Identität und Unterschied überhaupt bestimmt werden.","refs":["CH_GB18_A_28:A8","CH_GB18_1DAU:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-03","text":"[Mutating] Das Identitätsgesetz verliert seinen Status als stillstehendes Fundament und wird zur performativen Darstellung einer Reflexionsbewegung.","refs":["CH_GB18_A_28:A1","CH_GB18_A_28:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-04","text":"[Emergent] Der absolute Unterschied ist nicht der Abstand zweier fertiger Einheiten, sondern der einfache Selbstunterschied von A und Nicht-A unter derselben Bestimmungsrücksicht.","refs":["CH_GB18_1DAU:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-05","text":"[Persistent] Unterschied und Identität sind weder unabhängige Pole noch nachträglich verbundene Bestimmungen, sondern zugleich Ganze und Momente derselben Reflexion.","refs":["CH_GB18_1DAU:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-06","text":"[Mutating] Verschiedenheit entsteht, wenn die wechselseitig bestimmten Momente als selbstbezügliche Reflexionen auftreten und sich zunächst gegeneinander gleichgültig verhalten.","refs":["CH_GB18_1DAU:AS6","CH_GB18_2DV0:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-07","text":"[Emergent] Gleichheit und Ungleichheit sind gesetzte Formen äußerlicher Reflexion und keine ursprünglichen Eigenschaften der verglichenen Dinge.","refs":["CH_GB18_2DV0:A7","CH_GB18_2DV0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-08","text":"[Attractor] Jede Bestimmung, die ihre Beziehung auf Anderes als äußerlich abweist, reproduziert diese Beziehung als Bedingung ihrer eigenen Bestimmtheit und negiert ihre Selbständigkeit.","refs":["CH_GB18_2DV0:A10","CH_GB18_2DV0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-09","text":"[Terminal] Die Selbstaufhebung äußerlicher Verschiedenheit setzt nicht Wiederherstellung abstrakter Gleichheit frei, sondern den Übergang in negative Einheit und Gegensatz.","refs":["CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_38:RMD-01","text":"Identität kehrt wieder, behält jedoch nicht die Funktion einer Selbstgleichheit: Sie mutiert von leerer Tautologie zu einer reflexiven Einheit, die Differenz in sich trägt.","refs":["CH_GB18_A_28:ME1","CH_GB18_2DV0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RMD-02","text":"Unterschied verschiebt sich von der ausgeschlossenen Differenz abstrakter Identität zum absoluten Selbstunterschied und wird anschließend als bestimmter Unterschied in Verschiedenheit absorbiert.","refs":["CH_GB18_A_28:ME2","CH_GB18_1DAU:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RMD-03","text":"Negativität mutiert von dem im Identitätssatz impliziten Gehalt des Widerspruchs zur Selbstnegation äußerlich gesetzter Vergleichsformen.","refs":["CH_GB18_A_28:A9","CH_GB18_2DV0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RMD-04","text":"Die äußerliche Reflexion des Vergleichens wird nicht als fremde Subjektivität beibehalten, sondern als vorläufige Erscheinungsform der immanenten negativen Einheit zurückgenommen.","refs":["CH_GB18_2DV0:A6","CH_GB18_2DV0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RMD-05","text":"Gleichheit und Ungleichheit leisten Übergangsarbeit als Vergleichsformen und verschwinden, sobald ihre Trennung die relationale Bestimmtheit vernichtet, die sie erst bedeutungsvoll machte.","refs":["CH_GB18_2DV0:A9","CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_38:CGD-01","text":"Die Analyse der Satzform A=A, des Substrats und der enttäuschten Erwartung einer Bestimmung bleibt ein lokaler Diagnosemechanismus; auf Clusterebene zählt sie nur als Eintrittspunkt in die Selbstnegation abstrakter Identität.","refs":["CH_GB18_A_28:A7","CH_GB18_A_28:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:CGD-02","text":"Die gegenwärtige Ebene trägt nicht die einzelne These, dass Identität Differenz enthält, sondern die stärkere Architektur, nach der jede Bestimmung nur als negative Selbstbeziehung Bestimmtheit gewinnt.","refs":["CH_GB18_A_28:A8","CH_GB18_2DV0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:CGD-03","text":"Die Konstruktion des einfachen Nicht und des absoluten Unterschieds bleibt als Herleitungsmechanismus lokal, wird jedoch auf Clusterebene als notwendige Umcodierung von äußerer Differenz in immanente Reflexion wirksam.","refs":["CH_GB18_1DAU:A6","CH_GB18_1DAU:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:CGD-04","text":"Gleichheit, Ungleichheit und der vergleichende Dritte skalieren über ihre lokale Behandlung hinaus, weil sie die allgemeine Unhaltbarkeit einer äußerlichen Vermittlung demonstrieren.","refs":["CH_GB18_2DV0:A8","CH_GB18_2DV0:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:CGD-05","text":"Der Gegensatz ist keine weitere lokale Kategorie neben Gleichheit und Ungleichheit, sondern deren terminale Reklassifikation als instabile Durchgangsformen negativer Einheit.","refs":["CH_GB18_2DV0:SD4","CH_GB18_2DV0:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_38:GNX-01","text":"Ausgeschlossen wird eine Identität, die vor, außerhalb oder unabhängig von ihrer eigenen Differenz bestehen könnte.","refs":["CH_GB18_A_28:NX1","CH_GB18_1DAU:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GNX-02","text":"Ausgeschlossen wird ein Unterschied, der durch äußerlich bestehende Dinge, äußere Relationen oder bloßes Übergehen zwischen fixierten Bestimmungen erklärt werden könnte.","refs":["CH_GB18_1DAU:NX2","CH_GB18_1DAU:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GNX-03","text":"Ausgeschlossen wird die Auffassung, Gleichheit und Ungleichheit seien den verglichenen Dingen an und für sich zukommende positive Eigenschaften.","refs":["CH_GB18_2DV0:NX3","CH_GB18_2DV0:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GNX-04","text":"Ausgeschlossen wird ein äußerer Standpunkt, der Vergleichsformen begründen könnte, ohne selbst in deren negative Bewegung einzugehen.","refs":["CH_GB18_2DV0:DNX2","CH_GB18_2DV0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_38:DBN-01","text":"Falsch sein muss, dass Denken auf einem Gesetz begründet werden kann, dessen Geltung von jedem Verhältnis zu Anderem gereinigt ist.","refs":["CH_GB18_A_28:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:DBN-02","text":"Falsch sein muss, dass Identität und Unterschied als primär getrennte Bestimmungen bestehen und erst nachträglich vermittelt werden.","refs":["CH_GB18_A_28:DNX2","CH_GB18_2DV0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:DBN-03","text":"Falsch sein muss, dass äußerliche Vergleichung eine stabile Vermittlung liefern kann, welche Gleichheit und Ungleichheit dauerhaft trennt und zugleich bedeutungsvoll erhält.","refs":["CH_GB18_2DV0:NX5","CH_GB18_2DV0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_38:BSA-01","text":"Unverfügbar bleibt eine reine Selbstgegenwart, in der Identität ohne innere Negation und ohne Selbstunterschied wahr sein könnte.","refs":["CH_GB18_A_28:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:BSA-02","text":"Unverfügbar bleibt ein letzter äußerer Grund, der die Einheit von Identität und Unterschied vermitteln könnte, ohne selbst Moment dieser Einheit zu sein.","refs":["CH_GB18_1DAU:DNX4","CH_GB18_1DAU:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:BSA-03","text":"Unzulässig bleibt eine letzte positive Differenz, die weder durch Identität getragen noch durch negative Reflexion vermittelt wäre.","refs":["CH_GB18_2DV0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_38:XD-01","text":"Die im Identitätssatz performativ wirksame Negativität erhält erst durch die Bestimmung des absoluten Unterschieds ihren ontologischen Status; der Widerspruch wird dadurch nicht als Fehler, sondern als Explikation des Identitätsgehalts lesbar.","refs":["CL_GB18_38:GA-01","CL_GB18_38:GA-03","CL_GB18_38:GA-04","CH_GB18_A_28:AS5","CH_GB18_1DAU:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_38:XD-02","text":"Die Bewegung von immanentem Unterschied zu äußerlicher Verschiedenheit etabliert die Äußerlichkeit nicht als Gegenwelt der Reflexion, sondern als abgeleitete und selbstaufhebende Phase derselben Negativität.","refs":["CL_GB18_38:GA-02","CL_GB18_38:GA-05","CL_GB18_38:GA-06","CH_GB18_1DAU:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_38:XD-03","text":"Der vergleichende Dritte ist weder souveräner Beobachter noch bloße subjektive Zutat, weil seine äußerliche Setzung als immanente negative Einheit der Vergleichsbestimmungen zurückkehrt.","refs":["CL_GB18_38:GA-07","CL_GB18_38:GA-08","CH_GB18_2DV0:A8","CH_GB18_2DV0:A11"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_38:XD-04","text":"Gleichheit und Ungleichheit können nur als wechselseitige Formen bestehen; ihre Trennung produziert notwendig den Übergang von Vergleichbarkeit zu Gegensatz.","refs":["CL_GB18_38:GA-07","CL_GB18_38:GA-09","CH_GB18_2DV0:A9","CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_38:BSD-01","text":"Das erste Denkgesetz wird auf Clusterebene nicht widerlegt, um durch ein anderes fixes Gesetz ersetzt zu werden, sondern als erste Instanz einer Selbstbewegung des Denkens rekonstruiert.","refs":["CH_GB18_A_28:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:BSD-02","text":"Realität erscheint nicht als Ansammlung zunächst identischer Dinge, sondern als gegliederte Selbstbewegung, in der Bestimmtheit nur durch Selbstnegation besteht.","refs":["CH_GB18_1DAU:SD3","CH_GB18_2DV0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:BSD-03","text":"Vergleich wird von einer Erkenntnistechnik zu einer ontologischen Krisenform: Er enthüllt, dass seine eigenen Kategorien ihre Geltung nur durch die Negation ihrer Absonderung erhalten.","refs":["CH_GB18_2DV0:SD3","CH_GB18_2DV0:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:BSD-04","text":"Der Übergang in Gegensatz ist keine harmonische Synthese, sondern die durch Selbstaufhebung erzwungene Reklassifikation äußerlicher Verschiedenheit.","refs":["CH_GB18_2DV0:SD4","CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_38:RLE-01","text":"Abstrakte Identität schließt Verschiedenheit aus, setzt sie dadurch voraus und kehrt als Einheit mit ihr zu sich zurück; die Wiederkehr verändert die Bedeutung der Identität.","refs":["CH_GB18_A_28:A3","CH_GB18_A_28:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RLE-02","text":"Unterschied negiert sich als Unterschied von sich selbst und erzeugt dadurch Identität als sein immanentes Anderes; Identität und Unterschied sind die wechselseitigen Produkte derselben Schleife.","refs":["CH_GB18_1DAU:A8","CH_GB18_1DAU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RLE-03","text":"Verschiedenheit stabilisiert sich vorläufig als Gleichgültigkeit, externalisiert sich im Vergleich und verliert durch diese Externalisierung gerade die Bestimmtheit, die sie sichern sollte.","refs":["CH_GB18_2DV0:AS2","CH_GB18_2DV0:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RLE-04","text":"Die negative Einheit fungiert als Attraktor, weil jede versuchte Selbständigkeit von Identität, Unterschied, Gleichheit oder Ungleichheit in sie zurückgeführt wird.","refs":["CH_GB18_2DV0:A13","CH_GB18_2DV0:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_38:FGS-B01","text":"Abstrakte Selbstgleichheit → Ausschluss der Verschiedenheit → performative Wiederkehr des Ausgeschlossenen.","refs":["CH_GB18_A_28:AS2","CH_GB18_A_28:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FGS-B02","text":"Wiederkehr der Differenz → Negativität der Identität → absoluter Unterschied als Selbstbeziehung.","refs":["CH_GB18_A_28:A8","CH_GB18_1DAU:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FGS-B03","text":"Selbstbezüglicher Unterschied → Identität als immanentes Anderes → bestimmter Unterschied → Verschiedenheit.","refs":["CH_GB18_1DAU:AS4","CH_GB18_1DAU:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FGS-B04","text":"Verschiedenheit als Gleichgültigkeit → äußerliche Reflexion → Gleichheit und Ungleichheit als gesetzte Vergleichsformen.","refs":["CH_GB18_2DV0:A3","CH_GB18_2DV0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FGS-B05","text":"Getrennte Vergleichsformen → Verlust ihrer wechselseitigen Bestimmtheit → negative Einheit → Gegensatz.","refs":["CH_GB18_2DV0:A10","CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_38:AFM-B01","text":"Anspruch eines ersten Denkgesetzes → Diagnose leerer Selbstgleichheit.","refs":["CH_GB18_A_28:AS1","CH_GB18_A_28:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AFM-B02","text":"Leere Selbstgleichheit → immanente Verschiedenheit → Negativität der Identität.","refs":["CH_GB18_A_28:A2","CH_GB18_A_28:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AFM-B03","text":"Negativität der Identität → absoluter Unterschied → Identität als internes Anderes des Unterschieds.","refs":["CH_GB18_1DAU:A2","CH_GB18_1DAU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AFM-B04","text":"Einheit von Identität und Unterschied → bestimmter Unterschied → Verschiedenheit selbstbezüglicher Momente.","refs":["CH_GB18_1DAU:A12","CH_GB18_1DAU:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AFM-B05","text":"Verschiedenheit → äußerliche Vergleichung → Gleichheit und Ungleichheit → Gleichgültigkeit ihrer Trennung.","refs":["CH_GB18_2DV0:AS3","CH_GB18_2DV0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AFM-B06","text":"Gleichgültigkeit → Selbstaufhebung des gesetzten Unterschieds → negative Einheit → Gegensatz.","refs":["CH_GB18_2DV0:A12","CH_GB18_2DV0:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_38:MME-01","text":"Identität wird von einer statischen Gleichheitsrelation zu einer reflexiven Selbstunterscheidung umkartiert.","refs":["CH_GB18_A_28:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MME-02","text":"Unterschied wird von einer Relation zwischen Daseienden zu einer immanenten Operation der Reflexion reklassifiziert.","refs":["CH_GB18_1DAU:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MME-03","text":"Gleichheit und Ungleichheit werden von Eigenschaften verglichener Gegenstände zu gesetzten Formen äußerlicher Reflexion umgeordnet.","refs":["CH_GB18_2DV0:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MME-04","text":"Der Gegensatz von subjektivem Vergleichen und objektiver Bestimmtheit zerfällt, weil das Vergleichende als immanente negative Einheit bestimmt wird.","refs":["CH_GB18_2DV0:ME3","CH_GB18_2DV0:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_38:ALT-B01","text":"Surface level — Das System behandelt A=A, A und Nicht-A, Verschiedenheit, Gleichheit, Ungleichheit und Vergleichung als explizite Bestimmungsprobleme.","refs":["CH_GB18_2DV0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:ALT-B02","text":"Structural level — Die tragende Struktur ist die negative Selbstbeziehung, durch die Identität, Unterschied und Vergleichsformen zugleich entstehen und ihre Absonderung verlieren.","refs":["CH_GB18_1DAU:ALT2","CH_GB18_2DV0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:ALT-B03","text":"Metastrategic level — Die Untersuchung ersetzt äußerliche Widerlegung durch immanente Rekonstruktion der Vollzugsformen, in denen eine Bestimmung ihre eigene Grenze produziert.","refs":["CH_GB18_A_28:ALT3","CH_GB18_1DAU:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:ALT-B04","text":"Ontological / Temporal level — Wirklichkeit besteht als rückläufige Bewegung von Setzung, Negation, Andersheit, Selbstaufhebung und Rückkehr, nicht als zeitlose Koexistenz fixer Bestimmungen.","refs":["CH_GB18_A_28:ALT4","CH_GB18_2DV0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:ALT-B05","text":"Methodological / Performative level — Die Analyse vollzieht ihren Gegenstand, indem Satzform und Vergleichsform als Verfahren sichtbar werden, die das von ihnen Ausgeschlossene selbst wieder einführen.","refs":["CH_GB18_A_28:SD4","CH_GB18_2DV0:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_38:FL-01","text":"Die Architektur setzt voraus, dass logische Satzform und ontologische Reflexionsstruktur ineinander übergehen; die Notwendigkeit dieses Übergangs bleibt jedoch nicht vollständig vermittelt.","refs":["CH_GB18_A_28:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FL-02","text":"Das Vergleichende erscheint zunächst als äußerliche Tätigkeit und wird anschließend als immanente Natur der verglichenen Bestimmungen bestimmt; der Übergang zwischen beiden Status bleibt ein produktiver Bruch.","refs":["CH_GB18_2DV0:MRT2","CH_GB18_2DV0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FL-03","text":"Abstrakte Identität ist zugleich unwahr für sich und notwendiges Moment der vollständigen Wahrheit; das System benötigt diese Doppelstellung, ohne sie in ruhige Konsistenz aufzulösen.","refs":["CH_GB18_A_28:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MP-01","text":"Identität mutiert von der leeren Behauptung der Selbstgleichheit zur Negation der Negation und damit zur bewegten Form innerer Differenz.","refs":["CH_GB18_A_28:A1","CH_GB18_A_28:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MP-02","text":"Unterschied mutiert vom einfachen Selbstunterschied zur Verschiedenheit und danach zu äußerlichen Vergleichsformen, deren Selbstaufhebung seine frühere Immanenz wieder freilegt.","refs":["CH_GB18_1DAU:A5","CH_GB18_2DV0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MP-03","text":"Gleichgültigkeit ist doppelfunktional: Sie stabilisiert zunächst selbstbezügliche Bestimmungen und wird zugleich zum Mechanismus ihrer Auflösung.","refs":["CH_GB18_2DV0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_38:HSI-01","text":"Realität erscheint als Maschine negativer Reflexion, in der keine Bestimmung zuerst positiv vorliegt, sondern jede nur durch ihre immanente Beziehung auf ihr Anderes besteht.","refs":["CH_GB18_2DV0:DNX1","CH_GB18_1DAU:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:HSI-02","text":"Das Subjekt ist kein äußerer Beobachter der Differenzen, sondern eine Durchgangsfigur der Vergleichsbewegung, deren gesetzte Äußerlichkeit in immanente Negativität zurückkehrt.","refs":["CH_GB18_2DV0:A8","CH_GB18_2DV0:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:HSI-03","text":"Zeit erscheint als rekursive Sequenz von Setzung, Selbstunterschied, Externalisierung, Selbstaufhebung und transformierter Rückkehr; Handlung besteht in der immanenten Rekonstruktion dieser Sequenz, nicht in ihrer äußeren Beherrschung.","refs":["CH_GB18_A_28:FGS5","CH_GB18_2DV0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_38:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Gesamtbewegung von abstrakter Identität über absoluten Unterschied und Verschiedenheit zur negativen Einheit zu rekonstruieren.","refs":["CH_GB18_A_28:MRT1","CH_GB18_2DV0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MRT-B02","text":"Die Architektur ist am stärksten, wenn sie logische Formanalyse, immanente Ontologie und performative Selbstwiderlegung als eine einzige negative Bewegungsform verschränkt.","refs":["CH_GB18_A_28:MRT4","CH_GB18_2DV0:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MRT-B03","text":"Unterbestimmt bleibt die Vermittlung zwischen Satzform und ontologischer Reflexion sowie zwischen dem äußerlichen Vergleichenden und seiner immanenten Rücknahme.","refs":["CH_GB18_A_28:MRT2","CH_GB18_2DV0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MRT-B04","text":"Die Rekonstruktion bleibt kohärent, sofern Gegensatz nicht als äußerer Endpunkt, sondern als durch Selbstaufhebung erzeugte Schwelle einer weiteren negativen Bewegung verstanden wird.","refs":["CH_GB18_A_28:MRT7","CH_GB18_2DV0:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122240946278Z_3c19fc04","language_code":"en","language_name":"English","title":"Chapters 112–114","source_sha256":"44ac690046fde55c3ff559d5ac936f169af264068ced42404f2a71aa1105d9a0","sha256":"f0326ad0fb9e35198d8be13cc0d1ac0be439b64f1872cc24d247676f04d8302b","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:22:40.947726+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_38:AS-01","text":"The system examines the claim that abstract self-sameness can function as the first and resting law of thought, and determines this claim to be an inadequate beginning.","refs":["CH_GB18_A_28:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-02","text":"The emptiness of abstract identity is not mere poverty of content, but a defect of enactment: its delimitation against difference brings what is excluded back into its own form.","refs":["CH_GB18_A_28:AS2","CH_GB18_A_28:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-03","text":"What initially appears as a defect of identity is transformed into an ontological principle: difference does not arise externally between existing entities, but as an immanent determination of reflection.","refs":["CH_GB18_1DAU:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-04","text":"Absolute difference compels identity and difference into a reciprocal internal relation in which identity does not disappear, but becomes the immanent other of difference.","refs":["CH_GB18_1DAU:AS3","CH_GB18_1DAU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-05","text":"The unity of identity and difference generates determinate difference; as soon as both moments are determined as reflections-into-self, this passes over into diversity.","refs":["CH_GB18_1DAU:AS5","CH_GB18_1DAU:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-06","text":"Diversity externalizes itself as equality and inequality, whose meaning does not belong to things themselves, but is generated through comparative positing.","refs":["CH_GB18_2DV0:A7","CH_GB18_2DV0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-07","text":"The attempted isolation of equality and inequality destroys their relational determinacy and releases the negative unity that sustained them.","refs":["CH_GB18_2DV0:A10","CH_GB18_2DV0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AS-08","text":"The movement does not conclude in a resting identity, but in the necessary transformation of external diversity into opposition; its form is recursive, escalating, and negatively productive.","refs":["CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_38:GA-01","text":"[Attractor] Identity is true only as unity with diversity; isolated self-sameness is an incomplete abstraction.","refs":["CH_GB18_A_28:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-02","text":"[Persistent] Negativity is not external negation, but the immanent self-relation through which reflection, identity, and difference are determined at all.","refs":["CH_GB18_A_28:A8","CH_GB18_1DAU:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-03","text":"[Mutating] The law of identity loses its status as a stationary foundation and becomes the performative presentation of a movement of reflection.","refs":["CH_GB18_A_28:A1","CH_GB18_A_28:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-04","text":"[Emergent] Absolute difference is not the distance between two finished unities, but the simple self-difference of A and non-A under the same respect of determination.","refs":["CH_GB18_1DAU:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-05","text":"[Persistent] Difference and identity are neither independent poles nor subsequently connected determinations, but at once wholes and moments of the same reflection.","refs":["CH_GB18_1DAU:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-06","text":"[Mutating] Diversity arises when the reciprocally determined moments appear as self-relating reflections and initially comport themselves indifferently toward one another.","refs":["CH_GB18_1DAU:AS6","CH_GB18_2DV0:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-07","text":"[Emergent] Equality and inequality are posited forms of external reflection and not original properties of the things compared.","refs":["CH_GB18_2DV0:A7","CH_GB18_2DV0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-08","text":"[Attractor] Every determination that rejects its relation to otherness as external reproduces this relation as the condition of its own determinacy and negates its independence.","refs":["CH_GB18_2DV0:A10","CH_GB18_2DV0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GA-09","text":"[Terminal] The self-sublation of external diversity does not release a restoration of abstract equality, but the transition into negative unity and opposition.","refs":["CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_38:RMD-01","text":"Identity recurs, yet no longer retains the function of self-sameness: it mutates from empty tautology into a reflective unity that bears difference within itself.","refs":["CH_GB18_A_28:ME1","CH_GB18_2DV0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RMD-02","text":"Difference shifts from the excluded difference of abstract identity to absolute self-difference and is subsequently absorbed as determinate difference into diversity.","refs":["CH_GB18_A_28:ME2","CH_GB18_1DAU:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RMD-03","text":"Negativity mutates from the content of contradiction implicit in the proposition of identity into the self-negation of externally posited forms of comparison.","refs":["CH_GB18_A_28:A9","CH_GB18_2DV0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RMD-04","text":"The external reflection of comparing is not retained as an alien subjectivity, but withdrawn as a provisional form of appearance of immanent negative unity.","refs":["CH_GB18_2DV0:A6","CH_GB18_2DV0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RMD-05","text":"Equality and inequality perform transitional work as forms of comparison and disappear as soon as their separation destroys the relational determinacy that first made them meaningful.","refs":["CH_GB18_2DV0:A9","CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_38:CGD-01","text":"The analysis of the propositional form A=A, of the substrate, and of the disappointed expectation of a determination remains a local diagnostic mechanism; at the cluster level it counts only as an entry point into the self-negation of abstract identity.","refs":["CH_GB18_A_28:A7","CH_GB18_A_28:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:CGD-02","text":"The present level does not bear the single thesis that identity contains difference, but the stronger architecture according to which every determination gains determinacy only as negative self-relation.","refs":["CH_GB18_A_28:A8","CH_GB18_2DV0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:CGD-03","text":"The construction of the simple not and of absolute difference remains local as a derivational mechanism, but becomes effective at the cluster level as the necessary recoding of external difference into immanent reflection.","refs":["CH_GB18_1DAU:A6","CH_GB18_1DAU:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:CGD-04","text":"Equality, inequality, and the comparing third scale beyond their local treatment because they demonstrate the general untenability of an external mediation.","refs":["CH_GB18_2DV0:A8","CH_GB18_2DV0:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:CGD-05","text":"Opposition is not a further local category alongside equality and inequality, but their terminal reclassification as unstable transitional forms of negative unity.","refs":["CH_GB18_2DV0:SD4","CH_GB18_2DV0:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_38:GNX-01","text":"Excluded is an identity that could exist prior to, outside of, or independently of its own difference.","refs":["CH_GB18_A_28:NX1","CH_GB18_1DAU:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GNX-02","text":"Excluded is a difference that could be explained by externally existing things, external relations, or mere transition between fixed determinations.","refs":["CH_GB18_1DAU:NX2","CH_GB18_1DAU:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GNX-03","text":"Excluded is the view that equality and inequality are positive properties belonging in and for themselves to the things compared.","refs":["CH_GB18_2DV0:NX3","CH_GB18_2DV0:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:GNX-04","text":"Excluded is an external standpoint that could ground forms of comparison without itself entering into their negative movement.","refs":["CH_GB18_2DV0:DNX2","CH_GB18_2DV0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_38:DBN-01","text":"It must be false that thought can be grounded on a law whose validity is purified of every relation to otherness.","refs":["CH_GB18_A_28:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:DBN-02","text":"It must be false that identity and difference exist as primarily separate determinations and are mediated only subsequently.","refs":["CH_GB18_A_28:DNX2","CH_GB18_2DV0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:DBN-03","text":"It must be false that external comparison can provide a stable mediation that permanently separates equality and inequality while preserving them as meaningful.","refs":["CH_GB18_2DV0:NX5","CH_GB18_2DV0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_38:BSA-01","text":"Unavailable remains a pure self-presence in which identity could be true without internal negation and without self-difference.","refs":["CH_GB18_A_28:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:BSA-02","text":"Unavailable remains a final external ground that could mediate the unity of identity and difference without itself being a moment of this unity.","refs":["CH_GB18_1DAU:DNX4","CH_GB18_1DAU:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:BSA-03","text":"Inadmissible remains a final positive difference that would be neither sustained by identity nor mediated by negative reflection.","refs":["CH_GB18_2DV0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_38:XD-01","text":"The negativity performatively effective in the proposition of identity first acquires its ontological status through the determination of absolute difference; contradiction thereby becomes legible not as an error, but as an explication of the content of identity.","refs":["CL_GB18_38:GA-01","CL_GB18_38:GA-03","CL_GB18_38:GA-04","CH_GB18_A_28:AS5","CH_GB18_1DAU:AS3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_38:XD-02","text":"The movement from immanent difference to external diversity establishes externality not as a counterworld to reflection, but as a derived and self-sublating phase of the same negativity.","refs":["CL_GB18_38:GA-02","CL_GB18_38:GA-05","CL_GB18_38:GA-06","CH_GB18_1DAU:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_38:XD-03","text":"The comparing third is neither a sovereign observer nor a mere subjective addition, because its external positing returns as the immanent negative unity of the comparative determinations.","refs":["CL_GB18_38:GA-07","CL_GB18_38:GA-08","CH_GB18_2DV0:A8","CH_GB18_2DV0:A11"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_38:XD-04","text":"Equality and inequality can exist only as reciprocal forms; their separation necessarily produces the transition from comparability to opposition.","refs":["CL_GB18_38:GA-07","CL_GB18_38:GA-09","CH_GB18_2DV0:A9","CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_38:BSD-01","text":"At the cluster level, the first law of thought is not refuted in order to be replaced by another fixed law, but reconstructed as the first instance of a self-movement of thought.","refs":["CH_GB18_A_28:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:BSD-02","text":"Reality appears not as an aggregate of initially identical things, but as articulated self-movement in which determinacy exists only through self-negation.","refs":["CH_GB18_1DAU:SD3","CH_GB18_2DV0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:BSD-03","text":"Comparison changes from a technique of cognition into an ontological form of crisis: it reveals that its own categories acquire validity only through the negation of their separateness.","refs":["CH_GB18_2DV0:SD3","CH_GB18_2DV0:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:BSD-04","text":"The transition into opposition is not a harmonious synthesis, but the reclassification of external diversity compelled by self-sublation.","refs":["CH_GB18_2DV0:SD4","CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_38:RLE-01","text":"Abstract identity excludes diversity, thereby presupposes it, and returns to itself as unity with it; the return changes the meaning of identity.","refs":["CH_GB18_A_28:A3","CH_GB18_A_28:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RLE-02","text":"Difference negates itself as difference from itself and thereby generates identity as its immanent other; identity and difference are the reciprocal products of the same loop.","refs":["CH_GB18_1DAU:A8","CH_GB18_1DAU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RLE-03","text":"Diversity provisionally stabilizes itself as indifference, externalizes itself in comparison, and through this externalization loses precisely the determinacy it was meant to secure.","refs":["CH_GB18_2DV0:AS2","CH_GB18_2DV0:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:RLE-04","text":"Negative unity functions as an attractor because every attempted independence of identity, difference, equality, or inequality is led back into it.","refs":["CH_GB18_2DV0:A13","CH_GB18_2DV0:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_38:FGS-B01","text":"Abstract self-sameness → exclusion of diversity → performative return of what is excluded.","refs":["CH_GB18_A_28:AS2","CH_GB18_A_28:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FGS-B02","text":"Return of difference → negativity of identity → absolute difference as self-relation.","refs":["CH_GB18_A_28:A8","CH_GB18_1DAU:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FGS-B03","text":"Self-relating difference → identity as immanent other → determinate difference → diversity.","refs":["CH_GB18_1DAU:AS4","CH_GB18_1DAU:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FGS-B04","text":"Diversity as indifference → external reflection → equality and inequality as posited forms of comparison.","refs":["CH_GB18_2DV0:A3","CH_GB18_2DV0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FGS-B05","text":"Separated forms of comparison → loss of their reciprocal determinacy → negative unity → opposition.","refs":["CH_GB18_2DV0:A10","CH_GB18_2DV0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_38:AFM-B01","text":"Claim of a first law of thought → diagnosis of empty self-sameness.","refs":["CH_GB18_A_28:AS1","CH_GB18_A_28:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AFM-B02","text":"Empty self-sameness → immanent diversity → negativity of identity.","refs":["CH_GB18_A_28:A2","CH_GB18_A_28:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AFM-B03","text":"Negativity of identity → absolute difference → identity as the internal other of difference.","refs":["CH_GB18_1DAU:A2","CH_GB18_1DAU:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AFM-B04","text":"Unity of identity and difference → determinate difference → diversity of self-relating moments.","refs":["CH_GB18_1DAU:A12","CH_GB18_1DAU:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AFM-B05","text":"Diversity → external comparison → equality and inequality → indifference of their separation.","refs":["CH_GB18_2DV0:AS3","CH_GB18_2DV0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:AFM-B06","text":"Indifference → self-sublation of posited difference → negative unity → opposition.","refs":["CH_GB18_2DV0:A12","CH_GB18_2DV0:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_38:MME-01","text":"Identity is remapped from a static relation of equality into a reflective self-differentiation.","refs":["CH_GB18_A_28:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MME-02","text":"Difference is reclassified from a relation between existent entities into an immanent operation of reflection.","refs":["CH_GB18_1DAU:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MME-03","text":"Equality and inequality are reordered from properties of compared objects into posited forms of external reflection.","refs":["CH_GB18_2DV0:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MME-04","text":"The opposition between subjective comparing and objective determinacy disintegrates because that which compares is determined as immanent negative unity.","refs":["CH_GB18_2DV0:ME3","CH_GB18_2DV0:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_38:ALT-B01","text":"Surface level — The system treats A=A, A and non-A, diversity, equality, inequality, and comparison as explicit problems of determination.","refs":["CH_GB18_2DV0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:ALT-B02","text":"Structural level — The supporting structure is negative self-relation, through which identity, difference, and forms of comparison arise simultaneously and lose their separateness.","refs":["CH_GB18_1DAU:ALT2","CH_GB18_2DV0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:ALT-B03","text":"Metastrategic level — The investigation replaces external refutation with immanent reconstruction of the forms of enactment in which a determination produces its own limit.","refs":["CH_GB18_A_28:ALT3","CH_GB18_1DAU:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:ALT-B04","text":"Ontological / Temporal level — Reality exists as a retrogressive movement of positing, negation, otherness, self-sublation, and return, not as the timeless coexistence of fixed determinations.","refs":["CH_GB18_A_28:ALT4","CH_GB18_2DV0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:ALT-B05","text":"Methodological / Performative level — The analysis enacts its object by making propositional form and comparative form visible as procedures that themselves reintroduce what they exclude.","refs":["CH_GB18_A_28:SD4","CH_GB18_2DV0:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_38:FL-01","text":"The architecture presupposes that logical propositional form and ontological structure of reflection pass into one another; yet the necessity of this transition remains not fully mediated.","refs":["CH_GB18_A_28:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FL-02","text":"That which compares initially appears as an external activity and is subsequently determined as the immanent nature of the compared determinations; the transition between both statuses remains a productive rupture.","refs":["CH_GB18_2DV0:MRT2","CH_GB18_2DV0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:FL-03","text":"Abstract identity is at once untrue for itself and a necessary moment of complete truth; the system requires this double status without resolving it into calm consistency.","refs":["CH_GB18_A_28:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MP-01","text":"Identity mutates from the empty assertion of self-sameness into the negation of negation and thereby into the moving form of internal difference.","refs":["CH_GB18_A_28:A1","CH_GB18_A_28:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MP-02","text":"Difference mutates from simple self-difference into diversity and thereafter into external forms of comparison, whose self-sublation again exposes its earlier immanence.","refs":["CH_GB18_1DAU:A5","CH_GB18_2DV0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MP-03","text":"Indifference is double-functional: it initially stabilizes self-relating determinations and simultaneously becomes the mechanism of their dissolution.","refs":["CH_GB18_2DV0:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_38:HSI-01","text":"Reality appears as a machine of negative reflection in which no determination is initially given positively, but each exists only through its immanent relation to its other.","refs":["CH_GB18_2DV0:DNX1","CH_GB18_1DAU:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:HSI-02","text":"The subject is not an external observer of differences, but a transitional figure of the movement of comparison, whose posited externality returns into immanent negativity.","refs":["CH_GB18_2DV0:A8","CH_GB18_2DV0:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:HSI-03","text":"Time appears as a recursive sequence of positing, self-difference, externalization, self-sublation, and transformed return; action consists in the immanent reconstruction of this sequence, not in its external mastery.","refs":["CH_GB18_A_28:FGS5","CH_GB18_2DV0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_38:MRT-B01","text":"The extracted axioms suffice to reconstruct the overall movement from abstract identity through absolute difference and diversity to negative unity.","refs":["CH_GB18_A_28:MRT1","CH_GB18_2DV0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MRT-B02","text":"The architecture is strongest when it intertwines logical form analysis, immanent ontology, and performative self-refutation as a single negative form of movement.","refs":["CH_GB18_A_28:MRT4","CH_GB18_2DV0:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MRT-B03","text":"The mediation between propositional form and ontological reflection, as well as between the external comparer and its immanent withdrawal, remains underdetermined.","refs":["CH_GB18_A_28:MRT2","CH_GB18_2DV0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_38:MRT-B04","text":"The reconstruction remains coherent provided that opposition is understood not as an external endpoint, but as the threshold of a further negative movement generated through self-sublation.","refs":["CH_GB18_A_28:MRT7","CH_GB18_2DV0:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_38@R001","source_variant_id":"canonical:CL_GB18_38:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 112–114","context":"Anmerkung 2. · 1. Der absolute Unterschied. · 2. Die Verschiedenheit."},"title_language_code":"en"},{"id":"CL_GB18_39","layer":"CL","title":"Chapters 115–117","order":39,"parents":["CH_GB18_A_29","CH_GB18_3DG0","CH_GB18_A_30"],"revision":"CL_GB18_39@R001","sha256":"fbc42f8f4e7528fc12caf37a7de21b30b697e10df20affebc90e001bb7f98f4c","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_39:AS-01","text":"Das Cluster rekonstruiert, warum Identität, Verschiedenheit und Entgegensetzung nicht als isolierte Prädikate bestehen können, sondern nur als sich selbst vermittelnde Bestimmungen.","refs":["CH_GB18_A_29:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-02","text":"Seine Grundthese lautet, dass bestimmte Verschiedenheit nicht aus numerischer Vielheit, sondern aus der in Identität wirksamen Negation hervorgeht.","refs":["CH_GB18_A_29:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-03","text":"Das Argument verfährt rekonstruktiv: Es lässt unmittelbare Sätze an den Vermittlungsforderungen scheitern, die ihre eigenen Bestimmungen erzeugen.","refs":["CH_GB18_A_29:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-04","text":"Die Bewegung führt von unbestimmter Identität über bestimmte Verschiedenheit und Ungleichheit zu einem Gegensatz, dessen Seiten ihre jeweilige Bestimmtheit im anderen besitzen.","refs":["CH_GB18_A_29:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-05","text":"Die Vermittlungsforderung wird zum Strukturgesetz: Was in einem Satz als verschiedene Bestimmung verbunden wird, kann nicht ohne einen immanenten Übergang bestehen.","refs":["CH_GB18_A_29:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-06","text":"Die Auslagerung des Widerspruchs in eine äußere Rücksicht oder Reflexion erzeugt keine Lösung, sondern reproduziert die Einheit der getrennten Momente auf einer höheren Stufe.","refs":["CH_GB18_A_29:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-07","text":"Der Gegensatz vollendet diese Bewegung, indem jede Seite nur durch das Nichtsein der anderen besteht und damit zugleich Selbstbeziehung, Ausschließung und Vermittlung ist.","refs":["CH_GB18_3DG0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-08","text":"Die arithmetische Behandlung von Plus und Minus fungiert als operativer Test: Sie macht sichtbar, dass Entgegensetzung je nach Operation äußerlich, relational oder qualitativ bestimmt ist.","refs":["CH_GB18_A_30:AS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_39:GA-01","text":"[Persistent] Bestimmtheit entsteht nur, indem Identität Negation in sich aufnimmt; ein bloß selbstgleiches Substrat bleibt unbestimmt und vertauschbar.","refs":["CH_GB18_A_29:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-02","text":"[Mutating] Verschiedenheit mutiert von numerischer Vielheit zu bestimmter Ungleichheit und wird dadurch zu einer inneren Beziehung ihrer Momente.","refs":["CH_GB18_A_29:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-03","text":"[Emergent] Gleichheit und Ungleichheit sind keine separierbaren Eigenschaften, sondern gleichzeitig wirksame Momente derselben bestimmten Verschiedenheit.","refs":["CH_GB18_A_29:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-04","text":"[Persistent] Jede Seite des Gegensatzes ist nur, insofern ihr Nichtsein und damit das andere Moment als konstitutive Bedingung ihres Bestehens wirksam ist.","refs":["CH_GB18_3DG0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-05","text":"[Mutating] Positivität und Negativität sind zunächst austauschbare gesetzte Zuschreibungen und werden erst durch die Rücknahme der Relation in jede Seite zu ausschließender Selbstbestimmung.","refs":["CH_GB18_3DG0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-06","text":"[Emergent] Das Vorzeichen besitzt keine operationsunabhängige Bedeutung; seine Bestimmtheit hängt davon ab, ob die Relation äußerlich additiv oder qualitativ-faktoriell organisiert ist.","refs":["CH_GB18_A_30:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-07","text":"[Attractor] Ansichsein ist keine Flucht aus der Relation, sondern die Relation selbst, sofern sie als ausschließende Selbstbeziehung die Bestimmung einer Seite ausmacht.","refs":["CH_GB18_3DG0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-08","text":"[Terminal] Negation wird allein durch das Negative wirksam; Positivität erscheint als Resultat der Negation der Negation, nicht als ursprünglicher Grund.","refs":["CH_GB18_A_30:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-09","text":"[Attractor] Wesen, Selbstständigkeit und Bestimmung fallen mit der ausschließenden Beziehung auf das Andere zusammen; relationslose Substanz ist kein zulässiger Endpunkt.","refs":["CH_GB18_3DG0:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_39:RMD-01","text":"Numerische Vielheit kehrt als notwendiger Anfang wieder, verliert jedoch ihren Anspruch auf Bestimmtheit und wird in vermittelte Ungleichheit absorbiert.","refs":["CH_GB18_A_29:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RMD-02","text":"Gleichheit und Ungleichheit kehren im Gegensatz als Positives und Negatives wieder, aber nicht mehr als äußerlich vergleichbare Seiten, sondern als innere Formen von Selbstbeziehung und Nichtsein.","refs":["CH_GB18_3DG0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RMD-03","text":"Die äußere Reflexion mutiert von der Instanz, welche Gleichheit und Ungleichheit nach Rücksichten trennt, zu einem selbst vom Gegenstand hervorgebrachten Vollzug ihrer Einheit.","refs":["CH_GB18_A_29:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RMD-04","text":"Die Austauschbarkeit von positiv und negativ ist keine stabile Identität der Seiten, sondern eine Übergangsstufe bloßen Gesetztseins.","refs":["CH_GB18_3DG0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RMD-05","text":"Null mutiert von der scheinbaren Auslöschung entgegengesetzter Größen zu einer abstrahierten Form aufgehobener Beziehung, bleibender Einheit oder fortbestehender Vielheit.","refs":["CH_GB18_A_30:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RMD-06","text":"Das Negative verschiebt sich vom äußeren Gegenzeichen zum privilegierten Träger bestimmender Negation und damit zum Motor des Umschlags in Positivität.","refs":["CH_GB18_A_30:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_39:CGD-01","text":"Die Forderung nach einem vermittelnden Dritten bleibt auf der unteren Ebene eine logische Beweisforderung; auf Clusterebene wird sie zur Einsicht, dass Bestimmungen ihre Einheit nur durch immanente Negation erzeugen.","refs":["CH_GB18_A_29:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:CGD-02","text":"Die Trennung durch das „Insofern“ ist lokal eine Technik äußerer Reflexion; auf der aktuellen Ebene zeigt sie generell, dass perspektivische Separation den Widerspruch nur verlagern kann.","refs":["CH_GB18_A_29:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:CGD-03","text":"Die verschiedenen Resultate derselben arithmetischen Formel bleiben lokale Abstraktionsresultate; ihr skalierbarer Ertrag besteht darin, Aufhebung, Einheit und Vielheit als simultane Register einer Relation zu unterscheiden.","refs":["CH_GB18_A_30:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:CGD-04","text":"Die Bestimmung jeder Seite als Trägerin ihres Anderen skaliert über den einzelnen Gegensatz hinaus und organisiert die gesamte Architektur von Unterschied, Opposition und qualitativer Negation.","refs":["CH_GB18_3DG0:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:CGD-05","text":"Die konkrete Vorzeichenregel bleibt ein lokaler Fall; ihr übergeordneter Gehalt ist die asymmetrische These, dass nur Negativität Bestimmung als Negation hervorbringen kann.","refs":["CH_GB18_A_30:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_39:GNX-01","text":"Ausgeschlossen ist eine Verschiedenheit, die als bloße numerische Pluralität ohne Ungleichheit und ohne reflektierte Beziehung bereits vollständig bestimmt wäre.","refs":["CH_GB18_A_29:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GNX-02","text":"Ausgeschlossen ist eine Seite des Gegensatzes, die unmittelbar für sich bestehen und ihr Nichtsein außerhalb ihrer eigenen Bestimmung lassen könnte.","refs":["CH_GB18_3DG0:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GNX-03","text":"Ausgeschlossen ist eine dritte Vergleichsinstanz, die Positives und Negatives endgültig verteilen könnte, ohne selbst in die Relation der Seiten einzutreten.","refs":["CH_GB18_A_30:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GNX-04","text":"Ausgeschlossen ist ein Nullbegriff, der die aufgehobene Beziehung, die identische Grundlage und die fortbestehende Vielheit restlos vernichten würde.","refs":["CH_GB18_A_30:NX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_39:DBN-01","text":"Das Cluster verwirft ein Modell statischer Identitäten, nach dem ein selbstidentisches Substrat vor jeder inneren Negation bereits ein bestimmtes Ding sein könnte.","refs":["CH_GB18_A_29:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:DBN-02","text":"Es verwirft eine Logik der Widerspruchsvermeidung, welche Gleichheit und Ungleichheit durch verschiedene Rücksichten trennt und diese Verteilung mit ihrer Aufhebung verwechselt.","refs":["CH_GB18_A_29:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:DBN-03","text":"Es verwirft einen rein formalen Kalkül, der Regeln aus Symbolen ableitet, ohne die qualitative Bestimmung der jeweiligen Operation zu rekonstruieren.","refs":["CH_GB18_A_30:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:DBN-04","text":"Es verwirft eine vollständige Symmetrie von Positivem und Negativem, sobald Negativität als immanente Entgegensetzung und bestimmende Kraft auftritt.","refs":["CH_GB18_A_30:DNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_39:BSA-01","text":"Unverfügbar ist ein Ursprung von Positivität oder Negativität vor ihrer wechselseitigen Vermittlung; beide entstehen nur aus einer bereits wirksamen Relation.","refs":["CH_GB18_3DG0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSA-02","text":"Unzugänglich ist eine Positivität, die aus sich selbst Negation hervorbringen könnte; Positivität bleibt Resultat und nicht Quelle bestimmender Differenz.","refs":["CH_GB18_A_30:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSA-03","text":"Nicht verfügbar ist ein neutraler Endstandpunkt, an dem Null, Identität oder äußere Vergleichbarkeit jede fortbestehende Vermittlung endgültig stillstellen würden.","refs":["CH_GB18_A_30:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_39:XD-01","text":"Die zunächst abstrakte Forderung nach Vermittlung wird im Gegensatz konkret: Verschiedene Bestimmungen können nur zusammen bestehen, wenn jede Seite das Nichtsein der anderen als Bedingung ihres eigenen Seins enthält.","refs":["CL_GB18_39:GA-01","CL_GB18_39:GA-04","CH_GB18_A_29:AS5","CH_GB18_3DG0:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_39:XD-02","text":"Die Kritik der äußeren Reflexion erhält durch die Vorzeichenanalyse eine operationale Form: Ein dritter Bezugspunkt kann Zeichen verteilen, aber keine immanente Positivität oder Negativität begründen.","refs":["CL_GB18_39:GA-05","CL_GB18_39:GA-06","CH_GB18_A_29:A12","CH_GB18_A_30:A4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_39:XD-03","text":"Die Austauschbarkeit von positiv und negativ gilt nur für äußerlich gesetzte Opposition; sie bricht zusammen, sobald das Verhältnis selbst qualitativ wird und Negativität als immanente Entgegensetzung fungiert.","refs":["CL_GB18_39:GA-05","CL_GB18_39:GA-06","CH_GB18_3DG0:A8","CH_GB18_A_30:A9"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_39:XD-04","text":"Die Aufhebung entgegengesetzter Größen reproduziert die allgemeine Struktur reflektierter Verschiedenheit: Das andere wird negiert, ohne deshalb als Bedingung der Einheit und Vielheit zu verschwinden.","refs":["CL_GB18_39:GA-03","CL_GB18_39:GA-04","CH_GB18_3DG0:AS3","CH_GB18_A_30:A5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_39:XD-05","text":"Die Unterscheidung zwischen äußerlicher und an-sich-seiender Entgegensetzung verwandelt die Vorzeichenregel von einer Konvention der Zuschreibung in eine Theorie bestimmender Negation.","refs":["CL_GB18_39:GA-06","CL_GB18_39:GA-08","CH_GB18_A_30:A1","CH_GB18_A_30:A10"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_39:XD-06","text":"Positivität kann nicht als Ausgangsseite der Opposition gelten, weil ihre bestimmte Gestalt erst dort entsteht, wo Negativität sich selbst negiert und damit ihre ausschließende Funktion umkehrt.","refs":["CL_GB18_39:GA-05","CL_GB18_39:GA-08","CH_GB18_3DG0:A4","CH_GB18_A_30:A11"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_39:BSD-01","text":"Realität erscheint als Netz von Bestimmungen, deren Identität nicht vor ihren Relationen liegt, sondern aus dem Einschluss und Ausschluss ihres Anderen hervorgeht.","refs":["CH_GB18_A_29:A7","CH_GB18_3DG0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSD-02","text":"Erkenntnis kann Prädikate nicht als feste Eigenschaften behandeln, sondern muss die Operation bestimmen, durch welche eine Seite positiv, negativ, gleich, ungleich oder aufgehoben wird.","refs":["CH_GB18_A_30:AS1","CH_GB18_A_30:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSD-03","text":"Aufhebung ist kein Verlustmodell, sondern eine mehrschichtige Transformation, in der relationale Annullierung, bleibende Identität und getrennte Existenz zugleich möglich bleiben.","refs":["CH_GB18_A_30:A5","CH_GB18_A_30:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSD-04","text":"Die Reflexion ist weder ein äußerlicher Beobachter noch ein souveräner Schiedsrichter, sondern die Tätigkeit, in der der Gegenstand seine getrennten Momente als Einheit reproduziert.","refs":["CH_GB18_A_29:A11","CH_GB18_3DG0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSD-05","text":"Negativität besitzt innerhalb der Architektur eine asymmetrische generative Rolle: Sie führt Bestimmung ein, trägt Ausschließung und erzeugt durch ihre Selbstnegation die Form von Positivität.","refs":["CH_GB18_A_30:SD4","CH_GB18_3DG0:A6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_39:RLE-01","text":"Identität erzeugt Unbestimmtheit; Bestimmung führt Negation ein; Negation erzeugt Verschiedenheit; Verschiedenheit wird als Einheit von Gleichheit und Ungleichheit widersprüchlich und drängt zum Gegensatz.","refs":["CH_GB18_A_29:A1","CH_GB18_A_29:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RLE-02","text":"Der Gegensatz bildet eine Rekursionsschleife, weil jede Seite ihr Anderes als Nichtsein enthält, es ausschließt und gerade durch diese Ausschließung zu sich zurückkehrt.","refs":["CH_GB18_3DG0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RLE-03","text":"Die Zuschreibung positiv oder negativ durchläuft eine Eskalation von äußerlicher Austauschbarkeit zu innerer Notwendigkeit, sobald die Relation nicht mehr außerhalb, sondern in jeder Seite gesetzt wird.","refs":["CH_GB18_3DG0:A8","CH_GB18_3DG0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RLE-04","text":"Die Rechnung mit entgegengesetzten Größen bildet eine Schleife von Aufhebung, Einheit und Vielheit: Das Resultat Null beendet die Relation nicht, sondern zwingt zur Unterscheidung ihrer Abstraktionsebenen.","refs":["CH_GB18_A_30:A5","CH_GB18_A_30:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RLE-05","text":"Die Negation der Negation bildet einen terminalen Attraktor, der Positivität erzeugt, ohne die Bedingungen ihrer Entstehung aus negativer Vermittlung auszulöschen.","refs":["CH_GB18_A_30:A10","CH_GB18_A_30:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_39:FGS-B01","text":"Identität → Unbestimmtheit → Bedarf der Bestimmung → Negation als innere Differenz.","refs":["CH_GB18_A_29:A1","CH_GB18_A_29:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FGS-B02","text":"Numerische Vielheit → unbestimmte Verschiedenheit; bestimmte Verschiedenheit → Ungleichheit → Einheit von Gleichheit und Ungleichheit.","refs":["CH_GB18_A_29:A3","CH_GB18_A_29:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FGS-B03","text":"Gleichheit und Ungleichheit → reflektierte Bestimmungen von Sein und Nichtsein → Positives und Negatives.","refs":["CH_GB18_3DG0:AS2","CH_GB18_3DG0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FGS-B04","text":"Positives und Negatives → wechselseitiges Nichtsein → Rücknahme der Relation → ausschließende Selbstbeziehung → Ansichsein.","refs":["CH_GB18_3DG0:A7","CH_GB18_3DG0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FGS-B05","text":"Äußerliche Vorzeichenrelation → Austauschbarkeit der Zuschreibung; qualitative Operation → immanente Negativität und asymmetrische Bestimmung.","refs":["CH_GB18_A_30:A3","CH_GB18_A_30:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FGS-B06","text":"Immanente Negation → Negation der Negation → Positivität, die als Resultat der negativen Vermittlung fortbesteht.","refs":["CH_GB18_A_30:A10","CH_GB18_A_30:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_39:AFM-B01","text":"Unbestimmte Identität → Vertauschbarkeit des bloß selbstgleichen Substrats.","refs":["CH_GB18_A_29:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B02","text":"Numerische Vielheit → Zurückweisung ihrer Gleichsetzung mit bestimmter Verschiedenheit.","refs":["CH_GB18_A_29:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B03","text":"Bestimmte Verschiedenheit → Ungleichheit → Einheit von Gleichheit und Ungleichheit.","refs":["CH_GB18_A_29:A4","CH_GB18_A_29:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B04","text":"Einheit der verschiedenen Momente → Gegensatz → wechselseitige Vermittlung durch Nichtsein.","refs":["CH_GB18_3DG0:AS1","CH_GB18_3DG0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B05","text":"Wechselseitige Vermittlung → äußerlich vertauschbare Vorzeichen → Rücknahme der Beziehung in jede Seite.","refs":["CH_GB18_3DG0:A8","CH_GB18_3DG0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B06","text":"Äußerliche Zeichenopposition → Trennung der Operationen → qualitative Asymmetrie des Negativen.","refs":["CH_GB18_A_30:FGS1","CH_GB18_A_30:AF4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B07","text":"Bestimmende Negation → Negation ihrer selbst → Positivität als vermittelte Schließung.","refs":["CH_GB18_A_30:AF5","CH_GB18_A_30:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_39:MME-01","text":"Der Gegensatz von Gleichheit und Ungleichheit bricht als exklusive Alternative zusammen und wird als ko-konstitutive Form bestimmter Verschiedenheit kartiert.","refs":["CH_GB18_A_29:ME2","CH_GB18_A_29:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MME-02","text":"Positiv und negativ werden von Wert- oder Sachprädikaten zu Modi reflexiver Selbstbestimmung umklassifiziert.","refs":["CH_GB18_3DG0:ME2","CH_GB18_3DG0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MME-03","text":"Selbstständigkeit und Abhängigkeit werden als ineinander übergehende Funktionen derselben Vermittlung lesbar, nicht als getrennte Zustände.","refs":["CH_GB18_3DG0:SD2","CH_GB18_3DG0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MME-04","text":"Null wird von der Chiffre absoluter Vernichtung zur Karte dreier unterscheidbarer Register: aufgehobene Beziehung, bleibende Einheit und reale Vielheit.","refs":["CH_GB18_A_30:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MME-05","text":"Arithmetische Regeln werden nur noch als Folge einer Theorie der Negation verständlich; Symbolik wird dem Begriff der Operation untergeordnet.","refs":["CH_GB18_A_30:ME4","CH_GB18_A_30:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_39:ALT-B01","text":"Oberflächenebene — Das Cluster behandelt Identität, Verschiedenheit, Gleichheit, Ungleichheit, Positives, Negatives und die Rechenzeichen Plus und Minus.","refs":["CH_GB18_A_29:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:ALT-B02","text":"Strukturebene — Die tragende Struktur besteht aus Vermittlung, reflektierter Einheit, wechselseitigem Nichtsein, Ausschließung und qualitativer Negation.","refs":["CH_GB18_A_29:ALT2","CH_GB18_3DG0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:ALT-B03","text":"Metastrategische Ebene — Die Untersuchung ersetzt die Verteilung fertiger Eigenschaften durch die Rekonstruktion der Operationen, welche Entgegensetzung und Vorzeichenbestimmung hervorbringen.","refs":["CH_GB18_3DG0:ALT3","CH_GB18_A_30:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:ALT-B04","text":"Ontologisch-zeitliche Ebene — Bestimmungen sind keine statischen Eigenschaften, sondern Übergänge, in denen Identität Differenz hervorbringt, Negativität bestimmt wird und Positivität aus deren Selbstnegation entsteht.","refs":["CH_GB18_A_29:ALT4","CH_GB18_A_30:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:ALT-B05","text":"Methodologisch-performative Ebene — Die Form des Clusters vollzieht seine These, indem sie dieselben Ausdrücke über verschiedene Abstraktionsniveaus verschiebt und ihre scheinbare Gleichheit als Funktionsmutation ausweist.","refs":["CH_GB18_A_30:MRT3","CH_GB18_A_30:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_39:FL-01","text":"Die äußere Reflexion wird als bloße Verlagerung des Widerspruchs kritisiert, bleibt aber zugleich erforderlich, um die Einheit von Gleichheit und Ungleichheit sichtbar zu machen.","refs":["CH_GB18_A_29:MRT6","CH_GB18_A_29:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FL-02","text":"Jede Seite des Gegensatzes muss ihr Anderes zugleich als inneres Moment enthalten und als selbstständiges Anderes ausschließen; diese doppelte Forderung ist produktive Instabilität.","refs":["CH_GB18_3DG0:MRT5","CH_GB18_3DG0:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MP-01","text":"Der Begriff positiv oder negativ mutiert an der Schwelle zwischen äußerer Zeichenrelation und qualitativer Faktorenrelation von vertauschbarer Zuschreibung zu immanenter Bestimmung.","refs":["CH_GB18_A_30:A3","CH_GB18_A_30:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MP-02","text":"Der Ausdruck Null mutiert zwischen relationaler Aufhebung, identischer Einheit und getrennter Vielheit; die Einheit des Zeichens verdeckt den Wechsel der Abstraktionsebene.","refs":["CH_GB18_A_30:A7","CH_GB18_A_30:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_39:HSI-01","text":"Die Realität erscheint als Maschine reflexiver Differenz, in der jedes Bestimmte nur besteht, indem es sein Anderes zugleich enthält, negiert und durch diese Negation auf sich zurückkehrt.","refs":["CH_GB18_3DG0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:HSI-02","text":"Das Subjekt ist kein äußerer Beobachter der Gegensätze, sondern eine Funktion jener Reflexion, in welcher der Gegenstand seine getrennten Momente als Einheit vollzieht.","refs":["CH_GB18_A_29:SD3","CH_GB18_A_29:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:HSI-03","text":"Zeit erscheint als nichtlineare Sequenz von Übergängen, Aufhebungen und Rückkehrbewegungen, in denen ein Resultat seine vorausgesetzten Momente nicht vernichtet, sondern umcodiert.","refs":["CH_GB18_A_29:FGS7","CH_GB18_A_30:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:HSI-04","text":"Kampf oder Navigation bleibt nur als Arbeit in der Negativität möglich: Nicht die Flucht aus dem Gegensatz, sondern die Bestimmung seiner immanenten Operationen eröffnet Handlungsspielraum.","refs":["CH_GB18_A_30:SD4","CH_GB18_3DG0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_39:MRT-B01","text":"Die globalen Axiome reichen aus, um die Bewegung von unbestimmter Identität über bestimmte Verschiedenheit und Gegensatz bis zur qualitativen Negation zu rekonstruieren.","refs":["CH_GB18_A_29:MRT1","CH_GB18_A_30:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MRT-B02","text":"Unterbestimmt bleibt der genaue Übergang von austauschbaren äußeren Zuschreibungen zu notwendiger ausschließender Selbstbestimmung, weil die Vermittlung dieses Umschlags nicht vollständig expliziert wird.","refs":["CH_GB18_3DG0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MRT-B03","text":"Die Rekonstruktion bleibt kohärent, sofern wechselnde Abstraktionsebenen nicht vermischt und äußerliche Zeichenrelation, reflektierte Einheit und qualitative Negation streng unterschieden werden.","refs":["CH_GB18_A_30:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MRT-B04","text":"Die Architektur ist dort am stärksten, wo sie Widerspruch nicht beseitigt, sondern als Übergangskraft von Identität, Vermittlung, Ausschließung und Positivität formalisiert.","refs":["CH_GB18_A_29:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122311819902Z_02414a0a","language_code":"en","language_name":"English","title":"Chapters 115–117","source_sha256":"fbc42f8f4e7528fc12caf37a7de21b30b697e10df20affebc90e001bb7f98f4c","sha256":"d1c0c36bb0918967b4ed7ccfc2c698bf47794e4a170113df7d4e5a82db21deb9","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:23:11.820918+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_39:AS-01","text":"The cluster reconstructs why identity, difference, and opposition cannot subsist as isolated predicates, but only as determinations that mediate themselves.","refs":["CH_GB18_A_29:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-02","text":"Its fundamental thesis is that determinate difference does not arise from numerical multiplicity, but from negation operative within identity.","refs":["CH_GB18_A_29:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-03","text":"The argument proceeds reconstructively: it allows immediate propositions to fail under the demands of mediation that generate their own determinations.","refs":["CH_GB18_A_29:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-04","text":"The movement leads from indeterminate identity through determinate difference and inequality to an opposition whose sides possess their respective determinacy in the other.","refs":["CH_GB18_A_29:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-05","text":"The demand for mediation becomes a structural law: what is connected in a proposition as distinct determination cannot subsist without an immanent transition.","refs":["CH_GB18_A_29:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-06","text":"The displacement of contradiction into an external respect or reflection produces no solution, but reproduces the unity of the separated moments at a higher level.","refs":["CH_GB18_A_29:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-07","text":"Opposition completes this movement insofar as each side subsists only through the non-being of the other and is thereby at once self-relation, exclusion, and mediation.","refs":["CH_GB18_3DG0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AS-08","text":"The arithmetic treatment of plus and minus functions as an operative test: it makes visible that opposition is determined externally, relationally, or qualitatively according to the operation.","refs":["CH_GB18_A_30:AS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_39:GA-01","text":"[Persistent] Determinacy arises only insofar as identity takes negation into itself; a merely self-identical substrate remains indeterminate and interchangeable.","refs":["CH_GB18_A_29:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-02","text":"[Mutating] Difference mutates from numerical multiplicity into determinate inequality and thereby becomes an inner relation of its moments.","refs":["CH_GB18_A_29:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-03","text":"[Emergent] Equality and inequality are not separable properties, but simultaneously operative moments of the same determinate difference.","refs":["CH_GB18_A_29:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-04","text":"[Persistent] Each side of opposition is only insofar as its non-being, and thus the other moment, is operative as a constitutive condition of its subsistence.","refs":["CH_GB18_3DG0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-05","text":"[Mutating] Positivity and negativity are initially interchangeable posited attributions and become excluding self-determination only through the retraction of the relation into each side.","refs":["CH_GB18_3DG0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-06","text":"[Emergent] The sign has no operation-independent meaning; its determinacy depends on whether the relation is organized externally and additively or qualitatively and factorally.","refs":["CH_GB18_A_30:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-07","text":"[Attractor] Being-in-itself is not an escape from relation, but relation itself insofar as it constitutes the determination of one side as excluding self-relation.","refs":["CH_GB18_3DG0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-08","text":"[Terminal] Negation becomes effective solely through the negative; positivity appears as the result of the negation of negation, not as an original ground.","refs":["CH_GB18_A_30:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GA-09","text":"[Attractor] Essence, independence, and determination coincide with the excluding relation to the other; relationless substance is not a permissible endpoint.","refs":["CH_GB18_3DG0:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_39:RMD-01","text":"Numerical multiplicity recurs as a necessary beginning, but loses its claim to determinacy and is absorbed into mediated inequality.","refs":["CH_GB18_A_29:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RMD-02","text":"Equality and inequality recur in opposition as positive and negative, but no longer as externally comparable sides, rather as inner forms of self-relation and non-being.","refs":["CH_GB18_3DG0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RMD-03","text":"External reflection mutates from the instance that separates equality and inequality according to respects into an enactment of their unity itself produced by the object.","refs":["CH_GB18_A_29:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RMD-04","text":"The interchangeability of positive and negative is not a stable identity of the sides, but a transitional stage of mere positedness.","refs":["CH_GB18_3DG0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RMD-05","text":"Zero mutates from the apparent annihilation of opposed magnitudes into an abstracted form of sublated relation, enduring unity, or persisting multiplicity.","refs":["CH_GB18_A_30:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RMD-06","text":"The negative shifts from the external counter-sign to the privileged bearer of determining negation and thus to the motor of the reversal into positivity.","refs":["CH_GB18_A_30:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_39:CGD-01","text":"At the lower level, the demand for a mediating third remains a logical demand of proof; at the cluster level, it becomes the insight that determinations generate their unity only through immanent negation.","refs":["CH_GB18_A_29:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:CGD-02","text":"The separation through the “insofar as” is locally a technique of external reflection; at the current level, it generally shows that perspectival separation can only displace contradiction.","refs":["CH_GB18_A_29:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:CGD-03","text":"The different results of the same arithmetic formula remain local results of abstraction; their scalable yield consists in distinguishing sublation, unity, and multiplicity as simultaneous registers of a relation.","refs":["CH_GB18_A_30:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:CGD-04","text":"The determination of each side as bearer of its other scales beyond the individual opposition and organizes the entire architecture of difference, opposition, and qualitative negation.","refs":["CH_GB18_3DG0:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:CGD-05","text":"The concrete rule of signs remains a local case; its higher-order content is the asymmetrical thesis that only negativity can produce determination as negation.","refs":["CH_GB18_A_30:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_39:GNX-01","text":"Excluded is a difference that, as mere numerical plurality without inequality and without reflected relation, would already be fully determined.","refs":["CH_GB18_A_29:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GNX-02","text":"Excluded is a side of opposition that could subsist immediately for itself and leave its non-being outside its own determination.","refs":["CH_GB18_3DG0:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GNX-03","text":"Excluded is a third instance of comparison that could definitively distribute positive and negative without itself entering into the relation of the sides.","refs":["CH_GB18_A_30:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:GNX-04","text":"Excluded is a concept of zero that would utterly annihilate the sublated relation, the identical ground, and persisting multiplicity.","refs":["CH_GB18_A_30:NX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_39:DBN-01","text":"The cluster rejects a model of static identities according to which a self-identical substrate could already be a determinate thing prior to every inner negation.","refs":["CH_GB18_A_29:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:DBN-02","text":"It rejects a logic of contradiction-avoidance that separates equality and inequality through different respects and mistakes this distribution for their sublation.","refs":["CH_GB18_A_29:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:DBN-03","text":"It rejects a purely formal calculus that derives rules from symbols without reconstructing the qualitative determination of the respective operation.","refs":["CH_GB18_A_30:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:DBN-04","text":"It rejects a complete symmetry of positive and negative once negativity appears as immanent opposition and determining force.","refs":["CH_GB18_A_30:DNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_39:BSA-01","text":"Unavailable is an origin of positivity or negativity prior to their reciprocal mediation; both arise only from an already operative relation.","refs":["CH_GB18_3DG0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSA-02","text":"Inaccessible is a positivity that could generate negation from itself; positivity remains result and not source of determining difference.","refs":["CH_GB18_A_30:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSA-03","text":"Unavailable is a neutral final standpoint at which zero, identity, or external comparability would definitively suspend every persisting mediation.","refs":["CH_GB18_A_30:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_39:XD-01","text":"The initially abstract demand for mediation becomes concrete in opposition: distinct determinations can subsist together only if each side contains the non-being of the other as a condition of its own being.","refs":["CL_GB18_39:GA-01","CL_GB18_39:GA-04","CH_GB18_A_29:AS5","CH_GB18_3DG0:AS4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_39:XD-02","text":"The critique of external reflection receives an operational form through the analysis of signs: a third reference point can distribute signs, but cannot ground immanent positivity or negativity.","refs":["CL_GB18_39:GA-05","CL_GB18_39:GA-06","CH_GB18_A_29:A12","CH_GB18_A_30:A4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_39:XD-03","text":"The interchangeability of positive and negative applies only to externally posited opposition; it collapses as soon as the relation itself becomes qualitative and negativity functions as immanent opposition.","refs":["CL_GB18_39:GA-05","CL_GB18_39:GA-06","CH_GB18_3DG0:A8","CH_GB18_A_30:A9"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_39:XD-04","text":"The sublation of opposed magnitudes reproduces the general structure of reflected difference: the other is negated without thereby disappearing as the condition of unity and multiplicity.","refs":["CL_GB18_39:GA-03","CL_GB18_39:GA-04","CH_GB18_3DG0:AS3","CH_GB18_A_30:A5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_39:XD-05","text":"The distinction between external and in-itself opposition transforms the rule of signs from a convention of attribution into a theory of determining negation.","refs":["CL_GB18_39:GA-06","CL_GB18_39:GA-08","CH_GB18_A_30:A1","CH_GB18_A_30:A10"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_39:XD-06","text":"Positivity cannot count as the starting side of opposition, because its determinate shape arises only where negativity negates itself and thereby reverses its excluding function.","refs":["CL_GB18_39:GA-05","CL_GB18_39:GA-08","CH_GB18_3DG0:A4","CH_GB18_A_30:A11"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_39:BSD-01","text":"Reality appears as a network of determinations whose identity does not lie prior to their relations, but arises from the inclusion and exclusion of their other.","refs":["CH_GB18_A_29:A7","CH_GB18_3DG0:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSD-02","text":"Cognition cannot treat predicates as fixed properties, but must determine the operation through which one side becomes positive, negative, equal, unequal, or sublated.","refs":["CH_GB18_A_30:AS1","CH_GB18_A_30:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSD-03","text":"Sublation is not a model of loss, but a multilayered transformation in which relational annulment, enduring identity, and separate existence can simultaneously remain possible.","refs":["CH_GB18_A_30:A5","CH_GB18_A_30:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSD-04","text":"Reflection is neither an external observer nor a sovereign arbiter, but the activity in which the object reproduces its separated moments as unity.","refs":["CH_GB18_A_29:A11","CH_GB18_3DG0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:BSD-05","text":"Within the architecture, negativity has an asymmetrical generative role: it introduces determination, bears exclusion, and through its self-negation generates the form of positivity.","refs":["CH_GB18_A_30:SD4","CH_GB18_3DG0:A6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_39:RLE-01","text":"Identity produces indeterminacy; determination introduces negation; negation produces difference; difference becomes contradictory as the unity of equality and inequality and presses toward opposition.","refs":["CH_GB18_A_29:A1","CH_GB18_A_29:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RLE-02","text":"Opposition forms a recursive loop because each side contains its other as non-being, excludes it, and returns to itself precisely through this exclusion.","refs":["CH_GB18_3DG0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RLE-03","text":"The attribution of positive or negative undergoes an escalation from external interchangeability to inner necessity as soon as the relation is no longer posited outside, but within each side.","refs":["CH_GB18_3DG0:A8","CH_GB18_3DG0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RLE-04","text":"Calculation with opposed magnitudes forms a loop of sublation, unity, and multiplicity: the result zero does not terminate the relation, but compels a distinction among its levels of abstraction.","refs":["CH_GB18_A_30:A5","CH_GB18_A_30:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:RLE-05","text":"The negation of negation forms a terminal attractor that generates positivity without erasing the conditions of its emergence from negative mediation.","refs":["CH_GB18_A_30:A10","CH_GB18_A_30:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_39:FGS-B01","text":"Identity → indeterminacy → need for determination → negation as inner difference.","refs":["CH_GB18_A_29:A1","CH_GB18_A_29:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FGS-B02","text":"Numerical multiplicity → indeterminate difference; determinate difference → inequality → unity of equality and inequality.","refs":["CH_GB18_A_29:A3","CH_GB18_A_29:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FGS-B03","text":"Equality and inequality → reflected determinations of being and non-being → positive and negative.","refs":["CH_GB18_3DG0:AS2","CH_GB18_3DG0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FGS-B04","text":"Positive and negative → reciprocal non-being → retraction of the relation → excluding self-relation → being-in-itself.","refs":["CH_GB18_3DG0:A7","CH_GB18_3DG0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FGS-B05","text":"External relation of signs → interchangeability of attribution; qualitative operation → immanent negativity and asymmetrical determination.","refs":["CH_GB18_A_30:A3","CH_GB18_A_30:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FGS-B06","text":"Immanent negation → negation of negation → positivity that persists as the result of negative mediation.","refs":["CH_GB18_A_30:A10","CH_GB18_A_30:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_39:AFM-B01","text":"Indeterminate identity → interchangeability of the merely self-identical substrate.","refs":["CH_GB18_A_29:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B02","text":"Numerical multiplicity → rejection of its equation with determinate difference.","refs":["CH_GB18_A_29:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B03","text":"Determinate difference → inequality → unity of equality and inequality.","refs":["CH_GB18_A_29:A4","CH_GB18_A_29:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B04","text":"Unity of the distinct moments → opposition → reciprocal mediation through non-being.","refs":["CH_GB18_3DG0:AS1","CH_GB18_3DG0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B05","text":"Reciprocal mediation → externally interchangeable signs → retraction of the relation into each side.","refs":["CH_GB18_3DG0:A8","CH_GB18_3DG0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B06","text":"External opposition of signs → separation of the operations → qualitative asymmetry of the negative.","refs":["CH_GB18_A_30:FGS1","CH_GB18_A_30:AF4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:AFM-B07","text":"Determining negation → negation of itself → positivity as mediated closure.","refs":["CH_GB18_A_30:AF5","CH_GB18_A_30:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_39:MME-01","text":"The opposition of equality and inequality collapses as an exclusive alternative and is mapped as a co-constitutive form of determinate difference.","refs":["CH_GB18_A_29:ME2","CH_GB18_A_29:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MME-02","text":"Positive and negative are reclassified from predicates of value or fact into modes of reflexive self-determination.","refs":["CH_GB18_3DG0:ME2","CH_GB18_3DG0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MME-03","text":"Independence and dependence become legible as mutually transitioning functions of the same mediation, not as separate states.","refs":["CH_GB18_3DG0:SD2","CH_GB18_3DG0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MME-04","text":"Zero changes from the cipher of absolute annihilation into the map of three distinguishable registers: sublated relation, enduring unity, and real multiplicity.","refs":["CH_GB18_A_30:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MME-05","text":"Arithmetic rules become intelligible only as a consequence of a theory of negation; symbolism is subordinated to the concept of operation.","refs":["CH_GB18_A_30:ME4","CH_GB18_A_30:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_39:ALT-B01","text":"Surface level — The cluster treats identity, difference, equality, inequality, positive, negative, and the arithmetic signs plus and minus.","refs":["CH_GB18_A_29:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:ALT-B02","text":"Structural level — The supporting structure consists of mediation, reflected unity, reciprocal non-being, exclusion, and qualitative negation.","refs":["CH_GB18_A_29:ALT2","CH_GB18_3DG0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:ALT-B03","text":"Meta-strategic level — The inquiry replaces the distribution of finished properties with the reconstruction of the operations that generate opposition and the determination of signs.","refs":["CH_GB18_3DG0:ALT3","CH_GB18_A_30:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:ALT-B04","text":"Ontological-temporal level — Determinations are not static properties, but transitions in which identity generates difference, negativity is determined, and positivity arises from its self-negation.","refs":["CH_GB18_A_29:ALT4","CH_GB18_A_30:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:ALT-B05","text":"Methodological-performative level — The form of the cluster enacts its thesis by shifting the same expressions across different levels of abstraction and identifying their apparent equality as functional mutation.","refs":["CH_GB18_A_30:MRT3","CH_GB18_A_30:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_39:FL-01","text":"External reflection is criticized as a mere displacement of contradiction, yet at the same time remains necessary in order to make visible the unity of equality and inequality.","refs":["CH_GB18_A_29:MRT6","CH_GB18_A_29:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:FL-02","text":"Each side of opposition must at once contain its other as an inner moment and exclude it as an independent other; this double demand is productive instability.","refs":["CH_GB18_3DG0:MRT5","CH_GB18_3DG0:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MP-01","text":"The concept positive or negative mutates at the threshold between external relation of signs and qualitative relation of factors from interchangeable attribution to immanent determination.","refs":["CH_GB18_A_30:A3","CH_GB18_A_30:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MP-02","text":"The expression zero mutates between relational sublation, identical unity, and separate multiplicity; the unity of the sign conceals the change of level of abstraction.","refs":["CH_GB18_A_30:A7","CH_GB18_A_30:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_39:HSI-01","text":"Reality appears as a machine of reflexive difference, in which every determinate entity subsists only by at once containing its other, negating it, and returning to itself through this negation.","refs":["CH_GB18_3DG0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:HSI-02","text":"The subject is not an external observer of oppositions, but a function of that reflection in which the object enacts its separated moments as unity.","refs":["CH_GB18_A_29:SD3","CH_GB18_A_29:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:HSI-03","text":"Time appears as a nonlinear sequence of transitions, sublations, and movements of return, in which a result does not annihilate its presupposed moments, but recodes them.","refs":["CH_GB18_A_29:FGS7","CH_GB18_A_30:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:HSI-04","text":"Struggle or navigation remains possible only as work in negativity: not escape from opposition, but the determination of its immanent operations opens a space for action.","refs":["CH_GB18_A_30:SD4","CH_GB18_3DG0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_39:MRT-B01","text":"The global axioms suffice to reconstruct the movement from indeterminate identity through determinate difference and opposition to qualitative negation.","refs":["CH_GB18_A_29:MRT1","CH_GB18_A_30:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MRT-B02","text":"The exact transition from interchangeable external attributions to necessary excluding self-determination remains underdetermined, because the mediation of this reversal is not fully explicated.","refs":["CH_GB18_3DG0:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MRT-B03","text":"The reconstruction remains coherent provided that changing levels of abstraction are not conflated and external relation of signs, reflected unity, and qualitative negation are strictly distinguished.","refs":["CH_GB18_A_30:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_39:MRT-B04","text":"The architecture is strongest where it does not eliminate contradiction, but formalizes it as the force of transition of identity, mediation, exclusion, and positivity.","refs":["CH_GB18_A_29:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_39@R001","source_variant_id":"canonical:CL_GB18_39:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 115–117","context":"Anmerkung. · 3. Der Gegensatz. · Anmerkung."},"title_language_code":"en"},{"id":"CL_GB18_40","layer":"CL","title":"Chapters 118–120","order":40,"parents":["CH_GB18_CDW0","CH_GB18_A_31","CH_GB18_A_32"],"revision":"CL_GB18_40@R001","sha256":"2b4023ac23f3a5122ee55539fb174b1dee44e1d78f60080ea14869cefbd8735c","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_40:AS-01","text":"Das Cluster bestimmt das Problem als Unmöglichkeit, Positivität und Negativität, Opposition und logische Alternative noch als äußerlich bestehende Relata zu behandeln.","refs":["CH_GB18_A_31:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-02","text":"Die äußere Vergleichung wird durch Eigenreflexion ersetzt, damit jede Bestimmung nur noch über ihre immanente Beziehung auf ihr Anderes verständlich ist.","refs":["CH_GB18_A_31:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-03","text":"Selbstständigkeit wird als widersprüchliche Operation sichtbar: Sie enthält das Andere als Bedingung und versucht es zugleich auszuschließen.","refs":["CH_GB18_CDW0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-04","text":"Die Umkehrung von Positivem und Negativem ist keine Verwirrung des urteilenden Bewusstseins, sondern die notwendige Bewegungsform ihrer Begriffsstruktur.","refs":["CH_GB18_A_31:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-05","text":"Die formale Ausschlusslogik wiederholt die immanente Instabilität der Opposition, weil sie im Vollzug des Ausschlusses ein gemeinsames Bezugselement voraussetzt.","refs":["CH_GB18_A_32:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-06","text":"Widerspruch führt nicht in eine bloße Nullität, sondern erzeugt durch die Aufhebung des Gesetztseins eine positive Reflexionseinheit.","refs":["CH_GB18_CDW0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-07","text":"Die Bewegung ist rekursiv und kumulativ: Unterschied wird Opposition, Opposition wird Selbstwiderspruch, Ausschluss wird Setzung, und Setzung kehrt als Grund in sich zurück.","refs":["CH_GB18_CDW0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-08","text":"Die Schließung besteht nicht in stillgestellter Identität, sondern im Grund als Einheit, welche Negativität als ihre innere Bestimmungsform bewahrt.","refs":["CH_GB18_CDW0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_40:GA-01","text":"[Persistent] Opposition besteht nur als wechselseitige Bestimmtheit; kein Pol besitzt einen Sinn, der seiner Beziehung auf das Andere vorausliegt.","refs":["CH_GB18_CDW0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-02","text":"[Persistent] Jede ausschließende Bestimmung setzt gerade das Andere, dessen Ausschluss ihre Selbstständigkeit sichern soll.","refs":["CH_GB18_CDW0:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-03","text":"[Mutating] Positivität und Negativität sind keine festen Wert- oder Seinsklassen, sondern wechselnde Funktionen gegenseitiger begrifflicher Umkehrung.","refs":["CH_GB18_A_31:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-04","text":"[Emergent] Widerspruch ist keine Störung einer vorausliegenden Einheit, sondern der operative Mechanismus ihrer Hervorbringung.","refs":["CH_GB18_CDW0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-05","text":"[Persistent] Negation ist nicht bloße Abwesenheit, sondern selbstbezügliche Bestimmtheit, die eine positive Struktur des Bezogenseins trägt.","refs":["CH_GB18_CDW0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-06","text":"[Mutating] Formale Ausschlussregeln können Opposition nicht begründen, weil ihr Ausschluss ein Etwas voraussetzt, in dem beide Seiten bereits bezogen sind.","refs":["CH_GB18_A_32:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-07","text":"[Attractor] Der Grund ist keine externe Basis, sondern die immanente Reflexionseinheit, in welcher Opposition als gesetzte Negativität erhalten wird.","refs":["CH_GB18_CDW0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-08","text":"[Terminal] Aufhebung vernichtet Negativität nicht, sondern überführt sie als erhaltene innere Bestimmung in positive Einheit.","refs":["CH_GB18_CDW0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-09","text":"[Attractor] Wahrheit ist nur als negative Durchdringung möglich, in der Wissen nicht außerhalb seines Gegenstandes verbleibt, sondern dessen Opposition vollzieht und aufhebt.","refs":["CH_GB18_A_31:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_40:RMD-01","text":"Positivität und Negativität kehren nicht als stabile Gegenstände wieder, sondern mutieren von festen Gegenbestimmungen zu Vollzügen des Setzens, Ausschließens und Selbstaufhebens.","refs":["CH_GB18_CDW0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RMD-02","text":"Die Valenzen der Seiten kehren sich funktional um: Das Positive enthält absolute Negation, während das Negative durch Selbstidentität positive Bestimmtheit annimmt.","refs":["CH_GB18_A_31:D3","CH_GB18_A_31:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RMD-03","text":"Die zunächst als Verwirrung erscheinende Umkehrung wird in eine objektive Anzeige begrifflicher Notwendigkeit verschoben.","refs":["CH_GB18_A_31:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RMD-04","text":"Das ausgeschlossene Dritte mutiert vom vermeintlich zusätzlichen Term zur inneren Einheit, welche die Opposition überhaupt erst als Opposition trägt.","refs":["CH_GB18_A_32:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RMD-05","text":"Gleichgültigkeit verliert ihren Status als Außenbereich und wird als noch unentwickelte, aber bereits relationsfähige Bestimmung absorbiert.","refs":["CH_GB18_A_31:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_40:CGD-01","text":"Die konkreten Übertragungen auf Licht und Finsternis, Tugend und Laster sowie Wahrheit und Irrtum bleiben lokale Demonstrationen des allgemeinen Umkehrungsmechanismus.","refs":["CH_GB18_A_31:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:CGD-02","text":"Die Analyse des Prädikats und seines Nichtseins bleibt eine lokale kritische Oberfläche, auf der die Unzulänglichkeit formaler Negation sichtbar wird.","refs":["CH_GB18_A_32:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:CGD-03","text":"Auf Clusterebene wird Opposition als übergreifende Erzeugungsstruktur sichtbar, welche ontologische Bestimmung, Erkenntnisbewegung und formale Logik zugleich organisiert.","refs":["CH_GB18_A_31:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:CGD-04","text":"Die lokale Operation des Ausschließens skaliert zur globalen Regel: Jede Alternative erzeugt das gemeinsame Bezugselement, das ihre äußere Selbstständigkeit unterläuft.","refs":["CH_GB18_A_32:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_40:GNX-01","text":"Das Cluster schließt eine Bestimmung von Positivem und Negativem durch äußere Vergleichung aus.","refs":["CH_GB18_A_31:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GNX-02","text":"Es schließt eine Negation aus, die nur Abwesenheit, Mangel oder Nichtvorhandenheit wäre.","refs":["CH_GB18_A_31:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GNX-03","text":"Es schließt die Reduktion von Entgegensetzung auf eine zweiwertige Zuordnung äußerer Prädikate aus.","refs":["CH_GB18_A_32:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GNX-04","text":"Es schließt einen Grund aus, der dem Gegensatz als fertiges Substrat äußerlich vorausläge.","refs":["CH_GB18_CDW0:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GNX-05","text":"Es schließt eine Auflösung aus, die in endgültige Nullität fällt und keine bestimmte Einheit zurücklässt.","refs":["CH_GB18_CDW0:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_40:DBN-01","text":"Unzulässig ist ein Modell, in dem vollständig selbstständige Bestimmungen erst nachträglich miteinander in Beziehung treten.","refs":["CH_GB18_CDW0:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:DBN-02","text":"Unzulässig ist ein Erkenntnismodell, in dem Wissen den Gegenstand äußerlich betrachtet, ohne seine eigene negative Beziehung auf ihn zu vollziehen.","refs":["CH_GB18_A_31:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:DBN-03","text":"Unzulässig ist die Annahme, dass eine formale Alternative ihre eigene Reflexionsgrundlage vollständig ausschließen könne.","refs":["CH_GB18_A_32:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:DBN-04","text":"Unzulässig ist die Verfügbarkeit eines absolut ersten Positiven, das nicht schon durch Negation und Beziehung vermittelt wäre.","refs":["CH_GB18_CDW0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_40:BSA-01","text":"Nicht verfügbar ist reine Positivität als voraussetzungslose Selbstidentität ohne innere Negativität.","refs":["CH_GB18_CDW0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSA-02","text":"Nicht verfügbar ist ein wirklich indifferentes Drittes, das von der Opposition unberührt bliebe und dennoch ihren Träger bilden könnte.","refs":["CH_GB18_A_32:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSA-03","text":"Nicht verfügbar ist Wahrheit als unmittelbare Identität, die negative Vermittlung und Aufhebung überspringen könnte.","refs":["CH_GB18_A_31:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSA-04","text":"Nicht verfügbar ist ein endgültiger Zustand reiner Ruhe, weil die Einheit ihre Negativität nicht abwerfen kann.","refs":["CH_GB18_CDW0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_40:XD-01","text":"Die Umkehrung der Gegensätze ist keine semantische Mehrdeutigkeit, sondern die notwendige Folge jeder Bestimmung, die ihr Anderes zugleich ausschließen und in sich voraussetzen muss.","refs":["CL_GB18_40:GA-02","CL_GB18_40:GA-03","CH_GB18_A_31:A7","CH_GB18_CDW0:NX5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_40:XD-02","text":"Der Satz des ausgeschlossenen Dritten vollzieht dieselbe Selbstunterlaufung wie jede Ausschließung: Indem er ein Drittes ausschließt, erzeugt er die gemeinsame Bezugseinheit, die seine Alternative trägt.","refs":["CL_GB18_40:GA-02","CL_GB18_40:GA-06","CH_GB18_A_32:A7","CH_GB18_CDW0:MRT4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_40:XD-03","text":"Weder philosophische Erkenntnis noch logische Bestimmung können Gegensätze durch Fixierung ihrer Namen stabilisieren; sie müssen die Bewegung ihrer gegenseitigen Erzeugung erfassen.","refs":["CL_GB18_40:GA-03","CL_GB18_40:GA-09","CH_GB18_A_31:SD5","CH_GB18_A_32:D2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_40:XD-04","text":"Der Grund fungiert zugleich als ontologische Wahrheit des aufgehobenen Gegensatzes und als logische Einheit der Reflexion; er ist daher kein Resultat neben der Opposition, sondern deren immanente Requalifikation.","refs":["CL_GB18_40:GA-07","CL_GB18_40:GA-08","CH_GB18_CDW0:D7","CH_GB18_A_32:D7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_40:XD-05","text":"Die Unmöglichkeit eines äußeren Erkenntnisstandpunkts folgt aus derselben Struktur, die einen unabhängigen positiven oder negativen Pol ausschließt: Wissen gehört zur negativen Vermittlung des Gegenstandes selbst.","refs":["CL_GB18_40:GA-05","CL_GB18_40:GA-09","CH_GB18_A_31:D7","CH_GB18_A_31:SNX3"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_40:BSD-01","text":"Realität erscheint als Prozess selbstnegativer Bestimmtheit: Jede beanspruchte reine Identität erzeugt die Vermittlung, die sie nicht kontrollieren kann.","refs":["CH_GB18_CDW0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSD-02","text":"Formale logische Gesetze werden von neutralen Ausschlussinstrumenten zu Symptomen ihrer eigenen verdeckten Reflexionsgrundlage umklassifiziert.","refs":["CH_GB18_A_32:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSD-03","text":"Der Grund wird als rückwirkende Wahrheit bestimmt: Er entsteht aus der Aufhebung und klassifiziert dadurch den anfänglich selbstständigen Gegensatz nachträglich als gesetzte Negativität.","refs":["CH_GB18_CDW0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSD-04","text":"Wahrheit wird zu einer Praxis negativer Durchdringung, nicht zu einer positiven Korrespondenz zwischen äußerem Wissen und äußerem Gegenstand.","refs":["CH_GB18_A_31:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSD-05","text":"Die Zeitstruktur des Clusters ist rekursiv: Was als Anfang erscheint, wird erst durch den erreichten Grund als abhängiges Moment seiner eigenen Wahrheit lesbar.","refs":["CH_GB18_CDW0:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_40:RLE-01","text":"Selbstständigkeit erzeugt durch Einschluss und Ausschluss des Anderen Selbstwiderspruch; der Widerspruch hebt das Gesetztsein auf und kehrt als Grund in sich zurück.","refs":["CH_GB18_CDW0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RLE-02","text":"Äußere Gegenüberstellung erzeugt Verwirrung, die durch Eigenreflexion in notwendige Umkehrung übergeht und damit die äußere Gegenüberstellung rückwirkend delegitimiert.","refs":["CH_GB18_A_31:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RLE-03","text":"Der Ausschluss eines Dritten setzt ein gemeinsames Etwas; dieses Etwas verwandelt sich aus einem verdeckten Träger der Alternative in die Reflexionseinheit ihrer aufgehobenen Seiten.","refs":["CH_GB18_A_32:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RLE-04","text":"Der Grund wirkt als Attraktor, weil jede Bewegung der Opposition auf eine Einheit zuläuft, die Opposition nicht beseitigt, sondern als identische Negativität erhält.","refs":["CH_GB18_CDW0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_40:FGS-B01","text":"Äußere Gegenüberstellung → Suspendierung äußerer Vergleichung → Eigenreflexion der Bestimmungen.","refs":["CH_GB18_A_31:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:FGS-B02","text":"Eigenreflexion → Selbstständigkeitsanspruch → Einschluss des Anderen als Bedingung der eigenen Bestimmtheit.","refs":["CH_GB18_CDW0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:FGS-B03","text":"Einschluss des Anderen → Ausschluss des Anderen → Setzung des Ausgeschlossenen und Selbstwiderspruch; dieselbe Operation erscheint formal als Ausschluss eines Dritten.","refs":["CH_GB18_A_32:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:FGS-B04","text":"Selbstwiderspruch → Aufhebung des Gesetztseins → positive Rückkehr → Grund als Einheit erhaltener Negativität.","refs":["CH_GB18_CDW0:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_40:AFM-B01","text":"Äußerlich fixierte Gegenbestimmung → Problem der Beziehung von Positivem und Negativem.","refs":["CH_GB18_A_31:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AFM-B02","text":"Problem der Beziehung → Verlagerung in Eigenreflexion → wechselseitiges Erscheinen jeder Bestimmung im Anderen.","refs":["CH_GB18_A_31:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AFM-B03","text":"Wechselseitiges Erscheinen → Setzung und Ausschluss des Anderen → Selbstwiderspruch der selbstständigen Seiten.","refs":["CH_GB18_CDW0:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AFM-B04","text":"Selbstwiderspruch → formaler Ausschluss des Dritten → Enthüllung des Etwas als notwendigem Träger der Alternative.","refs":["CH_GB18_A_32:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AFM-B05","text":"Notwendiges Etwas → Setzung und Aufhebung der Gegensätze → Einheit der Reflexion → Grund.","refs":["CH_GB18_A_32:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_40:MME-01","text":"Positives und Negatives werden von fixierten Gegenständen zu rekursiven Operationen umkartiert.","refs":["CH_GB18_CDW0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MME-02","text":"Die äußere Alternative wird als innere Reflexionsrelation kartiert, deren Pole nur durch ihre gemeinsame Einheit bestehen.","refs":["CH_GB18_A_32:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MME-03","text":"Der Grund wird vom vorausgesetzten Fundament zum Resultat und zur inneren Wahrheit der aufgehobenen Opposition reklassifiziert.","refs":["CH_GB18_CDW0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MME-04","text":"Wahrheit wird von positiver Zuschreibung zu einer aktiven negativen Bewegung der Durchdringung und Aufhebung verschoben.","refs":["CH_GB18_A_31:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_40:ALT-B01","text":"Surface level — Positives und Negatives erscheinen als selbstständige Seiten eines Gegensatzes und als Terme einer scheinbar erschöpfenden Alternative.","refs":["CH_GB18_CDW0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:ALT-B02","text":"Structural level — Bestimmungen reproduzieren ihr Anderes durch die Operation, mit der sie dessen Ausschluss vollziehen.","refs":["CH_GB18_CDW0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:ALT-B03","text":"Metastrategic level — Erkenntnis muss die Fixierung der Gegensätze aufgeben und ihre notwendige Transformation als begriffliche Arbeit vollziehen.","refs":["CH_GB18_A_31:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:ALT-B04","text":"Ontological / Temporal level — Wesen ist keine ursprüngliche ruhende Präsenz, sondern die rückkehrende Einheit, die sich nur durch aufgehobene Negativität erhält.","refs":["CH_GB18_CDW0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:ALT-B05","text":"Methodological / Performative level — Die Form des Clusters vollzieht ihre These, indem sie jede feste Bestimmung in ihre Beziehung, Umkehrung und Aufhebung überführt.","refs":["CH_GB18_A_31:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_40:FL-01","text":"Der Grund ist zugleich Ergebnis der Aufhebung und Wahrheit, von der der aufgehobene Gegensatz rückwirkend abhängig erscheint; diese Zirkularität ist konstitutiv, aber nicht restlos entfaltet.","refs":["CH_GB18_CDW0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:FL-02","text":"Das Negative oszilliert zwischen relationaler Sinnbestimmung und mit sich identischem Bestehen; die Einheit beider Bestimmungen bleibt als Spannung erhalten.","refs":["CH_GB18_A_31:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:FL-03","text":"Das Etwas soll weder als bloßes Positives noch als bloßes Negatives fixierbar sein und zugleich die Einheit beider Bestimmungen bilden; diese Doppelstellung ist produktiver Instabilitätspunkt.","refs":["CH_GB18_A_32:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MP-01","text":"Der erste Mutationspunkt liegt in der Verschiebung von äußerer Vergleichung zu innerer Reflexion: Die Relation wird von einem Urteil über Bestimmungen zu deren eigener Bewegungsform.","refs":["CH_GB18_A_31:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MP-02","text":"Der zweite Mutationspunkt liegt in der Umcodierung der Umkehrung von einem Denkfehler zu einem Indikator begrifflicher Notwendigkeit.","refs":["CH_GB18_A_31:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MP-03","text":"Der dritte Mutationspunkt liegt in der Umwandlung des ausgeschlossenen Dritten vom vermeintlich zusätzlichen Term zur Einheit der bezogenen Gegensätze.","refs":["CH_GB18_A_32:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_40:HSI-01","text":"Die Realität erscheint als Reflexionsmaschine, in der jede Bestimmung durch den Versuch, ihr Anderes auszuschließen, dieses Andere reproduziert und sich selbst verändert.","refs":["CH_GB18_CDW0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:HSI-02","text":"Das Subjekt ist kein äußerer Richter über Gegensätze, sondern eine negative Erkenntnisbewegung, die sich nur durch das Durchdringen und Aufheben ihres Anderen bestimmt.","refs":["CH_GB18_A_31:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:HSI-03","text":"Zeit erscheint als rückläufige Rekonstruktion: Der Grund verwandelt den anfänglichen Gegensatz nachträglich in ein Moment seiner eigenen gesetzten Negativität.","refs":["CH_GB18_CDW0:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:HSI-04","text":"Mögliche Navigation besteht nicht in der Wahl eines Pols, sondern im Festhalten der Bewegung, durch welche jeder Pol sein Anderes enthält, setzt und in sich zurücknimmt.","refs":["CH_GB18_A_31:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_40:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von Gegensatz über Widerspruch und formalen Ausschluss zur Reflexionseinheit des Grundes zu rekonstruieren.","refs":["CH_GB18_CDW0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MRT-B02","text":"Die Architektur ist kohärent, sofern Selbstbeziehung nicht als unmittelbare Identität, sondern als negative Vermittlung verstanden wird.","refs":["CH_GB18_CDW0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MRT-B03","text":"Unterbestimmt bleiben der Status des anfänglichen Selbstständigkeitsanspruchs und die genaue systematische Stellung der Einheit der Reflexion innerhalb der weiteren Logik.","refs":["CH_GB18_CDW0:MRT2","CH_GB18_A_32:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MRT-B04","text":"Die stärkste und unverzichtbare Operation liegt in der Ableitung, dass Ausschluss die Setzung des Ausgeschlossenen vollzieht; die Rekonstruktion darf diese Operation weder in äußere Relation noch in bloße Nullität zurückübersetzen.","refs":["CH_GB18_CDW0:MRT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122338195017Z_cbe9ba5a","language_code":"en","language_name":"English","title":"Chapters 118–120","source_sha256":"2b4023ac23f3a5122ee55539fb174b1dee44e1d78f60080ea14869cefbd8735c","sha256":"a96af9be2051887a5bc79ae7376139b5202d80d00e8c00e773854c28c884970a","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:23:38.195984+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_40:AS-01","text":"The cluster identifies the problem as the impossibility of still treating positivity and negativity, opposition and logical alternative, as externally existing relata.","refs":["CH_GB18_A_31:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-02","text":"External comparison is replaced by self-reflection, so that each determination is intelligible only through its immanent relation to its other.","refs":["CH_GB18_A_31:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-03","text":"Self-subsistence becomes visible as a contradictory operation: it contains the other as condition and at the same time attempts to exclude it.","refs":["CH_GB18_CDW0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-04","text":"The reversal of positive and negative is not a confusion of judging consciousness, but the necessary form of movement of their conceptual structure.","refs":["CH_GB18_A_31:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-05","text":"The formal logic of exclusion repeats the immanent instability of opposition, because in carrying out exclusion it presupposes a common element of reference.","refs":["CH_GB18_A_32:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-06","text":"Contradiction does not lead into mere nullity, but produces, through the sublation of positedness, a positive unity of reflection.","refs":["CH_GB18_CDW0:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-07","text":"The movement is recursive and cumulative: difference becomes opposition, opposition becomes self-contradiction, exclusion becomes positing, and positing returns into itself as ground.","refs":["CH_GB18_CDW0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AS-08","text":"The closure does not consist in immobilized identity, but in ground as the unity that preserves negativity as its inner form of determination.","refs":["CH_GB18_CDW0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_40:GA-01","text":"[Persistent] Opposition exists only as reciprocal determinacy; neither pole possesses a sense that precedes its relation to the other.","refs":["CH_GB18_CDW0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-02","text":"[Persistent] Every excluding determination posits precisely the other whose exclusion is supposed to secure its self-subsistence.","refs":["CH_GB18_CDW0:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-03","text":"[Mutating] Positivity and negativity are not fixed classes of value or being, but changing functions of reciprocal conceptual reversal.","refs":["CH_GB18_A_31:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-04","text":"[Emergent] Contradiction is not a disturbance of a preceding unity, but the operative mechanism of its production.","refs":["CH_GB18_CDW0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-05","text":"[Persistent] Negation is not mere absence, but self-relating determinacy that bears a positive structure of relatedness.","refs":["CH_GB18_CDW0:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-06","text":"[Mutating] Formal rules of exclusion cannot ground opposition, because their exclusion presupposes a something in which both sides are already related.","refs":["CH_GB18_A_32:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-07","text":"[Attractor] Ground is not an external basis, but the immanent unity of reflection in which opposition is preserved as posited negativity.","refs":["CH_GB18_CDW0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-08","text":"[Terminal] Sublation does not destroy negativity, but transfers it, as preserved inner determination, into positive unity.","refs":["CH_GB18_CDW0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GA-09","text":"[Attractor] Truth is possible only as negative penetration, in which knowledge does not remain outside its object, but carries out and sublates its opposition.","refs":["CH_GB18_A_31:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_40:RMD-01","text":"Positivity and negativity recur not as stable objects, but mutate from fixed counter-determinations into acts of positing, excluding, and self-sublation.","refs":["CH_GB18_CDW0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RMD-02","text":"The valences of the sides reverse functionally: the positive contains absolute negation, while the negative assumes positive determinacy through self-identity.","refs":["CH_GB18_A_31:D3","CH_GB18_A_31:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RMD-03","text":"The reversal that initially appears as confusion is displaced into an objective indication of conceptual necessity.","refs":["CH_GB18_A_31:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RMD-04","text":"The excluded third mutates from the supposedly additional term into the inner unity that first bears opposition as opposition.","refs":["CH_GB18_A_32:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RMD-05","text":"Indifference loses its status as an external domain and is absorbed as a determination that is as yet undeveloped but already capable of relation.","refs":["CH_GB18_A_31:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_40:CGD-01","text":"The concrete applications to light and darkness, virtue and vice, as well as truth and error, remain local demonstrations of the general mechanism of reversal.","refs":["CH_GB18_A_31:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:CGD-02","text":"The analysis of the predicate and its non-being remains a local critical surface on which the inadequacy of formal negation becomes visible.","refs":["CH_GB18_A_32:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:CGD-03","text":"At the cluster level, opposition becomes visible as an overarching generative structure that simultaneously organizes ontological determination, the movement of cognition, and formal logic.","refs":["CH_GB18_A_31:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:CGD-04","text":"The local operation of excluding scales into the global rule: every alternative produces the common element of reference that undermines its external self-subsistence.","refs":["CH_GB18_A_32:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_40:GNX-01","text":"The cluster excludes a determination of positive and negative through external comparison.","refs":["CH_GB18_A_31:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GNX-02","text":"It excludes a negation that would be only absence, lack, or nonexistence.","refs":["CH_GB18_A_31:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GNX-03","text":"It excludes the reduction of opposition to a two-valued assignment of external predicates.","refs":["CH_GB18_A_32:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GNX-04","text":"It excludes a ground that would externally precede opposition as a finished substrate.","refs":["CH_GB18_CDW0:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:GNX-05","text":"It excludes a resolution that falls into final nullity and leaves no determinate unity behind.","refs":["CH_GB18_CDW0:NX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_40:DBN-01","text":"Impermissible is a model in which fully self-subsistent determinations enter into relation with one another only subsequently.","refs":["CH_GB18_CDW0:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:DBN-02","text":"Impermissible is a model of cognition in which knowledge considers the object externally, without carrying out its own negative relation to it.","refs":["CH_GB18_A_31:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:DBN-03","text":"Impermissible is the assumption that a formal alternative could completely exclude its own basis in reflection.","refs":["CH_GB18_A_32:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:DBN-04","text":"Impermissible is the availability of an absolutely first positive that would not already be mediated through negation and relation.","refs":["CH_GB18_CDW0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_40:BSA-01","text":"Unavailable is pure positivity as presuppositionless self-identity without inner negativity.","refs":["CH_GB18_CDW0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSA-02","text":"Unavailable is a genuinely indifferent third that would remain untouched by opposition and yet could constitute its bearer.","refs":["CH_GB18_A_32:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSA-03","text":"Unavailable is truth as immediate identity that could skip negative mediation and sublation.","refs":["CH_GB18_A_31:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSA-04","text":"Unavailable is a final state of pure rest, because unity cannot cast off its negativity.","refs":["CH_GB18_CDW0:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_40:XD-01","text":"The reversal of opposites is not semantic ambiguity, but the necessary consequence of every determination that must at once exclude its other and presuppose it within itself.","refs":["CL_GB18_40:GA-02","CL_GB18_40:GA-03","CH_GB18_A_31:A7","CH_GB18_CDW0:NX5"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_40:XD-02","text":"The law of the excluded third carries out the same self-undermining as every exclusion: in excluding a third, it produces the common unity of reference that bears its alternative.","refs":["CL_GB18_40:GA-02","CL_GB18_40:GA-06","CH_GB18_A_32:A7","CH_GB18_CDW0:MRT4"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_40:XD-03","text":"Neither philosophical cognition nor logical determination can stabilize opposites by fixing their names; they must grasp the movement of their reciprocal production.","refs":["CL_GB18_40:GA-03","CL_GB18_40:GA-09","CH_GB18_A_31:SD5","CH_GB18_A_32:D2"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_40:XD-04","text":"Ground functions simultaneously as the ontological truth of sublated opposition and as the logical unity of reflection; it is therefore not a result alongside opposition, but its immanent requalification.","refs":["CL_GB18_40:GA-07","CL_GB18_40:GA-08","CH_GB18_CDW0:D7","CH_GB18_A_32:D7"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_40:XD-05","text":"The impossibility of an external standpoint of cognition follows from the same structure that excludes an independent positive or negative pole: knowledge belongs to the negative mediation of the object itself.","refs":["CL_GB18_40:GA-05","CL_GB18_40:GA-09","CH_GB18_A_31:D7","CH_GB18_A_31:SNX3"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_40:BSD-01","text":"Reality appears as a process of self-negative determinacy: every claimed pure identity produces the mediation it cannot control.","refs":["CH_GB18_CDW0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSD-02","text":"Formal logical laws are reclassified from neutral instruments of exclusion into symptoms of their own concealed basis in reflection.","refs":["CH_GB18_A_32:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSD-03","text":"Ground is determined as retroactive truth: it arises from sublation and thereby retrospectively classifies the initially self-subsistent opposition as posited negativity.","refs":["CH_GB18_CDW0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSD-04","text":"Truth becomes a practice of negative penetration, not a positive correspondence between external knowledge and an external object.","refs":["CH_GB18_A_31:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:BSD-05","text":"The temporal structure of the cluster is recursive: what appears as a beginning becomes legible only through the attained ground as a dependent moment of its own truth.","refs":["CH_GB18_CDW0:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_40:RLE-01","text":"Self-subsistence produces self-contradiction through inclusion and exclusion of the other; contradiction sublates positedness and returns into itself as ground.","refs":["CH_GB18_CDW0:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RLE-02","text":"External juxtaposition produces confusion, which passes through self-reflection into necessary reversal and thereby retroactively delegitimates external juxtaposition.","refs":["CH_GB18_A_31:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RLE-03","text":"The exclusion of a third presupposes a common something; this something transforms itself from a concealed bearer of the alternative into the unity of reflection of its sublated sides.","refs":["CH_GB18_A_32:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:RLE-04","text":"Ground acts as an attractor because every movement of opposition tends toward a unity that does not eliminate opposition, but preserves it as identical negativity.","refs":["CH_GB18_CDW0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_40:FGS-B01","text":"External juxtaposition → suspension of external comparison → self-reflection of determinations.","refs":["CH_GB18_A_31:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:FGS-B02","text":"Self-reflection → claim to self-subsistence → inclusion of the other as condition of one's own determinacy.","refs":["CH_GB18_CDW0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:FGS-B03","text":"Inclusion of the other → exclusion of the other → positing of the excluded and self-contradiction; the same operation appears formally as exclusion of a third.","refs":["CH_GB18_A_32:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:FGS-B04","text":"Self-contradiction → sublation of positedness → positive return → ground as unity of preserved negativity.","refs":["CH_GB18_CDW0:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_40:AFM-B01","text":"Externally fixed counter-determination → problem of the relation between positive and negative.","refs":["CH_GB18_A_31:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AFM-B02","text":"Problem of relation → displacement into self-reflection → reciprocal appearance of each determination in the other.","refs":["CH_GB18_A_31:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AFM-B03","text":"Reciprocal appearance → positing and exclusion of the other → self-contradiction of the self-subsistent sides.","refs":["CH_GB18_CDW0:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AFM-B04","text":"Self-contradiction → formal exclusion of the third → revelation of the something as the necessary bearer of the alternative.","refs":["CH_GB18_A_32:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:AFM-B05","text":"Necessary something → positing and sublation of opposites → unity of reflection → ground.","refs":["CH_GB18_A_32:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_40:MME-01","text":"Positive and negative are remapped from fixed objects into recursive operations.","refs":["CH_GB18_CDW0:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MME-02","text":"The external alternative is mapped as an inner relation of reflection whose poles exist only through their common unity.","refs":["CH_GB18_A_32:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MME-03","text":"Ground is reclassified from presupposed foundation into the result and inner truth of sublated opposition.","refs":["CH_GB18_CDW0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MME-04","text":"Truth is displaced from positive attribution into an active negative movement of penetration and sublation.","refs":["CH_GB18_A_31:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_40:ALT-B01","text":"Surface level — Positive and negative appear as self-subsistent sides of an opposition and as terms of a seemingly exhaustive alternative.","refs":["CH_GB18_CDW0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:ALT-B02","text":"Structural level — Determinations reproduce their other through the operation by which they carry out its exclusion.","refs":["CH_GB18_CDW0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:ALT-B03","text":"Metastrategic level — Cognition must abandon the fixation of opposites and carry out their necessary transformation as conceptual work.","refs":["CH_GB18_A_31:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:ALT-B04","text":"Ontological / Temporal level — Essence is not an original resting presence, but the returning unity that sustains itself only through sublated negativity.","refs":["CH_GB18_CDW0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:ALT-B05","text":"Methodological / Performative level — The form of the cluster carries out its thesis by transferring every fixed determination into its relation, reversal, and sublation.","refs":["CH_GB18_A_31:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_40:FL-01","text":"Ground is at once the result of sublation and the truth on which the sublated opposition appears retroactively dependent; this circularity is constitutive, but not fully unfolded.","refs":["CH_GB18_CDW0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:FL-02","text":"The negative oscillates between relational determination of sense and existence identical with itself; the unity of both determinations remains preserved as tension.","refs":["CH_GB18_A_31:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:FL-03","text":"The something is supposed to be neither fixable as merely positive nor as merely negative, while at the same time constituting the unity of both determinations; this double position is a point of productive instability.","refs":["CH_GB18_A_32:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MP-01","text":"The first point of mutation lies in the displacement from external comparison to inner reflection: relation becomes, from a judgment about determinations, their own form of movement.","refs":["CH_GB18_A_31:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MP-02","text":"The second point of mutation lies in the recoding of reversal from an error of thought into an indicator of conceptual necessity.","refs":["CH_GB18_A_31:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MP-03","text":"The third point of mutation lies in the transformation of the excluded third from the supposedly additional term into the unity of related opposites.","refs":["CH_GB18_A_32:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_40:HSI-01","text":"Reality appears as a machine of reflection in which every determination, through the attempt to exclude its other, reproduces this other and transforms itself.","refs":["CH_GB18_CDW0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:HSI-02","text":"The subject is not an external judge over opposites, but a negative movement of cognition that determines itself only through penetrating and sublating its other.","refs":["CH_GB18_A_31:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:HSI-03","text":"Time appears as retrograde reconstruction: ground retrospectively transforms the initial opposition into a moment of its own posited negativity.","refs":["CH_GB18_CDW0:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:HSI-04","text":"Possible navigation consists not in the choice of a pole, but in holding fast to the movement through which each pole contains, posits, and takes back its other into itself.","refs":["CH_GB18_A_31:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_40:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from opposition through contradiction and formal exclusion to the unity of reflection of ground.","refs":["CH_GB18_CDW0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MRT-B02","text":"The architecture is coherent insofar as self-relation is understood not as immediate identity, but as negative mediation.","refs":["CH_GB18_CDW0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MRT-B03","text":"The status of the initial claim to self-subsistence and the precise systematic position of the unity of reflection within the further logic remain underdetermined.","refs":["CH_GB18_CDW0:MRT2","CH_GB18_A_32:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_40:MRT-B04","text":"The strongest and indispensable operation lies in the derivation that exclusion carries out the positing of the excluded; reconstruction must translate this operation back neither into external relation nor into mere nullity.","refs":["CH_GB18_CDW0:MRT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_40@R001","source_variant_id":"canonical:CL_GB18_40:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 118–120","context":"C. Der Widerspruch. · Anmerkung 1. · Anmerkung 2."},"title_language_code":"en"},{"id":"CL_GB18_41","layer":"CL","title":"Chapters 121–123","order":41,"parents":["CH_GB18_A_33","CH_GB18_A_34","CH_GB18_FUW0"],"revision":"CL_GB18_41@R001","sha256":"ab2437fa425f37d5d06e122216cdae22849feace2112639fa11a74fb6216daf8","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_41:AS-B01","text":"Das Cluster bestimmt, wie Bestimmtheit, Grund und Form ohne Rückgriff auf ein positiv vorausliegendes Erstes erklärt werden können: Alles zunächst Unmittelbare erweist sich als gesetzte und vermittelte Erscheinung.","refs":["CH_GB18_FUW0:AS1","CH_GB18_A_34:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B02","text":"Der Widerspruch wird von einer vermeintlichen Störung des Denkens zur immanenten Negativität des Wirklichen erhoben und in der Form als operative Selbstreflexion des Wesens fortbestimmt.","refs":["CH_GB18_A_33:A3","CH_GB18_FUW0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B03","text":"Identität und Unmittelbarkeit fungieren nur als abstrakte Anfangsformen; ihre Wahrheit liegt in ihrer Negation, ihrer Gesetztheit und ihrer Rückkehr in vermittelte Einheit.","refs":["CH_GB18_A_33:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B04","text":"Grund wird nicht als tragende Substanz hinter den Bestimmungen, sondern als Selbstfundierung bestimmt, in der das Gesetzte durch seine Aufhebung die negative Identität seines Grundes erzeugt.","refs":["CH_GB18_FUW0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B05","text":"Die Architektur ersetzt einseitige Abhängigkeit durch reziproke Vermittlung: Unterschiedene Momente sind nur, indem sie einander voraussetzen, negieren und in einer unbedingten Einheit zurückkehren.","refs":["CH_GB18_FUW0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B06","text":"Form ist der Punkt, an dem die Grundbewegung ihre eigene Differenz operativ macht; Materie erscheint nicht als äußerer Stoff, sondern als die von der Form selbst vorausgesetzte formlose Identität.","refs":["CH_GB18_FUW0:A8","CH_GB18_FUW0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B07","text":"Mechanische Kausalität bleibt für Teilbestimmungen zuständig, kann aber die Einheit einer Existenz nicht zureichend erklären; damit wird die Forderung nach Zweckbeziehung als nächsthöhere, noch ausgesetzte Vermittlung erzeugt.","refs":["CH_GB18_A_34:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B08","text":"Die Bewegung ist rekursiv und nicht abschließend: Widersprüchliche Endlichkeit verweist auf absolute Notwendigkeit, während die voll zureichende Zweckform des Unbedingten als nicht eingelöste Zukunft der Begriffslogik stehenbleibt.","refs":["CH_GB18_A_33:SD3","CH_GB18_A_34:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_41:GA-01","text":"[Persistent] Jede unmittelbare Bestimmtheit besitzt ihre Wahrheit nur als gesetzte, aufgehobene und vermittelte Bestimmtheit.","refs":["CH_GB18_FUW0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-02","text":"[Mutating] Negativität mutiert von der immanenten Widersprüchlichkeit endlicher Bestimmungen zur absoluten Selbstreflexion der Form, ohne ihren Status als Bewegungsprinzip zu verlieren.","refs":["CH_GB18_A_33:AS3","CH_GB18_FUW0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-03","text":"[Persistent] Identität ist nicht der negationsfreie Grund von Differenz, sondern die mit ihrer aufgehobenen Negation vermittelte negative Einheit.","refs":["CH_GB18_A_33:A1","CH_GB18_A_34:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-04","text":"[Emergent] Grund ist nur wirklich als Selbstgrund: Das Gesetzte setzt seinen Grund voraus, indem es seinen Anspruch auf selbständige Unmittelbarkeit aufhebt.","refs":["CH_GB18_FUW0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-05","text":"[Persistent] Unterschiedene Bestimmungen bestehen nicht isoliert, sondern nur in wechselseitiger Negation, Voraussetzung und Rückkehr in ihre gemeinsame Einheit.","refs":["CH_GB18_A_33:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-06","text":"[Emergent] Aufhebung produziert keine Leere, sondern reale Vermittlung und dadurch eine Unmittelbarkeit, die als Resultat ihrer eigenen Negation besteht.","refs":["CH_GB18_A_34:A9","CH_GB18_A_34:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-07","text":"[Mutating] Die Grundrelation wird in der Formrelation operational: Das Gesetzte tritt als Form hervor, deren Wirksamkeit nur ihre immanente Rückkehr in das Wesen ist.","refs":["CH_GB18_FUW0:A8","CH_GB18_FUW0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-08","text":"[Attractor] Eine zureichende Einheit verlangt Zweckbeziehung, doch diese Form ist innerhalb der erreichten Wesens- und Grundlogik lediglich gefordert und nicht vollzogen.","refs":["CH_GB18_A_34:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-09","text":"[Terminal] Materie ist die Grenzbestimmung einer Form, die eine einfache Identität voraussetzen muss, ohne sie als positiven, von Form unabhängigen Stoff festhalten zu können.","refs":["CH_GB18_FUW0:SD4","CH_GB18_FUW0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_41:RMD-01","text":"Identität kehrt wieder, verliert jedoch ihre abstrakte Positivität: Aus leerer Gleichheit wird negative Selbstidentität des Wesens und schließlich die vorausgesetzte Identität der Form.","refs":["CH_GB18_A_33:ME1","CH_GB18_A_34:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-02","text":"Widerspruch bleibt als funktionelle Konstante bestehen, verschiebt sich aber von der expliziten Wahrheit endlicher Bestimmungen zur operativen Negativität, durch welche Form und Wesen sich gegeneinander bestimmen.","refs":["CH_GB18_A_33:SD4","CH_GB18_FUW0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-03","text":"Unmittelbarkeit mutiert vom unwahren Anfang zu einem durch aufgehobene Reflexion wiederhergestellten Resultat und verliert damit jeden Status eines ontologisch ursprünglichen Gegebenen.","refs":["CH_GB18_A_34:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-04","text":"Reflexion erweitert ihren Geltungsbereich: Sie ist nicht mehr bloß Denkbewegung gegenüber einem Gegenstand, sondern reale Vermittlung, in der das Wesen seine Bestimmungen erzeugt und aufhebt.","refs":["CH_GB18_A_33:A3","CH_GB18_FUW0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-05","text":"Der Grund mutiert von der höheren Einheit, auf welche endliche Sphären verweisen, zur bestimmten Beziehung von Nichtgesetztem und Gesetztem, ohne in eine äußere Ursache zurückzufallen.","refs":["CH_GB18_A_33:A8","CH_GB18_FUW0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-06","text":"Form erscheint als neue Bestimmung, absorbiert aber die gesamte frühere Negativitätslogik: Sie ist die bleibende Gesetztheit von Bestimmungen und zugleich deren immanente Selbstaufhebung.","refs":["CH_GB18_FUW0:AS4","CH_GB18_FUW0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-07","text":"Absolute Notwendigkeit und Zweckbeziehung fungieren nicht als identische Endpunkte: Erstere folgt aus der Selbstaufhebung des Endlichen, letztere markiert die noch nicht erreichte Form zureichender Einheit.","refs":["CH_GB18_A_33:SD3","CH_GB18_A_34:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_41:CGD-01","text":"Äußere Bewegung und Lebendigkeit bleiben lokale Exempel der Widerspruchslogik; auf Clusterebene werden sie zu Indizien dafür, dass Selbstbewegung allgemein aus immanenter Negativität hervorgeht.","refs":["CH_GB18_A_33:D1","CH_GB18_A_33:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:CGD-02","text":"Die Kritik mechanischer Ursachen bleibt lokal an Erklärungsformen gebunden, skaliert aber zur globalen Unterscheidung zwischen Erklärung isolierter Teilbestimmungen und Rekonstruktion ihrer wesentlichen Einheit.","refs":["CH_GB18_A_34:A11","CH_GB18_A_34:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:CGD-03","text":"Form und Materie sind zunächst spezifische Kategorien der Form-Wesen-Relation; auf Clusterebene bezeichnen sie die allgemeine Grenze jeder Selbstfundierung zwischen operativer Negativität und vorausgesetzter Identität.","refs":["CH_GB18_FUW0:ME4","CH_GB18_FUW0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:CGD-04","text":"Die reziproke Vermittlung von Grund und Bedingung ist nicht bloß ein lokaler Übergang zur Existenz, sondern die globale Form, in der alle scheinbar asymmetrischen Abhängigkeiten umcodiert werden.","refs":["CH_GB18_FUW0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:CGD-05","text":"Absolute Notwendigkeit, Unbedingtes und Teleologie dürfen nicht zu einem bereits erreichten positiven Abschluss verschmolzen werden; sie strukturieren die aktuelle Ebene als gerichtete, aber offene Steigerung.","refs":["CH_GB18_A_33:SD3","CH_GB18_A_34:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_41:GNX-01","text":"Ausgeschlossen ist eine Ontologie unmittelbarer Selbständigkeit, in der Sein oder Bestimmtheit vor ihrer Gesetztheit und Vermittlung wahr sein könnten.","refs":["CH_GB18_A_34:DNX1","CH_GB18_FUW0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GNX-02","text":"Ausgeschlossen ist eine Theorie des Widerspruchs als bloß subjektiver, sprachlicher oder zufälliger Unvereinbarkeit.","refs":["CH_GB18_A_33:A3","CH_GB18_A_33:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GNX-03","text":"Ausgeschlossen ist ein Grund, der als fertig vorhandene positive Grundlage seinen Bestimmungen äußerlich vorausliegen könnte.","refs":["CH_GB18_A_34:NX1","CH_GB18_FUW0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GNX-04","text":"Ausgeschlossen ist eine Vermittlung zwischen bereits selbständigen Termen; reine und reale Vermittlung setzen die Nichtselbständigkeit ihrer Momente voraus.","refs":["CH_GB18_A_34:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GNX-05","text":"Ausgeschlossen ist eine lineare Kausalordnung, deren Summe lokaler Ursachen die Einheit einer Existenz erschöpfend begründen könnte.","refs":["CH_GB18_A_34:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GNX-06","text":"Ausgeschlossen ist eine äußerliche Form-Materie- oder Form-Wesen-Trennung, in der Form Bestimmung von außen hinzufügt oder Materie als unabhängiges Substrat vorliegt.","refs":["CH_GB18_FUW0:NX5","CH_GB18_FUW0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_41:DBN-01","text":"Das Cluster disqualifiziert jedes Gesamtmodell, das unabhängige Terme voraussetzt und ihre Beziehung erst sekundär erklären will.","refs":["CH_GB18_A_33:DNX1","CH_GB18_A_34:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:DBN-02","text":"Nicht zugelassen ist eine stabile Bestimmtheit, deren Identität nicht bereits die Negation, Grenze und mögliche Selbstaufhebung ihrer eigenen Form enthielte.","refs":["CH_GB18_A_33:DNX2","CH_GB18_FUW0:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:DBN-03","text":"Nicht zugelassen ist eine Wahrheit als äußere Repräsentation fixer Gegenstände; Wahrheit verlangt das Denken der immanenten Übergänge der Bestimmungen selbst.","refs":["CH_GB18_A_33:SNX3","CH_GB18_A_33:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:DBN-04","text":"Nicht zugelassen ist eine Erklärung, die Grund, Ursache oder Bedingung einseitig setzt und dadurch die Rückwirkung des Begründeten auf seine eigene Grundlage unterschlägt.","refs":["CH_GB18_FUW0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:DBN-05","text":"Nicht zugelassen ist ein positiver Materialismus des Substrats, weil Materie nur als von der Form selbst erzeugte Perspektive formloser Identität auftreten darf.","refs":["CH_GB18_FUW0:D7","CH_GB18_FUW0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_41:BSA-01","text":"Unverfügbar ist ein absoluter Anfang, der nicht bereits aus Gesetztsein, Negation und rückkehrender Vermittlung hervorgegangen wäre.","refs":["CH_GB18_FUW0:SNX1","CH_GB18_A_34:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:BSA-02","text":"Unzulässig ist ein positives Absolutes, das dem negativen Prozess der Endlichkeit äußerlich gegenüberstünde oder unabhängig von dessen Selbstaufhebung bestimmt werden könnte.","refs":["CH_GB18_A_33:SNX2","CH_GB18_A_34:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:BSA-03","text":"Unverfügbar ist eine letzte endliche Sphäre, welche ihren Widerspruch vollständig in sich abschließen und dadurch dem Rückgang in Grund und Vermittlung entgehen könnte.","refs":["CH_GB18_A_33:SNX1","CH_GB18_A_33:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:BSA-04","text":"Versperrt bleibt ein endgültiger Besitz der zureichenden Einheit: Zweckbeziehung ist als notwendige Form gefordert, aber innerhalb der erreichten Architektur nicht präsent.","refs":["CH_GB18_A_34:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_41:XD-01","text":"Der Widerspruch wird durch die Grundlogik nicht entschärft, sondern als der Mechanismus bestimmt, durch den endliche Selbständigkeit in reale Vermittlung und Selbstfundierung übergeht.","refs":["CL_GB18_41:GA-02","CL_GB18_41:GA-04","CL_GB18_41:GA-06","CH_GB18_A_33:SD4","CH_GB18_A_34:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:XD-02","text":"Die Selbstaufhebung des Endlichen erzeugt nicht bloß einen höheren Grund, sondern legt offen, dass jede behauptete Unmittelbarkeit nur eine abgeleitete Gestalt ihrer eigenen Negation ist.","refs":["CL_GB18_41:GA-01","CL_GB18_41:GA-06","CH_GB18_A_33:D5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:XD-03","text":"Die Umcodierung der Identität zur negativen Einheit verbindet die Widerspruchslogik mit der Grundrelation und verhindert, dass Einheit als vorgängige Gleichheit missverstanden wird.","refs":["CL_GB18_41:GA-03","CL_GB18_41:GA-05","CH_GB18_A_33:ME1","CH_GB18_FUW0:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:XD-04","text":"Die Verbindung von Grund-Bedingung-Relation und Form-Wesen-Relation ersetzt lineare Abhängigkeit durch ein Gefüge, in dem jedes Moment nur durch seine Rückkehr in die Identität des anderen besteht.","refs":["CL_GB18_41:GA-04","CL_GB18_41:GA-05","CL_GB18_41:GA-07","CH_GB18_FUW0:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:XD-05","text":"Die Kritik mechanischer Erklärung erzeugt eine produktive Grenze: Kausalität bleibt lokal gültig, doch zureichende Erklärung wird zur Forderung nach einer Einheit, deren Zweckform erst jenseits der erreichten Ebene explizit wird.","refs":["CL_GB18_41:GA-08","CH_GB18_A_34:SD3","CH_GB18_A_34:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:XD-06","text":"Materie entsteht als negative Sicherung gegen jeden Rückfall in substanzielle Fundierung: Sie bezeichnet die Identität, die Form voraussetzt, aber nicht als unabhängig vorhandenes Sein behaupten darf.","refs":["CL_GB18_41:GA-07","CL_GB18_41:GA-09","CH_GB18_FUW0:SD4","CH_GB18_FUW0:DNX5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_41:BSD-01","text":"Realität erscheint als rekursive Selbstvermittelung: Bestimmungen bestehen nur, indem sie ihre Selbständigkeit verlieren, ihren Grund setzen und als vermittelte Unmittelbarkeit zurückkehren.","refs":["CL_GB18_41:GA-01","CL_GB18_41:GA-04","CL_GB18_41:GA-06","CH_GB18_A_33:SD1","CH_GB18_FUW0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:BSD-02","text":"Erkenntnis wird von der Repräsentation fertiger Gegenstände zur Fähigkeit verschoben, negative Einheit, immanenten Übergang und die Selbstaufhebung von Bestimmungen festzuhalten.","refs":["CL_GB18_41:GA-02","CL_GB18_41:GA-03","CH_GB18_A_33:D6","CH_GB18_A_33:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:BSD-03","text":"Zeitlichkeit besitzt keinen unabhängigen Anfang: Was als Grundlage, Sein oder Ursprung erscheint, wird erst rückläufig durch den Prozess seiner Negation und Wiederherstellung bestimmt.","refs":["CL_GB18_41:GA-01","CL_GB18_41:GA-04","CH_GB18_A_34:ALT4","CH_GB18_FUW0:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:BSD-04","text":"Kausalität wird in eine hierarchisierte Erklärungsarchitektur eingeordnet, in der Teilursachen reale Funktionen haben, aber keine letzte Autorität über die Einheit des Erklärten besitzen.","refs":["CL_GB18_41:GA-05","CL_GB18_41:GA-08","CH_GB18_A_34:SD3","CH_GB18_FUW0:ME1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:BSD-05","text":"Die Schlussform des Clusters ist eine offene negative Schließung: Absolute Notwendigkeit und Zweck bleiben Attraktoren der Vermittlung, nicht positiv verfügbare Gegenstände.","refs":["CL_GB18_41:GA-08","CL_GB18_41:GA-09","CH_GB18_A_33:SD3","CH_GB18_A_34:SNX3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_41:RLE-01","text":"Die zentrale Schleife lautet: Unmittelbarkeit wird als gesetzt entdeckt, setzt einen Grund voraus, hebt ihr Gesetztsein auf und kehrt als vermittelte Unmittelbarkeit zurück.","refs":["CH_GB18_FUW0:A1","CH_GB18_FUW0:A2","CH_GB18_A_34:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RLE-02","text":"Grund und Bedingung bilden eine reziproke Schleife, in der keines der beiden Momente den anderen einseitig begründen kann und ihre Einheit erst als Unbedingtes erscheint.","refs":["CH_GB18_A_34:A10","CH_GB18_A_34:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RLE-03","text":"Form bildet eine zweite Schleife: Sie setzt Wesen als ihr Anderes voraus, erweist sich aber gerade dadurch als immanente Reflexion dieses Wesens und hebt die äußere Differenz auf.","refs":["CH_GB18_FUW0:A11","CH_GB18_FUW0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RLE-04","text":"Die Eskalation verläuft von abstrakter Identität über Widerspruch und Grund zu Form, ohne eine positive Substanz zu erreichen; Materie markiert die Grenze dieser Selbstvoraussetzung.","refs":["CH_GB18_A_33:FGS1","CH_GB18_FUW0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RLE-05","text":"Der Attraktor der Architektur ist zureichende Einheit: Jeder Versuch, sie mechanisch, substantiell oder unmittelbar zu fixieren, erzeugt den Übergang zu höherer Vermittlung.","refs":["CH_GB18_A_34:A12","CH_GB18_A_34:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_41:FGS-B01","text":"Abstrakte Identität oder unmittelbares Sein → Entdeckung des impliziten Gesetztseins → Verlust des Status eines positiven Anfangs.","refs":["CH_GB18_A_33:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FGS-B02","text":"Gesetztsein → immanente Negativität → Verschiedenheit und Widerspruch → Selbstbewegung oder Zerfall der selbständigen Bestimmung.","refs":["CH_GB18_A_33:FGS2","CH_GB18_A_33:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FGS-B03","text":"Selbstaufhebung der Bestimmung → negative Identität des Wesens → Grund als reale Vermittlung mit sich selbst.","refs":["CH_GB18_FUW0:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FGS-B04","text":"Grund und Bedingung → wechselseitige Voraussetzung → Unbedingtes → Existenz als vollzogene Vermittlung einer Sache.","refs":["CH_GB18_A_34:FGS5","CH_GB18_A_34:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FGS-B05","text":"Vermittelte Bestimmungen → Form als gesetzte Differenz zum Wesen → Form als absolute Negativität und Rückkehr in den Grund.","refs":["CH_GB18_FUW0:FGS4","CH_GB18_FUW0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FGS-B06","text":"Selbstvoraussetzung der Form → Wesen als formlose Identität → Materie als Grenzbestimmung → Ausschluss eines äußerlich vorhandenen Substrats.","refs":["CH_GB18_FUW0:FGS6","CH_GB18_FUW0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_41:AFM-B01","text":"Scheinbare Identität und Unmittelbarkeit → Nachweis ihres Gesetztseins und ihrer immanenten Negativität.","refs":["CH_GB18_A_33:AF1","CH_GB18_A_34:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AFM-B02","text":"Immanente Negativität → Verschiedenheit und Widerspruch → Selbstbewegung, Zerfall oder Aushalten der endlichen Bestimmung.","refs":["CH_GB18_A_33:AF2","CH_GB18_A_33:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AFM-B03","text":"Selbstaufhebung des Endlichen → negative Einheit → Grund als reale Vermittlung und Wiederherstellung des Seins.","refs":["CH_GB18_A_33:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AFM-B04","text":"Grundrelation → wechselseitige Vermittlung von Grund und Bedingung → Unbedingtes und Existenz.","refs":["CH_GB18_A_34:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AFM-B05","text":"Vermittelte Bestimmung → Form-Wesen-Differenz → Selbstaufhebung äußerlicher Form → Materie als Grenzbegriff und Verweisung auf die noch ausstehende Zweckform.","refs":["CH_GB18_FUW0:AF4","CH_GB18_A_34:AF4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_41:MME-01","text":"Identität und Widerspruch werden neu kartiert: Identität erscheint als abstrakte Durchgangsform, Widerspruch als ihre tiefere Wahrheit und produktive Negativität.","refs":["CH_GB18_A_33:ME1","CH_GB18_A_33:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MME-02","text":"Sein und Unmittelbarkeit werden vom ursprünglichen Gegebenen zum Ergebnis eines Prozesses der Aufhebung, Rückkehr und Wiederherstellung umgeordnet.","refs":["CH_GB18_A_34:ME2","CH_GB18_A_34:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MME-03","text":"Grund und Ursache werden auseinandergezogen: Ursache erklärt lokale Hervorbringung, Grund rekonstruiert die Einheit, in der Teilbestimmungen überhaupt zusammenbestehen.","refs":["CH_GB18_A_34:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MME-04","text":"Form und Wesen werden nicht als Schichten eines Gegenstands, sondern als zwei Aspekte einer Selbstvermittlungsoperation kartiert; Materie ist deren reflexive Grenze.","refs":["CH_GB18_FUW0:ME2","CH_GB18_FUW0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MME-05","text":"Eine angemessene Lektüre muss Bestimmungen als Operationen ihrer eigenen Setzung, Negation und Rückkehr verfolgen, statt sie als stabile ontologische Gegenstände zu inventarisieren.","refs":["CH_GB18_A_33:ALT3","CH_GB18_FUW0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_41:ALT-B01","text":"Surface level — Explizit behandelt das Cluster den Status von Widerspruch, Grund, Begründetem, Bedingung, Form, Wesen und Materie.","refs":["CH_GB18_A_33:ALT1","CH_GB18_FUW0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:ALT-B02","text":"Structural level — Gesetztheit, Negativität, Aufhebung und Rückkehr bilden eine Maschine, in der Bestimmungen nur als vermittelte und selbstentmächtigte bestehen.","refs":["CH_GB18_A_33:ALT2","CH_GB18_FUW0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:ALT-B03","text":"Metastrategic level — Das Cluster ersetzt die Suche nach äußerlichen Fundamenten durch die Rekonstruktion jener Vermittlungen, die ihre eigenen Voraussetzungen erzeugen.","refs":["CH_GB18_A_34:SD1","CH_GB18_FUW0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:ALT-B04","text":"Ontological / Temporal level — Realität und Zeit werden rückläufig: Kein Anfang, kein Grund und keine Bestimmung besitzt einen Vorrang vor dem Prozess seiner Selbstaufhebung.","refs":["CH_GB18_A_33:ALT4","CH_GB18_FUW0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:ALT-B05","text":"Methodological / Performative level — Die Form der Argumentation vollzieht ihre These, indem jede scheinbar feste Kategorie als Übergang, Grenze und erneute Voraussetzung einer weiteren Bestimmung behandelt wird.","refs":["CH_GB18_A_33:FGS5","CH_GB18_FUW0:FGS1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_41:FL-01","text":"Die Architektur oszilliert zwischen der absoluten Notwendigkeit als Ergebnis der Selbstaufhebung des Endlichen und der Zweckform als noch nicht verfügbarer zureichender Einheit; der Schluss ist daher gerichtet, aber nicht vollendet.","refs":["CH_GB18_A_33:SD3","CH_GB18_A_34:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FL-02","text":"Grund ist zugleich als absoluter Anfang eingeführt und nur als Resultat seiner Selbstaufhebung bestimmbar; diese Zirkularität ist produktiv, aber verhindert jede lineare Fundamentalisierung.","refs":["CH_GB18_A_34:MRT5","CH_GB18_FUW0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FL-03","text":"Wesen kann als tragende Identität erscheinen, während Form als tätige Negativität auftritt; ihre behauptete Einheit bleibt nur haltbar, wenn beide als verschiedene Funktionen derselben Reflexion gelesen werden.","refs":["CH_GB18_FUW0:MRT6","CH_GB18_FUW0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MP-01","text":"Der Begriff der Identität mutiert, sobald er nicht mehr leere Gleichheit, sondern die mit aufgehobener Negation vermittelte Selbstgleichheit des Wesens bezeichnet.","refs":["CH_GB18_A_33:A1","CH_GB18_A_34:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MP-02","text":"Der Widerspruch mutiert von der expliziten Wahrheit endlicher Bestimmungen zur strukturellen Form ihrer Vermittlung und ist dadurch weder bloße Destruktion noch statische Antinomie.","refs":["CH_GB18_A_33:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MP-03","text":"Der Grund mutiert von einer scheinbaren Grundlage hinter dem Sein zu einer Operation, die nur existiert, indem sie ihr eigenes Bestimmtsein aufhebt und erneut setzt.","refs":["CH_GB18_A_34:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MP-04","text":"Materie mutiert vom möglichen Namen eines Substrats zur negativen Grenzbestimmung, in der die Form ihre vorausgesetzte Identität anerkennt, ohne deren Selbständigkeit zuzulassen.","refs":["CH_GB18_FUW0:ME4","CH_GB18_FUW0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_41:HSI-01","text":"Die Realität erscheint als Maschine negativer Selbstvermittlung, deren Teile nur wirken, indem sie ihre isolierte Selbständigkeit verlieren und in einen erzeugten Grund zurückkehren.","refs":["CH_GB18_A_33:SD2","CH_GB18_FUW0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:HSI-02","text":"Das Subjekt erscheint nicht als äußerer Beobachter fixer Gegenstände, sondern als Ort spekulativen Denkens, an dem der Übergang widersprüchlicher Bestimmungen festgehalten werden kann.","refs":["CH_GB18_A_33:A6","CH_GB18_A_33:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:HSI-03","text":"Zeit ist keine Abfolge aus einem gesicherten Ursprung, sondern die Rückkehrbewegung, durch welche Sein, Grund und Bestimmtheit erst nachträglich ihren Status gewinnen.","refs":["CH_GB18_A_34:ALT4","CH_GB18_FUW0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:HSI-04","text":"Handlungsmacht besteht innerhalb dieser Architektur nicht in äußerlicher Kontrolle, sondern in der Fähigkeit einer Bestimmung, ihren Widerspruch zu tragen, aufzuheben und als höhere Vermittlung zu transformieren.","refs":["CH_GB18_A_33:D2","CH_GB18_A_33:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_41:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Gesamtbewegung von abstrakter Identität und unmittelbarem Sein über Widerspruch, Grund und Form bis zur Grenzbestimmung der Materie zu rekonstruieren.","refs":["CH_GB18_A_33:MRT1","CH_GB18_FUW0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MRT-B02","text":"Unterbestimmt bleibt der positive Status dessen, was nach absoluter Notwendigkeit, Unbedingtem und Materie folgt, weil Zweck und Begriff als notwendige, aber ausgesetzte Vermittlungsformen markiert sind.","refs":["CH_GB18_A_33:MRT2","CH_GB18_A_34:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MRT-B03","text":"Die Architektur ist kohärent, sofern Widerspruch als immanente Selbstnegation, Grund als reale Vermittlung und Form als Reflexion des Wesens gelesen werden.","refs":["CH_GB18_A_33:MRT3","CH_GB18_FUW0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MRT-B04","text":"Ihre stärkste Verdichtung liegt in der Verbindung von Widerspruch, negativer Einheit, Selbstgrund und Form, weil dadurch Destruktion, Produktion und Erklärung innerhalb eines Mechanismus zusammenfallen.","refs":["CH_GB18_A_33:MRT4","CH_GB18_FUW0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MRT-B05","text":"Die Rekonstruktion bleibt auf die Sequenz von Setzung, Negation, Aufhebung und Wiederherstellung angewiesen; ohne diese rekursive Bewegung würden Grund, Form und Materie erneut als äußere Gegenstände missverstanden.","refs":["CH_GB18_A_33:MRT6","CH_GB18_FUW0:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122411145935Z_8ff22f14","language_code":"en","language_name":"English","title":"Chapters 121–123","source_sha256":"ab2437fa425f37d5d06e122216cdae22849feace2112639fa11a74fb6216daf8","sha256":"e5066bf1e257f47ec384a9548bc8ec77308184013b8c77b8570f46bf7e535c09","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:24:11.146856+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_41:AS-B01","text":"The cluster determines how determinacy, ground, and form can be explained without recourse to a positively antecedent first: everything initially immediate proves to be a posited and mediated appearance.","refs":["CH_GB18_FUW0:AS1","CH_GB18_A_34:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B02","text":"Contradiction is elevated from a supposed disturbance of thought to the immanent negativity of the real and is further determined in form as the operative self-reflection of essence.","refs":["CH_GB18_A_33:A3","CH_GB18_FUW0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B03","text":"Identity and immediacy function only as abstract initial forms; their truth lies in their negation, their positedness, and their return into mediated unity.","refs":["CH_GB18_A_33:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B04","text":"Ground is determined not as a supporting substance behind determinations, but as self-grounding, in which the posited produces the negative identity of its ground through its sublation.","refs":["CH_GB18_FUW0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B05","text":"The architecture replaces one-sided dependence with reciprocal mediation: distinct moments are only insofar as they presuppose one another, negate one another, and return into an unconditioned unity.","refs":["CH_GB18_FUW0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B06","text":"Form is the point at which the movement of ground makes its own difference operative; matter appears not as external stuff, but as the formless identity presupposed by form itself.","refs":["CH_GB18_FUW0:A8","CH_GB18_FUW0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B07","text":"Mechanical causality remains responsible for partial determinations, but cannot sufficiently explain the unity of an existence; this generates the demand for purposive relation as the next higher, still suspended mediation.","refs":["CH_GB18_A_34:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AS-B08","text":"The movement is recursive and non-conclusive: contradictory finitude refers to absolute necessity, while the fully adequate purposive form of the unconditioned remains as the unfulfilled future of the logic of the concept.","refs":["CH_GB18_A_33:SD3","CH_GB18_A_34:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_41:GA-01","text":"[Persistent] Every immediate determinacy possesses its truth only as posited, sublated, and mediated determinacy.","refs":["CH_GB18_FUW0:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-02","text":"[Mutating] Negativity mutates from the immanent contradictoriness of finite determinations into the absolute self-reflection of form, without losing its status as a principle of movement.","refs":["CH_GB18_A_33:AS3","CH_GB18_FUW0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-03","text":"[Persistent] Identity is not the negation-free ground of difference, but the negative unity mediated with its sublated negation.","refs":["CH_GB18_A_33:A1","CH_GB18_A_34:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-04","text":"[Emergent] Ground is actual only as self-ground: the posited presupposes its ground by sublating its claim to independent immediacy.","refs":["CH_GB18_FUW0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-05","text":"[Persistent] Distinct determinations do not subsist in isolation, but only in mutual negation, presupposition, and return into their common unity.","refs":["CH_GB18_A_33:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-06","text":"[Emergent] Sublation produces not emptiness, but real mediation and thereby an immediacy that subsists as the result of its own negation.","refs":["CH_GB18_A_34:A9","CH_GB18_A_34:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-07","text":"[Mutating] The ground-relation becomes operational in the form-relation: the posited emerges as form, whose efficacy is only its immanent return into essence.","refs":["CH_GB18_FUW0:A8","CH_GB18_FUW0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-08","text":"[Attractor] An adequate unity requires purposive relation, yet this form is within the achieved logic of essence and ground merely demanded and not actualized.","refs":["CH_GB18_A_34:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GA-09","text":"[Terminal] Matter is the limit-determination of a form that must presuppose a simple identity without being able to retain it as positive stuff independent of form.","refs":["CH_GB18_FUW0:SD4","CH_GB18_FUW0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_41:RMD-01","text":"Identity recurs, but loses its abstract positivity: empty equality becomes the negative self-identity of essence and finally the presupposed identity of form.","refs":["CH_GB18_A_33:ME1","CH_GB18_A_34:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-02","text":"Contradiction persists as a functional constant, but shifts from the explicit truth of finite determinations to the operative negativity through which form and essence determine themselves in relation to one another.","refs":["CH_GB18_A_33:SD4","CH_GB18_FUW0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-03","text":"Immediacy mutates from the untrue beginning into a result restored through sublated reflection, and thereby loses every status as an ontologically original given.","refs":["CH_GB18_A_34:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-04","text":"Reflection expands its scope: it is no longer merely a movement of thought vis-à-vis an object, but real mediation, in which essence produces and sublates its determinations.","refs":["CH_GB18_A_33:A3","CH_GB18_FUW0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-05","text":"Ground mutates from the higher unity to which finite spheres refer into the determinate relation of the unposited and the posited, without lapsing back into an external cause.","refs":["CH_GB18_A_33:A8","CH_GB18_FUW0:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-06","text":"Form appears as a new determination, but absorbs the entire earlier logic of negativity: it is the enduring positedness of determinations and at once their immanent self-sublation.","refs":["CH_GB18_FUW0:AS4","CH_GB18_FUW0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RMD-07","text":"Absolute necessity and purposive relation do not function as identical endpoints: the former follows from the self-sublation of the finite, the latter marks the form of adequate unity not yet attained.","refs":["CH_GB18_A_33:SD3","CH_GB18_A_34:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_41:CGD-01","text":"External movement and vitality remain local examples of the logic of contradiction; at the cluster level, they become indications that self-movement generally arises from immanent negativity.","refs":["CH_GB18_A_33:D1","CH_GB18_A_33:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:CGD-02","text":"The critique of mechanical causes remains locally bound to forms of explanation, but scales into the global distinction between explaining isolated partial determinations and reconstructing their essential unity.","refs":["CH_GB18_A_34:A11","CH_GB18_A_34:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:CGD-03","text":"Form and matter are initially specific categories of the form–essence relation; at the cluster level, they designate the general limit of every self-grounding between operative negativity and presupposed identity.","refs":["CH_GB18_FUW0:ME4","CH_GB18_FUW0:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:CGD-04","text":"The reciprocal mediation of ground and condition is not merely a local transition to existence, but the global form in which all seemingly asymmetric dependencies are recoded.","refs":["CH_GB18_FUW0:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:CGD-05","text":"Absolute necessity, the unconditioned, and teleology must not be fused into an already achieved positive conclusion; they structure the current level as a directed, yet open escalation.","refs":["CH_GB18_A_33:SD3","CH_GB18_A_34:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_41:GNX-01","text":"Excluded is an ontology of immediate independence, in which being or determinacy could be true prior to its positedness and mediation.","refs":["CH_GB18_A_34:DNX1","CH_GB18_FUW0:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GNX-02","text":"Excluded is a theory of contradiction as merely subjective, linguistic, or contingent incompatibility.","refs":["CH_GB18_A_33:A3","CH_GB18_A_33:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GNX-03","text":"Excluded is a ground that could antecede its determinations externally as a positively given foundation.","refs":["CH_GB18_A_34:NX1","CH_GB18_FUW0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GNX-04","text":"Excluded is mediation between already independent terms; pure and real mediation presuppose the non-independence of their moments.","refs":["CH_GB18_A_34:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GNX-05","text":"Excluded is a linear causal order whose sum of local causes could exhaustively ground the unity of an existence.","refs":["CH_GB18_A_34:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:GNX-06","text":"Excluded is an external separation of form and matter or of form and essence, in which form adds determination from without or matter exists as an independent substrate.","refs":["CH_GB18_FUW0:NX5","CH_GB18_FUW0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_41:DBN-01","text":"The cluster disqualifies every overall model that presupposes independent terms and seeks to explain their relation only secondarily.","refs":["CH_GB18_A_33:DNX1","CH_GB18_A_34:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:DBN-02","text":"Not permitted is a stable determinacy whose identity did not already contain the negation, limit, and possible self-sublation of its own form.","refs":["CH_GB18_A_33:DNX2","CH_GB18_FUW0:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:DBN-03","text":"Not permitted is truth as external representation of fixed objects; truth requires thinking the immanent transitions of determinations themselves.","refs":["CH_GB18_A_33:SNX3","CH_GB18_A_33:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:DBN-04","text":"Not permitted is an explanation that posits ground, cause, or condition one-sidedly and thereby suppresses the retroactive effect of the grounded upon its own basis.","refs":["CH_GB18_FUW0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:DBN-05","text":"Not permitted is a positive materialism of the substrate, because matter may appear only as the perspective of formless identity produced by form itself.","refs":["CH_GB18_FUW0:D7","CH_GB18_FUW0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_41:BSA-01","text":"Unavailable is an absolute beginning that had not already emerged from positedness, negation, and returning mediation.","refs":["CH_GB18_FUW0:SNX1","CH_GB18_A_34:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:BSA-02","text":"Impermissible is a positive absolute that would stand externally opposed to the negative process of finitude or could be determined independently of its self-sublation.","refs":["CH_GB18_A_33:SNX2","CH_GB18_A_34:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:BSA-03","text":"Unavailable is a final finite sphere that could completely enclose its contradiction within itself and thereby escape regression into ground and mediation.","refs":["CH_GB18_A_33:SNX1","CH_GB18_A_33:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:BSA-04","text":"A definitive possession of adequate unity remains barred: purposive relation is required as a necessary form, but is not present within the achieved architecture.","refs":["CH_GB18_A_34:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_41:XD-01","text":"Contradiction is not mitigated by the logic of ground, but determined as the mechanism through which finite independence passes into real mediation and self-grounding.","refs":["CL_GB18_41:GA-02","CL_GB18_41:GA-04","CL_GB18_41:GA-06","CH_GB18_A_33:SD4","CH_GB18_A_34:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:XD-02","text":"The self-sublation of the finite produces not merely a higher ground, but reveals that every asserted immediacy is only a derivative configuration of its own negation.","refs":["CL_GB18_41:GA-01","CL_GB18_41:GA-06","CH_GB18_A_33:D5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:XD-03","text":"The recoding of identity into negative unity connects the logic of contradiction with the ground-relation and prevents unity from being misunderstood as antecedent equality.","refs":["CL_GB18_41:GA-03","CL_GB18_41:GA-05","CH_GB18_A_33:ME1","CH_GB18_FUW0:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:XD-04","text":"The connection of the ground–condition relation and the form–essence relation replaces linear dependence with a configuration in which each moment subsists only through its return into the identity of the other.","refs":["CL_GB18_41:GA-04","CL_GB18_41:GA-05","CL_GB18_41:GA-07","CH_GB18_FUW0:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:XD-05","text":"The critique of mechanical explanation generates a productive limit: causality remains locally valid, but adequate explanation becomes the demand for a unity whose purposive form becomes explicit only beyond the achieved level.","refs":["CL_GB18_41:GA-08","CH_GB18_A_34:SD3","CH_GB18_A_34:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:XD-06","text":"Matter arises as a negative safeguard against every relapse into substantial grounding: it designates the identity that form presupposes but may not assert as independently existing being.","refs":["CL_GB18_41:GA-07","CL_GB18_41:GA-09","CH_GB18_FUW0:SD4","CH_GB18_FUW0:DNX5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_41:BSD-01","text":"Reality appears as recursive self-mediation: determinations subsist only by losing their independence, positing their ground, and returning as mediated immediacy.","refs":["CL_GB18_41:GA-01","CL_GB18_41:GA-04","CL_GB18_41:GA-06","CH_GB18_A_33:SD1","CH_GB18_FUW0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:BSD-02","text":"Cognition is displaced from the representation of finished objects to the capacity to retain negative unity, immanent transition, and the self-sublation of determinations.","refs":["CL_GB18_41:GA-02","CL_GB18_41:GA-03","CH_GB18_A_33:D6","CH_GB18_A_33:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:BSD-03","text":"Temporality possesses no independent beginning: what appears as foundation, being, or origin is determined only retroactively through the process of its negation and restoration.","refs":["CL_GB18_41:GA-01","CL_GB18_41:GA-04","CH_GB18_A_34:ALT4","CH_GB18_FUW0:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:BSD-04","text":"Causality is situated within a hierarchized architecture of explanation, in which partial causes have real functions but possess no final authority over the unity of what is explained.","refs":["CL_GB18_41:GA-05","CL_GB18_41:GA-08","CH_GB18_A_34:SD3","CH_GB18_FUW0:ME1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_41:BSD-05","text":"The concluding form of the cluster is an open negative closure: absolute necessity and purpose remain attractors of mediation, not positively available objects.","refs":["CL_GB18_41:GA-08","CL_GB18_41:GA-09","CH_GB18_A_33:SD3","CH_GB18_A_34:SNX3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_41:RLE-01","text":"The central loop is as follows: immediacy is discovered as posited, presupposes a ground, sublates its positedness, and returns as mediated immediacy.","refs":["CH_GB18_FUW0:A1","CH_GB18_FUW0:A2","CH_GB18_A_34:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RLE-02","text":"Ground and condition form a reciprocal loop in which neither moment can ground the other one-sidedly and their unity appears only as the unconditioned.","refs":["CH_GB18_A_34:A10","CH_GB18_A_34:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RLE-03","text":"Form constitutes a second loop: it presupposes essence as its other, but thereby proves itself to be the immanent reflection of this essence and sublates the external difference.","refs":["CH_GB18_FUW0:A11","CH_GB18_FUW0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RLE-04","text":"The escalation proceeds from abstract identity through contradiction and ground to form, without attaining a positive substance; matter marks the limit of this self-presupposition.","refs":["CH_GB18_A_33:FGS1","CH_GB18_FUW0:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:RLE-05","text":"The attractor of the architecture is adequate unity: every attempt to fix it mechanically, substantially, or immediately generates the transition to higher mediation.","refs":["CH_GB18_A_34:A12","CH_GB18_A_34:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_41:FGS-B01","text":"Abstract identity or immediate being → discovery of implicit positedness → loss of the status of a positive beginning.","refs":["CH_GB18_A_33:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FGS-B02","text":"Positedness → immanent negativity → difference and contradiction → self-movement or disintegration of the independent determination.","refs":["CH_GB18_A_33:FGS2","CH_GB18_A_33:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FGS-B03","text":"Self-sublation of determination → negative identity of essence → ground as real mediation with itself.","refs":["CH_GB18_FUW0:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FGS-B04","text":"Ground and condition → reciprocal presupposition → unconditioned → existence as the actualized mediation of a thing.","refs":["CH_GB18_A_34:FGS5","CH_GB18_A_34:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FGS-B05","text":"Mediated determinations → form as posited difference from essence → form as absolute negativity and return into ground.","refs":["CH_GB18_FUW0:FGS4","CH_GB18_FUW0:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FGS-B06","text":"Self-presupposition of form → essence as formless identity → matter as limit-determination → exclusion of an externally existing substrate.","refs":["CH_GB18_FUW0:FGS6","CH_GB18_FUW0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_41:AFM-B01","text":"Apparent identity and immediacy → demonstration of their positedness and immanent negativity.","refs":["CH_GB18_A_33:AF1","CH_GB18_A_34:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AFM-B02","text":"Immanent negativity → difference and contradiction → self-movement, disintegration, or endurance of finite determination.","refs":["CH_GB18_A_33:AF2","CH_GB18_A_33:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AFM-B03","text":"Self-sublation of the finite → negative unity → ground as real mediation and restoration of being.","refs":["CH_GB18_A_33:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AFM-B04","text":"Ground-relation → reciprocal mediation of ground and condition → unconditioned and existence.","refs":["CH_GB18_A_34:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:AFM-B05","text":"Mediated determination → form–essence difference → self-sublation of external form → matter as limit-concept and reference to the purposive form still outstanding.","refs":["CH_GB18_FUW0:AF4","CH_GB18_A_34:AF4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_41:MME-01","text":"Identity and contradiction are remapped: identity appears as an abstract transitional form, contradiction as its deeper truth and productive negativity.","refs":["CH_GB18_A_33:ME1","CH_GB18_A_33:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MME-02","text":"Being and immediacy are reordered from the originally given into the result of a process of sublation, return, and restoration.","refs":["CH_GB18_A_34:ME2","CH_GB18_A_34:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MME-03","text":"Ground and cause are separated: cause explains local production, ground reconstructs the unity in which partial determinations coexist at all.","refs":["CH_GB18_A_34:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MME-04","text":"Form and essence are mapped not as layers of an object, but as two aspects of an operation of self-mediation; matter is its reflexive limit.","refs":["CH_GB18_FUW0:ME2","CH_GB18_FUW0:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MME-05","text":"An adequate reading must trace determinations as operations of their own positing, negation, and return, rather than inventorying them as stable ontological objects.","refs":["CH_GB18_A_33:ALT3","CH_GB18_FUW0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_41:ALT-B01","text":"Surface level — The cluster explicitly treats the status of contradiction, ground, the grounded, condition, form, essence, and matter.","refs":["CH_GB18_A_33:ALT1","CH_GB18_FUW0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:ALT-B02","text":"Structural level — Positedness, negativity, sublation, and return form a machine in which determinations subsist only as mediated and self-disempowered.","refs":["CH_GB18_A_33:ALT2","CH_GB18_FUW0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:ALT-B03","text":"Metastrategic level — The cluster replaces the search for external foundations with the reconstruction of those mediations that produce their own presuppositions.","refs":["CH_GB18_A_34:SD1","CH_GB18_FUW0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:ALT-B04","text":"Ontological / Temporal level — Reality and time are retrogressive: no beginning, ground, or determination possesses priority over the process of its self-sublation.","refs":["CH_GB18_A_33:ALT4","CH_GB18_FUW0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:ALT-B05","text":"Methodological / Performative level — The form of argumentation enacts its thesis by treating every seemingly fixed category as transition, limit, and renewed presupposition of a further determination.","refs":["CH_GB18_A_33:FGS5","CH_GB18_FUW0:FGS1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_41:FL-01","text":"The architecture oscillates between absolute necessity as the result of the self-sublation of the finite and purposive form as adequate unity not yet available; the conclusion is therefore directed, but not complete.","refs":["CH_GB18_A_33:SD3","CH_GB18_A_34:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FL-02","text":"Ground is introduced both as an absolute beginning and as determinable only as the result of its self-sublation; this circularity is productive, but prevents every linear foundationalization.","refs":["CH_GB18_A_34:MRT5","CH_GB18_FUW0:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:FL-03","text":"Essence can appear as supporting identity, while form emerges as active negativity; their asserted unity remains tenable only if both are read as different functions of the same reflection.","refs":["CH_GB18_FUW0:MRT6","CH_GB18_FUW0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MP-01","text":"The concept of identity mutates as soon as it no longer designates empty equality, but the self-sameness of essence mediated with sublated negation.","refs":["CH_GB18_A_33:A1","CH_GB18_A_34:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MP-02","text":"Contradiction mutates from the explicit truth of finite determinations into the structural form of their mediation and is thereby neither mere destruction nor static antinomy.","refs":["CH_GB18_A_33:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MP-03","text":"Ground mutates from an apparent foundation behind being into an operation that exists only by sublating and re-positing its own determinacy.","refs":["CH_GB18_A_34:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MP-04","text":"Matter mutates from the possible name of a substrate into the negative limit-determination in which form acknowledges its presupposed identity without permitting its independence.","refs":["CH_GB18_FUW0:ME4","CH_GB18_FUW0:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_41:HSI-01","text":"Reality appears as a machine of negative self-mediation, whose parts operate only by losing their isolated independence and returning into a produced ground.","refs":["CH_GB18_A_33:SD2","CH_GB18_FUW0:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:HSI-02","text":"The subject appears not as an external observer of fixed objects, but as the locus of speculative thinking, in which the transition of contradictory determinations can be retained.","refs":["CH_GB18_A_33:A6","CH_GB18_A_33:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:HSI-03","text":"Time is not a sequence from a secured origin, but the movement of return through which being, ground, and determinacy gain their status only subsequently.","refs":["CH_GB18_A_34:ALT4","CH_GB18_FUW0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:HSI-04","text":"Agency within this architecture consists not in external control, but in the capacity of a determination to endure its contradiction, sublate it, and transform it into higher mediation.","refs":["CH_GB18_A_33:D2","CH_GB18_A_33:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_41:MRT-B01","text":"The extracted axioms suffice to reconstruct the overall movement from abstract identity and immediate being through contradiction, ground, and form to the limit-determination of matter.","refs":["CH_GB18_A_33:MRT1","CH_GB18_FUW0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MRT-B02","text":"The positive status of what follows after absolute necessity, the unconditioned, and matter remains underdetermined, because purpose and concept are marked as necessary but suspended forms of mediation.","refs":["CH_GB18_A_33:MRT2","CH_GB18_A_34:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MRT-B03","text":"The architecture is coherent insofar as contradiction is read as immanent self-negation, ground as real mediation, and form as reflection of essence.","refs":["CH_GB18_A_33:MRT3","CH_GB18_FUW0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MRT-B04","text":"Its strongest condensation lies in the connection of contradiction, negative unity, self-ground, and form, because destruction, production, and explanation thereby coincide within one mechanism.","refs":["CH_GB18_A_33:MRT4","CH_GB18_FUW0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_41:MRT-B05","text":"The reconstruction remains dependent upon the sequence of positing, negation, sublation, and restoration; without this recursive movement, ground, form, and matter would again be misunderstood as external objects.","refs":["CH_GB18_A_33:MRT6","CH_GB18_FUW0:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_41@R001","source_variant_id":"canonical:CL_GB18_41:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 121–123","context":"Anmerkung 3. · Anmerkung. · a. Form und Wesen."},"title_language_code":"en"},{"id":"CL_GB18_42","layer":"CL","title":"Chapters 124–126","order":42,"parents":["CH_GB18_BFUM","CH_GB18_CFUI","CH_GB18_DFG0"],"revision":"CL_GB18_42@R001","sha256":"776882122ffe740e4f14eeefcbdf6b693312c3e1959f1d84fc5eeaefd0123d63","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_42:AS-B01","text":"Der Cluster bestimmt die Differenz von Form, Materie, Inhalt, Grund und Begründetem so, dass kein Moment als selbständiger erster Träger der anderen gelten kann.","refs":["CH_GB18_BFUM:AS1","CH_GB18_DFG0:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AS-B02","text":"Die globale These lautet, dass jede scheinbar eigenständige Bestimmung nur als gesetzte Position einer negativen Selbstvermittlung besteht und in eine umfassendere Grundrelation zurückkehrt.","refs":["CH_GB18_BFUM:AS4","CH_GB18_CFUI:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AS-B03","text":"Die Bewegung ist rekursiv und kumulativ: Form und Materie negieren ihre Selbständigkeit, Inhalt absorbiert ihre Einheit, und negative Reflexion transformiert diese Einheit in Grundbestimmtheit.","refs":["CH_GB18_BFUM:AS5","CH_GB18_CFUI:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AS-B04","text":"Die Schließung erzeugt keinen ruhenden Ursprung, sondern einen bestimmten Grund, dessen doppelte Bestimmtheit als Form und Inhalt eine fortbestehende Differenz von formaler Identität und inhaltlicher Äußerlichkeit enthält.","refs":["CH_GB18_CFUI:A16","CH_GB18_DFG0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_42:GA-01","text":"[Persistent] Form und Materie sind keine selbständigen Prinzipien, sondern wechselseitig vorausgesetzte Positionen einer einzigen Vermittlungsbewegung.","refs":["CH_GB18_DFG0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-02","text":"[Mutating] Materie mutiert von abstrakter, formloser Identität zu formierter Materie und bleibt nur als aufgehobene Formnegativität bestimmbar.","refs":["CH_GB18_BFUM:A3","CH_GB18_CFUI:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-03","text":"[Mutating] Form mutiert von bestimmender Tätigkeit zu einer umfassenden Grundrelation, in welcher frühere Gegenpole als ihre eigenen Bestimmungen wiederkehren.","refs":["CH_GB18_CFUI:A2","CH_GB18_CFUI:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-04","text":"[Emergent] Inhalt ist weder ein drittes Substrat noch eine bloße Zusammensetzung, sondern die negative Rücknahme der Form-Materie-Differenz in eine Grundidentität.","refs":["CH_GB18_BFUM:SD4","CH_GB18_CFUI:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-05","text":"[Persistent] Grund und Begründetes enthalten denselben bestimmten Inhalt und unterscheiden sich ausschließlich als reversible Formpositionen.","refs":["CH_GB18_DFG0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-06","text":"[Attractor] Jede scheinbare Äußerlichkeit wird in eine immanente Relation umcodiert, indem sie als vorläufige Gestalt einer tieferen Selbstvermittlung erscheint.","refs":["CH_GB18_CFUI:ALT3","CH_GB18_CFUI:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-07","text":"[Terminal] Der bestimmte Grund entsteht erst, wenn seine Bestimmtheit in Form und Inhalt verdoppelt wird und beide Seiten als Momente derselben Grundstruktur fungieren.","refs":["CH_GB18_CFUI:A16","CH_GB18_CFUI:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-08","text":"[Persistent] Zureichendheit bezeichnet keine inhaltliche Mehrleistung des Grundes, sondern die Geschlossenheit einer Vermittlung, in der keine Seite einen zusätzlichen Inhalt besitzt.","refs":["CH_GB18_DFG0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-09","text":"[Attractor] Ein absolut erster Anfang bleibt ausgeschlossen, weil jede Bestimmung nur durch die Voraussetzung ihres Anderen und dessen Rücknahme in sich selbst besteht.","refs":["CH_GB18_DFG0:SD1","CH_GB18_BFUM:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-10","text":"[Terminal] Der formelle Grund bewahrt die Differenz von Form und Inhalt als Restäußerlichkeit; gerade diese Nichtdeckung verhindert, dass die erreichte Formidentität als vollständige Realidentität missverstanden wird.","refs":["CH_GB18_DFG0:A14","CH_GB18_DFG0:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_42:RMD-01","text":"[Mutation] Form kehrt nicht als dieselbe Tätigkeit wieder: Sie verschiebt sich von der bestimmenden Negativität über die Reflexionsform zur umfassenden Grundbeziehung.","refs":["CH_GB18_BFUM:A8","CH_GB18_CFUI:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RMD-02","text":"[Mutation] Materie bleibt als Moment der Gleichgültigkeit erhalten, verliert jedoch ihren Status als abstrakte Grundlage und wird zur formierten Bestimmung innerhalb des Inhalts.","refs":["CH_GB18_BFUM:A1","CH_GB18_CFUI:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RMD-03","text":"[Emergenz] Inhalt erscheint zunächst als gesetzte Einheit der aufgehobenen Form-Materie-Differenz und wird anschließend zur wesentlichen Form des Grundes.","refs":["CH_GB18_BFUM:AS7","CH_GB18_CFUI:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RMD-04","text":"[Absorption] Der absolute Grund der Form-Materie-Bewegung wird im formellen Grund in eine reversible Vermittlungsstruktur überführt, deren Seiten denselben Inhalt tragen.","refs":["CH_GB18_BFUM:AS4","CH_GB18_DFG0:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RMD-05","text":"[Umkehrung] Aktivität und Passivität verlieren ihre ontologische Rollenfixierung und werden zu wechselnden Setzungsweisen innerhalb einer einzigen Vermittlung.","refs":["CH_GB18_BFUM:SD2","CH_GB18_DFG0:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RMD-06","text":"[Terminale Transformation] Die Gleichgültigkeit des Inhalts wandelt sich von einem Schein äußerer Trennung in die notwendige Restdifferenz, durch welche die Zureichendheit des formellen Grundes begrenzt bleibt.","refs":["CH_GB18_DFG0:A12","CH_GB18_DFG0:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_42:CGD-01","text":"[Lokal] Die Abstraktion der Materie von aller Form beschreibt einen spezifischen Übergangsmechanismus; [Cluster-Ebene] tragend wird nur, dass jede materielle Selbständigkeit bereits eine vermittelte Formbestimmung ist.","refs":["CH_GB18_BFUM:A2","CH_GB18_CFUI:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:CGD-02","text":"[Lokal] Die Folge Wesen, Materie, Inhalt bezeichnet eine interne Sequenz der Formanalyse; [Cluster-Ebene] entscheidend ist die wiederholte Unterstellung jeder Selbständigkeit unter Form und Grund.","refs":["CH_GB18_CFUI:AS4","CH_GB18_CFUI:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:CGD-03","text":"[Lokal] Die Asymmetrie von Formtätigkeit und materieller Passivität organisiert die erste Darstellung; [Cluster-Ebene] wird sie als Schein einer gemeinsamen Negativität aufgehoben.","refs":["CH_GB18_BFUM:AS5","CH_GB18_BFUM:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:CGD-04","text":"[Lokal] Die Reversibilität von Grund und Begründetem ist der Mechanismus des formellen Grundes; [Cluster-Ebene] fungiert sie als Ausschluss jedes einseitigen Ursprungs.","refs":["CH_GB18_DFG0:D5","CH_GB18_DFG0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:CGD-05","text":"[Lokal] Die Äußerlichkeit des Inhalts gegenüber der Form markiert die Begrenzung des formellen Grundes; [Cluster-Ebene] wird sie zur notwendigen Spannung, die vollständige Identität verhindert.","refs":["CH_GB18_DFG0:A14","CH_GB18_DFG0:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_42:GNX-01","text":"Ausgeschlossen ist ein Dualismus, in dem Form und Materie als unabhängig konstituierte Substanzen nachträglich in Beziehung träten.","refs":["CH_GB18_BFUM:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GNX-02","text":"Ausgeschlossen ist ein Empirismus, in dem Materie als vorformaler, unmittelbar gegebener Stoff die Grundrelation begründen könnte.","refs":["CH_GB18_BFUM:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GNX-03","text":"Ausgeschlossen ist ein lineares Grundmodell, in dem Grund und Begründetes feste, nicht reversible Positionen besetzen.","refs":["CH_GB18_BFUM:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GNX-04","text":"Ausgeschlossen sind reiner Inhalt ohne Formbestimmung und reiner Grund ohne Inhalt, weil beide Abstraktionen die Vermittlung zerstören.","refs":["CH_GB18_CFUI:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GNX-05","text":"Ausgeschlossen ist ein erklärender Überschuss, durch den der Grund dem Begründeten mehr Inhalt liefern würde, als in dessen Bestimmtheit bereits enthalten ist.","refs":["CH_GB18_DFG0:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_42:DBN-01","text":"Falsch sein muss die Annahme einer unmittelbaren Einheit, die ohne Entzweiung, Negation und gesetzte Rückkehr bestehen könnte.","refs":["CH_GB18_BFUM:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:DBN-02","text":"Falsch sein muss eine Identität, die ihre eigenen Bestimmungen nicht durchläuft, setzt und in sich zurücknimmt.","refs":["CH_GB18_CFUI:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:DBN-03","text":"Falsch sein muss ein Grund, der dem Begründeten als inhaltlich höherer oder zusätzlicher Träger gegenübersteht.","refs":["CH_GB18_DFG0:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:DBN-04","text":"Falsch sein muss die Annahme, dass ein einfacher Inhalt seine Grundform aus eigener Positivität hervorbringt, ohne negative Selbstvermittlung zu benötigen.","refs":["CH_GB18_DFG0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_42:BSA-01","text":"Unverfügbar bleibt ein absoluter erster Anfang in Form reiner Materie, reiner Form oder eines bereits fertigen Grundes.","refs":["CH_GB18_BFUM:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:BSA-02","text":"Unverfügbar bleibt ein äußerer Standpunkt, von dem aus Form, Inhalt und Grund als unabhängig fixierbare Gegenstände bestimmt werden könnten.","refs":["CH_GB18_CFUI:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:BSA-03","text":"Versperrt bleibt ein positiv ruhender Grund, der seine Bestimmungen nicht negativ hervorbringen und zurücknehmen müsste.","refs":["CH_GB18_BFUM:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:BSA-04","text":"Unzulässig bleibt die restlose Koinzidenz von Inhalt und Grundform, weil die Äußerlichkeit des Inhalts die formelle Grundrelation erst konstituiert.","refs":["CH_GB18_DFG0:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_42:XD-01","text":"Der Inhalt vermittelt den Übergang von der aufgehobenen Form-Materie-Differenz zur Grundrelation, weil er deren Resultat nicht konserviert, sondern durch negative Reflexion in Grundidentität transformiert.  ; Trace Type — Composite.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-04","CL_GB18_42:GA-06","CH_GB18_BFUM:AS7","CH_GB18_CFUI:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:XD-02","text":"Das Grundverhältnis übersetzt die negative Selbstbewegung von Form und Materie in eine Form der Begründung, in der Erklären keine Inhaltsproduktion, sondern die doppelte Darstellbarkeit desselben Inhalts bedeutet.  ; Trace Type — Composite.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-05","CL_GB18_42:GA-08","CH_GB18_BFUM:SD1","CH_GB18_DFG0:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:XD-03","text":"Gleichgültigkeit fungiert nicht einheitlich, sondern als beweglicher Grenzoperator: zuerst als Abstraktion der Materie, dann als vorläufige Selbständigkeit des Inhalts und schließlich als Restäußerlichkeit des formellen Grundes.  ; Trace Type — Tension.","refs":["CL_GB18_42:GA-02","CL_GB18_42:GA-04","CL_GB18_42:GA-10","CH_GB18_BFUM:A1","CH_GB18_CFUI:A9","CH_GB18_DFG0:A14"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:XD-04","text":"Der Grund wird nicht vorausgesetzt, sondern erzeugt sich als Resultat der Selbstentzweiung und Rückkehr seiner Momente; seine Bestimmtheit ist daher die Spur einer durchlaufenen Negation.  ; Trace Type — Composite.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-06","CL_GB18_42:GA-07","CH_GB18_BFUM:D6","CH_GB18_CFUI:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:XD-05","text":"Die Grenze des formellen Grundes ist produktiv: Die formale Geschlossenheit seiner Vermittlung beruht gerade darauf, dass die inhaltliche Äußerlichkeit nicht aufgehoben werden darf.  ; Trace Type — Tension.","refs":["CL_GB18_42:GA-08","CL_GB18_42:GA-10","CH_GB18_DFG0:A12","CH_GB18_DFG0:MRT6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_42:BSD-01","text":"Realität erscheint als Feld gesetzter Positionen, nicht als Sammlung selbständiger Dinge: Unterschiede bestehen nur als Funktionen einer Einheit, die sich in ihnen entzweit und vermittelt.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-04","CL_GB18_42:GA-05","CH_GB18_BFUM:ME1","CH_GB18_DFG0:ME1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:BSD-02","text":"Zeitlichkeit ist keine lineare Folge von Ursprung und Wirkung, sondern die logische Rekursion von Voraussetzung, Setzung, Rückgang und erneuter Bestimmung.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-09","CH_GB18_BFUM:ALT4","CH_GB18_DFG0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:BSD-03","text":"Erkenntnis wird als immanente Umschrift begriffen: Etwas begründen heißt, denselben Inhalt in seiner gesetzten und reflektierten Form auszuweisen, nicht eine fremde Ursache hinzuzufügen.","refs":["CL_GB18_42:GA-05","CL_GB18_42:GA-08","CH_GB18_DFG0:SD2","CH_GB18_DFG0:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:BSD-04","text":"Die Methode des Clusters ist negative Reklassifikation: Jede äußere Opposition wird nicht widerlegt, indem sie entfernt wird, sondern indem sie als interne Funktion einer umfassenderen Vermittlung erscheint.","refs":["CL_GB18_42:GA-03","CL_GB18_42:GA-06","CH_GB18_CFUI:ALT3","CH_GB18_DFG0:SNX1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_42:RLE-01","text":"Form und Materie bilden eine erste Schleife: Entgegensetzung erzeugt wechselseitige Voraussetzung, diese hebt die Selbständigkeit beider auf und setzt ihre Einheit als Inhalt.","refs":["CH_GB18_BFUM:FGS6","CH_GB18_BFUM:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RLE-02","text":"Inhalt bildet eine zweite Schleife: Das in ihm zurückgenommene Gesetztsein wird zur Grundidentität und kehrt als Bestimmtheit des Grundes wieder.","refs":["CH_GB18_CFUI:D3","CH_GB18_CFUI:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RLE-03","text":"Grund und Begründetes bilden eine dritte Schleife: Das Gesetzte geht in den Grund zurück, während der Grund sich zugleich selbst als Gesetztes hervorbringt.","refs":["CH_GB18_DFG0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RLE-04","text":"Der Attraktor der Bewegung ist die negative Reflexion, weil sie Gleichgültigkeit nicht tilgt, sondern in Grundidentität überführt und damit neue Bestimmtheit erzeugt.","refs":["CH_GB18_CFUI:A13","CH_GB18_CFUI:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RLE-05","text":"Der formelle Grund ist ein instabiler Attraktor: Er erreicht vollständige formale Vermittlung, behält aber die inhaltliche Äußerlichkeit, die seine weitere Transformation notwendig macht.","refs":["CH_GB18_DFG0:D8","CH_GB18_DFG0:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_42:FGS-B01","text":"Abstraktion der Materie → Materie erscheint als formlose Identität, die ihre Bestimmbarkeit nur durch aufgehobene Form besitzt.","refs":["CH_GB18_BFUM:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FGS-B02","text":"Formsetzung + Materievoraussetzung → Jede Seite enthält ihr Anderes als Bedingung ihrer eigenen Bestimmtheit.","refs":["CH_GB18_BFUM:A4","CH_GB18_BFUM:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FGS-B03","text":"Wechselseitige Negation der Selbständigkeit → Form und Materie werden als Momente einer einzigen Vermittlungsbewegung bestimmt.","refs":["CH_GB18_BFUM:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FGS-B04","text":"Gesetzte Einheit von Form und Materie → Inhalt → negative Reflexion der Formbestimmungen in eine Grundidentität.","refs":["CH_GB18_BFUM:AS7","CH_GB18_CFUI:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FGS-B05","text":"Grundidentität + gleicher bestimmter Inhalt → Grund und Begründetes als reversible Formseiten einer vollständigen Vermittlung.","refs":["CH_GB18_DFG0:A8","CH_GB18_DFG0:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FGS-B06","text":"Formale Vermittlung ohne eigene Inhaltsdifferenz → eingeschränkte Zureichendheit → formeller Grund mit fortbestehender Äußerlichkeit des Inhalts.","refs":["CH_GB18_DFG0:A13","CH_GB18_DFG0:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_42:AFM-B01","text":"Entgegensetzung von Form und Materie → Zurückweisung ihrer äußeren Unabhängigkeit → wechselseitige Voraussetzung.","refs":["CH_GB18_BFUM:AS1","CH_GB18_BFUM:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AFM-B02","text":"Wechselseitige Voraussetzung → Aufhebung der getrennten Selbständigkeiten → Einheit als Inhalt.","refs":["CH_GB18_BFUM:A4","CH_GB18_BFUM:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AFM-B03","text":"Inhalt als gesetzte Einheit → negative Reflexion → Gleichgültigkeit wird Grundidentität.","refs":["CH_GB18_CFUI:D4","CH_GB18_CFUI:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AFM-B04","text":"Grundidentität → Verdopplung in Form und Inhalt → bestimmter Grund.","refs":["CH_GB18_CFUI:A16","CH_GB18_CFUI:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AFM-B05","text":"Gleicher Inhalt in zwei Formstellungen → reversible Vermittlung → Zureichendheit als formale Geschlossenheit → formeller Grund.","refs":["CH_GB18_DFG0:FGS7","CH_GB18_DFG0:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_42:MME-01","text":"Die Opposition Form/Materie wird von einer Relation zweier Dinge in die interne Differenz einer sich selbst vermittelnden Einheit umkartiert.","refs":["CH_GB18_BFUM:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MME-02","text":"Grund wird von einer einseitigen Ursache zu einer reversiblen Selbstbegründung umklassifiziert, in der Voraussetzung und Resultat ineinander übergehen.","refs":["CH_GB18_BFUM:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MME-03","text":"Inhalt wird vom vermeintlichen Gegenpol der Form zur Resultat- und Trägerbestimmung der Grundrelation transformiert.","refs":["CH_GB18_BFUM:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MME-04","text":"Zureichendheit wird von kausaler Überlegenheit zu vollständiger Inhaltsgleichheit in unterschiedlichen Formstellungen reorganisiert.","refs":["CH_GB18_DFG0:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_42:ALT-B01","text":"Surface level — Form bestimmt Materie, Materie erhält Bestimmtheit durch Form, und ein bestimmter Inhalt erscheint als Grund und Begründetes.","refs":["CH_GB18_BFUM:ALT1","CH_GB18_DFG0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:ALT-B02","text":"Structural level — Die Struktur besteht aus wechselseitiger Voraussetzung, negativer Vermittlung, Rückgang in den Grund und Verdopplung der Bestimmtheit.","refs":["CH_GB18_BFUM:ALT2","CH_GB18_DFG0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:ALT-B03","text":"Metastrategic level — Die Operation des Systems besteht darin, jede scheinbare Äußerlichkeit als vorläufige Darstellung einer immanenten Relation umzudeuten.","refs":["CH_GB18_CFUI:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:ALT-B04","text":"Ontological / Temporal level — Ursprünglichkeit existiert nur als Bewegung von Entzweiung, Setzung, Rückkehr und erneuter Bestimmung, nicht als ruhender Anfang.","refs":["CH_GB18_BFUM:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:ALT-B05","text":"Methodological / Performative level — Die rekonstruktiv-dialektische Form vollzieht ihre These, indem sie äußere Gegenüberstellungen seriell in innere Reflexionsbestimmungen transformiert.","refs":["CH_GB18_CFUI:AS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_42:FL-01","text":"Die erste Bruchlinie liegt zwischen der anfänglichen Asymmetrie von tätiger Form und passiver Materie und ihrer späteren Bestimmung als einer einzigen negativen Bewegung.","refs":["CH_GB18_BFUM:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FL-02","text":"Die zweite Bruchlinie liegt darin, dass Inhalt zugleich der Form gegenüber gleichgültig und ihre wesentliche Form innerhalb des Grundes sein soll.","refs":["CH_GB18_CFUI:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FL-03","text":"Die dritte Bruchlinie besteht darin, dass Grund und Begründetes inhaltlich identisch, als Formbestimmungen jedoch notwendig verschieden bleiben.","refs":["CH_GB18_DFG0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MP-01","text":"Der erste Mutationspunkt liegt in der Umformung der Materie von empirischem Stoff zu abstrakter Grundlage und immanenter Selbstnegativität.","refs":["CH_GB18_BFUM:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MP-02","text":"Der zweite Mutationspunkt liegt in der Umformung des Inhalts vom Resultat der aufgehobenen Differenz zur aktiven Grundidentität.","refs":["CH_GB18_BFUM:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MP-03","text":"Der dritte Mutationspunkt liegt in der Umformung der Form von einer bestimmenden Tätigkeit zu einer selbstvermittelnden Struktur, die ihren Inhalt voraussetzt und zugleich hervorbringt.","refs":["CH_GB18_DFG0:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_42:HSI-01","text":"Die Realität erscheint als negative Maschine, die sich in Bestimmungen entzweit, ihre eigenen Voraussetzungen produziert und ihre Differenzen als Vermittlungsmomente zurücknimmt.","refs":["CH_GB18_BFUM:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:HSI-02","text":"Eine souveräne Instanz des Begründens tritt nicht hervor; an ihre Stelle treten reversible Positionen desselben Inhalts, die nur in ihrer gegenseitigen Vermittlung bestehen.","refs":["CH_GB18_DFG0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:HSI-03","text":"Zeit erscheint als nichtlinearer Vollzug, in dem Ursprünglichkeit erst durch Rückkehr, Wiederholung und gesetzte Einheit erzeugt wird.","refs":["CH_GB18_BFUM:ALT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_42:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von Form und Materie über Inhalt und Grund bis zur formellen Geschlossenheit des bestimmten Grundes zu rekonstruieren.","refs":["CH_GB18_BFUM:MRT1","CH_GB18_DFG0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MRT-B02","text":"Unterbestimmt bleibt, warum die absolute Einheit notwendig gerade die Sequenz Form, Materie, Inhalt und Grund durchlaufen muss und nicht anders differenziert wird.","refs":["CH_GB18_BFUM:MRT2","CH_GB18_CFUI:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MRT-B03","text":"Die Rekonstruktion bleibt kohärent, sofern Identität und Unterschied auf verschiedene Ebenen verteilt werden: Identität innerhalb der Vermittlungsform, Unterschied als Äußerlichkeit ihres Inhalts.","refs":["CH_GB18_DFG0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MRT-B04","text":"Unverzichtbar bleibt die Restspannung von Form und Inhalt, weil ihre Tilgung die formelle Grundrelation in eine ungestützte vollständige Identität überführen würde.","refs":["CH_GB18_DFG0:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122443145563Z_b420d529","language_code":"en","language_name":"English","title":"Chapters 124–126","source_sha256":"776882122ffe740e4f14eeefcbdf6b693312c3e1959f1d84fc5eeaefd0123d63","sha256":"6675857489a40cc96d64cfdb039d411571e519d266d78b2169f7b3afa1cdf7d3","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:24:43.146964+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_42:AS-B01","text":"The cluster determines the difference of form, matter, content, ground, and grounded such that no moment can count as an independent first bearer of the others.","refs":["CH_GB18_BFUM:AS1","CH_GB18_DFG0:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AS-B02","text":"The global thesis is that every seemingly independent determination exists only as a posited position of a negative self-mediation and returns into a more comprehensive ground-relation.","refs":["CH_GB18_BFUM:AS4","CH_GB18_CFUI:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AS-B03","text":"The movement is recursive and cumulative: form and matter negate their independence, content absorbs their unity, and negative reflection transforms this unity into ground-determinacy.","refs":["CH_GB18_BFUM:AS5","CH_GB18_CFUI:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AS-B04","text":"The closure produces not a resting origin, but a determinate ground whose doubled determinacy as form and content contains a persisting difference of formal identity and substantive externality.","refs":["CH_GB18_CFUI:A16","CH_GB18_DFG0:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_42:GA-01","text":"[Persistent] Form and matter are not independent principles, but mutually presupposed positions of a single movement of mediation.","refs":["CH_GB18_DFG0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-02","text":"[Mutating] Matter mutates from abstract, formless identity into formed matter and remains determinable only as sublated form-negativity.","refs":["CH_GB18_BFUM:A3","CH_GB18_CFUI:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-03","text":"[Mutating] Form mutates from determining activity into a comprehensive ground-relation in which earlier opposites return as its own determinations.","refs":["CH_GB18_CFUI:A2","CH_GB18_CFUI:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-04","text":"[Emergent] Content is neither a third substrate nor a mere composition, but the negative withdrawal of the form-matter difference into a ground-identity.","refs":["CH_GB18_BFUM:SD4","CH_GB18_CFUI:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-05","text":"[Persistent] Ground and grounded contain the same determinate content and differ exclusively as reversible formal positions.","refs":["CH_GB18_DFG0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-06","text":"[Attractor] Every apparent externality is recoded into an immanent relation by appearing as a provisional shape of a deeper self-mediation.","refs":["CH_GB18_CFUI:ALT3","CH_GB18_CFUI:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-07","text":"[Terminal] The determinate ground arises only when its determinacy is doubled in form and content and both sides function as moments of the same ground-structure.","refs":["CH_GB18_CFUI:A16","CH_GB18_CFUI:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-08","text":"[Persistent] Sufficiency designates no surplus of content on the part of the ground, but the closure of a mediation in which no side possesses an additional content.","refs":["CH_GB18_DFG0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-09","text":"[Attractor] An absolutely first beginning remains excluded, because every determination exists only through the presupposition of its other and that other's withdrawal into itself.","refs":["CH_GB18_DFG0:SD1","CH_GB18_BFUM:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GA-10","text":"[Terminal] The formal ground preserves the difference of form and content as residual externality; precisely this non-coincidence prevents the attained formal identity from being misunderstood as complete real identity.","refs":["CH_GB18_DFG0:A14","CH_GB18_DFG0:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_42:RMD-01","text":"[Mutation] Form does not return as the same activity: it shifts from determining negativity through the form of reflection to the comprehensive ground-relation.","refs":["CH_GB18_BFUM:A8","CH_GB18_CFUI:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RMD-02","text":"[Mutation] Matter persists as a moment of indifference, but loses its status as abstract foundation and becomes formed determination within content.","refs":["CH_GB18_BFUM:A1","CH_GB18_CFUI:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RMD-03","text":"[Emergence] Content first appears as the posited unity of the sublated form-matter difference and subsequently becomes the essential form of the ground.","refs":["CH_GB18_BFUM:AS7","CH_GB18_CFUI:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RMD-04","text":"[Absorption] The absolute ground of the form-matter movement is transferred in the formal ground into a reversible structure of mediation whose sides bear the same content.","refs":["CH_GB18_BFUM:AS4","CH_GB18_DFG0:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RMD-05","text":"[Reversal] Activity and passivity lose their ontological fixation of roles and become alternating modes of positing within a single mediation.","refs":["CH_GB18_BFUM:SD2","CH_GB18_DFG0:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RMD-06","text":"[Terminal Transformation] The indifference of content changes from an appearance of external separation into the necessary residual difference through which the sufficiency of the formal ground remains limited.","refs":["CH_GB18_DFG0:A12","CH_GB18_DFG0:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_42:CGD-01","text":"[Local] The abstraction of matter from all form describes a specific transitional mechanism; [Cluster level] what is load-bearing is only that every material independence is already a mediated form-determination.","refs":["CH_GB18_BFUM:A2","CH_GB18_CFUI:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:CGD-02","text":"[Local] The sequence essence, matter, content designates an internal sequence of the analysis of form; [Cluster level] decisive is the repeated subordination of every independence to form and ground.","refs":["CH_GB18_CFUI:AS4","CH_GB18_CFUI:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:CGD-03","text":"[Local] The asymmetry of formative activity and material passivity organizes the first exposition; [Cluster level] it is sublated as the appearance of a common negativity.","refs":["CH_GB18_BFUM:AS5","CH_GB18_BFUM:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:CGD-04","text":"[Local] The reversibility of ground and grounded is the mechanism of the formal ground; [Cluster level] it functions as the exclusion of every one-sided origin.","refs":["CH_GB18_DFG0:D5","CH_GB18_DFG0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:CGD-05","text":"[Local] The externality of content in relation to form marks the limitation of the formal ground; [Cluster level] it becomes the necessary tension that prevents complete identity.","refs":["CH_GB18_DFG0:A14","CH_GB18_DFG0:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_42:GNX-01","text":"Excluded is a dualism in which form and matter would enter into relation only subsequently as independently constituted substances.","refs":["CH_GB18_BFUM:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GNX-02","text":"Excluded is an empiricism in which matter, as pre-formal and immediately given stuff, could ground the fundamental relation.","refs":["CH_GB18_BFUM:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GNX-03","text":"Excluded is a linear model of ground in which ground and grounded occupy fixed, non-reversible positions.","refs":["CH_GB18_BFUM:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GNX-04","text":"Excluded are pure content without form-determination and pure ground without content, because both abstractions destroy mediation.","refs":["CH_GB18_CFUI:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:GNX-05","text":"Excluded is an explanatory surplus through which the ground would supply the grounded with more content than is already contained in its determinacy.","refs":["CH_GB18_DFG0:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_42:DBN-01","text":"False must be the assumption of an immediate unity that could exist without diremption, negation, and posited return.","refs":["CH_GB18_BFUM:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:DBN-02","text":"False must be an identity that does not traverse, posit, and withdraw into itself its own determinations.","refs":["CH_GB18_CFUI:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:DBN-03","text":"False must be a ground that confronts the grounded as a bearer higher in content or as an additional bearer.","refs":["CH_GB18_DFG0:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:DBN-04","text":"False must be the assumption that a simple content produces its ground-form out of its own positivity without requiring negative self-mediation.","refs":["CH_GB18_DFG0:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_42:BSA-01","text":"An absolutely first beginning in the form of pure matter, pure form, or an already finished ground remains unavailable.","refs":["CH_GB18_BFUM:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:BSA-02","text":"An external standpoint from which form, content, and ground could be determined as independently fixable objects remains unavailable.","refs":["CH_GB18_CFUI:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:BSA-03","text":"A positively resting ground that would not have to produce and withdraw its determinations negatively remains barred.","refs":["CH_GB18_BFUM:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:BSA-04","text":"The complete coincidence of content and ground-form remains inadmissible, because the externality of content first constitutes the formal ground-relation.","refs":["CH_GB18_DFG0:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_42:XD-01","text":"Content mediates the transition from the sublated form-matter difference to the ground-relation, because it does not preserve its result but transforms it through negative reflection into ground-identity.  ; Trace Type — Composite.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-04","CL_GB18_42:GA-06","CH_GB18_BFUM:AS7","CH_GB18_CFUI:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:XD-02","text":"The ground-relation translates the negative self-movement of form and matter into a form of grounding in which explaining signifies not the production of content but the double presentability of the same content.  ; Trace Type — Composite.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-05","CL_GB18_42:GA-08","CH_GB18_BFUM:SD1","CH_GB18_DFG0:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:XD-03","text":"Indifference does not function uniformly, but as a mobile boundary operator: first as abstraction of matter, then as provisional independence of content, and finally as residual externality of the formal ground.  ; Trace Type — Tension.","refs":["CL_GB18_42:GA-02","CL_GB18_42:GA-04","CL_GB18_42:GA-10","CH_GB18_BFUM:A1","CH_GB18_CFUI:A9","CH_GB18_DFG0:A14"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:XD-04","text":"The ground is not presupposed, but produces itself as the result of the self-diremption and return of its moments; its determinacy is therefore the trace of a traversed negation.  ; Trace Type — Composite.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-06","CL_GB18_42:GA-07","CH_GB18_BFUM:D6","CH_GB18_CFUI:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:XD-05","text":"The limit of the formal ground is productive: the formal closure of its mediation rests precisely on the fact that substantive externality may not be sublated.  ; Trace Type — Tension.","refs":["CL_GB18_42:GA-08","CL_GB18_42:GA-10","CH_GB18_DFG0:A12","CH_GB18_DFG0:MRT6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_42:BSD-01","text":"Reality appears as a field of posited positions, not as a collection of independent things: differences exist only as functions of a unity that dirempts and mediates itself in them.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-04","CL_GB18_42:GA-05","CH_GB18_BFUM:ME1","CH_GB18_DFG0:ME1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:BSD-02","text":"Temporality is not a linear sequence of origin and effect, but the logical recursion of presupposition, positing, return, and renewed determination.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-09","CH_GB18_BFUM:ALT4","CH_GB18_DFG0:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:BSD-03","text":"Cognition is conceived as immanent re-inscription: to ground something means to exhibit the same content in its posited and reflected form, not to add an alien cause.","refs":["CL_GB18_42:GA-05","CL_GB18_42:GA-08","CH_GB18_DFG0:SD2","CH_GB18_DFG0:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_42:BSD-04","text":"The method of the cluster is negative reclassification: every external opposition is not refuted by being removed, but by appearing as an internal function of a more comprehensive mediation.","refs":["CL_GB18_42:GA-03","CL_GB18_42:GA-06","CH_GB18_CFUI:ALT3","CH_GB18_DFG0:SNX1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_42:RLE-01","text":"Form and matter form a first loop: opposition produces mutual presupposition, this sublates the independence of both and posits their unity as content.","refs":["CH_GB18_BFUM:FGS6","CH_GB18_BFUM:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RLE-02","text":"Content forms a second loop: the positedness withdrawn into it becomes ground-identity and returns as the determinacy of the ground.","refs":["CH_GB18_CFUI:D3","CH_GB18_CFUI:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RLE-03","text":"Ground and grounded form a third loop: the posited returns into the ground, while the ground simultaneously produces itself as posited.","refs":["CH_GB18_DFG0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RLE-04","text":"The attractor of the movement is negative reflection, because it does not eliminate indifference but transfers it into ground-identity and thereby generates new determinacy.","refs":["CH_GB18_CFUI:A13","CH_GB18_CFUI:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:RLE-05","text":"The formal ground is an unstable attractor: it attains complete formal mediation, yet retains the substantive externality that makes its further transformation necessary.","refs":["CH_GB18_DFG0:D8","CH_GB18_DFG0:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_42:FGS-B01","text":"Abstraction of matter → Matter appears as formless identity, which possesses its determinability only through sublated form.","refs":["CH_GB18_BFUM:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FGS-B02","text":"Positing of form + presupposition of matter → Each side contains its other as the condition of its own determinacy.","refs":["CH_GB18_BFUM:A4","CH_GB18_BFUM:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FGS-B03","text":"Mutual negation of independence → Form and matter are determined as moments of a single movement of mediation.","refs":["CH_GB18_BFUM:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FGS-B04","text":"Posited unity of form and matter → Content → negative reflection of form-determinations into a ground-identity.","refs":["CH_GB18_BFUM:AS7","CH_GB18_CFUI:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FGS-B05","text":"Ground-identity + same determinate content → Ground and grounded as reversible formal sides of a complete mediation.","refs":["CH_GB18_DFG0:A8","CH_GB18_DFG0:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FGS-B06","text":"Formal mediation without its own difference of content → limited sufficiency → formal ground with persisting externality of content.","refs":["CH_GB18_DFG0:A13","CH_GB18_DFG0:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_42:AFM-B01","text":"Opposition of form and matter → rejection of their external independence → mutual presupposition.","refs":["CH_GB18_BFUM:AS1","CH_GB18_BFUM:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AFM-B02","text":"Mutual presupposition → sublation of separate independences → unity as content.","refs":["CH_GB18_BFUM:A4","CH_GB18_BFUM:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AFM-B03","text":"Content as posited unity → negative reflection → indifference becomes ground-identity.","refs":["CH_GB18_CFUI:D4","CH_GB18_CFUI:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AFM-B04","text":"Ground-identity → doubling into form and content → determinate ground.","refs":["CH_GB18_CFUI:A16","CH_GB18_CFUI:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:AFM-B05","text":"Same content in two formal positions → reversible mediation → sufficiency as formal closure → formal ground.","refs":["CH_GB18_DFG0:FGS7","CH_GB18_DFG0:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_42:MME-01","text":"The opposition form/matter is remapped from a relation of two things into the internal difference of a self-mediating unity.","refs":["CH_GB18_BFUM:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MME-02","text":"Ground is reclassified from a one-sided cause into a reversible self-grounding in which presupposition and result pass over into one another.","refs":["CH_GB18_BFUM:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MME-03","text":"Content is transformed from the alleged opposite of form into the result-determination and bearer-determination of the ground-relation.","refs":["CH_GB18_BFUM:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MME-04","text":"Sufficiency is reorganized from causal superiority into complete equality of content in differing formal positions.","refs":["CH_GB18_DFG0:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_42:ALT-B01","text":"Surface level — Form determines matter, matter receives determinacy through form, and a determinate content appears as ground and grounded.","refs":["CH_GB18_BFUM:ALT1","CH_GB18_DFG0:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:ALT-B02","text":"Structural level — The structure consists of mutual presupposition, negative mediation, return into the ground, and doubling of determinacy.","refs":["CH_GB18_BFUM:ALT2","CH_GB18_DFG0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:ALT-B03","text":"Metastrategic level — The operation of the system consists in reinterpreting every apparent externality as a provisional presentation of an immanent relation.","refs":["CH_GB18_CFUI:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:ALT-B04","text":"Ontological / Temporal level — Originality exists only as the movement of diremption, positing, return, and renewed determination, not as a resting beginning.","refs":["CH_GB18_BFUM:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:ALT-B05","text":"Methodological / Performative level — The reconstructive-dialectical form enacts its thesis by serially transforming external oppositions into internal determinations of reflection.","refs":["CH_GB18_CFUI:AS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_42:FL-01","text":"The first fault line lies between the initial asymmetry of active form and passive matter and their later determination as a single negative movement.","refs":["CH_GB18_BFUM:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FL-02","text":"The second fault line lies in the fact that content is supposed simultaneously to be indifferent toward form and its essential form within the ground.","refs":["CH_GB18_CFUI:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:FL-03","text":"The third fault line consists in the fact that ground and grounded remain identical in content but necessarily different as form-determinations.","refs":["CH_GB18_DFG0:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MP-01","text":"The first mutation point lies in the transformation of matter from empirical stuff into abstract foundation and immanent self-negativity.","refs":["CH_GB18_BFUM:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MP-02","text":"The second mutation point lies in the transformation of content from the result of the sublated difference into active ground-identity.","refs":["CH_GB18_BFUM:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MP-03","text":"The third mutation point lies in the transformation of form from a determining activity into a self-mediating structure that presupposes and simultaneously produces its content.","refs":["CH_GB18_DFG0:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_42:HSI-01","text":"Reality appears as a negative machine that dirempts itself into determinations, produces its own presuppositions, and withdraws its differences as moments of mediation.","refs":["CH_GB18_BFUM:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:HSI-02","text":"A sovereign instance of grounding does not emerge; in its place appear reversible positions of the same content, which exist only in their reciprocal mediation.","refs":["CH_GB18_DFG0:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:HSI-03","text":"Time appears as a nonlinear enactment in which originality is first produced through return, repetition, and posited unity.","refs":["CH_GB18_BFUM:ALT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_42:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from form and matter through content and ground to the formal closure of the determinate ground.","refs":["CH_GB18_BFUM:MRT1","CH_GB18_DFG0:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MRT-B02","text":"It remains underdetermined why absolute unity must necessarily traverse precisely the sequence form, matter, content, and ground, and is not differentiated otherwise.","refs":["CH_GB18_BFUM:MRT2","CH_GB18_CFUI:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MRT-B03","text":"The reconstruction remains coherent provided that identity and difference are distributed across different levels: identity within the form of mediation, difference as the externality of its content.","refs":["CH_GB18_DFG0:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_42:MRT-B04","text":"The residual tension of form and content remains indispensable, because its elimination would transfer the formal ground-relation into an unsupported complete identity.","refs":["CH_GB18_DFG0:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_42@R001","source_variant_id":"canonical:CL_GB18_42:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 124–126","context":"b. Form und Materie. · c. Form und Inhalt. · a. Der formelle Grund."},"title_language_code":"en"},{"id":"CL_GB18_43","layer":"CL","title":"Chapters 127–129","order":43,"parents":["CH_GB18_A_35","CH_GB18_BDRG","CH_GB18_A_36"],"revision":"CL_GB18_43@R001","sha256":"3e776dedf1521d7c15e406af30ec3e1d7678c8a67bbc5ef619c73ef42b1fdc44","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_43:AS-B01","text":"Das System untersucht, ob ein Grund erklären kann, ohne entweder den Inhalt des Begründeten tautologisch zu verdoppeln oder dessen konkrete Bestimmtheit äußerlich vorauszusetzen.","refs":["CH_GB18_A_35:A2","CH_GB18_A_36:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B02","text":"Die formale Grundrelation bewahrt Notwendigkeit nur als Inhaltsidentität und verliert damit den Unterschied, den Erklärung leisten müsste.","refs":["CH_GB18_A_35:A3","CH_GB18_A_36:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B03","text":"Die reale Grundrelation durchbricht die Tautologie durch Inhaltsdifferenz, erzeugt aber einen Rest eigentümlicher Mannigfaltigkeit, deren Verbindung mit dem Grund nicht immanent begründet ist.","refs":["CH_GB18_BDRG:AS3","CH_GB18_A_36:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B04","text":"Der Übergang vom Grund zur Grundlage markiert die Einsicht, dass ein allgemeiner Inhalt das Bestehen eines Konkreten tragen kann, ohne dessen besondere Inhalte, Verknüpfungen und Folgen hervorzubringen.","refs":["CH_GB18_BDRG:SD2","CH_GB18_A_36:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B05","text":"Sobald die Grundform nicht aus dem Inhalt folgt, wird die Verteilung von Grund und Begründetem zu einer äußerlich zugeteilten, umkehrbaren und perspektivisch selektierbaren Relation.","refs":["CH_GB18_BDRG:A12","CH_GB18_A_36:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B06","text":"Die Bewegung ist spiralförmig: Phänomen wird zum Grund abstrahiert, der Grund wird als vorausliegend ausgegeben, seine äußere Unzulänglichkeit erzeugt neue Gründe, und deren Häufung verweist erneut auf das fehlende Ganze.","refs":["CH_GB18_A_35:SD1","CH_GB18_A_36:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B07","text":"Wissenschaftliche Erklärung, Raisonnement und institutionalisierte Prinzipien erscheinen als verschiedene Operationsfelder derselben Grundform: Sie stabilisieren selektierte Bestimmungen, ohne die konkrete Verknüpfung des Gegenstands zureichend zu erzeugen.","refs":["CH_GB18_A_35:SD3","CH_GB18_A_36:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B08","text":"Die Schließung bleibt negativ und terminal: Der Begriff wird als Name einer immanenten Einheit gefordert, die nicht als weiterer Einzelgrund auftreten darf, deren positive Bestimmung aber noch aussteht.","refs":["CH_GB18_A_36:AS5","CH_GB18_A_36:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_43:GA-01","text":"[Persistent] Erklärung verlangt eine Inhaltsdifferenz zwischen Grund und Begründetem; reine Wiederholung in der Form von Kraft, Gesetz oder Prinzip bleibt Tautologie.","refs":["CH_GB18_A_35:NX1","CH_GB18_BDRG:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-02","text":"[Mutating] Inhaltsdifferenz realisiert den Grund gegen die formale Tautologie, entzieht ihm aber zugleich die Fähigkeit, die gesamte Bestimmtheit des Begründeten immanent zu erzeugen.","refs":["CH_GB18_BDRG:D1","CH_GB18_A_36:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-03","text":"[Persistent] Das Begründete enthält einen wesentlichen Grundinhalt und einen eigentümlichen Zusatzinhalt, sodass seine Identität nicht mit der Erklärung seiner vollständigen Konkretion zusammenfällt.","refs":["CH_GB18_BDRG:A7","CH_GB18_BDRG:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-04","text":"[Mutating] Grund und Gesetztes sind keine aus ihren Inhalten unmittelbar ableitbaren Positionen, sondern Rollen, deren Zuweisung von einer äußerlichen Relation oder einem Dritten abhängt.","refs":["CH_GB18_BDRG:SD3","CH_GB18_A_36:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-05","text":"[Emergent] Ein Grund wird zur Grundlage, sobald er zwar einen allgemeinen oder wesentlichen Zusammenhang trägt, aber weder die besondere Mannigfaltigkeit noch ihre konkrete Verknüpfung hervorbringt.","refs":["CH_GB18_BDRG:SD5","CH_GB18_A_36:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-06","text":"[Attractor] Die Vielbestimmtheit des Konkreten erzeugt eine strukturelle Konkurrenz möglicher Gründe, weil mehrere wesentliche Teilbestimmungen gleich plausibel privilegiert werden können.","refs":["CH_GB18_A_36:A6","CH_GB18_A_36:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-07","text":"[Persistent] Die epistemische Umkehrung eines aus dem Phänomen gewonnenen Begriffs in einen angeblich vorausliegenden Grund entspricht der ontologischen Selbstäußerlichkeit der realen Grundform.","refs":["CH_GB18_A_35:D3","CH_GB18_BDRG:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-08","text":"[Terminal] Die Anhäufung von Gründen erzeugt keinen Abschluss, sondern ein unendliches Raisonnement, in dem entgegengesetzte Positionen gleichartig legitimierbar werden.","refs":["CH_GB18_A_36:SD2","CH_GB18_A_36:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-09","text":"[Attractor] Der Begriff bezeichnet die geforderte Einheit, in der Sache, Bestimmungen und Verknüpfung nicht äußerlich gekoppelt, sondern immanent zusammengehören.","refs":["CH_GB18_A_36:A9","CH_GB18_A_36:ALT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-10","text":"[Terminal] Der Begriff kann die Krise der Grundform nicht durch einen besseren Einzelgrund lösen, sondern nur durch Aufhebung der Form, die Gründe isoliert, verteilt und äußerlich verbindet.","refs":["CH_GB18_A_36:NX7","CH_GB18_A_36:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_43:RMD-01","text":"Die Inhaltsidentität kehrt zunächst als wissenschaftliche Umbenennung eines Phänomens und anschließend als formelle Notwendigkeit wieder; ihre Funktion mutiert von epistemischer Leere zu systematischer Grenze jeder bloß formalen Grundrelation.","refs":["CH_GB18_A_35:AS2","CH_GB18_A_36:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-02","text":"Die Inhaltsdifferenz erscheint zuerst als Bedingung eines realen Grundes, mutiert aber in der weiteren Bewegung zur Quelle von Zufälligkeit, weil der verschiedene Inhalt nicht mehr aus dem Grund hervorgeht.","refs":["CH_GB18_BDRG:AS3","CH_GB18_A_36:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-03","text":"Der eigentümliche Zusatzinhalt des Begründeten wird von einer logischen Differenzbestimmung zur allgemeinen Struktur konkreter Vielbestimmtheit erweitert, aus der konkurrierende Grundzuschreibungen entstehen.","refs":["CH_GB18_BDRG:A8","CH_GB18_A_36:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-04","text":"Die Umkehrung der Grundrichtung verschiebt sich von der wissenschaftlichen Darstellung, die Abgeleitetes als Prinzip ausgibt, zur allgemeinen Reversibilität von Grund und Gesetztem innerhalb äußerlich bestimmter Beziehungen.","refs":["CH_GB18_A_35:AS4","CH_GB18_A_36:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-05","text":"Die Differenz von hypothetischer Konstruktion und unmittelbarem Dasein wird in die weiterreichende Differenz von Inhalt und Grundform absorbiert: Nicht jeder verfügbare Inhalt besitzt dadurch begründende oder ontologische Priorität.","refs":["CH_GB18_A_35:A8","CH_GB18_A_36:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-06","text":"Das unbekannte innere Wesen verschwindet als positive Lösung, nachdem es seine negative Funktion erfüllt hat: Es exponiert, dass die Benennung von Kräften und Materien keine vermittelte Erkenntnis garantiert.","refs":["CH_GB18_A_35:A9","CH_GB18_A_35:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-07","text":"Der Begriff tritt nicht als stabiler Gegenstand auf, sondern als terminaler Attraktor, der aus der wiederholten Unzulänglichkeit formeller, realer und selektierter Gründe hervorgeht.","refs":["CH_GB18_A_36:SD4","CH_GB18_A_36:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_43:CGD-01","text":"Die Beispiele von Kräften, Materien, Kristallbildung und wissenschaftlichen Hypothesen bleiben lokale Demonstrationen; auf Clusterebene tragen sie nur die allgemeinere These, dass Benennung keine Erklärung erzeugt.","refs":["CH_GB18_A_35:D1","CH_GB18_A_35:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:CGD-02","text":"Die Unterscheidung von wesentlichem Grundinhalt und unwesentlicher Mannigfaltigkeit bleibt zunächst eine Bestimmung des realen Grundes, skaliert aber zur Einsicht, dass konkrete Gegenstände durch keinen isolierten Inhalt ausgeschöpft werden.","refs":["CH_GB18_BDRG:A10","CH_GB18_A_36:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:CGD-03","text":"Die wissenschaftliche Verkehrung der Darstellungsordnung wird auf Clusterebene zur allgemeinen Diagnose, dass epistemische Nachträglichkeit durch Grundrelationen in ontologische Vorrangigkeit umcodiert werden kann.","refs":["CH_GB18_A_35:SD2","CH_GB18_A_35:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:CGD-04","text":"Moralische, kausale, institutionelle und theologische Fälle bleiben lokale Erscheinungsweisen; ihre gemeinsame aktuelle Funktion besteht darin, die Selektierbarkeit von Gründen unabhängig vom jeweiligen Gegenstandsbereich sichtbar zu machen.","refs":["CH_GB18_A_36:ME3","CH_GB18_A_36:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:CGD-05","text":"Die positive Bestimmung des Begriffs wird nicht auf die aktuelle Ebene übertragen; global tragend ist allein seine negative Funktion als Grenze, an der die Grundform nicht weitergeführt werden kann.","refs":["CH_GB18_A_36:MRT2","CH_GB18_A_35:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_43:GNX-01","text":"Ausgeschlossen ist, dass die Übersetzung eines Phänomens in reflektierte Wesentlichkeit bereits Erkenntnisfortschritt oder Erklärung ausmacht.","refs":["CH_GB18_A_35:DNX1","CH_GB18_A_35:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GNX-02","text":"Ausgeschlossen ist, dass ein allgemeiner oder wesentlicher Inhalt die besondere Mannigfaltigkeit eines Konkreten und deren Verbindung notwendig hervorbringt.","refs":["CH_GB18_BDRG:DNX2","CH_GB18_A_36:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GNX-03","text":"Ausgeschlossen ist, dass die Rollen von Grund und Begründetem aus den verbundenen Inhalten selbst hervorgehen.","refs":["CH_GB18_BDRG:DNX4","CH_GB18_A_36:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GNX-04","text":"Ausgeschlossen ist, dass theoretische Konstruktionen, unbekannte Wesen oder institutionell anerkannte Prinzipien durch ihre Benennung den Rang unmittelbarer Wirklichkeit oder rationaler Notwendigkeit erhalten.","refs":["CH_GB18_A_35:NX4","CH_GB18_A_35:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GNX-05","text":"Ausgeschlossen ist, dass die Menge, Wesentlichkeit oder rhetorische Plausibilität einzelner Gründe eine zureichende Erkenntnis der Sache ersetzt.","refs":["CH_GB18_A_36:NX6","CH_GB18_A_36:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_43:DBN-01","text":"Das System kann keinen Grund zulassen, der zugleich völlig identisch mit seinem Begründeten und dennoch dessen konkrete Differenz erzeugend wäre.","refs":["CH_GB18_A_36:AS1","CH_GB18_BDRG:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:DBN-02","text":"Das System kann keine immanente Vermittlung behaupten, solange wesentlicher Inhalt und eigentümliche Mannigfaltigkeit nur äußerlich nebeneinanderstehen.","refs":["CH_GB18_BDRG:DNX1","CH_GB18_BDRG:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:DBN-03","text":"Das System kann keine endgültige Begründung anerkennen, deren Auswahlregel selbst außerhalb des Gegenstands liegt und durch ein weiteres Drittes nachgeliefert werden muss.","refs":["CH_GB18_BDRG:SNX3","CH_GB18_A_36:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:DBN-04","text":"Das System kann den Begriff nicht als zusätzlichen Grund zulassen, weil dies die isolierende und äußerliche Grundform reproduzieren würde, die er gerade überschreiten soll.","refs":["CH_GB18_A_36:A9","CH_GB18_A_36:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_43:BSA-01","text":"Unverfügbar bleibt ein selbstbegründender Anfang, der aus sich heraus sowohl die Notwendigkeit als auch die konkrete Differenz seines Gegenstands deduzieren könnte.","refs":["CH_GB18_A_35:SNX1","CH_GB18_BDRG:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:BSA-02","text":"Unverfügbar bleibt eine letzte Grundzuschreibung, weil jede isolierte Wesentlichkeit durch eine andere Rücksicht, ein weiteres Drittes oder die Umkehrung der Relation relativiert werden kann.","refs":["CH_GB18_A_36:DNX3","CH_GB18_A_36:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:BSA-03","text":"Abwesend bleibt eine positive Darstellung der Einheit, die Erklärung zureichend machen könnte; der Begriff erscheint nur als durch die Unmöglichkeit partikularer Gründe erzwungene Leerstelle.","refs":["CH_GB18_A_35:SNX3","CH_GB18_A_36:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_43:XD-01","text":"Formale Tautologie und reale Äußerlichkeit sind keine konkurrierenden Defekte zweier unterschiedlicher Erklärungsmodelle, sondern die entgegengesetzten Grenzzustände derselben Grundform.","refs":["CL_GB18_43:GA-01","CL_GB18_43:GA-02","CH_GB18_A_36:AS1","CH_GB18_A_36:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:XD-02","text":"Die Verkehrung, in der ein aus dem Phänomen abstrahierter Grund als vorausliegend erscheint, ist nicht bloß ein Darstellungsfehler, sondern die epistemische Gestalt der strukturellen Selbstäußerlichkeit des realen Grundes.","refs":["CL_GB18_43:GA-04","CL_GB18_43:GA-07","CH_GB18_A_35:D3","CH_GB18_BDRG:FGS10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:XD-03","text":"Der Übergang von Grund zu Grundlage erzeugt notwendig ein Selektionsproblem: Was den Gegenstand nicht vollständig begründet, kann nur unter einer äußerlich gesetzten Rücksicht als sein Grund fungieren.","refs":["CL_GB18_43:GA-05","CL_GB18_43:GA-06","CH_GB18_BDRG:SD2","CH_GB18_A_36:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:XD-04","text":"Die Verwechslung von Hypothese und Dasein sowie die Verteilung der Grundform durch ein Drittes erzeugen gemeinsam eine Kritik epistemischer Autorität: Geltung kann als Wirklichkeit oder Notwendigkeit erscheinen, obwohl sie nur relational zugeteilt ist.","refs":["CL_GB18_43:GA-04","CL_GB18_43:GA-07","CH_GB18_A_35:A8","CH_GB18_A_36:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:XD-05","text":"Die Möglichkeit, dieselbe Bestimmung für gegensätzliche Erscheinungen oder entgegengesetzte Positionen anzuführen, folgt nicht aus beliebiger Sophistik allein, sondern aus der strukturellen Partialität jedes isolierten Grundes.","refs":["CL_GB18_43:GA-06","CL_GB18_43:GA-08","CH_GB18_A_36:D3","CH_GB18_A_36:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:XD-06","text":"Der Begriff wird gerade dadurch notwendig, dass er nicht als ein weiterer Grund unter mehreren fungieren darf; seine Funktion ist die negative Aufhebung des Feldes konkurrierender Gründe.","refs":["CL_GB18_43:GA-09","CL_GB18_43:GA-10","CH_GB18_A_36:SD4","CH_GB18_A_36:MRT6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_43:BSD-01","text":"Erklärung wird von einer behaupteten Hervorbringungsrelation zu einer Kartierungsoperation umklassifiziert, die Inhalte auswählt, als wesentliche Gründe auszeichnet und ihre tatsächliche Abhängigkeit verdecken kann.","refs":["CL_GB18_43:GA-04","CL_GB18_43:GA-07","CH_GB18_A_35:SD2","CH_GB18_BDRG:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:BSD-02","text":"Kausalität, moralische Motivation, institutionelle Stellung und theologische Ableitung werden als Fälle derselben prekären Operation lesbar: Eine partielle Bestimmung wird äußerlich zur erklärenden Priorität erhoben.","refs":["CL_GB18_43:GA-05","CL_GB18_43:GA-06","CH_GB18_A_36:ME3","CH_GB18_A_36:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:BSD-03","text":"Zeitliche oder erkenntnismäßige Nachträglichkeit kann nicht als Widerlegung eines Grundanspruchs genügen; entscheidend ist vielmehr, ob die behauptete Priorität die konkrete Verknüpfung des Begründeten immanent erzeugt.","refs":["CL_GB18_43:GA-03","CL_GB18_43:GA-07","CH_GB18_A_35:ALT4","CH_GB18_A_36:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:BSD-04","text":"Wissenschaftliche und argumentative Autorität erscheint als stabilisierte Anerkennung selektierter Grundlagen, sofern ihre Prinzipien weder ihren Ursprung noch ihre konkrete Reichweite immanent ausweisen müssen.","refs":["CL_GB18_43:GA-04","CL_GB18_43:GA-08","CH_GB18_A_35:SD3","CH_GB18_A_35:NX3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:BSD-05","text":"Das System produziert keine positive Theorie des Begriffs, sondern eine Schwellenlogik: Nur der Ausfall aller isolierten Grundformen eröffnet die Forderung nach immanenter Totalität.","refs":["CL_GB18_43:GA-09","CL_GB18_43:GA-10","CH_GB18_A_36:FGS5","CH_GB18_A_36:SD4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_43:RLE-01","text":"Das Phänomen wird in einen reflektierten Grund übersetzt, der Grund wird als Prinzip vorausgesetzt, und das Prinzip erhält seine scheinbare Geltung wiederum aus der Ordnung des Phänomens, das es erklären sollte.","refs":["CH_GB18_A_35:FGS3","CH_GB18_A_35:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RLE-02","text":"Die Flucht aus der Tautologie durch Inhaltsdifferenz schlägt in Äußerlichkeit um; die Flucht aus der Äußerlichkeit durch weitere Gründe schlägt in unendliches Raisonnement um.","refs":["CH_GB18_BDRG:FGS4","CH_GB18_A_36:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RLE-03","text":"Die Auswahl eines Grundes erzeugt dessen mögliche Umkehrung, die Umkehrung erzeugt konkurrierende Begründungen, und deren Konkurrenz verdichtet sich zur Forderung nach einer nicht-selektiven Einheit.","refs":["CH_GB18_A_36:D4","CH_GB18_A_36:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RLE-04","text":"Der Attraktor des Systems ist nicht ein bestimmter Grundinhalt, sondern die Forderung nach einer Verknüpfung, in der Sache und Gründe nicht mehr als äußerlich gekoppelte Bestandteile auftreten.","refs":["CH_GB18_A_36:A9","CH_GB18_A_36:ALT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RLE-05","text":"Die Wiederkehr des Grundes markiert keinen Stillstand, sondern eine Eskalation seiner Defizienz: von Benennung über Grundlage und Selektion bis zur Unmöglichkeit einer letzten Begründung innerhalb der Grundform.","refs":["CH_GB18_A_35:AF1","CH_GB18_A_36:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_43:FGS-B01","text":"Unmittelbares Phänomen → reflektierte Inhaltsbestimmung → Benennung als Grund; bleibt der Inhalt identisch, entsteht formale Notwendigkeit ohne erklärende Differenz.","refs":["CH_GB18_A_35:FGS1","CH_GB18_A_36:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B02","text":"Inhaltsdifferenz → realer Grund; enthält das Begründete jedoch eigenen Zusatzinhalt, wird die Erklärung seines konkreten Bestands unvollständig.","refs":["CH_GB18_BDRG:FGS4","CH_GB18_BDRG:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B03","text":"Wesentlicher Grundinhalt + eigentümliche Mannigfaltigkeit → Grundlage statt zureichender Grund.","refs":["CH_GB18_BDRG:D5","CH_GB18_A_36:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B04","text":"Gleichgültige Inhalte + fehlende immanente Vermittlung → äußerliches Band → Grund und Gesetztes werden relational zugewiesene Rollen.","refs":["CH_GB18_BDRG:FGS7","CH_GB18_BDRG:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B05","text":"Konkrete Vielbestimmtheit + äußerliche Rollenzuweisung → selektierbare, reversible und konkurrierende Gründe.","refs":["CH_GB18_A_36:FGS3","CH_GB18_A_36:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B06","text":"Selektierte Teilgründe + zusätzliche Vermittlungsbedingungen → unabschließbares Raisonnement, in dem Gründe keine bestimmte Folge garantieren.","refs":["CH_GB18_A_36:D5","CH_GB18_A_36:AF4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B07","text":"Scheitern isolierter Gründe an der Sache als Verknüpfung → Begriff als negativ geforderte Form immanenter Zureichung.","refs":["CH_GB18_A_36:FGS5","CH_GB18_A_36:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_43:AFM-B01","text":"Phänomenale Bestimmtheit → reflektierte Umbenennung als Kraft, Gesetz oder Grund.","refs":["CH_GB18_A_35:AF1","CH_GB18_A_35:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B02","text":"Inhaltsidentität von Grund und Begründetem → Notwendigkeit ohne Differenz → Tautologie.","refs":["CH_GB18_A_36:A2","CH_GB18_A_36:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B03","text":"Inhaltsdifferenz → realer Grund → Differenz von wesentlichem Inhalt und eigentümlicher Mannigfaltigkeit.","refs":["CH_GB18_BDRG:AF1","CH_GB18_BDRG:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B04","text":"Fehlende Vermittlung der Inhalte → Grund wird Grundlage → äußerliche Verbindung und äußere Rollenzuweisung.","refs":["CH_GB18_BDRG:FGS9","CH_GB18_A_36:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B05","text":"Konkrete Vielbestimmtheit → konkurrierende und umkehrbare Grundzuschreibungen.","refs":["CH_GB18_A_36:AF3","CH_GB18_A_36:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B06","text":"Konkurrenz der Gründe → gegenläufige Rechtfertigungen → endloses Raisonnement.","refs":["CH_GB18_A_36:SD2","CH_GB18_A_36:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B07","text":"Unzureichende Teilgründe → Begriff als Name der fehlenden immanenten Einheit → negative terminale Schließung.","refs":["CH_GB18_A_36:AF5","CH_GB18_A_36:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_43:MME-01","text":"Der Gegensatz zwischen wissenschaftlicher Erklärung und alltäglicher Tautologie kollabiert, sobald beide denselben Inhalt nur unter verschiedenen Namen wiederholen.","refs":["CH_GB18_A_35:NX6","CH_GB18_A_35:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MME-02","text":"Der Gegensatz von Identität und Vermittlung wird neu geordnet: Identität kann im Begründeten fortbestehen, ohne dessen konkrete Bestimmtheit oder Verbindung hervorzubringen.","refs":["CH_GB18_BDRG:ME3","CH_GB18_BDRG:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MME-03","text":"Wesentlichkeit, Grundlage und Begründungskraft werden auseinandergezogen; keine dieser Kategorien garantiert für sich die Zureichung einer Erklärung.","refs":["CH_GB18_A_36:ME1","CH_GB18_A_36:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MME-04","text":"Theoretische Gegenstände, Ursachen und Gründe werden nicht mehr als vorgefundene selbständige Entitäten gelesen, sondern als möglicherweise abgeleitete und relational positionierte Bestimmungen.","refs":["CH_GB18_A_35:ME4","CH_GB18_BDRG:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MME-05","text":"Erkenntnis wird von der Akkumulation plausibler Gründe auf die Rekonstruktion der Sache als immanenter Verknüpfung ihrer Bestimmungen umgestellt.","refs":["CH_GB18_A_36:ME5","CH_GB18_A_36:A9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_43:ALT-B01","text":"Surface level — Das System behandelt wissenschaftliche Kräfte, Gesetze und Materien ebenso wie moralische Motive, Strafen, Institutionen und theologische Ableitungen als Begründungsformen.","refs":["CH_GB18_A_35:ALT1","CH_GB18_A_36:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:ALT-B02","text":"Structural level — Die Grundbeziehung zerfällt in einen identisch bleibenden wesentlichen Inhalt, einen eigenen Zusatzinhalt und eine äußerliche Form der Verknüpfung.","refs":["CH_GB18_BDRG:ALT2","CH_GB18_BDRG:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:ALT-B03","text":"Metastrategic level — Begründung wird als Operation der Auswahl, Priorisierung und Legitimierung lesbar, deren Überzeugungskraft nicht mit immanenter Wahrheit oder zureichender Erzeugung zusammenfällt.","refs":["CH_GB18_A_35:ALT3","CH_GB18_A_36:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:ALT-B04","text":"Ontological / Temporal level — Ein nachträglich abstrahierter Inhalt darf nicht als ontologisch vorausliegender Grund gelten, sofern die konkrete Mannigfaltigkeit und Verbindung des Begründeten außerhalb seiner Bestimmung liegen.","refs":["CH_GB18_A_35:ALT4","CH_GB18_A_36:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:ALT-B05","text":"Methodological / Performative level — Die Architektur vollzieht ihre Kritik selbst, indem sie von der Tautologie über die reale Differenz zur äußerlichen Selektion fortschreitet und jede erreichte Grundform als unzureichende Bedingung der nächsten ausweist.","refs":["CH_GB18_BDRG:AF1","CH_GB18_A_36:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_43:FL-01","text":"Die Forderung nach einem anderen Inhalt als Grund ist nötig, um Tautologie zu vermeiden, aber sie eröffnet gerade die Äußerlichkeit, durch die der reale Grund zur Grundlage absinkt.","refs":["CH_GB18_BDRG:D2","CH_GB18_A_36:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FL-02","text":"Das System diagnostiziert die Notwendigkeit eines Dritten zur Bestimmung von Grund und Gesetztem, kann aber die Begründung dieses Dritten innerhalb der kritisierten Grundform nicht liefern.","refs":["CH_GB18_A_36:A5","CH_GB18_A_36:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FL-03","text":"Die Kritik an hypothetischen und phantasmatischen Bestimmungen verlangt eine Grenze zwischen legitimer Vermittlung und bloßer Projektion, entwickelt jedoch kein positives Kriterium dieser Grenze.","refs":["CH_GB18_A_35:SNX4","CH_GB18_A_35:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FL-04","text":"Der Begriff wird als zureichende Einheit gefordert, bleibt aber negativ bestimmt; dadurch ist er zugleich der notwendige Ausgang aus dem Raisonnement und die größte verbleibende Unterbestimmung des Clusters.","refs":["CH_GB18_A_36:SD4","CH_GB18_A_36:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MP-01","text":"Der Schlüsselbegriff Erklärung mutiert von der Kritik tautologischer Benennung zur Forderung, die gesamte konkrete Verknüpfung eines Gegenstands hervorzubringen oder zu enthalten.","refs":["CH_GB18_A_35:A2","CH_GB18_A_36:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MP-02","text":"Der Grund mutiert zum Begriff der Grundlage, sobald sein wesentlicher Inhalt nicht mehr als Ursache oder Quelle der zusätzlichen Mannigfaltigkeit gelten kann.","refs":["CH_GB18_BDRG:SD2","CH_GB18_A_36:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MP-03","text":"Die Umkehrung mutiert von einer methodischen Verkehrung wissenschaftlicher Darstellung zu einer strukturellen Reversibilität äußerlich zugeteilter Grundrollen.","refs":["CH_GB18_A_35:D4","CH_GB18_A_36:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MP-04","text":"Der Begriff mutiert von der Möglichkeit eines anderen Grundes zum Namen der Aufhebung einer Grundform, die nur partielle und äußerlich verbundene Bestimmungen erzeugt.","refs":["CH_GB18_A_35:SD5","CH_GB18_A_36:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_43:HSI-01","text":"Realität erscheint als konkretes Gefüge gleichwesentlicher, aber nicht durch einen Einzelgrund erzeugter Bestimmungen, deren Einheit weder in bloßer Identität noch in äußerlicher Kopplung aufgeht.","refs":["CH_GB18_A_36:A6","CH_GB18_BDRG:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:HSI-02","text":"Das erkennende Subjekt erscheint als Träger einer selektierenden Grundpraxis: Es kann einzelne Bestimmungen herausheben und ordnen, gewinnt dadurch aber noch keine zureichende Erkenntnis der Sache.","refs":["CH_GB18_A_36:A7","CH_GB18_A_36:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:HSI-03","text":"Zeit und Kausalität erscheinen als prekäre Hierarchisierungen, weil ein später abstrahierter Grund als früherer Ursprung ausgegeben und ein gegenwärtiger Zusammenhang nur äußerlich als Folge zugeordnet werden kann.","refs":["CH_GB18_A_35:SD2","CH_GB18_A_36:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:HSI-04","text":"Möglicher Kampf besteht nicht im Sammeln stärkerer Gründe, sondern in der Rekonstruktion jener immanenten Verknüpfung, die Gründe als isolierte und gegenseitig austauschbare Rechtfertigungen entmachtet.","refs":["CH_GB18_A_36:NX7","CH_GB18_A_36:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_43:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die zentrale Bewegung zu rekonstruieren: formale Identität erzeugt Tautologie, reale Differenz erzeugt Äußerlichkeit, und äußerliche Auswahl erzeugt unabschließbares Raisonnement.","refs":["CH_GB18_A_36:MRT1","CH_GB18_A_36:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MRT-B02","text":"Die Rekonstruktion ist kohärent, sofern Grundlage nicht als abgeschwächter Grund, sondern als Index dafür verstanden wird, dass wesentlicher Inhalt und konkrete Verknüpfung auseinandergetreten sind.","refs":["CH_GB18_A_36:ME1","CH_GB18_A_36:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MRT-B03","text":"Unterbestimmt bleibt die positive Bestimmung des Begriffs sowie die Form der Vermittlung, durch die die äußere dritte Instanz in eine immanente Verknüpfung überführt werden könnte.","refs":["CH_GB18_A_36:MRT2","CH_GB18_A_36:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MRT-B04","text":"Die stärkste Architektur liegt in der Verbindung von logischer Grundkritik, wissenschaftlicher Erklärungsdiagnose und Analyse des Raisonnements als einer gemeinsamen Maschine äußerlicher Priorisierung.","refs":["CH_GB18_A_35:ALT3","CH_GB18_A_36:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MRT-B05","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung nur, wenn der Begriff nicht positiv ersetzt oder als Einzelgrund missverstanden wird, sondern als negative Grenze gelesen wird, an der die Grundform ihre eigene Unzulänglichkeit sichtbar macht.","refs":["CH_GB18_A_36:MRT6","CH_GB18_A_36:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122520358865Z_65a0b6f5","language_code":"en","language_name":"English","title":"Chapters 127–129","source_sha256":"3e776dedf1521d7c15e406af30ec3e1d7678c8a67bbc5ef619c73ef42b1fdc44","sha256":"985c2721739c3dd30a8146576d3c24e11258ae4862de25e797067083e18e7ef9","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:25:20.360215+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_43:AS-B01","text":"The system examines whether a ground can explain without either tautologically duplicating the content of the grounded or externally presupposing its concrete determinacy.","refs":["CH_GB18_A_35:A2","CH_GB18_A_36:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B02","text":"The formal ground-relation preserves necessity only as identity of content and thereby loses the difference that explanation would have to accomplish.","refs":["CH_GB18_A_35:A3","CH_GB18_A_36:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B03","text":"The real ground-relation breaks through tautology by means of difference of content, but produces a residue of peculiar manifoldness whose connection with the ground is not immanently grounded.","refs":["CH_GB18_BDRG:AS3","CH_GB18_A_36:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B04","text":"The transition from ground to ground-basis marks the insight that a universal content can sustain the subsistence of something concrete without producing its particular contents, connections, and consequences.","refs":["CH_GB18_BDRG:SD2","CH_GB18_A_36:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B05","text":"As soon as the form of ground does not follow from the content, the distribution of ground and grounded becomes an externally assigned, reversible, and perspectivally selectable relation.","refs":["CH_GB18_BDRG:A12","CH_GB18_A_36:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B06","text":"The movement is spiral-shaped: phenomenon is abstracted into ground, the ground is presented as antecedent, its external inadequacy generates new grounds, and their accumulation points again to the missing whole.","refs":["CH_GB18_A_35:SD1","CH_GB18_A_36:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B07","text":"Scientific explanation, Raisonnement, and institutionalized principles appear as different fields of operation of the same form of ground: they stabilize selected determinations without sufficiently producing the concrete connection of the object.","refs":["CH_GB18_A_35:SD3","CH_GB18_A_36:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AS-B08","text":"The closure remains negative and terminal: the Concept is required as the name of an immanent unity that must not appear as a further individual ground, but whose positive determination is still pending.","refs":["CH_GB18_A_36:AS5","CH_GB18_A_36:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_43:GA-01","text":"[Persistent] Explanation requires a difference of content between ground and grounded; mere repetition in the form of force, law, or principle remains tautology.","refs":["CH_GB18_A_35:NX1","CH_GB18_BDRG:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-02","text":"[Mutating] Difference of content realizes ground against formal tautology, but at the same time deprives it of the capacity to immanently produce the entire determinacy of the grounded.","refs":["CH_GB18_BDRG:D1","CH_GB18_A_36:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-03","text":"[Persistent] The grounded contains an essential ground-content and a peculiar additional content, so that its identity does not coincide with the explanation of its complete concretion.","refs":["CH_GB18_BDRG:A7","CH_GB18_BDRG:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-04","text":"[Mutating] Ground and posited are not positions immediately derivable from their contents, but roles whose assignment depends on an external relation or a third.","refs":["CH_GB18_BDRG:SD3","CH_GB18_A_36:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-05","text":"[Emergent] A ground becomes a ground-basis as soon as it indeed sustains a universal or essential connection, but produces neither the particular manifoldness nor its concrete connection.","refs":["CH_GB18_BDRG:SD5","CH_GB18_A_36:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-06","text":"[Attractor] The multideterminacy of the concrete generates a structural competition of possible grounds, because several essential partial determinations can be privileged with equal plausibility.","refs":["CH_GB18_A_36:A6","CH_GB18_A_36:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-07","text":"[Persistent] The epistemic inversion of a concept gained from the phenomenon into an allegedly antecedent ground corresponds to the ontological self-externality of the real form of ground.","refs":["CH_GB18_A_35:D3","CH_GB18_BDRG:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-08","text":"[Terminal] The accumulation of grounds produces no closure, but an infinite Raisonnement in which opposed positions become equally legitimizable.","refs":["CH_GB18_A_36:SD2","CH_GB18_A_36:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-09","text":"[Attractor] The Concept designates the required unity in which the thing, determinations, and connection are not externally coupled but immanently belong together.","refs":["CH_GB18_A_36:A9","CH_GB18_A_36:ALT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GA-10","text":"[Terminal] The Concept cannot resolve the crisis of the form of ground through a better individual ground, but only through sublation of the form that isolates, distributes, and externally connects grounds.","refs":["CH_GB18_A_36:NX7","CH_GB18_A_36:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_43:RMD-01","text":"Identity of content initially recurs as the scientific renaming of a phenomenon and subsequently as formal necessity; its function mutates from epistemic emptiness into the systematic limit of every merely formal ground-relation.","refs":["CH_GB18_A_35:AS2","CH_GB18_A_36:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-02","text":"Difference of content first appears as the condition of a real ground, but in the further movement mutates into the source of contingency, because the different content no longer proceeds from the ground.","refs":["CH_GB18_BDRG:AS3","CH_GB18_A_36:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-03","text":"The peculiar additional content of the grounded is expanded from a logical determination of difference into the general structure of concrete multideterminacy, from which competing attributions of ground arise.","refs":["CH_GB18_BDRG:A8","CH_GB18_A_36:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-04","text":"The inversion of the direction of ground shifts from scientific presentation, which presents what is derived as principle, to the general reversibility of ground and posited within externally determined relations.","refs":["CH_GB18_A_35:AS4","CH_GB18_A_36:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-05","text":"The difference between hypothetical construction and immediate existence is absorbed into the more far-reaching difference between content and form of ground: not every available content thereby possesses grounding or ontological priority.","refs":["CH_GB18_A_35:A8","CH_GB18_A_36:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-06","text":"The unknown inner essence disappears as a positive solution after it has fulfilled its negative function: it exposes that the naming of forces and matters guarantees no mediated cognition.","refs":["CH_GB18_A_35:A9","CH_GB18_A_35:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RMD-07","text":"The Concept does not appear as a stable object, but as a terminal attractor that proceeds from the repeated inadequacy of formal, real, and selected grounds.","refs":["CH_GB18_A_36:SD4","CH_GB18_A_36:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_43:CGD-01","text":"The examples of forces, matters, crystal formation, and scientific hypotheses remain local demonstrations; at the cluster level, they bear only the more general thesis that naming produces no explanation.","refs":["CH_GB18_A_35:D1","CH_GB18_A_35:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:CGD-02","text":"The distinction between essential ground-content and inessential manifoldness initially remains a determination of real ground, but scales into the insight that concrete objects are not exhausted by any isolated content.","refs":["CH_GB18_BDRG:A10","CH_GB18_A_36:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:CGD-03","text":"The scientific inversion of the order of presentation becomes, at the cluster level, the general diagnosis that epistemic belatedness can be recoded into ontological priority through ground-relations.","refs":["CH_GB18_A_35:SD2","CH_GB18_A_35:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:CGD-04","text":"Moral, causal, institutional, and theological cases remain local manifestations; their common current function consists in making visible the selectability of grounds independently of the respective domain of objects.","refs":["CH_GB18_A_36:ME3","CH_GB18_A_36:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:CGD-05","text":"The positive determination of the Concept is not transferred to the current level; globally load-bearing is solely its negative function as the limit at which the form of ground cannot be continued.","refs":["CH_GB18_A_36:MRT2","CH_GB18_A_35:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_43:GNX-01","text":"Excluded is that the translation of a phenomenon into reflected essentiality already constitutes cognitive progress or explanation.","refs":["CH_GB18_A_35:DNX1","CH_GB18_A_35:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GNX-02","text":"Excluded is that a universal or essential content necessarily produces the particular manifoldness of something concrete and its connection.","refs":["CH_GB18_BDRG:DNX2","CH_GB18_A_36:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GNX-03","text":"Excluded is that the roles of ground and grounded proceed from the connected contents themselves.","refs":["CH_GB18_BDRG:DNX4","CH_GB18_A_36:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GNX-04","text":"Excluded is that theoretical constructions, unknown essences, or institutionally recognized principles attain the status of immediate actuality or rational necessity through their naming.","refs":["CH_GB18_A_35:NX4","CH_GB18_A_35:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:GNX-05","text":"Excluded is that the quantity, essentiality, or rhetorical plausibility of individual grounds replaces sufficient cognition of the thing.","refs":["CH_GB18_A_36:NX6","CH_GB18_A_36:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_43:DBN-01","text":"The system cannot permit a ground that is at once wholly identical with its grounded and yet productive of its concrete difference.","refs":["CH_GB18_A_36:AS1","CH_GB18_BDRG:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:DBN-02","text":"The system cannot claim an immanent mediation so long as essential content and peculiar manifoldness stand merely externally alongside one another.","refs":["CH_GB18_BDRG:DNX1","CH_GB18_BDRG:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:DBN-03","text":"The system cannot recognize any final grounding whose rule of selection itself lies outside the object and must be supplied by a further third.","refs":["CH_GB18_BDRG:SNX3","CH_GB18_A_36:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:DBN-04","text":"The system cannot permit the Concept as an additional ground, because this would reproduce the isolating and external form of ground that it is precisely supposed to surpass.","refs":["CH_GB18_A_36:A9","CH_GB18_A_36:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_43:BSA-01","text":"Unavailable remains a self-grounding beginning that could deduce from itself both the necessity and the concrete difference of its object.","refs":["CH_GB18_A_35:SNX1","CH_GB18_BDRG:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:BSA-02","text":"Unavailable remains a final attribution of ground, because every isolated essentiality can be relativized by another respect, a further third, or the inversion of the relation.","refs":["CH_GB18_A_36:DNX3","CH_GB18_A_36:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:BSA-03","text":"Absent remains a positive presentation of the unity that could make explanation sufficient; the Concept appears only as a blank space compelled by the impossibility of particular grounds.","refs":["CH_GB18_A_35:SNX3","CH_GB18_A_36:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_43:XD-01","text":"Formal tautology and real externality are not competing defects of two different explanatory models, but the opposed limiting states of the same form of ground.","refs":["CL_GB18_43:GA-01","CL_GB18_43:GA-02","CH_GB18_A_36:AS1","CH_GB18_A_36:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:XD-02","text":"The inversion in which a ground abstracted from the phenomenon appears as antecedent is not merely an error of presentation, but the epistemic shape of the structural self-externality of real ground.","refs":["CL_GB18_43:GA-04","CL_GB18_43:GA-07","CH_GB18_A_35:D3","CH_GB18_BDRG:FGS10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:XD-03","text":"The transition from ground to ground-basis necessarily produces a problem of selection: what does not completely ground the object can function as its ground only under an externally posited respect.","refs":["CL_GB18_43:GA-05","CL_GB18_43:GA-06","CH_GB18_BDRG:SD2","CH_GB18_A_36:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:XD-04","text":"The confusion of hypothesis and existence, together with the distribution of the form of ground through a third, jointly produces a critique of epistemic authority: validity can appear as actuality or necessity although it is only relationally assigned.","refs":["CL_GB18_43:GA-04","CL_GB18_43:GA-07","CH_GB18_A_35:A8","CH_GB18_A_36:A5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:XD-05","text":"The possibility of adducing the same determination for opposed appearances or opposed positions follows not merely from arbitrary sophistry, but from the structural partiality of every isolated ground.","refs":["CL_GB18_43:GA-06","CL_GB18_43:GA-08","CH_GB18_A_36:D3","CH_GB18_A_36:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:XD-06","text":"The Concept becomes necessary precisely because it must not function as one further ground among several; its function is the negative sublation of the field of competing grounds.","refs":["CL_GB18_43:GA-09","CL_GB18_43:GA-10","CH_GB18_A_36:SD4","CH_GB18_A_36:MRT6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_43:BSD-01","text":"Explanation is reclassified from an asserted relation of production into an operation of mapping that selects contents, marks them out as essential grounds, and can conceal their actual dependence.","refs":["CL_GB18_43:GA-04","CL_GB18_43:GA-07","CH_GB18_A_35:SD2","CH_GB18_BDRG:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:BSD-02","text":"Causality, moral motivation, institutional standing, and theological derivation become legible as cases of the same precarious operation: a partial determination is externally elevated into explanatory priority.","refs":["CL_GB18_43:GA-05","CL_GB18_43:GA-06","CH_GB18_A_36:ME3","CH_GB18_A_36:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:BSD-03","text":"Temporal or cognitive belatedness cannot suffice as a refutation of a claim to ground; decisive is rather whether the asserted priority immanently produces the concrete connection of the grounded.","refs":["CL_GB18_43:GA-03","CL_GB18_43:GA-07","CH_GB18_A_35:ALT4","CH_GB18_A_36:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:BSD-04","text":"Scientific and argumentative authority appears as stabilized recognition of selected ground-bases, insofar as their principles need not immanently demonstrate either their origin or their concrete scope.","refs":["CL_GB18_43:GA-04","CL_GB18_43:GA-08","CH_GB18_A_35:SD3","CH_GB18_A_35:NX3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_43:BSD-05","text":"The system produces no positive theory of the Concept, but a threshold logic: only the failure of all isolated forms of ground opens the demand for immanent totality.","refs":["CL_GB18_43:GA-09","CL_GB18_43:GA-10","CH_GB18_A_36:FGS5","CH_GB18_A_36:SD4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_43:RLE-01","text":"The phenomenon is translated into a reflected ground, the ground is presupposed as principle, and the principle in turn receives its apparent validity from the order of the phenomenon that it was supposed to explain.","refs":["CH_GB18_A_35:FGS3","CH_GB18_A_35:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RLE-02","text":"The escape from tautology through difference of content turns into externality; the escape from externality through further grounds turns into infinite Raisonnement.","refs":["CH_GB18_BDRG:FGS4","CH_GB18_A_36:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RLE-03","text":"The selection of a ground produces its possible inversion, the inversion produces competing groundings, and their competition condenses into the demand for a non-selective unity.","refs":["CH_GB18_A_36:D4","CH_GB18_A_36:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RLE-04","text":"The attractor of the system is not a determinate ground-content, but the demand for a connection in which thing and grounds no longer appear as externally coupled components.","refs":["CH_GB18_A_36:A9","CH_GB18_A_36:ALT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:RLE-05","text":"The return of ground marks not a standstill, but an escalation of its deficiency: from naming through ground-basis and selection to the impossibility of a final grounding within the form of ground.","refs":["CH_GB18_A_35:AF1","CH_GB18_A_36:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_43:FGS-B01","text":"Immediate phenomenon → reflected determination of content → naming as ground; if the content remains identical, formal necessity without explanatory difference arises.","refs":["CH_GB18_A_35:FGS1","CH_GB18_A_36:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B02","text":"Difference of content → real ground; if the grounded nevertheless contains its own additional content, the explanation of its concrete subsistence becomes incomplete.","refs":["CH_GB18_BDRG:FGS4","CH_GB18_BDRG:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B03","text":"Essential ground-content + peculiar manifoldness → ground-basis instead of sufficient ground.","refs":["CH_GB18_BDRG:D5","CH_GB18_A_36:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B04","text":"Indifferent contents + lacking immanent mediation → external bond → ground and posited become relationally assigned roles.","refs":["CH_GB18_BDRG:FGS7","CH_GB18_BDRG:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B05","text":"Concrete multideterminacy + external assignment of roles → selectable, reversible, and competing grounds.","refs":["CH_GB18_A_36:FGS3","CH_GB18_A_36:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B06","text":"Selected partial grounds + additional conditions of mediation → unclosable Raisonnement in which grounds guarantee no determinate consequence.","refs":["CH_GB18_A_36:D5","CH_GB18_A_36:AF4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FGS-B07","text":"Failure of isolated grounds in the face of the thing as connection → Concept as negatively required form of immanent sufficiency.","refs":["CH_GB18_A_36:FGS5","CH_GB18_A_36:AS5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_43:AFM-B01","text":"Phenomenal determinacy → reflected renaming as force, law, or ground.","refs":["CH_GB18_A_35:AF1","CH_GB18_A_35:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B02","text":"Identity of content of ground and grounded → necessity without difference → tautology.","refs":["CH_GB18_A_36:A2","CH_GB18_A_36:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B03","text":"Difference of content → real ground → difference between essential content and peculiar manifoldness.","refs":["CH_GB18_BDRG:AF1","CH_GB18_BDRG:FGS8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B04","text":"Lacking mediation of contents → ground becomes ground-basis → external connection and external assignment of roles.","refs":["CH_GB18_BDRG:FGS9","CH_GB18_A_36:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B05","text":"Concrete multideterminacy → competing and reversible attributions of ground.","refs":["CH_GB18_A_36:AF3","CH_GB18_A_36:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B06","text":"Competition of grounds → opposing justifications → endless Raisonnement.","refs":["CH_GB18_A_36:SD2","CH_GB18_A_36:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:AFM-B07","text":"Insufficient partial grounds → Concept as name of the missing immanent unity → negative terminal closure.","refs":["CH_GB18_A_36:AF5","CH_GB18_A_36:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_43:MME-01","text":"The opposition between scientific explanation and everyday tautology collapses as soon as both merely repeat the same content under different names.","refs":["CH_GB18_A_35:NX6","CH_GB18_A_35:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MME-02","text":"The opposition of identity and mediation is reordered: identity can persist in the grounded without producing its concrete determinacy or connection.","refs":["CH_GB18_BDRG:ME3","CH_GB18_BDRG:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MME-03","text":"Essentiality, ground-basis, and grounding force are pulled apart; none of these categories by itself guarantees the sufficiency of an explanation.","refs":["CH_GB18_A_36:ME1","CH_GB18_A_36:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MME-04","text":"Theoretical objects, causes, and grounds are no longer read as encountered independent entities, but as possibly derived and relationally positioned determinations.","refs":["CH_GB18_A_35:ME4","CH_GB18_BDRG:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MME-05","text":"Cognition is shifted from the accumulation of plausible grounds to the reconstruction of the thing as the immanent connection of its determinations.","refs":["CH_GB18_A_36:ME5","CH_GB18_A_36:A9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_43:ALT-B01","text":"Surface level — The system treats scientific forces, laws, and matters, just as it treats moral motives, punishments, institutions, and theological derivations, as forms of grounding.","refs":["CH_GB18_A_35:ALT1","CH_GB18_A_36:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:ALT-B02","text":"Structural level — The ground-relation disintegrates into an essential content that remains identical, a distinct additional content, and an external form of connection.","refs":["CH_GB18_BDRG:ALT2","CH_GB18_BDRG:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:ALT-B03","text":"Metastrategic level — Grounding becomes legible as an operation of selection, prioritization, and legitimation, whose persuasive force does not coincide with immanent truth or sufficient production.","refs":["CH_GB18_A_35:ALT3","CH_GB18_A_36:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:ALT-B04","text":"Ontological / Temporal level — A subsequently abstracted content must not count as an ontologically antecedent ground insofar as the concrete manifoldness and connection of the grounded lie outside its determination.","refs":["CH_GB18_A_35:ALT4","CH_GB18_A_36:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:ALT-B05","text":"Methodological / Performative level — The architecture itself enacts its critique by advancing from tautology through real difference to external selection and exhibiting every attained form of ground as the inadequate condition of the next.","refs":["CH_GB18_BDRG:AF1","CH_GB18_A_36:AF5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_43:FL-01","text":"The demand for another content as ground is necessary to avoid tautology, but it is precisely this that opens the externality through which real ground sinks into ground-basis.","refs":["CH_GB18_BDRG:D2","CH_GB18_A_36:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FL-02","text":"The system diagnoses the necessity of a third for determining ground and posited, but cannot supply the grounding of this third within the criticized form of ground.","refs":["CH_GB18_A_36:A5","CH_GB18_A_36:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FL-03","text":"The critique of hypothetical and phantasmatic determinations requires a boundary between legitimate mediation and mere projection, but develops no positive criterion for this boundary.","refs":["CH_GB18_A_35:SNX4","CH_GB18_A_35:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:FL-04","text":"The Concept is required as a sufficient unity, but remains negatively determined; it is therefore at once the necessary exit from Raisonnement and the cluster's greatest remaining underdetermination.","refs":["CH_GB18_A_36:SD4","CH_GB18_A_36:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MP-01","text":"The key concept of explanation mutates from the critique of tautological naming into the demand to produce or contain the entire concrete connection of an object.","refs":["CH_GB18_A_35:A2","CH_GB18_A_36:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MP-02","text":"Ground mutates into the concept of ground-basis as soon as its essential content can no longer count as cause or source of the additional manifoldness.","refs":["CH_GB18_BDRG:SD2","CH_GB18_A_36:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MP-03","text":"Inversion mutates from a methodological inversion of scientific presentation into a structural reversibility of externally assigned roles of ground.","refs":["CH_GB18_A_35:D4","CH_GB18_A_36:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MP-04","text":"The Concept mutates from the possibility of another ground into the name of the sublation of a form of ground that produces only partial and externally connected determinations.","refs":["CH_GB18_A_35:SD5","CH_GB18_A_36:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_43:HSI-01","text":"Reality appears as a concrete configuration of coessential determinations not produced by an individual ground, whose unity is exhausted neither in mere identity nor in external coupling.","refs":["CH_GB18_A_36:A6","CH_GB18_BDRG:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:HSI-02","text":"The cognizing subject appears as the bearer of a selective practice of grounding: it can single out and order individual determinations, but thereby acquires no sufficient cognition of the thing.","refs":["CH_GB18_A_36:A7","CH_GB18_A_36:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:HSI-03","text":"Time and causality appear as precarious hierarchizations, because a subsequently abstracted ground can be presented as an earlier origin and a present connection can be externally assigned merely as consequence.","refs":["CH_GB18_A_35:SD2","CH_GB18_A_36:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:HSI-04","text":"Possible struggle consists not in collecting stronger grounds, but in reconstructing that immanent connection which disempowers grounds as isolated and mutually exchangeable justifications.","refs":["CH_GB18_A_36:NX7","CH_GB18_A_36:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_43:MRT-B01","text":"The extracted axioms suffice to reconstruct the central movement: formal identity produces tautology, real difference produces externality, and external selection produces unclosable Raisonnement.","refs":["CH_GB18_A_36:MRT1","CH_GB18_A_36:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MRT-B02","text":"The reconstruction is coherent insofar as ground-basis is understood not as a weakened ground, but as an index that essential content and concrete connection have come apart.","refs":["CH_GB18_A_36:ME1","CH_GB18_A_36:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MRT-B03","text":"What remains underdetermined is the positive determination of the Concept, as well as the form of mediation through which the external third instance could be transferred into an immanent connection.","refs":["CH_GB18_A_36:MRT2","CH_GB18_A_36:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MRT-B04","text":"The strongest architecture lies in the connection of logical critique of ground, diagnosis of scientific explanation, and analysis of Raisonnement as a common machine of external prioritization.","refs":["CH_GB18_A_35:ALT3","CH_GB18_A_36:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_43:MRT-B05","text":"The reconstruction preserves the actual movement only if the Concept is not positively replaced or misunderstood as an individual ground, but is read as the negative limit at which the form of ground makes its own inadequacy visible.","refs":["CH_GB18_A_36:MRT6","CH_GB18_A_36:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_43@R001","source_variant_id":"canonical:CL_GB18_43:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 127–129","context":"Anmerkung. · b. Der reale Grund. · Anmerkung."},"title_language_code":"en"},{"id":"CL_GB18_44","layer":"CL","title":"Chapters 130–132","order":44,"parents":["CH_GB18_CD_2","CH_GB18_DRU0","CH_GB18_BDAU"],"revision":"CL_GB18_44@R001","sha256":"23999d9e432241a9ef7c4b38a01fe302f443ad6aa712a7eeac8df2c42844b42f","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_44:AS-01","text":"Das Cluster löst das Problem, wie Grund, Bedingung und Unbedingtheit gedacht werden können, ohne einen äußerlichen ersten Ursprung oder eine bloße Kette abhängiger Bestimmungen zu unterstellen.","refs":["CH_GB18_CD_2:AS1","CH_GB18_DRU0:AS1","CH_GB18_BDAU:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AS-02","text":"Die Bewegung beginnt mit der Entkräftung eines realen Grundes, der als äußerliche Reflexion selbst begründungsbedürftig wird, und überführt Begründung in eine Selbstvermittlung von Form, Inhalt und Voraussetzung.","refs":["CH_GB18_CD_2:AS2","CH_GB18_DRU0:D1","CH_GB18_BDAU:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AS-03","text":"Die vollständige Grundbeziehung bestimmt Grund und Begründetes als Funktionsstellen eines gemeinsamen Inhalts, deren Unterschied zunächst nur durch die Form unmittelbarer und gesetzter Verknüpfung besteht.","refs":["CH_GB18_CD_2:AS4","CH_GB18_DRU0:A17","CH_GB18_BDAU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AS-04","text":"Die Bedingung erscheint zunächst als relativ Unbedingtes: unmittelbares Material für den Grund, das weder selbst Grund noch außerhalb der Grundbeziehung absolut selbständig ist.","refs":["CH_GB18_DRU0:AS4","CH_GB18_DRU0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AS-05","text":"Die Gegensätze von Bedingung und Grund werden schließlich als Selbstunterschiede einer negativen Identität rekonfiguriert, in der die Sache ihre Bedingungen setzt, voraussetzt und als bloßen Verhältnisschein aufhebt.","refs":["CH_GB18_BDAU:AS4","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AS-06","text":"Die Gesamtbewegung ist rekursiv und spiralförmig: Der Grund negiert seine äußerliche Selbständigkeit, setzt sein Anderes voraus, absorbiert es als eigenes Moment und erreicht Unbedingtheit nur als sich entzweiende Selbstidentität.","refs":["CH_GB18_CD_2:A10","CH_GB18_BDAU:A1","CH_GB18_BDAU:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_44:GA-01","text":"[Persistent] Grundsein ist keine feste Eigenschaft eines isolierten Inhalts, sondern eine relationale Funktion innerhalb einer vermittelten Totalität.","refs":["CH_GB18_CD_2:SD1","CH_GB18_DRU0:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-02","text":"[Persistent] Unmittelbarkeit besitzt keinen unabhängigen ontologischen Vorrang, sondern erscheint stets als vorausgesetztes oder aufgehobenes Resultat der Vermittlung.","refs":["CH_GB18_CD_2:ME3","CH_GB18_BDAU:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-03","text":"[Mutating] Die Bedingung mutiert von unmittelbarem und gegenüber der Form zunächst gleichgültigem Material zu gesetztem Ansichseyn und innerem Moment der Grundbewegung.","refs":["CH_GB18_DRU0:A8","CH_GB18_BDAU:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-04","text":"[Mutating] Der Grund mutiert von vollständiger Vermittlung formeller und realer Bestimmungen zu selbstbezüglicher Reflexion, die ihr eigenes Ansichseyn als Bedingung gegen sich setzt.","refs":["CH_GB18_CD_2:A9","CH_GB18_BDAU:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-05","text":"[Emergent] Form und Inhalt sind auf Clusterebene keine getrennten Sphären, sondern gegenläufige Funktionen einer einzigen Selbstvermittlung, in der Material formiert und Form materialisiert wird.","refs":["CH_GB18_CD_2:D6","CH_GB18_BDAU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-06","text":"[Persistent] Die Differenz von Bedingung und Grund bleibt notwendig, besitzt jedoch keinen Status selbständiger Zweiheit, sondern fungiert als immanenter Selbstunterschied der Einheit.","refs":["CH_GB18_DRU0:A18","CH_GB18_BDAU:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-07","text":"[Mutating] Das Unbedingte verschiebt sich von einer relativen Funktionsbestimmung der Bedingung zu der immanenten Einheit, welche Relativität und Bedingtheit selbst trägt.","refs":["CH_GB18_DRU0:SD2","CH_GB18_BDAU:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-08","text":"[Attractor] Negative Identität ist der Attraktor des Systems, weil sie die Entzweiung von Bedingung und Grund hervorbringt, ohne deren Einheit in eine ruhende Gleichheit aufzulösen.","refs":["CH_GB18_BDAU:A12","CH_GB18_BDAU:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-09","text":"[Terminal] Der unendliche Bedingungsregress verliert seine Notwendigkeit, sobald die Bedingung nicht als äußerlich selbständige Instanz, sondern als Moment der absoluten Selbstbewegung bestimmt wird.","refs":["CH_GB18_BDAU:NX5","CH_GB18_BDAU:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-10","text":"[Attractor] Vollständigkeit besteht nicht in voraussetzungsloser Selbstidentität, sondern in Selbstnegation, Rückkehr und der Reproduktion des Anderen als eigenes Moment.","refs":["CH_GB18_CD_2:NX7","CH_GB18_BDAU:A1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_44:RMD-01","text":"Der Grund kehrt als zentrale Kategorie durchgehend wieder, verschiebt seine Funktion jedoch von äußerlicher Grundrelation über bedingte Reflexion zu immanenter Selbstsetzung.","refs":["CH_GB18_CD_2:A1","CH_GB18_BDAU:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RMD-02","text":"Die Bedingung wiederholt sich nicht als konstante Voraussetzung, sondern mutiert von unmittelbarem Dasein und Material des Grundes zu formierter Materie und gesetztem Ansichseyn.","refs":["CH_GB18_DRU0:A8","CH_GB18_BDAU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RMD-03","text":"Unmittelbarkeit kehrt funktional wieder, verliert jedoch ihre anfängliche Valenz als selbständiges Bestehen und wird zum Resultat beziehungsweise zur Erscheinungsform der Vermittlung.","refs":["CH_GB18_DRU0:A13","CH_GB18_BDAU:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RMD-04","text":"Die Differenz von Grund und Begründetem, Bedingung und Grund sowie Form und Inhalt wird schrittweise aus einer externen Relation in einen notwendigen Selbstunterschied derselben Totalität absorbiert.","refs":["CH_GB18_CD_2:A6","CH_GB18_DRU0:A17","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RMD-05","text":"Das Unbedingte wechselt von einer relativen Bestimmung innerhalb einer konkreten Grundrelation zu einer absoluten negativen Einheit, die jede solche Relation als Moment umfasst.","refs":["CH_GB18_DRU0:ME3","CH_GB18_BDAU:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RMD-06","text":"Der Regress verschwindet nicht einfach, sondern leistet zunächst die strukturelle Arbeit, die Unzulänglichkeit äußerlicher Bedingtheit sichtbar zu machen, bevor er im Absoluten seine Notwendigkeit verliert.","refs":["CH_GB18_DRU0:SNX1","CH_GB18_BDAU:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_44:CGD-01","text":"Die Unterscheidung zweier Etwas mit gleichem Gesamtinhalt gehört zur lokalen Mechanik der vollständigen Grundbeziehung; auf Clusterebene zählt sie nur insofern, als sie die spätere Aufhebung äußerlicher Zweiheit vorbereitet.","refs":["CH_GB18_CD_2:A6","CH_GB18_CD_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:CGD-02","text":"Der Widerspruch von Selbstständigkeit und Momentsein ist zunächst der Abschluss der relativen Unbedingtheit, wird auf Clusterebene jedoch zum Übergangsmotor der absoluten Einheit.","refs":["CH_GB18_DRU0:AS6","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:CGD-03","text":"Die Differenz von unmittelbarem Bedingungsmaterial und formiertem Grundinhalt bleibt lokal erforderlich, wird aber übergeordnet als Zwischenform der Identität von Form und Inhalt umcodiert.","refs":["CH_GB18_DRU0:A11","CH_GB18_BDAU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:CGD-04","text":"Die globale Proposition des Clusters lautet nicht, dass ein neuer erster Grund gefunden wird, sondern dass jeder Anspruch auf einen ersten, äußerlich bestimmten Grund systematisch in vermittelte Selbstbeziehung übergeht.","refs":["CH_GB18_CD_2:DNX1","CH_GB18_BDAU:DNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_44:GNX-01","text":"Ausgeschlossen wird ein realer Grund, der seine Grundfunktion unabhängig von der Beziehung zum Begründeten und unabhängig von weiterer Vermittlung innehaben könnte.","refs":["CH_GB18_CD_2:NX1","CH_GB18_BDAU:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GNX-02","text":"Ausgeschlossen wird sowohl eine Bedingung, die vollständig selbständig erklären könnte, als auch ein Grund, der reine Form ohne vorausgesetztes Material wäre.","refs":["CH_GB18_DRU0:NX8","CH_GB18_DRU0:NX9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GNX-03","text":"Ausgeschlossen wird ein absolutes Unbedingtes als ruhender Besitzstand jenseits von Setzen, Voraussetzen, Negation und Selbstentzweiung.","refs":["CH_GB18_DRU0:DNX2","CH_GB18_BDAU:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GNX-04","text":"Ausgeschlossen wird eine stabile ontologische Zweiheit von Bedingung und Grund, weil ihre scheinbare Äußerlichkeit nur die Erscheinungsform einer vorausgesetzten Einheit ist.","refs":["CH_GB18_DRU0:DNX6","CH_GB18_BDAU:DNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_44:DBN-01","text":"Das System kann kein Ursprungsmodell zulassen, in dem eine Sache aus zuvor selbständigen Gründen und Bedingungen linear hervorgeht.","refs":["CH_GB18_CD_2:DNX2","CH_GB18_BDAU:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:DBN-02","text":"Das System kann den Widerspruch von Bedingung und Grund nicht durch einseitige Vorrangstellung einer Seite auflösen, weil jede solche Lösung die Vermittlungsstruktur zerstören würde.","refs":["CH_GB18_DRU0:DNX7","CH_GB18_BDAU:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:DBN-03","text":"Das System kann keine absolute Identität zulassen, die keine bewahrte Differenz, keine Selbstentzweiung und keinen Rückgang aus dem Anderen enthielte.","refs":["CH_GB18_CD_2:DNX5","CH_GB18_BDAU:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_44:BSA-01","text":"Unverfügbar ist ein Außen der Vermittlung, von dem aus Bedingung, Grund oder die Sache selbst unabhängig fundiert werden könnten.","refs":["CH_GB18_CD_2:SNX4","CH_GB18_BDAU:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:BSA-02","text":"Unverfügbar ist ein schlechthin erster Anfang, weil jeder Anfang bereits als vermittelte, gesetzte oder aufgehobene Unmittelbarkeit zurückkehrt.","refs":["CH_GB18_CD_2:SNX1","CH_GB18_DRU0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:BSA-03","text":"Unzulässig ist ein Unbedingtes, das als ruhendes Substrat verfügbar wäre; das Absolute besteht nur in der Bewegung, durch die es seine Momente produziert und aufhebt.","refs":["CH_GB18_CD_2:SNX3","CH_GB18_BDAU:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_44:XD-01","text":"Die Bedingung ist nicht die äußere Grenze der Grundbeziehung, sondern die Form, in der der Grund seine eigene Bedingtheit hervorbringt und als Voraussetzung gegen sich setzt.","refs":["CL_GB18_44:GA-03","CL_GB18_44:GA-04","CL_GB18_44:GA-10","CH_GB18_CD_2:SD5","CH_GB18_DRU0:SD1","CH_GB18_BDAU:D3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_44:XD-02","text":"Der Übergang vom gemeinsamen Gesamtinhalt über das Bedingungsmaterial zur formierten Materie zeigt, dass Inhalt nicht vor seiner Formierung gegeben ist, sondern erst als Selbstbeziehung der Form vollständig Inhalt wird.","refs":["CL_GB18_44:GA-02","CL_GB18_44:GA-05","CH_GB18_CD_2:A6","CH_GB18_DRU0:D6","CH_GB18_BDAU:A8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_44:XD-03","text":"Die scheinbare Unabhängigkeit von Bedingung und Grund ist weder ein bloßer Fehler noch eine bleibende Realität, sondern die notwendige Erscheinungsform, in der absolute Identität sich als Selbstunterschied artikuliert.","refs":["CL_GB18_44:GA-06","CL_GB18_44:GA-08","CH_GB18_DRU0:SD4","CH_GB18_BDAU:SD2"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_44:XD-04","text":"Der Bedingungsregress wird nicht durch einen externen Endpunkt beendet, sondern durch die Umklassifikation endlicher Bedingtheit als innerhalb der absoluten Selbstbewegung gesetztes Moment.","refs":["CL_GB18_44:GA-08","CL_GB18_44:GA-09","CH_GB18_BDAU:NX5","CH_GB18_BDAU:ME3"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_44:XD-05","text":"Die Schließung des Systems besteht nicht in der Beseitigung des Verhältnisses von Bedingung und Grund, sondern in dessen Umwandlung in die immanente Artikulation negativer Identität.","refs":["CL_GB18_44:GA-06","CL_GB18_44:GA-08","CH_GB18_CD_2:A3","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_44:BSD-01","text":"Kausalität wird von einem Modell des Hervorgehens aus selbständigen Voraussetzungen in ein Modell der Selbstmanifestation überführt, in dem die Sache ihre Bedingungen nur als Momente ihres eigenen Vollzugs besitzt.","refs":["CL_GB18_44:GA-04","CL_GB18_44:GA-08","CH_GB18_BDAU:SD4","CH_GB18_BDAU:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_44:BSD-02","text":"Erklärung wird methodisch zur Rekonstruktion der Bedingungen, unter denen etwas Grund sein kann, und nicht zur Suche nach einem isolierbaren ersten Träger von Grundcharakter.","refs":["CL_GB18_44:GA-01","CL_GB18_44:GA-10","CH_GB18_CD_2:ALT3","CH_GB18_DRU0:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_44:BSD-03","text":"Zeitlichkeit verliert die Form eines äußerlichen Anfangs-Nachher-Schemas; das scheinbar Erste erhält seine Bestimmung erst rückwirkend als Voraussetzung einer bereits vollzogenen Vermittlung.","refs":["CL_GB18_44:GA-02","CL_GB18_44:GA-10","CH_GB18_CD_2:ALT4","CH_GB18_BDAU:ME1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_44:BSD-04","text":"Die Sache selbst wird nicht als Substrat hinter ihren Relationen bestimmt, sondern als negative Einheit, deren Realität ausschließlich in der Erzeugung, Entzweiung und Aufhebung ihrer Momente besteht.","refs":["CL_GB18_44:GA-08","CL_GB18_44:GA-10","CH_GB18_BDAU:AS5","CH_GB18_BDAU:SD3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_44:RLE-01","text":"Der Grund gerät in eine rekursive Schleife, weil seine äußerliche Grundfunktion ihn selbst zum Begründeten macht, dessen Voraussetzung wiederum als Bedingung des Grundes erscheint.","refs":["CH_GB18_CD_2:D1","CH_GB18_CD_2:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RLE-02","text":"Unmittelbarkeit bildet eine Eskalationsschleife: Sie erscheint als Ausgangspunkt, wird als Material aufgenommen, verliert ihre Gleichgültigkeit und kehrt als vermittelte Unmittelbarkeit zurück.","refs":["CH_GB18_CD_2:ME3","CH_GB18_DRU0:A12","CH_GB18_BDAU:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RLE-03","text":"Die Gegenseitigkeit von Bedingung und Grund bildet einen Attraktor, weil jede Seite nur durch ihre scheinbar selbständige Gegeninstanz bestimmt ist und ihre Wahrheit erst in der vorausgesetzten Identität erhält.","refs":["CH_GB18_DRU0:A18","CH_GB18_BDAU:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RLE-04","text":"Negative Identität fungiert als terminaler Attraktor, weil sie die Wiederkehr äußerlicher Differenz nicht tilgt, sondern als notwendige Selbstentzweiung der Einheit reproduziert.","refs":["CH_GB18_CD_2:A10","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_44:FGS-B01","text":"Äußerlicher realer Grund → Verlust seines selbständigen Grundcharakters → Übergang des Grundes auf die Seite des Begründeten.","refs":["CH_GB18_CD_2:AS1","CH_GB18_CD_2:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:FGS-B02","text":"Gemeinsamer Inhalt → Differenz unmittelbarer und gesetzter Verknüpfung → vollständige Grundbeziehung als Vermittlung des Grundcharakters selbst.","refs":["CH_GB18_CD_2:AS4","CH_GB18_CD_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:FGS-B03","text":"Vorausgesetztes unmittelbares Dasein → Bedingung als relativ Unbedingtes → Aufnahme des Materials als Moment der Grundbeziehung.","refs":["CH_GB18_DRU0:A8","CH_GB18_DRU0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:FGS-B04","text":"Bedingung als gesetztes Ansichseyn + Grund als voraussetzende Reflexion → gegenseitige Entäußerung von Form und Inhalt → Identität ihrer Bewegung.","refs":["CH_GB18_BDAU:AS2","CH_GB18_BDAU:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:FGS-B05","text":"Identität von Bedingung und Grund → negative Selbstentzweiung → Aufhebung des Verhältnisscheins → absolut unbedingte Sache.","refs":["CH_GB18_BDAU:A11","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_44:AFM-B01","text":"Äußerlicher Grund → begründungsbedürftiger Grundcharakter → vollständige Grundbeziehung → Bedingung als vorausgesetzte Unmittelbarkeit.","refs":["CH_GB18_CD_2:AS1","CH_GB18_CD_2:AS3","CH_GB18_DRU0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AFM-B02","text":"Bedingung als Material → relative Unbedingtheit → Widerspruch von Selbstständigkeit und Momentsein → Krise der äußerlichen Zweiheit.","refs":["CH_GB18_DRU0:A11","CH_GB18_DRU0:SD2","CH_GB18_DRU0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AFM-B03","text":"Voraussetzen und Setzen → Identität von Form und Inhalt → Umcodierung von Bedingung und Grund als Momente einer Sache.","refs":["CH_GB18_BDAU:A5","CH_GB18_BDAU:A9","CH_GB18_BDAU:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AFM-B04","text":"Negative Identität → Aufhebung des äußeren Verhältnisscheins → absolut Unbedingtes als immanente Selbstbewegung.","refs":["CH_GB18_BDAU:A12","CH_GB18_BDAU:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_44:MME-01","text":"Grund und Bedingung werden nicht länger als getrennte Erklärungsterme kartiert, sondern als verschiedene Funktionsphasen einer Selbstvermittlung.","refs":["CH_GB18_CD_2:ME1","CH_GB18_BDAU:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MME-02","text":"Das Unbedingte wird von einem absoluten Status in eine Bewegungsform umkartiert, die Relativität, Vermittlung und Selbstnegation in sich enthält.","refs":["CH_GB18_DRU0:ME3","CH_GB18_BDAU:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MME-03","text":"Der Gegensatz von Form und Inhalt zerfällt als starre Alternative und wird als interne Gegenläufigkeit von Materialisierung und Formierung rekonfiguriert.","refs":["CH_GB18_CD_2:ME2","CH_GB18_DRU0:ME4","CH_GB18_BDAU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MME-04","text":"Der unendliche Regress wird nicht als notwendige Konsequenz von Bedingtheit behandelt, sondern als Effekt der falschen Verabsolutierung endlicher und äußerlicher Bestimmungen.","refs":["CH_GB18_BDAU:ME3","CH_GB18_BDAU:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_44:ALT-B01","text":"Oberflächenebene — Das Cluster behandelt das Verhältnis von Grund, Begründetem, Bedingung, relativ Unbedingtem und absolut Unbedingtem.","refs":["CH_GB18_CD_2:ALT1","CH_GB18_BDAU:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:ALT-B02","text":"Strukturebene — Die operative Struktur ist eine Reflexionsmaschine, in der Setzen und Voraussetzen dieselbe Bewegung bilden und Unmittelbarkeit als Moment dieser Bewegung erscheint.","refs":["CH_GB18_CD_2:ALT2","CH_GB18_BDAU:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:ALT-B03","text":"Metastrategische Ebene — Erklärung wird als Rekonstruktion der immanenten Bedingungen von Grundcharakter reorganisiert und gegen die Suche nach isolierten Ursprüngen gerichtet.","refs":["CH_GB18_CD_2:ALT3","CH_GB18_DRU0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:ALT-B04","text":"Ontologisch-zeitliche Ebene — Realität besitzt keinen unvermittelten Anfang, sondern ist Übergang, Negation und Rückkehr einer Identität, die sich nur im Anderen erhält.","refs":["CH_GB18_CD_2:ALT5","CH_GB18_BDAU:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:ALT-B05","text":"Methodologisch-performative Ebene — Die Darstellung vollzieht ihre These, indem sie jeden scheinbar festen Ausgangspunkt rückwirkend in ein vorausgesetztes Resultat überführt.","refs":["CH_GB18_DRU0:AS2","CH_GB18_BDAU:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_44:FL-01","text":"Die Totalität muss eine Bedingung voraussetzen, um sich als Grund zu vermitteln, soll diese Bedingung aber zugleich als ihr eigenes gesetztes Moment aufheben; diese Spannung ist produktiv und nicht abschließend neutralisiert.","refs":["CH_GB18_CD_2:MRT5","CH_GB18_BDAU:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:FL-02","text":"Das Verhältnis von Bedingung und Grund soll als äußerlicher Schein verschwinden, muss aber als notwendige Artikulation der absoluten Bewegung weiterhin ausgesprochen werden.","refs":["CH_GB18_CD_2:MRT6","CH_GB18_BDAU:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MP-01","text":"Die Bedingung mutiert an der Schwelle zum Absoluten von gleichgültigem unmittelbarem Material zu formierter Materie, ohne ihre Funktion als Moment der Unmittelbarkeit vollständig zu verlieren.","refs":["CH_GB18_DRU0:A8","CH_GB18_BDAU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MP-02","text":"Das Unbedingte mutiert von relativer Unbedingtheit der Bedingung zu negativer Identität der Sache; der Übergang bewahrt die frühere Relativität nur als aufgehobenes Moment.","refs":["CH_GB18_DRU0:ME3","CH_GB18_BDAU:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_44:HSI-01","text":"Die Realität erscheint als reflexive Maschine, die keine äußeren Fundamente verarbeitet, sondern ihre eigenen Voraussetzungen produziert, differenziert und wieder in sich zurücknimmt.","refs":["CH_GB18_BDAU:AS5","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:HSI-02","text":"Die Sache selbst ist keine Substanz hinter ihren Bedingungen, sondern ein Vollzug negativer Identität, dessen Momente nur in ihrer Selbstentzweiung Realität besitzen.","refs":["CH_GB18_BDAU:SD3","CH_GB18_BDAU:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:HSI-03","text":"Zeit wird als rückläufige Ordnung gedacht: Das Vorausgesetzte ist nicht ursprünglich vor der Vermittlung, sondern erhält seinen Status erst durch die Bewegung, die es als Voraussetzung setzt.","refs":["CH_GB18_CD_2:ALT5","CH_GB18_BDAU:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:HSI-04","text":"Strategisch bleibt keine Flucht in einen ersten Grund möglich; möglich ist nur die Navigation der Übergänge, durch die Material, Form, Bedingung und Grund ihre jeweiligen Funktionen erhalten.","refs":["CH_GB18_CD_2:ALT3","CH_GB18_DRU0:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_44:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von äußerlicher Grundrelation über relativ bedingte Reflexion bis zur negativen Identität des absolut Unbedingten zu rekonstruieren.","refs":["CH_GB18_CD_2:MRT1","CH_GB18_BDAU:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MRT-B02","text":"Unterbestimmt bleibt, wie die spezifische Endlichkeit eines Daseins die regressauslösende Frage nach einer weiteren Bedingung erzeugt und warum diese Frage gerade dort notwendig wird.","refs":["CH_GB18_CD_2:MRT2","CH_GB18_BDAU:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MRT-B03","text":"Die Clusterarchitektur ist kohärent, sofern Voraussetzung nicht zeitlich-vorhanden, sondern als reflexive Funktionsbestimmung einer Selbstvermittlung gelesen wird.","refs":["CH_GB18_CD_2:MRT3","CH_GB18_BDAU:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MRT-B04","text":"Die Rekonstruktion bleibt auf die produktive Spannung angewiesen, dass Identität nur als Selbstentzweiung und Aufhebung des Verhältnisses möglich ist, das sie zugleich artikulieren muss.","refs":["CH_GB18_CD_2:MRT7","CH_GB18_BDAU:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122547239637Z_10492f1b","language_code":"en","language_name":"English","title":"Chapters 130–132","source_sha256":"23999d9e432241a9ef7c4b38a01fe302f443ad6aa712a7eeac8df2c42844b42f","sha256":"48251175ba826e904c60f221ffa8ef0f8ed7851a754d6bc9e57772645b64e17d","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:25:47.241025+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_44:AS-01","text":"The cluster resolves the problem of how ground, condition, and unconditionedness can be thought without presupposing an external first origin or a mere chain of dependent determinations.","refs":["CH_GB18_CD_2:AS1","CH_GB18_DRU0:AS1","CH_GB18_BDAU:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AS-02","text":"The movement begins with the invalidation of a real ground which, as external reflection, itself becomes in need of grounding, and transforms grounding into a self-mediation of form, content, and presupposition.","refs":["CH_GB18_CD_2:AS2","CH_GB18_DRU0:D1","CH_GB18_BDAU:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AS-03","text":"The complete ground-relation determines ground and grounded as functional positions of a common content, whose difference initially consists only in the form of immediate and posited connection.","refs":["CH_GB18_CD_2:AS4","CH_GB18_DRU0:A17","CH_GB18_BDAU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AS-04","text":"Condition initially appears as the relatively unconditioned: immediate material for the ground, which is neither itself ground nor absolutely independent outside the ground-relation.","refs":["CH_GB18_DRU0:AS4","CH_GB18_DRU0:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AS-05","text":"The opposites of condition and ground are ultimately reconfigured as self-differences of a negative identity, in which the thing posits its conditions, presupposes them, and sublates them as mere semblance of relation.","refs":["CH_GB18_BDAU:AS4","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AS-06","text":"The overall movement is recursive and spiral-shaped: ground negates its external independence, presupposes its other, absorbs it as its own moment, and attains unconditionedness only as self-dividing self-identity.","refs":["CH_GB18_CD_2:A10","CH_GB18_BDAU:A1","CH_GB18_BDAU:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_44:GA-01","text":"[Persistent] Being-ground is not a fixed property of an isolated content, but a relational function within a mediated totality.","refs":["CH_GB18_CD_2:SD1","CH_GB18_DRU0:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-02","text":"[Persistent] Immediacy possesses no independent ontological priority, but always appears as a presupposed or sublated result of mediation.","refs":["CH_GB18_CD_2:ME3","CH_GB18_BDAU:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-03","text":"[Mutating] Condition mutates from immediate material initially indifferent to form into posited Ansichseyn and an inner moment of the movement of ground.","refs":["CH_GB18_DRU0:A8","CH_GB18_BDAU:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-04","text":"[Mutating] Ground mutates from the complete mediation of formal and real determinations into self-relating reflection, which posits its own Ansichseyn as condition over against itself.","refs":["CH_GB18_CD_2:A9","CH_GB18_BDAU:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-05","text":"[Emergent] At the cluster level, form and content are not separate spheres, but opposed functions of a single self-mediation, in which material is formed and form is materialized.","refs":["CH_GB18_CD_2:D6","CH_GB18_BDAU:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-06","text":"[Persistent] The difference between condition and ground remains necessary, yet has no status as an independent duality, but functions as the immanent self-difference of unity.","refs":["CH_GB18_DRU0:A18","CH_GB18_BDAU:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-07","text":"[Mutating] The unconditioned shifts from a relative functional determination of condition to the immanent unity that itself bears relativity and conditionedness.","refs":["CH_GB18_DRU0:SD2","CH_GB18_BDAU:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-08","text":"[Attractor] Negative identity is the system's attractor because it brings forth the division of condition and ground without dissolving their unity into a static equality.","refs":["CH_GB18_BDAU:A12","CH_GB18_BDAU:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-09","text":"[Terminal] The infinite regress of conditions loses its necessity as soon as condition is determined not as an externally independent instance, but as a moment of absolute self-movement.","refs":["CH_GB18_BDAU:NX5","CH_GB18_BDAU:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GA-10","text":"[Attractor] Completeness does not consist in presuppositionless self-identity, but in self-negation, return, and the reproduction of the other as its own moment.","refs":["CH_GB18_CD_2:NX7","CH_GB18_BDAU:A1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_44:RMD-01","text":"Ground recurs throughout as the central category, but shifts its function from external ground-relation through conditioned reflection to immanent self-positing.","refs":["CH_GB18_CD_2:A1","CH_GB18_BDAU:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RMD-02","text":"Condition does not recur as a constant presupposition, but mutates from immediate existence and material of the ground into formed matter and posited Ansichseyn.","refs":["CH_GB18_DRU0:A8","CH_GB18_BDAU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RMD-03","text":"Immediacy functionally recurs, yet loses its initial valence as independent subsistence and becomes the result or manifestation of mediation.","refs":["CH_GB18_DRU0:A13","CH_GB18_BDAU:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RMD-04","text":"The difference between ground and grounded, condition and ground, as well as form and content, is gradually absorbed from an external relation into a necessary self-difference of the same totality.","refs":["CH_GB18_CD_2:A6","CH_GB18_DRU0:A17","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RMD-05","text":"The unconditioned changes from a relative determination within a concrete ground-relation into an absolute negative unity that encompasses every such relation as a moment.","refs":["CH_GB18_DRU0:ME3","CH_GB18_BDAU:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RMD-06","text":"The regress does not simply disappear, but initially performs the structural work of making visible the inadequacy of external conditionedness before losing its necessity in the Absolute.","refs":["CH_GB18_DRU0:SNX1","CH_GB18_BDAU:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_44:CGD-01","text":"The distinction between two somethings with the same total content belongs to the local mechanics of the complete ground-relation; at the cluster level, it matters only insofar as it prepares the later sublation of external duality.","refs":["CH_GB18_CD_2:A6","CH_GB18_CD_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:CGD-02","text":"The contradiction between independence and being-a-moment is initially the conclusion of relative unconditionedness, but at the cluster level becomes the motor of transition to absolute unity.","refs":["CH_GB18_DRU0:AS6","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:CGD-03","text":"The difference between immediate conditional material and formed ground-content remains locally required, but is recoded at the higher level as an intermediate form of the identity of form and content.","refs":["CH_GB18_DRU0:A11","CH_GB18_BDAU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:CGD-04","text":"The global proposition of the cluster is not that a new first ground is found, but that every claim to a first, externally determined ground systematically passes over into mediated self-relation.","refs":["CH_GB18_CD_2:DNX1","CH_GB18_BDAU:DNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_44:GNX-01","text":"Excluded is a real ground that could possess its grounding function independently of the relation to the grounded and independently of further mediation.","refs":["CH_GB18_CD_2:NX1","CH_GB18_BDAU:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GNX-02","text":"Excluded are both a condition that could explain completely independently and a ground that would be pure form without presupposed material.","refs":["CH_GB18_DRU0:NX8","CH_GB18_DRU0:NX9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GNX-03","text":"Excluded is an absolute unconditioned as a static possession beyond positing, presupposing, negation, and self-division.","refs":["CH_GB18_DRU0:DNX2","CH_GB18_BDAU:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:GNX-04","text":"Excluded is a stable ontological duality of condition and ground, because their apparent externality is only the manifestation of a presupposed unity.","refs":["CH_GB18_DRU0:DNX6","CH_GB18_BDAU:DNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_44:DBN-01","text":"The system cannot permit a model of origin in which a thing proceeds linearly from previously independent grounds and conditions.","refs":["CH_GB18_CD_2:DNX2","CH_GB18_BDAU:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:DBN-02","text":"The system cannot resolve the contradiction between condition and ground through the one-sided priority of one side, because every such solution would destroy the structure of mediation.","refs":["CH_GB18_DRU0:DNX7","CH_GB18_BDAU:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:DBN-03","text":"The system cannot permit an absolute identity that contained no preserved difference, no self-division, and no return from the other.","refs":["CH_GB18_CD_2:DNX5","CH_GB18_BDAU:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_44:BSA-01","text":"Unavailable is an outside of mediation from which condition, ground, or the thing itself could be independently founded.","refs":["CH_GB18_CD_2:SNX4","CH_GB18_BDAU:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:BSA-02","text":"Unavailable is an absolutely first beginning, because every beginning already returns as mediated, posited, or sublated immediacy.","refs":["CH_GB18_CD_2:SNX1","CH_GB18_DRU0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:BSA-03","text":"Inadmissible is an unconditioned that would be available as a static substrate; the Absolute consists only in the movement through which it produces and sublates its moments.","refs":["CH_GB18_CD_2:SNX3","CH_GB18_BDAU:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_44:XD-01","text":"Condition is not the external limit of the ground-relation, but the form in which ground brings forth its own conditionedness and posits it as presupposition over against itself.","refs":["CL_GB18_44:GA-03","CL_GB18_44:GA-04","CL_GB18_44:GA-10","CH_GB18_CD_2:SD5","CH_GB18_DRU0:SD1","CH_GB18_BDAU:D3"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_44:XD-02","text":"The transition from common total content through conditional material to formed matter shows that content is not given prior to its formation, but becomes fully content only as the self-relation of form.","refs":["CL_GB18_44:GA-02","CL_GB18_44:GA-05","CH_GB18_CD_2:A6","CH_GB18_DRU0:D6","CH_GB18_BDAU:A8"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"CL_GB18_44:XD-03","text":"The apparent independence of condition and ground is neither a mere error nor an enduring reality, but the necessary manifestation in which absolute identity articulates itself as self-difference.","refs":["CL_GB18_44:GA-06","CL_GB18_44:GA-08","CH_GB18_DRU0:SD4","CH_GB18_BDAU:SD2"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"CL_GB18_44:XD-04","text":"The regress of conditions is not terminated by an external endpoint, but by the reclassification of finite conditionedness as a posited moment within absolute self-movement.","refs":["CL_GB18_44:GA-08","CL_GB18_44:GA-09","CH_GB18_BDAU:NX5","CH_GB18_BDAU:ME3"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"CL_GB18_44:XD-05","text":"The closure of the system consists not in eliminating the relation between condition and ground, but in transforming it into the immanent articulation of negative identity.","refs":["CL_GB18_44:GA-06","CL_GB18_44:GA-08","CH_GB18_CD_2:A3","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_44:BSD-01","text":"Causality is transformed from a model of proceeding from independent presuppositions into a model of self-manifestation, in which the thing possesses its conditions only as moments of its own enactment.","refs":["CL_GB18_44:GA-04","CL_GB18_44:GA-08","CH_GB18_BDAU:SD4","CH_GB18_BDAU:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_44:BSD-02","text":"Explanation becomes methodologically the reconstruction of the conditions under which something can be ground, rather than the search for an isolable first bearer of grounding character.","refs":["CL_GB18_44:GA-01","CL_GB18_44:GA-10","CH_GB18_CD_2:ALT3","CH_GB18_DRU0:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_44:BSD-03","text":"Temporality loses the form of an external beginning-afterwards schema; what appears first receives its determination only retrospectively as the presupposition of a mediation already accomplished.","refs":["CL_GB18_44:GA-02","CL_GB18_44:GA-10","CH_GB18_CD_2:ALT4","CH_GB18_BDAU:ME1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_44:BSD-04","text":"The thing itself is determined not as a substrate behind its relations, but as a negative unity whose reality consists exclusively in the production, division, and sublation of its moments.","refs":["CL_GB18_44:GA-08","CL_GB18_44:GA-10","CH_GB18_BDAU:AS5","CH_GB18_BDAU:SD3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_44:RLE-01","text":"Ground enters a recursive loop because its external grounding function itself makes it into the grounded, whose presupposition in turn appears as the condition of ground.","refs":["CH_GB18_CD_2:D1","CH_GB18_CD_2:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RLE-02","text":"Immediacy forms an escalation loop: it appears as a point of departure, is taken up as material, loses its indifference, and returns as mediated immediacy.","refs":["CH_GB18_CD_2:ME3","CH_GB18_DRU0:A12","CH_GB18_BDAU:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RLE-03","text":"The reciprocity of condition and ground forms an attractor, because each side is determined only through its apparently independent counterpart and receives its truth only in the presupposed identity.","refs":["CH_GB18_DRU0:A18","CH_GB18_BDAU:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:RLE-04","text":"Negative identity functions as a terminal attractor because it does not erase the recurrence of external difference, but reproduces it as the necessary self-division of unity.","refs":["CH_GB18_CD_2:A10","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_44:FGS-B01","text":"External real ground → loss of its independent grounding character → transition of ground to the side of the grounded.","refs":["CH_GB18_CD_2:AS1","CH_GB18_CD_2:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:FGS-B02","text":"Common content → difference of immediate and posited connection → complete ground-relation as mediation of the grounding character itself.","refs":["CH_GB18_CD_2:AS4","CH_GB18_CD_2:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:FGS-B03","text":"Presupposed immediate existence → condition as relatively unconditioned → taking up of material as a moment of the ground-relation.","refs":["CH_GB18_DRU0:A8","CH_GB18_DRU0:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:FGS-B04","text":"Condition as posited Ansichseyn + ground as presupposing reflection → reciprocal externalization of form and content → identity of their movement.","refs":["CH_GB18_BDAU:AS2","CH_GB18_BDAU:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:FGS-B05","text":"Identity of condition and ground → negative self-division → sublation of the semblance of relation → absolutely unconditioned thing.","refs":["CH_GB18_BDAU:A11","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_44:AFM-B01","text":"External ground → grounding character in need of grounding → complete ground-relation → condition as presupposed immediacy.","refs":["CH_GB18_CD_2:AS1","CH_GB18_CD_2:AS3","CH_GB18_DRU0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AFM-B02","text":"Condition as material → relative unconditionedness → contradiction between independence and being-a-moment → crisis of external duality.","refs":["CH_GB18_DRU0:A11","CH_GB18_DRU0:SD2","CH_GB18_DRU0:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AFM-B03","text":"Presupposing and positing → identity of form and content → recoding of condition and ground as moments of one thing.","refs":["CH_GB18_BDAU:A5","CH_GB18_BDAU:A9","CH_GB18_BDAU:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:AFM-B04","text":"Negative identity → sublation of the external semblance of relation → absolutely unconditioned as immanent self-movement.","refs":["CH_GB18_BDAU:A12","CH_GB18_BDAU:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_44:MME-01","text":"Ground and condition are no longer mapped as separate explanatory terms, but as different functional phases of a self-mediation.","refs":["CH_GB18_CD_2:ME1","CH_GB18_BDAU:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MME-02","text":"The unconditioned is remapped from an absolute status into a form of movement that contains relativity, mediation, and self-negation within itself.","refs":["CH_GB18_DRU0:ME3","CH_GB18_BDAU:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MME-03","text":"The opposition of form and content disintegrates as a rigid alternative and is reconfigured as the internal counter-movement of materialization and formation.","refs":["CH_GB18_CD_2:ME2","CH_GB18_DRU0:ME4","CH_GB18_BDAU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MME-04","text":"The infinite regress is not treated as a necessary consequence of conditionedness, but as an effect of the false absolutization of finite and external determinations.","refs":["CH_GB18_BDAU:ME3","CH_GB18_BDAU:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_44:ALT-B01","text":"Surface level — The cluster treats the relation of ground, grounded, condition, relatively unconditioned, and absolutely unconditioned.","refs":["CH_GB18_CD_2:ALT1","CH_GB18_BDAU:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:ALT-B02","text":"Structural level — The operative structure is a machine of reflection in which positing and presupposing form the same movement and immediacy appears as a moment of this movement.","refs":["CH_GB18_CD_2:ALT2","CH_GB18_BDAU:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:ALT-B03","text":"Metastrategic level — Explanation is reorganized as the reconstruction of the immanent conditions of grounding character and directed against the search for isolated origins.","refs":["CH_GB18_CD_2:ALT3","CH_GB18_DRU0:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:ALT-B04","text":"Ontological-temporal level — Reality has no unmediated beginning, but is transition, negation, and return of an identity that sustains itself only in the other.","refs":["CH_GB18_CD_2:ALT5","CH_GB18_BDAU:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:ALT-B05","text":"Methodological-performative level — The exposition enacts its thesis by retrospectively transforming every seemingly fixed point of departure into a presupposed result.","refs":["CH_GB18_DRU0:AS2","CH_GB18_BDAU:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_44:FL-01","text":"Totality must presuppose a condition in order to mediate itself as ground, but must at the same time sublate this condition as its own posited moment; this tension is productive and not conclusively neutralized.","refs":["CH_GB18_CD_2:MRT5","CH_GB18_BDAU:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:FL-02","text":"The relation between condition and ground is supposed to disappear as external semblance, but must continue to be articulated as a necessary articulation of absolute movement.","refs":["CH_GB18_CD_2:MRT6","CH_GB18_BDAU:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MP-01","text":"At the threshold of the Absolute, condition mutates from indifferent immediate material into formed matter, without wholly losing its function as a moment of immediacy.","refs":["CH_GB18_DRU0:A8","CH_GB18_BDAU:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MP-02","text":"The unconditioned mutates from the relative unconditionedness of condition into the negative identity of the thing; the transition preserves the earlier relativity only as a sublated moment.","refs":["CH_GB18_DRU0:ME3","CH_GB18_BDAU:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_44:HSI-01","text":"Reality appears as a reflexive machine that processes no external foundations, but produces, differentiates, and takes back into itself its own presuppositions.","refs":["CH_GB18_BDAU:AS5","CH_GB18_BDAU:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:HSI-02","text":"The thing itself is not a substance behind its conditions, but an enactment of negative identity whose moments possess reality only in their self-division.","refs":["CH_GB18_BDAU:SD3","CH_GB18_BDAU:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:HSI-03","text":"Time is conceived as a retroactive order: the presupposed is not originally prior to mediation, but receives its status only through the movement that posits it as presupposition.","refs":["CH_GB18_CD_2:ALT5","CH_GB18_BDAU:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:HSI-04","text":"Strategically, no escape into a first ground remains possible; possible is only the navigation of the transitions through which material, form, condition, and ground receive their respective functions.","refs":["CH_GB18_CD_2:ALT3","CH_GB18_DRU0:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_44:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from external ground-relation through relatively conditioned reflection to the negative identity of the absolutely unconditioned.","refs":["CH_GB18_CD_2:MRT1","CH_GB18_BDAU:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MRT-B02","text":"What remains underdetermined is how the specific finitude of an existence generates the regress-triggering question of a further condition and why this question becomes necessary precisely there.","refs":["CH_GB18_CD_2:MRT2","CH_GB18_BDAU:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MRT-B03","text":"The cluster architecture is coherent provided that presupposition is read not as temporally pre-existing, but as a reflexive functional determination of a self-mediation.","refs":["CH_GB18_CD_2:MRT3","CH_GB18_BDAU:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_44:MRT-B04","text":"The reconstruction remains dependent on the productive tension that identity is possible only as self-division and sublation of the relation that it must simultaneously articulate.","refs":["CH_GB18_CD_2:MRT7","CH_GB18_BDAU:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_44@R001","source_variant_id":"canonical:CL_GB18_44:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 130–132","context":"c. Der vollständige Grund. · a. Das relativ Unbedingte. · b. Das absolute Unbedingte."},"title_language_code":"en"},{"id":"CL_GB18_45","layer":"CL","title":"Chapters 133–135","order":45,"parents":["CH_GB18_CHDS","CH_GB18_ZADE","CH_GB18_DDUS"],"revision":"CL_GB18_45@R001","sha256":"894fed1f03152e261514f3df0bb4db8aec3c1075f2d15cb5cbf775fbfc20525b","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_45:AS-B01","text":"Das System bestimmt Existenz nicht als Effekt eines ihr vorausliegenden Grundes, sondern als Problem der Selbsthervorbringung einer Sache, deren Bedingungen, Grund und Hervorgang immanent zusammenfallen.","refs":["CH_GB18_CHDS:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B02","text":"Die unbedingte Sache wird nicht durch Abwesenheit von Bedingungen bestimmt, sondern dadurch, dass sie ihre Bedingungen als eigene gesetzte Äußerlichkeit erzeugt.","refs":["CH_GB18_CHDS:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B03","text":"Grund, Bedingung und Reflexion werden als Funktionen einer einzigen Selbstvermittlung rekonstruiert, deren Momente nur durch ihre gegenseitige Aufhebung bestehen.","refs":["CH_GB18_CHDS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B04","text":"Das Hervortreten in Existenz schlägt nicht in eine bloß gegebene Unmittelbarkeit um, sondern in Erscheinung als reflektierte Wahrheit des Dings.","refs":["CH_GB18_ZADE:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B05","text":"Das Ding ist die negative Einheit, in der vermittelte Unmittelbarkeit als Existierendes Bestand gewinnt und zugleich ihre innere Differenz bewahrt.","refs":["CH_GB18_DDUS:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B06","text":"Die Argumentform ist dialektisch-rekonstruktiv: Sie verfolgt, wie Negativität und Reflexion ihre eigenen Voraussetzungen setzen, aufheben und als veränderte Gestalten zurückgewinnen.","refs":["CH_GB18_ZADE:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B07","text":"Die Bewegung ist weder linear noch bloß zyklisch, sondern spiralförmig: Jede erreichte Unmittelbarkeit offenbart sich als gesetzte, hebt sich auf und wird zur Bedingung einer höheren Vermittlungsform.","refs":["CH_GB18_CHDS:AF6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B08","text":"Die vorläufige Schließung liegt in Wirklichkeit als vollständiger Durchdringung von Reflexion-in-sich und Reflexion-ins-Anderssein, ohne dass diese Durchdringung ihre genetische Negativität auslöscht.","refs":["CH_GB18_ZADE:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_45:GA-01","text":"[Persistent] Unmittelbarkeit ist nie erster Ausgangspunkt, sondern die positive Resultatform einer zuvor vollzogenen und in ihr verschwundenen Vermittlung.","refs":["CH_GB18_CHDS:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-02","text":"[Attractor] Immanente Negativität ist der universale Generationsoperator, durch den Sein, Grund, Bedingung, Existenz, Erscheinung und Ding ihre jeweilige Gestalt verlieren und gewinnen.","refs":["CH_GB18_ZADE:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-03","text":"[Mutating] Der Grund beginnt als Bedingungs- und Erklärungsfunktion, wird aber nur wahr, indem er als abgesonderter Grund verschwindet und als negativer Ursprung der Existenz fortwirkt.","refs":["CH_GB18_CHDS:A9","CH_GB18_DDUS:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-04","text":"[Persistent] Äußerlichkeit ist keine fremde Sphäre, sondern die auseinandergetretene Form des vollständigen Inhalts, in der die Sache sich selbst als Bedingung, Existenz und Erscheinung aussetzt.","refs":["CH_GB18_CHDS:A4","CH_GB18_ZADE:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-05","text":"[Emergent] Existenz, Erscheinung und Ding bilden keine getrennten Ontologien, sondern aufeinanderfolgende Konfigurationen vermittelter Unmittelbarkeit.","refs":["CH_GB18_DDUS:A2","CH_GB18_DDUS:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-06","text":"[Persistent] Wahrheit liegt weder hinter noch neben der Erscheinung, sondern in der Selbstmanifestation des Wesens innerhalb des erscheinenden und dinglichen Seins.","refs":["CH_GB18_ZADE:NX5","CH_GB18_DDUS:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-07","text":"[Terminal] Wirklichkeit ist keine weitere Entität, sondern die Vollendung jener Beziehung, in der Wesen und Anderssein einander vollständig durchdringen.","refs":["CH_GB18_ZADE:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-08","text":"[Attractor] Differenz wird nicht überwunden, indem sie ausgelöscht wird, sondern indem sie als interne Artikulation einer negativen Einheit erhalten bleibt.","refs":["CH_GB18_DDUS:A11","CH_GB18_ZADE:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_45:RMD-01","text":"Unmittelbarkeit kehrt funktional wieder, mutiert jedoch von äußerlichem Dasein über gesetzte Existenz zu vermittelter Unmittelbarkeit und verliert damit jeden Status eines voraussetzungslosen Anfangs.","refs":["CH_GB18_CHDS:NX2","CH_GB18_ZADE:ME1","CH_GB18_DDUS:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RMD-02","text":"Der Grund verschiebt sich von der formalen Bedingung der Sache zum negativen Grund ihres Hervorgangs; seine bleibende Funktion besteht gerade in seinem Verschwinden als selbständige Instanz.","refs":["CH_GB18_CHDS:A9","CH_GB18_DDUS:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RMD-03","text":"Die Bedingung mutiert von scheinbar äußerlichem Material zur gesetzten Äußerlichkeit des vollständigen Inhalts und wird dadurch in die Erscheinungslogik absorbiert.","refs":["CH_GB18_CHDS:NX1","CH_GB18_CHDS:FGS3","CH_GB18_ZADE:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RMD-04","text":"Erscheinung kehrt nicht als reduzierter Schein wieder, sondern als Wahrheitsform des Dings, in der die Differenz von Wesen und Existenz sichtbar und relationierbar wird.","refs":["CH_GB18_ZADE:A12","CH_GB18_ZADE:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RMD-05","text":"Die subjektive Reflexion des Beweisens wird in immanente Vermittlung umcodiert: Was zunächst als erkenntnismäßige Operation erscheint, wird als Bewegung des Wesens selbst lesbar.","refs":["CH_GB18_DDUS:A6","CH_GB18_DDUS:A7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_45:CGD-01","text":"Die Vollständigkeit bestimmter Bedingungen bleibt eine lokale Schwelle des Hervorgangs; auf Clusterebene trägt nur die übergeordnete Regel, dass Totalität äußerlicher Momente in Selbstaufhebung umschlägt.","refs":["CH_GB18_CHDS:A8","CH_GB18_CHDS:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:CGD-02","text":"Die absolute Abstraktion des Seyns ist ein lokaler Einstiegspunkt; ihre aufwärts skalierende Funktion besteht darin, Negativität als allgemeine Bedingung jeder späteren Bestimmtheit auszuweisen.","refs":["CH_GB18_ZADE:A1","CH_GB18_ZADE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:CGD-03","text":"Der Gottesbeweis bleibt ein lokaler Prüfungsfall; seine aktuelle Bedeutung liegt in der globalen Unterscheidung zwischen äußerem Erkenntnisgrund und immanenter Vermittlung.","refs":["CH_GB18_DDUS:AS3","CH_GB18_DDUS:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:CGD-04","text":"Die Differenz von Ding-an-sich und äußerlicher Existenz bleibt eine lokale analytische Artikulation; auf Clusterebene wird sie in das allgemeinere Prinzip immanenter Differenz innerhalb vermittelter Unmittelbarkeit aufgenommen.","refs":["CH_GB18_DDUS:A11","CH_GB18_DDUS:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_45:GNX-01","text":"Ausgeschlossen wird jede Erklärung, in der ein äußerlicher Grund oder ein fremdes Material die Sache erzeugt, ohne selbst als Moment ihrer Bewegung bestimmt zu sein.","refs":["CH_GB18_CHDS:NX1","CH_GB18_DDUS:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GNX-02","text":"Ausgeschlossen wird eine ursprüngliche Unmittelbarkeit, die vor Negativität, Setzung und aufgehobener Vermittlung bestehen könnte.","refs":["CH_GB18_CHDS:NX2","CH_GB18_DDUS:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GNX-03","text":"Ausgeschlossen wird ein Wesen, das hinter seiner Erscheinung verborgen bliebe, ebenso wie eine Erscheinung, die nur subjektive oder zufällige Oberfläche wäre.","refs":["CH_GB18_ZADE:NX5","CH_GB18_ZADE:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GNX-04","text":"Ausgeschlossen wird Vermittlung als bleibendes Drittes zwischen bereits selbständigen Termen; sie ist nur wirksam als Selbsttilgung ihrer eigenen Trennung.","refs":["CH_GB18_CHDS:NX5","CH_GB18_CHDS:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_45:DBN-01","text":"Unwahr ist ein Gesamtmodell selbständiger Substanzen, in dem Grund, Wesen, Bedingungen, Erscheinungen und Dinge vor ihrer Beziehung bereits ontologisch fertig wären.","refs":["CH_GB18_ZADE:SNX3","CH_GB18_DDUS:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:DBN-02","text":"Unwahr ist eine Erklärung, die ihren erklärenden Grund nach vollzogener Erklärung als unverändertes Fundament zurückbehält.","refs":["CH_GB18_CHDS:DNX2","CH_GB18_DDUS:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:DBN-03","text":"Unzulässig ist die Annahme eines zugänglichen An-sich außerhalb des Erscheinens, weil das An-sich nur innerhalb der Vermittlung seiner Erscheinung bestimmt werden kann.","refs":["CH_GB18_ZADE:SNX2","CH_GB18_ZADE:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_45:BSA-01","text":"Unverfügbar bleibt ein letzter Anfang, der nicht selbst als gesetzte und aufgehobene Unmittelbarkeit bestimmt werden müsste.","refs":["CH_GB18_CHDS:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:BSA-02","text":"Unmöglich bleibt ein Absolutes, das seine Identität ohne immanente Negativität, Selbstentäußerung und Erscheinung bewahren könnte.","refs":["CH_GB18_ZADE:DNX1","CH_GB18_ZADE:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:BSA-03","text":"Unzulässig bleibt ein äußerer Standort, von dem aus Wesen, Existenz und Erscheinung als voneinander getrennte Regionen beurteilt werden könnten.","refs":["CH_GB18_CHDS:SNX3","CH_GB18_DDUS:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_45:XD-01","text":"Die äußerliche Vielheit der Bedingungen und die Erscheinung des Dings sind zwei Skalen derselben Operation: vollständiger Inhalt wird als Äußerlichkeit gesetzt, damit er als immanente Wahrheit zurückkehren kann.","refs":["CL_GB18_45:GA-04","CL_GB18_45:GA-06","CH_GB18_CHDS:A4","CH_GB18_ZADE:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_45:XD-02","text":"Das Verschwinden des Grundes ist kein Verlust von Erklärung, sondern die Transformation von Erklärung in positive Existenz; Grundlosigkeit bezeichnet daher vollendete Selbstvermittlung.","refs":["CL_GB18_45:GA-01","CL_GB18_45:GA-03","CH_GB18_CHDS:SD1","CH_GB18_DDUS:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_45:XD-03","text":"Weil Erscheinung die Wahrheit des Dings und das Ding negative Einheit ist, kann kein dingliches Inneres als unberührter Rest außerhalb seiner manifesten Vermittlung bestehen.","refs":["CL_GB18_45:GA-06","CL_GB18_45:GA-08","CH_GB18_ZADE:D8","CH_GB18_DDUS:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_45:XD-04","text":"Wirklichkeit entsteht auf dieser Ebene als retrospektive Lesbarkeit des gesamten Übergangs: Bedingung, Grund, Existenz, Erscheinung und Ding erweisen sich erst im Vollzug ihrer gegenseitigen Aufhebung als Momente einer einzigen Bewegung.","refs":["CL_GB18_45:GA-02","CL_GB18_45:GA-07","CH_GB18_CHDS:FGS6","CH_GB18_ZADE:SD5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_45:BSD-01","text":"Kausalität wird von einer Relation zwischen äußerlich getrennten Ursachen und Wirkungen zu einer Selbstproduktionsform umgeordnet, in der das Hervorgebrachte die aufgehobene Tätigkeit seines Hervorbringens ist.","refs":["CH_GB18_CHDS:D4","CH_GB18_DDUS:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:BSD-02","text":"Erkenntnis besitzt keinen privilegierten Außenstandpunkt: Sie ist wahr nur, sofern sie ihre eigene Vermittlung als immanente Bewegung des Gegenstands anerkennt.","refs":["CH_GB18_DDUS:D2","CH_GB18_DDUS:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:BSD-03","text":"Das Subjekt wird nicht als souveräner Setzer der Vermittlung bestimmt, sondern als nachträgliche Reflexionsfunktion innerhalb eines Prozesses, dessen Gegenständlichkeit seine subjektive Form übersteigt.","refs":["CH_GB18_DDUS:A7","CH_GB18_DDUS:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:BSD-04","text":"Zeitlichkeit wird rückläufig: Das Spätere begründet nicht das Frühere kausal, sondern enthüllt dessen Wahrheit als aufgehobenes Moment einer erst nachträglich vollständigen Bewegung.","refs":["CH_GB18_CHDS:ALT5","CH_GB18_ZADE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_45:RLE-01","text":"Die erste Schleife lautet: abstraktes Seyn setzt seine eigene Negativität frei, hebt sich dadurch auf und kehrt als Wesen zu einer veränderten Selbstgleichheit zurück.","refs":["CH_GB18_ZADE:A3","CH_GB18_ZADE:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RLE-02","text":"Die zweite Schleife lautet: Grund setzt Bedingung, Bedingung enthält den vollständigen Inhalt des Grundes, und ihre Totalität hebt beide als selbständige Instanzen auf.","refs":["CH_GB18_CHDS:A2","CH_GB18_CHDS:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RLE-03","text":"Die dritte Schleife lautet: Existenz erscheint zunächst als unmittelbares Ding, dessen reflexiver Grund diese Unmittelbarkeit aufhebt und als Erscheinung zurücksetzt.","refs":["CH_GB18_ZADE:A9","CH_GB18_ZADE:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RLE-04","text":"Der Attraktor der Bewegung ist vermittelte Unmittelbarkeit: Jede Form gewinnt Stabilität nur, indem sie die Vermittlung bewahrt, deren sichtbare Selbständigkeit sie zugleich zerstört.","refs":["CH_GB18_DDUS:A9","CH_GB18_DDUS:ALT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RLE-05","text":"Die Eskalation führt von der Selbstaufhebung einzelner Bestimmungen zur vollständigen Durchdringung von Wesen und Anderssein; Wirklichkeit ist der Grenzfall dieser rekursiven Verdichtung.","refs":["CH_GB18_ZADE:FGS5","CH_GB18_ZADE:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_45:FGS-B01","text":"Immanente Negativität des Seyns → Selbstaufhebung des Seyns → Wesen als veränderte Selbstgleichheit.","refs":["CH_GB18_ZADE:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FGS-B02","text":"Wesen als Reflexion → Setzung und Aufhebung von Bestimmungen → Grund als selbstrelationaler Vermittlungsmodus.","refs":["CH_GB18_ZADE:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FGS-B03","text":"Grund als Selbstsetzung → Bedingung als äußerliche Vollständigkeit des Inhalts → Aufhebung der vorausgesetzten Trennung.","refs":["CH_GB18_CHDS:FGS2","CH_GB18_CHDS:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FGS-B04","text":"Aufgehobener Grund und aufgehobene Bedingung → vermittelte Unmittelbarkeit → Existenz als Selbstentäußerung des Wesens.","refs":["CH_GB18_CHDS:FGS6","CH_GB18_DDUS:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FGS-B05","text":"Reflexiv instabile Existenz → Ding als Gesetztsein → Erscheinung als Wahrheit des Dings.","refs":["CH_GB18_ZADE:FGS4","CH_GB18_ZADE:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FGS-B06","text":"Erscheinung und wesentliches Seyn → Verhältnis der Reflexionsrichtungen → Wirklichkeit als Durchdringung bei fortbestehender immanenter Differenz.","refs":["CH_GB18_ZADE:A13","CH_GB18_ZADE:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_45:AFM-B01","text":"Äußerliche Bedingtheit wird als Schein einer Abhängigkeit von Anderem sichtbar.","refs":["CH_GB18_CHDS:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AFM-B02","text":"Die Bedingung wird als Selbstsetzung des Grundes und als äußerlich gewordener vollständiger Inhalt reklassifiziert.","refs":["CH_GB18_CHDS:AF2","CH_GB18_CHDS:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AFM-B03","text":"Die Selbstaufhebung von Grund und Bedingung erzeugt Existenz als begründete Grundlosigkeit und positive vermittelte Unmittelbarkeit.","refs":["CH_GB18_CHDS:AF5","CH_GB18_DDUS:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AFM-B04","text":"Die Unmittelbarkeit der Existenz wird durch ihre eigene Reflexivität als Gesetztsein instabil und schlägt in Erscheinung um.","refs":["CH_GB18_ZADE:AF4","CH_GB18_ZADE:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AFM-B05","text":"Erscheinung vermittelt Wesen und Anderssein, ohne ihre Differenz in eine äußerliche Trennung zurückfallen zu lassen.","refs":["CH_GB18_ZADE:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AFM-B06","text":"Das Verhältnis vollendet sich als Wirklichkeit, in der die gesamte vorausgehende Sequenz als Selbstentfaltung einer negativen Einheit lesbar wird.","refs":["CH_GB18_ZADE:AF6","CH_GB18_ZADE:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_45:MME-01","text":"Grund und Ursache werden von asymmetrischen Fundierungsinstanzen zu transitorischen Funktionen einer Selbstaufhebungsbewegung umkartiert.","refs":["CH_GB18_CHDS:ME1","CH_GB18_DDUS:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MME-02","text":"Erscheinung wird von einem Gegensatz zur Wahrheit zu deren notwendiger Vollzugsform umklassifiziert.","refs":["CH_GB18_ZADE:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MME-03","text":"Die Opposition zwischen einer Erscheinungswelt und einem An-sich zerfällt als absolute Trennung und wird als interne Relation einer einzigen Wirklichkeit lesbar.","refs":["CH_GB18_ZADE:ME3","CH_GB18_ZADE:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MME-04","text":"Das Ding wird von einer atomaren Einheit mit äußerlich hinzugefügten Eigenschaften zu einer negativen Einheit immanenter Vermittlung neu bestimmt.","refs":["CH_GB18_DDUS:ME4","CH_GB18_DDUS:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_45:ALT-B01","text":"Surface level — Eine Sache tritt nicht einfach ein, sondern gewinnt Existenz, indem ihre Bedingungen, ihr Grund und ihre Vermittlung ihre selbständige Gestalt verlieren.","refs":["CH_GB18_CHDS:ALT1","CH_GB18_DDUS:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:ALT-B02","text":"Structural level — Grund, Bedingung, Existenz, Erscheinung und Ding sind keine selbständigen Entitäten, sondern aufeinander übergehende Funktionsformen derselben negativen Bewegung.","refs":["CH_GB18_CHDS:ALT2","CH_GB18_ZADE:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:ALT-B03","text":"Metastrategic level — Erklären heißt nicht, eine äußere Ursache zuzuweisen, sondern die Selbstaufhebung zu rekonstruieren, durch die ein Gegenstand seine eigene Erscheinungsform erzeugt.","refs":["CH_GB18_CHDS:ALT3","CH_GB18_ZADE:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:ALT-B04","text":"Ontological / Temporal level — Das Erste ist nicht ursprüngliche Präsenz, sondern eine rückläufige Selbstsetzung, deren Resultat ihre Voraussetzung erst als aufgehobenes Moment bestimmt.","refs":["CH_GB18_CHDS:ALT4","CH_GB18_DDUS:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:ALT-B05","text":"Methodological / Performative level — Die Form der Rekonstruktion vollzieht ihren Gegenstand, indem sie jede feste Ausgangsbestimmung als spätere und aufgehobene Funktion einer umfassenderen Vermittlung ausweist.","refs":["CH_GB18_ZADE:SD4","CH_GB18_DDUS:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_45:FL-01","text":"Die Bedingungen sollen vollständiger Inhalt der Sache sein, treten jedoch zunächst als äußerliche, gleichgültige und mit Außerwesentlichem vermischte Mannigfaltigkeit auf; die Einheit ihrer Totalität bleibt daher nicht unmittelbar gesichert.","refs":["CH_GB18_CHDS:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FL-02","text":"Erscheinung wird als Wahrheit des Dings bestimmt, während die Gegenüberstellung von Erscheinungswelt und an-sich-seiender Welt eine Differenz aufrechterhält, deren genauer Status zwischen relationaler Vermittlung und Restopposition oszilliert.","refs":["CH_GB18_ZADE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FL-03","text":"Das Wesen soll mit seiner Existenz identisch sein, doch die analytische Differenz von Ding-an-sich und äußerlicher Existenz verlangt eine nicht restlos eliminierbare Binnenunterscheidung.","refs":["CH_GB18_DDUS:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MP-01","text":"Der Grund mutiert vom tragenden Erklärungsprinzip zum negativen Grund: Seine Aufhebung zerstört nicht seine Funktion, sondern radikalisiert sie zur generativen Bedingung der Existenz.","refs":["CH_GB18_DDUS:AS4","CH_GB18_DDUS:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MP-02","text":"Unmittelbarkeit mutiert vom scheinbar gegebenen Sein zur positiven Form aufgehobener Vermittlung und erhält dadurch eine genetische Tiefe, die ihrer Erscheinungsform widerspricht.","refs":["CH_GB18_ZADE:SD1","CH_GB18_DDUS:ALT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MP-03","text":"Die beweisende Reflexion mutiert von äußerlich-subjektiver Erkenntnistätigkeit zur Selbstdarstellung des Wesens; ihre Doppelstellung bleibt produktiv instabil.","refs":["CH_GB18_DDUS:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_45:HSI-01","text":"Die Realität erscheint als Maschine negativer Selbstproduktion: Sie setzt sich in Äußerlichkeit aus, löscht deren Selbständigkeit und gewinnt gerade dadurch eine reichere Gestalt von Unmittelbarkeit.","refs":["CH_GB18_CHDS:SD3","CH_GB18_DDUS:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:HSI-02","text":"Das Ding ist keine ruhende Substanz, sondern ein Knotenpunkt, an dem aufgehobene Vermittlung als negative Einheit besteht und seine Differenzen in sich trägt.","refs":["CH_GB18_DDUS:FGS6","CH_GB18_DDUS:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:HSI-03","text":"Zeit ist keine Folge von Zuständen, sondern die rückläufige Ordnung, in der jede erreichte Bestimmung ihre Herkunft als aufgehobene Voraussetzung enthüllt.","refs":["CH_GB18_ZADE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:HSI-04","text":"Orientierung ist nur im Nachvollzug von Übergängen möglich: Nicht ein äußerer Standpunkt, sondern die Kartierung von Setzung, Aufhebung, Erscheinung und Rückkehr eröffnet Zugang zur Sache.","refs":["CH_GB18_CHDS:ALT3","CH_GB18_ZADE:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_45:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Clusterbewegung von unbedingter Sache über Grund und Bedingung zu Existenz, Erscheinung, Ding und Wirklichkeit als eine durchgehende Selbstvermittlung zu rekonstruieren.","refs":["CH_GB18_CHDS:MRT1","CH_GB18_ZADE:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MRT-B02","text":"Unterbestimmt bleiben die Kriterien, nach denen Bedingungen als vollständig gelten, sowie die konkrete Bestimmung der Wirklichkeit über ihre formale Durchdringungsstruktur hinaus.","refs":["CH_GB18_ZADE:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MRT-B03","text":"Die Rekonstruktion ist kohärent nur unter der Bedingung, dass das Verschwinden der Vermittlung als ihre höchste Wirksamkeit und nicht als bloßer Wegfall begriffen wird.","refs":["CH_GB18_CHDS:MRT7","CH_GB18_DDUS:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MRT-B04","text":"Der irreduzible Rest liegt in der produktiven Spannung zwischen Identität und interner Differenz: Die Architektur verlangt zugleich die Einheit von Wesen und Existenz sowie ihre fortgesetzte analytische Artikulation im Ding und in der Erscheinung.","refs":["CH_GB18_DDUS:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122620254615Z_4868544a","language_code":"en","language_name":"English","title":"Chapters 133–135","source_sha256":"894fed1f03152e261514f3df0bb4db8aec3c1075f2d15cb5cbf775fbfc20525b","sha256":"3395ee23725421e1801740d15b4ec3f0aa33f329edcc2da9fa19be0041c2eb90","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:26:20.256431+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_45:AS-B01","text":"The system determines existence not as the effect of a ground antecedent to it, but as the problem of the self-production of a thing whose conditions, ground, and emergence coincide immanently.","refs":["CH_GB18_CHDS:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B02","text":"The unconditioned thing is determined not by the absence of conditions, but by the fact that it produces its conditions as its own posited externality.","refs":["CH_GB18_CHDS:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B03","text":"Ground, condition, and reflection are reconstructed as functions of a single self-mediation, whose moments subsist only through their reciprocal sublation.","refs":["CH_GB18_CHDS:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B04","text":"Emergence into existence does not turn into a merely given immediacy, but into appearance as the reflected truth of the thing.","refs":["CH_GB18_ZADE:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B05","text":"The thing is the negative unity in which mediated immediacy gains subsistence as what exists and at the same time preserves its internal difference.","refs":["CH_GB18_DDUS:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B06","text":"The argumentative form is dialectical-reconstructive: it traces how negativity and reflection posit, sublate, and recover their own presuppositions as transformed configurations.","refs":["CH_GB18_ZADE:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B07","text":"The movement is neither linear nor merely cyclical, but spiral-shaped: every attained immediacy reveals itself as posited, sublates itself, and becomes the condition of a higher form of mediation.","refs":["CH_GB18_CHDS:AF6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AS-B08","text":"The provisional closure lies in actuality as the complete interpenetration of reflection-into-itself and reflection-into-otherness, without this interpenetration erasing its genetic negativity.","refs":["CH_GB18_ZADE:A15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_45:GA-01","text":"[Persistent] Immediacy is never the first point of departure, but the positive result-form of a mediation previously accomplished and vanished within it.","refs":["CH_GB18_CHDS:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-02","text":"[Attractor] Immanent negativity is the universal generative operator through which being, ground, condition, existence, appearance, and thing lose and gain their respective configuration.","refs":["CH_GB18_ZADE:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-03","text":"[Mutating] Ground begins as a function of condition and explanation, but becomes true only by vanishing as a separate ground and continuing to operate as the negative origin of existence.","refs":["CH_GB18_CHDS:A9","CH_GB18_DDUS:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-04","text":"[Persistent] Externality is not an alien sphere, but the diverged form of complete content, in which the thing exposes itself as condition, existence, and appearance.","refs":["CH_GB18_CHDS:A4","CH_GB18_ZADE:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-05","text":"[Emergent] Existence, appearance, and thing do not constitute separate ontologies, but successive configurations of mediated immediacy.","refs":["CH_GB18_DDUS:A2","CH_GB18_DDUS:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-06","text":"[Persistent] Truth lies neither behind nor alongside appearance, but in the self-manifestation of essence within appearing and thingly being.","refs":["CH_GB18_ZADE:NX5","CH_GB18_DDUS:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-07","text":"[Terminal] Actuality is not a further entity, but the completion of that relation in which essence and otherness completely interpenetrate one another.","refs":["CH_GB18_ZADE:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GA-08","text":"[Attractor] Difference is not overcome by being erased, but by remaining preserved as the internal articulation of a negative unity.","refs":["CH_GB18_DDUS:A11","CH_GB18_ZADE:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_45:RMD-01","text":"Immediacy functionally recurs, but mutates from external Dasein through posited existence into mediated immediacy and thereby loses every status as a presuppositionless beginning.","refs":["CH_GB18_CHDS:NX2","CH_GB18_ZADE:ME1","CH_GB18_DDUS:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RMD-02","text":"Ground shifts from the formal condition of the thing to the negative ground of its emergence; its enduring function consists precisely in its disappearance as an independent instance.","refs":["CH_GB18_CHDS:A9","CH_GB18_DDUS:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RMD-03","text":"Condition mutates from seemingly external material into the posited externality of complete content and is thereby absorbed into the logic of appearance.","refs":["CH_GB18_CHDS:NX1","CH_GB18_CHDS:FGS3","CH_GB18_ZADE:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RMD-04","text":"Appearance recurs not as reduced semblance, but as the truth-form of the thing, in which the difference between essence and existence becomes visible and relatable.","refs":["CH_GB18_ZADE:A12","CH_GB18_ZADE:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RMD-05","text":"The subjective reflection of proving is recoded into immanent mediation: what initially appears as an epistemic operation becomes legible as the movement of essence itself.","refs":["CH_GB18_DDUS:A6","CH_GB18_DDUS:A7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_45:CGD-01","text":"The completeness of determinate conditions remains a local threshold of emergence; at the cluster level, only the higher-order rule holds that the totality of external moments turns into self-sublation.","refs":["CH_GB18_CHDS:A8","CH_GB18_CHDS:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:CGD-02","text":"The absolute abstraction of Being (Seyn) is a local point of entry; its upward-scaling function consists in establishing negativity as the general condition of every later determinacy.","refs":["CH_GB18_ZADE:A1","CH_GB18_ZADE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:CGD-03","text":"The proof of God remains a local test case; its present significance lies in the global distinction between an external ground of cognition and immanent mediation.","refs":["CH_GB18_DDUS:AS3","CH_GB18_DDUS:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:CGD-04","text":"The difference between thing-in-itself and external existence remains a local analytical articulation; at the cluster level, it is taken up into the more general principle of immanent difference within mediated immediacy.","refs":["CH_GB18_DDUS:A11","CH_GB18_DDUS:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_45:GNX-01","text":"Excluded is every explanation in which an external ground or alien material produces the thing without itself being determined as a moment of its movement.","refs":["CH_GB18_CHDS:NX1","CH_GB18_DDUS:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GNX-02","text":"Excluded is an original immediacy that could subsist prior to negativity, positing, and sublated mediation.","refs":["CH_GB18_CHDS:NX2","CH_GB18_DDUS:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GNX-03","text":"Excluded is an essence that would remain concealed behind its appearance, as is an appearance that would be merely a subjective or contingent surface.","refs":["CH_GB18_ZADE:NX5","CH_GB18_ZADE:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:GNX-04","text":"Excluded is mediation as an enduring third between already independent terms; it is effective only as the self-cancellation of its own separation.","refs":["CH_GB18_CHDS:NX5","CH_GB18_CHDS:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_45:DBN-01","text":"False is a total model of independent substances in which ground, essence, conditions, appearances, and things would already be ontologically complete prior to their relation.","refs":["CH_GB18_ZADE:SNX3","CH_GB18_DDUS:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:DBN-02","text":"False is an explanation that retains its explanatory ground as an unchanged foundation after the explanation has been accomplished.","refs":["CH_GB18_CHDS:DNX2","CH_GB18_DDUS:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:DBN-03","text":"Inadmissible is the assumption of an accessible in-itself outside appearing, because the in-itself can be determined only within the mediation of its appearance.","refs":["CH_GB18_ZADE:SNX2","CH_GB18_ZADE:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_45:BSA-01","text":"Unavailable remains a final beginning that would not itself have to be determined as posited and sublated immediacy.","refs":["CH_GB18_CHDS:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:BSA-02","text":"Impossible remains an Absolute that could preserve its identity without immanent negativity, self-externalization, and appearance.","refs":["CH_GB18_ZADE:DNX1","CH_GB18_ZADE:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:BSA-03","text":"Inadmissible remains an external standpoint from which essence, existence, and appearance could be judged as mutually separate regions.","refs":["CH_GB18_CHDS:SNX3","CH_GB18_DDUS:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_45:XD-01","text":"The external multiplicity of conditions and the appearance of the thing are two scales of the same operation: complete content is posited as externality so that it can return as immanent truth.","refs":["CL_GB18_45:GA-04","CL_GB18_45:GA-06","CH_GB18_CHDS:A4","CH_GB18_ZADE:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_45:XD-02","text":"The disappearance of ground is not a loss of explanation, but the transformation of explanation into positive existence; groundlessness therefore denotes completed self-mediation.","refs":["CL_GB18_45:GA-01","CL_GB18_45:GA-03","CH_GB18_CHDS:SD1","CH_GB18_DDUS:D1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_45:XD-03","text":"Because appearance is the truth of the thing and the thing is negative unity, no thingly interior can subsist as an untouched remainder outside its manifest mediation.","refs":["CL_GB18_45:GA-06","CL_GB18_45:GA-08","CH_GB18_ZADE:D8","CH_GB18_DDUS:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_45:XD-04","text":"At this level, actuality arises as the retrospective legibility of the entire transition: condition, ground, existence, appearance, and thing prove to be moments of a single movement only in the enactment of their reciprocal sublation.","refs":["CL_GB18_45:GA-02","CL_GB18_45:GA-07","CH_GB18_CHDS:FGS6","CH_GB18_ZADE:SD5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_45:BSD-01","text":"Causality is reordered from a relation between externally separate causes and effects into a form of self-production in which what is produced is the sublated activity of its production.","refs":["CH_GB18_CHDS:D4","CH_GB18_DDUS:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:BSD-02","text":"Cognition possesses no privileged external standpoint: it is true only insofar as it recognizes its own mediation as the immanent movement of the object.","refs":["CH_GB18_DDUS:D2","CH_GB18_DDUS:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:BSD-03","text":"The subject is determined not as the sovereign positor of mediation, but as a retrospective function of reflection within a process whose objectivity exceeds its subjective form.","refs":["CH_GB18_DDUS:A7","CH_GB18_DDUS:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:BSD-04","text":"Temporality becomes retrograde: the later does not ground the earlier causally, but reveals its truth as a sublated moment of a movement complete only retrospectively.","refs":["CH_GB18_CHDS:ALT5","CH_GB18_ZADE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_45:RLE-01","text":"The first loop is as follows: abstract Being (Seyn) releases its own negativity, thereby sublates itself, and returns as essence to a transformed self-sameness.","refs":["CH_GB18_ZADE:A3","CH_GB18_ZADE:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RLE-02","text":"The second loop is as follows: ground posits condition, condition contains the complete content of ground, and their totality sublates both as independent instances.","refs":["CH_GB18_CHDS:A2","CH_GB18_CHDS:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RLE-03","text":"The third loop is as follows: existence initially appears as an immediate thing, whose reflective ground sublates this immediacy and re-posites it as appearance.","refs":["CH_GB18_ZADE:A9","CH_GB18_ZADE:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RLE-04","text":"The attractor of the movement is mediated immediacy: every form gains stability only by preserving the mediation whose visible independence it at the same time destroys.","refs":["CH_GB18_DDUS:A9","CH_GB18_DDUS:ALT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:RLE-05","text":"The escalation leads from the self-sublation of individual determinations to the complete interpenetration of essence and otherness; actuality is the limiting case of this recursive condensation.","refs":["CH_GB18_ZADE:FGS5","CH_GB18_ZADE:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_45:FGS-B01","text":"Immanent negativity of Being (Seyn) → self-sublation of Being (Seyn) → essence as transformed self-sameness.","refs":["CH_GB18_ZADE:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FGS-B02","text":"Essence as reflection → positing and sublation of determinations → ground as a self-relational mode of mediation.","refs":["CH_GB18_ZADE:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FGS-B03","text":"Ground as self-positing → condition as the external completeness of content → sublation of the presupposed separation.","refs":["CH_GB18_CHDS:FGS2","CH_GB18_CHDS:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FGS-B04","text":"Sublated ground and sublated condition → mediated immediacy → existence as the self-externalization of essence.","refs":["CH_GB18_CHDS:FGS6","CH_GB18_DDUS:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FGS-B05","text":"Reflexively unstable existence → thing as positedness → appearance as the truth of the thing.","refs":["CH_GB18_ZADE:FGS4","CH_GB18_ZADE:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FGS-B06","text":"Appearance and essential Being (Seyn) → relation of the directions of reflection → actuality as interpenetration amid persisting immanent difference.","refs":["CH_GB18_ZADE:A13","CH_GB18_ZADE:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_45:AFM-B01","text":"External conditionality becomes visible as the semblance of a dependence on an other.","refs":["CH_GB18_CHDS:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AFM-B02","text":"Condition is reclassified as the self-positing of ground and as complete content become external.","refs":["CH_GB18_CHDS:AF2","CH_GB18_CHDS:AF3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AFM-B03","text":"The self-sublation of ground and condition produces existence as grounded groundlessness and positive mediated immediacy.","refs":["CH_GB18_CHDS:AF5","CH_GB18_DDUS:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AFM-B04","text":"The immediacy of existence becomes unstable through its own reflexivity as positedness and turns into appearance.","refs":["CH_GB18_ZADE:AF4","CH_GB18_ZADE:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AFM-B05","text":"Appearance mediates essence and otherness without allowing their difference to fall back into an external separation.","refs":["CH_GB18_ZADE:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:AFM-B06","text":"The relation completes itself as actuality, in which the entire preceding sequence becomes legible as the self-unfolding of a negative unity.","refs":["CH_GB18_ZADE:AF6","CH_GB18_ZADE:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_45:MME-01","text":"Ground and cause are remapped from asymmetrical grounding instances into transitory functions of a movement of self-sublation.","refs":["CH_GB18_CHDS:ME1","CH_GB18_DDUS:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MME-02","text":"Appearance is reclassified from an opposite of truth into its necessary form of enactment.","refs":["CH_GB18_ZADE:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MME-03","text":"The opposition between a world of appearance and an in-itself collapses as an absolute separation and becomes legible as the internal relation of a single actuality.","refs":["CH_GB18_ZADE:ME3","CH_GB18_ZADE:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MME-04","text":"The thing is newly determined from an atomic unity with externally added properties into a negative unity of immanent mediation.","refs":["CH_GB18_DDUS:ME4","CH_GB18_DDUS:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_45:ALT-B01","text":"Surface level — A thing does not simply enter, but gains existence by having its conditions, its ground, and its mediation lose their independent configuration.","refs":["CH_GB18_CHDS:ALT1","CH_GB18_DDUS:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:ALT-B02","text":"Structural level — Ground, condition, existence, appearance, and thing are not independent entities, but functional forms of the same negative movement passing into one another.","refs":["CH_GB18_CHDS:ALT2","CH_GB18_ZADE:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:ALT-B03","text":"Metastrategic level — To explain does not mean to assign an external cause, but to reconstruct the self-sublation through which an object produces its own form of appearance.","refs":["CH_GB18_CHDS:ALT3","CH_GB18_ZADE:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:ALT-B04","text":"Ontological / Temporal level — The first is not original presence, but a retrograde self-positing whose result determines its presupposition only as a sublated moment.","refs":["CH_GB18_CHDS:ALT4","CH_GB18_DDUS:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:ALT-B05","text":"Methodological / Performative level — The form of reconstruction enacts its object by establishing every fixed initial determination as a later and sublated function of a more comprehensive mediation.","refs":["CH_GB18_ZADE:SD4","CH_GB18_DDUS:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_45:FL-01","text":"The conditions are supposed to be the complete content of the thing, yet initially appear as an external, indifferent multiplicity intermingled with the non-essential; the unity of their totality is therefore not immediately secured.","refs":["CH_GB18_CHDS:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FL-02","text":"Appearance is determined as the truth of the thing, while the opposition between the world of appearance and the world that is in itself maintains a difference whose precise status oscillates between relational mediation and residual opposition.","refs":["CH_GB18_ZADE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:FL-03","text":"Essence is supposed to be identical with its existence, yet the analytical difference between thing-in-itself and external existence requires an internal distinction that cannot be eliminated without remainder.","refs":["CH_GB18_DDUS:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MP-01","text":"Ground mutates from a supporting explanatory principle into negative ground: its sublation does not destroy its function, but radicalizes it into the generative condition of existence.","refs":["CH_GB18_DDUS:AS4","CH_GB18_DDUS:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MP-02","text":"Immediacy mutates from seemingly given being into the positive form of sublated mediation and thereby acquires a genetic depth that contradicts its form of appearance.","refs":["CH_GB18_ZADE:SD1","CH_GB18_DDUS:ALT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MP-03","text":"Proving reflection mutates from an externally subjective cognitive activity into the self-presentation of essence; its double position remains productively unstable.","refs":["CH_GB18_DDUS:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_45:HSI-01","text":"Reality appears as a machine of negative self-production: it exposes itself in externality, cancels the independence of the latter, and precisely thereby gains a richer configuration of immediacy.","refs":["CH_GB18_CHDS:SD3","CH_GB18_DDUS:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:HSI-02","text":"The thing is not a resting substance, but a nodal point at which sublated mediation subsists as negative unity and bears its differences within itself.","refs":["CH_GB18_DDUS:FGS6","CH_GB18_DDUS:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:HSI-03","text":"Time is not a succession of states, but the retrograde order in which every attained determination reveals its origin as a sublated presupposition.","refs":["CH_GB18_ZADE:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:HSI-04","text":"Orientation is possible only in retracing transitions: not an external standpoint, but the mapping of positing, sublation, appearance, and return opens access to the thing.","refs":["CH_GB18_CHDS:ALT3","CH_GB18_ZADE:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_45:MRT-B01","text":"The extracted axioms suffice to reconstruct the cluster movement from unconditioned thing through ground and condition to existence, appearance, thing, and actuality as a continuous self-mediation.","refs":["CH_GB18_CHDS:MRT1","CH_GB18_ZADE:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MRT-B02","text":"What remains underdetermined are the criteria according to which conditions count as complete, as well as the concrete determination of actuality beyond its formal structure of interpenetration.","refs":["CH_GB18_ZADE:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MRT-B03","text":"The reconstruction is coherent only on the condition that the disappearance of mediation is understood as its highest efficacy and not as mere absence.","refs":["CH_GB18_CHDS:MRT7","CH_GB18_DDUS:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_45:MRT-B04","text":"The irreducible remainder lies in the productive tension between identity and internal difference: the architecture simultaneously requires the unity of essence and existence and their continued analytical articulation in the thing and in appearance.","refs":["CH_GB18_DDUS:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_45@R001","source_variant_id":"canonical:CL_GB18_45:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 133–135","context":"c. Hervorgang der Sache in die Existenz. · Zweiter Abschnitt. Die Erscheinung. · A. Das Ding und seine Eigenschaften."},"title_language_code":"en"},{"id":"CL_GB18_46","layer":"CL","title":"Chapters 136–138","order":46,"parents":["CH_GB18_DSUE","CH_GB18_BD_2","CH_GB18_A_37"],"revision":"CL_GB18_46@R001","sha256":"4e4014f162ad5cee26d83f012039f90d0c5f1c59ea027c9354027ec00396d93e","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_46:AS-B01","text":"Das System rekonstruiert, wie ein zunächst unbestimmtes Ding an sich bestimmt sein kann, ohne seine Bestimmtheit als äußerliches Prädikat oder subjektive Projektion zu empfangen.","refs":["CH_GB18_DSUE:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B02","text":"Seine Grundbewegung bestimmt Unmittelbarkeit als Resultat aufgehobener Vermittlung und lässt Bestimmtheit daher nicht vor, sondern nur innerhalb der Selbstvermittlung bestehen.","refs":["CH_GB18_DSUE:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B03","text":"Die Subjektivierung aller Bestimmungen im Bewusstsein erscheint als Zwischenfixierung der äußerlichen Reflexion, nicht als endgültige Erklärung ihrer Herkunft.","refs":["CH_GB18_A_37:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B04","text":"Die Gegenbewegung des Freiheitsbewusstseins verschiebt die Schranke lediglich erneut, weil die abstrakte Identität des Ich die abgespaltene Bestimmtheit nicht begründen kann.","refs":["CH_GB18_A_37:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B05","text":"Äußerliche Beziehung verliert ihren Status als selbständiges Außen, indem sie sich als immanente Negativität und Selbstunterscheidung des Dinges zurückbestimmt.","refs":["CH_GB18_DSUE:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B06","text":"Eigenschaft bildet die operative Scharnierform, in der relationale Verhaltensweise und Selbsterhaltung nicht getrennt bleiben, sondern dieselbe reflektierte Qualität ausdrücken.","refs":["CH_GB18_BD_2:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B07","text":"Die Selbsterhaltung der Eigenschaft eröffnet Kausalität, doch bleibt diese zunächst unvollständig, weil das Ding seine Bestimmungen noch nicht als setzende Reflexion hervorbringt.","refs":["CH_GB18_BD_2:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B08","text":"Die Schließung liegt in der Aufhebung des Gegensatzes von Ding an sich und Existenz: Das Ding ist Grund nur als in Eigenschaften äußerlich und ansichseiend existierende Einheit.","refs":["CH_GB18_BD_2:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_46:GA-01","text":"[Attractor] Bestimmtheit existiert nur als Selbstbeziehung, die sich durch die Form eines Anderen vermittelt und gerade dadurch bei sich bleibt.","refs":["CH_GB18_BD_2:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-02","text":"[Persistent] Wesentliche und gesetzte Existenz sind keine getrennten Seinsregionen, sondern ungleiche Momente einer Existenzordnung.","refs":["CH_GB18_DSUE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-03","text":"[Mutating] Äußerliche Reflexion mutiert von scheinbar fremder Zuschreibung über subjektive Fixierung zu einer eigenen Bestimmung des Dinges.","refs":["CH_GB18_A_37:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-04","text":"[Persistent] Eigenschaft ist reflektierte Qualität, weil Beziehung zu Anderem und Selbstidentität in ihr zusammenfallen.","refs":["CH_GB18_BD_2:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-05","text":"[Emergent] Grund ist nicht ein verborgenes Inneres hinter Eigenschaften, sondern deren bedingte Einheit, die nur im äußerlichen Gesetztsein wirklich ist.","refs":["CH_GB18_BD_2:D10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-06","text":"[Emergent] Kausalität beginnt als Selbsterhaltung einer Bestimmung in ihrer Wirkung und nicht als Übertragung eines fertigen Inneren auf ein Äußeres.","refs":["CH_GB18_BD_2:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-07","text":"[Terminal] Das reine, schlechthin unbestimmte Ding an sich zerfällt, weil seine Bestimmungslosigkeit weder Erkenntnis noch reale Eigenschaftlichkeit tragen kann.","refs":["CH_GB18_A_37:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-08","text":"[Attractor] Die Verteilung der Bestimmtheit auf Objekt oder Subjekt ist eine endliche Zwischenform; jede einseitige Lokalisierung der Schranke reproduziert ihre eigene Begrenzung.","refs":["CH_GB18_A_37:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_46:RMD-01","text":"Das Ding an sich kehrt als Identitätsbegriff wieder, mutiert jedoch von abstrakter Unmittelbarkeit zu negativ vermittelter, eigenschaftlicher und grundhafter Selbstidentität.","refs":["CH_GB18_DSUE:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RMD-02","text":"Äußerliche Reflexion bleibt funktional erhalten, verliert aber ihre Fremdheit und wird zur immanenten Bestimmung des Dinges selbst.","refs":["CH_GB18_A_37:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RMD-03","text":"Eigenschaft verschiebt sich vom Ergebnis der Selbstvermittlung zur Form des Grundes und wird dadurch in eine umfassendere Reflexionsstruktur absorbiert.","refs":["CH_GB18_BD_2:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RMD-04","text":"Die Beziehung zu Anderem mutiert von scheinbarer Abhängigkeit zu der Bedingung, unter der sich eine Eigenschaft überhaupt bewähren und erhalten kann.","refs":["CH_GB18_BD_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RMD-05","text":"Das Freiheitsbewusstsein leistet die Übergangsarbeit einer allgemeinen Identität, verschwindet jedoch als abschließende Position, sobald seine Funktion in die Reflexionsstruktur des Dinges zurückkehrt.","refs":["CH_GB18_A_37:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_46:CGD-01","text":"Die Unterscheidung zwischen wesentlicher und unwesentlicher Existenz bleibt lokal, sofern sie nur zwei Seinsweisen benennt; auf Clusterebene wird sie zur Struktur einer einzigen reflexiven Existenzordnung.","refs":["CH_GB18_DSUE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:CGD-02","text":"Qualität, Beschaffenheit und Eigenschaft sind lokale Übergangskategorien; global tragen sie nur, insofern sie die Erzeugung selbstbezüglicher Bestimmtheit formal vermitteln.","refs":["CH_GB18_BD_2:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:CGD-03","text":"Die Alternative zwischen subjektiver und objektiver Bestimmtheit bleibt auf der unteren Ebene polemisch; auf Clusterebene erscheint sie als falsche Verteilung derselben Reflexionsfunktion.","refs":["CH_GB18_A_37:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:CGD-04","text":"Die konkrete Weiterentwicklung der Eigenschaften bleibt unterbestimmt und wird nicht zum globalen Axiom, weil die Clusterarchitektur nur ihre notwendige Reflexionsfunktion benötigt.","refs":["CH_GB18_BD_2:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_46:GNX-01","text":"Ausgeschlossen ist eine reine Unmittelbarkeit, die bestimmte Eigenschaften haben könnte, ohne aufgehobene Vermittlung in sich zu bewahren.","refs":["CH_GB18_DSUE:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GNX-02","text":"Ausgeschlossen ist eine Zweiweltenordnung, in der das wahre Ding von Existenz, Eigenschaft und äußerlicher Erscheinung getrennt verbleibt.","refs":["CH_GB18_BD_2:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GNX-03","text":"Ausgeschlossen ist ein Subjekt, das sämtliche Bestimmtheit erzeugt, während der Gegenstand nur passiver Träger dieser Produktion wäre.","refs":["CH_GB18_A_37:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GNX-04","text":"Ausgeschlossen ist eine Ursache, die vor ihrer Wirkung selbständig bestünde und sich nicht in ihr erhielte.","refs":["CH_GB18_BD_2:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GNX-05","text":"Ausgeschlossen ist eine Vielheit von Dingen, deren Unterschiede unabhängig von ihren Beziehungen bestehen könnten.","refs":["CH_GB18_DSUE:DNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_46:DBN-01","text":"Falsch sein muss die Annahme, eine äußerliche Reflexion könne das Ding bestimmen, ohne selbst von dessen wesentlicher Identität abhängig zu sein.","refs":["CH_GB18_DSUE:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:DBN-02","text":"Falsch sein muss die Verteilung der Bestimmtheit entweder auf das Subjekt oder auf ein völlig abgetrenntes Objekt.","refs":["CH_GB18_A_37:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:DBN-03","text":"Falsch sein muss eine Äußerlichkeit, die nicht zugleich reflektierte Unmittelbarkeit des Grundes ist.","refs":["CH_GB18_BD_2:DNX7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_46:BSA-01","text":"Unverfügbar ist ein Sein vor aller Bestimmung, weil die Abwesenheit jeder Bestimmung keinen ontologischen Träger bilden kann.","refs":["CH_GB18_A_37:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:BSA-02","text":"Unverfügbar ist ein Träger, der Eigenschaften und Existenz ontologisch vorausläge, ohne selbst durch sie bestimmt zu sein.","refs":["CH_GB18_BD_2:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:BSA-03","text":"Unzulässig ist eine letzte Position jenseits der Reflexion, weil das Ding nur durch seine Reflexionsbestimmungen als Ding bestimmt wird.","refs":["CH_GB18_A_37:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_46:XD-01","text":"Die Bewegung von äußerlicher Reflexion über ihre Subjektivierung zu ihrer Rückkehr ins Ding zeigt, dass Subjekt-Objekt-Umkehrungen keine Lösung, sondern interne Permutationen derselben endlichen Schranke sind. ; Trace Type — Composite","refs":["CL_GB18_46:GA-03","CL_GB18_46:GA-08","CH_GB18_A_37:AS3","CH_GB18_A_37:D7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:XD-02","text":"Weil Eigenschaften sich nur unter Bedingungen anderer Dinge bewähren und sich zugleich als Ursache erhalten, ist Kausalität bedingte Selbstvermittlung statt souveräne Einwirkung. ; Trace Type — Composite","refs":["CL_GB18_46:GA-04","CL_GB18_46:GA-05","CL_GB18_46:GA-06","CH_GB18_BD_2:A11","CH_GB18_BD_2:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:XD-03","text":"Äußerlichkeit wird nicht trotz, sondern als reale Bedingung des Ansichseins bestimmt; der Grund existiert nur, indem er sich äußerlich reflektiert. ; Trace Type — Composite","refs":["CL_GB18_46:GA-02","CL_GB18_46:GA-05","CH_GB18_BD_2:A17","CH_GB18_BD_2:D10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:XD-04","text":"Die Unerkennbarkeit des reinen Dinges an sich ist keine bloß epistemische Einschränkung, sondern das Symptom seiner ontologischen Selbstaufhebung durch eigene Bestimmtheit. ; Trace Type — Negative","refs":["CL_GB18_46:GA-03","CL_GB18_46:GA-07","CH_GB18_A_37:D1","CH_GB18_A_37:D9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:XD-05","text":"Die Vielheit der Dinge wird zur Durchgangsform einer differenzierten Selbstbeziehung, weil jede Eigenschaft nur als relationale und sich erhaltende Bestimmung wirklich ist. ; Trace Type — Composite","refs":["CL_GB18_46:GA-01","CL_GB18_46:GA-04","CH_GB18_DSUE:D5","CH_GB18_BD_2:D4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_46:BSD-01","text":"Die Ontologie des Clusters ersetzt die Opposition von Innen und Außen durch eine Struktur, in der Äußerlichkeit ein unselbständiges, aber notwendiges Moment der Selbstvermittlung ist.","refs":["CL_GB18_46:GA-01","CL_GB18_46:GA-02","CH_GB18_DSUE:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:BSD-02","text":"Erkenntnis wird nicht als Zugriff eines Subjekts auf ein fremdes Objekt modelliert, sondern als Nachvollzug der Reflexionsbewegung, in der Ding und Bestimmtheit zugleich hervorgebracht werden.","refs":["CL_GB18_46:GA-03","CL_GB18_46:GA-07","CL_GB18_46:GA-08","CH_GB18_A_37:ME3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:BSD-03","text":"Kausalität wird zur ontologischen Selbstreproduktion des Grundes unter Bedingungen und nicht zur linearen Übertragung einer bereits fertigen Ursache auf eine fremde Wirkung.","refs":["CL_GB18_46:GA-04","CL_GB18_46:GA-05","CL_GB18_46:GA-06","CH_GB18_BD_2:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:BSD-04","text":"Die zeitliche Bewegung des Systems ist retrospektiv: Das Ende bestimmt die anfängliche Reinheit des Dinges als abstrakte und deshalb unwahre Vorform seiner bestimmten Existenz.","refs":["CL_GB18_46:GA-03","CL_GB18_46:GA-07","CH_GB18_DSUE:AF2"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_46:RLE-01","text":"Die Hauptschleife führt von abstrakter Unbestimmtheit über äußerliche Reflexion und Eigenschaft zur Bestimmung eines Dinges, das rückwirkend die Unwahrheit seiner anfänglichen Reinheit ausweist.","refs":["CH_GB18_A_37:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RLE-02","text":"Die Eigenschaft geht in Beziehung zu Anderem hinaus, bewahrt sich gerade in dieser Beziehung und kehrt als Grundform ihrer Selbsterhaltung zu sich zurück.","refs":["CH_GB18_BD_2:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RLE-03","text":"Die Schranke zirkuliert zwischen Objekt und Subjekt, bis beide Seiten als einseitige Lokalisierungen derselben Reflexionsstruktur sichtbar werden.","refs":["CH_GB18_A_37:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RLE-04","text":"Die Eskalation von Eigenschaft zu Ursache wird bewusst angehalten, weil die Ursache noch keine setzende Reflexion ihrer eigenen Bestimmungen ist.","refs":["CH_GB18_BD_2:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_46:FGS-B01","text":"Abstraktion von aller Bestimmtheit → unerkennbares Ding an sich → Externalisierung der Bestimmung.","refs":["CH_GB18_A_37:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FGS-B02","text":"Externalisierung der Bestimmung → fremde Reflexion → scheinbare Subjekt-Objekt-Spaltung.","refs":["CH_GB18_A_37:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FGS-B03","text":"Subjektivistische Fixierung der Reflexion → Verlegung der Schranke → Reproduktion der Endlichkeit.","refs":["CH_GB18_A_37:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FGS-B04","text":"Beziehung auf das Ding → Selbstaufhebung der Äußerlichkeit → Reflexion als eigene Bestimmung des Dinges.","refs":["CH_GB18_DSUE:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FGS-B05","text":"Eigene Reflexion des Dinges → Eigenschaft als reflektierte Qualität → Einheit von Beziehung und Selbstidentität.","refs":["CH_GB18_BD_2:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FGS-B06","text":"Selbsterhaltung der Eigenschaft → Wirkung → vorläufige Ursache → bedingter Grund in existierender Äußerlichkeit.","refs":["CH_GB18_BD_2:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_46:AFM-B01","text":"Abstraktes Ansichsein → äußerliche Bestimmtheit → Spaltung von Ding und Reflexion.","refs":["CH_GB18_A_37:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AFM-B02","text":"Subjektivierung der Bestimmtheit → Verlegung der Schranke → Fortbestand der Endlichkeit.","refs":["CH_GB18_A_37:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AFM-B03","text":"Äußerliche Reflexion → eigene Bestimmung des Dinges → bestimmte Dingheit.","refs":["CH_GB18_A_37:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AFM-B04","text":"Bestimmte Dingheit → Eigenschaft → sich erhaltende relationale Bestimmung.","refs":["CH_GB18_BD_2:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AFM-B05","text":"Sich erhaltende Eigenschaft → Ursache → Begrenzung auf noch nicht setzende Reflexion.","refs":["CH_GB18_BD_2:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AFM-B06","text":"Bedingter Grund → reflektierte Unmittelbarkeit → Einheit von Existenz und Ansichsein.","refs":["CH_GB18_BD_2:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_46:MME-01","text":"Der Gegensatz von Ding an sich und Existenz wird als innere Differenz einer einheitlichen Existenzordnung neu kartiert.","refs":["CH_GB18_DSUE:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MME-02","text":"Beziehung zu Anderem wird von äußerer Abhängigkeit zu einer Bedingung der Selbsterhaltung umklassifiziert.","refs":["CH_GB18_BD_2:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MME-03","text":"Die Opposition von Ding und Reflexion bricht zusammen, weil Reflexion als innere Selbstbestimmung des Dinges lesbar wird.","refs":["CH_GB18_A_37:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MME-04","text":"Kausalität wird als Erhaltung einer Bestimmung in ihrer Wirkung und nicht als einseitige Hervorbringung eines äußeren Resultats sichtbar.","refs":["CH_GB18_BD_2:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MME-05","text":"Subjektive und objektive Schranke erscheinen als Varianten derselben Endlichkeitsstruktur.","refs":["CH_GB18_A_37:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_46:ALT-B01","text":"Auf der Surface level behandelt das System Ding an sich, Eigenschaften, Beziehung, Wirkung und Ursache als Momente einer einzigen begrifflichen Bewegung.","refs":["CH_GB18_BD_2:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:ALT-B02","text":"Auf der Structural level organisiert das System die Bewegung durch Reflexion, Gesetztsein, Grund und Selbstidentität.","refs":["CH_GB18_BD_2:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:ALT-B03","text":"Auf der Metastrategic level ersetzt das System äußere Widerlegung durch die immanente Konsequenz einer Schrankenbestimmung, die sich selbst entkräftet.","refs":["CH_GB18_A_37:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:ALT-B04","text":"Auf der Ontological / Temporal level ist Realität nur als sich reflektierende Bestimmtheit vorhanden, deren Anfang durch ihre spätere Selbstbestimmung umgedeutet wird.","refs":["CH_GB18_A_37:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:ALT-B05","text":"Auf der Methodological / Performative level vollzieht die Argumentform selbst, was sie behauptet, indem sie Zuschreibung nur anerkennt, sofern diese aus der Selbstbewegung des Begriffs hervorgeht.","refs":["CH_GB18_DSUE:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_46:FL-01","text":"Die Architektur benötigt die Spannung, dass dem Ding zunächst keine eigene Mannigfaltigkeit zukommt und seine Bestimmtheit später als eigene Eigenschaft erscheint.","refs":["CH_GB18_DSUE:A4","CH_GB18_DSUE:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FL-02","text":"Die Eigenschaft soll vom anderen Ding abhängen und zugleich eigener Grund sein; diese Spannung wird als Bedingtheit erhalten, nicht aufgehoben.","refs":["CH_GB18_BD_2:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FL-03","text":"Das Ding wird als Ursache bestimmt, obwohl seine setzende Reflexion ausdrücklich noch aussteht; Kausalität fungiert daher als Übergangs- und nicht als Schlussbestimmung.","refs":["CH_GB18_BD_2:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MP-01","text":"Die entscheidende Mutation erfolgt, wenn äußerliche Reflexion nicht länger fremde Zuschreibung bleibt, sondern zur Bestimmung des Dinges selbst wird.","refs":["CH_GB18_A_37:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MP-02","text":"Die Eigenschaft mutiert, wenn Beziehung und Selbstidentität nicht mehr getrennte Momente darstellen, sondern als reflektierte Qualität zusammenfallen.","refs":["CH_GB18_BD_2:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MP-03","text":"Der Übergang zur Ursache tritt ein, wenn Selbsterhaltung nicht als passive Beharrung, sondern als Wirkungsform des Grundes gefasst wird.","refs":["CH_GB18_BD_2:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_46:HSI-01","text":"Realität erscheint als eine Maschine der Selbstunterscheidung, in der jedes scheinbar äußere Verhältnis zur Selbstbeziehung einer wesentlichen Identität zurückkehrt.","refs":["CH_GB18_DSUE:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:HSI-02","text":"Das Subjekt erscheint nicht als souveräner Ursprung der Bestimmungen, sondern als vorübergehende Lokalisierung einer Reflexion, deren Bedingungen über es hinausreichen.","refs":["CH_GB18_BD_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:HSI-03","text":"Zeit erscheint als Veränderung ohne Verlust des Ansichseins: Veränderlichkeit ist die äußerliche Realisationsform eines sich reflektierenden Grundes.","refs":["CH_GB18_BD_2:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_46:MRT-B01","text":"Die extrahierten Axiome reichen auf Clusterebene aus, um die Bewegung von abstraktem Ding an sich über Eigenschaft und Kausalität zum bedingten Grund zu rekonstruieren.","refs":["CH_GB18_BD_2:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MRT-B02","text":"Unterbestimmt bleibt die genaue kategoriale Vermittlung zwischen Qualität, Beschaffenheit und reflektierter Qualität.","refs":["CH_GB18_BD_2:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MRT-B03","text":"Die Architektur bleibt nur kohärent, wenn aufgehobene Vermittlung zugleich als negiert und als fortbestehend verstanden wird.","refs":["CH_GB18_BD_2:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MRT-B04","text":"Die stärkste Operation ist die immanente Auflösung der Zweiweltenstruktur; ihre empfindlichste Stelle bleibt die vorausgesetzte Identifikation äußerlicher Reflexion mit eigener Bestimmung des Dinges.","refs":["CH_GB18_A_37:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122649557872Z_b7be04d8","language_code":"en","language_name":"English","title":"Chapters 136–138","source_sha256":"4e4014f162ad5cee26d83f012039f90d0c5f1c59ea027c9354027ec00396d93e","sha256":"d867190eeb67b42499a8efc8556c5107d6862dcbee128f3e978d6ae222f238cd","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:26:49.558950+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_46:AS-B01","text":"The system reconstructs how an initially indeterminate thing in itself can be determinate without receiving its determinacy as an external predicate or subjective projection.","refs":["CH_GB18_DSUE:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B02","text":"Its fundamental movement determines immediacy as the result of sublated mediation and therefore allows determinacy to subsist not prior to, but only within, self-mediation.","refs":["CH_GB18_DSUE:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B03","text":"The subjectivization of all determinations in consciousness appears as an intermediate fixation of external reflection, not as the final explanation of their origin.","refs":["CH_GB18_A_37:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B04","text":"The counter-movement of consciousness of freedom merely displaces the limit once again, because the abstract identity of the I cannot ground the split-off determinacy.","refs":["CH_GB18_A_37:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B05","text":"External relation loses its status as an independent outside by determining itself back into the immanent negativity and self-differentiation of the thing.","refs":["CH_GB18_DSUE:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B06","text":"Property forms the operative hinge-form in which relational comportment and self-preservation do not remain separate, but express the same reflected quality.","refs":["CH_GB18_BD_2:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B07","text":"The self-preservation of property opens up causality, yet this initially remains incomplete, because the thing does not yet bring forth its determinations as positing reflection.","refs":["CH_GB18_BD_2:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AS-B08","text":"The closure lies in the sublation of the opposition between thing in itself and existence: the thing is ground only as a unity existing externally and in-itself in properties.","refs":["CH_GB18_BD_2:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_46:GA-01","text":"[Attractor] Determinacy exists only as self-relation, which mediates itself through the form of an other and precisely thereby remains with itself.","refs":["CH_GB18_BD_2:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-02","text":"[Persistent] Essential and posited existence are not separate regions of being, but unequal moments of an order of existence.","refs":["CH_GB18_DSUE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-03","text":"[Mutating] External reflection mutates from apparently alien attribution through subjective fixation into a determination proper to the thing.","refs":["CH_GB18_A_37:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-04","text":"[Persistent] Property is reflected quality because relation to an other and self-identity coincide within it.","refs":["CH_GB18_BD_2:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-05","text":"[Emergent] Ground is not a hidden interior behind properties, but their conditioned unity, which is actual only in external positedness.","refs":["CH_GB18_BD_2:D10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-06","text":"[Emergent] Causality begins as the self-preservation of a determination in its effect and not as the transfer of a finished interior onto an exterior.","refs":["CH_GB18_BD_2:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-07","text":"[Terminal] The pure, absolutely indeterminate thing in itself disintegrates, because its lack of determinacy can support neither cognition nor real propertyhood.","refs":["CH_GB18_A_37:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GA-08","text":"[Attractor] The distribution of determinacy onto object or subject is a finite intermediate form; every one-sided localization of the limit reproduces its own limitation.","refs":["CH_GB18_A_37:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_46:RMD-01","text":"The thing in itself recurs as a concept of identity, but mutates from abstract immediacy into negatively mediated, property-bearing, and ground-like self-identity.","refs":["CH_GB18_DSUE:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RMD-02","text":"External reflection remains functionally preserved, but loses its foreignness and becomes an immanent determination of the thing itself.","refs":["CH_GB18_A_37:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RMD-03","text":"Property shifts from the result of self-mediation to the form of ground and is thereby absorbed into a more comprehensive structure of reflection.","refs":["CH_GB18_BD_2:ME6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RMD-04","text":"The relation to an other mutates from apparent dependence into the condition under which a property can prove and preserve itself at all.","refs":["CH_GB18_BD_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RMD-05","text":"Consciousness of freedom performs the transitional work of a universal identity, but disappears as a conclusive position as soon as its function returns into the reflective structure of the thing.","refs":["CH_GB18_A_37:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_46:CGD-01","text":"The distinction between essential and unessential existence remains local insofar as it names only two modes of being; at the cluster level it becomes the structure of a single reflexive order of existence.","refs":["CH_GB18_DSUE:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:CGD-02","text":"Quality, constitution, and property are local transitional categories; globally, they bear only insofar as they formally mediate the generation of self-relating determinacy.","refs":["CH_GB18_BD_2:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:CGD-03","text":"The alternative between subjective and objective determinacy remains polemical at the lower level; at the cluster level it appears as a false distribution of the same function of reflection.","refs":["CH_GB18_A_37:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:CGD-04","text":"The concrete further development of properties remains underdetermined and does not become a global axiom, because the cluster architecture requires only its necessary function of reflection.","refs":["CH_GB18_BD_2:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_46:GNX-01","text":"Excluded is a pure immediacy that could have determinate properties without preserving sublated mediation within itself.","refs":["CH_GB18_DSUE:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GNX-02","text":"Excluded is a two-world order in which the true thing remains separated from existence, property, and external appearance.","refs":["CH_GB18_BD_2:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GNX-03","text":"Excluded is a subject that generates all determinacy while the object would be merely the passive bearer of this production.","refs":["CH_GB18_A_37:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GNX-04","text":"Excluded is a cause that would subsist independently prior to its effect and would not preserve itself in it.","refs":["CH_GB18_BD_2:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:GNX-05","text":"Excluded is a multiplicity of things whose differences could subsist independently of their relations.","refs":["CH_GB18_DSUE:DNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_46:DBN-01","text":"The assumption must be false that an external reflection could determine the thing without itself depending on its essential identity.","refs":["CH_GB18_DSUE:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:DBN-02","text":"The distribution of determinacy either onto the subject or onto a wholly detached object must be false.","refs":["CH_GB18_A_37:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:DBN-03","text":"An externality that is not at the same time reflected immediacy of ground must be false.","refs":["CH_GB18_BD_2:DNX7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_46:BSA-01","text":"Unavailable is a being prior to all determinacy, because the absence of every determinacy cannot constitute an ontological bearer.","refs":["CH_GB18_A_37:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:BSA-02","text":"Unavailable is a bearer that would ontologically precede properties and existence without itself being determined through them.","refs":["CH_GB18_BD_2:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:BSA-03","text":"Inadmissible is a final position beyond reflection, because the thing is determined as a thing only through its determinations of reflection.","refs":["CH_GB18_A_37:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_46:XD-01","text":"The movement from external reflection through its subjectivization to its return into the thing shows that subject-object inversions are not a solution but internal permutations of the same finite limit. ; Trace Type — Composite","refs":["CL_GB18_46:GA-03","CL_GB18_46:GA-08","CH_GB18_A_37:AS3","CH_GB18_A_37:D7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:XD-02","text":"Because properties prove themselves only under the conditions of other things and at the same time preserve themselves as cause, causality is conditioned self-mediation rather than sovereign action. ; Trace Type — Composite","refs":["CL_GB18_46:GA-04","CL_GB18_46:GA-05","CL_GB18_46:GA-06","CH_GB18_BD_2:A11","CH_GB18_BD_2:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:XD-03","text":"Externality is determined not despite but as the real condition of being-in-itself; ground exists only by reflecting itself externally. ; Trace Type — Composite","refs":["CL_GB18_46:GA-02","CL_GB18_46:GA-05","CH_GB18_BD_2:A17","CH_GB18_BD_2:D10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:XD-04","text":"The unknowability of the pure thing in itself is not a merely epistemic limitation, but the symptom of its ontological self-sublation through its own determinacy. ; Trace Type — Negative","refs":["CL_GB18_46:GA-03","CL_GB18_46:GA-07","CH_GB18_A_37:D1","CH_GB18_A_37:D9"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:XD-05","text":"The multiplicity of things becomes a transitional form of differentiated self-relation, because every property is actual only as a relational and self-preserving determination. ; Trace Type — Composite","refs":["CL_GB18_46:GA-01","CL_GB18_46:GA-04","CH_GB18_DSUE:D5","CH_GB18_BD_2:D4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_46:BSD-01","text":"The ontology of the cluster replaces the opposition of inside and outside with a structure in which externality is a non-independent but necessary moment of self-mediation.","refs":["CL_GB18_46:GA-01","CL_GB18_46:GA-02","CH_GB18_DSUE:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:BSD-02","text":"Cognition is modeled not as a subject's access to an alien object, but as the retracing of the movement of reflection in which thing and determinacy are brought forth simultaneously.","refs":["CL_GB18_46:GA-03","CL_GB18_46:GA-07","CL_GB18_46:GA-08","CH_GB18_A_37:ME3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:BSD-03","text":"Causality becomes the ontological self-reproduction of ground under conditions and not the linear transfer of an already finished cause onto an alien effect.","refs":["CL_GB18_46:GA-04","CL_GB18_46:GA-05","CL_GB18_46:GA-06","CH_GB18_BD_2:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_46:BSD-04","text":"The temporal movement of the system is retrospective: the end determines the initial purity of the thing as the abstract and therefore untrue preliminary form of its determinate existence.","refs":["CL_GB18_46:GA-03","CL_GB18_46:GA-07","CH_GB18_DSUE:AF2"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_46:RLE-01","text":"The principal loop leads from abstract indeterminacy through external reflection and property to the determination of a thing that retroactively reveals the untruth of its initial purity.","refs":["CH_GB18_A_37:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RLE-02","text":"Property goes out into relation to an other, preserves itself precisely in this relation, and returns to itself as the ground-form of its self-preservation.","refs":["CH_GB18_BD_2:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RLE-03","text":"The limit circulates between object and subject until both sides become visible as one-sided localizations of the same structure of reflection.","refs":["CH_GB18_A_37:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:RLE-04","text":"The escalation from property to cause is deliberately halted, because cause is not yet positing reflection of its own determinations.","refs":["CH_GB18_BD_2:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_46:FGS-B01","text":"Abstraction from all determinacy → unknowable thing in itself → externalization of determination.","refs":["CH_GB18_A_37:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FGS-B02","text":"Externalization of determination → alien reflection → apparent subject-object split.","refs":["CH_GB18_A_37:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FGS-B03","text":"Subjectivist fixation of reflection → displacement of the limit → reproduction of finitude.","refs":["CH_GB18_A_37:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FGS-B04","text":"Relation to the thing → self-sublation of externality → reflection as the thing's own determination.","refs":["CH_GB18_DSUE:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FGS-B05","text":"The thing's own reflection → property as reflected quality → unity of relation and self-identity.","refs":["CH_GB18_BD_2:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FGS-B06","text":"Self-preservation of property → effect → provisional cause → conditioned ground in existing externality.","refs":["CH_GB18_BD_2:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_46:AFM-B01","text":"Abstract being-in-itself → external determinacy → split between thing and reflection.","refs":["CH_GB18_A_37:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AFM-B02","text":"Subjectivization of determinacy → displacement of the limit → persistence of finitude.","refs":["CH_GB18_A_37:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AFM-B03","text":"External reflection → the thing's own determination → determinate thinghood.","refs":["CH_GB18_A_37:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AFM-B04","text":"Determinate thinghood → property → self-preserving relational determination.","refs":["CH_GB18_BD_2:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AFM-B05","text":"Self-preserving property → cause → limitation to reflection not yet positing.","refs":["CH_GB18_BD_2:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:AFM-B06","text":"Conditioned ground → reflected immediacy → unity of existence and being-in-itself.","refs":["CH_GB18_BD_2:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_46:MME-01","text":"The opposition between thing in itself and existence is remapped as an internal difference of a unified order of existence.","refs":["CH_GB18_DSUE:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MME-02","text":"Relation to an other is reclassified from external dependence into a condition of self-preservation.","refs":["CH_GB18_BD_2:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MME-03","text":"The opposition of thing and reflection collapses because reflection becomes readable as the thing's inner self-determination.","refs":["CH_GB18_A_37:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MME-04","text":"Causality becomes visible as the preservation of a determination in its effect and not as the one-sided production of an external result.","refs":["CH_GB18_BD_2:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MME-05","text":"Subjective and objective limit appear as variants of the same structure of finitude.","refs":["CH_GB18_A_37:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_46:ALT-B01","text":"At the Surface level, the system treats thing in itself, properties, relation, effect, and cause as moments of a single conceptual movement.","refs":["CH_GB18_BD_2:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:ALT-B02","text":"At the Structural level, the system organizes the movement through reflection, positedness, ground, and self-identity.","refs":["CH_GB18_BD_2:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:ALT-B03","text":"At the Metastrategic level, the system replaces external refutation with the immanent consequence of a determination of limit that invalidates itself.","refs":["CH_GB18_A_37:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:ALT-B04","text":"At the Ontological / Temporal level, reality is present only as self-reflecting determinacy, whose beginning is reinterpreted through its later self-determination.","refs":["CH_GB18_A_37:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:ALT-B05","text":"At the Methodological / Performative level, the form of argument itself performs what it asserts by recognizing attribution only insofar as this proceeds from the self-movement of the concept.","refs":["CH_GB18_DSUE:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_46:FL-01","text":"The architecture requires the tension that initially no multiplicity belongs to the thing itself and that its determinacy later appears as its own property.","refs":["CH_GB18_DSUE:A4","CH_GB18_DSUE:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FL-02","text":"Property is supposed to depend on the other thing and at the same time to be its own ground; this tension is preserved as conditionedness, not sublated.","refs":["CH_GB18_BD_2:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:FL-03","text":"The thing is determined as cause although its positing reflection is expressly still pending; causality therefore functions as a transitional rather than a conclusive determination.","refs":["CH_GB18_BD_2:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MP-01","text":"The decisive mutation occurs when external reflection no longer remains alien attribution, but becomes the determination of the thing itself.","refs":["CH_GB18_A_37:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MP-02","text":"Property mutates when relation and self-identity no longer represent separate moments, but coincide as reflected quality.","refs":["CH_GB18_BD_2:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MP-03","text":"The transition to cause occurs when self-preservation is conceived not as passive persistence, but as the form of effect of ground.","refs":["CH_GB18_BD_2:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_46:HSI-01","text":"Reality appears as a machine of self-differentiation, in which every apparently external relation returns to the self-relation of an essential identity.","refs":["CH_GB18_DSUE:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:HSI-02","text":"The subject appears not as the sovereign origin of determinations, but as a temporary localization of a reflection whose conditions extend beyond it.","refs":["CH_GB18_BD_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:HSI-03","text":"Time appears as change without loss of being-in-itself: mutability is the external form of realization of a self-reflecting ground.","refs":["CH_GB18_BD_2:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_46:MRT-B01","text":"At the cluster level, the extracted axioms suffice to reconstruct the movement from abstract thing in itself through property and causality to conditioned ground.","refs":["CH_GB18_BD_2:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MRT-B02","text":"The precise categorical mediation between quality, constitution, and reflected quality remains underdetermined.","refs":["CH_GB18_BD_2:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MRT-B03","text":"The architecture remains coherent only if sublated mediation is understood simultaneously as negated and as persisting.","refs":["CH_GB18_BD_2:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_46:MRT-B04","text":"The strongest operation is the immanent dissolution of the two-world structure; its most sensitive point remains the presupposed identification of external reflection with the thing's own determination.","refs":["CH_GB18_A_37:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_46@R001","source_variant_id":"canonical:CL_GB18_46:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 136–138","context":"a. Ding an sich und Existenz. · b. Die Eigenschaft. · Anmerkung."},"title_language_code":"en"},{"id":"CL_GB18_47","layer":"CL","title":"Chapters 139–141","order":47,"parents":["CH_GB18_CDWD","CH_GB18_BDBD","CH_GB18_CDAS"],"revision":"CL_GB18_47@R001","sha256":"9c01eb7e39cefeed7d2a982b6d254d3c85da8887f49d6d698eb3ca7a5601da9d","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_47:AS-01","text":"Das System setzt beim selbständigen Ding an, um zu zeigen, dass dessen Bestimmtheit nicht in einem eigenschaftslosen Inneren, sondern nur in seiner eigenschaftlichen Beziehung besteht.","refs":["CH_GB18_CDWD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-02","text":"Die Eigenschaft wird aus dem Status einer vermittelnden Bestimmung herausgelöst und als die Reflexionsform bestimmt, in der Unterschiede und Beziehungen derselben Dinge zugleich erzeugt werden.","refs":["CH_GB18_CDWD:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-03","text":"Die Verselbstständigung der Eigenschaft verwandelt sie in Materie und entzieht dem Ding den Rang eines ursprünglichen Trägers.","refs":["CH_GB18_BDBD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-04","text":"Das Ding kehrt als negative Einheit wieder, aber diese Einheit besitzt keine qualitative Konstitutionskraft gegenüber der Kontinuität selbstständiger Materien.","refs":["CH_GB18_BDBD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-05","text":"Materielle Zusammensetzung bestimmt das Ding als quantitative Sammlung, deren Bestandteile seine Grenze überschreiten und keiner exklusiven Dingzugehörigkeit unterliegen.","refs":["CH_GB18_BDBD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-06","text":"Die äußerliche Veränderlichkeit des Dings wird nicht als bloßer Zufall, sondern als sein wesentliches Bestehen bestimmt.","refs":["CH_GB18_CDAS:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-07","text":"Die quantitative Sammlung schlägt in negative Vermittlung um, weil jedes Bestehen einer Materie das Nichtbestehen anderer Materien in derselben Rücksicht voraussetzt.","refs":["CH_GB18_CDAS:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-08","text":"Die Bewegung schließt nicht bei einer stabilisierten Dingontologie, sondern bei Erscheinung als Existenz, deren Ansichsein nur in unwesentlicher und negativer Vermittlung besteht.","refs":["CH_GB18_CDAS:A18"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_47:GA-01","text":"[Persistent] Dingheit besitzt keine ursprüngliche Selbstständigkeit außerhalb bestimmter Beziehungen, Eigenschaften oder materieller Zusammensetzungen.","refs":["CH_GB18_CDWD:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-02","text":"[Mutating] Die Eigenschaft beginnt als Bestimmung des Dings, wird als Wechselbeziehung begriffen und endet als selbstständige Materie.","refs":["CH_GB18_CDWD:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-03","text":"[Persistent] Selbstständigkeit ist keine Unabhängigkeit, sondern eine durch negative Beziehung, Bestimmtheit und Anderes vermittelte Existenzweise.","refs":["CH_GB18_CDAS:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-04","text":"[Emergent] Das Ding wird nur dadurch bestimmt, dass qualitative Einheit in quantitative Komposition und negative Einheit übergeht.","refs":["CH_GB18_BDBD:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-05","text":"[Mutating] Äußerlichkeit ist zunächst der Verlust der Wesentlichkeit des Dings, wird aber zur wesentlichen Form seines Bestehens.","refs":["CH_GB18_CDAS:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-06","text":"[Attractor] Jede positive Einheit des Dings wird in eine Einheit überführt, die nur durch Differenz, Aufhebung und fehlenden inneren Zusammenhang besteht.","refs":["CH_GB18_CDAS:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-07","text":"[Persistent] Individuation ist nicht die Wirkung eines inneren Substrats, sondern die jeweils bestimmte Verteilung, Negation und Zusammensetzung von Eigenschaften oder Stoffen.","refs":["CH_GB18_BDBD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-08","text":"[Terminal] Existenz ist nicht die letzte ontologische Bestimmung, sondern Erscheinung eines durch Nichtigkeit vermittelten Bestehens.","refs":["CH_GB18_CDAS:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-09","text":"[Attractor] Der Übergang von positiver Kontinuität zu negativer Vermittlung erzeugt eine poröse Ontologie, in der Grenzen niemals abschließend schließen.","refs":["CH_GB18_CDAS:D3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_47:RMD-01","text":"Das Ding kehrt vom scheinbar wesentlichen Extrem über negative Einheit zur bloßen quantitativen und porösen Kompositionsidentität wieder; stabile Dingidentität wird durch funktionale Restidentität ersetzt.","refs":["CH_GB18_CDWD:A14","CH_GB18_CDAS:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RMD-02","text":"Die Eigenschaft bleibt als Ort der Bestimmtheit erhalten, mutiert jedoch von Relation über Kontinuität zu selbstständiger Materie.","refs":["CH_GB18_CDWD:D1","CH_GB18_BDBD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RMD-03","text":"Materie erscheint zuerst als Verselbstständigung der Eigenschaft, dann als äußerliche Sammlung und schließlich als negativ vermittelte Stoffbeziehung.","refs":["CH_GB18_CDWD:D8","CH_GB18_CDAS:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RMD-04","text":"Die Grenze des Dings verschiebt sich von äußerlicher Abgrenzbarkeit über quantitative Verteilung zu absoluter Porosität ohne eigenes Maß und eigene Form.","refs":["CH_GB18_CDWD:ME4","CH_GB18_CDAS:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RMD-05","text":"Kontinuität kehrt nicht als harmonische Einheit wieder, sondern wird in die widersprüchliche Gleichzeitigkeit von Bestehen, Nichtbestehen und Aufhebung umcodiert.","refs":["CH_GB18_BDBD:A4","CH_GB18_CDAS:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_47:CGD-01","text":"Die Bestimmung einzelner Eigenschaften oder bestimmter Materien gehört zur unteren Ebene; auf Clusterebene trägt allein die Umkehrung ihrer ontologischen Rangordnung.","refs":["CH_GB18_CDWD:A10","CH_GB18_BDBD:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:CGD-02","text":"Die quantitative Zusammensetzung eines einzelnen Dings bleibt lokal; global wird sie zur Auflösung jeder qualitativen Dinggrenze.","refs":["CH_GB18_BDBD:A16","CH_GB18_CDAS:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:CGD-03","text":"Die negative Einheit ist nicht bloß eine Bestimmung des abschließenden Dings, sondern die übergreifende Form, in der Ding, Materie und Existenz ihre Selbstständigkeit zugleich gewinnen und verlieren.","refs":["CH_GB18_CDAS:A11","CH_GB18_CDAS:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:CGD-04","text":"Die Erscheinung überschreitet die lokale Analyse stofflicher Auflösung, weil sie die Wahrheit des gesamten Wegs von Ding, Eigenschaft und Materie bestimmt.","refs":["CH_GB18_CDAS:D9","CH_GB18_CDAS:FGS10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_47:GNX-01","text":"Ausgeschlossen wird ein Ding, das als eigenschaftsloses Substrat seinen Bestimmungen, Beziehungen und Stoffen ontologisch vorausliegt.","refs":["CH_GB18_CDWD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GNX-02","text":"Ausgeschlossen wird eine Eigenschaft, die nur akzidentelles Prädikat eines ansonsten vollständigen Dings wäre.","refs":["CH_GB18_BDBD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GNX-03","text":"Ausgeschlossen wird eine Materie, die durch Zugehörigkeit zu einem einzelnen Ding qualitativ begrenzt oder innerlich vermittelt wäre.","refs":["CH_GB18_BDBD:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GNX-04","text":"Ausgeschlossen wird eine positive Einheit, die den Stoffen vorausliegt und ihre Verbindung als inneren Zusammenhang begründet.","refs":["CH_GB18_CDAS:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GNX-05","text":"Ausgeschlossen wird eine Existenz, die ihren Grund in unmittelbarem positivem Ansichsein statt in Negation, Unwesentlichkeit und Erscheinung hätte.","refs":["CH_GB18_CDAS:DNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_47:DBN-01","text":"Das System kann keine ontologische Rangordnung zulassen, in der ein selbstidentisches Ding die Eigenschaften als nachträgliche Akzidenzen trägt.","refs":["CH_GB18_CDWD:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:DBN-02","text":"Das System kann keine geschlossene Grenze zwischen Ding und Bestandteil zulassen, weil Materien über jedes einzelne Ding hinaus fortbestehen.","refs":["CH_GB18_BDBD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:DBN-03","text":"Das System kann keine reine Koexistenz zulassen, weil Gleichzeitigkeit der Stoffe stets als gegenseitiges Bestehen und Nichtbestehen bestimmt wird.","refs":["CH_GB18_CDAS:DNX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:DBN-04","text":"Das System kann keine letzte positive Grundlage zulassen, weil die Wahrheit der Existenz gerade in ihrer durch Nichtigkeit vermittelten Unwesentlichkeit liegt.","refs":["CH_GB18_CDAS:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_47:BSA-01","text":"Nicht verfügbar ist eine relationfreie Identität, die vor Bestimmtheit, Zusammensetzung und negativer Vermittlung bestehen könnte.","refs":["CH_GB18_CDWD:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSA-02","text":"Unzulässig ist eine ontologisch abschließbare Einheit, die sich vollständig von dem unterscheiden könnte, was sie ausschließt.","refs":["CH_GB18_CDAS:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSA-03","text":"Versperrt bleibt ein Bestehen ohne Aufhebung, Vermittlung und Erscheinung; diese Unmöglichkeit ist der negative Attraktor der gesamten Bewegung.","refs":["CH_GB18_CDAS:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_47:XD-01","text":"Die Verselbstständigung der Eigenschaft erzeugt keine stabile materielle Grundlage, sondern verschiebt die Instabilität des Dings auf die Stoffe selbst, deren Selbstständigkeit nur negativ vermittelt bestehen kann.","refs":["CL_GB18_47:GA-02","CL_GB18_47:GA-03","CH_GB18_CDWD:A16","CH_GB18_CDAS:SD3"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_47:XD-02","text":"Die quantitative Sammlung ist keine neutrale Endform der Dingheit, weil ihre äußerliche Komposition notwendig in poröse Durchdringung und gegenseitige Aufhebung übergeht.","refs":["CL_GB18_47:GA-04","CL_GB18_47:GA-09","CH_GB18_BDBD:A16","CH_GB18_CDAS:FGS7"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_47:XD-03","text":"Der Verlust qualitativer Dinggrenzen führt nicht zu formlosem Pluralismus, sondern zu einer negativen Einheit, in der jede Bestimmtheit nur durch Ausschluss anderer Bestimmtheiten besteht.","refs":["CL_GB18_47:GA-06","CL_GB18_47:GA-07","CH_GB18_BDBD:ME2","CH_GB18_CDAS:A9"],"deep_refs":[],"trace_type":"Tension.","passages":[]},{"id":"CL_GB18_47:XD-04","text":"Die Äußerlichkeit des Dings wird von einem Symptom seiner Unwesentlichkeit zur Bedingung seines Bestehens und damit zum Übergangspunkt von Existenz zu Erscheinung.","refs":["CL_GB18_47:GA-05","CL_GB18_47:GA-08","CH_GB18_BDBD:D5","CH_GB18_CDAS:D9"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_47:XD-05","text":"Die Auflösung des Dings ist kein äußerer Untergang eines zuvor stabilen Substrats, sondern die Explikation dessen, dass seine Einheit von Beginn an aus nicht abschließbarer Relation bestand.","refs":["CL_GB18_47:GA-01","CL_GB18_47:GA-06","CH_GB18_CDWD:NX1","CH_GB18_CDAS:SD2"],"deep_refs":[],"trace_type":"Negative.","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_47:BSD-01","text":"Ontologische Priorität liegt weder beim Ding noch bei einer isolierten Materie, sondern bei der reflexiven Anordnung, in der Eigenschaften zu Materien und Materien zu negativ vermittelten Bestimmtheiten werden.","refs":["CH_GB18_CDWD:SD1","CH_GB18_CDAS:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSD-02","text":"Individuation wird als vorläufige Konfiguration bestimmt: Sie ist quantitative Verteilung, negative Abgrenzung und Austauschprozess zugleich.","refs":["CH_GB18_BDBD:SD2","CH_GB18_CDAS:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSD-03","text":"Das System erzeugt eine Ontologie der nichtschließenden Komposition, in der Einheit ausschließlich als Leistung von Differenz und Aufhebung vorkommt.","refs":["CH_GB18_BDBD:SD6","CH_GB18_CDAS:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSD-04","text":"Zeitlichkeit erscheint als fortgesetzter Zu- und Abgang, durch den die Identität des Dings nicht trotz, sondern als Folge ihres Verschwindens besteht.","refs":["CH_GB18_CDAS:AS2","CH_GB18_CDAS:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSD-05","text":"Erscheinung ist keine bloße epistemische Schwächung des Seienden, sondern die ontologische Wahrheit einer Existenz, die nur vermittelt, unwesentlich und negativ gegründet ist.","refs":["CH_GB18_CDAS:A17","CH_GB18_CDAS:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_47:RLE-01","text":"Ding → Eigenschaft → Materie → Stoffbeziehung → Erscheinung bildet eine Eskalationslinie, in der jede versuchte Stabilisierung die Bedingung ihrer nächsten Auflösung erzeugt.","refs":["CH_GB18_CDWD:AF1","CH_GB18_CDAS:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RLE-02","text":"Die Schleife der Selbstständigkeit lautet: Selbstständigkeit wird behauptet, durch Beziehung bestimmt, als Materie verselbstständigt und durch negative Vermittlung wieder entzogen.","refs":["CH_GB18_BDBD:A2","CH_GB18_CDAS:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RLE-03","text":"Der Attraktor des Systems ist negative Einheit: Sie ersetzt erst die qualitative Einheit des Dings und transformiert dann die materielle Koexistenz in gegenseitige Aufhebung.","refs":["CH_GB18_BDBD:SD4","CH_GB18_CDAS:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RLE-04","text":"Die Grenze spiralförmig zurückkehrender Dingheit wird zunächst äußerlich, dann quantitativ und zuletzt porös, sodass jede Grenzbestimmung ihre eigene Überschreitung hervorbringt.","refs":["CH_GB18_CDWD:ME4","CH_GB18_CDAS:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RLE-05","text":"Die Wiederkehr des Ansichseins markiert keinen Rückgang zu ursprünglicher Substanz, sondern seine terminale Umcodierung als Unwesentlichkeit und Erscheinung.","refs":["CH_GB18_CDWD:A11","CH_GB18_CDAS:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_47:FGS-B01","text":"Setze das Ding als scheinbar selbständige Einheit, deren Unterschied zunächst durch Eigenschaften bestimmt wird.","refs":["CH_GB18_CDWD:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FGS-B02","text":"Identifiziere die Eigenschaft mit der Wechselbeziehung, sodass die Selbstständigkeit der Dinge in eine gemeinsame Reflexionsstruktur übergeht.","refs":["CH_GB18_CDWD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FGS-B03","text":"Verselbstständige die Eigenschaft als Materie und reduziere das Ding auf negative Einheit beziehungsweise quantitative Sammlung.","refs":["CH_GB18_CDWD:D8","CH_GB18_BDBD:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FGS-B04","text":"Lasse die Materien das einzelne Ding überschreiten, wodurch dessen Grenze, Maß und qualitative Einheit äußerlich und unwesentlich werden.","refs":["CH_GB18_BDBD:A13","CH_GB18_CDAS:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FGS-B05","text":"Transformiere die äußerliche Sammlung in negative Stoffbeziehung, in der jedes Bestehen durch das Nichtbestehen anderer Bestimmtheiten vermittelt ist.","refs":["CH_GB18_CDAS:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FGS-B06","text":"Bestimme die widersprüchliche Existenz als Erscheinung, in der Ansichsein nur als unwesentliches und negativ gegründetes Bestehen vorhanden ist.","refs":["CH_GB18_CDAS:FGS10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_47:AFM-B01","text":"Scheinbar selbständiges Ding → eigenschaftliche Bestimmtheit.","refs":["CH_GB18_CDWD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B02","text":"Eigenschaftliche Bestimmtheit → Wechselwirkung als einheitliche Reflexion.","refs":["CH_GB18_CDWD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B03","text":"Wechselwirkung → Verselbstständigung der Eigenschaft als Materie.","refs":["CH_GB18_CDWD:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B04","text":"Selbstständige Materie → Ding als negative und quantitative Sammlung.","refs":["CH_GB18_BDBD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B05","text":"Quantitative Sammlung → äußerliche Veränderlichkeit und Auflösbarkeit.","refs":["CH_GB18_CDAS:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B06","text":"Äußerliche Veränderlichkeit → negative Einheit und poröse Durchdringung der Stoffe.","refs":["CH_GB18_CDAS:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B07","text":"Negative Einheit → widersprüchliche Existenz → Erscheinung.","refs":["CH_GB18_CDAS:AS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_47:MME-01","text":"Das begriffliche Feld wird vom Substratmodell auf ein Relationsmodell umgestellt, in dem Bestimmungen nicht an einem vorausgesetzten Träger haften, sondern dessen Existenz erst erzeugen.","refs":["CH_GB18_CDWD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MME-02","text":"Die Opposition von Ding und Eigenschaft kollabiert zugunsten einer Hierarchie, in der Dingheit als äußere Form der verselbstständigten Eigenschaft erscheint.","refs":["CH_GB18_CDWD:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MME-03","text":"Die Opposition von qualitativer Individualität und quantitativer Zusammensetzung wird aufgehoben, indem Individuation selbst als quantitativer und relationaler Effekt bestimmt wird.","refs":["CH_GB18_BDBD:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MME-04","text":"Die Opposition von äußerer Beziehung und innerem Wesen zerfällt, weil die Äußerlichkeit zur wesentlichen Struktur des Dings wird.","refs":["CH_GB18_CDAS:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MME-05","text":"Die Opposition von Koexistenz und Ausschluss wird durch eine Ontologie ersetzt, in der Stoffe gerade durch ihr wechselseitiges Bestehen und Nichtbestehen zusammen bestehen.","refs":["CH_GB18_CDAS:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_47:ALT-B01","text":"Surface level — Das Ding erscheint als veränderliche Zusammensetzung von Eigenschaften oder Stoffen, die eintreten, austreten und ihre Mengenverhältnisse verändern können.","refs":["CH_GB18_CDAS:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:ALT-B02","text":"Structural level — Dingheit wird durch die Verschränkung von selbstständiger Materie, äußerlicher Kontinuität und negativer Einheit hervorgebracht.","refs":["CH_GB18_BDBD:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:ALT-B03","text":"Metastrategic level — Das System demontiert jede Erklärung, die qualitative Einheit, inneren Zusammenhang oder unabhängige Substanz als Ausgangspunkt der Analyse voraussetzt.","refs":["CH_GB18_BDBD:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:ALT-B04","text":"Ontological / Temporal level — Identität ist kein beharrendes Sein, sondern eine zeitliche Folge materieller Ersetzung, Auflösung und negativer Vermittlung.","refs":["CH_GB18_CDAS:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie jeden behaupteten Träger schrittweise in die Beziehungen, Differenzen und Negationen auflöst, die ihn konstituieren.","refs":["CH_GB18_CDWD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_47:FL-01","text":"Die Eigenschaft muss zugleich Wechselbeziehung und selbstständige Materie sein; diese Doppelstellung erzeugt den Übergang, verhindert jedoch eine statische Bestimmung ihres Status.","refs":["CH_GB18_CDWD:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FL-02","text":"Die Materien sollen das Ding konstituieren, ohne durch diese Zugehörigkeit wesentlich bestimmt oder qualitativ begrenzt zu werden.","refs":["CH_GB18_BDBD:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FL-03","text":"Das Ding wird als Zusammenhang bestimmt, dessen einziger positiver Inhalt im Fehlen eines inneren Zusammenhangs liegt.","refs":["CH_GB18_BDBD:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FL-04","text":"Gleichgültige Koexistenz und negative Beziehung bleiben zugleich notwendig; ihre Nichtauflösung ist die Bedingung der porösen Einheit des Dings.","refs":["CH_GB18_CDAS:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MP-01","text":"Der entscheidende Mutationspunkt liegt in der Umkehrung, durch die das Ding von der wesentlichen Einheit zur unwesentlichen äußeren Form und die Eigenschaft zum selbstständigen Bestehen wird.","refs":["CH_GB18_CDWD:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MP-02","text":"Der terminale Mutationspunkt liegt im Übergang von äußerlicher Stoffverbindung zu Erscheinung, weil die Äußerlichkeit dort als negative Grundlage der Existenz lesbar wird.","refs":["CH_GB18_CDAS:AS3","CH_GB18_CDAS:A18"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_47:HSI-01","text":"Realität erscheint als poröses Gefüge selbstständiger Bestimmtheiten, deren jeweilige Existenz nur in ihrer Durchdringung, Begrenzung und Aufhebung durch andere besteht.","refs":["CH_GB18_CDAS:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:HSI-02","text":"Das Subjektmodell des selbstidentischen Trägers wird durch das Bild einer vorläufigen Konfiguration ersetzt, die sich nur als Verhältnis ihrer wechselnden Bestimmungen hält.","refs":["CH_GB18_CDAS:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:HSI-03","text":"Zeit ist keine neutrale Folge äußerer Veränderungen, sondern die Form, in der Dingidentität durch Zu- und Abgang ihrer Stoffe erzeugt und zugleich entzogen wird.","refs":["CH_GB18_CDAS:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:HSI-04","text":"Mögliche Navigation besteht nicht in der Sicherung eines letzten Trägers, sondern in der Analyse jener negativen Vermittlungen, durch die scheinbar selbständige Einheiten bestehen.","refs":["CH_GB18_CDAS:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_47:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die gerichtete Bewegung von Ding über Eigenschaft und Materie zur negativen Einheit und Erscheinung zu rekonstruieren.","refs":["CH_GB18_CDWD:MRT1","CH_GB18_CDAS:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MRT-B02","text":"Die Rekonstruktion ist auf Clusterebene kohärent, sofern Selbstständigkeit nicht als Unabhängigkeit, sondern als negativ vermittelte Bestimmung verstanden wird.","refs":["CH_GB18_CDAS:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MRT-B03","text":"Unterbestimmt bleibt die genaue kategoriale Vermittlung zwischen selbstständiger Materie, absoluter Porosität, negativer Einheit und Erscheinung.","refs":["CH_GB18_CDWD:MRT2","CH_GB18_CDAS:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MRT-B04","text":"Die Architektur ist am stärksten dort, wo sie die fortschreitende Umkehrung jeder Substratontologie als selbstgenerierende Folge von Bestimmtheit, Äußerlichkeit und Negation sichtbar macht.","refs":["CH_GB18_CDWD:MRT4","CH_GB18_CDAS:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122719988023Z_3ee1ebdb","language_code":"en","language_name":"English","title":"Chapters 139–141","source_sha256":"9c01eb7e39cefeed7d2a982b6d254d3c85da8887f49d6d698eb3ca7a5601da9d","sha256":"f4b0f7fbf401f5aa8dfc993655f4fd217e5dfb6c58a2cc4c101576c3542085b8","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:27:19.988994+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_47:AS-01","text":"The system begins with the self-subsistent thing in order to show that its determinacy consists not in a propertyless interior, but only in its property-based relation.","refs":["CH_GB18_CDWD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-02","text":"Property is detached from the status of a mediating determination and determined as the form of reflection in which differences and relations of the same things are simultaneously produced.","refs":["CH_GB18_CDWD:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-03","text":"The autonomization of property transforms it into matter and deprives the thing of the status of an original bearer.","refs":["CH_GB18_BDBD:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-04","text":"The thing returns as negative unity, but this unity possesses no qualitative constitutive power vis-à-vis the continuity of self-subsistent matters.","refs":["CH_GB18_BDBD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-05","text":"Material composition determines the thing as a quantitative collection whose components exceed its boundary and are not subject to any exclusive belonging to the thing.","refs":["CH_GB18_BDBD:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-06","text":"The external mutability of the thing is determined not as mere contingency, but as its essential subsistence.","refs":["CH_GB18_CDAS:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-07","text":"The quantitative collection turns into negative mediation because every subsistence of one matter presupposes the non-subsistence of other matters in the same respect.","refs":["CH_GB18_CDAS:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AS-08","text":"The movement concludes not in a stabilized ontology of the thing, but in appearance as existence, whose being-in-itself consists only in inessential and negative mediation.","refs":["CH_GB18_CDAS:A18"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_47:GA-01","text":"[Persistent] Thinghood possesses no original self-subsistence outside determinate relations, properties, or material compositions.","refs":["CH_GB18_CDWD:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-02","text":"[Mutating] Property begins as a determination of the thing, is conceived as reciprocal relation, and ends as self-subsistent matter.","refs":["CH_GB18_CDWD:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-03","text":"[Persistent] Self-subsistence is not independence, but a mode of existence mediated through negative relation, determinacy, and otherness.","refs":["CH_GB18_CDAS:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-04","text":"[Emergent] The thing is determined only insofar as qualitative unity passes over into quantitative composition and negative unity.","refs":["CH_GB18_BDBD:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-05","text":"[Mutating] Externality is initially the loss of the essentiality of the thing, but becomes the essential form of its subsistence.","refs":["CH_GB18_CDAS:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-06","text":"[Attractor] Every positive unity of the thing is transformed into a unity that subsists only through difference, sublation, and the absence of inner connection.","refs":["CH_GB18_CDAS:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-07","text":"[Persistent] Individuation is not the effect of an inner substrate, but the respectively determinate distribution, negation, and composition of properties or materials.","refs":["CH_GB18_BDBD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-08","text":"[Terminal] Existence is not the final ontological determination, but the appearance of a subsistence mediated through nothingness.","refs":["CH_GB18_CDAS:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GA-09","text":"[Attractor] The transition from positive continuity to negative mediation produces a porous ontology in which boundaries never finally close.","refs":["CH_GB18_CDAS:D3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_47:RMD-01","text":"The thing returns from the seemingly essential extreme, through negative unity, to mere quantitative and porous compositional identity; stable thing-identity is replaced by functional residual identity.","refs":["CH_GB18_CDWD:A14","CH_GB18_CDAS:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RMD-02","text":"Property is retained as the locus of determinacy, but mutates from relation through continuity into self-subsistent matter.","refs":["CH_GB18_CDWD:D1","CH_GB18_BDBD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RMD-03","text":"Matter appears first as the autonomization of property, then as an external collection, and finally as a negatively mediated material relation.","refs":["CH_GB18_CDWD:D8","CH_GB18_CDAS:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RMD-04","text":"The boundary of the thing shifts from external delimitability through quantitative distribution to absolute porosity without its own measure and form.","refs":["CH_GB18_CDWD:ME4","CH_GB18_CDAS:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RMD-05","text":"Continuity does not return as harmonious unity, but is recoded into the contradictory simultaneity of subsistence, non-subsistence, and sublation.","refs":["CH_GB18_BDBD:A4","CH_GB18_CDAS:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_47:CGD-01","text":"The determination of individual properties or determinate matters belongs to the lower level; at the cluster level, only the reversal of their ontological rank bears weight.","refs":["CH_GB18_CDWD:A10","CH_GB18_BDBD:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:CGD-02","text":"The quantitative composition of an individual thing remains local; globally, it becomes the dissolution of every qualitative boundary of the thing.","refs":["CH_GB18_BDBD:A16","CH_GB18_CDAS:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:CGD-03","text":"Negative unity is not merely a determination of the concluding thing, but the overarching form in which thing, matter, and existence simultaneously gain and lose their self-subsistence.","refs":["CH_GB18_CDAS:A11","CH_GB18_CDAS:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:CGD-04","text":"Appearance exceeds the local analysis of material dissolution because it determines the truth of the entire path of thing, property, and matter.","refs":["CH_GB18_CDAS:D9","CH_GB18_CDAS:FGS10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_47:GNX-01","text":"Excluded is a thing that, as a propertyless substrate, ontologically precedes its determinations, relations, and materials.","refs":["CH_GB18_CDWD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GNX-02","text":"Excluded is a property that would be merely an accidental predicate of an otherwise complete thing.","refs":["CH_GB18_BDBD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GNX-03","text":"Excluded is a matter that would be qualitatively delimited or internally mediated through belonging to an individual thing.","refs":["CH_GB18_BDBD:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GNX-04","text":"Excluded is a positive unity that precedes the materials and grounds their connection as an inner coherence.","refs":["CH_GB18_CDAS:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:GNX-05","text":"Excluded is an existence that would have its ground in immediate positive being-in-itself rather than in negation, inessentiality, and appearance.","refs":["CH_GB18_CDAS:DNX6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_47:DBN-01","text":"The system cannot allow an ontological hierarchy in which a self-identical thing bears properties as subsequent accidents.","refs":["CH_GB18_CDWD:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:DBN-02","text":"The system cannot allow a closed boundary between thing and component, because matters persist beyond every individual thing.","refs":["CH_GB18_BDBD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:DBN-03","text":"The system cannot allow pure coexistence, because the simultaneity of materials is always determined as reciprocal subsistence and non-subsistence.","refs":["CH_GB18_CDAS:DNX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:DBN-04","text":"The system cannot allow a final positive foundation, because the truth of existence lies precisely in its inessentiality mediated through nothingness.","refs":["CH_GB18_CDAS:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_47:BSA-01","text":"Unavailable is a relation-free identity that could subsist prior to determinacy, composition, and negative mediation.","refs":["CH_GB18_CDWD:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSA-02","text":"Impermissible is an ontologically closable unity that could distinguish itself completely from that which it excludes.","refs":["CH_GB18_CDAS:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSA-03","text":"Blocked remains a subsistence without sublation, mediation, and appearance; this impossibility is the negative attractor of the entire movement.","refs":["CH_GB18_CDAS:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_47:XD-01","text":"The autonomization of property produces no stable material foundation, but shifts the instability of the thing onto the materials themselves, whose self-subsistence can subsist only as negatively mediated.","refs":["CL_GB18_47:GA-02","CL_GB18_47:GA-03","CH_GB18_CDWD:A16","CH_GB18_CDAS:SD3"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_47:XD-02","text":"The quantitative collection is not a neutral final form of thinghood, because its external composition necessarily passes over into porous interpenetration and reciprocal sublation.","refs":["CL_GB18_47:GA-04","CL_GB18_47:GA-09","CH_GB18_BDBD:A16","CH_GB18_CDAS:FGS7"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_47:XD-03","text":"The loss of qualitative boundaries of the thing leads not to formless pluralism, but to a negative unity in which every determinacy subsists only through the exclusion of other determinacies.","refs":["CL_GB18_47:GA-06","CL_GB18_47:GA-07","CH_GB18_BDBD:ME2","CH_GB18_CDAS:A9"],"deep_refs":[],"trace_type":"Tension.","passages":[]},{"id":"CL_GB18_47:XD-04","text":"The externality of the thing becomes, from a symptom of its inessentiality, the condition of its subsistence and thereby the point of transition from existence to appearance.","refs":["CL_GB18_47:GA-05","CL_GB18_47:GA-08","CH_GB18_BDBD:D5","CH_GB18_CDAS:D9"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_47:XD-05","text":"The dissolution of the thing is not the external downfall of a previously stable substrate, but the explication of the fact that its unity consisted from the outset in a relation incapable of final closure.","refs":["CL_GB18_47:GA-01","CL_GB18_47:GA-06","CH_GB18_CDWD:NX1","CH_GB18_CDAS:SD2"],"deep_refs":[],"trace_type":"Negative.","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_47:BSD-01","text":"Ontological priority lies neither with the thing nor with an isolated matter, but with the reflexive arrangement in which properties become matters and matters become negatively mediated determinacies.","refs":["CH_GB18_CDWD:SD1","CH_GB18_CDAS:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSD-02","text":"Individuation is determined as a provisional configuration: it is simultaneously quantitative distribution, negative delimitation, and process of exchange.","refs":["CH_GB18_BDBD:SD2","CH_GB18_CDAS:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSD-03","text":"The system produces an ontology of non-closing composition, in which unity occurs exclusively as the achievement of difference and sublation.","refs":["CH_GB18_BDBD:SD6","CH_GB18_CDAS:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSD-04","text":"Temporality appears as continuous accession and departure, through which the identity of the thing subsists not despite, but as a consequence of, its disappearance.","refs":["CH_GB18_CDAS:AS2","CH_GB18_CDAS:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:BSD-05","text":"Appearance is not a mere epistemic weakening of being, but the ontological truth of an existence that is only mediated, inessential, and negatively grounded.","refs":["CH_GB18_CDAS:A17","CH_GB18_CDAS:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_47:RLE-01","text":"Thing → property → matter → material relation → appearance forms a line of escalation in which every attempted stabilization produces the condition of its next dissolution.","refs":["CH_GB18_CDWD:AF1","CH_GB18_CDAS:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RLE-02","text":"The loop of self-subsistence is as follows: self-subsistence is asserted, determined through relation, autonomized as matter, and withdrawn again through negative mediation.","refs":["CH_GB18_BDBD:A2","CH_GB18_CDAS:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RLE-03","text":"The attractor of the system is negative unity: it first replaces the qualitative unity of the thing and then transforms material coexistence into reciprocal sublation.","refs":["CH_GB18_BDBD:SD4","CH_GB18_CDAS:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RLE-04","text":"The boundary of spirally recurring thinghood becomes first external, then quantitative, and finally porous, such that every boundary-determination brings forth its own transgression.","refs":["CH_GB18_CDWD:ME4","CH_GB18_CDAS:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:RLE-05","text":"The return of being-in-itself marks no regression to original substance, but its terminal recoding as inessentiality and appearance.","refs":["CH_GB18_CDWD:A11","CH_GB18_CDAS:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_47:FGS-B01","text":"Set the thing as a seemingly self-subsistent unity whose difference is initially determined through properties.","refs":["CH_GB18_CDWD:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FGS-B02","text":"Identify property with reciprocal relation, so that the self-subsistence of things passes over into a common structure of reflection.","refs":["CH_GB18_CDWD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FGS-B03","text":"Autonomize property as matter and reduce the thing to negative unity or quantitative collection.","refs":["CH_GB18_CDWD:D8","CH_GB18_BDBD:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FGS-B04","text":"Let the matters exceed the individual thing, whereby its boundary, measure, and qualitative unity become external and inessential.","refs":["CH_GB18_BDBD:A13","CH_GB18_CDAS:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FGS-B05","text":"Transform the external collection into negative material relation, in which every subsistence is mediated through the non-subsistence of other determinacies.","refs":["CH_GB18_CDAS:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FGS-B06","text":"Determine contradictory existence as appearance, in which being-in-itself is present only as inessential and negatively grounded subsistence.","refs":["CH_GB18_CDAS:FGS10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_47:AFM-B01","text":"Seemingly self-subsistent thing → property-based determinacy.","refs":["CH_GB18_CDWD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B02","text":"Property-based determinacy → interaction as unified reflection.","refs":["CH_GB18_CDWD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B03","text":"Interaction → autonomization of property as matter.","refs":["CH_GB18_CDWD:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B04","text":"Self-subsistent matter → thing as negative and quantitative collection.","refs":["CH_GB18_BDBD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B05","text":"Quantitative collection → external mutability and dissolvability.","refs":["CH_GB18_CDAS:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B06","text":"External mutability → negative unity and porous interpenetration of materials.","refs":["CH_GB18_CDAS:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:AFM-B07","text":"Negative unity → contradictory existence → appearance.","refs":["CH_GB18_CDAS:AS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_47:MME-01","text":"The conceptual field is shifted from the substrate model to a relational model in which determinations do not adhere to a presupposed bearer, but first produce its existence.","refs":["CH_GB18_CDWD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MME-02","text":"The opposition between thing and property collapses in favor of a hierarchy in which thinghood appears as the external form of autonomized property.","refs":["CH_GB18_CDWD:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MME-03","text":"The opposition between qualitative individuality and quantitative composition is sublated by determining individuation itself as a quantitative and relational effect.","refs":["CH_GB18_BDBD:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MME-04","text":"The opposition between external relation and inner essence disintegrates because externality becomes the essential structure of the thing.","refs":["CH_GB18_CDAS:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MME-05","text":"The opposition between coexistence and exclusion is replaced by an ontology in which materials subsist together precisely through their reciprocal subsistence and non-subsistence.","refs":["CH_GB18_CDAS:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_47:ALT-B01","text":"Surface level — The thing appears as a mutable composition of properties or materials that can enter, depart, and alter their proportions.","refs":["CH_GB18_CDAS:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:ALT-B02","text":"Structural level — Thinghood is produced through the interweaving of self-subsistent matter, external continuity, and negative unity.","refs":["CH_GB18_BDBD:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:ALT-B03","text":"Metastrategic level — The system dismantles every explanation that presupposes qualitative unity, inner coherence, or independent substance as the starting point of analysis.","refs":["CH_GB18_BDBD:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:ALT-B04","text":"Ontological / Temporal level — Identity is not persisting being, but a temporal sequence of material replacement, dissolution, and negative mediation.","refs":["CH_GB18_CDAS:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:ALT-B05","text":"Methodological / Performative level — The exposition performs its thesis by gradually dissolving every asserted bearer into the relations, differences, and negations that constitute it.","refs":["CH_GB18_CDWD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_47:FL-01","text":"Property must be both reciprocal relation and self-subsistent matter; this double status produces the transition, yet prevents a static determination of its status.","refs":["CH_GB18_CDWD:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FL-02","text":"The matters are supposed to constitute the thing without being essentially determined or qualitatively delimited by this belonging.","refs":["CH_GB18_BDBD:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FL-03","text":"The thing is determined as a coherence whose sole positive content lies in the absence of an inner coherence.","refs":["CH_GB18_BDBD:AS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:FL-04","text":"Indifferent coexistence and negative relation remain equally necessary; their non-resolution is the condition of the porous unity of the thing.","refs":["CH_GB18_CDAS:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MP-01","text":"The decisive mutation point lies in the reversal through which the thing becomes, from essential unity, an inessential external form, and property becomes self-subsistent subsistence.","refs":["CH_GB18_CDWD:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MP-02","text":"The terminal mutation point lies in the transition from external material connection to appearance, because externality there becomes legible as the negative foundation of existence.","refs":["CH_GB18_CDAS:AS3","CH_GB18_CDAS:A18"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_47:HSI-01","text":"Reality appears as a porous configuration of self-subsistent determinacies, each of whose existence consists only in its interpenetration, delimitation, and sublation by others.","refs":["CH_GB18_CDAS:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:HSI-02","text":"The subject model of the self-identical bearer is replaced by the image of a provisional configuration that maintains itself only as the relation of its changing determinations.","refs":["CH_GB18_CDAS:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:HSI-03","text":"Time is not a neutral sequence of external changes, but the form in which thing-identity is produced and simultaneously withdrawn through the accession and departure of its materials.","refs":["CH_GB18_CDAS:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:HSI-04","text":"Possible navigation consists not in securing a final bearer, but in analyzing those negative mediations through which seemingly self-subsistent unities subsist.","refs":["CH_GB18_CDAS:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_47:MRT-B01","text":"The extracted axioms suffice to reconstruct the directed movement from thing through property and matter to negative unity and appearance.","refs":["CH_GB18_CDWD:MRT1","CH_GB18_CDAS:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MRT-B02","text":"The reconstruction is coherent at the cluster level, provided self-subsistence is understood not as independence, but as negatively mediated determination.","refs":["CH_GB18_CDAS:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MRT-B03","text":"The precise categorial mediation between self-subsistent matter, absolute porosity, negative unity, and appearance remains underdetermined.","refs":["CH_GB18_CDWD:MRT2","CH_GB18_CDAS:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_47:MRT-B04","text":"The architecture is strongest where it makes visible the progressive reversal of every substrate ontology as a self-generating sequence of determinacy, externality, and negation.","refs":["CH_GB18_CDWD:MRT4","CH_GB18_CDAS:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_47@R001","source_variant_id":"canonical:CL_GB18_47:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 139–141","context":"c. Die Wechselwirkung der Dinge. · B. Das Bestehen des Dings aus Materien. · C. Die Auflösung des Dings."},"title_language_code":"en"},{"id":"CL_GB18_48","layer":"CL","title":"Chapters 142–144","order":48,"parents":["CH_GB18_A_38","CH_GB18_DGDE","CH_GB18_BD_3"],"revision":"CL_GB18_48@R001","sha256":"54fed5b86d77a1ad7a2f394c756e251f9fe382f49b1611e11d3102f969d4fc1c","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_48:BAS-01","text":"Das System bestimmt Wahrheit als immanente Selbstvermittlung dessen, was zunächst als selbstständiges Ding, unmittelbare Existenz oder ruhiges Gesetz erscheint.","refs":["CH_GB18_A_38:AS6","CH_GB18_DGDE:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-02","text":"Seine Bewegung beginnt mit der äußerlichen Verselbstständigung gleicher Inhaltsbestimmungen, zeigt deren notwendige Negation und überführt diese Negation in eine positive, aber zunächst unvollständige Identität.","refs":["CH_GB18_A_38:AS1","CH_GB18_DGDE:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-03","text":"Das Gesetz entsteht als Stabilisierung der Erscheinung, kann aber nur Wahrheit beanspruchen, indem es die negative Bewegung aufnimmt, die es zunächst als bloße Form der Erscheinung zurücklässt.","refs":["CH_GB18_DGDE:A9","CH_GB18_DGDE:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-04","text":"Die wesentliche oder an-und-für-sich-seyende Welt wird nicht als jenseitiges Reich erreicht, sondern als Resultat der Selbstreflexion der Erscheinung und ihrer Gesetzlichkeit erzeugt.","refs":["CH_GB18_BD_3:D4","CH_GB18_BD_3:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-05","text":"Die gerichtete Bewegung ist rekursiv: Verselbstständigung erzeugt Negation, Negation erzeugt Identität, Identität externalisiert sich erneut und wird nur durch ihre Rückkehr in Negativität real.","refs":["CH_GB18_A_38:A6","CH_GB18_BD_3:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-06","text":"Die äußere Erklärung durch Materien, quantitative Verkleinerung, getrennte Gesetzeswelt oder unabhängigen Grund wird als wiederkehrende Vermeidung der immanenten Negativität demontiert.","refs":["CH_GB18_A_38:A7","CH_GB18_DGDE:NX4","CH_GB18_DGDE:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-07","text":"Die Schließung besteht nicht in einer ruhenden Substanz, sondern in einer Totalität, die ihre Unterschiede nur durch Selbstentzweiung, Umkehrung und Übergehen bei sich hält.","refs":["CH_GB18_BD_3:A10","CH_GB18_BD_3:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-08","text":"Der Geist fungiert als Grenzfigur dieser Architektur, weil er diejenige Einheit bezeichnet, in welcher Unterschiede nicht mehr als selbstständige Dinge, sondern als Momente einer Begriffseinheit bestehen.","refs":["CH_GB18_A_38:A9","CH_GB18_A_38:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_48:GA-01","text":"[Persistent] Selbstständigkeit ist auf dieser Ebene keine vorausliegende Unabhängigkeit, sondern eine Form des Bestehens, die nur durch ihr Verhältnis zu anderem Bestehen und damit durch ihre eigene Negation möglich ist.","refs":["CH_GB18_A_38:A8","CH_GB18_DGDE:A4","CH_GB18_BD_3:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-02","text":"[Mutating] Negative Einheit erscheint zuerst als destruktive Durchdringung selbstständiger Materien, dann als produktive Vermittlung der Erscheinung und schließlich als reale Einheit der Gesetzesseiten.","refs":["CH_GB18_A_38:A6","CH_GB18_DGDE:A6","CH_GB18_BD_3:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-03","text":"[Persistent] Erscheinung ist nicht Mangel an Realität, sondern die Wahrheit einer Existenz, deren Unmittelbarkeit als eigenes Gesetztsein und als vermittelte Negativität expliziert wird.","refs":["CH_GB18_A_38:AS6","CH_GB18_DGDE:A2","CH_GB18_BD_3:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-04","text":"[Attractor] Unterschiede erhalten Wahrheit nur, wenn sie weder in äußerlicher Gleichgültigkeit zerfallen noch in unterschiedslose Einheit verschwinden, sondern als wechselseitig gesetzte Momente bestehen.","refs":["CH_GB18_A_38:A10","CH_GB18_DGDE:A8","CH_GB18_BD_3:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-05","text":"[Mutating] Das Gesetz ist zunächst die ruhige positive Identität der Erscheinung, wird aber erst real, wenn seine eigene Negativität, Gegensätzlichkeit und Selbstvermittlung in seinen Inhalt aufgenommen sind.","refs":["CH_GB18_DGDE:A9","CH_GB18_DGDE:A13","CH_GB18_BD_3:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-06","text":"[Persistent] Grund, Gesetz und Wesen können nicht als selbständige Erste vor ihren Relationen bestehen, weil sie nur als reflektierte Funktionen des von ihnen Begründeten bestimmt sind.","refs":["CH_GB18_DGDE:A5","CH_GB18_DGDE:SD1","CH_GB18_BD_3:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-07","text":"[Emergent] Ontologische Hierarchie entsteht nicht durch den Vorrang eines fertigen Wesens über eine minderwirkliche Erscheinung, sondern durch die Selbstnegation der Erscheinung in eine sie umfassende Totalität.","refs":["CH_GB18_BD_3:D3","CH_GB18_BD_3:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-08","text":"[Attractor] Reale Identität ist nur als durchgehaltene Selbstentgegensetzung möglich; sie ist weder unmittelbare Gleichheit noch die Auslöschung des Unterschieds.","refs":["CH_GB18_DGDE:SD2","CH_GB18_BD_3:A11","CH_GB18_BD_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-09","text":"[Terminal] Die Begriffseinheit des Geistes markiert die Grenzform, in der die dingliche Selbstständigkeit der Unterschiede in unselbstständige Momente zurückgenommen ist.","refs":["CH_GB18_A_38:A9","CH_GB18_A_38:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-10","text":"[Mutating] Notwendigkeit ist nicht Wiederholbarkeit oder unmittelbare gesetzliche Verbindung, sondern die im Inhalt selbst wirksame Negativität, durch welche Bestimmungen ineinander übergehen.","refs":["CH_GB18_DGDE:A13","CH_GB18_DGDE:NX8","CH_GB18_BD_3:D2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_48:RMD-01","text":"Die Bestimmung derselben Inhaltsseite kehrt als Eigenschaft, Materie, gesetzliche Seite und begriffliches Moment wieder; ihre Identität bleibt inhaltlich erhalten, während ihre Form von äußerlicher Selbstständigkeit zu immanenter Vermittlung mutiert.","refs":["CH_GB18_A_38:A1","CH_GB18_DGDE:A8","CH_GB18_A_38:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-02","text":"Negative Einheit verschiebt ihre Funktion von der Aufdeckung des Widerspruchs im Ding zur Erzeugung bleibenden Inhalts in der Erscheinung und zur Realität des Gesetzes.","refs":["CH_GB18_A_38:AS3","CH_GB18_DGDE:AS3","CH_GB18_BD_3:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-03","text":"Erscheinung mutiert von der objektiven Unhaltbarkeit des Dinges zur positiven Wahrheit der Existenz und wird schließlich zur selbstgesetzten Gegenwelt des Wesens.","refs":["CH_GB18_A_38:SD3","CH_GB18_DGDE:ME1","CH_GB18_BD_3:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-04","text":"Das Gesetz tritt zunächst als ruhiger Inhalt auf, wird dann als unzureichend gegenüber der Bewegungsform der Erscheinung bestimmt und erscheint schließlich als negative Totalität, die diese Bewegungsform in sich enthält.","refs":["CH_GB18_DGDE:AS4","CH_GB18_DGDE:NX7","CH_GB18_BD_3:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-05","text":"Das Andere wird von der räumlich äußerlichen Materie über das vermittelte Andere der Erscheinung zur Form der Selbstbeziehung einer Totalität transformiert.","refs":["CH_GB18_A_38:A3","CH_GB18_DGDE:A4","CH_GB18_BD_3:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-06","text":"Quantitative Verkleinerung, Porosität und Allmählichkeit verschwinden nach ihrer kritischen Funktion, weil sie als repräsentative Verschiebungen des Widerspruchs keine tragenden Bestimmungen der höheren Architektur bleiben.","refs":["CH_GB18_A_38:NX2","CH_GB18_A_38:NX3","CH_GB18_A_38:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-07","text":"Die Unterscheidung von sinnlicher und übersinnlicher Welt wird nicht stabilisiert, sondern in eine interne Umkehrungsstruktur einer einzigen reflektierten Existenz absorbiert.","refs":["CH_GB18_BD_3:NX5","CH_GB18_BD_3:NX6","CH_GB18_BD_3:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_48:CGD-01","text":"Die Analyse von Porosität, Kleinheit und Durchdringung bleibt lokal, insofern sie besondere Formen der Dingvorstellung betrifft; auf Clusterebene zählt nur ihre gemeinsame Funktion als Externalisierung und Verdeckung immanenter Negativität.","refs":["CH_GB18_A_38:NX2","CH_GB18_A_38:NX3","CH_GB18_A_38:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:CGD-02","text":"Die lokale Gegenüberstellung von Ding und Geist skaliert auf Clusterebene zu einem Kriterium realer Einheit: Unterschiede müssen als Momente bestehen, statt als Teilsubstanzen nebeneinander fortzubestehen.","refs":["CH_GB18_A_38:A10","CH_GB18_A_38:NX6","CH_GB18_DGDE:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:CGD-03","text":"Die Unvollständigkeit eines bestimmten Gesetzes bleibt lokal als Problem seiner äußerlichen Inhaltsverbindung; auf Clusterebene wird sie zum Übergangsmechanismus, durch den Gesetz in negative Totalität übergehen muss.","refs":["CH_GB18_DGDE:A12","CH_GB18_DGDE:A13","CH_GB18_BD_3:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:CGD-04","text":"Die übersinnliche Welt bleibt nicht ein zusätzlicher Gegenstandsbereich, sondern skaliert zur Gesamtbestimmung reflektierter Existenz, welche die sinnliche Welt in sich als eigenes Gegenmoment enthält.","refs":["CH_GB18_BD_3:D4","CH_GB18_BD_3:SD2","CH_GB18_BD_3:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:CGD-05","text":"Die konkreten Inhalte der Gesetzesseiten bleiben absichtlich unbestimmt; tragend ist allein die Form ihrer wechselseitigen Setzung, Negation und realen Identität.","refs":["CH_GB18_DGDE:A8","CH_GB18_BD_3:A5","CH_GB18_BD_3:NX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_48:GNX-01","text":"Ausgeschlossen wird ein Modell, in dem ein Gegenstand aus äußerlich verbundenen, selbständigen Bestandteilen besteht und seine Einheit als zusätzliche Eigenschaft erhält.","refs":["CH_GB18_A_38:NX1","CH_GB18_A_38:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GNX-02","text":"Ausgeschlossen wird jede quantitative Entschärfung des Widerspruchs, weil Verkleinerung, Verdünnung oder Unwahrnehmbarkeit die negative Struktur nur aus dem Begriff in die Anschauung verlagern.","refs":["CH_GB18_A_38:NX3","CH_GB18_A_38:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GNX-03","text":"Ausgeschlossen wird ein Grund, der als unabhängiges Erstes vor dem Begründeten liegt und von dessen Bewegung unberührt bleibt.","refs":["CH_GB18_DGDE:NX4","CH_GB18_DGDE:DNX2","CH_GB18_BD_3:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GNX-04","text":"Ausgeschlossen wird ein Gesetz, das zugleich bloße Regelmäßigkeit, ruhige Identität und vollendete Notwendigkeit sein könnte.","refs":["CH_GB18_DGDE:NX8","CH_GB18_DGDE:SNX3","CH_GB18_BD_3:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GNX-05","text":"Ausgeschlossen wird eine Zweiweltenordnung, in der Sinnliches und Übersinnliches als selbständige Reiche einander äußerlich gegenüberstehen.","refs":["CH_GB18_DGDE:NX6","CH_GB18_DGDE:SNX4","CH_GB18_BD_3:DNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_48:DBN-01","text":"Das System kann keine letzte unreflektierte Unmittelbarkeit zulassen, weil jede behauptete Unmittelbarkeit als gesetzte, vermittelte und negative Bestimmung rekonstruiert wird.","refs":["CH_GB18_DGDE:A1","CH_GB18_DGDE:DNX1","CH_GB18_BD_3:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:DBN-02","text":"Das System kann keine Identität ohne Negativität zulassen, weil positive Einheit nur als Resultat der Aufhebung, Entgegensetzung und Rückkehr ihrer Unterschiede bestimmt wird.","refs":["CH_GB18_DGDE:A6","CH_GB18_DGDE:SD2","CH_GB18_BD_3:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:DBN-03","text":"Das System kann keine Totalität ohne Selbstentzweiung zulassen, weil eine Totalität ohne eigene Erscheinung und Gegenwelt bloß abstrakte Einheit bliebe.","refs":["CH_GB18_BD_3:A9","CH_GB18_BD_3:A10","CH_GB18_BD_3:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:DBN-04","text":"Das System kann keine Wahrheit zulassen, die sich durch den Ausschluss der Erscheinung konstituiert; Wahrheit besteht vielmehr in der Aufnahme der Erscheinung als eigener negativer Form.","refs":["CH_GB18_DGDE:NX1","CH_GB18_DGDE:D5","CH_GB18_BD_3:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_48:BSA-01","text":"Nicht verfügbar ist eine positive Substanz, welche Einheit, Unterschied und Selbstständigkeit ohne gegenseitige Begrenzung, Negation oder Selbstaufhebung tragen könnte.","refs":["CH_GB18_A_38:SNX4","CH_GB18_A_38:SNX1","CH_GB18_BD_3:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSA-02","text":"Nicht verfügbar ist eine endgültige Gesetzlichkeit, die vollendete Notwendigkeit besäße, ohne ihre eigenen Seiten, ihre negative Form und ihre Selbstvermittlung zu enthalten.","refs":["CH_GB18_DGDE:A13","CH_GB18_DGDE:SD5","CH_GB18_DGDE:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSA-03","text":"Nicht verfügbar ist ein absolutes Außen der Totalität, denn jedes Andere wird als selbst reflektierte Existenz und damit als Moment der eigenen Selbstbeziehung bestimmt.","refs":["CH_GB18_BD_3:NX2","CH_GB18_BD_3:D1","CH_GB18_BD_3:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSA-04","text":"Ontologisch unstatthaft ist eine Wahrheit, die ohne Selbstumkehrung bestehen könnte; die höchste positive Bestimmung bleibt durch die Unmöglichkeit einer negationsfreien Endgestalt organisiert.","refs":["CH_GB18_BD_3:A11","CH_GB18_BD_3:SD4","CH_GB18_BD_3:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_48:XD-01","text":"Die Dingkritik und die Kritik des zunächst ruhigen Gesetzes sind zwei Gestalten desselben Einwands: Eine Einheit ist unwahr, sofern sie ihre Unterschiede als äußerlich selbständige oder nur unmittelbar verbundene Bestimmungen festhält.","refs":["CL_GB18_48:GA-02","CL_GB18_48:GA-04","CL_GB18_48:GA-05","CH_GB18_A_38:AS6","CH_GB18_DGDE:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_48:XD-02","text":"Die quantitative Entschärfung des Dingwiderspruchs und die bloß unmittelbare Gesetzesverbindung besitzen dieselbe strukturelle Funktion: Beide neutralisieren die Selbstvermittlung, statt sie aus dem Inhalt hervorgehen zu lassen.","refs":["CL_GB18_48:GA-05","CL_GB18_48:GA-10","CH_GB18_A_38:A7","CH_GB18_DGDE:A13"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_48:XD-03","text":"Erscheinung wird durch die Verbindung der Einheiten zur operativen Form, in der sich ontologischer Mangel in positive Vermittlung umkehrt: Der Zusammenbruch äußerlicher Selbstständigkeit wird zur Erzeugung eines wesentlichen Inhalts.","refs":["CL_GB18_48:GA-02","CL_GB18_48:GA-03","CL_GB18_48:GA-07","CH_GB18_A_38:SD3","CH_GB18_DGDE:D3","CH_GB18_BD_3:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_48:XD-04","text":"Die Einheit von Grund und Begründetem ist nicht bloß wechselseitig, sondern selbstproduktiv: Die Totalität setzt die Erscheinung, durch deren Negativität sie erst als deren Grund bestimmt wird.","refs":["CL_GB18_48:GA-01","CL_GB18_48:GA-06","CL_GB18_48:GA-07","CH_GB18_DGDE:SD1","CH_GB18_BD_3:D5","CH_GB18_BD_3:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_48:XD-05","text":"Das Übersinnliche bezeichnet keine Flucht aus der Erscheinung, sondern die Reflexionsform, in der Erscheinung ihren eigenen negativen Grund als immanente Totalität erkennt.","refs":["CL_GB18_48:GA-03","CL_GB18_48:GA-06","CL_GB18_48:GA-07","CH_GB18_BD_3:NX5","CH_GB18_BD_3:D4","CH_GB18_BD_3:ME3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_48:XD-06","text":"Die geistige Begriffseinheit bleibt als terminales Kriterium wirksam, doch ihre Ableitung aus Gesetz, Totalität und Weltumkehrung wird nicht vollständig vollzogen; sie ist Zielnorm der Architektur, nicht deren vollständig explizierter Endbeweis.","refs":["CL_GB18_48:GA-04","CL_GB18_48:GA-09","CH_GB18_A_38:SD5","CH_GB18_A_38:MRT5","CH_GB18_BD_3:MRT7"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_48:BSD-01","text":"Realität erscheint als System selbstvermittelnder Bestimmungen, nicht als Bestand unabhängiger Dinge, Gesetze oder Welten; das Reale ist die Fähigkeit einer Bestimmung, ihre eigene Negativität als Moment ihrer Wahrheit zu tragen.","refs":["CH_GB18_A_38:D8","CH_GB18_DGDE:MRT3","CH_GB18_BD_3:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSD-02","text":"Zeitlichkeit wird ontologisch umbestimmt: Dauer ist keine Unterbrechung des Wandels, sondern die positive Identität, die nur im Übergang, Vergehen und Wiederkehren der Bestimmungen besteht.","refs":["CH_GB18_DGDE:SD2","CH_GB18_DGDE:ALT4","CH_GB18_BD_3:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSD-03","text":"Erkenntnis wird nicht an der Wiederholung gegebener Regelmäßigkeiten gemessen, sondern daran, ob sie die negative Vermittlung freilegt, welche den Zusammenhang ihrer Inhalte notwendig macht.","refs":["CH_GB18_DGDE:D6","CH_GB18_DGDE:ME5","CH_GB18_DGDE:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSD-04","text":"Der Übergang vom Raum des Dinges zur reflektierten Welt ist kein Wechsel des Gegenstandsbereichs, sondern eine Umcodierung von Äußerlichkeit: Räumliches Nebeneinander wird als unzureichende Gestalt der Selbstbeziehung lesbar.","refs":["CH_GB18_A_38:ME2","CH_GB18_DGDE:ME2","CH_GB18_BD_3:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSD-05","text":"Die höchste Einheit des Systems ist keine harmonische Versöhnung, sondern eine reversible Totalität, deren Identität nur durch fortgesetzte Entgegensetzung und Umkehrung real bleibt.","refs":["CH_GB18_BD_3:A11","CH_GB18_BD_3:D7","CH_GB18_BD_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_48:RLE-01","text":"Die erste Schleife lautet: Verselbstständigung von Bestimmungen → gemeinsame Einheit → Durchdringung → gegenseitige Negation → Enthüllung der Erscheinung.","refs":["CH_GB18_A_38:AF1","CH_GB18_A_38:AF3","CH_GB18_A_38:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RLE-02","text":"Die zweite Schleife lautet: Erscheinung → wechselseitige Negation → positiver wesentlicher Inhalt → Gesetz → Unzulänglichkeit des zunächst ruhigen Gesetzes.","refs":["CH_GB18_DGDE:AF2","CH_GB18_DGDE:AF3","CH_GB18_DGDE:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RLE-03","text":"Die dritte Schleife lautet: negatives Gesetz → reale Identität → Totalität → Selbstsetzung der Erscheinung → Umkehrung von wesentlicher und erscheinender Welt.","refs":["CH_GB18_BD_3:AF3","CH_GB18_BD_3:AF4","CH_GB18_BD_3:AF6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RLE-04","text":"Negative Einheit ist der begriffliche Attraktor, weil jede stabile Gestalt des Systems erst durch die Aufnahme der Negation ihrer eigenen Seiten Realität gewinnt.","refs":["CH_GB18_A_38:ALT2","CH_GB18_BD_3:A6","CH_GB18_BD_3:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RLE-05","text":"Das Vorstellen bildet eine Gegen-Schleife: Es übersetzt Widerspruch in räumliche, quantitative oder empirische Bilder; die Architektur kehrt diese Übersetzungen um und gewinnt daraus die begriffliche Negativität zurück.","refs":["CH_GB18_A_38:AS4","CH_GB18_A_38:D4","CH_GB18_A_38:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_48:FGS-B01","text":"Gleiche Inhaltsbestimmung → Eigenschaft als reflektiertes Moment oder Materie als äußerlich selbstständige Einheit.","refs":["CH_GB18_A_38:FGS1","CH_GB18_A_38:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FGS-B02","text":"Äußerlich selbstständige Unterschiede + gemeinsame Einheit → Durchdringung → wechselseitige Negation → Ding als Erscheinung.","refs":["CH_GB18_A_38:FGS3","CH_GB18_A_38:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FGS-B03","text":"Erscheinung als eigenes Gesetztsein → Vermittlung durch anderes Gesetztsein → positive Identität der sich negierenden Unterschiede.","refs":["CH_GB18_DGDE:AF1","CH_GB18_DGDE:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FGS-B04","text":"Positive Identität der Erscheinung → Gesetz als bleibender Inhalt → Differenz zwischen ruhigem Inhalt und negativer Bewegungsform.","refs":["CH_GB18_DGDE:FGS4","CH_GB18_DGDE:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FGS-B05","text":"Unmittelbares Gesetz → fehlende Selbstvermittlung → Aufnahme seiner Negativität → Gesetz als reale Totalität.","refs":["CH_GB18_DGDE:FGS6","CH_GB18_BD_3:D2","CH_GB18_BD_3:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FGS-B06","text":"Reale Totalität → Selbstsetzung ihrer Erscheinung → Gegenüberstellung von wesentlicher und erscheinender Welt → Umkehrung als reale Identität.","refs":["CH_GB18_BD_3:FGS5","CH_GB18_BD_3:FGS6","CH_GB18_BD_3:AF7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_48:AFM-B01","text":"Äußerliche Verselbstständigung derselben Inhaltsbestimmungen erzeugt den Schein eines stabilen Dinges.","refs":["CH_GB18_A_38:AF1","CH_GB18_A_38:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:AFM-B02","text":"Gemeinsame Dingheit erzwingt Durchdringung und enthüllt die Selbstnegation der als selbstständig behaupteten Unterschiede.","refs":["CH_GB18_A_38:AF3","CH_GB18_A_38:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:AFM-B03","text":"Die Aufdeckung dieser Selbstnegation reklassifiziert das Ding als Erscheinung und die Existenz als reflektierte Unmittelbarkeit.","refs":["CH_GB18_A_38:AF5","CH_GB18_DGDE:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:AFM-B04","text":"Die wechselseitige Negation der Erscheinung erzeugt einen bleibenden Inhalt, der als Gesetz ihrer positiven Identität bestimmt wird.","refs":["CH_GB18_DGDE:AS3","CH_GB18_DGDE:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:AFM-B05","text":"Das Gesetz wird durch seine zunächst äußerliche Verbindung begrenzt und muss seine negative Form in sich aufnehmen, um reale Notwendigkeit zu gewinnen.","refs":["CH_GB18_DGDE:AS6","CH_GB18_DGDE:A13","CH_GB18_BD_3:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:AFM-B06","text":"Das real gewordene Gesetz wird zur Totalität reflektierter Existenz, die sich selbst als erscheinende Welt setzt und ihre Identität als Umkehrung vollzieht.","refs":["CH_GB18_BD_3:A7","CH_GB18_BD_3:A10","CH_GB18_BD_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_48:MME-01","text":"Dingheit wird von einer stabilen Trägersubstanz zu einer Übergangsform umkartiert, in der Einheit und Selbstständigkeit nur als Selbstaufhebung zusammenbestehen.","refs":["CH_GB18_A_38:SD1","CH_GB18_A_38:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MME-02","text":"Erscheinung wird von einer defizitären Scheinform zur höheren Wahrheit der unmittelbaren Existenz und zum Ort ihrer immanenten Vermittlung umklassifiziert.","refs":["CH_GB18_DGDE:NX1","CH_GB18_DGDE:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MME-03","text":"Gesetz wird von einer über der Welt stehenden Regel zu einer immanenten, aber nur durch Negativität realen Totalitätsform reklassifiziert.","refs":["CH_GB18_DGDE:ME3","CH_GB18_BD_3:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MME-04","text":"Grund wird von einer einseitigen Begründungsrelation zu einer Selbstsetzungsstruktur transformiert, in der Grund und Begründetes sich wechselseitig bestimmen.","refs":["CH_GB18_DGDE:ME2","CH_GB18_BD_3:SD3","CH_GB18_BD_3:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MME-05","text":"Die Opposition von Sinnlichem und Übersinnlichem verliert ihren topologischen Charakter und wird als interne Reflexions- und Umkehrungsstruktur einer einzigen Totalität lesbar.","refs":["CH_GB18_BD_3:NX6","CH_GB18_BD_3:ME3","CH_GB18_BD_3:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_48:ALT-B01","text":"Surface level — Das System behandelt Ding, Materie, Gesetz, Erscheinung, wesentliche Welt und Geist als explizite Gegenstände einer fortschreitenden Reflexionsanalyse.","refs":["CH_GB18_A_38:ALT1","CH_GB18_DGDE:ALT1","CH_GB18_BD_3:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:ALT-B02","text":"Structural level — Alle Gegenstände werden als Formen negativer Einheit bestimmt, in denen Selbstständigkeit, Gesetztsein, Grund und Identität nur durch wechselseitige Vermittlung bestehen.","refs":["CH_GB18_A_38:ALT2","CH_GB18_DGDE:ALT2","CH_GB18_BD_3:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:ALT-B03","text":"Metastrategic level — Die Analyse ersetzt die Feststellung gegebener Gegenstände oder Gesetze durch die Prüfung, ob ihre behauptete Einheit die eigene Negativität begrifflich tragen kann.","refs":["CH_GB18_A_38:ALT3","CH_GB18_DGDE:ALT3","CH_GB18_BD_3:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:ALT-B04","text":"Ontological / Temporal level — Realität wird als Werden, Übergehen, Selbstentzweiung und Rückkehr bestimmt; Dauer ist die im Wandel erzeugte Identität, nicht dessen Negation.","refs":["CH_GB18_DGDE:ALT4","CH_GB18_BD_3:ALT4","CH_GB18_BD_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem jede positive Bestimmung als unzureichend erscheint, ihre Grenze freilegt und nur durch die Aufnahme dieser Grenze in eine höhere Form übergeht.","refs":["CH_GB18_DGDE:AS7","CH_GB18_DGDE:MRT7","CH_GB18_BD_3:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_48:FL-01","text":"Das Gesetz ist zugleich immanenter wesentlicher Inhalt der Erscheinung und gegenüber deren negativer Bewegungsform unvollständig; die Immanenz wird daher behauptet, ohne schon vollständige Realisierung zu sein.","refs":["CH_GB18_DGDE:A10","CH_GB18_DGDE:NX7","CH_GB18_DGDE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FL-02","text":"Die an-und-für-sich-seyende Welt soll Totalität ohne äußeres Anderes sein und zugleich als Seite gegenüber der erscheinenden Welt bestehen; diese Doppelstellung verlangt Umkehrung, verhindert aber eine ruhende Schließung.","refs":["CH_GB18_BD_3:A9","CH_GB18_BD_3:A11","CH_GB18_BD_3:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FL-03","text":"Die Begriffseinheit des Geistes beendet die Dinglogik normativ, aber die Vermittlung vom widersprüchlichen Ding zur nichtdinglichen Begriffseinheit bleibt innerhalb des bereitgestellten Materials nicht vollständig entwickelt.","refs":["CH_GB18_A_38:SD5","CH_GB18_A_38:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MP-01","text":"Negative Einheit mutiert von der widersprüchlichen Koexistenz dinglicher Materien zur produktiven Form gesetzlicher Realität; dieselbe Bestimmung wechselt damit von destruktiver Diagnose zu generativem Prinzip.","refs":["CH_GB18_A_38:A6","CH_GB18_BD_3:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MP-02","text":"Erscheinung kehrt ihre Valenz um: Was zunächst die objektive Unhaltbarkeit des Dinges bezeichnet, wird zur Wahrheit reflektierter Existenz und zur Bedingung der wesentlichen Welt.","refs":["CH_GB18_A_38:SD3","CH_GB18_DGDE:ME1","CH_GB18_BD_3:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MP-03","text":"Das Gesetz mutiert von positiver Ruhe zu negativer Totalität, wodurch seine frühere Unvollständigkeit nicht beseitigt, sondern als notwendiger Durchgangspunkt seiner Realisierung absorbiert wird.","refs":["CH_GB18_DGDE:AS5","CH_GB18_DGDE:SD5","CH_GB18_BD_3:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MP-04","text":"Der Grund mutiert von einer scheinbar vorausliegenden Beziehung zu einer Selbstsetzung, in der das Begründete die Form seines eigenen Grundes mit erzeugt.","refs":["CH_GB18_DGDE:A5","CH_GB18_BD_3:D5","CH_GB18_BD_3:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_48:HSI-01","text":"Die Realität erscheint als Maschine negativer Selbstvermittlung, in der keine Bestimmung durch bloßes Beharren besteht, sondern jede Form nur durch die Aufnahme ihres eigenen Nichtbestehens real wird.","refs":["CH_GB18_BD_3:A3","CH_GB18_BD_3:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:HSI-02","text":"Das Subjekt erscheint nicht als äußerer Beobachter dieser Maschine, sondern im Grenzbild des Geistes als Einheit, deren Unterschiede bereits als innere Momente und nicht als selbständige Dinge organisiert sind.","refs":["CH_GB18_A_38:A9","CH_GB18_A_38:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:HSI-03","text":"Zeit ist die Form, in der Identität sich durch Vergehen, Übergang und Wiederkehr erzeugt; sie ist keine äußere Abfolge, die einer fertigen Substanz widerfährt.","refs":["CH_GB18_DGDE:SD2","CH_GB18_DGDE:ALT4","CH_GB18_BD_3:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:HSI-04","text":"Möglich bleibt keine Flucht aus Negativität, sondern nur Navigation durch ihre Formen: äußere Selbstständigkeit muss in reflektierte Beziehung, ruhige Gesetzlichkeit in reale Notwendigkeit und Welttrennung in Umkehrung überführt werden.","refs":["CH_GB18_A_38:SD5","CH_GB18_DGDE:SD5","CH_GB18_BD_3:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_48:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Gesamtbewegung von äußerlicher Dingheit über Erscheinung und Gesetz zur negativen Totalität und Umkehrung der Welten zu rekonstruieren.","refs":["CH_GB18_A_38:MRT1","CH_GB18_DGDE:MRT1","CH_GB18_BD_3:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MRT-B02","text":"Unterbestimmt bleibt die konkrete Vermittlung, durch welche negative Einheit als an den Gesetzesseiten real gesetzt gilt, sowie die positive Ausarbeitung des Übergangs zur Begriffseinheit des Geistes.","refs":["CH_GB18_A_38:MRT2","CH_GB18_DGDE:MRT2","CH_GB18_BD_3:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MRT-B03","text":"Die Architektur ist kohärent, sofern Identität niemals als negationsfreie Unmittelbarkeit gelesen wird, sondern als Resultat und Vollzug ihrer eigenen Vermittlung.","refs":["CH_GB18_A_38:MRT3","CH_GB18_DGDE:MRT3","CH_GB18_BD_3:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MRT-B04","text":"Die stärkste Rekonstruktionsleistung liegt in der wiederholten Umkehrung, durch welche Widerspruch nicht als Defekt entfernt, sondern als Generator von Inhalt, Gesetz, Totalität und Weltbeziehung bestimmt wird.","refs":["CH_GB18_A_38:MRT4","CH_GB18_DGDE:MRT4","CH_GB18_BD_3:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MRT-B05","text":"Unverzichtbar für die Rekonstruktion bleibt die Sequenzierung der Übergänge, weil der Sinn von Erscheinung, Gesetz, Wesen und Umkehrung nicht in isolierten Definitionen, sondern in ihrer rekursiven Mutation liegt.","refs":["CH_GB18_A_38:MRT6","CH_GB18_DGDE:MRT7","CH_GB18_BD_3:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122756768968Z_91fa8da8","language_code":"en","language_name":"English","title":"Chapters 142–144","source_sha256":"54fed5b86d77a1ad7a2f394c756e251f9fe382f49b1611e11d3102f969d4fc1c","sha256":"6b27de55ce0298abca7be624fd89957360b0de98550e734b20f6588c081a1ca8","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:27:56.770585+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_48:BAS-01","text":"The system determines truth as the immanent self-mediation of that which initially appears as an independent thing, immediate existence, or tranquil law.","refs":["CH_GB18_A_38:AS6","CH_GB18_DGDE:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-02","text":"Its movement begins with the external autonomization of identical determinations of content, shows their necessary negation, and transfers this negation into a positive, though initially incomplete, identity.","refs":["CH_GB18_A_38:AS1","CH_GB18_DGDE:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-03","text":"The law arises as stabilization of appearance, but can claim truth only by taking up the negative movement that it initially leaves behind as the mere form of appearance.","refs":["CH_GB18_DGDE:A9","CH_GB18_DGDE:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-04","text":"The essential or being-in-and-for-itself world is not attained as a transcendent realm, but produced as the result of the self-reflection of appearance and its lawfulness.","refs":["CH_GB18_BD_3:D4","CH_GB18_BD_3:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-05","text":"The directed movement is recursive: autonomization produces negation, negation produces identity, identity externalizes itself anew and becomes real only through its return into negativity.","refs":["CH_GB18_A_38:A6","CH_GB18_BD_3:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-06","text":"External explanation through matters, quantitative diminution, a separate world of laws, or an independent ground is dismantled as a recurrent avoidance of immanent negativity.","refs":["CH_GB18_A_38:A7","CH_GB18_DGDE:NX4","CH_GB18_DGDE:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-07","text":"Closure consists not in a resting substance, but in a totality that holds its differences within itself only through self-division, inversion, and transition.","refs":["CH_GB18_BD_3:A10","CH_GB18_BD_3:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BAS-08","text":"Spirit functions as the limiting figure of this architecture, because it designates that unity in which differences no longer exist as independent things, but as moments of a conceptual unity.","refs":["CH_GB18_A_38:A9","CH_GB18_A_38:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_48:GA-01","text":"[Persistent] Independence is at this level not antecedent independence, but a form of subsistence possible only through its relation to other subsistence and thus through its own negation.","refs":["CH_GB18_A_38:A8","CH_GB18_DGDE:A4","CH_GB18_BD_3:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-02","text":"[Mutating] Negative unity first appears as the destructive interpenetration of independent matters, then as productive mediation of appearance, and finally as the real unity of the sides of the law.","refs":["CH_GB18_A_38:A6","CH_GB18_DGDE:A6","CH_GB18_BD_3:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-03","text":"[Persistent] Appearance is not a lack of reality, but the truth of an existence whose immediacy is explicated as its own positedness and as mediated negativity.","refs":["CH_GB18_A_38:AS6","CH_GB18_DGDE:A2","CH_GB18_BD_3:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-04","text":"[Attractor] Differences attain truth only if they neither disintegrate into external indifference nor disappear into undifferentiated unity, but exist as mutually posited moments.","refs":["CH_GB18_A_38:A10","CH_GB18_DGDE:A8","CH_GB18_BD_3:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-05","text":"[Mutating] The law is initially the tranquil positive identity of appearance, but becomes real only when its own negativity, opposition, and self-mediation are incorporated into its content.","refs":["CH_GB18_DGDE:A9","CH_GB18_DGDE:A13","CH_GB18_BD_3:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-06","text":"[Persistent] Ground, law, and essence cannot exist as independent firsts prior to their relations, because they are determined only as reflected functions of that which they ground.","refs":["CH_GB18_DGDE:A5","CH_GB18_DGDE:SD1","CH_GB18_BD_3:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-07","text":"[Emergent] Ontological hierarchy arises not through the primacy of a finished essence over a less-real appearance, but through the self-negation of appearance into a totality encompassing it.","refs":["CH_GB18_BD_3:D3","CH_GB18_BD_3:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-08","text":"[Attractor] Real identity is possible only as sustained self-opposition; it is neither immediate equality nor the effacement of difference.","refs":["CH_GB18_DGDE:SD2","CH_GB18_BD_3:A11","CH_GB18_BD_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-09","text":"[Terminal] The conceptual unity of spirit marks the limiting form in which the thing-like independence of differences is withdrawn into dependent moments.","refs":["CH_GB18_A_38:A9","CH_GB18_A_38:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GA-10","text":"[Mutating] Necessity is not repeatability or immediate lawful connection, but the negativity operative in the content itself, through which determinations pass over into one another.","refs":["CH_GB18_DGDE:A13","CH_GB18_DGDE:NX8","CH_GB18_BD_3:D2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_48:RMD-01","text":"The determination of the same side of content recurs as property, matter, lawful side, and conceptual moment; its identity remains preserved in content, while its form mutates from external independence to immanent mediation.","refs":["CH_GB18_A_38:A1","CH_GB18_DGDE:A8","CH_GB18_A_38:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-02","text":"Negative unity shifts its function from disclosing contradiction in the thing to producing enduring content in appearance and to the reality of the law.","refs":["CH_GB18_A_38:AS3","CH_GB18_DGDE:AS3","CH_GB18_BD_3:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-03","text":"Appearance mutates from the objective untenability of the thing into the positive truth of existence and finally becomes the self-posited counterworld of essence.","refs":["CH_GB18_A_38:SD3","CH_GB18_DGDE:ME1","CH_GB18_BD_3:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-04","text":"The law first appears as tranquil content, is then determined as inadequate in relation to the form of movement of appearance, and finally appears as negative totality containing this form of movement within itself.","refs":["CH_GB18_DGDE:AS4","CH_GB18_DGDE:NX7","CH_GB18_BD_3:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-05","text":"The other is transformed from spatially external matter, through the mediated other of appearance, into the form of the self-relation of a totality.","refs":["CH_GB18_A_38:A3","CH_GB18_DGDE:A4","CH_GB18_BD_3:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-06","text":"Quantitative diminution, porosity, and gradualness disappear after their critical function, because as representational displacements of contradiction they do not remain load-bearing determinations of the higher architecture.","refs":["CH_GB18_A_38:NX2","CH_GB18_A_38:NX3","CH_GB18_A_38:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RMD-07","text":"The distinction between the sensible and supersensible world is not stabilized, but absorbed into an internal structure of inversion within a single reflected existence.","refs":["CH_GB18_BD_3:NX5","CH_GB18_BD_3:NX6","CH_GB18_BD_3:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_48:CGD-01","text":"The analysis of porosity, smallness, and interpenetration remains local insofar as it concerns particular forms of the representation of the thing; at the cluster level, only their common function as externalization and concealment of immanent negativity counts.","refs":["CH_GB18_A_38:NX2","CH_GB18_A_38:NX3","CH_GB18_A_38:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:CGD-02","text":"The local opposition of thing and spirit scales at the cluster level into a criterion of real unity: differences must exist as moments rather than continue to subsist alongside one another as partial substances.","refs":["CH_GB18_A_38:A10","CH_GB18_A_38:NX6","CH_GB18_DGDE:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:CGD-03","text":"The incompleteness of a determinate law remains locally a problem of its external connection of content; at the cluster level, it becomes the transitional mechanism through which law must pass into negative totality.","refs":["CH_GB18_DGDE:A12","CH_GB18_DGDE:A13","CH_GB18_BD_3:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:CGD-04","text":"The supersensible world does not remain an additional domain of objects, but scales into the total determination of reflected existence, which contains the sensible world within itself as its own counter-moment.","refs":["CH_GB18_BD_3:D4","CH_GB18_BD_3:SD2","CH_GB18_BD_3:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:CGD-05","text":"The concrete contents of the sides of the law remain deliberately indeterminate; only the form of their mutual positing, negation, and real identity is load-bearing.","refs":["CH_GB18_DGDE:A8","CH_GB18_BD_3:A5","CH_GB18_BD_3:NX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_48:GNX-01","text":"Excluded is a model in which an object consists of externally connected, independent components and receives its unity as an additional property.","refs":["CH_GB18_A_38:NX1","CH_GB18_A_38:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GNX-02","text":"Excluded is every quantitative attenuation of contradiction, because diminution, rarefaction, or imperceptibility merely displace the negative structure from the concept into intuition.","refs":["CH_GB18_A_38:NX3","CH_GB18_A_38:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GNX-03","text":"Excluded is a ground that lies as an independent first prior to what is grounded and remains unaffected by its movement.","refs":["CH_GB18_DGDE:NX4","CH_GB18_DGDE:DNX2","CH_GB18_BD_3:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GNX-04","text":"Excluded is a law that could simultaneously be mere regularity, tranquil identity, and completed necessity.","refs":["CH_GB18_DGDE:NX8","CH_GB18_DGDE:SNX3","CH_GB18_BD_3:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:GNX-05","text":"Excluded is a two-world order in which the sensible and supersensible stand externally opposed to one another as independent realms.","refs":["CH_GB18_DGDE:NX6","CH_GB18_DGDE:SNX4","CH_GB18_BD_3:DNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_48:DBN-01","text":"The system cannot permit a final unreflected immediacy, because every asserted immediacy is reconstructed as a posited, mediated, and negative determination.","refs":["CH_GB18_DGDE:A1","CH_GB18_DGDE:DNX1","CH_GB18_BD_3:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:DBN-02","text":"The system cannot permit identity without negativity, because positive unity is determined only as the result of the sublation, opposition, and return of its differences.","refs":["CH_GB18_DGDE:A6","CH_GB18_DGDE:SD2","CH_GB18_BD_3:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:DBN-03","text":"The system cannot permit totality without self-division, because a totality without its own appearance and counterworld would remain merely abstract unity.","refs":["CH_GB18_BD_3:A9","CH_GB18_BD_3:A10","CH_GB18_BD_3:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:DBN-04","text":"The system cannot permit a truth that constitutes itself through the exclusion of appearance; truth consists rather in the incorporation of appearance as its own negative form.","refs":["CH_GB18_DGDE:NX1","CH_GB18_DGDE:D5","CH_GB18_BD_3:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_48:BSA-01","text":"Unavailable is a positive substance that could sustain unity, difference, and independence without reciprocal limitation, negation, or self-sublation.","refs":["CH_GB18_A_38:SNX4","CH_GB18_A_38:SNX1","CH_GB18_BD_3:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSA-02","text":"Unavailable is a final lawfulness that would possess completed necessity without containing its own sides, its negative form, and its self-mediation.","refs":["CH_GB18_DGDE:A13","CH_GB18_DGDE:SD5","CH_GB18_DGDE:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSA-03","text":"Unavailable is an absolute outside of totality, for every other is determined as self-reflected existence and thus as a moment of its own self-relation.","refs":["CH_GB18_BD_3:NX2","CH_GB18_BD_3:D1","CH_GB18_BD_3:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSA-04","text":"Ontologically inadmissible is a truth that could subsist without self-inversion; the highest positive determination remains organized by the impossibility of a final form free of negation.","refs":["CH_GB18_BD_3:A11","CH_GB18_BD_3:SD4","CH_GB18_BD_3:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_48:XD-01","text":"The critique of the thing and the critique of the initially tranquil law are two forms of the same objection: a unity is untrue insofar as it holds fast to its differences as externally independent or merely immediately connected determinations.","refs":["CL_GB18_48:GA-02","CL_GB18_48:GA-04","CL_GB18_48:GA-05","CH_GB18_A_38:AS6","CH_GB18_DGDE:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_48:XD-02","text":"The quantitative attenuation of the contradiction of the thing and the merely immediate connection of law have the same structural function: both neutralize self-mediation instead of allowing it to emerge from content.","refs":["CL_GB18_48:GA-05","CL_GB18_48:GA-10","CH_GB18_A_38:A7","CH_GB18_DGDE:A13"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_48:XD-03","text":"Through the connection of the units, appearance becomes the operative form in which ontological deficiency reverses into positive mediation: the collapse of external independence becomes the production of essential content.","refs":["CL_GB18_48:GA-02","CL_GB18_48:GA-03","CL_GB18_48:GA-07","CH_GB18_A_38:SD3","CH_GB18_DGDE:D3","CH_GB18_BD_3:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_48:XD-04","text":"The unity of ground and grounded is not merely reciprocal, but self-productive: totality posits appearance, through whose negativity it is first determined as its ground.","refs":["CL_GB18_48:GA-01","CL_GB18_48:GA-06","CL_GB18_48:GA-07","CH_GB18_DGDE:SD1","CH_GB18_BD_3:D5","CH_GB18_BD_3:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_48:XD-05","text":"The supersensible designates no flight from appearance, but the form of reflection in which appearance recognizes its own negative ground as immanent totality.","refs":["CL_GB18_48:GA-03","CL_GB18_48:GA-06","CL_GB18_48:GA-07","CH_GB18_BD_3:NX5","CH_GB18_BD_3:D4","CH_GB18_BD_3:ME3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_48:XD-06","text":"The spiritual conceptual unity remains effective as a terminal criterion, yet its derivation from law, totality, and the inversion of worlds is not fully carried out; it is the architectural norm of aim, not its fully explicated final proof.","refs":["CL_GB18_48:GA-04","CL_GB18_48:GA-09","CH_GB18_A_38:SD5","CH_GB18_A_38:MRT5","CH_GB18_BD_3:MRT7"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_48:BSD-01","text":"Reality appears as a system of self-mediating determinations, not as a stock of independent things, laws, or worlds; the real is the capacity of a determination to sustain its own negativity as a moment of its truth.","refs":["CH_GB18_A_38:D8","CH_GB18_DGDE:MRT3","CH_GB18_BD_3:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSD-02","text":"Temporality is ontologically redefined: duration is not an interruption of change, but the positive identity that exists only in the transition, passing-away, and recurrence of determinations.","refs":["CH_GB18_DGDE:SD2","CH_GB18_DGDE:ALT4","CH_GB18_BD_3:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSD-03","text":"Cognition is measured not by the repetition of given regularities, but by whether it discloses the negative mediation that makes the connection of its contents necessary.","refs":["CH_GB18_DGDE:D6","CH_GB18_DGDE:ME5","CH_GB18_DGDE:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSD-04","text":"The transition from the space of the thing to the reflected world is not a change of domain of objects, but a recoding of externality: spatial juxtaposition becomes legible as an inadequate form of self-relation.","refs":["CH_GB18_A_38:ME2","CH_GB18_DGDE:ME2","CH_GB18_BD_3:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:BSD-05","text":"The highest unity of the system is not a harmonious reconciliation, but a reversible totality whose identity remains real only through continued opposition and inversion.","refs":["CH_GB18_BD_3:A11","CH_GB18_BD_3:D7","CH_GB18_BD_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_48:RLE-01","text":"The first loop is: autonomization of determinations → common unity → interpenetration → mutual negation → disclosure of appearance.","refs":["CH_GB18_A_38:AF1","CH_GB18_A_38:AF3","CH_GB18_A_38:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RLE-02","text":"The second loop is: appearance → mutual negation → positive essential content → law → inadequacy of the initially tranquil law.","refs":["CH_GB18_DGDE:AF2","CH_GB18_DGDE:AF3","CH_GB18_DGDE:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RLE-03","text":"The third loop is: negative law → real identity → totality → self-positing of appearance → inversion of the essential and appearing world.","refs":["CH_GB18_BD_3:AF3","CH_GB18_BD_3:AF4","CH_GB18_BD_3:AF6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RLE-04","text":"Negative unity is the conceptual attractor, because every stable form of the system first gains reality through incorporating the negation of its own sides.","refs":["CH_GB18_A_38:ALT2","CH_GB18_BD_3:A6","CH_GB18_BD_3:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:RLE-05","text":"Representation forms a counter-loop: it translates contradiction into spatial, quantitative, or empirical images; the architecture reverses these translations and thereby recovers conceptual negativity.","refs":["CH_GB18_A_38:AS4","CH_GB18_A_38:D4","CH_GB18_A_38:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_48:FGS-B01","text":"Identical determination of content → property as reflected moment or matter as externally independent unity.","refs":["CH_GB18_A_38:FGS1","CH_GB18_A_38:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FGS-B02","text":"Externally independent differences + common unity → interpenetration → mutual negation → thing as appearance.","refs":["CH_GB18_A_38:FGS3","CH_GB18_A_38:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FGS-B03","text":"Appearance as its own positedness → mediation through other positedness → positive identity of the self-negating differences.","refs":["CH_GB18_DGDE:AF1","CH_GB18_DGDE:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FGS-B04","text":"Positive identity of appearance → law as enduring content → difference between tranquil content and negative form of movement.","refs":["CH_GB18_DGDE:FGS4","CH_GB18_DGDE:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FGS-B05","text":"Immediate law → absent self-mediation → incorporation of its negativity → law as real totality.","refs":["CH_GB18_DGDE:FGS6","CH_GB18_BD_3:D2","CH_GB18_BD_3:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FGS-B06","text":"Real totality → self-positing of its appearance → opposition of essential and appearing world → inversion as real identity.","refs":["CH_GB18_BD_3:FGS5","CH_GB18_BD_3:FGS6","CH_GB18_BD_3:AF7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_48:AFM-B01","text":"External autonomization of the same determinations of content produces the semblance of a stable thing.","refs":["CH_GB18_A_38:AF1","CH_GB18_A_38:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:AFM-B02","text":"Common thinghood compels interpenetration and discloses the self-negation of differences asserted as independent.","refs":["CH_GB18_A_38:AF3","CH_GB18_A_38:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:AFM-B03","text":"The disclosure of this self-negation reclassifies the thing as appearance and existence as reflected immediacy.","refs":["CH_GB18_A_38:AF5","CH_GB18_DGDE:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:AFM-B04","text":"The mutual negation of appearance produces an enduring content, determined as the law of its positive identity.","refs":["CH_GB18_DGDE:AS3","CH_GB18_DGDE:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:AFM-B05","text":"The law is limited by its initially external connection and must incorporate its negative form in order to acquire real necessity.","refs":["CH_GB18_DGDE:AS6","CH_GB18_DGDE:A13","CH_GB18_BD_3:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:AFM-B06","text":"The law that has become real becomes the totality of reflected existence, which posits itself as appearing world and realizes its identity as inversion.","refs":["CH_GB18_BD_3:A7","CH_GB18_BD_3:A10","CH_GB18_BD_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_48:MME-01","text":"Thinghood is remapped from a stable bearer-substance to a transitional form in which unity and independence coexist only as self-sublation.","refs":["CH_GB18_A_38:SD1","CH_GB18_A_38:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MME-02","text":"Appearance is reclassified from a deficient form of semblance to the higher truth of immediate existence and the site of its immanent mediation.","refs":["CH_GB18_DGDE:NX1","CH_GB18_DGDE:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MME-03","text":"Law is reclassified from a rule standing above the world to an immanent form of totality that is real only through negativity.","refs":["CH_GB18_DGDE:ME3","CH_GB18_BD_3:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MME-04","text":"Ground is transformed from a one-sided relation of grounding into a structure of self-positing in which ground and grounded determine each other mutually.","refs":["CH_GB18_DGDE:ME2","CH_GB18_BD_3:SD3","CH_GB18_BD_3:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MME-05","text":"The opposition of the sensible and supersensible loses its topological character and becomes legible as the internal structure of reflection and inversion of a single totality.","refs":["CH_GB18_BD_3:NX6","CH_GB18_BD_3:ME3","CH_GB18_BD_3:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_48:ALT-B01","text":"Surface level — The system treats thing, matter, law, appearance, essential world, and spirit as explicit objects of a progressive analysis of reflection.","refs":["CH_GB18_A_38:ALT1","CH_GB18_DGDE:ALT1","CH_GB18_BD_3:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:ALT-B02","text":"Structural level — All objects are determined as forms of negative unity, in which independence, positedness, ground, and identity exist only through mutual mediation.","refs":["CH_GB18_A_38:ALT2","CH_GB18_DGDE:ALT2","CH_GB18_BD_3:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:ALT-B03","text":"Metastrategic level — The analysis replaces the assertion of given objects or laws with the examination of whether their asserted unity can conceptually sustain its own negativity.","refs":["CH_GB18_A_38:ALT3","CH_GB18_DGDE:ALT3","CH_GB18_BD_3:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:ALT-B04","text":"Ontological / Temporal level — Reality is determined as becoming, transition, self-division, and return; duration is the identity produced in change, not its negation.","refs":["CH_GB18_DGDE:ALT4","CH_GB18_BD_3:ALT4","CH_GB18_BD_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:ALT-B05","text":"Methodological / Performative level — The exposition enacts its thesis by allowing every positive determination to appear as inadequate, disclose its limit, and pass into a higher form only through incorporating this limit.","refs":["CH_GB18_DGDE:AS7","CH_GB18_DGDE:MRT7","CH_GB18_BD_3:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_48:FL-01","text":"The law is at once the immanent essential content of appearance and incomplete in relation to its negative form of movement; immanence is therefore asserted without yet being complete realization.","refs":["CH_GB18_DGDE:A10","CH_GB18_DGDE:NX7","CH_GB18_DGDE:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FL-02","text":"The being-in-and-for-itself world is to be totality without an external other and yet to exist as a side over against the appearing world; this double status requires inversion, but prevents resting closure.","refs":["CH_GB18_BD_3:A9","CH_GB18_BD_3:A11","CH_GB18_BD_3:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:FL-03","text":"The conceptual unity of spirit normatively ends the logic of the thing, but the mediation from the contradictory thing to non-thing-like conceptual unity remains not fully developed within the material provided.","refs":["CH_GB18_A_38:SD5","CH_GB18_A_38:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MP-01","text":"Negative unity mutates from the contradictory coexistence of thing-like matters into the productive form of lawful reality; the same determination thereby changes from destructive diagnosis to generative principle.","refs":["CH_GB18_A_38:A6","CH_GB18_BD_3:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MP-02","text":"Appearance reverses its valence: what initially designates the objective untenability of the thing becomes the truth of reflected existence and the condition of the essential world.","refs":["CH_GB18_A_38:SD3","CH_GB18_DGDE:ME1","CH_GB18_BD_3:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MP-03","text":"The law mutates from positive repose into negative totality, whereby its former incompleteness is not eliminated, but absorbed as a necessary passage-point of its realization.","refs":["CH_GB18_DGDE:AS5","CH_GB18_DGDE:SD5","CH_GB18_BD_3:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MP-04","text":"Ground mutates from an apparently antecedent relation into a self-positing in which the grounded co-produces the form of its own ground.","refs":["CH_GB18_DGDE:A5","CH_GB18_BD_3:D5","CH_GB18_BD_3:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_48:HSI-01","text":"Reality appears as a machine of negative self-mediation, in which no determination subsists through mere persistence, but every form becomes real only by incorporating its own non-being.","refs":["CH_GB18_BD_3:A3","CH_GB18_BD_3:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:HSI-02","text":"The subject appears not as an external observer of this machine, but in the limiting image of spirit as a unity whose differences are already organized as inner moments and not as independent things.","refs":["CH_GB18_A_38:A9","CH_GB18_A_38:D8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:HSI-03","text":"Time is the form in which identity produces itself through passing-away, transition, and return; it is not an external succession that happens to a finished substance.","refs":["CH_GB18_DGDE:SD2","CH_GB18_DGDE:ALT4","CH_GB18_BD_3:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:HSI-04","text":"No flight from negativity remains possible, but only navigation through its forms: external independence must be transferred into reflected relation, tranquil lawfulness into real necessity, and separation of worlds into inversion.","refs":["CH_GB18_A_38:SD5","CH_GB18_DGDE:SD5","CH_GB18_BD_3:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_48:MRT-B01","text":"The extracted axioms suffice to reconstruct the overall movement from external thinghood through appearance and law to negative totality and inversion of the worlds.","refs":["CH_GB18_A_38:MRT1","CH_GB18_DGDE:MRT1","CH_GB18_BD_3:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MRT-B02","text":"What remains underdetermined is the concrete mediation through which negative unity counts as really posited in the sides of the law, as well as the positive elaboration of the transition to the conceptual unity of spirit.","refs":["CH_GB18_A_38:MRT2","CH_GB18_DGDE:MRT2","CH_GB18_BD_3:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MRT-B03","text":"The architecture is coherent insofar as identity is never read as immediacy free of negation, but as the result and enactment of its own mediation.","refs":["CH_GB18_A_38:MRT3","CH_GB18_DGDE:MRT3","CH_GB18_BD_3:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MRT-B04","text":"The strongest reconstructive achievement lies in repeated inversion, through which contradiction is determined not as a defect to be removed, but as the generator of content, law, totality, and world-relation.","refs":["CH_GB18_A_38:MRT4","CH_GB18_DGDE:MRT4","CH_GB18_BD_3:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_48:MRT-B05","text":"Indispensable for reconstruction remains the sequencing of transitions, because the meaning of appearance, law, essence, and inversion lies not in isolated definitions, but in their recursive mutation.","refs":["CH_GB18_A_38:MRT6","CH_GB18_DGDE:MRT7","CH_GB18_BD_3:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_48@R001","source_variant_id":"canonical:CL_GB18_48:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 142–144","context":"Anmerkung. · A. Das Gesetz der Erscheinung. · B. Die erscheinende und die an-sich-seynede Welt."},"title_language_code":"en"},{"id":"CL_GB18_49","layer":"CL","title":"Chapters 145–147","order":49,"parents":["CH_GB18_CASD","CH_GB18_DVLD","CH_GB18_A_39"],"revision":"CL_GB18_49@R001","sha256":"d18ebcab6d3019b25e4641f5dd0217d64cbe80d97c033ebd2eb3a7f2efb0e55a","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_49:BAS-01","text":"Das Cluster löst den scheinbaren Gegensatz von Erscheinung und Wesen nicht durch Vorrang einer Seite, sondern durch die Bestimmung der Erscheinung als wesentliches Verhältnis auf.","refs":["CH_GB18_CASD:AS1","CH_GB18_DVLD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:BAS-02","text":"Die globale These lautet, dass jede behauptete Selbstständigkeit nur durch die Aufnahme ihres Anderen besteht und sich daher als relationale Selbstnegation erweist.","refs":["CH_GB18_CASD:A10","CH_GB18_DVLD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:BAS-03","text":"Die Bewegung überführt innere Identität in daseiende Vermittlung: Gesetz, Totalität und Einheit gelten nur, sofern sie Negativität und Differenz in sich realisieren.","refs":["CH_GB18_CASD:A12","CH_GB18_DVLD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:BAS-04","text":"Das Verhältnis von Ganzem und Teilen konkretisiert diese Logik als Antinomie: Die Totalität kann ihre Momente weder unabhängig bestehen lassen noch sie unterschiedslos absorbieren.","refs":["CH_GB18_A_39:AS1","CH_GB18_A_39:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:BAS-05","text":"Die Argumentbewegung ist rekursiv und mutationsgetrieben: reziproke Vermittlung erzeugt Selbstauflösung, diese produziert Wiederkehr, und Wiederkehr erzwingt den Übergang in eine andere Verhältnisform.","refs":["CH_GB18_A_39:D6","CH_GB18_DVLD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_49:GA-01","text":"[Attractor] Die Wahrheit der Erscheinung ist kein hinter ihr liegendes Wesen, sondern das wesentliche Verhältnis, in dem getrennte Bestimmungen nur als Momente einer relationalen Totalität bestehen.","refs":["CH_GB18_DVLD:A1","CH_GB18_CASD:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-02","text":"[Persistent] Selbstständigkeit ist nur als Reflexion in ein Anderes möglich und enthält daher ihre eigene Negation als Bedingung ihres Bestehens.","refs":["CH_GB18_CASD:A10","CH_GB18_DVLD:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-03","text":"[Mutating] Positivität und Negativität sind keine fix verteilten Eigenschaften, sondern Funktionen der reziproken Verkehrung, durch die jede Seite ihre Gegenbestimmung hervorbringt.","refs":["CH_GB18_CASD:A3","CH_GB18_A_39:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-04","text":"[Emergent] Totalität ist weder Addition selbstständiger Teile noch abstrakte Einheit über ihnen, sondern die Formeinheit einer innerlich differenzierten und sich vermittelnden Mannigfaltigkeit.","refs":["CH_GB18_CASD:SD4","CH_GB18_DVLD:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-05","text":"[Mutating] Gesetz wandelt sich von einer bloß inneren Gleichheit verschiedener Seiten in eine realisierte Identität, deren Einheit nur durch die Anwesenheit ihrer Differenz besteht.","refs":["CH_GB18_CASD:A12","CH_GB18_CASD:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-06","text":"[Persistent] Es gibt kein ursprüngliches Erstes und keinen äußeren Grund, weil jeder Grund durch seine eigene Entgegensetzung vermittelt und als gesetzter Anfang erkennbar wird.","refs":["CH_GB18_CASD:D4","CH_GB18_DVLD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-07","text":"[Emergent] Das Verhältnis von Ganzem und Teilen ist die quantitative Erscheinungsform einer Totalität, deren Momente nur durch die Aufhebung ihrer isolierten Selbstständigkeit bestimmt bleiben.","refs":["CH_GB18_A_39:A3","CH_GB18_A_39:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-08","text":"[Attractor] Jede Absonderung eines Moments vom Anderen erzeugt unmittelbar dessen Umschlag in die Gegenbestimmung und treibt dadurch den rekursiven Fortschritt an.","refs":["CH_GB18_A_39:D7","CH_GB18_A_39:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-09","text":"[Terminal] Das Verhältnis von Ganzem und Teilen kann nicht als letzte Gestalt der Vermittlung bestehen, weil seine unmittelbaren Seiten in negative Einheit übergehen und Kraft und Äußerung verlangen.","refs":["CH_GB18_DVLD:A11","CH_GB18_DVLD:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-10","text":"[Terminal] Unendlichkeit bezeichnet keine vollendete Totalität, sondern die fortgesetzte Reproduktion einer Vermittlung, die ihre gegensätzlichen Bestimmungen nicht in stabiler Form vereinigen kann.","refs":["CH_GB18_A_39:SD2","CH_GB18_A_39:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_49:RMD-01","text":"Erscheinung bleibt funktional erhalten, mutiert aber von einer der Wesenheit gegenüberstehenden Welt zu einer Reflexionsweise innerhalb jeder Totalität.","refs":["CH_GB18_CASD:ME2","CH_GB18_DVLD:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RMD-02","text":"Grund verliert seine Stellung als vorausgesetzter Ursprung und wird in reziproke Bedingung, aufgehobenen Grund und gesetzten Anfang verschoben.","refs":["CH_GB18_CASD:D4","CH_GB18_DVLD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RMD-03","text":"Totalität erweitert sich von der Zweiheit erscheinender und an sich seiender Welten zur quantitativen Struktur von Ganzem und Teilen, ohne ihre innere Negativität zu verlieren.","refs":["CH_GB18_CASD:A9","CH_GB18_A_39:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RMD-04","text":"Widerspruch mutiert von der Verkehrung zweier Bestimmungen zum strukturellen Motor des Umschlags, der als unendlicher Progress sichtbar wird.","refs":["CH_GB18_DVLD:ME5","CH_GB18_A_39:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RMD-05","text":"Gesetz wird in die höhere Struktur wesentlicher Vermittlung absorbiert: Seine realisierte Identität fungiert nicht mehr als Endform, sondern als Moment der relationalen Formeinheit.","refs":["CH_GB18_CASD:A12","CH_GB18_DVLD:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_49:CGD-01","text":"Die reziproke Verteilung von Positivität und Negativität gehört lokal zur Auflösung der Zweiweltenstruktur; auf Clusterebene gilt sie als allgemeine Regel, nach der jede isolierte Bestimmung ihre Gegenbestimmung erzeugt.","refs":["CH_GB18_CASD:A3","CH_GB18_CASD:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:CGD-02","text":"Kontinuität und Diskretion bleiben die spezifisch quantitative Konfiguration der Anmerkung, während ihre höherstufige Funktion darin besteht, die Instabilität jeder unmittelbaren Teil-Ganzes-Fixierung sichtbar zu machen.","refs":["CH_GB18_A_39:AS2","CH_GB18_A_39:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:CGD-03","text":"Kraft und Äußerung ist auf dieser Ebene keine ausgearbeitete neue Ontologie, sondern die terminale Grenzmarke, an der das Verhältnis von Ganzem und Teilen seine eigene Unzulänglichkeit offenlegt.","refs":["CH_GB18_DVLD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_49:GNX-01","text":"Ausgeschlossen ist eine Zweiweltenontologie, in der Erscheinung und Wesen als unabhängige Totalitäten oder durch einen äußeren Grund vermittelte Sphären bestehen.","refs":["CH_GB18_CASD:SNX1","CH_GB18_CASD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GNX-02","text":"Ausgeschlossen ist eine Totalität, deren Ganzes ohne Teile oder deren Teile mit bewahrter Teilbestimmung unabhängig vom Ganzen bestehen könnten.","refs":["CH_GB18_DVLD:NX1","CH_GB18_A_39:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GNX-03","text":"Ausgeschlossen ist eine Identität, die Differenz durch formale Gleichsetzung neutralisiert, statt sie als negative Bedingung ihrer Realisierung aufzunehmen.","refs":["CH_GB18_CASD:DNX3","CH_GB18_DVLD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_49:DBN-01","text":"Das System setzt voraus, dass Abhängigkeit und Selbstständigkeit nicht verschiedenen Ebenen zugeteilt und dadurch widerspruchslos getrennt werden können; jede stabile Trennung muss in Umschlag übergehen.","refs":["CH_GB18_DVLD:DNX1","CH_GB18_A_39:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:DBN-02","text":"Das System schließt jede reine Unmittelbarkeit aus, weil Existenz nur als vermittelte Setzung und Reflexion in ein Anderes bestimmt werden kann.","refs":["CH_GB18_DVLD:DNX2","CH_GB18_CASD:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:DBN-03","text":"Das System disqualifiziert Gleichheit als letzte Vermittlungsform, sofern sie reale Differenz in eine bloß innere oder tautologische Einheit zurücknimmt.","refs":["CH_GB18_DVLD:NX4","CH_GB18_CASD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_49:BSA-01","text":"Nicht verfügbar ist eine endgültige Einheit, die Differenz beendet und zugleich die Selbstständigkeit ihrer Momente unverändert bewahrt.","refs":["CH_GB18_CASD:SNX5","CH_GB18_DVLD:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:BSA-02","text":"Nicht verfügbar ist ein abgeschlossenes Ganzes, das die rekursive Produktion von Teilen beendet, ohne die Totalität selbst als relationale Bestimmung aufzugeben.","refs":["CH_GB18_A_39:NX6","CH_GB18_A_39:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_49:XD-01","text":"Die Realisierung des Gesetzes und die negative Einheit des Verhältnisses bestimmen gemeinsam Identität als Vollzug der Vermittlung und nicht als ruhende Übereinstimmung verschiedener Inhalte. ; Trace Type — [Composite]","refs":["CL_GB18_49:GA-02","CL_GB18_49:GA-05","CH_GB18_CASD:A12","CH_GB18_DVLD:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_49:XD-02","text":"Die Formeinheit relationaler Totalität kann im Verhältnis von Ganzem und Teilen nicht stabil repräsentiert werden, weil jede Seite ihren Anspruch auf Grundlage durch ihre Abhängigkeit vom Anderen unterminiert. ; Trace Type — [Tension]","refs":["CL_GB18_49:GA-04","CL_GB18_49:GA-09","CH_GB18_CASD:A9","CH_GB18_DVLD:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_49:XD-03","text":"Der unendliche Progress ist die dynamische Gestalt jener Selbstnegation, die im wesentlichen Verhältnis zunächst als gegenseitige Begründung erscheint. ; Trace Type — [Tension]","refs":["CL_GB18_49:GA-02","CL_GB18_49:GA-07","CL_GB18_49:GA-08","CH_GB18_DVLD:A8","CH_GB18_A_39:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_49:XD-04","text":"Die Aufhebung eines äußeren Grundes und eines ursprünglichen Ersten erzeugt eine Ontologie, in der jeder Ursprung nachträglich durch die Beziehung bestimmt wird, die er begründen sollte. ; Trace Type — [Negative]","refs":["CL_GB18_49:GA-06","CH_GB18_CASD:DNX1","CH_GB18_DVLD:DNX2"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_49:BSD-01","text":"Realität erscheint als Produktion relationaler Totalitäten: Identität entsteht nicht vor der Beziehung, sondern als Effekt der in sich aufgenommenen Entgegensetzung.","refs":["CL_GB18_49:GA-02","CL_GB18_49:GA-04","CH_GB18_CASD:SD3","CH_GB18_DVLD:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_49:BSD-02","text":"Antinomie wird methodologisch umklassifiziert: Sie zeigt nicht das äußerliche Scheitern eines Begriffs, sondern die immanente Unmöglichkeit, vermittelte Bestimmungen als isolierte Gegenstände festzuhalten.","refs":["CL_GB18_49:GA-08","CL_GB18_49:GA-10","CH_GB18_DVLD:ME5","CH_GB18_A_39:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_49:BSD-03","text":"Zeitlichkeit erscheint als nachträgliche Setzung von Anfängen und als fortgesetzte Wiederkehr einer Vermittlung, die jede erreichte Bestimmung erneut destabilisiert.","refs":["CL_GB18_49:GA-06","CL_GB18_49:GA-10","CH_GB18_DVLD:ALT4","CH_GB18_A_39:AS6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_49:RLE-01","text":"Reflexion in ein Anderes erzeugt ein sich aufhebendes Anderes, dessen Rückkehr in Selbstbeziehung als Gesetz erscheint; Gesetz ist daher eine Schleife der vermittelten Selbstgleichheit.","refs":["CH_GB18_CASD:A5","CH_GB18_CASD:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RLE-02","text":"Ganze und Teile bilden eine Schleife gegenseitiger Setzung: Jede Seite beansprucht Grundrang, findet ihren Grund aber außer sich und hebt dadurch ihre isolierte Selbstständigkeit auf.","refs":["CH_GB18_DVLD:A7","CH_GB18_DVLD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RLE-03","text":"Der Teil wird durch seine Ablösung vom Ganzen zum Einfachen und damit erneut zum Ganzen; die Wiederholung dieses Umschlags bildet den Attraktor des unendlichen Progresses.","refs":["CH_GB18_A_39:FGS4","CH_GB18_A_39:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_49:FGS-B01","text":"Grundsetzung: Erscheinung und an sich seiende Welt werden als getrennte Totalitäten gesetzt, deren Verhältnis zunächst den Charakter eines Grundverhältnisses trägt.","refs":["CH_GB18_CASD:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FGS-B02","text":"Reziproke Verkehrung: Jede positive Bestimmung enthält ihre negative Gegenbestimmung und jede Reflexion in Anderes erzeugt ein Anderes, das sich selbst aufhebt.","refs":["CH_GB18_CASD:A3","CH_GB18_CASD:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FGS-B03","text":"Totalisierung: Die aufgehobene Welttrennung wird als wesentliche Beziehung zweier Totalitäten bestimmt, deren Selbstständigkeit nur in ihrer Beziehung aufeinander besteht.","refs":["CH_GB18_CASD:A9","CH_GB18_CASD:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FGS-B04","text":"Instabilisierung: Ganzes und Teile setzen und bedingen einander, sodass jede Seite zugleich Grundlage und gesetztes Moment sowie Selbstständigkeit und Selbstnegation ist.","refs":["CH_GB18_DVLD:A7","CH_GB18_DVLD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FGS-B05","text":"Rekursive Eskalation: Der abgelöste Teil wird wieder Ganzes, das Ganze wieder Zusammensetzung, und die Wiederholung erzeugt den unendlichen Progress als Form der nicht stabilisierbaren Vermittlung.","refs":["CH_GB18_A_39:D3","CH_GB18_A_39:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FGS-B06","text":"Terminale Öffnung: Die negative Einheit hebt die unmittelbaren Seiten auf und verlangt den Übergang von Ganzem und Teilen zu Kraft und Äußerung.","refs":["CH_GB18_DVLD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_49:AFM-B01","text":"Weltentrennung → reziproke Verkehrung positiver und negativer Bestimmungen → Aufhebung der isolierten Sphären.","refs":["CH_GB18_CASD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:AFM-B02","text":"Aufgehobener Grund → relationale Totalität → Selbstständigkeit nur als wesentliche Beziehung auf das Andere.","refs":["CH_GB18_CASD:D4","CH_GB18_CASD:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:AFM-B03","text":"Wesentliches Verhältnis → Ganze und Teile als unmittelbare Seiten → gegenseitiges Bedingen → Tautologie formaler Gleichheit.","refs":["CH_GB18_DVLD:A7","CH_GB18_DVLD:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:AFM-B04","text":"Ablösung des Teils → Umschlag in Ganzheit → Wiederholung des Umschlags → unendlicher Progress als Antinomie der Vermittlung.","refs":["CH_GB18_A_39:D6","CH_GB18_A_39:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:AFM-B05","text":"Selbstreproduzierender Widerspruch → negative Einheit → Übergang zu Kraft und Äußerung.","refs":["CH_GB18_DVLD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_49:MME-01","text":"Die Karte verschiebt Welt, Grund und Bedingung von linearen Hierarchien zu reziproken Vermittlungsstrukturen, in denen jedes Erste nur als gesetzter Anfang gilt.","refs":["CH_GB18_CASD:ME3","CH_GB18_DVLD:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MME-02","text":"Selbstständigkeit wird von isolierter Unabhängigkeit in eine Bestimmung umkartiert, die ihre Abhängigkeit und ihre Einheit mit dem Anderen einschließt.","refs":["CH_GB18_CASD:ME5","CH_GB18_DVLD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MME-03","text":"Teilbarkeit wird von einer Eigenschaft materieller Gegenstände in eine relationale Dynamik umklassifiziert, deren Gegenstand der Umschlag zwischen Ganzheit und Teilsein ist.","refs":["CH_GB18_A_39:ME1","CH_GB18_A_39:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MME-04","text":"Widerspruch wird als produktive Übergangsform kartiert: Er zerstört keine bereits fertige Ordnung, sondern macht die Unhaltbarkeit ihrer unmittelbaren Gestalt sichtbar.","refs":["CH_GB18_DVLD:ME5","CH_GB18_A_39:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_49:ALT-B01","text":"Auf der Oberflächenebene erscheinen zwei Welten sowie Ganze und Teile als getrennte Gegenstände oder Sphären mit gegensätzlichen Bestimmungen.","refs":["CH_GB18_CASD:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:ALT-B02","text":"Auf der strukturellen Ebene erzeugen Reflexion in Anderes, innere Entgegensetzung und wechselseitige Bedingung jene Vermittlung, die die scheinbar selbstständigen Seiten trägt.","refs":["CH_GB18_CASD:ALT2","CH_GB18_A_39:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:ALT-B03","text":"Auf der metastrategischen Ebene ersetzt das System die Wahl zwischen konkurrierenden Seiten durch die Rekonstruktion der Operation, welche deren Vorrang, Abhängigkeit und Umschlag zugleich produziert.","refs":["CH_GB18_CASD:ALT3","CH_GB18_A_39:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:ALT-B04","text":"Auf der ontologisch-zeitlichen Ebene wird Sein als gerichtete Folge vermittelte Setzungen bestimmt, in der jede gesetzte Identität ihr eigenes Verschwinden erzeugt.","refs":["CH_GB18_CASD:ALT4","CH_GB18_A_39:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:ALT-B05","text":"Auf der methodologisch-performativen Ebene vollzieht die Architektur ihre These, indem sie jede scheinbar stabile Kategorie als Passage, Vermittlung und Übergang lesen muss.","refs":["CH_GB18_DVLD:ALT3","CH_GB18_A_39:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_49:FL-01","text":"Die Formeinheit relationaler Totalität und die Abwesenheit einer stabilen Vermittlungsform stehen in produktiver Spannung: Einheit wird erreicht, aber nur als Form der fortgesetzten Instabilisierung.","refs":["CH_GB18_CASD:SD4","CH_GB18_A_39:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FL-02","text":"Der Übergang zu Kraft und Äußerung ist als notwendig gesetzt, während die Bestimmung, weshalb negative Einheit gerade diese Folgeform annehmen muss, innerhalb des Materials unterbestimmt bleibt.","refs":["CH_GB18_DVLD:A11","CH_GB18_DVLD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MP-01","text":"Der Grund mutiert vom bestimmten Grund der Erscheinung über den aufgehobenen Grund zur unmittelbaren Existenz und verliert damit jeden Status eines äußeren Ursprungs.","refs":["CH_GB18_CASD:D4","CH_GB18_CASD:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MP-02","text":"Der Teil mutiert bei seiner Absonderung vom Ganzen in eine Ganzheit; diese Mutation verwandelt quantitative Teilbarkeit in rekursive Totalitätsproduktion.","refs":["CH_GB18_A_39:AS5","CH_GB18_A_39:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_49:HSI-01","text":"Das verborgene Systembild ist eine Maschine relationaler Totalitäten, in der jedes selbstständige Moment nur durch die negative Einheit mit seinem Anderen Wirklichkeit besitzt.","refs":["CH_GB18_CASD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:HSI-02","text":"Zeit erscheint als rekursive Umschlagszeit: Nicht Fortschritt zu einer ruhenden Endform, sondern Wiederkehr der Bedingungen, durch die jede gesetzte Bestimmung erneut in ihr Anderes übergeht.","refs":["CH_GB18_A_39:ALT4","CH_GB18_A_39:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:HSI-03","text":"Eine privilegierte Subjektposition wird nicht bestimmt; operativ bleibt allein die Nachzeichnung der Vermittlung, die jedes Vorrangsverhältnis erzeugt, aufhebt und in Übergangsbewegung überführt.","refs":["CH_GB18_DVLD:ALT3","CH_GB18_A_39:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_49:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von Welttrennung über relationale Totalität, Teil-Ganzes-Antinomie und unendlichen Progress bis zur terminalen Forderung nach Kraft und Äußerung zu rekonstruieren.","refs":["CH_GB18_CASD:MRT1","CH_GB18_DVLD:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MRT-B02","text":"Unterbestimmt bleiben der präzise Status von Inhalt, Idealität und Formeinheit sowie die Notwendigkeit, mit der negative Einheit gerade in Kraft und Äußerung übergehen soll.","refs":["CH_GB18_CASD:MRT3","CH_GB18_DVLD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MRT-B03","text":"Die Architektur ist dort am stärksten, wo sie Aufhebung als gleichzeitige Beseitigung isolierter Selbstständigkeit und Erhaltung der unterschiedenen Momente bestimmt.","refs":["CH_GB18_CASD:MRT6","CH_GB18_A_39:MRT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122824679584Z_3e48217b","language_code":"en","language_name":"English","title":"Chapters 145–147","source_sha256":"d18ebcab6d3019b25e4641f5dd0217d64cbe80d97c033ebd2eb3a7f2efb0e55a","sha256":"58e1f1bb413cd6d3d4d8717a7b2752337d9da9b8ad0bc2ac18c1c41f0cd28f17","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:28:24.681606+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_49:BAS-01","text":"The cluster resolves the apparent opposition of appearance and essence not through the priority of one side, but by determining appearance as an essential relation.","refs":["CH_GB18_CASD:AS1","CH_GB18_DVLD:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:BAS-02","text":"The global thesis is that every asserted self-subsistence exists only through the incorporation of its other and thus proves to be relational self-negation.","refs":["CH_GB18_CASD:A10","CH_GB18_DVLD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:BAS-03","text":"The movement transforms inner identity into existent mediation: law, totality, and unity are valid only insofar as they realize negativity and difference within themselves.","refs":["CH_GB18_CASD:A12","CH_GB18_DVLD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:BAS-04","text":"The relation of whole and parts concretizes this logic as antinomy: totality can neither allow its moments to subsist independently nor absorb them without distinction.","refs":["CH_GB18_A_39:AS1","CH_GB18_A_39:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:BAS-05","text":"The movement of argument is recursive and mutation-driven: reciprocal mediation generates self-sublation, this produces return, and return compels the transition into another form of relation.","refs":["CH_GB18_A_39:D6","CH_GB18_DVLD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_49:GA-01","text":"[Attractor] The truth of appearance is not an essence lying behind it, but the essential relation in which separate determinations exist only as moments of a relational totality.","refs":["CH_GB18_DVLD:A1","CH_GB18_CASD:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-02","text":"[Persistent] Self-subsistence is possible only as reflection into an other and therefore contains its own negation as the condition of its existence.","refs":["CH_GB18_CASD:A10","CH_GB18_DVLD:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-03","text":"[Mutating] Positivity and negativity are not fixedly distributed properties, but functions of reciprocal inversion, through which each side brings forth its counter-determination.","refs":["CH_GB18_CASD:A3","CH_GB18_A_39:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-04","text":"[Emergent] Totality is neither the addition of self-subsistent parts nor abstract unity above them, but the formal unity of an internally differentiated and self-mediating manifold.","refs":["CH_GB18_CASD:SD4","CH_GB18_DVLD:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-05","text":"[Mutating] Law transforms itself from a merely inner equality of different sides into a realized identity whose unity exists only through the presence of its difference.","refs":["CH_GB18_CASD:A12","CH_GB18_CASD:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-06","text":"[Persistent] There is no original first and no external ground, because every ground is mediated through its own opposition and becomes recognizable as a posited beginning.","refs":["CH_GB18_CASD:D4","CH_GB18_DVLD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-07","text":"[Emergent] The relation of whole and parts is the quantitative form of appearance of a totality whose moments remain determined only through the sublation of their isolated self-subsistence.","refs":["CH_GB18_A_39:A3","CH_GB18_A_39:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-08","text":"[Attractor] Every separation of one moment from the other immediately generates its reversal into the counter-determination and thereby drives recursive progress.","refs":["CH_GB18_A_39:D7","CH_GB18_A_39:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-09","text":"[Terminal] The relation of whole and parts cannot subsist as the final form of mediation, because its immediate sides pass into negative unity and demand force and expression.","refs":["CH_GB18_DVLD:A11","CH_GB18_DVLD:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GA-10","text":"[Terminal] Infinity designates not a completed totality, but the continued reproduction of a mediation that cannot unite its opposed determinations in stable form.","refs":["CH_GB18_A_39:SD2","CH_GB18_A_39:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_49:RMD-01","text":"Appearance remains functionally preserved, but mutates from a world opposed to essentiality into a mode of reflection within every totality.","refs":["CH_GB18_CASD:ME2","CH_GB18_DVLD:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RMD-02","text":"Ground loses its position as presupposed origin and is displaced into reciprocal condition, sublated ground, and posited beginning.","refs":["CH_GB18_CASD:D4","CH_GB18_DVLD:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RMD-03","text":"Totality expands from the duality of appearing and in-itself worlds to the quantitative structure of whole and parts, without losing its inner negativity.","refs":["CH_GB18_CASD:A9","CH_GB18_A_39:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RMD-04","text":"Contradiction mutates from the inversion of two determinations into the structural motor of reversal, which becomes visible as infinite progress.","refs":["CH_GB18_DVLD:ME5","CH_GB18_A_39:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RMD-05","text":"Law is absorbed into the higher structure of essential mediation: its realized identity no longer functions as an end-form, but as a moment of relational formal unity.","refs":["CH_GB18_CASD:A12","CH_GB18_DVLD:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_49:CGD-01","text":"The reciprocal distribution of positivity and negativity belongs locally to the dissolution of the two-world structure; at the cluster level, it applies as the general rule according to which every isolated determination generates its counter-determination.","refs":["CH_GB18_CASD:A3","CH_GB18_CASD:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:CGD-02","text":"Continuity and discreteness remain the specifically quantitative configuration of the remark, while their higher-level function consists in making visible the instability of every immediate fixation of part and whole.","refs":["CH_GB18_A_39:AS2","CH_GB18_A_39:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:CGD-03","text":"Force and expression at this level are not an elaborated new ontology, but the terminal boundary marker at which the relation of whole and parts discloses its own inadequacy.","refs":["CH_GB18_DVLD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_49:GNX-01","text":"Excluded is a two-world ontology in which appearance and essence subsist as independent totalities or as spheres mediated by an external ground.","refs":["CH_GB18_CASD:SNX1","CH_GB18_CASD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GNX-02","text":"Excluded is a totality whose whole could subsist without parts, or whose parts could subsist independently of the whole while retaining their determination as parts.","refs":["CH_GB18_DVLD:NX1","CH_GB18_A_39:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:GNX-03","text":"Excluded is an identity that neutralizes difference through formal equation, instead of incorporating it as the negative condition of its realization.","refs":["CH_GB18_CASD:DNX3","CH_GB18_DVLD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_49:DBN-01","text":"The system presupposes that dependence and self-subsistence cannot be assigned to different levels and thereby separated without contradiction; every stable separation must pass over into reversal.","refs":["CH_GB18_DVLD:DNX1","CH_GB18_A_39:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:DBN-02","text":"The system excludes every pure immediacy, because existence can be determined only as mediated positing and reflection into an other.","refs":["CH_GB18_DVLD:DNX2","CH_GB18_CASD:DNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:DBN-03","text":"The system disqualifies equality as the final form of mediation insofar as it withdraws real difference into a merely inner or tautological unity.","refs":["CH_GB18_DVLD:NX4","CH_GB18_CASD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_49:BSA-01","text":"Unavailable is a final unity that terminates difference while at the same time preserving the self-subsistence of its moments unchanged.","refs":["CH_GB18_CASD:SNX5","CH_GB18_DVLD:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:BSA-02","text":"Unavailable is a closed whole that terminates the recursive production of parts without relinquishing totality itself as a relational determination.","refs":["CH_GB18_A_39:NX6","CH_GB18_A_39:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_49:XD-01","text":"The realization of law and the negative unity of the relation jointly determine identity as the enactment of mediation and not as the static agreement of different contents. ; Trace Type — [Composite]","refs":["CL_GB18_49:GA-02","CL_GB18_49:GA-05","CH_GB18_CASD:A12","CH_GB18_DVLD:A10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_49:XD-02","text":"The formal unity of relational totality cannot be stably represented in the relation of whole and parts, because each side undermines its claim to foundational status through its dependence on the other. ; Trace Type — [Tension]","refs":["CL_GB18_49:GA-04","CL_GB18_49:GA-09","CH_GB18_CASD:A9","CH_GB18_DVLD:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_49:XD-03","text":"Infinite progress is the dynamic form of that self-negation which initially appears in the essential relation as reciprocal grounding. ; Trace Type — [Tension]","refs":["CL_GB18_49:GA-02","CL_GB18_49:GA-07","CL_GB18_49:GA-08","CH_GB18_DVLD:A8","CH_GB18_A_39:D6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_49:XD-04","text":"The sublation of an external ground and an original first generates an ontology in which every origin is retrospectively determined by the relation it was supposed to ground. ; Trace Type — [Negative]","refs":["CL_GB18_49:GA-06","CH_GB18_CASD:DNX1","CH_GB18_DVLD:DNX2"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_49:BSD-01","text":"Reality appears as the production of relational totalities: identity arises not before relation, but as the effect of opposition taken up into itself.","refs":["CL_GB18_49:GA-02","CL_GB18_49:GA-04","CH_GB18_CASD:SD3","CH_GB18_DVLD:SD3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_49:BSD-02","text":"Antinomy is methodologically reclassified: it does not show the external failure of a concept, but the immanent impossibility of retaining mediated determinations as isolated objects.","refs":["CL_GB18_49:GA-08","CL_GB18_49:GA-10","CH_GB18_DVLD:ME5","CH_GB18_A_39:ME5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_49:BSD-03","text":"Temporality appears as the retrospective positing of beginnings and as the continued return of a mediation that repeatedly destabilizes every attained determination.","refs":["CL_GB18_49:GA-06","CL_GB18_49:GA-10","CH_GB18_DVLD:ALT4","CH_GB18_A_39:AS6"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_49:RLE-01","text":"Reflection into an other generates a self-sublating other whose return into self-relation appears as law; law is therefore a loop of mediated self-equality.","refs":["CH_GB18_CASD:A5","CH_GB18_CASD:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RLE-02","text":"Wholes and parts form a loop of reciprocal positing: each side claims foundational rank, but finds its ground outside itself and thereby sublates its isolated self-subsistence.","refs":["CH_GB18_DVLD:A7","CH_GB18_DVLD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:RLE-03","text":"Through its detachment from the whole, the part becomes the simple and thereby once again the whole; the repetition of this reversal forms the attractor of infinite progress.","refs":["CH_GB18_A_39:FGS4","CH_GB18_A_39:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_49:FGS-B01","text":"Basic positing: appearance and the world that is in itself are posited as separate totalities, whose relation initially bears the character of a ground-relation.","refs":["CH_GB18_CASD:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FGS-B02","text":"Reciprocal inversion: every positive determination contains its negative counter-determination, and every reflection into an other generates an other that sublates itself.","refs":["CH_GB18_CASD:A3","CH_GB18_CASD:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FGS-B03","text":"Totalization: the sublated separation of worlds is determined as the essential relation of two totalities whose self-subsistence exists only in their relation to one another.","refs":["CH_GB18_CASD:A9","CH_GB18_CASD:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FGS-B04","text":"Destabilization: whole and parts posit and condition one another, so that each side is at once foundation and posited moment, as well as self-subsistence and self-negation.","refs":["CH_GB18_DVLD:A7","CH_GB18_DVLD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FGS-B05","text":"Recursive escalation: the detached part becomes whole again, the whole becomes composition again, and repetition generates infinite progress as the form of mediation that cannot be stabilized.","refs":["CH_GB18_A_39:D3","CH_GB18_A_39:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FGS-B06","text":"Terminal opening: negative unity sublates the immediate sides and demands the transition from whole and parts to force and expression.","refs":["CH_GB18_DVLD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_49:AFM-B01","text":"Separation of worlds → reciprocal inversion of positive and negative determinations → sublation of the isolated spheres.","refs":["CH_GB18_CASD:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:AFM-B02","text":"Sublated ground → relational totality → self-subsistence only as an essential relation to the other.","refs":["CH_GB18_CASD:D4","CH_GB18_CASD:D7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:AFM-B03","text":"Essential relation → wholes and parts as immediate sides → reciprocal conditioning → tautology of formal equality.","refs":["CH_GB18_DVLD:A7","CH_GB18_DVLD:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:AFM-B04","text":"Detachment of the part → reversal into wholeness → repetition of the reversal → infinite progress as the antinomy of mediation.","refs":["CH_GB18_A_39:D6","CH_GB18_A_39:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:AFM-B05","text":"Self-reproducing contradiction → negative unity → transition to force and expression.","refs":["CH_GB18_DVLD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_49:MME-01","text":"The map shifts world, ground, and condition from linear hierarchies to structures of reciprocal mediation, in which every first counts only as a posited beginning.","refs":["CH_GB18_CASD:ME3","CH_GB18_DVLD:ME3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MME-02","text":"Self-subsistence is remapped from isolated independence into a determination that includes its dependence and its unity with the other.","refs":["CH_GB18_CASD:ME5","CH_GB18_DVLD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MME-03","text":"Divisibility is reclassified from a property of material objects into a relational dynamic whose object is the reversal between wholeness and being-a-part.","refs":["CH_GB18_A_39:ME1","CH_GB18_A_39:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MME-04","text":"Contradiction is mapped as a productive transitional form: it does not destroy an already completed order, but makes visible the untenability of its immediate shape.","refs":["CH_GB18_DVLD:ME5","CH_GB18_A_39:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_49:ALT-B01","text":"At the surface level, two worlds as well as wholes and parts appear as separate objects or spheres with opposed determinations.","refs":["CH_GB18_CASD:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:ALT-B02","text":"At the structural level, reflection into an other, inner opposition, and reciprocal condition generate the mediation that sustains the apparently self-subsistent sides.","refs":["CH_GB18_CASD:ALT2","CH_GB18_A_39:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:ALT-B03","text":"At the metastrategic level, the system replaces the choice between competing sides with the reconstruction of the operation that simultaneously produces their priority, dependence, and reversal.","refs":["CH_GB18_CASD:ALT3","CH_GB18_A_39:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:ALT-B04","text":"At the ontological-temporal level, being is determined as a directed sequence of mediated positings in which every posited identity generates its own disappearance.","refs":["CH_GB18_CASD:ALT4","CH_GB18_A_39:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:ALT-B05","text":"At the methodological-performative level, the architecture enacts its thesis by having to read every apparently stable category as passage, mediation, and transition.","refs":["CH_GB18_DVLD:ALT3","CH_GB18_A_39:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_49:FL-01","text":"The formal unity of relational totality and the absence of a stable form of mediation stand in productive tension: unity is attained, but only as a form of continued destabilization.","refs":["CH_GB18_CASD:SD4","CH_GB18_A_39:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:FL-02","text":"The transition to force and expression is posited as necessary, while the determination of why negative unity must assume precisely this consequent form remains underdetermined within the material.","refs":["CH_GB18_DVLD:A11","CH_GB18_DVLD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MP-01","text":"Ground mutates from the determinate ground of appearance through the sublated ground to immediate existence, and thereby loses every status as an external origin.","refs":["CH_GB18_CASD:D4","CH_GB18_CASD:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MP-02","text":"The part mutates, upon its separation from the whole, into a wholeness; this mutation transforms quantitative divisibility into recursive totality-production.","refs":["CH_GB18_A_39:AS5","CH_GB18_A_39:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_49:HSI-01","text":"The hidden system-image is a machine of relational totalities in which every self-subsistent moment possesses actuality only through negative unity with its other.","refs":["CH_GB18_CASD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:HSI-02","text":"Time appears as recursive time of reversal: not progress toward a static end-form, but the return of the conditions through which every posited determination once again passes into its other.","refs":["CH_GB18_A_39:ALT4","CH_GB18_A_39:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:HSI-03","text":"A privileged subject-position is not determined; operationally, what remains is solely the tracing of the mediation that produces, sublates, and transforms every relation of priority into movement of transition.","refs":["CH_GB18_DVLD:ALT3","CH_GB18_A_39:ALT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_49:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from the separation of worlds through relational totality, the part-whole antinomy, and infinite progress to the terminal demand for force and expression.","refs":["CH_GB18_CASD:MRT1","CH_GB18_DVLD:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MRT-B02","text":"What remains underdetermined are the precise status of content, ideality, and formal unity, as well as the necessity with which negative unity is supposed to pass precisely into force and expression.","refs":["CH_GB18_CASD:MRT3","CH_GB18_DVLD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_49:MRT-B03","text":"The architecture is strongest where it determines sublation as the simultaneous removal of isolated self-subsistence and preservation of the differentiated moments.","refs":["CH_GB18_CASD:MRT6","CH_GB18_A_39:MRT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_49@R001","source_variant_id":"canonical:CL_GB18_49:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 145–147","context":"C. Auflösung der Erscheinung. · A. Das Verhältniß des Ganzen und der Theile. · Anmerkung."},"title_language_code":"en"},{"id":"CL_GB18_50","layer":"CL","title":"Chapters 148–150","order":50,"parents":["CH_GB18_BDVL","CH_GB18_DBDK","CH_GB18_BDSD"],"revision":"CL_GB18_50@R001","sha256":"7499d9ed654d7b4e2d13788041b818818cce80cd03f48bbf24f037389151c1ed","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_50:ABS-01","text":"Das System löst das Problem, wie eine Einheit wirksam werden kann, ohne als ruhiges Ding, unveränderliches Substrat oder bloß äußerlich zusammengesetztes Ganzes bestimmt zu werden.","refs":["CH_GB18_BDVL:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-02","text":"Die Kraft ersetzt die äußerliche Einheit des Ganzen und der Theile durch eine negative Einheit, in der Differenz nicht verschwindet, sondern als aufgehobenes Moment wirksam bleibt.","refs":["CH_GB18_BDVL:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-03","text":"Äußerung ist weder ein unabhängiges Außen noch bloßer Verlust der Kraft, sondern die Bewegung, in der die Kraft außer sich tritt und als Grund in sich zurückkehrt.","refs":["CH_GB18_BDVL:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-04","text":"Die Selbstidentität der Kraft besteht daher nicht vor der Veränderung, sondern als Selbsterhaltung innerhalb einer selbstgesetzten Veränderung.","refs":["CH_GB18_BDVL:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-05","text":"Die zunächst äußerlich erscheinende Bedingung der Kraft wird aus dem Status eines gleichgültigen Dings in den Status einer anderen Kraft überführt.","refs":["CH_GB18_DBDK:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-06","text":"Das Kraftverhältnis wird dadurch zu einer verteilten Selbstbeziehung: Jede Kraft setzt eine Äußerlichkeit voraus, die als andere Kraft erscheint, aber ihre eigene Negativität vollzieht.","refs":["CH_GB18_BDSD:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-07","text":"Der Anstoß fungiert nicht als äußerer Ursprung, sondern als Solicitation einer bereits im Verhältnis angelegten Selbstnegation.","refs":["CH_GB18_BDSD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-08","text":"Die Bewegung ist rekursiv und spiralförmig: Aggregat wird Kraft, Kraft wird Verhältnis, Verhältnis wird gegenseitige Solicitation, und die anfängliche Äußerlichkeit kehrt als gesetztes Moment der Selbstvermittlung zurück.","refs":["CH_GB18_BDSD:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_50:GA-01","text":"[Persistent] Einheit ist nicht die Tilgung der Differenz, sondern deren negative Integration als aufgehobene und wirksame Momente.","refs":["CH_GB18_BDVL:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-02","text":"[Mutating] Kraft ist nur als Übergang in Äußerung und Rückgang aus der Äußerung in ihren Grund bestimmt.","refs":["CH_GB18_BDVL:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-03","text":"[Persistent] Identität besteht als Selbsterhaltung in der gesetzten Veränderung und nicht als Beharren eines unveränderlichen Trägers.","refs":["CH_GB18_BDVL:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-04","text":"[Mutating] Die Bedingung der Kraft ist kein gleichgültiges Ding, sondern eine andere Kraft derselben Bestimmungsform.","refs":["CH_GB18_DBDK:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-05","text":"[Emergent] Jede einzelne Kraft ist nur als bedingte Tätigkeit wirklich, weil ihre Tätigkeit die Tätigkeit einer anderen Kraft voraussetzt.","refs":["CH_GB18_DBDK:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-06","text":"[Attractor] Äußerlichkeit ist zugleich gesetzt und vorausgesetzt; sie bildet weder ein absolutes Außen noch eine bloße innere Bestimmung.","refs":["CH_GB18_BDSD:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-07","text":"[Terminal] Solicitation bestimmt keine Kraft durch fremden Inhalt, sondern aktualisiert deren eigene negative Selbstbeziehung.","refs":["CH_GB18_BDSD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-08","text":"[Attractor] Aktivität und Passivität sind reversible Formbestimmungen einer gegenseitig vermittelten Kraftbeziehung und keine festen Zustände zweier getrennt bestimmter Wesenheiten.","refs":["CH_GB18_BDSD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_50:RMD-01","text":"Das Ganze-und-Theile-Verhältnis verschwindet nicht einfach, sondern wird von einer äußerlichen Aggregatform in eine untergeordnete Vorstufe innerer Vermittlung umcodiert.","refs":["CH_GB18_BDVL:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RMD-02","text":"Die Äußerlichkeit mutiert von der Unabhängigkeit eines Gegenstandes zum gesetzten Dasein der Kraft und schließlich zum vorausgesetzten Medium ihrer gegenseitigen Selbstvermittlung.","refs":["CH_GB18_DBDK:ME3","CH_GB18_BDSD:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RMD-03","text":"Das Andere bleibt als Differenz erhalten, verliert jedoch seinen Status als absolut fremde Gegeninstanz und wird zur Form, in der Kraft sich selbst bedingt.","refs":["CH_GB18_BDVL:D7","CH_GB18_BDSD:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RMD-04","text":"Der Anstoß kehrt funktional als äußerer Auslöser wieder, wird aber terminal als gegenseitig gesetzte Solicitation und damit als nicht-linearer Vollzug der Selbstbestimmung absorbiert.","refs":["CH_GB18_BDSD:A13","CH_GB18_BDSD:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_50:CGD-01","text":"Die Bestimmung des Verhältnisses von Ganzem und Theilen bleibt lokal, sofern sie nur den Widerspruch einer äußerlichen Einheit beschreibt; auf Clusterebene zählt sie nur als Ausgangsform der Umwandlung in Kraft.","refs":["CH_GB18_BDVL:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:CGD-02","text":"Die Zuordnung einer Kraft zu einem Ding oder einer Materie bleibt eine lokale Fehlform, deren gegenwärtige Funktion darin besteht, den Übergang zur relationalen Ontologie der Kräfte auszulösen.","refs":["CH_GB18_DBDK:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:CGD-03","text":"Die reziproke Beziehung zweier Kräfte skaliert zur globalen Struktur, weil sie Grund, Äußerung, Bedingung, Aktivität und Passivität in einer einzigen rekursiven Architektur integriert.","refs":["CH_GB18_BDSD:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_50:GNX-01","text":"Ausgeschlossen wird jede Ontologie, in der selbstständige Teile, Dinge oder Materien ihren Grund unabhängig von ihren Verhältnissen besitzen.","refs":["CH_GB18_BDVL:DNX2","CH_GB18_DBDK:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GNX-02","text":"Ausgeschlossen wird ein Modell, in dem Grund und Äußerung dauerhaft getrennt bleiben und die Äußerung als unabhängige Wirkung oder bloßer Zusatz erscheint.","refs":["CH_GB18_BDVL:DNX3","CH_GB18_DBDK:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GNX-03","text":"Ausgeschlossen wird eine lineare Kausalordnung, in der ein Anstoß einseitig übertragen wird, eine Kraft bloß empfängt und Reaktion nachträglich folgt.","refs":["CH_GB18_BDSD:DNX3","CH_GB18_BDSD:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_50:DBN-01","text":"Das System kann keine voraussetzungslose Selbstbeziehung zulassen, weil jede Kraft ihre Tätigkeit nur über ein vorausgesetztes Anderes beginnt und vollzieht.","refs":["CH_GB18_BDVL:DNX5","CH_GB18_DBDK:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:DBN-02","text":"Das System kann keine reine Selbstständigkeit zulassen, weil Selbstständigkeit nur als bedingte und durch Andersheit vermittelte Form der Kraft besteht.","refs":["CH_GB18_BDVL:SNX3","CH_GB18_BDSD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:DBN-03","text":"Das System kann keine endgültige Versöhnung von Einheit und Verschiedenheit zulassen, weil die Einheit der Kräfte nur durch fortgesetzte Differenz, Solicitation und Reaktion wirklich bleibt.","refs":["CH_GB18_DBDK:SNX4","CH_GB18_BDSD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_50:BSA-01","text":"Unverfügbar ist ein letzter Ursprung der Bewegung, der außerhalb der Selbstnegation, Bedingtheit und Gegenseitigkeit der Kräfte läge.","refs":["CH_GB18_BDSD:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:BSA-02","text":"Unmöglich ist ein reines Außen, weil jedes Außen zugleich als vorausgesetzte und gesetzte Äußerlichkeit in die Bewegung der Kraft eingeschrieben wird.","refs":["CH_GB18_BDSD:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:BSA-03","text":"Unzulässig ist eine nicht-zirkuläre Zeitordnung, in der ein erster Anstoß und eine endgültige Wirkung voneinander isoliert werden könnten.","refs":["CH_GB18_BDSD:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_50:XD-01","text":"Die Aufhebung des Dinges als Träger der Kraft und die Aufhebung des Anstoßes als fremder Bestimmung sind zwei Phasen derselben Verschiebung: Erklärung wird von Substanz auf relationale Selbstvermittlung verlagert.","refs":["CL_GB18_50:GA-04","CL_GB18_50:GA-07","CH_GB18_DBDK:SD1","CH_GB18_BDSD:NX2"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_50:XD-02","text":"Die Kraft vollzieht ihre Identität nicht trotz der Bedingung durch andere Kraft, sondern gerade als Umwandlung der Bedingtheit in eine eigene Äußerung und Reaktion.","refs":["CL_GB18_50:GA-03","CL_GB18_50:GA-05","CL_GB18_50:GA-06","CH_GB18_BDVL:SD4","CH_GB18_BDSD:D7"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_50:XD-03","text":"Die reziproke Kraftbeziehung ist keine Verdopplung einer einzelnen Einheit, sondern die notwendige Verteilung von Selbstbeziehung über differente Seiten, deren Einheit zunächst nur ansichseiend bleibt.","refs":["CL_GB18_50:GA-05","CL_GB18_50:GA-08","CH_GB18_DBDK:A16","CH_GB18_BDSD:SD3"],"deep_refs":[],"trace_type":"Tension.","passages":[]},{"id":"CL_GB18_50:XD-04","text":"Die Transformation von Aggregat zu Kraftverhältnis ersetzt die Frage nach dem Bestand eines Gegenstandes durch die Frage, wie Differenz sich als Bedingung ihrer eigenen Vermittlung reproduziert.","refs":["CL_GB18_50:GA-01","CL_GB18_50:GA-04","CH_GB18_BDVL:D1","CH_GB18_DBDK:SD4"],"deep_refs":[],"trace_type":"Composite.","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_50:BSD-01","text":"Realität erscheint als Feld rekursiver Wirksamkeiten, in dem jedes scheinbar selbstständige Dasein nur als Moment von Setzung, Voraussetzung, Äußerung und Rückkehr besteht.","refs":["CL_GB18_50:GA-02","CL_GB18_50:GA-05","CL_GB18_50:GA-06","CH_GB18_BDSD:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_50:BSD-02","text":"Kausalität wird in eine zirkuläre Struktur überführt, in der Ursache und Wirkung nicht verschwinden, aber ihre einseitige Stellung verlieren und wechselseitig erzeugte Rollen werden.","refs":["CL_GB18_50:GA-07","CL_GB18_50:GA-08","CH_GB18_BDSD:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_50:BSD-03","text":"Das Subjektmodell eines passiv betroffenen Trägers wird unhaltbar; Betroffenheit ist selbst eine vermittelte Form eigener Aktivität und nicht deren Gegenteil.","refs":["CL_GB18_50:GA-07","CL_GB18_50:GA-08","CH_GB18_BDSD:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_50:BSD-04","text":"Zeit wird als Wiederkehr ohne bloße Wiederholung bestimmt: Jede Rückkehr erzeugt die Kraft erneut als veränderte, bedingte und dennoch bei sich bleibende Einheit.","refs":["CL_GB18_50:GA-02","CL_GB18_50:GA-03","CH_GB18_BDSD:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_50:RLE-01","text":"Die erste Schleife führt von Kraft über Äußerung zu Grund zurück und produziert Identität als rückkehrende Selbsterhaltung in der Veränderung.","refs":["CH_GB18_BDVL:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RLE-02","text":"Die zweite Schleife führt von gesetzter Unmittelbarkeit zu vorausgesetzter Bedingung und macht jede gesetzte Äußerlichkeit zur Bedingung weiterer Tätigkeit.","refs":["CH_GB18_DBDK:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RLE-03","text":"Die dritte Schleife führt von der anderen Kraft über Solicitation zur Reaktion und verwandelt scheinbare Fremdbestimmung in eine verteilte Selbstbestimmung.","refs":["CH_GB18_BDSD:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RLE-04","text":"Der Attraktor des Clusters ist die negative Einheit, weil sie Aggregat, Ding, Bedingung, Anstoß und Reaktion als unterschiedliche Stadien derselben selbstvermittelnden Bewegung absorbiert.","refs":["CH_GB18_DBDK:A1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_50:FGS-B01","text":"Selbstständige Teile plus äußerliche Einheit erzeugen ein Aggregat, dessen Widerspruch die Unzulänglichkeit bloßer Zusammensetzung freilegt.","refs":["CH_GB18_BDVL:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:FGS-B02","text":"Der Widerspruch von Einheit und Mannigfaltigkeit wird negativ integriert und erzeugt Kraft als reflektierte Einheit aufgehobener Momente.","refs":["CH_GB18_BDVL:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:FGS-B03","text":"Kraft setzt Äußerung, erhält sich in deren Veränderung und nimmt die Äußerung zugleich als Rückverweis auf ihren Grund in sich zurück.","refs":["CH_GB18_BDVL:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:FGS-B04","text":"Die Äußerung wird als Voraussetzung wiederkehrend und transformiert das Verhältnis von Kraft und Ding in ein Verhältnis zweier Kräfte.","refs":["CH_GB18_DBDK:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:FGS-B05","text":"Gegenseitige Vorausgesetztheit erzeugt Solicitation, in der Anstoß, Reaktion, Aktivität und Passivität als wechselseitig vermittelte Bestimmungen zirkulieren.","refs":["CH_GB18_BDSD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_50:AFM-B01","text":"Äußerliche Einheit von Ganzem und Theilen → Widerspruch zwischen Einheit und selbstständiger Mannigfaltigkeit.","refs":["CH_GB18_BDVL:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:AFM-B02","text":"Widerspruch → negative Einheit der Kraft → Aufhebung der Extreme zu Momenten einer reflektierten Einheit.","refs":["CH_GB18_BDVL:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:AFM-B03","text":"Kraft → Äußerung → Rückkehr der Äußerung in die Kraft als ihren Grund.","refs":["CH_GB18_BDVL:AF4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:AFM-B04","text":"Rückkehr → Selbsterhaltung in Veränderung → Offenlegung der Bedingtheit durch ein Anderes.","refs":["CH_GB18_BDVL:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:AFM-B05","text":"Bedingtheit → Aufhebung des Dings als Träger → andere Kraft als notwendige Voraussetzung der Tätigkeit.","refs":["CH_GB18_DBDK:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:AFM-B06","text":"Gegenseitige Kraftbeziehung → Solicitation → Reaktion als Setzung und Aufhebung der eigenen Äußerlichkeit.","refs":["CH_GB18_BDSD:FGS8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_50:MME-01","text":"Gegenstände werden nicht mehr als Träger innerer Kräfte kartiert, sondern als vorläufige Erscheinungsformen eines relationalen Feldes von Kraftverhältnissen.","refs":["CH_GB18_DBDK:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MME-02","text":"Äußerlichkeit wird von einer Grenze zwischen Innerem und Außen zu einem operativen Medium, in dem Kraft ihre Identität vollzieht.","refs":["CH_GB18_BDSD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MME-03","text":"Aktivität und Passivität verlieren ihre Stellung als gegensätzliche Kategorien und werden als vertauschbare Positionen innerhalb desselben Vermittlungsprozesses neu geordnet.","refs":["CH_GB18_BDSD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MME-04","text":"Die strategische Lesart verschiebt sich von der Suche nach isolierten Ursachen zur Rekonstruktion von Schleifen, durch welche Bedingungen und Bedingtes dieselbe Bestimmungsform reproduzieren.","refs":["CH_GB18_DBDK:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_50:ALT-B01","text":"Surface level — Explizit behandelt wird die Beziehung von Kraft, Äußerung, Bedingung, Anstoß und Reaktion.","refs":["CH_GB18_BDVL:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ALT-B02","text":"Structural level — Die operative Struktur besteht aus negativer Einheit, gesetzter Äußerlichkeit, vorausgesetzter Bedingung und gegenseitiger Vermittlung mehrerer Kräfte.","refs":["CH_GB18_DBDK:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ALT-B03","text":"Metastrategic level — Erklärung wird von äußerlicher Zusammensetzung, Dingträgern und linearer Verursachung auf Selbstvermittlung durch Andersheit umgestellt.","refs":["CH_GB18_BDSD:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ALT-B04","text":"Ontological / Temporal level — Sein ist weder unmittelbare Substanz noch bloßes Werden, sondern rekursive Rückkehr einer Kraft, die sich nur in gesetzter Veränderung erhält.","refs":["CH_GB18_BDVL:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ALT-B05","text":"Methodological / Performative level — Die Argumentform vollzieht ihre These, indem sie jede scheinbar feste Bestimmung in eine Relation überführt, deren Bedingung als mutierte Wiederkehr derselben Bestimmungsform erscheint.","refs":["CH_GB18_DBDK:ALT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_50:FL-01","text":"Die Kraft muss sich als negative Selbstbeziehung bestimmen, kann ihren Vollzug aber nicht ohne eine vorausgesetzte andere Kraft beginnen; Selbstbestimmung bleibt deshalb konstitutiv bedingt.","refs":["CH_GB18_BDVL:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:FL-02","text":"Äußerlichkeit muss zugleich als wirkliches Gegenüber und als eigenes, an sich aufhebbares Moment der Kraft gelten; diese Doppelstellung darf weder zu absoluter Fremdheit noch zu bloßer Innerlichkeit reduziert werden.","refs":["CH_GB18_BDSD:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MP-01","text":"Der Begriff der Kraft mutiert vom Grund einer Äußerung zur Tätigkeit, die ihre Äußerlichkeit hervorbringt, voraussetzt und in einer anderen Kraft wiederfindet.","refs":["CH_GB18_DBDK:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MP-02","text":"Die Bedingung mutiert vom gleichgültigen Ding zur anderen Kraft und damit von äußerem Anlass zur notwendigen Form der Selbstvermittlung.","refs":["CH_GB18_DBDK:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MP-03","text":"Solicitation mutiert vom einseitig empfangenen Impuls zur gegenseitigen Bestimmung, in der jede Kraft nur als die von der anderen gesetzte Rolle wirksam ist.","refs":["CH_GB18_BDSD:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_50:HSI-01","text":"Die Realität erscheint als Maschine negativer Vermittlung, in der kein Bestand ohne Übergang, keine Einheit ohne Differenz und keine Wirkung ohne rückläufige Bedingung möglich ist.","refs":["CH_GB18_BDVL:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:HSI-02","text":"Das Subjekt erscheint nicht als souveräner Ursprung und nicht als passiver Empfänger, sondern als Position innerhalb einer verteilten Selbstbestimmung durch Andere.","refs":["CH_GB18_BDSD:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:HSI-03","text":"Zeit erscheint als rekursive Gegenwart von Setzen und Voraussetzen, in der der Anstoß nie absolut zuerst und die Reaktion nie bloß danach kommt.","refs":["CH_GB18_BDSD:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:HSI-04","text":"Möglich bleibt keine Flucht aus dem Verhältnis, sondern nur die immanente Navigation seiner Umkehrungen: Äußerlichkeit wird aufgehoben, indem sie als eigenes Moment gesetzt wird.","refs":["CH_GB18_BDSD:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_50:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung vom mechanischen Aggregat über Kraft und Bedingung bis zur gegenseitigen Solicitation als eine einheitliche rekursive Architektur zu rekonstruieren.","refs":["CH_GB18_BDVL:MRT7","CH_GB18_BDSD:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MRT-B02","text":"Unterbestimmt bleibt, wie die zunächst nur ansichseiende Einheit der Kräfte in eine vollständig gesetzte Einheit übergehen und ob dieser Übergang eine ontologische oder ausschließlich begriffliche Bestimmung darstellt.","refs":["CH_GB18_DBDK:MRT2","CH_GB18_BDSD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MRT-B03","text":"Die Architektur ist am stärksten dort, wo sie Identität als Erhaltung in Veränderung und Bedingtheit als eigene Tätigkeit formalisiert; sie hängt jedoch irreduzibel von der produktiven Spannung zwischen Selbstsetzung und Voraussetzung ab.","refs":["CH_GB18_BDVL:MRT5","CH_GB18_DBDK:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122851398121Z_ff17f626","language_code":"en","language_name":"English","title":"Chapters 148–150","source_sha256":"7499d9ed654d7b4e2d13788041b818818cce80cd03f48bbf24f037389151c1ed","sha256":"a941a34557653d18f57ed35bd244df8f8f999e5ca97306e6d0e3067d93dd4a52","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:28:51.399262+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_50:ABS-01","text":"The system resolves the problem of how a unity can become efficacious without being determined as a quiescent thing, immutable substrate, or merely externally composed whole.","refs":["CH_GB18_BDVL:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-02","text":"Force replaces the external unity of the whole and the parts with a negative unity, in which difference does not disappear but remains efficacious as a sublated moment.","refs":["CH_GB18_BDVL:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-03","text":"Manifestation is neither an independent externality nor a mere loss of force, but the movement in which force steps outside itself and returns into itself as ground.","refs":["CH_GB18_BDVL:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-04","text":"The self-identity of force therefore consists not prior to change, but as self-preservation within a self-posited change.","refs":["CH_GB18_BDVL:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-05","text":"The condition of force, which initially appears external, is transferred from the status of an indifferent thing to the status of another force.","refs":["CH_GB18_DBDK:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-06","text":"The relation of forces thereby becomes a distributed self-relation: each force presupposes an externality that appears as another force but enacts its own negativity.","refs":["CH_GB18_BDSD:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-07","text":"Impulse functions not as an external origin, but as solicitation of a self-negation already inherent in the relation.","refs":["CH_GB18_BDSD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ABS-08","text":"The movement is recursive and spiral-shaped: aggregate becomes force, force becomes relation, relation becomes mutual solicitation, and the initial externality returns as a posited moment of self-mediation.","refs":["CH_GB18_BDSD:AF1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_50:GA-01","text":"[Persistent] Unity is not the effacement of difference, but its negative integration as sublated and efficacious moments.","refs":["CH_GB18_BDVL:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-02","text":"[Mutating] Force is determined only as transition into manifestation and recession from manifestation into its ground.","refs":["CH_GB18_BDVL:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-03","text":"[Persistent] Identity consists as self-preservation in posited change and not as the persistence of an immutable bearer.","refs":["CH_GB18_BDVL:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-04","text":"[Mutating] The condition of force is not an indifferent thing, but another force of the same form of determination.","refs":["CH_GB18_DBDK:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-05","text":"[Emergent] Each individual force is actual only as conditioned activity, because its activity presupposes the activity of another force.","refs":["CH_GB18_DBDK:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-06","text":"[Attractor] Externality is at once posited and presupposed; it constitutes neither an absolute outside nor a merely internal determination.","refs":["CH_GB18_BDSD:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-07","text":"[Terminal] Solicitation does not determine a force through alien content, but actualizes its own negative self-relation.","refs":["CH_GB18_BDSD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GA-08","text":"[Attractor] Activity and passivity are reversible formal determinations of a mutually mediated relation of forces and not fixed states of two separately determined entities.","refs":["CH_GB18_BDSD:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_50:RMD-01","text":"The whole-and-parts relation does not simply disappear, but is recoded from an external aggregate-form into a subordinate preliminary stage of internal mediation.","refs":["CH_GB18_BDVL:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RMD-02","text":"Externality mutates from the independence of an object into the posited existence of force and finally into the presupposed medium of its mutual self-mediation.","refs":["CH_GB18_DBDK:ME3","CH_GB18_BDSD:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RMD-03","text":"The other is preserved as difference, yet loses its status as an absolutely alien counter-instance and becomes the form in which force conditions itself.","refs":["CH_GB18_BDVL:D7","CH_GB18_BDSD:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RMD-04","text":"Impulse recurs functionally as an external trigger, but is terminally absorbed as mutually posited solicitation and thus as a non-linear enactment of self-determination.","refs":["CH_GB18_BDSD:A13","CH_GB18_BDSD:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_50:CGD-01","text":"The determination of the relation of whole and parts remains local insofar as it describes only the contradiction of an external unity; at the cluster level, it counts only as the initial form of transformation into force.","refs":["CH_GB18_BDVL:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:CGD-02","text":"The attribution of a force to a thing or matter remains a local malformed form, whose present function consists in initiating the transition to the relational ontology of forces.","refs":["CH_GB18_DBDK:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:CGD-03","text":"The reciprocal relation of two forces scales into the global structure because it integrates ground, manifestation, condition, activity, and passivity within a single recursive architecture.","refs":["CH_GB18_BDSD:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_50:GNX-01","text":"Excluded is every ontology in which independent parts, things, or matters possess their ground independently of their relations.","refs":["CH_GB18_BDVL:DNX2","CH_GB18_DBDK:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GNX-02","text":"Excluded is a model in which ground and manifestation remain permanently separate and manifestation appears as an independent effect or a mere addition.","refs":["CH_GB18_BDVL:DNX3","CH_GB18_DBDK:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:GNX-03","text":"Excluded is a linear causal order in which an impulse is transmitted one-sidedly, a force merely receives, and reaction follows subsequently.","refs":["CH_GB18_BDSD:DNX3","CH_GB18_BDSD:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_50:DBN-01","text":"The system cannot permit a presuppositionless self-relation, because every force begins and enacts its activity only through a presupposed other.","refs":["CH_GB18_BDVL:DNX5","CH_GB18_DBDK:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:DBN-02","text":"The system cannot permit pure independence, because independence exists only as a conditioned form of force mediated through otherness.","refs":["CH_GB18_BDVL:SNX3","CH_GB18_BDSD:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:DBN-03","text":"The system cannot permit a final reconciliation of unity and difference, because the unity of forces remains actual only through continuing difference, solicitation, and reaction.","refs":["CH_GB18_DBDK:SNX4","CH_GB18_BDSD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_50:BSA-01","text":"Unavailable is an ultimate origin of movement that would lie outside the self-negation, conditionedness, and reciprocity of forces.","refs":["CH_GB18_BDSD:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:BSA-02","text":"A pure outside is impossible, because every outside is at once inscribed into the movement of force as presupposed and posited externality.","refs":["CH_GB18_BDSD:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:BSA-03","text":"Inadmissible is a non-circular temporal order in which a first impulse and a final effect could be isolated from one another.","refs":["CH_GB18_BDSD:SNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_50:XD-01","text":"The sublation of the thing as bearer of force and the sublation of impulse as alien determination are two phases of the same displacement: explanation is shifted from substance to relational self-mediation.","refs":["CL_GB18_50:GA-04","CL_GB18_50:GA-07","CH_GB18_DBDK:SD1","CH_GB18_BDSD:NX2"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_50:XD-02","text":"Force enacts its identity not despite its conditioning by another force, but precisely as the transformation of conditionedness into its own manifestation and reaction.","refs":["CL_GB18_50:GA-03","CL_GB18_50:GA-05","CL_GB18_50:GA-06","CH_GB18_BDVL:SD4","CH_GB18_BDSD:D7"],"deep_refs":[],"trace_type":"Composite.","passages":[]},{"id":"CL_GB18_50:XD-03","text":"The reciprocal relation of forces is not a doubling of a single unity, but the necessary distribution of self-relation over different sides, whose unity initially remains only in itself.","refs":["CL_GB18_50:GA-05","CL_GB18_50:GA-08","CH_GB18_DBDK:A16","CH_GB18_BDSD:SD3"],"deep_refs":[],"trace_type":"Tension.","passages":[]},{"id":"CL_GB18_50:XD-04","text":"The transformation from aggregate to relation of forces replaces the question of an object's persistence with the question of how difference reproduces itself as the condition of its own mediation.","refs":["CL_GB18_50:GA-01","CL_GB18_50:GA-04","CH_GB18_BDVL:D1","CH_GB18_DBDK:SD4"],"deep_refs":[],"trace_type":"Composite.","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_50:BSD-01","text":"Reality appears as a field of recursive efficacies, in which every seemingly independent existence subsists only as a moment of positing, presupposition, manifestation, and return.","refs":["CL_GB18_50:GA-02","CL_GB18_50:GA-05","CL_GB18_50:GA-06","CH_GB18_BDSD:SD5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_50:BSD-02","text":"Causality is transferred into a circular structure in which cause and effect do not disappear, but lose their one-sided position and become mutually generated roles.","refs":["CL_GB18_50:GA-07","CL_GB18_50:GA-08","CH_GB18_BDSD:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_50:BSD-03","text":"The subject-model of a passively affected bearer becomes untenable; being affected is itself a mediated form of one's own activity and not its opposite.","refs":["CL_GB18_50:GA-07","CL_GB18_50:GA-08","CH_GB18_BDSD:D4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_50:BSD-04","text":"Time is determined as return without mere repetition: each return produces force anew as an altered, conditioned, and nevertheless self-identical unity.","refs":["CL_GB18_50:GA-02","CL_GB18_50:GA-03","CH_GB18_BDSD:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_50:RLE-01","text":"The first loop leads from force through manifestation back to ground and produces identity as returning self-preservation in change.","refs":["CH_GB18_BDVL:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RLE-02","text":"The second loop leads from posited immediacy to presupposed condition and makes every posited externality the condition of further activity.","refs":["CH_GB18_DBDK:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RLE-03","text":"The third loop leads from the other force through solicitation to reaction and transforms apparent external determination into a distributed self-determination.","refs":["CH_GB18_BDSD:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:RLE-04","text":"The attractor of the cluster is negative unity, because it absorbs aggregate, thing, condition, impulse, and reaction as different stages of the same self-mediating movement.","refs":["CH_GB18_DBDK:A1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_50:FGS-B01","text":"Independent parts plus external unity generate an aggregate whose contradiction reveals the inadequacy of mere composition.","refs":["CH_GB18_BDVL:FGS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:FGS-B02","text":"The contradiction of unity and multiplicity is negatively integrated and generates force as the reflected unity of sublated moments.","refs":["CH_GB18_BDVL:FGS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:FGS-B03","text":"Force posits manifestation, preserves itself in its alteration, and at the same time takes manifestation back into itself as a reference back to its ground.","refs":["CH_GB18_BDVL:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:FGS-B04","text":"Manifestation becomes recurrent as presupposition and transforms the relation of force and thing into a relation of two forces.","refs":["CH_GB18_DBDK:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:FGS-B05","text":"Mutual presupposedness generates solicitation, in which impulse, reaction, activity, and passivity circulate as mutually mediated determinations.","refs":["CH_GB18_BDSD:FGS4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_50:AFM-B01","text":"External unity of whole and parts → contradiction between unity and independent multiplicity.","refs":["CH_GB18_BDVL:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:AFM-B02","text":"Contradiction → negative unity of force → sublation of the extremes into moments of a reflected unity.","refs":["CH_GB18_BDVL:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:AFM-B03","text":"Force → manifestation → return of manifestation into force as its ground.","refs":["CH_GB18_BDVL:AF4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:AFM-B04","text":"Return → self-preservation in change → disclosure of conditionedness through an other.","refs":["CH_GB18_BDVL:AF5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:AFM-B05","text":"Conditionedness → sublation of the thing as bearer → other force as the necessary presupposition of activity.","refs":["CH_GB18_DBDK:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:AFM-B06","text":"Mutual relation of forces → solicitation → reaction as positing and sublation of one's own externality.","refs":["CH_GB18_BDSD:FGS8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_50:MME-01","text":"Objects are no longer mapped as bearers of inner forces, but as provisional phenomenal forms of a relational field of relations of forces.","refs":["CH_GB18_DBDK:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MME-02","text":"Externality is transformed from a boundary between inner and outer into an operative medium in which force enacts its identity.","refs":["CH_GB18_BDSD:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MME-03","text":"Activity and passivity lose their position as opposing categories and are reordered as interchangeable positions within the same process of mediation.","refs":["CH_GB18_BDSD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MME-04","text":"The strategic reading shifts from the search for isolated causes to the reconstruction of loops through which conditions and the conditioned reproduce the same form of determination.","refs":["CH_GB18_DBDK:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_50:ALT-B01","text":"Surface level — The relation of force, manifestation, condition, impulse, and reaction is explicitly treated.","refs":["CH_GB18_BDVL:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ALT-B02","text":"Structural level — The operative structure consists of negative unity, posited externality, presupposed condition, and the mutual mediation of several forces.","refs":["CH_GB18_DBDK:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ALT-B03","text":"Metastrategic level — Explanation is shifted from external composition, thing-bearers, and linear causation to self-mediation through otherness.","refs":["CH_GB18_BDSD:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ALT-B04","text":"Ontological / Temporal level — Being is neither immediate substance nor mere becoming, but the recursive return of a force that preserves itself only in posited change.","refs":["CH_GB18_BDVL:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:ALT-B05","text":"Methodological / Performative level — The argumentative form enacts its thesis by transferring every seemingly fixed determination into a relation whose condition appears as the mutated return of the same form of determination.","refs":["CH_GB18_DBDK:ALT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_50:FL-01","text":"Force must determine itself as negative self-relation, but cannot begin its enactment without a presupposed other force; self-determination therefore remains constitutively conditioned.","refs":["CH_GB18_BDVL:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:FL-02","text":"Externality must count at once as a real counterpart and as force's own moment, sublatable in itself; this double status must be reduced neither to absolute alienness nor to mere inwardness.","refs":["CH_GB18_BDSD:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MP-01","text":"The concept of force mutates from the ground of a manifestation into the activity that produces its externality, presupposes it, and rediscovers it in another force.","refs":["CH_GB18_DBDK:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MP-02","text":"Condition mutates from the indifferent thing into the other force and thereby from external occasion into the necessary form of self-mediation.","refs":["CH_GB18_DBDK:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MP-03","text":"Solicitation mutates from a one-sidedly received impulse into mutual determination, in which each force is efficacious only as the role posited by the other.","refs":["CH_GB18_BDSD:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_50:HSI-01","text":"Reality appears as a machine of negative mediation, in which no persistence without transition, no unity without difference, and no effect without retrogressive condition is possible.","refs":["CH_GB18_BDVL:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:HSI-02","text":"The subject appears neither as sovereign origin nor as passive recipient, but as a position within a distributed self-determination through others.","refs":["CH_GB18_BDSD:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:HSI-03","text":"Time appears as the recursive present of positing and presupposing, in which impulse is never absolutely first and reaction never comes merely afterward.","refs":["CH_GB18_BDSD:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:HSI-04","text":"No escape from the relation remains possible, but only the immanent navigation of its reversals: externality is sublated by being posited as one's own moment.","refs":["CH_GB18_BDSD:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_50:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from mechanical aggregate through force and condition to mutual solicitation as a unified recursive architecture.","refs":["CH_GB18_BDVL:MRT7","CH_GB18_BDSD:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MRT-B02","text":"It remains underdetermined how the unity of forces, initially only in itself, can pass into a fully posited unity and whether this transition constitutes an ontological or exclusively conceptual determination.","refs":["CH_GB18_DBDK:MRT2","CH_GB18_BDSD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_50:MRT-B03","text":"The architecture is strongest where it formalizes identity as preservation in change and conditionedness as one's own activity; yet it depends irreducibly on the productive tension between self-positing and presupposition.","refs":["CH_GB18_BDVL:MRT5","CH_GB18_DBDK:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_50@R001","source_variant_id":"canonical:CL_GB18_50:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 148–150","context":"B. Das Verhältniß der Kraft und ihrer Äußerung. · a. Das Bedingtseyn der Kraft. · b. Die Sollicitation der Kraft."},"title_language_code":"en"},{"id":"CL_GB18_51","layer":"CL","title":"Chapters 151–153","order":51,"parents":["CH_GB18_CD_3","CH_GB18_CVLD","CH_GB18_A_40"],"revision":"CL_GB18_51@R001","sha256":"c972b6537eaca4a38d909f5b54cb90c204812108e6d43bc44c1c190030a61f5d","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_51:AS-01","text":"Das System löst das Problem, wie eine zunächst endliche, äußerlich bedingte Kraft zur Wahrheit einer Selbstvermittlung werden kann.","refs":["CH_GB18_CD_3:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AS-02","text":"Es bestimmt Äußerlichkeit nicht als Gegenreich, sondern als notwendige Form, durch welche Innerlichkeit sich setzt, verliert und zu sich zurückkehrt.","refs":["CH_GB18_CVLD:AS2","CH_GB18_A_40:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AS-03","text":"Die Bewegung ist spiralförmig: unmittelbare Identität erzeugt Differenz, Differenz erzeugt Vermittlung, und Vermittlung erzeugt eine höhere Identität, die ihre Äußerung in sich einschließt.","refs":["CH_GB18_A_40:SD1","CH_GB18_A_40:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AS-04","text":"Die Kraft wird zur allgemeinen Operationsform, in der Fremdbestimmung, Passivität und Anstoß als Selbstverhältnisse rekonstruiert werden.","refs":["CH_GB18_CD_3:SD3","CH_GB18_CD_3:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AS-05","text":"Die Schließung dieser Ebene liegt nicht in einer substantiellen Ruhe, sondern in der Wirklichkeit als Selbstoffenbarung, deren Einheit nur durch fortdauernde negative Vermittlung besteht.","refs":["CH_GB18_A_40:D9","CH_GB18_CVLD:NX9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_51:GA-01","text":"[Persistent] Unmittelbarkeit ist kein neutraler Anfang, sondern die Form, in der Identität noch äußerlich, passiv und endlich bleibt.","refs":["CH_GB18_CD_3:A1","CH_GB18_A_40:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-02","text":"[Mutating] Äußerlichkeit mutiert von der Grenze der Kraft zur Vollzugsform ihrer Selbstbeziehung.","refs":["CH_GB18_CD_3:A9","CH_GB18_CVLD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-03","text":"[Persistent] Inneres und Äußeres sind keine getrennten Inhalte, sondern differente Formbestimmungen einer Identität, die nur in ihrem Übergehen besteht.","refs":["CH_GB18_CVLD:A7","CH_GB18_CVLD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-04","text":"[Emergent] Die Vermittlung hebt Differenz nicht auf, indem sie sie auslöscht, sondern indem sie jede Seite als Moment der Totalität ihres Anderen bestimmt.","refs":["CH_GB18_CVLD:A13","CH_GB18_A_40:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-05","text":"[Attractor] Totalität ist nicht vorausgesetzt verfügbar, sondern der Attraktor, auf den die gegenseitige Setzung der Bestimmungen verweist.","refs":["CH_GB18_CVLD:SD4","CH_GB18_A_40:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-06","text":"[Mutating] Negativität wechselt ihre Funktion von einer Beschränkung endlicher Kraft zu der Vermittlung, durch welche Identität erst erzeugt wird.","refs":["CH_GB18_CD_3:A13","CH_GB18_A_40:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-07","text":"[Terminal] Wirklichkeit entsteht erst dort, wo Erscheinung nicht mehr als bloßes Äußeres gilt, sondern als Selbstoffenbarung des Wesens.","refs":["CH_GB18_A_40:SD4","CH_GB18_A_40:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-08","text":"[Terminal] Der Geist bezeichnet keine ursprüngliche Innerlichkeit, sondern die vermittelte Rückkehr aus einer von ihm selbst gesetzten Unmittelbarkeit.","refs":["CH_GB18_A_40:SD6","CH_GB18_A_40:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_51:RMD-01","text":"Die Kraft kehrt als stabile Funktionsfigur wieder, verschiebt sich jedoch von endlicher Bedingtheit zur allgemeinen Form der Selbstäußerung und Selbstvermittlung.","refs":["CH_GB18_CD_3:A5","CH_GB18_CVLD:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RMD-02","text":"Der äußere Anstoß wird zunächst als scheinbare Fremdbedingung behandelt und anschließend in eigenes Sollicitieren und gesetzte Vermittlung umcodiert.","refs":["CH_GB18_CD_3:A11","CH_GB18_CD_3:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RMD-03","text":"Das Innere mutiert von einer reflexiven Gegenbestimmung der Kraft zu einer unzureichenden Anfangsform, die nur durch Äußerung und Entwicklung Wahrheit erhält.","refs":["CH_GB18_CVLD:A6","CH_GB18_A_40:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RMD-04","text":"Die Identität verschiebt sich von inhaltsvoller Grundlage über reine Formumkehrung zu einer Wirklichkeit, in der Inhalt und Form untrennbar geworden sind.","refs":["CH_GB18_CVLD:SD2","CH_GB18_A_40:A18"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RMD-05","text":"Die negative Einheit bleibt als funktionale Wiederkehr erhalten, wird aber von einem inhaltslosen Punkt zur produktiven Bedingung entwickelter Totalität überführt.","refs":["CH_GB18_CVLD:NX9","CH_GB18_A_40:A3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_51:CGD-01","text":"Die konkrete Trennung voraussetzender und selbstbezüglicher Reflexion bleibt ein lokaler Mechanismus der Kraftanalyse; auf Clusterebene wird sie zur allgemeinen Struktur jeder Selbstvermittlung.","refs":["CH_GB18_CD_3:A2","CH_GB18_CVLD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:CGD-02","text":"Die Unterscheidung von Wesen und Seyn gehört zunächst der Verhältnislogik von Innerem und Äußerem an, wird hier jedoch als Entwicklungsordnung von Wirklichkeit lesbar.","refs":["CH_GB18_CVLD:A6","CH_GB18_A_40:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:CGD-03","text":"Der inhaltslose negative Punkt bleibt eine lokale Grenze der bloßen Formbeziehung und kann nicht selbst als letzte Totalität des Clusters gelten.","refs":["CH_GB18_CVLD:AS7","CH_GB18_CVLD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:CGD-04","text":"Die Bestimmung Gottes als Natur statt Geist skaliert nur insofern nach oben, als sie die allgemeine Unzulässigkeit einer unmittelbaren Vollendung exponiert.","refs":["CH_GB18_A_40:D10","CH_GB18_A_40:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_51:GNX-01","text":"Ausgeschlossen wird ein Außen, das unabhängig von der Kraft, dem Wesen oder der Vermittlungsbewegung als erster Wirkgrund bestehen könnte.","refs":["CH_GB18_CD_3:SNX1","CH_GB18_CVLD:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GNX-02","text":"Zurückgewiesen wird jede Identität, die vor Negation, Differenz und Selbstäußerung bereits vollständig gegeben wäre.","refs":["CH_GB18_CD_3:SNX2","CH_GB18_A_40:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GNX-03","text":"Verworfen wird ein Modell, in dem Inneres und Äußeres selbstständige ontologische Regionen oder getrennte Inhalte darstellen.","refs":["CH_GB18_CVLD:DNX1","CH_GB18_A_40:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GNX-04","text":"Unzulässig bleibt eine Totalität, die als fertiger Grund verfügbar wäre, bevor sie durch Tätigkeit, Entgegensetzung und Rückkehr hervorgebracht wird.","refs":["CH_GB18_A_40:DNX4","CH_GB18_A_40:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_51:DBN-01","text":"Das System kann nicht bestehen, wenn Form und Inhalt als voneinander unabhängige Schichten behandelt werden; ihre Trennung würde Selbstvermittlung in äußere Verknüpfung zurückverwandeln.","refs":["CH_GB18_CD_3:DNX5","CH_GB18_A_40:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:DBN-02","text":"Das System kann keine Passivität als eigenständiges Gegenprinzip zulassen, weil sie nur als gesetztes Moment der Aktivität verständlich bleibt.","refs":["CH_GB18_CD_3:DNX3","CH_GB18_CD_3:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:DBN-03","text":"Das System kann keine Wirklichkeit anerkennen, die hinter ihrer Erscheinung verborgen bliebe, weil Wahrheit nur als hervorgetretene Selbstrelation gilt.","refs":["CH_GB18_A_40:SNX2","CH_GB18_A_40:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_51:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist eine absolut unmittelbare Einheit, die weder ihre Differenz erzeugen noch aus ihrer Äußerung zu sich zurückkehren müsste.","refs":["CH_GB18_A_40:SNX1","CH_GB18_A_40:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:BSA-02","text":"Nicht verfügbar ist ein Standpunkt außerhalb des Übergehens, von dem aus Wirklichkeit, Wesen oder Geist als fertige Gegenstände festgehalten werden könnten.","refs":["CH_GB18_CVLD:SNX4","CH_GB18_A_40:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_51:XD-01","text":"Die Unendlichkeit der Kraft erweist sich als Vorform der Wirklichkeit: Beide bezeichnen nicht grenzenlose Beständigkeit, sondern Selbstidentität durch gesetzte und aufgehobene Äußerlichkeit.","refs":["CL_GB18_51:GA-02","CL_GB18_51:GA-06","CL_GB18_51:GA-07","CH_GB18_CD_3:SD4","CH_GB18_A_40:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_51:XD-02","text":"Die Rückführung des Anstoßes auf Selbstsollicitieren und die Umkehrung von Innerem und Äußerem bilden zusammen eine nichtlineare Kausalität, in der Bedingung und Wirkung wechselseitig hervorgebracht werden.","refs":["CL_GB18_51:GA-02","CL_GB18_51:GA-04","CH_GB18_CD_3:D6","CH_GB18_CVLD:D5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_51:XD-03","text":"Die formale negative Einheit wird erst durch die Entwicklungslogik vor der Verwechslung mit erfüllter Totalität bewahrt.","refs":["CL_GB18_51:GA-05","CL_GB18_51:GA-06","CH_GB18_CVLD:NX7","CH_GB18_A_40:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_51:XD-04","text":"Die Identität von Erscheinung und Wesen verallgemeinert die zuvor an der Kraft gewonnene Einsicht, dass Äußerlichkeit nicht Verlust, sondern Bedingung der Selbstgegenwart ist.","refs":["CL_GB18_51:GA-02","CL_GB18_51:GA-07","CH_GB18_CD_3:SD1","CH_GB18_A_40:D9"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_51:BSD-01","text":"Kausalität wird als rekursive Selbstbedingung bestimmt: Was als äußerer Anstoß erscheint, ist das Resultat einer Bewegung, die ihre Bedingungen im Vollzug selbst erzeugt.","refs":["CH_GB18_CD_3:SD5","CH_GB18_CD_3:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:BSD-02","text":"Realität besitzt auf dieser Ebene keinen verborgenen Kern hinter ihren Erscheinungen, sondern die Struktur einer sich äußernden und dadurch erst wirklichen Totalität.","refs":["CH_GB18_A_40:SD4","CH_GB18_A_40:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:BSD-03","text":"Das Subjektmodell des Geistes wird aus einer ontologischen Bewegung gewonnen: Selbstsein ist nicht Besitz einer Innerlichkeit, sondern Rückkehr aus selbstgesetzter Andersheit.","refs":["CH_GB18_A_40:FGS7","CH_GB18_A_40:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:BSD-04","text":"Endlichkeit bezeichnet nicht primär quantitative Begrenzung, sondern die Unfähigkeit einer Bestimmung, ihre Differenz als eigenes vermitteltes Moment zu begreifen.","refs":["CH_GB18_CD_3:D1","CH_GB18_A_40:NX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_51:RLE-01","text":"Die zentrale Schleife verläuft von Unmittelbarkeit über Äußerung und Negation zu einer Identität, die nur als Ergebnis ihres Anderswerdens besteht.","refs":["CH_GB18_CD_3:FGS7","CH_GB18_A_40:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RLE-02","text":"Die Eskalation führt von Kraft als endlicher Form über das Verhältnis von Innerem und Äußerem zur Wirklichkeit als vollständiger Selbstoffenbarung.","refs":["CH_GB18_CD_3:FGS8","CH_GB18_A_40:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RLE-03","text":"Totalität fungiert als Attraktor, weil jede isolierte Seite notwendig auf ihr Anderes und damit auf die Einheit verweist, die sie noch nicht vollständig besitzt.","refs":["CH_GB18_CVLD:D7","CH_GB18_A_40:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RLE-04","text":"Der Phasenwechsel tritt ein, wenn Äußerlichkeit nicht mehr als äußerer Zustand, sondern als Äußerung des Ansichseins verstanden wird.","refs":["CH_GB18_A_40:D7","CH_GB18_A_40:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_51:FGS-B01","text":"Unmittelbarkeit → endliche und passive Bestimmtheit → scheinbare Selbstständigkeit von Innerem, Äußerem und Anstoß.","refs":["CH_GB18_CD_3:FGS1","CH_GB18_A_40:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FGS-B02","text":"Scheinbare Selbstständigkeit → negative Einheit → Äußerung als Setzung des Anderen durch das Sichselbstbestimmende.","refs":["CH_GB18_CVLD:FGS2","CH_GB18_CD_3:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FGS-B03","text":"Gesetzte Äußerlichkeit → Rücknahme in die Reflexion → Umcodierung von Fremdbeziehung, Passivität und Grenze als eigene Vermittlung.","refs":["CH_GB18_CD_3:FGS5","CH_GB18_CD_3:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FGS-B04","text":"Wechselseitige Vermittlung → jede Seite als Totalität ihrer selbst und ihres Anderen → Übergang von abstrakter Formeinheit zu entwickelter Wirklichkeit.","refs":["CH_GB18_A_40:FGS4","CH_GB18_A_40:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FGS-B05","text":"Wirklichkeit → Selbstoffenbarung des Wesens → Geist als nicht-unmittelbare Rückkehrstruktur.","refs":["CH_GB18_A_40:SD4","CH_GB18_A_40:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_51:AFM-B01","text":"Unmittelbare Kraft → äußere Bedingtheit → endliche Form.","refs":["CH_GB18_CD_3:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AFM-B02","text":"Endliche Form → Aufhebung der Äußerlichkeit → Selbstbeziehung im Anderen.","refs":["CH_GB18_CD_3:FGS4","CH_GB18_CD_3:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AFM-B03","text":"Selbstbeziehung → Verhältnis von Innerem und Äußerem → negative Einheit ohne erfüllten Grund.","refs":["CH_GB18_CVLD:AF1","CH_GB18_CVLD:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AFM-B04","text":"Negative Einheit → Entgegensetzung und Formreflexion → wechselseitige Totalität der Seiten.","refs":["CH_GB18_A_40:FGS2","CH_GB18_A_40:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AFM-B05","text":"Wechselseitige Totalität → Äußerlichkeit als Selbstoffenbarung → Wirklichkeit als Identität von Wesen und Erscheinung.","refs":["CH_GB18_A_40:FGS5","CH_GB18_A_40:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_51:MME-01","text":"Die Karte der Kausalität verschiebt sich von äußerer Einwirkung zu zirkulärer Selbstvermittlung.","refs":["CH_GB18_CD_3:ME5","CH_GB18_CD_3:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MME-02","text":"Die Karte der Grenze verschiebt sich von äußerer Schranke zu einer durch Unmittelbarkeit erzeugten und durch Vermittlung transformierbaren Begrenzung.","refs":["CH_GB18_CD_3:ME3","CH_GB18_CD_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MME-03","text":"Die Karte der Wirklichkeit verschiebt sich von verborgenem Grund zu vollzogener Selbstoffenbarung.","refs":["CH_GB18_A_40:ME6","CH_GB18_A_40:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MME-04","text":"Die falsche Alternative zwischen Innerlichkeit und Äußerlichkeit zerfällt, weil jede Seite nur durch die andere das ist, was sie an sich ist.","refs":["CH_GB18_A_40:D5","CH_GB18_A_40:A16"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_51:ALT-B01","text":"Surface level — Der explizite Gegenstand ist der Übergang von Kraft, Innerem und Äußerem zu Erscheinung, Wirklichkeit und Geist.","refs":["CH_GB18_A_40:ALT1","CH_GB18_A_40:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:ALT-B02","text":"Structural level — Die tragende Maschine besteht aus negativer Einheit, Entgegensetzung, Äußerung, Rückkehr und wechselseitiger Totalisierung.","refs":["CH_GB18_A_40:ALT2","CH_GB18_CVLD:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:ALT-B03","text":"Metastrategic level — Das System verweigert die Entscheidung für eine Seite des Gegensatzes und ersetzt sie durch eine Analyse der Bedingungen, unter denen beide Seiten sich gegenseitig erzeugen.","refs":["CH_GB18_CVLD:ALT3","CH_GB18_A_40:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:ALT-B04","text":"Ontological / Temporal level — Zeitlichkeit erscheint als Entwicklung, in der das Wirkliche nur dadurch wird, dass es seine Unmittelbarkeit verlässt und vermittelt zurücknimmt.","refs":["CH_GB18_A_40:ALT4","CH_GB18_CD_3:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie jeden scheinbar festen Gegenstand in eine Folge von Setzung, Umkehrung und Rückkehr überführt.","refs":["CH_GB18_CVLD:FGS6","CH_GB18_A_40:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_51:FL-01","text":"Die Architektur benötigt eine inhaltsvolle Grundlage, bestimmt deren Formverhältnis jedoch zugleich als negative Einheit ohne gegenwärtigen identischen Grund.","refs":["CH_GB18_CVLD:A8","CH_GB18_CVLD:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FL-02","text":"Die Äußerlichkeit wird zugleich aufgehoben und bewahrt; sie darf weder als selbstständiges Außen fortbestehen noch als entbehrlicher Schein verschwinden.","refs":["CH_GB18_CD_3:MRT6","CH_GB18_CVLD:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FL-03","text":"Die Totalität fehlt dem unmittelbaren Verhältnis, wird seinen Bestimmungen aber dennoch bereits als deren innere Wahrheit zugeschrieben.","refs":["CH_GB18_A_40:MRT5","CH_GB18_A_40:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MP-01","text":"Die Kraft mutiert im Übergang vom äußerlich bedingten Wirken zur Selbstsetzung ihrer Bedingungen.","refs":["CH_GB18_CD_3:SD5","CH_GB18_CD_3:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MP-02","text":"Identität mutiert im Übergang von substantieller Grundlage zu bloßer Formumkehrung und schließlich zur Einheit von Erscheinung und Wesen.","refs":["CH_GB18_CVLD:SD2","CH_GB18_A_40:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MP-03","text":"Der Geist markiert den terminalen Mutationspunkt, an dem die Rückkehr aus Äußerlichkeit nicht mehr nur Kraftprozess, sondern Gestalt der Wirklichkeit selbst ist.","refs":["CH_GB18_A_40:FGS7","CH_GB18_A_40:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_51:HSI-01","text":"Die Realität erscheint als Maschine der Selbstäußerung, die ihre Außenräume nicht vorfindet, sondern als notwendige Bedingungen ihrer Rückkehr produziert.","refs":["CH_GB18_CD_3:SD1","CH_GB18_A_40:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:HSI-02","text":"Das Subjekt erscheint als ein Verhältnis, das sich nur besitzt, indem es sich in seinem Anderen verliert und dort als vermittelt zu sich zurückkehrt.","refs":["CH_GB18_CD_3:A9","CH_GB18_A_40:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:HSI-03","text":"Zeit erscheint nicht als Folge äußerer Zustände, sondern als Entwicklungslogik der gesetzten, negierten und zurückgenommenen Unmittelbarkeit.","refs":["CH_GB18_A_40:SD5","CH_GB18_A_40:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:HSI-04","text":"Möglich bleibt kein Kampf gegen ein schlechthin äußeres Gegenüber, sondern nur die Navigation jener Vermittlungen, in denen Fremdheit als eigene Bedingung wirksam wird.","refs":["CH_GB18_CD_3:SD3","CH_GB18_CVLD:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_51:MRT-B01","text":"Die globalen Axiome reichen aus, um den Übergang von endlicher Kraft über negative Einheit und wechselseitige Vermittlung zu Wirklichkeit als Selbstoffenbarung zu rekonstruieren.","refs":["CH_GB18_CD_3:MRT1","CH_GB18_A_40:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MRT-B02","text":"Die Rekonstruktion bleibt nur kohärent, wenn Aufhebung als bewahrende Transformation und nicht als Vernichtung der Äußerlichkeit verstanden wird.","refs":["CH_GB18_CD_3:MRT3","CH_GB18_A_40:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MRT-B03","text":"Unterbestimmt bleibt die Vermittlung zwischen der absoluten Sache als Grundlage und dem inhaltslosen Punkt der reinen Formbeziehung.","refs":["CH_GB18_CVLD:MRT3","CH_GB18_CVLD:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MRT-B04","text":"Die Architektur ist am stärksten dort, wo sie äußeren Anstoß, Erscheinung und Grenze als interne Effekte einer Selbstvermittlung ausweist; sie hängt jedoch unverzichtbar von der sequenzierten Eskalation ihrer Begriffe ab.","refs":["CH_GB18_CD_3:MRT5","CH_GB18_A_40:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122917625642Z_b8fa70d9","language_code":"en","language_name":"English","title":"Chapters 151–153","source_sha256":"c972b6537eaca4a38d909f5b54cb90c204812108e6d43bc44c1c190030a61f5d","sha256":"be524e9a77ff866bad5f569c9a8b47265a6f3fb203dd361ed7c639d932ca3c44","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:29:17.627551+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_51:AS-01","text":"The system resolves the problem of how a force that is initially finite and externally conditioned can become the truth of a self-mediation.","refs":["CH_GB18_CD_3:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AS-02","text":"It determines externality not as a counter-realm, but as the necessary form through which inwardness posits itself, loses itself, and returns to itself.","refs":["CH_GB18_CVLD:AS2","CH_GB18_A_40:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AS-03","text":"The movement is spiral-shaped: immediate identity generates difference, difference generates mediation, and mediation generates a higher identity that includes its expression within itself.","refs":["CH_GB18_A_40:SD1","CH_GB18_A_40:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AS-04","text":"Force becomes the universal operational form in which hetero-determination, passivity, and impulse are reconstructed as self-relations.","refs":["CH_GB18_CD_3:SD3","CH_GB18_CD_3:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AS-05","text":"The closure of this level lies not in a substantial repose, but in actuality as self-revelation, whose unity exists only through enduring negative mediation.","refs":["CH_GB18_A_40:D9","CH_GB18_CVLD:NX9"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_51:GA-01","text":"[Persistent] Immediacy is not a neutral beginning, but the form in which identity still remains external, passive, and finite.","refs":["CH_GB18_CD_3:A1","CH_GB18_A_40:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-02","text":"[Mutating] Externality mutates from the limit of force into the mode of execution of its self-relation.","refs":["CH_GB18_CD_3:A9","CH_GB18_CVLD:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-03","text":"[Persistent] Inner and outer are not separate contents, but different determinations of form of an identity that exists only in its transition.","refs":["CH_GB18_CVLD:A7","CH_GB18_CVLD:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-04","text":"[Emergent] Mediation does not sublate difference by erasing it, but by determining each side as a moment of the totality of its other.","refs":["CH_GB18_CVLD:A13","CH_GB18_A_40:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-05","text":"[Attractor] Totality is not available as presupposed, but is the attractor to which the reciprocal positing of the determinations points.","refs":["CH_GB18_CVLD:SD4","CH_GB18_A_40:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-06","text":"[Mutating] Negativity changes its function from a limitation of finite force into the mediation through which identity is first produced.","refs":["CH_GB18_CD_3:A13","CH_GB18_A_40:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-07","text":"[Terminal] Actuality arises only where appearance no longer counts as a merely external element, but as the self-revelation of essence.","refs":["CH_GB18_A_40:SD4","CH_GB18_A_40:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GA-08","text":"[Terminal] Spirit designates not an original inwardness, but the mediated return from an immediacy posited by itself.","refs":["CH_GB18_A_40:SD6","CH_GB18_A_40:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_51:RMD-01","text":"Force recurs as a stable functional figure, yet shifts from finite conditionedness to the universal form of self-expression and self-mediation.","refs":["CH_GB18_CD_3:A5","CH_GB18_CVLD:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RMD-02","text":"The external impulse is initially treated as an apparent alien condition and subsequently recoded into its own soliciting and posited mediation.","refs":["CH_GB18_CD_3:A11","CH_GB18_CD_3:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RMD-03","text":"The inner mutates from a reflexive counter-determination of force into an inadequate initial form that attains truth only through expression and development.","refs":["CH_GB18_CVLD:A6","CH_GB18_A_40:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RMD-04","text":"Identity shifts from a contentful foundation through a pure reversal of form to an actuality in which content and form have become inseparable.","refs":["CH_GB18_CVLD:SD2","CH_GB18_A_40:A18"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RMD-05","text":"Negative unity persists as a functional recurrence, but is transferred from a contentless point to the productive condition of developed totality.","refs":["CH_GB18_CVLD:NX9","CH_GB18_A_40:A3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_51:CGD-01","text":"The concrete distinction between presupposing and self-relating reflection remains a local mechanism of the analysis of force; at the cluster level it becomes the universal structure of every self-mediation.","refs":["CH_GB18_CD_3:A2","CH_GB18_CVLD:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:CGD-02","text":"The distinction between essence and Seyn initially belongs to the logic of the relation of inner and outer, but here becomes legible as a developmental order of actuality.","refs":["CH_GB18_CVLD:A6","CH_GB18_A_40:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:CGD-03","text":"The contentless negative point remains a local limit of the mere relation of form and cannot itself count as the final totality of the cluster.","refs":["CH_GB18_CVLD:AS7","CH_GB18_CVLD:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:CGD-04","text":"The determination of God as nature rather than spirit scales upward only insofar as it exposes the general inadmissibility of an immediate completion.","refs":["CH_GB18_A_40:D10","CH_GB18_A_40:SNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_51:GNX-01","text":"Excluded is an outside that could subsist as a first effective ground independently of force, essence, or the movement of mediation.","refs":["CH_GB18_CD_3:SNX1","CH_GB18_CVLD:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GNX-02","text":"Rejected is every identity that would already be fully given prior to negation, difference, and self-expression.","refs":["CH_GB18_CD_3:SNX2","CH_GB18_A_40:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GNX-03","text":"Rejected is a model in which inner and outer constitute independent ontological regions or separate contents.","refs":["CH_GB18_CVLD:DNX1","CH_GB18_A_40:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:GNX-04","text":"Inadmissible remains a totality that would be available as a finished ground before it is produced through activity, opposition, and return.","refs":["CH_GB18_A_40:DNX4","CH_GB18_A_40:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_51:DBN-01","text":"The system cannot subsist if form and content are treated as layers independent of one another; their separation would transform self-mediation back into external connection.","refs":["CH_GB18_CD_3:DNX5","CH_GB18_A_40:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:DBN-02","text":"The system cannot allow passivity as an independent counter-principle, because it remains intelligible only as a posited moment of activity.","refs":["CH_GB18_CD_3:DNX3","CH_GB18_CD_3:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:DBN-03","text":"The system cannot recognize an actuality that would remain concealed behind its appearance, because truth counts only as an emerged self-relation.","refs":["CH_GB18_A_40:SNX2","CH_GB18_A_40:D8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_51:BSA-01","text":"The most deeply excluded possibility is an absolutely immediate unity that would neither have to produce its difference nor return to itself from its expression.","refs":["CH_GB18_A_40:SNX1","CH_GB18_A_40:SNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:BSA-02","text":"Unavailable is a standpoint outside transition from which actuality, essence, or spirit could be held fast as finished objects.","refs":["CH_GB18_CVLD:SNX4","CH_GB18_A_40:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_51:XD-01","text":"The infinity of force proves to be a prefiguration of actuality: both designate not boundless persistence, but self-identity through posited and sublated externality.","refs":["CL_GB18_51:GA-02","CL_GB18_51:GA-06","CL_GB18_51:GA-07","CH_GB18_CD_3:SD4","CH_GB18_A_40:SD4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_51:XD-02","text":"The reduction of impulse to self-soliciting and the reversal of inner and outer together constitute a nonlinear causality in which condition and effect are reciprocally produced.","refs":["CL_GB18_51:GA-02","CL_GB18_51:GA-04","CH_GB18_CD_3:D6","CH_GB18_CVLD:D5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_51:XD-03","text":"Formal negative unity is preserved from confusion with fulfilled totality only through the logic of development.","refs":["CL_GB18_51:GA-05","CL_GB18_51:GA-06","CH_GB18_CVLD:NX7","CH_GB18_A_40:SD1"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_51:XD-04","text":"The identity of appearance and essence generalizes the insight previously gained from force that externality is not loss but the condition of self-presence.","refs":["CL_GB18_51:GA-02","CL_GB18_51:GA-07","CH_GB18_CD_3:SD1","CH_GB18_A_40:D9"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_51:BSD-01","text":"Causality is determined as recursive self-conditioning: what appears as an external impulse is the result of a movement that produces its conditions in its very execution.","refs":["CH_GB18_CD_3:SD5","CH_GB18_CD_3:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:BSD-02","text":"At this level reality possesses no hidden core behind its appearances, but rather the structure of a totality that expresses itself and thereby first becomes actual.","refs":["CH_GB18_A_40:SD4","CH_GB18_A_40:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:BSD-03","text":"The subject-model of spirit is derived from an ontological movement: self-being is not possession of an inwardness, but return from self-posited otherness.","refs":["CH_GB18_A_40:FGS7","CH_GB18_A_40:SD6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:BSD-04","text":"Finitude designates not primarily quantitative limitation, but the incapacity of a determination to grasp its difference as its own mediated moment.","refs":["CH_GB18_CD_3:D1","CH_GB18_A_40:NX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_51:RLE-01","text":"The central loop runs from immediacy through expression and negation to an identity that exists only as the result of its becoming-other.","refs":["CH_GB18_CD_3:FGS7","CH_GB18_A_40:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RLE-02","text":"The escalation leads from force as a finite form through the relation of inner and outer to actuality as complete self-revelation.","refs":["CH_GB18_CD_3:FGS8","CH_GB18_A_40:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RLE-03","text":"Totality functions as an attractor because every isolated side necessarily points to its other and thus to the unity that it does not yet fully possess.","refs":["CH_GB18_CVLD:D7","CH_GB18_A_40:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:RLE-04","text":"The phase change occurs when externality is no longer understood as an external state, but as the expression of being-in-itself.","refs":["CH_GB18_A_40:D7","CH_GB18_A_40:A17"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_51:FGS-B01","text":"Immediacy → finite and passive determinacy → apparent independence of inner, outer, and impulse.","refs":["CH_GB18_CD_3:FGS1","CH_GB18_A_40:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FGS-B02","text":"Apparent independence → negative unity → expression as the positing of the other by that which determines itself.","refs":["CH_GB18_CVLD:FGS2","CH_GB18_CD_3:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FGS-B03","text":"Posited externality → withdrawal into reflection → recoding of alien relation, passivity, and limit as its own mediation.","refs":["CH_GB18_CD_3:FGS5","CH_GB18_CD_3:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FGS-B04","text":"Reciprocal mediation → each side as the totality of itself and its other → transition from abstract unity of form to developed actuality.","refs":["CH_GB18_A_40:FGS4","CH_GB18_A_40:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FGS-B05","text":"Actuality → self-revelation of essence → spirit as a non-immediate structure of return.","refs":["CH_GB18_A_40:SD4","CH_GB18_A_40:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_51:AFM-B01","text":"Immediate force → external conditionedness → finite form.","refs":["CH_GB18_CD_3:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AFM-B02","text":"Finite form → sublation of externality → self-relation in the other.","refs":["CH_GB18_CD_3:FGS4","CH_GB18_CD_3:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AFM-B03","text":"Self-relation → relation of inner and outer → negative unity without fulfilled ground.","refs":["CH_GB18_CVLD:AF1","CH_GB18_CVLD:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AFM-B04","text":"Negative unity → opposition and reflection of form → reciprocal totality of the sides.","refs":["CH_GB18_A_40:FGS2","CH_GB18_A_40:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:AFM-B05","text":"Reciprocal totality → externality as self-revelation → actuality as identity of essence and appearance.","refs":["CH_GB18_A_40:FGS5","CH_GB18_A_40:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_51:MME-01","text":"The map of causality shifts from external influence to circular self-mediation.","refs":["CH_GB18_CD_3:ME5","CH_GB18_CD_3:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MME-02","text":"The map of limit shifts from an external barrier to a limitation generated through immediacy and transformable through mediation.","refs":["CH_GB18_CD_3:ME3","CH_GB18_CD_3:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MME-03","text":"The map of actuality shifts from hidden ground to accomplished self-revelation.","refs":["CH_GB18_A_40:ME6","CH_GB18_A_40:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MME-04","text":"The false alternative between inwardness and externality collapses, because each side is what it is in itself only through the other.","refs":["CH_GB18_A_40:D5","CH_GB18_A_40:A16"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_51:ALT-B01","text":"Surface level — The explicit object is the transition from force, inner, and outer to appearance, actuality, and spirit.","refs":["CH_GB18_A_40:ALT1","CH_GB18_A_40:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:ALT-B02","text":"Structural level — The supporting machine consists of negative unity, opposition, expression, return, and reciprocal totalization.","refs":["CH_GB18_A_40:ALT2","CH_GB18_CVLD:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:ALT-B03","text":"Metastrategic level — The system refuses the decision in favor of one side of the opposition and replaces it with an analysis of the conditions under which both sides reciprocally produce one another.","refs":["CH_GB18_CVLD:ALT3","CH_GB18_A_40:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:ALT-B04","text":"Ontological / Temporal level — Temporality appears as a development in which the actual becomes only by leaving its immediacy and taking it back in mediated form.","refs":["CH_GB18_A_40:ALT4","CH_GB18_CD_3:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:ALT-B05","text":"Methodological / Performative level — The exposition performs its thesis by converting every seemingly fixed object into a sequence of positing, reversal, and return.","refs":["CH_GB18_CVLD:FGS6","CH_GB18_A_40:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_51:FL-01","text":"The architecture requires a contentful foundation, yet simultaneously determines its relation of form as negative unity without a present identical ground.","refs":["CH_GB18_CVLD:A8","CH_GB18_CVLD:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FL-02","text":"Externality is simultaneously sublated and preserved; it may neither persist as an independent outside nor disappear as a dispensable semblance.","refs":["CH_GB18_CD_3:MRT6","CH_GB18_CVLD:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:FL-03","text":"Totality is lacking to the immediate relation, yet is nevertheless already ascribed to its determinations as their inner truth.","refs":["CH_GB18_A_40:MRT5","CH_GB18_A_40:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MP-01","text":"Force mutates in the transition from externally conditioned activity to the self-positing of its conditions.","refs":["CH_GB18_CD_3:SD5","CH_GB18_CD_3:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MP-02","text":"Identity mutates in the transition from substantial foundation to mere reversal of form and finally to the unity of appearance and essence.","refs":["CH_GB18_CVLD:SD2","CH_GB18_A_40:D9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MP-03","text":"Spirit marks the terminal mutation point at which the return from externality is no longer merely a process of force, but the shape of actuality itself.","refs":["CH_GB18_A_40:FGS7","CH_GB18_A_40:SD6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_51:HSI-01","text":"Reality appears as a machine of self-expression that does not find its outer spaces ready-made, but produces them as necessary conditions of its return.","refs":["CH_GB18_CD_3:SD1","CH_GB18_A_40:A17"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:HSI-02","text":"The subject appears as a relation that possesses itself only by losing itself in its other and returning there to itself as mediated.","refs":["CH_GB18_CD_3:A9","CH_GB18_A_40:A16"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:HSI-03","text":"Time appears not as a succession of external states, but as the developmental logic of posited, negated, and withdrawn immediacy.","refs":["CH_GB18_A_40:SD5","CH_GB18_A_40:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:HSI-04","text":"What remains possible is no struggle against an absolutely external counterpart, but only the navigation of those mediations in which alienness becomes effective as its own condition.","refs":["CH_GB18_CD_3:SD3","CH_GB18_CVLD:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_51:MRT-B01","text":"The global axioms suffice to reconstruct the transition from finite force through negative unity and reciprocal mediation to actuality as self-revelation.","refs":["CH_GB18_CD_3:MRT1","CH_GB18_A_40:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MRT-B02","text":"The reconstruction remains coherent only if sublation is understood as preservative transformation and not as the annihilation of externality.","refs":["CH_GB18_CD_3:MRT3","CH_GB18_A_40:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MRT-B03","text":"The mediation between the absolute thing as foundation and the contentless point of the pure relation of form remains underdetermined.","refs":["CH_GB18_CVLD:MRT3","CH_GB18_CVLD:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_51:MRT-B04","text":"The architecture is strongest where it demonstrates external impulse, appearance, and limit to be internal effects of a self-mediation; yet it depends indispensably on the sequenced escalation of its concepts.","refs":["CH_GB18_CD_3:MRT5","CH_GB18_A_40:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_51@R001","source_variant_id":"canonical:CL_GB18_51:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 151–153","context":"c. Die Unendlichkeit der Kraft. · C. Verhältniß des Äußern und Innern. · Anmerkung."},"title_language_code":"en"},{"id":"CL_GB18_52","layer":"CL","title":"Chapters 154–156","order":52,"parents":["CH_GB18_DADW","CH_GB18_DADA","CH_GB18_BDAA"],"revision":"CL_GB18_52@R001","sha256":"608950e579048be853e76eb3c7c732bd0e21173d950294a4302a3bd83df72296","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_52:BAS-01","text":"Das Cluster bestimmt Wirklichkeit und Absolutes als Problem einer Einheit, die Differenz hervorbringen muss, ohne sie als selbständige Gegenwirklichkeit zuzulassen.","refs":["CH_GB18_DADW:AS1","CH_GB18_DADA:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BAS-02","text":"Die Wirklichkeit entsteht als Einheit von Wesen und Existenz, deren Vermittlung die Existenz zur Erscheinung formiert und Differenz als immanenten Prozess statt als ontologische Trennung auslegt.","refs":["CH_GB18_DADW:AS2","CH_GB18_DADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BAS-03","text":"Die Auslegung des Absoluten verschiebt Erkenntnis von äußerer Prädikation zu einer Selbstbewegung, in der jede Bestimmtheit nur als transparenter, in seinen Grund rückkehrender Schein gilt.","refs":["CH_GB18_DADA:AS4","CH_GB18_DADA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BAS-04","text":"Das Attribut wird zur notwendigen, aber nicht selbständigen Form, in der die Totalität des Absoluten erscheint und zugleich die Geltung jeder formalen Bestimmung widerruft.","refs":["CH_GB18_BDAA:A3","CH_GB18_BDAA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BAS-05","text":"Die Bewegung ist rekursiv: äußerliche Reflexion wird als innere Rückkehr absorbiert, erzeugt attributive Form und zeigt in deren Selbstaufhebung die fortbestehende Schwierigkeit einer nichtäußerlichen Bestimmung.","refs":["CH_GB18_DADA:A11","CH_GB18_BDAA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BAS-06","text":"Die Schließung bleibt negativ-operativ: Das Absolute besitzt keine stabile positive Form neben seinen Bestimmungen, sondern existiert als Selbstverhältnis, das die Selbständigkeit seiner Formen aufhebt.","refs":["CH_GB18_BDAA:A15","CH_GB18_BDAA:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_52:GA-01","text":"[Persistent] Wirklichkeit und Absolutes sind keine Zusammensetzungen getrennter Elemente, sondern Einheiten, in denen Wesen, Existenz und Bestimmung ihren Wahrheitsstatus nur als Momente einer Totalität besitzen.","refs":["CH_GB18_DADW:A1","CH_GB18_DADA:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-02","text":"[Mutating] Form mutiert von der Bestimmung der Existenz über die Erscheinung zur Transparenz des Scheins und schließlich zur selbstaufhebenden attributiven Form.","refs":["CH_GB18_DADW:A5","CH_GB18_DADA:A6","CH_GB18_BDAA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-03","text":"[Persistent] Inneres und Äußeres bezeichnen keine getrennten Bereiche, sondern identische Inhalts- und Formgrundlagen, deren Unterschied nur als Reflexionsdifferenz besteht.","refs":["CH_GB18_DADW:A8","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-04","text":"[Emergent] Äußerliche Reflexion ist kein außerhalb des Absoluten verbleibender Erkenntnisakt, sondern ein negatives Moment seiner Selbstbeziehung.","refs":["CH_GB18_DADW:A14","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-05","text":"[Attractor] Totalität ist das einzige wahre Bestehen; Bestimmungen, Seiten und Formen dürfen nur bestehen, sofern sie ihre Eigenständigkeit an die Totalität verlieren.","refs":["CH_GB18_BDAA:A6","CH_GB18_BDAA:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-06","text":"[Mutating] Erscheinung und Schein sind keine bloßen Defizite des Seins, sondern Vermittlungsformen, in denen Bestimmtheit sichtbar wird, indem sie ihre Selbständigkeit preisgibt.","refs":["CH_GB18_DADW:D2","CH_GB18_DADA:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-07","text":"[Terminal] Das Attribut enthält den ganzen absoluten Inhalt, kann aber gerade deshalb nicht als eigenständige Bestimmung oder positive Eigenschaft des Absoluten bestehen bleiben.","refs":["CH_GB18_BDAA:A5","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-08","text":"[Mutating] Die Rückkehr der Reflexion zur Identität ist notwendig, aber nicht hinreichend: Sie löscht Unterschiede aus, ohne die Äußerlichkeit der Reflexionsoperation vollständig zu überwinden.","refs":["CH_GB18_BDAA:A13","CH_GB18_BDAA:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-09","text":"[Attractor] Das Absolute duldet keine positive Bestimmtheit, die sich ihm gegenüber selbständig erhält; jede Bestimmung muss als aufgehobene Form seiner eigenen Erscheinung lesbar werden.","refs":["CH_GB18_DADA:NX1","CH_GB18_BDAA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-10","text":"[Emergent] Substantialität wird nicht als ruhender Träger, sondern als operative Selbstbeziehung verständlich, in der Auslegung, Reflexion und Form auf ihren absoluten Grund zurückgenommen werden.","refs":["CH_GB18_DADW:A17","CH_GB18_DADA:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_52:RMD-01","text":"Die Einheit von Wesen und Existenz bleibt als stabile Grundfigur erhalten, erweitert sich jedoch zur Einheit von Seyn, Wesen, Innerem und Äußerem als absoluten Totalitäten.","refs":["CH_GB18_DADW:A1","CH_GB18_DADA:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RMD-02","text":"Erscheinung mutiert zum Schein: Was zunächst die formierte Existenz vermittelt, wird im Absoluten zur durchsichtigen Weise des Verschwindens endlicher Selbständigkeit.","refs":["CH_GB18_DADW:A5","CH_GB18_DADA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RMD-03","text":"Die Differenz von Innerem und Äußerem wandert von einer Struktur des Wirklichen zu einem Kriterium der Auslegung: Das Äußere wird gerade kraft seiner Äußerlichkeit als inneres Moment lesbar.","refs":["CH_GB18_DADW:A8","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RMD-04","text":"Form verschiebt ihre Funktion von der positiven Gestaltung der Existenz zu einer negativen Bestimmung, deren Wirklichkeit nur im eigenen Übergang zum Schein liegt.","refs":["CH_GB18_DADW:A4","CH_GB18_BDAA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RMD-05","text":"Reflexion mutiert von negativer Rückkehr des Absoluten in sich zu einer Grenze der absoluten Bestimmung, weil ihre Rückkehr abstrakte Identität erzeugt und ihre Äußerlichkeit nicht vollständig tilgt.","refs":["CH_GB18_DADW:A14","CH_GB18_BDAA:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RMD-06","text":"Das Absolute erscheint zunächst als Einheit, wird dann als eigene Auslegung bestimmt und endet im Attribut als Form, die seine Totalität zeigt, aber keine bleibende Eigenform besitzt.","refs":["CH_GB18_DADW:A12","CH_GB18_BDAA:A3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_52:CGD-01","text":"Die genaue Sequenz von Grund, Existenz und Erscheinung bleibt eine lokale Vermittlungsmechanik; auf Clusterebene bleibt davon die übergreifende Regel, dass jede Differenz nur durch vermittelte Form Wirklichkeit erhält.","refs":["CH_GB18_DADW:AS3","CH_GB18_DADW:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:CGD-02","text":"Die Trias von Wirklichkeit, Möglichkeit und Notwendigkeit bleibt als konkrete Modalgliederung lokal, während ihre clusterskalige Funktion darin besteht, jede starre Unmittelbarkeit in ein Selbstverhältnis des Absoluten zu überführen.","refs":["CH_GB18_DADW:A15","CH_GB18_DADW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:CGD-03","text":"Die Möglichkeit mehrerer Attribute bleibt lokal unterbestimmt; auf Clusterebene skaliert allein der Ausschluss, mehrere Attribute als selbständige absolute Zentren zu lesen.","refs":["CH_GB18_BDAA:D2","CH_GB18_BDAA:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:CGD-04","text":"Die Bestimmung der Substanz als Selbstverhältnis und die Bestimmung des Attributs als Totalitätsform werden im Cluster zu einer gemeinsamen Regel: Das Absolute ist nur als Rücknahme jeder selbständigen Form in seine Totalität bestimmt.","refs":["CH_GB18_DADW:D9","CH_GB18_BDAA:A6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_52:GNX-01","text":"Ausgeschlossen ist eine Wirklichkeit, in der Wesen und Erscheinung als getrennte positive Seinsregionen fortbestehen.","refs":["CH_GB18_DADW:NX1","CH_GB18_DADA:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GNX-02","text":"Ausgeschlossen ist eine dauerhafte Zweiteilung von Innerem und Äußerem, Inhalt und Form oder Grund und Erscheinung.","refs":["CH_GB18_DADW:NX4","CH_GB18_DADA:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GNX-03","text":"Ausgeschlossen ist ein Endliches, das dem Absoluten gegenüber einen eigenen ontologischen Bestand oder einen positiven Eigengrund beanspruchen könnte.","refs":["CH_GB18_DADA:DNX2","CH_GB18_BDAA:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GNX-04","text":"Ausgeschlossen ist eine Erkenntnisposition, die dem Absoluten äußerlich bliebe und es durch Prädikation, Zuschreibung oder Sammlung endlicher Bestimmungen feststellen könnte.","refs":["CH_GB18_DADA:DNX3","CH_GB18_DADW:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GNX-05","text":"Ausgeschlossen ist eine bestimmte positive Form des Absoluten, die zugleich bestimmt, nichtäußerlich und nicht selbstaufhebend wäre.","refs":["CH_GB18_BDAA:SNX1","CH_GB18_BDAA:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_52:DBN-01","text":"Das System verwirft jeden absoluten Außenstandpunkt, weil die Operation des Auslegens nur als Selbstbewegung dessen gültig sein kann, was ausgelegt wird.","refs":["CH_GB18_DADA:SNX1","CH_GB18_DADA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:DBN-02","text":"Das System verwirft ein Absolutes als vorgegebenes Substrat oder Behältnis, das seinen Erscheinungen ontologisch vorausläge und sie bloß trüge.","refs":["CH_GB18_DADA:DNX1","CH_GB18_BDAA:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:DBN-03","text":"Das System verwirft eine Vermittlung, die den absoluten Inhalt darstellen könnte, ohne ihre eigene Selbständigkeit und Formgeltung aufzuheben.","refs":["CH_GB18_BDAA:DNX4","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:DBN-04","text":"Das System verwirft ein positives Absolutes ohne Negativität, weil absolute Einheit nur durch die Rücknahme und Entselbständigung ihrer eigenen Differenzen bestimmt werden kann.","refs":["CH_GB18_DADA:SNX3","CH_GB18_BDAA:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_52:BSA-01","text":"Unverfügbar bleibt eine Form absoluter Bestimmtheit, die weder äußerlich noch selbstaufhebend wäre; diese Abwesenheit organisiert die fortgesetzte Negativität des Systems.","refs":["CH_GB18_BDAA:SNX1","CH_GB18_BDAA:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BSA-02","text":"Unzulässig ist die Koexistenz absoluter Identität mit einer irreduziblen, selbstbeständigen Differenz, weil jede Differenz nur als aufgehobene Differenz gelten darf.","refs":["CH_GB18_DADA:SNX2","CH_GB18_BDAA:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BSA-03","text":"Versperrt ist eine vollendete Erkenntnis des Absoluten als Gegenstand, weil jede äußerliche positive Auslegung in die Selbstauslegung des Absoluten zurückgenommen werden muss.","refs":["CH_GB18_DADA:SNX1","CH_GB18_DADA:NX7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_52:XD-01","text":"Die Einheit von Wesen und Existenz wird durch die Totalitätslogik des Attributs verschärft: Wirklichkeit ist nicht Versöhnung zweier Seiten, sondern die Entmächtigung ihrer selbständigen Geltung.  ; Trace Type — Composite","refs":["CL_GB18_52:GA-01","CL_GB18_52:GA-05","CH_GB18_DADW:A1","CH_GB18_BDAA:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_52:XD-02","text":"Die Auslegung des Absoluten transformiert äußerliche Erkenntnis in eine ontologische Funktion: Auslegung ist nur gültig, wenn sie ihre eigene Stellung als äußere Reflexion zurücknimmt.  ; Trace Type — Tension","refs":["CL_GB18_52:GA-03","CL_GB18_52:GA-04","CH_GB18_DADA:AS4","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_52:XD-03","text":"Das Attribut bildet eine notwendige Doppelbindung: Es muss den ganzen Inhalt des Absoluten ausdrücken und verliert genau dadurch den Status einer selbständigen positiven Bestimmung.  ; Trace Type — Tension","refs":["CL_GB18_52:GA-05","CL_GB18_52:GA-07","CH_GB18_BDAA:A5","CH_GB18_BDAA:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_52:XD-04","text":"Form besitzt nur funktionale Realität: Sie ermöglicht Erscheinung und Bestimmung, kann aber keinen eigenen Seinsgrund beanspruchen und muss als negativer Schein vergehen.  ; Trace Type — Composite","refs":["CL_GB18_52:GA-02","CL_GB18_52:GA-06","CH_GB18_DADW:D2","CH_GB18_BDAA:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_52:XD-05","text":"Substanz wird zur Bezeichnung einer Selbstschließung, in der die Reflexion nicht mehr ein Verhältnis zwischen Termen bildet, sondern die Bewegung ihrer eigenen Rücknahme vollzieht.  ; Trace Type — Composite","refs":["CL_GB18_52:GA-04","CL_GB18_52:GA-10","CH_GB18_DADW:A17","CH_GB18_DADA:SD5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_52:BSD-01","text":"Die Kritik äußerlicher Erkenntnis ist nicht epistemische Vorbemerkung, sondern Ontologie: Eine Erkenntnisform ist falsch, sofern sie ihren Gegenstand als außerhalb seiner eigenen Selbstbewegung behandelt.","refs":["CH_GB18_DADA:DNX3","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BSD-02","text":"Die Zeitstruktur des Systems ist retrospektiv: Was zunächst als selbständige Bestimmung auftritt, erhält seine Wahrheit erst nachträglich im Rückgang auf die Totalität.","refs":["CH_GB18_DADA:SD3","CH_GB18_DADW:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BSD-03","text":"Die Ontologie wird asymmetrisch organisiert: Totalität kann sich in Formen zeigen, aber Formen können die Totalität weder begründen noch als eigenständige Realität ersetzen.","refs":["CH_GB18_BDAA:A6","CH_GB18_BDAA:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BSD-04","text":"Die methodische Konsequenz besteht in einer immanenten Lektüre, die Kategorien nicht als stabile Gegenstände sammelt, sondern ihre Selbstauflösung und ihren Rückgang auf den Grund verfolgt.","refs":["CH_GB18_DADA:ALT3","CH_GB18_DADA:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_52:RLE-01","text":"Die erste Schleife führt von grundvermittelter Existenz über Erscheinung und Reflexion zur Wirklichkeit zurück, in der die anfängliche Unmittelbarkeit als vermitteltes Moment lesbar wird.","refs":["CH_GB18_DADW:A3","CH_GB18_DADW:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RLE-02","text":"Die zweite Schleife verwandelt äußerliche Reflexion in innere Selbstbewegung, indem die Opposition von Beobachtung und Gegenstand als Differenz innerhalb der absoluten Einheit kollabiert.","refs":["CH_GB18_DADW:A13","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RLE-03","text":"Die attributive Schleife erzeugt Form nur, um ihre Nichtselbständigkeit sichtbar zu machen: Form wird gesetzt, totalisiert, zum Schein reduziert und in die einfache Identität zurückgenommen.","refs":["CH_GB18_BDAA:FGS1","CH_GB18_BDAA:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RLE-04","text":"Der zentrale Attraktor ist die Totalität, zu der Wesen, Existenz, Erscheinung, Reflexion und Attribut zurückkehren, ohne ihre Differenz als positive Gegenmacht bewahren zu dürfen.","refs":["CH_GB18_BDAA:AS4","CH_GB18_BDAA:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_52:FGS-B01","text":"Grundvermittelte Existenz → Formbestimmung → Erscheinung → Reflexion: Unmittelbarkeit wird nur als bereits vermittelte Bestimmung wirklich.","refs":["CH_GB18_DADW:A3","CH_GB18_DADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FGS-B02","text":"Reflexion-in-Anderes → Reflexion-in-sich → Inneres und Äußeres: Differenz entsteht, aber nur auf identischer Inhalts- und Formgrundlage.","refs":["CH_GB18_DADW:A6","CH_GB18_DADW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FGS-B03","text":"Identität von Inhalt und Form → Aufhebung der Formverschiedenheit → absolute Wirklichkeit: Die Differenz verliert ihren Status als selbständige Bestimmung.","refs":["CH_GB18_DADW:A10","CH_GB18_DADW:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FGS-B04","text":"Äußere Prädikation → Negation endlicher Bestimmungen → abstrakte Leere → Einheit von Seyn und Wesen: Das Absolute kann nicht als bloß prädikatloses Jenseits bestimmt werden.","refs":["CH_GB18_DADA:AS2","CH_GB18_DADA:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FGS-B05","text":"Absolute Einheit von Form und Inhalt → Transparenz aller Bestimmtheit → Attribut als ganzer Inhalt: Das Absolute erscheint nur in Formen, die keine autonome Realität gewinnen.","refs":["CH_GB18_DADA:A6","CH_GB18_BDAA:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FGS-B06","text":"Attributive Totalität → Aufhebung der Form → abstrakte Identität mit Äußerlichkeitsrest: Die Maschine schließt sich negativ und produziert ihre nächste Instabilität aus der eigenen Schließung.","refs":["CH_GB18_BDAA:A12","CH_GB18_BDAA:A13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_52:AFM-B01","text":"Unverbundenes Wesen und haltlose Erscheinung → Einheit von Wesen und Existenz → Wirklichkeit als vermittelte Totalität.","refs":["CH_GB18_DADW:A2","CH_GB18_DADW:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:AFM-B02","text":"Wirklichkeit → Identität von Innerem und Äußerem → absolute Wirklichkeit als Aufhebung selbständiger Formdifferenz.","refs":["CH_GB18_DADW:A8","CH_GB18_DADW:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:AFM-B03","text":"Äußerliche Prädikation → negative Leere → Unzulänglichkeit abstrakter Identität → Forderung nach Selbstauslegung des Absoluten.","refs":["CH_GB18_DADA:AS2","CH_GB18_DADA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:AFM-B04","text":"Einheit von Seyn und Wesen → Transparenz der Bestimmungen → Endlichkeit als nichtselbständiger Schein.","refs":["CH_GB18_DADA:A3","CH_GB18_DADA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:AFM-B05","text":"Attribut als Form des ganzen Inhalts → Totalität als einziges Bestehen → Selbstaufhebung der attributiven Form.","refs":["CH_GB18_BDAA:A5","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:AFM-B06","text":"Rückkehr zur Identität → Fortbestand der Äußerlichkeit → negative Offenhaltung der Frage nach einer nichtäußerlichen absoluten Form.","refs":["CH_GB18_BDAA:A13","CH_GB18_BDAA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_52:MME-01","text":"Wirklichkeit wird von einem Zustand oder Gegenstandsbereich zu einer Formbewegung umkartiert, in der Wesen und Existenz nur in ihrer Einheit wahr sind.","refs":["CH_GB18_DADW:ME1","CH_GB18_DADW:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MME-02","text":"Erscheinung wird von bloßer Oberfläche zu einer notwendigen Vermittlung umklassifiziert, während Schein die spätere Gestalt derselben Vermittlung unter Bedingungen absoluter Totalisierung bezeichnet.","refs":["CH_GB18_DADW:ME3","CH_GB18_DADA:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MME-03","text":"Die Gegenüberstellung von Innerem und Äußerem verliert ihren ontologischen Vorrang und wird zu einer selbstaufhebenden Differenz der Reflexion.","refs":["CH_GB18_DADW:ME2","CH_GB18_DADA:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MME-04","text":"Substanz und Attribut werden von Träger- und Eigenschaftsbegriffen zu Übergangsfiguren einer Totalität verschoben, in der nur das Selbstverhältnis des Absoluten Bestand besitzt.","refs":["CH_GB18_DADW:ME6","CH_GB18_BDAA:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MME-05","text":"Negation wird nicht als bloße Tilgung, sondern als Kartierungsoperation bestimmt, die Differenzen erhält, indem sie ihre Selbständigkeit in aufgehobenen Schein überführt.","refs":["CH_GB18_DADA:SD4","CH_GB18_BDAA:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_52:ALT-B01","text":"Oberflächenebene — Wirklichkeit, Absolutes, Erscheinung, Reflexion und Attribut bilden die expliziten Gegenstände, durch die das System die Möglichkeit absoluter Bestimmung prüft.","refs":["CH_GB18_DADW:A1","CH_GB18_BDAA:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:ALT-B02","text":"Strukturebene — Die wiederkehrende Maschine besteht aus Formierung, Reflexion, Totalisierung und Rücknahme, durch die jede Bestimmung nur als abhängig von ihrem Grund gilt.","refs":["CH_GB18_DADW:A14","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:ALT-B03","text":"Metastrategische Ebene — Auslegung wird von einer äußeren Methode in eine immanente Operation umgewandelt, die ihre eigenen Voraussetzungen als Formen des Gegenstands zurücknimmt.","refs":["CH_GB18_DADA:ALT3","CH_GB18_DADA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:ALT-B04","text":"Ontologisch-temporale Ebene — Realität ist Rückkehr und retrospektive Vermittlung, während im Absoluten selbst kein eigenständiges Werden als positive Seinsweise zugelassen wird.","refs":["CH_GB18_DADW:ALT4","CH_GB18_DADA:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:ALT-B05","text":"Methodologisch-performative Ebene — Die Darstellung vollzieht ihre Behauptung, indem sie jede äußere Feststellung des Absoluten in eine Bewegung des Sich-Aufhebens und Sich-Zurücknehmens verwandelt.","refs":["CH_GB18_DADA:A8","CH_GB18_DADA:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_52:FL-01","text":"Das System behauptet, im Absoluten sei kein Werden, bestimmt dessen Auslegung aber zugleich als eigenes Tun mit immanenter Bewegungsstruktur.","refs":["CH_GB18_DADA:NX5","CH_GB18_DADA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FL-02","text":"Das Attribut soll den ganzen Inhalt und das wahre Bestehen des Absoluten enthalten, bleibt aber zugleich relative, unwesentliche und nichtige Form.","refs":["CH_GB18_BDAA:A6","CH_GB18_BDAA:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FL-03","text":"Reflexion ist als negative Rückkehr des Absoluten erforderlich, bleibt in ihrer Rückkehr zur Identität jedoch mit einem Rest äußerlicher Abstraktion belastet.","refs":["CH_GB18_DADW:A14","CH_GB18_BDAA:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MP-01","text":"Erscheinung mutiert dort zum Schein, wo die Vermittlung der Existenz nicht mehr als positive Wirklichkeit, sondern als Transparenz und Aufhebbarkeit jeder Bestimmung funktioniert.","refs":["CH_GB18_DADW:A5","CH_GB18_DADA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MP-02","text":"Äußerliche Reflexion mutiert dort zur inneren Reflexion, wo ihre Gegenstellung zum Absoluten als Moment der absoluten Einheit umcodiert wird.","refs":["CH_GB18_DADW:A13","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MP-03","text":"Form mutiert von der Gleichheit mit dem Inhalt zur unwesentlichen Erscheinungsweise, sobald sie als attributive Form keine selbständige Bestimmung mehr tragen darf.","refs":["CH_GB18_BDAA:A2","CH_GB18_BDAA:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_52:HSI-01","text":"Die Realität erscheint als Maschine der Totalisierung: Sie erzeugt Formen ihrer eigenen Sichtbarkeit, lässt diese Formen wirken und entzieht ihnen im selben Vollzug jeden unabhängigen Seinsstatus.","refs":["CH_GB18_DADW:SD1","CH_GB18_BDAA:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:HSI-02","text":"Eine stabile Erkenntnisinstanz außerhalb des Systems wird nicht begründet; die Stelle des Auslegens erscheint nur als verschwindende Reflexionsfunktion innerhalb der Bewegung des Absoluten.","refs":["CH_GB18_DADA:SNX1","CH_GB18_DADA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:HSI-03","text":"Zeit erscheint als rückläufige Vermittlungszeit: Bestimmungen werden erst in ihrem Rückgang auf den Grund wahr, während das Absolute selbst kein zeitlich werdendes Objekt ist.","refs":["CH_GB18_DADA:SD3","CH_GB18_DADA:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:HSI-04","text":"Handlungsmacht besteht nur als immanente Operation der Entselbständigung: Formen können auftreten, unterscheiden und vermitteln, aber nicht als autonome Träger verbleiben.","refs":["CH_GB18_BDAA:A12","CH_GB18_DADA:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_52:MRT-B01","text":"Die Axiome reichen aus, um die clusterskalige Bewegung von Wirklichkeit über absolute Selbstauslegung zur Selbstaufhebung des Attributs als einheitliche Negativitätsmaschine zu rekonstruieren.","refs":["CH_GB18_DADW:MRT1","CH_GB18_BDAA:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MRT-B02","text":"Unterbestimmt bleiben die positive Vermittlung der Modalitäten sowie die Bestimmung einer möglichen Vielheit von Attributen jenseits ihrer Rücknahme in denselben absoluten Inhalt.","refs":["CH_GB18_DADW:MRT2","CH_GB18_BDAA:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MRT-B03","text":"Die Architektur ist kohärent, sofern Aufhebung nicht als Auslöschung, sondern als Erhaltung einer Differenz in der Form ihrer Nichtselbständigkeit verstanden wird.","refs":["CH_GB18_DADW:MRT3","CH_GB18_BDAA:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MRT-B04","text":"Die stärkste und zugleich irreduzible Spannung bleibt die Notwendigkeit einer Form, die das Absolute erscheinen lässt, obwohl diese Form keinen eigenständigen ontologischen Bestand besitzen darf.","refs":["CH_GB18_DADA:MRT4","CH_GB18_BDAA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T122950426782Z_aa8a029d","language_code":"en","language_name":"English","title":"Chapters 154–156","source_sha256":"608950e579048be853e76eb3c7c732bd0e21173d950294a4302a3bd83df72296","sha256":"ffb9d5151922d82ca4d24cb0b07e20d2ed0b9a31306e5487230d4498a8f8f068","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:29:50.427766+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_52:BAS-01","text":"The cluster determines reality and the Absolute as the problem of a unity that must produce difference without permitting it as an independent counter-reality.","refs":["CH_GB18_DADW:AS1","CH_GB18_DADA:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BAS-02","text":"Reality arises as the unity of essence and existence, whose mediation forms existence into appearance and interprets difference as an immanent process rather than as an ontological separation.","refs":["CH_GB18_DADW:AS2","CH_GB18_DADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BAS-03","text":"The interpretation of the Absolute shifts cognition from external predication to a self-movement in which every determinacy counts only as a transparent semblance returning into its ground.","refs":["CH_GB18_DADA:AS4","CH_GB18_DADA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BAS-04","text":"The attribute becomes the necessary but not independent form in which the totality of the Absolute appears and at the same time revokes the validity of every formal determination.","refs":["CH_GB18_BDAA:A3","CH_GB18_BDAA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BAS-05","text":"The movement is recursive: external reflection is absorbed as internal return, produces attributive form, and shows in its self-sublation the continuing difficulty of a non-external determination.","refs":["CH_GB18_DADA:A11","CH_GB18_BDAA:A13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BAS-06","text":"The closure remains negative-operative: the Absolute possesses no stable positive form alongside its determinations, but exists as a self-relation that sublates the independence of its forms.","refs":["CH_GB18_BDAA:A15","CH_GB18_BDAA:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_52:GA-01","text":"[Persistent] Reality and the Absolute are not composites of separate elements, but unities in which essence, existence, and determination possess their truth-status only as moments of a totality.","refs":["CH_GB18_DADW:A1","CH_GB18_DADA:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-02","text":"[Mutating] Form mutates from the determination of existence through appearance to the transparency of semblance, and finally to self-sublating attributive form.","refs":["CH_GB18_DADW:A5","CH_GB18_DADA:A6","CH_GB18_BDAA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-03","text":"[Persistent] Inner and outer designate no separate regions, but identical foundations of content and form, whose difference exists only as a difference of reflection.","refs":["CH_GB18_DADW:A8","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-04","text":"[Emergent] External reflection is not an act of cognition remaining outside the Absolute, but a negative moment of its self-relation.","refs":["CH_GB18_DADW:A14","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-05","text":"[Attractor] Totality is the sole true subsistence; determinations, sides, and forms may subsist only insofar as they lose their independence to totality.","refs":["CH_GB18_BDAA:A6","CH_GB18_BDAA:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-06","text":"[Mutating] Appearance and semblance are not mere deficits of being, but forms of mediation in which determinacy becomes visible by surrendering its independence.","refs":["CH_GB18_DADW:D2","CH_GB18_DADA:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-07","text":"[Terminal] The attribute contains the entire absolute content, but precisely for that reason cannot remain as an independent determination or positive property of the Absolute.","refs":["CH_GB18_BDAA:A5","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-08","text":"[Mutating] The return of reflection to identity is necessary but not sufficient: it erases differences without fully overcoming the externality of the operation of reflection.","refs":["CH_GB18_BDAA:A13","CH_GB18_BDAA:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-09","text":"[Attractor] The Absolute tolerates no positive determinacy that maintains itself independently over against it; every determination must become legible as a sublated form of its own appearance.","refs":["CH_GB18_DADA:NX1","CH_GB18_BDAA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GA-10","text":"[Emergent] Substantiality is understood not as a resting bearer, but as an operative self-relation in which interpretation, reflection, and form are taken back into their absolute ground.","refs":["CH_GB18_DADW:A17","CH_GB18_DADA:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_52:RMD-01","text":"The unity of essence and existence remains preserved as a stable basic configuration, but expands into the unity of Seyn, essence, inner, and outer as absolute totalities.","refs":["CH_GB18_DADW:A1","CH_GB18_DADA:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RMD-02","text":"Appearance mutates into semblance: what initially mediates formed existence becomes, in the Absolute, the transparent mode of the disappearance of finite independence.","refs":["CH_GB18_DADW:A5","CH_GB18_DADA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RMD-03","text":"The difference between inner and outer migrates from a structure of the real to a criterion of interpretation: the outer becomes legible as an inner moment precisely by virtue of its externality.","refs":["CH_GB18_DADW:A8","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RMD-04","text":"Form shifts its function from the positive configuration of existence to a negative determination whose reality lies only in its own transition into semblance.","refs":["CH_GB18_DADW:A4","CH_GB18_BDAA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RMD-05","text":"Reflection mutates from the negative return of the Absolute into itself into a limit of absolute determination, because its return produces abstract identity and does not fully efface its externality.","refs":["CH_GB18_DADW:A14","CH_GB18_BDAA:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RMD-06","text":"The Absolute first appears as unity, is then determined as its own interpretation, and ends in the attribute as a form that shows its totality but possesses no enduring form of its own.","refs":["CH_GB18_DADW:A12","CH_GB18_BDAA:A3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_52:CGD-01","text":"The precise sequence of ground, existence, and appearance remains a local mechanics of mediation; at the cluster level, what remains is the overarching rule that every difference acquires reality only through mediated form.","refs":["CH_GB18_DADW:AS3","CH_GB18_DADW:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:CGD-02","text":"The triad of reality, possibility, and necessity remains local as a concrete modal articulation, whereas its cluster-scale function consists in transforming every rigid immediacy into a self-relation of the Absolute.","refs":["CH_GB18_DADW:A15","CH_GB18_DADW:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:CGD-03","text":"The possibility of several attributes remains locally underdetermined; at the cluster level, only the exclusion of reading several attributes as independent absolute centers scales.","refs":["CH_GB18_BDAA:D2","CH_GB18_BDAA:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:CGD-04","text":"The determination of substance as self-relation and the determination of the attribute as a form of totality become, in the cluster, a common rule: the Absolute is determined only as the withdrawal of every independent form into its totality.","refs":["CH_GB18_DADW:D9","CH_GB18_BDAA:A6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_52:GNX-01","text":"Excluded is a reality in which essence and appearance persist as separate positive regions of being.","refs":["CH_GB18_DADW:NX1","CH_GB18_DADA:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GNX-02","text":"Excluded is an enduring bifurcation of inner and outer, content and form, or ground and appearance.","refs":["CH_GB18_DADW:NX4","CH_GB18_DADA:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GNX-03","text":"Excluded is a finite entity that could claim, over against the Absolute, an ontological subsistence of its own or a positive ground of its own.","refs":["CH_GB18_DADA:DNX2","CH_GB18_BDAA:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GNX-04","text":"Excluded is a position of cognition that would remain external to the Absolute and could establish it through predication, attribution, or the collection of finite determinations.","refs":["CH_GB18_DADA:DNX3","CH_GB18_DADW:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:GNX-05","text":"Excluded is a determinate positive form of the Absolute that would at once be determinate, non-external, and non-self-sublating.","refs":["CH_GB18_BDAA:SNX1","CH_GB18_BDAA:DNX4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_52:DBN-01","text":"The system rejects every absolute external standpoint, because the operation of interpretation can be valid only as the self-movement of that which is interpreted.","refs":["CH_GB18_DADA:SNX1","CH_GB18_DADA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:DBN-02","text":"The system rejects an Absolute as a given substrate or container that would ontologically precede its appearances and merely bear them.","refs":["CH_GB18_DADA:DNX1","CH_GB18_BDAA:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:DBN-03","text":"The system rejects a mediation that could present absolute content without sublating its own independence and formal validity.","refs":["CH_GB18_BDAA:DNX4","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:DBN-04","text":"The system rejects a positive Absolute without negativity, because absolute unity can be determined only through the withdrawal and deprivation of independence of its own differences.","refs":["CH_GB18_DADA:SNX3","CH_GB18_BDAA:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_52:BSA-01","text":"Unavailable remains a form of absolute determinacy that would be neither external nor self-sublating; this absence organizes the system's continuing negativity.","refs":["CH_GB18_BDAA:SNX1","CH_GB18_BDAA:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BSA-02","text":"Impermissible is the coexistence of absolute identity with an irreducible, self-subsistent difference, because every difference may count only as a sublated difference.","refs":["CH_GB18_DADA:SNX2","CH_GB18_BDAA:DNX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BSA-03","text":"Barred is a completed cognition of the Absolute as an object, because every external positive interpretation must be taken back into the self-interpretation of the Absolute.","refs":["CH_GB18_DADA:SNX1","CH_GB18_DADA:NX7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_52:XD-01","text":"The unity of essence and existence is sharpened by the logic of totality of the attribute: reality is not the reconciliation of two sides, but the disempowerment of their independent validity.  ; Trace Type — Composite","refs":["CL_GB18_52:GA-01","CL_GB18_52:GA-05","CH_GB18_DADW:A1","CH_GB18_BDAA:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_52:XD-02","text":"The interpretation of the Absolute transforms external cognition into an ontological function: interpretation is valid only if it withdraws its own position as external reflection.  ; Trace Type — Tension","refs":["CL_GB18_52:GA-03","CL_GB18_52:GA-04","CH_GB18_DADA:AS4","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_52:XD-03","text":"The attribute constitutes a necessary double bind: it must express the entire content of the Absolute and thereby loses precisely the status of an independent positive determination.  ; Trace Type — Tension","refs":["CL_GB18_52:GA-05","CL_GB18_52:GA-07","CH_GB18_BDAA:A5","CH_GB18_BDAA:A8"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_52:XD-04","text":"Form possesses only functional reality: it enables appearance and determination, but can claim no ground of being of its own and must pass away as negative semblance.  ; Trace Type — Composite","refs":["CL_GB18_52:GA-02","CL_GB18_52:GA-06","CH_GB18_DADW:D2","CH_GB18_BDAA:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_52:XD-05","text":"Substance becomes the designation of a self-closure in which reflection no longer forms a relation between terms, but enacts the movement of its own withdrawal.  ; Trace Type — Composite","refs":["CL_GB18_52:GA-04","CL_GB18_52:GA-10","CH_GB18_DADW:A17","CH_GB18_DADA:SD5"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_52:BSD-01","text":"The critique of external cognition is not an epistemic preliminary remark, but ontology: a form of cognition is false insofar as it treats its object as outside its own self-movement.","refs":["CH_GB18_DADA:DNX3","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BSD-02","text":"The temporal structure of the system is retrospective: what initially emerges as an independent determination receives its truth only subsequently in the return to totality.","refs":["CH_GB18_DADA:SD3","CH_GB18_DADW:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BSD-03","text":"Ontology is organized asymmetrically: totality can show itself in forms, but forms can neither ground totality nor replace it as independent reality.","refs":["CH_GB18_BDAA:A6","CH_GB18_BDAA:A15"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:BSD-04","text":"The methodological consequence consists in an immanent reading that does not collect categories as stable objects, but follows their self-dissolution and their return to the ground.","refs":["CH_GB18_DADA:ALT3","CH_GB18_DADA:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_52:RLE-01","text":"The first loop leads from ground-mediated existence through appearance and reflection back to reality, in which the initial immediacy becomes legible as a mediated moment.","refs":["CH_GB18_DADW:A3","CH_GB18_DADW:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RLE-02","text":"The second loop transforms external reflection into internal self-movement by collapsing the opposition of observation and object as a difference within absolute unity.","refs":["CH_GB18_DADW:A13","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RLE-03","text":"The attributive loop produces form only in order to make its non-independence visible: form is posited, totalized, reduced to semblance, and taken back into simple identity.","refs":["CH_GB18_BDAA:FGS1","CH_GB18_BDAA:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:RLE-04","text":"The central attractor is totality, to which essence, existence, appearance, reflection, and attribute return without being permitted to preserve their difference as a positive counterforce.","refs":["CH_GB18_BDAA:AS4","CH_GB18_BDAA:A10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_52:FGS-B01","text":"Ground-mediated existence → determination of form → appearance → reflection: immediacy becomes actual only as an already mediated determination.","refs":["CH_GB18_DADW:A3","CH_GB18_DADW:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FGS-B02","text":"Reflection-into-another → reflection-into-itself → inner and outer: difference arises, but only on an identical foundation of content and form.","refs":["CH_GB18_DADW:A6","CH_GB18_DADW:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FGS-B03","text":"Identity of content and form → sublation of the difference of form → absolute reality: difference loses its status as an independent determination.","refs":["CH_GB18_DADW:A10","CH_GB18_DADW:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FGS-B04","text":"External predication → negation of finite determinations → abstract emptiness → unity of Seyn and essence: the Absolute cannot be determined as a merely predicate-less beyond.","refs":["CH_GB18_DADA:AS2","CH_GB18_DADA:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FGS-B05","text":"Absolute unity of form and content → transparency of all determinacy → attribute as entire content: the Absolute appears only in forms that gain no autonomous reality.","refs":["CH_GB18_DADA:A6","CH_GB18_BDAA:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FGS-B06","text":"Attributive totality → sublation of form → abstract identity with a remainder of externality: the machine closes itself negatively and produces its next instability from its own closure.","refs":["CH_GB18_BDAA:A12","CH_GB18_BDAA:A13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_52:AFM-B01","text":"Unconnected essence and insubstantial appearance → unity of essence and existence → reality as mediated totality.","refs":["CH_GB18_DADW:A2","CH_GB18_DADW:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:AFM-B02","text":"Reality → identity of inner and outer → absolute reality as the sublation of independent difference of form.","refs":["CH_GB18_DADW:A8","CH_GB18_DADW:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:AFM-B03","text":"External predication → negative emptiness → inadequacy of abstract identity → demand for the self-interpretation of the Absolute.","refs":["CH_GB18_DADA:AS2","CH_GB18_DADA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:AFM-B04","text":"Unity of Seyn and essence → transparency of determinations → finitude as non-independent semblance.","refs":["CH_GB18_DADA:A3","CH_GB18_DADA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:AFM-B05","text":"Attribute as form of the entire content → totality as sole subsistence → self-sublation of attributive form.","refs":["CH_GB18_BDAA:A5","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:AFM-B06","text":"Return to identity → persistence of externality → negative openness of the question of a non-external absolute form.","refs":["CH_GB18_BDAA:A13","CH_GB18_BDAA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_52:MME-01","text":"Reality is remapped from a state or domain of objects into a movement of form in which essence and existence are true only in their unity.","refs":["CH_GB18_DADW:ME1","CH_GB18_DADW:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MME-02","text":"Appearance is reclassified from a mere surface into a necessary mediation, while semblance designates the later shape of the same mediation under conditions of absolute totalization.","refs":["CH_GB18_DADW:ME3","CH_GB18_DADA:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MME-03","text":"The opposition between inner and outer loses its ontological primacy and becomes a self-sublating difference of reflection.","refs":["CH_GB18_DADW:ME2","CH_GB18_DADA:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MME-04","text":"Substance and attribute are shifted from concepts of bearer and property into transitional figures of a totality in which only the self-relation of the Absolute possesses subsistence.","refs":["CH_GB18_DADW:ME6","CH_GB18_BDAA:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MME-05","text":"Negation is determined not as mere erasure, but as a mapping operation that preserves differences by transferring their independence into sublated semblance.","refs":["CH_GB18_DADA:SD4","CH_GB18_BDAA:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_52:ALT-B01","text":"Surface level — reality, the Absolute, appearance, reflection, and attribute constitute the explicit objects through which the system tests the possibility of absolute determination.","refs":["CH_GB18_DADW:A1","CH_GB18_BDAA:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:ALT-B02","text":"Structural level — the recurring machine consists of formation, reflection, totalization, and withdrawal, through which every determination counts only as dependent on its ground.","refs":["CH_GB18_DADW:A14","CH_GB18_BDAA:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:ALT-B03","text":"Metastrategic level — interpretation is transformed from an external method into an immanent operation that takes back its own presuppositions as forms of the object.","refs":["CH_GB18_DADA:ALT3","CH_GB18_DADA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:ALT-B04","text":"Ontological-temporal level — reality is return and retrospective mediation, while in the Absolute itself no independent becoming is permitted as a positive mode of being.","refs":["CH_GB18_DADW:ALT4","CH_GB18_DADA:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:ALT-B05","text":"Methodological-performative level — the presentation enacts its assertion by transforming every external establishment of the Absolute into a movement of self-sublation and self-withdrawal.","refs":["CH_GB18_DADA:A8","CH_GB18_DADA:MRT6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_52:FL-01","text":"The system asserts that there is no becoming in the Absolute, yet simultaneously determines its interpretation as an activity of its own with an immanent structure of movement.","refs":["CH_GB18_DADA:NX5","CH_GB18_DADA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FL-02","text":"The attribute is supposed to contain the entire content and the true subsistence of the Absolute, yet at the same time remains a relative, inessential, and null form.","refs":["CH_GB18_BDAA:A6","CH_GB18_BDAA:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:FL-03","text":"Reflection is required as the negative return of the Absolute, but in its return to identity remains burdened with a remainder of external abstraction.","refs":["CH_GB18_DADW:A14","CH_GB18_BDAA:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MP-01","text":"Appearance mutates into semblance where the mediation of existence no longer functions as positive reality, but as the transparency and sublatability of every determination.","refs":["CH_GB18_DADW:A5","CH_GB18_DADA:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MP-02","text":"External reflection mutates into internal reflection where its opposition to the Absolute is recoded as a moment of absolute unity.","refs":["CH_GB18_DADW:A13","CH_GB18_DADA:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MP-03","text":"Form mutates from equality with content into an inessential mode of appearance as soon as, as attributive form, it may no longer bear an independent determination.","refs":["CH_GB18_BDAA:A2","CH_GB18_BDAA:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_52:HSI-01","text":"Reality appears as a machine of totalization: it produces forms of its own visibility, allows these forms to operate, and in the same enactment deprives them of every independent status of being.","refs":["CH_GB18_DADW:SD1","CH_GB18_BDAA:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:HSI-02","text":"A stable instance of cognition outside the system is not grounded; the site of interpretation appears only as a vanishing function of reflection within the movement of the Absolute.","refs":["CH_GB18_DADA:SNX1","CH_GB18_DADA:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:HSI-03","text":"Time appears as retrogressive time of mediation: determinations become true only in their return to the ground, while the Absolute itself is not a temporally becoming object.","refs":["CH_GB18_DADA:SD3","CH_GB18_DADA:NX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:HSI-04","text":"Agency exists only as an immanent operation of deprivation of independence: forms may appear, differentiate, and mediate, but may not remain as autonomous bearers.","refs":["CH_GB18_BDAA:A12","CH_GB18_DADA:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_52:MRT-B01","text":"The axioms suffice to reconstruct the cluster-scale movement from reality through absolute self-interpretation to the self-sublation of the attribute as a unified machine of negativity.","refs":["CH_GB18_DADW:MRT1","CH_GB18_BDAA:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MRT-B02","text":"The positive mediation of the modalities, as well as the determination of a possible plurality of attributes beyond their withdrawal into the same absolute content, remains underdetermined.","refs":["CH_GB18_DADW:MRT2","CH_GB18_BDAA:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MRT-B03","text":"The architecture is coherent insofar as sublation is understood not as erasure, but as the preservation of a difference in the form of its non-independence.","refs":["CH_GB18_DADW:MRT3","CH_GB18_BDAA:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_52:MRT-B04","text":"The strongest and at the same time irreducible tension remains the necessity of a form that lets the Absolute appear, although this form may possess no independent ontological subsistence.","refs":["CH_GB18_DADA:MRT4","CH_GB18_BDAA:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_52@R001","source_variant_id":"canonical:CL_GB18_52:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 154–156","context":"Dritter Abschnitt. Die Wirklichkeit. · A. Die Auslegung des Absoluten. · B. Das absolute Attribut."},"title_language_code":"en"},{"id":"CL_GB18_53","layer":"CL","title":"Chapters 157–159","order":53,"parents":["CH_GB18_CDMD","CH_GB18_A_41","CH_GB18_ZLOF"],"revision":"CL_GB18_53@R001","sha256":"66fa232b3e6cc3d8550a760705601ffaf1949b572d7934e540307d05197a12b9","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_53:ABS-B01","text":"Das zentrale Problem besteht darin, das Absolute nicht als vorausgesetzten Träger seiner Bestimmungen, sondern als Resultat einer Bewegung zu bestimmen, die ihre eigenen Unterschiede hervorbringt und aufhebt.","refs":["CH_GB18_A_41:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B02","text":"Die anfängliche Identität erweist sich als unzureichend, weil sie bereits Bestimmtheit enthält und daher ihre eigene Unmittelbarkeit überschreiten muß.","refs":["CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B03","text":"Attribut, Modus und Modalität bilden keine äußerliche Reihe von Prädikaten, sondern Stationen einer Selbstbestimmung, in der die absolute Einheit sich als Differenz exponiert.","refs":["CH_GB18_CDMD:AS2","CH_GB18_ZLOF:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B04","text":"Äußerlichkeit wird nicht als Abfall aus dem Absoluten behandelt, sondern als gesetzte Form seiner Reflexion, deren Wahrheit erst in der Rückkehr der Differenz in sich besteht.","refs":["CH_GB18_CDMD:AS4","CH_GB18_CDMD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B05","text":"Die Kritik an ruhender Substanz, emanativem Verlust und begrenzter Monadenreflexion dient als Negativkartographie: Sie isoliert Systeme, in denen Einheit, Andersheit oder Selbstbeziehung jeweils ohne die notwendige Vermittlung ihrer Gegenmomente verbleiben.","refs":["CH_GB18_A_41:AS5","CH_GB18_A_41:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B06","text":"Möglichkeit fungiert als innere Krise formeller Identität, weil jede bestimmte Möglichkeit ihre Negation und damit ihre Unzulänglichkeit zur selbständigen Wahrheit erzeugt.","refs":["CH_GB18_ZLOF:A7","CH_GB18_ZLOF:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B07","text":"Zufälligkeit ist die Übergangsgestalt, in der Wirklichkeit zugleich grundlos und begründet erscheint, bis diese Instabilität als notwendige Identität von Möglichkeit und Wirklichkeit umschlägt.","refs":["CH_GB18_ZLOF:A11","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B08","text":"Die Bewegung schließt nicht mit einem ruhenden Sein, sondern mit Wirklichkeit als selbsttragender Manifestation, deren Form, Inhalt und Erkenntnisvollzug nicht mehr auseinanderfallen.","refs":["CH_GB18_CDMD:A14","CH_GB18_CDMD:A13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_53:GA-01","text":"[Attractor] Das Absolute ist nur als Resultat einer selbstbezüglichen Negativität absolut, weil seine Identität die Hervorbringung, Entäußerung und Rücknahme ihrer Unterschiede einschließt.","refs":["CH_GB18_A_41:AS3","CH_GB18_A_41:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-02","text":"[Persistent] Bestimmtheit besitzt keinen positiven Eigenstand außerhalb der Negation; sie ist die Form, in der Identität ihre innere Differenz setzt.","refs":["CH_GB18_A_41:A2","CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-03","text":"[Mutating] Äußerlichkeit mutiert vom Schein eines außerhalb liegenden Anderen zur gesetzten Selbstexposition des Absoluten und verliert dadurch jeden unabhängigen ontologischen Status.","refs":["CH_GB18_CDMD:A5","CH_GB18_CDMD:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-04","text":"[Persistent] Eine Bestimmung gilt nur dann als Bestimmung des Absoluten, wenn ihr Hervorgehen, ihr Widerspruch und ihre Rückkehr aus dessen eigener Bewegung begriffen werden können.","refs":["CH_GB18_A_41:A8","CH_GB18_CDMD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-05","text":"[Emergent] Die Trias Identität, Attribut und Modus wird auf der Clusterebene als allgemeine Modalmaschine lesbar, in der formelle Wirklichkeit, Möglichkeit, Zufälligkeit und Notwendigkeit verschiedene Phasen derselben Reflexionslogik darstellen.","refs":["CH_GB18_CDMD:AS3","CH_GB18_ZLOF:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-06","text":"[Mutating] Möglichkeit ist nicht ein Vorrat verfügbarer Inhalte, sondern ein mangelhaftes Ansichsein, das kraft seiner bestimmten Form den Übergang in Wirklichkeit erzwingt.","refs":["CH_GB18_ZLOF:A5","CH_GB18_ZLOF:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-07","text":"[Terminal] Notwendigkeit ist die aufgehobene Selbständigkeit von Möglichkeit und Wirklichkeit und deshalb keine äußere Zwangsform, sondern ihre immanente Identität.","refs":["CH_GB18_ZLOF:A12","CH_GB18_ZLOF:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-08","text":"[Attractor] Wirklichkeit ist die Selbstmanifestation, in der Form und Inhalt, Erkenntnis und Gegenstand sowie Innerlichkeit und Äußerlichkeit als eine Bewegung erscheinen.","refs":["CH_GB18_CDMD:A13","CH_GB18_ZLOF:A1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_53:RMD-01","text":"Identität kehrt nicht als stabile Ausgangsgleichheit wieder, sondern mutiert von einfacher Unmittelbarkeit über bestimmte Identität zu resultierender Selbstidentität.","refs":["CH_GB18_CDMD:A1","CH_GB18_A_41:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RMD-02","text":"Negation verschiebt sich von formeller Reflexion zu absoluter Negativität: Was zunächst als äußerliches Gegenmoment erscheint, wird zur Produktivkraft der Selbstbestimmung.","refs":["CH_GB18_CDMD:A2","CH_GB18_A_41:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RMD-03","text":"Der Modus behält die Funktion der Äußerlichkeit, doch seine Valenz kehrt sich um, weil er nicht Verlust, sondern die Form der Rückkehr des Absoluten zu sich selbst wird.","refs":["CH_GB18_CDMD:NX1","CH_GB18_CDMD:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RMD-04","text":"Attribut und Modus werden aus einer taxonomischen Abfolge in ein Kriterium notwendiger Vermittlung absorbiert: Ihre Wahrheit liegt nicht in ihrem Vorkommen, sondern in ihrem erzeugten Zusammenhang.","refs":["CH_GB18_A_41:ME6","CH_GB18_A_41:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RMD-05","text":"Möglichkeit verschwindet als selbständige Modalität, nachdem sie durch Selbstwiderspruch Wirklichkeit und schließlich Notwendigkeit erzeugt hat.","refs":["CH_GB18_ZLOF:A9","CH_GB18_ZLOF:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_53:CGD-01","text":"Die konkrete Gliederung in Substanz, Attribut und Modus bleibt eine lokale begriffliche Sequenz; auf Clusterebene trägt allein die Regel, daß jede Gliederung aus Selbstvermittlung hervorgehen muß.","refs":["CH_GB18_A_41:AS4","CH_GB18_A_41:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:CGD-02","text":"Die historischen Diagnosen zu Spinoza, Emanation und Leibniz bleiben lokale Gegenmodelle; global werden sie zu drei Ausschlußtypen: Identität ohne Bewegung, Andersheit ohne Rückkehr und Reflexion ohne immanente Entgrenzung.","refs":["CH_GB18_A_41:SD1","CH_GB18_A_41:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:CGD-03","text":"Die formellen Unterscheidungen von Sein, Existenz und Wirklichkeit bleiben modal-lokale Bestimmungen; global skalieren sie zur Regel, daß jede Unmittelbarkeit nur als Moment reflektierter Form gilt.","refs":["CH_GB18_ZLOF:ME1","CH_GB18_ZLOF:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:CGD-04","text":"Die lokale Doppelbestimmung der Zufälligkeit als Grundlosigkeit und Begründetheit skaliert zur allgemeinen Einsicht, daß Oppositionen nicht zwischen getrennten Bereichen vermitteln, sondern sich als Selbstunterschied einer Einheit erzeugen.","refs":["CH_GB18_ZLOF:D6","CH_GB18_A_41:ME1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_53:GNX-01","text":"Ausgeschlossen ist ein statisches Absolutes, dessen Identität vor jeder Selbstunterscheidung vollständig wäre.","refs":["CH_GB18_CDMD:DNX1","CH_GB18_A_41:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GNX-02","text":"Ausgeschlossen ist eine Äußerlichkeit, die dem Absoluten als eigenständiges Sein oder irreversibles Anderswerden gegenübertreten könnte.","refs":["CH_GB18_CDMD:DNX2","CH_GB18_A_41:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GNX-03","text":"Ausgeschlossen ist eine Erkenntnis, die ihre Bestimmungen äußerlich aufnimmt, subsumiert oder auf einen vorausgesetzten Grund zurückführt.","refs":["CH_GB18_A_41:NX3","CH_GB18_A_41:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GNX-04","text":"Ausgeschlossen ist eine Möglichkeit, die ohne immanente Negation, ohne Wirklichkeitsverweisung und ohne Selbstaufhebung als gültiger Inhalt bestehen könnte.","refs":["CH_GB18_ZLOF:DNX1","CH_GB18_ZLOF:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_53:DBN-01","text":"Falsch sein muß, daß Wahrheit mit einem unmittelbaren Anfang identisch sein kann; jeder Anfang wird nur als bereits gesetztes Moment einer Selbstvermittlung zugelassen.","refs":["CH_GB18_A_41:DNX1","CH_GB18_ZLOF:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:DBN-02","text":"Falsch sein muß, daß Differenz entweder endgültig aus der Einheit austritt oder als bloßer Schein ohne produktive Funktion verschwindet.","refs":["CH_GB18_A_41:SNX2","CH_GB18_CDMD:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:DBN-03","text":"Falsch sein muß, daß Grund, Grenze oder Relation außerhalb dessen liegen können, was sie begründen, begrenzen oder vermitteln sollen.","refs":["CH_GB18_ZLOF:DNX3","CH_GB18_A_41:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_53:BSA-01","text":"Unverfügbar ist eine Außenposition gegenüber dem Absoluten, von der aus dessen Bestimmungen als fertige Gegenstände erkannt, verglichen oder legitimiert werden könnten.","refs":["CH_GB18_CDMD:SNX2","CH_GB18_A_41:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:BSA-02","text":"Unverfügbar ist ein verborgenes Inneres, dessen Manifestation als Übertritt in ein wirklich anderes Sein verstanden werden könnte.","refs":["CH_GB18_CDMD:DNX3","CH_GB18_CDMD:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:BSA-03","text":"Unverfügbar ist letzte Kontingenz, weil ihr Umschlag in die Identität von Grund und Grundlosigkeit die Notwendigkeit bereits als ihren eigenen Vollzug enthält.","refs":["CH_GB18_ZLOF:SNX3","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_53:XD-01","text":"Die Kritik äußerlicher Erkenntnis und die Rekonstruktion modal-logischer Übergänge bilden gemeinsam ein Kriterium spekulativer Gültigkeit: Ein Begriff ist nur wahr, wenn seine Erkenntnisform und seine Seinsform dieselbe Selbstbewegung vollziehen.","refs":["CL_GB18_53:GA-01","CL_GB18_53:GA-04","CL_GB18_53:GA-08","CH_GB18_A_41:SD3","CH_GB18_ZLOF:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_53:XD-02","text":"Der Modus des Absoluten und die Modalität der Wirklichkeit werden als zwei Skalen derselben Operation sichtbar: Äußerlichkeit wird gesetzt, als unzureichend reflektiert und als immanente Identität zurückgenommen.","refs":["CL_GB18_53:GA-03","CL_GB18_53:GA-05","CH_GB18_CDMD:FGS5","CH_GB18_ZLOF:FGS6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_53:XD-03","text":"Die Vergleichsfiguren Spinoza, Emanation und Monade zeigen nicht bloß historische Defizite, sondern markieren die drei systematischen Abbruchstellen jeder Absolutheitslehre: fehlende Genesis, fehlende Rückkehr und äußerlich verbleibende Grenze.","refs":["CL_GB18_53:GA-01","CL_GB18_53:GA-04","CH_GB18_A_41:SD1","CH_GB18_A_41:D7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_53:XD-04","text":"Die formelle Möglichkeit übernimmt strukturell die Rolle der anfänglichen Identität: Beide erscheinen als selbstgleiche Bestimmungen, deren innere Unzulänglichkeit erst durch Negation ihre Wahrheit freisetzt.","refs":["CL_GB18_53:GA-02","CL_GB18_53:GA-06","CH_GB18_CDMD:D5","CH_GB18_ZLOF:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_53:XD-05","text":"Notwendigkeit bildet keine Rückkehr zu der anfänglichen Einfachheit, sondern deren transformierte Wiederkehr als Identität, die ihre eigene Äußerlichkeit, Möglichkeit und Zufälligkeit in sich enthält.","refs":["CL_GB18_53:GA-01","CL_GB18_53:GA-07","CH_GB18_A_41:A4","CH_GB18_ZLOF:SD4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_53:BSD-01","text":"Realität wird als immanente Begründungsmaschine bestimmt: Was als Grund, Gegenstand, Möglichkeit oder Grenze erscheint, ist nur wirklich, sofern es als Moment eines Selbstvollzugs hervorgebracht wird.","refs":["CH_GB18_ZLOF:DNX3","CH_GB18_A_41:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:BSD-02","text":"Das Subjekt verliert den Status einer äußeren Instanz der Erkenntnis und wird zur internen Funktion absoluter Selbstmanifestation, deren Denken nicht neben dem Sein steht.","refs":["CH_GB18_CDMD:SD4","CH_GB18_A_41:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:BSD-03","text":"Zeit erscheint nicht als lineare Folge von Ursprung, Entfernung und Rückkehr, sondern als rekursive Zeitlichkeit, in der das Resultat die Wahrheit des Anfangs bestimmt.","refs":["CH_GB18_A_41:A1","CH_GB18_A_41:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:BSD-04","text":"Notwendigkeit ersetzt Kausalzwang durch die Form eines Umschlags, in dem jedes Moment seine Selbständigkeit gerade dadurch verliert, daß es seine Gegenbestimmung erzeugt.","refs":["CH_GB18_ZLOF:D7","CH_GB18_ZLOF:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_53:RLE-01","text":"Die Grundschleife lautet: Identität setzt Bestimmtheit, Bestimmtheit exponiert Äußerlichkeit, Äußerlichkeit reflektiert ihre Gesetztseinheit und stellt dadurch eine konkretere Identität her.","refs":["CH_GB18_CDMD:FGS1","CH_GB18_CDMD:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RLE-02","text":"Die Modalitätsschleife lautet: Wirklichkeit enthält Möglichkeit, Möglichkeit erzeugt Widerspruch, Widerspruch erzeugt Zufälligkeit, und Zufälligkeit kollabiert in Notwendigkeit.","refs":["CH_GB18_ZLOF:A4","CH_GB18_ZLOF:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RLE-03","text":"Selbstnegation ist der zentrale Attraktor, weil sie zugleich Differenz erzeugt, deren äußerliche Selbständigkeit zerstört und die Rückkehr zur Identität ermöglicht.","refs":["CH_GB18_A_41:FGS7","CH_GB18_A_41:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RLE-04","text":"Die Architektur eskaliert von einer lokalen Theorie des Modus zu einer allgemeinen Ontologie der Modalität, weil die Entäußerung des Absoluten nur vollständig bestimmt ist, wenn sie als Möglichkeit, Zufälligkeit und Notwendigkeit rekonstruiert wird.","refs":["CH_GB18_CDMD:ME1","CH_GB18_ZLOF:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_53:FGS-B01","text":"Unmittelbare Identität → innere Bestimmtheit → Negation als Form der Selbstunterscheidung.","refs":["CH_GB18_CDMD:FGS1","CH_GB18_A_41:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:FGS-B02","text":"Selbstunterscheidung → Attribut und Modus → Äußerlichkeit als gesetztes Moment des Absoluten.","refs":["CH_GB18_CDMD:FGS2","CH_GB18_CDMD:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:FGS-B03","text":"Gesetzte Äußerlichkeit → Schein als Schein → Rückkehr der Form in sich.","refs":["CH_GB18_CDMD:FGS4","CH_GB18_CDMD:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:FGS-B04","text":"Rückkehrende Reflexion → Wirklichkeit als Einheit von Innerem und Äußerem → Möglichkeit als unzulängliches Ansichsein dieser Einheit.","refs":["CH_GB18_ZLOF:A1","CH_GB18_ZLOF:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:FGS-B05","text":"Möglichkeit des Gegenteils → Selbstwiderspruch → Zufälligkeit als instabile Einheit → Notwendigkeit als aufgehobene Selbständigkeit der Modalitäten.","refs":["CH_GB18_ZLOF:A8","CH_GB18_ZLOF:A10","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_53:AFM-B01","text":"Unmittelbare Identität → Diagnose ihrer verborgenen Bestimmtheit.","refs":["CH_GB18_CDMD:A1","CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:AFM-B02","text":"Bestimmtheit → Kritik äußerlicher Reflexion → Forderung notwendiger Selbstvermittlung.","refs":["CH_GB18_A_41:A6","CH_GB18_A_41:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:AFM-B03","text":"Attribut und Modus → Äußerlichkeit → Schein als immanente Rückkehr.","refs":["CH_GB18_CDMD:A3","CH_GB18_CDMD:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:AFM-B04","text":"Wirklichkeit → Möglichkeit → Widerspruch der bestimmten Möglichkeit.","refs":["CH_GB18_ZLOF:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:AFM-B05","text":"Zufälligkeit → Umschlag von Grund und Grundlosigkeit → Notwendigkeit als konkrete Identität.","refs":["CH_GB18_ZLOF:D6","CH_GB18_ZLOF:AF6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_53:MME-01","text":"Der Gegensatz von Einheit und Vielheit wird umklassifiziert: Vielheit ist weder äußerer Zusatz noch bloß zu tilgender Schein, sondern die notwendige Selbstartikulation der Einheit.","refs":["CH_GB18_A_41:ME1","CH_GB18_A_41:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MME-02","text":"Der Gegensatz von Innerem und Äußerem zerfällt als räumliche Metaphysik und wird durch ein Verhältnis von Selbstsetzung und reflektiertem Gesetztsein ersetzt.","refs":["CH_GB18_CDMD:A11","CH_GB18_ZLOF:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MME-03","text":"Erkenntnis wird von Repräsentation oder Subsumtion in eine immanente Rekonstruktion jener Bewegung verschoben, durch die ihr Gegenstand überhaupt Bestimmtheit erhält.","refs":["CH_GB18_A_41:A5","CH_GB18_A_41:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MME-04","text":"Notwendigkeit wird nicht mehr gegen Zufälligkeit gestellt, sondern als deren Wahrheit begriffen; dadurch wird Kontingenz zur operativen Übergangsform statt zum ontologischen Rest.","refs":["CH_GB18_ZLOF:SD3","CH_GB18_ZLOF:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_53:ALT-B01","text":"Surface level — Der explizite Gegenstandsbereich umfaßt Absolutes, Attribut, Modus, Wirklichkeit, Möglichkeit, Zufälligkeit und Notwendigkeit.","refs":["CH_GB18_CDMD:ALT1","CH_GB18_ZLOF:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ALT-B02","text":"Structural level — Alle Gegenstände werden durch dieselbe Operationsfolge organisiert: Setzung, Negation, Gesetztsein, Widerspruch, Aufhebung und Rückkehr.","refs":["CH_GB18_A_41:FGS7","CH_GB18_ZLOF:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ALT-B03","text":"Metastrategic level — Kritik erhält die Form einer Prüfung, ob ein System seine Übergänge immanent erzeugt oder auf äußerliche Reflexion, Erfahrung, Harmonie oder Definition angewiesen bleibt.","refs":["CH_GB18_A_41:ALT3","CH_GB18_A_41:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ALT-B04","text":"Ontological / Temporal level — Sein ist nur als Selbstbewegung wirklich; seine Zeitlichkeit ist nicht linear, sondern die rückwirkende Konstitution des Anfangs durch sein Resultat.","refs":["CH_GB18_ZLOF:ALT4","CH_GB18_A_41:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie keine Bestimmung bestehen läßt, ohne deren Negation, Grenze und Rückkehr als Bedingung ihrer Geltung auszuweisen.","refs":["CH_GB18_CDMD:FGS6","CH_GB18_ZLOF:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_53:FL-01","text":"Die Architektur verlangt, daß Negation zunächst als äußerliche Reflexion auftreten kann, obwohl ihre Wahrheit nur als bereits immanente Selbstnegation verständlich wird; die Vermittlung dieser beiden Status bleibt komprimiert.","refs":["CH_GB18_CDMD:A4","CH_GB18_CDMD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:FL-02","text":"Der Übergang von bestimmter Möglichkeit zu notwendiger Unmöglichkeit ist operativ zentral, wird jedoch eher als Umschlag behauptet als als eigenständig ausgeführte Deduktion gesichert.","refs":["CH_GB18_ZLOF:MRT2","CH_GB18_ZLOF:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MP-01","text":"Der Modus mutiert an der Stelle, an der Äußerlichkeit nicht mehr als Verlust des Absoluten, sondern als dasjenige begriffen wird, wodurch absolute Identität ausdrücklich gesetzt wird.","refs":["CH_GB18_CDMD:NX1","CH_GB18_CDMD:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MP-02","text":"Zufälligkeit mutiert von einer Bezeichnung für Grundlosigkeit zu einer Übergangsstruktur, deren doppelte Bestimmung die Notwendigkeit bereits erzeugt, ohne sie voraussetzen zu dürfen.","refs":["CH_GB18_ZLOF:NX6","CH_GB18_ZLOF:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_53:HSI-01","text":"Die Realität erscheint als selbstdifferenzierende Maschine, die kein Außen verarbeitet, sondern ihre scheinbaren Außenseiten als eigene Reflexionszustände produziert.","refs":["CH_GB18_CDMD:SD2","CH_GB18_ZLOF:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:HSI-02","text":"Das Subjekt erscheint nicht als isolierter Beobachter, sondern als endliche Gestalt einer Erkenntnis, die nur wahr ist, sofern sie aus der Bewegung ihres Gegenstands hervorgeht.","refs":["CH_GB18_A_41:DNX3","CH_GB18_A_41:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:HSI-03","text":"Zeit erscheint als rekursive Rückkehr, in der Entäußerung keine Entfernung von sich selbst bleibt, sondern die Bedingung einer konkreteren Selbstgegenwart wird.","refs":["CH_GB18_CDMD:FGS5","CH_GB18_A_41:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_53:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die gemeinsame Architektur als Selbstbewegung der Negativität von unmittelbarer Identität bis zur notwendigen Wirklichkeit zu rekonstruieren.","refs":["CH_GB18_CDMD:MRT1","CH_GB18_ZLOF:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MRT-B02","text":"Die Rekonstruktion ist am stärksten, wo sie Äußerlichkeit, Möglichkeit und Zufälligkeit nicht als Gegenbegriffe der Identität behandelt, sondern als deren notwendige Selbstunterschiede.","refs":["CH_GB18_CDMD:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MRT-B03","text":"Unterbestimmt bleiben die Übergänge, durch die äußere Reflexion vollständig in absolute Negativität übergeht und durch die Möglichkeit des Gegenteils jeder bestimmten Möglichkeit notwendig innewohnt.","refs":["CH_GB18_CDMD:MRT2","CH_GB18_ZLOF:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MRT-B04","text":"Die Clusterarchitektur bleibt kohärent, sofern Notwendigkeit nicht als erster Grund, sondern als terminale Gestalt einer Selbstvermittlung gelesen wird, die ihre Ausgangsbegriffe rückwirkend bestimmt.","refs":["CH_GB18_ZLOF:MRT7","CH_GB18_CDMD:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123018904225Z_75999be4","language_code":"en","language_name":"English","title":"Chapters 157–159","source_sha256":"66fa232b3e6cc3d8550a760705601ffaf1949b572d7934e540307d05197a12b9","sha256":"1386365bc176a4b4f832e67f75cce0d7be6b41998135d58348e01490e2284520","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:30:18.908305+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_53:ABS-B01","text":"The central problem consists in determining the Absolute not as the presupposed bearer of its determinations, but as the result of a movement that produces and sublates its own differences.","refs":["CH_GB18_A_41:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B02","text":"Initial identity proves insufficient because it already contains determinacy and must therefore transcend its own immediacy.","refs":["CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B03","text":"Attribute, mode, and modality do not constitute an external series of predicates, but stations of a self-determination in which absolute unity exposes itself as difference.","refs":["CH_GB18_CDMD:AS2","CH_GB18_ZLOF:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B04","text":"Externality is not treated as a falling-away from the Absolute, but as a posited form of its reflection, whose truth consists only in the return of difference into itself.","refs":["CH_GB18_CDMD:AS4","CH_GB18_CDMD:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B05","text":"The critique of resting substance, emanative loss, and limited monadic reflection serves as a negative cartography: it isolates systems in which unity, otherness, or self-relation respectively remain without the necessary mediation of their opposing moments.","refs":["CH_GB18_A_41:AS5","CH_GB18_A_41:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B06","text":"Possibility functions as the inner crisis of formal identity, because every determinate possibility generates its negation and thus its inadequacy to independent truth.","refs":["CH_GB18_ZLOF:A7","CH_GB18_ZLOF:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B07","text":"Contingency is the transitional configuration in which actuality appears at once groundless and grounded, until this instability turns into the necessary identity of possibility and actuality.","refs":["CH_GB18_ZLOF:A11","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ABS-B08","text":"The movement does not conclude with a resting being, but with actuality as self-sustaining manifestation, whose form, content, and enactment of cognition no longer fall apart.","refs":["CH_GB18_CDMD:A14","CH_GB18_CDMD:A13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_53:GA-01","text":"[Attractor] The Absolute is absolute only as the result of a self-relating negativity, because its identity includes the production, externalization, and retraction of its differences.","refs":["CH_GB18_A_41:AS3","CH_GB18_A_41:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-02","text":"[Persistent] Determinacy possesses no positive independent standing outside negation; it is the form in which identity posits its inner difference.","refs":["CH_GB18_A_41:A2","CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-03","text":"[Mutating] Externality mutates from the semblance of an other lying outside into the posited self-exposition of the Absolute and thereby loses every independent ontological status.","refs":["CH_GB18_CDMD:A5","CH_GB18_CDMD:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-04","text":"[Persistent] A determination counts as a determination of the Absolute only if its emergence, its contradiction, and its return can be comprehended from the Absolute's own movement.","refs":["CH_GB18_A_41:A8","CH_GB18_CDMD:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-05","text":"[Emergent] At the cluster level, the triad of identity, attribute, and mode becomes legible as a general modal machine, in which formal actuality, possibility, contingency, and necessity represent different phases of the same logic of reflection.","refs":["CH_GB18_CDMD:AS3","CH_GB18_ZLOF:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-06","text":"[Mutating] Possibility is not a stock of available contents, but a deficient being-in-itself that, by virtue of its determinate form, compels the transition into actuality.","refs":["CH_GB18_ZLOF:A5","CH_GB18_ZLOF:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-07","text":"[Terminal] Necessity is the sublated independence of possibility and actuality and is therefore not an external form of compulsion, but their immanent identity.","refs":["CH_GB18_ZLOF:A12","CH_GB18_ZLOF:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GA-08","text":"[Attractor] Actuality is the self-manifestation in which form and content, cognition and object, as well as inwardness and externality, appear as one movement.","refs":["CH_GB18_CDMD:A13","CH_GB18_ZLOF:A1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_53:RMD-01","text":"Identity does not recur as stable initial equality, but mutates from simple immediacy through determinate identity into resultant self-identity.","refs":["CH_GB18_CDMD:A1","CH_GB18_A_41:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RMD-02","text":"Negation shifts from formal reflection to absolute negativity: what initially appears as an external opposing moment becomes the productive force of self-determination.","refs":["CH_GB18_CDMD:A2","CH_GB18_A_41:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RMD-03","text":"The mode retains the function of externality, but its valence is reversed, because it becomes not loss, but the form of the Absolute's return to itself.","refs":["CH_GB18_CDMD:NX1","CH_GB18_CDMD:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RMD-04","text":"Attribute and mode are absorbed from a taxonomic sequence into a criterion of necessary mediation: their truth lies not in their occurrence, but in their generated connection.","refs":["CH_GB18_A_41:ME6","CH_GB18_A_41:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RMD-05","text":"Possibility disappears as an independent modality after having generated actuality and finally necessity through self-contradiction.","refs":["CH_GB18_ZLOF:A9","CH_GB18_ZLOF:FGS7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_53:CGD-01","text":"The concrete articulation into substance, attribute, and mode remains a local conceptual sequence; at the cluster level, only the rule that every articulation must emerge from self-mediation is decisive.","refs":["CH_GB18_A_41:AS4","CH_GB18_A_41:SD5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:CGD-02","text":"The historical diagnoses concerning Spinoza, emanation, and Leibniz remain local countermodels; globally, they become three types of exclusion: identity without movement, otherness without return, and reflection without immanent de-limitation.","refs":["CH_GB18_A_41:SD1","CH_GB18_A_41:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:CGD-03","text":"The formal distinctions among being, existence, and actuality remain modal-local determinations; globally, they scale into the rule that every immediacy counts only as a moment of reflected form.","refs":["CH_GB18_ZLOF:ME1","CH_GB18_ZLOF:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:CGD-04","text":"The local double determination of contingency as groundlessness and groundedness scales into the general insight that oppositions do not mediate between separate spheres, but generate themselves as the self-difference of a unity.","refs":["CH_GB18_ZLOF:D6","CH_GB18_A_41:ME1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_53:GNX-01","text":"Excluded is a static Absolute whose identity would be complete prior to every self-differentiation.","refs":["CH_GB18_CDMD:DNX1","CH_GB18_A_41:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GNX-02","text":"Excluded is an externality that could confront the Absolute as independent being or irreversible becoming-other.","refs":["CH_GB18_CDMD:DNX2","CH_GB18_A_41:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GNX-03","text":"Excluded is a cognition that receives its determinations externally, subsumes them, or refers them back to a presupposed ground.","refs":["CH_GB18_A_41:NX3","CH_GB18_A_41:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:GNX-04","text":"Excluded is a possibility that could persist as valid content without immanent negation, without reference to actuality, and without self-sublation.","refs":["CH_GB18_ZLOF:DNX1","CH_GB18_ZLOF:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_53:DBN-01","text":"It must be false that truth can be identical with an immediate beginning; every beginning is admitted only as an already posited moment of a self-mediation.","refs":["CH_GB18_A_41:DNX1","CH_GB18_ZLOF:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:DBN-02","text":"It must be false that difference either finally exits unity or disappears as mere semblance without productive function.","refs":["CH_GB18_A_41:SNX2","CH_GB18_CDMD:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:DBN-03","text":"It must be false that ground, limit, or relation can lie outside that which they are meant to ground, limit, or mediate.","refs":["CH_GB18_ZLOF:DNX3","CH_GB18_A_41:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_53:BSA-01","text":"Unavailable is an external position with respect to the Absolute from which its determinations could be cognized, compared, or legitimized as ready-made objects.","refs":["CH_GB18_CDMD:SNX2","CH_GB18_A_41:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:BSA-02","text":"Unavailable is a hidden interior whose manifestation could be understood as a transition into a genuinely other being.","refs":["CH_GB18_CDMD:DNX3","CH_GB18_CDMD:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:BSA-03","text":"Unavailable is ultimate contingency, because its turn into the identity of ground and groundlessness already contains necessity as its own enactment.","refs":["CH_GB18_ZLOF:SNX3","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_53:XD-01","text":"The critique of external cognition and the reconstruction of modal-logical transitions jointly form a criterion of speculative validity: a concept is true only if its form of cognition and its form of being enact the same self-movement.","refs":["CL_GB18_53:GA-01","CL_GB18_53:GA-04","CL_GB18_53:GA-08","CH_GB18_A_41:SD3","CH_GB18_ZLOF:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_53:XD-02","text":"The mode of the Absolute and the modality of actuality become visible as two scales of the same operation: externality is posited, reflected as inadequate, and retracted as immanent identity.","refs":["CL_GB18_53:GA-03","CL_GB18_53:GA-05","CH_GB18_CDMD:FGS5","CH_GB18_ZLOF:FGS6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_53:XD-03","text":"The comparative figures of Spinoza, emanation, and monad show not merely historical deficits, but mark the three systematic breaking points of every doctrine of absoluteness: missing genesis, missing return, and a limit that remains external.","refs":["CL_GB18_53:GA-01","CL_GB18_53:GA-04","CH_GB18_A_41:SD1","CH_GB18_A_41:D7"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_53:XD-04","text":"Formal possibility structurally assumes the role of initial identity: both appear as self-equal determinations whose inner inadequacy releases their truth only through negation.","refs":["CL_GB18_53:GA-02","CL_GB18_53:GA-06","CH_GB18_CDMD:D5","CH_GB18_ZLOF:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_53:XD-05","text":"Necessity does not constitute a return to initial simplicity, but its transformed recurrence as an identity containing within itself its own externality, possibility, and contingency.","refs":["CL_GB18_53:GA-01","CL_GB18_53:GA-07","CH_GB18_A_41:A4","CH_GB18_ZLOF:SD4"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_53:BSD-01","text":"Reality is determined as an immanent machine of grounding: what appears as ground, object, possibility, or limit is actual only insofar as it is produced as a moment of self-enactment.","refs":["CH_GB18_ZLOF:DNX3","CH_GB18_A_41:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:BSD-02","text":"The subject loses the status of an external instance of cognition and becomes the internal function of absolute self-manifestation, whose thinking does not stand alongside being.","refs":["CH_GB18_CDMD:SD4","CH_GB18_A_41:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:BSD-03","text":"Time appears not as a linear sequence of origin, removal, and return, but as recursive temporality in which the result determines the truth of the beginning.","refs":["CH_GB18_A_41:A1","CH_GB18_A_41:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:BSD-04","text":"Necessity replaces causal compulsion with the form of a transition, in which every moment loses its independence precisely by generating its counter-determination.","refs":["CH_GB18_ZLOF:D7","CH_GB18_ZLOF:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_53:RLE-01","text":"The fundamental loop is as follows: identity posits determinacy, determinacy exposes externality, externality reflects its positedness and thereby produces a more concrete identity.","refs":["CH_GB18_CDMD:FGS1","CH_GB18_CDMD:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RLE-02","text":"The modality loop is as follows: actuality contains possibility, possibility generates contradiction, contradiction generates contingency, and contingency collapses into necessity.","refs":["CH_GB18_ZLOF:A4","CH_GB18_ZLOF:FGS7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RLE-03","text":"Self-negation is the central attractor because it simultaneously generates difference, destroys its external independence, and enables the return to identity.","refs":["CH_GB18_A_41:FGS7","CH_GB18_A_41:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:RLE-04","text":"The architecture escalates from a local theory of mode to a general ontology of modality, because the externalization of the Absolute is fully determined only when reconstructed as possibility, contingency, and necessity.","refs":["CH_GB18_CDMD:ME1","CH_GB18_ZLOF:ME4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_53:FGS-B01","text":"Immediate identity → inner determinacy → negation as the form of self-differentiation.","refs":["CH_GB18_CDMD:FGS1","CH_GB18_A_41:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:FGS-B02","text":"Self-differentiation → attribute and mode → externality as a posited moment of the Absolute.","refs":["CH_GB18_CDMD:FGS2","CH_GB18_CDMD:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:FGS-B03","text":"Posited externality → semblance as semblance → return of form into itself.","refs":["CH_GB18_CDMD:FGS4","CH_GB18_CDMD:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:FGS-B04","text":"Returning reflection → actuality as unity of inner and outer → possibility as the inadequate being-in-itself of this unity.","refs":["CH_GB18_ZLOF:A1","CH_GB18_ZLOF:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:FGS-B05","text":"Possibility of the opposite → self-contradiction → contingency as unstable unity → necessity as the sublated independence of the modalities.","refs":["CH_GB18_ZLOF:A8","CH_GB18_ZLOF:A10","CH_GB18_ZLOF:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_53:AFM-B01","text":"Immediate identity → diagnosis of its hidden determinacy.","refs":["CH_GB18_CDMD:A1","CH_GB18_CDMD:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:AFM-B02","text":"Determinacy → critique of external reflection → demand for necessary self-mediation.","refs":["CH_GB18_A_41:A6","CH_GB18_A_41:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:AFM-B03","text":"Attribute and mode → externality → semblance as immanent return.","refs":["CH_GB18_CDMD:A3","CH_GB18_CDMD:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:AFM-B04","text":"Actuality → possibility → contradiction of determinate possibility.","refs":["CH_GB18_ZLOF:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:AFM-B05","text":"Contingency → transition of ground and groundlessness → necessity as concrete identity.","refs":["CH_GB18_ZLOF:D6","CH_GB18_ZLOF:AF6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_53:MME-01","text":"The opposition of unity and multiplicity is reclassified: multiplicity is neither an external addition nor mere semblance to be effaced, but the necessary self-articulation of unity.","refs":["CH_GB18_A_41:ME1","CH_GB18_A_41:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MME-02","text":"The opposition of inner and outer disintegrates as spatial metaphysics and is replaced by a relation of self-positing and reflected positedness.","refs":["CH_GB18_CDMD:A11","CH_GB18_ZLOF:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MME-03","text":"Cognition is shifted from representation or subsumption into an immanent reconstruction of that movement through which its object receives determinacy in the first place.","refs":["CH_GB18_A_41:A5","CH_GB18_A_41:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MME-04","text":"Necessity is no longer set against contingency, but comprehended as its truth; thereby contingency becomes the operative transitional form rather than the ontological remainder.","refs":["CH_GB18_ZLOF:SD3","CH_GB18_ZLOF:ME3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_53:ALT-B01","text":"Surface level — The explicit domain of objects comprises the Absolute, attribute, mode, actuality, possibility, contingency, and necessity.","refs":["CH_GB18_CDMD:ALT1","CH_GB18_ZLOF:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ALT-B02","text":"Structural level — All objects are organized through the same sequence of operations: positing, negation, positedness, contradiction, sublation, and return.","refs":["CH_GB18_A_41:FGS7","CH_GB18_ZLOF:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ALT-B03","text":"Metastrategic level — Critique takes the form of an examination of whether a system generates its transitions immanently or remains dependent on external reflection, experience, harmony, or definition.","refs":["CH_GB18_A_41:ALT3","CH_GB18_A_41:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ALT-B04","text":"Ontological / Temporal level — Being is actual only as self-movement; its temporality is not linear, but the retroactive constitution of the beginning through its result.","refs":["CH_GB18_ZLOF:ALT4","CH_GB18_A_41:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:ALT-B05","text":"Methodological / Performative level — The exposition enacts its thesis by allowing no determination to stand without demonstrating its negation, limit, and return as conditions of its validity.","refs":["CH_GB18_CDMD:FGS6","CH_GB18_ZLOF:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_53:FL-01","text":"The architecture requires that negation can initially appear as external reflection, although its truth becomes intelligible only as already immanent self-negation; the mediation of these two statuses remains compressed.","refs":["CH_GB18_CDMD:A4","CH_GB18_CDMD:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:FL-02","text":"The transition from determinate possibility to necessary impossibility is operationally central, yet it is secured more as an asserted transition than as an independently developed deduction.","refs":["CH_GB18_ZLOF:MRT2","CH_GB18_ZLOF:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MP-01","text":"The mode mutates at the point where externality is comprehended no longer as the loss of the Absolute, but as that through which absolute identity is explicitly posited.","refs":["CH_GB18_CDMD:NX1","CH_GB18_CDMD:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MP-02","text":"Contingency mutates from a designation for groundlessness into a transitional structure whose double determination already generates necessity without being permitted to presuppose it.","refs":["CH_GB18_ZLOF:NX6","CH_GB18_ZLOF:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_53:HSI-01","text":"Reality appears as a self-differentiating machine that processes no outside, but produces its apparent outsides as its own states of reflection.","refs":["CH_GB18_CDMD:SD2","CH_GB18_ZLOF:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:HSI-02","text":"The subject appears not as an isolated observer, but as a finite configuration of a cognition that is true only insofar as it emerges from the movement of its object.","refs":["CH_GB18_A_41:DNX3","CH_GB18_A_41:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:HSI-03","text":"Time appears as recursive return, in which externalization does not remain a removal from itself, but becomes the condition of a more concrete self-presence.","refs":["CH_GB18_CDMD:FGS5","CH_GB18_A_41:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_53:MRT-B01","text":"The extracted axioms suffice to reconstruct the common architecture as the self-movement of negativity from immediate identity to necessary actuality.","refs":["CH_GB18_CDMD:MRT1","CH_GB18_ZLOF:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MRT-B02","text":"The reconstruction is strongest where it treats externality, possibility, and contingency not as counter-concepts of identity, but as its necessary self-differences.","refs":["CH_GB18_CDMD:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MRT-B03","text":"Underdetermined remain the transitions through which external reflection passes completely into absolute negativity and through which the possibility of the opposite necessarily inheres in every determinate possibility.","refs":["CH_GB18_CDMD:MRT2","CH_GB18_ZLOF:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_53:MRT-B04","text":"The cluster architecture remains coherent insofar as necessity is read not as a first ground, but as the terminal configuration of a self-mediation that retroactively determines its initial concepts.","refs":["CH_GB18_ZLOF:MRT7","CH_GB18_CDMD:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_53@R001","source_variant_id":"canonical:CL_GB18_53:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 157–159","context":"C. Der Modus des Absoluten. · Anmerkung. · A. Zufälligkeit oder formelle Wirklichkeit, Möglichkeit und Nothwendigkeit."},"title_language_code":"en"},{"id":"CL_GB18_54","layer":"CL","title":"Chapters 160–162","order":54,"parents":["CH_GB18_BRNO","CH_GB18_CAN0","CH_GB18_DV_2"],"revision":"CL_GB18_54@R001","sha256":"6eb8d23abf886c542e4b0a8e3d95690ab39c7f5645f633f7094e52b481d55247","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_54:AS-B01","text":"Das System rekonstruiert, wie eine zunächst voraussetzungsabhängige Modalität ihre äußeren Bedingungen in eigene Setzungen verwandelt, ohne die in ihr enthaltene Zufälligkeit auszutilgen.","refs":["CH_GB18_BRNO:AS6","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B02","text":"Möglichkeit verliert den Status einer abstrakten Alternative und wird als instabile Verteilung realer Bedingungen bestimmt, deren Bestehen bereits auf Selbstaufhebung drängt.","refs":["CH_GB18_BRNO:AS3","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B03","text":"Die Aufhebung des Bedingungsfeldes führt nicht aus der Wirklichkeit heraus, sondern erzeugt die wechselseitige Durchdringung von Möglichkeit und Wirklichkeit als Notwendigkeit.","refs":["CH_GB18_BRNO:AS4","CH_GB18_CAN0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B04","text":"Zufälligkeit wird vom Gegenbegriff der Notwendigkeit zu deren immanenter Bestimmtheit, weil jedes bestimmte Notwendige zugleich einen begrenzten Inhalt besitzt.","refs":["CH_GB18_BRNO:A12","CH_GB18_CAN0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B05","text":"Absolute Notwendigkeit entsteht erst dort, wo das Aufheben von Voraussetzungen rückwirkend das Selbst setzt, von dem dieses Aufheben ausgeht.","refs":["CH_GB18_CAN0:A6","CH_GB18_DV_2:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B06","text":"Die Identität von Sein und Wesen ist keine ruhende Endbestimmung, sondern die absolute Notwendigkeit, in der die vorherigen Modalitätsformen als eigene Momente zurückgenommen werden.","refs":["CH_GB18_CAN0:AS4","CH_GB18_CAN0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B07","text":"Substanz ist die operative Gestalt dieser Identität: Wirklichkeit besteht nur, indem sie ihre Erscheinung, ihren Untergang und ihre Reflexion als eigene Bewegung produziert.","refs":["CH_GB18_CAN0:A12","CH_GB18_DV_2:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B08","text":"Die Bewegung schließt auf dieser Ebene nicht mit ruhender Substantialität, sondern mit der Erzeugung einer selbstbezüglichen Negativität, durch die Kausalität notwendig wird.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_54:GA-01","text":"[Persistent] Wirklichkeit ist weder bloße Gegebenheit noch bloßes Erscheinen, sondern inhaltsvolle Selbstbeziehung, die sich nur in einer Mannigfaltigkeit eigener Gestalten erhält.","refs":["CH_GB18_BRNO:AS2","CH_GB18_DV_2:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-02","text":"[Mutating] Reale Möglichkeit ist kein vorwirklicher Zustand, sondern die Bedingungsmannigfaltigkeit einer Sache, deren immanenter Widerspruch ihre Aktualisierung erzwingt.","refs":["CH_GB18_BRNO:AS3","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-03","text":"[Mutating] Notwendigkeit gewinnt Bestimmtheit nicht durch Ausschluss, sondern durch Aufnahme der Zufälligkeit als eigener Negation.","refs":["CH_GB18_BRNO:A12","CH_GB18_CAN0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-04","text":"[Emergent] Eine Voraussetzung besitzt Wahrheit nur als rückwirkende Setzung der Bewegung, die zunächst von ihr abhängig zu sein schien.","refs":["CH_GB18_CAN0:A6","CH_GB18_DV_2:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-05","text":"[Attractor] Absolute Notwendigkeit ist die Selbstidentität des Seins in seiner Negation und daher der Punkt, an dem Modalität in substanzielle Selbstvermittlung übergeht.","refs":["CH_GB18_CAN0:A8","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-06","text":"[Persistent] Zufälligkeit ist die Bewegungsform der Notwendigkeit, nicht deren äußerer Rest oder ontologischer Gegenbereich.","refs":["CH_GB18_CAN0:A11","CH_GB18_DV_2:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-07","text":"[Emergent] Die Substanz existiert ausschließlich als scheinhafte Totalität ihrer Accidentalität; ihre Einheit ist keine Trennung von Erscheinung, sondern deren immanente Organisation.","refs":["CH_GB18_DV_2:A3","CH_GB18_DV_2:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-08","text":"[Attractor] Substanzielle Macht ist die identische Bewegung von Hervorbringen und Aufheben, in der Möglichkeit in Wirklichkeit und Wirklichkeit in Möglichkeit übergeht.","refs":["CH_GB18_DV_2:A10","CH_GB18_DV_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-09","text":"[Terminal] Kausalität entsteht, wenn die zunächst nur scheinende Accidentalität als für sich seiende Negativität gesetzt werden muß.","refs":["CH_GB18_DV_2:A14","CH_GB18_DV_2:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_54:RMD-01","text":"Formelle Notwendigkeit kehrt als notwendiger Ausgangspunkt wieder, verliert jedoch jede eigenständige Geltung, weil ihre Inhaltsleere nur den Übergang zur realen und absoluten Notwendigkeit auslöst.","refs":["CH_GB18_BRNO:AS1","CH_GB18_CAN0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RMD-02","text":"Reale Möglichkeit mutiert von der vorhandenen Vielheit äußerer Umstände zur Selbstnegation des Bedingungsfeldes und wird dadurch zum inneren Moment notwendiger Wirklichkeit.","refs":["CH_GB18_BRNO:AS3","CH_GB18_CAN0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RMD-03","text":"Bedingungen wandern von fremden Wirklichkeiten, die das Ansichsein einer Sache bilden, in die Selbstsetzung der notwendigen Bewegung und verlieren damit ihren Status als letzte Voraussetzungen.","refs":["CH_GB18_BRNO:A6","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RMD-04","text":"Zufälligkeit kehrt funktional wieder, aber ihre Valenz kehrt sich um: Was zunächst die Relativität der Notwendigkeit markiert, wird als deren Wesen und Bewegungsform bestimmt.","refs":["CH_GB18_BRNO:AS6","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RMD-05","text":"Absolute Wirklichkeit transformiert sich von einer noch an sich vorhandenen Einheit in absolute Notwendigkeit und danach in Substanz als manifestierte Selbstidentität.","refs":["CH_GB18_CAN0:AS2","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RMD-06","text":"Zerstörung verschwindet als bloß negativer Endpunkt und wird in die produktive Macht aufgenommen, durch die Substanz ihre eigenen Gestalten erzeugt und aufhebt.","refs":["CH_GB18_DV_2:A11","CH_GB18_DV_2:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_54:CGD-01","text":"Die Beschreibung realer Möglichkeit als vorhandene Mannigfaltigkeit bleibt lokal, solange Bedingungen als gegebene Umstände erscheinen; auf Clusterebene werden sie als retrospektiv gesetzte Momente der Notwendigkeit lesbar.","refs":["CH_GB18_BRNO:A5","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:CGD-02","text":"Die Beschränktheit eines bestimmten Notwendigen ist lokal eine Diagnose relativer Notwendigkeit; global organisiert sie die Umkehrung, durch welche Zufälligkeit zur inneren Bestimmtheit der Notwendigkeit wird.","refs":["CH_GB18_BRNO:A12","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:CGD-03","text":"Die Ohnmacht einzelner Accidenzen ist nicht bloß eine Theorie der Abhängigkeit, sondern die gegenwärtige Ebene, auf der Pluralität als artikulierte Totalität der substantiellen Macht erscheint.","refs":["CH_GB18_DV_2:A12","CH_GB18_DV_2:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:CGD-04","text":"Die formelle Einheit von Substanz und Accidenzen bleibt ein lokales Defizit, das auf Clusterebene als produktive Unzulänglichkeit begriffen wird, weil erst ihr Mangel an realem Unterschied den Übergang zur Kausalität erzeugt.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_54:GNX-01","text":"Ausgeschlossen wird jede Möglichkeit, die sich auf bloße Widerspruchslosigkeit beschränkt und keinen realen Bedingungszusammenhang enthält.","refs":["CH_GB18_BRNO:NX4","CH_GB18_CAN0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GNX-02","text":"Ausgeschlossen wird jede Erklärung, die Bedingungen oder Wirken durch eine äußerliche Reflexion, einen fremden Grund oder ein gegenüberstehendes Objekt bestimmt.","refs":["CH_GB18_BRNO:NX6","CH_GB18_DV_2:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GNX-03","text":"Ausgeschlossen wird sowohl ein hinter den Erscheinungen ruhendes Substrat als auch eine Mehrzahl selbstmächtiger Accidenzen.","refs":["CH_GB18_DV_2:NX5","CH_GB18_DV_2:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GNX-04","text":"Ausgeschlossen wird eine Notwendigkeit, die Zufälligkeit als bloße Störung oder eliminierbaren Zusatz behandeln könnte.","refs":["CH_GB18_CAN0:NX3","CH_GB18_DV_2:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_54:DBN-01","text":"Unzulässig ist ein Grundmodell, in dem Notwendigkeit durch eine ihr vorausliegende Bedingung erklärt wird, statt die Bedingung als eigenes Resultat zu setzen.","refs":["CH_GB18_CAN0:DNX1","CH_GB18_DV_2:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:DBN-02","text":"Unzulässig ist eine Ontologie endlicher Selbständigkeiten, in der einzelne Wirklichkeiten oder Accidenzen ohne immanente negative Beziehung zur Totalität fortbestehen könnten.","refs":["CH_GB18_CAN0:DNX2","CH_GB18_DV_2:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:DBN-03","text":"Unzulässig ist ein positives Absolutes, das weder Negativität noch Entäußerung noch fortgesetzte Selbstunterscheidung in sich trüge.","refs":["CH_GB18_CAN0:SNX1","CH_GB18_DV_2:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_54:BSA-01","text":"Unverfügbar bleibt ein Absolutes außerhalb seiner eigenen Manifestation; es besitzt keine Wahrheit jenseits von Schein, Accidentalität und Selbstnegation.","refs":["CH_GB18_DV_2:SNX1","CH_GB18_CAN0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:BSA-02","text":"Unmöglich bleibt eine vollendete Wirklichkeit, die Möglichkeit und Zufälligkeit endgültig ausschlösse, weil ihre Ausschließung selbst in leere Bestimmtheit zurückfiele.","refs":["CH_GB18_BRNO:SNX3","CH_GB18_CAN0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:BSA-03","text":"Unverfügbar bleibt ein absoluter Anfang vor aller Setzung, weil jede Setzung bereits das Selbst voraussetzt, das erst im Aufheben seines Vorausgesetzten hervorgeht.","refs":["CH_GB18_DV_2:SNX2","CH_GB18_DV_2:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_54:XD-01","text":"Die vollständige Bedingung wird erst im Vollzug ihrer Selbstaufhebung zur eigenen Voraussetzung der Sache; Verwirklichung ist daher rückwirkende Selbstbegründung. Trace Type — Composite.","refs":["CL_GB18_54:GA-02","CL_GB18_54:GA-04","CH_GB18_BRNO:AS4","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:XD-02","text":"Zufälligkeit ist weder äußerer Rest relativer Notwendigkeit noch bloße Erscheinung absoluter Notwendigkeit, sondern die Form, in der Notwendigkeit ihre Bestimmtheit ausübt. Trace Type — Composite.","refs":["CL_GB18_54:GA-03","CL_GB18_54:GA-06","CH_GB18_BRNO:AS6","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:XD-03","text":"Der Übergang von absoluter Notwendigkeit zu Substanz wandelt blinden Untergang in Selbstmanifestation um: Das Verschwinden scheinbar selbständiger Wirklichkeiten ist die Auslegung der absoluten Identität. Trace Type — Composite.","refs":["CL_GB18_54:GA-05","CL_GB18_54:GA-07","CH_GB18_CAN0:AS5","CH_GB18_DV_2:A3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:XD-04","text":"Die Identität von Schaffen und Zerstören entzieht der Modalbewegung jede lineare Zeitform, weil die Aufhebung von Wirklichkeit zugleich Rückkehr in Möglichkeit und Voraussetzung neuen Hervorgehens ist. Trace Type — Composite.","refs":["CL_GB18_54:GA-02","CL_GB18_54:GA-08","CH_GB18_BRNO:AS4","CH_GB18_DV_2:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:XD-05","text":"Kausalität erscheint als notwendige Differenzproduktion der Substanz, weil deren erste Einheit mit den Accidenzen ihre eigene Macht noch nicht als reale Gegenüberstellung artikulieren kann. Trace Type — Tension.","refs":["CL_GB18_54:GA-07","CL_GB18_54:GA-09","CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_54:BSD-01","text":"Der Grund verändert seinen Status: Er ist nicht der Boden, auf dem die Bewegung stattfindet, sondern das Resultat einer Bewegung, die ihre Voraussetzung durch Aufhebung produziert.","refs":["CL_GB18_54:GA-04","CL_GB18_54:GA-05","CH_GB18_DV_2:A8","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:BSD-02","text":"Zeitlichkeit wird als rekursive Modalzeit bestimmt, in der jeder Übergang zugleich Rückgang in Möglichkeit, Setzung eines Grundes und Hervorgehen notwendiger Wirklichkeit ist.","refs":["CL_GB18_54:GA-02","CL_GB18_54:GA-08","CH_GB18_DV_2:D3","CH_GB18_DV_2:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:BSD-03","text":"Pluralität besitzt abgeleitete Realität: Sie ist weder Illusion noch autonome Vielheit, sondern die Artikulation einer Totalität, die ihre Differenzen setzt, verteilt und zurücknimmt.","refs":["CL_GB18_54:GA-07","CL_GB18_54:GA-08","CH_GB18_DV_2:A9","CH_GB18_DV_2:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:BSD-04","text":"Absolute Identität erzeugt keine finale Ruhe, sondern muß sich als Differenz entfalten; Kausalität ist der Preis und die Explikation ihrer Nicht-Ruhe.","refs":["CL_GB18_54:GA-05","CL_GB18_54:GA-09","CH_GB18_DV_2:SNX3","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:BSD-05","text":"Erklärung wird von der Suche nach äußeren Gründen zur Rekonstruktion einer Bewegung, in der das Vorausgesetzte als Ergebnis der Sache selbst erscheint.","refs":["CL_GB18_54:GA-04","CL_GB18_54:GA-07","CH_GB18_DV_2:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_54:RLE-01","text":"Das Bedingungsfeld bildet eine rekursive Schleife: reale Möglichkeit existiert als Mannigfaltigkeit, diese Mannigfaltigkeit enthält Widerspruch, und ihre Selbstaufhebung setzt die Wirklichkeit, deren Möglichkeit sie war.","refs":["CH_GB18_BRNO:A7","CH_GB18_BRNO:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RLE-02","text":"Notwendigkeit und Zufälligkeit bilden einen Umkehrkreislauf, in dem Notwendigkeit sich als Zufälligkeit bestimmt und Zufälligkeit als ihr Wesen zurückkehrt.","refs":["CH_GB18_CAN0:A7","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RLE-03","text":"Substanz und Accidentalität bilden einen Erscheinungsattraktor: Die Substanz umfaßt die Accidentalität als Totalität, während Accidentalität dieselbe Totalität in der Form des Scheins ausführt.","refs":["CH_GB18_DV_2:A4","CH_GB18_DV_2:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RLE-04","text":"Die Eskalation von Substantialität zu Kausalität verläuft über ein produktives Scheitern, weil die zunächst formelle Einheit ihre fehlende reale Differenz selbst hervorbringen muß.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RLE-05","text":"Der begriffliche Attraktor des Clusters ist die Identität in Negation: Modalität, Wirklichkeit, Substanz und Kausalität konvergieren auf die Forderung, daß Selbstgleichheit nur als Selbstunterscheidung besteht.","refs":["CH_GB18_CAN0:A8","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_54:FGS-B01","text":"Formelle Notwendigkeit ohne selbständige Gliederung → Gleichgültigkeit gegen Formdifferenz → reale Wirklichkeit als inhaltsvolle Mannigfaltigkeit.","refs":["CH_GB18_BRNO:AS1","CH_GB18_BRNO:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FGS-B02","text":"Reale Wirklichkeit → reales Ansichsein → reale Möglichkeit als Bedingungsmannigfaltigkeit → immanenter Widerspruch.","refs":["CH_GB18_BRNO:AS3","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FGS-B03","text":"Immanenter Widerspruch der Bedingungen → Selbstaufhebung des Bedingungsfeldes → wechselseitige Aktualisierung von Wirklichkeit und Möglichkeit → reale Notwendigkeit.","refs":["CH_GB18_BRNO:AS4","CH_GB18_BRNO:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FGS-B04","text":"Relative Notwendigkeit mit äußerer Voraussetzung → Selbstsetzung der Voraussetzung → Identität von Sein und Wesen → absolute Notwendigkeit.","refs":["CH_GB18_CAN0:A6","CH_GB18_CAN0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FGS-B05","text":"Absolute Notwendigkeit → Identität in Negation → Substanz → Scheinen als eigene Wirklichkeit und Accidentalität als artikulierte Totalität.","refs":["CH_GB18_CAN0:A12","CH_GB18_DV_2:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FGS-B06","text":"Substanzielle Macht → identisches Hervorbringen und Aufheben → formelle Einheit mit Accidentalität → selbstbezügliche Negativität → Kausalität.","refs":["CH_GB18_DV_2:A10","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_54:AFM-B01","text":"Formelle Modalität ohne selbständige Inhaltsgliederung → reale Wirklichkeit als inhaltsvolle Selbstbeziehung.","refs":["CH_GB18_BRNO:AS1","CH_GB18_BRNO:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AFM-B02","text":"Reale Wirklichkeit → Möglichkeit als vorhandenes Bedingungsfeld → Widerspruch der Bedingungen.","refs":["CH_GB18_BRNO:AS3","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AFM-B03","text":"Widerspruch der Bedingungen → Selbstaufhebung → Zusammengehen von Möglichkeit und Wirklichkeit → relative Notwendigkeit.","refs":["CH_GB18_BRNO:AS4","CH_GB18_BRNO:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AFM-B04","text":"Relative Notwendigkeit → Selbstsetzung ihrer Voraussetzung → absolute Notwendigkeit ohne äußeren Grund.","refs":["CH_GB18_CAN0:A6","CH_GB18_CAN0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AFM-B05","text":"Absolute Notwendigkeit → Sein in seiner Negation → Substanz als in sich reflektierte Wirklichkeit.","refs":["CH_GB18_CAN0:A8","CH_GB18_DV_2:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AFM-B06","text":"Substanz als scheinhafte Totalität → Accidentalität und Macht → unzureichende formelle Einheit → Kausalität.","refs":["CH_GB18_DV_2:A4","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_54:MME-01","text":"Möglichkeit wird von einer Denkmodalität zu einer Karte realer Bedingungsverteilungen umklassifiziert, deren Instabilität bereits die Sache selbst artikuliert.","refs":["CH_GB18_BRNO:ME1","CH_GB18_BRNO:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MME-02","text":"Zufälligkeit wird von der Alternative zur Notwendigkeit zu deren innerem Übergangsmodus reklassifiziert.","refs":["CH_GB18_CAN0:ME1","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MME-03","text":"Die Opposition von bleibender Substanz und wechselnden Accidenzen bricht zusammen und wird durch die Selbstunterscheidung einer einzigen Totalität ersetzt.","refs":["CH_GB18_DV_2:ME1","CH_GB18_DV_2:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MME-04","text":"Kausalität erscheint nicht als äußerliche Relationsform zwischen bereits selbständigen Dingen, sondern als Explikation eines inneren Defizits substantieller Form.","refs":["CH_GB18_DV_2:ME5","CH_GB18_DV_2:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_54:ALT-B01","text":"Auf der Oberflächenebene reorganisiert das System die Beziehungen von Wirklichkeit, Möglichkeit, Zufälligkeit, Notwendigkeit, Substanz und Accidentalität.","refs":["CH_GB18_BRNO:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:ALT-B02","text":"Auf der strukturellen Ebene wird Notwendigkeit als Selbstbewegung bestimmt, die ihre Momente setzt, aufhebt und als eigene Voraussetzungen reproduziert.","refs":["CH_GB18_CAN0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:ALT-B03","text":"Auf der metastrategischen Ebene ersetzt die Rekonstruktion immanenter Selbstsetzung jede Erklärung durch äußere Ursachen, Gründe oder Träger.","refs":["CH_GB18_DV_2:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:ALT-B04","text":"Auf der ontologischen und temporalen Ebene ist Sein nur als reflektiertes Scheinen wirklich, während Entstehen und Vergehen Formen der Rückkehr in Möglichkeit sind.","refs":["CH_GB18_DV_2:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:ALT-B05","text":"Auf der methodologischen und performativen Ebene vollzieht die Darstellung ihre eigene These, indem jede vorausgesetzte Gestalt als Resultat einer sie rückwirkend begründenden Bewegung erscheint.","refs":["CH_GB18_DV_2:D1","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_54:FL-01","text":"Die Totalität der Bedingungen bleibt hinsichtlich der Erzeugung ihres konkreten Inhalts unterbestimmt; ihre Vollständigkeit fungiert als notwendige Kompression, nicht als vollständig ausgewiesene Genesis.","refs":["CH_GB18_BRNO:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FL-02","text":"Zwischen absoluter Identität und der fortbestehenden Erscheinung freier Wirklichkeiten bleibt eine Bruchlinie bestehen, die erst durch die Deutung ihrer Blindheit als Selbstoffenbarung überbrückt wird.","refs":["CH_GB18_CAN0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FL-03","text":"Die Substanz soll keinen realen Unterschied zu ihren Accidenzen enthalten, muß aber gerade eine solche Differenz erzeugen, damit Kausalität hervorgehen kann.","refs":["CH_GB18_DV_2:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MP-01","text":"Der entscheidende Mutationspunkt liegt im Übergang von der Selbstaufhebung der Bedingungen zu ihrer Bestimmung als eigener Setzung der Notwendigkeit.","refs":["CH_GB18_BRNO:AS4","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MP-02","text":"Der Begriff der Zufälligkeit wechselt seine Funktion, indem er von der Begrenzung relativer Notwendigkeit zur positiven Bestimmtheit absoluter Notwendigkeit wird.","refs":["CH_GB18_CAN0:A2","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MP-03","text":"Accidentalität mutiert von bloßem Scheinen zur für sich seienden Negativität; diese Mutation ist der Übergangspunkt von Substantialität zu Kausalität.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_54:HSI-01","text":"Die Realität erscheint als Maschine rekursiver Selbstvermittlung, die jeden Grund nur dadurch besitzt, daß sie ihn als aufgehobene Voraussetzung erzeugt.","refs":["CH_GB18_DV_2:A1","CH_GB18_DV_2:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:HSI-02","text":"Jede scheinbar selbständige Einheit erscheint als abgeleitete Gestalt einer sie übergreifenden Macht und nicht als ontologisch autonomer Träger eigener Wirksamkeit.","refs":["CH_GB18_DV_2:A12","CH_GB18_CAN0:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:HSI-03","text":"Zeit ist keine irreversible Folge von Hervorbringen und Verlust, sondern der rekursive Umschlag, in dem Wirklichkeit, Möglichkeit, Schaffen und Zerstören ineinander zurückkehren.","refs":["CH_GB18_DV_2:ALT4","CH_GB18_DV_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:HSI-04","text":"Mögliche Orientierung besteht nicht in der Auffindung eines äußeren Grundes, sondern in der Nachzeichnung der immanenten Bewegung, durch welche Voraussetzung, Erscheinung und Ursache erzeugt werden.","refs":["CH_GB18_DV_2:ALT3","CH_GB18_DV_2:D4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_54:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Clusterbewegung von realer Möglichkeit über relative und absolute Notwendigkeit zur Substanz und zum Umschlag in Kausalität zu rekonstruieren.","refs":["CH_GB18_CAN0:MRT1","CH_GB18_DV_2:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MRT-B02","text":"Unterbestimmt bleibt die Genesis der inhaltlichen Bestimmtheit, aus der konkrete Sachen und ihre vollständigen Bedingungsfelder hervorgehen.","refs":["CH_GB18_BRNO:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MRT-B03","text":"Die stärkste Operation der Clusterarchitektur liegt in der Umwandlung von Zufälligkeit und Negativität aus äußerlichen Gegeninstanzen in notwendige Bewegungsformen des Absoluten.","refs":["CH_GB18_CAN0:MRT4","CH_GB18_DV_2:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MRT-B04","text":"Die Rekonstruktion bleibt auf die produktive Unaufgelöstheit angewiesen, daß Kausalität zugleich aus der Unzulänglichkeit der Substantialität hervorgeht und deren realen Unterschied erstmals erzeugt.","refs":["CH_GB18_DV_2:MRT3","CH_GB18_CAN0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123053071075Z_2a854015","language_code":"en","language_name":"English","title":"Chapters 160–162","source_sha256":"6eb8d23abf886c542e4b0a8e3d95690ab39c7f5645f633f7094e52b481d55247","sha256":"0f2700a1b1b1a26b25f3184fe638d8fe480b5aa55998b645dbda9639212f0a2b","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:30:53.073060+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_54:AS-B01","text":"The system reconstructs how an initially presupposition-dependent modality transforms its external conditions into its own posits without eliminating the contingency contained within it.","refs":["CH_GB18_BRNO:AS6","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B02","text":"Possibility loses the status of an abstract alternative and is determined as an unstable distribution of real conditions, whose persistence already presses toward self-sublation.","refs":["CH_GB18_BRNO:AS3","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B03","text":"The sublation of the field of conditions does not lead out of actuality, but produces the reciprocal interpenetration of possibility and actuality as necessity.","refs":["CH_GB18_BRNO:AS4","CH_GB18_CAN0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B04","text":"Contingency changes from the counter-concept of necessity into its immanent determinacy, because every determinate necessary has at the same time a limited content.","refs":["CH_GB18_BRNO:A12","CH_GB18_CAN0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B05","text":"Absolute necessity arises only where the sublating of presuppositions retroactively posits the self from which this sublating proceeds.","refs":["CH_GB18_CAN0:A6","CH_GB18_DV_2:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B06","text":"The identity of being and essence is not a resting final determination, but absolute necessity, in which the preceding forms of modality are taken back as its own moments.","refs":["CH_GB18_CAN0:AS4","CH_GB18_CAN0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B07","text":"Substance is the operative shape of this identity: actuality exists only by producing its appearance, its perishing, and its reflection as its own movement.","refs":["CH_GB18_CAN0:A12","CH_GB18_DV_2:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AS-B08","text":"At this level, the movement does not conclude with resting substantiality, but with the production of a self-referential negativity through which causality becomes necessary.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_54:GA-01","text":"[Persistent] Actuality is neither mere givenness nor mere appearance, but contentful self-relation, which maintains itself only in a multiplicity of its own shapes.","refs":["CH_GB18_BRNO:AS2","CH_GB18_DV_2:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-02","text":"[Mutating] Real possibility is not a pre-actual state, but the multiplicity of conditions of a thing, whose immanent contradiction compels its actualization.","refs":["CH_GB18_BRNO:AS3","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-03","text":"[Mutating] Necessity gains determinacy not through exclusion, but through the incorporation of contingency as its own negation.","refs":["CH_GB18_BRNO:A12","CH_GB18_CAN0:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-04","text":"[Emergent] A presupposition possesses truth only as the retroactive positing of the movement that initially appeared to depend upon it.","refs":["CH_GB18_CAN0:A6","CH_GB18_DV_2:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-05","text":"[Attractor] Absolute necessity is the self-identity of being in its negation and is therefore the point at which modality passes over into substantial self-mediation.","refs":["CH_GB18_CAN0:A8","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-06","text":"[Persistent] Contingency is the form of movement of necessity, not its external remainder or ontological counter-domain.","refs":["CH_GB18_CAN0:A11","CH_GB18_DV_2:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-07","text":"[Emergent] Substance exists exclusively as the apparent totality of its accidentality; its unity is not a separation from appearance, but its immanent organization.","refs":["CH_GB18_DV_2:A3","CH_GB18_DV_2:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-08","text":"[Attractor] Substantial power is the identical movement of bringing-forth and sublating, in which possibility passes over into actuality and actuality into possibility.","refs":["CH_GB18_DV_2:A10","CH_GB18_DV_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GA-09","text":"[Terminal] Causality arises when the initially merely apparent accidentality must be posited as negativity existing for itself.","refs":["CH_GB18_DV_2:A14","CH_GB18_DV_2:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_54:RMD-01","text":"Formal necessity recurs as a necessary point of departure, yet loses every independent validity, because its emptiness of content only triggers the transition to real and absolute necessity.","refs":["CH_GB18_BRNO:AS1","CH_GB18_CAN0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RMD-02","text":"Real possibility mutates from the existing multiplicity of external circumstances into the self-negation of the field of conditions and thereby becomes the inner moment of necessary actuality.","refs":["CH_GB18_BRNO:AS3","CH_GB18_CAN0:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RMD-03","text":"Conditions migrate from alien actualities, which constitute the being-in-itself of a thing, into the self-positing of necessary movement and thereby lose their status as ultimate presuppositions.","refs":["CH_GB18_BRNO:A6","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RMD-04","text":"Contingency recurs functionally, but its valence is reversed: what initially marks the relativity of necessity is determined as its essence and form of movement.","refs":["CH_GB18_BRNO:AS6","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RMD-05","text":"Absolute actuality transforms itself from a unity still present in itself into absolute necessity and thereafter into substance as manifested self-identity.","refs":["CH_GB18_CAN0:AS2","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RMD-06","text":"Destruction disappears as a merely negative endpoint and is incorporated into the productive power through which substance brings forth and sublates its own shapes.","refs":["CH_GB18_DV_2:A11","CH_GB18_DV_2:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_54:CGD-01","text":"The description of real possibility as an existing multiplicity remains local so long as conditions appear as given circumstances; at the cluster level, they become legible as retrospectively posited moments of necessity.","refs":["CH_GB18_BRNO:A5","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:CGD-02","text":"The limitation of a determinate necessary is locally a diagnosis of relative necessity; globally, it organizes the reversal through which contingency becomes the inner determinacy of necessity.","refs":["CH_GB18_BRNO:A12","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:CGD-03","text":"The powerlessness of individual accidents is not merely a theory of dependence, but the present level at which plurality appears as the articulated totality of substantial power.","refs":["CH_GB18_DV_2:A12","CH_GB18_DV_2:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:CGD-04","text":"The formal unity of substance and accidents remains a local deficit, which at the cluster level is understood as productive inadequacy, because only its lack of real difference produces the transition to causality.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:MRT3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_54:GNX-01","text":"Excluded is every possibility that confines itself to mere non-contradiction and contains no real nexus of conditions.","refs":["CH_GB18_BRNO:NX4","CH_GB18_CAN0:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GNX-02","text":"Excluded is every explanation that determines conditions or efficacy through external reflection, an alien ground, or an opposed object.","refs":["CH_GB18_BRNO:NX6","CH_GB18_DV_2:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GNX-03","text":"Excluded are both a substrate resting behind appearances and a plurality of self-empowered accidents.","refs":["CH_GB18_DV_2:NX5","CH_GB18_DV_2:NX6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:GNX-04","text":"Excluded is a necessity that could treat contingency as a mere disturbance or eliminable addition.","refs":["CH_GB18_CAN0:NX3","CH_GB18_DV_2:DNX5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_54:DBN-01","text":"Inadmissible is a model of ground in which necessity is explained through a condition preceding it, instead of positing the condition as its own result.","refs":["CH_GB18_CAN0:DNX1","CH_GB18_DV_2:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:DBN-02","text":"Inadmissible is an ontology of finite self-subsistences in which individual actualities or accidents could persist without an immanent negative relation to totality.","refs":["CH_GB18_CAN0:DNX2","CH_GB18_DV_2:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:DBN-03","text":"Inadmissible is a positive Absolute that contained within itself neither negativity, nor externalization, nor continued self-differentiation.","refs":["CH_GB18_CAN0:SNX1","CH_GB18_DV_2:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_54:BSA-01","text":"Unavailable remains an Absolute outside its own manifestation; it possesses no truth beyond semblance, accidentality, and self-negation.","refs":["CH_GB18_DV_2:SNX1","CH_GB18_CAN0:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:BSA-02","text":"Impossible remains a completed actuality that would definitively exclude possibility and contingency, because their exclusion itself would fall back into empty determinacy.","refs":["CH_GB18_BRNO:SNX3","CH_GB18_CAN0:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:BSA-03","text":"Unavailable remains an absolute beginning before all positing, because every positing already presupposes the self that first emerges in the sublating of its presupposed.","refs":["CH_GB18_DV_2:SNX2","CH_GB18_DV_2:A8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_54:XD-01","text":"The complete condition becomes its own presupposition of the thing only in the enactment of its self-sublation; actualization is therefore retroactive self-grounding. Trace Type — Composite.","refs":["CL_GB18_54:GA-02","CL_GB18_54:GA-04","CH_GB18_BRNO:AS4","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:XD-02","text":"Contingency is neither the external remainder of relative necessity nor the mere appearance of absolute necessity, but the form in which necessity exercises its determinacy. Trace Type — Composite.","refs":["CL_GB18_54:GA-03","CL_GB18_54:GA-06","CH_GB18_BRNO:AS6","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:XD-03","text":"The transition from absolute necessity to substance transforms blind perishing into self-manifestation: the disappearance of apparently self-subsistent actualities is the exposition of absolute identity. Trace Type — Composite.","refs":["CL_GB18_54:GA-05","CL_GB18_54:GA-07","CH_GB18_CAN0:AS5","CH_GB18_DV_2:A3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:XD-04","text":"The identity of creating and destroying deprives modal movement of every linear form of time, because the sublation of actuality is at once return into possibility and the presupposition of new emergence. Trace Type — Composite.","refs":["CL_GB18_54:GA-02","CL_GB18_54:GA-08","CH_GB18_BRNO:AS4","CH_GB18_DV_2:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:XD-05","text":"Causality appears as the necessary production of difference by substance, because its first unity with the accidents cannot yet articulate its own power as a real opposition. Trace Type — Tension.","refs":["CL_GB18_54:GA-07","CL_GB18_54:GA-09","CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_54:BSD-01","text":"Ground changes its status: it is not the basis upon which movement takes place, but the result of a movement that produces its presupposition through sublation.","refs":["CL_GB18_54:GA-04","CL_GB18_54:GA-05","CH_GB18_DV_2:A8","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:BSD-02","text":"Temporality is determined as recursive modal time, in which every transition is at once regression into possibility, positing of a ground, and emergence of necessary actuality.","refs":["CL_GB18_54:GA-02","CL_GB18_54:GA-08","CH_GB18_DV_2:D3","CH_GB18_DV_2:A11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:BSD-03","text":"Plurality possesses derived reality: it is neither illusion nor autonomous multiplicity, but the articulation of a totality that posits, distributes, and takes back its differences.","refs":["CL_GB18_54:GA-07","CL_GB18_54:GA-08","CH_GB18_DV_2:A9","CH_GB18_DV_2:A12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:BSD-04","text":"Absolute identity produces no final repose, but must unfold itself as difference; causality is the price and the explication of its non-repose.","refs":["CL_GB18_54:GA-05","CL_GB18_54:GA-09","CH_GB18_DV_2:SNX3","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_54:BSD-05","text":"Explanation changes from the search for external grounds into the reconstruction of a movement in which the presupposed appears as the result of the thing itself.","refs":["CL_GB18_54:GA-04","CL_GB18_54:GA-07","CH_GB18_DV_2:ALT3"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_54:RLE-01","text":"The field of conditions forms a recursive loop: real possibility exists as multiplicity, this multiplicity contains contradiction, and its self-sublation posits the actuality whose possibility it was.","refs":["CH_GB18_BRNO:A7","CH_GB18_BRNO:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RLE-02","text":"Necessity and contingency form a cycle of reversal in which necessity determines itself as contingency and contingency returns as its essence.","refs":["CH_GB18_CAN0:A7","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RLE-03","text":"Substance and accidentality form an attractor of appearance: substance encompasses accidentality as totality, while accidentality enacts that same totality in the form of semblance.","refs":["CH_GB18_DV_2:A4","CH_GB18_DV_2:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RLE-04","text":"The escalation from substantiality to causality proceeds through a productive failure, because the initially formal unity must itself bring forth its lacking real difference.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:RLE-05","text":"The conceptual attractor of the cluster is identity in negation: modality, actuality, substance, and causality converge upon the demand that self-sameness exists only as self-differentiation.","refs":["CH_GB18_CAN0:A8","CH_GB18_CAN0:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_54:FGS-B01","text":"Formal necessity without independent articulation → indifference toward difference of form → real actuality as contentful multiplicity.","refs":["CH_GB18_BRNO:AS1","CH_GB18_BRNO:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FGS-B02","text":"Real actuality → real being-in-itself → real possibility as multiplicity of conditions → immanent contradiction.","refs":["CH_GB18_BRNO:AS3","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FGS-B03","text":"Immanent contradiction of the conditions → self-sublation of the field of conditions → reciprocal actualization of actuality and possibility → real necessity.","refs":["CH_GB18_BRNO:AS4","CH_GB18_BRNO:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FGS-B04","text":"Relative necessity with external presupposition → self-positing of the presupposition → identity of being and essence → absolute necessity.","refs":["CH_GB18_CAN0:A6","CH_GB18_CAN0:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FGS-B05","text":"Absolute necessity → identity in negation → substance → semblance as its own actuality and accidentality as articulated totality.","refs":["CH_GB18_CAN0:A12","CH_GB18_DV_2:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FGS-B06","text":"Substantial power → identical bringing-forth and sublating → formal unity with accidentality → self-referential negativity → causality.","refs":["CH_GB18_DV_2:A10","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_54:AFM-B01","text":"Formal modality without independent articulation of content → real actuality as contentful self-relation.","refs":["CH_GB18_BRNO:AS1","CH_GB18_BRNO:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AFM-B02","text":"Real actuality → possibility as existing field of conditions → contradiction of the conditions.","refs":["CH_GB18_BRNO:AS3","CH_GB18_BRNO:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AFM-B03","text":"Contradiction of the conditions → self-sublation → convergence of possibility and actuality → relative necessity.","refs":["CH_GB18_BRNO:AS4","CH_GB18_BRNO:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AFM-B04","text":"Relative necessity → self-positing of its presupposition → absolute necessity without external ground.","refs":["CH_GB18_CAN0:A6","CH_GB18_CAN0:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AFM-B05","text":"Absolute necessity → being in its negation → substance as actuality reflected into itself.","refs":["CH_GB18_CAN0:A8","CH_GB18_DV_2:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:AFM-B06","text":"Substance as apparent totality → accidentality and power → inadequate formal unity → causality.","refs":["CH_GB18_DV_2:A4","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_54:MME-01","text":"Possibility is reclassified from a modality of thought into a map of real distributions of conditions, whose instability already articulates the thing itself.","refs":["CH_GB18_BRNO:ME1","CH_GB18_BRNO:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MME-02","text":"Contingency is reclassified from the alternative to necessity into its inner mode of transition.","refs":["CH_GB18_CAN0:ME1","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MME-03","text":"The opposition of enduring substance and changing accidents collapses and is replaced by the self-differentiation of a single totality.","refs":["CH_GB18_DV_2:ME1","CH_GB18_DV_2:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MME-04","text":"Causality appears not as an external form of relation between already self-subsistent things, but as the explication of an inner deficit of substantial form.","refs":["CH_GB18_DV_2:ME5","CH_GB18_DV_2:SD5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_54:ALT-B01","text":"At the surface level, the system reorganizes the relations of actuality, possibility, contingency, necessity, substance, and accidentality.","refs":["CH_GB18_BRNO:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:ALT-B02","text":"At the structural level, necessity is determined as self-movement that posits, sublates, and reproduces its moments as its own presuppositions.","refs":["CH_GB18_CAN0:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:ALT-B03","text":"At the metastrategic level, the reconstruction of immanent self-positing replaces every explanation through external causes, grounds, or bearers.","refs":["CH_GB18_DV_2:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:ALT-B04","text":"At the ontological and temporal level, being is actual only as reflected semblance, while coming-to-be and passing-away are forms of return into possibility.","refs":["CH_GB18_DV_2:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:ALT-B05","text":"At the methodological and performative level, the presentation enacts its own thesis by having every presupposed shape appear as the result of a movement that retroactively grounds it.","refs":["CH_GB18_DV_2:D1","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_54:FL-01","text":"The totality of conditions remains underdetermined with respect to the generation of its concrete content; its completeness functions as necessary compression, not as a fully demonstrated genesis.","refs":["CH_GB18_BRNO:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FL-02","text":"A fault line persists between absolute identity and the continuing appearance of free actualities, which is bridged only by interpreting their blindness as self-revelation.","refs":["CH_GB18_CAN0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:FL-03","text":"Substance is supposed to contain no real difference from its accidents, yet it must produce precisely such a difference in order that causality may emerge.","refs":["CH_GB18_DV_2:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MP-01","text":"The decisive mutation point lies in the transition from the self-sublation of conditions to their determination as the necessity's own positing.","refs":["CH_GB18_BRNO:AS4","CH_GB18_CAN0:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MP-02","text":"The concept of contingency changes its function by becoming, from the limitation of relative necessity, the positive determinacy of absolute necessity.","refs":["CH_GB18_CAN0:A2","CH_GB18_CAN0:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MP-03","text":"Accidentality mutates from mere semblance into negativity existing for itself; this mutation is the point of transition from substantiality to causality.","refs":["CH_GB18_DV_2:A13","CH_GB18_DV_2:A14"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_54:HSI-01","text":"Reality appears as a machine of recursive self-mediation, which possesses every ground only by producing it as a sublated presupposition.","refs":["CH_GB18_DV_2:A1","CH_GB18_DV_2:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:HSI-02","text":"Every apparently self-subsistent unity appears as a derived shape of a power encompassing it, and not as an ontologically autonomous bearer of its own efficacy.","refs":["CH_GB18_DV_2:A12","CH_GB18_CAN0:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:HSI-03","text":"Time is not an irreversible sequence of production and loss, but the recursive reversal in which actuality, possibility, creating, and destroying return into one another.","refs":["CH_GB18_DV_2:ALT4","CH_GB18_DV_2:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:HSI-04","text":"Possible orientation consists not in finding an external ground, but in retracing the immanent movement through which presupposition, appearance, and cause are produced.","refs":["CH_GB18_DV_2:ALT3","CH_GB18_DV_2:D4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_54:MRT-B01","text":"The extracted axioms suffice to reconstruct the cluster movement from real possibility through relative and absolute necessity to substance and the reversal into causality.","refs":["CH_GB18_CAN0:MRT1","CH_GB18_DV_2:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MRT-B02","text":"What remains underdetermined is the genesis of the determinacy of content from which concrete things and their complete fields of conditions emerge.","refs":["CH_GB18_BRNO:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MRT-B03","text":"The strongest operation of the cluster architecture lies in the transformation of contingency and negativity from external counter-instances into necessary forms of movement of the Absolute.","refs":["CH_GB18_CAN0:MRT4","CH_GB18_DV_2:MRT5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_54:MRT-B04","text":"The reconstruction remains dependent on the productive unresolvedness that causality both arises from the inadequacy of substantiality and first produces its real difference.","refs":["CH_GB18_DV_2:MRT3","CH_GB18_CAN0:MRT5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_54@R001","source_variant_id":"canonical:CL_GB18_54:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 160–162","context":"B. Relative Nothwendigkeit oder reale Wirklichkeit, Möglichkeit und Nothwendigkeit. · C. Absolute Nothwendigkeit. · A. Das Verhältniß der Substantialität."},"title_language_code":"en"},{"id":"CL_GB18_55","layer":"CL","title":"Chapters 163–165","order":55,"parents":["CH_GB18_BDKT","CH_GB18_DFKT","CH_GB18_BDBK"],"revision":"CL_GB18_55@R001","sha256":"dbb783c20488a4727a3d84c579b9f0c36fa07a5a9790e25dd27a344dfc2f959d","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_55:AS-B01","text":"Das Cluster rekonstruiert Kausalität als Problem der Vermittlung zwischen substantieller Selbstmacht, gesetzter Wirkung und endlicher Äußerlichkeit.","refs":["CH_GB18_BDKT:AS1","CH_GB18_BDBK:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B02","text":"Sein Ausgangspunkt ist eine Substanz, die nicht durch fremde Einwirkung bestimmt wird, sondern sich als reflektierte Macht selbst unterscheidet und bestimmt.","refs":["CH_GB18_BDKT:A1","CH_GB18_DFKT:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B03","text":"Die erste Kausalform erzeugt eine asymmetrische Ordnung: Die Ursache erscheint als für sich seiende Substanz, die Wirkung als ent-substantialisierte Setzung.","refs":["CH_GB18_BDKT:A8","CH_GB18_BDKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B04","text":"Diese Asymmetrie wird instabil, weil die Ursache nur in ihrer Wirkung Wirklichkeit erhält und Ursache sowie Wirkung denselben vollständigen Inhalt enthalten.","refs":["CH_GB18_DFKT:A7","CH_GB18_DFKT:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B05","text":"Die formelle Kausalität hebt sich daher nicht in eine bleibende Einheit auf, sondern erlischt zunächst in einer gegen die Relation gleichgültigen Unmittelbarkeit.","refs":["CH_GB18_DFKT:A12","CH_GB18_DFKT:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B06","text":"Die bestimmte Kausalität reintroduziert die Differenz als Endlichkeit von Form, Inhalt und Substrat, wodurch Ursache und Wirkung äußerlich getrennte Rollen eines identischen Inhalts werden.","refs":["CH_GB18_BDBK:A2","CH_GB18_BDBK:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B07","text":"Die endliche Ursache kann ihren Ursprung nicht behaupten, weil sie als bestimmte Ursache selbst Wirkung ist und dadurch den Regreß und Progreß der Kausalreihen produziert.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B08","text":"Die gerichtete Bewegung endet nicht in einem ersten Grund, sondern in einer Kausalität, die ihre Voraussetzungen selbst setzt, aufhebt und als eigene Bedingungen reproduziert.","refs":["CH_GB18_BDBK:A12","CH_GB18_BDBK:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_55:GA-01","text":"[Persistent] Kausalität ist nur verständlich, wenn Substanz als sich auf sich beziehende Macht und nicht als passiver Träger von Bestimmungen gilt.","refs":["CH_GB18_BDKT:A1","CH_GB18_BDKT:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-02","text":"[Mutating] Die negative Selbstunterscheidung der Substanz erzeugt zunächst das Gesetztsein der Wirkung und wird später zur Selbstvoraussetzung der Kausalität erweitert.","refs":["CH_GB18_BDKT:A6","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-03","text":"[Mutating] Die Wirkung ist zunächst aufgehobene Substantialität, wird aber zur Wirklichkeit, in der die Ursache erst als Ursache existiert.","refs":["CH_GB18_BDKT:A7","CH_GB18_DFKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-04","text":"[Persistent] Kausalität darf nicht als äußerliche Verbindung fertiger Dinge begriffen werden, weil ihre Form aus immanenter Selbstbestimmung hervorgeht.","refs":["CH_GB18_BDKT:D4","CH_GB18_DFKT:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-05","text":"[Emergent] Ursache und Wirkung sind keine selbständigen Entitäten, sondern wechselseitig abhängige Funktionen eines einzigen Inhalts.","refs":["CH_GB18_DFKT:A9","CH_GB18_DFKT:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-06","text":"[Mutating] Die inhaltliche Identität von Ursache und Wirkung schlägt, sobald Form und Inhalt äußerlich auseinanderfallen, in die Endlichkeit analytischer Kausalität um.","refs":["CH_GB18_BDBK:A1","CH_GB18_BDBK:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-07","text":"[Attractor] Jede endliche Ursache wird durch ihre Bestimmtheit selbst zur Wirkung und zwingt die Kausalität in eine rekursive Umkehrung ihrer Rollen.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-08","text":"[Persistent] Notwendigkeit bezeichnet keine äußere Nötigung, sondern die Selbstbestimmung einer Macht, die ihre eigene Wirklichkeit hervorbringt.","refs":["CH_GB18_DFKT:A8","CH_GB18_DFKT:DNX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-09","text":"[Emergent] Das Substrat ist kein gegebenes Drittes zwischen Ursache und Wirkung, sondern eine von der Kausalität selbst gesetzte Voraussetzung.","refs":["CH_GB18_BDBK:A12","CH_GB18_BDBK:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-10","text":"[Terminal] Die Kausalität erreicht ihre höchste Bestimmung nicht als absoluter Anfang, sondern als Selbstbedingung, in der Setzen und Voraussetzen ineinanderfallen.","refs":["CH_GB18_BDBK:SD3","CH_GB18_BDBK:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_55:RMD-01","text":"Die Substanz behält ihre Identität als Macht, mutiert jedoch von der unterscheidenden Quelle der Wirkung zur durch ihre Wirkung allein wirklichen Ursache und schließlich zur endlichen Substratgestalt.","refs":["CH_GB18_BDKT:A1","CH_GB18_DFKT:A7","CH_GB18_BDBK:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RMD-02","text":"Die Wirkung verschiebt sich von bloß Gesetztem zu identischem Gesetztsein und wird anschließend zum Moment, das jede endliche Ursache als selbst abgeleitete Bestimmung entlarvt.","refs":["CH_GB18_BDKT:A7","CH_GB18_DFKT:A6","CH_GB18_BDBK:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RMD-03","text":"Ursprünglichkeit erscheint zunächst als Vorrang der Ursache, kehrt sich aber um, weil die Ursache nur im Vollzug ihrer Wirkung Ursache ist und als endliche Ursache selbst Wirkung bleibt.","refs":["CH_GB18_DFKT:A1","CH_GB18_DFKT:A10","CH_GB18_BDBK:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RMD-04","text":"Identität mutiert von der substantiellen Einheit der Kausalität zur analytischen Gleichheit eines Inhalts, der unter äußerlich getrennten Formrollen wiederholt wird.","refs":["CH_GB18_DFKT:A9","CH_GB18_BDBK:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RMD-05","text":"Das Kausalitätsverhältniß wird nicht einfach aufgehoben: Es erlischt als formelle Zweiheit, kehrt als endliche Äußerlichkeit wieder und wird in die Selbstvoraussetzung einer bedingenden Kausalität absorbiert.","refs":["CH_GB18_DFKT:A12","CH_GB18_BDBK:A2","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_55:CGD-01","text":"Die anfängliche Gegenüberstellung einer für sich seienden Ursache und einer bloß gesetzten Wirkung bleibt eine lokale Eröffnungsform und trägt die Architektur des Clusters nicht als Endbestimmung.","refs":["CH_GB18_BDKT:A8","CH_GB18_BDKT:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:CGD-02","text":"Das Erlöschen der Kausalität in gleichgültige Unmittelbarkeit ist kein isolierter Abschluß, sondern ein Übergangspunkt, an dem die Differenz als Endlichkeit von Form und Substrat erneut bestimmt werden muß.","refs":["CH_GB18_DFKT:A12","CH_GB18_BDBK:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:CGD-03","text":"Die Beispiele äußerer Ereignisse, Nahrung, Klima oder geschichtlicher Anlässe bleiben lokale diagnostische Fälle einer höheren Unterscheidung zwischen Veranlassung und immanenter Wirksamkeit.","refs":["CH_GB18_BDBK:NX5","CH_GB18_BDBK:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:CGD-04","text":"Auf Cluster-Ebene ist allein tragend, daß kausale Rollen weder feste Eigenschaften noch unabhängige Ursprünge sind, sondern temporäre Funktionen eines selbstvermittelnden Zusammenhangs.","refs":["CH_GB18_DFKT:A10","CH_GB18_BDBK:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_55:GNX-01","text":"Ausgeschlossen wird jede Kausalität, die als äußerliche Verknüpfung bereits fertiger und voneinander unabhängiger Dinge angesetzt wird.","refs":["CH_GB18_BDKT:DNX4","CH_GB18_DFKT:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GNX-02","text":"Ausgeschlossen wird eine Wirkung, die ihre Herkunft aus der setzenden Macht tilgt und als selbständiger Ursprung auftreten könnte.","refs":["CH_GB18_BDKT:DNX3","CH_GB18_DFKT:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GNX-03","text":"Ausgeschlossen wird eine stabile Zweiheit von Ursache und Wirkung, weil ihre jeweiligen Status nur im Vollzug des Wirkens bestehen.","refs":["CH_GB18_DFKT:DNX5","CH_GB18_DFKT:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GNX-04","text":"Ausgeschlossen wird ein erster endlicher Grund, weil jede bestimmte Ursache durch ihre eigene Bestimmtheit schon in die Reihe ihrer Bedingungen zurückfällt.","refs":["CH_GB18_BDBK:DNX2","CH_GB18_BDBK:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_55:DBN-01","text":"Das System kann keine vorgegebene Accidentalität, kein fertiges Substrat und keine äußerliche Bedingung zulassen, ohne die Selbstbestimmung der Substanz zu zerstören.","refs":["CH_GB18_DFKT:NX1","CH_GB18_DFKT:DNX1","CH_GB18_BDBK:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:DBN-02","text":"Das System kann Ursache und Wirkung nicht als dauerhaft fixierte Rollen zulassen, weil ihre Stabilisierung die innere Umkehrung endlicher Kausalität blockieren würde.","refs":["CH_GB18_DFKT:DNX5","CH_GB18_BDBK:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:DBN-03","text":"Das System kann die Erklärung nicht als bloße Wiederholung eines identischen Inhalts unter zwei Formnamen zulassen, weil analytische Kausalität keine inhaltliche Vermittlung leistet.","refs":["CH_GB18_BDBK:NX2","CH_GB18_BDBK:D1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_55:BSA-01","text":"Nicht verfügbar ist ein absolut äußerer Ursprung, der als Ursache bestehen könnte, ohne durch seine Wirkung vermittelt, bestimmt und begrenzt zu werden.","refs":["CH_GB18_DFKT:SNX1","CH_GB18_DFKT:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:BSA-02","text":"Nicht verfügbar ist eine letzte Erklärung durch einen ersten endlichen Punkt, weil der unendliche Regreß nicht aus Unwissen, sondern aus der Form der endlichen Ursache selbst entsteht.","refs":["CH_GB18_BDBK:SD2","CH_GB18_BDBK:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:BSA-03","text":"Ontologisch unzulässig ist die Reduktion organischer, geistiger oder geschichtlicher Wirklichkeit auf die bloße Fortsetzung äußerer Bedingungen.","refs":["CH_GB18_BDBK:NX5","CH_GB18_BDBK:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_55:XD-01","text":"Die asymmetrische Ausgangsform von Ursache und Wirkung ist notwendig, aber nur als Übergangsmechanismus: Sie erzeugt erst die Differenz, die in der Wirklichkeit der Ursache wieder aufgehoben werden muß. ; Trace Type — Tension","refs":["CH_GB18_BDKT:A8","CH_GB18_DFKT:A7","CL_GB18_55:GA-03","CL_GB18_55:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:XD-02","text":"Die Ursache verliert ihren Anspruch auf isolierte Ursprünglichkeit genau dadurch, daß ihre Realität die Wirkung verlangt; in der endlichen Gestalt wird dieser Verlust zum Regreßzwang. ; Trace Type — Composite","refs":["CH_GB18_DFKT:A10","CH_GB18_BDBK:A10","CL_GB18_55:GA-05","CL_GB18_55:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:XD-03","text":"Die Aufhebung der formellen Kausalität in Unmittelbarkeit und die spätere Rückkehr äußerlicher Kausalformen bilden keinen bloßen Widerspruch, sondern einen Maßstabswechsel von absoluter Actuosität zu endlicher Form-Inhalt-Trennung. ; Trace Type — Tension","refs":["CH_GB18_DFKT:A12","CH_GB18_BDBK:A2","CL_GB18_55:GA-06","CL_GB18_55:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:XD-04","text":"Äußere Ereignisse werden aus Ursachen zu Veranlassungen oder Möglichkeitsbedingungen herabgestuft, sobald ein Gegenstand als sich selbst bestimmende Einheit erfaßt wird. ; Trace Type — Composite","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:A6","CL_GB18_55:GA-04","CL_GB18_55:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_55:BSD-01","text":"Wirklichkeit erscheint als ein Prozeß, in dem Macht ihre Differenzen produziert, nur durch diese Differenzen wirklich wird und ihre scheinbar festen Relationen wieder in Selbstvermittlung überführt.","refs":["CH_GB18_BDKT:SD1","CH_GB18_DFKT:SD2","CL_GB18_55:GA-01","CL_GB18_55:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:BSD-02","text":"Kausale Zeit ist weder lineare Übertragung noch bloße Abfolge, weil Ursache und Wirkung ihren Status nur im Vollzug haben, einander rückwirkend bestimmen und in neue Voraussetzungen umschlagen.","refs":["CH_GB18_DFKT:SD4","CH_GB18_BDBK:ALT4","CL_GB18_55:GA-05","CL_GB18_55:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:BSD-03","text":"Erklärung muß zwischen äußerem Anlaß, verteilten Bedingungen, immanenter Wirksamkeit und selbstgesetzter Voraussetzung unterscheiden, statt jedes Vorhergehende als Ursache zu behandeln.","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:ME2","CL_GB18_55:GA-04","CL_GB18_55:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:BSD-04","text":"Organische, geistige und geschichtliche Prozesse werden als Transformation äußerer Einwirkung bestimmt; ihre Realität besteht nicht in kausaler Passivität, sondern in selektiver Aneignung und Unterbrechung.","refs":["CH_GB18_BDBK:A6","CH_GB18_BDBK:D4","CL_GB18_55:GA-08","CL_GB18_55:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_55:RLE-01","text":"Die Grundschleife lautet: Macht setzt eine Bestimmung, unterscheidet sich von ihr, gewinnt in ihr Wirklichkeit und wird dadurch auf ihre eigene Setzung zurückgeführt.","refs":["CH_GB18_BDKT:A3","CH_GB18_DFKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RLE-02","text":"Die formelle Kausalität spiraliert von Ursache zu Wirkung und von Wirkung zur Aufhebung der Ursache, wodurch die anfängliche Asymmetrie in gegenseitige Enthaltenheit übergeht.","refs":["CH_GB18_DFKT:A9","CH_GB18_DFKT:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RLE-03","text":"Die endliche Kausalität erzeugt eine schlechte Unendlichkeit, weil jede Ursache als Wirkung und jede Wirkung als mögliche Ursache erneut in dieselbe Form zurückkehrt.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RLE-04","text":"Der Attraktor des Clusters ist Selbstvoraussetzung: Kausalität kann sich nicht durch einen fremden Grund schließen und muß ihr eigenes Bedingungsfeld hervorbringen.","refs":["CH_GB18_BDBK:A12","CH_GB18_BDBK:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_55:FGS-B01","text":"Macht → reflektierte Selbstbeziehung → negative Setzung einer Bestimmung → Differenz von für sich seiender Ursache und gesetzter Wirkung.","refs":["CH_GB18_BDKT:FGS1","CH_GB18_BDKT:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FGS-B02","text":"Ursache → Hervorbringen der Wirkung → Wirklichkeit der Ursache in ihrem Gesetztsein → Aufhebung der formellen Asymmetrie.","refs":["CH_GB18_DFKT:A7","CH_GB18_DFKT:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FGS-B03","text":"Inhaltsidentität → äußere Trennung von Form und Inhalt → endliche Substanz als Substrat → analytische Kausalität.","refs":["CH_GB18_BDBK:AS2","CH_GB18_BDBK:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FGS-B04","text":"Bestimmte Ursache → eigene Negation → Wirkung → erneute Ursache → unendlicher Regreß und Progreß.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FGS-B05","text":"Gegenseitiges Setzen und Aufheben → gesetzte Voraussetzung → Selbstbedingung der Kausalität → Übergang über die endliche Kausalform hinaus.","refs":["CH_GB18_BDBK:FGS6","CH_GB18_BDBK:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_55:AFM-B01","text":"Substanz als Macht → Selbstbeziehung → bestimmendes Setzen.","refs":["CH_GB18_BDKT:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B02","text":"Bestimmendes Setzen → aufgehobene Substantialität → Wirkung.","refs":["CH_GB18_BDKT:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B03","text":"Für sich seiende Substanz → Ursache → formelles Kausalitätsverhältniß.","refs":["CH_GB18_BDKT:FGS4","CH_GB18_BDKT:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B04","text":"Ursache und Wirkung als identischer Inhalt → Ursache nur durch Wirkung wirklich → Erlöschen der formellen Differenz.","refs":["CH_GB18_DFKT:A7","CH_GB18_DFKT:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B05","text":"Gleichgültige Unmittelbarkeit → äußerliche Form-Inhalt-Trennung → endliche Kausalität.","refs":["CH_GB18_DFKT:A12","CH_GB18_BDBK:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B06","text":"Endliche Ursache als Wirkung → kausaler Regreß und Progreß → Verlust des ersten Ursprungs.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B07","text":"Gegenseitige Umkehrung → Selbstaufhebung → Selbstvoraussetzung der Kausalität.","refs":["CH_GB18_BDBK:A12","CH_GB18_BDBK:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_55:MME-01","text":"Ursache und Wirkung werden von festen Dingen zu relationalen Statusformen umkartiert, deren Identität nur innerhalb eines Wirkungszusammenhangs besteht.","refs":["CH_GB18_DFKT:ME5","CH_GB18_BDBK:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MME-02","text":"Der Gegensatz von innerer Macht und äußerer Wirkung wird als Unterschied zweier Phasen derselben Selbstvermittlung neu klassifiziert.","refs":["CH_GB18_BDKT:SD1","CH_GB18_DFKT:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MME-03","text":"Der unendliche Regreß wird von einem epistemischen Defizit zu einer ontologischen Signatur endlicher Kausalität umgezeichnet.","refs":["CH_GB18_BDBK:ME4","CH_GB18_BDBK:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MME-04","text":"Die strategische Karte der Erklärung wird neu geordnet: Nicht jede vorhergehende Bedingung ist Ursache, und nicht jeder Anlaß ist Träger der hervorgebrachten Wirklichkeit.","refs":["CH_GB18_BDBK:NX4","CH_GB18_BDBK:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_55:ALT-B01","text":"Surface level — Das System analysiert Ursache und Wirkung als wechselnde Bestimmungen eines identischen Inhalts.","refs":["CH_GB18_BDBK:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:ALT-B02","text":"Structural level — Kausalität wird durch Selbstbestimmung, Setzen, Rückkehr, Wirklichkeit und Selbstvoraussetzung organisiert.","refs":["CH_GB18_DFKT:ALT2","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:ALT-B03","text":"Metastrategic level — Das System ersetzt die Suche nach äußerer Einwirkung durch die Prüfung, ob eine Erklärung immanente Selbsttätigkeit oder nur äußere Anlässe erfaßt.","refs":["CH_GB18_DFKT:ALT3","CH_GB18_BDBK:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:ALT-B04","text":"Ontological / Temporal level — Sein erscheint als selbstwirkende Macht, deren kausale Rollen nur im Vollzug entstehen, sich umkehren und wieder erlöschen.","refs":["CH_GB18_BDKT:ALT4","CH_GB18_DFKT:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:ALT-B05","text":"Methodological / Performative level — Die Argumentform vollzieht ihre These, indem sie jede behauptete Ursache in die Bedingungen ihrer eigenen Wirklichkeit und Begrenzung zurückführt.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_55:FL-01","text":"Die Ursache soll ursprünglich gegenüber der Wirkung sein, besitzt aber Wirklichkeit nur in der Wirkung; Ursprünglichkeit bleibt daher vermittelt statt absolut.","refs":["CH_GB18_DFKT:A1","CH_GB18_DFKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FL-02","text":"Die Wirkung gilt zugleich als aufgehobene Substantialität und als vollständige Wirklichkeit der Ursache, wodurch ihr Status zwischen Abhängigkeit und Realitätsfunktion oszilliert.","refs":["CH_GB18_BDKT:A7","CH_GB18_DFKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FL-03","text":"Die Kausalität erlischt in gleichgültiger Unmittelbarkeit, tritt aber anschließend erneut als endliche Äußerlichkeit auf; diese Spannung markiert einen Skalenwechsel statt eine vollständig vermittelte Kontinuität.","refs":["CH_GB18_DFKT:A12","CH_GB18_BDBK:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MP-01","text":"Der erste Mutationspunkt liegt dort, wo die negative Setzung einer Bestimmung nicht länger bloß die Wirkung absondert, sondern als absolute Actuosität der Ursache bestimmt wird.","refs":["CH_GB18_BDKT:A6","CH_GB18_DFKT:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MP-02","text":"Der zweite Mutationspunkt liegt dort, wo die Wirkung von bloßem Gesetztsein zur Wirklichkeit der Ursache umbestimmt wird.","refs":["CH_GB18_DFKT:A6","CH_GB18_DFKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MP-03","text":"Der dritte Mutationspunkt liegt dort, wo der unendliche Regreß nicht als fehlende Abschlußerklärung behandelt wird, sondern in Selbstvoraussetzung umschlägt.","refs":["CH_GB18_BDBK:SD2","CH_GB18_BDBK:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_55:HSI-01","text":"Realität erscheint als Maschine selbstsetzender Macht, deren Elemente keine selbständigen Dinge, sondern Resultate und Voraussetzungen ihrer eigenen Vermittlung sind.","refs":["CH_GB18_BDKT:A3","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:HSI-02","text":"Das Subjekt erscheint dort, wo Lebendiges und Geist äußere Einwirkung nicht fortsetzen, sondern sie auswählen, umformen oder abbrechen.","refs":["CH_GB18_BDBK:A6","CH_GB18_BDBK:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:HSI-03","text":"Zeit erscheint als rückläufige und spiralförmige Ordnung, weil Wirkung die Ursache wirklich macht, jede Ursache selbst Wirkung wird und Voraussetzungen nachträglich gesetzt werden.","refs":["CH_GB18_DFKT:SD4","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:HSI-04","text":"Mögliche Navigation besteht nicht im Auffinden eines isolierten ersten Auslösers, sondern im Unterscheiden von Anlaß, Bedingung, Wirkungsform und immanenter Selbstbestimmung.","refs":["CH_GB18_BDBK:D2","CH_GB18_BDBK:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_55:MRT-B01","text":"Die extrahierte Architektur reicht aus, wenn Macht, negative Setzung, Wirkung, gegenseitige Vermittlung, endliche Umkehrung und Selbstvoraussetzung gemeinsam erhalten bleiben.","refs":["CH_GB18_DFKT:MRT1","CH_GB18_BDBK:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MRT-B02","text":"Unterbestimmt bleibt die positive Gestalt des Verhältnisses, das nach der Selbstvoraussetzung der Kausalität folgt und organische oder geistige Selbsttätigkeit vollständig bestimmen könnte.","refs":["CH_GB18_BDBK:MRT2","CH_GB18_BDBK:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MRT-B03","text":"Die Rekonstruktion ist kohärent, sofern die Aufhebung der Kausalform nicht als bloßes Verschwinden, sondern als produktiver Übergang in eine höhere Vermittlungsform gelesen wird.","refs":["CH_GB18_DFKT:MRT3","CH_GB18_BDBK:MRT8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MRT-B04","text":"Die stärkste Achse des Clusters liegt in der Ableitung äußerer Kausalität aus innerer Selbstbestimmung und in der Rückführung jeder endlichen Ursache auf ihre eigene Abgeleitetheit.","refs":["CH_GB18_BDKT:MRT4","CH_GB18_BDBK:MRT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123124752348Z_50078c4f","language_code":"en","language_name":"English","title":"Chapters 163–165","source_sha256":"dbb783c20488a4727a3d84c579b9f0c36fa07a5a9790e25dd27a344dfc2f959d","sha256":"a4958a29079c4e58177990859bee63ad3d0044408891bf8e427dad795d5dfcdf","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:31:24.753544+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_55:AS-B01","text":"The cluster reconstructs causality as a problem of mediation between substantial self-power, posited effect, and finite externality.","refs":["CH_GB18_BDKT:AS1","CH_GB18_BDBK:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B02","text":"Its point of departure is a substance that is not determined by external influence, but distinguishes and determines itself as reflected power.","refs":["CH_GB18_BDKT:A1","CH_GB18_DFKT:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B03","text":"The first form of causality produces an asymmetrical order: the cause appears as substance existing for itself, the effect as de-substantialized positing.","refs":["CH_GB18_BDKT:A8","CH_GB18_BDKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B04","text":"This asymmetry becomes unstable because the cause attains actuality only in its effect and cause and effect contain the same complete content.","refs":["CH_GB18_DFKT:A7","CH_GB18_DFKT:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B05","text":"Formal causality therefore does not sublate itself into an enduring unity, but initially expires into an immediacy indifferent to the relation.","refs":["CH_GB18_DFKT:A12","CH_GB18_DFKT:SNX5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B06","text":"Determinate causality reintroduces difference as the finitude of form, content, and substrate, whereby cause and effect become externally separated roles of an identical content.","refs":["CH_GB18_BDBK:A2","CH_GB18_BDBK:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B07","text":"The finite cause cannot maintain its originariness, because as a determinate cause it is itself an effect and thereby produces the regress and progress of causal series.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AS-B08","text":"The directed movement ends not in a first ground, but in a causality that itself posits, sublates, and reproduces its presuppositions as its own conditions.","refs":["CH_GB18_BDBK:A12","CH_GB18_BDBK:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_55:GA-01","text":"[Persistent] Causality is intelligible only if substance is regarded as power relating itself to itself, and not as a passive bearer of determinations.","refs":["CH_GB18_BDKT:A1","CH_GB18_BDKT:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-02","text":"[Mutating] The negative self-distinction of substance initially generates the positedness of the effect and is later expanded into the self-presupposition of causality.","refs":["CH_GB18_BDKT:A6","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-03","text":"[Mutating] The effect is initially sublated substantiality, but becomes the actuality in which the cause first exists as cause.","refs":["CH_GB18_BDKT:A7","CH_GB18_DFKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-04","text":"[Persistent] Causality must not be conceived as an external connection of finished things, because its form proceeds from immanent self-determination.","refs":["CH_GB18_BDKT:D4","CH_GB18_DFKT:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-05","text":"[Emergent] Cause and effect are not independent entities, but mutually dependent functions of a single content.","refs":["CH_GB18_DFKT:A9","CH_GB18_DFKT:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-06","text":"[Mutating] The identity in content of cause and effect turns, as soon as form and content externally fall apart, into the finitude of analytical causality.","refs":["CH_GB18_BDBK:A1","CH_GB18_BDBK:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-07","text":"[Attractor] Every finite cause becomes an effect through its own determinacy and compels causality into a recursive reversal of its roles.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-08","text":"[Persistent] Necessity designates not an external compulsion, but the self-determination of a power that brings forth its own actuality.","refs":["CH_GB18_DFKT:A8","CH_GB18_DFKT:DNX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-09","text":"[Emergent] The substrate is not a given third between cause and effect, but a presupposition posited by causality itself.","refs":["CH_GB18_BDBK:A12","CH_GB18_BDBK:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GA-10","text":"[Terminal] Causality attains its highest determination not as an absolute beginning, but as self-condition, in which positing and presupposing coincide.","refs":["CH_GB18_BDBK:SD3","CH_GB18_BDBK:FGS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_55:RMD-01","text":"Substance retains its identity as power, but mutates from the distinguishing source of the effect to the cause actual only through its effect and finally to finite substrate-configuration.","refs":["CH_GB18_BDKT:A1","CH_GB18_DFKT:A7","CH_GB18_BDBK:A9"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RMD-02","text":"The effect shifts from what is merely posited to identical positedness and subsequently becomes the moment that exposes every finite cause as itself a derived determination.","refs":["CH_GB18_BDKT:A7","CH_GB18_DFKT:A6","CH_GB18_BDBK:A10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RMD-03","text":"Originariness initially appears as the priority of the cause, but reverses itself because the cause is cause only in the enactment of its effect and, as finite cause, itself remains effect.","refs":["CH_GB18_DFKT:A1","CH_GB18_DFKT:A10","CH_GB18_BDBK:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RMD-04","text":"Identity mutates from the substantial unity of causality into the analytical equality of a content repeated under externally separated formal roles.","refs":["CH_GB18_DFKT:A9","CH_GB18_BDBK:D1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RMD-05","text":"The causal relation is not simply sublated: it expires as formal duality, returns as finite externality, and is absorbed into the self-presupposition of a conditioning causality.","refs":["CH_GB18_DFKT:A12","CH_GB18_BDBK:A2","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_55:CGD-01","text":"The initial opposition between a cause existing for itself and a merely posited effect remains a local opening form and does not bear the architecture of the cluster as final determination.","refs":["CH_GB18_BDKT:A8","CH_GB18_BDKT:NX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:CGD-02","text":"The expiration of causality into indifferent immediacy is not an isolated conclusion, but a point of transition at which difference must again be determined as the finitude of form and substrate.","refs":["CH_GB18_DFKT:A12","CH_GB18_BDBK:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:CGD-03","text":"The examples of external events, nourishment, climate, or historical occasions remain local diagnostic cases of a higher distinction between occasion and immanent efficacy.","refs":["CH_GB18_BDBK:NX5","CH_GB18_BDBK:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:CGD-04","text":"At the cluster level, it is solely decisive that causal roles are neither fixed properties nor independent origins, but temporary functions of a self-mediating nexus.","refs":["CH_GB18_DFKT:A10","CH_GB18_BDBK:D5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_55:GNX-01","text":"Excluded is every causality posited as an external linkage of already finished and mutually independent things.","refs":["CH_GB18_BDKT:DNX4","CH_GB18_DFKT:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GNX-02","text":"Excluded is an effect that effaces its origin in positing power and could appear as an independent origin.","refs":["CH_GB18_BDKT:DNX3","CH_GB18_DFKT:NX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GNX-03","text":"Excluded is a stable duality of cause and effect, because their respective statuses exist only in the enactment of efficacity.","refs":["CH_GB18_DFKT:DNX5","CH_GB18_DFKT:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:GNX-04","text":"Excluded is a first finite ground, because every determinate cause already falls back into the series of its conditions through its own determinacy.","refs":["CH_GB18_BDBK:DNX2","CH_GB18_BDBK:SNX1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_55:DBN-01","text":"The system cannot permit a pregiven accidentality, a finished substrate, or an external condition without destroying the self-determination of substance.","refs":["CH_GB18_DFKT:NX1","CH_GB18_DFKT:DNX1","CH_GB18_BDBK:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:DBN-02","text":"The system cannot permit cause and effect as permanently fixed roles, because their stabilization would block the internal reversal of finite causality.","refs":["CH_GB18_DFKT:DNX5","CH_GB18_BDBK:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:DBN-03","text":"The system cannot permit explanation as the mere repetition of an identical content under two formal names, because analytical causality accomplishes no mediation of content.","refs":["CH_GB18_BDBK:NX2","CH_GB18_BDBK:D1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_55:BSA-01","text":"Unavailable is an absolutely external origin that could subsist as cause without being mediated, determined, and limited through its effect.","refs":["CH_GB18_DFKT:SNX1","CH_GB18_DFKT:SNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:BSA-02","text":"Unavailable is an ultimate explanation through a first finite point, because infinite regress arises not from ignorance, but from the form of the finite cause itself.","refs":["CH_GB18_BDBK:SD2","CH_GB18_BDBK:DNX4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:BSA-03","text":"Ontologically inadmissible is the reduction of organic, spiritual, or historical actuality to the mere continuation of external conditions.","refs":["CH_GB18_BDBK:NX5","CH_GB18_BDBK:SNX3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_55:XD-01","text":"The asymmetrical initial form of cause and effect is necessary, but only as a transitional mechanism: it first produces the difference that must be sublated again in the actuality of the cause. ; Trace Type — Tension","refs":["CH_GB18_BDKT:A8","CH_GB18_DFKT:A7","CL_GB18_55:GA-03","CL_GB18_55:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:XD-02","text":"The cause loses its claim to isolated originariness precisely because its reality requires the effect; in finite configuration this loss becomes the compulsion of regress. ; Trace Type — Composite","refs":["CH_GB18_DFKT:A10","CH_GB18_BDBK:A10","CL_GB18_55:GA-05","CL_GB18_55:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:XD-03","text":"The sublation of formal causality into immediacy and the later return of external causal forms constitute not a mere contradiction, but a change of scale from absolute Actuosity to finite form-content separation. ; Trace Type — Tension","refs":["CH_GB18_DFKT:A12","CH_GB18_BDBK:A2","CL_GB18_55:GA-06","CL_GB18_55:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:XD-04","text":"External events are demoted from causes to occasions or conditions of possibility as soon as an object is grasped as a self-determining unity. ; Trace Type — Composite","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:A6","CL_GB18_55:GA-04","CL_GB18_55:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_55:BSD-01","text":"Actuality appears as a process in which power produces its differences, becomes actual only through these differences, and reconducts its seemingly fixed relations into self-mediation.","refs":["CH_GB18_BDKT:SD1","CH_GB18_DFKT:SD2","CL_GB18_55:GA-01","CL_GB18_55:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:BSD-02","text":"Causal time is neither linear transmission nor mere succession, because cause and effect have their status only in enactment, determine one another retroactively, and turn into new presuppositions.","refs":["CH_GB18_DFKT:SD4","CH_GB18_BDBK:ALT4","CL_GB18_55:GA-05","CL_GB18_55:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:BSD-03","text":"Explanation must distinguish between external occasion, distributed conditions, immanent efficacy, and self-posited presupposition, rather than treating everything preceding as cause.","refs":["CH_GB18_BDBK:A5","CH_GB18_BDBK:ME2","CL_GB18_55:GA-04","CL_GB18_55:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_55:BSD-04","text":"Organic, spiritual, and historical processes are determined as transformation of external influence; their reality consists not in causal passivity, but in selective appropriation and interruption.","refs":["CH_GB18_BDBK:A6","CH_GB18_BDBK:D4","CL_GB18_55:GA-08","CL_GB18_55:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_55:RLE-01","text":"The basic loop runs: power posits a determination, distinguishes itself from it, gains actuality in it, and is thereby led back to its own positing.","refs":["CH_GB18_BDKT:A3","CH_GB18_DFKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RLE-02","text":"Formal causality spirals from cause to effect and from effect to the sublation of the cause, whereby the initial asymmetry passes into mutual containment.","refs":["CH_GB18_DFKT:A9","CH_GB18_DFKT:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RLE-03","text":"Finite causality produces a bad infinity, because every cause returns anew to the same form as effect and every effect as possible cause.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:RLE-04","text":"The attractor of the cluster is self-presupposition: causality cannot close itself through an alien ground and must bring forth its own field of conditions.","refs":["CH_GB18_BDBK:A12","CH_GB18_BDBK:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_55:FGS-B01","text":"Power → reflected self-relation → negative positing of a determination → difference between cause existing for itself and posited effect.","refs":["CH_GB18_BDKT:FGS1","CH_GB18_BDKT:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FGS-B02","text":"Cause → bringing forth of the effect → actuality of the cause in its positedness → sublation of formal asymmetry.","refs":["CH_GB18_DFKT:A7","CH_GB18_DFKT:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FGS-B03","text":"Identity of content → external separation of form and content → finite substance as substrate → analytical causality.","refs":["CH_GB18_BDBK:AS2","CH_GB18_BDBK:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FGS-B04","text":"Determinate cause → own negation → effect → renewed cause → infinite regress and progress.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FGS-B05","text":"Mutual positing and sublation → posited presupposition → self-condition of causality → transition beyond the finite causal form.","refs":["CH_GB18_BDBK:FGS6","CH_GB18_BDBK:MRT8"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_55:AFM-B01","text":"Substance as power → self-relation → determining positing.","refs":["CH_GB18_BDKT:AF1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B02","text":"Determining positing → sublated substantiality → effect.","refs":["CH_GB18_BDKT:FGS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B03","text":"Substance existing for itself → cause → formal causal relation.","refs":["CH_GB18_BDKT:FGS4","CH_GB18_BDKT:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B04","text":"Cause and effect as identical content → cause actual only through effect → expiration of formal difference.","refs":["CH_GB18_DFKT:A7","CH_GB18_DFKT:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B05","text":"Indifferent immediacy → external form-content separation → finite causality.","refs":["CH_GB18_DFKT:A12","CH_GB18_BDBK:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B06","text":"Finite cause as effect → causal regress and progress → loss of the first origin.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:AFM-B07","text":"Mutual reversal → self-sublation → self-presupposition of causality.","refs":["CH_GB18_BDBK:A12","CH_GB18_BDBK:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_55:MME-01","text":"Cause and effect are remapped from fixed things to relational forms of status whose identity exists only within a nexus of efficacy.","refs":["CH_GB18_DFKT:ME5","CH_GB18_BDBK:NX7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MME-02","text":"The opposition of inner power and external effect is reclassified as the difference between two phases of the same self-mediation.","refs":["CH_GB18_BDKT:SD1","CH_GB18_DFKT:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MME-03","text":"Infinite regress is redrawn from an epistemic deficit into an ontological signature of finite causality.","refs":["CH_GB18_BDBK:ME4","CH_GB18_BDBK:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MME-04","text":"The strategic map of explanation is reordered: not every preceding condition is a cause, and not every occasion is the bearer of the actuality brought forth.","refs":["CH_GB18_BDBK:NX4","CH_GB18_BDBK:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_55:ALT-B01","text":"Surface level — The system analyzes cause and effect as changing determinations of an identical content.","refs":["CH_GB18_BDBK:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:ALT-B02","text":"Structural level — Causality is organized through self-determination, positing, return, actuality, and self-presupposition.","refs":["CH_GB18_DFKT:ALT2","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:ALT-B03","text":"Metastrategic level — The system replaces the search for external influence with examination of whether an explanation grasps immanent self-activity or merely external occasions.","refs":["CH_GB18_DFKT:ALT3","CH_GB18_BDBK:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:ALT-B04","text":"Ontological / Temporal level — Being appears as self-acting power, whose causal roles arise only in enactment, reverse themselves, and expire again.","refs":["CH_GB18_BDKT:ALT4","CH_GB18_DFKT:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:ALT-B05","text":"Methodological / Performative level — The argumentative form enacts its thesis by leading every asserted cause back into the conditions of its own actuality and limitation.","refs":["CH_GB18_BDBK:A10","CH_GB18_BDBK:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_55:FL-01","text":"The cause is supposed to be original in relation to the effect, but possesses actuality only in the effect; originariness therefore remains mediated rather than absolute.","refs":["CH_GB18_DFKT:A1","CH_GB18_DFKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FL-02","text":"The effect counts simultaneously as sublated substantiality and as the complete actuality of the cause, whereby its status oscillates between dependence and reality-function.","refs":["CH_GB18_BDKT:A7","CH_GB18_DFKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:FL-03","text":"Causality expires into indifferent immediacy, but subsequently reappears as finite externality; this tension marks a change of scale rather than a fully mediated continuity.","refs":["CH_GB18_DFKT:A12","CH_GB18_BDBK:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MP-01","text":"The first mutation point lies where the negative positing of a determination no longer merely separates off the effect, but is determined as the absolute Actuosity of the cause.","refs":["CH_GB18_BDKT:A6","CH_GB18_DFKT:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MP-02","text":"The second mutation point lies where the effect is redetermined from mere positedness into the actuality of the cause.","refs":["CH_GB18_DFKT:A6","CH_GB18_DFKT:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MP-03","text":"The third mutation point lies where infinite regress is not treated as a missing final explanation, but turns into self-presupposition.","refs":["CH_GB18_BDBK:SD2","CH_GB18_BDBK:SD3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_55:HSI-01","text":"Reality appears as a machine of self-positing power, whose elements are not independent things, but results and presuppositions of their own mediation.","refs":["CH_GB18_BDKT:A3","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:HSI-02","text":"The subject appears where living beings and spirit do not continue external influence, but select, transform, or interrupt it.","refs":["CH_GB18_BDBK:A6","CH_GB18_BDBK:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:HSI-03","text":"Time appears as a retrograde and spiral order, because effect makes cause actual, every cause itself becomes effect, and presuppositions are posited retroactively.","refs":["CH_GB18_DFKT:SD4","CH_GB18_BDBK:A12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:HSI-04","text":"Possible navigation consists not in finding an isolated first trigger, but in distinguishing occasion, condition, form of efficacy, and immanent self-determination.","refs":["CH_GB18_BDBK:D2","CH_GB18_BDBK:ME2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_55:MRT-B01","text":"The extracted architecture is sufficient if power, negative positing, effect, mutual mediation, finite reversal, and self-presupposition are jointly retained.","refs":["CH_GB18_DFKT:MRT1","CH_GB18_BDBK:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MRT-B02","text":"What remains underdetermined is the positive configuration of the relation that follows the self-presupposition of causality and could fully determine organic or spiritual self-activity.","refs":["CH_GB18_BDBK:MRT2","CH_GB18_BDBK:MRT6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MRT-B03","text":"The reconstruction is coherent insofar as the sublation of the causal form is read not as mere disappearance, but as a productive transition into a higher form of mediation.","refs":["CH_GB18_DFKT:MRT3","CH_GB18_BDBK:MRT8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_55:MRT-B04","text":"The strongest axis of the cluster lies in the derivation of external causality from inner self-determination and in the reduction of every finite cause to its own derivedness.","refs":["CH_GB18_BDKT:MRT4","CH_GB18_BDBK:MRT4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_55@R001","source_variant_id":"canonical:CL_GB18_55:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 163–165","context":"B. Das Kausalitäts-Verhältniß. · a. Die formelle Kausalität. · b. Das bestimmte Kausalitätsverhältniß."},"title_language_code":"en"},{"id":"CL_GB18_56","layer":"CL","title":"Chapters 166–167","order":56,"parents":["CH_GB18_CWUG","CH_GB18_CD_4"],"revision":"CL_GB18_56@R001","sha256":"a91bc77786a746a1a0b0e4ba8fe749d0149306f5a61bae679b118ce7e3e4dee4","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_56:BAS-01","text":"Die zu lösende Schwierigkeit besteht darin, dass endliche Kausalität Ursache und Wirkung äußerlich trennt und ihre innere Identität dadurch verdeckt.","refs":["CH_GB18_CWUG:AS1","CH_GB18_CD_4:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-02","text":"Das System bestimmt Wirksamkeit neu als voraussetzendes Tun, das seine Bedingung nicht vorfindet, ohne sie zugleich als eigenes Anderes zu setzen.","refs":["CH_GB18_CWUG:AS2","CH_GB18_CD_4:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-03","text":"Die passive Seite wird nicht durch Einwirkung ausgelöscht, sondern in ihrem Bestimmtwerden zur Ursache und damit zur Gegenwirkung umgekehrt.","refs":["CH_GB18_CWUG:AS5","CH_GB18_CWUG:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-04","text":"Die Gegenwirkung schließt den äußerlichen Wirkungsfortschritt, weil das Übergehen in Anderes als Rückkehr der Kausalität in ihre eigene Bedingtheit erscheint.","refs":["CH_GB18_CWUG:D7","CH_GB18_CD_4:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-05","text":"Wechselwirkung ist nicht der Endzustand zweier wechselseitig stabiler Ursachen, sondern die Manifestation, dass Aktivität und Passivität Momente einer Selbstvermittlung sind.","refs":["CH_GB18_CD_4:AS2","CH_GB18_CD_4:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-06","text":"Die Selbstvermittlung transformiert Notwendigkeit und Zufälligkeit von getrennten Modalitäten in unmanifeste und manifeste Formen derselben inneren Identität.","refs":["CH_GB18_CD_4:AS5","CH_GB18_CD_4:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-07","text":"Freiheit entsteht nicht außerhalb der Bedingtheit, sondern als ihre durchsichtige Selbstgegenwart, in der absolute Substanz Begriff und Subjektivität wird.","refs":["CH_GB18_CD_4:A8","CH_GB18_CD_4:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-08","text":"Die Gesamtbewegung ist rekursiv und spiralförmig: äußerliche Kausalität wird durch Umkehrung, Rückkehr und Manifestation in den Begriff als Schließung überführt.","refs":["CH_GB18_CWUG:SD4","CH_GB18_CD_4:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_56:GA-01","text":"[Persistent] Kausalität besitzt Wirklichkeit nur als Selbstbeziehung, die ihre eigene Wirksamkeitsbedingung voraussetzt und in der Wirkung auf sich zurückkommt.","refs":["CH_GB18_CWUG:A1","CH_GB18_CD_4:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-02","text":"[Mutating] Die Bedingung verschiebt sich von einem scheinbar äußeren Passivum zur selbstgesetzten Negation der Ursache.","refs":["CH_GB18_CWUG:A9","CH_GB18_CD_4:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-03","text":"[Persistent] Aktivität und Passivität sind keine festen Eigenschaften, sondern reversible Funktionsstellen derselben vermittelten Ursächlichkeit.","refs":["CH_GB18_CWUG:SD1","CH_GB18_CD_4:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-04","text":"[Emergent] Gegenwirkung enthüllt, dass die Wirkung ihre Ursache nicht lediglich fortsetzt, sondern deren isolierte Stellung aufhebt und sie selbst passiviert.","refs":["CH_GB18_CWUG:D5","CH_GB18_CWUG:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-05","text":"[Attractor] Andersheit ist nur als erhaltene und aufgehobene Selbstunterscheidung wirksam; ihre scheinbare Selbstständigkeit ist die Form der Vermittlung.","refs":["CH_GB18_CWUG:AS4","CH_GB18_CD_4:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-06","text":"[Mutating] Notwendigkeit und Zufälligkeit werden nicht beseitigt, sondern als innere und manifeste Zustände identischer Reflexion umcodiert.","refs":["CH_GB18_CD_4:D5","CH_GB18_CD_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-07","text":"[Terminal] Freiheit bezeichnet die manifest gewordene Identität der Bedingtheit mit sich selbst und nicht deren Abwesenheit.","refs":["CH_GB18_CD_4:D6","CH_GB18_CD_4:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-08","text":"[Terminal] Der Begriff ist die Form, in der die absolute Substanz ihre Unterschiede als Einheit von Allgemeinheit, Besonderheit und Einzelheit setzt.","refs":["CH_GB18_CD_4:A11","CH_GB18_CD_4:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-09","text":"[Attractor] Negation ist produktiv, weil das gesetzte Andere gerade als Bedingung der Selbstbeziehung erhalten werden muss.","refs":["CH_GB18_CWUG:A7","CH_GB18_CD_4:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-10","text":"[Attractor] Weder ein absoluter Anfang noch ein endgültiges Außen der Vermittlung kann innerhalb der Architektur bestehen.","refs":["CH_GB18_CWUG:SNX1","CH_GB18_CD_4:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_56:RMD-01","text":"Kausalität kehrt zunächst als äußerlicher Wirkungsfortschritt wieder, mutiert jedoch zur rekursiven Form, in der Ursache, Wirkung und Bedingung einander hervorbringen.","refs":["CH_GB18_CWUG:AS1","CH_GB18_CD_4:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RMD-02","text":"Die passive Substanz bleibt als notwendige Bedingung erhalten, verliert jedoch die Funktion eines fremden Trägers und wird als selbstgesetzte Passivität der Ursache absorbiert.","refs":["CH_GB18_CWUG:AS3","CH_GB18_CD_4:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RMD-03","text":"Gegenwirkung beginnt als Umkehrung des Erleidenden in Ursache und wird zur allgemeinen Form, in der jede Wirksamkeit ihre eigene Passivität produziert.","refs":["CH_GB18_CWUG:AS5","CH_GB18_CD_4:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RMD-04","text":"Gewalt leistet lokal die Arbeit, die scheinbare Exteriorität der Einwirkung zu exponieren, wird auf Clusterebene aber in die allgemeinere Struktur immanenter Selbstvermittlung absorbiert.","refs":["CH_GB18_CWUG:A8","CH_GB18_CWUG:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RMD-05","text":"Wechselwirkung mutiert von der gegenseitigen Kausalität zweier Seiten zur Aufhebung der Annahme, dass diese Seiten als selbständige Relata bestehen könnten.","refs":["CH_GB18_CWUG:AF5","CH_GB18_CD_4:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RMD-06","text":"Notwendigkeit, Zufälligkeit und Freiheit verschieben sich von gegensätzlichen Modalbegriffen zu Stufen der Manifestation einer identischen Reflexion.","refs":["CH_GB18_CD_4:A7","CH_GB18_CD_4:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_56:CGD-01","text":"Die konkrete Figur gewaltsamer Einwirkung bleibt eine lokale Expositionsform; global tragend ist allein die Umwandlung äußerlicher Einwirkung in immanente Bedingtheit.","refs":["CH_GB18_CWUG:NX4","CH_GB18_CD_4:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:CGD-02","text":"Die erste Ursache und die passive Substanz sind untere Funktionsfiguren; auf Clusterebene skaliert ihr Umschlag zur allgemeinen Instabilität jeder einseitigen Ursachposition.","refs":["CH_GB18_CWUG:D6","CH_GB18_CD_4:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:CGD-03","text":"Der schlechte Progressus von Wirkungen bleibt die lokale Negativfolie, während die gegenwärtige Ebene die Rückkehrsstruktur als allgemeine Form der Kausalität etabliert.","refs":["CH_GB18_CWUG:NX7","CH_GB18_CWUG:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:CGD-04","text":"Die Wechselwirkung ist nicht selbst die abschließende Kategorie, sondern die Übergangsmaschine, welche die Relation in Reflexion, Freiheit und Begriff überführt.","refs":["CH_GB18_CD_4:D3","CH_GB18_CD_4:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:CGD-05","text":"Die Einheit von Allgemeinheit, Besonderheit und Einzelheit gehört als terminale Artikulation zur Clusterebene, bleibt jedoch hinsichtlich ihrer notwendigen Dreigliedrigkeit begründungsbedürftig.","refs":["CH_GB18_CD_4:A9","CH_GB18_CD_4:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_56:GNX-01","text":"Ausgeschlossen ist ein Kausalmodell, in dem Ursache und Wirkung unabhängige Substrate sind, denen eine Relation erst nachträglich äußerlich zukommt.","refs":["CH_GB18_CWUG:NX1","CH_GB18_CD_4:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GNX-02","text":"Ausgeschlossen ist die dauerhafte Asymmetrie von aktivem Täter und passivem Erleidenden, weil jede Aktivität ihre eigene Passivität setzt.","refs":["CH_GB18_CWUG:DNX4","CH_GB18_CD_4:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GNX-03","text":"Ausgeschlossen ist die Erklärung durch lineare Wirkungsreihen, weil der Fortschritt der Wirkung als Rückkehr der Ursache in ihre Bedingung begriffen wird.","refs":["CH_GB18_CWUG:NX7","CH_GB18_CWUG:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GNX-04","text":"Ausgeschlossen ist Freiheit als Unbedingtheit, Willkür oder bloßes Verschwinden von Notwendigkeit.","refs":["CH_GB18_CD_4:NX5","CH_GB18_CD_4:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GNX-05","text":"Ausgeschlossen ist eine Auffassung begrifflicher Momente als getrennter ontischer Totalitäten oder bloßer Klassifikationsstufen.","refs":["CH_GB18_CD_4:NX7","CH_GB18_CD_4:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_56:DBN-01","text":"Unzulässig ist ein Verhältnis, in dem Bedingungen der Wirksamkeit der Ursache äußerlich vorausliegen und durch die Wirkung unverändert bleiben.","refs":["CH_GB18_CWUG:DNX1","CH_GB18_CD_4:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:DBN-02","text":"Unzulässig ist ein Modell, in dem Relata ihrer Relation logisch vorausgehen, weil Ursache und Wirkung nur in der Selbstvermittlung der Relation bestehen.","refs":["CH_GB18_CD_4:DNX1","CH_GB18_CD_4:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:DBN-03","text":"Unzulässig ist Negation als bloßer Verlust, da Aufhebung die Bedingung zugleich entkräftet und als Moment der Selbstbeziehung erhält.","refs":["CH_GB18_CWUG:A6","CH_GB18_CD_4:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:DBN-04","text":"Unzulässig ist eine bleibende Nichtidentität von Subjekt und objektiver Bestimmung, weil Freiheit nur als manifestierte Identität der Vermittlung gilt.","refs":["CH_GB18_CD_4:SNX3","CH_GB18_CD_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:DBN-05","text":"Unzulässig ist die Trennung logischer Form von ontologischer Wirklichkeit, weil die Kategorien selbst die Bewegungsform des Wirklichen artikulieren.","refs":["CH_GB18_CD_4:DNX5","CH_GB18_CD_4:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_56:BSA-01","text":"Unverfügbar ist ein schlechthin unmittelbarer Ursprung, weil jedes Setzen nur als Rückkehr einer bereits vermittelten Ursache auftreten kann.","refs":["CH_GB18_CWUG:SNX1","CH_GB18_CD_4:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BSA-02","text":"Unmöglich ist ein endgültiges Außen der Wechselwirkung, aus dem ein unabhängiger Grund, eine fremde Ursache oder eine letzte Bedingung einwirken könnte.","refs":["CH_GB18_CWUG:SNX3","CH_GB18_CD_4:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BSA-03","text":"Unzulässig ist Freiheit als Erhaltung einer bleibenden Nichtidentität zwischen Subjektivität und objektiver Bestimmung.","refs":["CH_GB18_CD_4:SNX3","CH_GB18_CD_4:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BSA-04","text":"Ausgeschlossen ist eine Vielzahl letzter äußerlicher Substanzen, weil Differenz nur als Selbstunterscheidung einer sich vermittelnden Einheit Geltung besitzt.","refs":["CH_GB18_CD_4:DNX4","CH_GB18_CD_4:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_56:XD-01","text":"Die Umkehrung des Passiven in Ursache und die Selbstsetzung der Passivität schließen sich zu einer Struktur zusammen, in der jede Wirkung die Bedingung ihrer Ursache reorganisiert.","refs":["CL_GB18_56:GA-01","CL_GB18_56:GA-02","CL_GB18_56:GA-03","CL_GB18_56:GA-04","CH_GB18_CWUG:AS5","CH_GB18_CD_4:A4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:XD-02","text":"Gegenwirkung erweist sich nicht als symmetrische Gegenkraft, sondern als Übergangsmechanismus, durch den die Kausalrelation ihren eigenen relationalen Status überschreitet.","refs":["CL_GB18_56:GA-03","CL_GB18_56:GA-04","CL_GB18_56:GA-05","CH_GB18_CWUG:D5","CH_GB18_CD_4:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:XD-03","text":"Der Abschluss des schlechten Wirkungsfortschritts erzeugt erst die Möglichkeit, Notwendigkeit als innere Identität und Freiheit als ihre Manifestation zu lesen.","refs":["CL_GB18_56:GA-04","CL_GB18_56:GA-05","CL_GB18_56:GA-06","CL_GB18_56:GA-07","CH_GB18_CWUG:D7","CH_GB18_CD_4:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:XD-04","text":"Gewalt verliert ihre Stellung als eigenständiger Grundbegriff, weil sie nur noch die spannungsvolle Erscheinung einer Bedingtheit darstellt, die als eigene Bestimmung des Erleidenden gelesen wird.","refs":["CL_GB18_56:GA-02","CL_GB18_56:GA-05","CL_GB18_56:GA-09","CH_GB18_CWUG:D3","CH_GB18_CWUG:MRT5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:XD-05","text":"Der Begriff entsteht als Form, in der die kausale Rückkehrsstruktur nicht mehr zwischen Seiten verläuft, sondern sich als Selbstunterscheidung der absoluten Substanz artikuliert.","refs":["CL_GB18_56:GA-05","CL_GB18_56:GA-07","CL_GB18_56:GA-08","CH_GB18_CD_4:AS4","CH_GB18_CD_4:FGS5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:XD-06","text":"Jede Berufung auf eine äußere Ursache, einen unabhängigen Grund oder eine unbedingte Freiheit wird negativ ausgeschlossen, weil sie die Selbstvermittlung von Ursache, Bedingung und Wirkung zerreißen würde.","refs":["CL_GB18_56:GA-01","CL_GB18_56:GA-10","CH_GB18_CWUG:DNX1","CH_GB18_CD_4:SNX2"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_56:BSD-01","text":"Realität erscheint als immanente Selbstvermittlung, in der logische Kategorien nicht nachträglich auf ein fertiges Sein angewandt werden, sondern dessen Bewegungsform ausmachen.","refs":["CL_GB18_56:GA-05","CL_GB18_56:GA-08","CH_GB18_CD_4:DNX5","CH_GB18_CD_4:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:BSD-02","text":"Das Subjekt ist kein vorausgesetztes Zentrum der Kausalität, sondern das Resultat einer Substanz, die ihre Differenz als identische Selbstbestimmung auslegt.","refs":["CL_GB18_56:GA-07","CL_GB18_56:GA-08","CH_GB18_CD_4:SD3","CH_GB18_CD_4:AS6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:BSD-03","text":"Zeitliche Sukzession verliert den Status einer letzten Erklärung, weil der Übergang in Anderes als Reflexion und Rückkehr in sich bestimmt wird.","refs":["CL_GB18_56:GA-01","CL_GB18_56:GA-05","CH_GB18_CD_4:A6","CH_GB18_CD_4:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:BSD-04","text":"Freiheit wird ontologisch als Vollzug der eigenen Bedingtheit bestimmt und nicht als Wahl zwischen von Vermittlung unabhängigen Möglichkeiten.","refs":["CL_GB18_56:GA-06","CL_GB18_56:GA-07","CH_GB18_CD_4:A8","CH_GB18_CD_4:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:BSD-05","text":"Erklärung muss Kausalität als Umschlag von Positionen kartieren, weil eine bloße Abfolge von Ursachen und Wirkungen die generative Rückkehrsstruktur verfehlt.","refs":["CL_GB18_56:GA-01","CL_GB18_56:GA-03","CL_GB18_56:GA-04","CH_GB18_CWUG:ALT3","CH_GB18_CD_4:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_56:RLE-01","text":"Die zentrale Schleife verläuft von vorausgesetzter Bedingung über Einwirkung und Bestimmtwerden zur Gegenwirkung und zur Passivierung der anfänglichen Ursache.","refs":["CH_GB18_CWUG:FGS1","CH_GB18_CWUG:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RLE-02","text":"Die Wiederkehr von Aktivität und Passivität markiert keinen Stillstand, sondern einen Phasenwechsel von äußerlicher Kausalität zu reflexiver Selbstvermittlung.","refs":["CH_GB18_CWUG:AF5","CH_GB18_CD_4:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RLE-03","text":"Die Bedingung fungiert als begrifflicher Attraktor, weil jede Ursache nur durch die von ihr gesetzte Passivität Ursache bleiben kann.","refs":["CH_GB18_CWUG:A2","CH_GB18_CD_4:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RLE-04","text":"Negation bildet den produktiven Motor der Architektur, weil das Aufheben von Andersheit zugleich deren Erhaltung als Vermittlung verlangt.","refs":["CH_GB18_CWUG:A6","CH_GB18_CWUG:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RLE-05","text":"Die Eskalationslinie führt von Kausalität über Wechselwirkung und Reflexion zu Notwendigkeit, Freiheit und Begriff.","refs":["CH_GB18_CD_4:AF1","CH_GB18_CD_4:AF4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RLE-06","text":"Der Begriff ist der terminale Attraktor, weil er die zuvor verteilten Gegensätze nicht addiert, sondern als Momente einer Selbstunterscheidung totalisiert.","refs":["CH_GB18_CD_4:SD4","CH_GB18_CD_4:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_56:FGS-B01","text":"Äußerliche Kausalität → vorausgesetzte Differenz von Ursache und Wirkung → Problem der verdeckten Identität.","refs":["CH_GB18_CD_4:A1","CH_GB18_CD_4:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B02","text":"Vorausgesetzte Differenz → Setzung einer passiven Bedingung → Ursache als bedingtes voraussetzendes Tun.","refs":["CH_GB18_CWUG:AS2","CH_GB18_CWUG:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B03","text":"Einwirkung auf das Passive → Aufhebung seiner scheinbaren Selbstständigkeit → Erhaltung des Anderen als Bedingung der Ursache.","refs":["CH_GB18_CWUG:AS4","CH_GB18_CWUG:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B04","text":"Bestimmtwerden des Passiven → Selbstwerden zur Ursache → Gegenwirkung gegen die erste Ursache.","refs":["CH_GB18_CWUG:AS5","CH_GB18_CWUG:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B05","text":"Gegenwirkung → Passivierung der anfänglichen Ursache → Wechselwirkung als Reflexion-in-sich.","refs":["CH_GB18_CWUG:D6","CH_GB18_CD_4:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B06","text":"Reflexive Kausalität → Manifestation innerer Notwendigkeit → Freiheit als gesetzte Identität.","refs":["CH_GB18_CD_4:AF3","CH_GB18_CD_4:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B07","text":"Freiheit der manifesten Identität → Selbstunterscheidung der absoluten Substanz → Begriff als Einheit von Allgemeinheit, Besonderheit und Einzelheit.","refs":["CH_GB18_CD_4:AF4","CH_GB18_CD_4:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_56:AFM-B01","text":"Äußerliche Ursache/Wirkung → vorausgesetzte Selbstständigkeit der Seiten.","refs":["CH_GB18_CD_4:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B02","text":"Vorausgesetzte Selbstständigkeit → passive Bedingung als gesetztes Anderes.","refs":["CH_GB18_CWUG:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B03","text":"Gesetztes Anderes → Einwirkung und Aufhebung seiner scheinbaren Selbstständigkeit.","refs":["CH_GB18_CWUG:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B04","text":"Bestimmtwerden des Passiven → Gegenwirkung und Passivierung der ursprünglichen Ursache.","refs":["CH_GB18_CWUG:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B05","text":"Wechselseitige Passivierung → Wechselwirkung als Selbstvermittlung der Kausalität.","refs":["CH_GB18_CD_4:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B06","text":"Selbstvermittlung → Manifestation innerer Notwendigkeit → Freiheit.","refs":["CH_GB18_CD_4:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B07","text":"Freiheit → Selbstunterscheidung der absoluten Substanz → Begriff als subjektive Totalität.","refs":["CH_GB18_CD_4:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_56:MME-01","text":"Ursache und Wirkung werden von getrennten Ereignispositionen zu wechselnden Funktionen einer einzigen vermittelten Selbstbeziehung umgeordnet.","refs":["CH_GB18_CWUG:ME1","CH_GB18_CD_4:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MME-02","text":"Passivität wird von fremdem Erleiden zu einer von Aktivität selbst gesetzten Bedingung transformiert.","refs":["CH_GB18_CWUG:ME2","CH_GB18_CD_4:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MME-03","text":"Der Gegensatz von Aktivität und Passivität kollabiert als ontische Verteilung, bleibt jedoch als dynamische Selbstunterscheidung der Vermittlung erhalten.","refs":["CH_GB18_CD_4:A2","CH_GB18_CD_4:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MME-04","text":"Unendlichkeit wird vom endlosen Fortschritt zur rekursiven Rückkehrsform umklassifiziert.","refs":["CH_GB18_CWUG:ME5","CH_GB18_CWUG:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MME-05","text":"Freiheit wird von der Verneinung von Bedingtheit zur expliziten Selbstgegenwart der Bedingtheit verschoben.","refs":["CH_GB18_CD_4:ME4","CH_GB18_CD_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MME-06","text":"Allgemeinheit, Besonderheit und Einzelheit werden als koextensive Artikulationen einer begrifflichen Selbstunterscheidung statt als getrennte Ordnungsstufen sichtbar.","refs":["CH_GB18_CD_4:ME5","CH_GB18_CD_4:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_56:ALT-B01","text":"Surface level — Das System behandelt Ursache, passive Substanz, Gewalt, Gegenwirkung und Wechselwirkung als explizite Figuren der Kausalität.","refs":["CH_GB18_CWUG:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:ALT-B02","text":"Structural level — Jede Ursache setzt ihre Bedingung, hebt deren Selbstständigkeit auf und reproduziert sie als eigene Vermittlungsform.","refs":["CH_GB18_CWUG:ALT2","CH_GB18_CD_4:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:ALT-B03","text":"Metastrategic level — Die Argumentation ersetzt lineare Erklärung nicht durch die Tilgung von Gegensätzen, sondern durch ihre Umcodierung als reversible Momente einer höheren Einheit.","refs":["CH_GB18_CWUG:ALT3","CH_GB18_CD_4:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:ALT-B04","text":"Ontological / Temporal level — Werden ist keine bloße Sukzession selbständiger Zustände, sondern die Erscheinungsform einer sich durch Andersheit hindurch vollziehenden Rückkehr.","refs":["CH_GB18_CWUG:ALT4","CH_GB18_CD_4:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:ALT-B05","text":"Methodological / Performative level — Die Form vollzieht ihre These, indem sie jede behauptete Äußerlichkeit erneut in eine immanente Bedingung und deren Reflexion zurückführt.","refs":["CH_GB18_CWUG:FGS1","CH_GB18_CD_4:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_56:FL-01","text":"Die reale Differenz von Ursache und Passivem wird benötigt, um Einwirkung zu artikulieren, während ihre behauptete substanzielle Identität diese Differenz zugleich begrifflich entkräftet.","refs":["CH_GB18_CWUG:MRT6","CH_GB18_CD_4:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FL-02","text":"Gewalt erscheint zugleich als äußerliche Einwirkung und als Verwirklichung einer dem Erleidenden immanenten Bestimmung; diese Doppelbestimmung bleibt irreduzibel spannungsvoll.","refs":["CH_GB18_CWUG:MRT5","CH_GB18_CWUG:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FL-03","text":"Die Gleichsetzung des Übergehens in Anderes mit Reflexion-in-sich ist für den Übergang zum Begriff notwendig, wird aber nicht weiter begründet.","refs":["CH_GB18_CD_4:MRT5","CH_GB18_CD_4:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MP-01","text":"Die Bedingung mutiert vom vorausgesetzten Anderen zur selbstgesetzten Passivität und verändert damit die Bedeutung von Abhängigkeit.","refs":["CH_GB18_CWUG:A2","CH_GB18_CD_4:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MP-02","text":"Gegenwirkung mutiert von einer Reaktion des Passiven zur allgemeinen Operation, durch welche Kausalität ihre eigene Äußerlichkeit aufhebt.","refs":["CH_GB18_CWUG:D5","CH_GB18_CD_4:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MP-03","text":"Freiheit mutiert von einem Gegenbegriff zur Notwendigkeit zur manifesten Form der Notwendigkeit selbst.","refs":["CH_GB18_CD_4:NX5","CH_GB18_CD_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_56:HSI-01","text":"Die Realität erscheint als Maschine selbstvermittelnder Differenzen, deren Teile nur bestehen, indem sie ihre Bedingungen setzen, negieren und als eigene Voraussetzungen zurückerhalten.","refs":["CH_GB18_CWUG:ALT2","CH_GB18_CD_4:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:HSI-02","text":"Das Subjekt erscheint nicht als unabhängiger Handelnder, sondern als die Form, in der Substanz ihre Differenz als identische Selbstbestimmung organisiert.","refs":["CH_GB18_CD_4:SD3","CH_GB18_CD_4:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:HSI-03","text":"Zeit erscheint als Rückkehrszeit: Jeder Übergang in Anderes ist nur in seiner Rückbeziehung auf sich selbst vollendet.","refs":["CH_GB18_CWUG:ALT4","CH_GB18_CD_4:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:HSI-04","text":"Handlung bleibt nur als immanente Transformation möglich, weil jede einseitige Ursachposition durch ihre Wirkung in Bedingtheit und Passivität zurückkehrt.","refs":["CH_GB18_CWUG:A11","CH_GB18_CWUG:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_56:MRT-B01","text":"Die extrahierte Architektur reicht aus, um den Übergang von endlicher Kausalität über Gegenwirkung und Wechselwirkung zu Freiheit und Begriff zu rekonstruieren.","refs":["CH_GB18_CWUG:MRT1","CH_GB18_CD_4:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MRT-B02","text":"Unterbestimmt bleibt die Notwendigkeit der substantiellen Identität von Ursache und passiver Substanz, auf der die gesamte Rückkehrslogik beruht.","refs":["CH_GB18_CWUG:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MRT-B03","text":"Die Architektur ist kohärent, sofern Gesetztsein, Bedingtheit, Negation und Selbstwerden als Seiten eines einzigen Vermittlungsprozesses gelten.","refs":["CH_GB18_CWUG:MRT3","CH_GB18_CD_4:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MRT-B04","text":"Ihre stärkste Operation liegt im Umschlag des Passiven in Ursache, weil dadurch lineare Wirkungsketten in rekursive Selbstvermittlung überführt werden.","refs":["CH_GB18_CWUG:MRT4","CH_GB18_CD_4:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MRT-B05","text":"Die Rekonstruktion bleibt auf die Sequenz von äußerlicher Kausalität, Gegenwirkung, Wechselwirkung, Freiheit und Begriff angewiesen, weil die terminale Begriffsstruktur nicht unabhängig von dieser Eskalation begründet wird.","refs":["CH_GB18_CD_4:MRT7","CH_GB18_CD_4:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123200322195Z_d45380e4","language_code":"en","language_name":"English","title":"Chapters 166–167","source_sha256":"a91bc77786a746a1a0b0e4ba8fe749d0149306f5a61bae679b118ce7e3e4dee4","sha256":"a8287052e0b9fd820dfea897811394deee7324ddc05638f53848be18e0269a2d","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:32:00.324600+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"CL_GB18_56:BAS-01","text":"The difficulty to be resolved consists in the fact that finite causality externally separates cause and effect and thereby conceals their inner identity.","refs":["CH_GB18_CWUG:AS1","CH_GB18_CD_4:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-02","text":"The system redefines efficacy as presupposing activity, which does not find its condition without simultaneously positing it as its own other.","refs":["CH_GB18_CWUG:AS2","CH_GB18_CD_4:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-03","text":"The passive side is not extinguished through influence, but is reversed, in its being-determined, into cause and thus into counteraction.","refs":["CH_GB18_CWUG:AS5","CH_GB18_CWUG:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-04","text":"Counteraction closes the external progression of effect, because the transition into other appears as the return of causality into its own conditionedness.","refs":["CH_GB18_CWUG:D7","CH_GB18_CD_4:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-05","text":"Reciprocal action is not the final state of two mutually stable causes, but the manifestation that activity and passivity are moments of a self-mediation.","refs":["CH_GB18_CD_4:AS2","CH_GB18_CD_4:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-06","text":"Self-mediation transforms necessity and contingency from separate modalities into unmanifest and manifest forms of the same inner identity.","refs":["CH_GB18_CD_4:AS5","CH_GB18_CD_4:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-07","text":"Freedom arises not outside conditionedness, but as its transparent self-presence, in which absolute substance becomes Concept and subjectivity.","refs":["CH_GB18_CD_4:A8","CH_GB18_CD_4:AS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BAS-08","text":"The overall movement is recursive and spiral-shaped: external causality is transformed into closure in the Concept through reversal, return, and manifestation.","refs":["CH_GB18_CWUG:SD4","CH_GB18_CD_4:MRT7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"CL_GB18_56:GA-01","text":"[Persistent] Causality possesses actuality only as self-relation that presupposes its own condition of efficacy and returns to itself in the effect.","refs":["CH_GB18_CWUG:A1","CH_GB18_CD_4:A5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-02","text":"[Mutating] The condition shifts from a seemingly external passive entity to the self-posited negation of the cause.","refs":["CH_GB18_CWUG:A9","CH_GB18_CD_4:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-03","text":"[Persistent] Activity and passivity are not fixed properties, but reversible functional positions of the same mediated causality.","refs":["CH_GB18_CWUG:SD1","CH_GB18_CD_4:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-04","text":"[Emergent] Counteraction reveals that the effect does not merely continue its cause, but sublates its isolated position and itself renders it passive.","refs":["CH_GB18_CWUG:D5","CH_GB18_CWUG:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-05","text":"[Attractor] Otherness is efficacious only as preserved and sublated self-distinction; its apparent independence is the form of mediation.","refs":["CH_GB18_CWUG:AS4","CH_GB18_CD_4:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-06","text":"[Mutating] Necessity and contingency are not eliminated, but recoded as inner and manifest states of identical reflection.","refs":["CH_GB18_CD_4:D5","CH_GB18_CD_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-07","text":"[Terminal] Freedom designates the identity of conditionedness with itself that has become manifest, and not its absence.","refs":["CH_GB18_CD_4:D6","CH_GB18_CD_4:ME4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-08","text":"[Terminal] The Concept is the form in which absolute substance posits its differences as the unity of universality, particularity, and individuality.","refs":["CH_GB18_CD_4:A11","CH_GB18_CD_4:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-09","text":"[Attractor] Negation is productive because the posited other must be preserved precisely as the condition of self-relation.","refs":["CH_GB18_CWUG:A7","CH_GB18_CD_4:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GA-10","text":"[Attractor] Neither an absolute beginning nor a final outside of mediation can subsist within the architecture.","refs":["CH_GB18_CWUG:SNX1","CH_GB18_CD_4:SNX2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"CL_GB18_56:RMD-01","text":"Causality initially recurs as an external progression of effect, but mutates into the recursive form in which cause, effect, and condition bring one another forth.","refs":["CH_GB18_CWUG:AS1","CH_GB18_CD_4:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RMD-02","text":"The passive substance remains preserved as a necessary condition, but loses the function of an alien bearer and is absorbed as the self-posited passivity of the cause.","refs":["CH_GB18_CWUG:AS3","CH_GB18_CD_4:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RMD-03","text":"Counteraction begins as the reversal of the sufferer into cause and becomes the general form in which every efficacy produces its own passivity.","refs":["CH_GB18_CWUG:AS5","CH_GB18_CD_4:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RMD-04","text":"Violence locally performs the work of exposing the apparent exteriority of influence, but at the cluster level is absorbed into the more general structure of immanent self-mediation.","refs":["CH_GB18_CWUG:A8","CH_GB18_CWUG:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RMD-05","text":"Reciprocal action mutates from the mutual causality of two sides into the sublation of the assumption that these sides could exist as independent relata.","refs":["CH_GB18_CWUG:AF5","CH_GB18_CD_4:NX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RMD-06","text":"Necessity, contingency, and freedom shift from opposed modal concepts to stages of the manifestation of an identical reflection.","refs":["CH_GB18_CD_4:A7","CH_GB18_CD_4:D6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"CL_GB18_56:CGD-01","text":"The concrete figure of violent influence remains a local form of exposition; globally load-bearing is solely the transformation of external influence into immanent conditionedness.","refs":["CH_GB18_CWUG:NX4","CH_GB18_CD_4:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:CGD-02","text":"The first cause and the passive substance are lower functional figures; at the cluster level, their reversal scales into the general instability of every one-sided causal position.","refs":["CH_GB18_CWUG:D6","CH_GB18_CD_4:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:CGD-03","text":"The bad progress of effects remains the local negative foil, whereas the present level establishes the return structure as the general form of causality.","refs":["CH_GB18_CWUG:NX7","CH_GB18_CWUG:ME5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:CGD-04","text":"Reciprocal action is not itself the concluding category, but the transitional mechanism that carries relation over into reflection, freedom, and Concept.","refs":["CH_GB18_CD_4:D3","CH_GB18_CD_4:MRT7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:CGD-05","text":"The unity of universality, particularity, and individuality belongs to the cluster level as a terminal articulation, but remains in need of grounding with respect to its necessary threefoldness.","refs":["CH_GB18_CD_4:A9","CH_GB18_CD_4:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"CL_GB18_56:GNX-01","text":"Excluded is a causal model in which cause and effect are independent substrates to which a relation accrues externally only afterward.","refs":["CH_GB18_CWUG:NX1","CH_GB18_CD_4:DNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GNX-02","text":"Excluded is the enduring asymmetry of active agent and passive sufferer, because every activity posits its own passivity.","refs":["CH_GB18_CWUG:DNX4","CH_GB18_CD_4:NX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GNX-03","text":"Excluded is explanation through linear series of effects, because the progression of effect is conceived as the return of cause into its condition.","refs":["CH_GB18_CWUG:NX7","CH_GB18_CWUG:SD4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GNX-04","text":"Excluded is freedom as unconditionedness, arbitrariness, or the mere disappearance of necessity.","refs":["CH_GB18_CD_4:NX5","CH_GB18_CD_4:DNX3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:GNX-05","text":"Excluded is a conception of conceptual moments as separate ontic totalities or mere levels of classification.","refs":["CH_GB18_CD_4:NX7","CH_GB18_CD_4:ME5"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"CL_GB18_56:DBN-01","text":"Impermissible is a relation in which conditions of the cause's efficacy lie externally prior to it and remain unchanged by the effect.","refs":["CH_GB18_CWUG:DNX1","CH_GB18_CD_4:D2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:DBN-02","text":"Impermissible is a model in which relata logically precede their relation, because cause and effect exist only in the self-mediation of relation.","refs":["CH_GB18_CD_4:DNX1","CH_GB18_CD_4:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:DBN-03","text":"Impermissible is negation as mere loss, since sublation simultaneously invalidates the condition and preserves it as a moment of self-relation.","refs":["CH_GB18_CWUG:A6","CH_GB18_CD_4:DNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:DBN-04","text":"Impermissible is an enduring nonidentity of subject and objective determination, because freedom counts only as manifested identity of mediation.","refs":["CH_GB18_CD_4:SNX3","CH_GB18_CD_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:DBN-05","text":"Impermissible is the separation of logical form from ontological actuality, because the categories themselves articulate the form of movement of the actual.","refs":["CH_GB18_CD_4:DNX5","CH_GB18_CD_4:SD4"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"CL_GB18_56:BSA-01","text":"Unavailable is an absolutely immediate origin, because every positing can occur only as the return of an already mediated cause.","refs":["CH_GB18_CWUG:SNX1","CH_GB18_CD_4:SNX1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BSA-02","text":"Impossible is a final outside of reciprocal action from which an independent ground, an alien cause, or a final condition could exert influence.","refs":["CH_GB18_CWUG:SNX3","CH_GB18_CD_4:SNX2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BSA-03","text":"Impermissible is freedom as the preservation of an enduring nonidentity between subjectivity and objective determination.","refs":["CH_GB18_CD_4:SNX3","CH_GB18_CD_4:A8"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:BSA-04","text":"Excluded is a plurality of final external substances, because difference possesses validity only as the self-distinction of a self-mediating unity.","refs":["CH_GB18_CD_4:DNX4","CH_GB18_CD_4:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"CL_GB18_56:XD-01","text":"The reversal of the passive into cause and the self-positing of passivity combine into a structure in which every effect reorganizes the condition of its cause.","refs":["CL_GB18_56:GA-01","CL_GB18_56:GA-02","CL_GB18_56:GA-03","CL_GB18_56:GA-04","CH_GB18_CWUG:AS5","CH_GB18_CD_4:A4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:XD-02","text":"Counteraction proves to be not a symmetrical counterforce, but a transitional mechanism through which the causal relation transcends its own relational status.","refs":["CL_GB18_56:GA-03","CL_GB18_56:GA-04","CL_GB18_56:GA-05","CH_GB18_CWUG:D5","CH_GB18_CD_4:D3"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:XD-03","text":"Only the closure of the bad progression of effect generates the possibility of reading necessity as inner identity and freedom as its manifestation.","refs":["CL_GB18_56:GA-04","CL_GB18_56:GA-05","CL_GB18_56:GA-06","CL_GB18_56:GA-07","CH_GB18_CWUG:D7","CH_GB18_CD_4:SD2"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:XD-04","text":"Violence loses its position as an independent basic concept, because it represents only the tension-filled appearance of a conditionedness read as the sufferer's own determination.","refs":["CL_GB18_56:GA-02","CL_GB18_56:GA-05","CL_GB18_56:GA-09","CH_GB18_CWUG:D3","CH_GB18_CWUG:MRT5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:XD-05","text":"The Concept arises as the form in which the causal return structure no longer proceeds between sides, but articulates itself as the self-distinction of absolute substance.","refs":["CL_GB18_56:GA-05","CL_GB18_56:GA-07","CL_GB18_56:GA-08","CH_GB18_CD_4:AS4","CH_GB18_CD_4:FGS5"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:XD-06","text":"Every appeal to an external cause, an independent ground, or an unconditioned freedom is negatively excluded, because it would rupture the self-mediation of cause, condition, and effect.","refs":["CL_GB18_56:GA-01","CL_GB18_56:GA-10","CH_GB18_CWUG:DNX1","CH_GB18_CD_4:SNX2"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"CL_GB18_56:BSD-01","text":"Reality appears as immanent self-mediation, in which logical categories are not subsequently applied to a finished being, but constitute its form of movement.","refs":["CL_GB18_56:GA-05","CL_GB18_56:GA-08","CH_GB18_CD_4:DNX5","CH_GB18_CD_4:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:BSD-02","text":"The subject is not a presupposed center of causality, but the result of a substance that interprets its difference as identical self-determination.","refs":["CL_GB18_56:GA-07","CL_GB18_56:GA-08","CH_GB18_CD_4:SD3","CH_GB18_CD_4:AS6"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:BSD-03","text":"Temporal succession loses the status of a final explanation, because transition into other is determined as reflection and return into itself.","refs":["CL_GB18_56:GA-01","CL_GB18_56:GA-05","CH_GB18_CD_4:A6","CH_GB18_CD_4:ALT4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:BSD-04","text":"Freedom is determined ontologically as the enactment of its own conditionedness and not as choice among possibilities independent of mediation.","refs":["CL_GB18_56:GA-06","CL_GB18_56:GA-07","CH_GB18_CD_4:A8","CH_GB18_CD_4:ME4"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"CL_GB18_56:BSD-05","text":"Explanation must map causality as the reversal of positions, because a mere sequence of causes and effects misses the generative return structure.","refs":["CL_GB18_56:GA-01","CL_GB18_56:GA-03","CL_GB18_56:GA-04","CH_GB18_CWUG:ALT3","CH_GB18_CD_4:SD1"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"CL_GB18_56:RLE-01","text":"The central loop proceeds from presupposed condition through influence and being-determined to counteraction and the rendering passive of the initial cause.","refs":["CH_GB18_CWUG:FGS1","CH_GB18_CWUG:FGS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RLE-02","text":"The recurrence of activity and passivity marks not a standstill, but a phase change from external causality to reflective self-mediation.","refs":["CH_GB18_CWUG:AF5","CH_GB18_CD_4:AF2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RLE-03","text":"The condition functions as a conceptual attractor, because every cause can remain cause only through the passivity posited by it.","refs":["CH_GB18_CWUG:A2","CH_GB18_CD_4:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RLE-04","text":"Negation forms the productive motor of the architecture, because the sublation of otherness simultaneously demands its preservation as mediation.","refs":["CH_GB18_CWUG:A6","CH_GB18_CWUG:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RLE-05","text":"The escalation line leads from causality through reciprocal action and reflection to necessity, freedom, and Concept.","refs":["CH_GB18_CD_4:AF1","CH_GB18_CD_4:AF4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:RLE-06","text":"The Concept is the terminal attractor, because it does not add the previously distributed oppositions, but totalizes them as moments of a self-distinction.","refs":["CH_GB18_CD_4:SD4","CH_GB18_CD_4:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"CL_GB18_56:FGS-B01","text":"External causality → presupposed difference of cause and effect → problem of concealed identity.","refs":["CH_GB18_CD_4:A1","CH_GB18_CD_4:AS1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B02","text":"Presupposed difference → positing of a passive condition → cause as conditioned presupposing activity.","refs":["CH_GB18_CWUG:AS2","CH_GB18_CWUG:A2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B03","text":"Influence upon the passive → sublation of its apparent independence → preservation of the other as condition of the cause.","refs":["CH_GB18_CWUG:AS4","CH_GB18_CWUG:A7"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B04","text":"Being-determined of the passive → self-becoming into cause → counteraction against the first cause.","refs":["CH_GB18_CWUG:AS5","CH_GB18_CWUG:FGS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B05","text":"Counteraction → rendering passive of the initial cause → reciprocal action as reflection-into-itself.","refs":["CH_GB18_CWUG:D6","CH_GB18_CD_4:AS4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B06","text":"Reflective causality → manifestation of inner necessity → freedom as posited identity.","refs":["CH_GB18_CD_4:AF3","CH_GB18_CD_4:D6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FGS-B07","text":"Freedom of manifest identity → self-distinction of absolute substance → Concept as unity of universality, particularity, and individuality.","refs":["CH_GB18_CD_4:AF4","CH_GB18_CD_4:A11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"CL_GB18_56:AFM-B01","text":"External cause/effect → presupposed independence of the sides.","refs":["CH_GB18_CD_4:A1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B02","text":"Presupposed independence → passive condition as posited other.","refs":["CH_GB18_CWUG:AS3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B03","text":"Posited other → influence and sublation of its apparent independence.","refs":["CH_GB18_CWUG:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B04","text":"Being-determined of the passive → counteraction and rendering passive of the original cause.","refs":["CH_GB18_CWUG:D5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B05","text":"Mutual rendering passive → reciprocal action as self-mediation of causality.","refs":["CH_GB18_CD_4:AS2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B06","text":"Self-mediation → manifestation of inner necessity → freedom.","refs":["CH_GB18_CD_4:AS5"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:AFM-B07","text":"Freedom → self-distinction of absolute substance → Concept as subjective totality.","refs":["CH_GB18_CD_4:AS6"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"CL_GB18_56:MME-01","text":"Cause and effect are rearranged from separate event-positions into alternating functions of a single mediated self-relation.","refs":["CH_GB18_CWUG:ME1","CH_GB18_CD_4:ME1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MME-02","text":"Passivity is transformed from alien suffering into a condition posited by activity itself.","refs":["CH_GB18_CWUG:ME2","CH_GB18_CD_4:ME2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MME-03","text":"The opposition of activity and passivity collapses as an ontic distribution, yet is preserved as a dynamic self-distinction of mediation.","refs":["CH_GB18_CD_4:A2","CH_GB18_CD_4:A3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MME-04","text":"Infinity is reclassified from endless progress into a recursive form of return.","refs":["CH_GB18_CWUG:ME5","CH_GB18_CWUG:FGS6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MME-05","text":"Freedom is shifted from the negation of conditionedness to the explicit self-presence of conditionedness.","refs":["CH_GB18_CD_4:ME4","CH_GB18_CD_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MME-06","text":"Universality, particularity, and individuality become visible as coextensive articulations of a conceptual self-distinction rather than as separate levels of order.","refs":["CH_GB18_CD_4:ME5","CH_GB18_CD_4:D7"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"CL_GB18_56:ALT-B01","text":"Surface level — The system treats cause, passive substance, violence, counteraction, and reciprocal action as explicit figures of causality.","refs":["CH_GB18_CWUG:ALT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:ALT-B02","text":"Structural level — Every cause posits its condition, sublates its independence, and reproduces it as its own form of mediation.","refs":["CH_GB18_CWUG:ALT2","CH_GB18_CD_4:ALT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:ALT-B03","text":"Metastrategic level — The argumentation replaces linear explanation not by the erasure of oppositions, but by their recoding as reversible moments of a higher unity.","refs":["CH_GB18_CWUG:ALT3","CH_GB18_CD_4:ALT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:ALT-B04","text":"Ontological / Temporal level — Becoming is not a mere succession of independent states, but the form of appearance of a return accomplishing itself through otherness.","refs":["CH_GB18_CWUG:ALT4","CH_GB18_CD_4:ALT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:ALT-B05","text":"Methodological / Performative level — The form enacts its thesis by leading every asserted externality back into an immanent condition and its reflection.","refs":["CH_GB18_CWUG:FGS1","CH_GB18_CD_4:FGS3"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"CL_GB18_56:FL-01","text":"The real difference between cause and the passive is required in order to articulate influence, while their asserted substantial identity simultaneously conceptually invalidates this difference.","refs":["CH_GB18_CWUG:MRT6","CH_GB18_CD_4:D4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FL-02","text":"Violence appears simultaneously as external influence and as the actualization of a determination immanent in the sufferer; this double determination remains irreducibly tension-filled.","refs":["CH_GB18_CWUG:MRT5","CH_GB18_CWUG:SD3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:FL-03","text":"The equation of transition into other with reflection-into-itself is necessary for the transition to the Concept, but is not further grounded.","refs":["CH_GB18_CD_4:MRT5","CH_GB18_CD_4:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MP-01","text":"The condition mutates from the presupposed other into self-posited passivity and thereby changes the meaning of dependence.","refs":["CH_GB18_CWUG:A2","CH_GB18_CD_4:A4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MP-02","text":"Counteraction mutates from a reaction of the passive into the general operation through which causality sublates its own externality.","refs":["CH_GB18_CWUG:D5","CH_GB18_CD_4:D3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MP-03","text":"Freedom mutates from a counter-concept to necessity into the manifest form of necessity itself.","refs":["CH_GB18_CD_4:NX5","CH_GB18_CD_4:SD2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"CL_GB18_56:HSI-01","text":"Reality appears as a machine of self-mediating differences, whose parts exist only by positing, negating, and receiving back their conditions as their own presuppositions.","refs":["CH_GB18_CWUG:ALT2","CH_GB18_CD_4:SD1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:HSI-02","text":"The subject appears not as an independent agent, but as the form in which substance organizes its difference as identical self-determination.","refs":["CH_GB18_CD_4:SD3","CH_GB18_CD_4:A11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:HSI-03","text":"Time appears as time of return: every transition into other is completed only in its relation back to itself.","refs":["CH_GB18_CWUG:ALT4","CH_GB18_CD_4:A6"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:HSI-04","text":"Action remains possible only as immanent transformation, because every one-sided causal position returns through its effect into conditionedness and passivity.","refs":["CH_GB18_CWUG:A11","CH_GB18_CWUG:SD1"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"CL_GB18_56:MRT-B01","text":"The extracted architecture suffices to reconstruct the transition from finite causality through counteraction and reciprocal action to freedom and Concept.","refs":["CH_GB18_CWUG:MRT1","CH_GB18_CD_4:MRT1"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MRT-B02","text":"What remains underdetermined is the necessity of the substantial identity of cause and passive substance on which the entire logic of return rests.","refs":["CH_GB18_CWUG:MRT2"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MRT-B03","text":"The architecture is coherent insofar as positedness, conditionedness, negation, and self-becoming count as sides of a single process of mediation.","refs":["CH_GB18_CWUG:MRT3","CH_GB18_CD_4:MRT3"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MRT-B04","text":"Its strongest operation lies in the reversal of the passive into cause, because thereby linear chains of effect are transformed into recursive self-mediation.","refs":["CH_GB18_CWUG:MRT4","CH_GB18_CD_4:MRT4"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CL_GB18_56:MRT-B05","text":"The reconstruction remains dependent on the sequence of external causality, counteraction, reciprocal action, freedom, and Concept, because the terminal conceptual structure is not grounded independently of this escalation.","refs":["CH_GB18_CD_4:MRT7","CH_GB18_CD_4:MRT2"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"CL_GB18_56@R001","source_variant_id":"canonical:CL_GB18_56:v1","source_language_code":"de"}],"identity":{"layer":"CL","kicker":"Cluster · Science of Logic","title":"Chapters 166–167","context":"c. Wirkung und Gegenwirkung. · C. Die Wechselwirkung."},"title_language_code":"en"},{"id":"MC_GB18_L1_01","layer":"MC","title":"Gb18 L1 01","order":1,"parents":["CL_GB18_01","CL_GB18_02","CL_GB18_03","CL_GB18_04"],"revision":"MC_GB18_L1_01@R001","sha256":"446cbf1b2fa205c1a186a14d3873a859eb8d4d644d931e27a48bb5ea6ae81458","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_01:AS-01","text":"Das System muss objektive Bestimmtheit aus einem vollständig entleerten Anfang erzeugen, ohne die geschichtliche Krise der Logik durch eine äußerlich bereitgestellte Methode oder Ontologie zu lösen.","refs":["CL_GB18_01:AS-B01","CL_GB18_03:SP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AS-02","text":"Logik wird deshalb als erneuerte Metaphysik rekonstruiert, deren erste Bewährung darin liegt, die Einheit von Seyn und Begriff in eine genetische Ordnung reiner Bestimmungen zu überführen.","refs":["CL_GB18_01:AS-B02","CL_GB18_02:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AS-03","text":"Die Aufhebung des Gegensatzes von Wissen und Gegenstand ermöglicht den Anfang, indem das vermittelte reine Wissen seine epistemische Form verliert und als reine Unmittelbarkeit fungiert.","refs":["CL_GB18_01:AS-B03","CL_GB18_02:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AS-04","text":"Der Beweisgang verwirklicht die allgemeine Methode bestimmter Negation an den reinen Bestimmungen selbst: Ihre fixierte Identität setzt Differenz, zerfällt im Widerspruch und erzeugt Werden sowie Daseyn.","refs":["CL_GB18_01:AS-B04","CL_GB18_04:BS-04","CL_GB18_04:BS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AS-05","text":"Die Bewegung ist apophatisch, rekursiv und spiralförmig: Abstraktion entzieht Inhalt, die entstehende Leere destabilisiert Identität, und jeder Fortgang kehrt mit größerer Bestimmtheit in seinen Grund zurück.","refs":["CL_GB18_04:BS-08","CL_GB18_03:FGS-B04","CL_GB18_02:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AS-06","text":"Die Schließung ist retrospektiv statt vorausliegend: Erst der vollständige Durchgang legitimiert Anfang und Gliederung, während die phänomenologische Eintrittsbedingung eine nicht vollständig absorbierte Voraussetzung erhält.","refs":["CL_GB18_01:GA-09","CL_GB18_02:AS-08","CL_GB18_01:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_01:GA-01","text":"[Persistent] Wissenschaftliche Wahrheit verlangt die Einheit von Methode, Inhalt, Anfang und Gliederung; jede äußerliche Anwendung einer fertigen Methode zerstört die beanspruchte Notwendigkeit.","refs":["CL_GB18_02:GA-02","CL_GB18_01:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-02","text":"[Attractor] Begriffliche Bestimmungen dürfen allein aus der Selbstunterscheidung ihres Inhalts hervorgehen, sodass Methode, Wahrheit und Objektivität in der Selbstbewegung des Begriffs konvergieren.","refs":["CL_GB18_02:GA-01","CL_GB18_01:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-03","text":"[Mutating] Reines Wissen mutiert von der konkreten Einheit von Seyn und Begriff zur reinen Unmittelbarkeit, sobald es seine relationale Wissensform verliert.","refs":["CL_GB18_02:GA-03","CL_GB18_02:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-04","text":"[Persistent] Der logische Anfang muss reine, unbestimmte Unmittelbarkeit sein, weil jeder reichere oder bestimmte Inhalt die erst zu erzeugende Vermittlung voraussetzen würde.","refs":["CL_GB18_02:GA-05","CL_GB18_03:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-05","text":"[Emergent] Der vollständige Ausschluss positiver Bestimmtheit erzeugt die strukturelle Gleichrangigkeit von reinem Seyn und reinem Nichts und macht ihre isolierte Fixierung instabil.","refs":["CL_GB18_03:GA-03","CL_GB18_04:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-06","text":"[Mutating] Differenz mutiert vom ausgeschlossenen Inhalt zur relationalen Bewegungsform, die nur im Übergang Bestand besitzt und dadurch Bestimmtheit erzeugt.","refs":["CL_GB18_03:GA-04","CL_GB18_04:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-07","text":"[Persistent] Keine Bestimmung darf isoliert bleiben; ihre notwendige Beziehung auf anderes macht ihre Endlichkeit sichtbar und treibt sie über ihre fixierte Gestalt hinaus.","refs":["CL_GB18_01:GA-06","CL_GB18_03:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-08","text":"[Attractor] Widerspruch und bestimmte Negation sind produktive Übergangsformen: Sie bewahren den negierten Inhalt, entziehen ihm aber seine selbständige Geltung.","refs":["CL_GB18_01:GA-07","CL_GB18_04:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-09","text":"[Emergent] Werden ist die Wahrheit von Seyn und Nichts, weil es Vollzug, Resultat und fortgesetzte Nichtselbständigkeit seiner Grenzmomente vereinigt.","refs":["CL_GB18_04:GA-04","CL_GB18_04:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-10","text":"[Mutating] Unmittelbarkeit und Vermittlung sind keine ausschließenden Eigenschaften, sondern wechselnde und spiralförmig wiederkehrende Funktionen derselben begrifflichen Bewegung.","refs":["CL_GB18_02:GA-04","CL_GB18_02:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-11","text":"[Terminal] Anfang und Gliederung erhalten ihre wissenschaftliche Geltung erst durch die Gesamtentwicklung, die ihre zunächst vorläufigen Setzungen rückwirkend als notwendig bestimmt.","refs":["CL_GB18_02:GA-10","CL_GB18_01:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-12","text":"[Emergent] Daseyn ist die erste Sphäre wirklicher Bestimmtheit, weil die im reinen Anfang ausgeschlossene Differenz dort als vermitteltes Verhältnis zurückkehrt.","refs":["CL_GB18_03:GA-06","CL_GB18_04:XD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_01:RMD-01","text":"Logik mutiert vom vermeintlichen Instrument des Denkens zur metaphysischen Selbstbewegung, die ihre generative Kraft an der immanenten Selbstdetermination des reinen Seyns vollzieht.","refs":["CL_GB18_01:RMD-01","CL_GB18_02:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-02","text":"Reines Wissen kehrt nicht identisch wieder: Seine vermittelte Einheit wird durch den Verlust der Wissensform zur unmittelbaren Anfangsfunktion des reinen Seyns.","refs":["CL_GB18_02:RMD-01","CL_GB18_02:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-03","text":"Seyn wandert von einem Moment der Einheit über den unbestimmten Anfang zu einem unselbständigen Grenzmoment des Werdens.","refs":["CL_GB18_02:RMD-03","CL_GB18_04:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-04","text":"Negation mutiert von der bloßen Auflösung fixer Bestimmungen zur bewahrenden Übergangsoperation und schließlich zur Bedingung bestimmter Realität.","refs":["CL_GB18_01:RMD-04","CL_GB18_04:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-05","text":"Differenz wird aus dem ontologischen Inhalt verdrängt, erscheint zunächst im Vollzug von Anschauen und Denken und kehrt im bestimmten Daseyn als reale Relation zurück.","refs":["CL_GB18_03:RMD-03","CL_GB18_04:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-06","text":"Identität mutiert von einer ausschließenden Grundform zur Identität-in-Differenz und wird anschließend zum Problem einer Urteilsform, die ihre eigene Nichtidentität verdeckt.","refs":["CL_GB18_04:GA-03","CL_GB18_04:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-07","text":"Abstraktion bleibt als Anfangsoperation notwendig, verliert aber terminale Geltung und wird zur Operation, welche die Selbständigkeit der reinen Pole entzieht.","refs":["CL_GB18_01:GA-05","CL_GB18_04:XD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-08","text":"Eintheilung mutiert von einer vorläufigen Karte zum Selbsturteil des Begriffs; ihre verschiedenen Dreiteilungen werden in rekursive Instanzen einer einzigen generativen Form absorbiert.","refs":["CL_GB18_02:RMD-04","CL_GB18_02:GA-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_01:CGD-01","text":"Die geschichtliche Krise der überlieferten Logik bleibt eine lokale Ermöglichungsbedingung; auf der aktuellen Ebene trägt allein die Einheit von sachlichem Inhalt, Methode und Gliederung.","refs":["CL_GB18_01:CGD-01","CL_GB18_02:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:CGD-02","text":"Die konkreten Dreiteilungen bleiben lokale Gliederungen ihrer Sphären; nach oben skaliert das Gesetz, dass dieselbe generative Form auf mehreren Maßstäben operiert.","refs":["CL_GB18_02:CGD-01","CL_GB18_02:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:CGD-03","text":"Die Bewegung von Seyn und Nichts zu Werden und Fürsichseyn skaliert nicht als vollständige Ontologie, sondern als erste interne Bewährung der behaupteten Selbstbewegung.","refs":["CL_GB18_04:CGD-01","CL_GB18_03:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:CGD-04","text":"Sinnliche Analogien und intentionale Beschreibungen bleiben lokale Hilfskonstruktionen; global fortbesteht allein Differenz als Vollzugsform ohne vorausgesetzten positiven Inhalt.","refs":["CL_GB18_04:CGD-04","CL_GB18_03:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:CGD-05","text":"Die Kritik einzelner Identitätssätze bleibt lokal an die Urteilsform gebunden, skaliert aber zur allgemeinen Grenze einer Sprache, die spekulative Bewegung nicht neutral darstellen kann.","refs":["CL_GB18_04:BS-05","CL_GB18_04:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:CGD-06","text":"Qualität, Quantität und Maaß bleiben die lokale Binnenordnung des Seyns; aktuell skaliert ihre Funktion als rekursive Vermittlung von Unmittelbarkeit, Aufhebung und bestimmter Relation.","refs":["CL_GB18_02:GA-09","CL_GB18_02:XD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_01:GNX-01","text":"Ausgeschlossen sind jede äußerlich bereitgestellte Methode und jeder archimedische Standpunkt außerhalb des logischen Prozesses.","refs":["CL_GB18_01:GNX-01","CL_GB18_02:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:GNX-02","text":"Ausgeschlossen ist ein inhaltlich bestimmter Anfang, der seine positive Abgrenzung bereits vor der Bewegung besäße.","refs":["CL_GB18_02:GNX-03","CL_GB18_03:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:GNX-03","text":"Ausgeschlossen sind eine irreduzible ontologische Differenz zwischen Denken und Sein und die Letztgültigkeit des Subjekt-Objekt-Gegensatzes.","refs":["CL_GB18_01:DBN-01","CL_GB18_02:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:GNX-04","text":"Ausgeschlossen ist jede isolierte Denk- oder Anfangsbestimmung, die als widerspruchsfreie und selbstgenügsame Identität bestehen bleiben könnte.","refs":["CL_GB18_01:DBN-02","CL_GB18_03:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:GNX-05","text":"Ausgeschlossen sind Seyn und Nichts als selbständige positive Pole sowie ein zeitliches oder substantielles Medium, das ihren Übergang äußerlich tragen würde.","refs":["CL_GB18_04:GNX-01","CL_GB18_04:GNX-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:GNX-06","text":"Ausgeschlossen ist die unmittelbare Beurteilung reiner Kategorien durch empirischen Inhalt, äußere Vergleichung oder die Fixierung eines einzelnen Lehrsatzes.","refs":["CL_GB18_04:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_01:DBN-01","text":"Damit das System bestehen kann, muss jeder neutrale Außenstandpunkt falsch sein; auch eine begrifflich bestimmbare Außenheit wäre bereits in die kategoriale Bewegung einbezogen.","refs":["CL_GB18_02:GNX-02","CL_GB18_01:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:DBN-02","text":"Lineare Grundlegung muss unzureichend sein: Der Anfang darf seine Letztbegründung nicht vor dem Prozess besitzen, sondern muss durch dessen Kreis rückwirkend bestimmt werden.","refs":["CL_GB18_02:DBN-02","CL_GB18_01:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:DBN-03","text":"Negation darf weder reiner Verlust noch Widerspruch ein toter Endpunkt sein; beide müssen als immanente Form eines bewahrenden Übergangs lesbar bleiben.","refs":["CL_GB18_01:DBN-04","CL_GB18_04:GA-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:DBN-04","text":"Die Ebenen reiner Kategorie und konkreter Erfahrung dürfen nicht kollabieren, weil empirische Inhalte sonst die genetische Erzeugung von Bestimmtheit umgehen würden.","refs":["CL_GB18_04:GNX-04","CL_GB18_04:BSD-02"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_01:BSA-01","text":"Die tiefste Abwesenheit ist ein ruhender Ursprung vor Negation und Vermittlung; jede Form ursprünglichen Bestands wird in rückblickend lesbare Bewegung aufgelöst.","refs":["CL_GB18_04:BSA-01","CL_GB18_04:BSD-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:BSA-02","text":"Nicht verfügbar ist ein irreduzibel fremdes Substrat oder eine positive Bestimmtheit, die vor beziehungsweise außerhalb wechselseitiger Vermittlung bestehen könnte.","refs":["CL_GB18_02:BSA-03","CL_GB18_04:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:BSA-03","text":"Nicht verfügbar ist eine endgültige Formel oder Perspektive, die spekulative Wahrheit besitzen könnte, ohne selbst in deren Übergangsbewegung einzutreten.","refs":["CL_GB18_04:DBN-03","CL_GB18_02:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:BSA-04","text":"Das System umkreist die unmögliche Möglichkeit eines inhaltslosen Anfangs, der dennoch positiv unterschieden wäre; die ungeklärte Verwandlung bloßer Ununterscheidbarkeit in Bewegung bildet seine tiefste Leerstelle.","refs":["CL_GB18_03:BSA-01","CL_GB18_04:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_01:XD-01","text":"Die allgemeine Identität von Methode und Inhalt erhält ihre operative Bewährung erst dort, wo Seyn und Nichts ihre Wahrheit ausschließlich durch den gegenseitigen Übergang erzeugen.","refs":["MC_GB18_L1_01:GA-01","MC_GB18_L1_01:GA-02","MC_GB18_L1_01:GA-09","CL_GB18_01:GA-03","CL_GB18_04:GA-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-02","text":"Die Vermittlung des reinen Wissens widerspricht der Unmittelbarkeit des Anfangs nicht, sofern seine Wissensform erlischt und nur ihr begrifflicher Minimalgehalt als reines Seyn fortbesteht.","refs":["MC_GB18_L1_01:GA-03","MC_GB18_L1_01:GA-10","CL_GB18_02:GA-03","CL_GB18_02:RMD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-03","text":"Der Ausschluss jeder Bestimmung erzeugt nicht bloß Leere, sondern die instabile Identität von Seyn und Nichts, deren Nichtselbständigkeit Werden notwendig macht.","refs":["MC_GB18_L1_01:GA-04","MC_GB18_L1_01:GA-05","MC_GB18_L1_01:GA-09","CL_GB18_03:GA-01","CL_GB18_04:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-04","text":"Werden konkretisiert bestimmte Negation: Es bewahrt Seyn und Nichts als verschwindende Momente und eröffnet im Daseyn die erste Sphäre vermittelter positiver Bestimmtheit.","refs":["MC_GB18_L1_01:GA-08","MC_GB18_L1_01:GA-09","MC_GB18_L1_01:GA-12","CL_GB18_01:GA-07","CL_GB18_04:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-05","text":"Die Makrogliederung der Logik und der Mikroübergang der Anfangskategorien sind rekursive Realisierungen derselben Form: Differenzierung, Vermittlung und Rücknahme in einen reicheren Begriff.","refs":["MC_GB18_L1_01:GA-01","MC_GB18_L1_01:GA-10","MC_GB18_L1_01:GA-11","CL_GB18_02:GA-07","CL_GB18_02:BSD-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-06","text":"Die Unzulänglichkeit des Identitätssatzes ist keine externe Sprachkritik, sondern ein performativer Fall der allgemeinen Dialektik: Die Aussage setzt jene Differenz, die ihre Form nicht tragen kann.","refs":["MC_GB18_L1_01:GA-07","MC_GB18_L1_01:GA-08","MC_GB18_L1_01:GA-09","CL_GB18_04:BS-05","CL_GB18_04:ALT-B05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-07","text":"Voraussetzungslosigkeit bezeichnet nur die lokale Inhaltsarmut des Anfangs, nicht die Abwesenheit jeder systemischen oder phänomenologischen Vermittlung.","refs":["MC_GB18_L1_01:GA-03","MC_GB18_L1_01:GA-10","MC_GB18_L1_01:GA-11","CL_GB18_02:XD-04","CL_GB18_02:FL-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-08","text":"Die generative Handlungsmacht geht vom äußeren Subjekt auf den Inhalt über, doch die Erkenntnis des immanenten Widerspruchs benötigt weiterhin eine reflektierende Instanz, deren systematischer Status ungeklärt bleibt.","refs":["MC_GB18_L1_01:GA-02","MC_GB18_L1_01:GA-08","CL_GB18_02:XD-06","CL_GB18_04:FL-03"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_01:BSD-01","text":"Erkenntnistheorie wird in Ontologie überführt, weil die Bedingungen wahren Denkens nicht mehr von der Selbstbestimmung des Seienden getrennt werden können.","refs":["CL_GB18_01:BSD-01","CL_GB18_02:BSD-01"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_01:BSD-02","text":"Das Subjekt verliert kategoriale Souveränität und wird zu einer vorübergehenden Station der Begriffsbewegung; Freiheit kann nur als Bewusstsein dieser objektiven Notwendigkeit erscheinen.","refs":["CL_GB18_01:BSD-02","CL_GB18_02:HSI-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_01:BSD-03","text":"Zeit wird zugleich gerichtet, rückwirkend und logisch gegenwärtig: Der Fortgang erzeugt neue Bestimmtheit, das Resultat bestimmt seinen Anfang, und die Pole bestehen nur als Übergegangensein.","refs":["CL_GB18_02:HSI-03","CL_GB18_04:HSI-03"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_01:BSD-04","text":"Kausalität wird immanent: Nicht ein äußerer Grund, sondern die notwendige Beziehung einer Bestimmung auf ihr Anderes und die Unhaltbarkeit ihrer Isolation erzeugen den Fortgang.","refs":["CL_GB18_01:BSD-04","CL_GB18_03:BSD-03"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_01:BSD-05","text":"Wahrheit verlagert sich vom Besitz isolierter Sätze auf die Rekonstruktion ihrer Selbstumschlagsrelationen; angemessenes Lesen muss daher Gegenbewegung, Ebenenwechsel und Übergang verfolgen.","refs":["CL_GB18_04:MME-01","CL_GB18_04:MME-04"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_01:RLE-01","text":"Die historische Niederlage der Metaphysik löst ihre Reorganisation als Logik aus; diese führt vom reinen Wissen zum reinen Seyn und prüft ihre Erneuerung an der Erzeugung des Anfangs.","refs":["CL_GB18_01:RLE-01","CL_GB18_02:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RLE-02","text":"Die zentrale ontologische Eskalation führt vom vermittelten reinen Wissen über den unbestimmten Anfang zu Gegensatz, Qualität, Daseyn und höherer Selbstbeziehung.","refs":["CL_GB18_02:RLE-01","CL_GB18_03:SP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RLE-03","text":"Die zentrale dialektische Schleife lautet: isolierte Bestimmung → notwendige Beziehung auf anderes → Widerspruch → bestimmte Negation → bewahrte und reichere Bestimmung.","refs":["CL_GB18_01:GA-06","CL_GB18_01:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RLE-04","text":"Anfang und Totalität bilden eine Rechtfertigungsschleife: Vorläufige Setzung ermöglicht Entwicklung, während erst die entwickelte Totalität die Setzung als notwendig ausweist.","refs":["CL_GB18_01:RLE-04","CL_GB18_02:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RLE-05","text":"Werden ist der lokale Attraktor der Anfangsbewegung, während der eine substantielle Begriff deren globaler Attraktor bleibt; beide bezeichnen Selbständigkeit nur als organisierte Übergangsrelation.","refs":["CL_GB18_04:RLE-04","CL_GB18_01:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RLE-06","text":"Die performative Schleife führt vom Identitätssatz über die von ihm gesetzte Differenz zum immanenten Widerspruch und von dort zurück in die Bewegung, die der Satz fixieren wollte.","refs":["CL_GB18_04:RLE-02","CL_GB18_04:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_01:FGS-B01","text":"Ausschluss einer selbständigen Methode + Forderung der Einheit von sachlichem Inhalt und Gliederung → Selbstbewegung des Inhalts als einzig zulässige wissenschaftliche Form.","refs":["CL_GB18_02:DBN-01","CL_GB18_02:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B02","text":"Phänomenologisch vermitteltes reines Wissen → Aufhebung seiner relationalen Wissensform → reine Unmittelbarkeit → reines Seyn als Minimalanfang.","refs":["CL_GB18_02:FGS-B02","CL_GB18_02:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B03","text":"Reine Unmittelbarkeit → Ausschluss jeder positiven Bestimmung → gemeinsame Bestimmungslosigkeit von Seyn und Nichts.","refs":["CL_GB18_03:GA-01","CL_GB18_03:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B04","text":"Gemeinsame Bestimmungslosigkeit + unmögliche Selbständigkeit der Pole → immanenter Widerspruch → Identität nur als Verschwinden und Übergang → Werden.","refs":["CL_GB18_04:GA-05","CL_GB18_04:BS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B05","text":"Werden → Rückkehr der ausgeschlossenen Bestimmtheit als Daseyn → Endlichkeit → Aufhebung der Isolation → höhere Selbstbeziehung.","refs":["CL_GB18_04:BS-07","CL_GB18_03:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B06","text":"Vollzogene Entwicklung → rückwirkende Rechtfertigung des Anfangs und der Eintheilung → Kreis von vorläufiger Setzung und systematischer Geltung.","refs":["CL_GB18_02:GA-10","CL_GB18_02:AS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B07","text":"Generative Gesamtform: Ausschluss erzeugt Leere; Leere erzeugt instabile Identität; instabile Identität erzeugt Differenz; Differenz erzeugt bestimmte Negation; bestimmte Negation erzeugt rekursive begriffliche Anreicherung.","refs":["CL_GB18_03:FGS-B04","CL_GB18_01:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_01:AFM-B01","text":"Krise äußerlich fixierter Logik → erneuerte Metaphysik → phänomenologisch vermitteltes reines Wissen → Verlust der Wissensform → reines Seyn als Minimalanfang.","refs":["CL_GB18_01:AS-B02","CL_GB18_02:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AFM-B02","text":"Reines Seyn → Ausschluss jeder Differenz → Leere und Gleichrangigkeit von Seyn und Nichts → instabiler Übergang → Werden → Daseyn.","refs":["CL_GB18_03:SP-02","CL_GB18_04:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AFM-B03","text":"Daseyn → Endlichkeit → Aufhebung der Isolation → Selbstbeziehung → rückwirkende Rechtfertigung des Anfangs durch die entwickelte Totalität.","refs":["CL_GB18_03:RMD-07","CL_GB18_02:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AFM-B04","text":"Urteilsförmige Fixierung der Einheit → Mitsetzung verdrängter Differenz → immanenter Selbstwiderspruch → Rückkehr von der Proposition in die Begriffsbewegung.","refs":["CL_GB18_04:AFM-B03","CL_GB18_04:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_01:MME-01","text":"Logik wird von einer Lehre formaler Richtigkeit zu einer Ontologie selbstartikulierender Begriffsbewegung umkartiert.","refs":["CL_GB18_01:MME-01","CL_GB18_02:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MME-02","text":"Anfang wird vom vorhandenen Ursprung zum Konvergenzpunkt von vermitteltem Resultat, voraussetzungsloser Abstraktion und rückwirkender Rechtfertigung.","refs":["CL_GB18_02:MME-02","CL_GB18_04:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MME-03","text":"Die Gegensätze von Unmittelbarkeit und Vermittlung sowie Identität und Differenz kollabieren als Alternativen und werden zu gleichursprünglichen Funktionen einer Bewegung.","refs":["CL_GB18_02:MME-03","CL_GB18_04:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MME-04","text":"Widerspruch und Negation wechseln vom Status logischer Defekte zu immanenten Produktionsmechanismen bestimmteren Inhalts.","refs":["CL_GB18_01:MME-04","CL_GB18_04:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MME-05","text":"Kategorien werden von ruhenden Gegenständen zu systematischen Positionen einer Übergangsordnung; Daseyn erscheint darin als Vermittlungszone zwischen Leere und bestimmter Relation.","refs":["CL_GB18_03:MME-04","CL_GB18_04:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MME-06","text":"Lesen wird von der Extraktion einzelner Lehrsätze auf die Rekonstruktion notwendiger Gegenbewegungen und die Disziplin logischer Ebenenunterschiede umgestellt.","refs":["CL_GB18_04:MME-04","CL_GB18_04:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_01:ALT-B01","text":"Auf der Surface level werden die Erneuerung und Gliederung der Logik sowie Seyn, Nichts, Werden, Daseyn und Fürsichseyn als explizite Gegenstände behandelt.","refs":["CL_GB18_02:ALT-B01","CL_GB18_04:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:ALT-B02","text":"Auf der Structural level erzeugen Ausschluss, relationale Differenz, Widerspruch, bestimmte Negation und rückwirkende Rückkehr die verschachtelte Ordnung der Bestimmungen.","refs":["CL_GB18_03:ALT-B02","CL_GB18_02:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:ALT-B03","text":"Auf der Metastrategic level wird Kritik an immanente Entwicklung gebunden und durch die Diagnose von Ebenenwechseln anstelle äußerer Widerlegung organisiert.","refs":["CL_GB18_01:ALT-B03","CL_GB18_04:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:ALT-B04","text":"Auf der Ontological / Temporal level ist Realität Selbstvermittlung, deren gerichteter Fortgang rückwirkend auf den Anfang wirkt und deren Momente nur in der logischen Gegenwart ihres Übergegangenseins bestehen.","refs":["CL_GB18_02:ALT-B04","CL_GB18_04:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:ALT-B05","text":"Auf der Methodological / Performative level setzt die Darstellung vorläufige Bestimmungen, lässt sie an ihrem immanenten Widerspruch zerfallen und vollzieht dadurch ihre eigene These.","refs":["CL_GB18_02:ALT-B05","CL_GB18_04:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_01:FL-01","text":"Der Anspruch der Voraussetzungslosigkeit bleibt mit der phänomenologischen Erzeugung des reinen Wissens gespannt; lokale Inhaltsleere beseitigt die systematische Eintrittsbedingung nicht.","refs":["CL_GB18_01:FL-01","CL_GB18_02:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:FL-02","text":"Die Benennung des völlig Unbestimmten als Seyn führt bereits eine positive Bestimmung ein, obwohl jede positive Bestimmung Differenz voraussetzen soll.","refs":["CL_GB18_02:FL-02","CL_GB18_03:GA-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:FL-03","text":"Die Ununterscheidbarkeit von Seyn und Nichts erklärt ihre Gleichrangigkeit, beweist aber nicht, weshalb daraus notwendig Bewegung, Qualität oder Daseyn statt bloßer formaler Gleichheit hervorgehen.","refs":["CL_GB18_04:MRT-B02","CL_GB18_03:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:FL-04","text":"Bestimmte Negation erklärt Bewahrung und Anreicherung, sichert aber weder die Eindeutigkeit des nächsten Begriffs noch die konkrete Folge der kategorialen Übergänge.","refs":["CL_GB18_01:FL-05","CL_GB18_02:MRT-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:FL-05","text":"Der Anspruch reiner Immanenz benötigt zur Erkennung des Widerspruchs eine reflektierende Instanz und zur Darstellung polemische oder rezeptionsbezogene Einschübe, deren Status nicht aus dem Inhalt selbst hervorgeht.","refs":["CL_GB18_04:FL-03","CL_GB18_01:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:FL-06","text":"Die rückwirkende Rechtfertigung kann entweder kontrollierte Kreisstruktur oder zirkuläre Selbstbestätigung sein; die Unterscheidung hängt vom Erfolg einer noch ausstehenden Totalität ab.","refs":["CL_GB18_02:FL-03","CL_GB18_01:RLE-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:MP-01","text":"Reines Wissen mutiert in dem Moment zu reinem Seyn, in dem die aufgehobene Relation seine Wissensform funktionslos macht.","refs":["CL_GB18_02:MP-01","CL_GB18_02:RMD-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:MP-02","text":"Differenz mutiert vom verbotenen positiven Inhalt zur operativen Vollzugsform, die ausschließlich im Übergang Bestand besitzt.","refs":["CL_GB18_03:MP-02","CL_GB18_04:RMD-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:MP-03","text":"Widerspruch mutiert vom äußeren Defekt des Gedankens zum Mechanismus, durch den eine Bestimmung die Notwendigkeit ihrer eigenen Überschreitung erzeugt.","refs":["CL_GB18_04:GA-05","CL_GB18_04:MP-01"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_01:MP-04","text":"Abstraktion mutiert von einer notwendigen Anfangsbedingung zur produktiven Entziehung der Selbständigkeit reiner Pole; fixiert würde dieselbe Operation zur Unwahrheit.","refs":["CL_GB18_01:MP-01","CL_GB18_04:XD-01"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_01:HSI-01","text":"Realität erscheint als kreisförmige, wechselseitig selbstaufhebende Maschine, die Unterschiede erzeugt, vermittelt und als unselbständige Momente in reichere Formen zurücknimmt.","refs":["CL_GB18_02:HSI-01","CL_GB18_04:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:HSI-02","text":"Das Subjekt ist weder souveräner Besitzer von Kategorien noch äußerer Vergleicher fertiger Gegenstände, sondern ein Knoten, der die immanente Bewegung nachvollzieht oder ihre Ebenen verwechselt.","refs":["CL_GB18_01:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:HSI-03","text":"Zeit ist eine Spirale aus gerichteter Entwicklung, rückwirkender Begründung und logischer Gegenwart des Übergegangenseins, nicht eine lineare Abfolge stabiler Zustände.","refs":["CL_GB18_01:HSI-03","CL_GB18_04:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:HSI-04","text":"Kampf und Navigation bestehen im Widerstand der Bestimmungen gegen ihre eigene Isolation; eine Flucht zu einem kategorial unberührten Außen bleibt ausgeschlossen.","refs":["CL_GB18_01:HSI-04","CL_GB18_03:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_01:MRT-B01","text":"Die Architektur ist in diesem Maßstab rekonstruierbar, wenn sie die Einheit von Methode und Inhalt, die Mutation des reinen Wissens, die Gleichrangigkeit von Seyn und Nichts, Werden, Daseyn und rückwirkende Schließung bewahrt.","refs":["CL_GB18_03:MRT-B01","CL_GB18_02:MRT-B01","CL_GB18_04:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MRT-B02","text":"Unterbestimmt bleiben die Verwandlung reiner Ununterscheidbarkeit in Bewegung, der Übergang von leerer Identität zu Daseyn und die Eindeutigkeit der jeweiligen dialektischen Nachfolger.","refs":["CL_GB18_04:MRT-B02","CL_GB18_03:MRT-B02","CL_GB18_01:FL-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MRT-B03","text":"Das System bleibt kohärent, sofern Unmittelbarkeit, Vermittlung und Differenz als wechselnde Funktionen statt als statische Eigenschaften behandelt und reine Kategorie sowie konkrete Erfahrung streng unterschieden werden.","refs":["CL_GB18_02:MRT-B03","CL_GB18_03:MRT-B04","CL_GB18_04:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MRT-B04","text":"Die stärkste Verbindung liegt in der Umwandlung von Unbestimmtheit in relationale Bestimmtheit und in der performativen Enthüllung der Urteilsform als unzureichendem Behälter spekulativer Wahrheit.","refs":["CL_GB18_03:MRT-B03","CL_GB18_04:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MRT-B05","text":"Die Rekonstruktion hängt unverzichtbar von Vorläufigkeit, rekursiver Rückkehr, apophatischer Kompression und rhetorischer Bewegungsleistung ab; insbesondere die Eindeutigkeit dialektischer Nachfolger widersteht vollständiger axiomatischer Reduktion.","refs":["CL_GB18_02:MRT-B05","CL_GB18_01:MRT-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123242863686Z_42cee231","language_code":"en","language_name":"English","title":"Gb18 L1 01","source_sha256":"446cbf1b2fa205c1a186a14d3873a859eb8d4d644d931e27a48bb5ea6ae81458","sha256":"8ba97dae43e70632c88ead2187081f9a80125679c789527f8c6fa89b73365809","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:32:42.865123+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_01:AS-01","text":"The system must generate objective determinacy from a completely emptied beginning, without resolving the historical crisis of logic through an externally provided method or ontology.","refs":["CL_GB18_01:AS-B01","CL_GB18_03:SP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AS-02","text":"Logic is therefore reconstructed as renewed metaphysics, whose first validation consists in transferring the unity of Seyn and concept into a genetic order of pure determinations.","refs":["CL_GB18_01:AS-B02","CL_GB18_02:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AS-03","text":"The sublation of the opposition between knowledge and object enables the beginning, in that mediated pure knowledge loses its epistemic form and functions as pure immediacy.","refs":["CL_GB18_01:AS-B03","CL_GB18_02:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AS-04","text":"The course of proof realizes the universal method of determinate negation in the pure determinations themselves: their fixed identity posits difference, disintegrates in contradiction, and generates becoming and Daseyn.","refs":["CL_GB18_01:AS-B04","CL_GB18_04:BS-04","CL_GB18_04:BS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AS-05","text":"The movement is apophatic, recursive, and spiral-shaped: abstraction withdraws content, the resulting emptiness destabilizes identity, and every progression returns to its ground with greater determinacy.","refs":["CL_GB18_04:BS-08","CL_GB18_03:FGS-B04","CL_GB18_02:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AS-06","text":"The closure is retrospective rather than antecedent: only the complete passage legitimates beginning and articulation, while the phenomenological condition of entry retains a presupposition that is not fully absorbed.","refs":["CL_GB18_01:GA-09","CL_GB18_02:AS-08","CL_GB18_01:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_01:GA-01","text":"[Persistent] Scientific truth requires the unity of method, content, beginning, and articulation; every external application of a finished method destroys the necessity claimed.","refs":["CL_GB18_02:GA-02","CL_GB18_01:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-02","text":"[Attractor] Conceptual determinations may arise solely from the self-differentiation of their content, such that method, truth, and objectivity converge in the self-movement of the concept.","refs":["CL_GB18_02:GA-01","CL_GB18_01:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-03","text":"[Mutating] Pure knowledge mutates from the concrete unity of Seyn and concept into pure immediacy as soon as it loses its relational form of knowledge.","refs":["CL_GB18_02:GA-03","CL_GB18_02:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-04","text":"[Persistent] The logical beginning must be pure, indeterminate immediacy, because every richer or determinate content would presuppose the mediation yet to be generated.","refs":["CL_GB18_02:GA-05","CL_GB18_03:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-05","text":"[Emergent] The complete exclusion of positive determinacy generates the structural equivalence of pure Seyn and pure nothing and renders their isolated fixation unstable.","refs":["CL_GB18_03:GA-03","CL_GB18_04:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-06","text":"[Mutating] Difference mutates from excluded content into the relational form of movement, which subsists only in transition and thereby generates determinacy.","refs":["CL_GB18_03:GA-04","CL_GB18_04:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-07","text":"[Persistent] No determination may remain isolated; its necessary relation to an other makes its finitude visible and drives it beyond its fixed shape.","refs":["CL_GB18_01:GA-06","CL_GB18_03:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-08","text":"[Attractor] Contradiction and determinate negation are productive forms of transition: they preserve the negated content but deprive it of its independent validity.","refs":["CL_GB18_01:GA-07","CL_GB18_04:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-09","text":"[Emergent] Becoming is the truth of Seyn and nothing because it unites enactment, result, and the continued non-independence of its limit-moments.","refs":["CL_GB18_04:GA-04","CL_GB18_04:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-10","text":"[Mutating] Immediacy and mediation are not mutually exclusive properties but alternating and spirally recurring functions of the same conceptual movement.","refs":["CL_GB18_02:GA-04","CL_GB18_02:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-11","text":"[Terminal] Beginning and articulation receive their scientific validity only through the total development, which retrospectively determines their initially provisional positings as necessary.","refs":["CL_GB18_02:GA-10","CL_GB18_01:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:GA-12","text":"[Emergent] Daseyn is the first sphere of actual determinacy, because the difference excluded in the pure beginning returns there as a mediated relation.","refs":["CL_GB18_03:GA-06","CL_GB18_04:XD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_01:RMD-01","text":"Logic mutates from the supposed instrument of thinking into metaphysical self-movement, which enacts its generative force in the immanent self-determination of pure Seyn.","refs":["CL_GB18_01:RMD-01","CL_GB18_02:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-02","text":"Pure knowledge does not recur identically: its mediated unity becomes, through the loss of the form of knowledge, the immediate initial function of pure Seyn.","refs":["CL_GB18_02:RMD-01","CL_GB18_02:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-03","text":"Seyn migrates from a moment of unity through the indeterminate beginning to a non-independent limit-moment of becoming.","refs":["CL_GB18_02:RMD-03","CL_GB18_04:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-04","text":"Negation mutates from the mere dissolution of fixed determinations into a preserving operation of transition and finally into the condition of determinate reality.","refs":["CL_GB18_01:RMD-04","CL_GB18_04:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-05","text":"Difference is displaced from ontological content, appears first in the enactment of intuition and thinking, and returns in determinate Daseyn as a real relation.","refs":["CL_GB18_03:RMD-03","CL_GB18_04:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-06","text":"Identity mutates from an exclusive basic form into identity-in-difference and subsequently becomes the problem of a form of judgment that conceals its own non-identity.","refs":["CL_GB18_04:GA-03","CL_GB18_04:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-07","text":"Abstraction remains necessary as an initial operation, but loses terminal validity and becomes the operation that withdraws the independence of the pure poles.","refs":["CL_GB18_01:GA-05","CL_GB18_04:XD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RMD-08","text":"Eintheilung mutates from a provisional map into the self-judgment of the concept; its various tripartitions are absorbed into recursive instances of a single generative form.","refs":["CL_GB18_02:RMD-04","CL_GB18_02:GA-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_01:CGD-01","text":"The historical crisis of inherited logic remains a local enabling condition; at the current level, only the unity of objective content, method, and articulation bears weight.","refs":["CL_GB18_01:CGD-01","CL_GB18_02:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:CGD-02","text":"The concrete tripartitions remain local articulations of their spheres; scaled upward is the law that the same generative form operates at multiple scales.","refs":["CL_GB18_02:CGD-01","CL_GB18_02:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:CGD-03","text":"The movement from Seyn and nothing to becoming and Fürsichseyn does not scale as a complete ontology, but as the first internal validation of the asserted self-movement.","refs":["CL_GB18_04:CGD-01","CL_GB18_03:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:CGD-04","text":"Sensuous analogies and intentional descriptions remain local auxiliary constructions; globally, only difference as a form of enactment without presupposed positive content persists.","refs":["CL_GB18_04:CGD-04","CL_GB18_03:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:CGD-05","text":"The critique of individual propositions of identity remains locally bound to the form of judgment, but scales into the general limit of a language that cannot neutrally represent speculative movement.","refs":["CL_GB18_04:BS-05","CL_GB18_04:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:CGD-06","text":"Quality, quantity, and Maaß remain the local internal order of Seyn; currently, their function scales as recursive mediation of immediacy, sublation, and determinate relation.","refs":["CL_GB18_02:GA-09","CL_GB18_02:XD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_01:GNX-01","text":"Excluded are every externally provided method and every Archimedean standpoint outside the logical process.","refs":["CL_GB18_01:GNX-01","CL_GB18_02:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:GNX-02","text":"Excluded is a beginning determined in content that would already possess its positive delimitation before the movement.","refs":["CL_GB18_02:GNX-03","CL_GB18_03:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:GNX-03","text":"Excluded are an irreducible ontological difference between thinking and being and the ultimate validity of the subject-object opposition.","refs":["CL_GB18_01:DBN-01","CL_GB18_02:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:GNX-04","text":"Excluded is every isolated determination of thinking or beginning that could remain as a contradiction-free and self-sufficient identity.","refs":["CL_GB18_01:DBN-02","CL_GB18_03:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:GNX-05","text":"Excluded are Seyn and nothing as independent positive poles, as well as a temporal or substantial medium that would externally sustain their transition.","refs":["CL_GB18_04:GNX-01","CL_GB18_04:GNX-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:GNX-06","text":"Excluded is the immediate assessment of pure categories by empirical content, external comparison, or the fixation of an individual theorem.","refs":["CL_GB18_04:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_01:DBN-01","text":"For the system to subsist, every neutral external standpoint must be false; even a conceptually determinable externality would already be included in categorial movement.","refs":["CL_GB18_02:GNX-02","CL_GB18_01:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:DBN-02","text":"Linear grounding must be insufficient: the beginning may not possess its ultimate grounding prior to the process, but must be retrospectively determined through its circle.","refs":["CL_GB18_02:DBN-02","CL_GB18_01:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:DBN-03","text":"Negation may be neither pure loss nor contradiction a dead endpoint; both must remain readable as immanent form of a preserving transition.","refs":["CL_GB18_01:DBN-04","CL_GB18_04:GA-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:DBN-04","text":"The levels of pure category and concrete experience may not collapse, because empirical contents would otherwise bypass the genetic generation of determinacy.","refs":["CL_GB18_04:GNX-04","CL_GB18_04:BSD-02"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_01:BSA-01","text":"The deepest absence is a resting origin prior to negation and mediation; every form of original subsistence is dissolved into retrospectively readable movement.","refs":["CL_GB18_04:BSA-01","CL_GB18_04:BSD-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:BSA-02","text":"Unavailable is an irreducibly alien substrate or a positive determinacy that could subsist before or outside reciprocal mediation.","refs":["CL_GB18_02:BSA-03","CL_GB18_04:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:BSA-03","text":"Unavailable is a final formula or perspective that could possess speculative truth without itself entering into its movement of transition.","refs":["CL_GB18_04:DBN-03","CL_GB18_02:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_01:BSA-04","text":"The system circles around the impossible possibility of a contentless beginning that would nevertheless be positively distinguished; the unexplained transformation of mere indistinguishability into movement constitutes its deepest lacuna.","refs":["CL_GB18_03:BSA-01","CL_GB18_04:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_01:XD-01","text":"The universal identity of method and content receives its operative validation only where Seyn and nothing generate their truth exclusively through mutual transition.","refs":["MC_GB18_L1_01:GA-01","MC_GB18_L1_01:GA-02","MC_GB18_L1_01:GA-09","CL_GB18_01:GA-03","CL_GB18_04:GA-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-02","text":"The mediation of pure knowledge does not contradict the immediacy of the beginning, provided that its form of knowledge expires and only its conceptual minimal content persists as pure Seyn.","refs":["MC_GB18_L1_01:GA-03","MC_GB18_L1_01:GA-10","CL_GB18_02:GA-03","CL_GB18_02:RMD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-03","text":"The exclusion of every determination generates not mere emptiness, but the unstable identity of Seyn and nothing, whose non-independence makes becoming necessary.","refs":["MC_GB18_L1_01:GA-04","MC_GB18_L1_01:GA-05","MC_GB18_L1_01:GA-09","CL_GB18_03:GA-01","CL_GB18_04:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-04","text":"Becoming concretizes determinate negation: it preserves Seyn and nothing as vanishing moments and opens, in Daseyn, the first sphere of mediated positive determinacy.","refs":["MC_GB18_L1_01:GA-08","MC_GB18_L1_01:GA-09","MC_GB18_L1_01:GA-12","CL_GB18_01:GA-07","CL_GB18_04:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-05","text":"The macro-articulation of logic and the micro-transition of the initial categories are recursive realizations of the same form: differentiation, mediation, and resumption into a richer concept.","refs":["MC_GB18_L1_01:GA-01","MC_GB18_L1_01:GA-10","MC_GB18_L1_01:GA-11","CL_GB18_02:GA-07","CL_GB18_02:BSD-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-06","text":"The inadequacy of the proposition of identity is not an external critique of language, but a performative case of the universal dialectic: the statement posits that difference which its form cannot bear.","refs":["MC_GB18_L1_01:GA-07","MC_GB18_L1_01:GA-08","MC_GB18_L1_01:GA-09","CL_GB18_04:BS-05","CL_GB18_04:ALT-B05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-07","text":"Presuppositionlessness designates only the local poverty of content of the beginning, not the absence of all systemic or phenomenological mediation.","refs":["MC_GB18_L1_01:GA-03","MC_GB18_L1_01:GA-10","MC_GB18_L1_01:GA-11","CL_GB18_02:XD-04","CL_GB18_02:FL-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_01:XD-08","text":"Generative agency passes from the external subject to the content, yet the cognition of immanent contradiction still requires a reflecting instance whose systematic status remains unresolved.","refs":["MC_GB18_L1_01:GA-02","MC_GB18_L1_01:GA-08","CL_GB18_02:XD-06","CL_GB18_04:FL-03"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_01:BSD-01","text":"Epistemology is transferred into ontology because the conditions of true thinking can no longer be separated from the self-determination of what is.","refs":["CL_GB18_01:BSD-01","CL_GB18_02:BSD-01"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_01:BSD-02","text":"The subject loses categorial sovereignty and becomes a temporary station of conceptual movement; freedom can appear only as consciousness of this objective necessity.","refs":["CL_GB18_01:BSD-02","CL_GB18_02:HSI-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_01:BSD-03","text":"Time is at once directed, retrospective, and logically present: progression generates new determinacy, the result determines its beginning, and the poles subsist only as having-passed-over.","refs":["CL_GB18_02:HSI-03","CL_GB18_04:HSI-03"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_01:BSD-04","text":"Causality becomes immanent: not an external ground, but the necessary relation of a determination to its other and the untenability of its isolation generate the progression.","refs":["CL_GB18_01:BSD-04","CL_GB18_03:BSD-03"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_01:BSD-05","text":"Truth shifts from possession of isolated propositions to reconstruction of their relations of self-reversal; adequate reading must therefore follow counter-movement, level-change, and transition.","refs":["CL_GB18_04:MME-01","CL_GB18_04:MME-04"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_01:RLE-01","text":"The historical defeat of metaphysics triggers its reorganization as logic; this leads from pure knowledge to pure Seyn and tests its renewal in the generation of the beginning.","refs":["CL_GB18_01:RLE-01","CL_GB18_02:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RLE-02","text":"The central ontological escalation leads from mediated pure knowledge through the indeterminate beginning to opposition, quality, Daseyn, and higher self-relation.","refs":["CL_GB18_02:RLE-01","CL_GB18_03:SP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RLE-03","text":"The central dialectical loop is: isolated determination → necessary relation to an other → contradiction → determinate negation → preserved and richer determination.","refs":["CL_GB18_01:GA-06","CL_GB18_01:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RLE-04","text":"Beginning and totality form a loop of justification: provisional positing enables development, while only the developed totality establishes the positing as necessary.","refs":["CL_GB18_01:RLE-04","CL_GB18_02:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RLE-05","text":"Becoming is the local attractor of the initial movement, while the one substantial concept remains its global attractor; both designate independence only as an organized relation of transition.","refs":["CL_GB18_04:RLE-04","CL_GB18_01:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:RLE-06","text":"The performative loop leads from the proposition of identity through the difference posited by it to immanent contradiction and from there back into the movement that the proposition sought to fix.","refs":["CL_GB18_04:RLE-02","CL_GB18_04:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_01:FGS-B01","text":"Exclusion of an independent method + demand for the unity of objective content and articulation → self-movement of content as the only admissible scientific form.","refs":["CL_GB18_02:DBN-01","CL_GB18_02:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B02","text":"Phenomenologically mediated pure knowledge → sublation of its relational form of knowledge → pure immediacy → pure Seyn as minimal beginning.","refs":["CL_GB18_02:FGS-B02","CL_GB18_02:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B03","text":"Pure immediacy → exclusion of every positive determination → shared indeterminacy of Seyn and nothing.","refs":["CL_GB18_03:GA-01","CL_GB18_03:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B04","text":"Shared indeterminacy + impossible independence of the poles → immanent contradiction → identity only as vanishing and transition → becoming.","refs":["CL_GB18_04:GA-05","CL_GB18_04:BS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B05","text":"Becoming → return of excluded determinacy as Daseyn → finitude → sublation of isolation → higher self-relation.","refs":["CL_GB18_04:BS-07","CL_GB18_03:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B06","text":"Completed development → retrospective justification of the beginning and Eintheilung → circle of provisional positing and systematic validity.","refs":["CL_GB18_02:GA-10","CL_GB18_02:AS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:FGS-B07","text":"Generative overall form: exclusion generates emptiness; emptiness generates unstable identity; unstable identity generates difference; difference generates determinate negation; determinate negation generates recursive conceptual enrichment.","refs":["CL_GB18_03:FGS-B04","CL_GB18_01:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_01:AFM-B01","text":"Crisis of externally fixed logic → renewed metaphysics → phenomenologically mediated pure knowledge → loss of the form of knowledge → pure Seyn as minimal beginning.","refs":["CL_GB18_01:AS-B02","CL_GB18_02:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AFM-B02","text":"Pure Seyn → exclusion of every difference → emptiness and equivalence of Seyn and nothing → unstable transition → becoming → Daseyn.","refs":["CL_GB18_03:SP-02","CL_GB18_04:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AFM-B03","text":"Daseyn → finitude → sublation of isolation → self-relation → retrospective justification of the beginning through developed totality.","refs":["CL_GB18_03:RMD-07","CL_GB18_02:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:AFM-B04","text":"Judgment-form fixation of unity → co-positing of displaced difference → immanent self-contradiction → return from proposition into conceptual movement.","refs":["CL_GB18_04:AFM-B03","CL_GB18_04:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_01:MME-01","text":"Logic is remapped from a doctrine of formal correctness into an ontology of self-articulating conceptual movement.","refs":["CL_GB18_01:MME-01","CL_GB18_02:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MME-02","text":"Beginning shifts from existing origin to the convergence point of mediated result, presuppositionless abstraction, and retrospective justification.","refs":["CL_GB18_02:MME-02","CL_GB18_04:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MME-03","text":"The oppositions of immediacy and mediation, as well as identity and difference, collapse as alternatives and become co-original functions of a movement.","refs":["CL_GB18_02:MME-03","CL_GB18_04:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MME-04","text":"Contradiction and negation shift from the status of logical defects to immanent mechanisms for producing more determinate content.","refs":["CL_GB18_01:MME-04","CL_GB18_04:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MME-05","text":"Categories shift from resting objects to systematic positions of an order of transition; within it, Daseyn appears as a zone of mediation between emptiness and determinate relation.","refs":["CL_GB18_03:MME-04","CL_GB18_04:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MME-06","text":"Reading is shifted from the extraction of individual propositions to the reconstruction of necessary counter-movements and the discipline of logical differences of level.","refs":["CL_GB18_04:MME-04","CL_GB18_04:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_01:ALT-B01","text":"At the Surface level, the renewal and articulation of logic, as well as Seyn, nothing, becoming, Daseyn, and Fürsichseyn, are treated as explicit objects.","refs":["CL_GB18_02:ALT-B01","CL_GB18_04:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:ALT-B02","text":"At the Structural level, exclusion, relational difference, contradiction, determinate negation, and retrospective return generate the nested order of determinations.","refs":["CL_GB18_03:ALT-B02","CL_GB18_02:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:ALT-B03","text":"At the Metastrategic level, critique is bound to immanent development and organized through the diagnosis of changes of level in place of external refutation.","refs":["CL_GB18_01:ALT-B03","CL_GB18_04:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:ALT-B04","text":"At the Ontological / Temporal level, reality is self-mediation, whose directed progression acts retrospectively upon the beginning and whose moments subsist only in the logical present of their having-passed-over.","refs":["CL_GB18_02:ALT-B04","CL_GB18_04:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:ALT-B05","text":"At the Methodological / Performative level, the presentation provisionally posits determinations, lets them disintegrate in their immanent contradiction, and thereby enacts its own thesis.","refs":["CL_GB18_02:ALT-B05","CL_GB18_04:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_01:FL-01","text":"The claim of presuppositionlessness remains in tension with the phenomenological generation of pure knowledge; local emptiness of content does not eliminate the systematic condition of entry.","refs":["CL_GB18_01:FL-01","CL_GB18_02:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:FL-02","text":"The naming of the wholly indeterminate as Seyn already introduces a positive determination, although every positive determination is supposed to presuppose difference.","refs":["CL_GB18_02:FL-02","CL_GB18_03:GA-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:FL-03","text":"The indistinguishability of Seyn and nothing explains their equivalence, but does not prove why movement, quality, or Daseyn rather than mere formal equality must necessarily arise from it.","refs":["CL_GB18_04:MRT-B02","CL_GB18_03:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:FL-04","text":"Determinate negation explains preservation and enrichment, but secures neither the univocity of the next concept nor the concrete sequence of categorial transitions.","refs":["CL_GB18_01:FL-05","CL_GB18_02:MRT-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:FL-05","text":"The claim of pure immanence requires a reflecting instance for recognizing contradiction and polemical or reception-related insertions for presentation, whose status does not arise from the content itself.","refs":["CL_GB18_04:FL-03","CL_GB18_01:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:FL-06","text":"Retrospective justification can be either a controlled circular structure or circular self-confirmation; the distinction depends on the success of a totality still outstanding.","refs":["CL_GB18_02:FL-03","CL_GB18_01:RLE-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:MP-01","text":"Pure knowledge mutates into pure Seyn at the moment when the sublated relation renders its form of knowledge functionless.","refs":["CL_GB18_02:MP-01","CL_GB18_02:RMD-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:MP-02","text":"Difference mutates from prohibited positive content into the operative form of enactment that subsists exclusively in transition.","refs":["CL_GB18_03:MP-02","CL_GB18_04:RMD-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_01:MP-03","text":"Contradiction mutates from an external defect of thought into the mechanism through which a determination generates the necessity of its own transcendence.","refs":["CL_GB18_04:GA-05","CL_GB18_04:MP-01"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_01:MP-04","text":"Abstraction mutates from a necessary initial condition into the productive withdrawal of the independence of pure poles; if fixed, the same operation would become untruth.","refs":["CL_GB18_01:MP-01","CL_GB18_04:XD-01"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_01:HSI-01","text":"Reality appears as a circular, reciprocally self-sublating machine that generates differences, mediates them, and takes them back as non-independent moments into richer forms.","refs":["CL_GB18_02:HSI-01","CL_GB18_04:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:HSI-02","text":"The subject is neither sovereign possessor of categories nor external comparer of finished objects, but a node that retraces immanent movement or confuses its levels.","refs":["CL_GB18_01:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:HSI-03","text":"Time is a spiral of directed development, retrospective grounding, and the logical present of having-passed-over, not a linear succession of stable states.","refs":["CL_GB18_01:HSI-03","CL_GB18_04:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:HSI-04","text":"Struggle and navigation consist in the resistance of determinations to their own isolation; an escape to a categorially untouched outside remains excluded.","refs":["CL_GB18_01:HSI-04","CL_GB18_03:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_01:MRT-B01","text":"The architecture is reconstructible at this scale if it preserves the unity of method and content, the mutation of pure knowledge, the equivalence of Seyn and nothing, becoming, Daseyn, and retrospective closure.","refs":["CL_GB18_03:MRT-B01","CL_GB18_02:MRT-B01","CL_GB18_04:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MRT-B02","text":"Underdetermined remain the transformation of pure indistinguishability into movement, the transition from empty identity to Daseyn, and the univocity of the respective dialectical successors.","refs":["CL_GB18_04:MRT-B02","CL_GB18_03:MRT-B02","CL_GB18_01:FL-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MRT-B03","text":"The system remains coherent provided that immediacy, mediation, and difference are treated as alternating functions rather than static properties and pure category and concrete experience are strictly distinguished.","refs":["CL_GB18_02:MRT-B03","CL_GB18_03:MRT-B04","CL_GB18_04:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MRT-B04","text":"The strongest connection lies in the transformation of indeterminacy into relational determinacy and in the performative unveiling of the form of judgment as an inadequate container of speculative truth.","refs":["CL_GB18_03:MRT-B03","CL_GB18_04:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_01:MRT-B05","text":"The reconstruction depends indispensably on provisionality, recursive return, apophatic compression, and rhetorical performance of movement; in particular, the univocity of dialectical successors resists complete axiomatic reduction.","refs":["CL_GB18_02:MRT-B05","CL_GB18_01:MRT-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_01@R001","source_variant_id":"canonical:MC_GB18_L1_01:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 01","context":"Chapters 01–12 · Vorrede zur ersten Ausgabe. · Vorrede zur zweiten Auflage. · Allgemeiner Begriff der Logik · Allgemeine Eintheilung der Logik · Womit muß der Anfang der Wissenschaft gemacht werden? · Allgemeine Eintheilung des Seyns · Erster Abschnitt. Bestimmtheit (Qualität). · A. Seyn. · B. Nichts. · 1. Einheit des Seyns und Nichts. · Anmerkung 1. · Anmerkung 2."},"title_language_code":"en"},{"id":"MC_GB18_L2_01","layer":"MC","title":"Gb18 L2 01","order":1,"parents":["MC_GB18_L1_01","MC_GB18_L1_02","MC_GB18_L1_03","MC_GB18_L1_04"],"revision":"MC_GB18_L2_01@R001","sha256":"949fa028dcebb423cc0d5534f2ab1b9b5fc4fd6bac2ce2ce5c6fdc9df5a146d4","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L2_01:AS-01","text":"Das System muss qualitative Bestimmtheit, Endlichkeit, Unendlichkeit und Vielheit aus einem bestimmungslosen Anfang erzeugen, ohne Differenz, Beziehung oder Bewegung als selbständige Tatsachen vorauszusetzen.","refs":["MC_GB18_L1_01:AS-01","MC_GB18_L1_04:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-02","text":"Seine globale These bestimmt Negation als erzeugende und bewahrende Operation, durch die endliche Bestimmungen ihre Selbständigkeit verlieren und als wirksame Momente immanenter Einheit fortbestehen.","refs":["MC_GB18_L1_02:AS-02","MC_GB18_L1_04:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-03","text":"Das Argument wird zu einer immanent-dialektischen Ontologie, in der jede Bestimmung durch ihre ausgeschlossene Bedingung destabilisiert und in ein komplexeres Operationsregime überführt wird.","refs":["MC_GB18_L1_02:AS-03","MC_GB18_L1_04:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-04","text":"Die erste Bewegung führt vom entleerten reinen Wissen über Seyn, Nichts und Werden zur resultativen Unmittelbarkeit des Daseyns und zur Entfaltung qualitativer Negativität.","refs":["MC_GB18_L1_02:AS-01","MC_GB18_L1_02:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-05","text":"Die qualitative Bewegung eskaliert von Grenze und Endlichkeit über Sollen und schlechte Unendlichkeit zur Aufhebung der selbständigen Gegenstellung von Endlichem und Unendlichem.","refs":["MC_GB18_L1_03:AS-03","MC_GB18_L1_03:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-06","text":"Vermittelte Unendlichkeit verdichtet sich zum Fürsichsein und zum Eins, dessen negative Selbstbeziehung durch Leeres und Repulsion die Vielheit erzeugt.","refs":["MC_GB18_L1_04:AS-B05","MC_GB18_L1_04:AS-B06","MC_GB18_L1_04:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-07","text":"Die Bewegung ist apophatisch, rekursiv, spiralförmig und mutationsgetrieben: Jeder Ausschluss erzeugt das Ausgeschlossene erneut als interne Bedingung einer reicheren Form.","refs":["MC_GB18_L1_01:AS-05","MC_GB18_L1_03:AS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-08","text":"Die Schließung ist retrospektiv und offen: Die entwickelte qualitative Totalität legitimiert ihren Anfang, vollendet sich aber nur durch ihren Übergang in die noch nicht entwickelte Ordnung der Quantität.","refs":["MC_GB18_L1_04:AS-B08","MC_GB18_L1_01:GA-11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L2_01:GA-01","text":"[Persistent] Wissenschaftliche und ontologische Notwendigkeit dürfen nur aus der Selbstbewegung des Inhalts hervorgehen; eine äußerlich angewandte Methode könnte Übergänge lediglich behaupten.","refs":["MC_GB18_L1_01:GA-01","MC_GB18_L1_02:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-02","text":"[Persistent] Keine Bestimmung besitzt isolierte Selbständigkeit, weil ihre Identität nur durch Beziehung auf das von ihr Unterschiedene entsteht und fortbesteht.","refs":["MC_GB18_L1_01:GA-07","MC_GB18_L1_02:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-03","text":"[Mutating] Negation mutiert vom abstrakten Nichts über Übergang, Aufhebung, Qualität und Grenze zur Selbstnegation der Opposition und schließlich zur Repulsion als Erzeugung von Vielheit.","refs":["MC_GB18_L1_01:GA-08","MC_GB18_L1_02:GA-03","MC_GB18_L1_04:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-04","text":"[Mutating] Unmittelbarkeit mutiert vom inhaltsleeren Anfang zur verdichteten Erscheinungsform aufgehobener Vermittlung und weiter zur abstrakten Seinsform negativer Selbstbeziehung.","refs":["MC_GB18_L1_01:GA-10","MC_GB18_L1_02:GA-05","MC_GB18_L1_04:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-05","text":"[Persistent] Anderssein ist kein äußerlicher Zusatz zur Identität, sondern das interne Moment, durch dessen Aufhebung Selbstbeziehung überhaupt generative Kraft gewinnt.","refs":["MC_GB18_L1_03:GA-01","MC_GB18_L1_04:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-06","text":"[Emergent] Realität und Bestimmtheit sind nur als organisierte Negativität möglich; reine Positivität fällt entweder in Unbestimmtheit zurück oder schlägt in widersprüchliche Überfülle um.","refs":["MC_GB18_L1_02:GA-06","MC_GB18_L1_03:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-07","text":"[Mutating] Grenze mutiert von qualitativer Konstitution zur inneren Endlichkeit, zur Schranke wiederholter Überschreitung und schließlich zur ideellen Differenz innerhalb vermittelter Einheit.","refs":["MC_GB18_L1_03:GA-02","MC_GB18_L1_02:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-08","text":"[Emergent] Schlechte Unendlichkeit ist keine Annäherung an ein Jenseits, sondern die rekursive Wiederherstellung einer Grenze, deren abstrakte Überschreitung ihre Gegenstellung unangetastet lässt.","refs":["MC_GB18_L1_03:GA-07","MC_GB18_L1_03:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-09","text":"[Attractor] Selbstbeziehung ist der globale Attraktor, auf den Werden, Grenze, Endlichkeit, Idealität, Fürsichsein, Eins und Repulsion als zunehmend verdichtete Formen konvergieren.","refs":["MC_GB18_L1_03:GA-12","MC_GB18_L1_02:GA-13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-10","text":"[Attractor] Höhere Einheit bewahrt ihre Unterschiede als unselbständige, genetisch wirksame Momente; eine Einheit, die Differenz tilgt, wäre erneut abstrakte Unbestimmtheit.","refs":["MC_GB18_L1_02:GA-09","MC_GB18_L1_04:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-11","text":"[Emergent] Widerspruch entsteht, wenn begrifflich voneinander abhängige Momente in der Seinsform selbständiger Einheiten erscheinen, und erzwingt die Transformation dieser Darstellungsform.","refs":["MC_GB18_L1_04:GA-10","MC_GB18_L1_04:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-12","text":"[Mutating] Das Eins mutiert von scheinbar isolierter Selbstidentität zur relationalen Produktionsstruktur, deren Ausschlussbewegung in der Repulsion gleichartige Vielheit hervorbringt.","refs":["MC_GB18_L1_04:GA-06","MC_GB18_L1_04:GA-08","MC_GB18_L1_04:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-13","text":"[Terminal] Das qualitative Fürsichsein vollendet sich nicht in ruhender Einheit, sondern durch sein Außer-sich-Treten als Vielheit und den dadurch eröffneten Übergang zur Quantität.","refs":["MC_GB18_L1_04:GA-12","MC_GB18_L1_04:AFM-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-14","text":"[Attractor] Anfang und Ergebnis bilden eine retrospektive Rechtfertigungsschleife, in der jede scheinbare Unmittelbarkeit erst durch die Rekonstruktion ihrer verdeckten Genese wissenschaftliche Geltung erhält.","refs":["MC_GB18_L1_01:AS-06","MC_GB18_L1_04:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L2_01:RMD-01","text":"[Mutation] Reines Wissen verliert seine epistemische Relationsform, erscheint als reines Seyn und wird vom vermittelten Systemresultat zur lokalen Funktion eines unbestimmten Anfangs.","refs":["MC_GB18_L1_01:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-02","text":"[Absorption] Seyn und Nichts verlieren ihre Funktion als selbständige Erste, werden im Werden zu verschwindenden Momenten und gehen nach dessen Selbstaufhebung in die Bestimmtheit des Daseyns ein.","refs":["MC_GB18_L1_02:RMD-01","MC_GB18_L1_02:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-03","text":"[Escalation] Negation bleibt funktional persistent, erweitert sich aber von abstrakter Abwesenheit zur bewahrenden Aufhebung, zur qualitativen Grenze, zur Selbstnegation und zur Produktion äußerlicher Vielheit.","refs":["MC_GB18_L1_02:GA-03","MC_GB18_L1_04:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-04","text":"[Reversal] Unmittelbarkeit kehrt valenzverkehrt wieder: Sie bezeichnet zuerst Inhaltsleere, danach das ruhige Resultat aufgehobener Bewegung und zuletzt eine ihre eigene Genese verdeckende Seinsform.","refs":["MC_GB18_L1_02:RMD-05","MC_GB18_L1_04:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-05","text":"[Displacement] Das Andere wandert vom äußeren Gegenstand in die interne Negation, wird als ideelles Moment aufgenommen und erscheint im Eins erneut als Leeres und weiteres Eins.","refs":["MC_GB18_L1_03:RMD-01","MC_GB18_L1_04:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-06","text":"[Escalation] Grenze verschiebt sich von der Konstitution qualitativer Bestimmtheit zur Schranke, zum Motor wiederholter Überschreitung und zur Maschine, die Existenz zugleich erzeugt und auflöst.","refs":["MC_GB18_L1_03:RMD-02","MC_GB18_L1_03:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-07","text":"[Terminal transformation] Unendlichkeit verliert die Form des abstrakten Jenseits und wird zur prozessualen Einheit, in der das Endliche als genetisch notwendiges, aber nicht selbständiges Moment fortbesteht.","refs":["MC_GB18_L1_03:RMD-06","MC_GB18_L1_03:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-08","text":"[Mutation] Das Eins verliert seine scheinbare Ursprünglichkeit und wird zur Produktionsstruktur einer gesetzten Äußerlichkeit, deren Wahrheit nicht isolierte Einheit, sondern gleichartige Vielheit ist.","refs":["MC_GB18_L1_04:RMD-06","MC_GB18_L1_04:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L2_01:CGD-01","text":"Die geschichtliche Krise der überlieferten Logik bleibt eine lokale Eintrittsbedingung; auf der aktuellen Ebene skaliert allein die Selbstbewegung des Inhalts als notwendige Form von Methode und Ontologie.","refs":["MC_GB18_L1_01:CGD-01","MC_GB18_L1_01:FGS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:CGD-02","text":"Seyn, Nichts, Werden, Qualität, Grenze und Endlichkeit bleiben unterscheidbare Kategorien der unteren Sequenzen; aktuell skalieren sie zu Funktionsformen einer einzigen mutierenden Negationsoperation.","refs":["MC_GB18_L1_02:CGD-03","MC_GB18_L1_02:FGS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:CGD-03","text":"Kosmologische, anthropologische und philosophiegeschichtliche Beispiele bleiben lokale Anschauungs- und Prüfkonfigurationen; global trägt nur ihre gemeinsame Diagnose äußerlicher Begrenzung und Vermittlung.","refs":["MC_GB18_L1_03:CGD-01","MC_GB18_L1_04:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:CGD-04","text":"Das Sollen bleibt eine lokale endliche Normform; auf der aktuellen Ebene skaliert seine Homologie mit dem unendlichen Progress als Wiederholungsstruktur einer nicht aufgehobenen Schranke.","refs":["MC_GB18_L1_03:CGD-03","MC_GB18_L1_03:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:CGD-05","text":"Lokale Setzungen des Fürsichseins als Abschluss werden durch die Gesamtbewegung umcodiert: Fürsichsein ist keine endgültige Subjektivität, sondern die Brücke vom Endlichen zur Produktionsform des Eins.","refs":["MC_GB18_L1_02:CGD-04","MC_GB18_L1_04:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:CGD-06","text":"Die kategoriale Detailentwicklung der Quantität liegt außerhalb der aktuellen Architektur; nach oben skaliert nur die notwendige Selbstüberschreitung der Qualität in diese neue Ordnung.","refs":["MC_GB18_L1_04:CGD-06","MC_GB18_L1_04:FL-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L2_01:GNX-01","text":"Ausgeschlossen sind jede äußerlich bereitgestellte Methode und jeder neutrale Standpunkt, der die Bewegung fertiger Bestimmungen von außerhalb erklären könnte.","refs":["MC_GB18_L1_01:GNX-01","MC_GB18_L1_01:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:GNX-02","text":"Ausgeschlossen ist ein positiv bestimmter Anfang, weil jede positive Abgrenzung bereits Differenz, Negation und Vermittlung voraussetzen würde.","refs":["MC_GB18_L1_01:GNX-02","MC_GB18_L1_01:FGS-B03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:GNX-03","text":"Ausgeschlossen sind selbständige Pole, Substanzen und Einheiten, deren Relationen erst nachträglich zu ihrem fertigen Bestand hinzuträten.","refs":["MC_GB18_L1_02:GNX-01","MC_GB18_L1_04:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:GNX-04","text":"Ausgeschlossen sind sowohl rein affirmative Realität als auch terminale Negation, weil die eine Bestimmtheit entleert und die andere als gesetzter Bestand erneut negierbar wird.","refs":["MC_GB18_L1_02:GNX-03","MC_GB18_L1_03:GNX-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:GNX-05","text":"Ausgeschlossen sind Zweiweltenmodelle und unendlicher Fortschritt als Lösungen, da beide die Gegenstellung von Endlichem und Unendlichem reproduzieren.","refs":["MC_GB18_L1_03:GNX-03","MC_GB18_L1_03:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:GNX-06","text":"Ausgeschlossen sind vorgegebene Vielheit, neutrales Leeres und äußerliche Vermittlungsinstanzen, weil Differenz und Beziehung aus der negativen Selbstbewegung selbst hervorgehen müssen.","refs":["MC_GB18_L1_04:GNX-04","MC_GB18_L1_04:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L2_01:DBN-01","text":"Damit das System Bestand hat, muss jedes irreduzibel fremde Substrat falsch sein; selbst Äußerlichkeit darf nur als erzeugte und rückholbare Form interner Negativität auftreten.","refs":["MC_GB18_L1_01:BSA-02","MC_GB18_L1_04:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:DBN-02","text":"Lineare Grundlegung und unbegrenzte Sukzession müssen unzureichend sein, weil weder der Anfang vor dem Prozess begründet noch Vermittlung durch bloßes Weitergehen ersetzt werden kann.","refs":["MC_GB18_L1_01:DBN-02","MC_GB18_L1_03:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:DBN-03","text":"Eine positive Identität vor Negation und Vermittlung muss unmöglich sein; andernfalls bliebe die gesamte Ableitung von Bestimmtheit äußerlich und nachträglich.","refs":["MC_GB18_L1_03:DBN-03","MC_GB18_L1_04:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:DBN-04","text":"Weder Endlichkeit noch Unendlichkeit dürfen letzte Selbständigkeit besitzen, weil eine endgültige Identität gegen ihre jeweilige Gegenbestimmung die Vermittlungsmaschine stillstellen würde.","refs":["MC_GB18_L1_03:DBN-01","MC_GB18_L1_03:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:DBN-05","text":"Die Seinslogik darf innerhalb qualitativer Selbstbeziehung keine endgültige reflexive Schließung erreichen; ihre eigene Vollendung muss sie in Vielheit und Quantität überführen.","refs":["MC_GB18_L1_02:DBN-05","MC_GB18_L1_04:GA-12"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L2_01:BSA-01","text":"Die tiefste Abwesenheit ist ein ruhender Ursprung vor Negation, dessen Identität keiner nachträglichen Vermittlung und keiner rückwirkenden Rekonstruktion bedürfte.","refs":["MC_GB18_L1_01:BSA-01","MC_GB18_L1_04:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:BSA-02","text":"Nicht verfügbar ist ein unassimilierbares Außen, das sich der rekursiven Bewegung entziehen und dennoch Bestimmtheit, Widerstand oder Differenz liefern könnte.","refs":["MC_GB18_L1_04:BSA-01","MC_GB18_L1_01:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:BSA-03","text":"Nicht verfügbar sind sowohl ein letztes Nichts als auch eine letzte Identität; jede terminal gesetzte Negativität oder Selbigkeit wird erneut zum Gegenstand bestimmter Negation.","refs":["MC_GB18_L1_03:BSA-03","MC_GB18_L1_03:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:BSA-04","text":"Das System organisiert sich um die nicht vollständig erreichte Möglichkeit einer Einheit, die Differenz erzeugt und erhält, ohne sie zu verselbständigen oder restlos zu assimilieren.","refs":["MC_GB18_L1_04:BSA-04","MC_GB18_L1_04:FL-04"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L2_01:XD-01","text":"Weil der Anfang aus aufgehobener Wissensvermittlung hervorgeht und Daseyn später als Resultat aufgehobener Bewegung erscheint, bezeichnet Unmittelbarkeit auf keiner Stufe die einfache Abwesenheit von Vermittlung.","refs":["MC_GB18_L2_01:GA-01","MC_GB18_L2_01:GA-04","MC_GB18_L2_01:GA-14","MC_GB18_L1_01:AS-03","MC_GB18_L1_02:GA-05","MC_GB18_L1_04:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-02","text":"Bestimmte Negation bildet eine skalierbare Produktionsoperation: Sie erzeugt zunächst Übergang und qualitative Bestimmtheit, danach immanente Grenze und zuletzt Vielheit als externalisierte Selbstbeziehung.","refs":["MC_GB18_L2_01:GA-03","MC_GB18_L2_01:GA-06","MC_GB18_L2_01:GA-07","MC_GB18_L1_01:GA-08","MC_GB18_L1_02:GA-03","MC_GB18_L1_04:RMD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-03","text":"Die innere Grenze des Endlichen erzeugt die schlechte Unendlichkeit, sobald Überschreitung die Selbständigkeit der Opposition unangetastet lässt und deshalb dieselbe Grenze rekursiv wiederherstellt.","refs":["MC_GB18_L2_01:GA-07","MC_GB18_L2_01:GA-08","MC_GB18_L1_03:GA-02","MC_GB18_L1_03:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-04","text":"Wahre Unendlichkeit entsteht, wenn nicht das Endliche getilgt, sondern die Selbständigkeit seiner Opposition zum Unendlichen negiert wird; Idealität ist der Status des bewahrten Unterschieds in dieser Einheit.","refs":["MC_GB18_L2_01:GA-08","MC_GB18_L2_01:GA-10","MC_GB18_L1_03:GA-09","MC_GB18_L1_04:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-05","text":"Die vermittelte Unendlichkeit verdichtet sich zum Fürsichsein und erscheint im Eins als abstrakte, erneut unmittelbare Seinsform derselben negationshaltigen Selbstbeziehung.","refs":["MC_GB18_L2_01:GA-09","MC_GB18_L2_01:GA-10","MC_GB18_L2_01:GA-12","MC_GB18_L1_03:GA-11","MC_GB18_L1_04:GA-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-06","text":"Das interne Nichts des Eins externalisiert sich als Leeres; der Ausschluss dieses Anderen bewahrt jedoch die Relation und mutiert durch Repulsion in die Erzeugung vieler gleicher Einsheiten.","refs":["MC_GB18_L2_01:GA-05","MC_GB18_L2_01:GA-11","MC_GB18_L2_01:GA-12","MC_GB18_L1_04:XD-03","MC_GB18_L1_04:XD-04","MC_GB18_L1_04:RMD-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-07","text":"Der Gesamtfortgang überschreitet das bloße Übergehen des Seyns in Richtung Selbstbeziehung, erreicht aber noch kein vollständig reflexives Setzen; Fürsichsein bleibt eine Übergangszone zwischen beiden Operationsregimen.","refs":["MC_GB18_L2_01:GA-09","MC_GB18_L2_01:GA-13","MC_GB18_L1_02:GA-12","MC_GB18_L1_02:CGD-06","MC_GB18_L1_03:AS-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-08","text":"Qualität schließt sich nicht durch Ruhe, sondern indem ihre negative Selbstbeziehung Vielheit hervorbringt und dadurch die kategoriale Ordnung der Quantität notwendig macht.","refs":["MC_GB18_L2_01:GA-12","MC_GB18_L2_01:GA-13","MC_GB18_L2_01:GA-14","MC_GB18_L1_04:AS-B08","MC_GB18_L1_04:AFM-B04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L2_01:BSD-01","text":"Realität erhält den Status einer rekursiven Selbstdifferenzierungsmaschine, deren Bestimmungen aus organisierter Negativität entstehen, sich verselbständigen und durch ihre Widersprüche transformiert zurückkehren.","refs":["MC_GB18_L1_03:BSD-01","MC_GB18_L1_04:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:BSD-02","text":"Das Subjekt verliert den Status einer vorausgesetzten Substanz und erscheint als unvollendeter Effekt jener Selbstbeziehung, die ihr Anderssein erzeugt, internalisiert und dennoch wirksam erhält.","refs":["MC_GB18_L1_02:BSD-05","MC_GB18_L1_04:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:BSD-03","text":"Zeit spaltet sich in zwei logische Formen: Als unendlicher Progress konserviert sie den ungelösten Gegensatz, als rekursive Nachträglichkeit lässt sie das Resultat seine eigene Voraussetzung rekonstruieren.","refs":["MC_GB18_L1_03:BSD-03","MC_GB18_L1_04:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:BSD-04","text":"Kausalität wird von äußerer Einwirkung auf negative Selbstvermittlung umgestellt; der Fortgang entsteht aus der inneren Unhaltbarkeit und Begrenzung der jeweils fixierten Bestimmung.","refs":["MC_GB18_L1_02:BSD-02","MC_GB18_L1_04:DBN-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:BSD-05","text":"Erkenntnis wird zur Rekonstruktion jener Bedingungen und Negationsoperationen, durch die vermittelte Bestimmungen als unmittelbar, selbständig oder äußerlich erscheinen.","refs":["MC_GB18_L1_03:BSD-05","MC_GB18_L1_04:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:BSD-06","text":"Freiheit und Handlungsmacht können nicht im abstrakten Hinausgehen bestehen, sondern nur in der immanenten Transformation eigener Schranken; ihre positive konkrete Gestalt bleibt jedoch unterbestimmt.","refs":["MC_GB18_L1_03:BSD-06","MC_GB18_L1_03:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L2_01:RLE-01","text":"Die Anfangsschleife lautet: Ausschluss aller Bestimmtheit → Leere → Gleichrangigkeit von Seyn und Nichts → Instabilität isolierter Identität → Werden.","refs":["MC_GB18_L1_01:AS-05","MC_GB18_L1_01:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-02","text":"Die Sedimentationsschleife lautet: Vermittlung erzeugt Unmittelbarkeit → Unmittelbarkeit verdeckt ihre Genese → ihre innere Negativität setzt Vermittlung auf höherer Stufe erneut frei.","refs":["MC_GB18_L1_02:RLE-03","MC_GB18_L1_04:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-03","text":"Die Endlichkeitsschleife lautet: Bestimmtheit → Grenze → negatives Selbstverhältnis → Sollen → Hinausgehen → Wiederkehr der Schranke.","refs":["MC_GB18_L1_03:RLE-01","MC_GB18_L1_03:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-04","text":"Die schlechte Unendlichkeit eskaliert, bis die Wiederkehr der Grenze nicht mehr als Aufforderung zum Weitergehen, sondern als Beweis der Endlichkeit des abstrakten Unendlichen gelesen wird.","refs":["MC_GB18_L1_03:RLE-03","MC_GB18_L1_03:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-05","text":"Die Negation der Negation ist die Korrekturschleife, welche nicht erneut das Andere ausschließt, sondern die Selbständigkeit der Opposition negiert und so vermittelte Affirmation erzeugt.","refs":["MC_GB18_L1_03:RLE-05","MC_GB18_L1_03:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-06","text":"Die Repulsionsschleife lautet: Eins → internes Nichts → Leeres → Ausschluss → fortbestehende Relation → viele Einsheiten → Widerspruch der äußerlichen Vielheit.","refs":["MC_GB18_L1_04:RLE-02","MC_GB18_L1_04:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-07","text":"Idealität ist der übergreifende Attraktor, während Anfang und Totalität eine Rechtfertigungsschleife bilden: Jede isolierte Form wird auf die immanente Vermittlung zurückgeführt, die sie verdeckt.","refs":["MC_GB18_L1_01:RLE-04","MC_GB18_L1_04:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L2_01:FGS-B01","text":"Ausschluss äußerlicher Methode + Forderung immanenter Notwendigkeit → Selbstbewegung des Inhalts als einzig zulässige Erzeugungsform.","refs":["MC_GB18_L1_01:GA-01","MC_GB18_L1_01:FGS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B02","text":"Vermitteltes reines Wissen → Verlust seiner Wissensform → reine Unmittelbarkeit → Seyn ohne positive Bestimmung → Nichts.","refs":["MC_GB18_L1_01:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B03","text":"Gleichrangigkeit von Seyn und Nichts + Unmöglichkeit ihrer isolierten Selbständigkeit → Übergang → Werden → Aufhebung des Verschwindens.","refs":["MC_GB18_L1_01:GA-05","MC_GB18_L1_01:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B04","text":"Aufgehobenes Werden → resultative Unmittelbarkeit des Daseyns → Qualität als Einheit von Realität und Negation → Etwas und Anderes → Grenze.","refs":["MC_GB18_L1_02:XD-01","MC_GB18_L1_02:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B05","text":"Immanente Grenze → Endlichkeit → Schranke und Sollen → abstraktes Hinausgehen → unendlicher Progress als Reproduktion der Opposition.","refs":["MC_GB18_L1_03:FGS-B02","MC_GB18_L1_03:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B06","text":"Einsicht in die wechselseitige Abhängigkeit der Opposition → Negation ihrer Selbständigkeit → Idealität → affirmative Unendlichkeit → Fürsichsein.","refs":["MC_GB18_L1_03:FGS-B06","MC_GB18_L1_03:FGS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B07","text":"Fürsichsein → Eins → internes Nichts → Leeres → Ausschluss → Repulsion → viele gleiche Einsheiten → äußerliche Vielheit.","refs":["MC_GB18_L1_04:FGS-B03","MC_GB18_L1_04:FGS-B04","MC_GB18_L1_04:XD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B08","text":"Äußerliche Vielheit + gemeinsame Herkunft der Einsheiten → Widerspruch qualitativer Selbständigkeit → Außer-sich-Sein des Fürsichseins → Übergang zur Quantität.","refs":["MC_GB18_L1_04:GA-10","MC_GB18_L1_04:FGS-B08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L2_01:AFM-B01","text":"Entleerung epistemischer Relation → reines Seyn → Nichts → Werden → resultative Unmittelbarkeit.","refs":["MC_GB18_L1_01:FGS-B02","MC_GB18_L1_01:AFM-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AFM-B02","text":"Daseyn → Qualität → Negation → Etwas und Anderes → Grenze → Endlichkeit.","refs":["MC_GB18_L1_02:XD-03","MC_GB18_L1_02:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AFM-B03","text":"Endlichkeit → Schranke → Sollen → Hinausgehen → Wiederkehr der Grenze → schlechte Unendlichkeit.","refs":["MC_GB18_L1_03:RLE-02","MC_GB18_L1_03:AFM-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AFM-B04","text":"Negation der selbständigen Gegenstellung → Idealität → affirmative Unendlichkeit → Fürsichsein → Eins → Leeres → Repulsion → Vielheit.","refs":["MC_GB18_L1_03:RLE-06","MC_GB18_L1_04:XD-03","MC_GB18_L1_04:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AFM-B05","text":"Widerspruch äußerlicher Vielheit → Erschöpfung qualitativer Selbstbeziehung → Übergang zur Quantität → offene Fortsetzung der kategorialen Entwicklung.","refs":["MC_GB18_L1_04:BSD-07","MC_GB18_L1_04:AFM-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L2_01:MME-01","text":"Unmittelbarkeit und Vermittlung bilden keine ausschließenden Zustände mehr; Unmittelbarkeit wird als verdichtete, ihre Genese verdeckende Vermittlung lesbar.","refs":["MC_GB18_L1_01:MME-03","MC_GB18_L1_04:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-02","text":"Identität und Differenz verlieren den Status unabhängiger Prinzipien; Identität gilt nur noch als vermittelte Rückkehr aus intern wirksamer Andersheit.","refs":["MC_GB18_L1_02:MME-01","MC_GB18_L1_04:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-03","text":"Negation und Widerspruch werden von Defektformen zu Produktionsmechanismen umkartiert, die Bestimmtheit erzeugen und abstrakte Seinsformen in neue Ordnungen überführen.","refs":["MC_GB18_L1_01:MME-04","MC_GB18_L1_04:MP-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-04","text":"Innen und Außen werden als Funktionen eines Vermittlungsgrades reklassifiziert; Äußerlichkeit erscheint als verselbständigte Darstellung intern erzeugter Differenz.","refs":["MC_GB18_L1_03:MME-01","MC_GB18_L1_04:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-05","text":"Endliches und Unendliches werden von getrennten Seinsregionen zu genetisch abhängigen Momenten einer Selbstvermittlung umkartiert.","refs":["MC_GB18_L1_03:MME-03","MC_GB18_L1_03:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-06","text":"Eins und Viele verlieren den Status konkurrierender Grundbestände; Vielheit wird als problematische Selbstexternalisierung der Einsform rekonstruiert.","refs":["MC_GB18_L1_04:MME-03","MC_GB18_L1_04:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-07","text":"Qualität und Quantität erscheinen nicht als äußerlich benachbarte Bereiche; Quantität wird als terminaler Effekt der qualitativen Selbstüberschreitung kartiert.","refs":["MC_GB18_L1_04:MME-07","MC_GB18_L1_04:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L2_01:ALT-B01","text":"Auf der Surface level bilden Seyn, Nichts, Werden, Daseyn, Grenze, Endlichkeit, Unendlichkeit, Fürsichsein, Eins, Leeres, Repulsion und Vielheit die explizite Kategoriebewegung.","refs":["MC_GB18_L1_02:ALT-B01","MC_GB18_L1_04:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:ALT-B02","text":"Auf der Structural level erzeugt eine rekursive Maschine aus Ausschluss, bestimmter Negation, Grenzbildung, Aufhebung und Selbstexternalisierung zunehmend komplexe Formen von Selbstbeziehung.","refs":["MC_GB18_L1_03:ALT-B02","MC_GB18_L1_04:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:ALT-B03","text":"Auf der Metastrategic level ersetzt immanente Rekonstruktion die Wahl zwischen fixierten Gegensätzen und prüft Theorien danach, ob sie Differenz aus ihrem eigenen Grund erzeugen können.","refs":["MC_GB18_L1_02:ALT-B03","MC_GB18_L1_04:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:ALT-B04","text":"Auf der Ontological / Temporal level ist Realität gestufte Selbstentäußerung; Zeit erscheint als schlechte Wiederholung oder als rückwirkende Freilegung aufgehobener Genese.","refs":["MC_GB18_L1_03:ALT-B04","MC_GB18_L1_04:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:ALT-B05","text":"Auf der Methodological / Performative level setzt die Darstellung Begriffe probeweise fest, aktiviert ihren immanenten Gegensatz und führt sie durch Gegenbewegung in ihre verleugnete Vermittlung zurück.","refs":["MC_GB18_L1_02:ALT-B05","MC_GB18_L1_04:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L2_01:FL-01","text":"Die Ununterscheidbarkeit von Seyn und Nichts begründet ihre Gleichrangigkeit, sichert aber nicht vollständig, weshalb sie notwendig in Bewegung statt in formaler Identität übergeht.","refs":["MC_GB18_L1_01:FL-03","MC_GB18_L1_01:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:FL-02","text":"Der erste Übergang soll unmittelbar sein, wird jedoch durch reflektierte Bestimmungen von Unbestimmtheit und Negativität nachgewiesen; Vollzug und Darstellung bleiben nicht deckungsgleich.","refs":["MC_GB18_L1_02:FL-01","MC_GB18_L1_01:FL-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:FL-03","text":"Vermittlung wirkt bereits konstitutiv, obwohl die Sphäre des Seyns sie noch nicht als gesetzte Vermittlung ausweisen darf; die Architektur operiert mit einer Form, deren Status sie erst später erklären kann.","refs":["MC_GB18_L1_02:FL-04","MC_GB18_L1_02:XD-08"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:FL-04","text":"Der Umschlag vom unendlichen Progress zur affirmativen Unendlichkeit ist strukturell gefordert, aber nicht vollständig gegen einen bloßen Abbruch der Wiederholung abgesichert.","refs":["MC_GB18_L1_03:FL-03","MC_GB18_L1_03:MRT-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:FL-05","text":"Das System verbietet endgültige Außenheit und muss sie zugleich als Leeres, Dasein und Vielheit erzeugen; Äußerlichkeit ist daher notwendige Produktionsform und zu überwindender Vermittlungsmangel zugleich.","refs":["MC_GB18_L1_04:FL-01","MC_GB18_L1_04:MRT-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:FL-06","text":"Idealität fungiert als Maßstab vollendeter Immanenz, obwohl ihre positive Transformation der Repulsion nicht demonstriert wird und die Bewegung stattdessen in Quantität übergeht.","refs":["MC_GB18_L1_04:FL-04","MC_GB18_L1_04:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:MP-01","text":"Reines Wissen mutiert zu reinem Seyn, sobald seine relationale Wissensform erlischt und nur die Funktion unbestimmter Unmittelbarkeit verbleibt.","refs":["MC_GB18_L1_01:MP-01","MC_GB18_L1_01:XD-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:MP-02","text":"Unmittelbarkeit mutiert vom leeren Ausgang zur resultativen Ruhe aufgehobener Bewegung und danach zur abstrakten Erscheinungsform einer erneut verdeckten Genese.","refs":["MC_GB18_L1_02:MP-03","MC_GB18_L1_04:MP-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L2_01:MP-03","text":"Negation mutiert vom abstrakten Gegenpol des Seyns zur qualitativen Realität, zur Selbstnegation der Opposition und zur Repulsion als äußerer Produktion.","refs":["MC_GB18_L1_02:MP-04","MC_GB18_L1_03:MP-03","MC_GB18_L1_04:RMD-03"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L2_01:MP-04","text":"Grenze mutiert zur Schranke, sobald ihre konstitutive Negativität das Endliche über seine unmittelbare Gestalt hinaustreibt und damit die Wiederholung der Grenze erzeugt.","refs":["MC_GB18_L1_03:MP-02","MC_GB18_L1_03:RMD-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L2_01:MP-05","text":"Unendlichkeit mutiert vom abstrakten Jenseits zur prozessualen Einheit, indem die Selbständigkeit des Endlichen aufgehoben, seine genetische Funktion aber erhalten wird.","refs":["MC_GB18_L1_03:RMD-06","MC_GB18_L1_03:MRT-B02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L2_01:MP-06","text":"Das Eins mutiert von abstrakter Selbstidentität zur Produktionsstruktur, sobald sein Ausschluss des Anderen als fortdauernde Relation und schließlich als Repulsion lesbar wird.","refs":["MC_GB18_L1_04:RMD-06","MC_GB18_L1_04:MP-04"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L2_01:HSI-01","text":"Realität erscheint als rekursive Maschine negativer Selbstunterscheidung, die Unterschiede erzeugt, verselbständigt, an ihrem Widerspruch transformiert und als Momente reicheren Zusammenhangs zurücknimmt.","refs":["MC_GB18_L1_04:HSI-01","MC_GB18_L1_01:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:HSI-02","text":"Das Subjekt ist weder souveräner Ursprung noch atomare Substanz, sondern ein relationaler Knoten und möglicher Effekt der Aneignung von Andersheit und Grenze.","refs":["MC_GB18_L1_01:HSI-02","MC_GB18_L1_04:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:HSI-03","text":"Zeit ist eine rückläufige Spirale: Lineare Wiederholung konserviert ungelöste Grenzen, während Resultate ihre Produktion verdecken und den Anfang nachträglich als bereits vermittelt enthüllen.","refs":["MC_GB18_L1_03:HSI-03","MC_GB18_L1_04:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:HSI-04","text":"Kampf und Navigation bestehen darin, äußerliche Vermittlungen und abstrakte Jenseitsmodelle zurückzuweisen, ohne Andersheit zu vernichten; möglich bleibt nur ihre Transformation in immanente Relation.","refs":["MC_GB18_L1_04:HSI-04","MC_GB18_L1_02:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L2_01:MRT-B01","text":"Die Architektur ist rekonstruierbar, wenn sie entleerten Anfang, Werden, resultative Unmittelbarkeit, bestimmte Negation, Grenze, schlechte und wahre Unendlichkeit, Idealität, Fürsichsein, Repulsion und Vielheit bewahrt.","refs":["MC_GB18_L1_02:MRT-B01","MC_GB18_L1_04:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MRT-B02","text":"Das System bleibt kohärent, sofern keine Unmittelbarkeit als vermittlungslos, keine Negation als bloße Vernichtung und keine Äußerlichkeit als ursprüngliche Gegebenheit behandelt wird.","refs":["MC_GB18_L1_02:MRT-B03","MC_GB18_L1_04:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MRT-B03","text":"Unterbestimmt bleiben die Notwendigkeit des ersten Übergangs, der Umschlag vom unendlichen Progress zur Affirmation und die genaue Externalisierung interner Negation als Leeres und Vielheit.","refs":["MC_GB18_L1_01:MRT-B02","MC_GB18_L1_03:MRT-B04","MC_GB18_L1_04:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MRT-B04","text":"Die stärkste Systemleistung liegt in der durchgängigen Mutation einer Negationsfunktion, die aus Leere Übergang, aus Übergang Bestimmtheit, aus Grenze Selbstbeziehung und aus Selbstbeziehung Vielheit erzeugt.","refs":["MC_GB18_L1_02:MRT-B04","MC_GB18_L1_04:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MRT-B05","text":"Die Rekonstruktion hängt unverzichtbar von Sequenzierung, rekursiver Rückkehr, rückwirkender Begründung und performativer Begriffsmutation ab; eine statische Axiomliste könnte die Bewegung nicht ersetzen.","refs":["MC_GB18_L1_01:MRT-B05","MC_GB18_L1_03:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MRT-B06","text":"Vollständiger axiomatischer Reduktion widersteht die Doppelstellung der Äußerlichkeit: Sie muss erzeugt werden, als selbständig erscheinen und zugleich in die Selbstbeziehung zurückgenommen werden, damit der Übergang zur Quantität möglich wird.","refs":["MC_GB18_L1_04:MRT-B04","MC_GB18_L1_04:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T124224987962Z_383c2a04","language_code":"en","language_name":"English","title":"Gb18 L2 01","source_sha256":"949fa028dcebb423cc0d5534f2ab1b9b5fc4fd6bac2ce2ce5c6fdc9df5a146d4","sha256":"fba0f840a1296c480596b724ef2fad274d0ab25ba81cce10dbac7e48b0f10f41","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:42:24.990102+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L2_01:AS-01","text":"The system must generate qualitative determinacy, finitude, infinity, and multiplicity from an indeterminate beginning, without presupposing difference, relation, or movement as independent facts.","refs":["MC_GB18_L1_01:AS-01","MC_GB18_L1_04:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-02","text":"Its global thesis determines negation as a generative and preserving operation through which finite determinations lose their independence and persist as effective moments of immanent unity.","refs":["MC_GB18_L1_02:AS-02","MC_GB18_L1_04:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-03","text":"The argument becomes an immanent-dialectical ontology in which every determination is destabilized by its excluded condition and transferred into a more complex operational regime.","refs":["MC_GB18_L1_02:AS-03","MC_GB18_L1_04:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-04","text":"The first movement leads from emptied pure knowing through Seyn, Nothing, and Becoming to the resultant immediacy of Daseyn and to the unfolding of qualitative negativity.","refs":["MC_GB18_L1_02:AS-01","MC_GB18_L1_02:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-05","text":"The qualitative movement escalates from limit and finitude through ought and bad infinity to the sublation of the independent opposition of finite and infinite.","refs":["MC_GB18_L1_03:AS-03","MC_GB18_L1_03:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-06","text":"Mediated infinity condenses into being-for-self and into the One, whose negative self-relation generates multiplicity through the void and repulsion.","refs":["MC_GB18_L1_04:AS-B05","MC_GB18_L1_04:AS-B06","MC_GB18_L1_04:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-07","text":"The movement is apophatic, recursive, spiral-shaped, and mutation-driven: every exclusion generates the excluded anew as the internal condition of a richer form.","refs":["MC_GB18_L1_01:AS-05","MC_GB18_L1_03:AS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AS-08","text":"The closure is retrospective and open: the developed qualitative totality legitimates its beginning, but completes itself only through its transition into the not-yet-developed order of quantity.","refs":["MC_GB18_L1_04:AS-B08","MC_GB18_L1_01:GA-11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L2_01:GA-01","text":"[Persistent] Scientific and ontological necessity may arise only from the self-movement of the content; an externally applied method could merely assert transitions.","refs":["MC_GB18_L1_01:GA-01","MC_GB18_L1_02:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-02","text":"[Persistent] No determination possesses isolated independence, because its identity arises and persists only through relation to that which differs from it.","refs":["MC_GB18_L1_01:GA-07","MC_GB18_L1_02:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-03","text":"[Mutating] Negation mutates from abstract Nothing through transition, sublation, quality, and limit into the self-negation of opposition and finally into repulsion as the generation of multiplicity.","refs":["MC_GB18_L1_01:GA-08","MC_GB18_L1_02:GA-03","MC_GB18_L1_04:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-04","text":"[Mutating] Immediacy mutates from the contentless beginning into the condensed form of appearance of sublated mediation and further into the abstract form of being of negative self-relation.","refs":["MC_GB18_L1_01:GA-10","MC_GB18_L1_02:GA-05","MC_GB18_L1_04:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-05","text":"[Persistent] Otherness is not an external addition to identity, but the internal moment through whose sublation self-relation acquires generative force at all.","refs":["MC_GB18_L1_03:GA-01","MC_GB18_L1_04:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-06","text":"[Emergent] Reality and determinacy are possible only as organized negativity; pure positivity either falls back into indeterminacy or turns into contradictory overfullness.","refs":["MC_GB18_L1_02:GA-06","MC_GB18_L1_03:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-07","text":"[Mutating] Limit mutates from qualitative constitution into internal finitude, into the barrier of repeated transcendence, and finally into ideal difference within mediated unity.","refs":["MC_GB18_L1_03:GA-02","MC_GB18_L1_02:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-08","text":"[Emergent] Bad infinity is not an approach to a beyond, but the recursive restoration of a limit whose abstract transcendence leaves its opposition untouched.","refs":["MC_GB18_L1_03:GA-07","MC_GB18_L1_03:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-09","text":"[Attractor] Self-relation is the global attractor toward which Becoming, limit, finitude, ideality, being-for-self, One, and repulsion converge as increasingly condensed forms.","refs":["MC_GB18_L1_03:GA-12","MC_GB18_L1_02:GA-13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-10","text":"[Attractor] Higher unity preserves its differences as non-independent, genetically effective moments; a unity that erases difference would again be abstract indeterminacy.","refs":["MC_GB18_L1_02:GA-09","MC_GB18_L1_04:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-11","text":"[Emergent] Contradiction arises when conceptually interdependent moments appear in the form of being of independent unities, and compels the transformation of this form of presentation.","refs":["MC_GB18_L1_04:GA-10","MC_GB18_L1_04:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-12","text":"[Mutating] The One mutates from seemingly isolated self-identity into a relational structure of production whose movement of exclusion produces homogeneous multiplicity in repulsion.","refs":["MC_GB18_L1_04:GA-06","MC_GB18_L1_04:GA-08","MC_GB18_L1_04:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-13","text":"[Terminal] Qualitative being-for-self completes itself not in resting unity, but through its stepping-outside-itself as multiplicity and the transition to quantity thereby opened.","refs":["MC_GB18_L1_04:GA-12","MC_GB18_L1_04:AFM-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:GA-14","text":"[Attractor] Beginning and result form a retrospective loop of justification in which every apparent immediacy acquires scientific validity only through the reconstruction of its concealed genesis.","refs":["MC_GB18_L1_01:AS-06","MC_GB18_L1_04:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L2_01:RMD-01","text":"[Mutation] Pure knowing loses its epistemic relational form, appears as pure Seyn, and changes from a mediated system-result into the local function of an indeterminate beginning.","refs":["MC_GB18_L1_01:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-02","text":"[Absorption] Seyn and Nothing lose their function as independent firsts, become vanishing moments in Becoming, and enter into the determinacy of Daseyn after its self-sublation.","refs":["MC_GB18_L1_02:RMD-01","MC_GB18_L1_02:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-03","text":"[Escalation] Negation remains functionally persistent, but expands from abstract absence to preserving sublation, to qualitative limit, to self-negation, and to the production of external multiplicity.","refs":["MC_GB18_L1_02:GA-03","MC_GB18_L1_04:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-04","text":"[Reversal] Immediacy recurs with reversed valence: it first denotes emptiness of content, then the tranquil result of sublated movement, and finally a form of being that conceals its own genesis.","refs":["MC_GB18_L1_02:RMD-05","MC_GB18_L1_04:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-05","text":"[Displacement] The Other migrates from the external object into internal negation, is taken up as an ideal moment, and reappears in the One as void and further One.","refs":["MC_GB18_L1_03:RMD-01","MC_GB18_L1_04:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-06","text":"[Escalation] Limit shifts from the constitution of qualitative determinacy to barrier, to the motor of repeated transcendence, and to the machine that simultaneously generates and dissolves existence.","refs":["MC_GB18_L1_03:RMD-02","MC_GB18_L1_03:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-07","text":"[Terminal transformation] Infinity loses the form of the abstract beyond and becomes the processual unity in which the finite persists as a genetically necessary but non-independent moment.","refs":["MC_GB18_L1_03:RMD-06","MC_GB18_L1_03:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RMD-08","text":"[Mutation] The One loses its apparent originality and becomes the productive structure of a posited externality whose truth is not isolated unity but homogeneous multiplicity.","refs":["MC_GB18_L1_04:RMD-06","MC_GB18_L1_04:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L2_01:CGD-01","text":"The historical crisis of inherited logic remains a local entry condition; at the current level, only the self-movement of content scales as the necessary form of method and ontology.","refs":["MC_GB18_L1_01:CGD-01","MC_GB18_L1_01:FGS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:CGD-02","text":"Seyn, Nothing, Becoming, quality, limit, and finitude remain distinguishable categories of the lower sequences; currently, they scale into functional forms of a single mutating operation of negation.","refs":["MC_GB18_L1_02:CGD-03","MC_GB18_L1_02:FGS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:CGD-03","text":"Cosmological, anthropological, and history-of-philosophy examples remain local configurations of intuition and testing; globally, only their shared diagnosis of external limitation and mediation bears weight.","refs":["MC_GB18_L1_03:CGD-01","MC_GB18_L1_04:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:CGD-04","text":"The ought remains a local finite normative form; at the current level, its homology with infinite progress scales as the structure of repetition of a barrier not sublated.","refs":["MC_GB18_L1_03:CGD-03","MC_GB18_L1_03:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:CGD-05","text":"Local positings of being-for-self as closure are recoded by the total movement: being-for-self is not final subjectivity, but the bridge from the finite to the productive form of the One.","refs":["MC_GB18_L1_02:CGD-04","MC_GB18_L1_04:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:CGD-06","text":"The categorical detailed development of quantity lies outside the current architecture; only the necessary self-transcendence of quality into this new order scales upward.","refs":["MC_GB18_L1_04:CGD-06","MC_GB18_L1_04:FL-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L2_01:GNX-01","text":"Excluded are every externally supplied method and every neutral standpoint that could explain the movement of finished determinations from outside.","refs":["MC_GB18_L1_01:GNX-01","MC_GB18_L1_01:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:GNX-02","text":"Excluded is a positively determined beginning, because every positive delimitation would already presuppose difference, negation, and mediation.","refs":["MC_GB18_L1_01:GNX-02","MC_GB18_L1_01:FGS-B03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:GNX-03","text":"Excluded are independent poles, substances, and unities whose relations would be added only subsequently to their finished stock.","refs":["MC_GB18_L1_02:GNX-01","MC_GB18_L1_04:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:GNX-04","text":"Excluded are both purely affirmative reality and terminal negation, because the former empties determinacy and the latter, as posited stock, becomes negatable anew.","refs":["MC_GB18_L1_02:GNX-03","MC_GB18_L1_03:GNX-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:GNX-05","text":"Excluded are two-world models and infinite progress as solutions, since both reproduce the opposition of finite and infinite.","refs":["MC_GB18_L1_03:GNX-03","MC_GB18_L1_03:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:GNX-06","text":"Excluded are given multiplicity, neutral void, and external instances of mediation, because difference and relation must arise from negative self-movement itself.","refs":["MC_GB18_L1_04:GNX-04","MC_GB18_L1_04:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L2_01:DBN-01","text":"For the system to hold, every irreducibly alien substrate must be false; even externality may appear only as a generated and retrievable form of internal negativity.","refs":["MC_GB18_L1_01:BSA-02","MC_GB18_L1_04:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:DBN-02","text":"Linear grounding and unlimited succession must be insufficient, because neither can the beginning be grounded prior to the process nor can mediation be replaced by mere continuation.","refs":["MC_GB18_L1_01:DBN-02","MC_GB18_L1_03:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:DBN-03","text":"A positive identity prior to negation and mediation must be impossible; otherwise the entire derivation of determinacy would remain external and subsequent.","refs":["MC_GB18_L1_03:DBN-03","MC_GB18_L1_04:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:DBN-04","text":"Neither finitude nor infinity may possess final independence, because a definitive identity against its respective counter-determination would halt the machine of mediation.","refs":["MC_GB18_L1_03:DBN-01","MC_GB18_L1_03:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:DBN-05","text":"The logic of being may not attain final reflexive closure within qualitative self-relation; its own completion must carry it over into multiplicity and quantity.","refs":["MC_GB18_L1_02:DBN-05","MC_GB18_L1_04:GA-12"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L2_01:BSA-01","text":"The deepest absence is a resting origin prior to negation, whose identity would require neither subsequent mediation nor retrospective reconstruction.","refs":["MC_GB18_L1_01:BSA-01","MC_GB18_L1_04:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:BSA-02","text":"Unavailable is an unassimilable outside that could evade recursive movement and nevertheless supply determinacy, resistance, or difference.","refs":["MC_GB18_L1_04:BSA-01","MC_GB18_L1_01:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:BSA-03","text":"Unavailable are both a final Nothing and a final identity; every terminally posited negativity or sameness becomes anew the object of determinate negation.","refs":["MC_GB18_L1_03:BSA-03","MC_GB18_L1_03:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_01:BSA-04","text":"The system organizes itself around the not fully attained possibility of a unity that generates and preserves difference without rendering it independent or completely assimilating it.","refs":["MC_GB18_L1_04:BSA-04","MC_GB18_L1_04:FL-04"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L2_01:XD-01","text":"Because the beginning proceeds from sublated mediation of knowing and Daseyn later appears as the result of sublated movement, immediacy at no stage denotes the simple absence of mediation.","refs":["MC_GB18_L2_01:GA-01","MC_GB18_L2_01:GA-04","MC_GB18_L2_01:GA-14","MC_GB18_L1_01:AS-03","MC_GB18_L1_02:GA-05","MC_GB18_L1_04:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-02","text":"Determinate negation forms a scalable productive operation: it first generates transition and qualitative determinacy, then immanent limit, and finally multiplicity as externalized self-relation.","refs":["MC_GB18_L2_01:GA-03","MC_GB18_L2_01:GA-06","MC_GB18_L2_01:GA-07","MC_GB18_L1_01:GA-08","MC_GB18_L1_02:GA-03","MC_GB18_L1_04:RMD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-03","text":"The internal limit of the finite generates bad infinity as soon as transcendence leaves the independence of the opposition untouched and therefore recursively restores the same limit.","refs":["MC_GB18_L2_01:GA-07","MC_GB18_L2_01:GA-08","MC_GB18_L1_03:GA-02","MC_GB18_L1_03:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-04","text":"True infinity arises when not the finite is erased, but the independence of its opposition to the infinite is negated; ideality is the status of preserved difference in this unity.","refs":["MC_GB18_L2_01:GA-08","MC_GB18_L2_01:GA-10","MC_GB18_L1_03:GA-09","MC_GB18_L1_04:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-05","text":"Mediated infinity condenses into being-for-self and appears in the One as the abstract, again immediate form of being of the same self-relation containing negation.","refs":["MC_GB18_L2_01:GA-09","MC_GB18_L2_01:GA-10","MC_GB18_L2_01:GA-12","MC_GB18_L1_03:GA-11","MC_GB18_L1_04:GA-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-06","text":"The internal Nothing of the One externalizes itself as void; yet the exclusion of this Other preserves the relation and mutates through repulsion into the generation of many identical unities.","refs":["MC_GB18_L2_01:GA-05","MC_GB18_L2_01:GA-11","MC_GB18_L2_01:GA-12","MC_GB18_L1_04:XD-03","MC_GB18_L1_04:XD-04","MC_GB18_L1_04:RMD-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-07","text":"The overall progression goes beyond the mere transition of Seyn in the direction of self-relation, but does not yet attain a fully reflexive positing; being-for-self remains a transitional zone between both operational regimes.","refs":["MC_GB18_L2_01:GA-09","MC_GB18_L2_01:GA-13","MC_GB18_L1_02:GA-12","MC_GB18_L1_02:CGD-06","MC_GB18_L1_03:AS-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_01:XD-08","text":"Quality closes not through rest, but by its negative self-relation generating multiplicity and thereby making the categorical order of quantity necessary.","refs":["MC_GB18_L2_01:GA-12","MC_GB18_L2_01:GA-13","MC_GB18_L2_01:GA-14","MC_GB18_L1_04:AS-B08","MC_GB18_L1_04:AFM-B04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L2_01:BSD-01","text":"Reality acquires the status of a recursive machine of self-differentiation whose determinations arise from organized negativity, render themselves independent, and return transformed through their contradictions.","refs":["MC_GB18_L1_03:BSD-01","MC_GB18_L1_04:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:BSD-02","text":"The subject loses the status of a presupposed substance and appears as an unfinished effect of that self-relation which generates, internalizes, and nevertheless preserves its otherness as effective.","refs":["MC_GB18_L1_02:BSD-05","MC_GB18_L1_04:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:BSD-03","text":"Time splits into two logical forms: as infinite progress, it conserves the unresolved opposition; as recursive belatedness, it allows the result to reconstruct its own presupposition.","refs":["MC_GB18_L1_03:BSD-03","MC_GB18_L1_04:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:BSD-04","text":"Causality is shifted from external influence to negative self-mediation; progression arises from the internal untenability and limitation of each fixed determination.","refs":["MC_GB18_L1_02:BSD-02","MC_GB18_L1_04:DBN-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:BSD-05","text":"Cognition becomes the reconstruction of those conditions and operations of negation through which mediated determinations appear as immediate, independent, or external.","refs":["MC_GB18_L1_03:BSD-05","MC_GB18_L1_04:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:BSD-06","text":"Freedom and agency cannot consist in abstract going-beyond, but only in the immanent transformation of their own barriers; their positive concrete shape, however, remains underdetermined.","refs":["MC_GB18_L1_03:BSD-06","MC_GB18_L1_03:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L2_01:RLE-01","text":"The beginning loop is: exclusion of all determinacy → void → equivalence of Seyn and Nothing → instability of isolated identity → Becoming.","refs":["MC_GB18_L1_01:AS-05","MC_GB18_L1_01:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-02","text":"The sedimentation loop is: mediation generates immediacy → immediacy conceals its genesis → its internal negativity releases mediation anew at a higher level.","refs":["MC_GB18_L1_02:RLE-03","MC_GB18_L1_04:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-03","text":"The finitude loop is: determinacy → limit → negative self-relation → ought → going-beyond → return of the barrier.","refs":["MC_GB18_L1_03:RLE-01","MC_GB18_L1_03:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-04","text":"Bad infinity escalates until the return of the limit is read no longer as an injunction to continue, but as proof of the finitude of abstract infinity.","refs":["MC_GB18_L1_03:RLE-03","MC_GB18_L1_03:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-05","text":"The negation of negation is the corrective loop that does not again exclude the Other, but negates the independence of the opposition and thus generates mediated affirmation.","refs":["MC_GB18_L1_03:RLE-05","MC_GB18_L1_03:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-06","text":"The repulsion loop is: One → internal Nothing → void → exclusion → persisting relation → many unities → contradiction of external multiplicity.","refs":["MC_GB18_L1_04:RLE-02","MC_GB18_L1_04:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:RLE-07","text":"Ideality is the overarching attractor, while beginning and totality form a loop of justification: every isolated form is led back to the immanent mediation that it conceals.","refs":["MC_GB18_L1_01:RLE-04","MC_GB18_L1_04:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L2_01:FGS-B01","text":"Exclusion of external method + demand for immanent necessity → self-movement of content as the sole permissible form of generation.","refs":["MC_GB18_L1_01:GA-01","MC_GB18_L1_01:FGS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B02","text":"Mediated pure knowing → loss of its form of knowing → pure immediacy → Seyn without positive determination → Nothing.","refs":["MC_GB18_L1_01:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B03","text":"Equivalence of Seyn and Nothing + impossibility of their isolated independence → transition → Becoming → sublation of vanishing.","refs":["MC_GB18_L1_01:GA-05","MC_GB18_L1_01:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B04","text":"Sublated Becoming → resultant immediacy of Daseyn → quality as unity of reality and negation → Something and Other → limit.","refs":["MC_GB18_L1_02:XD-01","MC_GB18_L1_02:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B05","text":"Immanent limit → finitude → barrier and ought → abstract going-beyond → infinite progress as reproduction of opposition.","refs":["MC_GB18_L1_03:FGS-B02","MC_GB18_L1_03:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B06","text":"Insight into the reciprocal dependence of the opposition → negation of its independence → ideality → affirmative infinity → being-for-self.","refs":["MC_GB18_L1_03:FGS-B06","MC_GB18_L1_03:FGS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B07","text":"Being-for-self → One → internal Nothing → void → exclusion → repulsion → many identical unities → external multiplicity.","refs":["MC_GB18_L1_04:FGS-B03","MC_GB18_L1_04:FGS-B04","MC_GB18_L1_04:XD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:FGS-B08","text":"External multiplicity + common origin of the unities → contradiction of qualitative independence → being-outside-itself of being-for-self → transition to quantity.","refs":["MC_GB18_L1_04:GA-10","MC_GB18_L1_04:FGS-B08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L2_01:AFM-B01","text":"Emptying of epistemic relation → pure Seyn → Nothing → Becoming → resultant immediacy.","refs":["MC_GB18_L1_01:FGS-B02","MC_GB18_L1_01:AFM-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AFM-B02","text":"Daseyn → quality → negation → Something and Other → limit → finitude.","refs":["MC_GB18_L1_02:XD-03","MC_GB18_L1_02:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AFM-B03","text":"Finitude → barrier → ought → going-beyond → return of the limit → bad infinity.","refs":["MC_GB18_L1_03:RLE-02","MC_GB18_L1_03:AFM-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AFM-B04","text":"Negation of the independent opposition → ideality → affirmative infinity → being-for-self → One → void → repulsion → multiplicity.","refs":["MC_GB18_L1_03:RLE-06","MC_GB18_L1_04:XD-03","MC_GB18_L1_04:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:AFM-B05","text":"Contradiction of external multiplicity → exhaustion of qualitative self-relation → transition to quantity → open continuation of categorical development.","refs":["MC_GB18_L1_04:BSD-07","MC_GB18_L1_04:AFM-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L2_01:MME-01","text":"Immediacy and mediation no longer form exclusive states; immediacy becomes legible as condensed mediation concealing its genesis.","refs":["MC_GB18_L1_01:MME-03","MC_GB18_L1_04:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-02","text":"Identity and difference lose the status of independent principles; identity is valid only as mediated return from internally effective otherness.","refs":["MC_GB18_L1_02:MME-01","MC_GB18_L1_04:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-03","text":"Negation and contradiction are remapped from defective forms into productive mechanisms that generate determinacy and transfer abstract forms of being into new orders.","refs":["MC_GB18_L1_01:MME-04","MC_GB18_L1_04:MP-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-04","text":"Inside and outside are reclassified as functions of a degree of mediation; externality appears as an independent presentation of internally generated difference.","refs":["MC_GB18_L1_03:MME-01","MC_GB18_L1_04:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-05","text":"Finite and infinite are remapped from separate regions of being into genetically dependent moments of a self-mediation.","refs":["MC_GB18_L1_03:MME-03","MC_GB18_L1_03:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-06","text":"One and Many lose the status of competing basic stocks; multiplicity is reconstructed as the problematic self-externalization of the form of the One.","refs":["MC_GB18_L1_04:MME-03","MC_GB18_L1_04:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MME-07","text":"Quality and quantity do not appear as externally adjacent domains; quantity is mapped as the terminal effect of qualitative self-transcendence.","refs":["MC_GB18_L1_04:MME-07","MC_GB18_L1_04:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L2_01:ALT-B01","text":"At the Surface level, Seyn, Nothing, Becoming, Daseyn, limit, finitude, infinity, being-for-self, One, void, repulsion, and multiplicity form the explicit movement of categories.","refs":["MC_GB18_L1_02:ALT-B01","MC_GB18_L1_04:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:ALT-B02","text":"At the Structural level, a recursive machine of exclusion, determinate negation, limit-formation, sublation, and self-externalization generates increasingly complex forms of self-relation.","refs":["MC_GB18_L1_03:ALT-B02","MC_GB18_L1_04:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:ALT-B03","text":"At the Metastrategic level, immanent reconstruction replaces the choice between fixed oppositions and tests theories according to whether they can generate difference from their own ground.","refs":["MC_GB18_L1_02:ALT-B03","MC_GB18_L1_04:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:ALT-B04","text":"At the Ontological / Temporal level, reality is graduated self-externalization; time appears as bad repetition or as retrospective disclosure of sublated genesis.","refs":["MC_GB18_L1_03:ALT-B04","MC_GB18_L1_04:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:ALT-B05","text":"At the Methodological / Performative level, the exposition provisionally fixes concepts, activates their immanent opposition, and leads them through countermovement back into their disavowed mediation.","refs":["MC_GB18_L1_02:ALT-B05","MC_GB18_L1_04:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L2_01:FL-01","text":"The indistinguishability of Seyn and Nothing grounds their equivalence, but does not fully secure why they necessarily pass into movement rather than formal identity.","refs":["MC_GB18_L1_01:FL-03","MC_GB18_L1_01:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:FL-02","text":"The first transition is supposed to be immediate, yet is demonstrated through reflected determinations of indeterminacy and negativity; execution and presentation do not remain congruent.","refs":["MC_GB18_L1_02:FL-01","MC_GB18_L1_01:FL-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:FL-03","text":"Mediation already operates constitutively, although the sphere of being may not yet exhibit it as posited mediation; the architecture operates with a form whose status it can explain only later.","refs":["MC_GB18_L1_02:FL-04","MC_GB18_L1_02:XD-08"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:FL-04","text":"The reversal from infinite progress to affirmative infinity is structurally required, but not fully secured against a mere termination of repetition.","refs":["MC_GB18_L1_03:FL-03","MC_GB18_L1_03:MRT-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:FL-05","text":"The system forbids final externality and must simultaneously generate it as void, Dasein, and multiplicity; externality is therefore both a necessary productive form and a deficiency of mediation to be overcome.","refs":["MC_GB18_L1_04:FL-01","MC_GB18_L1_04:MRT-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:FL-06","text":"Ideality functions as the criterion of completed immanence, although its positive transformation of repulsion is not demonstrated and the movement instead passes into quantity.","refs":["MC_GB18_L1_04:FL-04","MC_GB18_L1_04:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:MP-01","text":"Pure knowing mutates into pure Seyn as soon as its relational form of knowing expires and only the function of indeterminate immediacy remains.","refs":["MC_GB18_L1_01:MP-01","MC_GB18_L1_01:XD-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_01:MP-02","text":"Immediacy mutates from the empty starting point into the resultant repose of sublated movement and thereafter into the abstract form of appearance of a genesis again concealed.","refs":["MC_GB18_L1_02:MP-03","MC_GB18_L1_04:MP-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L2_01:MP-03","text":"Negation mutates from the abstract counterpole of Seyn into qualitative reality, into the self-negation of opposition, and into repulsion as external production.","refs":["MC_GB18_L1_02:MP-04","MC_GB18_L1_03:MP-03","MC_GB18_L1_04:RMD-03"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L2_01:MP-04","text":"Limit mutates into barrier as soon as its constitutive negativity drives the finite beyond its immediate shape and thereby generates the repetition of the limit.","refs":["MC_GB18_L1_03:MP-02","MC_GB18_L1_03:RMD-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L2_01:MP-05","text":"Infinity mutates from the abstract beyond into processual unity by sublating the independence of the finite while preserving its genetic function.","refs":["MC_GB18_L1_03:RMD-06","MC_GB18_L1_03:MRT-B02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L2_01:MP-06","text":"The One mutates from abstract self-identity into a productive structure as soon as its exclusion of the Other becomes legible as enduring relation and finally as repulsion.","refs":["MC_GB18_L1_04:RMD-06","MC_GB18_L1_04:MP-04"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L2_01:HSI-01","text":"Reality appears as a recursive machine of negative self-differentiation that generates differences, renders them independent, transforms them through their contradiction, and takes them back as moments of richer connection.","refs":["MC_GB18_L1_04:HSI-01","MC_GB18_L1_01:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:HSI-02","text":"The subject is neither sovereign origin nor atomic substance, but a relational node and possible effect of the appropriation of otherness and limit.","refs":["MC_GB18_L1_01:HSI-02","MC_GB18_L1_04:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:HSI-03","text":"Time is a retrograde spiral: linear repetition conserves unresolved limits, while results conceal their production and retrospectively reveal the beginning as already mediated.","refs":["MC_GB18_L1_03:HSI-03","MC_GB18_L1_04:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:HSI-04","text":"Struggle and navigation consist in rejecting external mediations and abstract models of beyond, without annihilating otherness; only its transformation into immanent relation remains possible.","refs":["MC_GB18_L1_04:HSI-04","MC_GB18_L1_02:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L2_01:MRT-B01","text":"The architecture is reconstructible if it preserves the emptied beginning, Becoming, resultant immediacy, determinate negation, limit, bad and true infinity, ideality, being-for-self, repulsion, and multiplicity.","refs":["MC_GB18_L1_02:MRT-B01","MC_GB18_L1_04:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MRT-B02","text":"The system remains coherent provided that no immediacy is treated as without mediation, no negation as mere annihilation, and no externality as original givenness.","refs":["MC_GB18_L1_02:MRT-B03","MC_GB18_L1_04:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MRT-B03","text":"Underdetermined remain the necessity of the first transition, the reversal from infinite progress to affirmation, and the precise externalization of internal negation as void and multiplicity.","refs":["MC_GB18_L1_01:MRT-B02","MC_GB18_L1_03:MRT-B04","MC_GB18_L1_04:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MRT-B04","text":"The system's strongest achievement lies in the continuous mutation of a function of negation that generates transition from void, determinacy from transition, self-relation from limit, and multiplicity from self-relation.","refs":["MC_GB18_L1_02:MRT-B04","MC_GB18_L1_04:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MRT-B05","text":"The reconstruction indispensably depends on sequencing, recursive return, retrospective grounding, and performative mutation of concepts; a static list of axioms could not replace the movement.","refs":["MC_GB18_L1_01:MRT-B05","MC_GB18_L1_03:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_01:MRT-B06","text":"Complete axiomatic reduction is resisted by the double status of externality: it must be generated, appear as independent, and simultaneously be taken back into self-relation, in order for the transition to quantity to become possible.","refs":["MC_GB18_L1_04:MRT-B04","MC_GB18_L1_04:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L2_01@R001","source_variant_id":"canonical:MC_GB18_L2_01:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L2 01","context":"Chapters 01–48 · Vorrede zur ersten Ausgabe. · Vorrede zur zweiten Auflage. · Allgemeiner Begriff der Logik · Allgemeine Eintheilung der Logik · Womit muß der Anfang der Wissenschaft gemacht werden? · Allgemeine Eintheilung des Seyns · Erster Abschnitt. Bestimmtheit (Qualität). · A. Seyn. · B. Nichts. · 1. Einheit des Seyns und Nichts. · Anmerkung 1. · Anmerkung 2. · Anmerkung 3. · Anmerkung 4. · 2. Momente des Werdens. · 3. Aufheben des Werdens. · Anmerkung. · A. Daseyn als solches. · a. Daseyn überhaupt. · b. Qualität. · Anmerkung. · c. Etwas. · B. Die Endlichkeit. · a. Etwas und ein Anderes. · b. Bestimmung, Beschaffenheit und Grenze. · c. Die Endlichkeit. · 1. Die Unmittelbarkeit der Endlichkeit. · 2. Die Schranke und das Sollen. · Anmerkung. · 3. Übergang des Endlichen in das Unendliche. · C. Die Unendlichkeit. · a. Das Unendliche überhaupt. · b. Wechselbestimmung des Endlichen und Unendlichen. · c. Die affirmative Unendlichkeit. · Der Übergang. · Anmerkung 1. · Anmerkung 2. · A. Das Fürsichseyn als solches. · a. Daseyn und Fürsichseyn. · b. Seyn-für-eines. · Anmerkung. · c. Eins. · B. Eins und Vieles. · a. Das Eins an ihm selbst. · b. Das Eins und das Leere. · Anmerkung. · c. Viele Eins. Repulsion. · Anmerkung."},"title_language_code":"en"},{"id":"MC_GB18_L3_01","layer":"MC","title":"Gb18 L3 01","order":1,"parents":["MC_GB18_L2_01","MC_GB18_L2_02"],"revision":"MC_GB18_L3_01@R001","sha256":"535131d2682986eff033ebe06f6a1bd0cb30d17ba50cd436b339d0ec1c267b29","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L3_01:AS-01","text":"Das System muss die vollständige Bestimmungsordnung des Seyns aus einem voraussetzungslosen Anfang erzeugen, ohne qualitative Identität, quantitative Einheit, Maß oder Beziehung als fertige Gegebenheiten einzuführen.","refs":["MC_GB18_L2_01:AS-01","MC_GB18_L2_02:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-02","text":"Seine globale These bestimmt Negation als erhaltende Selbstdifferenzierung, durch die Qualität sich externalisiert, Quantität relational bestimmt und Maß zur konkreten Einheit beider wird.","refs":["MC_GB18_L2_01:AS-02","MC_GB18_L2_02:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-03","text":"Der Beweisgang ist eine immanente Kategoriengenese, deren Übergänge aus der Unhaltbarkeit isolierter Bestimmungen hervorgehen und deren konkrete Geltung zugleich qualitative Typisierung verlangt.","refs":["MC_GB18_L2_01:AS-03","MC_GB18_L2_02:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-04","text":"Qualitative Selbstbeziehung erzeugt durch Eins, Leeres und Repulsion jene gleichartige Vielheit, die Quantität nicht voraussetzt, sondern als transformierte Form qualitativer Negativität eröffnet.","refs":["MC_GB18_L2_01:AS-06","MC_GB18_L2_02:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-05","text":"Quantitative Äußerlichkeit wird durch Grenze, Relation und Invariante requalifiziert, bis kontinuierliche Variation an Maßpunkten neue Qualitäten und Reihen von Zuständen hervorbringt.","refs":["MC_GB18_L2_02:AS-03","MC_GB18_L2_02:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-06","text":"Äußerlichkeit mutiert vom scheinbar ausgeschlossenen Gegenpol zur erzeugten Vielheit, zum Medium quantitativer Bestimmung und schließlich zum zurückgenommenen Zustand einer reflektierten Einheit.","refs":["MC_GB18_L2_01:AS-07","MC_GB18_L2_02:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-07","text":"Die Bewegung ist apophatisch, rekursiv, spiralförmig und mutationsgetrieben, weil jede vorläufige Einheit ihre Grenze erzeugt und durch deren Rückkehr in ein höheres Operationsregime übergeht.","refs":["MC_GB18_L2_01:AS-07","MC_GB18_L2_02:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-08","text":"Die Schließung ist retrospektiv und terminal-transformativ: Maß vollendet das Seyn nicht als höchste Seinsbestimmung, sondern entzieht einzelnen Maßen ihre Selbständigkeit und eröffnet Wesen als reflektierten Grund.","refs":["MC_GB18_L2_01:AS-08","MC_GB18_L2_02:AS-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L3_01:GA-01","text":"[Persistent] Keine Bestimmung besitzt vor ihren Beziehungen vollständige Selbständigkeit; qualitative Identität, Quantum und Maß sind Resultate vermittelter Differenz.","refs":["MC_GB18_L2_01:GA-02","MC_GB18_L2_02:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-02","text":"[Persistent] Negation ist nur produktiv, sofern sie das Negierte als wirksames Moment erhält und dadurch weitere Bestimmung ermöglicht.","refs":["MC_GB18_L2_01:AS-02","MC_GB18_L2_02:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-03","text":"[Persistent] Wissenschaftliche Geltung verlangt, dass Kategorien und Übergänge aus der Selbstbewegung des Inhalts hervorgehen, statt durch eine äußerlich angewandte Methode verbunden zu werden.","refs":["MC_GB18_L2_01:GA-01","MC_GB18_L2_02:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-04","text":"[Mutating] Unmittelbarkeit mutiert vom bestimmungslosen Anfang zur sedimentierten Vermittlung und zuletzt zur Erscheinungsform von Zuständen, deren Grund in einer reflektierten Einheit liegt.","refs":["MC_GB18_L2_01:GA-04","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-05","text":"[Attractor] Selbstbeziehung ist der positive Attraktor der Bewegung; ihre konkrete Form ist negative Identität, die Differenz integriert, ohne sie zu vernichten.","refs":["MC_GB18_L2_01:GA-09","MC_GB18_L2_02:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-06","text":"[Mutating] Anderssein und Äußerlichkeit sind weder ursprüngliches Außen noch bloßer Mangel, sondern erzeugte Medien, in denen Einheit ihre eigene Differenz setzt, bestimmt und zurücknimmt.","refs":["MC_GB18_L2_01:GA-05","MC_GB18_L2_02:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-07","text":"[Mutating] Grenze mutiert von qualitativer Konstitution über Schranke und quantitative Selbstbegrenzung zur Maßschwelle, an der eine Bestimmungsordnung in eine andere umschlägt.","refs":["MC_GB18_L2_01:GA-07","MC_GB18_L2_02:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-08","text":"[Emergent] Widerspruch ist die operative Form, in der voneinander abhängige Momente ihre falsche Selbständigkeit verlieren und als Selbstverschiedenheit einer Einheit reorganisiert werden.","refs":["MC_GB18_L2_01:GA-11","MC_GB18_L2_02:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-09","text":"[Mutating] Unendlichkeit mutiert vom schlechten Progress zur gegenwärtigen Selbstvermittlung einer Relation und schließlich zur Maßlosigkeit, welche quantitative Stabilität qualitativ negiert.","refs":["MC_GB18_L2_01:GA-08","MC_GB18_L2_02:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-10","text":"[Emergent] Quantität entsteht, wenn qualitative Selbstbeziehung sich als gleichartige Vielheit externalisiert und Kontinuität, Diskretion, Einheit und Grenze zu einem vermittelten Operationsfeld verbindet.","refs":["MC_GB18_L2_01:XD-08","MC_GB18_L2_02:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-11","text":"[Emergent] Maß ist die konkrete Wahrheit der Trennung von Qualität und Quantität, weil eine qualitative Relation Größenmomente funktional bestimmt und deren Geltungsbereich organisiert.","refs":["MC_GB18_L2_01:MME-07","MC_GB18_L2_02:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-12","text":"[Emergent] Qualitative Transformation entsteht nicht aus Akkumulation allein, sondern aus einem Maßgesetz, das quantitative Variation gliedert und an einer Schwelle ihre Funktion umkehrt.","refs":["MC_GB18_L2_01:XD-08","MC_GB18_L2_02:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-13","text":"[Terminal] Die Seinslogik schließt sich, indem Maße ihre Selbständigkeit verlieren, zu Zuständen eines Substrats werden und damit die reflektierte Grundstruktur des Wesens eröffnen.","refs":["MC_GB18_L2_01:DBN-05","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-14","text":"[Mutating] Begriffliche Legitimität mutiert von reiner immanenter Ableitung zu einer gestuften Prüfung, in der formale Erzeugung qualitativ typisiert und gegenstandsbezogen begrenzt werden muss.","refs":["MC_GB18_L2_02:AS-04","MC_GB18_L2_02:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-15","text":"[Attractor] Das fehlende immanente Gesetz konkreter Exponenten, Affinitäten, Reihen und Schwellen bleibt der negative Attraktor, der eine vollständige Schließung der Maßarchitektur verhindert.","refs":["MC_GB18_L2_02:GA-12","MC_GB18_L2_02:DBN-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L3_01:RMD-01","text":"[Escalation] Negation erweitert sich vom abstrakten Nichts über Qualität, Grenze und Repulsion zur quantitativen Begrenzung, Maßlosigkeit und Entselbständigung einzelner Zustände.","refs":["MC_GB18_L2_01:GA-03","MC_GB18_L2_02:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-02","text":"[Mutation] Unmittelbarkeit bezeichnet zuerst Inhaltsleere, danach das ruhige Resultat aufgehobener Vermittlung und zuletzt die scheinbare Selbständigkeit eines Zustands gegenüber seinem reflektierten Grund.","refs":["MC_GB18_L2_01:RMD-04","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-03","text":"[Escalation] Grenze wandert von qualitativer Konstitution über endliche Schranke und quantitative Jenseitserzeugung zur Maßschwelle qualitativer Transformation.","refs":["MC_GB18_L2_01:RMD-06","MC_GB18_L2_02:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-04","text":"[Displacement] Das Andere wandert aus der Form äußerer Gegenständlichkeit in die interne Negation, erscheint erneut als quantitative Äußerlichkeit und wird im Maß zur Funktionsstelle negativer Einheit.","refs":["MC_GB18_L2_01:RMD-05","MC_GB18_L2_02:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-05","text":"[Mutation] Das Eins verliert seine scheinbare Ursprünglichkeit, erzeugt Vielheit, wird zur Zahl und endet als temporär stabiler Knoten relationaler Bestimmung.","refs":["MC_GB18_L2_01:RMD-08","MC_GB18_L2_02:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-06","text":"[Terminal transformation] Unendlichkeit verliert die Form eines unerreichbaren Jenseits, wird zur vollständigen Relation und überträgt ihre negative Übergangsfunktion schließlich auf Maßlosigkeit und Schwelle.","refs":["MC_GB18_L2_01:RMD-07","MC_GB18_L2_02:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-07","text":"[Reversal] Qualität verschwindet in der quantitativen Externalisierung nur vorläufig und kehrt im Maß als organisierender Grund der Größenrelation zurück.","refs":["MC_GB18_L2_01:MME-07","MC_GB18_L2_02:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-08","text":"[Functional recurrence] Widerspruch bleibt als Übergangsoperator erhalten, wechselt aber vom Kollaps isolierter Bestimmungen zur Vermittlung von Stabilität, Variation und qualitativem Sprung.","refs":["MC_GB18_L2_01:GA-11","MC_GB18_L2_02:RMD-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-09","text":"[Absorption] Selbständigkeit wandert vom qualitativen Etwas über Eins und Quantum zum relationalen Knoten und wird schließlich zur bloßen Zustandsform einer umfassenderen Einheit.","refs":["MC_GB18_L2_01:CGD-05","MC_GB18_L2_02:MP-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-10","text":"[Terminal transformation] Maß mutiert von der unmittelbaren Einheit qualitativer und quantitativer Bestimmung zur Schwellenmaschine und wird danach in Substrat und Wesen absorbiert.","refs":["MC_GB18_L2_02:RMD-07","MC_GB18_L2_02:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L3_01:CGD-01","text":"Seyn, Nichts, Werden, Zahl, Grad, Verhältnis und Potenz bleiben Kategorien lokaler Sequenzen; auf der aktuellen Ebene skalieren sie zu Phasen einer einzigen Maschine erhaltender Negation.","refs":["MC_GB18_L2_01:CGD-02","MC_GB18_L2_02:CGD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-02","text":"Kosmologische, physikalische, chemische, musikalische und politische Beispiele bleiben lokale Prüfkonfigurationen; global skaliert ihr gemeinsamer Typus relationaler und schwellenabhängiger Transformation.","refs":["MC_GB18_L2_01:CGD-03","MC_GB18_L2_02:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-03","text":"Historische Logikkritik und einzelne Rechenoperationen bleiben lokale Eintritts- und Demonstrationsformen; aktuell trägt die Differenz zwischen immanenter Kategoriengenese und bloß formalem Erfolg.","refs":["MC_GB18_L2_01:CGD-01","MC_GB18_L2_02:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-04","text":"Das Sollen bleibt die lokale Normform endlicher Überschreitung; nach oben skaliert die Differenz zwischen einer Grenze, die sich bloß wiederholt, und einer Schwelle, die ihre Ordnung transformiert.","refs":["MC_GB18_L2_01:CGD-04","MC_GB18_L2_02:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-05","text":"Konkrete Koeffizienten, Exponenten, Affinitäten und Maßpunkte bleiben lokal unterbestimmt; auf der aktuellen Ebene wird ihre Nichtableitbarkeit zum negativen Attraktor systematischer Offenheit.","refs":["MC_GB18_L2_02:CGD-04","MC_GB18_L2_02:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-06","text":"Seele und Geist bleiben lokale Grenztests quantitativer Erklärung; global skaliert die Regel, dass kategoriale Geltung mit der Konkretion und dem Typus des Gegenstands begrenzt werden muss.","refs":["MC_GB18_L2_02:CGD-05","MC_GB18_L2_02:GA-13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-07","text":"Die noch unentwickelte Quantität bildet lokal die Grenze der Qualitätslogik, während der Übergang von Maß zu Wesen auf der aktuellen Ebene die terminale Schließungsform des gesamten Seyns bildet.","refs":["MC_GB18_L2_01:CGD-06","MC_GB18_L2_02:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L3_01:GNX-01","text":"Ausgeschlossen sind eine äußerlich bereitgestellte Methode und jeder neutrale Beobachtungsstandpunkt, der Kategorien oder Relationen von außerhalb des Vermittlungsfeldes verbinden könnte.","refs":["MC_GB18_L2_01:GNX-01","MC_GB18_L2_02:GNX-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-02","text":"Ausgeschlossen ist ein positiv bestimmter Anfang oder eine erste Unmittelbarkeit, die Differenz und Negation nicht bereits voraussetzte.","refs":["MC_GB18_L2_01:GNX-02","MC_GB18_L2_02:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-03","text":"Ausgeschlossen sind fertige Substanzen, Quanta und Relata, denen Beziehungen erst nachträglich hinzugefügt würden.","refs":["MC_GB18_L2_01:GNX-03","MC_GB18_L2_02:GNX-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-04","text":"Ausgeschlossen sind reine Positivität, terminale Vernichtung und unveränderte Selbsterhaltung, weil keine dieser Formen produktive Bestimmtheit erzeugen kann.","refs":["MC_GB18_L2_01:GNX-04","MC_GB18_L2_02:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-05","text":"Ausgeschlossen sind Zweiweltenmodelle, unbegrenzter Progress und ein letztes Maß, weil sie Grenze und Jenseits als selbständige Pole konservieren.","refs":["MC_GB18_L2_01:GNX-05","MC_GB18_L2_02:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-06","text":"Ausgeschlossen sind selbstinterpretierender Formalismus, universale Quantifizierung und die Reduktion des Geistes auf Ding- und Größenkategorien.","refs":["MC_GB18_L2_02:GNX-02","MC_GB18_L2_02:GNX-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-07","text":"Ausgeschlossen ist eine endgültige Schließung innerhalb des Seyns; dessen vollendete Maßstruktur muss ihre eigenen Bestimmungen entselbständigen und in Wesen übergehen.","refs":["MC_GB18_L2_01:DBN-05","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L3_01:DBN-01","text":"Damit die Architektur trägt, darf kein irreduzibel fremdes oder vorrelational selbständiges Substrat Bestimmtheit liefern; Substrat ist nur als Resultat entstehenden Maßverfalls zulässig.","refs":["MC_GB18_L2_01:DBN-01","MC_GB18_L2_02:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:DBN-02","text":"Eine positive Identität vor Negation und Relation muss unmöglich sein, weil Vermittlung andernfalls äußerlich zu einem bereits fertigen Bestand hinzuträte.","refs":["MC_GB18_L2_01:DBN-03","MC_GB18_L2_02:GA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:DBN-03","text":"Lineare Sukzession und quantitative Akkumulation dürfen aus sich weder wahre Unendlichkeit noch qualitative Neuheit hervorbringen; ohne Rücknahme der Grenze reproduzieren sie nur dieselbe Form.","refs":["MC_GB18_L2_01:DBN-02","MC_GB18_L2_02:DBN-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:DBN-04","text":"Ein dauerhaftes Außen muss unzulässig sein, obwohl Äußerlichkeit als notwendige Produktionsform auftreten muss; sie darf Widerstand und Differenz liefern, aber kein unabhängiger Grund werden.","refs":["MC_GB18_L2_01:BSA-02","MC_GB18_L2_02:BSA-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:DBN-05","text":"Operative Berechenbarkeit, numerische Exaktheit und empirische Bestätigung dürfen nicht mit begrifflicher Erzeugung oder ontologischer Wahrheit identifiziert werden.","refs":["MC_GB18_L2_02:DBN-02","MC_GB18_L2_02:GA-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:DBN-06","text":"Eine vollständige Ableitung konkreter Naturgesetze darf nicht fingiert werden; die Nichtverfügbarkeit des Erzeugungsprinzips bestimmter Reihen und Schwellen gehört zur Architektur selbst.","refs":["MC_GB18_L2_02:DBN-05","MC_GB18_L2_02:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L3_01:BSA-01","text":"Die tiefste Abwesenheit ist ein ruhender Ursprung, dessen Identität keiner Differenzierung, Vermittlung oder retrospektiven Rechtfertigung bedürfte.","refs":["MC_GB18_L2_01:BSA-01","MC_GB18_L2_02:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:BSA-02","text":"Nicht verfügbar ist ein unassimilierbares Außen, das Bestimmtheit erzeugen könnte, ohne als Moment der dadurch bestimmten Einheit zurückzukehren.","refs":["MC_GB18_L2_01:BSA-02","MC_GB18_L2_02:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:BSA-03","text":"Unverfügbar sind eine letzte Identität, ein letztes Nichts und eine vollständig kommensurable Zahlenordnung, in der qualitative Differenz ohne Rest verschwindet.","refs":["MC_GB18_L2_01:BSA-03","MC_GB18_L2_02:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:BSA-04","text":"Das System umkreist eine vollständig immanente Einheit, die konkrete Differenzen und Schwellen erzeugen könnte, ohne sie zu verselbständigen; gerade das fehlende Erzeugungsgesetz verhindert ihre positive Vollendung.","refs":["MC_GB18_L2_01:BSA-04","MC_GB18_L2_02:BSA-03"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L3_01:XD-01","text":"Die terminale Selbstexternalisierung der Qualität erzeugt die gleichartige Vielheit, aus deren erhaltener Einheit Quantität als neues Bestimmungsregime hervorgeht.","refs":["MC_GB18_L3_01:GA-05","MC_GB18_L3_01:GA-10","MC_GB18_L2_01:XD-08","MC_GB18_L2_02:FGS-B02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-02","text":"Äußerlichkeit ist die Übergangsform zwischen Qualität und Quantität: Als ursprünglicher Grund bleibt sie verboten, als erzeugte Vielheit und Medium gleichgültiger Variation wird sie notwendig.","refs":["MC_GB18_L3_01:GA-06","MC_GB18_L3_01:GA-10","MC_GB18_L2_01:FL-05","MC_GB18_L2_02:XD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-03","text":"Grenze erzeugt zwei entgegengesetzte Zeitformen: Ihre abstrakte Überschreitung reproduziert schlechten Progress, ihre maßförmige Zuspitzung erzeugt eine Schwelle qualitativer Transformation.","refs":["MC_GB18_L3_01:GA-07","MC_GB18_L3_01:GA-09","MC_GB18_L3_01:GA-12","MC_GB18_L2_01:XD-03","MC_GB18_L2_02:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-04","text":"Wahre Unendlichkeit liefert die logische Bedingung des Maßes, weil erst die aufgehobene Selbständigkeit ihrer Seiten eine in sich vollständige qualitative Relation ermöglicht.","refs":["MC_GB18_L3_01:GA-09","MC_GB18_L3_01:GA-11","MC_GB18_L2_01:XD-04","MC_GB18_L2_02:GA-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-05","text":"Maß ist nicht die Addition von Qualität und Quantität, sondern die Rückkehr qualitativer Selbstbestimmung innerhalb der aus ihr hervorgegangenen quantitativen Äußerlichkeit.","refs":["MC_GB18_L3_01:GA-10","MC_GB18_L3_01:GA-11","MC_GB18_L3_01:GA-12","MC_GB18_L2_01:MME-07","MC_GB18_L2_02:MME-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-06","text":"Widerspruch eskaliert von der Destabilisierung isolierter Kategorien zur Phasenoperation, die quantitative Erhaltung und qualitative Veränderung an derselben Einheit vermittelt.","refs":["MC_GB18_L3_01:GA-02","MC_GB18_L3_01:GA-08","MC_GB18_L3_01:GA-12","MC_GB18_L2_01:GA-11","MC_GB18_L2_02:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-07","text":"Resultative Unmittelbarkeit erreicht ihre terminale Form, wenn einzelne Maße nur noch als unmittelbare Zustände erscheinen und ihre Vermittlung in ein fortbestehendes Substrat zurücktritt.","refs":["MC_GB18_L3_01:GA-04","MC_GB18_L3_01:GA-13","MC_GB18_L2_01:XD-01","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-08","text":"Immanente Ableitung und gegenständliche Prüfung bilden eine spannungsreiche Doppelbedingung: Kategorien müssen sich selbst erzeugen, dürfen ihre konkrete Geltung aber nicht aus formaler Erzeugbarkeit allein beziehen.","refs":["MC_GB18_L3_01:GA-03","MC_GB18_L3_01:GA-14","MC_GB18_L2_01:GA-01","MC_GB18_L2_02:XD-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-09","text":"Die Schließung des Seyns ist zugleich seine Öffnung: Maß geht in Wesen über, während das Gesetz seiner konkreten Reihen und Schwellen uneingelöst bleibt.","refs":["MC_GB18_L3_01:GA-13","MC_GB18_L3_01:GA-15","MC_GB18_L2_01:AS-08","MC_GB18_L2_02:XD-07"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L3_01:BSD-01","text":"Realität erhält den Status einer Folge relational stabilisierter Phasen, deren Identität aus negativer Selbstvermittlung hervorgeht und deren Übergänge durch Maßschwellen organisiert werden.","refs":["MC_GB18_L2_01:BSD-01","MC_GB18_L2_02:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-02","text":"Das Subjekt verliert den Status eines vorausgesetzten Trägers und wird zur vermittelnden Selbstbeziehung; als Geist bleibt es gegenüber einer vollständigen Übersetzung in quantitative Dingbestimmungen irreduzibel.","refs":["MC_GB18_L2_01:BSD-02","MC_GB18_L2_02:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-03","text":"Zeit wird zur Spiralstruktur aus Grenzwiederholung, quantitativer Fortsetzung, qualitativer Unterbrechung und retrospektiver Rekonstruktion der eigenen Voraussetzungen.","refs":["MC_GB18_L2_01:BSD-03","MC_GB18_L2_02:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-04","text":"Kausalität wird von äußerer Einwirkung auf rekursive Spezifikation umgestellt: Eine Veränderung wirkt nur, sofern sie intern relational bestimmt und an einer Schwelle zur neuen Qualität organisiert wird.","refs":["MC_GB18_L2_01:BSD-04","MC_GB18_L2_02:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-05","text":"Erkenntnis wird zu einer gestuften Rekonstruktion von Genese, formaler Operation, qualitativer Typisierung, Beobachtung und gegenstandsbezogener Reichweitenbegrenzung.","refs":["MC_GB18_L2_01:BSD-05","MC_GB18_L2_02:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-06","text":"Handlungsmacht besteht weder in abstrakter Grenzüberschreitung noch in bloßer Mengensteigerung, sondern in der Transformation relationaler Bedingungen und der Navigation ihrer Umschlagspunkte.","refs":["MC_GB18_L2_01:BSD-06","MC_GB18_L2_02:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-07","text":"Universalität bedeutet keine gleichförmige Anwendbarkeit einer Kategorie auf alle Gegenstände, sondern die immanente Bestimmung ihrer Reichweite und ihrer notwendigen Selbstbegrenzung.","refs":["MC_GB18_L2_02:GA-13","MC_GB18_L2_02:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L3_01:RLE-01","text":"Die Rechtfertigungsschleife lautet: voraussetzungsloser Anfang → kategoriale Entwicklung → terminales Resultat → retrospektive Rekonstruktion des Anfangs als aufgehobene Vermittlung.","refs":["MC_GB18_L2_01:GA-14","MC_GB18_L2_02:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-02","text":"Die Sedimentationsschleife lautet: Vermittlung erzeugt Unmittelbarkeit → Unmittelbarkeit verdeckt ihre Genese → der verdeckte Gegensatz aktiviert neue Vermittlung.","refs":["MC_GB18_L2_01:RLE-02","MC_GB18_L2_02:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-03","text":"Die Externalisierungsschleife lautet: Selbstbeziehung → Ausschluss → Leeres und Vielheit → quantitative Äußerlichkeit → relationale Rücknahme → konkrete Selbstbeziehung.","refs":["MC_GB18_L2_01:RLE-06","MC_GB18_L2_02:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-04","text":"Die Grenzschleife erzeugt aus Bestimmtheit eine Schranke, aus der Schranke ein Jenseits und aus jedem abstrakten Jenseits dieselbe Grenze auf erweiterter Stufe.","refs":["MC_GB18_L2_01:RLE-03","MC_GB18_L2_02:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-05","text":"Die Quantitätsspirale führt von kontinuierlicher Teilbarkeit über diskrete Einheit und Zahl zu Grad, Verhältnis und qualitativer Invariante.","refs":["MC_GB18_L2_02:RLE-03","MC_GB18_L2_02:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-06","text":"Die Schwelleneskalation führt von gleichgültiger Variation über Akkumulation und Maßpunkt zum qualitativen Sprung; die Negation der Negation verhindert, dass dieser Sprung bloße Vernichtung bleibt.","refs":["MC_GB18_L2_02:RLE-05","MC_GB18_L2_01:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-07","text":"Die terminale Schleife vervielfältigt Maße, ordnet ihre Sprünge zu Knotenlinien und nimmt ihre Selbständigkeit in die Kontinuität eines Substrats zurück.","refs":["MC_GB18_L2_02:RLE-06","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-08","text":"Zwei Attraktoren organisieren die Gesamtmaschine: positiv die immanente Selbstvermittlung aller Bestimmung, negativ das fehlende Gesetz konkreter Maßordnungen.","refs":["MC_GB18_L2_01:RLE-07","MC_GB18_L2_02:RLE-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L3_01:FGS-B01","text":"Ausschluss äußerlicher Methode + Forderung immanenter Notwendigkeit → Selbstbewegung des Inhalts + gegenstandsbezogene Geltungsprüfung.","refs":["MC_GB18_L2_01:FGS-B01","MC_GB18_L2_02:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B02","text":"Entleerung aller Bestimmtheit → reines Seyn ↔ Nichts → Instabilität isolierter Unmittelbarkeit → Werden.","refs":["MC_GB18_L2_01:AS-04","MC_GB18_L2_01:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B03","text":"Aufgehobenes Werden → resultative Unmittelbarkeit → Daseyn → Qualität → Etwas und Anderes → Grenze.","refs":["MC_GB18_L2_01:FGS-B04","MC_GB18_L2_01:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B04","text":"Immanente Grenze → Endlichkeit → Schranke und Sollen → abstrakte Überschreitung → Wiederkehr der Grenze → schlechte Unendlichkeit.","refs":["MC_GB18_L2_01:XD-03","MC_GB18_L2_01:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B05","text":"Negation der selbständigen Opposition → affirmative Unendlichkeit → Fürsichsein → Eins → Leeres → Repulsion → gleichartige Vielheit.","refs":["MC_GB18_L2_01:XD-06","MC_GB18_L2_01:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B06","text":"Erhaltene Vielheit + Gleichheit der Einsheiten → Kontinuität mit innerer Diskretion → Quantität → Quantum, Zahl und Grad.","refs":["MC_GB18_L2_02:FGS-B02","MC_GB18_L2_02:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B07","text":"Quantitative Grenze + relationale Rücknahme des Jenseits → Verhältnis, Exponent und Potenz → qualitative Invariante → Maß.","refs":["MC_GB18_L2_02:FGS-B04","MC_GB18_L2_02:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B08","text":"Maßvariation → Gleichgültigkeitsbereich → Maßpunkt → qualitativer Sprung → Knotenlinie → Entselbständigung einzelner Maße → Substrat.","refs":["MC_GB18_L2_02:FGS-B06","MC_GB18_L2_02:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B09","text":"Substrat als Einheit wechselnder Zustände → reflektierter Grund → Wesen; fehlendes Gesetz konkreter Schwellen → terminal offene Schließung.","refs":["MC_GB18_L2_02:FGS-B07","MC_GB18_L2_02:GA-12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L3_01:AFM-B01","text":"Ausschluss äußerer Voraussetzungen → entleerter Anfang → immanente Instabilität → kategoriale Selbstbewegung.","refs":["MC_GB18_L2_01:GNX-01","MC_GB18_L2_01:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AFM-B02","text":"Reines Seyn → Nichts → Werden → Daseyn → qualitative Bestimmtheit.","refs":["MC_GB18_L2_01:RMD-02","MC_GB18_L2_01:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AFM-B03","text":"Qualität → Grenze → Endlichkeit → schlechte Unendlichkeit → affirmative Selbstbeziehung → Eins.","refs":["MC_GB18_L2_01:AFM-B03","MC_GB18_L2_01:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AFM-B04","text":"Eins → Repulsion → Vielheit → Kontinuität und Diskretion → Quantität → Quantum und Grad.","refs":["MC_GB18_L2_01:RLE-06","MC_GB18_L2_02:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AFM-B05","text":"Quantum → Verhältnis → qualitative Invariante → Maß → Akkumulation → Schwelle → qualitativer Sprung.","refs":["MC_GB18_L2_02:AFM-B03","MC_GB18_L2_02:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AFM-B06","text":"Maßreihe → Knotenlinie → Substratkontinuität → Zustandsform → Wesen → offene Frage des konkreten Erzeugungsgesetzes.","refs":["MC_GB18_L2_02:AFM-B04","MC_GB18_L2_02:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L3_01:MME-01","text":"Unmittelbarkeit und Vermittlung werden nicht länger als ausschließende Zustände kartiert; Unmittelbarkeit erscheint als verdichtete und ihre Genese verdeckende Vermittlung.","refs":["MC_GB18_L2_01:MME-01","MC_GB18_L2_02:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-02","text":"Identität und Differenz verlieren den Status unabhängiger Prinzipien; konkrete Identität wird als negative Einheit integrierter Selbstverschiedenheit lesbar.","refs":["MC_GB18_L2_01:MME-02","MC_GB18_L2_02:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-03","text":"Innen und Außen werden zu Funktionen unterschiedlicher Vermittlungsgrade; Äußerlichkeit bezeichnet die verselbständigte Darstellung intern erzeugter Differenz.","refs":["MC_GB18_L2_01:MME-04","MC_GB18_L2_02:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-04","text":"Qualität und Quantität verlieren den Status getrennter Ordnungen und werden als wechselseitig transformierbare Momente des Maßes neu kartiert.","refs":["MC_GB18_L2_01:MME-07","MC_GB18_L2_02:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-05","text":"Kontinuität, Diskretion und qualitativer Sprung bilden keinen Gegensatz mehr: Kontinuität trägt Variation, Diskretion gliedert sie und die Schwelle reorganisiert beide.","refs":["MC_GB18_L2_02:RMD-08","MC_GB18_L2_02:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-06","text":"Mathematik wird von einer ontologischen Universalautorität zu einem regionalen Darstellungs- und Prüfverfahren umklassifiziert, dessen Gegenstandsbedeutung eigens rekonstruiert werden muss.","refs":["MC_GB18_L2_02:MME-05","MC_GB18_L2_02:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-07","text":"Seyn und Wesen werden nicht als getrennte Regionen kartiert; Wesen entsteht als reflektierte Wahrheit einer Seinsordnung, deren unmittelbare Maße ihre Selbständigkeit verloren haben.","refs":["MC_GB18_L2_02:CGD-06","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L3_01:ALT-B01","text":"Auf dem Surface level bilden Seyn, Nichts, Werden, Qualität, Grenze, Eins, Zahl, Grad, Verhältnis, Maß, Schwelle, Substrat und Wesen die explizite Kategoriebewegung.","refs":["MC_GB18_L2_01:ALT-B01","MC_GB18_L2_02:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:ALT-B02","text":"Auf dem Structural level organisiert eine rekursive Maschine aus bestimmter Negation, Externalisierung, Grenzbildung, relationaler Rücknahme und Schwellenumschlag die Entstehung stabiler Gestalten.","refs":["MC_GB18_L2_01:ALT-B02","MC_GB18_L2_02:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:ALT-B03","text":"Auf dem Metastrategic level ersetzt immanente Rekonstruktion die Wahl zwischen fixierten Gegensätzen und verlegt Intervention auf die Transformation relationaler Bedingungen und reproduzierter Grenzen.","refs":["MC_GB18_L2_01:ALT-B03","MC_GB18_L2_02:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:ALT-B04","text":"Auf dem Ontological / Temporal level ist Realität gestufte Selbstverschiedenheit; Zeit erscheint als Wiederholung, quantitative Fortsetzung, qualitative Unterbrechung und retrospektive Rückkehr.","refs":["MC_GB18_L2_01:ALT-B04","MC_GB18_L2_02:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:ALT-B05","text":"Auf dem Methodological / Performative level setzt die Darstellung Bestimmungen fest, aktiviert ihre ausgeschlossenen Bedingungen und überführt sie durch den erzeugten Widerspruch in umfassendere Vermittlungsordnungen.","refs":["MC_GB18_L2_01:ALT-B05","MC_GB18_L2_02:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L3_01:FL-01","text":"Die Ununterscheidbarkeit von Seyn und Nichts begründet ihre Gleichrangigkeit, erklärt aber nicht vollständig, weshalb diese Gleichrangigkeit notwendig Bewegung statt formaler Identität erzeugt.","refs":["MC_GB18_L2_01:FL-01","MC_GB18_L2_01:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-02","text":"Vermittlung operiert bereits am Anfang konstitutiv, obwohl sie innerhalb der Seinsform noch nicht als gesetzte Relation ausgewiesen werden darf.","refs":["MC_GB18_L2_01:FL-03","MC_GB18_L2_02:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-03","text":"Äußerlichkeit muss erzeugt, erhalten und zurückgenommen werden, darf jedoch nie unabhängige Erklärungskraft besitzen; die Architektur kann sie weder eliminieren noch verselbständigen.","refs":["MC_GB18_L2_01:FL-05","MC_GB18_L2_02:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-04","text":"Die Forderung vollständiger immanenter Selbstbewegung steht in Spannung zur konstitutiven Rolle von Anwendung, qualitativer Typisierung und Gegenstandsprüfung.","refs":["MC_GB18_L2_01:GA-01","MC_GB18_L2_02:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-05","text":"Maß soll qualitative Notwendigkeit ausdrücken, obwohl konkrete Exponenten, Affinitäten und Schwellenwerte nicht aus einem positiven gemeinsamen Gesetz abgeleitet werden.","refs":["MC_GB18_L2_01:FL-06","MC_GB18_L2_02:FL-06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-06","text":"Der universale Übergang des Maßes zum Wesen steht in Spannung zur regionalen Reichweite quantitativer Gesetzlichkeit und zur Irreduzibilität geistiger Selbstbestimmung.","refs":["MC_GB18_L2_02:FL-04","MC_GB18_L2_02:FL-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-07","text":"Das Substrat muss durch wechselnde Qualitäten bestimmt werden und zugleich als dasselbe fortbestehen, ohne in ein vorausgesetztes fremdes Trägermedium zurückzufallen.","refs":["MC_GB18_L2_02:FL-07","MC_GB18_L2_01:DBN-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:MP-01","text":"Unmittelbarkeit mutiert vom leeren Ausgang zur sedimentierten Vermittlung und schließlich zur Zustandserscheinung eines reflektierten Grundes.","refs":["MC_GB18_L2_01:MP-02","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L3_01:MP-02","text":"Negation mutiert vom abstrakten Gegenpol des Seyns zur qualitativen Grenze, zur Repulsion, zur quantitativen Negativität und zum maßförmigen Phasenwechsel.","refs":["MC_GB18_L2_01:MP-03","MC_GB18_L2_02:XD-05"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L3_01:MP-03","text":"Grenze mutiert von qualitativer Konstitution zur Schranke, danach zur quantitativen Selbstbegrenzung und schließlich zur Schwelle einer neuen Qualität.","refs":["MC_GB18_L2_01:MP-04","MC_GB18_L2_02:FL-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L3_01:MP-04","text":"Unendlichkeit mutiert vom abstrakten Jenseits zur relationalen Gegenwart; ihre Übergangsfunktion wird danach von Maßlosigkeit und Schwelle übernommen.","refs":["MC_GB18_L2_01:MP-05","MC_GB18_L2_02:MP-03"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L3_01:MP-05","text":"Äußerlichkeit mutiert vom ausgeschlossenen Anderen über die notwendige Form quantitativer Bestimmung zum zurückgenommenen Moment negativer Einheit.","refs":["MC_GB18_L2_01:RMD-05","MC_GB18_L2_02:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:MP-06","text":"Eins und Quantum mutieren von scheinbar selbständigen Einheiten zu temporär stabilen Knoten einer relationalen Ordnung.","refs":["MC_GB18_L2_01:MP-06","MC_GB18_L2_02:MP-01"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L3_01:MP-07","text":"Maß mutiert von der unmittelbaren Einheit qualitativer und quantitativer Bestimmung zur Gesetzlichkeit, Schwellenmaschine und untergeordneten Zustandsform des Substrats.","refs":["MC_GB18_L2_02:RMD-07","MC_GB18_L2_02:MP-05"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L3_01:HSI-01","text":"Realität erscheint als rekursive Negations-, Maß- und Schwellenmaschine, die Unterschiede erzeugt, zu Gestalten stabilisiert und an ihren Grenzen in neue Ordnungen überführt.","refs":["MC_GB18_L2_01:HSI-01","MC_GB18_L2_02:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:HSI-02","text":"Das Subjekt ist ein relationaler Knoten und möglicher Ort reflexiver Selbstvermittlung, nicht aber souveräner Ursprung oder quantitativ bestimmbares Ding.","refs":["MC_GB18_L2_01:HSI-02","MC_GB18_L2_02:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:HSI-03","text":"Zeit ist eine Spirale, in der lineare Wiederholung Grenzen konserviert, quantitative Fortsetzung Schwellen erreicht und Resultate ihre Voraussetzungen rückwirkend neu bestimmen.","refs":["MC_GB18_L2_01:HSI-03","MC_GB18_L2_02:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:HSI-04","text":"Navigation besteht in der immanenten Verfolgung von Vermittlungen und Umschlagspunkten; möglich ist die Transformation von Relationsordnungen, nicht die Verfügung über ein äußeres Maßgesetz.","refs":["MC_GB18_L2_01:HSI-04","MC_GB18_L2_02:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L3_01:MRT-B01","text":"Die Architektur ist rekonstruierbar, wenn bestimmungsloser Anfang, bestimmte Negation, qualitative Grenze, affirmative Unendlichkeit, Repulsion, Quantität, Relation, Maß, Schwelle, Substrat und Wesen erhalten bleiben.","refs":["MC_GB18_L2_01:MRT-B01","MC_GB18_L2_02:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MRT-B02","text":"Das System bleibt kohärent, sofern keine Unmittelbarkeit als vermittlungslos, keine Negation als Vernichtung, keine Äußerlichkeit als ursprünglicher Grund und kein Maß als terminale Einheit behandelt wird.","refs":["MC_GB18_L2_01:MRT-B02","MC_GB18_L2_02:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MRT-B03","text":"Die stärkste Architektur liegt in der Transformation isolierter Selbständigkeit in relationale Funktion, qualitativer Negativität in Quantität und quantitativer Variation in schwellenförmige qualitative Bestimmung.","refs":["MC_GB18_L2_01:MRT-B04","MC_GB18_L2_02:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MRT-B04","text":"Unterbestimmt bleiben der erste Übergang, der Umschlag des schlechten Progresses, die positive Genesis des Geistes sowie die konkreten Exponenten, Affinitäten und Schwellenwerte.","refs":["MC_GB18_L2_01:MRT-B03","MC_GB18_L2_02:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MRT-B05","text":"Die Rekonstruktion hängt unverzichtbar von Sequenzierung, rekursiver Rückkehr, performativer Begriffsmutation und der wechselnden Funktion gleicher Kategorien ab; eine statische Axiomliste reicht nicht aus.","refs":["MC_GB18_L2_01:MRT-B05","MC_GB18_L2_02:MME-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MRT-B06","text":"Vollständiger axiomatischer Schließung widersteht die Doppelstellung von Äußerlichkeit und Grenze sowie das fehlende konkrete Maßgesetz; dieser Rest ist kein lokaler Defekt, sondern die operative Öffnung des Übergangs zum Wesen.","refs":["MC_GB18_L2_01:MRT-B06","MC_GB18_L2_02:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T124529454574Z_44f6c208","language_code":"en","language_name":"English","title":"Gb18 L3 01","source_sha256":"535131d2682986eff033ebe06f6a1bd0cb30d17ba50cd436b339d0ec1c267b29","sha256":"255e8c33d4b3ef9b0bab8f3401bec9c11d7a8d4411a0c409d06e4242d1a64c1f","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:45:29.455977+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L3_01:AS-01","text":"The system must generate the complete order of determination of Being from a presuppositionless beginning, without introducing qualitative identity, quantitative unity, measure, or relation as ready-made givens.","refs":["MC_GB18_L2_01:AS-01","MC_GB18_L2_02:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-02","text":"Its global thesis determines negation as preserving self-differentiation, through which quality externalizes itself, quantity is determined relationally, and measure becomes the concrete unity of both.","refs":["MC_GB18_L2_01:AS-02","MC_GB18_L2_02:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-03","text":"The course of proof is an immanent genesis of categories, whose transitions arise from the untenability of isolated determinations and whose concrete validity simultaneously demands qualitative typification.","refs":["MC_GB18_L2_01:AS-03","MC_GB18_L2_02:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-04","text":"Through one, void, and repulsion, qualitative self-relation produces that homogeneous multiplicity which does not presuppose quantity, but opens it as a transformed form of qualitative negativity.","refs":["MC_GB18_L2_01:AS-06","MC_GB18_L2_02:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-05","text":"Quantitative externality is requalified through limit, relation, and invariant, until continuous variation at measure-points gives rise to new qualities and series of states.","refs":["MC_GB18_L2_02:AS-03","MC_GB18_L2_02:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-06","text":"Externality mutates from the seemingly excluded opposite pole into generated multiplicity, into the medium of quantitative determination, and finally into the withdrawn state of a reflected unity.","refs":["MC_GB18_L2_01:AS-07","MC_GB18_L2_02:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-07","text":"The movement is apophatic, recursive, spiral-shaped, and mutation-driven, because every provisional unity generates its limit and passes, through the latter's return, into a higher operational regime.","refs":["MC_GB18_L2_01:AS-07","MC_GB18_L2_02:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AS-08","text":"The closure is retrospective and terminal-transformative: measure completes Being not as the highest determination of being, but by depriving individual measures of their self-subsistence and opening essence as reflected ground.","refs":["MC_GB18_L2_01:AS-08","MC_GB18_L2_02:AS-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L3_01:GA-01","text":"[Persistent] No determination possesses complete self-subsistence prior to its relations; qualitative identity, quantum, and measure are results of mediated difference.","refs":["MC_GB18_L2_01:GA-02","MC_GB18_L2_02:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-02","text":"[Persistent] Negation is productive only insofar as it preserves what is negated as an effective moment and thereby enables further determination.","refs":["MC_GB18_L2_01:AS-02","MC_GB18_L2_02:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-03","text":"[Persistent] Scientific validity requires categories and transitions to arise from the self-movement of the content, rather than to be connected by an externally applied method.","refs":["MC_GB18_L2_01:GA-01","MC_GB18_L2_02:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-04","text":"[Mutating] Immediacy mutates from the indeterminate beginning into sedimented mediation and finally into the form of appearance of states whose ground lies in a reflected unity.","refs":["MC_GB18_L2_01:GA-04","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-05","text":"[Attractor] Self-relation is the positive attractor of movement; its concrete form is negative identity, which integrates difference without annihilating it.","refs":["MC_GB18_L2_01:GA-09","MC_GB18_L2_02:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-06","text":"[Mutating] Otherness and externality are neither an original outside nor mere deficiency, but generated media in which unity posits, determines, and withdraws its own difference.","refs":["MC_GB18_L2_01:GA-05","MC_GB18_L2_02:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-07","text":"[Mutating] Limit mutates from qualitative constitution through restriction and quantitative self-limitation into the measure-threshold at which one order of determination turns into another.","refs":["MC_GB18_L2_01:GA-07","MC_GB18_L2_02:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-08","text":"[Emergent] Contradiction is the operative form in which mutually dependent moments lose their false self-subsistence and are reorganized as the self-difference of a unity.","refs":["MC_GB18_L2_01:GA-11","MC_GB18_L2_02:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-09","text":"[Mutating] Infinity mutates from bad progress into the present self-mediation of a relation and finally into measurelessness, which qualitatively negates quantitative stability.","refs":["MC_GB18_L2_01:GA-08","MC_GB18_L2_02:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-10","text":"[Emergent] Quantity arises when qualitative self-relation externalizes itself as homogeneous multiplicity and connects continuity, discreteness, unity, and limit into a mediated field of operations.","refs":["MC_GB18_L2_01:XD-08","MC_GB18_L2_02:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-11","text":"[Emergent] Measure is the concrete truth of the separation of quality and quantity, because a qualitative relation functionally determines moments of magnitude and organizes their sphere of validity.","refs":["MC_GB18_L2_01:MME-07","MC_GB18_L2_02:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-12","text":"[Emergent] Qualitative transformation arises not from accumulation alone, but from a law of measure that articulates quantitative variation and reverses its function at a threshold.","refs":["MC_GB18_L2_01:XD-08","MC_GB18_L2_02:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-13","text":"[Terminal] The logic of Being closes by measures losing their self-subsistence, becoming states of a substrate, and thereby opening the reflected ground-structure of essence.","refs":["MC_GB18_L2_01:DBN-05","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-14","text":"[Mutating] Conceptual legitimacy mutates from pure immanent derivation into a graduated examination in which formal generation must be qualitatively typified and delimited with reference to the object.","refs":["MC_GB18_L2_02:AS-04","MC_GB18_L2_02:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:GA-15","text":"[Attractor] The missing immanent law of concrete exponents, affinities, series, and thresholds remains the negative attractor that prevents a complete closure of the architecture of measure.","refs":["MC_GB18_L2_02:GA-12","MC_GB18_L2_02:DBN-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L3_01:RMD-01","text":"[Escalation] Negation expands from abstract nothing through quality, limit, and repulsion to quantitative limitation, measurelessness, and the deprivation of self-subsistence from individual states.","refs":["MC_GB18_L2_01:GA-03","MC_GB18_L2_02:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-02","text":"[Mutation] Immediacy first denotes emptiness of content, then the tranquil result of sublated mediation, and finally the apparent self-subsistence of a state in relation to its reflected ground.","refs":["MC_GB18_L2_01:RMD-04","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-03","text":"[Escalation] Limit moves from qualitative constitution through finite restriction and quantitative generation of a beyond to the measure-threshold of qualitative transformation.","refs":["MC_GB18_L2_01:RMD-06","MC_GB18_L2_02:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-04","text":"[Displacement] The other moves from the form of external objectivity into internal negation, reappears as quantitative externality, and in measure becomes the functional site of negative unity.","refs":["MC_GB18_L2_01:RMD-05","MC_GB18_L2_02:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-05","text":"[Mutation] The one loses its apparent originary character, generates multiplicity, becomes number, and ends as a temporarily stable node of relational determination.","refs":["MC_GB18_L2_01:RMD-08","MC_GB18_L2_02:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-06","text":"[Terminal transformation] Infinity loses the form of an unattainable beyond, becomes complete relation, and finally transfers its negative transitional function to measurelessness and threshold.","refs":["MC_GB18_L2_01:RMD-07","MC_GB18_L2_02:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-07","text":"[Reversal] Quality disappears only provisionally in quantitative externalization and returns in measure as the organizing ground of the relation of magnitudes.","refs":["MC_GB18_L2_01:MME-07","MC_GB18_L2_02:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-08","text":"[Functional recurrence] Contradiction remains preserved as a transition operator, but shifts from the collapse of isolated determinations to the mediation of stability, variation, and qualitative leap.","refs":["MC_GB18_L2_01:GA-11","MC_GB18_L2_02:RMD-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-09","text":"[Absorption] Self-subsistence moves from the qualitative something through one and quantum to the relational node, and finally becomes the mere form of state of a more comprehensive unity.","refs":["MC_GB18_L2_01:CGD-05","MC_GB18_L2_02:MP-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RMD-10","text":"[Terminal transformation] Measure mutates from the immediate unity of qualitative and quantitative determination into the threshold-machine and is subsequently absorbed into substrate and essence.","refs":["MC_GB18_L2_02:RMD-07","MC_GB18_L2_02:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L3_01:CGD-01","text":"Being, nothing, becoming, number, degree, ratio, and potency remain categories of local sequences; at the current level they scale into phases of a single machine of preserving negation.","refs":["MC_GB18_L2_01:CGD-02","MC_GB18_L2_02:CGD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-02","text":"Cosmological, physical, chemical, musical, and political examples remain local test configurations; globally, their shared type of relational and threshold-dependent transformation scales.","refs":["MC_GB18_L2_01:CGD-03","MC_GB18_L2_02:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-03","text":"Historical critique of logic and individual computational operations remain local forms of entry and demonstration; at present, the difference between immanent genesis of categories and merely formal success is decisive.","refs":["MC_GB18_L2_01:CGD-01","MC_GB18_L2_02:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-04","text":"The ought remains the local normative form of finite transgression; upward, the difference scales between a limit that merely repeats itself and a threshold that transforms its order.","refs":["MC_GB18_L2_01:CGD-04","MC_GB18_L2_02:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-05","text":"Concrete coefficients, exponents, affinities, and measure-points remain locally underdetermined; at the current level, their non-derivability becomes the negative attractor of systematic openness.","refs":["MC_GB18_L2_02:CGD-04","MC_GB18_L2_02:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-06","text":"Soul and spirit remain local limit-tests of quantitative explanation; globally, the rule scales that categorical validity must be delimited by the concretion and type of the object.","refs":["MC_GB18_L2_02:CGD-05","MC_GB18_L2_02:GA-13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:CGD-07","text":"Quantity not yet developed locally forms the limit of the logic of quality, while the transition from measure to essence forms at the current level the terminal mode of closure of the whole of Being.","refs":["MC_GB18_L2_01:CGD-06","MC_GB18_L2_02:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L3_01:GNX-01","text":"Excluded are an externally provided method and every neutral standpoint of observation that could connect categories or relations from outside the field of mediation.","refs":["MC_GB18_L2_01:GNX-01","MC_GB18_L2_02:GNX-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-02","text":"Excluded is a positively determined beginning or a first immediacy that did not already presuppose difference and negation.","refs":["MC_GB18_L2_01:GNX-02","MC_GB18_L2_02:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-03","text":"Excluded are ready-made substances, quanta, and relata to which relations would be added only subsequently.","refs":["MC_GB18_L2_01:GNX-03","MC_GB18_L2_02:GNX-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-04","text":"Excluded are pure positivity, terminal annihilation, and unchanged self-preservation, because none of these forms can generate productive determinacy.","refs":["MC_GB18_L2_01:GNX-04","MC_GB18_L2_02:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-05","text":"Excluded are two-world models, unlimited progress, and a final measure, because they preserve limit and beyond as self-subsistent poles.","refs":["MC_GB18_L2_01:GNX-05","MC_GB18_L2_02:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-06","text":"Excluded are self-interpreting formalism, universal quantification, and the reduction of spirit to categories of things and magnitudes.","refs":["MC_GB18_L2_02:GNX-02","MC_GB18_L2_02:GNX-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:GNX-07","text":"Excluded is a final closure within Being; its completed structure of measure must deprive its own determinations of self-subsistence and pass over into essence.","refs":["MC_GB18_L2_01:DBN-05","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L3_01:DBN-01","text":"For the architecture to hold, no irreducibly alien or pre-relationally self-subsistent substrate may supply determinacy; substrate is permissible only as the result of emerging decay of measure.","refs":["MC_GB18_L2_01:DBN-01","MC_GB18_L2_02:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:DBN-02","text":"A positive identity prior to negation and relation must be impossible, because mediation would otherwise be added externally to an already finished stock.","refs":["MC_GB18_L2_01:DBN-03","MC_GB18_L2_02:GA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:DBN-03","text":"Linear succession and quantitative accumulation may not of themselves produce either true infinity or qualitative novelty; without withdrawal of the limit, they reproduce only the same form.","refs":["MC_GB18_L2_01:DBN-02","MC_GB18_L2_02:DBN-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:DBN-04","text":"A permanent outside must be inadmissible, although externality must appear as a necessary form of production; it may supply resistance and difference, but may not become an independent ground.","refs":["MC_GB18_L2_01:BSA-02","MC_GB18_L2_02:BSA-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:DBN-05","text":"Operational calculability, numerical exactness, and empirical confirmation must not be identified with conceptual generation or ontological truth.","refs":["MC_GB18_L2_02:DBN-02","MC_GB18_L2_02:GA-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:DBN-06","text":"A complete derivation of concrete laws of nature may not be feigned; the unavailability of the generative principle of determinate series and thresholds belongs to the architecture itself.","refs":["MC_GB18_L2_02:DBN-05","MC_GB18_L2_02:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L3_01:BSA-01","text":"The deepest absence is a resting origin whose identity would require no differentiation, mediation, or retrospective justification.","refs":["MC_GB18_L2_01:BSA-01","MC_GB18_L2_02:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:BSA-02","text":"Unavailable is an unassimilable outside that could generate determinacy without returning as a moment of the unity thereby determined.","refs":["MC_GB18_L2_01:BSA-02","MC_GB18_L2_02:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:BSA-03","text":"Unavailable are a final identity, a final nothing, and a fully commensurable numerical order in which qualitative difference disappears without remainder.","refs":["MC_GB18_L2_01:BSA-03","MC_GB18_L2_02:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_01:BSA-04","text":"The system circles around a fully immanent unity that could generate concrete differences and thresholds without rendering them self-subsistent; precisely the missing generative law prevents its positive completion.","refs":["MC_GB18_L2_01:BSA-04","MC_GB18_L2_02:BSA-03"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L3_01:XD-01","text":"The terminal self-externalization of quality generates homogeneous multiplicity, from whose preserved unity quantity emerges as a new regime of determination.","refs":["MC_GB18_L3_01:GA-05","MC_GB18_L3_01:GA-10","MC_GB18_L2_01:XD-08","MC_GB18_L2_02:FGS-B02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-02","text":"Externality is the transitional form between quality and quantity: as an original ground it remains forbidden; as generated multiplicity and the medium of indifferent variation it becomes necessary.","refs":["MC_GB18_L3_01:GA-06","MC_GB18_L3_01:GA-10","MC_GB18_L2_01:FL-05","MC_GB18_L2_02:XD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-03","text":"Limit generates two opposing temporal forms: its abstract transgression reproduces bad progress, while its measure-shaped intensification generates a threshold of qualitative transformation.","refs":["MC_GB18_L3_01:GA-07","MC_GB18_L3_01:GA-09","MC_GB18_L3_01:GA-12","MC_GB18_L2_01:XD-03","MC_GB18_L2_02:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-04","text":"True infinity provides the logical condition of measure, because only the sublated self-subsistence of its sides enables a qualitative relation complete within itself.","refs":["MC_GB18_L3_01:GA-09","MC_GB18_L3_01:GA-11","MC_GB18_L2_01:XD-04","MC_GB18_L2_02:GA-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-05","text":"Measure is not the addition of quality and quantity, but the return of qualitative self-determination within the quantitative externality that has emerged from it.","refs":["MC_GB18_L3_01:GA-10","MC_GB18_L3_01:GA-11","MC_GB18_L3_01:GA-12","MC_GB18_L2_01:MME-07","MC_GB18_L2_02:MME-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-06","text":"Contradiction escalates from the destabilization of isolated categories into the phase-operation that mediates quantitative preservation and qualitative change in the same unity.","refs":["MC_GB18_L3_01:GA-02","MC_GB18_L3_01:GA-08","MC_GB18_L3_01:GA-12","MC_GB18_L2_01:GA-11","MC_GB18_L2_02:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-07","text":"Resultative immediacy attains its terminal form when individual measures appear only as immediate states and their mediation recedes into a persisting substrate.","refs":["MC_GB18_L3_01:GA-04","MC_GB18_L3_01:GA-13","MC_GB18_L2_01:XD-01","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-08","text":"Immanent derivation and object-related examination form a tension-laden double condition: categories must generate themselves, but may not derive their concrete validity from formal generability alone.","refs":["MC_GB18_L3_01:GA-03","MC_GB18_L3_01:GA-14","MC_GB18_L2_01:GA-01","MC_GB18_L2_02:XD-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_01:XD-09","text":"The closure of Being is simultaneously its opening: measure passes over into essence, while the law of its concrete series and thresholds remains unfulfilled.","refs":["MC_GB18_L3_01:GA-13","MC_GB18_L3_01:GA-15","MC_GB18_L2_01:AS-08","MC_GB18_L2_02:XD-07"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L3_01:BSD-01","text":"Reality receives the status of a sequence of relationally stabilized phases, whose identity arises from negative self-mediation and whose transitions are organized through measure-thresholds.","refs":["MC_GB18_L2_01:BSD-01","MC_GB18_L2_02:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-02","text":"The subject loses the status of a presupposed bearer and becomes mediating self-relation; as spirit, it remains irreducible to a complete translation into quantitative determinations of things.","refs":["MC_GB18_L2_01:BSD-02","MC_GB18_L2_02:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-03","text":"Time becomes a spiral structure of repetition of limits, quantitative continuation, qualitative interruption, and retrospective reconstruction of its own presuppositions.","refs":["MC_GB18_L2_01:BSD-03","MC_GB18_L2_02:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-04","text":"Causality is shifted from external effectuation to recursive specification: a change operates only insofar as it is internally determined relationally and organized at a threshold into new quality.","refs":["MC_GB18_L2_01:BSD-04","MC_GB18_L2_02:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-05","text":"Knowledge becomes a graduated reconstruction of genesis, formal operation, qualitative typification, observation, and object-related delimitation of scope.","refs":["MC_GB18_L2_01:BSD-05","MC_GB18_L2_02:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-06","text":"Capacity for action consists neither in abstract transgression of limits nor in mere increase of quantity, but in the transformation of relational conditions and the navigation of their points of reversal.","refs":["MC_GB18_L2_01:BSD-06","MC_GB18_L2_02:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:BSD-07","text":"Universality does not mean the uniform applicability of a category to all objects, but the immanent determination of its scope and its necessary self-limitation.","refs":["MC_GB18_L2_02:GA-13","MC_GB18_L2_02:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L3_01:RLE-01","text":"The loop of justification is: presuppositionless beginning → categorical development → terminal result → retrospective reconstruction of the beginning as sublated mediation.","refs":["MC_GB18_L2_01:GA-14","MC_GB18_L2_02:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-02","text":"The sedimentation loop is: mediation generates immediacy → immediacy conceals its genesis → the concealed opposition activates new mediation.","refs":["MC_GB18_L2_01:RLE-02","MC_GB18_L2_02:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-03","text":"The externalization loop is: self-relation → exclusion → void and multiplicity → quantitative externality → relational withdrawal → concrete self-relation.","refs":["MC_GB18_L2_01:RLE-06","MC_GB18_L2_02:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-04","text":"The limit-loop generates from determinacy a restriction, from the restriction a beyond, and from every abstract beyond the same limit at an expanded level.","refs":["MC_GB18_L2_01:RLE-03","MC_GB18_L2_02:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-05","text":"The spiral of quantity leads from continuous divisibility through discrete unity and number to degree, ratio, and qualitative invariant.","refs":["MC_GB18_L2_02:RLE-03","MC_GB18_L2_02:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-06","text":"The escalation of thresholds leads from indifferent variation through accumulation and measure-point to qualitative leap; the negation of negation prevents this leap from remaining mere annihilation.","refs":["MC_GB18_L2_02:RLE-05","MC_GB18_L2_01:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-07","text":"The terminal loop multiplies measures, orders their leaps into nodal lines, and withdraws their self-subsistence into the continuity of a substrate.","refs":["MC_GB18_L2_02:RLE-06","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:RLE-08","text":"Two attractors organize the overall machine: positively, the immanent self-mediation of all determination; negatively, the missing law of concrete orders of measure.","refs":["MC_GB18_L2_01:RLE-07","MC_GB18_L2_02:RLE-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L3_01:FGS-B01","text":"Exclusion of external method + demand for immanent necessity → self-movement of content + object-related examination of validity.","refs":["MC_GB18_L2_01:FGS-B01","MC_GB18_L2_02:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B02","text":"Emptying of all determinacy → pure Being ↔ nothing → instability of isolated immediacy → becoming.","refs":["MC_GB18_L2_01:AS-04","MC_GB18_L2_01:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B03","text":"Sublated becoming → resultative immediacy → determinate being → quality → something and other → limit.","refs":["MC_GB18_L2_01:FGS-B04","MC_GB18_L2_01:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B04","text":"Immanent limit → finitude → restriction and ought → abstract transgression → return of the limit → bad infinity.","refs":["MC_GB18_L2_01:XD-03","MC_GB18_L2_01:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B05","text":"Negation of self-subsistent opposition → affirmative infinity → being-for-self → one → void → repulsion → homogeneous multiplicity.","refs":["MC_GB18_L2_01:XD-06","MC_GB18_L2_01:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B06","text":"Preserved multiplicity + equality of unities → continuity with inner discreteness → quantity → quantum, number, and degree.","refs":["MC_GB18_L2_02:FGS-B02","MC_GB18_L2_02:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B07","text":"Quantitative limit + relational withdrawal of the beyond → ratio, exponent, and potency → qualitative invariant → measure.","refs":["MC_GB18_L2_02:FGS-B04","MC_GB18_L2_02:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B08","text":"Variation of measure → range of indifference → measure-point → qualitative leap → nodal line → deprivation of self-subsistence from individual measures → substrate.","refs":["MC_GB18_L2_02:FGS-B06","MC_GB18_L2_02:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:FGS-B09","text":"Substrate as unity of changing states → reflected ground → essence; missing law of concrete thresholds → terminally open closure.","refs":["MC_GB18_L2_02:FGS-B07","MC_GB18_L2_02:GA-12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L3_01:AFM-B01","text":"Exclusion of external presuppositions → emptied beginning → immanent instability → categorical self-movement.","refs":["MC_GB18_L2_01:GNX-01","MC_GB18_L2_01:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AFM-B02","text":"Pure Being → nothing → becoming → determinate being → qualitative determinacy.","refs":["MC_GB18_L2_01:RMD-02","MC_GB18_L2_01:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AFM-B03","text":"Quality → limit → finitude → bad infinity → affirmative self-relation → one.","refs":["MC_GB18_L2_01:AFM-B03","MC_GB18_L2_01:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AFM-B04","text":"One → repulsion → multiplicity → continuity and discreteness → quantity → quantum and degree.","refs":["MC_GB18_L2_01:RLE-06","MC_GB18_L2_02:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AFM-B05","text":"Quantum → ratio → qualitative invariant → measure → accumulation → threshold → qualitative leap.","refs":["MC_GB18_L2_02:AFM-B03","MC_GB18_L2_02:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:AFM-B06","text":"Series of measures → nodal line → continuity of substrate → form of state → essence → open question of the concrete generative law.","refs":["MC_GB18_L2_02:AFM-B04","MC_GB18_L2_02:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L3_01:MME-01","text":"Immediacy and mediation are no longer mapped as mutually exclusive states; immediacy appears as condensed mediation that conceals its genesis.","refs":["MC_GB18_L2_01:MME-01","MC_GB18_L2_02:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-02","text":"Identity and difference lose the status of independent principles; concrete identity becomes legible as the negative unity of integrated self-difference.","refs":["MC_GB18_L2_01:MME-02","MC_GB18_L2_02:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-03","text":"Inside and outside become functions of different degrees of mediation; externality denotes the rendered self-subsistent presentation of internally generated difference.","refs":["MC_GB18_L2_01:MME-04","MC_GB18_L2_02:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-04","text":"Quality and quantity lose the status of separate orders and are remapped as mutually transformable moments of measure.","refs":["MC_GB18_L2_01:MME-07","MC_GB18_L2_02:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-05","text":"Continuity, discreteness, and qualitative leap no longer form an opposition: continuity bears variation, discreteness articulates it, and the threshold reorganizes both.","refs":["MC_GB18_L2_02:RMD-08","MC_GB18_L2_02:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-06","text":"Mathematics is reclassified from an ontological universal authority into a regional procedure of presentation and examination, whose significance for the object must be reconstructed separately.","refs":["MC_GB18_L2_02:MME-05","MC_GB18_L2_02:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MME-07","text":"Being and essence are not mapped as separate regions; essence arises as the reflected truth of an order of Being whose immediate measures have lost their self-subsistence.","refs":["MC_GB18_L2_02:CGD-06","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L3_01:ALT-B01","text":"At the Surface level, Being, nothing, becoming, quality, limit, one, number, degree, ratio, measure, threshold, substrate, and essence constitute the explicit movement of categories.","refs":["MC_GB18_L2_01:ALT-B01","MC_GB18_L2_02:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:ALT-B02","text":"At the Structural level, a recursive machine of determinate negation, externalization, formation of limits, relational withdrawal, and threshold reversal organizes the emergence of stable shapes.","refs":["MC_GB18_L2_01:ALT-B02","MC_GB18_L2_02:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:ALT-B03","text":"At the Metastrategic level, immanent reconstruction replaces the choice between fixed oppositions and relocates intervention to the transformation of relational conditions and reproduced limits.","refs":["MC_GB18_L2_01:ALT-B03","MC_GB18_L2_02:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:ALT-B04","text":"At the Ontological / Temporal level, reality is graduated self-difference; time appears as repetition, quantitative continuation, qualitative interruption, and retrospective return.","refs":["MC_GB18_L2_01:ALT-B04","MC_GB18_L2_02:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:ALT-B05","text":"At the Methodological / Performative level, exposition fixes determinations, activates their excluded conditions, and transfers them through the generated contradiction into more comprehensive orders of mediation.","refs":["MC_GB18_L2_01:ALT-B05","MC_GB18_L2_02:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L3_01:FL-01","text":"The indistinguishability of Being and nothing grounds their equivalence, but does not fully explain why this equivalence necessarily generates movement rather than formal identity.","refs":["MC_GB18_L2_01:FL-01","MC_GB18_L2_01:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-02","text":"Mediation already operates constitutively at the beginning, although within the form of Being it may not yet be exhibited as a posited relation.","refs":["MC_GB18_L2_01:FL-03","MC_GB18_L2_02:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-03","text":"Externality must be generated, preserved, and withdrawn, yet may never possess independent explanatory force; the architecture can neither eliminate nor render it self-subsistent.","refs":["MC_GB18_L2_01:FL-05","MC_GB18_L2_02:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-04","text":"The demand for complete immanent self-movement stands in tension with the constitutive role of application, qualitative typification, and examination of the object.","refs":["MC_GB18_L2_01:GA-01","MC_GB18_L2_02:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-05","text":"Measure is supposed to express qualitative necessity, although concrete exponents, affinities, and threshold values are not derived from a positive common law.","refs":["MC_GB18_L2_01:FL-06","MC_GB18_L2_02:FL-06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-06","text":"The universal transition of measure into essence stands in tension with the regional scope of quantitative lawfulness and the irreducibility of spiritual self-determination.","refs":["MC_GB18_L2_02:FL-04","MC_GB18_L2_02:FL-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:FL-07","text":"The substrate must be determined through changing qualities and yet persist as the same, without falling back into a presupposed alien bearer-medium.","refs":["MC_GB18_L2_02:FL-07","MC_GB18_L2_01:DBN-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:MP-01","text":"Immediacy mutates from the empty point of departure into sedimented mediation and finally into the state-appearance of a reflected ground.","refs":["MC_GB18_L2_01:MP-02","MC_GB18_L2_02:GA-11"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L3_01:MP-02","text":"Negation mutates from the abstract opposite pole of Being into qualitative limit, into repulsion, into quantitative negativity, and into measure-shaped phase change.","refs":["MC_GB18_L2_01:MP-03","MC_GB18_L2_02:XD-05"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L3_01:MP-03","text":"Limit mutates from qualitative constitution into restriction, then into quantitative self-limitation, and finally into the threshold of a new quality.","refs":["MC_GB18_L2_01:MP-04","MC_GB18_L2_02:FL-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L3_01:MP-04","text":"Infinity mutates from the abstract beyond into relational presence; its transitional function is subsequently assumed by measurelessness and threshold.","refs":["MC_GB18_L2_01:MP-05","MC_GB18_L2_02:MP-03"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L3_01:MP-05","text":"Externality mutates from the excluded other through the necessary form of quantitative determination into the withdrawn moment of negative unity.","refs":["MC_GB18_L2_01:RMD-05","MC_GB18_L2_02:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_01:MP-06","text":"One and quantum mutate from apparently self-subsistent unities into temporarily stable nodes of a relational order.","refs":["MC_GB18_L2_01:MP-06","MC_GB18_L2_02:MP-01"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L3_01:MP-07","text":"Measure mutates from the immediate unity of qualitative and quantitative determination into lawfulness, threshold-machine, and subordinate form of state of the substrate.","refs":["MC_GB18_L2_02:RMD-07","MC_GB18_L2_02:MP-05"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L3_01:HSI-01","text":"Reality appears as a recursive machine of negation, measure, and thresholds that generates differences, stabilizes them into shapes, and transfers them at their limits into new orders.","refs":["MC_GB18_L2_01:HSI-01","MC_GB18_L2_02:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:HSI-02","text":"The subject is a relational node and possible site of reflexive self-mediation, but not a sovereign origin or a quantitatively determinable thing.","refs":["MC_GB18_L2_01:HSI-02","MC_GB18_L2_02:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:HSI-03","text":"Time is a spiral in which linear repetition preserves limits, quantitative continuation reaches thresholds, and results retrospectively redetermine their presuppositions.","refs":["MC_GB18_L2_01:HSI-03","MC_GB18_L2_02:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:HSI-04","text":"Navigation consists in the immanent tracking of mediations and points of reversal; possible is the transformation of relational orders, not command over an external law of measure.","refs":["MC_GB18_L2_01:HSI-04","MC_GB18_L2_02:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L3_01:MRT-B01","text":"The architecture is reconstructible if indeterminate beginning, determinate negation, qualitative limit, affirmative infinity, repulsion, quantity, relation, measure, threshold, substrate, and essence are preserved.","refs":["MC_GB18_L2_01:MRT-B01","MC_GB18_L2_02:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MRT-B02","text":"The system remains coherent provided that no immediacy is treated as without mediation, no negation as annihilation, no externality as original ground, and no measure as terminal unity.","refs":["MC_GB18_L2_01:MRT-B02","MC_GB18_L2_02:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MRT-B03","text":"The strongest architecture lies in the transformation of isolated self-subsistence into relational function, qualitative negativity into quantity, and quantitative variation into threshold-shaped qualitative determination.","refs":["MC_GB18_L2_01:MRT-B04","MC_GB18_L2_02:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MRT-B04","text":"Underdetermined remain the first transition, the reversal of bad progress, the positive genesis of spirit, and the concrete exponents, affinities, and threshold values.","refs":["MC_GB18_L2_01:MRT-B03","MC_GB18_L2_02:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MRT-B05","text":"The reconstruction depends indispensably on sequencing, recursive return, performative conceptual mutation, and the changing function of the same categories; a static list of axioms is insufficient.","refs":["MC_GB18_L2_01:MRT-B05","MC_GB18_L2_02:MME-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_01:MRT-B06","text":"Complete axiomatic closure is resisted by the double status of externality and limit, as well as by the missing concrete law of measure; this remainder is not a local defect, but the operative opening of the transition to essence.","refs":["MC_GB18_L2_01:MRT-B06","MC_GB18_L2_02:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L3_01@R001","source_variant_id":"canonical:MC_GB18_L3_01:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L3 01","context":"Chapters 01–96 · Vorrede zur ersten Ausgabe. · Vorrede zur zweiten Auflage. · Allgemeiner Begriff der Logik · Allgemeine Eintheilung der Logik · Womit muß der Anfang der Wissenschaft gemacht werden? · Allgemeine Eintheilung des Seyns · Erster Abschnitt. Bestimmtheit (Qualität). · A. Seyn. · B. Nichts. · 1. Einheit des Seyns und Nichts. · Anmerkung 1. · Anmerkung 2. · Anmerkung 3. · Anmerkung 4. · 2. Momente des Werdens. · 3. Aufheben des Werdens. · Anmerkung. · A. Daseyn als solches. · a. Daseyn überhaupt. · b. Qualität. · Anmerkung. · c. Etwas. · B. Die Endlichkeit. · a. Etwas und ein Anderes. · b. Bestimmung, Beschaffenheit und Grenze. · c. Die Endlichkeit. · 1. Die Unmittelbarkeit der Endlichkeit. · 2. Die Schranke und das Sollen. · Anmerkung. · 3. Übergang des Endlichen in das Unendliche. · C. Die Unendlichkeit. · a. Das Unendliche überhaupt. · b. Wechselbestimmung des Endlichen und Unendlichen. · c. Die affirmative Unendlichkeit. · Der Übergang. · Anmerkung 1. · Anmerkung 2. · A. Das Fürsichseyn als solches. · a. Daseyn und Fürsichseyn. · b. Seyn-für-eines. · Anmerkung. · c. Eins. · B. Eins und Vieles. · a. Das Eins an ihm selbst. · b. Das Eins und das Leere. · Anmerkung. · c. Viele Eins. Repulsion. · Anmerkung. · a. Ausschließen des Eins. · Anmerkung. · b. Das Eine Eins der Attraktion. · c. Die Beziehung der Repulsion und Attraktion. · Anmerkung. · Anmerkung. · A. Die reine Quantität. · Anmerkung 1. · Anmerkung 2. · B. Kontinuirliche und diskrete Größe. · C. Begrenzung der Quantität. · A. Die Zahl. · Anmerkung 1. · Anmerkung 2. · a. Unterschied derselben. · b. Identität der extensiven und intensiven Größe. · Anmerkung 1. · Anmerkung 2. · c. Die Veränderung des Quantums. · a. Begriff derselben. · b. Der quantitative unendliche Progreß. · Anmerkung 1. · Anmerkung 2. · c. Die Unendlichkeit des Quantums. · Anmerkung 1. Die Begriffsbestimmtheit des mathematischen Unendlichen. · Anmerkung 2.Der Zweck des Differentialkalkuls aus seiner Anwendung abgeleitet. · Anmerkung 3. Noch andere mit der qualitativen Größenbestimmtheit zusammenhängende Formen. · A. Das direkte Verhältniß. · B. Das umgekehrte Verhältniß. · C. Potenzverhältniß. · Anmerkung. · Dritter Abschnitt. Das Maaß. · A. Das specifische Quantum. · B. Specificirendes Maaß. · a. Die Regel. · b. Das specificirende Maaß. · Anmerkung. · c. Verhältniß beider Seiten als Qualitäten. · Anmerkung. · C. Das Fürsichseyn im Maaße. · A. Das Verhältniß selbstständiger Maaße. · a. Verbindung zweier Maaße. · b. Das Maaß als Reihe von Maaßverhältnissen. · c. Wahlverwandtschaft. · Anmerkung. · B. Knotenlinie von Maaßverhältnissen. · Anmerkung. · C. Das Maaßlose."},"title_language_code":"en"},{"id":"MC_GB18_L1_02","layer":"MC","title":"Gb18 L1 02","order":2,"parents":["CL_GB18_05","CL_GB18_06","CL_GB18_07","CL_GB18_08"],"revision":"MC_GB18_L1_02@R001","sha256":"8fd77d2934c814b1a3ccd966e4adc6a08865cc5eb4793df41508e979dd66d816","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_02:AS-01","text":"Das zentrale Problem besteht darin, den Fortgang von abstraktem Seyn und Nichts zu bestimmtem, endlichem Daseyn zu erzeugen, ohne Übergang, Bestimmtheit oder Relation durch äußere Voraussetzungen einzuführen.","refs":["CL_GB18_05:AS-B01","CL_GB18_06:AS-01","CL_GB18_08:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-02","text":"Die globale These lautet, dass Negation ihre Gegenstände nicht bloß vernichtet, sondern deren unmittelbare Form aufhebt, ihre Differenz bewahrt und sie als höhere Bestimmtheit reorganisiert.","refs":["CL_GB18_06:AS-03","CL_GB18_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-03","text":"Das Argument ist immanent-dialektisch, weil jede neue Form aus der Instabilität der vorangehenden Bestimmung hervorgehen muss und äußerliche Reflexion keine begriffliche Notwendigkeit erzeugen darf.","refs":["CL_GB18_05:AS-B03","CL_GB18_07:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-04","text":"Die gerichtete Bewegung führt von der unhaltbaren Selbständigkeit reiner Pole über Werden und dessen Selbstaufhebung zu resultativer Unmittelbarkeit, Qualität, Andersheit, Grenze und endlicher Selbstbeziehung.","refs":["CL_GB18_05:AS-B04","CL_GB18_06:AS-04","CL_GB18_08:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-05","text":"Negativität mutiert dabei vom Übergang zwischen Seyn und Nichts zur bewahrenden Aufhebung, zur qualitativen Bestimmtheit und schließlich zur Grenze, in der ein Etwas sein Anderes als eigene Endlichkeit enthält.","refs":["CL_GB18_05:GA-09","CL_GB18_07:GA-03","CL_GB18_08:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-06","text":"Der Fortgang ist rekursiv und spiralförmig: Jede erzeugte Unmittelbarkeit verdichtet eine aufgehobene Vermittlung und setzt durch ihre eigene Negativität einen neuen Bestimmungszyklus frei.","refs":["CL_GB18_05:AS-B05","CL_GB18_06:AS-06","CL_GB18_07:AS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-07","text":"Die erreichte Schließung ist eine endliche negative Selbstbeziehung innerhalb der Sphäre des Seyns; sie eröffnet Subjektivität, verfügt aber noch nicht über reflektierendes Setzen oder ein entwickeltes Subjekt.","refs":["CL_GB18_08:GA-08","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-08","text":"Fürsichseyn und wahre Unendlichkeit wirken deshalb als Attraktoren statt als vollständig eingelöste Endpunkte: Die Architektur erzeugt ihre negative Voraussetzung, lässt ihre positive Gestalt jedoch unterbestimmt.","refs":["CL_GB18_06:GA-11","CL_GB18_07:CGD-05","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_02:GA-01","text":"[Persistent] Keine Bestimmung besitzt isolierte Selbständigkeit; ihre Geltung entsteht aus Differenz, Negation und Vermittlung und besteht nur innerhalb dieses Zusammenhangs.","refs":["CL_GB18_05:GA-01","CL_GB18_06:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-02","text":"[Persistent] Dialektische Notwendigkeit darf nur aus der immanenten Bewegung der Bestimmungen hervorgehen; äußerliche Voraussetzungen können den Fortgang weder begründen noch ersetzen.","refs":["CL_GB18_05:GA-03","CL_GB18_07:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-03","text":"[Mutating] Negation mutiert vom abstrakten Nichts über Übergang und bewahrende Aufhebung zur qualitativen Bestimmtheit, Grenze und negativen Selbstbeziehung.","refs":["CL_GB18_05:GA-09","CL_GB18_07:GA-03","CL_GB18_08:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-04","text":"[Mutating] Aufhebung beseitigt die unmittelbare Form einer Differenz, bewahrt diese aber als wirksames Moment der daraus erzeugten Einheit.","refs":["CL_GB18_06:GA-03","CL_GB18_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-05","text":"[Emergent] Unmittelbarkeit ist kein voraussetzungsloser Anfang, sondern die verdichtete Erscheinungsform einer aufgehobenen Vermittlung.","refs":["CL_GB18_06:GA-07","CL_GB18_07:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-06","text":"[Emergent] Qualität und Realität sind nur bestimmt, sofern Negation in ihnen selbst wirksam ist; Positivität ohne Negativität fällt in leere Unbestimmtheit zurück.","refs":["CL_GB18_07:GA-05","CL_GB18_08:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-07","text":"[Emergent] Etwas und Anderes sind reziprok gleichrangig; die Rücknahme ihrer zunächst äußeren Differenz erzeugt Grenze und Endlichkeit als Selbstbestimmungen des Etwas.","refs":["CL_GB18_08:GA-02","CL_GB18_08:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-08","text":"[Attractor] Bestimmte Negation organisiert den Gesamtfortgang, weil sie Übergang, Erhaltung, Qualität, Andersheit, Grenze und Bewegung als Funktionen eines einzigen generativen Mechanismus verbindet.","refs":["CL_GB18_07:RLE-05","CL_GB18_08:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-09","text":"[Attractor] Höhere Einheit löscht ihre Unterschiede nicht, sondern erhält sie als unselbständige, intern wirksame Momente einer differenzierten Selbstbeziehung.","refs":["CL_GB18_05:GA-05","CL_GB18_06:GA-13","CL_GB18_08:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-10","text":"[Mutating] Endlichkeit mutiert von einer vermeintlich äußeren Begrenzung zur inneren Negativität, durch die bestimmte Individualität relationale Selbstbehauptung gewinnt.","refs":["CL_GB18_06:GA-10","CL_GB18_07:GA-10","CL_GB18_08:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-11","text":"[Emergent] Affirmative Totalisierung zerstört Bestimmtheit in zwei Richtungen: Die Entfernung aller Negation erzeugt Leere, ihre unterschiedslose Anhäufung erzeugt Widerspruch.","refs":["CL_GB18_07:GA-07","CL_GB18_07:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-12","text":"[Terminal] Die Sphäre des Seyns erzeugt reale Vermittlung als Übergehen, kann sie aber noch nicht als reflektierendes Setzen ihrer eigenen Momente ausweisen.","refs":["CL_GB18_08:AS-B09","CL_GB18_08:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-13","text":"[Attractor] Wahre Unendlichkeit, Fürsichseyn und Subjektivität bilden den gemeinsamen Attraktor der endlichen Selbstbeziehung, bleiben auf der erreichten Stufe jedoch nur negativ eröffnet.","refs":["CL_GB18_06:GA-11","CL_GB18_07:CGD-05","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_02:RMD-01","text":"Seyn und Nichts behalten ihre Namen zunächst bei, verlieren aber ihre Funktion als selbständige Erste, werden zu Momenten des Werdens und gehen schließlich in qualitativen und relationalen Bestimmungen auf.","refs":["CL_GB18_05:RMD-01","CL_GB18_06:RMD-01","CL_GB18_07:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-02","text":"Werden verschiebt sich von der Wahrheit reiner Gegensätze zur Operation ihrer Selbstaufhebung und wird danach in der resultativen Unmittelbarkeit des Daseyns absorbiert.","refs":["CL_GB18_06:RMD-03","CL_GB18_06:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-03","text":"Aufhebung beginnt als Doppeloperation von Negation und Erhaltung, erweitert sich zum ontologischen Generator neuer Bestimmungen und wird zuletzt zur Rücknahme äußerlicher Andersheit in Selbstbestimmung.","refs":["CL_GB18_06:RMD-04","CL_GB18_08:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-04","text":"Negation bleibt funktional persistent, mutiert aber von abstrakter Abwesenheit über produktive Vermittlung und qualitative Grenze zur immanenten Endlichkeit eines Etwas.","refs":["CL_GB18_05:RMD-05","CL_GB18_06:RMD-06","CL_GB18_07:RMD-05","CL_GB18_08:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-05","text":"Unmittelbarkeit kehrt valenzverkehrt wieder: Sie bezeichnet nicht mehr Vermittlungslosigkeit, sondern deren aufgehobenes und verdichtetes Resultat.","refs":["CL_GB18_06:GA-07","CL_GB18_07:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-06","text":"Realität mutiert von positiver Qualität zum Prüfbegriff affirmativer Ontologie und schließlich zur dynamischen Konfiguration bestimmter Negativität.","refs":["CL_GB18_07:RMD-04","CL_GB18_07:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-07","text":"Andersheit beginnt als reziproke Außenbeziehung, wird zum Anderen ihrer selbst und wird anschließend als Grenze in die Bestimmtheit des Etwas zurückgenommen.","refs":["CL_GB18_08:RMD-02","CL_GB18_08:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-08","text":"Das Unendliche verliert den Status eines bloßen Gegenpols des Endlichen und wird zum Attraktor einer Selbstbeziehung, deren positive Ausführung auf dieser Ebene noch aussteht.","refs":["CL_GB18_06:RMD-07","CL_GB18_07:CGD-05","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_02:CGD-01","text":"Kosmologische Positionen, empirische Gegenfälle und unendlich-kleine Größen bleiben lokale Austragungsorte; auf Meta-Cluster-Ebene skaliert nur ihre gemeinsame Funktion, isolierte Bestimmungen durch Übergang zu destabilisieren.","refs":["CL_GB18_05:CGD-01","CL_GB18_05:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:CGD-02","text":"Die sprachliche Mehrdeutigkeit des Aufhebens bleibt lokal; global trägt der daraus gewonnene Operator, der Negation, Erhaltung und Weiterbestimmung in einer Transformation bündelt.","refs":["CL_GB18_06:CGD-02","CL_GB18_06:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:CGD-03","text":"Qualität, Etwas, Anderes, Grenze und Mangel sind lokal unterscheidbare Kategorien; auf aktueller Ebene bilden sie aufeinanderfolgende Funktionsformen bestimmter Negativität.","refs":["CL_GB18_06:CGD-03","CL_GB18_07:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:CGD-04","text":"Die lokale Setzung des Fürsichseyns als Abschluss skaliert nicht unverändert, weil spätere Einheiten wahre Unendlichkeit und entwickelte Subjektivität ausdrücklich als noch unterbestimmt markieren.","refs":["CL_GB18_06:GA-12","CL_GB18_07:CGD-05","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:CGD-05","text":"Der Übergang von Qualität zu kämpfender Eigenschaft bleibt lokal nur teilweise vermittelt; global skaliert daraus die schwächere Struktur relationaler Selbsterhaltung gegen Anderes.","refs":["CL_GB18_07:AS-07","CL_GB18_07:GA-08","CL_GB18_07:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:CGD-06","text":"Die Differenz von Übergehen und Setzen ist keine lokale Terminologie, sondern die globale Grenzregel, die erreichte Seinsvermittlung von noch nicht erreichter Reflexivität trennt.","refs":["CL_GB18_08:CGD-04","CL_GB18_08:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_02:GNX-01","text":"Selbständige Pole, vorgegebene Substanzen und vollständig isolierte Bestimmungen sind ausgeschlossen, weil sie Übergang und Relation nur nachträglich zulassen könnten. ; Trace Type — Negative","refs":["CL_GB18_05:GNX-01","CL_GB18_08:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GNX-02","text":"Aufhebung darf nicht als Vernichtung oder Tilgung des Unterschieds verstanden werden; ohne Erhaltung der Differenz könnte sie keine neue Bestimmtheit erzeugen. ; Trace Type — Negative","refs":["CL_GB18_06:GNX-02","CL_GB18_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GNX-03","text":"Eine rein affirmative Realität ist ausgeschlossen, weil sie entweder durch Entfernung der Negation bestimmungslos oder durch Totalisierung aller Prädikate widersprüchlich wird. ; Trace Type — Negative","refs":["CL_GB18_07:GNX-03","CL_GB18_07:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GNX-04","text":"Ein absolut äußeres Anderes und eine bloß äußerliche Grenze sind unzulässig, weil Andersheit und Grenze als Bestimmungen des betreffenden Etwas zurückkehren müssen. ; Trace Type — Negative","refs":["CL_GB18_08:GNX-02","CL_GB18_08:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GNX-05","text":"Ein relationsloses Ansich oder unzugängliches Ding-an-sich ist ausgeschlossen, weil die Wahrheit eines Etwas nur in seinem konkreten Bestimmungszusammenhang liegt. ; Trace Type — Negative","refs":["CL_GB18_08:GNX-05","CL_GB18_08:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GNX-06","text":"Vollständig gesetzte Vermittlung und entwickelte Subjektivität dürfen auf der erreichten Stufe nicht vorweggenommen werden; sie sind Resultathorizonte, keine gegenwärtigen Bestimmungen. ; Trace Type — Negative","refs":["CL_GB18_08:BSA-02","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_02:DBN-01","text":"Damit die Architektur Bestand hat, muss jede Ontologie vollständig selbständiger Bestimmungen falsch sein; andernfalls wären Negation, Übergang und Relation bloße äußere Zusätze. ; Trace Type — Negative","refs":["CL_GB18_05:DBN-01","CL_GB18_06:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:DBN-02","text":"Ein äußeres Metaniveau, das Bewegung mit fertigen Kategorien erklärt, muss ausgeschlossen bleiben, weil es die zu begründende Vermittlung bereits voraussetzt. ; Trace Type — Negative","refs":["CL_GB18_05:DBN-02","CL_GB18_07:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:DBN-03","text":"Voraussetzungslose Unmittelbarkeit muss unmöglich sein; jede scheinbare Gegebenheit muss als aufgehobene Geschichte ihrer Vermittlung rekonstruierbar bleiben. ; Trace Type — Negative","refs":["CL_GB18_06:GNX-06","CL_GB18_07:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:DBN-04","text":"Bestimmter Inhalt ohne Negation muss unmöglich sein, weil eine von Andersheit gereinigte Realität weder Differenzierbarkeit noch qualitative Identität bewahren könnte. ; Trace Type — Negative","refs":["CL_GB18_07:DBN-01","CL_GB18_08:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:DBN-05","text":"Die Seinslogik darf keine endgültige reflexive Schließung erzeugen; ihre Vermittlung muss wirksam bleiben, ohne bereits als gesetzte Vermittlung vollständig durchsichtig zu sein. ; Trace Type — Negative","refs":["CL_GB18_08:AS-B09","CL_GB18_08:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_02:BSA-01","text":"Nicht verfügbar ist ein Standpunkt reiner Präsenz außerhalb des Übergangs, von dem Seyn, Nichts oder Bestimmtheit ohne Negation gesetzt werden könnten. ; Trace Type — Negative","refs":["CL_GB18_05:BSA-01","CL_GB18_05:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:BSA-02","text":"Die tiefste ausgeschlossene Identität ist ein Selbst, das ohne Andersheit und negative Selbstbeziehung unmittelbar mit sich zusammenfiele. ; Trace Type — Negative","refs":["CL_GB18_06:BSA-04","CL_GB18_08:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:BSA-03","text":"Ein positives Absolutes, das alle Bestimmungen enthält und dennoch widerspruchslos bleibt, ist ontologisch unverfügbar; seine vermeintliche Fülle zerfällt in Leere oder Überfülle. ; Trace Type — Negative","refs":["CL_GB18_07:BSA-01","CL_GB18_07:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:BSA-04","text":"Die Architektur organisiert sich um die Abwesenheit einer bereits vollendeten Selbstbeziehung: Wahre Unendlichkeit und Subjektivität treiben den Fortgang, können innerhalb der erreichten Sphäre aber nicht positiv dargestellt werden. ; Trace Type — Negative","refs":["CL_GB18_07:CGD-05","CL_GB18_08:GA-10","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_02:XD-01","text":"Werden kann nur dann Daseyn erzeugen, wenn sein gegenseitiges Verschwinden selbst aufgehoben wird; resultatives Sein ist daher die bewahrte Ruhe einer zuvor bewegten Differenz. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-03","MC_GB18_L1_02:GA-04","MC_GB18_L1_02:GA-05","CL_GB18_05:GA-10","CL_GB18_06:AS-04","CL_GB18_06:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-02","text":"Resultative Unmittelbarkeit beendet Vermittlung nicht, sondern macht sie unsichtbar wirksam; jede spätere Bestimmung kann deshalb die aufgehobene Herkunft erneut freisetzen. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-04","MC_GB18_L1_02:GA-05","MC_GB18_L1_02:GA-08","CL_GB18_06:GA-03","CL_GB18_07:GA-01","CL_GB18_07:RMD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-03","text":"Qualität, Realität, Andersheit und Grenze sind keine getrennten Themen, sondern sukzessive Formen, in denen bestimmte Negation ihren zunächst verborgenen Anteil an Daseyn expliziert. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-03","MC_GB18_L1_02:GA-06","MC_GB18_L1_02:GA-08","CL_GB18_07:GA-02","CL_GB18_08:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-04","text":"Weil Etwas und Anderes gleichrangig sind, kann Grenze nicht als fremde Schranke bestehen; sie ist die positive Form, in der reziproke Andersheit zur Endlichkeit des Etwas wird. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-07","MC_GB18_L1_02:GA-10","CL_GB18_08:GA-02","CL_GB18_08:GA-05","CL_GB18_08:XD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-05","text":"Die Alternative von leerem Seyn und widersprüchlicher Totalität bildet einen allgemeinen Test gegen jede Ontologie, die Realität durch Entfernung oder unterschiedslose Maximierung von Negation vollenden will. ; Trace Type — Negative","refs":["MC_GB18_L1_02:GA-06","MC_GB18_L1_02:GA-11","CL_GB18_07:GA-07","CL_GB18_07:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-06","text":"Fürsichseyn ist zugleich erzeugter Attraktor und ungelöste Bruchstelle: Die Negation der Endlichkeit verlangt eine höhere Selbstbeziehung, doch deren positive Operationsform wird von den späteren Einheiten nicht eingelöst. ; Trace Type — Tension","refs":["MC_GB18_L1_02:GA-10","MC_GB18_L1_02:GA-13","CL_GB18_06:GA-12","CL_GB18_07:CGD-05","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-07","text":"Subjektivität kann nur durch endliche negative Selbstbeziehung entstehen, darf aber nicht mit dieser Vorbedingung gleichgesetzt werden; die Grenze wird angeeignet, ohne dass bereits ein entwickeltes Subjekt vorliegt. ; Trace Type — Tension","refs":["MC_GB18_L1_02:GA-07","MC_GB18_L1_02:GA-10","MC_GB18_L1_02:GA-13","CL_GB18_08:XD-05","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-08","text":"Immanente Dialektik erzeugt auf dieser Stufe notwendige Übergänge, aber noch kein reflexives Setzen; methodische Geltung und ontologisches Operationsregime müssen deshalb unterschieden bleiben. ; Trace Type — Tension","refs":["MC_GB18_L1_02:GA-02","MC_GB18_L1_02:GA-12","CL_GB18_05:GA-03","CL_GB18_08:GA-08","CL_GB18_08:CGD-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_02:BSD-01","text":"Realität erhält den Status eines Prozesses vermittelter Bestimmtheit: Was als gegenwärtiges Daseyn erscheint, ist die vorläufig stabilisierte Form einer fortwirkenden negativen Bewegung. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-03","MC_GB18_L1_02:GA-05","MC_GB18_L1_02:GA-06","CL_GB18_05:BSD-01","CL_GB18_06:BSD-01","CL_GB18_07:BSD-01","CL_GB18_08:BSD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-02","text":"Kausalität wird von äußerer Verursachung auf immanente Selbsttransformation verlagert: Eine Bestimmung erzeugt ihre Folgeform, indem ihre eigene Begrenzung zur produktiven Negation wird. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-02","MC_GB18_L1_02:GA-03","MC_GB18_L1_02:GA-08","CL_GB18_05:BSD-05","CL_GB18_06:BSD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-03","text":"Zeit ist keine lineare Reihe fertiger Zustände, sondern die logische Nachträglichkeit, in der aufgehobene Bestimmungen als Bedingungen späterer Formen fortwirken und verändert wiederkehren. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-04","MC_GB18_L1_02:GA-05","MC_GB18_L1_02:GA-07","CL_GB18_05:BSD-02","CL_GB18_06:HSI-03","CL_GB18_07:HSI-03","CL_GB18_08:BSD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-04","text":"Erkenntnis wird zur Rekonstruktion immanenter Bestimmungszusammenhänge; sie wendet weder feste Prädikate auf ruhende Gegenstände an noch sucht sie einen bestimmungslosen Kern hinter den Beziehungen. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-02","MC_GB18_L1_02:GA-07","MC_GB18_L1_02:GA-09","CL_GB18_05:BSD-03","CL_GB18_08:BSD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-05","text":"Das Subjekt verliert den Status einer vorausgesetzten Substanz und erscheint zunächst als unvollendeter Effekt negativer Selbstbeziehung, der erst jenseits des bloßen Übergehens reflektierte Selbstsetzung gewinnen könnte. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-10","MC_GB18_L1_02:GA-12","MC_GB18_L1_02:GA-13","CL_GB18_05:BSD-04","CL_GB18_06:HSI-02","CL_GB18_08:HSI-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-06","text":"Handlungsmacht nimmt die Form relationaler Selbsterhaltung an: Endliche Individualität wirkt nicht durch souveräne Unabhängigkeit, sondern durch die Erhaltung ihrer Bestimmtheit in Widerstand und Gegenwirkung. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-07","MC_GB18_L1_02:GA-10","CL_GB18_07:GA-08","CL_GB18_07:BSD-04","CL_GB18_07:HSI-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-07","text":"Die Methode vollzieht ihre Ontologie performativ, indem sie jeden festen Begriff durch dessen ausgeschlossene Bedingung destabilisiert und als mutierte Funktion in die nächste Bestimmungsstufe überführt. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-02","MC_GB18_L1_02:GA-03","MC_GB18_L1_02:GA-08","CL_GB18_05:ALT-B05","CL_GB18_06:ALT-B05","CL_GB18_08:BSD-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_02:RLE-01","text":"Abstraktion trennt Bestimmungen, Fixierung verselbständigt sie, der Ausschluss des Übergangs erzeugt Stillstand, und der Stillstand erzwingt die Wiederkehr des ausgeschlossenen Anderen.","refs":["CL_GB18_05:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RLE-02","text":"Werden differenziert sich in gegenläufige Richtungen, jede Richtung erzeugt ihre Gegenrichtung, und ihre wechselseitige Aufhebung verdichtet Bewegung zur resultativen Einheit.","refs":["CL_GB18_05:RLE-03","CL_GB18_06:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RLE-03","text":"Vermittlung erzeugt Unmittelbarkeit, Unmittelbarkeit expliziert Bestimmtheit, Bestimmtheit setzt Negation frei, und Negation reaktiviert Vermittlung auf höherer Stufe.","refs":["CL_GB18_07:RLE-01","CL_GB18_07:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RLE-04","text":"Die Eskalation der Negativität führt von abstrakter Abwesenheit über Aufhebung und qualitative Grenze zur endlichen Selbstbeziehung, ohne die früheren Funktionen spurlos zu beseitigen.","refs":["CL_GB18_05:GA-09","CL_GB18_07:GA-03","CL_GB18_08:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RLE-05","text":"Totalisierung bildet eine doppelte Eskalationsschleife: Negationsentzug entleert Realität, während die unterschiedslose Aufnahme aller Bestimmungen ihre Positivität in Widerspruch umschlagen lässt.","refs":["CL_GB18_07:RLE-03","CL_GB18_07:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RLE-06","text":"Bestimmte Negation ist der operative Attraktor; wahre Unendlichkeit und Subjektivität sind seine terminalen Horizonte, während die Schwelle zwischen Übergehen und Setzen ihre vorläufige Nichterreichbarkeit markiert.","refs":["CL_GB18_07:RLE-05","CL_GB18_06:GA-11","CL_GB18_08:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_02:FGS-B01","text":"Abstraktion des jeweils Anderen → Verselbständigung von Seyn und Nichts → Ausschluss des Übergangs → Selbstwiderspruch der isolierten Bestimmungen.","refs":["CL_GB18_05:FGS-B01","CL_GB18_05:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B02","text":"Selbstwiderspruch → unmittelbarer Übergang → Differenzierung in Entstehen und Vergehen → wechselseitige Selbstumkehrung → Werden.","refs":["CL_GB18_05:AS-B07","CL_GB18_05:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B03","text":"Werden → Verschwinden seiner gegenläufigen Bewegungen → Aufhebung des Verschwindens → ruhige, resultative Unmittelbarkeit → Daseyn.","refs":["CL_GB18_06:AS-04","CL_GB18_06:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B04","text":"Daseyn → Qualität als Realität und Negation → Explikation enthaltener Negativität → Grenze, Schranke und Mangel.","refs":["CL_GB18_06:AS-05","CL_GB18_07:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B05","text":"Etwas und Anderes → reziproke Andersheit → Rücknahme des Seyns-für-Anderes → immanente Grenze → Endlichkeit als Selbstbestimmung.","refs":["CL_GB18_08:AS-B02","CL_GB18_08:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B06","text":"Endlichkeit → relationale Selbsterhaltung und Negation der Grenze → Attraktion durch wahre Unendlichkeit und Fürsichseyn → Eröffnung, aber noch keine Vollendung von Subjektivität.","refs":["CL_GB18_06:GA-11","CL_GB18_07:GA-08","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B07","text":"Das Gesamtschema ist rekursive Verdichtung: Jede Stufe negiert die unmittelbare Form der vorherigen, bewahrt deren Unterschied und verschiebt denselben Mechanismus in ein komplexeres Operationsregime.","refs":["CL_GB18_06:FGS-B06","CL_GB18_08:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_02:AFM-B01","text":"Abstrakte Selbständigkeit von Seyn und Nichts → Übergang → Werden → Selbstaufhebung → Daseyn als resultative Unmittelbarkeit → Qualität → Realität und Negation → Etwas und Anderes → Grenze → Endlichkeit → negative Selbstbeziehung → Schwelle von Fürsichseyn und Subjektivität.","refs":["CL_GB18_06:AFM-B01","CL_GB18_08:AFM-B06","CL_GB18_08:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AFM-B02","text":"Äußerliche Fixierung → immanente Kritik → Wiederkehr des Ausgeschlossenen → funktionale Begriffsmutation → Absorption der Differenz → erneute Negativität → rekursive Intensivierung → vorreflexive Schließung im Übergehen.","refs":["CL_GB18_05:RLE-01","CL_GB18_07:ALT-B05","CL_GB18_08:AS-B09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_02:MME-01","text":"Identität und Differenz werden nicht mehr als unabhängige Prinzipien kartiert; Identität erscheint als vermittelte Rückkehr aus einer bewahrten Andersheit.","refs":["CL_GB18_05:MME-03","CL_GB18_08:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-02","text":"Unmittelbarkeit wird von einem voraussetzungslosen Anfang zur verdichteten Geschichte aufgehobener Vermittlung umklassifiziert.","refs":["CL_GB18_07:GA-01","CL_GB18_07:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-03","text":"Negation wird von Abwesenheit und Defizit zu einer produktiven Operation umkartiert, die Bestimmtheit erzeugt, bewahrt, begrenzt und relationiert.","refs":["CL_GB18_05:MME-05","CL_GB18_06:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-04","text":"Realität wird von positiver Gegebenheit zu bestimmter Negativität umgezeichnet; ihre Positivität gilt nur noch als selektive Erscheinungsform ihrer negativen Bedingungen.","refs":["CL_GB18_07:GA-06","CL_GB18_07:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-05","text":"Grenze wird von einer äußeren Trennlinie zur positiven Form der Endlichkeit und damit zur inneren Bestimmung des begrenzten Etwas.","refs":["CL_GB18_08:MME-02","CL_GB18_08:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-06","text":"Individualität wird von atomarer Selbständigkeit zu prekärer Selbsterhaltung in Relation, Gegenwirkung und Widerstand reklassifiziert.","refs":["CL_GB18_07:MME-05","CL_GB18_07:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-07","text":"Die Unterscheidung von Übergehen und Setzen ersetzt eine bloße Kategorienfolge durch eine Karte verschiedener Operationsregime und verhindert die vorzeitige Gleichsetzung von Seinsbewegung und Reflexion.","refs":["CL_GB18_08:MME-05","CL_GB18_08:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_02:ALT-B01","text":"Auf der Oberflächenebene erscheinen Seyn, Nichts, Werden, Daseyn, Qualität, Realität, Etwas, Anderes, Grenze und Endlichkeit als sukzessive Gegenstände derselben Bestimmungsbewegung.","refs":["CL_GB18_05:ALT-B01","CL_GB18_08:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:ALT-B02","text":"Auf der Strukturebene organisiert bestimmte Negation die Transformation von Übergang in resultative Unmittelbarkeit, relationale Qualität, Grenze und endliche Selbstbeziehung.","refs":["CL_GB18_06:ALT-B02","CL_GB18_08:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:ALT-B03","text":"Auf der metastrategischen Ebene wird die Wahl zwischen fixierten Gegensätzen durch eine immanente Prüfung ersetzt, welche die ausgeschlossene Bedingung jeder Position als Motor ihrer Transformation freilegt.","refs":["CL_GB18_06:ALT-B03","CL_GB18_07:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:ALT-B04","text":"Auf der ontologisch-temporalen Ebene ist Realität eine gerichtete, aber rekursive Bewegung, in der frühere Bestimmungen als aufgehobene Bedingungen späterer Formen fortwirken.","refs":["CL_GB18_05:ALT-B04","CL_GB18_06:HSI-03","CL_GB18_08:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:ALT-B05","text":"Auf der methodologisch-performativen Ebene vollzieht die Darstellung ihre These, indem sie Begriffe probeweise fixiert, deren innere Negativität freisetzt und sie in veränderter Funktion wiederkehren lässt.","refs":["CL_GB18_05:ALT-B05","CL_GB18_06:ALT-B05","CL_GB18_08:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_02:FL-01","text":"Der erste Übergang soll unmittelbar und unvermittelt sein, wird aber durch eine reflektierte Bestimmung von Unbestimmtheit und Negativität ausgewiesen; Vollzug und Nachweis bleiben nicht deckungsgleich. ; Trace Type — Tension","refs":["CL_GB18_05:FL-01","CL_GB18_05:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FL-02","text":"Resultative Einheit soll Ruhe erzeugen und zugleich die Differenz ihrer aufgehobenen Momente aktiv bewahren; ihre Stabilität bleibt deshalb notwendig gespannt. ; Trace Type — Tension","refs":["CL_GB18_06:FL-01","CL_GB18_06:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FL-03","text":"Fürsichseyn wird lokal als Abschluss gesetzt, während wahre Unendlichkeit und entwickelte Subjektivität im größeren Zusammenhang unterbestimmt bleiben; terminale Behauptung und systemischer Horizont fallen auseinander. ; Trace Type — Tension","refs":["CL_GB18_06:GA-12","CL_GB18_07:FL-03","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FL-04","text":"Vermittlung ist überall konstitutiv, darf in der Sphäre des Seyns aber noch nicht als konkrete, gesetzte Vermittlung erscheinen; die Architektur benötigt eine Wirksamkeit, die sie operationslogisch noch nicht explizieren kann. ; Trace Type — Tension","refs":["CL_GB18_08:RMD-06","CL_GB18_08:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FL-05","text":"Der Übergang von logischer Negativität zu Widerstand, Gegenwirkung und Kampf wird benötigt, um Eigenschaft dynamisch zu bestimmen, ist aber nur teilweise vermittelt. ; Trace Type — Tension","refs":["CL_GB18_07:FL-04","CL_GB18_07:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FL-06","text":"Negative Selbstbeziehung eröffnet Subjektivität, ohne bereits ein konkretes Subjekt zu erzeugen; die Architektur muss Vorbedingung und Resultat auseinanderhalten, obwohl sie beide durch dieselbe Negationsfigur verbindet. ; Trace Type — Tension","refs":["CL_GB18_08:GA-10","CL_GB18_08:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-01","text":"Werden mutiert von der Wahrheit reiner Gegensätze zum Mechanismus ihrer Selbstaufhebung und verliert nach der Erzeugung des Daseyns seine selbständige Form. ; Trace Type — Tension","refs":["CL_GB18_05:AS-B02","CL_GB18_06:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-02","text":"Aufhebung mutiert von einer sprachlich markierten Doppelbedeutung zum universellen Operator, der unmittelbare Form negiert, Differenz erhält und neue Bestimmtheit setzt. ; Trace Type — Tension","refs":["CL_GB18_06:MP-02","CL_GB18_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-03","text":"Unmittelbarkeit mutiert vom unvermittelten Ausgang zur resultativen Erscheinung einer aufgehobenen Genese und wird dadurch selbst zum Träger weiterer Vermittlung. ; Trace Type — Tension","refs":["CL_GB18_06:GA-07","CL_GB18_07:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-04","text":"Negation mutiert vom abstrakten Gegenpol des Seyns zur qualitativen Realität und anschließend zu Grenze, Schranke, Mangel und Endlichkeit. ; Trace Type — Tension","refs":["CL_GB18_07:MP-02","CL_GB18_08:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-05","text":"Realität mutiert von positiver Qualität zum kritischen Prüfbegriff affirmativer Totalität und schließlich zur dynamischen Selbstbeziehung bestimmter Negativität. ; Trace Type — Tension","refs":["CL_GB18_07:MP-03","CL_GB18_07:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-06","text":"Andersheit mutiert von äußerlicher Gegenbestimmung zum immanenten Moment des Etwas; Grenze ist der Punkt, an dem diese Rücknahme zur positiven Form der Endlichkeit wird. ; Trace Type — Tension","refs":["CL_GB18_08:RMD-02","CL_GB18_08:MME-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_02:HSI-01","text":"Realität erscheint als rekursive Umformungsmaschine, die keine stabilen Substanzen produziert, sondern Übergänge zu vorläufig stabilisierten und erneut negierbaren Bestimmungen verdichtet.","refs":["CL_GB18_05:HSI-01","CL_GB18_07:HSI-01","CL_GB18_08:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:HSI-02","text":"Das Subjekt erscheint als noch unvollendete Schaltstelle negativer Selbstbeziehung: nicht als vorausgesetzter Träger, sondern als möglicher Effekt der Aneignung von Andersheit und Grenze.","refs":["CL_GB18_05:HSI-02","CL_GB18_08:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:HSI-03","text":"Zeit erscheint als logische Nachträglichkeit, in der das Vergangene nicht verschwindet, sondern aufgehoben in der gegenwärtigen Form fortwirkt und als mutierte Bestimmung wiederkehrt.","refs":["CL_GB18_07:HSI-03","CL_GB18_08:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:HSI-04","text":"Kampf und Navigation bestehen nicht in der Flucht aus Endlichkeit, sondern in der Rekonstruktion und Erhaltung jener relationalen Bestimmungen, durch die ein Etwas seiner Auflösung widersteht.","refs":["CL_GB18_07:HSI-04","CL_GB18_08:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_02:MRT-B01","text":"Die minimal hinreichende Architektur besteht aus Differenzierung, Übergang, bewahrender Aufhebung, resultativer Unmittelbarkeit, bestimmter Negation, Internalisierung von Andersheit und endlicher Selbstbeziehung.","refs":["CL_GB18_06:MRT-B01","CL_GB18_08:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MRT-B02","text":"Diese Operationen reichen aus, um die Bewegung von Seyn und Nichts über Werden und Daseyn bis zu Qualität, Grenze und Endlichkeit auf Meta-Cluster-Ebene zu rekonstruieren.","refs":["CL_GB18_05:MRT-B01","CL_GB18_07:MRT-B01","CL_GB18_08:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MRT-B03","text":"Die Rekonstruktion bleibt kohärent, sofern keine Unmittelbarkeit als voraussetzungslos, keine Negation als bloße Vernichtung und keine Grenze als äußerlicher Zusatz behandelt wird.","refs":["CL_GB18_06:MRT-B03","CL_GB18_07:MRT-B02","CL_GB18_08:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MRT-B04","text":"Die stärkste Systemleistung ist die durchgängige Mutation einer einzigen Negationsfunktion: Aus Übergang wird Erhaltung, aus Erhaltung Bestimmtheit, aus Bestimmtheit Relation und aus Relation endliche Selbstbeziehung.","refs":["CL_GB18_05:MRT-B04","CL_GB18_07:MRT-B03","CL_GB18_08:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MRT-B05","text":"Unterbestimmt bleiben der reflektierte Nachweis des unmittelbaren Übergangs, die positive Gestalt wahrer Unendlichkeit, der Schritt zur kämpfenden Eigenschaft und die konkrete Entstehung von Fürsichseyn und Subjektivität.","refs":["CL_GB18_05:MRT-B02","CL_GB18_07:MRT-B04","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MRT-B06","text":"Axiomatischer Reduktion widersteht die Doppelstruktur der Aufhebung: Sie muss Unterschied zugleich negieren und erhalten, weil nur diese Spannung Bewegung in bestimmte, aber weiterhin transformierbare Einheit überführt.","refs":["CL_GB18_05:MRT-B06","CL_GB18_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123330641452Z_f34bfb83","language_code":"en","language_name":"English","title":"Gb18 L1 02","source_sha256":"8fd77d2934c814b1a3ccd966e4adc6a08865cc5eb4793df41508e979dd66d816","sha256":"8c891f10424717d905d5a388ba86440ed7f21d1ff8a4540b2a14fcd16ffdb2ee","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:33:30.643649+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_02:AS-01","text":"The central problem consists in generating the progression from abstract Being and Nothing to determinate, finite existence, without introducing transition, determinacy, or relation through external presuppositions.","refs":["CL_GB18_05:AS-B01","CL_GB18_06:AS-01","CL_GB18_08:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-02","text":"The global thesis is that negation does not merely annihilate its objects, but sublates their immediate form, preserves their difference, and reorganizes them as higher determinacy.","refs":["CL_GB18_06:AS-03","CL_GB18_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-03","text":"The argument is immanent-dialectical because every new form must emerge from the instability of the preceding determination, and external reflection must not generate conceptual necessity.","refs":["CL_GB18_05:AS-B03","CL_GB18_07:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-04","text":"The directed movement leads from the untenable independence of pure poles through Becoming and its self-sublation to resultant immediacy, quality, otherness, limit, and finite self-relation.","refs":["CL_GB18_05:AS-B04","CL_GB18_06:AS-04","CL_GB18_08:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-05","text":"Negativity thereby mutates from the transition between Being and Nothing into preservative sublation, into qualitative determinacy, and finally into the limit in which a Something contains its Other as its own finitude.","refs":["CL_GB18_05:GA-09","CL_GB18_07:GA-03","CL_GB18_08:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-06","text":"The progression is recursive and spiral-shaped: every generated immediacy condenses a sublated mediation and, through its own negativity, releases a new cycle of determination.","refs":["CL_GB18_05:AS-B05","CL_GB18_06:AS-06","CL_GB18_07:AS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-07","text":"The closure attained is a finite negative self-relation within the sphere of Being; it opens subjectivity, but does not yet possess reflective positing or a developed subject.","refs":["CL_GB18_08:GA-08","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AS-08","text":"Being-for-self and true infinity therefore function as attractors rather than as fully realized endpoints: the architecture generates their negative presupposition, but leaves their positive form underdetermined.","refs":["CL_GB18_06:GA-11","CL_GB18_07:CGD-05","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_02:GA-01","text":"[Persistent] No determination possesses isolated independence; its validity arises from difference, negation, and mediation and exists only within this connection.","refs":["CL_GB18_05:GA-01","CL_GB18_06:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-02","text":"[Persistent] Dialectical necessity may arise only from the immanent movement of determinations; external presuppositions can neither ground nor replace the progression.","refs":["CL_GB18_05:GA-03","CL_GB18_07:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-03","text":"[Mutating] Negation mutates from abstract Nothing through transition and preservative sublation into qualitative determinacy, limit, and negative self-relation.","refs":["CL_GB18_05:GA-09","CL_GB18_07:GA-03","CL_GB18_08:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-04","text":"[Mutating] Sublation removes the immediate form of a difference, but preserves it as an effective moment of the unity thereby generated.","refs":["CL_GB18_06:GA-03","CL_GB18_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-05","text":"[Emergent] Immediacy is not a presuppositionless beginning, but the condensed form of appearance of a sublated mediation.","refs":["CL_GB18_06:GA-07","CL_GB18_07:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-06","text":"[Emergent] Quality and reality are determinate only insofar as negation is effective within them themselves; positivity without negativity falls back into empty indeterminacy.","refs":["CL_GB18_07:GA-05","CL_GB18_08:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-07","text":"[Emergent] Something and Other are reciprocally equal in rank; the withdrawal of their initially external difference generates limit and finitude as self-determinations of Something.","refs":["CL_GB18_08:GA-02","CL_GB18_08:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-08","text":"[Attractor] Determinate negation organizes the overall progression because it connects transition, preservation, quality, otherness, limit, and movement as functions of a single generative mechanism.","refs":["CL_GB18_07:RLE-05","CL_GB18_08:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-09","text":"[Attractor] Higher unity does not erase its differences, but retains them as dependent, internally effective moments of a differentiated self-relation.","refs":["CL_GB18_05:GA-05","CL_GB18_06:GA-13","CL_GB18_08:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-10","text":"[Mutating] Finitude mutates from a supposedly external limitation into the inner negativity through which determinate individuality gains relational self-assertion.","refs":["CL_GB18_06:GA-10","CL_GB18_07:GA-10","CL_GB18_08:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-11","text":"[Emergent] Affirmative totalization destroys determinacy in two directions: the removal of all negation generates emptiness, while its indiscriminate accumulation generates contradiction.","refs":["CL_GB18_07:GA-07","CL_GB18_07:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-12","text":"[Terminal] The sphere of Being generates real mediation as transition, but cannot yet exhibit it as reflective positing of its own moments.","refs":["CL_GB18_08:AS-B09","CL_GB18_08:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GA-13","text":"[Attractor] True infinity, being-for-self, and subjectivity form the common attractor of finite self-relation, but at the level attained remain opened only negatively.","refs":["CL_GB18_06:GA-11","CL_GB18_07:CGD-05","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_02:RMD-01","text":"Being and Nothing initially retain their names, but lose their function as independent firsts, become moments of Becoming, and finally dissolve into qualitative and relational determinations.","refs":["CL_GB18_05:RMD-01","CL_GB18_06:RMD-01","CL_GB18_07:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-02","text":"Becoming shifts from the truth of pure opposites to the operation of their self-sublation and is thereafter absorbed into the resultant immediacy of existence.","refs":["CL_GB18_06:RMD-03","CL_GB18_06:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-03","text":"Sublation begins as the dual operation of negation and preservation, expands into the ontological generator of new determinations, and finally becomes the withdrawal of external otherness into self-determination.","refs":["CL_GB18_06:RMD-04","CL_GB18_08:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-04","text":"Negation remains functionally persistent, but mutates from abstract absence through productive mediation and qualitative limit into the immanent finitude of a Something.","refs":["CL_GB18_05:RMD-05","CL_GB18_06:RMD-06","CL_GB18_07:RMD-05","CL_GB18_08:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-05","text":"Immediacy recurs with reversed valence: it no longer denotes absence of mediation, but its sublated and condensed result.","refs":["CL_GB18_06:GA-07","CL_GB18_07:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-06","text":"Reality mutates from positive quality into the testing concept of affirmative ontology and finally into the dynamic configuration of determinate negativity.","refs":["CL_GB18_07:RMD-04","CL_GB18_07:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-07","text":"Otherness begins as a reciprocal external relation, becomes the Other of itself, and is subsequently withdrawn as limit into the determinacy of Something.","refs":["CL_GB18_08:RMD-02","CL_GB18_08:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RMD-08","text":"The Infinite loses the status of a mere counterpole to the finite and becomes the attractor of a self-relation whose positive execution is still outstanding at this level.","refs":["CL_GB18_06:RMD-07","CL_GB18_07:CGD-05","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_02:CGD-01","text":"Cosmological positions, empirical countercases, and infinitely small magnitudes remain local sites of contestation; at the meta-cluster level, only their common function of destabilizing isolated determinations through transition scales.","refs":["CL_GB18_05:CGD-01","CL_GB18_05:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:CGD-02","text":"The linguistic ambiguity of sublation remains local; globally, what carries is the operator gained from it, which bundles negation, preservation, and further determination in one transformation.","refs":["CL_GB18_06:CGD-02","CL_GB18_06:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:CGD-03","text":"Quality, Something, Other, limit, and defect are locally distinguishable categories; at the current level, they form successive functional forms of determinate negativity.","refs":["CL_GB18_06:CGD-03","CL_GB18_07:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:CGD-04","text":"The local positing of being-for-self as closure does not scale unchanged, because later unities explicitly mark true infinity and developed subjectivity as still underdetermined.","refs":["CL_GB18_06:GA-12","CL_GB18_07:CGD-05","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:CGD-05","text":"The transition from quality to struggling property remains locally only partially mediated; globally, the weaker structure of relational self-preservation against Other scales from it.","refs":["CL_GB18_07:AS-07","CL_GB18_07:GA-08","CL_GB18_07:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:CGD-06","text":"The difference between transition and positing is not local terminology, but the global boundary rule separating attained mediation of Being from reflexivity not yet attained.","refs":["CL_GB18_08:CGD-04","CL_GB18_08:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_02:GNX-01","text":"Independent poles, pre-given substances, and completely isolated determinations are excluded, because they could admit transition and relation only retrospectively. ; Trace Type — Negative","refs":["CL_GB18_05:GNX-01","CL_GB18_08:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GNX-02","text":"Sublation must not be understood as annihilation or erasure of difference; without preservation of difference, it could generate no new determinacy. ; Trace Type — Negative","refs":["CL_GB18_06:GNX-02","CL_GB18_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GNX-03","text":"A purely affirmative reality is excluded, because it becomes either indeterminate through the removal of negation or contradictory through totalization of all predicates. ; Trace Type — Negative","refs":["CL_GB18_07:GNX-03","CL_GB18_07:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GNX-04","text":"An absolutely external Other and a merely external limit are inadmissible, because otherness and limit must return as determinations of the Something concerned. ; Trace Type — Negative","refs":["CL_GB18_08:GNX-02","CL_GB18_08:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GNX-05","text":"A relationless in-itself or inaccessible thing-in-itself is excluded, because the truth of a Something lies only in its concrete nexus of determination. ; Trace Type — Negative","refs":["CL_GB18_08:GNX-05","CL_GB18_08:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:GNX-06","text":"Fully posited mediation and developed subjectivity must not be anticipated at the level attained; they are horizons of result, not present determinations. ; Trace Type — Negative","refs":["CL_GB18_08:BSA-02","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_02:DBN-01","text":"For the architecture to endure, every ontology of fully independent determinations must be false; otherwise negation, transition, and relation would be mere external additions. ; Trace Type — Negative","refs":["CL_GB18_05:DBN-01","CL_GB18_06:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:DBN-02","text":"An external meta-level that explains movement with ready-made categories must remain excluded, because it already presupposes the mediation to be grounded. ; Trace Type — Negative","refs":["CL_GB18_05:DBN-02","CL_GB18_07:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:DBN-03","text":"Presuppositionless immediacy must be impossible; every apparent givenness must remain reconstructible as the sublated history of its mediation. ; Trace Type — Negative","refs":["CL_GB18_06:GNX-06","CL_GB18_07:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:DBN-04","text":"Determinate content without negation must be impossible, because a reality purified of otherness could preserve neither differentiability nor qualitative identity. ; Trace Type — Negative","refs":["CL_GB18_07:DBN-01","CL_GB18_08:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:DBN-05","text":"The logic of Being must not generate a final reflexive closure; its mediation must remain effective without already being fully transparent as posited mediation. ; Trace Type — Negative","refs":["CL_GB18_08:AS-B09","CL_GB18_08:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_02:BSA-01","text":"Unavailable is a standpoint of pure presence outside transition, from which Being, Nothing, or determinacy could be posited without negation. ; Trace Type — Negative","refs":["CL_GB18_05:BSA-01","CL_GB18_05:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:BSA-02","text":"The deepest excluded identity is a self that would immediately coincide with itself without otherness and negative self-relation. ; Trace Type — Negative","refs":["CL_GB18_06:BSA-04","CL_GB18_08:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:BSA-03","text":"A positive Absolute that contains all determinations and nevertheless remains contradiction-free is ontologically unavailable; its supposed fullness disintegrates into emptiness or excess fullness. ; Trace Type — Negative","refs":["CL_GB18_07:BSA-01","CL_GB18_07:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:BSA-04","text":"The architecture organizes itself around the absence of an already completed self-relation: true infinity and subjectivity drive the progression, but cannot be positively presented within the sphere attained. ; Trace Type — Negative","refs":["CL_GB18_07:CGD-05","CL_GB18_08:GA-10","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_02:XD-01","text":"Becoming can generate existence only if its reciprocal vanishing is itself sublated; resultant Being is therefore the preserved repose of a previously moving difference. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-03","MC_GB18_L1_02:GA-04","MC_GB18_L1_02:GA-05","CL_GB18_05:GA-10","CL_GB18_06:AS-04","CL_GB18_06:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-02","text":"Resultant immediacy does not end mediation, but makes it invisibly effective; every later determination can therefore release the sublated origin anew. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-04","MC_GB18_L1_02:GA-05","MC_GB18_L1_02:GA-08","CL_GB18_06:GA-03","CL_GB18_07:GA-01","CL_GB18_07:RMD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-03","text":"Quality, reality, otherness, and limit are not separate themes, but successive forms in which determinate negation explicates its initially hidden share in existence. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-03","MC_GB18_L1_02:GA-06","MC_GB18_L1_02:GA-08","CL_GB18_07:GA-02","CL_GB18_08:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-04","text":"Because Something and Other are equal in rank, limit cannot persist as an alien barrier; it is the positive form in which reciprocal otherness becomes the finitude of Something. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-07","MC_GB18_L1_02:GA-10","CL_GB18_08:GA-02","CL_GB18_08:GA-05","CL_GB18_08:XD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-05","text":"The alternative of empty Being and contradictory totality forms a general test against every ontology that seeks to complete reality through removal or indiscriminate maximization of negation. ; Trace Type — Negative","refs":["MC_GB18_L1_02:GA-06","MC_GB18_L1_02:GA-11","CL_GB18_07:GA-07","CL_GB18_07:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-06","text":"Being-for-self is at once a generated attractor and an unresolved fracture point: the negation of finitude demands a higher self-relation, yet its positive operational form is not fulfilled by the later unities. ; Trace Type — Tension","refs":["MC_GB18_L1_02:GA-10","MC_GB18_L1_02:GA-13","CL_GB18_06:GA-12","CL_GB18_07:CGD-05","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-07","text":"Subjectivity can arise only through finite negative self-relation, but must not be equated with this precondition; the limit is appropriated without a developed subject already being present. ; Trace Type — Tension","refs":["MC_GB18_L1_02:GA-07","MC_GB18_L1_02:GA-10","MC_GB18_L1_02:GA-13","CL_GB18_08:XD-05","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:XD-08","text":"At this level, immanent dialectic generates necessary transitions, but not yet reflexive positing; methodological validity and ontological operational regime must therefore remain distinguished. ; Trace Type — Tension","refs":["MC_GB18_L1_02:GA-02","MC_GB18_L1_02:GA-12","CL_GB18_05:GA-03","CL_GB18_08:GA-08","CL_GB18_08:CGD-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_02:BSD-01","text":"Reality acquires the status of a process of mediated determinacy: what appears as present existence is the provisionally stabilized form of a continuing negative movement. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-03","MC_GB18_L1_02:GA-05","MC_GB18_L1_02:GA-06","CL_GB18_05:BSD-01","CL_GB18_06:BSD-01","CL_GB18_07:BSD-01","CL_GB18_08:BSD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-02","text":"Causality is shifted from external causation to immanent self-transformation: a determination generates its subsequent form by becoming productive negation through its own limitation. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-02","MC_GB18_L1_02:GA-03","MC_GB18_L1_02:GA-08","CL_GB18_05:BSD-05","CL_GB18_06:BSD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-03","text":"Time is not a linear sequence of finished states, but the logical belatedness in which sublated determinations continue to operate as conditions of later forms and recur in altered form. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-04","MC_GB18_L1_02:GA-05","MC_GB18_L1_02:GA-07","CL_GB18_05:BSD-02","CL_GB18_06:HSI-03","CL_GB18_07:HSI-03","CL_GB18_08:BSD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-04","text":"Cognition becomes the reconstruction of immanent nexuses of determination; it neither applies fixed predicates to static objects nor seeks an indeterminate core behind relations. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-02","MC_GB18_L1_02:GA-07","MC_GB18_L1_02:GA-09","CL_GB18_05:BSD-03","CL_GB18_08:BSD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-05","text":"The subject loses the status of a presupposed substance and initially appears as an unfinished effect of negative self-relation, which could gain reflected self-positing only beyond mere transition. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-10","MC_GB18_L1_02:GA-12","MC_GB18_L1_02:GA-13","CL_GB18_05:BSD-04","CL_GB18_06:HSI-02","CL_GB18_08:HSI-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-06","text":"Agency takes the form of relational self-preservation: finite individuality acts not through sovereign independence, but through preserving its determinacy in resistance and counteraction. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-07","MC_GB18_L1_02:GA-10","CL_GB18_07:GA-08","CL_GB18_07:BSD-04","CL_GB18_07:HSI-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_02:BSD-07","text":"The method performs its ontology by destabilizing every fixed concept through its excluded condition and transferring it as a mutated function into the next level of determination. ; Trace Type — Composite","refs":["MC_GB18_L1_02:GA-02","MC_GB18_L1_02:GA-03","MC_GB18_L1_02:GA-08","CL_GB18_05:ALT-B05","CL_GB18_06:ALT-B05","CL_GB18_08:BSD-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_02:RLE-01","text":"Abstraction separates determinations, fixation renders them independent, the exclusion of transition generates stasis, and stasis compels the return of the excluded Other.","refs":["CL_GB18_05:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RLE-02","text":"Becoming differentiates itself into opposing directions, each direction generates its counter-direction, and their reciprocal sublation condenses movement into resultant unity.","refs":["CL_GB18_05:RLE-03","CL_GB18_06:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RLE-03","text":"Mediation generates immediacy, immediacy explicates determinacy, determinacy releases negation, and negation reactivates mediation at a higher level.","refs":["CL_GB18_07:RLE-01","CL_GB18_07:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RLE-04","text":"The escalation of negativity leads from abstract absence through sublation and qualitative limit to finite self-relation, without erasing the earlier functions without trace.","refs":["CL_GB18_05:GA-09","CL_GB18_07:GA-03","CL_GB18_08:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RLE-05","text":"Totalization forms a double escalation loop: withdrawal of negation empties reality, while indiscriminate inclusion of all determinations causes its positivity to turn into contradiction.","refs":["CL_GB18_07:RLE-03","CL_GB18_07:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:RLE-06","text":"Determinate negation is the operative attractor; true infinity and subjectivity are its terminal horizons, while the threshold between transition and positing marks their provisional unattainability.","refs":["CL_GB18_07:RLE-05","CL_GB18_06:GA-11","CL_GB18_08:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_02:FGS-B01","text":"Abstraction of the respective Other → rendering Being and Nothing independent → exclusion of transition → self-contradiction of isolated determinations.","refs":["CL_GB18_05:FGS-B01","CL_GB18_05:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B02","text":"Self-contradiction → immediate transition → differentiation into arising and passing away → reciprocal self-reversal → Becoming.","refs":["CL_GB18_05:AS-B07","CL_GB18_05:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B03","text":"Becoming → vanishing of its opposing movements → sublation of vanishing → tranquil, resultant immediacy → existence.","refs":["CL_GB18_06:AS-04","CL_GB18_06:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B04","text":"Existence → quality as reality and negation → explication of contained negativity → limit, barrier, and defect.","refs":["CL_GB18_06:AS-05","CL_GB18_07:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B05","text":"Something and Other → reciprocal otherness → withdrawal of being-for-Other → immanent limit → finitude as self-determination.","refs":["CL_GB18_08:AS-B02","CL_GB18_08:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B06","text":"Finitude → relational self-preservation and negation of limit → attraction by true infinity and being-for-self → opening, but not yet completion, of subjectivity.","refs":["CL_GB18_06:GA-11","CL_GB18_07:GA-08","CL_GB18_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FGS-B07","text":"The overall schema is recursive condensation: each level negates the immediate form of the preceding one, preserves its difference, and shifts the same mechanism into a more complex operational regime.","refs":["CL_GB18_06:FGS-B06","CL_GB18_08:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_02:AFM-B01","text":"Abstract independence of Being and Nothing → transition → Becoming → self-sublation → existence as resultant immediacy → quality → reality and negation → Something and Other → limit → finitude → negative self-relation → threshold of being-for-self and subjectivity.","refs":["CL_GB18_06:AFM-B01","CL_GB18_08:AFM-B06","CL_GB18_08:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:AFM-B02","text":"External fixation → immanent critique → return of the excluded → functional concept-mutation → absorption of difference → renewed negativity → recursive intensification → pre-reflective closure in transition.","refs":["CL_GB18_05:RLE-01","CL_GB18_07:ALT-B05","CL_GB18_08:AS-B09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_02:MME-01","text":"Identity and difference are no longer mapped as independent principles; identity appears as a mediated return from a preserved otherness.","refs":["CL_GB18_05:MME-03","CL_GB18_08:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-02","text":"Immediacy is reclassified from a presuppositionless beginning into the condensed history of sublated mediation.","refs":["CL_GB18_07:GA-01","CL_GB18_07:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-03","text":"Negation is remapped from absence and deficit into a productive operation that generates, preserves, limits, and relates determinacy.","refs":["CL_GB18_05:MME-05","CL_GB18_06:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-04","text":"Reality is redrawn from positive givenness into determinate negativity; its positivity now counts only as a selective form of appearance of its negative conditions.","refs":["CL_GB18_07:GA-06","CL_GB18_07:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-05","text":"Limit is transformed from an external dividing line into the positive form of finitude and thus into the inner determination of the limited Something.","refs":["CL_GB18_08:MME-02","CL_GB18_08:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-06","text":"Individuality is reclassified from atomic independence into precarious self-preservation in relation, counteraction, and resistance.","refs":["CL_GB18_07:MME-05","CL_GB18_07:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MME-07","text":"The distinction between transition and positing replaces a mere sequence of categories with a map of different operational regimes and prevents the premature equation of movement of Being and reflection.","refs":["CL_GB18_08:MME-05","CL_GB18_08:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_02:ALT-B01","text":"At the surface level, Being, Nothing, Becoming, existence, quality, reality, Something, Other, limit, and finitude appear as successive objects of the same movement of determination.","refs":["CL_GB18_05:ALT-B01","CL_GB18_08:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:ALT-B02","text":"At the structural level, determinate negation organizes the transformation of transition into resultant immediacy, relational quality, limit, and finite self-relation.","refs":["CL_GB18_06:ALT-B02","CL_GB18_08:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:ALT-B03","text":"At the meta-strategic level, the choice between fixed opposites is replaced by an immanent examination that exposes the excluded condition of every position as the motor of its transformation.","refs":["CL_GB18_06:ALT-B03","CL_GB18_07:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:ALT-B04","text":"At the ontological-temporal level, reality is a directed but recursive movement in which earlier determinations continue to operate as sublated conditions of later forms.","refs":["CL_GB18_05:ALT-B04","CL_GB18_06:HSI-03","CL_GB18_08:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:ALT-B05","text":"At the methodological-performative level, the presentation carries out its thesis by provisionally fixing concepts, releasing their inner negativity, and allowing them to recur in altered function.","refs":["CL_GB18_05:ALT-B05","CL_GB18_06:ALT-B05","CL_GB18_08:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_02:FL-01","text":"The first transition is to be immediate and unmediated, yet is demonstrated through a reflected determination of indeterminacy and negativity; enactment and demonstration do not remain congruent. ; Trace Type — Tension","refs":["CL_GB18_05:FL-01","CL_GB18_05:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FL-02","text":"Resultant unity is to generate repose while at the same time actively preserving the difference of its sublated moments; its stability therefore remains necessarily tense. ; Trace Type — Tension","refs":["CL_GB18_06:FL-01","CL_GB18_06:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FL-03","text":"Being-for-self is locally posited as closure, while true infinity and developed subjectivity remain underdetermined in the larger context; terminal assertion and systemic horizon diverge. ; Trace Type — Tension","refs":["CL_GB18_06:GA-12","CL_GB18_07:FL-03","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FL-04","text":"Mediation is constitutive everywhere, but in the sphere of Being it must not yet appear as concrete, posited mediation; the architecture requires an efficacy that it cannot yet explicate operationally. ; Trace Type — Tension","refs":["CL_GB18_08:RMD-06","CL_GB18_08:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FL-05","text":"The transition from logical negativity to resistance, counteraction, and struggle is required in order to determine property dynamically, but is only partially mediated. ; Trace Type — Tension","refs":["CL_GB18_07:FL-04","CL_GB18_07:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:FL-06","text":"Negative self-relation opens subjectivity without already generating a concrete subject; the architecture must distinguish precondition and result, although it connects both through the same figure of negation. ; Trace Type — Tension","refs":["CL_GB18_08:GA-10","CL_GB18_08:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-01","text":"Becoming mutates from the truth of pure opposites into the mechanism of their self-sublation and loses its independent form after generating existence. ; Trace Type — Tension","refs":["CL_GB18_05:AS-B02","CL_GB18_06:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-02","text":"Sublation mutates from a linguistically marked double meaning into the universal operator that negates immediate form, preserves difference, and posits new determinacy. ; Trace Type — Tension","refs":["CL_GB18_06:MP-02","CL_GB18_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-03","text":"Immediacy mutates from the unmediated starting point into the resultant appearance of a sublated genesis and thereby itself becomes the bearer of further mediation. ; Trace Type — Tension","refs":["CL_GB18_06:GA-07","CL_GB18_07:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-04","text":"Negation mutates from the abstract counterpole of Being into qualitative reality and subsequently into limit, barrier, defect, and finitude. ; Trace Type — Tension","refs":["CL_GB18_07:MP-02","CL_GB18_08:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-05","text":"Reality mutates from positive quality into the critical testing concept of affirmative totality and finally into the dynamic self-relation of determinate negativity. ; Trace Type — Tension","refs":["CL_GB18_07:MP-03","CL_GB18_07:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MP-06","text":"Otherness mutates from external counter-determination into the immanent moment of Something; limit is the point at which this withdrawal becomes the positive form of finitude. ; Trace Type — Tension","refs":["CL_GB18_08:RMD-02","CL_GB18_08:MME-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_02:HSI-01","text":"Reality appears as a recursive transformation machine that produces no stable substances, but condenses transitions into provisionally stabilized and again negatable determinations.","refs":["CL_GB18_05:HSI-01","CL_GB18_07:HSI-01","CL_GB18_08:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:HSI-02","text":"The subject appears as a still unfinished switching point of negative self-relation: not as a presupposed bearer, but as a possible effect of the appropriation of otherness and limit.","refs":["CL_GB18_05:HSI-02","CL_GB18_08:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:HSI-03","text":"Time appears as logical belatedness, in which what is past does not vanish but continues to operate, sublated, in the present form and recurs as a mutated determination.","refs":["CL_GB18_07:HSI-03","CL_GB18_08:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:HSI-04","text":"Struggle and navigation do not consist in flight from finitude, but in the reconstruction and preservation of those relational determinations through which a Something resists its dissolution.","refs":["CL_GB18_07:HSI-04","CL_GB18_08:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_02:MRT-B01","text":"The minimally sufficient architecture consists of differentiation, transition, preservative sublation, resultant immediacy, determinate negation, internalization of otherness, and finite self-relation.","refs":["CL_GB18_06:MRT-B01","CL_GB18_08:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MRT-B02","text":"These operations suffice to reconstruct, at the meta-cluster level, the movement from Being and Nothing through Becoming and existence to quality, limit, and finitude.","refs":["CL_GB18_05:MRT-B01","CL_GB18_07:MRT-B01","CL_GB18_08:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MRT-B03","text":"The reconstruction remains coherent provided that no immediacy is treated as presuppositionless, no negation as mere annihilation, and no limit as an external addition.","refs":["CL_GB18_06:MRT-B03","CL_GB18_07:MRT-B02","CL_GB18_08:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MRT-B04","text":"The strongest system achievement is the continuous mutation of a single function of negation: transition becomes preservation, preservation becomes determinacy, determinacy becomes relation, and relation becomes finite self-relation.","refs":["CL_GB18_05:MRT-B04","CL_GB18_07:MRT-B03","CL_GB18_08:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MRT-B05","text":"Underdetermined remain the reflected demonstration of immediate transition, the positive form of true infinity, the step toward struggling property, and the concrete emergence of being-for-self and subjectivity.","refs":["CL_GB18_05:MRT-B02","CL_GB18_07:MRT-B04","CL_GB18_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_02:MRT-B06","text":"The double structure of sublation resists axiomatic reduction: it must negate and preserve difference simultaneously, because only this tension transfers movement into determinate yet still transformable unity.","refs":["CL_GB18_05:MRT-B06","CL_GB18_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_02@R001","source_variant_id":"canonical:MC_GB18_L1_02:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 02","context":"Chapters 13–24 · Anmerkung 3. · Anmerkung 4. · 2. Momente des Werdens. · 3. Aufheben des Werdens. · Anmerkung. · A. Daseyn als solches. · a. Daseyn überhaupt. · b. Qualität. · Anmerkung. · c. Etwas. · B. Die Endlichkeit. · a. Etwas und ein Anderes."},"title_language_code":"en"},{"id":"MC_GB18_L2_02","layer":"MC","title":"Gb18 L2 02","order":2,"parents":["MC_GB18_L1_05","MC_GB18_L1_06","MC_GB18_L1_07","MC_GB18_L1_08"],"revision":"MC_GB18_L2_02@R001","sha256":"2fa1e0de3ac9c94f5ffead4f923dc929a47647e1c67b9fc782fe66551d026bb6","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L2_02:AS-01","text":"Das System muss Einheit, quantitative Bestimmtheit und qualitative Realität erzeugen, ohne selbständige Träger, fertige Quanta oder äußerlich hinzugefügte Relationen vorauszusetzen.","refs":["MC_GB18_L1_05:AS-01","MC_GB18_L1_06:AS-01","MC_GB18_L1_08:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-02","text":"Seine globale These lautet, dass Bestimmtheit nur als relationale Selbstvermittlung besteht und in der Maßform Quantität nicht verschwindet, sondern zur operativen Bedingung qualitativer Realität wird.","refs":["MC_GB18_L1_05:GA-01","MC_GB18_L1_07:AS-02","MC_GB18_L1_08:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-03","text":"Die Bewegung führt von ausschließender Einheit über quantitative Externalisierung, Relation und Grenze zur Selbstnegation des Maßes, in der einzelne Bestimmungen zu Zuständen einer reflektierten Einheit herabgesetzt werden.","refs":["MC_GB18_L1_05:AS-03","MC_GB18_L1_07:GA-11","MC_GB18_L1_08:AS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-04","text":"Der Beweisgang verbindet immanente Erzeugung der Kategorien mit gegenständlicher Prüfung: Weder importierte Voraussetzungen noch empirische oder mathematische Regelmäßigkeit allein sichern begriffliche Geltung.","refs":["MC_GB18_L1_05:AS-07","MC_GB18_L1_07:AS-04","MC_GB18_L1_08:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-05","text":"Äußerlichkeit mutiert vom Zeichen unaufgehobener Aggregation zum notwendigen Medium der Bestimmung und schließlich zum zurückgenommenen Moment negativer Einheit, ohne jemals selbständiger Grund zu werden.","refs":["MC_GB18_L1_06:AS-03","MC_GB18_L1_07:GA-03","MC_GB18_L1_08:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-06","text":"Die Architektur ist rekursiv, spiralförmig und mutationsgetrieben: Jede Schließung erzeugt eine Grenze, jede Grenze ihr Jenseits und jede vermittelte Rückkehr eine neue Schwellenordnung.","refs":["MC_GB18_L1_05:AS-08","MC_GB18_L1_07:AS-05","MC_GB18_L1_08:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-07","text":"Die relative Schließung erfolgt durch den Übergang des Maßes in reflektierte Gesetzlichkeit, Substrat und Wesen; offen bleibt jedoch das immanente Gesetz, das konkrete Exponenten, Reihen und Schwellen erzeugen müsste.","refs":["MC_GB18_L1_07:GA-11","MC_GB18_L1_08:GA-10","MC_GB18_L1_08:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-08","text":"Quantitative Erklärung wird nicht verworfen, sondern regionalisiert: Sie erfasst bestimmte Invarianten, verliert aber ihre Zuständigkeit gegenüber konkreteren Gegenständen und insbesondere gegenüber nicht-dinglichem Geist.","refs":["MC_GB18_L1_06:GA-11","MC_GB18_L1_07:GA-13","MC_GB18_L1_08:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L2_02:GA-01","text":"[Persistent] Keine bestimmte Einheit besitzt vor ihren Relationen vollständige Selbstständigkeit; ihre Identität ist das Resultat vermittelter Differenz.","refs":["MC_GB18_L1_05:GA-01","MC_GB18_L1_07:GA-01","MC_GB18_L1_08:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-02","text":"[Persistent] Negation vernichtet das Ausgeschlossene nicht, sondern erhält es als innere Bedingung der Einheit und als Material weiterer Bestimmung.","refs":["MC_GB18_L1_05:GA-02","MC_GB18_L1_05:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-03","text":"[Mutating] Äußerlichkeit mutiert von begriffloser Setzung über notwendige Vermittlung zum eigenen Moment reflektierter Identität, bleibt aber als unabhängiger Erklärungsgrund ausgeschlossen.","refs":["MC_GB18_L1_06:GA-02","MC_GB18_L1_07:GA-03","MC_GB18_L1_08:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-04","text":"[Mutating] Grenze mutiert von qualitativer Bestimmung über quantitative Selbstbeziehung und rekursive Jenseitserzeugung zum Schwellenparameter qualitativer Transformation.","refs":["MC_GB18_L1_05:GA-07","MC_GB18_L1_06:GA-03","MC_GB18_L1_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-05","text":"[Persistent] Quantität besitzt nur als vermittelte Einheit von Kontinuität, Diskretion, Einheit, Vielheit und Grenze begriffliche Realität.","refs":["MC_GB18_L1_05:GA-06","MC_GB18_L1_06:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-06","text":"[Emergent] Eine qualitative Relation oder Maßstruktur ist der affirmative Grund bestimmter Quantität, weil sie den Größenmomenten ihre Funktion und ihren Geltungsbereich zuweist.","refs":["MC_GB18_L1_07:GA-02","MC_GB18_L1_08:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-07","text":"[Emergent] Formale Erzeugung, numerische Exaktheit und empirische Regelmäßigkeit begründen keine Gegenstandsbedeutung, solange qualitative Typisierung und immanente Vermittlung fehlen.","refs":["MC_GB18_L1_06:GA-10","MC_GB18_L1_07:GA-07","MC_GB18_L1_08:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-08","text":"[Attractor] Widerspruch wird produktiv, sobald seine Pole als Selbstverschiedenheit einer Einheit vermittelt werden; ihre bloße Trennung reproduziert den Widerspruch.","refs":["MC_GB18_L1_05:GA-11","MC_GB18_L1_06:GA-12","MC_GB18_L1_08:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-09","text":"[Attractor] Konkrete Identität ist negative Einheit: die zeitweilige Stabilität einer Bestimmung, die sich durch integrierte Differenz erhält und verändert.","refs":["MC_GB18_L1_06:GA-13","MC_GB18_L1_07:GA-12","MC_GB18_L1_08:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-10","text":"[Emergent] Quantitative Kontinuität erzeugt qualitative Veränderung nur innerhalb eines immanenten Maßgesetzes, das Akkumulation gliedert und an einer Schwelle ihre Funktion umkehrt.","refs":["MC_GB18_L1_07:GA-10","MC_GB18_L1_08:GA-06","MC_GB18_L1_08:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-11","text":"[Terminal] Die Maßarchitektur vollendet sich nicht in einem höchsten Maß, sondern in der Aufhebung selbständiger Maße zu Zuständen einer reflektierten Substrat- oder Wesenseinheit.","refs":["MC_GB18_L1_07:GA-11","MC_GB18_L1_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-12","text":"[Attractor] Das fehlende immanente Erzeugungsgesetz für konkrete Exponenten, Reihen, Affinitäten und Schwellen ist der negative Attraktor, der die systematische Öffnung aufrechterhält.","refs":["MC_GB18_L1_08:GA-11","MC_GB18_L1_08:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-13","text":"[Terminal] Quantitative Kategorien behalten regionale Geltung, können aber weder konkrete Wirklichkeit überhaupt noch nicht-dinglichen Geist unter ein einheitliches Erklärungsregime zwingen.","refs":["MC_GB18_L1_06:GA-11","MC_GB18_L1_07:GA-13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L2_02:RMD-01","text":"Das Eins wandert von unmittelbarer Einzelheit über Zahl und relationales Quantum zum vorläufig selbstständigen Knoten; seine organisatorische Funktion bleibt, seine beziehungslose Selbstständigkeit verschwindet.","refs":["MC_GB18_L1_05:RMD-01","MC_GB18_L1_07:RMD-01","MC_GB18_L1_08:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-02","text":"Repulsion und Attraktion verlieren ihre Identität als getrennte Kräfte und werden in die negative Einheit absorbiert, die Ausschluss, Beziehung und Selbsterhaltung zugleich organisiert.","refs":["MC_GB18_L1_05:RMD-02","MC_GB18_L1_05:RMD-03","MC_GB18_L1_08:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-03","text":"Äußerlichkeit kehrt funktional auf jeder Stufe wieder, wechselt aber von defizitärer Fremdsetzung über reale Vermittlungsbedingung zum Ort qualitativer Selbstbeziehung.","refs":["MC_GB18_L1_06:RMD-02","MC_GB18_L1_07:RMD-07","MC_GB18_L1_08:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-04","text":"Grenze erweitert ihren Geltungsbereich von qualitativer Bestimmtheit und Zahl über das rekursiv gesetzte Jenseits bis zur Maßschwelle, an der sie eine neue Qualität freisetzt.","refs":["MC_GB18_L1_05:RMD-07","MC_GB18_L1_06:RMD-03","MC_GB18_L1_08:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-05","text":"Unendlichkeit mutiert vom schlechten Progress über die immanente Vollständigkeit einer Relation zur Maßlosigkeit, welche nicht Ferne, sondern produktive Selbstnegation bezeichnet.","refs":["MC_GB18_L1_06:RMD-06","MC_GB18_L1_07:RMD-04","MC_GB18_L1_08:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-06","text":"Der Exponent wandert vom gemeinsamen Zahlenwert zum qualitativen Invarianten einer Relation und weiter zum empirisch prekären Index von Reihen, Ausschlüssen und Schwellen.","refs":["MC_GB18_L1_07:GA-04","MC_GB18_L1_08:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-07","text":"Maß mutiert von unmittelbarer Einheit über selbstvermittelte Gesetzlichkeit und Schwellenmaschine zur untergeordneten Zustandsform eines fortbestehenden Substrats.","refs":["MC_GB18_L1_07:RMD-08","MC_GB18_L1_08:RMD-01","MC_GB18_L1_08:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-08","text":"Kontinuität und Diskretion bleiben funktional erhalten, werden aber von abstrakten Gegensätzen zu gemeinsamem Träger und Gliederung einer seriellen Schwellenordnung umcodiert.","refs":["MC_GB18_L1_05:RMD-05","MC_GB18_L1_05:RMD-06","MC_GB18_L1_08:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-09","text":"Widerspruch wandert von der Selbstzerstörung isolierter Bestimmungen über Antinomie und quantitative Negativität zum Attraktor jeder Vermittlung von Erhaltung und Veränderung.","refs":["MC_GB18_L1_05:RMD-09","MC_GB18_L1_06:RMD-09","MC_GB18_L1_06:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L2_02:CGD-01","text":"Einzelne Kraft-, Materie-, Raum- und Bewegungsmodelle bleiben lokale Diagnosefelder; auf der aktuellen Ebene skaliert nur das Verbot, den zu erzeugenden Gegenstand als fertigen Träger vorauszusetzen.","refs":["MC_GB18_L1_05:CGD-03","MC_GB18_L1_05:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-02","text":"Rechnungsarten, Grenzwerte, Zahlformen und historische Kalkülbegründungen bleiben lokale Operationen; global tragen sie die Differenz zwischen formalem Erfolg und begrifflicher Selbstvermittlung.","refs":["MC_GB18_L1_06:CGD-01","MC_GB18_L1_07:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-03","text":"Physikalische, chemische, musikalische, moralische und staatliche Beispiele bleiben domänenspezifisch; nach oben skaliert allein der gemeinsame Typus relationaler und schwellenabhängiger Transformation.","refs":["MC_GB18_L1_08:CGD-01","MC_GB18_L1_08:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-04","text":"Konkrete Koeffizienten, Exponenten, Affinitäten und Maßpunkte bleiben auf unteren Ebenen unterbestimmt; global wird diese Nichtableitbarkeit zum negativen Attraktor der Gesamtarchitektur.","refs":["MC_GB18_L1_08:CGD-06","MC_GB18_L1_08:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-05","text":"Die Behandlung von Seele und Geist bleibt ein lokaler Grenztest, doch die Selbstbegrenzung quantitativer Kategorien gegenüber nicht-dinglicher Wirklichkeit skaliert zur allgemeinen Geltungsregel.","refs":["MC_GB18_L1_06:CGD-03","MC_GB18_L1_06:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-06","text":"Der Übergang des Maßes zum Wesen und die Entselbstständigung einzelner Maße im Substrat sind keine weiteren Regionaloperationen, sondern die Schließungsform der aktuellen Syntheseebene.","refs":["MC_GB18_L1_07:CGD-07","MC_GB18_L1_08:CGD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-07","text":"Bestimmte Verhältnis- und Potenzformen bleiben lokale Sequenzen; global skaliert die Umcodierung mathematischer Formen zu Funktionsstellen relationaler Selbstbestimmung.","refs":["MC_GB18_L1_07:CGD-02","MC_GB18_L1_08:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L2_02:GNX-01","text":"Ausgeschlossen ist jede Ontologie fertiger Substanzen oder Quanta, die vor ihren Beziehungen vollständig bestimmt wären.","refs":["MC_GB18_L1_05:GNX-01","MC_GB18_L1_07:GNX-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-02","text":"Ausgeschlossen ist ein sich selbst interpretierender Formalismus, der Exaktheit, syntaktische Ableitbarkeit oder Rechenleistung unmittelbar in begriffliche Wahrheit verwandelt.","refs":["MC_GB18_L1_06:GNX-01","MC_GB18_L1_07:GNX-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-03","text":"Ausgeschlossen ist additive oder lineare Kausalität, sofern bloße Wiederholung äußerer Einwirkungen ohne Maßrelation innere Einheit oder qualitative Veränderung erzeugen soll.","refs":["MC_GB18_L1_06:GNX-02","MC_GB18_L1_08:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-04","text":"Ausgeschlossen sind sowohl unabhängige Atome als auch ein homogenes Kontinuum, das Diskretion, qualitative Neuheit und reale Sprünge tilgt.","refs":["MC_GB18_L1_05:GNX-03","MC_GB18_L1_08:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-05","text":"Ausgeschlossen sind kumulativer Fortschritt zu positiver Unendlichkeit und ein letztes Maß, das der eigenen Begrenzung oder Transformation entzogen wäre.","refs":["MC_GB18_L1_06:GNX-05","MC_GB18_L1_08:GNX-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-06","text":"Ausgeschlossen ist die Quantifizierung des Geistes ebenso wie die Universalisierung quantitativer Gesetzlichkeit zu einer Ontologie aller Gegenstandsbereiche.","refs":["MC_GB18_L1_06:GNX-04","MC_GB18_L1_07:GNX-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-07","text":"Ausgeschlossen ist eine Außenperspektive, von der aus Relationen, Maße und Widersprüche hergestellt oder vollständig überblickt werden könnten, ohne selbst in das Vermittlungsfeld einzutreten.","refs":["MC_GB18_L1_05:BSA-02","MC_GB18_L1_08:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L2_02:DBN-01","text":"Damit das System trägt, muss jede vorrelationale Selbstständigkeit falsch sein; andernfalls wären Beziehung, Maß und negative Einheit nachträgliche Zusätze statt konstitutiver Operationen.","refs":["MC_GB18_L1_05:DBN-01","MC_GB18_L1_07:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:DBN-02","text":"Operative Berechenbarkeit darf nicht mit ontologischer Zusammensetzung und empirische Bestätigung nicht mit begrifflicher Erzeugung identisch sein.","refs":["MC_GB18_L1_07:DBN-06","MC_GB18_L1_08:GNX-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:DBN-03","text":"Quantitative Akkumulation darf weder wahre Unendlichkeit noch qualitative Veränderung aus sich allein hervorbringen, weil sie ohne Maßgesetz nur die vorhandene Grenzform reproduziert.","refs":["MC_GB18_L1_06:DBN-03","MC_GB18_L1_07:GNX-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:DBN-04","text":"Negation darf weder ihr Anderes vollständig vernichten noch Selbsterhaltung als unverändertes Beharren fixieren; beides würde die produktive Vermittlung von Identität und Veränderung zerstören.","refs":["MC_GB18_L1_05:DBN-03","MC_GB18_L1_08:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:DBN-05","text":"Eine vollständige Deduktion konkreter Zahlen und Schwellen darf nicht fingiert werden; die offene Nichtverfügbarkeit ihres Erzeugungsprinzips gehört zur tragenden Architektur.","refs":["MC_GB18_L1_08:DBN-04","MC_GB18_L1_08:GA-11"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L2_02:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist eine erste Unmittelbarkeit oder letzte Selbstständigkeit, die Differenz, Relation und Veränderung vollständig hinter sich lassen könnte.","refs":["MC_GB18_L1_05:BSA-01","MC_GB18_L1_08:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:BSA-02","text":"Nicht verfügbar ist ein dauerhaftes Außen, in das Grenze, Widerspruch oder qualitative Bestimmung ausgelagert werden könnten, ohne als Momente der Einheit zurückzukehren.","refs":["MC_GB18_L1_05:BSA-02","MC_GB18_L1_07:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:BSA-03","text":"Die Architektur umkreist das fehlende Gesetz, das konkrete Exponenten, Affinitäten, Reihen und Schwellen aus einer gemeinsamen immanenten Ordnung erzeugen würde.","refs":["MC_GB18_L1_08:BSA-01","MC_GB18_L1_08:GA-11"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:BSA-04","text":"Unverfügbar ist eine vollständig kommensurable Zahlenordnung, in der qualitative Differenz, Neuheit und Unterbrechung restlos als homogene Variation darstellbar wären.","refs":["MC_GB18_L1_07:BSA-05","MC_GB18_L1_08:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L2_02:XD-01","text":"Quantität ist die transformierte Gestalt negativer Beziehung: Erst eine qualitative Relation macht ihre Einheiten bestimmt und verwandelt äußerliche Größen in Momente eines Maßes.","refs":["MC_GB18_L2_02:GA-01","MC_GB18_L2_02:GA-05","MC_GB18_L2_02:GA-06","MC_GB18_L1_05:GA-05","MC_GB18_L1_07:GA-02","MC_GB18_L1_08:GA-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-02","text":"Äußerlichkeit ist weder an sich defizitär noch an sich produktiv; ihre Funktion hängt davon ab, ob sie als fremde Setzung fixiert oder in negative Einheit zurückgenommen wird.","refs":["MC_GB18_L2_02:GA-03","MC_GB18_L2_02:GA-09","MC_GB18_L1_06:GA-02","MC_GB18_L1_07:RMD-07","MC_GB18_L1_08:GA-12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-03","text":"Die Grenze erzeugt eine gestufte Transformationslogik: Als bloß wiedergesetzte Grenze produziert sie schlechten Progress, als maßförmige Schwelle qualitative Selbstnegation.","refs":["MC_GB18_L2_02:GA-04","MC_GB18_L2_02:GA-10","MC_GB18_L1_06:GA-06","MC_GB18_L1_07:GA-10","MC_GB18_L1_08:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-04","text":"Begriffliche Legitimität verlangt eine doppelte Prüfung: Die Kategorien müssen ihre Voraussetzungen immanent erzeugen, und ihre formalen Resultate müssen qualitativ typisiert und am Gegenstand validiert werden.","refs":["MC_GB18_L2_02:GA-07","MC_GB18_L2_02:GA-12","MC_GB18_L1_05:AS-07","MC_GB18_L1_07:GA-07","MC_GB18_L1_08:AS-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-05","text":"Widerspruch wird nur dann zur Entwicklungsoperation, wenn das ausgeschlossene Moment erhalten und als Selbstverschiedenheit der Einheit integriert wird.","refs":["MC_GB18_L2_02:GA-02","MC_GB18_L2_02:GA-08","MC_GB18_L2_02:GA-09","MC_GB18_L1_05:GA-02","MC_GB18_L1_06:GA-12","MC_GB18_L1_08:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-06","text":"Zahl, Exponent und Maß bilden keine additive Kategorienfolge, sondern eine Mutation der Grenze vom selbstbegrenzenden Zahlenwert zur qualitativen Invariante und zum bedingten Schwellenindex.","refs":["MC_GB18_L2_02:GA-04","MC_GB18_L2_02:GA-06","MC_GB18_L2_02:GA-10","MC_GB18_L1_05:GA-08","MC_GB18_L1_07:GA-04","MC_GB18_L1_08:RMD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-07","text":"Die Schließung der Maßlogik erzeugt zugleich ihre terminale Öffnung: Maße werden in Substrat und Wesen absorbiert, während das konkrete Gesetz ihrer Reihenbildung unverfügbar bleibt.","refs":["MC_GB18_L2_02:GA-11","MC_GB18_L2_02:GA-12","MC_GB18_L1_07:GA-11","MC_GB18_L1_08:GA-10","MC_GB18_L1_08:GA-11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-08","text":"Die Hervorbringung qualitativer Bestimmung aus quantitativer Vermittlung legitimiert keine universale Quantifizierung, weil die Reichweite quantitativer Kategorien mit wachsender Gegenstandskonkretion endet.","refs":["MC_GB18_L2_02:GA-07","MC_GB18_L2_02:GA-13","MC_GB18_L1_06:GA-11","MC_GB18_L1_07:GA-13"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L2_02:BSD-01","text":"Ontologisch werden Entitäten zu stabilisierten relationalen Phasen: Sie sind Knoten maßförmiger Beziehungen und zugleich Zustände der Einheit, die ihre Veränderungen trägt.","refs":["MC_GB18_L1_05:BSD-01","MC_GB18_L1_08:GA-04","MC_GB18_L1_08:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-02","text":"Kausalität wird rekursiv und schwellenförmig: Eine äußere Veränderung wird intern spezifiziert, reorganisiert die Relationsordnung und erzeugt an einer Maßgrenze eine neue qualitative Form.","refs":["MC_GB18_L1_05:BSD-02","MC_GB18_L1_08:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-03","text":"Zeit zerfällt in mechanische Wiederholung, schlechte Grenzperennierung, kumulative Schwellenbewegung und reflexive Rückkehr; ihre Einheit ist spiralförmig statt linear.","refs":["MC_GB18_L1_05:BSD-04","MC_GB18_L1_07:BSD-03","MC_GB18_L1_08:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-04","text":"Erkenntnis wird zu einem gestuften Verfahren aus genetischer Kategorienrekonstruktion, formaler Erzeugung, qualitativer Typisierung, Beobachtung und Gegenstandsprüfung.","refs":["MC_GB18_L1_05:BSD-05","MC_GB18_L1_07:BSD-02","MC_GB18_L1_08:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-05","text":"Das Subjekt verliert den Status eines souveränen Setzers und wird zur vermittelnden, widerspruchsfähigen Instanz; als Geist bleibt es auf quantitative Dingkategorien irreduzibel.","refs":["MC_GB18_L1_05:BSD-03","MC_GB18_L1_06:BSD-04","MC_GB18_L1_07:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-06","text":"Mathematik wird regionalisiert: Ihre Exaktheit kann bestimmte Invarianten vollständig erfassen, ohne daraus universale ontologische Reichweite zu gewinnen.","refs":["MC_GB18_L1_05:BSD-06","MC_GB18_L1_07:XD-07","MC_GB18_L1_07:MME-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-07","text":"Handlungsmacht besteht in der Transformation relationaler Bedingungen und der Navigation von Schwellen, nicht in abstrakter Grenzüberschreitung oder bloßer Mengensteigerung.","refs":["MC_GB18_L1_06:BSD-06","MC_GB18_L1_08:BSD-06","MC_GB18_L1_08:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L2_02:RLE-01","text":"Die elementare Schleife lautet: Ausschließung setzt Andere voraus, das Andere macht Ausschließung zur Beziehung, und Beziehung erzeugt eine vermittelte Form der Selbstständigkeit.","refs":["MC_GB18_L1_05:RLE-01","MC_GB18_L1_08:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-02","text":"Die Grenzschleife erzeugt aus jeder bestimmten Grenze ein Jenseits und aus jedem Jenseits eine neue Grenze; erst die Rücknahme dieser Äußerlichkeit unterbricht den schlechten Progress.","refs":["MC_GB18_L1_06:RLE-02","MC_GB18_L1_06:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-03","text":"Kontinuität ermöglicht Teilung, Teilung setzt diskrete Einheiten, deren Gleichheit Kontinuität wiederherstellt und über Zahl und Grad zur Maßordnung eskaliert.","refs":["MC_GB18_L1_05:RLE-03","MC_GB18_L1_06:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-04","text":"Die Relationsspirale führt von äußerlicher Vergleichung über Exponent und Potenz zur qualitativen Invariante, die als gemeinsamer Attraktor mathematische Form und Maßbestimmung organisiert.","refs":["MC_GB18_L1_07:RLE-02","MC_GB18_L1_07:RLE-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-05","text":"Die Schwelleneskalation führt von gleichgültiger Variation über Wiederholung und Akkumulation zu Gleichgültigkeitsbereich, Maßpunkt, qualitativem Sprung und erneuter Variation.","refs":["MC_GB18_L1_07:RLE-04","MC_GB18_L1_08:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-06","text":"Die terminale Schleife vervielfältigt Maße, erzeugt Knotenlinien und führt ihre Selbstständigkeit schließlich auf Substratkontinuität und reflektierte Wesensstruktur zurück.","refs":["MC_GB18_L1_08:RLE-05","MC_GB18_L1_07:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-07","text":"Die Maschine wird von zwei Attraktoren organisiert: positiv von immanenter Vermittlung, negativ vom fehlenden geschlossenen Maßsystem, das jede Erweiterung erneut verlangt.","refs":["MC_GB18_L1_05:RLE-07","MC_GB18_L1_08:RLE-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L2_02:FGS-B01","text":"Unmittelbare Einheit plus Ausschließung erzeugt vorausgesetzte Vielheit; deren Erhaltung verwandelt isolierte Selbstständigkeit in vermittelte Beziehung.","refs":["MC_GB18_L1_05:FGS-B01","MC_GB18_L1_05:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B02","text":"Erhaltene Vielheit plus Gleichheit der Einheiten erzeugt Kontinuität mit innerer Diskretion und damit Quantität als vermittelte Externalisierung.","refs":["MC_GB18_L1_05:FGS-B03","MC_GB18_L1_05:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B03","text":"Quantität plus immanente Grenze erzeugt Quantum und Zahl; die Aufhebung der Anzahl in einfacher Grenze erzeugt Grad und relationale Intensität.","refs":["MC_GB18_L1_05:FGS-B05","MC_GB18_L1_06:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B04","text":"Wiederholte Begrenzung erzeugt schlechten Progress; die Rücknahme des Jenseits als eigenes Moment verwandelt serielle Unendlichkeit in relationale Qualität.","refs":["MC_GB18_L1_06:FGS-B05","MC_GB18_L1_06:FGS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B05","text":"Das Relationsmoment organisiert sich als Exponent, Potenz oder Grenze; qualitative Typisierung und Gegenstandsprüfung bestimmen anschließend seine konkrete Maßgeltung.","refs":["MC_GB18_L1_07:FGS-B03","MC_GB18_L1_07:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B06","text":"Fortgesetzte quantitative Variation erreicht einen Maßpunkt, setzt eine neue Qualität frei und führt durch wiederholte Umschläge einzelne Maße auf ein gemeinsames Substrat zurück.","refs":["MC_GB18_L1_08:FGS-B05","MC_GB18_L1_08:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B07","text":"Die Maschine schließt relativ durch qualitative Selbstvermittlung, Substrat und Wesen, bleibt aber wegen des fehlenden konkreten Erzeugungsgesetzes terminal offen.","refs":["MC_GB18_L1_07:FGS-B08","MC_GB18_L1_08:MRT-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L2_02:AFM-B01","text":"Unmittelbare Einheit → Ausschließung → vorausgesetzte Vielheit → negative Beziehung → vermittelte Einheit → Quantität.","refs":["MC_GB18_L1_05:AS-08","MC_GB18_L1_05:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AFM-B02","text":"Quantität → immanente Grenze → Zahl und Grad → Jenseits der Grenze → schlechter Progress → Rücknahme der Äußerlichkeit → relationale Qualität.","refs":["MC_GB18_L1_06:GA-06","MC_GB18_L1_06:FGS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AFM-B03","text":"Relationale Qualität → äußerliches Verhältnis → Exponent und Potenz → qualitative Invariante → Maß → reflektierte Gesetzlichkeit.","refs":["MC_GB18_L1_07:AS-03","MC_GB18_L1_07:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AFM-B04","text":"Maßvariation → Gleichgültigkeitsbereich → Maßpunkt → qualitativer Sprung → Knotenlinie → Substratkontinuität → Entselbstständigung des Maßes → Wesen.","refs":["MC_GB18_L1_08:AS-04","MC_GB18_L1_08:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AFM-B05","text":"Formale Operation → Rechtfertigungsdefizit → immanente Rekonstruktion → qualitative Typisierung → Gegenstandsprüfung → regional begrenzte Geltung.","refs":["MC_GB18_L1_05:AS-07","MC_GB18_L1_07:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L2_02:MME-01","text":"Selbständige Substanzen und Relata werden aus der Grundkarte entfernt; Beziehung wird zur konstitutiven Form, durch die ihre Seiten erst bestimmte Geltung erhalten.","refs":["MC_GB18_L1_05:MME-01","MC_GB18_L1_07:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-02","text":"Qualität und Quantität verlieren den Status getrennter Ordnungen und werden als reziproke Momente einer Maßstruktur neu kartiert.","refs":["MC_GB18_L1_06:MME-04","MC_GB18_L1_07:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-03","text":"Kontinuität und Diskontinuität werden auf verschiedene Funktionen verteilt: Kontinuität trägt Variation, Diskretion gliedert sie, und qualitative Sprünge transformieren ihre Ordnung.","refs":["MC_GB18_L1_07:MME-06","MC_GB18_L1_08:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-04","text":"Endlichkeit und Unendlichkeit werden durch die Differenz zwischen äußerem Progress, gegenwärtiger Relationsvollständigkeit und maßinterner Negativität ersetzt.","refs":["MC_GB18_L1_06:MME-05","MC_GB18_L1_07:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-05","text":"Mathematische Form wird von einer äußeren Autorität zu einem regionalen Prüf- und Darstellungsverfahren umklassifiziert, dessen ontologische Bedeutung gesondert ausgewiesen werden muss.","refs":["MC_GB18_L1_06:MME-07","MC_GB18_L1_08:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-06","text":"Das Ding wird vom Träger fertiger Eigenschaften zum relationalen Knoten und schließlich zum Zustand eines durch qualitative Wechsel fortbestehenden Substrats.","refs":["MC_GB18_L1_08:MME-02","MC_GB18_L1_08:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-07","text":"Adäquate Lektüre muss Wiederkehr als mögliche Mutation, Umkehrung oder Absorption lesen, weil identische Ausdrücke auf verschiedenen Stufen unterschiedliche systematische Funktionen übernehmen.","refs":["MC_GB18_L1_08:MME-07","MC_GB18_L1_07:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L2_02:ALT-B01","text":"Auf der Oberflächenebene erscheinen Eins, Zahl, Grad, Verhältnis, Potenz, Messung, Reihen, physikalische und chemische Relationen sowie qualitative Sprünge als explizite Gegenstände.","refs":["MC_GB18_L1_05:ALT-B01","MC_GB18_L1_06:ALT-B01","MC_GB18_L1_08:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:ALT-B02","text":"Auf der strukturellen Ebene organisieren Grenze, Äußerlichkeit, Relation, Maß und negative Einheit die Erzeugung, Stabilisierung und Transformation bestimmter Gestalten.","refs":["MC_GB18_L1_05:ALT-B02","MC_GB18_L1_06:ALT-B02","MC_GB18_L1_08:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:ALT-B03","text":"Auf der metastrategischen Ebene wird Erklärung von äußerer Addition und Modellübertragung auf die Rekonstruktion relationaler Erzeugungsbedingungen und reproduzierter Widersprüche verlegt.","refs":["MC_GB18_L1_05:ALT-B03","MC_GB18_L1_06:ALT-B03","MC_GB18_L1_08:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:ALT-B04","text":"Auf der ontologischen und temporalen Ebene ist Realität vermittelte Selbstverschiedenheit, deren Zeit aus Wiederholung, Grenzperennierung, Schwelle, Unterbrechung und Rückkehr besteht.","refs":["MC_GB18_L1_05:ALT-B04","MC_GB18_L1_06:ALT-B04","MC_GB18_L1_08:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:ALT-B05","text":"Auf der methodologischen und performativen Ebene vollzieht die Darstellung ihre These, indem jede fixierte Bestimmung durch ihre eigenen Voraussetzungen und Folgen in eine umfassendere Vermittlungsordnung überführt wird.","refs":["MC_GB18_L1_05:ALT-B05","MC_GB18_L1_06:ALT-B05","MC_GB18_L1_08:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L2_02:FL-01","text":"Äußerlichkeit muss notwendiger Ausgangspunkt und bleibendes Moment sein, darf aber keine unabhängige Erklärungskraft besitzen; die Architektur kann sie weder eliminieren noch verselbstständigen.","refs":["MC_GB18_L1_08:FL-01","MC_GB18_L1_06:GA-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-02","text":"Grenze muss der bestehenden Qualität gleichgültig und zugleich für ihre quantitative und qualitative Bestimmtheit konstitutiv sein; diese Doppelstellung treibt die Bewegung, ohne sich auflösen zu lassen.","refs":["MC_GB18_L1_05:FL-04","MC_GB18_L1_08:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-03","text":"Die konstitutive Rolle von Anwendung und Gegenstandsprüfung steht in Spannung zur Forderung, Wahrheit müsse vollständig aus immanenter Selbstbestimmung hervorgehen.","refs":["MC_GB18_L1_07:FL-02","MC_GB18_L1_07:AS-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-04","text":"Der universale kategoriale Übergang des Maßes zum Wesen steht in Spannung zur regionalen und gegenstandsabhängigen Geltung quantitativer Gesetzlichkeit.","refs":["MC_GB18_L1_07:FL-03","MC_GB18_L1_07:GA-13"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-05","text":"Quantitative Vermittlung soll Qualität erzeugen, muss aber für Geist kategorial aufgehoben werden; die positive Vermittlung zwischen objektiver Negativität und geistiger Selbstbestimmung bleibt offen.","refs":["MC_GB18_L1_06:FL-04","MC_GB18_L1_06:FL-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-06","text":"Exponenten und Schwellen sollen qualitative Notwendigkeit ausdrücken, obwohl ihre konkreten Werte und ihr positives Erzeugungsprinzip empirisch oder sachlogisch unterbestimmt bleiben.","refs":["MC_GB18_L1_08:FL-04","MC_GB18_L1_08:FL-06","MC_GB18_L1_08:MRT-B06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-07","text":"Das Substrat muss durch qualitative Wechsel bestimmt werden und zugleich als dasselbe fortbestehen; seine Einheit oszilliert daher produktiv zwischen Identität und Zustandsfolge.","refs":["MC_GB18_L1_08:FL-05","MC_GB18_L1_08:DBN-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-01","text":"Das Eins und das Quantum mutieren vom selbständigen Ausgangspunkt über unselbständige Relationsmomente zu temporär stabilen relationalen Knoten.","refs":["MC_GB18_L1_05:MP-01","MC_GB18_L1_07:RMD-01","MC_GB18_L1_08:RMD-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-02","text":"Äußerlichkeit mutiert vom Mangel über die notwendige Form gegenständlicher Bestimmung zum zurückgenommenen Moment negativer Einheit.","refs":["MC_GB18_L1_06:RMD-02","MC_GB18_L1_07:RMD-07","MC_GB18_L1_08:GA-12"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-03","text":"Unendlichkeit mutiert vom unbegrenzten Progress zur relationalen Gegenwart; ihre negative Übergangsfunktion wird anschließend von Maßlosigkeit und Schwelle übernommen.","refs":["MC_GB18_L1_06:MP-03","MC_GB18_L1_07:MP-04","MC_GB18_L1_08:MP-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-04","text":"Der Exponent mutiert vom Zahlenquotienten zum qualitativen Relationsprinzip, danach zum Ausschlussoperator und schließlich zum bedingten Index empirischer Ordnungen.","refs":["MC_GB18_L1_07:MP-02","MC_GB18_L1_08:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-05","text":"Maß mutiert von unmittelbarer Einheit über selbstvermittelte Gesetzlichkeit und Übergangsmaschine zum untergeordneten Zustand des Substrats.","refs":["MC_GB18_L1_07:MP-05","MC_GB18_L1_08:MP-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-06","text":"Selbstständigkeit mutiert von negativer Abgrenzung über relationale Knotenbildung zur bloßen Zustandsform einer umfassenderen Einheit, ohne vollständig irreal zu werden.","refs":["MC_GB18_L1_08:RMD-04","MC_GB18_L1_08:RMD-08"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L2_02:HSI-01","text":"Realität erscheint als rekursive Schwellen- und Maßmaschine, in der Trennung Beziehung erzeugt, Beziehungen Gestalten stabilisieren und Grenzen qualitative Transformationen auslösen.","refs":["MC_GB18_L1_05:HSI-01","MC_GB18_L1_07:HSI-01","MC_GB18_L1_08:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:HSI-02","text":"Das Subjekt ist kein souveränes Zentrum, sondern ein relationaler Knoten und eine vermittelnde Instanz; als Geist bleibt es auf quantitative Dingbestimmung irreduzibel.","refs":["MC_GB18_L1_05:HSI-02","MC_GB18_L1_07:HSI-02","MC_GB18_L1_08:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:HSI-03","text":"Zeit ist eine Spiralstruktur aus Wiederholung, quantitativer Fortsetzung, qualitativer Unterbrechung und rückkehrender Einheit, die ihre Voraussetzungen auf veränderter Stufe reproduziert.","refs":["MC_GB18_L1_05:HSI-03","MC_GB18_L1_07:HSI-03","MC_GB18_L1_08:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:HSI-04","text":"Navigation bleibt als immanente Verfolgung von Umschlagspunkten und Eingriff in Relationsordnungen möglich, nicht aber als Verfügung über ein äußeres Auswahl-, Maß- oder Schwellengesetz.","refs":["MC_GB18_L1_05:HSI-04","MC_GB18_L1_07:HSI-04","MC_GB18_L1_08:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L2_02:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von ausschließender Einheit über Quantität, Grenze, Relation und Maß bis zu Schwelle, Substrat und Wesen zu rekonstruieren.","refs":["MC_GB18_L1_05:MRT-B01","MC_GB18_L1_07:MRT-B01","MC_GB18_L1_08:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MRT-B02","text":"Die Architektur ist am stärksten, wo sie isolierte Selbstständigkeit in relationale Funktion, quantitative Äußerlichkeit in qualitative Spezifikation und Stabilität in vermittelte Differenz transformiert.","refs":["MC_GB18_L1_05:MRT-B02","MC_GB18_L1_07:MRT-B02","MC_GB18_L1_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MRT-B03","text":"Unterbestimmt bleiben die positive Genesis des Geistes, konkrete Maßgrenzen, die universale Reichweite der Potenzform sowie Exponenten, Affinitäten, Mischungsregeln und Schwellenwerte.","refs":["MC_GB18_L1_05:MRT-B03","MC_GB18_L1_07:MRT-B03","MC_GB18_L1_08:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MRT-B04","text":"Das System ist auf dieser Ebene kohärent, sofern Negation als Erhaltung, Äußerlichkeit als vermitteltes Moment, Widerspruch als Übergangsoperation und Maß als nichtterminale Schließung gelesen werden.","refs":["MC_GB18_L1_05:MRT-B04","MC_GB18_L1_06:MRT-B05","MC_GB18_L1_08:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MRT-B05","text":"Der axiomatischen Schließung widersteht die Verbindung aus produktiver Doppelstellung der Grenze, notwendiger Gegenstandsprüfung und fehlendem immanentem Naturgesetz; gerade dieser Rest hält die Maschine beweglich.","refs":["MC_GB18_L1_05:MRT-B06","MC_GB18_L1_07:MRT-B05","MC_GB18_L1_08:MRT-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T124310594810Z_35035180","language_code":"en","language_name":"English","title":"Gb18 L2 02","source_sha256":"2fa1e0de3ac9c94f5ffead4f923dc929a47647e1c67b9fc782fe66551d026bb6","sha256":"2264d158814bfcd88a9e7b0e6a191d623eda6ea4a6cdc0576773eb63d152c9d5","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:43:10.596575+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L2_02:AS-01","text":"The system must generate unity, quantitative determinacy, and qualitative reality without presupposing independent bearers, ready-made quanta, or externally added relations.","refs":["MC_GB18_L1_05:AS-01","MC_GB18_L1_06:AS-01","MC_GB18_L1_08:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-02","text":"Its global thesis is that determinacy exists only as relational self-mediation and that, in the form of measure, quantity does not disappear but becomes the operative condition of qualitative reality.","refs":["MC_GB18_L1_05:GA-01","MC_GB18_L1_07:AS-02","MC_GB18_L1_08:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-03","text":"The movement leads from exclusive unity through quantitative externalization, relation, and limit to the self-negation of measure, in which individual determinations are reduced to states of a reflected unity.","refs":["MC_GB18_L1_05:AS-03","MC_GB18_L1_07:GA-11","MC_GB18_L1_08:AS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-04","text":"The course of proof connects the immanent generation of categories with objective testing: neither imported presuppositions nor empirical or mathematical regularity alone secures conceptual validity.","refs":["MC_GB18_L1_05:AS-07","MC_GB18_L1_07:AS-04","MC_GB18_L1_08:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-05","text":"Externality mutates from the sign of un-sublated aggregation into the necessary medium of determination and finally into the withdrawn moment of negative unity, without ever becoming an independent ground.","refs":["MC_GB18_L1_06:AS-03","MC_GB18_L1_07:GA-03","MC_GB18_L1_08:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-06","text":"The architecture is recursive, spiral-shaped, and mutation-driven: every closure generates a limit, every limit its beyond, and every mediated return a new threshold order.","refs":["MC_GB18_L1_05:AS-08","MC_GB18_L1_07:AS-05","MC_GB18_L1_08:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-07","text":"Relative closure occurs through the transition of measure into reflected lawfulness, substrate, and essence; yet the immanent law that would have to generate concrete exponents, series, and thresholds remains open.","refs":["MC_GB18_L1_07:GA-11","MC_GB18_L1_08:GA-10","MC_GB18_L1_08:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AS-08","text":"Quantitative explanation is not rejected but regionalized: it grasps certain invariants, yet loses its competence in relation to more concrete objects and especially to non-thing-like spirit.","refs":["MC_GB18_L1_06:GA-11","MC_GB18_L1_07:GA-13","MC_GB18_L1_08:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L2_02:GA-01","text":"[Persistent] No determinate unity possesses complete independence prior to its relations; its identity is the result of mediated difference.","refs":["MC_GB18_L1_05:GA-01","MC_GB18_L1_07:GA-01","MC_GB18_L1_08:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-02","text":"[Persistent] Negation does not annihilate the excluded, but preserves it as an inner condition of unity and as material for further determination.","refs":["MC_GB18_L1_05:GA-02","MC_GB18_L1_05:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-03","text":"[Mutating] Externality mutates from conceptless positing through necessary mediation into its own moment of reflected identity, but remains excluded as an independent explanatory ground.","refs":["MC_GB18_L1_06:GA-02","MC_GB18_L1_07:GA-03","MC_GB18_L1_08:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-04","text":"[Mutating] Limit mutates from qualitative determination through quantitative self-relation and recursive generation of a beyond into the threshold parameter of qualitative transformation.","refs":["MC_GB18_L1_05:GA-07","MC_GB18_L1_06:GA-03","MC_GB18_L1_08:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-05","text":"[Persistent] Quantity possesses conceptual reality only as the mediated unity of continuity, discreteness, unity, multiplicity, and limit.","refs":["MC_GB18_L1_05:GA-06","MC_GB18_L1_06:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-06","text":"[Emergent] A qualitative relation or measure structure is the affirmative ground of determinate quantity because it assigns the moments of magnitude their function and scope of validity.","refs":["MC_GB18_L1_07:GA-02","MC_GB18_L1_08:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-07","text":"[Emergent] Formal generation, numerical exactness, and empirical regularity do not establish objective significance so long as qualitative typification and immanent mediation are lacking.","refs":["MC_GB18_L1_06:GA-10","MC_GB18_L1_07:GA-07","MC_GB18_L1_08:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-08","text":"[Attractor] Contradiction becomes productive once its poles are mediated as the self-difference of a unity; their mere separation reproduces the contradiction.","refs":["MC_GB18_L1_05:GA-11","MC_GB18_L1_06:GA-12","MC_GB18_L1_08:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-09","text":"[Attractor] Concrete identity is negative unity: the temporary stability of a determination that maintains and changes itself through integrated difference.","refs":["MC_GB18_L1_06:GA-13","MC_GB18_L1_07:GA-12","MC_GB18_L1_08:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-10","text":"[Emergent] Quantitative continuity generates qualitative change only within an immanent law of measure that articulates accumulation and reverses its function at a threshold.","refs":["MC_GB18_L1_07:GA-10","MC_GB18_L1_08:GA-06","MC_GB18_L1_08:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-11","text":"[Terminal] The architecture of measure is completed not in a highest measure, but in the sublation of independent measures into states of a reflected substrate or essential unity.","refs":["MC_GB18_L1_07:GA-11","MC_GB18_L1_08:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-12","text":"[Attractor] The missing immanent law of generation for concrete exponents, series, affinities, and thresholds is the negative attractor that sustains systematic openness.","refs":["MC_GB18_L1_08:GA-11","MC_GB18_L1_08:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:GA-13","text":"[Terminal] Quantitative categories retain regional validity, but can compel neither concrete reality as such nor non-thing-like spirit under a unified explanatory regime.","refs":["MC_GB18_L1_06:GA-11","MC_GB18_L1_07:GA-13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L2_02:RMD-01","text":"The one moves from immediate singularity through number and relational quantum to the provisionally independent node; its organizational function remains, its relationless independence disappears.","refs":["MC_GB18_L1_05:RMD-01","MC_GB18_L1_07:RMD-01","MC_GB18_L1_08:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-02","text":"Repulsion and attraction lose their identity as separate forces and are absorbed into negative unity, which organizes exclusion, relation, and self-preservation at once.","refs":["MC_GB18_L1_05:RMD-02","MC_GB18_L1_05:RMD-03","MC_GB18_L1_08:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-03","text":"Externality returns functionally at every stage, but shifts from deficient alien positing through a real condition of mediation to the site of qualitative self-relation.","refs":["MC_GB18_L1_06:RMD-02","MC_GB18_L1_07:RMD-07","MC_GB18_L1_08:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-04","text":"Limit expands its scope from qualitative determinacy and number through the recursively posited beyond to the threshold of measure at which it releases a new quality.","refs":["MC_GB18_L1_05:RMD-07","MC_GB18_L1_06:RMD-03","MC_GB18_L1_08:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-05","text":"Infinity mutates from bad progress through the immanent completeness of a relation into measurelessness, which denotes not remoteness but productive self-negation.","refs":["MC_GB18_L1_06:RMD-06","MC_GB18_L1_07:RMD-04","MC_GB18_L1_08:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-06","text":"The exponent moves from the common numerical value to the qualitative invariant of a relation and further to the empirically precarious index of series, exclusions, and thresholds.","refs":["MC_GB18_L1_07:GA-04","MC_GB18_L1_08:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-07","text":"Measure mutates from immediate unity through self-mediated lawfulness and threshold machine into the subordinate state-form of an enduring substrate.","refs":["MC_GB18_L1_07:RMD-08","MC_GB18_L1_08:RMD-01","MC_GB18_L1_08:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-08","text":"Continuity and discreteness remain functionally preserved, but are recoded from abstract opposites into the common bearer and articulation of a serial threshold order.","refs":["MC_GB18_L1_05:RMD-05","MC_GB18_L1_05:RMD-06","MC_GB18_L1_08:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RMD-09","text":"Contradiction moves from the self-destruction of isolated determinations through antinomy and quantitative negativity to the attractor of every mediation of preservation and change.","refs":["MC_GB18_L1_05:RMD-09","MC_GB18_L1_06:RMD-09","MC_GB18_L1_06:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L2_02:CGD-01","text":"Individual models of force, matter, space, and motion remain local diagnostic fields; at the current level, only the prohibition against presupposing the object to be generated as a ready-made bearer scales.","refs":["MC_GB18_L1_05:CGD-03","MC_GB18_L1_05:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-02","text":"Methods of calculation, limit values, number forms, and historical foundations of calculus remain local operations; globally, they bear the difference between formal success and conceptual self-mediation.","refs":["MC_GB18_L1_06:CGD-01","MC_GB18_L1_07:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-03","text":"Physical, chemical, musical, moral, and political examples remain domain-specific; only the common type of relational and threshold-dependent transformation scales upward.","refs":["MC_GB18_L1_08:CGD-01","MC_GB18_L1_08:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-04","text":"Concrete coefficients, exponents, affinities, and points of measure remain underdetermined at lower levels; globally, this non-derivability becomes the negative attractor of the overall architecture.","refs":["MC_GB18_L1_08:CGD-06","MC_GB18_L1_08:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-05","text":"The treatment of soul and spirit remains a local limit test, yet the self-limitation of quantitative categories in relation to non-thing-like reality scales to a general rule of validity.","refs":["MC_GB18_L1_06:CGD-03","MC_GB18_L1_06:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-06","text":"The transition of measure to essence and the de-independence of individual measures in the substrate are not further regional operations, but the form of closure of the current level of synthesis.","refs":["MC_GB18_L1_07:CGD-07","MC_GB18_L1_08:CGD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:CGD-07","text":"Determinate forms of ratio and potency remain local sequences; globally, the recoding of mathematical forms into functional positions of relational self-determination scales.","refs":["MC_GB18_L1_07:CGD-02","MC_GB18_L1_08:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L2_02:GNX-01","text":"Excluded is every ontology of ready-made substances or quanta that would be fully determined prior to their relations.","refs":["MC_GB18_L1_05:GNX-01","MC_GB18_L1_07:GNX-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-02","text":"Excluded is a self-interpreting formalism that directly transforms exactness, syntactic derivability, or computational power into conceptual truth.","refs":["MC_GB18_L1_06:GNX-01","MC_GB18_L1_07:GNX-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-03","text":"Excluded is additive or linear causality insofar as mere repetition of external effects is supposed to generate inner unity or qualitative change without a relation of measure.","refs":["MC_GB18_L1_06:GNX-02","MC_GB18_L1_08:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-04","text":"Excluded are both independent atoms and a homogeneous continuum that effaces discreteness, qualitative novelty, and real leaps.","refs":["MC_GB18_L1_05:GNX-03","MC_GB18_L1_08:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-05","text":"Excluded are cumulative progress toward positive infinity and a final measure that would be exempt from its own limitation or transformation.","refs":["MC_GB18_L1_06:GNX-05","MC_GB18_L1_08:GNX-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-06","text":"Excluded is the quantification of spirit, as is the universalization of quantitative lawfulness into an ontology of all domains of objects.","refs":["MC_GB18_L1_06:GNX-04","MC_GB18_L1_07:GNX-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:GNX-07","text":"Excluded is an external perspective from which relations, measures, and contradictions could be produced or completely surveyed without itself entering the field of mediation.","refs":["MC_GB18_L1_05:BSA-02","MC_GB18_L1_08:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L2_02:DBN-01","text":"For the system to hold, every pre-relational independence must be false; otherwise relation, measure, and negative unity would be subsequent additions rather than constitutive operations.","refs":["MC_GB18_L1_05:DBN-01","MC_GB18_L1_07:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:DBN-02","text":"Operational calculability must not be identical with ontological composition, nor empirical confirmation with conceptual generation.","refs":["MC_GB18_L1_07:DBN-06","MC_GB18_L1_08:GNX-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:DBN-03","text":"Quantitative accumulation must produce neither true infinity nor qualitative change from itself alone, because without a law of measure it merely reproduces the existing form of limit.","refs":["MC_GB18_L1_06:DBN-03","MC_GB18_L1_07:GNX-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:DBN-04","text":"Negation must neither completely annihilate its other nor fix self-preservation as unchanged persistence; both would destroy the productive mediation of identity and change.","refs":["MC_GB18_L1_05:DBN-03","MC_GB18_L1_08:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:DBN-05","text":"A complete deduction of concrete numbers and thresholds must not be feigned; the open unavailability of their principle of generation belongs to the supporting architecture.","refs":["MC_GB18_L1_08:DBN-04","MC_GB18_L1_08:GA-11"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L2_02:BSA-01","text":"The deepest excluded possibility is a first immediacy or final independence that could entirely leave difference, relation, and change behind.","refs":["MC_GB18_L1_05:BSA-01","MC_GB18_L1_08:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:BSA-02","text":"Unavailable is a permanent outside into which limit, contradiction, or qualitative determination could be externalized without returning as moments of unity.","refs":["MC_GB18_L1_05:BSA-02","MC_GB18_L1_07:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:BSA-03","text":"The architecture circles around the missing law that would generate concrete exponents, affinities, series, and thresholds from a common immanent order.","refs":["MC_GB18_L1_08:BSA-01","MC_GB18_L1_08:GA-11"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_02:BSA-04","text":"Unavailable is a fully commensurable numerical order in which qualitative difference, novelty, and interruption could be represented exhaustively as homogeneous variation.","refs":["MC_GB18_L1_07:BSA-05","MC_GB18_L1_08:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L2_02:XD-01","text":"Quantity is the transformed shape of negative relation: only a qualitative relation makes its units determinate and transforms external magnitudes into moments of a measure.","refs":["MC_GB18_L2_02:GA-01","MC_GB18_L2_02:GA-05","MC_GB18_L2_02:GA-06","MC_GB18_L1_05:GA-05","MC_GB18_L1_07:GA-02","MC_GB18_L1_08:GA-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-02","text":"Externality is neither deficient in itself nor productive in itself; its function depends on whether it is fixed as alien positing or withdrawn into negative unity.","refs":["MC_GB18_L2_02:GA-03","MC_GB18_L2_02:GA-09","MC_GB18_L1_06:GA-02","MC_GB18_L1_07:RMD-07","MC_GB18_L1_08:GA-12"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-03","text":"Limit generates a graded logic of transformation: as a merely re-posited limit, it produces bad progress; as a threshold in the form of measure, qualitative self-negation.","refs":["MC_GB18_L2_02:GA-04","MC_GB18_L2_02:GA-10","MC_GB18_L1_06:GA-06","MC_GB18_L1_07:GA-10","MC_GB18_L1_08:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-04","text":"Conceptual legitimacy requires a double test: the categories must generate their presuppositions immanently, and their formal results must be qualitatively typified and validated on the object.","refs":["MC_GB18_L2_02:GA-07","MC_GB18_L2_02:GA-12","MC_GB18_L1_05:AS-07","MC_GB18_L1_07:GA-07","MC_GB18_L1_08:AS-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-05","text":"Contradiction becomes an operation of development only when the excluded moment is preserved and integrated as the self-difference of unity.","refs":["MC_GB18_L2_02:GA-02","MC_GB18_L2_02:GA-08","MC_GB18_L2_02:GA-09","MC_GB18_L1_05:GA-02","MC_GB18_L1_06:GA-12","MC_GB18_L1_08:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-06","text":"Number, exponent, and measure do not form an additive sequence of categories, but rather a mutation of limit from the self-limiting numerical value to the qualitative invariant and the conditioned threshold index.","refs":["MC_GB18_L2_02:GA-04","MC_GB18_L2_02:GA-06","MC_GB18_L2_02:GA-10","MC_GB18_L1_05:GA-08","MC_GB18_L1_07:GA-04","MC_GB18_L1_08:RMD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-07","text":"The closure of the logic of measure simultaneously generates its terminal opening: measures are absorbed into substrate and essence, while the concrete law of their serial formation remains unavailable.","refs":["MC_GB18_L2_02:GA-11","MC_GB18_L2_02:GA-12","MC_GB18_L1_07:GA-11","MC_GB18_L1_08:GA-10","MC_GB18_L1_08:GA-11"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_02:XD-08","text":"The production of qualitative determination from quantitative mediation does not legitimate universal quantification, because the scope of quantitative categories ends with increasing concreteness of the object.","refs":["MC_GB18_L2_02:GA-07","MC_GB18_L2_02:GA-13","MC_GB18_L1_06:GA-11","MC_GB18_L1_07:GA-13"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L2_02:BSD-01","text":"Ontologically, entities become stabilized relational phases: they are nodes of relations in the form of measure and at the same time states of the unity that bears their changes.","refs":["MC_GB18_L1_05:BSD-01","MC_GB18_L1_08:GA-04","MC_GB18_L1_08:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-02","text":"Causality becomes recursive and threshold-shaped: an external change is internally specified, reorganizes the order of relations, and generates a new qualitative form at a limit of measure.","refs":["MC_GB18_L1_05:BSD-02","MC_GB18_L1_08:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-03","text":"Time disintegrates into mechanical repetition, bad perpetuation of limits, cumulative threshold movement, and reflexive return; its unity is spiral-shaped rather than linear.","refs":["MC_GB18_L1_05:BSD-04","MC_GB18_L1_07:BSD-03","MC_GB18_L1_08:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-04","text":"Cognition becomes a graded procedure of genetic reconstruction of categories, formal generation, qualitative typification, observation, and objective testing.","refs":["MC_GB18_L1_05:BSD-05","MC_GB18_L1_07:BSD-02","MC_GB18_L1_08:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-05","text":"The subject loses the status of a sovereign posit-er and becomes a mediating, contradiction-capable instance; as spirit, it remains irreducible to quantitative categories of things.","refs":["MC_GB18_L1_05:BSD-03","MC_GB18_L1_06:BSD-04","MC_GB18_L1_07:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-06","text":"Mathematics is regionalized: its exactness can fully grasp certain invariants without thereby acquiring universal ontological scope.","refs":["MC_GB18_L1_05:BSD-06","MC_GB18_L1_07:XD-07","MC_GB18_L1_07:MME-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:BSD-07","text":"Agency consists in the transformation of relational conditions and the navigation of thresholds, not in abstract transgression of limits or mere increase of quantity.","refs":["MC_GB18_L1_06:BSD-06","MC_GB18_L1_08:BSD-06","MC_GB18_L1_08:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L2_02:RLE-01","text":"The elementary loop is: exclusion posits others, the other turns exclusion into relation, and relation generates a mediated form of independence.","refs":["MC_GB18_L1_05:RLE-01","MC_GB18_L1_08:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-02","text":"The limit loop generates a beyond from every determinate limit and a new limit from every beyond; only the withdrawal of this externality interrupts bad progress.","refs":["MC_GB18_L1_06:RLE-02","MC_GB18_L1_06:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-03","text":"Continuity makes division possible, division posits discrete units, whose equality restores continuity and escalates through number and degree to the order of measure.","refs":["MC_GB18_L1_05:RLE-03","MC_GB18_L1_06:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-04","text":"The spiral of relation leads from external comparison through exponent and potency to the qualitative invariant, which organizes mathematical form and determination of measure as a common attractor.","refs":["MC_GB18_L1_07:RLE-02","MC_GB18_L1_07:RLE-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-05","text":"Threshold escalation leads from indifferent variation through repetition and accumulation to the range of indifference, the point of measure, the qualitative leap, and renewed variation.","refs":["MC_GB18_L1_07:RLE-04","MC_GB18_L1_08:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-06","text":"The terminal loop multiplies measures, generates nodal lines, and finally reduces their independence to substrate continuity and reflected essential structure.","refs":["MC_GB18_L1_08:RLE-05","MC_GB18_L1_07:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:RLE-07","text":"The machine is organized by two attractors: positively by immanent mediation, negatively by the missing closed system of measure that repeatedly demands every extension.","refs":["MC_GB18_L1_05:RLE-07","MC_GB18_L1_08:RLE-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L2_02:FGS-B01","text":"Immediate unity plus exclusion generates presupposed multiplicity; its preservation transforms isolated independence into mediated relation.","refs":["MC_GB18_L1_05:FGS-B01","MC_GB18_L1_05:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B02","text":"Preserved multiplicity plus equality of units generates continuity with inner discreteness and thereby quantity as mediated externalization.","refs":["MC_GB18_L1_05:FGS-B03","MC_GB18_L1_05:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B03","text":"Quantity plus immanent limit generates quantum and number; the sublation of number into simple limit generates degree and relational intensity.","refs":["MC_GB18_L1_05:FGS-B05","MC_GB18_L1_06:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B04","text":"Repeated limitation generates bad progress; the withdrawal of the beyond as its own moment transforms serial infinity into relational quality.","refs":["MC_GB18_L1_06:FGS-B05","MC_GB18_L1_06:FGS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B05","text":"The moment of relation organizes itself as exponent, potency, or limit; qualitative typification and objective testing subsequently determine its concrete validity as measure.","refs":["MC_GB18_L1_07:FGS-B03","MC_GB18_L1_07:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B06","text":"Continued quantitative variation reaches a point of measure, releases a new quality, and through repeated reversals reduces individual measures to a common substrate.","refs":["MC_GB18_L1_08:FGS-B05","MC_GB18_L1_08:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:FGS-B07","text":"The machine closes relatively through qualitative self-mediation, substrate, and essence, but remains terminally open because of the missing concrete law of generation.","refs":["MC_GB18_L1_07:FGS-B08","MC_GB18_L1_08:MRT-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L2_02:AFM-B01","text":"Immediate unity → exclusion → presupposed multiplicity → negative relation → mediated unity → quantity.","refs":["MC_GB18_L1_05:AS-08","MC_GB18_L1_05:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AFM-B02","text":"Quantity → immanent limit → number and degree → beyond of the limit → bad progress → withdrawal of externality → relational quality.","refs":["MC_GB18_L1_06:GA-06","MC_GB18_L1_06:FGS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AFM-B03","text":"Relational quality → external ratio → exponent and potency → qualitative invariant → measure → reflected lawfulness.","refs":["MC_GB18_L1_07:AS-03","MC_GB18_L1_07:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AFM-B04","text":"Variation of measure → range of indifference → point of measure → qualitative leap → nodal line → substrate continuity → de-independence of measure → essence.","refs":["MC_GB18_L1_08:AS-04","MC_GB18_L1_08:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:AFM-B05","text":"Formal operation → deficit of justification → immanent reconstruction → qualitative typification → objective testing → regionally limited validity.","refs":["MC_GB18_L1_05:AS-07","MC_GB18_L1_07:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L2_02:MME-01","text":"Independent substances and relata are removed from the basic map; relation becomes the constitutive form through which its sides first receive determinate validity.","refs":["MC_GB18_L1_05:MME-01","MC_GB18_L1_07:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-02","text":"Quality and quantity lose the status of separate orders and are remapped as reciprocal moments of a structure of measure.","refs":["MC_GB18_L1_06:MME-04","MC_GB18_L1_07:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-03","text":"Continuity and discontinuity are distributed across different functions: continuity bears variation, discreteness articulates it, and qualitative leaps transform their order.","refs":["MC_GB18_L1_07:MME-06","MC_GB18_L1_08:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-04","text":"Finitude and infinity are replaced by the difference between external progress, present completeness of relation, and negativity internal to measure.","refs":["MC_GB18_L1_06:MME-05","MC_GB18_L1_07:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-05","text":"Mathematical form is reclassified from an external authority into a regional procedure of testing and representation, whose ontological significance must be separately established.","refs":["MC_GB18_L1_06:MME-07","MC_GB18_L1_08:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-06","text":"The thing changes from the bearer of ready-made properties into a relational node and finally into the state of a substrate enduring through qualitative alternations.","refs":["MC_GB18_L1_08:MME-02","MC_GB18_L1_08:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MME-07","text":"Adequate reading must read recurrence as possible mutation, reversal, or absorption, because identical expressions assume different systematic functions at different stages.","refs":["MC_GB18_L1_08:MME-07","MC_GB18_L1_07:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L2_02:ALT-B01","text":"At the surface level, one, number, degree, ratio, potency, measurement, series, physical and chemical relations, and qualitative leaps appear as explicit objects.","refs":["MC_GB18_L1_05:ALT-B01","MC_GB18_L1_06:ALT-B01","MC_GB18_L1_08:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:ALT-B02","text":"At the structural level, limit, externality, relation, measure, and negative unity organize the generation, stabilization, and transformation of determinate shapes.","refs":["MC_GB18_L1_05:ALT-B02","MC_GB18_L1_06:ALT-B02","MC_GB18_L1_08:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:ALT-B03","text":"At the metastrategic level, explanation is shifted from external addition and model transfer to the reconstruction of relational conditions of generation and reproduced contradictions.","refs":["MC_GB18_L1_05:ALT-B03","MC_GB18_L1_06:ALT-B03","MC_GB18_L1_08:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:ALT-B04","text":"At the ontological and temporal level, reality is mediated self-difference, whose time consists of repetition, perpetuation of limits, threshold, interruption, and return.","refs":["MC_GB18_L1_05:ALT-B04","MC_GB18_L1_06:ALT-B04","MC_GB18_L1_08:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:ALT-B05","text":"At the methodological and performative level, the exposition enacts its thesis by transferring every fixed determination, through its own presuppositions and consequences, into a more comprehensive order of mediation.","refs":["MC_GB18_L1_05:ALT-B05","MC_GB18_L1_06:ALT-B05","MC_GB18_L1_08:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L2_02:FL-01","text":"Externality must be a necessary starting point and an enduring moment, but may possess no independent explanatory force; the architecture can neither eliminate nor render it independent.","refs":["MC_GB18_L1_08:FL-01","MC_GB18_L1_06:GA-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-02","text":"Limit must be indifferent to the existing quality and at the same time constitutive for its quantitative and qualitative determinacy; this double status drives the movement without being dissolvable.","refs":["MC_GB18_L1_05:FL-04","MC_GB18_L1_08:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-03","text":"The constitutive role of application and objective testing stands in tension with the demand that truth must arise completely from immanent self-determination.","refs":["MC_GB18_L1_07:FL-02","MC_GB18_L1_07:AS-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-04","text":"The universal categorial transition of measure to essence stands in tension with the regional and object-dependent validity of quantitative lawfulness.","refs":["MC_GB18_L1_07:FL-03","MC_GB18_L1_07:GA-13"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-05","text":"Quantitative mediation is supposed to generate quality, but must be categorially sublated for spirit; the positive mediation between objective negativity and spiritual self-determination remains open.","refs":["MC_GB18_L1_06:FL-04","MC_GB18_L1_06:FL-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-06","text":"Exponents and thresholds are supposed to express qualitative necessity, although their concrete values and their positive principle of generation remain empirically or materially-logically underdetermined.","refs":["MC_GB18_L1_08:FL-04","MC_GB18_L1_08:FL-06","MC_GB18_L1_08:MRT-B06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:FL-07","text":"The substrate must be determined through qualitative alternations and at the same time endure as the same; its unity therefore oscillates productively between identity and succession of states.","refs":["MC_GB18_L1_08:FL-05","MC_GB18_L1_08:DBN-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-01","text":"The one and the quantum mutate from the independent starting point through dependent moments of relation into temporarily stable relational nodes.","refs":["MC_GB18_L1_05:MP-01","MC_GB18_L1_07:RMD-01","MC_GB18_L1_08:RMD-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-02","text":"Externality mutates from deficiency through the necessary form of objective determination into the withdrawn moment of negative unity.","refs":["MC_GB18_L1_06:RMD-02","MC_GB18_L1_07:RMD-07","MC_GB18_L1_08:GA-12"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-03","text":"Infinity mutates from unbounded progress into relational presence; its negative transitional function is subsequently assumed by measurelessness and threshold.","refs":["MC_GB18_L1_06:MP-03","MC_GB18_L1_07:MP-04","MC_GB18_L1_08:MP-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-04","text":"The exponent mutates from numerical quotient into a qualitative principle of relation, then into an exclusion operator, and finally into the conditioned index of empirical orders.","refs":["MC_GB18_L1_07:MP-02","MC_GB18_L1_08:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-05","text":"Measure mutates from immediate unity through self-mediated lawfulness and transition machine into the subordinate state of the substrate.","refs":["MC_GB18_L1_07:MP-05","MC_GB18_L1_08:MP-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_02:MP-06","text":"Independence mutates from negative delimitation through relational node formation into the mere state-form of a more comprehensive unity, without becoming wholly unreal.","refs":["MC_GB18_L1_08:RMD-04","MC_GB18_L1_08:RMD-08"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L2_02:HSI-01","text":"Reality appears as a recursive threshold and measure machine in which separation generates relation, relations stabilize shapes, and limits trigger qualitative transformations.","refs":["MC_GB18_L1_05:HSI-01","MC_GB18_L1_07:HSI-01","MC_GB18_L1_08:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:HSI-02","text":"The subject is not a sovereign center, but a relational node and a mediating instance; as spirit, it remains irreducible to quantitative determination of things.","refs":["MC_GB18_L1_05:HSI-02","MC_GB18_L1_07:HSI-02","MC_GB18_L1_08:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:HSI-03","text":"Time is a spiral structure of repetition, quantitative continuation, qualitative interruption, and returning unity that reproduces its presuppositions at a changed level.","refs":["MC_GB18_L1_05:HSI-03","MC_GB18_L1_07:HSI-03","MC_GB18_L1_08:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:HSI-04","text":"Navigation remains possible as immanent tracking of turning points and intervention in orders of relation, but not as disposal over an external law of selection, measure, or threshold.","refs":["MC_GB18_L1_05:HSI-04","MC_GB18_L1_07:HSI-04","MC_GB18_L1_08:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L2_02:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from exclusive unity through quantity, limit, relation, and measure to threshold, substrate, and essence.","refs":["MC_GB18_L1_05:MRT-B01","MC_GB18_L1_07:MRT-B01","MC_GB18_L1_08:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MRT-B02","text":"The architecture is strongest where it transforms isolated independence into relational function, quantitative externality into qualitative specification, and stability into mediated difference.","refs":["MC_GB18_L1_05:MRT-B02","MC_GB18_L1_07:MRT-B02","MC_GB18_L1_08:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MRT-B03","text":"What remains underdetermined is the positive genesis of spirit, concrete limits of measure, the universal scope of the potency form, as well as exponents, affinities, rules of mixture, and threshold values.","refs":["MC_GB18_L1_05:MRT-B03","MC_GB18_L1_07:MRT-B03","MC_GB18_L1_08:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MRT-B04","text":"At this level, the system is coherent provided negation is read as preservation, externality as a mediated moment, contradiction as an operation of transition, and measure as non-terminal closure.","refs":["MC_GB18_L1_05:MRT-B04","MC_GB18_L1_06:MRT-B05","MC_GB18_L1_08:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_02:MRT-B05","text":"The combination of the productive double status of limit, necessary objective testing, and the missing immanent law of nature resists axiomatic closure; precisely this remainder keeps the machine mobile.","refs":["MC_GB18_L1_05:MRT-B06","MC_GB18_L1_07:MRT-B05","MC_GB18_L1_08:MRT-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L2_02@R001","source_variant_id":"canonical:MC_GB18_L2_02:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L2 02","context":"Chapters 49–96 · a. Ausschließen des Eins. · Anmerkung. · b. Das Eine Eins der Attraktion. · c. Die Beziehung der Repulsion und Attraktion. · Anmerkung. · Anmerkung. · A. Die reine Quantität. · Anmerkung 1. · Anmerkung 2. · B. Kontinuirliche und diskrete Größe. · C. Begrenzung der Quantität. · A. Die Zahl. · Anmerkung 1. · Anmerkung 2. · a. Unterschied derselben. · b. Identität der extensiven und intensiven Größe. · Anmerkung 1. · Anmerkung 2. · c. Die Veränderung des Quantums. · a. Begriff derselben. · b. Der quantitative unendliche Progreß. · Anmerkung 1. · Anmerkung 2. · c. Die Unendlichkeit des Quantums. · Anmerkung 1. Die Begriffsbestimmtheit des mathematischen Unendlichen. · Anmerkung 2.Der Zweck des Differentialkalkuls aus seiner Anwendung abgeleitet. · Anmerkung 3. Noch andere mit der qualitativen Größenbestimmtheit zusammenhängende Formen. · A. Das direkte Verhältniß. · B. Das umgekehrte Verhältniß. · C. Potenzverhältniß. · Anmerkung. · Dritter Abschnitt. Das Maaß. · A. Das specifische Quantum. · B. Specificirendes Maaß. · a. Die Regel. · b. Das specificirende Maaß. · Anmerkung. · c. Verhältniß beider Seiten als Qualitäten. · Anmerkung. · C. Das Fürsichseyn im Maaße. · A. Das Verhältniß selbstständiger Maaße. · a. Verbindung zweier Maaße. · b. Das Maaß als Reihe von Maaßverhältnissen. · c. Wahlverwandtschaft. · Anmerkung. · B. Knotenlinie von Maaßverhältnissen. · Anmerkung. · C. Das Maaßlose."},"title_language_code":"en"},{"id":"MC_GB18_L3_02","layer":"MC","title":"Gb18 L3 02","order":2,"parents":["MC_GB18_L2_03","MC_GB18_L2_04"],"revision":"MC_GB18_L3_02@R001","sha256":"6a36eee166a7a7cc5dec042b86ebd7addcc71da8ca98459b4f423bead8360277","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L3_02:BAS-01","text":"Das System rekonstruiert, wie bestimmte Einheit ohne Substrat, äußeren Ursprung oder relationsexterne Träger aus ihrer eigenen Vermittlungsbewegung hervorgehen kann.","refs":["MC_GB18_L2_03:AS-01","MC_GB18_L2_04:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-02","text":"Seine globale These lautet, dass negative Selbstvermittlung Bestimmungen nicht vernichtet, sondern sie als differenzierte, manifestierende und selbstorganisierende Identitäten erzeugt.","refs":["MC_GB18_L2_03:AS-02","MC_GB18_L2_04:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-03","text":"Das Argument wird auf dieser Ebene zu einer genetisch-rekursiven Ontologie, in der jedes Resultat seinen Anfang umcodiert und jede erreichte Selbständigkeit eine neue Vermittlung erzwingt.","refs":["MC_GB18_L2_03:AS-07","MC_GB18_L2_04:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-04","text":"Die Bewegung führt von der negativen Schließung des Begründungsregresses zur positiven, jedoch instabilen Selbstmanifestation von Wirklichkeit, Freiheit und Begriff.","refs":["MC_GB18_L2_03:GA-11","MC_GB18_L2_04:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-05","text":"Äußerlichkeit wechselt dabei vom Defekt unerzeugter Verknüpfung zur notwendigen Erscheinungs-, Bedingungs- und Passivitätsform immanenter Selbstorganisation.","refs":["MC_GB18_L2_03:XD-04","MC_GB18_L2_04:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-06","text":"Widerspruch fungiert zunächst als Übergangsoperator zwischen Kategorien und mutiert anschließend zur operativen Umkehrung von Bedingung, Ursache, Wirkung, Aktivität und Passivität.","refs":["MC_GB18_L2_03:AS-05","MC_GB18_L2_04:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-07","text":"Die gerichtete Zeit des Systems ist eine Resultatszeit, in der logische Priorität rückwirkend erzeugt und ein Anfang erst durch seine Folgen wirksam bestimmt wird.","refs":["MC_GB18_L2_03:XD-02","MC_GB18_L2_04:XD-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-08","text":"Die Schließung ist asymmetrisch und offen: Der Regress äußerer Gründe endet, doch die positive Ableitung konkreter Begriffsgliederung bleibt von einer nicht vollständig ausgewiesenen Mutationssequenz abhängig.","refs":["MC_GB18_L2_03:AS-08","MC_GB18_L2_04:AS-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L3_02:GA-01","text":"[Persistent] Konkrete Identität besteht nur als Selbsterhaltung in einer erzeugten Differenz, die weder getilgt noch zu einem unabhängigen Außen verselbständigt wird.","refs":["MC_GB18_L2_03:GA-01","MC_GB18_L2_04:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-02","text":"[Attractor] Immanente Negativität ist der universale Transformationsoperator, der Grenzen hervorbringt, gegen die Bestimmung wendet und als Momente konkreterer Einheit zurücknimmt.","refs":["MC_GB18_L2_03:GA-02","MC_GB18_L2_04:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-03","text":"[Mutating] Unmittelbarkeit mutiert vom scheinbaren Ursprung zum gesetzten Resultat einer Vermittlung, die in ihrem Produkt verschwindet, ohne ihre Wirksamkeit zu verlieren.","refs":["MC_GB18_L2_03:GA-03","MC_GB18_L2_04:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-04","text":"[Mutating] Äußerlichkeit mutiert vom Mangel äußerer Bestimmung zur notwendigen Form von Erscheinung, Bedingung, Selbstäußerung und organisierter Passivität.","refs":["MC_GB18_L2_03:GA-04","MC_GB18_L2_04:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-05","text":"[Persistent] Selbständigkeit ist ausschließlich vermittelte Erhaltung innerhalb eines Zusammenhangs, der jede Bestimmung erzeugt, begrenzt und ihres relationsexternen Seinsgrundes entsetzt.","refs":["MC_GB18_L2_03:GA-05","MC_GB18_L2_04:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-06","text":"[Mutating] Grund, Bedingung und Ursache verlieren ihre vorausliegende Stellung und werden zu rückwirkend gesetzten Funktionen rekursiver Selbstvoraussetzung.","refs":["MC_GB18_L2_03:GA-08","MC_GB18_L2_04:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-07","text":"[Mutating] Widerspruch mutiert vom expliziten kategorialen Übergangsoperator zur operativen Instabilität, die Gesetzlichkeit in Kraft und feste Kausalrollen in Wechselwirkung überführt.","refs":["MC_GB18_L2_03:GA-07","MC_GB18_L2_04:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-08","text":"[Emergent] Erscheinung ist nicht das Andere der Wahrheit, sondern die ontologische Operation, durch die vermittelte Existenz und Wirklichkeit ihre innere Genesis manifestieren.","refs":["MC_GB18_L2_04:GA-07","MC_GB18_L2_04:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-09","text":"[Emergent] Wirklichkeit ist die vollzogene Einheit von Wesen, Existenz, Erscheinung und Bedingungen, sofern deren qualitative Verknüpfung aus derselben Bewegung erzeugt wird.","refs":["MC_GB18_L2_03:GA-09","MC_GB18_L2_04:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-10","text":"[Attractor] Totalität ist die Selbstorganisation differenzierter Momente, die deren Wirksamkeit erhält, aber jede isolierte Selbständigkeit durch ihren eigenen Widerspruch aufhebt.","refs":["MC_GB18_L2_03:GA-07","MC_GB18_L2_04:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-11","text":"[Mutating] Das negativ Unbedingte mutiert zur manifestierten Notwendigkeit und weiter zur Freiheit, sobald Bedingtheit als eigene Wirksamkeit des Zusammenhangs erscheint.","refs":["MC_GB18_L2_03:GA-11","MC_GB18_L2_04:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-12","text":"[Emergent] Substanz wird zum Subjekt, indem ihre Manifestationen, kausalen Rollen und Differenzen nicht äußerlich verteilt bleiben, sondern zu inneren Gliederungen ihrer Selbstorganisation werden.","refs":["MC_GB18_L2_04:GA-12","MC_GB18_L2_04:XD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-13","text":"[Terminal] Der Begriff übernimmt die offene Forderung positiver Zureichendheit als Organisation von Allgemeinheit, Besonderheit und Einzelheit innerhalb einer subjektiven Totalität.","refs":["MC_GB18_L2_03:GA-12","MC_GB18_L2_04:GA-14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-14","text":"[Persistent] Erkenntnisform und Seinsform konvergieren, weil Erklärung nur als immanente Rekonstruktion der Operationen gilt, durch die der Gegenstand seine Bestimmungen hervorbringt.","refs":["MC_GB18_L2_03:GA-13","MC_GB18_L2_04:GA-13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-15","text":"[Terminal] Systemische Schließung beendet äußere Begründungsregresse, bleibt aber von der durchlaufenen Mutationsfolge abhängig und liefert keine sequenzunabhängige positive Gesamtform.","refs":["MC_GB18_L2_03:XD-07","MC_GB18_L2_04:GA-15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L3_02:RMD-01","text":"Unmittelbarkeit bewahrt ihre Funktion positiver Präsenz, wechselt aber vom vermeintlichen Anfang über erzeugte Voraussetzung zur Resultatform verschwundener Vermittlung.","refs":["MC_GB18_L2_03:RMD-02","MC_GB18_L2_04:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-02","text":"Negativität eskaliert von Selbstunverträglichkeit und kategorialer Opposition zur universalen Produktivkraft von Manifestation, Kausalität und Selbstgliederung.","refs":["MC_GB18_L2_03:RMD-03","MC_GB18_L2_04:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-03","text":"Äußerlichkeit kehrt ihre Valenz um: Als unerzeugte Kopplung bleibt sie defizitär, als eigene Erscheinungs-, Bedingungs- und Passivitätsstelle der Totalität wird sie konstitutiv.","refs":["MC_GB18_L2_03:XD-04","MC_GB18_L2_04:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-04","text":"Grund verliert erst den Status eines Fundaments und wird danach in Bedingung, Ursache und rückwirkende Selbstvoraussetzung einer manifestierenden Wirklichkeit absorbiert.","refs":["MC_GB18_L2_03:RMD-08","MC_GB18_L2_04:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-05","text":"Widerspruch bleibt funktional persistent, obwohl seine Benennung zurücktritt: Seine spätere Form ist die Instabilität von Gesetz, Kraft und festen Kausalrollen.","refs":["MC_GB18_L2_03:RMD-07","MC_GB18_L2_04:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-06","text":"Erscheinung wandert von einer bloßen Grenz- und Anschlussstruktur zur positiven Wahrheit substratloser Existenz und schließlich zur Selbstoffenbarung der Wirklichkeit.","refs":["MC_GB18_L2_03:CGD-07","MC_GB18_L2_04:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-07","text":"Ursache verliert ihre privilegierte Ursprungsfunktion und wird über Gegenwirkung und Wechselwirkung zu einer reversiblen Stelle organisierter Selbstkonditionierung.","refs":["MC_GB18_L2_03:BSD-03","MC_GB18_L2_04:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-08","text":"Das Subjekt mutiert vom ausgeschlossenen Ursprung über einen dezentrierten Reflexionsknoten zur späten Organisationsform substantieller Selbstvermittlung.","refs":["MC_GB18_L2_03:BSD-05","MC_GB18_L2_04:RMD-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-09","text":"Der Begriff übernimmt terminal die zuvor gemeinsam mit dem Zweck markierte Forderung positiver Zureichendheit; Zweck bleibt dabei eine nicht eigenständig entfaltete Funktionsforderung.","refs":["MC_GB18_L2_03:GA-12","MC_GB18_L2_04:RLE-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L3_02:CGD-01","text":"Quantitative Faktoren, Satzformen, Dinggrenzen, Porosität und materielle Zusammensetzung bleiben lokale Demontageinstrumente; global trägt nur ihr gemeinsamer Nachweis, dass Substrate und äußerliche Übergänge keine Genesis erklären.","refs":["MC_GB18_L2_03:CGD-01","MC_GB18_L2_04:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:CGD-02","text":"Vergleich, Ausschluss und ruhige Gesetzlichkeit bleiben lokale Expositionsformen; nach oben skaliert ihre Ablösung durch bewegte, selbsttransformierende Relationsformen.","refs":["MC_GB18_L2_03:CGD-02","MC_GB18_L2_04:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:CGD-03","text":"Auf die aktuelle Ebene skaliert die einheitliche Architektur, nach der qualitative Relationen ihre Träger, Bedingungen und Rollen selbst erzeugen müssen.","refs":["MC_GB18_L2_03:CGD-04","MC_GB18_L2_04:CGD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:CGD-04","text":"Der auf der unteren Ebene terminale Grund und das absolut Unbedingte werden auf dieser Ebene zu Übergangsformen der Bewegung in vermittelte Existenz, Wirklichkeit und Selbstmanifestation.","refs":["MC_GB18_L2_03:CGD-06","MC_GB18_L2_04:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:CGD-05","text":"Existenz, Erscheinung, Geist, Attribut, Begriff und Zweck skalieren nicht gleichmäßig: Erscheinung und Begriff werden global tragend, während Geist, Attribut und Zweck unvollständig entwickelte Anschlussfunktionen bleiben.","refs":["MC_GB18_L2_03:CGD-07","MC_GB18_L2_04:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:CGD-06","text":"Die aktuelle Architektur ist nicht durch isolierte Endaxiome rekonstruierbar; global wirksam ist die Sequenz, in der negative Schließung in Manifestation, Kausalität und subjektive Gliederung mutiert.","refs":["MC_GB18_L2_03:MRT-B05","MC_GB18_L2_04:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L3_02:GNX-01","text":"Ausgeschlossen sind eigenschaftslose Substrate, passive Träger und fertige Wesen, die Bestimmungen oder Erscheinungen vor deren Vermittlung tragen sollen.","refs":["MC_GB18_L2_03:GNX-01","MC_GB18_L2_04:GNX-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:GNX-02","text":"Ausgeschlossen ist ein äußerer oder souveräner Erkenntnisstandpunkt, der die Bewegung fixiert, ohne von ihr selbst bestimmt zu werden.","refs":["MC_GB18_L2_03:GNX-03","MC_GB18_L2_04:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:GNX-03","text":"Ausgeschlossen sind fertige Relata sowie lineare Grund- und Kausalordnungen, deren Beziehungen erst nachträglich durch einen ersten Anstoß hergestellt werden.","refs":["MC_GB18_L2_03:GNX-02","MC_GB18_L2_04:GNX-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:GNX-04","text":"Ausgeschlossen sind sowohl differenzlose Selbstgleichheit als auch eine Vielheit, deren Momente unabhängig von ihrer erzeugenden Totalität bestehen.","refs":["MC_GB18_L2_03:GNX-05","MC_GB18_L2_04:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:GNX-05","text":"Ausgeschlossen sind ein positives Unbedingtes jenseits der Vermittlung, Zufälligkeit außerhalb der Notwendigkeit und Freiheit als bedingungslose Unterbrechung.","refs":["MC_GB18_L2_03:DBN-06","MC_GB18_L2_04:GNX-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:GNX-06","text":"Ausgeschlossen ist jede formale oder terminale Geschlossenheit, die ihre konkrete Differenzierung und Mutationssequenz nicht selbst erzeugt.","refs":["MC_GB18_L2_03:DBN-04","MC_GB18_L2_04:DBN-06"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L3_02:DBN-01","text":"Falsch sein muss ein Modell fertiger Terme, denen Eigenschaften, Beziehungen und kausale Rollen nachträglich zugewiesen werden.","refs":["MC_GB18_L2_03:GNX-02","MC_GB18_L2_04:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:DBN-02","text":"Falsch sein muss ein Verständnis des Widerspruchs oder der Negation als bloßer Störung beziehungsweise Zerstörung, weil damit der generative Übergangsoperator entfiele.","refs":["MC_GB18_L2_03:GNX-04","MC_GB18_L2_04:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:DBN-03","text":"Falsch sein muss die Alternative, Äußerlichkeit entweder zu autonomisieren oder restlos aufzulösen; das System benötigt sie als reale, aber internalisierbare Vollzugsdifferenz.","refs":["MC_GB18_L2_03:DBN-03","MC_GB18_L2_04:DBN-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:DBN-04","text":"Falsch sein muss eine terminale Form, die als positives Jenseits oder sequenzunabhängige Einheit auftreten könnte.","refs":["MC_GB18_L2_03:DBN-06","MC_GB18_L2_04:DBN-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:DBN-05","text":"Falsch sein muss Erkenntnis als Repräsentation fertiger Gegenstände, da Erklärung nur als Vollzug ihrer kategorialen Genesis legitimiert wird.","refs":["MC_GB18_L2_03:GA-13","MC_GB18_L2_04:DBN-05"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L3_02:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist ein Außen gegenüber der Vermittlungstotalität, das ihr Material, Grenzen, Ursachen oder Maßstäbe liefern könnte.","refs":["MC_GB18_L2_03:BSA-01","MC_GB18_L2_04:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:BSA-02","text":"Nicht verfügbar ist ein letzter Ursprung, dessen Priorität und Wirksamkeit nicht erst durch Wirkung, Rückkehr und Resultat erzeugt würden.","refs":["MC_GB18_L2_03:BSA-02","MC_GB18_L2_04:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:BSA-03","text":"Nicht verfügbar ist eine konkrete Identität, die keine Differenz hervorbringen müsste oder Differenz restlos tilgen könnte.","refs":["MC_GB18_L2_03:DBN-02","MC_GB18_L2_04:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:BSA-04","text":"Die strukturierende Abwesenheit ist eine vollständig bestimmte absolute Form, die positiv zureichend wäre, ohne Äußerlichkeit, Selbstaufhebung oder erneute Vermittlung zu erzeugen.","refs":["MC_GB18_L2_03:BSA-04","MC_GB18_L2_04:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L3_02:XD-01","text":"Die negative Schließung des Grund-Bedingungs-Regresses kann nicht terminal bleiben, sondern muss in eine Wirklichkeit übergehen, die ihre Bedingungen als eigene Manifestationen hervorbringt.","refs":["MC_GB18_L3_02:GA-06","MC_GB18_L3_02:GA-09","MC_GB18_L3_02:GA-11","MC_GB18_L2_03:XD-07","MC_GB18_L2_04:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-02","text":"Äußerlichkeit ist zugleich das Kriterium unzureichender Erklärung und das notwendige Medium, in dem eine Totalität ihre Differenz wirklich vollzieht.","refs":["MC_GB18_L3_02:GA-04","MC_GB18_L3_02:GA-08","MC_GB18_L3_02:GA-10","MC_GB18_L2_03:XD-04","MC_GB18_L2_04:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-03","text":"Der kategoriale Widerspruch wird in der Sphäre der Wirklichkeit zur kausalen Reversibilität: Fixierte Rollen erzeugen ihre Gegenrollen und verlieren dadurch ihre Ursprungsprivilegien.","refs":["MC_GB18_L3_02:GA-02","MC_GB18_L3_02:GA-07","MC_GB18_L2_03:XD-03","MC_GB18_L2_04:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-04","text":"Weil Grund und Ursache rückwirkend gesetzt werden, ist Priorität weder zeitliches Vorher noch unveränderliche Rangordnung, sondern ein Effekt der Resultatsbewegung.","refs":["MC_GB18_L3_02:GA-03","MC_GB18_L3_02:GA-06","MC_GB18_L2_03:XD-02","MC_GB18_L2_04:XD-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-05","text":"Das absolut Unbedingte wird nur dann positiv bestimmbar, wenn es als Notwendigkeit erscheint, die ihre Bedingungen manifestiert und diese manifestierte Bedingtheit als Freiheit organisiert.","refs":["MC_GB18_L3_02:GA-11","MC_GB18_L3_02:GA-13","MC_GB18_L2_03:GA-11","MC_GB18_L2_04:XD-10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-06","text":"Das Subjekt entsteht aus der Überlagerung dezentrierter Reflexion und substantieller Selbstorganisation; es ist weder Ursprung noch bloßer Effekt, sondern die Rückkehrform verteilter Vermittlung.","refs":["MC_GB18_L3_02:GA-12","MC_GB18_L3_02:GA-14","MC_GB18_L2_03:XD-06","MC_GB18_L2_04:XD-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-07","text":"Der Begriff übernimmt die Forderung positiver Zureichendheit, löst sie aber nur formal, solange Zweck und konkrete innere Gliederung nicht aus der gesamten Vermittlungsbewegung eigenständig deduziert sind.","refs":["MC_GB18_L3_02:GA-13","MC_GB18_L3_02:GA-15","MC_GB18_L2_03:GA-12","MC_GB18_L2_04:XD-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-08","text":"Der Ausschluss eines äußeren Beobachters zwingt Erkenntnis, Ontologie und Darstellung in dieselbe genetische Operation: Erklären heißt, die Sache als Erzeugerin ihrer Kategorien zu artikulieren.","refs":["MC_GB18_L3_02:GA-09","MC_GB18_L3_02:GA-14","MC_GB18_L2_03:GA-13","MC_GB18_L2_04:XD-09"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L3_02:BSD-01","text":"Ontologisch primär sind rekursive Produktionsfelder, in denen Einheiten, Dinge, Gründe und Substanzen als vorläufige Verdichtungen selbstvermittelnder Relationen entstehen.","refs":["MC_GB18_L2_03:BSD-01","MC_GB18_L2_04:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-02","text":"Zeit ist eine spiralförmige Resultatsordnung, in der Folgen ihre Voraussetzungen hervorbringen und Wiederkehr den Status des Anfangs transformiert.","refs":["MC_GB18_L2_03:BSD-02","MC_GB18_L2_04:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-03","text":"Kausalität wird zur Selbstkonditionierung eines Zusammenhangs, der Ursachen durch Wirkungen verwirklicht und feste Rollen in rekursive Wechselwirkung auflöst.","refs":["MC_GB18_L2_03:BSD-03","MC_GB18_L2_04:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-04","text":"Das Subjekt ist die späte Organisationsform einer zunächst objektiv verteilten Reflexion, die ihre Differenzen als eigene Bestimmungen zurücknimmt.","refs":["MC_GB18_L2_03:BSD-05","MC_GB18_L2_04:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-05","text":"Handlungsmacht besteht in der Umbildung erzeugender Bedingungen und Rollen, nicht im unvermittelten Anfang oder in der Wahl zwischen bereits fixierten Polen.","refs":["MC_GB18_L2_03:BSD-07","MC_GB18_L2_04:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-06","text":"Erklärung wird genetisch und performativ: Sie ist wahr, sofern sie die gemeinsame Genesis von Inhalt, Differenz, Bedingung und Zusammenhang rekonstruiert.","refs":["MC_GB18_L2_03:BSD-04","MC_GB18_L2_04:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-07","text":"Systemische Schließung ist keine Stillstellung, sondern die reversible Organisation von Notwendigkeit, Differenz und Äußerlichkeit innerhalb fortgesetzter Selbstbewegung.","refs":["MC_GB18_L2_03:XD-07","MC_GB18_L2_04:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L3_02:RLE-01","text":"Die Grundschleife lautet: Vermittlung erzeugt Bestimmtheit, Bestimmtheit erzeugt Grenze und Negation, deren Rücknahme erzeugt konkretere Identität und neue vermittelte Unmittelbarkeit.","refs":["MC_GB18_L2_03:RLE-01","MC_GB18_L2_04:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RLE-02","text":"Die Äußerlichkeitsschleife führt von äußerer Fixierung über ihre Kritik zur Internalisierung; jede Internalisierung setzt jedoch einen neuen äußeren Rest und erzwingt erneute Vermittlung.","refs":["MC_GB18_L2_03:RLE-04","MC_GB18_L2_04:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RLE-03","text":"Die Begründungsschleife setzt Bedingungen, wirkt durch sie und gewinnt sie rückwirkend als eigene Voraussetzungen zurück; Grund wird so zum Resultat seines Begründens.","refs":["MC_GB18_L2_03:RLE-05","MC_GB18_L2_04:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RLE-04","text":"Totalität ist der dominante Attraktor, weil jede isolierte Bestimmung durch ihren Erklärungs- oder Bestandserfolg auf den Zusammenhang verweist, der sie zugleich trägt und entselbständigt.","refs":["MC_GB18_L2_03:RLE-06","MC_GB18_L2_04:RLE-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RLE-05","text":"Erscheinung stabilisiert sich als Gesetz, Gesetz wird durch seine Starrheit zur Kraft, und Kraft eskaliert über Gegenwirkung zur rekursiven Kausalität.","refs":["MC_GB18_L2_04:RMD-06","MC_GB18_L2_04:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RLE-06","text":"Substantielle Macht differenziert sich in kausale Rollen, passiviert jede fixierte Ursachposition und konvergiert über Wechselwirkung, Freiheit und Begriff auf organisierte Selbstbestimmung.","refs":["MC_GB18_L2_04:RLE-06","MC_GB18_L2_04:RLE-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L3_02:FGS-B01","text":"Vorausgesetzte Unmittelbarkeit → Selbstwiderspruch der passiven Einheit → negative Reflexion → Unmittelbarkeit als gesetztes Resultat.","refs":["MC_GB18_L2_03:FGS-B02","MC_GB18_L2_04:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B02","text":"Reflexionsbestimmungen → Grund → Krise äußerer Begründung → Grund, Bedingung und Ursache als rückwirkende Selbstvoraussetzung.","refs":["MC_GB18_L2_03:RLE-05","MC_GB18_L2_04:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B03","text":"Regress der Gründe und Bedingungen → negatives Unbedingtes → vermittelte Unmittelbarkeit → bestimmte Existenz als neue Expositionssphäre.","refs":["MC_GB18_L2_03:FGS-B08","MC_GB18_L2_04:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B04","text":"Bestimmte Existenz → äußere Träger- und Eigenschaftsformen → Substratverlust → Erscheinung als ontologische Manifestation der Vermittlung.","refs":["MC_GB18_L2_03:CGD-07","MC_GB18_L2_04:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B05","text":"Erscheinung und Möglichkeit → rückwirkend gesetzte Bedingungen → Wirklichkeit → Substanz als manifestierende Selbstorganisation.","refs":["MC_GB18_L2_04:XD-07","MC_GB18_L2_04:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B06","text":"Substanz → kausale Differenzierung → Umkehrung von Ursache und Wirkung → Gegenwirkung und Wechselwirkung → organisierte Abhängigkeit.","refs":["MC_GB18_L2_04:GA-08","MC_GB18_L2_04:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B07","text":"Manifestierte Notwendigkeit → Freiheit als reflektierte Bedingtheit → Begriff als innere Gliederung subjektiver Totalität.","refs":["MC_GB18_L2_04:AS-07","MC_GB18_L2_04:GA-14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B08","text":"Negative Regressschließung + positive Selbstorganisation → begriffliche Schließung, deren Geltung von einer nicht vollständig deduzierten Vermittlungssequenz abhängt.","refs":["MC_GB18_L2_03:AS-08","MC_GB18_L2_04:AS-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L3_02:AFM-B01","text":"Vorausgesetzte Unmittelbarkeit → negative Reflexion → Grund → Krise der Begründung → Unbedingtes → bestimmte Existenz → Erscheinung → Wirklichkeit → Substanz → Kausalität → Freiheit → Begriff.","refs":["MC_GB18_L2_03:AS-06","MC_GB18_L2_04:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:AFM-B02","text":"Äußerliche Bestimmung → Erklärungsausfall → Internalisierung → notwendige Externalisierung → neuer äußerer Rest → erneute Vermittlung auf höherer Stufe.","refs":["MC_GB18_L2_03:RLE-04","MC_GB18_L2_04:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:AFM-B03","text":"Negative Schließung → manifestierte Notwendigkeit → kausale Reversibilität → organisierte Selbstbestimmung → offener Begriff als terminaler Attraktor.","refs":["MC_GB18_L2_03:XD-07","MC_GB18_L2_04:RLE-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L3_02:MME-01","text":"Einheit und Identität werden von ursprünglichen Beständen zu Operationen der Selbsterhaltung im Anderswerden umkartiert.","refs":["MC_GB18_L2_03:MME-01","MC_GB18_L2_04:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-02","text":"Innen und Außen bilden keine ontologische Alternative mehr; Äußerlichkeit zerfällt in defizitäre unerzeugte Kopplung und notwendige Exposition immanenter Differenz.","refs":["MC_GB18_L2_03:MME-02","MC_GB18_L2_04:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-03","text":"Erscheinung und Wahrheit wechseln ihre Rangordnung: Erscheinung wird zum Ort, an dem vermittelte Realität ihre Genesis wirklich vollzieht.","refs":["MC_GB18_L2_04:GA-07","MC_GB18_L2_04:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-04","text":"Grund, Ursache und Wirkung werden von Fundamenten oder festen Ereignispositionen zu reversiblen Funktionen eines rekursiven Produktionsfeldes.","refs":["MC_GB18_L2_03:MME-04","MC_GB18_L2_04:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-05","text":"Notwendigkeit und Freiheit verlieren ihre Gegensätzlichkeit; Freiheit bezeichnet die reflektierte Organisation einer Notwendigkeit, die ihre Bedingungen manifestiert.","refs":["MC_GB18_L2_04:GA-11","MC_GB18_L2_04:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-06","text":"Subjekt und Objekt werden als asymmetrische Funktionsstellen einer verteilten Reflexionsarchitektur lesbar, nicht als fertige Pole von Erkenntnis.","refs":["MC_GB18_L2_03:MME-06","MC_GB18_L2_04:MME-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-07","text":"Kategoriales Lesen muss Mutation, Umkehrung und Rückkehr verfolgen; die Inventarisierung stabiler Begriffe verfehlt deren Funktion als Phasen rekursiver Produktion.","refs":["MC_GB18_L2_03:MME-08","MC_GB18_L2_04:MME-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L3_02:ALT-B01","text":"Surface level — Unmittelbarkeit, Grund, Existenz, Erscheinung, Wirklichkeit, Substanz, Kausalität, Freiheit und Begriff sind sichtbare Verdichtungen einer durchgehenden Transformationsbewegung.","refs":["MC_GB18_L2_03:ALT-B01","MC_GB18_L2_04:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:ALT-B02","text":"Structural level — Negation, Setzung, Externalisierung, Ausschluss, Rückkehr und Selbstvoraussetzung bilden die rekursive Maschine aller kategorialen Übergänge.","refs":["MC_GB18_L2_03:ALT-B02","MC_GB18_L2_04:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:ALT-B03","text":"Metastrategic level — Interpretation und Intervention werden von der Wahl fertiger Pole auf die Rekonstruktion und Umbildung ihrer gegenseitigen Erzeugung verlagert.","refs":["MC_GB18_L2_03:ALT-B03","MC_GB18_L2_04:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:ALT-B04","text":"Ontological / Temporal level — Realität ist selbstwirkende Vermittlung, deren Zeit Voraussetzungen rückwirkend setzt und Ursachen erst durch ihre Wirkungen verwirklicht.","refs":["MC_GB18_L2_03:ALT-B04","MC_GB18_L2_04:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre Ontologie, indem sie jede feste Bestimmung durch Grenze, Gegenbestimmung und mutierte Rückkehr führt.","refs":["MC_GB18_L2_03:ALT-B05","MC_GB18_L2_04:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L3_02:FL-01","text":"Äußerlichkeit muss überwunden werden, sofern sie eine unerzeugte Kopplung bezeichnet, und erhalten bleiben, sofern ohne sie weder Manifestation noch reale Differenz möglich ist.","refs":["MC_GB18_L2_03:FL-01","MC_GB18_L2_04:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-02","text":"Erklärung verlangt Identität zwischen Grund und Begründetem, um Immanenz zu sichern, und wirksame Differenz, um Tautologie zu vermeiden; keine Seite kann vollständig dominieren.","refs":["MC_GB18_L2_03:FL-02","MC_GB18_L2_04:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-03","text":"Das absolut Unbedingte schließt den Regress negativ, während der Begriff positive Selbstgliederung beansprucht; der Übergang zwischen beiden Schließungsarten bleibt partiell unterbestimmt.","refs":["MC_GB18_L2_03:FL-03","MC_GB18_L2_04:XD-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-04","text":"Das Absolute soll vollendet sein und erscheint dennoch als operative Selbsterzeugung, die Auslegung, Manifestation und erneute Rückkehr benötigt.","refs":["MC_GB18_L2_04:AS-08","MC_GB18_L2_04:FL-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-05","text":"Selbstbestimmung benötigt Bedingungen, andere Kräfte und Wirkungen; Autonomie ist daher nur als konstitutiv bedingte Abhängigkeit formulierbar.","refs":["MC_GB18_L2_03:FL-07","MC_GB18_L2_04:FL-06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-06","text":"Die Kritik äußerer Grundzuteilung verlangt ein positives Kriterium legitimer Vermittlung, doch der Übergang von Wechselwirkung zur Begriffsgliederung deduziert dieses Kriterium nicht vollständig.","refs":["MC_GB18_L2_03:FL-04","MC_GB18_L2_04:FL-07"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-07","text":"Die Architektur erzeugt die Form konkreter Selbstvermittlung zuverlässiger als die bestimmten Inhalte und vollständigen Bedingungsfelder, die diese Form ausfüllen sollen.","refs":["MC_GB18_L2_03:FL-06","MC_GB18_L2_04:FL-08"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-01","text":"Widerspruch mutiert von der Krise passiver Einheit zur produktiven Reflexion und weiter zur ontologischen Operation von Externalisierung und Manifestation.","refs":["MC_GB18_L2_03:MP-01","MC_GB18_L2_04:XD-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-02","text":"Grund mutiert vom erwarteten Fundament zur rückwirkenden Einheit und schließlich zur Voraussetzung, die erst durch die von ihr abhängige Bewegung gesetzt wird.","refs":["MC_GB18_L2_03:MP-03","MC_GB18_L2_04:RMD-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-03","text":"Erscheinung mutiert von der Diagnose substratloser Existenz zur positiven Wahrheit und schließlich zur Selbstoffenbarung der Wirklichkeit.","refs":["MC_GB18_L2_04:RMD-05","MC_GB18_L2_04:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-04","text":"Kausalität mutiert von äußerer Einwirkung über operative Kraft und Selbstvoraussetzung zur Wechselwirkung, in der feste Ursache-Wirkungs-Positionen kollabieren.","refs":["MC_GB18_L2_04:GA-08","MC_GB18_L2_04:MP-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-05","text":"Notwendigkeit mutiert von negativer Unbedingtheit zur manifestierten Bedingtheit, deren reflektierte und organisierte Form Freiheit heißt.","refs":["MC_GB18_L2_04:GA-11","MC_GB18_L2_04:MP-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-06","text":"Substanz mutiert von manifestierender Macht zu Subjektivität, sobald ihre kausalen Differenzen nicht mehr als äußere Rollen, sondern als eigene Gliederungen organisiert werden.","refs":["MC_GB18_L2_04:GA-12","MC_GB18_L2_04:MP-05"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L3_02:HSI-01","text":"Realität erscheint als selbstdifferenzierende Vermittlungsmaschine, die Träger, Außenseiten, Bedingungen und Relationen erzeugt, externalisiert und als innere Organisationsformen zurücknimmt.","refs":["MC_GB18_L2_03:HSI-01","MC_GB18_L2_04:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:HSI-02","text":"Das Subjekt ist kein Betreiber der Maschine, sondern deren späte Rückkehrform, in der verteilte Reflexion ihre Unterschiede als eigene Bestimmungen organisiert.","refs":["MC_GB18_L2_03:HSI-02","MC_GB18_L2_04:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:HSI-03","text":"Zeit ist eine Spirale rückwirkender Setzung, in der Resultate Anfänge konstituieren, Wirkungen Ursachen verwirklichen und Wiederholung nur als Transformation vorkommt.","refs":["MC_GB18_L2_03:HSI-03","MC_GB18_L2_04:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:HSI-04","text":"Navigation besteht im Eingriff in Mutationen von Bedingungen, Rollen und Externalisierungen; Flucht in einen ersten Grund oder in bedingungslose Freiheit bleibt ausgeschlossen.","refs":["MC_GB18_L2_03:HSI-04","MC_GB18_L2_04:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L3_02:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von vorausgesetzter Unmittelbarkeit über Reflexion, Grund und Unbedingtheit bis zu Erscheinung, Kausalität, Freiheit und Begriff zu rekonstruieren.","refs":["MC_GB18_L2_03:MRT-B01","MC_GB18_L2_04:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MRT-B02","text":"Die Rekonstruktion bleibt kohärent, sofern negative Identität nicht als Differenzlosigkeit, Äußerlichkeit nicht als einheitliche Kategorie und Freiheit nicht als Unterbrechung der Notwendigkeit gelesen wird.","refs":["MC_GB18_L2_03:MRT-B02","MC_GB18_L2_04:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MRT-B03","text":"Die Architektur ist am stärksten in der Verbindung von Widerspruch, rückwirkender Voraussetzung, wiederholter Internalisierung der Äußerlichkeit und Transformation kausaler Rollen.","refs":["MC_GB18_L2_03:MRT-B03","MC_GB18_L2_04:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MRT-B04","text":"Unterbestimmt bleiben die positive Genesis konkreter Inhalte, die vollständige Vermittlung von negativer Unbedingtheit und Begriff sowie die Übergänge von Gesetz zu Kraft und Wechselwirkung zu Subjektivität.","refs":["MC_GB18_L2_03:MRT-B04","MC_GB18_L2_04:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MRT-B05","text":"Die minimale Rekonstruktion ist nur hinreichend, wenn sie die konkrete Mutationssequenz, die rekursive Rückkehr und die produktive Spannung zwischen negativer Schließung und positiver Selbstorganisation bewahrt.","refs":["MC_GB18_L2_03:MRT-B05","MC_GB18_L2_04:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T124837528155Z_b4009020","language_code":"en","language_name":"English","title":"Gb18 L3 02","source_sha256":"6a36eee166a7a7cc5dec042b86ebd7addcc71da8ca98459b4f423bead8360277","sha256":"254944b1c36478040f650e196020066a4a3c2e3de1091b84bd104b0f10a541b4","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:48:37.529504+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L3_02:BAS-01","text":"The system reconstructs how determinate unity without substrate, external origin, or relation-external bearers can emerge from its own movement of mediation.","refs":["MC_GB18_L2_03:AS-01","MC_GB18_L2_04:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-02","text":"Its global thesis is that negative self-mediation does not destroy determinations, but produces them as differentiated, manifesting, and self-organizing identities.","refs":["MC_GB18_L2_03:AS-02","MC_GB18_L2_04:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-03","text":"At this level, the argument becomes a genetic-recursive ontology in which every result recodes its beginning and every achieved self-subsistence compels a new mediation.","refs":["MC_GB18_L2_03:AS-07","MC_GB18_L2_04:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-04","text":"The movement leads from the negative closure of the regress of grounding to the positive, yet unstable self-manifestation of actuality, freedom, and concept.","refs":["MC_GB18_L2_03:GA-11","MC_GB18_L2_04:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-05","text":"In this process, externality shifts from the defect of unproduced connection to the necessary form of appearance, condition, and passivity of immanent self-organization.","refs":["MC_GB18_L2_03:XD-04","MC_GB18_L2_04:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-06","text":"Contradiction initially functions as a transition operator between categories and subsequently mutates into the operative reversal of condition, cause, effect, activity, and passivity.","refs":["MC_GB18_L2_03:AS-05","MC_GB18_L2_04:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-07","text":"The directed time of the system is a time of results, in which logical priority is retroactively produced and a beginning is effectively determined only through its consequences.","refs":["MC_GB18_L2_03:XD-02","MC_GB18_L2_04:XD-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BAS-08","text":"The closure is asymmetric and open: the regress of external grounds ends, yet the positive derivation of concrete conceptual articulation remains dependent on a mutation sequence that is not fully demonstrated.","refs":["MC_GB18_L2_03:AS-08","MC_GB18_L2_04:AS-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L3_02:GA-01","text":"[Persistent] Concrete identity exists only as self-preservation in a produced difference that is neither erased nor made self-subsistent as an independent outside.","refs":["MC_GB18_L2_03:GA-01","MC_GB18_L2_04:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-02","text":"[Attractor] Immanent negativity is the universal transformation operator that produces limits, turns them against determination, and takes them back as moments of more concrete unity.","refs":["MC_GB18_L2_03:GA-02","MC_GB18_L2_04:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-03","text":"[Mutating] Immediacy mutates from apparent origin into the posited result of a mediation that disappears in its product without losing its efficacy.","refs":["MC_GB18_L2_03:GA-03","MC_GB18_L2_04:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-04","text":"[Mutating] Externality mutates from the lack of external determination into the necessary form of appearance, condition, self-expression, and organized passivity.","refs":["MC_GB18_L2_03:GA-04","MC_GB18_L2_04:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-05","text":"[Persistent] Self-subsistence is exclusively mediated preservation within a context that produces, limits, and deprives every determination of its relation-external ground of being.","refs":["MC_GB18_L2_03:GA-05","MC_GB18_L2_04:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-06","text":"[Mutating] Ground, condition, and cause lose their antecedent position and become retroactively posited functions of recursive self-presupposition.","refs":["MC_GB18_L2_03:GA-08","MC_GB18_L2_04:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-07","text":"[Mutating] Contradiction mutates from the explicit categorical transition operator into the operative instability that transforms lawfulness into force and fixed causal roles into interaction.","refs":["MC_GB18_L2_03:GA-07","MC_GB18_L2_04:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-08","text":"[Emergent] Appearance is not the other of truth, but the ontological operation through which mediated existence and actuality manifest their inner genesis.","refs":["MC_GB18_L2_04:GA-07","MC_GB18_L2_04:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-09","text":"[Emergent] Actuality is the accomplished unity of essence, existence, appearance, and conditions, insofar as their qualitative connection is produced from the same movement.","refs":["MC_GB18_L2_03:GA-09","MC_GB18_L2_04:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-10","text":"[Attractor] Totality is the self-organization of differentiated moments that preserves their efficacy but sublates every isolated self-subsistence through its own contradiction.","refs":["MC_GB18_L2_03:GA-07","MC_GB18_L2_04:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-11","text":"[Mutating] The negatively unconditioned mutates into manifested necessity and then into freedom, as soon as conditionedness appears as the context's own efficacy.","refs":["MC_GB18_L2_03:GA-11","MC_GB18_L2_04:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-12","text":"[Emergent] Substance becomes subject insofar as its manifestations, causal roles, and differences do not remain externally distributed, but become inner articulations of its self-organization.","refs":["MC_GB18_L2_04:GA-12","MC_GB18_L2_04:XD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-13","text":"[Terminal] The concept assumes the open demand for positive sufficiency as the organization of universality, particularity, and singularity within a subjective totality.","refs":["MC_GB18_L2_03:GA-12","MC_GB18_L2_04:GA-14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-14","text":"[Persistent] Form of cognition and form of being converge because explanation is valid only as the immanent reconstruction of the operations through which the object produces its determinations.","refs":["MC_GB18_L2_03:GA-13","MC_GB18_L2_04:GA-13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:GA-15","text":"[Terminal] Systemic closure terminates external regresses of grounding, but remains dependent on the mutation sequence traversed and provides no sequence-independent positive overall form.","refs":["MC_GB18_L2_03:XD-07","MC_GB18_L2_04:GA-15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L3_02:RMD-01","text":"Immediacy preserves its function of positive presence, but shifts from the supposed beginning through produced presupposition to the result-form of vanished mediation.","refs":["MC_GB18_L2_03:RMD-02","MC_GB18_L2_04:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-02","text":"Negativity escalates from self-incompatibility and categorical opposition to the universal productive force of manifestation, causality, and self-articulation.","refs":["MC_GB18_L2_03:RMD-03","MC_GB18_L2_04:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-03","text":"Externality reverses its valence: as unproduced coupling it remains deficient; as totality's own locus of appearance, condition, and passivity, it becomes constitutive.","refs":["MC_GB18_L2_03:XD-04","MC_GB18_L2_04:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-04","text":"Ground first loses the status of a foundation and is thereafter absorbed into condition, cause, and retroactive self-presupposition of a manifesting actuality.","refs":["MC_GB18_L2_03:RMD-08","MC_GB18_L2_04:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-05","text":"Contradiction remains functionally persistent, although its naming recedes: its later form is the instability of law, force, and fixed causal roles.","refs":["MC_GB18_L2_03:RMD-07","MC_GB18_L2_04:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-06","text":"Appearance moves from a mere structure of limit and connection to the positive truth of substrateless existence and finally to the self-revelation of actuality.","refs":["MC_GB18_L2_03:CGD-07","MC_GB18_L2_04:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-07","text":"Cause loses its privileged originating function and, through counteraction and interaction, becomes a reversible locus of organized self-conditioning.","refs":["MC_GB18_L2_03:BSD-03","MC_GB18_L2_04:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-08","text":"The subject mutates from the excluded origin through a decentered node of reflection into the late organizational form of substantial self-mediation.","refs":["MC_GB18_L2_03:BSD-05","MC_GB18_L2_04:RMD-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RMD-09","text":"The concept terminally assumes the demand for positive sufficiency previously marked together with purpose; purpose thereby remains a functional demand not independently developed.","refs":["MC_GB18_L2_03:GA-12","MC_GB18_L2_04:RLE-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L3_02:CGD-01","text":"Quantitative factors, propositional forms, thing-boundaries, porosity, and material composition remain local instruments of dismantling; globally, only their joint demonstration that substrates and external transitions explain no genesis is load-bearing.","refs":["MC_GB18_L2_03:CGD-01","MC_GB18_L2_04:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:CGD-02","text":"Comparison, exclusion, and tranquil lawfulness remain local forms of exposition; what scales upward is their replacement by dynamic, self-transforming forms of relation.","refs":["MC_GB18_L2_03:CGD-02","MC_GB18_L2_04:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:CGD-03","text":"What scales to the current level is the unified architecture according to which qualitative relations must themselves produce their bearers, conditions, and roles.","refs":["MC_GB18_L2_03:CGD-04","MC_GB18_L2_04:CGD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:CGD-04","text":"Ground, terminal at the lower level, and the absolutely unconditioned become at this level transitional forms of movement into mediated existence, actuality, and self-manifestation.","refs":["MC_GB18_L2_03:CGD-06","MC_GB18_L2_04:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:CGD-05","text":"Existence, appearance, spirit, attribute, concept, and purpose do not scale evenly: appearance and concept become globally load-bearing, while spirit, attribute, and purpose remain incompletely developed functions of connection.","refs":["MC_GB18_L2_03:CGD-07","MC_GB18_L2_04:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:CGD-06","text":"The current architecture cannot be reconstructed through isolated terminal axioms; globally efficacious is the sequence in which negative closure mutates into manifestation, causality, and subjective articulation.","refs":["MC_GB18_L2_03:MRT-B05","MC_GB18_L2_04:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L3_02:GNX-01","text":"Excluded are propertyless substrates, passive bearers, and finished essences that are supposed to bear determinations or appearances prior to their mediation.","refs":["MC_GB18_L2_03:GNX-01","MC_GB18_L2_04:GNX-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:GNX-02","text":"Excluded is an external or sovereign standpoint of cognition that fixes the movement without itself being determined by it.","refs":["MC_GB18_L2_03:GNX-03","MC_GB18_L2_04:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:GNX-03","text":"Excluded are finished relata as well as linear orders of ground and causality whose relations are only subsequently established by a first impetus.","refs":["MC_GB18_L2_03:GNX-02","MC_GB18_L2_04:GNX-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:GNX-04","text":"Excluded are both difference-free self-sameness and a multiplicity whose moments exist independently of their producing totality.","refs":["MC_GB18_L2_03:GNX-05","MC_GB18_L2_04:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:GNX-05","text":"Excluded are a positive unconditioned beyond mediation, contingency outside necessity, and freedom as an unconditional interruption.","refs":["MC_GB18_L2_03:DBN-06","MC_GB18_L2_04:GNX-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:GNX-06","text":"Excluded is every formal or terminal closure that does not itself produce its concrete differentiation and mutation sequence.","refs":["MC_GB18_L2_03:DBN-04","MC_GB18_L2_04:DBN-06"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L3_02:DBN-01","text":"A model of finished terms to which properties, relations, and causal roles are subsequently assigned must be false.","refs":["MC_GB18_L2_03:GNX-02","MC_GB18_L2_04:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:DBN-02","text":"An understanding of contradiction or negation as mere disturbance or destruction must be false, because this would eliminate the generative transition operator.","refs":["MC_GB18_L2_03:GNX-04","MC_GB18_L2_04:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:DBN-03","text":"The alternative of either autonomizing externality or dissolving it without remainder must be false; the system requires it as a real, yet internalizable, difference of enactment.","refs":["MC_GB18_L2_03:DBN-03","MC_GB18_L2_04:DBN-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:DBN-04","text":"A terminal form that could appear as a positive beyond or as a sequence-independent unity must be false.","refs":["MC_GB18_L2_03:DBN-06","MC_GB18_L2_04:DBN-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:DBN-05","text":"Cognition as representation of finished objects must be false, since explanation is legitimated only as the enactment of their categorical genesis.","refs":["MC_GB18_L2_03:GA-13","MC_GB18_L2_04:DBN-05"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L3_02:BSA-01","text":"The deepest excluded possibility is an outside in relation to the totality of mediation that could supply it with material, limits, causes, or standards.","refs":["MC_GB18_L2_03:BSA-01","MC_GB18_L2_04:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:BSA-02","text":"Unavailable is an ultimate origin whose priority and efficacy would not first be produced through effect, return, and result.","refs":["MC_GB18_L2_03:BSA-02","MC_GB18_L2_04:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:BSA-03","text":"Unavailable is a concrete identity that would not have to produce difference or could erase difference without remainder.","refs":["MC_GB18_L2_03:DBN-02","MC_GB18_L2_04:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L3_02:BSA-04","text":"The structuring absence is a fully determined absolute form that would be positively sufficient without producing externality, self-sublation, or renewed mediation.","refs":["MC_GB18_L2_03:BSA-04","MC_GB18_L2_04:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L3_02:XD-01","text":"The negative closure of the ground-condition regress cannot remain terminal, but must pass into an actuality that produces its conditions as its own manifestations.","refs":["MC_GB18_L3_02:GA-06","MC_GB18_L3_02:GA-09","MC_GB18_L3_02:GA-11","MC_GB18_L2_03:XD-07","MC_GB18_L2_04:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-02","text":"Externality is at once the criterion of insufficient explanation and the necessary medium in which a totality actually enacts its difference.","refs":["MC_GB18_L3_02:GA-04","MC_GB18_L3_02:GA-08","MC_GB18_L3_02:GA-10","MC_GB18_L2_03:XD-04","MC_GB18_L2_04:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-03","text":"Categorical contradiction becomes causal reversibility in the sphere of actuality: fixed roles produce their counter-roles and thereby lose their privileges of origin.","refs":["MC_GB18_L3_02:GA-02","MC_GB18_L3_02:GA-07","MC_GB18_L2_03:XD-03","MC_GB18_L2_04:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-04","text":"Because ground and cause are retroactively posited, priority is neither temporal precedence nor immutable rank order, but an effect of the movement of results.","refs":["MC_GB18_L3_02:GA-03","MC_GB18_L3_02:GA-06","MC_GB18_L2_03:XD-02","MC_GB18_L2_04:XD-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-05","text":"The absolutely unconditioned becomes positively determinable only if it appears as necessity that manifests its conditions and organizes this manifested conditionedness as freedom.","refs":["MC_GB18_L3_02:GA-11","MC_GB18_L3_02:GA-13","MC_GB18_L2_03:GA-11","MC_GB18_L2_04:XD-10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-06","text":"The subject arises from the superimposition of decentered reflection and substantial self-organization; it is neither origin nor mere effect, but the form of return of distributed mediation.","refs":["MC_GB18_L3_02:GA-12","MC_GB18_L3_02:GA-14","MC_GB18_L2_03:XD-06","MC_GB18_L2_04:XD-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-07","text":"The concept assumes the demand for positive sufficiency, but resolves it only formally so long as purpose and concrete inner articulation are not independently deduced from the entire movement of mediation.","refs":["MC_GB18_L3_02:GA-13","MC_GB18_L3_02:GA-15","MC_GB18_L2_03:GA-12","MC_GB18_L2_04:XD-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L3_02:XD-08","text":"The exclusion of an external observer compels cognition, ontology, and exposition into the same genetic operation: to explain means to articulate the thing as producer of its categories.","refs":["MC_GB18_L3_02:GA-09","MC_GB18_L3_02:GA-14","MC_GB18_L2_03:GA-13","MC_GB18_L2_04:XD-09"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L3_02:BSD-01","text":"Ontologically primary are recursive fields of production in which unities, things, grounds, and substances emerge as provisional condensations of self-mediating relations.","refs":["MC_GB18_L2_03:BSD-01","MC_GB18_L2_04:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-02","text":"Time is a spiral order of results in which consequences produce their presuppositions and recurrence transforms the status of the beginning.","refs":["MC_GB18_L2_03:BSD-02","MC_GB18_L2_04:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-03","text":"Causality becomes the self-conditioning of a context that actualizes causes through effects and dissolves fixed roles into recursive interaction.","refs":["MC_GB18_L2_03:BSD-03","MC_GB18_L2_04:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-04","text":"The subject is the late organizational form of a reflection initially distributed objectively, which takes back its differences as its own determinations.","refs":["MC_GB18_L2_03:BSD-05","MC_GB18_L2_04:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-05","text":"Agency consists in the transformation of producing conditions and roles, not in the unmediated beginning or in the choice between already fixed poles.","refs":["MC_GB18_L2_03:BSD-07","MC_GB18_L2_04:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-06","text":"Explanation becomes genetic and performative: it is true insofar as it reconstructs the common genesis of content, difference, condition, and context.","refs":["MC_GB18_L2_03:BSD-04","MC_GB18_L2_04:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:BSD-07","text":"Systemic closure is not immobilization, but the reversible organization of necessity, difference, and externality within continued self-movement.","refs":["MC_GB18_L2_03:XD-07","MC_GB18_L2_04:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L3_02:RLE-01","text":"The basic loop is as follows: mediation produces determinacy, determinacy produces limit and negation, whose sublation produces more concrete identity and new mediated immediacy.","refs":["MC_GB18_L2_03:RLE-01","MC_GB18_L2_04:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RLE-02","text":"The loop of externality leads from external fixation through its critique to internalization; yet every internalization posits a new external remainder and compels renewed mediation.","refs":["MC_GB18_L2_03:RLE-04","MC_GB18_L2_04:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RLE-03","text":"The loop of grounding posits conditions, acts through them, and retroactively recovers them as its own presuppositions; ground thus becomes the result of its grounding.","refs":["MC_GB18_L2_03:RLE-05","MC_GB18_L2_04:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RLE-04","text":"Totality is the dominant attractor because every isolated determination refers, through its explanatory or subsistence success, to the context that both sustains it and deprives it of self-subsistence.","refs":["MC_GB18_L2_03:RLE-06","MC_GB18_L2_04:RLE-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RLE-05","text":"Appearance stabilizes itself as law, law becomes force through its rigidity, and force escalates through counteraction into recursive causality.","refs":["MC_GB18_L2_04:RMD-06","MC_GB18_L2_04:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:RLE-06","text":"Substantial power differentiates itself into causal roles, renders passive every fixed causal position, and converges through interaction, freedom, and concept upon organized self-determination.","refs":["MC_GB18_L2_04:RLE-06","MC_GB18_L2_04:RLE-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L3_02:FGS-B01","text":"Presupposed immediacy → self-contradiction of passive unity → negative reflection → immediacy as posited result.","refs":["MC_GB18_L2_03:FGS-B02","MC_GB18_L2_04:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B02","text":"Determinations of reflection → ground → crisis of external grounding → ground, condition, and cause as retroactive self-presupposition.","refs":["MC_GB18_L2_03:RLE-05","MC_GB18_L2_04:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B03","text":"Regress of grounds and conditions → negatively unconditioned → mediated immediacy → determinate existence as a new sphere of exposition.","refs":["MC_GB18_L2_03:FGS-B08","MC_GB18_L2_04:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B04","text":"Determinate existence → external forms of bearer and property → loss of substrate → appearance as ontological manifestation of mediation.","refs":["MC_GB18_L2_03:CGD-07","MC_GB18_L2_04:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B05","text":"Appearance and possibility → retroactively posited conditions → actuality → substance as manifesting self-organization.","refs":["MC_GB18_L2_04:XD-07","MC_GB18_L2_04:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B06","text":"Substance → causal differentiation → reversal of cause and effect → counteraction and interaction → organized dependence.","refs":["MC_GB18_L2_04:GA-08","MC_GB18_L2_04:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B07","text":"Manifested necessity → freedom as reflected conditionedness → concept as inner articulation of subjective totality.","refs":["MC_GB18_L2_04:AS-07","MC_GB18_L2_04:GA-14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:FGS-B08","text":"Negative regress closure + positive self-organization → conceptual closure, whose validity depends on a mediation sequence that is not fully deduced.","refs":["MC_GB18_L2_03:AS-08","MC_GB18_L2_04:AS-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L3_02:AFM-B01","text":"Presupposed immediacy → negative reflection → ground → crisis of grounding → unconditioned → determinate existence → appearance → actuality → substance → causality → freedom → concept.","refs":["MC_GB18_L2_03:AS-06","MC_GB18_L2_04:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:AFM-B02","text":"External determination → failure of explanation → internalization → necessary externalization → new external remainder → renewed mediation at a higher level.","refs":["MC_GB18_L2_03:RLE-04","MC_GB18_L2_04:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:AFM-B03","text":"Negative closure → manifested necessity → causal reversibility → organized self-determination → open concept as terminal attractor.","refs":["MC_GB18_L2_03:XD-07","MC_GB18_L2_04:RLE-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L3_02:MME-01","text":"Unity and identity are remapped from original stocks into operations of self-preservation in becoming-other.","refs":["MC_GB18_L2_03:MME-01","MC_GB18_L2_04:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-02","text":"Inside and outside no longer form an ontological alternative; externality disintegrates into deficient unproduced coupling and necessary exposition of immanent difference.","refs":["MC_GB18_L2_03:MME-02","MC_GB18_L2_04:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-03","text":"Appearance and truth exchange their rank order: appearance becomes the locus in which mediated reality actually enacts its genesis.","refs":["MC_GB18_L2_04:GA-07","MC_GB18_L2_04:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-04","text":"Ground, cause, and effect become, from foundations or fixed event-positions, reversible functions of a recursive field of production.","refs":["MC_GB18_L2_03:MME-04","MC_GB18_L2_04:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-05","text":"Necessity and freedom lose their opposition; freedom designates the reflected organization of a necessity that manifests its conditions.","refs":["MC_GB18_L2_04:GA-11","MC_GB18_L2_04:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-06","text":"Subject and object become legible as asymmetric functional loci of a distributed architecture of reflection, not as finished poles of cognition.","refs":["MC_GB18_L2_03:MME-06","MC_GB18_L2_04:MME-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MME-07","text":"Categorical reading must track mutation, reversal, and return; the inventorying of stable concepts misses their function as phases of recursive production.","refs":["MC_GB18_L2_03:MME-08","MC_GB18_L2_04:MME-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L3_02:ALT-B01","text":"Surface level — Immediacy, ground, existence, appearance, actuality, substance, causality, freedom, and concept are visible condensations of a continuous movement of transformation.","refs":["MC_GB18_L2_03:ALT-B01","MC_GB18_L2_04:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:ALT-B02","text":"Structural level — Negation, positing, externalization, exclusion, return, and self-presupposition form the recursive machine of all categorical transitions.","refs":["MC_GB18_L2_03:ALT-B02","MC_GB18_L2_04:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:ALT-B03","text":"Metastrategic level — Interpretation and intervention are displaced from the choice of finished poles to the reconstruction and transformation of their mutual production.","refs":["MC_GB18_L2_03:ALT-B03","MC_GB18_L2_04:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:ALT-B04","text":"Ontological / Temporal level — Reality is self-acting mediation whose time retroactively posits presuppositions and actualizes causes only through their effects.","refs":["MC_GB18_L2_03:ALT-B04","MC_GB18_L2_04:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:ALT-B05","text":"Methodological / Performative level — The exposition enacts its ontology by leading every fixed determination through limit, counter-determination, and mutated return.","refs":["MC_GB18_L2_03:ALT-B05","MC_GB18_L2_04:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L3_02:FL-01","text":"Externality must be overcome insofar as it designates an unproduced coupling, and must be preserved insofar as neither manifestation nor real difference is possible without it.","refs":["MC_GB18_L2_03:FL-01","MC_GB18_L2_04:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-02","text":"Explanation requires identity between ground and grounded in order to secure immanence, and effective difference in order to avoid tautology; neither side can completely dominate.","refs":["MC_GB18_L2_03:FL-02","MC_GB18_L2_04:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-03","text":"The absolutely unconditioned negatively closes the regress, while the concept claims positive self-articulation; the transition between the two kinds of closure remains partially underdetermined.","refs":["MC_GB18_L2_03:FL-03","MC_GB18_L2_04:XD-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-04","text":"The Absolute is supposed to be complete and yet appears as operative self-production that requires interpretation, manifestation, and renewed return.","refs":["MC_GB18_L2_04:AS-08","MC_GB18_L2_04:FL-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-05","text":"Self-determination requires conditions, other forces, and effects; autonomy is therefore formulable only as constitutively conditioned dependence.","refs":["MC_GB18_L2_03:FL-07","MC_GB18_L2_04:FL-06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-06","text":"The critique of external attribution of ground demands a positive criterion of legitimate mediation, yet the transition from interaction to conceptual articulation does not fully deduce this criterion.","refs":["MC_GB18_L2_03:FL-04","MC_GB18_L2_04:FL-07"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:FL-07","text":"The architecture produces the form of concrete self-mediation more reliably than the determinate contents and complete fields of conditions that are supposed to fill this form.","refs":["MC_GB18_L2_03:FL-06","MC_GB18_L2_04:FL-08"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-01","text":"Contradiction mutates from the crisis of passive unity into productive reflection and further into the ontological operation of externalization and manifestation.","refs":["MC_GB18_L2_03:MP-01","MC_GB18_L2_04:XD-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-02","text":"Ground mutates from the expected foundation into retroactive unity and finally into the presupposition that is posited only through the movement dependent on it.","refs":["MC_GB18_L2_03:MP-03","MC_GB18_L2_04:RMD-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-03","text":"Appearance mutates from the diagnosis of substrateless existence into positive truth and finally into the self-revelation of actuality.","refs":["MC_GB18_L2_04:RMD-05","MC_GB18_L2_04:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-04","text":"Causality mutates from external influence through operative force and self-presupposition into interaction, in which fixed cause-effect positions collapse.","refs":["MC_GB18_L2_04:GA-08","MC_GB18_L2_04:MP-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-05","text":"Necessity mutates from negative unconditionedness into manifested conditionedness, whose reflected and organized form is called freedom.","refs":["MC_GB18_L2_04:GA-11","MC_GB18_L2_04:MP-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L3_02:MP-06","text":"Substance mutates from manifesting power into subjectivity as soon as its causal differences are organized no longer as external roles but as its own articulations.","refs":["MC_GB18_L2_04:GA-12","MC_GB18_L2_04:MP-05"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L3_02:HSI-01","text":"Reality appears as a self-differentiating machine of mediation that produces, externalizes, and takes back bearers, external sides, conditions, and relations as inner forms of organization.","refs":["MC_GB18_L2_03:HSI-01","MC_GB18_L2_04:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:HSI-02","text":"The subject is not the operator of the machine, but its late form of return, in which distributed reflection organizes its differences as its own determinations.","refs":["MC_GB18_L2_03:HSI-02","MC_GB18_L2_04:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:HSI-03","text":"Time is a spiral of retroactive positing, in which results constitute beginnings, effects actualize causes, and repetition occurs only as transformation.","refs":["MC_GB18_L2_03:HSI-03","MC_GB18_L2_04:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:HSI-04","text":"Navigation consists in intervention in mutations of conditions, roles, and externalizations; escape into a first ground or into unconditional freedom remains excluded.","refs":["MC_GB18_L2_03:HSI-04","MC_GB18_L2_04:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L3_02:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from presupposed immediacy through reflection, ground, and unconditionedness to appearance, causality, freedom, and concept.","refs":["MC_GB18_L2_03:MRT-B01","MC_GB18_L2_04:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MRT-B02","text":"The reconstruction remains coherent provided that negative identity is not read as difference-lessness, externality not as a unified category, and freedom not as interruption of necessity.","refs":["MC_GB18_L2_03:MRT-B02","MC_GB18_L2_04:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MRT-B03","text":"The architecture is strongest in the connection of contradiction, retroactive presupposition, repeated internalization of externality, and transformation of causal roles.","refs":["MC_GB18_L2_03:MRT-B03","MC_GB18_L2_04:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MRT-B04","text":"Underdetermined remain the positive genesis of concrete contents, the complete mediation of negative unconditionedness and concept, and the transitions from law to force and from interaction to subjectivity.","refs":["MC_GB18_L2_03:MRT-B04","MC_GB18_L2_04:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L3_02:MRT-B05","text":"The minimal reconstruction is sufficient only if it preserves the concrete mutation sequence, recursive return, and productive tension between negative closure and positive self-organization.","refs":["MC_GB18_L2_03:MRT-B05","MC_GB18_L2_04:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L3_02@R001","source_variant_id":"canonical:MC_GB18_L3_02:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L3 02","context":"Chapters 97–167 · A. Die absolute Indifferenz. · B. Die Indifferenz als umgekehrtes Verhältniß ihrer Faktoren. · Anmerkung. · C. Übergang in das Wesen. · Zweites Buch Das Wesen. · Erster Abschnitt. Das Wesen als Reflexion in ihm selbst. · A. Das Wesentliche und das Unwesentliche. · B. Der Schein. · C. Die Reflexion. · 1. Die setzende Reflexion. · 2. Die äußere Reflexion. · 3. Bestimmende Reflexion. · Anmerkung. · A. Die Identität. · Anmerkung 1. · Anmerkung 2. · 1. Der absolute Unterschied. · 2. Die Verschiedenheit. · Anmerkung. · 3. Der Gegensatz. · Anmerkung. · C. Der Widerspruch. · Anmerkung 1. · Anmerkung 2. · Anmerkung 3. · Anmerkung. · a. Form und Wesen. · b. Form und Materie. · c. Form und Inhalt. · a. Der formelle Grund. · Anmerkung. · b. Der reale Grund. · Anmerkung. · c. Der vollständige Grund. · a. Das relativ Unbedingte. · b. Das absolute Unbedingte. · c. Hervorgang der Sache in die Existenz. · Zweiter Abschnitt. Die Erscheinung. · A. Das Ding und seine Eigenschaften. · a. Ding an sich und Existenz. · b. Die Eigenschaft. · Anmerkung. · c. Die Wechselwirkung der Dinge. · B. Das Bestehen des Dings aus Materien. · C. Die Auflösung des Dings. · Anmerkung. · A. Das Gesetz der Erscheinung. · B. Die erscheinende und die an-sich-seynede Welt. · C. Auflösung der Erscheinung. · A. Das Verhältniß des Ganzen und der Theile. · Anmerkung. · B. Das Verhältniß der Kraft und ihrer Äußerung. · a. Das Bedingtseyn der Kraft. · b. Die Sollicitation der Kraft. · c. Die Unendlichkeit der Kraft. · C. Verhältniß des Äußern und Innern. · Anmerkung. · Dritter Abschnitt. Die Wirklichkeit. · A. Die Auslegung des Absoluten. · B. Das absolute Attribut. · C. Der Modus des Absoluten. · Anmerkung. · A. Zufälligkeit oder formelle Wirklichkeit, Möglichkeit und Nothwendigkeit. · B. Relative Nothwendigkeit oder reale Wirklichkeit, Möglichkeit und Nothwendigkeit. · C. Absolute Nothwendigkeit. · A. Das Verhältniß der Substantialität. · B. Das Kausalitäts-Verhältniß. · a. Die formelle Kausalität. · b. Das bestimmte Kausalitätsverhältniß. · c. Wirkung und Gegenwirkung. · C. Die Wechselwirkung."},"title_language_code":"en"},{"id":"MC_GB18_L1_03","layer":"MC","title":"Gb18 L1 03","order":3,"parents":["CL_GB18_09","CL_GB18_10","CL_GB18_11","CL_GB18_12"],"revision":"MC_GB18_L1_03@R001","sha256":"29daf16b15041455602dc460bdc202329517ff0e3cb5c852ea5b298f412729cc","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_03:AS-01","text":"Das System löst bestimmte Existenz aus dem Modell unmittelbarer Selbstidentität und bestimmt sie als durch Anderssein vermittelte Selbstbeziehung.","refs":["CL_GB18_09:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-02","text":"Die Grenze bildet den generativen Operator, der Bestimmtheit konstituiert, Nichtsein immanent setzt und das Endliche zur Selbstüberschreitung treibt.","refs":["CL_GB18_09:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-03","text":"Die Selbstüberschreitung erscheint zunächst als Verhältnis von Sollen und Schranke, dessen Hinausgehen die Endlichkeit nicht verlässt, sondern reproduziert.","refs":["CL_GB18_10:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-04","text":"Die erste Negation des Endlichen erzeugt keine Unendlichkeit, sondern setzt durch ihren Ausschluss ein Gegenüber, das das Unendliche selbst verendlicht.","refs":["CL_GB18_11:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-05","text":"Der unendliche Progress temporalisiert eine unbegriffene Einheit: Jeder Überschritt wiederholt die Grenze, deren abstrakte Negation er vollziehen sollte.","refs":["CL_GB18_11:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-06","text":"Wahrhafte Unendlichkeit entsteht erst, wenn Endliches und abstrakt Unendliches ihre selbständige Gegenstellung verlieren und als genetische Momente einer Selbstvermittlung erscheinen.","refs":["CL_GB18_11:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-07","text":"Die logische Aufhebung eskaliert zur Ontologie, indem affirmative Selbstbeziehung als negationshaltiges Daseyn und schließlich als Fürsichseyn bestimmt wird.","refs":["CL_GB18_12:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-08","text":"Die Bewegung ist rekursiv, spiralförmig und mutationsgetrieben; sie schließt nicht durch Stillstellung, sondern durch eine Einheit, die Negation und Unterschied als ideelle Momente erhält.","refs":["CL_GB18_12:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_03:GA-01","text":"[Persistent] Bestimmtheit besitzt keine unvermittelte Identität, sondern besteht nur, indem sie Anderssein als eigenes Moment enthält.","refs":["CL_GB18_09:GA-01","CL_GB18_12:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-02","text":"[Persistent] Grenze ist zugleich Konstitution, Differenz und immanente Negation; sie begrenzt keinen fertigen Bestand, sondern erzeugt dessen bestimmte Existenz und Übergang.","refs":["CL_GB18_09:GA-03","CL_GB18_11:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-03","text":"[Persistent] Endlichkeit ist keine isolierte Eigenschaft, sondern die Einheit von Bestimmtheit, eigenem Nichtsein, negativem Selbstverhältnis und notwendiger Selbstüberschreitung.","refs":["CL_GB18_09:GA-05","CL_GB18_10:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-04","text":"[Mutating] Das Sollen artikuliert die Überschreitung der Schranke, bleibt jedoch an sie gebunden und behält daher nur endliche normative, nicht letzte ontologische Geltung.","refs":["CL_GB18_10:GA-03","CL_GB18_10:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-05","text":"[Mutating] Negation wechselt von äußerem Ausschluss über immanente Selbstnegation zur Aufhebung ihrer eigenen Einseitigkeit.","refs":["CL_GB18_11:GA-03","CL_GB18_12:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-06","text":"[Persistent] Ein dem Endlichen entgegengesetztes Unendliches bleibt durch das Ausgeschlossene bestimmt und ist deshalb selbst endlich.","refs":["CL_GB18_11:GA-04","CL_GB18_12:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-07","text":"[Emergent] Der unendliche Progress ist die rekursive Reproduktion einer Grenze, deren Überschreitung die Gegenstellung von Endlichem und Unendlichem unverändert wieder einsetzt.","refs":["CL_GB18_11:GA-08","CL_GB18_12:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-08","text":"[Mutating] Idealität bedeutet nicht Unwirklichkeit, sondern den Status einer unterschiedenen Bestimmung, die genetisch wirksam bleibt, ohne selbständig zu bestehen.","refs":["CL_GB18_12:GA-05","CL_GB18_11:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-09","text":"[Emergent] Die Negation der Negation bewahrt die negierte Bestimmung, indem sie deren Selbständigkeit aufhebt und sie in affirmative Selbstbeziehung überführt.","refs":["CL_GB18_10:GA-08","CL_GB18_12:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-10","text":"[Attractor] Affirmation ist kein vorausgesetzter positiver Grund, sondern die Rückkehr der Negation aus der Einseitigkeit ihres Ausschlusses.","refs":["CL_GB18_12:GA-08","CL_GB18_09:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-11","text":"[Terminal] Die vermittelte Unendlichkeit verdichtet sich ontologisch zu negationshaltigem Daseyn und zur Selbstbeziehung des Fürsichseyns.","refs":["CL_GB18_12:GA-07","CL_GB18_12:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-12","text":"[Attractor] Selbstbeziehung ist der globale Attraktor, auf den Grenze, Schranke, Anderssein, Negation, Übergang, Idealität und Aufhebung konvergieren.","refs":["CL_GB18_11:GA-06","CL_GB18_12:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-13","text":"[Attractor] Immanente Kritik muss nicht nur Antworten, sondern auch Frageformen negieren, wenn diese die Selbständigkeit der zu vermittelnden Gegensätze bereits voraussetzen.","refs":["CL_GB18_12:GA-09","CL_GB18_12:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_03:RMD-01","text":"[Displacement] Das Andere wandert vom äußeren Gegenstand in die innere Negation und wird schließlich als ideelles Moment vermittelter Selbstbeziehung bestimmt.","refs":["CL_GB18_09:GA-02","CL_GB18_11:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-02","text":"[Escalation] Die Grenze mutiert von qualitativer Bestimmtheit zur Schranke, von dort zum Motor wiederholter Überschreitung und schließlich zur nichtselbständigen Differenz innerhalb des Unendlichen.","refs":["CL_GB18_09:RMD-04","CL_GB18_10:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-03","text":"[Terminal transformation] Das Endliche verändert seinen Status vom vergehenden Bestand über den Gegenpol des Unendlichen zum notwendigen Vermittler, dessen Selbständigkeit im Resultat aufgehoben ist.","refs":["CL_GB18_09:RMD-05","CL_GB18_11:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-04","text":"[Functional recurrence] Das Sollen bleibt als endliche Normform erhalten, verliert aber seine Funktion als Lösung der Schranke und als letzte Gestalt der Vernunft.","refs":["CL_GB18_10:AS-06","CL_GB18_10:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-05","text":"[Reversal] Negation kehrt ihre Valenz um: Als Ausschluss produziert sie Gegenstellung und Endlichkeit, als Selbstnegation erzeugt sie vermittelte Affirmation.","refs":["CL_GB18_11:RMD-02","CL_GB18_12:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-06","text":"[Mutation] Das Unendliche wandert von einer unbestimmten Leerstelle über das abstrakte Jenseits und die schlechte Progression zur affirmativen Prozessform immanenter Selbstvermittlung.","refs":["CL_GB18_09:RMD-06","CL_GB18_12:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-07","text":"[Reversal] Progress verliert seine positive Valenz als Annäherung und wird zum Symptom dafür, dass die Grenze unter jedem Überschritt erneut installiert wird.","refs":["CL_GB18_11:RMD-05","CL_GB18_12:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-08","text":"[Mutation] Übergang verliert die Form räumlicher oder zeitlicher Versetzung und wird zur inneren Selbstbewegung wechselseitig abhängiger Bestimmungen.","refs":["CL_GB18_12:RMD-05","CL_GB18_12:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-09","text":"[Absorption] Das zunächst unterbestimmte Affirmative wird in die wahre Unendlichkeit, deren Idealität und schließlich in die Kategorien gesteigerter Selbstbeziehung absorbiert.","refs":["CL_GB18_09:FL-03","CL_GB18_12:XD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_03:CGD-01","text":"Anthropologische, geometrische und organische Beispiele bleiben lokale Anschauungsfelder; global fortbesteht nur ihre gemeinsame Struktur immanenter Grenze und Selbstüberschreitung.","refs":["CL_GB18_09:CGD-01","CL_GB18_10:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-02","text":"Die Differenz von Bestimmung und Beschaffenheit bleibt eine lokale Vorform; auf aktueller Ebene wird sie in die umfassendere Instabilität selbständiger Innen- und Außenseiten absorbiert.","refs":["CL_GB18_09:CGD-03","CL_GB18_09:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-03","text":"Moralische Pflicht skaliert nicht zur Ontologie des Ganzen, sondern bleibt eine endliche normative Vermittlung, deren Verabsolutierung den Widerspruch perpetuieren würde.","refs":["CL_GB18_10:CGD-04","CL_GB18_10:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-04","text":"Die Reihe anderer Endlicher skaliert nur insofern, als sie im unendlichen Progress zur allgemeinen Wiederholungsform nicht aufgehobener Grenze wird.","refs":["CL_GB18_10:RLE-03","CL_GB18_11:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-05","text":"Seyn, Daseyn und Fürsichseyn bleiben bestimmte Kategorien der unteren Ableitungssequenz; nach oben skaliert ihre gemeinsame Logik zunehmender Selbstbeziehung.","refs":["CL_GB18_12:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-06","text":"Die positive Gestalt konkreter Befreiung bleibt unterbestimmt; global bestimmt ist lediglich, dass weder abstraktes Können noch äußeres Hinausgehen sie leisten kann.","refs":["CL_GB18_10:CGD-05","CL_GB18_10:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-07","text":"Die lokale Gegenstellung von fixierender Analyse und spekulativem Denken skaliert zur allgemeinen methodischen Differenz zwischen äußerem Vergleich und immanenter Rekonstruktion.","refs":["CL_GB18_12:CGD-04","CL_GB18_11:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_03:GNX-01","text":"Ausgeschlossen ist eine unmittelbare Identität, die Anderssein, Vermittlung und Negation als bloß nachträgliche Zusätze behandeln könnte.","refs":["CL_GB18_09:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-02","text":"Ausgeschlossen ist eine Grenze, die einem fertigen und sonst unberührten Seienden lediglich äußerlich hinzutritt.","refs":["CL_GB18_09:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-03","text":"Ausgeschlossen ist jedes Zweiweltenmodell, das Endliches und Unendliches als unabhängig bestehende Regionen verteilt.","refs":["CL_GB18_11:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-04","text":"Ausgeschlossen ist die Gleichsetzung von Hinausgehen und Befreiung, weil abstrakte Überschreitung ihre Schranke als notwendige Beziehung mitführt.","refs":["CL_GB18_10:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-05","text":"Ausgeschlossen ist endloser Fortschritt als Lösung, weil er den zu lösenden Gegensatz in jedem Schritt erneut erzeugt.","refs":["CL_GB18_11:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-06","text":"Ausgeschlossen ist ein endgültiges Nichts, da eine absolut gesetzte Negativität selbst zum positiven Bestand und damit zum Gegenstand weiterer Negation wird.","refs":["CL_GB18_09:GNX-06","CL_GB18_09:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-07","text":"Ausgeschlossen ist jede äußere Übergangsinstanz, gleichgültig ob sie als subjektive Vernunft, fremde Gewalt oder transzendentes Jenseits erscheint.","refs":["CL_GB18_11:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_03:DBN-01","text":"Damit die Architektur Bestand hat, dürfen weder Endlichkeit noch Unendlichkeit schlechthin selbständig sein; jede Seite muss ihre Abhängigkeit vom Anderen in sich tragen.","refs":["CL_GB18_11:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:DBN-02","text":"Unzulässig ist jeder äußere Mechanismus, der zwischen zunächst vollständig getrennten Bestimmungen nachträglich vermitteln würde.","refs":["CL_GB18_12:DBN-03","CL_GB18_12:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:DBN-03","text":"Unzulässig ist eine positive Identität, die Negation und Widerspruch vorausläge, statt aus deren Selbstaufhebung hervorzugehen.","refs":["CL_GB18_10:DBN-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:DBN-04","text":"Unzulässig ist eine Zeitform, die begriffliche Vermittlung durch unbegrenzte Sukzession ersetzt und Wiederholung als Annäherung ausgibt.","refs":["CL_GB18_11:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:DBN-05","text":"Unzulässig ist eine voraussetzungsneutrale Frageform, weil bereits die Fragestellung getrennte Entitäten, äußere Übergänge oder lineare Ursprünge setzen kann.","refs":["CL_GB18_12:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_03:BSA-01","text":"Nicht verfügbar ist ein neutraler Außenstandpunkt, von dem Grenze, Endlichkeit und Unendlichkeit als fertige Gegenstände verglichen werden könnten.","refs":["CL_GB18_09:BSA-01","CL_GB18_12:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSA-02","text":"Nicht verfügbar ist ein reines Anfangs- oder Endmoment, das der Vermittlungsbewegung vorausläge oder ihrem Rückgriff entzogen bliebe.","refs":["CL_GB18_12:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSA-03","text":"Unmöglich ist ein letztes Nichts, dessen Negativität nicht selbst negiert und in vermittelte Bestimmtheit zurückgeführt werden könnte.","refs":["CL_GB18_09:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSA-04","text":"Unmöglich ist eine letzte Identität, die gegen Differenz, Negation und Vermittlung immun wäre; gerade diese nicht verfügbare Möglichkeit organisiert die Gesamtbewegung.","refs":["CL_GB18_12:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_03:XD-01","text":"Die negative Schließung des Vergehens wird erst durch die affirmative Negation bestimmbar: Das Positive darf nicht von außen ergänzt werden, sondern muss aus dem Verlust der Letztgültigkeit der Negation hervorgehen.","refs":["MC_GB18_L1_03:GA-05","MC_GB18_L1_03:GA-09","MC_GB18_L1_03:GA-10","CL_GB18_09:AS-08","CL_GB18_10:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-02","text":"Sollen und unendlicher Progress sind strukturell homolog: Beide versprechen Überschreitung, reproduzieren aber durch die fortbestehende Beziehung auf ihre Schranke die Endlichkeit.","refs":["MC_GB18_L1_03:GA-04","MC_GB18_L1_03:GA-07","CL_GB18_10:GA-03","CL_GB18_11:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-03","text":"Die Internalisierung des Anderen und die Idealität des Endlichen bilden dieselbe Bewegung auf verschiedenen Skalen: Alterität bleibt wirksam, verliert aber den Status selbständiger Exteriorität.","refs":["MC_GB18_L1_03:GA-01","MC_GB18_L1_03:GA-08","CL_GB18_09:GA-02","CL_GB18_12:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-04","text":"Die wahre Unendlichkeit bleibt keine bloße Relationslösung, sondern erzeugt eine ontologische Verdichtung, in der vermittelte Selbstbeziehung als Daseyn und Fürsichseyn bestimmt wird.","refs":["MC_GB18_L1_03:GA-09","MC_GB18_L1_03:GA-11","CL_GB18_11:GA-09","CL_GB18_12:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-05","text":"Anderssein ist nicht nur Bedingung bestimmter Identität, sondern der operative Träger, durch den Selbstbeziehung ihre eigene Nichtselbständigkeit erkennt und transformiert.","refs":["MC_GB18_L1_03:GA-01","MC_GB18_L1_03:GA-12","CL_GB18_09:AS-02","CL_GB18_11:GA-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-06","text":"Weil weder Vergehen noch Nichts als letzter Zustand bestehen kann, muss jede terminale Negation in die Negation ihrer eigenen Absolutheit übergehen.","refs":["MC_GB18_L1_03:GA-05","MC_GB18_L1_03:GA-09","CL_GB18_09:GA-08","CL_GB18_12:RLE-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-07","text":"Der Entzug eines äußeren Standpunkts und die Kritik voraussetzungsbeladener Fragen konvergieren in einer Erkenntnisform, die ihre Gegenstände nur durch Rekonstruktion ihrer immanenten Erzeugungsbedingungen begreift.","refs":["MC_GB18_L1_03:GA-12","MC_GB18_L1_03:GA-13","CL_GB18_11:BSD-05","CL_GB18_12:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-08","text":"Das Endliche muss zugleich verschwinden und erhalten bleiben: Es verliert selbständiges Sein, darf aber als genetische Vermittlungsbedingung des Unendlichen nicht getilgt werden.","refs":["MC_GB18_L1_03:GA-08","MC_GB18_L1_03:GA-11","CL_GB18_11:FL-01","CL_GB18_11:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_03:BSD-01","text":"Realität wird zu einer Maschine immanenter Selbstdifferenzierung, deren Bestimmungen durch eigene Grenzen entstehen, sich negieren und als nichtselbständige Momente zurückkehren.","refs":["CL_GB18_12:BSD-01","CL_GB18_11:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-02","text":"Kausalität wird von äußerer Einwirkung auf die innere Unvereinbarkeit von Bestimmungen verschoben; das Werden ist Selbstverursachung durch vermittelte Negation.","refs":["CL_GB18_10:BSD-02","CL_GB18_12:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-03","text":"Zeit besitzt eine doppelte Funktion: Als Progress konserviert sie den ungelösten Gegensatz, als prozessuale Aufhebung artikuliert sie dessen Rückkehr in vermittelte Selbstbeziehung.","refs":["CL_GB18_10:BSD-03","CL_GB18_11:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-04","text":"Das Subjekt verliert den Status eines souveränen Ursprungs und wird zum Vollzug eines Begreifens, das die Selbstbewegung der Bestimmungen nachvollzieht.","refs":["CL_GB18_11:BSD-03","CL_GB18_12:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-05","text":"Erkenntnis besteht nicht in äußerem Vergleich, sondern in der Rekonstruktion der Bedingungen, unter denen Identitäten, Gegensätze, Reihen und Fragen als selbständig erscheinen.","refs":["CL_GB18_12:BSD-03","CL_GB18_12:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-06","text":"Normative Forderung bleibt innerhalb endlicher Verhältnisse wirksam, kann aber weder Freiheit noch ontologische Versöhnung abschließend begründen.","refs":["CL_GB18_10:BSD-04","CL_GB18_10:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-07","text":"Wahrheit wird von dauerhafter Selbigkeit zur Fähigkeit einer Bestimmung umgeordnet, ihre Einseitigkeit zu negieren und sich als Moment einer umfassenderen Selbstbeziehung auszuweisen.","refs":["CL_GB18_11:BSD-04","CL_GB18_12:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_03:RLE-01","text":"Bestimmtheit erzeugt Grenze, Grenze erzeugt negatives Selbstverhältnis, und dieses treibt die Bestimmtheit über ihre unmittelbare Gestalt hinaus.","refs":["CL_GB18_09:RLE-01","CL_GB18_09:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-02","text":"Schranke erzeugt Sollen, Sollen erzeugt Hinausgehen, und das Hinausgehen reproduziert die Schranke als fortbestehende Bedingung.","refs":["CL_GB18_10:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-03","text":"Die schlechte Unendlichkeit bildet eine Eskalationsschleife, in der die Negation des Endlichen ein begrenzendes Gegenüber setzt und dadurch erneute Negation erzwingt.","refs":["CL_GB18_11:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-04","text":"Der Phasenwechsel beginnt, sobald die Wiederkehr der Grenze nicht mehr zum Weitergehen auffordert, sondern als Beweis für die Endlichkeit des isolierten Unendlichen gelesen wird.","refs":["CL_GB18_11:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-05","text":"Die Negation der Negation bildet die Korrekturschleife, welche die Wiederholung unterbricht, indem sie nicht das Andere, sondern die Selbständigkeit der Opposition negiert.","refs":["CL_GB18_12:RLE-03","CL_GB18_11:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-06","text":"Die Bewegung eskaliert von qualitativer Grenze über Endlichkeit und schlechte Unendlichkeit zur Idealität und schließlich zur ontologischen Selbstbeziehung.","refs":["CL_GB18_12:RLE-04","CL_GB18_12:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-07","text":"Selbstbeziehung fungiert als Attraktor, weil sämtliche Übergänge auf die Einsicht konvergieren, dass das Andere jeder Bestimmung bereits in ihrer eigenen Struktur wirksam ist.","refs":["CL_GB18_11:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_03:FGS-B01","text":"Vermittelte Identität plus immanentes Anderssein erzeugt bestimmte Existenz, deren Grenze sowohl Konstitution als auch Negation ist.","refs":["CL_GB18_09:GA-01","CL_GB18_09:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B02","text":"Immanente Grenze plus negatives Selbstverhältnis erzeugt Endlichkeit als notwendige Selbstüberschreitung und Vergehen.","refs":["CL_GB18_09:AS-05","CL_GB18_09:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B03","text":"Endlichkeit plus Schranke erzeugt das Sollen als Überschreitungsform, die ihre Begrenzung in sich fortsetzt.","refs":["CL_GB18_10:AS-03","CL_GB18_10:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B04","text":"Sollen plus fortbestehende Schranke erzeugt eine Serie von Überschreitungen, in der Möglichkeit und Unmöglichkeit sowie Einheit und Trennung alternieren.","refs":["CL_GB18_10:AS-04","CL_GB18_12:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B05","text":"Äußerliche Negation des Endlichen erzeugt abstrakte Unendlichkeit; deren Abhängigkeit vom Ausgeschlossenen erzeugt schlechte Unendlichkeit und Progress.","refs":["CL_GB18_11:FGS-B03","CL_GB18_11:AFM-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B06","text":"Reflexion der wechselseitigen Abhängigkeit negiert die Selbständigkeit beider Seiten und erzeugt Idealität als bewahrten Unterschied innerhalb einer vermittelten Einheit.","refs":["CL_GB18_12:XD-04","CL_GB18_12:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B07","text":"Ideelle Einheit plus Selbstbeziehung der Negation erzeugt affirmative Unendlichkeit, negationshaltiges Daseyn und Fürsichseyn.","refs":["CL_GB18_12:FGS-B06","CL_GB18_12:GA-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_03:AFM-B01","text":"Unmittelbare Selbstidentität → Vermittlung durch Anderssein → bestimmte Existenz.","refs":["CL_GB18_09:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B02","text":"Bestimmte Existenz → immanente Grenze → Endlichkeit als negatives Selbstverhältnis.","refs":["CL_GB18_09:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B03","text":"Endlichkeit → Schranke und Sollen → widersprüchliches Hinausgehen.","refs":["CL_GB18_10:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B04","text":"Hinausgehen → Wiederkehr der Grenze → unendlicher Progress.","refs":["CL_GB18_11:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B05","text":"Unendlicher Progress → Diagnose der Abhängigkeit des abstrakten Unendlichen → Negation der selbständigen Gegenstellung.","refs":["CL_GB18_11:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B06","text":"Negation der Gegenstellung → Idealität des Endlichen → affirmative Unendlichkeit.","refs":["CL_GB18_12:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B07","text":"Affirmative Unendlichkeit → negationshaltiges Daseyn → Fürsichseyn als verdichtete Selbstbeziehung.","refs":["CL_GB18_12:AFM-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_03:MME-01","text":"Innen und Außen werden nicht länger als getrennte Bereiche kartiert; Exteriorität erscheint als vermittelte Exponiertheit einer Bestimmung gegenüber ihrer eigenen Grenze.","refs":["CL_GB18_09:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-02","text":"Die Grenze wird vom Rand eines fertigen Gegenstandes zur Maschine seiner Konstitution, Auflösung und Transformation umklassifiziert.","refs":["CL_GB18_09:MME-02","CL_GB18_11:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-03","text":"Endliches und Unendliches verlieren den Status getrennter Seinsregionen und werden zu genetisch verbundenen Momenten eines Vermittlungsprozesses.","refs":["CL_GB18_12:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-04","text":"Fortschritt verliert seinen positiven Status als Annäherung und wird zur zyklischen Reinstallation eines ungelösten Gegensatzes.","refs":["CL_GB18_11:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-05","text":"Negation wird von Verlust und Vernichtung zur produktiven Quelle von Bestimmtheit, Affirmation und Selbstbeziehung transformiert.","refs":["CL_GB18_12:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-06","text":"Das Jenseits wird von einer höheren Realität zum Symptom einer Negation umkartiert, die noch nicht zu sich selbst zurückgekehrt ist.","refs":["CL_GB18_12:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-07","text":"Philosophische Lektüre muss nicht nur Propositionen, sondern auch Übergangsmodelle, Reihenbildungen und Frageformen auf ihre impliziten Ontologien prüfen.","refs":["CL_GB18_12:MME-04","CL_GB18_09:MME-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_03:ALT-B01","text":"Surface level — Grenze, Schranke, Sollen, Vergehen, Endliches, Unendliches, Progress, Idealität, Seyn, Daseyn und Fürsichseyn bilden die expliziten Gegenstände der Bewegung.","refs":["CL_GB18_12:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:ALT-B02","text":"Structural level — Eine rekursive Maschine verbindet vermittelte Identität, immanente Negation, Grenzsetzung, Wiederholung, Aufhebung und affirmative Selbstbeziehung.","refs":["CL_GB18_09:ALT-B02","CL_GB18_12:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:ALT-B03","text":"Metastrategic level — Äußere Befreiung, subjektive Erhebung und linearer Fortschritt werden durch immanente Rekonstruktion der selbstbegrenzenden Bestimmungen ersetzt.","refs":["CL_GB18_10:ALT-B03","CL_GB18_11:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:ALT-B04","text":"Ontological / Temporal level — Sein ist Resultat selbstnegativer Vermittlung; Zeit erscheint entweder als Wiederholung ungelöster Grenze oder als Vollzug ihrer Aufhebung.","refs":["CL_GB18_11:ALT-B04","CL_GB18_12:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie jede feste Bestimmung setzt, durch ihren immanenten Gegensatz destabilisiert und in veränderter Funktion zurückkehren lässt.","refs":["CL_GB18_09:ALT-B05","CL_GB18_12:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_03:FL-01","text":"Die Grenze muss zugleich affirmative Bestimmung und Negation sein; ihre Produktivität hängt an einer Einheit, die nicht in ruhige Identität überführt werden darf.","refs":["CL_GB18_09:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FL-02","text":"Das Sollen ist notwendige Normform und unzureichende Vermittlung zugleich; seine Entmachtung als Letztprinzip liefert noch keine positive Theorie konkreter Freiheit.","refs":["CL_GB18_10:FL-01","CL_GB18_10:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FL-03","text":"Der Übergang von unendlicher Serie zu affirmativer Unendlichkeit wird strukturell verlangt, aber nicht vollständig gegen einen bloßen Abbruch der Wiederholung abgesichert.","refs":["CL_GB18_10:FL-03","CL_GB18_12:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FL-04","text":"Das Endliche muss als Vermittlungsbedingung erhalten und als selbständiges Resultat aufgehoben werden; Tilgung und Idealität bleiben dauerhaft verwechselbar.","refs":["CL_GB18_11:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FL-05","text":"Die affirmative Negation bleibt instabil, weil jede unmittelbar positive Gestalt erneut qualitative Begrenzung erzeugen und damit in die überwundene Einseitigkeit zurückfallen kann.","refs":["CL_GB18_11:FL-02","CL_GB18_12:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MP-01","text":"Das Andere mutiert vom äußeren Gegenüber zur immanenten Differenz und schließlich zum ideellen Moment der Selbstbeziehung.","refs":["CL_GB18_10:RMD-02","CL_GB18_12:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MP-02","text":"Grenze mutiert zur Schranke, sobald sie nicht nur unterscheidet, sondern als eigene Negativität das Hinausgehen des Endlichen hervorbringt.","refs":["CL_GB18_10:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MP-03","text":"Negation mutiert vom ausschließenden Akt zur Selbstnegation der Opposition und erhält dadurch affirmative Funktion.","refs":["CL_GB18_11:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MP-04","text":"Unendlichkeit mutiert vom abstrakten Jenseits zur prozessualen Einheit, in der das Endliche als nichtselbständiges Moment erhalten bleibt.","refs":["CL_GB18_11:MP-03","CL_GB18_12:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MP-05","text":"Idealität mutiert von der bloßen Nichtselbständigkeit des Endlichen zur Vermittlungsform, die Daseyn und Fürsichseyn ontologisch erzeugt.","refs":["CL_GB18_12:RMD-03","CL_GB18_12:MP-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_03:HSI-01","text":"Realität erscheint als rekursive Grenzmaschine, die Unterschiede erzeugt, negiert, transformiert und als ideelle Momente ihrer eigenen Einheit zurücknimmt.","refs":["CL_GB18_12:HSI-01","CL_GB18_09:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:HSI-02","text":"Das Subjekt ist kein souveräner Außenpunkt, sondern der mögliche Vollzug eines Begreifens, das die objektive Selbstbewegung der Bestimmungen realisiert.","refs":["CL_GB18_11:HSI-02","CL_GB18_12:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:HSI-03","text":"Zeit ist entweder die endlose Wiederholung einer nicht aufgehobenen Grenze oder die gegenwärtige Rückkehr einer Bewegung, die ihre Voraussetzung nachträglich erzeugt.","refs":["CL_GB18_12:HSI-03","CL_GB18_11:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:HSI-04","text":"Möglich bleibt nur immanente Navigation: Kampf und Freiheit bestehen in der Rekonstruktion und Aufhebung eigener Schranken, falscher Jenseitsmodelle und voraussetzungsbeladener Fragen.","refs":["CL_GB18_10:HSI-04","CL_GB18_12:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_03:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von vermittelter Bestimmtheit über Grenze, Endlichkeit, Sollen und schlechte Unendlichkeit bis zu Idealität und ontologischer Selbstbeziehung zu rekonstruieren.","refs":["CL_GB18_09:MRT-B01","CL_GB18_12:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MRT-B02","text":"Die Architektur ist kohärent, sofern Aufhebung weder Tilgung noch äußere Versöhnung bedeutet, sondern Erhaltung der genetischen Funktion bei Entzug selbständigen Seins.","refs":["CL_GB18_11:MRT-B03","CL_GB18_10:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MRT-B03","text":"Ihre stärkste Operation ist die Umwandlung äußerer Begrenzung in immanente Selbstbewegung und die anschließende Diagnose jeder abstrakten Überschreitung als Wiederholung der Grenze.","refs":["CL_GB18_09:MRT-B03","CL_GB18_11:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MRT-B04","text":"Unterbestimmt bleiben die formale Notwendigkeit des Umschlags von Wiederholung in Affirmation und die positive Gestalt konkreter Freiheit.","refs":["CL_GB18_12:MRT-B02","CL_GB18_10:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MRT-B05","text":"Axiomatischer Reduktion widersteht die performative Rückkehr der Begriffe: Das System kann nur rekonstruiert werden, wenn Grenze, Negation, Unendlichkeit und Einheit als mutierende Funktionen statt als feste Prädikate gelesen werden.","refs":["CL_GB18_12:MRT-B04","CL_GB18_10:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T202704126218Z_48af491c","language_code":"en","language_name":"English","title":"Gb18 L1 03","source_sha256":"29daf16b15041455602dc460bdc202329517ff0e3cb5c852ea5b298f412729cc","sha256":"a9a6f6bd0f73c536d195676f7e51f7f815e08ea9c9aa27d57c384b5bb819a26d","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T20:27:04.127535+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_03:AS-01","text":"The system releases determinate existence from the model of immediate self-identity and determines it as self-relation mediated through otherness.","refs":["CL_GB18_09:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-02","text":"The limit forms the generative operator that constitutes determinacy, posits non-being immanently, and drives the finite toward self-transcendence.","refs":["CL_GB18_09:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-03","text":"Self-transcendence initially appears as the relation of ought and limitation, whose going-beyond does not leave finitude but reproduces it.","refs":["CL_GB18_10:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-04","text":"The first negation of the finite generates no infinity, but through its exclusion posits an opposite that renders infinity itself finite.","refs":["CL_GB18_11:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-05","text":"Infinite progress temporalizes an unconceived unity: every transgression repeats the limit whose abstract negation it was supposed to accomplish.","refs":["CL_GB18_11:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-06","text":"True infinity arises only when the finite and the abstract infinite lose their independent opposition and appear as genetic moments of a self-mediation.","refs":["CL_GB18_11:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-07","text":"Logical sublation escalates into ontology by determining affirmative self-relation as negation-containing Daseyn and finally as Fürsichseyn.","refs":["CL_GB18_12:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AS-08","text":"The movement is recursive, spiral-shaped, and mutation-driven; it closes not through immobilization, but through a unity that preserves negation and difference as ideal moments.","refs":["CL_GB18_12:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_03:GA-01","text":"[Persistent] Determinacy possesses no unmediated identity, but exists only by containing otherness as its own moment.","refs":["CL_GB18_09:GA-01","CL_GB18_12:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-02","text":"[Persistent] Limit is at once constitution, difference, and immanent negation; it does not limit a finished subsistence, but generates its determinate existence and transition.","refs":["CL_GB18_09:GA-03","CL_GB18_11:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-03","text":"[Persistent] Finitude is not an isolated property, but the unity of determinacy, its own non-being, negative self-relation, and necessary self-transcendence.","refs":["CL_GB18_09:GA-05","CL_GB18_10:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-04","text":"[Mutating] The ought articulates the transgression of limitation, yet remains bound to it and therefore retains only finite normative, not ultimate ontological, validity.","refs":["CL_GB18_10:GA-03","CL_GB18_10:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-05","text":"[Mutating] Negation shifts from external exclusion through immanent self-negation to the sublation of its own one-sidedness.","refs":["CL_GB18_11:GA-03","CL_GB18_12:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-06","text":"[Persistent] An infinite opposed to the finite remains determined by what is excluded and is therefore itself finite.","refs":["CL_GB18_11:GA-04","CL_GB18_12:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-07","text":"[Emergent] Infinite progress is the recursive reproduction of a limit whose transgression reinstates unchanged the opposition between finite and infinite.","refs":["CL_GB18_11:GA-08","CL_GB18_12:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-08","text":"[Mutating] Ideality does not mean unreality, but the status of a differentiated determination that remains genetically efficacious without existing independently.","refs":["CL_GB18_12:GA-05","CL_GB18_11:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-09","text":"[Emergent] The negation of negation preserves the negated determination by sublating its independence and transforming it into affirmative self-relation.","refs":["CL_GB18_10:GA-08","CL_GB18_12:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-10","text":"[Attractor] Affirmation is not a presupposed positive ground, but the return of negation from the one-sidedness of its exclusion.","refs":["CL_GB18_12:GA-08","CL_GB18_09:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-11","text":"[Terminal] Mediated infinity condenses ontologically into negation-containing Daseyn and the self-relation of Fürsichseyn.","refs":["CL_GB18_12:GA-07","CL_GB18_12:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-12","text":"[Attractor] Self-relation is the global attractor toward which limit, limitation, otherness, negation, transition, ideality, and sublation converge.","refs":["CL_GB18_11:GA-06","CL_GB18_12:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GA-13","text":"[Attractor] Immanent critique must negate not only answers but also forms of questioning when these already presuppose the independence of the opposites to be mediated.","refs":["CL_GB18_12:GA-09","CL_GB18_12:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_03:RMD-01","text":"[Displacement] The other migrates from the external object into inner negation and is finally determined as an ideal moment of mediated self-relation.","refs":["CL_GB18_09:GA-02","CL_GB18_11:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-02","text":"[Escalation] The limit mutates from qualitative determinacy into limitation, thence into the motor of repeated transgression, and finally into non-independent difference within infinity.","refs":["CL_GB18_09:RMD-04","CL_GB18_10:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-03","text":"[Terminal transformation] The finite changes its status from perishing subsistence, through the counterpole of the infinite, into the necessary mediator whose independence is sublated in the result.","refs":["CL_GB18_09:RMD-05","CL_GB18_11:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-04","text":"[Functional recurrence] The ought remains preserved as a finite normative form, but loses its function as a solution to limitation and as the ultimate form of reason.","refs":["CL_GB18_10:AS-06","CL_GB18_10:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-05","text":"[Reversal] Negation reverses its valence: as exclusion it produces opposition and finitude; as self-negation it generates mediated affirmation.","refs":["CL_GB18_11:RMD-02","CL_GB18_12:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-06","text":"[Mutation] Infinity migrates from an indeterminate empty place through the abstract beyond and bad progression to the affirmative process-form of immanent self-mediation.","refs":["CL_GB18_09:RMD-06","CL_GB18_12:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-07","text":"[Reversal] Progress loses its positive valence as approximation and becomes the symptom that the limit is reinstalled anew beneath every transgression.","refs":["CL_GB18_11:RMD-05","CL_GB18_12:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-08","text":"[Mutation] Transition loses the form of spatial or temporal displacement and becomes the inner self-movement of mutually dependent determinations.","refs":["CL_GB18_12:RMD-05","CL_GB18_12:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RMD-09","text":"[Absorption] The initially underdetermined affirmative is absorbed into true infinity, its ideality, and finally into the categories of intensified self-relation.","refs":["CL_GB18_09:FL-03","CL_GB18_12:XD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_03:CGD-01","text":"Anthropological, geometrical, and organic examples remain local fields of intuition; globally, only their shared structure of immanent limit and self-transcendence persists.","refs":["CL_GB18_09:CGD-01","CL_GB18_10:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-02","text":"The difference between determination and constitution remains a local preliminary form; at the current level, it is absorbed into the more comprehensive instability of independent inner and outer sides.","refs":["CL_GB18_09:CGD-03","CL_GB18_09:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-03","text":"Moral duty does not scale to the ontology of the whole, but remains a finite normative mediation whose absolutization would perpetuate contradiction.","refs":["CL_GB18_10:CGD-04","CL_GB18_10:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-04","text":"The series of other finite things scales only insofar as, in infinite progress, it becomes the general form of repetition of an unsublated limit.","refs":["CL_GB18_10:RLE-03","CL_GB18_11:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-05","text":"Seyn, Daseyn, and Fürsichseyn remain determinate categories of the lower derivational sequence; what scales upward is their shared logic of increasing self-relation.","refs":["CL_GB18_12:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-06","text":"The positive shape of concrete liberation remains underdetermined; globally determined is only that neither abstract capacity nor external going-beyond can accomplish it.","refs":["CL_GB18_10:CGD-05","CL_GB18_10:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:CGD-07","text":"The local opposition between fixing analysis and speculative thinking scales to the general methodological difference between external comparison and immanent reconstruction.","refs":["CL_GB18_12:CGD-04","CL_GB18_11:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_03:GNX-01","text":"Excluded is an immediate identity that could treat otherness, mediation, and negation as merely subsequent additions.","refs":["CL_GB18_09:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-02","text":"Excluded is a limit that merely attaches externally to a finished being otherwise untouched.","refs":["CL_GB18_09:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-03","text":"Excluded is every two-world model that distributes finite and infinite as independently existing regions.","refs":["CL_GB18_11:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-04","text":"Excluded is the equation of going-beyond with liberation, because abstract transgression carries along its limitation as a necessary relation.","refs":["CL_GB18_10:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-05","text":"Excluded is endless progress as a solution, because at every step it produces anew the opposition to be resolved.","refs":["CL_GB18_11:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-06","text":"Excluded is a final nothing, since an absolutely posited negativity itself becomes positive subsistence and thus the object of further negation.","refs":["CL_GB18_09:GNX-06","CL_GB18_09:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:GNX-07","text":"Excluded is every external agency of transition, regardless of whether it appears as subjective reason, alien force, or transcendent beyond.","refs":["CL_GB18_11:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_03:DBN-01","text":"For the architecture to endure, neither finitude nor infinity may be independent absolutely; each side must bear within itself its dependence on the other.","refs":["CL_GB18_11:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:DBN-02","text":"Impermissible is every external mechanism that would subsequently mediate between determinations initially wholly separated.","refs":["CL_GB18_12:DBN-03","CL_GB18_12:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:DBN-03","text":"Impermissible is a positive identity that would precede negation and contradiction rather than emerge from their self-sublation.","refs":["CL_GB18_10:DBN-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:DBN-04","text":"Impermissible is a temporal form that replaces conceptual mediation with unlimited succession and presents repetition as approximation.","refs":["CL_GB18_11:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:DBN-05","text":"Impermissible is a presupposition-neutral form of questioning, because the very posing of the question can posit separate entities, external transitions, or linear origins.","refs":["CL_GB18_12:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_03:BSA-01","text":"Unavailable is a neutral external standpoint from which limit, finitude, and infinity could be compared as finished objects.","refs":["CL_GB18_09:BSA-01","CL_GB18_12:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSA-02","text":"Unavailable is a pure initial or final moment that would precede the movement of mediation or remain beyond its retrospection.","refs":["CL_GB18_12:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSA-03","text":"Impossible is a final nothing whose negativity could not itself be negated and led back into mediated determinacy.","refs":["CL_GB18_09:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSA-04","text":"Impossible is a final identity immune to difference, negation, and mediation; precisely this unavailable possibility organizes the overall movement.","refs":["CL_GB18_12:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_03:XD-01","text":"The negative closure of perishing becomes determinable only through affirmative negation: the positive must not be added from outside, but must emerge from the loss of negation's ultimate validity.","refs":["MC_GB18_L1_03:GA-05","MC_GB18_L1_03:GA-09","MC_GB18_L1_03:GA-10","CL_GB18_09:AS-08","CL_GB18_10:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-02","text":"Ought and infinite progress are structurally homologous: both promise transgression, but through the persisting relation to their limitation reproduce finitude.","refs":["MC_GB18_L1_03:GA-04","MC_GB18_L1_03:GA-07","CL_GB18_10:GA-03","CL_GB18_11:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-03","text":"The internalization of the other and the ideality of the finite constitute the same movement at different scales: alterity remains effective but loses the status of independent exteriority.","refs":["MC_GB18_L1_03:GA-01","MC_GB18_L1_03:GA-08","CL_GB18_09:GA-02","CL_GB18_12:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-04","text":"True infinity remains no mere relational solution, but produces an ontological condensation in which mediated self-relation is determined as Daseyn and Fürsichseyn.","refs":["MC_GB18_L1_03:GA-09","MC_GB18_L1_03:GA-11","CL_GB18_11:GA-09","CL_GB18_12:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-05","text":"Otherness is not only the condition of determinate identity, but the operative bearer through which self-relation recognizes and transforms its own non-independence.","refs":["MC_GB18_L1_03:GA-01","MC_GB18_L1_03:GA-12","CL_GB18_09:AS-02","CL_GB18_11:GA-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-06","text":"Because neither perishing nor nothing can subsist as a final state, every terminal negation must pass into the negation of its own absoluteness.","refs":["MC_GB18_L1_03:GA-05","MC_GB18_L1_03:GA-09","CL_GB18_09:GA-08","CL_GB18_12:RLE-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-07","text":"The withdrawal of an external standpoint and the critique of presupposition-laden questions converge in a form of cognition that comprehends its objects only through reconstruction of their immanent conditions of production.","refs":["MC_GB18_L1_03:GA-12","MC_GB18_L1_03:GA-13","CL_GB18_11:BSD-05","CL_GB18_12:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_03:XD-08","text":"The finite must both disappear and be preserved: it loses independent being, but may not be effaced as the genetic condition of mediation of the infinite.","refs":["MC_GB18_L1_03:GA-08","MC_GB18_L1_03:GA-11","CL_GB18_11:FL-01","CL_GB18_11:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_03:BSD-01","text":"Reality becomes a machine of immanent self-differentiation, whose determinations arise through their own limits, negate themselves, and return as non-independent moments.","refs":["CL_GB18_12:BSD-01","CL_GB18_11:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-02","text":"Causality is displaced from external influence to the inner incompatibility of determinations; becoming is self-causation through mediated negation.","refs":["CL_GB18_10:BSD-02","CL_GB18_12:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-03","text":"Time has a double function: as progress it preserves the unresolved opposition; as processual sublation it articulates its return into mediated self-relation.","refs":["CL_GB18_10:BSD-03","CL_GB18_11:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-04","text":"The subject loses the status of a sovereign origin and becomes the enactment of a comprehending that retraces the self-movement of determinations.","refs":["CL_GB18_11:BSD-03","CL_GB18_12:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-05","text":"Cognition consists not in external comparison, but in reconstruction of the conditions under which identities, oppositions, series, and questions appear independent.","refs":["CL_GB18_12:BSD-03","CL_GB18_12:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-06","text":"Normative demand remains effective within finite relations, but can conclusively ground neither freedom nor ontological reconciliation.","refs":["CL_GB18_10:BSD-04","CL_GB18_10:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:BSD-07","text":"Truth is reassigned from enduring self-sameness to the capacity of a determination to negate its one-sidedness and establish itself as a moment of a more comprehensive self-relation.","refs":["CL_GB18_11:BSD-04","CL_GB18_12:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_03:RLE-01","text":"Determinacy generates limit, limit generates negative self-relation, and this drives determinacy beyond its immediate shape.","refs":["CL_GB18_09:RLE-01","CL_GB18_09:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-02","text":"Limitation generates ought, ought generates going-beyond, and going-beyond reproduces limitation as a persisting condition.","refs":["CL_GB18_10:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-03","text":"Bad infinity forms a loop of escalation in which the negation of the finite posits a limiting opposite and thereby compels renewed negation.","refs":["CL_GB18_11:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-04","text":"The phase shift begins as soon as the recurrence of the limit no longer calls for further advance, but is read as proof of the finitude of isolated infinity.","refs":["CL_GB18_11:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-05","text":"The negation of negation forms the corrective loop that interrupts repetition by negating not the other, but the independence of opposition.","refs":["CL_GB18_12:RLE-03","CL_GB18_11:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-06","text":"The movement escalates from qualitative limit through finitude and bad infinity to ideality and finally to ontological self-relation.","refs":["CL_GB18_12:RLE-04","CL_GB18_12:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:RLE-07","text":"Self-relation functions as an attractor because all transitions converge on the insight that the other of every determination is already effective in its own structure.","refs":["CL_GB18_11:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_03:FGS-B01","text":"Mediated identity plus immanent otherness generates determinate existence, whose limit is both constitution and negation.","refs":["CL_GB18_09:GA-01","CL_GB18_09:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B02","text":"Immanent limit plus negative self-relation generates finitude as necessary self-transcendence and perishing.","refs":["CL_GB18_09:AS-05","CL_GB18_09:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B03","text":"Finitude plus limitation generates ought as a form of transgression that continues its restriction within itself.","refs":["CL_GB18_10:AS-03","CL_GB18_10:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B04","text":"Ought plus persisting limitation generates a series of transgressions in which possibility and impossibility, as well as unity and separation, alternate.","refs":["CL_GB18_10:AS-04","CL_GB18_12:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B05","text":"External negation of the finite generates abstract infinity; its dependence on what is excluded generates bad infinity and progress.","refs":["CL_GB18_11:FGS-B03","CL_GB18_11:AFM-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B06","text":"Reflection on mutual dependence negates the independence of both sides and generates ideality as preserved difference within a mediated unity.","refs":["CL_GB18_12:XD-04","CL_GB18_12:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FGS-B07","text":"Ideal unity plus the self-relation of negation generates affirmative infinity, negation-containing Daseyn, and Fürsichseyn.","refs":["CL_GB18_12:FGS-B06","CL_GB18_12:GA-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_03:AFM-B01","text":"Immediate self-identity → mediation through otherness → determinate existence.","refs":["CL_GB18_09:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B02","text":"Determinate existence → immanent limit → finitude as negative self-relation.","refs":["CL_GB18_09:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B03","text":"Finitude → limitation and ought → contradictory going-beyond.","refs":["CL_GB18_10:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B04","text":"Going-beyond → return of the limit → infinite progress.","refs":["CL_GB18_11:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B05","text":"Infinite progress → diagnosis of the dependence of abstract infinity → negation of independent opposition.","refs":["CL_GB18_11:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B06","text":"Negation of opposition → ideality of the finite → affirmative infinity.","refs":["CL_GB18_12:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:AFM-B07","text":"Affirmative infinity → negation-containing Daseyn → Fürsichseyn as condensed self-relation.","refs":["CL_GB18_12:AFM-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_03:MME-01","text":"Inner and outer are no longer mapped as separate domains; exteriority appears as the mediated exposure of a determination to its own limit.","refs":["CL_GB18_09:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-02","text":"The limit is reclassified from the edge of a finished object into the machine of its constitution, dissolution, and transformation.","refs":["CL_GB18_09:MME-02","CL_GB18_11:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-03","text":"Finite and infinite lose the status of separate regions of being and become genetically connected moments of a process of mediation.","refs":["CL_GB18_12:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-04","text":"Progress loses its positive status as approximation and becomes the cyclical reinstallation of an unresolved opposition.","refs":["CL_GB18_11:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-05","text":"Negation is transformed from loss and annihilation into a productive source of determinacy, affirmation, and self-relation.","refs":["CL_GB18_12:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-06","text":"The beyond is remapped from a higher reality into the symptom of a negation that has not yet returned to itself.","refs":["CL_GB18_12:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MME-07","text":"Philosophical reading must examine not only propositions, but also models of transition, formations of series, and forms of questioning for their implicit ontologies.","refs":["CL_GB18_12:MME-04","CL_GB18_09:MME-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_03:ALT-B01","text":"Surface level — Limit, limitation, ought, perishing, finite, infinite, progress, ideality, Seyn, Daseyn, and Fürsichseyn form the explicit objects of the movement.","refs":["CL_GB18_12:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:ALT-B02","text":"Structural level — A recursive machine connects mediated identity, immanent negation, positing of limits, repetition, sublation, and affirmative self-relation.","refs":["CL_GB18_09:ALT-B02","CL_GB18_12:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:ALT-B03","text":"Metastrategic level — External liberation, subjective elevation, and linear progress are replaced by immanent reconstruction of self-limiting determinations.","refs":["CL_GB18_10:ALT-B03","CL_GB18_11:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:ALT-B04","text":"Ontological / Temporal level — Being is the result of self-negative mediation; time appears either as repetition of an unresolved limit or as the enactment of its sublation.","refs":["CL_GB18_11:ALT-B04","CL_GB18_12:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:ALT-B05","text":"Methodological / Performative level — The exposition enacts its thesis by positing every fixed determination, destabilizing it through its immanent opposite, and allowing it to return in an altered function.","refs":["CL_GB18_09:ALT-B05","CL_GB18_12:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_03:FL-01","text":"The limit must be both affirmative determination and negation; its productivity depends on a unity that must not be transformed into tranquil identity.","refs":["CL_GB18_09:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FL-02","text":"The ought is at once a necessary normative form and insufficient mediation; its disempowerment as an ultimate principle does not yet provide a positive theory of concrete freedom.","refs":["CL_GB18_10:FL-01","CL_GB18_10:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FL-03","text":"The transition from infinite series to affirmative infinity is structurally required, but not fully secured against a mere cessation of repetition.","refs":["CL_GB18_10:FL-03","CL_GB18_12:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FL-04","text":"The finite must be preserved as a condition of mediation and sublated as an independent result; effacement and ideality remain permanently confusable.","refs":["CL_GB18_11:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:FL-05","text":"Affirmative negation remains unstable because every immediately positive shape can once again generate qualitative limitation and thereby fall back into the overcome one-sidedness.","refs":["CL_GB18_11:FL-02","CL_GB18_12:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MP-01","text":"The other mutates from the external opposite into immanent difference and finally into the ideal moment of self-relation.","refs":["CL_GB18_10:RMD-02","CL_GB18_12:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MP-02","text":"Limit mutates into limitation as soon as it not only distinguishes, but as its own negativity brings forth the going-beyond of the finite.","refs":["CL_GB18_10:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MP-03","text":"Negation mutates from the excluding act into the self-negation of opposition and thereby acquires an affirmative function.","refs":["CL_GB18_11:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MP-04","text":"Infinity mutates from the abstract beyond into the processual unity in which the finite is preserved as a non-independent moment.","refs":["CL_GB18_11:MP-03","CL_GB18_12:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MP-05","text":"Ideality mutates from the mere non-independence of the finite into the form of mediation that ontologically generates Daseyn and Fürsichseyn.","refs":["CL_GB18_12:RMD-03","CL_GB18_12:MP-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_03:HSI-01","text":"Reality appears as a recursive machine of limits that generates, negates, transforms differences, and takes them back as ideal moments of its own unity.","refs":["CL_GB18_12:HSI-01","CL_GB18_09:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:HSI-02","text":"The subject is not a sovereign external point, but the possible enactment of a comprehending that realizes the objective self-movement of determinations.","refs":["CL_GB18_11:HSI-02","CL_GB18_12:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:HSI-03","text":"Time is either the endless repetition of an unsublated limit or the present return of a movement that retroactively generates its presupposition.","refs":["CL_GB18_12:HSI-03","CL_GB18_11:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:HSI-04","text":"Only immanent navigation remains possible: struggle and freedom consist in the reconstruction and sublation of one's own limitations, false models of the beyond, and presupposition-laden questions.","refs":["CL_GB18_10:HSI-04","CL_GB18_12:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_03:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from mediated determinacy through limit, finitude, ought, and bad infinity to ideality and ontological self-relation.","refs":["CL_GB18_09:MRT-B01","CL_GB18_12:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MRT-B02","text":"The architecture is coherent insofar as sublation means neither effacement nor external reconciliation, but preservation of genetic function while withdrawing independent being.","refs":["CL_GB18_11:MRT-B03","CL_GB18_10:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MRT-B03","text":"Its strongest operation is the transformation of external limitation into immanent self-movement and the subsequent diagnosis of every abstract transgression as repetition of the limit.","refs":["CL_GB18_09:MRT-B03","CL_GB18_11:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MRT-B04","text":"The formal necessity of the reversal from repetition into affirmation and the positive shape of concrete freedom remain underdetermined.","refs":["CL_GB18_12:MRT-B02","CL_GB18_10:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_03:MRT-B05","text":"The performative return of concepts resists axiomatic reduction: the system can be reconstructed only if limit, negation, infinity, and unity are read as mutating functions rather than as fixed predicates.","refs":["CL_GB18_12:MRT-B04","CL_GB18_10:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_03@R001","source_variant_id":"canonical:MC_GB18_L1_03:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 03","context":"Chapters 25–36 · b. Bestimmung, Beschaffenheit und Grenze. · c. Die Endlichkeit. · 1. Die Unmittelbarkeit der Endlichkeit. · 2. Die Schranke und das Sollen. · Anmerkung. · 3. Übergang des Endlichen in das Unendliche. · C. Die Unendlichkeit. · a. Das Unendliche überhaupt. · b. Wechselbestimmung des Endlichen und Unendlichen. · c. Die affirmative Unendlichkeit. · Der Übergang. · Anmerkung 1."},"title_language_code":"en"},{"id":"MC_GB18_L2_03","layer":"MC","title":"Gb18 L2 03","order":3,"parents":["MC_GB18_L1_09","MC_GB18_L1_10","MC_GB18_L1_11"],"revision":"MC_GB18_L2_03@R001","sha256":"58b8672de0a4c9c429500542edf505969282c84083a96023a29863bcb657cd19","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L2_03:AS-01","text":"Das System bearbeitet das Problem, wie Einheit, Bestimmtheit und Grund ohne ursprüngliches Substrat, relationsexterne Identität oder vorausliegenden Erklärungsträger entstehen können.","refs":["MC_GB18_L1_09:BAS-01","MC_GB18_L1_10:BAS-01","MC_GB18_L1_11:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-02","text":"Unmittelbarkeit, Identität und Grund werden als rückwirkend erzeugte Funktionen einer negativen Selbstvermittlung neubestimmt.","refs":["MC_GB18_L1_09:BAS-06","MC_GB18_L1_10:GA-08","MC_GB18_L1_11:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-03","text":"Äußerliche Quantifizierung, formale Vergleichung und die Zuteilung einzelner Gründe bilden aufeinanderfolgende Belastungstests für die immanente Erzeugung qualitativer Verknüpfung.","refs":["MC_GB18_L1_09:BAS-03","MC_GB18_L1_10:BAS-04","MC_GB18_L1_11:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-04","text":"Jede fixierte Bestimmung erzeugt das von ihr ausgeschlossene Andere und erweist damit ihre Selbständigkeit als Funktion einer umfassenderen Relation.","refs":["MC_GB18_L1_09:GA-05","MC_GB18_L1_10:GA-03","MC_GB18_L1_11:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-05","text":"Widerspruch fungiert als skalenübergreifender Übergangsoperator: Er verwandelt Indifferenz in Reflexion, Opposition in Grund und die Krise des Grundes in die Bewegung des Unbedingten.","refs":["MC_GB18_L1_09:BAS-04","MC_GB18_L1_10:GA-06","MC_GB18_L1_11:XD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-06","text":"Die Bewegung führt von der Erzeugung der Reflexion über deren Bestimmungen zur Grundform und anschließend zur Prüfung, Krise und Transformation des Erklärens selbst.","refs":["MC_GB18_L1_09:BAS-07","MC_GB18_L1_10:BAS-03","MC_GB18_L1_11:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-07","text":"Das Argument verläuft rekursiv, spiralförmig und retrospektiv, weil jedes Resultat seinen Ausgangspunkt als eigene Voraussetzung neu setzt.","refs":["MC_GB18_L1_09:BAS-08","MC_GB18_L1_10:BAS-08","MC_GB18_L1_11:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-08","text":"Die Schließung bleibt asymmetrisch: Das absolut Unbedingte beendet den Regress der Grund-Bedingungs-Relation, während Begriff und Zweck als positive Form zureichender Einheit fehlen.","refs":["MC_GB18_L1_11:AS-08","MC_GB18_L1_11:GA-11","MC_GB18_L1_11:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L2_03:GA-01","text":"[Persistent] Konkrete Einheit besteht nur als negative Selbstvermittlung einer Differenz, die weder ausgelöscht noch verselbständigt wird.","refs":["MC_GB18_L1_09:GA-01","MC_GB18_L1_11:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-02","text":"[Persistent] Negativität ist keine äußere Verneinung, sondern die immanente Selbstbeziehung, durch welche Bestimmtheit erzeugt und erhalten wird.","refs":["MC_GB18_L1_09:GA-04","MC_GB18_L1_10:GA-01","MC_GB18_L1_11:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-03","text":"[Mutating] Unmittelbarkeit mutiert vom scheinbaren Anfang zum gesetzten Rest, zur erzeugten Voraussetzung und schließlich zum rückwirkenden Resultat der Vermittlung.","refs":["MC_GB18_L1_09:GA-02","MC_GB18_L1_11:GA-01","MC_GB18_L1_11:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-04","text":"[Mutating] Äußerlichkeit mutiert vom Defekt äußerlicher Bestimmung zur notwendigen Expositionsform immanenter Differenz und erneut zum Defekt, sobald ihre Verknüpfung unerzeugt bleibt.","refs":["MC_GB18_L1_10:BAS-05","MC_GB18_L1_11:GA-08","MC_GB18_L1_11:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-05","text":"[Persistent] Kein Moment besitzt relationsexterne Selbständigkeit; seine Bestimmtheit entsteht ausschließlich innerhalb der Bewegung, die es setzt, unterscheidet und zurücknimmt.","refs":["MC_GB18_L1_10:GA-03","MC_GB18_L1_11:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-06","text":"[Mutating] Identität mutiert von vorausgesetzter Indifferenz und abstrakter Selbstgleichheit zur negativen Einheit, die ihre eigene Differenz hervorbringt.","refs":["MC_GB18_L1_09:RMD-01","MC_GB18_L1_10:GA-02","MC_GB18_L1_11:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-07","text":"[Attractor] Widerspruch ist der wiederkehrende Übergangsoperator, durch den isolierte Bestimmungen ihre Selbständigkeit verlieren und in umfassendere Vermittlungsformen übergehen.","refs":["MC_GB18_L1_09:BAS-04","MC_GB18_L1_10:GA-06","MC_GB18_L1_11:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-08","text":"[Mutating] Grund mutiert vom Resultat bestimmender Reflexion zur rückwirkenden Einheit ihrer Bestimmungen und schließlich zur Operation, die ihre Bedingung selbst setzt.","refs":["MC_GB18_L1_09:GA-08","MC_GB18_L1_10:GA-08","MC_GB18_L1_11:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-09","text":"[Emergent] Zureichende Erklärung muss Identität, Differenz und konkrete Verknüpfung aus derselben Bewegung erzeugen, statt sie durch Benennung, Vergleich oder Addition vorauszusetzen.","refs":["MC_GB18_L1_09:GA-11","MC_GB18_L1_11:GA-06","MC_GB18_L1_11:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-10","text":"[Attractor] Setzen und Voraussetzen bilden eine retrospektive Schleife, in der das vermeintlich Frühere erst durch die Rückkehr der Vermittlung seinen Voraussetzungsstatus erhält.","refs":["MC_GB18_L1_09:GA-07","MC_GB18_L1_11:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-11","text":"[Terminal] Das absolut Unbedingte schließt den Bedingungsregress als negative Identität, ohne damit die positive Gesamtform des Systems zu vollenden.","refs":["MC_GB18_L1_11:GA-11","MC_GB18_L1_11:CGD-06","MC_GB18_L1_11:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-12","text":"[Attractor] Begriff und Zweck wirken als offene Attraktoren einer positiven Zureichendheit, die innerhalb der Grundform gefordert, aber nicht realisiert werden kann.","refs":["MC_GB18_L1_11:GA-10","MC_GB18_L1_11:BSA-04","MC_GB18_L1_11:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-13","text":"[Persistent] Erkenntnis und Erklärung sind nur als immanente Rekonstruktion der erzeugenden Operationen möglich; ein äußerer Beobachtungs- oder Begründungsstandpunkt ist ausgeschlossen.","refs":["MC_GB18_L1_09:BSD-04","MC_GB18_L1_10:GA-09","MC_GB18_L1_11:DBN-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L2_03:RMD-01","text":"Indifferenz verschwindet als eigenständige Kategorie, nachdem ihr Widerspruch die passive Einheit in negative Totalität und Reflexion transformiert hat.","refs":["MC_GB18_L1_09:RMD-01","MC_GB18_L1_09:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-02","text":"Unmittelbarkeit bleibt terminologisch persistent, wechselt aber vom Anfang über Voraussetzung und Material der Vermittlung zum rückwirkend erzeugten Resultat.","refs":["MC_GB18_L1_09:RMD-04","MC_GB18_L1_11:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-03","text":"Negativität eskaliert von destruktiver Selbstunverträglichkeit über produktive Selbstdifferenzierung zur terminalen Form negativer Identität.","refs":["MC_GB18_L1_09:RMD-03","MC_GB18_L1_10:RMD-03","MC_GB18_L1_11:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-04","text":"Identität wandert von vorausgesetzter Einheit über selbstunterscheidende Reflexion zur negativen Einheit der gesamten Grund-Bedingungs-Bewegung.","refs":["MC_GB18_L1_09:MME-01","MC_GB18_L1_10:RMD-01","MC_GB18_L1_11:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-05","text":"Unterschied verschiebt sich von quantitativ oder äußerlich fixierter Verschiedenheit über innere Opposition zur notwendigen Restdifferenz innerhalb vermittelter Einheit.","refs":["MC_GB18_L1_09:RMD-02","MC_GB18_L1_10:RMD-02","MC_GB18_L1_11:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-06","text":"Äußere Reflexion wird zunächst internalisiert, bleibt als Expositionsphase produktiv und kehrt in der realen Begründung als problematische unerzeugte Kopplung zurück.","refs":["MC_GB18_L1_10:RMD-04","MC_GB18_L1_10:XD-06","MC_GB18_L1_11:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-07","text":"Widerspruch mutiert von der Krise vorausgesetzter Einheit zum kategorialen Übergangsoperator und wird schließlich in die negative Identität der Grundbewegung absorbiert.","refs":["MC_GB18_L1_10:RMD-07","MC_GB18_L1_11:RMD-02","MC_GB18_L1_11:XD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-08","text":"Grund wechselt vom erwarteten Fundament zur erzeugten Reflexionseinheit, wird danach als formelle und reale Erklärung geprüft und endet als selbstbedingende Operation.","refs":["MC_GB18_L1_09:RMD-07","MC_GB18_L1_10:GA-08","MC_GB18_L1_11:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-09","text":"Das Dritte mutiert vom ausgeschlossenen Zusatz zur immanenten Einheit der Opposition, dann zum Grund und schließlich zur offenen Differenz zwischen negativer Schließung und positiver Begriffseinheit.","refs":["MC_GB18_L1_10:RMD-06","MC_GB18_L1_10:MP-04","MC_GB18_L1_11:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L2_03:CGD-01","text":"Kräfteanalyse, reflektierende Urteilskraft, Maß und Faktorenrelation bleiben lokale Diagnoseformen; nach oben skaliert nur ihr Nachweis des Ausfalls äußerlicher Übergangserklärung.","refs":["MC_GB18_L1_09:CGD-01","MC_GB18_L1_09:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-02","text":"Satzanalysen, Vorzeichen, Nullbestimmungen und Vergleichsformen bleiben lokale Expositionsmittel für die Selbstaufhebung äußerer Reflexion.","refs":["MC_GB18_L1_10:CGD-01","MC_GB18_L1_10:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-03","text":"Kräfte, Materien, Bewegung, Lebendigkeit und wissenschaftliche Hypothesen bleiben lokale Fälle der allgemeineren Differenz zwischen Benennung, Teilkausalität und immanenter Erklärung.","refs":["MC_GB18_L1_11:CGD-01","MC_GB18_L1_11:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-04","text":"Auf die aktuelle Ebene skaliert die Diagnose, dass jede äußerlich fixierte Relation den qualitativen Übergang voraussetzt, den sie erklären soll.","refs":["MC_GB18_L1_09:GA-03","MC_GB18_L1_10:CGD-02","MC_GB18_L1_11:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-05","text":"Die lokalen Widersprüche skalieren zu einer globalen Transformationsregel, nach der jede selbständige Bestimmung ihre Relation internalisieren und als umfassendere Einheit zurückkehren muss.","refs":["MC_GB18_L1_09:CGD-03","MC_GB18_L1_10:CGD-04","MC_GB18_L1_11:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-06","text":"Der auf der unteren Ebene terminale Grund wird auf der aktuellen Ebene zum Ausgangspunkt einer erneuten Prüfung und verliert dadurch seinen Status als endgültige Schließung.","refs":["MC_GB18_L1_10:CGD-05","MC_GB18_L1_11:CGD-04","MC_GB18_L1_11:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-07","text":"Existenz, Erscheinung, Begriff und Zweck skalieren nicht als positiv entwickelte Inhalte, sondern als Anschluss- und Grenzstrukturen der noch unvollständigen Vermittlung.","refs":["MC_GB18_L1_09:CGD-04","MC_GB18_L1_11:CGD-05","MC_GB18_L1_11:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L2_03:GNX-01","text":"Ausgeschlossen ist jedes passive Substrat oder unmittelbare Sein, das Bestimmungen vor ihrer Vermittlung tragen soll.","refs":["MC_GB18_L1_09:GNX-01","MC_GB18_L1_11:GNX-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-02","text":"Ausgeschlossen sind unabhängige Terme, deren Beziehung erst nachträglich durch quantitative, logische oder kausale Verknüpfung hergestellt wird.","refs":["MC_GB18_L1_09:GNX-02","MC_GB18_L1_10:DBN-01","MC_GB18_L1_11:GNX-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-03","text":"Ausgeschlossen ist ein äußerer Erkenntnis-, Vergleichs- oder Begründungsstandpunkt, der die Relation fixiert, ohne selbst von ihr bestimmt zu werden.","refs":["MC_GB18_L1_09:GNX-03","MC_GB18_L1_10:GNX-02","MC_GB18_L1_11:DBN-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-04","text":"Ausgeschlossen ist eine Logik, die Widerspruch als bloße Störung behandelt und dadurch den Übergangsoperator der Vermittlung entfernt.","refs":["MC_GB18_L1_10:GNX-03","MC_GB18_L1_11:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-05","text":"Ausgeschlossen sind ursprüngliche Selbstgleichheit, ein absolut erstes Positives und eine Einheit ohne Selbstentzweiung.","refs":["MC_GB18_L1_09:BSA-02","MC_GB18_L1_10:GNX-04","MC_GB18_L1_11:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-06","text":"Ausgeschlossen ist die Gleichsetzung von Erklärung mit Umbenennung, Addition, anerkannter Wesentlichkeit oder institutionell stabilisierter Grundzuteilung.","refs":["MC_GB18_L1_11:GNX-06","MC_GB18_L1_11:DBN-05","MC_GB18_L1_11:BSD-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-07","text":"Ausgeschlossen sind lineare Grund- und Kausalordnungen sowie ein ruhendes Unbedingtes, das die negative Bewegung von außen beendet.","refs":["MC_GB18_L1_09:GNX-05","MC_GB18_L1_11:GNX-05","MC_GB18_L1_11:GNX-07"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L2_03:DBN-01","text":"Damit das System Bestand hat, muss reine Selbstgegenwart falsch sein: Keine Einheit darf vor ihrer Negation bereits vollständig bestimmt vorliegen.","refs":["MC_GB18_L1_10:BSA-01","MC_GB18_L1_11:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:DBN-02","text":"Differenz darf weder restlos getilgt noch zu einem ontologisch unabhängigen Außen verselbständigt werden.","refs":["MC_GB18_L1_09:DBN-04","MC_GB18_L1_11:GA-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:DBN-03","text":"Äußerlichkeit darf nicht absolut sein, kann aber auch nicht verschwinden, weil ihre notwendige Expositionsfunktion von ihrer defizitären unerzeugten Form unterschieden werden muss.","refs":["MC_GB18_L1_10:XD-06","MC_GB18_L1_11:XD-03","MC_GB18_L1_11:FL-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:DBN-04","text":"Formale Geschlossenheit, symbolische Operation und die Vervielfachung plausibler Gründe dürfen nicht als zureichende Erklärung gelten.","refs":["MC_GB18_L1_10:DBN-03","MC_GB18_L1_11:DBN-05","MC_GB18_L1_11:XD-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:DBN-05","text":"Ein neutrales Drittes darf die Opposition nicht von außen vermitteln, weil seine eigene Bestimmtheit sonst unerklärt bliebe.","refs":["MC_GB18_L1_10:DBN-04","MC_GB18_L1_11:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:DBN-06","text":"Das Unbedingte darf weder als positives Jenseits noch der Begriff als zusätzlicher Einzelgrund auftreten, ohne die überwundene Grundform zu reproduzieren.","refs":["MC_GB18_L1_11:GNX-07","MC_GB18_L1_11:XD-07"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L2_03:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist ein unvermitteltes Außen, das der Reflexion Material, Grund oder Einheit liefern könnte.","refs":["MC_GB18_L1_09:BSA-01","MC_GB18_L1_10:BSA-02","MC_GB18_L1_11:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:BSA-02","text":"Nicht verfügbar sind ursprüngliche Selbstgegenwart und ein absoluter Anfang, dessen Priorität nicht erst durch Rückkehr erzeugt wird.","refs":["MC_GB18_L1_09:BSA-02","MC_GB18_L1_10:BSA-01","MC_GB18_L1_11:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:BSA-03","text":"Nicht verfügbar ist ein neutraler Endpunkt, an dem Negativität, Vermittlung und die erneute Setzung von Voraussetzungen endgültig erlöschen.","refs":["MC_GB18_L1_10:BSA-03","MC_GB18_L1_11:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:BSA-04","text":"Die strukturierende Abwesenheit des Systems ist die positive Gestalt immanenter Zureichendheit, die als Begriff und Zweck gefordert, aber nicht dargestellt wird.","refs":["MC_GB18_L1_11:BSA-04","MC_GB18_L1_11:GA-10","MC_GB18_L1_11:MRT-B04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L2_03:XD-01","text":"Der Ausfall quantitativer Faktoren, formaler Denkgesetze und institutionalisierter Grundansprüche erweist sich als ein einziger Strukturdefekt: Die Relation wird verwendet, ohne ihre qualitative Erzeugung zu rekonstruieren.","refs":["MC_GB18_L2_03:GA-04","MC_GB18_L2_03:GA-09","MC_GB18_L1_09:XD-01","MC_GB18_L1_10:XD-02","MC_GB18_L1_11:XD-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-02","text":"Weil Unmittelbarkeit erzeugt und Grund rückwirkend gesetzt wird, ist logische Priorität kein zeitliches Vorher, sondern ein Effekt rekonstruierter Rückkehr.","refs":["MC_GB18_L2_03:GA-03","MC_GB18_L2_03:GA-10","MC_GB18_L1_09:XD-04","MC_GB18_L1_10:XD-04","MC_GB18_L1_11:XD-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-03","text":"Widerspruch erzeugt eine gestufte Eskalation: Er bringt Reflexion hervor, verdichtet Reflexionsbestimmungen zum Grund und transformiert den unzureichenden Grund schließlich in negative Unbedingtheit.","refs":["MC_GB18_L2_03:GA-02","MC_GB18_L2_03:GA-07","MC_GB18_L2_03:GA-08","MC_GB18_L2_03:GA-11","MC_GB18_L1_09:XD-02","MC_GB18_L1_10:GA-06","MC_GB18_L1_11:XD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-04","text":"Äußerlichkeit ist zugleich notwendige Sichtbarkeitsform immanenter Differenz und Defekt jeder Erklärung, die diese Sichtbarkeit als unerzeugte Kopplung stehen lässt.","refs":["MC_GB18_L2_03:GA-04","MC_GB18_L2_03:GA-09","MC_GB18_L1_09:DBN-04","MC_GB18_L1_10:XD-06","MC_GB18_L1_11:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-05","text":"Zureichende Erklärung muss Identität und erklärende Differenz zusammen erzeugen; reine Inhaltsgleichheit wird tautologisch, unerzeugter Zusatzinhalt äußerlich.","refs":["MC_GB18_L2_03:GA-01","MC_GB18_L2_03:GA-08","MC_GB18_L2_03:GA-09","MC_GB18_L1_11:AS-03","MC_GB18_L1_11:GA-06","MC_GB18_L1_11:XD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-06","text":"Die Aufhebung des äußeren Beobachters verwandelt das Subjekt in eine doppelte Funktionsstelle: Es vollzieht immanente Vermittlung und stabilisiert zugleich selektive Grundordnungen.","refs":["MC_GB18_L2_03:GA-09","MC_GB18_L2_03:GA-13","MC_GB18_L1_09:BSD-05","MC_GB18_L1_10:XD-05","MC_GB18_L1_11:BSD-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-07","text":"Das absolut Unbedingte und die positive Einheit des Begriffs dürfen nicht identifiziert werden: Negative Schließung beendet den Regress, realisiert aber noch keine positive Zureichendheit.","refs":["MC_GB18_L2_03:GA-11","MC_GB18_L2_03:GA-12","MC_GB18_L1_11:AS-08","MC_GB18_L1_11:XD-07","MC_GB18_L1_11:BSD-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-08","text":"Kategoriale Stabilität ist metastabil: Eine Bestimmung besteht nur, indem sie die Vermittlung internalisiert, die ihre isolierte Gestalt zugleich auflöst.","refs":["MC_GB18_L2_03:GA-02","MC_GB18_L2_03:GA-05","MC_GB18_L2_03:GA-07","MC_GB18_L1_09:GA-09","MC_GB18_L1_10:GA-10","MC_GB18_L1_11:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L2_03:BSD-01","text":"Realität wird zur reflexiven Maschine, deren Einheiten, Unterschiede und Grundlagen erst aus den Relationen hervorgehen, die sie scheinbar voraussetzen.","refs":["MC_GB18_L1_09:BSD-01","MC_GB18_L1_10:BSD-01","MC_GB18_L1_11:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-02","text":"Zeit ist eine retrospektive Spirale, in der Resultate ihre Voraussetzungen erzeugen, erhalten und umcodieren.","refs":["MC_GB18_L1_09:BSD-03","MC_GB18_L1_10:BSD-02","MC_GB18_L1_11:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-03","text":"Kausalität verliert den Status äußerer Einwirkung; lokale Ursachen bleiben wirksam, werden aber der immanenten Einheit ihrer konkreten Verknüpfung untergeordnet.","refs":["MC_GB18_L1_09:BSD-02","MC_GB18_L1_11:BSD-04","MC_GB18_L1_11:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-04","text":"Erkenntnis und Erklärung werden zur Rekonstruktion der Operationen, durch welche Inhalt, Differenz und Zusammenhang gemeinsam hervorgebracht werden.","refs":["MC_GB18_L1_09:BSD-04","MC_GB18_L1_10:GA-09","MC_GB18_L1_11:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-05","text":"Das Subjekt ist weder Ursprung noch Außeninstanz, sondern ein Knoten von Reflexionsvollzug, Vergleich und selektiver Grundpraxis.","refs":["MC_GB18_L1_09:BSD-05","MC_GB18_L1_10:BSD-03","MC_GB18_L1_11:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-06","text":"Politische und institutionelle Autorität wird als sedimentierte Grundverteilung lesbar, deren Anerkennung keine immanente Notwendigkeit garantiert.","refs":["MC_GB18_L1_10:BSD-05","MC_GB18_L1_11:BSD-06","MC_GB18_L1_11:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-07","text":"Handlungsmacht besteht im Eingriff in die Operationen, die Gegensätze, Prioritäten und Grundrollen erzeugen, nicht in der Wahl eines bereits fixierten Pols.","refs":["MC_GB18_L1_09:HSI-04","MC_GB18_L1_10:HSI-04","MC_GB18_L1_11:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-08","text":"Geschichte kann keinen unvermittelten Ursprung besitzen; jeder Anfang wird zum rückwirkend bestimmten Moment einer transformierenden Übergangsbewegung.","refs":["MC_GB18_L1_09:MME-05","MC_GB18_L1_10:ALT-B04","MC_GB18_L1_11:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L2_03:RLE-01","text":"Die Hauptschleife lautet: gesetzte Unmittelbarkeit erzeugt Negativität, Negativität Bestimmtheit, Bestimmtheit ihr Anderes, der Widerspruch den Grund und der Grund erneut vermittelte Unmittelbarkeit.","refs":["MC_GB18_L1_09:RLE-03","MC_GB18_L1_10:RLE-01","MC_GB18_L1_11:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-02","text":"Die Ausschlussschleife setzt das Abgewiesene als eigene Bedingung, nimmt es als Gegenüber zurück und reproduziert den Unterschied innerhalb der erreichten Einheit.","refs":["MC_GB18_L1_09:RLE-04","MC_GB18_L1_10:RLE-04","MC_GB18_L1_11:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-03","text":"Negativität eskaliert von Selbstunverträglichkeit über widersprüchliche Opposition zur negativen Identität, die den Widerspruch nicht tilgt, sondern als innere Bewegung erhält.","refs":["MC_GB18_L1_09:RLE-02","MC_GB18_L1_10:RLE-01","MC_GB18_L1_11:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-04","text":"Der Pfad der Äußerlichkeit führt von quantifizierter Differenz über Vergleich und Opposition zur realen Grundzuteilung und endet im Regress konkurrierender Rechtfertigungen.","refs":["MC_GB18_L1_09:RMD-02","MC_GB18_L1_10:RLE-02","MC_GB18_L1_11:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-05","text":"Grund ist ein vorläufiger Attraktor: Er sammelt die Reflexionsbestimmungen zur Einheit, wird aber durch seinen eigenen Erklärungsanspruch zur negativen Unbedingtheit weitergetrieben.","refs":["MC_GB18_L1_10:RLE-03","MC_GB18_L1_11:RMD-03","MC_GB18_L1_11:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-06","text":"Zureichende Einheit ist der offene Attraktor, der jede formale, mechanische oder partielle Schließung destabilisiert und auf Begriff und Zweck verweist.","refs":["MC_GB18_L1_11:GA-10","MC_GB18_L1_11:RLE-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-07","text":"Jeder Versuch, einen Vermittlungsdefekt durch einen äußeren Zusatz zu beheben, reproduziert denselben Defekt auf höherer Ebene und erzwingt eine Mutation der Relationsform.","refs":["MC_GB18_L1_09:RLE-01","MC_GB18_L1_10:RLE-04","MC_GB18_L1_11:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L2_03:FGS-B01","text":"Vorausgesetzte Unmittelbarkeit + äußere Bestimmung → fehlender qualitativer Übergang → Zusammenbruch des passiven Erklärungsmodells.","refs":["MC_GB18_L1_09:BAS-02","MC_GB18_L1_09:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B02","text":"Erklärungsausfall + Selbstwiderspruch der vorausgesetzten Einheit → negative Totalität → Reflexion als immanente Bewegungsform.","refs":["MC_GB18_L1_09:XD-02","MC_GB18_L1_10:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B03","text":"Reflexion + Einheit von Setzen und Voraussetzen → erzeugte Unmittelbarkeit → rückwirkende Konstitution des Anfangs.","refs":["MC_GB18_L1_09:BAS-06","MC_GB18_L1_09:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B04","text":"Negative Selbstbeziehung → Identität und Unterschied → externalisierte Verschiedenheit → Vergleich → innere Opposition.","refs":["MC_GB18_L1_10:RMD-01","MC_GB18_L1_10:RMD-02","MC_GB18_L1_10:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B05","text":"Ausschluss des Anderen → Setzung des Ausgeschlossenen → Selbstwiderspruch → Grund als rückwirkende Einheit erhaltener Negativität.","refs":["MC_GB18_L1_10:RLE-04","MC_GB18_L1_10:GA-06","MC_GB18_L1_10:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B06","text":"Grund + formale Inhaltsidentität → reversible Rollen → geschlossene Tautologie ohne erklärende Differenz.","refs":["MC_GB18_L1_11:RMD-07","MC_GB18_L1_11:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B07","text":"Flucht in reale Inhaltsdifferenz → unerzeugter Zusatzinhalt → partielle Grundlagen → konkurrierende Gründe und unendliches Raisonnement.","refs":["MC_GB18_L1_11:AS-07","MC_GB18_L1_11:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B08","text":"Regress der Gründe und Bedingungen → wechselseitige Voraussetzung → Internalisierung der Bedingung → absolut Unbedingtes als negative Identität.","refs":["MC_GB18_L1_11:RLE-04","MC_GB18_L1_11:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B09","text":"Negative Schließung des Regresses → fortbestehende Forderung nach positiver Zureichendheit → Begriff und Zweck als offene Fortbestimmung.","refs":["MC_GB18_L1_11:GA-11","MC_GB18_L1_11:GA-10","MC_GB18_L1_11:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L2_03:AFM-B01","text":"Vorausgesetzte Einheit → äußerliche Bestimmung → Erklärungsausfall → negative Selbstbeziehung → Reflexion → Identität und Unterschied → Opposition → Widerspruch → Grund → Krise der Begründung → Bedingung → absolut Unbedingtes → offene Begriffsforderung.","refs":["MC_GB18_L1_10:BAS-03","MC_GB18_L1_11:AS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AFM-B02","text":"Äußere Erklärung → immanente Rekonstruktion → kategoriale Selbstdifferenzierung → Grund als rückwirkende Einheit.","refs":["MC_GB18_L1_09:XD-01","MC_GB18_L1_10:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AFM-B03","text":"Grund → formale Geschlossenheit → Tautologie → reale Differenz → partielle Grundlage → konkurrierende Grundzuteilung → Regress.","refs":["MC_GB18_L1_11:AS-07","MC_GB18_L1_11:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AFM-B04","text":"Regress → reziproke Grund-Bedingungs-Relation → Internalisierung der Voraussetzung → negative Identität des Unbedingten.","refs":["MC_GB18_L1_11:RLE-04","MC_GB18_L1_11:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AFM-B05","text":"Negative Schließung → fehlende positive Zureichendheit → Begriff und Zweck als nicht realisierte Anschlussbewegung.","refs":["MC_GB18_L1_11:GA-10","MC_GB18_L1_11:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L2_03:MME-01","text":"Einheit und Identität werden von ursprünglichen Beständen zu Operationen negativer Selbstvermittlung umkartiert.","refs":["MC_GB18_L1_09:MME-01","MC_GB18_L1_10:MME-01","MC_GB18_L1_11:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-02","text":"Äußerlichkeit wird in notwendige Exposition und defizitäre unerzeugte Verknüpfung differenziert; dadurch kollabiert der Gegensatz von reiner Immanenz und bloßem Außen.","refs":["MC_GB18_L1_10:BAS-05","MC_GB18_L1_11:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-03","text":"Widerspruch wird von der Grenze zulässiger Bestimmung zur produktiven Regel kategorialer Transformation reklassifiziert.","refs":["MC_GB18_L1_10:MME-03","MC_GB18_L1_11:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-04","text":"Grund wird vom vorausgesetzten Fundament zur erzeugten, prüfbaren und selbstbedingenden Vermittlungsoperation umgezeichnet.","refs":["MC_GB18_L1_10:MME-05","MC_GB18_L1_11:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-05","text":"Zureichendheit wird von formaler Geschlossenheit, Kausalüberschuss und Grundakkumulation auf die immanente Erzeugung konkreter Differenz und Verknüpfung umgestellt.","refs":["MC_GB18_L1_11:GA-12","MC_GB18_L1_11:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-06","text":"Die Gegenüberstellung von Gegenstand und Subjekt wird durch eine verteilte Reflexionsarchitektur ersetzt, in der beide als Funktionsstellen derselben Vermittlung auftreten.","refs":["MC_GB18_L1_09:MME-04","MC_GB18_L1_10:BSD-03","MC_GB18_L1_11:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-07","text":"Anfang, Priorität und Schließung werden temporal umkartiert: Das Frühere ist rückwirkend erzeugt, das Terminale negativ und die positive Vollendung offen.","refs":["MC_GB18_L1_09:MME-05","MC_GB18_L1_10:BSD-02","MC_GB18_L1_11:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-08","text":"Kategorien müssen als mutierende Operationen gelesen werden; eine bloße Inventarisierung stabiler Begriffe verfehlt die generative Architektur.","refs":["MC_GB18_L1_10:BSD-06","MC_GB18_L1_11:MME-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L2_03:ALT-B01","text":"Surface level — Indifferenz, Unmittelbarkeit, Identität, Unterschied, Opposition, Widerspruch, Grund, Form, Inhalt, Bedingung und Unbedingtes sind die sichtbaren Stationen einer einzigen Transformationslogik.","refs":["MC_GB18_L1_09:ALT-B01","MC_GB18_L1_10:ALT-B01","MC_GB18_L1_11:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:ALT-B02","text":"Structural level — Negativität, Setzen, Voraussetzen, Ausschluss, Aufhebung und Rückkehr bilden die rekursive Maschine, die Selbständigkeit erzeugt und wieder internalisiert.","refs":["MC_GB18_L1_09:ALT-B02","MC_GB18_L1_10:ALT-B02","MC_GB18_L1_11:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:ALT-B03","text":"Metastrategic level — Erklärung, Interpretation und Intervention werden von der Auswahl fertiger Gründe auf die Rekonstruktion ihrer erzeugenden Verteilungen und Übergänge umgestellt.","refs":["MC_GB18_L1_09:ALT-B03","MC_GB18_L1_10:ALT-B03","MC_GB18_L1_11:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:ALT-B04","text":"Ontological / Temporal level — Realität besitzt keinen unvermittelten Ursprung; ihre Einheiten bestehen in einer rückwirkenden Zeit negativer Selbstdifferenzierung.","refs":["MC_GB18_L1_09:ALT-B04","MC_GB18_L1_10:ALT-B04","MC_GB18_L1_11:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie jede fixierte Kategorie durch deren eigenen Anspruch destabilisiert und mutiert zurückkehren lässt.","refs":["MC_GB18_L1_09:ALT-B05","MC_GB18_L1_10:ALT-B05","MC_GB18_L1_11:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L2_03:FL-01","text":"Äußerlichkeit muss überwunden werden und zugleich fortbestehen: Ohne sie fehlt die Exposition der Differenz, mit ihr droht unerzeugte Verknüpfung.","refs":["MC_GB18_L1_09:FL-02","MC_GB18_L1_10:FL-02","MC_GB18_L1_11:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-02","text":"Die Erklärung verlangt Identität zwischen Grund und Begründetem, erzeugt damit aber Tautologie; sie verlangt Differenz, erzeugt damit aber Äußerlichkeit.","refs":["MC_GB18_L1_11:AS-03","MC_GB18_L1_11:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-03","text":"Das absolut Unbedingte beansprucht terminale Schließung, während Begriff und Zweck als positive Vollendungsformen ausdrücklich offenbleiben.","refs":["MC_GB18_L1_11:AS-08","MC_GB18_L1_11:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-04","text":"Die Kritik äußerer Grundzuteilung benötigt ein Kriterium legitimer Vermittlung, kann dieses aber innerhalb der noch unentwickelten positiven Begriffseinheit nicht vollständig ausweisen.","refs":["MC_GB18_L1_11:FL-04","MC_GB18_L1_11:MRT-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-05","text":"Der Übergang von logischen Satz-, Vergleichs- und Ausschlussformen zu ontologischer Reflexionsstruktur bleibt komprimiert und nicht vollständig vermittelt.","refs":["MC_GB18_L1_10:FL-01","MC_GB18_L1_10:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-06","text":"Die negative Rekonstruktion äußerer Gegebenheit ist stärker entwickelt als die positive Genesis konkreter mannigfaltiger Inhalte.","refs":["MC_GB18_L1_09:FL-01","MC_GB18_L1_11:MRT-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-07","text":"Bestimmungen müssen zugleich selbständig genug sein, um Übergänge zu tragen, und vollständig vermittelt genug, um keine relationsexterne Existenz zu besitzen.","refs":["MC_GB18_L1_09:FL-03","MC_GB18_L1_10:FL-04","MC_GB18_L1_11:FL-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:MP-01","text":"Der erste Mutationspunkt verwandelt den Widerspruch der Indifferenz von einem Defekt passiver Einheit in produktive Reflexion.","refs":["MC_GB18_L1_09:MP-01","MC_GB18_L1_09:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:MP-02","text":"Der zweite Mutationskomplex führt Identität vom Ganzen der Reflexion zum differenzierten Moment und Unterschied von äußerer Verschiedenheit zur inneren Opposition.","refs":["MC_GB18_L1_10:MP-01","MC_GB18_L1_10:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:MP-03","text":"Grund mutiert vom erwarteten Fundament über die rückwirkende Einheit der Reflexionsbestimmungen zur Operation, die ihre eigene Bedingtheit hervorbringt.","refs":["MC_GB18_L1_09:RMD-07","MC_GB18_L1_11:GA-04","MC_GB18_L1_11:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:MP-04","text":"Unmittelbarkeit mutiert vom ontologischen Anfang zum gesetzten Material, zur erzeugten Voraussetzung und zum Resultat der Rückkehr.","refs":["MC_GB18_L1_09:MP-03","MC_GB18_L1_11:RMD-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:MP-05","text":"Das Unbedingte mutiert von relativer Selbständigkeit zur negativen Identität, die Bedingtheit als eigenen Selbstunterschied erhält.","refs":["MC_GB18_L1_11:MP-03","MC_GB18_L1_11:RLE-06"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L2_03:HSI-01","text":"Realität erscheint als reflexive Maschine, die keine äußeren Fundamente verarbeitet, sondern Einheiten, Gegenüber, Gründe und Bedingungen intern erzeugt und zurücknimmt.","refs":["MC_GB18_L1_09:HSI-01","MC_GB18_L1_10:HSI-01","MC_GB18_L1_11:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:HSI-02","text":"Das Subjekt ist ein nicht-souveräner Knoten, an dem Reflexionsvollzug, Vergleich, Grundauswahl und spekulative Vermittlung zusammentreffen.","refs":["MC_GB18_L1_09:HSI-02","MC_GB18_L1_10:HSI-02","MC_GB18_L1_11:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:HSI-03","text":"Zeit ist eine Spirale rückwirkender Setzung, in der Voraussetzungen früher erscheinen, aber erst durch spätere Vermittlung konstituiert werden.","refs":["MC_GB18_L1_09:HSI-03","MC_GB18_L1_10:HSI-03","MC_GB18_L1_11:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:HSI-04","text":"Navigation bleibt als Eingriff in die Mutationen möglich, durch die Gegensätze, Gründe und Bedingungen erzeugt werden; eine Flucht in einen ersten Grund ist ausgeschlossen.","refs":["MC_GB18_L1_09:HSI-04","MC_GB18_L1_10:HSI-04","MC_GB18_L1_11:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L2_03:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von vorausgesetzter Unmittelbarkeit über Reflexion, Widerspruch und Grund bis zur negativen Unbedingtheit zu rekonstruieren.","refs":["MC_GB18_L1_09:MRT-B01","MC_GB18_L1_10:MRT-B01","MC_GB18_L1_11:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MRT-B02","text":"Die Rekonstruktion ist kohärent, sofern negative Identität nicht als unterschiedslose Gleichheit, Voraussetzung nicht als zeitliches Vorher und Äußerlichkeit nicht als einheitliche Kategorie gelesen wird.","refs":["MC_GB18_L1_09:MRT-B03","MC_GB18_L1_10:MRT-B03","MC_GB18_L1_11:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MRT-B03","text":"Die stärkste Architektur liegt in der rekursiven Verbindung von Widerspruch, rückwirkender Voraussetzung, Grundkritik und Internalisierung der Bedingung.","refs":["MC_GB18_L1_11:MRT-B03","MC_GB18_L1_09:MRT-B04","MC_GB18_L1_10:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MRT-B04","text":"Unterbestimmt bleiben die positive Genesis konkreter Inhalte, die notwendige Vermittlung von logischer Form und Ontologie sowie die positive Gestalt von Begriff und Zweck.","refs":["MC_GB18_L1_09:MRT-B02","MC_GB18_L1_10:MRT-B02","MC_GB18_L1_11:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MRT-B05","text":"Die wirkliche Bewegung bleibt nur erhalten, wenn formale Geschlossenheit, reale Äußerlichkeit, negative Schließung und offene Begriffsforderung unterschieden werden und der Vollzug mutierender Ausschlüsse nicht auf statische Axiome reduziert wird.","refs":["MC_GB18_L1_11:MRT-B05","MC_GB18_L1_11:MRT-B06","MC_GB18_L1_10:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T124354971934Z_d4a8cbc4","language_code":"en","language_name":"English","title":"Gb18 L2 03","source_sha256":"58b8672de0a4c9c429500542edf505969282c84083a96023a29863bcb657cd19","sha256":"d2f674bd9874320fda664524f51e1d5b352f1102ead5a7c873d1d91920ae06ea","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:43:54.972916+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L2_03:AS-01","text":"The system addresses the problem of how unity, determinacy, and ground can arise without an original substrate, relation-external identity, or antecedent bearer of explanation.","refs":["MC_GB18_L1_09:BAS-01","MC_GB18_L1_10:BAS-01","MC_GB18_L1_11:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-02","text":"Immediacy, identity, and ground are redetermined as retroactively generated functions of a negative self-mediation.","refs":["MC_GB18_L1_09:BAS-06","MC_GB18_L1_10:GA-08","MC_GB18_L1_11:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-03","text":"External quantification, formal comparison, and the allocation of individual grounds form successive stress tests for the immanent generation of qualitative connection.","refs":["MC_GB18_L1_09:BAS-03","MC_GB18_L1_10:BAS-04","MC_GB18_L1_11:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-04","text":"Every fixed determination generates the other excluded by it and thereby demonstrates its independence to be a function of a more comprehensive relation.","refs":["MC_GB18_L1_09:GA-05","MC_GB18_L1_10:GA-03","MC_GB18_L1_11:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-05","text":"Contradiction functions as a cross-scale transition operator: it transforms indifference into reflection, opposition into ground, and the crisis of ground into the movement of the unconditioned.","refs":["MC_GB18_L1_09:BAS-04","MC_GB18_L1_10:GA-06","MC_GB18_L1_11:XD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-06","text":"The movement proceeds from the generation of reflection through its determinations to the form of ground, and then to the examination, crisis, and transformation of explanation itself.","refs":["MC_GB18_L1_09:BAS-07","MC_GB18_L1_10:BAS-03","MC_GB18_L1_11:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-07","text":"The argument proceeds recursively, spirally, and retrospectively, because every result resets its point of departure as its own presupposition.","refs":["MC_GB18_L1_09:BAS-08","MC_GB18_L1_10:BAS-08","MC_GB18_L1_11:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AS-08","text":"The closure remains asymmetrical: the absolutely unconditioned terminates the regress of the ground-condition relation, while concept and purpose are absent as the positive form of sufficient unity.","refs":["MC_GB18_L1_11:AS-08","MC_GB18_L1_11:GA-11","MC_GB18_L1_11:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L2_03:GA-01","text":"[Persistent] Concrete unity exists only as the negative self-mediation of a difference that is neither effaced nor rendered independent.","refs":["MC_GB18_L1_09:GA-01","MC_GB18_L1_11:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-02","text":"[Persistent] Negativity is not an external negation, but the immanent self-relation through which determinacy is generated and maintained.","refs":["MC_GB18_L1_09:GA-04","MC_GB18_L1_10:GA-01","MC_GB18_L1_11:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-03","text":"[Mutating] Immediacy mutates from the apparent beginning into the posited remainder, the generated presupposition, and finally the retroactive result of mediation.","refs":["MC_GB18_L1_09:GA-02","MC_GB18_L1_11:GA-01","MC_GB18_L1_11:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-04","text":"[Mutating] Externality mutates from the defect of external determination into the necessary form of exposition of immanent difference, and again into a defect as soon as its connection remains ungenerated.","refs":["MC_GB18_L1_10:BAS-05","MC_GB18_L1_11:GA-08","MC_GB18_L1_11:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-05","text":"[Persistent] No moment possesses relation-external independence; its determinacy arises exclusively within the movement that posits, differentiates, and withdraws it.","refs":["MC_GB18_L1_10:GA-03","MC_GB18_L1_11:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-06","text":"[Mutating] Identity mutates from presupposed indifference and abstract self-sameness into the negative unity that brings forth its own difference.","refs":["MC_GB18_L1_09:RMD-01","MC_GB18_L1_10:GA-02","MC_GB18_L1_11:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-07","text":"[Attractor] Contradiction is the recurrent transition operator through which isolated determinations lose their independence and pass into more comprehensive forms of mediation.","refs":["MC_GB18_L1_09:BAS-04","MC_GB18_L1_10:GA-06","MC_GB18_L1_11:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-08","text":"[Mutating] Ground mutates from the result of determining reflection into the retroactive unity of its determinations and finally into the operation that itself posits its condition.","refs":["MC_GB18_L1_09:GA-08","MC_GB18_L1_10:GA-08","MC_GB18_L1_11:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-09","text":"[Emergent] Sufficient explanation must generate identity, difference, and concrete connection from the same movement, rather than presupposing them through designation, comparison, or addition.","refs":["MC_GB18_L1_09:GA-11","MC_GB18_L1_11:GA-06","MC_GB18_L1_11:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-10","text":"[Attractor] Positing and presupposing form a retrospective loop in which the supposedly earlier first receives its status as presupposition through the return of mediation.","refs":["MC_GB18_L1_09:GA-07","MC_GB18_L1_11:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-11","text":"[Terminal] The absolutely unconditioned closes the regress of conditions as negative identity, without thereby completing the positive overall form of the system.","refs":["MC_GB18_L1_11:GA-11","MC_GB18_L1_11:CGD-06","MC_GB18_L1_11:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-12","text":"[Attractor] Concept and purpose operate as open attractors of a positive sufficiency that is required within the form of ground but cannot be realized there.","refs":["MC_GB18_L1_11:GA-10","MC_GB18_L1_11:BSA-04","MC_GB18_L1_11:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:GA-13","text":"[Persistent] Cognition and explanation are possible only as immanent reconstruction of the generating operations; an external standpoint of observation or grounding is excluded.","refs":["MC_GB18_L1_09:BSD-04","MC_GB18_L1_10:GA-09","MC_GB18_L1_11:DBN-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L2_03:RMD-01","text":"Indifference disappears as an independent category after its contradiction has transformed passive unity into negative totality and reflection.","refs":["MC_GB18_L1_09:RMD-01","MC_GB18_L1_09:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-02","text":"Immediacy remains terminologically persistent, but shifts from beginning through presupposition and material of mediation to the retroactively generated result.","refs":["MC_GB18_L1_09:RMD-04","MC_GB18_L1_11:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-03","text":"Negativity escalates from destructive self-incompatibility through productive self-differentiation to the terminal form of negative identity.","refs":["MC_GB18_L1_09:RMD-03","MC_GB18_L1_10:RMD-03","MC_GB18_L1_11:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-04","text":"Identity migrates from presupposed unity through self-differentiating reflection to the negative unity of the entire ground-condition movement.","refs":["MC_GB18_L1_09:MME-01","MC_GB18_L1_10:RMD-01","MC_GB18_L1_11:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-05","text":"Difference shifts from quantitatively or externally fixed diversity through inner opposition to the necessary residual difference within mediated unity.","refs":["MC_GB18_L1_09:RMD-02","MC_GB18_L1_10:RMD-02","MC_GB18_L1_11:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-06","text":"External reflection is initially internalized, remains productive as a phase of exposition, and returns in real grounding as a problematic ungenerated coupling.","refs":["MC_GB18_L1_10:RMD-04","MC_GB18_L1_10:XD-06","MC_GB18_L1_11:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-07","text":"Contradiction mutates from the crisis of presupposed unity into the categorical transition operator and is finally absorbed into the negative identity of the movement of ground.","refs":["MC_GB18_L1_10:RMD-07","MC_GB18_L1_11:RMD-02","MC_GB18_L1_11:XD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-08","text":"Ground shifts from the expected foundation to the generated unity of reflection, is then tested as formal and real explanation, and ends as a self-conditioning operation.","refs":["MC_GB18_L1_09:RMD-07","MC_GB18_L1_10:GA-08","MC_GB18_L1_11:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RMD-09","text":"The third mutates from an excluded supplement into the immanent unity of opposition, then into ground, and finally into the open difference between negative closure and positive conceptual unity.","refs":["MC_GB18_L1_10:RMD-06","MC_GB18_L1_10:MP-04","MC_GB18_L1_11:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L2_03:CGD-01","text":"Analysis of forces, reflective judgment, measure, and the relation of factors remain local diagnostic forms; only their demonstration of the failure of external transition-explanation scales upward.","refs":["MC_GB18_L1_09:CGD-01","MC_GB18_L1_09:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-02","text":"Analyses of propositions, signs, zero-determinations, and forms of comparison remain local means of exposition for the self-sublation of external reflection.","refs":["MC_GB18_L1_10:CGD-01","MC_GB18_L1_10:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-03","text":"Forces, matters, movement, vitality, and scientific hypotheses remain local cases of the more general difference between designation, partial causality, and immanent explanation.","refs":["MC_GB18_L1_11:CGD-01","MC_GB18_L1_11:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-04","text":"What scales to the current level is the diagnosis that every externally fixed relation presupposes the qualitative transition that it is meant to explain.","refs":["MC_GB18_L1_09:GA-03","MC_GB18_L1_10:CGD-02","MC_GB18_L1_11:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-05","text":"The local contradictions scale into a global rule of transformation according to which every independent determination must internalize its relation and return as a more comprehensive unity.","refs":["MC_GB18_L1_09:CGD-03","MC_GB18_L1_10:CGD-04","MC_GB18_L1_11:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-06","text":"The ground terminal at the lower level becomes, at the current level, the point of departure for a renewed examination and thereby loses its status as definitive closure.","refs":["MC_GB18_L1_10:CGD-05","MC_GB18_L1_11:CGD-04","MC_GB18_L1_11:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:CGD-07","text":"Existence, appearance, concept, and purpose do not scale as positively developed contents, but as structures of continuation and limit of still incomplete mediation.","refs":["MC_GB18_L1_09:CGD-04","MC_GB18_L1_11:CGD-05","MC_GB18_L1_11:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L2_03:GNX-01","text":"Excluded is every passive substrate or immediate being that is supposed to bear determinations prior to their mediation.","refs":["MC_GB18_L1_09:GNX-01","MC_GB18_L1_11:GNX-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-02","text":"Excluded are independent terms whose relation is established only subsequently through quantitative, logical, or causal connection.","refs":["MC_GB18_L1_09:GNX-02","MC_GB18_L1_10:DBN-01","MC_GB18_L1_11:GNX-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-03","text":"Excluded is an external standpoint of cognition, comparison, or grounding that fixes the relation without itself being determined by it.","refs":["MC_GB18_L1_09:GNX-03","MC_GB18_L1_10:GNX-02","MC_GB18_L1_11:DBN-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-04","text":"Excluded is a logic that treats contradiction as a mere disturbance and thereby removes the transition operator of mediation.","refs":["MC_GB18_L1_10:GNX-03","MC_GB18_L1_11:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-05","text":"Excluded are original self-sameness, an absolutely first positive, and a unity without self-division.","refs":["MC_GB18_L1_09:BSA-02","MC_GB18_L1_10:GNX-04","MC_GB18_L1_11:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-06","text":"Excluded is the equation of explanation with renaming, addition, acknowledged essentiality, or institutionally stabilized allocation of grounds.","refs":["MC_GB18_L1_11:GNX-06","MC_GB18_L1_11:DBN-05","MC_GB18_L1_11:BSD-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:GNX-07","text":"Excluded are linear orders of ground and causality, as well as a resting unconditioned that ends the negative movement from outside.","refs":["MC_GB18_L1_09:GNX-05","MC_GB18_L1_11:GNX-05","MC_GB18_L1_11:GNX-07"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L2_03:DBN-01","text":"For the system to hold, pure self-presence must be false: no unity may already be fully determined before its negation.","refs":["MC_GB18_L1_10:BSA-01","MC_GB18_L1_11:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:DBN-02","text":"Difference may neither be completely effaced nor rendered independent as an ontologically independent outside.","refs":["MC_GB18_L1_09:DBN-04","MC_GB18_L1_11:GA-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:DBN-03","text":"Externality must not be absolute, but neither can it disappear, because its necessary function of exposition must be distinguished from its deficient ungenerated form.","refs":["MC_GB18_L1_10:XD-06","MC_GB18_L1_11:XD-03","MC_GB18_L1_11:FL-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:DBN-04","text":"Formal closure, symbolic operation, and the multiplication of plausible grounds must not count as sufficient explanation.","refs":["MC_GB18_L1_10:DBN-03","MC_GB18_L1_11:DBN-05","MC_GB18_L1_11:XD-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:DBN-05","text":"A neutral third must not mediate opposition from outside, because its own determinacy would otherwise remain unexplained.","refs":["MC_GB18_L1_10:DBN-04","MC_GB18_L1_11:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:DBN-06","text":"The unconditioned may appear neither as a positive beyond nor concept as an additional individual ground, without reproducing the superseded form of ground.","refs":["MC_GB18_L1_11:GNX-07","MC_GB18_L1_11:XD-07"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L2_03:BSA-01","text":"The deepest excluded possibility is an unmediated outside that could provide reflection with material, ground, or unity.","refs":["MC_GB18_L1_09:BSA-01","MC_GB18_L1_10:BSA-02","MC_GB18_L1_11:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:BSA-02","text":"Unavailable are original self-presence and an absolute beginning whose priority is not itself first generated through return.","refs":["MC_GB18_L1_09:BSA-02","MC_GB18_L1_10:BSA-01","MC_GB18_L1_11:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:BSA-03","text":"Unavailable is a neutral endpoint at which negativity, mediation, and the renewed positing of presuppositions are definitively extinguished.","refs":["MC_GB18_L1_10:BSA-03","MC_GB18_L1_11:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L2_03:BSA-04","text":"The structuring absence of the system is the positive shape of immanent sufficiency, required as concept and purpose but not presented.","refs":["MC_GB18_L1_11:BSA-04","MC_GB18_L1_11:GA-10","MC_GB18_L1_11:MRT-B04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L2_03:XD-01","text":"The failure of quantitative factors, formal laws of thought, and institutionalized claims to ground proves to be a single structural defect: relation is used without reconstructing its qualitative generation.","refs":["MC_GB18_L2_03:GA-04","MC_GB18_L2_03:GA-09","MC_GB18_L1_09:XD-01","MC_GB18_L1_10:XD-02","MC_GB18_L1_11:XD-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-02","text":"Because immediacy is generated and ground is retroactively posited, logical priority is not temporal precedence, but an effect of reconstructed return.","refs":["MC_GB18_L2_03:GA-03","MC_GB18_L2_03:GA-10","MC_GB18_L1_09:XD-04","MC_GB18_L1_10:XD-04","MC_GB18_L1_11:XD-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-03","text":"Contradiction generates a graded escalation: it brings forth reflection, condenses the determinations of reflection into ground, and finally transforms insufficient ground into negative unconditionedness.","refs":["MC_GB18_L2_03:GA-02","MC_GB18_L2_03:GA-07","MC_GB18_L2_03:GA-08","MC_GB18_L2_03:GA-11","MC_GB18_L1_09:XD-02","MC_GB18_L1_10:GA-06","MC_GB18_L1_11:XD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-04","text":"Externality is at once the necessary form of visibility of immanent difference and the defect of every explanation that leaves this visibility standing as an ungenerated coupling.","refs":["MC_GB18_L2_03:GA-04","MC_GB18_L2_03:GA-09","MC_GB18_L1_09:DBN-04","MC_GB18_L1_10:XD-06","MC_GB18_L1_11:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-05","text":"Sufficient explanation must generate identity and explanatory difference together; mere identity of content becomes tautological, ungenerated additional content external.","refs":["MC_GB18_L2_03:GA-01","MC_GB18_L2_03:GA-08","MC_GB18_L2_03:GA-09","MC_GB18_L1_11:AS-03","MC_GB18_L1_11:GA-06","MC_GB18_L1_11:XD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-06","text":"The sublation of the external observer transforms the subject into a double functional position: it performs immanent mediation and simultaneously stabilizes selective orders of ground.","refs":["MC_GB18_L2_03:GA-09","MC_GB18_L2_03:GA-13","MC_GB18_L1_09:BSD-05","MC_GB18_L1_10:XD-05","MC_GB18_L1_11:BSD-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-07","text":"The absolutely unconditioned and the positive unity of concept must not be identified: negative closure ends the regress, but does not yet realize positive sufficiency.","refs":["MC_GB18_L2_03:GA-11","MC_GB18_L2_03:GA-12","MC_GB18_L1_11:AS-08","MC_GB18_L1_11:XD-07","MC_GB18_L1_11:BSD-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_03:XD-08","text":"Categorical stability is metastable: a determination persists only by internalizing the mediation that simultaneously dissolves its isolated shape.","refs":["MC_GB18_L2_03:GA-02","MC_GB18_L2_03:GA-05","MC_GB18_L2_03:GA-07","MC_GB18_L1_09:GA-09","MC_GB18_L1_10:GA-10","MC_GB18_L1_11:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L2_03:BSD-01","text":"Reality becomes a reflexive machine whose unities, differences, and foundations first emerge from the relations that they apparently presuppose.","refs":["MC_GB18_L1_09:BSD-01","MC_GB18_L1_10:BSD-01","MC_GB18_L1_11:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-02","text":"Time is a retrospective spiral in which results generate, preserve, and recode their presuppositions.","refs":["MC_GB18_L1_09:BSD-03","MC_GB18_L1_10:BSD-02","MC_GB18_L1_11:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-03","text":"Causality loses the status of external action; local causes remain effective, but are subordinated to the immanent unity of their concrete connection.","refs":["MC_GB18_L1_09:BSD-02","MC_GB18_L1_11:BSD-04","MC_GB18_L1_11:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-04","text":"Cognition and explanation become reconstruction of the operations through which content, difference, and connection are jointly produced.","refs":["MC_GB18_L1_09:BSD-04","MC_GB18_L1_10:GA-09","MC_GB18_L1_11:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-05","text":"The subject is neither origin nor external instance, but a node of the enactment of reflection, comparison, and selective practice of grounding.","refs":["MC_GB18_L1_09:BSD-05","MC_GB18_L1_10:BSD-03","MC_GB18_L1_11:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-06","text":"Political and institutional authority becomes legible as a sedimented distribution of grounds whose recognition guarantees no immanent necessity.","refs":["MC_GB18_L1_10:BSD-05","MC_GB18_L1_11:BSD-06","MC_GB18_L1_11:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-07","text":"Agency consists in intervening in the operations that generate oppositions, priorities, and roles of ground, not in choosing an already fixed pole.","refs":["MC_GB18_L1_09:HSI-04","MC_GB18_L1_10:HSI-04","MC_GB18_L1_11:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:BSD-08","text":"History cannot possess an unmediated origin; every beginning becomes a retroactively determined moment of a transformative movement of transition.","refs":["MC_GB18_L1_09:MME-05","MC_GB18_L1_10:ALT-B04","MC_GB18_L1_11:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L2_03:RLE-01","text":"The main loop is as follows: posited immediacy generates negativity, negativity determinacy, determinacy its other, contradiction ground, and ground mediated immediacy anew.","refs":["MC_GB18_L1_09:RLE-03","MC_GB18_L1_10:RLE-01","MC_GB18_L1_11:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-02","text":"The loop of exclusion posits what is rejected as its own condition, withdraws it as an opposite, and reproduces difference within the unity attained.","refs":["MC_GB18_L1_09:RLE-04","MC_GB18_L1_10:RLE-04","MC_GB18_L1_11:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-03","text":"Negativity escalates from self-incompatibility through contradictory opposition to negative identity, which does not efface contradiction but preserves it as inner movement.","refs":["MC_GB18_L1_09:RLE-02","MC_GB18_L1_10:RLE-01","MC_GB18_L1_11:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-04","text":"The path of externality leads from quantified difference through comparison and opposition to real allocation of ground and ends in the regress of competing justifications.","refs":["MC_GB18_L1_09:RMD-02","MC_GB18_L1_10:RLE-02","MC_GB18_L1_11:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-05","text":"Ground is a provisional attractor: it gathers the determinations of reflection into unity, but is driven onward by its own claim to explanation toward negative unconditionedness.","refs":["MC_GB18_L1_10:RLE-03","MC_GB18_L1_11:RMD-03","MC_GB18_L1_11:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-06","text":"Sufficient unity is the open attractor that destabilizes every formal, mechanical, or partial closure and refers to concept and purpose.","refs":["MC_GB18_L1_11:GA-10","MC_GB18_L1_11:RLE-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:RLE-07","text":"Every attempt to remedy a defect of mediation through an external addition reproduces the same defect at a higher level and compels a mutation of the form of relation.","refs":["MC_GB18_L1_09:RLE-01","MC_GB18_L1_10:RLE-04","MC_GB18_L1_11:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L2_03:FGS-B01","text":"Presupposed immediacy + external determination → absent qualitative transition → collapse of the passive model of explanation.","refs":["MC_GB18_L1_09:BAS-02","MC_GB18_L1_09:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B02","text":"Failure of explanation + self-contradiction of presupposed unity → negative totality → reflection as immanent form of movement.","refs":["MC_GB18_L1_09:XD-02","MC_GB18_L1_10:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B03","text":"Reflection + unity of positing and presupposing → generated immediacy → retroactive constitution of the beginning.","refs":["MC_GB18_L1_09:BAS-06","MC_GB18_L1_09:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B04","text":"Negative self-relation → identity and difference → externalized diversity → comparison → inner opposition.","refs":["MC_GB18_L1_10:RMD-01","MC_GB18_L1_10:RMD-02","MC_GB18_L1_10:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B05","text":"Exclusion of the other → positing of the excluded → self-contradiction → ground as retroactive unity of preserved negativity.","refs":["MC_GB18_L1_10:RLE-04","MC_GB18_L1_10:GA-06","MC_GB18_L1_10:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B06","text":"Ground + formal identity of content → reversible roles → closed tautology without explanatory difference.","refs":["MC_GB18_L1_11:RMD-07","MC_GB18_L1_11:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B07","text":"Flight into real difference of content → ungenerated additional content → partial foundations → competing grounds and infinite ratiocination.","refs":["MC_GB18_L1_11:AS-07","MC_GB18_L1_11:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B08","text":"Regress of grounds and conditions → reciprocal presupposition → internalization of condition → absolutely unconditioned as negative identity.","refs":["MC_GB18_L1_11:RLE-04","MC_GB18_L1_11:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:FGS-B09","text":"Negative closure of the regress → persisting demand for positive sufficiency → concept and purpose as open further determination.","refs":["MC_GB18_L1_11:GA-11","MC_GB18_L1_11:GA-10","MC_GB18_L1_11:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L2_03:AFM-B01","text":"Presupposed unity → external determination → failure of explanation → negative self-relation → reflection → identity and difference → opposition → contradiction → ground → crisis of grounding → condition → absolutely unconditioned → open demand for concept.","refs":["MC_GB18_L1_10:BAS-03","MC_GB18_L1_11:AS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AFM-B02","text":"External explanation → immanent reconstruction → categorical self-differentiation → ground as retroactive unity.","refs":["MC_GB18_L1_09:XD-01","MC_GB18_L1_10:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AFM-B03","text":"Ground → formal closure → tautology → real difference → partial foundation → competing allocation of grounds → regress.","refs":["MC_GB18_L1_11:AS-07","MC_GB18_L1_11:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AFM-B04","text":"Regress → reciprocal ground-condition relation → internalization of presupposition → negative identity of the unconditioned.","refs":["MC_GB18_L1_11:RLE-04","MC_GB18_L1_11:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:AFM-B05","text":"Negative closure → absent positive sufficiency → concept and purpose as unrealized movement of continuation.","refs":["MC_GB18_L1_11:GA-10","MC_GB18_L1_11:BSD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L2_03:MME-01","text":"Unity and identity are remapped from original stocks to operations of negative self-mediation.","refs":["MC_GB18_L1_09:MME-01","MC_GB18_L1_10:MME-01","MC_GB18_L1_11:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-02","text":"Externality is differentiated into necessary exposition and deficient ungenerated connection; thereby the opposition between pure immanence and mere outside collapses.","refs":["MC_GB18_L1_10:BAS-05","MC_GB18_L1_11:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-03","text":"Contradiction is reclassified from the limit of permissible determination into the productive rule of categorical transformation.","refs":["MC_GB18_L1_10:MME-03","MC_GB18_L1_11:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-04","text":"Ground is redrawn from presupposed foundation into a generated, examinable, and self-conditioning operation of mediation.","refs":["MC_GB18_L1_10:MME-05","MC_GB18_L1_11:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-05","text":"Sufficiency is shifted from formal closure, causal excess, and accumulation of grounds to the immanent generation of concrete difference and connection.","refs":["MC_GB18_L1_11:GA-12","MC_GB18_L1_11:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-06","text":"The opposition of object and subject is replaced by a distributed architecture of reflection in which both appear as functional positions of the same mediation.","refs":["MC_GB18_L1_09:MME-04","MC_GB18_L1_10:BSD-03","MC_GB18_L1_11:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-07","text":"Beginning, priority, and closure are temporally remapped: the earlier is retroactively generated, the terminal is negative, and positive completion remains open.","refs":["MC_GB18_L1_09:MME-05","MC_GB18_L1_10:BSD-02","MC_GB18_L1_11:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MME-08","text":"Categories must be read as mutating operations; a mere inventory of stable concepts misses the generative architecture.","refs":["MC_GB18_L1_10:BSD-06","MC_GB18_L1_11:MME-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L2_03:ALT-B01","text":"Surface level — Indifference, immediacy, identity, difference, opposition, contradiction, ground, form, content, condition, and the unconditioned are the visible stations of a single logic of transformation.","refs":["MC_GB18_L1_09:ALT-B01","MC_GB18_L1_10:ALT-B01","MC_GB18_L1_11:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:ALT-B02","text":"Structural level — Negativity, positing, presupposing, exclusion, sublation, and return form the recursive machine that generates independence and internalizes it again.","refs":["MC_GB18_L1_09:ALT-B02","MC_GB18_L1_10:ALT-B02","MC_GB18_L1_11:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:ALT-B03","text":"Metastrategic level — Explanation, interpretation, and intervention are shifted from selecting ready-made grounds to reconstructing their generating distributions and transitions.","refs":["MC_GB18_L1_09:ALT-B03","MC_GB18_L1_10:ALT-B03","MC_GB18_L1_11:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:ALT-B04","text":"Ontological / Temporal level — Reality has no unmediated origin; its unities subsist in a retroactive time of negative self-differentiation.","refs":["MC_GB18_L1_09:ALT-B04","MC_GB18_L1_10:ALT-B04","MC_GB18_L1_11:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:ALT-B05","text":"Methodological / Performative level — The presentation enacts its thesis by destabilizing every fixed category through its own claim and allowing it to return in mutation.","refs":["MC_GB18_L1_09:ALT-B05","MC_GB18_L1_10:ALT-B05","MC_GB18_L1_11:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L2_03:FL-01","text":"Externality must be overcome and yet persist: without it, the exposition of difference is absent; with it, ungenerated connection threatens.","refs":["MC_GB18_L1_09:FL-02","MC_GB18_L1_10:FL-02","MC_GB18_L1_11:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-02","text":"Explanation requires identity between ground and grounded, but thereby produces tautology; it requires difference, but thereby produces externality.","refs":["MC_GB18_L1_11:AS-03","MC_GB18_L1_11:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-03","text":"The absolutely unconditioned claims terminal closure, while concept and purpose explicitly remain open as forms of positive completion.","refs":["MC_GB18_L1_11:AS-08","MC_GB18_L1_11:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-04","text":"The critique of external allocation of grounds requires a criterion of legitimate mediation, but cannot fully establish it within the still undeveloped positive unity of concept.","refs":["MC_GB18_L1_11:FL-04","MC_GB18_L1_11:MRT-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-05","text":"The transition from logical forms of proposition, comparison, and exclusion to ontological structure of reflection remains compressed and not fully mediated.","refs":["MC_GB18_L1_10:FL-01","MC_GB18_L1_10:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-06","text":"The negative reconstruction of external givenness is more developed than the positive genesis of concrete manifold contents.","refs":["MC_GB18_L1_09:FL-01","MC_GB18_L1_11:MRT-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:FL-07","text":"Determinations must be sufficiently independent to bear transitions and sufficiently fully mediated to possess no relation-external existence.","refs":["MC_GB18_L1_09:FL-03","MC_GB18_L1_10:FL-04","MC_GB18_L1_11:FL-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:MP-01","text":"The first point of mutation transforms the contradiction of indifference from a defect of passive unity into productive reflection.","refs":["MC_GB18_L1_09:MP-01","MC_GB18_L1_09:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:MP-02","text":"The second complex of mutation leads identity from the whole of reflection to the differentiated moment, and difference from external diversity to inner opposition.","refs":["MC_GB18_L1_10:MP-01","MC_GB18_L1_10:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:MP-03","text":"Ground mutates from the expected foundation through the retroactive unity of the determinations of reflection into the operation that brings forth its own conditionedness.","refs":["MC_GB18_L1_09:RMD-07","MC_GB18_L1_11:GA-04","MC_GB18_L1_11:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:MP-04","text":"Immediacy mutates from the ontological beginning into posited material, generated presupposition, and the result of return.","refs":["MC_GB18_L1_09:MP-03","MC_GB18_L1_11:RMD-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L2_03:MP-05","text":"The unconditioned mutates from relative independence into negative identity, which preserves conditionedness as its own self-difference.","refs":["MC_GB18_L1_11:MP-03","MC_GB18_L1_11:RLE-06"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L2_03:HSI-01","text":"Reality appears as a reflexive machine that processes no external foundations, but internally generates and withdraws unities, opposites, grounds, and conditions.","refs":["MC_GB18_L1_09:HSI-01","MC_GB18_L1_10:HSI-01","MC_GB18_L1_11:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:HSI-02","text":"The subject is a non-sovereign node at which the enactment of reflection, comparison, selection of grounds, and speculative mediation converge.","refs":["MC_GB18_L1_09:HSI-02","MC_GB18_L1_10:HSI-02","MC_GB18_L1_11:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:HSI-03","text":"Time is a spiral of retroactive positing in which presuppositions appear earlier, but are constituted only through later mediation.","refs":["MC_GB18_L1_09:HSI-03","MC_GB18_L1_10:HSI-03","MC_GB18_L1_11:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:HSI-04","text":"Navigation remains possible as intervention in the mutations through which oppositions, grounds, and conditions are generated; escape into a first ground is excluded.","refs":["MC_GB18_L1_09:HSI-04","MC_GB18_L1_10:HSI-04","MC_GB18_L1_11:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L2_03:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from presupposed immediacy through reflection, contradiction, and ground to negative unconditionedness.","refs":["MC_GB18_L1_09:MRT-B01","MC_GB18_L1_10:MRT-B01","MC_GB18_L1_11:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MRT-B02","text":"The reconstruction is coherent insofar as negative identity is not read as undifferentiated equality, presupposition not as temporal precedence, and externality not as a unitary category.","refs":["MC_GB18_L1_09:MRT-B03","MC_GB18_L1_10:MRT-B03","MC_GB18_L1_11:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MRT-B03","text":"The strongest architecture lies in the recursive connection of contradiction, retroactive presupposition, critique of ground, and internalization of condition.","refs":["MC_GB18_L1_11:MRT-B03","MC_GB18_L1_09:MRT-B04","MC_GB18_L1_10:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MRT-B04","text":"Underdetermined remain the positive genesis of concrete contents, the necessary mediation of logical form and ontology, and the positive shape of concept and purpose.","refs":["MC_GB18_L1_09:MRT-B02","MC_GB18_L1_10:MRT-B02","MC_GB18_L1_11:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_03:MRT-B05","text":"The actual movement is preserved only if formal closure, real externality, negative closure, and the open demand for concept are distinguished, and the enactment of mutating exclusions is not reduced to static axioms.","refs":["MC_GB18_L1_11:MRT-B05","MC_GB18_L1_11:MRT-B06","MC_GB18_L1_10:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L2_03@R001","source_variant_id":"canonical:MC_GB18_L2_03:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L2 03","context":"Chapters 97–132 · A. Die absolute Indifferenz. · B. Die Indifferenz als umgekehrtes Verhältniß ihrer Faktoren. · Anmerkung. · C. Übergang in das Wesen. · Zweites Buch Das Wesen. · Erster Abschnitt. Das Wesen als Reflexion in ihm selbst. · A. Das Wesentliche und das Unwesentliche. · B. Der Schein. · C. Die Reflexion. · 1. Die setzende Reflexion. · 2. Die äußere Reflexion. · 3. Bestimmende Reflexion. · Anmerkung. · A. Die Identität. · Anmerkung 1. · Anmerkung 2. · 1. Der absolute Unterschied. · 2. Die Verschiedenheit. · Anmerkung. · 3. Der Gegensatz. · Anmerkung. · C. Der Widerspruch. · Anmerkung 1. · Anmerkung 2. · Anmerkung 3. · Anmerkung. · a. Form und Wesen. · b. Form und Materie. · c. Form und Inhalt. · a. Der formelle Grund. · Anmerkung. · b. Der reale Grund. · Anmerkung. · c. Der vollständige Grund. · a. Das relativ Unbedingte. · b. Das absolute Unbedingte."},"title_language_code":"en"},{"id":"MC_GB18_L1_04","layer":"MC","title":"Gb18 L1 04","order":4,"parents":["CL_GB18_13","CL_GB18_14","CL_GB18_15","CL_GB18_16"],"revision":"MC_GB18_L1_04@R001","sha256":"35d61c62ad588d3e36a6bdfe3c4b247f7058c3db40d7e4bfec7f7cdacfad2781","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_04:AS-B01","text":"Das System löst das Problem, Endlichkeit, Andersheit, Vielheit und Bewegung herzuleiten, ohne sie als selbständige Tatsachen vorauszusetzen oder durch subjektive Umbenennung zu beseitigen.","refs":["CL_GB18_13:ASP-01","CL_GB18_16:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B02","text":"Seine globale These bestimmt Idealität als immanente Einheit, die endliche Bestimmungen durch Transformation ihres ontologischen Status in sich erhält.","refs":["CL_GB18_13:ASP-02","CL_GB18_14:BAS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B03","text":"Das Argument wird zu einer rekursiven Ontologie der Negativität: Differenz entsteht aus Unmittelbarkeit, kehrt als Andersheit zurück und reorganisiert die Einheit, aus der sie hervorging.","refs":["CL_GB18_13:ASP-03","CL_GB18_15:SP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B04","text":"Unmittelbarkeit verliert den Status eines Anfangs und wird zur sedimentierten Erscheinungsform bereits vollzogener Vermittlung.","refs":["CL_GB18_14:BAS-05","CL_GB18_15:SP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B05","text":"Das Eins ist weder Ursprung noch ruhendes Zentrum, sondern die abstrakte Seinsform negativer Selbstbeziehung, die ihr inneres Nichts als Leeres externalisiert.","refs":["CL_GB18_14:BAS-06","CL_GB18_15:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B06","text":"Repulsion operationalisiert die negative Selbstbeziehung und erzeugt Vielheit als zugleich gesetzte und scheinbar vorausgesetzte Äußerlichkeit gleichartiger Einsheiten.","refs":["CL_GB18_16:AS-B04","CL_GB18_16:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B07","text":"Der Widerspruch zwischen begrifflicher Einheit und verselbständigter Seinsform ist der produktive Mechanismus, durch den das System seine jeweils abstrakte Gestalt überschreitet.","refs":["CL_GB18_14:BAS-07","CL_GB18_16:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B08","text":"Die Schließung ist doppelt und offen: Das qualitative Fürsichsein geht kategorial in Quantität über, während Idealität als nicht vollständig eingelöster Maßstab immanenter Vermittlung fortbesteht.","refs":["CL_GB18_13:GA-08","CL_GB18_16:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_04:GA-01","text":"[Persistent] Endlichkeit besitzt keine letzte Selbständigkeit; ihre Realität besteht nur als gesetzte und vermittelte Bestimmtheit innerhalb einer umfassenderen Bewegung.","refs":["CL_GB18_13:GA-01","CL_GB18_14:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-02","text":"[Persistent] Aufhebung negiert die selbständige Geltung einer Bestimmung, ohne deren differenzierende Funktion aus der höheren Einheit zu tilgen.","refs":["CL_GB18_13:GA-03","CL_GB18_14:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-03","text":"[Mutating] Idealität entwickelt sich von der Nichtanerkennung des Endlichen als Absolutes zur positiven Einheit von Endlichem und Unendlichem, Ideellem und Reellem sowie Fürsichsein und Für-es-sein.","refs":["CL_GB18_13:GA-02","CL_GB18_14:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-04","text":"[Persistent] Selbstbeziehung entsteht nur durch aufgehobenes Anderssein; reine Identität ohne enthaltene Differenz besitzt keine generative Kraft.","refs":["CL_GB18_14:GA-01","CL_GB18_13:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-05","text":"[Mutating] Unmittelbarkeit ist kein voraussetzungsloser Anfang, sondern die erzeugte Form einer Vermittlung, die ihre eigene Genese zunächst verdeckt.","refs":["CL_GB18_14:GA-05","CL_GB18_15:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-06","text":"[Emergent] Das Eins ist die abstrakte Erscheinungsform negativer Selbstbeziehung und mutiert von scheinbar isolierter Identität zur Produktionsstruktur von Differenz.","refs":["CL_GB18_14:BAS-06","CL_GB18_15:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-07","text":"[Emergent] Dasein und Äußerlichkeit sind keine ursprünglichen Gegebenheiten, sondern Resultate der Verselbständigung intern erzeugter Unterschiede.","refs":["CL_GB18_15:GA-04","CL_GB18_15:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-08","text":"[Attractor] Repulsion ist die operative Form, in der negative Selbstbeziehung Vielheit hervorbringt, ohne in ein qualitativ anderes Sein überzugehen.","refs":["CL_GB18_16:GA-05","CL_GB18_16:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-09","text":"[Persistent] Äußerliche Beziehung bezeichnet einen Vermittlungsmangel; immanente Beziehung bezeichnet die Idealität einer Einheit, die ihr Für-Anderes als eigene Bestimmung enthält.","refs":["CL_GB18_16:RMD-04","CL_GB18_16:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-10","text":"[Emergent] Widerspruch entsteht notwendig, wenn begrifflich untrennbare Momente in der Form selbständiger Seiender erscheinen.","refs":["CL_GB18_14:GA-07","CL_GB18_16:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-11","text":"[Attractor] Die Gleichheit von erzeugendem und erzeugtem Eins verhindert einen ersten souveränen Träger und verteilt die Produktion auf die Selbstbewegung der Relation.","refs":["CL_GB18_16:GA-08","CL_GB18_16:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-12","text":"[Terminal] Das qualitative Fürsichsein vollendet sich nur, indem seine negative Selbstbeziehung als Vielheit außer sich tritt und dadurch die kategoriale Ordnung der Quantität eröffnet.","refs":["CL_GB18_13:GA-08","CL_GB18_16:GA-09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_04:RMD-01","text":"Endlichkeit kehrt nicht als beseitigter Gegenstand, sondern als notwendige, unselbständige Bestimmtheit der Selbstvermittlung wieder.","refs":["CL_GB18_13:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-02","text":"Idealität mutiert vom negativen Kriterium gegen verabsolutierte Endlichkeit zur positiven Einheitsstruktur und schließlich zum Prüfmaßstab jeder Theorie von Vielheit und Beziehung.","refs":["CL_GB18_13:GA-02","CL_GB18_14:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-03","text":"Negation erweitert sich von Grenze und Aufhebung über verdoppelte Selbstnegation und Ausschluss bis zur Repulsion als produktiver Erzeugung von Vielheit.","refs":["CL_GB18_13:RMD-02","CL_GB18_14:RMD-06","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-04","text":"Unmittelbarkeit erfährt eine Valenzumkehr: Was zunächst vermittlungsfrei erscheint, wird zum verdichteten Resultat einer rückläufig erschlossenen Negationsbewegung.","refs":["CL_GB18_15:RMD-03","CL_GB18_14:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-05","text":"Das Andere wandert vom vermeintlich äußeren Gegenstand über das innere Moment der Selbstbeziehung zum Leeren und schließlich zum weiteren Eins.","refs":["CL_GB18_13:RMD-03","CL_GB18_15:RMD-04","CL_GB18_16:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-06","text":"Das Eins mutiert von abstrakter Selbstidentität über reine Realität und Sein zu einer relationalen Produktionsstruktur, deren Wahrheit in ihrer Vielheit liegt.","refs":["CL_GB18_15:RMD-01","CL_GB18_16:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-07","text":"Das Nichts verschiebt sich vom internen Moment des Eins zum äußerlich erscheinenden Leeren und verliert zuletzt seine Funktion als selbständiger Behälter.","refs":["CL_GB18_15:RMD-05","CL_GB18_16:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-08","text":"Vielheit mutiert von einer äußerlich gegebenen Menge zur gesetzten Äußerlichkeit der Selbstbeziehung, deren Unendlichkeit nicht numerisch, sondern operativ ist.","refs":["CL_GB18_16:RMD-03","CL_GB18_16:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-09","text":"Widerspruch kehrt zunächst als Zeichen unvollständiger Vermittlung wieder und wird anschließend in die notwendige Entwicklungsform verselbständigter Darstellung absorbiert.","refs":["CL_GB18_14:MP-04","CL_GB18_14:XD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_04:CGD-01","text":"Die kategorialen Detailfolgen von Eins, Vielheit, Repulsion und Attraktion bleiben lokal; auf der aktuellen Ebene skalieren sie zur Regel, dass Selbstidentität ihre Differenz operativ erzeugt.","refs":["CL_GB18_13:CGD-01","CL_GB18_16:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:CGD-02","text":"Bewußtseyn und Selbstbewußtseyn bleiben lokale Veranschaulichungen; global trägt nur die Unterscheidung zwischen subjektivem Besitz und ontologischer Transformation des Anderen.","refs":["CL_GB18_13:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:CGD-03","text":"Die einzelnen philosophiegeschichtlichen Systeme bleiben lokale Prüfkonfigurationen; aktuell skalieren sie zu unterschiedlichen Regimen fortdauernder äußerlicher Negativität.","refs":["CL_GB18_14:CGD-02","CL_GB18_14:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:CGD-04","text":"Gestalt, Stellung und Bewegungsrichtung einzelner Atome bleiben lokale Symptome; global werden Natur-, Staats- und Beziehungstheorien als Varianten äußerlicher Zusammensetzung lesbar.","refs":["CL_GB18_16:CGD-01","CL_GB18_16:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:CGD-05","text":"Die positive Detailableitung der Vielheit bleibt unterbestimmt, während auf der aktuellen Ebene die Notwendigkeit ihrer Erzeugung aus negativer Selbstbeziehung feststeht.","refs":["CL_GB18_14:CGD-05","CL_GB18_16:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:CGD-06","text":"Der Übergang zur Quantität skaliert als notwendige Schließung des Qualitativen, doch die weitere positive Entwicklung dieser neuen Ordnung liegt außerhalb der aktuellen Architektur.","refs":["CL_GB18_13:GA-08","CL_GB18_14:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_04:GNX-01","text":"Ausgeschlossen ist ein endliches Seiendes, das als selbstgenügsames, ungesetztes und vom Ganzen unabhängiges Letztes bestehen könnte.","refs":["CL_GB18_13:GNX-01","CL_GB18_14:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GNX-02","text":"Ausgeschlossen ist ein formeller Idealismus, der nur die Vorstellungsform verändert und die Selbständigkeit des endlichen Inhalts unangetastet lässt.","refs":["CL_GB18_13:GNX-02","CL_GB18_14:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GNX-03","text":"Ausgeschlossen ist eine positive Einheit, die Bestimmtheit tilgt oder ohne Selbstunterscheidung bestehen soll.","refs":["CL_GB18_14:GNX-03","CL_GB18_15:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GNX-04","text":"Ausgeschlossen sind eine vorgegebene Vielheit und ein neutrales Leeres, die Bewegung und Beziehung lediglich aufnehmen, statt sie hervorzubringen.","refs":["CL_GB18_16:GNX-01","CL_GB18_16:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GNX-05","text":"Ausgeschlossen ist jede Vermittlung durch ein äußerliches Drittes, einen Beobachter oder eine übergeordnete Monade.","refs":["CL_GB18_14:GNX-04","CL_GB18_16:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GNX-06","text":"Ausgeschlossen ist eine widerspruchsfreie Entwicklung, weil die Verselbständigung begrifflicher Momente gerade die Form ihres notwendigen Übergangs bildet.","refs":["CL_GB18_14:BSA-03","CL_GB18_14:XD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_04:DBN-01","text":"Falsch sein muss eine Ontologie fertiger, selbstidentischer Einheiten, deren Beziehungen erst nachträglich hinzukommen.","refs":["CL_GB18_16:BSA-01","CL_GB18_16:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:DBN-02","text":"Falsch sein muss die Annahme eines vornegativen Seins oder einer unvermittelten Unmittelbarkeit als ontologischer Grundlage.","refs":["CL_GB18_14:DBN-03","CL_GB18_14:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:DBN-03","text":"Falsch sein muss ein ursprüngliches Eins, das vor seiner Negation läge und als asymmetrischer Produzent außerhalb seiner Produkte fortbestünde.","refs":["CL_GB18_14:BSA-01","CL_GB18_16:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:DBN-04","text":"Falsch sein muss die Gleichsetzung innerer Repräsentation mit wirklicher Relation, weil sie Vermittlung in ein Bewusstsein verlagert, statt die Einheit selbst zu transformieren.","refs":["CL_GB18_16:GNX-06","CL_GB18_16:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:DBN-05","text":"Falsch sein muss eine Kausalität zwischen bereits getrennten Bestimmungen; Bewegung muss als negative Selbstvermittlung rekonstruiert werden.","refs":["CL_GB18_15:DBN-02","CL_GB18_16:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_04:BSA-01","text":"Nicht verfügbar ist ein absoluter Außenstandpunkt oder ein unassimilierbares Außen, das der rekursiven Vermittlung endgültig entzogen bliebe.","refs":["CL_GB18_13:BSA-01","CL_GB18_14:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSA-02","text":"Nicht verfügbar ist eine Selbstbeziehung ohne Andersheit; eine solche Identität wäre abstrakt, bewegungslos und ohne Bestimmungsvermögen.","refs":["CL_GB18_13:BSA-02","CL_GB18_15:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSA-03","text":"Nicht verfügbar ist eine lineare und widerspruchsfreie Zeit der Entwicklung; jede spätere Äußerlichkeit rekonstruiert ihren vermeintlichen Anfang als bereits vermittelt.","refs":["CL_GB18_14:BSA-03","CL_GB18_15:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSA-04","text":"Das System umkreist eine nicht vollständig erreichbare Einheit, die Differenz erzeugt, ohne sie entweder zu verselbständigen oder restlos zu assimilieren.","refs":["CL_GB18_16:BSA-04","CL_GB18_16:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_04:XD-01","text":"Die Kritik des subjektiven Idealismus und der Maßstab vollendeter Idealität konvergieren darin, dass eine Formveränderung nur gilt, wenn sie den relationalen Status des endlichen Inhalts transformiert.","refs":["MC_GB18_L1_04:GA-01","MC_GB18_L1_04:GA-03","MC_GB18_L1_04:GA-09","CL_GB18_13:CGD-03","CL_GB18_16:AS-B07"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_04:XD-02","text":"Negationsbegründete Unmittelbarkeit erzeugt das Eins als Erscheinungsform vermittelter Selbstbeziehung und widerlegt dadurch seinen Status als Ursprung.","refs":["MC_GB18_L1_04:GA-05","MC_GB18_L1_04:GA-06","CL_GB18_14:BAS-05","CL_GB18_14:BAS-06"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_04:XD-03","text":"Das im Eins gesetzte Nichts externalisiert sich als Leeres und bildet damit die notwendige Brücke zwischen interner Negation und äußerlich erscheinender Vielheit.","refs":["MC_GB18_L1_04:GA-06","MC_GB18_L1_04:GA-07","CL_GB18_15:GA-08","CL_GB18_16:GA-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_04:XD-04","text":"Ausschluss erzeugt die Relation, die er zu beseitigen scheint, und mutiert in der Repulsion zur produktiven Selbstbeziehung des Eins auf viele Einsheiten.","refs":["MC_GB18_L1_04:GA-04","MC_GB18_L1_04:GA-08","CL_GB18_15:XD-06","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_04:XD-05","text":"Die zugleich gesetzte und vorausgesetzte Vielheit ist die skalierte Form des Widerspruchs zwischen begrifflicher Untrennbarkeit und seyender Verselbständigung.","refs":["MC_GB18_L1_04:GA-07","MC_GB18_L1_04:GA-10","CL_GB18_14:BAS-07","CL_GB18_16:AS-B05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_04:XD-06","text":"Die Gleichheit von repellierendem und repelliertem Eins beseitigt jeden ursprünglichen Erzeuger und verteilt Handlungsmacht auf die rekursive Operation der Repulsion.","refs":["MC_GB18_L1_04:GA-08","MC_GB18_L1_04:GA-11","CL_GB18_16:GA-08","CL_GB18_16:XD-04"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_04:XD-07","text":"Die Äußerlichwerdung der Negation erzeugt Dasein und Vielheit, bleibt aber als abstrakte Form unzureichend und treibt deshalb zugleich zu Idealität und Quantität weiter.","refs":["MC_GB18_L1_04:GA-07","MC_GB18_L1_04:GA-09","MC_GB18_L1_04:GA-12","CL_GB18_15:CGD-05","CL_GB18_16:GA-09","CL_GB18_16:RLE-04"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_04:XD-08","text":"Atomismus, Monadologie und unvollendete Idealismen werden zu Varianten derselben Vermittlungskrise: Sie verlagern Beziehung in ein äußeres Medium, einen Beobachter oder eine übergeordnete Instanz.","refs":["MC_GB18_L1_04:GA-03","MC_GB18_L1_04:GA-09","CL_GB18_14:CGD-02","CL_GB18_16:AS-B06","CL_GB18_16:XD-05"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_04:BSD-01","text":"Realität erhält den Status operativer Selbstunterscheidung: Bestimmtheit entsteht aus der Organisation von Negation und nicht aus einem positiven ontologischen Substrat.","refs":["CL_GB18_15:BSD-01","CL_GB18_16:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-02","text":"Das Subjekt wird von einer souveränen Inneninstanz zu einer verteilten Selbstbeziehung, deren Identität nur durch die immanente Erzeugung ihres Für-Anderes besteht.","refs":["CL_GB18_14:BSD-03","CL_GB18_16:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-03","text":"Kausalität wird als negative Selbstvermittlung reorganisiert; Ursache ist nicht ein äußerer Stoß, sondern die Selbstbestimmung einer Relation, die ihren Unterschied hervorbringt.","refs":["CL_GB18_16:BSD-04","CL_GB18_15:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-04","text":"Zeit nimmt die Form rekursiver Nachträglichkeit an: Resultate verdecken ihre Produktion und legen rückwirkend frei, dass ihre scheinbare Unmittelbarkeit bereits vermittelt war.","refs":["CL_GB18_14:BSD-04","CL_GB18_15:BSD-04","CL_GB18_16:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-05","text":"Erkenntnis wird zur Rekonstruktion verleugneter Vermittlung; jede unmittelbare Bestimmung ist darauf zu prüfen, welche Negationsoperation sie als fertige Gegebenheit erscheinen lässt.","refs":["CL_GB18_15:BSD-05","CL_GB18_16:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-06","text":"Politische, natürliche und metaphysische Einzelheiten werden homolog, sobald sie als selbstgenügsame Einheiten gelten, deren Zusammenhang nur äußerlich zusammengesetzt werden kann.","refs":["CL_GB18_16:GA-10","CL_GB18_16:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-07","text":"Widerspruch wird zum Index einer notwendigen Transformation: Die erzeugte Selbständigkeit der vielen Eins legt die Abstraktheit ihrer gemeinsamen Einsform offen.","refs":["CL_GB18_14:CGD-06","CL_GB18_16:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_04:RLE-01","text":"Die Hauptschleife lautet: Endlichkeit → Grenze → Negation → Selbstbeziehung → erzeugte Unmittelbarkeit → Eins → Andersheit → Repulsion → Vielheit → erneute Vermittlung.","refs":["CL_GB18_13:RLE-01","CL_GB18_16:AS-B08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-02","text":"Der Ausschluss des Anderen reproduziert das Andere als notwendiges Moment und verwandelt äußerliche Negation in immanente Relation.","refs":["CL_GB18_15:RLE-02","CL_GB18_14:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-03","text":"Die Wiederkehr von Unmittelbarkeit ist keine Wiederholung desselben, sondern ein Phasenwechsel, bei dem Vermittlung jeweils in eine neue unmittelbare Form sedimentiert.","refs":["CL_GB18_14:BSD-04","CL_GB18_15:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-04","text":"Das Leere zieht die interne Negativität in eine äußere Grenzform; Repulsion transformiert diese Grenze anschließend in die operative Produktion vieler Einsheiten.","refs":["CL_GB18_15:RLE-04","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-05","text":"Idealität fungiert als Attraktor, weil jede isolierte Einheit, äußerliche Vermittlung und persistierende Jenseitigkeit auf die Forderung immanenter Beziehung zurückverwiesen wird.","refs":["CL_GB18_14:RLE-03","CL_GB18_16:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-06","text":"Die Wiederkehr atomistischer Formen in verschiedenen Gegenstandsbereichen ist eine Rekursion desselben abstrakten Einzelheitsmodells und keine bloße Reihe von Beispielen.","refs":["CL_GB18_16:RLE-05","CL_GB18_16:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-07","text":"Die Eskalation verläuft von der Kritik falscher Idealität über die Ontologie negativer Selbstbeziehung zur Erzeugung von Bewegung und Vielheit und endet im offenen Übergang zur Quantität.","refs":["CL_GB18_13:RLE-03","CL_GB18_13:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_04:FGS-B01","text":"Absolutgesetztes Endliches → Nachweis seiner Abhängigkeit → Verlust selbständiger Geltung → Idealität als erhaltenes Moment.","refs":["CL_GB18_13:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B02","text":"Grenze → Negation → Negation der Negation → Fürsichsein als Rückkehr der Differenz in Selbstbeziehung.","refs":["CL_GB18_13:ASP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B03","text":"Negative Selbstbeziehung → erzeugte Unmittelbarkeit → Fürsichseiendes → Eins als abstrakte Seinsform der Vermittlung.","refs":["CL_GB18_14:BAS-05","CL_GB18_14:BAS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B04","text":"Eins → gesetztes Nichts → Leeres → äußerlich erscheinendes Dasein der internen Negation.","refs":["CL_GB18_15:GA-08","CL_GB18_15:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B05","text":"Hervorgebrachte Andersheit → Ausschluss → fortdauernde Beziehung → Repulsion als rekursive Stabilisierung der Einheit.","refs":["CL_GB18_15:GA-11","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B06","text":"Repulsion → viele gleiche Eins → Aufhebung der Produktionsspur → Vielheit als zugleich gesetzt und vorausgesetzt.","refs":["CL_GB18_16:GA-03","CL_GB18_16:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B07","text":"Äußerliche Vielheit → Widerspruch zwischen Selbständigkeit und gemeinsamer Herkunft → Diagnose abstrakter Vermittlung → Forderung nach Idealität.","refs":["CL_GB18_14:BAS-07","CL_GB18_16:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B08","text":"Außer-sich-Sein der qualitativen Selbstbeziehung → quantitative Ordnung → offene Fortsetzung der kategorialen Entwicklung.","refs":["CL_GB18_13:GA-08","CL_GB18_16:GA-09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_04:AFM-B01","text":"Endlichkeit → Grenze → Negation → Selbstbeziehung → Unmittelbarkeit → Eins → Leeres → Ausschluss → Repulsion → Vielheit → Widerspruch → höhere Vermittlung.","refs":["CL_GB18_13:RLE-01","CL_GB18_15:GA-09","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AFM-B02","text":"Formeller Idealismus → Nachweis fortbestehender Selbständigkeit → Diagnose äußerer Vermittlung → Immanenztest der Idealität.","refs":["CL_GB18_13:CGD-03","CL_GB18_14:GNX-02","CL_GB18_16:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AFM-B03","text":"Ursprüngliche Unmittelbarkeit → erzeugte Unmittelbarkeit → gegebene Vielheit → gesetzte Vielheit → Idealität als Einheit von Selbstsein und Beziehung.","refs":["CL_GB18_14:MME-04","CL_GB18_16:RMD-03","CL_GB18_16:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AFM-B04","text":"Vollendung des qualitativen Fürsichseins → Außer-sich-Treten als Vielheit → Übergang zur Quantität bei fortbestehendem Attraktor der Idealität.","refs":["CL_GB18_13:GA-08","CL_GB18_16:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AFM-B05","text":"Jede scheinbare Vollendung → interne Erzeugung ihres Gegensatzes → Verlust statischer Schließung → neue kategoriale Ordnung.","refs":["CL_GB18_13:BSD-03","CL_GB18_14:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_04:MME-01","text":"Die Opposition Idealismus gegen Realismus wird durch eine Skala ersetzt, auf der die Immanenz oder Äußerlichkeit der Vermittlung entscheidet.","refs":["CL_GB18_13:MME-01","CL_GB18_14:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-02","text":"Der Gegensatz von Unmittelbarkeit und Vermittlung bricht zusammen, weil Unmittelbarkeit als verdichtete und ihre Genese verdeckende Vermittlung lesbar wird.","refs":["CL_GB18_15:MME-03","CL_GB18_14:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-03","text":"Eins und Viele werden nicht mehr als konkurrierende ontologische Grundbestände kartiert; Vielheit ist die problematische Selbstsetzung der Einsform.","refs":["CL_GB18_16:MME-02","CL_GB18_16:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-04","text":"Das Leere wird vom passiven Mangel oder Raum zur negativen Grenzform umklassifiziert, in der interne Negation als äußere Differenz erscheint.","refs":["CL_GB18_15:MME-04","CL_GB18_16:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-05","text":"Widerspruch wird von einer Störung zur kartierbaren Wirkung jener Seinsform, die relationale Momente als selbständige Einheiten ausstellt.","refs":["CL_GB18_14:MME-05","CL_GB18_14:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-06","text":"Bewegung wird von räumlicher Veränderung zu negativer Selbstvermittlung umkartiert; äußere Kausalität verliert damit ihren Status als Grundmodell.","refs":["CL_GB18_16:MME-01","CL_GB18_16:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-07","text":"Qualität erscheint nicht länger als stabile Grundschicht, sondern als selbstüberschreitende Ordnung, deren Vollzug Quantität erzeugt.","refs":["CL_GB18_13:MME-03","CL_GB18_13:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_04:ALT-B01","text":"[Surface level] Endlichkeit, Idealität, Fürsichsein, Eins, Leeres, Atome, Monaden, Repulsion und Vielheit bilden die explizite Gegenstandskette.","refs":["CL_GB18_13:ALT-B01","CL_GB18_16:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:ALT-B02","text":"[Structural level] Die tragende Maschine transformiert äußerliche Negation in negative Selbstbeziehung und diese in Unmittelbarkeit, Differenz, Ausschluss und Vielheit.","refs":["CL_GB18_13:ALT-B02","CL_GB18_15:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:ALT-B03","text":"[Metastrategic level] Theorien werden nicht nach ihrem Einheitsbekenntnis, sondern nach ihrer Fähigkeit geordnet, Differenz und Vermittlung aus dem eigenen Grund hervorzubringen.","refs":["CL_GB18_14:ALT-B03","CL_GB18_16:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:ALT-B04","text":"[Ontological / Temporal level] Realität ist gestufte Selbstentäußerung; Genese erscheint im Resultat aufgehoben und wird erst rückläufig als dessen konstitutive Vermittlung sichtbar.","refs":["CL_GB18_13:ALT-B04","CL_GB18_16:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:ALT-B05","text":"[Methodological / Performative level] Die Darstellung vollzieht ihre These, indem sie jede fixierte Bestimmung durch Übergang, Gegenbewegung und Rücknahme in ihre verleugnete Vermittlung zurückführt.","refs":["CL_GB18_13:ALT-B05","CL_GB18_16:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_04:FL-01","text":"Das System verbietet ein endgültiges Außen, muss aber Äußerlichkeit erzeugen, damit Differenz, Dasein und Vielheit überhaupt bestimmt werden können.","refs":["CL_GB18_14:BSA-02","CL_GB18_15:AFM-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FL-02","text":"Selbstbeziehung soll kein äußeres Gegenüber voraussetzen, doch das Eins wird nur durch die Hervorbringung und den Ausschluss eines Anderen verständlich.","refs":["CL_GB18_14:GA-01","CL_GB18_15:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FL-03","text":"Vielheit muss erzeugt sein, um begrifflich erklärt zu werden, und zugleich als vorausgesetzte Selbständigkeit erscheinen, damit Repulsion eine äußere Form annehmen kann.","refs":["CL_GB18_16:AS-B05","CL_GB18_16:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FL-04","text":"Idealität fungiert als Vollständigkeitsmaßstab, obwohl ihr positiver Vollzug über Repulsion hinaus nicht vollständig demonstriert wird.","refs":["CL_GB18_14:FL-04","CL_GB18_16:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FL-05","text":"Das Leere oszilliert zwischen Bewegungsgrund und bloßer Grenzform; der Übergang zwischen beiden Funktionen bleibt komprimiert.","refs":["CL_GB18_16:FL-02","CL_GB18_16:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FL-06","text":"Die Vollendung des qualitativen Fürsichseins erzwingt den Übergang zur Quantität, ohne deren positive Entwicklung auf der aktuellen Ebene auszuführen.","refs":["CL_GB18_13:GA-08","CL_GB18_14:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MP-01","text":"Idealität mutiert vom Kriterium der Nichtabsolutheit über die konkrete Einheitsforderung zum Maßstab immanenter Beziehung von Fürsichsein und Für-es-sein.","refs":["CL_GB18_13:MP-01","CL_GB18_14:MP-03","CL_GB18_16:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MP-02","text":"Unmittelbarkeit mutiert vom vermeintlichen Anfang zum erzeugten Resultat und wird dadurch selbst zur Form rückläufiger Vermittlung.","refs":["CL_GB18_14:GA-05","CL_GB18_15:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MP-03","text":"Das Andere mutiert über das interne Nichts und das äußere Leere zum weiteren Eins; damit wechselt Differenz vom Mangel zur Struktur gleichartiger Vielheit.","refs":["CL_GB18_15:MP-02","CL_GB18_16:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MP-04","text":"Ausschluss mutiert von einer Endoperation zur generativen Relation und erreicht in der Repulsion seine operative Form.","refs":["CL_GB18_15:RMD-07","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MP-05","text":"Widerspruch mutiert vom Zeichen mangelhafter Vermittlung zum notwendigen Mechanismus, durch den abstrakte Seinsformen in neue kategoriale Ordnungen übergehen.","refs":["CL_GB18_14:MP-04","CL_GB18_14:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_04:HSI-01","text":"Realität erscheint als rekursive Maschine negativer Selbstunterscheidung, die ihre Unterschiede erzeugt, vergegenständlicht und durch deren Rückkehr reorganisiert wird.","refs":["CL_GB18_13:HSI-01","CL_GB18_16:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:HSI-02","text":"Das Subjekt ist weder souveränes Bewusstsein noch Atom oder Monade, sondern ein relationaler Knoten, der nur durch sein erzeugtes Anderssein bestimmt ist.","refs":["CL_GB18_13:HSI-02","CL_GB18_16:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:HSI-03","text":"Zeit ist eine rückläufige Spirale, in der Produktion im Resultat verschwindet und spätere Äußerlichkeit den früheren Anfang als bereits differenziert enthüllt.","refs":["CL_GB18_14:HSI-03","CL_GB18_16:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:HSI-04","text":"Kampf und Navigation bestehen darin, äußerliche Vermittlungen zurückzuweisen, ohne Andersheit zu vernichten; möglich bleibt nur ihre Rekonstruktion als immanente Relation.","refs":["CL_GB18_16:HSI-04","CL_GB18_13:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_04:MRT-B01","text":"Die Architektur ist mit den Axiomen von vermittelter Endlichkeit, erhaltender Aufhebung, negativer Selbstbeziehung, erzeugter Unmittelbarkeit, Eins, Leeres, Repulsion und Vielheit rekonstruierbar.","refs":["CL_GB18_15:MRT-B01","CL_GB18_16:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MRT-B02","text":"Unterbestimmt bleiben der genaue Umschlag interner Negation in äußeres Dasein und die positive Transformation der Repulsion in konkrete Idealität.","refs":["CL_GB18_15:MRT-B02","CL_GB18_16:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MRT-B03","text":"Das System ist kohärent, sofern Widerspruch und äußerliche Vielheit als notwendige, aber unzureichende Produktionsformen und nicht als terminale Tatsachen behandelt werden.","refs":["CL_GB18_15:MRT-B03","CL_GB18_16:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MRT-B04","text":"Der axiomatischen Schließung widersteht die Doppelstellung der Äußerlichkeit: Sie muss zugleich erzeugt, als vorausgesetzt ausgestellt und in die Selbstbeziehung zurückgenommen werden.","refs":["CL_GB18_16:MRT-B05","CL_GB18_15:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MRT-B05","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung, wenn sie die Darstellungsform des Seyns und die Kette aus Negativität, Selbstbewegung, Repulsion und Vielheit als gemeinsame Maschine liest.","refs":["CL_GB18_14:MRT-B04","CL_GB18_16:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123500952850Z_8be554e4","language_code":"en","language_name":"English","title":"Gb18 L1 04","source_sha256":"35d61c62ad588d3e36a6bdfe3c4b247f7058c3db40d7e4bfec7f7cdacfad2781","sha256":"06defd1e14a0d59b7f1bf86163e329c1491509038b8cf4c28db307c90560689b","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:35:00.954700+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_04:AS-B01","text":"The system resolves the problem of deriving finitude, otherness, plurality, and movement without presupposing them as independent facts or eliminating them through subjective renaming.","refs":["CL_GB18_13:ASP-01","CL_GB18_16:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B02","text":"Its global thesis determines ideality as immanent unity, which preserves finite determinations within itself by transforming their ontological status.","refs":["CL_GB18_13:ASP-02","CL_GB18_14:BAS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B03","text":"The argument becomes a recursive ontology of negativity: difference arises from immediacy, returns as otherness, and reorganizes the unity from which it emerged.","refs":["CL_GB18_13:ASP-03","CL_GB18_15:SP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B04","text":"Immediacy loses the status of a beginning and becomes the sedimented form of appearance of mediation already accomplished.","refs":["CL_GB18_14:BAS-05","CL_GB18_15:SP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B05","text":"The One is neither origin nor resting center, but the abstract form of being of negative self-relation, which externalizes its inner nothing as the void.","refs":["CL_GB18_14:BAS-06","CL_GB18_15:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B06","text":"Repulsion operationalizes negative self-relation and produces plurality as an externality of homogeneous ones that is at once posited and seemingly presupposed.","refs":["CL_GB18_16:AS-B04","CL_GB18_16:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B07","text":"The contradiction between conceptual unity and autonomous form of being is the productive mechanism through which the system surpasses its respectively abstract shape.","refs":["CL_GB18_14:BAS-07","CL_GB18_16:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AS-B08","text":"The closure is double and open: qualitative being-for-self passes categorically into quantity, while ideality persists as a not fully redeemed standard of immanent mediation.","refs":["CL_GB18_13:GA-08","CL_GB18_16:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_04:GA-01","text":"[Persistent] Finitude possesses no ultimate independence; its reality consists only in posited and mediated determinacy within a more comprehensive movement.","refs":["CL_GB18_13:GA-01","CL_GB18_14:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-02","text":"[Persistent] Sublation negates the independent validity of a determination without erasing its differentiating function from the higher unity.","refs":["CL_GB18_13:GA-03","CL_GB18_14:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-03","text":"[Mutating] Ideality develops from the non-recognition of the finite as absolute into the positive unity of finite and infinite, ideal and real, as well as being-for-self and being-for-another.","refs":["CL_GB18_13:GA-02","CL_GB18_14:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-04","text":"[Persistent] Self-relation arises only through sublated otherness; pure identity without contained difference possesses no generative force.","refs":["CL_GB18_14:GA-01","CL_GB18_13:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-05","text":"[Mutating] Immediacy is not a presuppositionless beginning, but the produced form of a mediation that initially conceals its own genesis.","refs":["CL_GB18_14:GA-05","CL_GB18_15:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-06","text":"[Emergent] The One is the abstract form of appearance of negative self-relation and mutates from seemingly isolated identity into the productive structure of difference.","refs":["CL_GB18_14:BAS-06","CL_GB18_15:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-07","text":"[Emergent] Determinate being and externality are not original givens, but results of the autonomization of internally produced differences.","refs":["CL_GB18_15:GA-04","CL_GB18_15:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-08","text":"[Attractor] Repulsion is the operative form in which negative self-relation brings forth plurality without passing into a qualitatively different being.","refs":["CL_GB18_16:GA-05","CL_GB18_16:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-09","text":"[Persistent] External relation denotes a deficiency of mediation; immanent relation denotes the ideality of a unity that contains its being-for-another as its own determination.","refs":["CL_GB18_16:RMD-04","CL_GB18_16:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-10","text":"[Emergent] Contradiction necessarily arises when conceptually inseparable moments appear in the form of independent beings.","refs":["CL_GB18_14:GA-07","CL_GB18_16:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-11","text":"[Attractor] The equality of the generating and generated One prevents a first sovereign bearer and distributes production across the self-movement of relation.","refs":["CL_GB18_16:GA-08","CL_GB18_16:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GA-12","text":"[Terminal] Qualitative being-for-self completes itself only by externalizing its negative self-relation as plurality and thereby opening the categorical order of quantity.","refs":["CL_GB18_13:GA-08","CL_GB18_16:GA-09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_04:RMD-01","text":"Finitude returns not as an eliminated object, but as a necessary, non-independent determination of self-mediation.","refs":["CL_GB18_13:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-02","text":"Ideality mutates from the negative criterion against absolutized finitude into the positive structure of unity and finally into the standard for testing every theory of plurality and relation.","refs":["CL_GB18_13:GA-02","CL_GB18_14:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-03","text":"Negation expands from limit and sublation through doubled self-negation and exclusion to repulsion as the productive generation of plurality.","refs":["CL_GB18_13:RMD-02","CL_GB18_14:RMD-06","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-04","text":"Immediacy undergoes a reversal of valence: what initially appears free of mediation becomes the condensed result of a movement of negation disclosed retroactively.","refs":["CL_GB18_15:RMD-03","CL_GB18_14:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-05","text":"The Other moves from the supposedly external object through the inner moment of self-relation to the void and finally to the further One.","refs":["CL_GB18_13:RMD-03","CL_GB18_15:RMD-04","CL_GB18_16:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-06","text":"The One mutates from abstract self-identity through pure reality and being into a relational productive structure whose truth lies in its plurality.","refs":["CL_GB18_15:RMD-01","CL_GB18_16:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-07","text":"Nothing shifts from the internal moment of the One to the externally appearing void and ultimately loses its function as an independent container.","refs":["CL_GB18_15:RMD-05","CL_GB18_16:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-08","text":"Plurality mutates from an externally given aggregate into the posited externality of self-relation, whose infinity is not numerical but operative.","refs":["CL_GB18_16:RMD-03","CL_GB18_16:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RMD-09","text":"Contradiction initially returns as a sign of incomplete mediation and is subsequently absorbed into the necessary developmental form of autonomized presentation.","refs":["CL_GB18_14:MP-04","CL_GB18_14:XD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_04:CGD-01","text":"The categorical detailed sequences of One, plurality, repulsion, and attraction remain local; at the current level, they scale into the rule that self-identity operatively generates its difference.","refs":["CL_GB18_13:CGD-01","CL_GB18_16:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:CGD-02","text":"Bewußtseyn and Selbstbewußtseyn remain local illustrations; globally, only the distinction between subjective possession and ontological transformation of the Other is load-bearing.","refs":["CL_GB18_13:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:CGD-03","text":"The individual systems in the history of philosophy remain local test configurations; at present, they scale into different regimes of enduring external negativity.","refs":["CL_GB18_14:CGD-02","CL_GB18_14:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:CGD-04","text":"The shape, position, and direction of movement of individual atoms remain local symptoms; globally, theories of nature, state, and relation become legible as variants of external composition.","refs":["CL_GB18_16:CGD-01","CL_GB18_16:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:CGD-05","text":"The positive detailed derivation of plurality remains underdetermined, whereas at the current level the necessity of its generation from negative self-relation is established.","refs":["CL_GB18_14:CGD-05","CL_GB18_16:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:CGD-06","text":"The transition to quantity scales as the necessary closure of the qualitative, yet the further positive development of this new order lies outside the current architecture.","refs":["CL_GB18_13:GA-08","CL_GB18_14:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_04:GNX-01","text":"Excluded is a finite being that could subsist as a self-sufficient, unposited, and whole-independent ultimate.","refs":["CL_GB18_13:GNX-01","CL_GB18_14:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GNX-02","text":"Excluded is a formal idealism that merely changes the form of representation and leaves the independence of finite content untouched.","refs":["CL_GB18_13:GNX-02","CL_GB18_14:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GNX-03","text":"Excluded is a positive unity that erases determinacy or is supposed to subsist without self-differentiation.","refs":["CL_GB18_14:GNX-03","CL_GB18_15:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GNX-04","text":"Excluded are a pre-given plurality and a neutral void that merely receive movement and relation instead of producing them.","refs":["CL_GB18_16:GNX-01","CL_GB18_16:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GNX-05","text":"Excluded is every mediation through an external third, an observer, or a higher monad.","refs":["CL_GB18_14:GNX-04","CL_GB18_16:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:GNX-06","text":"Excluded is a contradiction-free development, because the autonomization of conceptual moments constitutes precisely the form of their necessary transition.","refs":["CL_GB18_14:BSA-03","CL_GB18_14:XD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_04:DBN-01","text":"An ontology of completed, self-identical units whose relations are added only subsequently must be false.","refs":["CL_GB18_16:BSA-01","CL_GB18_16:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:DBN-02","text":"The assumption of a pre-negative being or of unmediated immediacy as ontological foundation must be false.","refs":["CL_GB18_14:DBN-03","CL_GB18_14:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:DBN-03","text":"An original One that would precede its negation and persist outside its products as an asymmetric producer must be false.","refs":["CL_GB18_14:BSA-01","CL_GB18_16:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:DBN-04","text":"The equation of inner representation with actual relation must be false, because it displaces mediation into a consciousness instead of transforming unity itself.","refs":["CL_GB18_16:GNX-06","CL_GB18_16:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:DBN-05","text":"A causality between already separated determinations must be false; movement must be reconstructed as negative self-mediation.","refs":["CL_GB18_15:DBN-02","CL_GB18_16:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_04:BSA-01","text":"Unavailable is an absolute external standpoint or an unassimilable outside that would remain definitively withdrawn from recursive mediation.","refs":["CL_GB18_13:BSA-01","CL_GB18_14:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSA-02","text":"Unavailable is a self-relation without otherness; such an identity would be abstract, motionless, and without the capacity for determination.","refs":["CL_GB18_13:BSA-02","CL_GB18_15:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSA-03","text":"Unavailable is a linear and contradiction-free time of development; every later externality reconstructs its supposed beginning as already mediated.","refs":["CL_GB18_14:BSA-03","CL_GB18_15:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSA-04","text":"The system circles around a unity that is not fully attainable, which produces difference without either autonomizing it or assimilating it without remainder.","refs":["CL_GB18_16:BSA-04","CL_GB18_16:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_04:XD-01","text":"The critique of subjective idealism and the standard of completed ideality converge in holding that a change of form counts only if it transforms the relational status of finite content.","refs":["MC_GB18_L1_04:GA-01","MC_GB18_L1_04:GA-03","MC_GB18_L1_04:GA-09","CL_GB18_13:CGD-03","CL_GB18_16:AS-B07"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_04:XD-02","text":"Negation-grounded immediacy produces the One as the form of appearance of mediated self-relation and thereby refutes its status as origin.","refs":["MC_GB18_L1_04:GA-05","MC_GB18_L1_04:GA-06","CL_GB18_14:BAS-05","CL_GB18_14:BAS-06"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_04:XD-03","text":"The nothing posited in the One externalizes itself as the void and thus forms the necessary bridge between internal negation and externally appearing plurality.","refs":["MC_GB18_L1_04:GA-06","MC_GB18_L1_04:GA-07","CL_GB18_15:GA-08","CL_GB18_16:GA-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_04:XD-04","text":"Exclusion produces the relation it seems to eliminate and mutates in repulsion into the productive self-relation of the One to many ones.","refs":["MC_GB18_L1_04:GA-04","MC_GB18_L1_04:GA-08","CL_GB18_15:XD-06","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_04:XD-05","text":"Plurality, at once posited and presupposed, is the scaled form of the contradiction between conceptual inseparability and beingly autonomous existence.","refs":["MC_GB18_L1_04:GA-07","MC_GB18_L1_04:GA-10","CL_GB18_14:BAS-07","CL_GB18_16:AS-B05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_04:XD-06","text":"The equality of repelling and repelled One eliminates every original generator and distributes agency across the recursive operation of repulsion.","refs":["MC_GB18_L1_04:GA-08","MC_GB18_L1_04:GA-11","CL_GB18_16:GA-08","CL_GB18_16:XD-04"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_04:XD-07","text":"The externalization of negation produces determinate being and plurality, but remains insufficient as an abstract form and therefore simultaneously drives further toward ideality and quantity.","refs":["MC_GB18_L1_04:GA-07","MC_GB18_L1_04:GA-09","MC_GB18_L1_04:GA-12","CL_GB18_15:CGD-05","CL_GB18_16:GA-09","CL_GB18_16:RLE-04"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_04:XD-08","text":"Atomism, monadology, and incomplete idealisms become variants of the same crisis of mediation: they displace relation into an external medium, an observer, or a higher instance.","refs":["MC_GB18_L1_04:GA-03","MC_GB18_L1_04:GA-09","CL_GB18_14:CGD-02","CL_GB18_16:AS-B06","CL_GB18_16:XD-05"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_04:BSD-01","text":"Reality receives the status of operative self-differentiation: determinacy arises from the organization of negation and not from a positive ontological substrate.","refs":["CL_GB18_15:BSD-01","CL_GB18_16:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-02","text":"The subject shifts from a sovereign inner instance to a distributed self-relation, whose identity exists only through the immanent generation of its being-for-another.","refs":["CL_GB18_14:BSD-03","CL_GB18_16:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-03","text":"Causality is reorganized as negative self-mediation; cause is not an external impact, but the self-determination of a relation that brings forth its difference.","refs":["CL_GB18_16:BSD-04","CL_GB18_15:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-04","text":"Time takes the form of recursive belatedness: results conceal their production and retroactively disclose that their apparent immediacy was already mediated.","refs":["CL_GB18_14:BSD-04","CL_GB18_15:BSD-04","CL_GB18_16:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-05","text":"Knowledge becomes the reconstruction of disavowed mediation; every immediate determination must be tested as to which operation of negation makes it appear as a completed given.","refs":["CL_GB18_15:BSD-05","CL_GB18_16:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-06","text":"Political, natural, and metaphysical particulars become homologous as soon as they count as self-sufficient units whose connection can be composed only externally.","refs":["CL_GB18_16:GA-10","CL_GB18_16:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:BSD-07","text":"Contradiction becomes the index of a necessary transformation: the produced independence of the many ones discloses the abstractness of their common form of One.","refs":["CL_GB18_14:CGD-06","CL_GB18_16:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_04:RLE-01","text":"The main loop is: finitude → limit → negation → self-relation → produced immediacy → One → otherness → repulsion → plurality → renewed mediation.","refs":["CL_GB18_13:RLE-01","CL_GB18_16:AS-B08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-02","text":"The exclusion of the Other reproduces the Other as a necessary moment and transforms external negation into immanent relation.","refs":["CL_GB18_15:RLE-02","CL_GB18_14:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-03","text":"The recurrence of immediacy is not a repetition of the same, but a phase change in which mediation is each time sedimented into a new immediate form.","refs":["CL_GB18_14:BSD-04","CL_GB18_15:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-04","text":"The void draws internal negativity into an external limiting form; repulsion subsequently transforms this limit into the operative production of many ones.","refs":["CL_GB18_15:RLE-04","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-05","text":"Ideality functions as an attractor because every isolated unity, external mediation, and persisting beyond is referred back to the demand for immanent relation.","refs":["CL_GB18_14:RLE-03","CL_GB18_16:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-06","text":"The recurrence of atomistic forms in different domains of objects is a recursion of the same abstract model of singularity and not a mere series of examples.","refs":["CL_GB18_16:RLE-05","CL_GB18_16:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:RLE-07","text":"The escalation proceeds from the critique of false ideality through the ontology of negative self-relation to the production of movement and plurality, and ends in the open transition to quantity.","refs":["CL_GB18_13:RLE-03","CL_GB18_13:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_04:FGS-B01","text":"Absolutely posited finite → demonstration of its dependence → loss of independent validity → ideality as preserved moment.","refs":["CL_GB18_13:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B02","text":"Limit → negation → negation of negation → being-for-self as the return of difference into self-relation.","refs":["CL_GB18_13:ASP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B03","text":"Negative self-relation → produced immediacy → being-for-self → One as the abstract form of being of mediation.","refs":["CL_GB18_14:BAS-05","CL_GB18_14:BAS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B04","text":"One → posited nothing → void → externally appearing determinate being of internal negation.","refs":["CL_GB18_15:GA-08","CL_GB18_15:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B05","text":"Brought-forth otherness → exclusion → enduring relation → repulsion as recursive stabilization of unity.","refs":["CL_GB18_15:GA-11","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B06","text":"Repulsion → many equal ones → sublation of the trace of production → plurality as at once posited and presupposed.","refs":["CL_GB18_16:GA-03","CL_GB18_16:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B07","text":"External plurality → contradiction between independence and common origin → diagnosis of abstract mediation → demand for ideality.","refs":["CL_GB18_14:BAS-07","CL_GB18_16:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FGS-B08","text":"Being-outside-itself of qualitative self-relation → quantitative order → open continuation of categorical development.","refs":["CL_GB18_13:GA-08","CL_GB18_16:GA-09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_04:AFM-B01","text":"Finitude → limit → negation → self-relation → immediacy → One → void → exclusion → repulsion → plurality → contradiction → higher mediation.","refs":["CL_GB18_13:RLE-01","CL_GB18_15:GA-09","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AFM-B02","text":"Formal idealism → demonstration of persisting independence → diagnosis of external mediation → test of the immanence of ideality.","refs":["CL_GB18_13:CGD-03","CL_GB18_14:GNX-02","CL_GB18_16:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AFM-B03","text":"Original immediacy → produced immediacy → given plurality → posited plurality → ideality as unity of self-being and relation.","refs":["CL_GB18_14:MME-04","CL_GB18_16:RMD-03","CL_GB18_16:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AFM-B04","text":"Completion of qualitative being-for-self → stepping-outside-itself as plurality → transition to quantity with the attractor of ideality persisting.","refs":["CL_GB18_13:GA-08","CL_GB18_16:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:AFM-B05","text":"Every apparent completion → internal generation of its opposite → loss of static closure → new categorical order.","refs":["CL_GB18_13:BSD-03","CL_GB18_14:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_04:MME-01","text":"The opposition of idealism and realism is replaced by a scale on which the immanence or externality of mediation is decisive.","refs":["CL_GB18_13:MME-01","CL_GB18_14:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-02","text":"The opposition of immediacy and mediation collapses because immediacy becomes legible as condensed mediation concealing its genesis.","refs":["CL_GB18_15:MME-03","CL_GB18_14:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-03","text":"One and many are no longer mapped as competing ontological basic stocks; plurality is the problematic self-positing of the form of One.","refs":["CL_GB18_16:MME-02","CL_GB18_16:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-04","text":"The void is reclassified from passive lack or space into the negative limiting form in which internal negation appears as external difference.","refs":["CL_GB18_15:MME-04","CL_GB18_16:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-05","text":"Contradiction shifts from a disturbance to the mappable effect of that form of being which presents relational moments as independent units.","refs":["CL_GB18_14:MME-05","CL_GB18_14:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-06","text":"Movement is remapped from spatial change to negative self-mediation; external causality thereby loses its status as the basic model.","refs":["CL_GB18_16:MME-01","CL_GB18_16:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MME-07","text":"Quality no longer appears as a stable foundational layer, but as a self-surpassing order whose enactment produces quantity.","refs":["CL_GB18_13:MME-03","CL_GB18_13:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_04:ALT-B01","text":"[Surface level] Finitude, ideality, being-for-self, One, void, atoms, monads, repulsion, and plurality form the explicit chain of objects.","refs":["CL_GB18_13:ALT-B01","CL_GB18_16:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:ALT-B02","text":"[Structural level] The supporting machine transforms external negation into negative self-relation and this into immediacy, difference, exclusion, and plurality.","refs":["CL_GB18_13:ALT-B02","CL_GB18_15:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:ALT-B03","text":"[Metastrategic level] Theories are ordered not according to their profession of unity, but according to their capacity to bring forth difference and mediation from their own ground.","refs":["CL_GB18_14:ALT-B03","CL_GB18_16:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:ALT-B04","text":"[Ontological / Temporal level] Reality is stratified self-externalization; genesis appears sublated in the result and becomes visible only retroactively as its constitutive mediation.","refs":["CL_GB18_13:ALT-B04","CL_GB18_16:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:ALT-B05","text":"[Methodological / Performative level] The presentation enacts its thesis by leading every fixed determination back, through transition, counter-movement, and retraction, into its disavowed mediation.","refs":["CL_GB18_13:ALT-B05","CL_GB18_16:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_04:FL-01","text":"The system prohibits a final outside, yet must produce externality in order for difference, determinate being, and plurality to be determinable at all.","refs":["CL_GB18_14:BSA-02","CL_GB18_15:AFM-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FL-02","text":"Self-relation is not supposed to presuppose an external counterpart, yet the One becomes intelligible only through the production and exclusion of an Other.","refs":["CL_GB18_14:GA-01","CL_GB18_15:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FL-03","text":"Plurality must be produced in order to be conceptually explained, and at the same time appear as presupposed independence so that repulsion can assume an external form.","refs":["CL_GB18_16:AS-B05","CL_GB18_16:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FL-04","text":"Ideality functions as a standard of completeness, although its positive enactment beyond repulsion is not fully demonstrated.","refs":["CL_GB18_14:FL-04","CL_GB18_16:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FL-05","text":"The void oscillates between ground of movement and mere limiting form; the transition between the two functions remains compressed.","refs":["CL_GB18_16:FL-02","CL_GB18_16:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:FL-06","text":"The completion of qualitative being-for-self compels the transition to quantity without carrying out its positive development at the current level.","refs":["CL_GB18_13:GA-08","CL_GB18_14:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MP-01","text":"Ideality mutates from the criterion of non-absoluteness through the concrete demand for unity into the standard of immanent relation between being-for-self and being-for-another.","refs":["CL_GB18_13:MP-01","CL_GB18_14:MP-03","CL_GB18_16:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MP-02","text":"Immediacy mutates from the supposed beginning into the produced result and thereby itself becomes the form of retroactive mediation.","refs":["CL_GB18_14:GA-05","CL_GB18_15:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MP-03","text":"The Other mutates through the internal nothing and the external void into the further One; thus difference shifts from lack to the structure of homogeneous plurality.","refs":["CL_GB18_15:MP-02","CL_GB18_16:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MP-04","text":"Exclusion mutates from a final operation into a generative relation and attains its operative form in repulsion.","refs":["CL_GB18_15:RMD-07","CL_GB18_16:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MP-05","text":"Contradiction mutates from the sign of deficient mediation into the necessary mechanism through which abstract forms of being pass into new categorical orders.","refs":["CL_GB18_14:MP-04","CL_GB18_14:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_04:HSI-01","text":"Reality appears as a recursive machine of negative self-differentiation, which produces and objectifies its differences and is reorganized through their return.","refs":["CL_GB18_13:HSI-01","CL_GB18_16:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:HSI-02","text":"The subject is neither sovereign consciousness nor atom or monad, but a relational node determined only through its produced otherness.","refs":["CL_GB18_13:HSI-02","CL_GB18_16:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:HSI-03","text":"Time is a retroactive spiral in which production disappears in the result and later externality reveals the earlier beginning as already differentiated.","refs":["CL_GB18_14:HSI-03","CL_GB18_16:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:HSI-04","text":"Struggle and navigation consist in rejecting external mediations without destroying otherness; only its reconstruction as immanent relation remains possible.","refs":["CL_GB18_16:HSI-04","CL_GB18_13:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_04:MRT-B01","text":"The architecture is reconstructible with the axioms of mediated finitude, preserving sublation, negative self-relation, produced immediacy, One, void, repulsion, and plurality.","refs":["CL_GB18_15:MRT-B01","CL_GB18_16:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MRT-B02","text":"The precise transition of internal negation into external determinate being and the positive transformation of repulsion into concrete ideality remain underdetermined.","refs":["CL_GB18_15:MRT-B02","CL_GB18_16:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MRT-B03","text":"The system is coherent insofar as contradiction and external plurality are treated as necessary but insufficient forms of production and not as terminal facts.","refs":["CL_GB18_15:MRT-B03","CL_GB18_16:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MRT-B04","text":"The double status of externality resists axiomatic closure: it must simultaneously be produced, presented as presupposed, and taken back into self-relation.","refs":["CL_GB18_16:MRT-B05","CL_GB18_15:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_04:MRT-B05","text":"The reconstruction preserves the actual movement if it reads the form of presentation of Seyns and the chain of negativity, self-movement, repulsion, and plurality as a common machine.","refs":["CL_GB18_14:MRT-B04","CL_GB18_16:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_04@R001","source_variant_id":"canonical:MC_GB18_L1_04:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 04","context":"Chapters 37–48 · Anmerkung 2. · A. Das Fürsichseyn als solches. · a. Daseyn und Fürsichseyn. · b. Seyn-für-eines. · Anmerkung. · c. Eins. · B. Eins und Vieles. · a. Das Eins an ihm selbst. · b. Das Eins und das Leere. · Anmerkung. · c. Viele Eins. Repulsion. · Anmerkung."},"title_language_code":"en"},{"id":"MC_GB18_L2_04","layer":"MC","title":"Gb18 L2 04","order":4,"parents":["MC_GB18_L1_12","MC_GB18_L1_13","MC_GB18_L1_14"],"revision":"MC_GB18_L2_04@R001","sha256":"996ac4f449490e5e24414b55dee55067841165e8c38c2649bdb9c4b031688b9c","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L2_04:AS-01","text":"Das System rekonstruiert, wie bestimmte Existenz bis zur begrifflichen Selbstorganisation fortschreiten kann, ohne Substrat, äußeren Ursprung oder vorausliegende absolute Identität anzunehmen.","refs":["MC_GB18_L1_12:AS-01","MC_GB18_L1_14:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-02","text":"Seine globale These lautet, dass immanente Negativität feste Bestimmungen nicht vernichtet, sondern in die differenzierte Selbstbeziehung konkreter Identität transformiert.","refs":["MC_GB18_L1_12:AS-02","MC_GB18_L1_14:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-03","text":"Selbstständigkeit und Äußerlichkeit werden als notwendige Vollzugsformen bewahrt, verlieren jedoch jeden Anspruch auf einen von der erzeugenden Totalität unabhängigen Bestand.","refs":["MC_GB18_L1_13:GA-01","MC_GB18_L1_14:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-04","text":"Die Bewegung führt von vermittelter Unmittelbarkeit über Ding, Erscheinung, Gesetz, Kraft und Wirklichkeit zu Modalität, Substanz, Kausalität, Freiheit und Begriff.","refs":["MC_GB18_L1_12:AS-07","MC_GB18_L1_13:AS-06","MC_GB18_L1_14:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-05","text":"Das Argument ist genetisch und rekursiv, weil jede gesetzte Selbstständigkeit ihre Gegenbestimmung hervorbringt und jedes Resultat den Sinn seines Anfangs rückwirkend verändert.","refs":["MC_GB18_L1_12:AS-06","MC_GB18_L1_14:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-06","text":"Der Fortschritt verläuft spiralförmig, kumulativ und mutationsgetrieben: Die produktive Unzulänglichkeit einer Form erzeugt jeweils die Vermittlungsweise, durch die sie überschritten und erhalten wird.","refs":["MC_GB18_L1_13:AS-07","MC_GB18_L1_14:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-07","text":"Die terminale Schließung bestimmt Freiheit als manifestierte Bedingtheit und den Begriff als innere Gliederung einer zur Subjektivität transformierten Substanz.","refs":["MC_GB18_L1_14:AS-07","MC_GB18_L1_14:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-08","text":"Diese Schließung bleibt instabil, weil die Übergänge zur geistigen beziehungsweise begrifflichen Einheit funktional verlangt, aber weder in ihrer positiven Form noch in ihrer konkreten Folge vollständig deduziert werden.","refs":["MC_GB18_L1_12:FL-07","MC_GB18_L1_13:MRT-B04","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L2_04:GA-01","text":"[Persistent] Unmittelbarkeit ist weder Ursprung noch Endzustand, sondern die Resultatform einer Vermittlung, die in ihrem Produkt verschwindet und wirksam bleibt.","refs":["MC_GB18_L1_12:GA-01","MC_GB18_L1_13:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-02","text":"[Attractor] Immanente Negativität ist der universale Transformationsoperator, durch den Grenzen, Gegenbestimmungen und Äußerlichkeit zu Bedingungen konkreterer Identität werden.","refs":["MC_GB18_L1_12:GA-02","MC_GB18_L1_14:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-03","text":"[Persistent] Identität besteht als Selbsterhaltung im Anderswerden; Differenz wird nicht nachträglich hinzugefügt, sondern erzeugt und trägt die Selbstbeziehung.","refs":["MC_GB18_L1_12:GA-10","MC_GB18_L1_13:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-04","text":"[Mutating] Äußerlichkeit mutiert vom fremden Gegenüber zur eigenen Erscheinungs-, Bedingungs- und Passivitätsform einer sich auf sich zurückbeziehenden Bewegung.","refs":["MC_GB18_L1_12:GA-04","MC_GB18_L1_13:RMD-04","MC_GB18_L1_14:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-05","text":"[Persistent] Selbstständigkeit bezeichnet keine isolierte Unabhängigkeit, sondern die vermittelte Erhaltung einer Bestimmung innerhalb des Zusammenhangs, der sie erzeugt und begrenzt.","refs":["MC_GB18_L1_12:GA-06","MC_GB18_L1_13:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-06","text":"[Mutating] Grund, Bedingung und Ursache verlieren den Status vorausliegender Fundamente und werden zu rückwirkend gesetzten Funktionen rekursiver Selbstvoraussetzung.","refs":["MC_GB18_L1_12:GA-05","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-07","text":"[Mutating] Erscheinung entwickelt sich von der Wahrheit substratloser Existenz über Selbstoffenbarung zur notwendigen Manifestationsform von Wirklichkeit und Substanz.","refs":["MC_GB18_L1_12:GA-09","MC_GB18_L1_13:GA-07","MC_GB18_L1_14:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-08","text":"[Mutating] Kausalität entsteht aus der Krise ruhiger Gesetzlichkeit, wird durch Kraft operativ und endet als reversible Rollenverteilung von Ursache, Wirkung, Aktivität und Passivität.","refs":["MC_GB18_L1_12:GA-11","MC_GB18_L1_13:RMD-03","MC_GB18_L1_14:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-09","text":"[Emergent] Wirklichkeit ist kein vorhandener Gegenstandsbereich, sondern die vollzogene Einheit von Wesen, Existenz, Erscheinung und rückwirkend gesetzten Bedingungen.","refs":["MC_GB18_L1_13:GA-07","MC_GB18_L1_14:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-10","text":"[Attractor] Totalität ist weder Aggregat noch starre Einheit, sondern die Selbstorganisation differenzierter Momente, denen sie Wirksamkeit gewährt und unabhängigen Seinsgrund entzieht.","refs":["MC_GB18_L1_12:GA-12","MC_GB18_L1_13:GA-04","MC_GB18_L1_14:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-11","text":"[Mutating] Notwendigkeit absorbiert Zufälligkeit als eigene Manifestationsbewegung und transformiert sich zur Freiheit, sobald ihre Bedingtheit als Selbstbestimmung durchsichtig wird.","refs":["MC_GB18_L1_14:GA-05","MC_GB18_L1_14:GA-06","MC_GB18_L1_14:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-12","text":"[Emergent] Substanz besteht nur in der Erzeugung, Aufhebung und Reorganisation ihrer Manifestationen und wird dadurch zur Grundlage einer nicht vorausgesetzten Subjektivität.","refs":["MC_GB18_L1_14:GA-07","MC_GB18_L1_14:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-13","text":"[Emergent] Erkenntnisform und Seinsform konvergieren, weil gültige Erklärung die Genesis der Kategorien als Selbstbewegung ihres Gegenstands rekonstruieren muss.","refs":["MC_GB18_L1_12:BSD-03","MC_GB18_L1_13:GA-08","MC_GB18_L1_14:GA-13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-14","text":"[Terminal] Der Begriff ist die Form, in der kausal verteilte Rollen als Allgemeinheit, Besonderheit und Einzelheit zu inneren Gliederungen einer subjektiven Totalität werden.","refs":["MC_GB18_L1_14:GA-11","MC_GB18_L1_14:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-15","text":"[Terminal] Die begriffliche Schließung bleibt von der konkreten Mutationssequenz abhängig und kann deren Übergänge weder durch reine Form noch durch eine unmittelbare geistige Einheit ersetzen.","refs":["MC_GB18_L1_12:FL-07","MC_GB18_L1_13:FL-05","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L2_04:RMD-01","text":"Unmittelbarkeit behält die Funktion positiver Präsenz, kehrt aber auf jeder Stufe als gesetztes Resultat einer bereits vollzogenen Vermittlung wieder.","refs":["MC_GB18_L1_12:RMD-01","MC_GB18_L1_13:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-02","text":"Äußerlichkeit wandert von dinglicher Fremdheit über Bedingung und Selbstäußerung zur internen Passivitätsstelle und bleibt nach jeder Internalisierung als neuer Vermittlungsbedarf zurück.","refs":["MC_GB18_L1_12:GA-04","MC_GB18_L1_13:RMD-04","MC_GB18_L1_14:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-03","text":"Der Grund verliert seine vorausliegende Position, wird zur Rücknahme von Äußerung und endet als Voraussetzung, die erst durch die von ihr abhängige Bewegung gesetzt wird.","refs":["MC_GB18_L1_12:RMD-02","MC_GB18_L1_13:RMD-05","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-04","text":"Eigenschaft und Form bewahren die Aufgabe, Bestimmtheit zu tragen, werden jedoch von selbstständiger Materie über Erscheinungsform bis zur entselbstständigten Artikulation der Totalität umcodiert.","refs":["MC_GB18_L1_12:RMD-04","MC_GB18_L1_13:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-05","text":"Erscheinung kehrt ihre Valenz mehrfach um: Sie wird von der Auflösung dinglicher Stabilität zur Wahrheit vermittelter Existenz, dann zum transparenten Schein und schließlich zur Selbstoffenbarung der Wirklichkeit.","refs":["MC_GB18_L1_12:RMD-07","MC_GB18_L1_13:RMD-01","MC_GB18_L1_13:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-06","text":"Gesetz, Kraft und Kausalität bilden keine identische Kategorie, sondern eine funktionale Mutation von ruhiger Stabilisierung über operative Selbstäußerung zur rekursiven Erzeugung kausaler Rollen.","refs":["MC_GB18_L1_12:RMD-09","MC_GB18_L1_13:RMD-03","MC_GB18_L1_14:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-07","text":"Totalität erweitert sich von negativer Einheit über das Absolute zur begrifflichen Selbstgliederung; dabei mutiert sie vom Attraktor aller Aufhebungen zur terminalen Organisationsform.","refs":["MC_GB18_L1_13:RMD-07","MC_GB18_L1_13:GA-10","MC_GB18_L1_14:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-08","text":"Ursache wandert von einer vorläufigen Gestalt der Selbsterhaltung über rekursive Selbstbedingung zur reversiblen Funktionsstelle und verschwindet als privilegierter Ursprung.","refs":["MC_GB18_L1_12:CGD-05","MC_GB18_L1_13:GA-06","MC_GB18_L1_14:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-09","text":"Das Subjekt mutiert vom ausgeschlossenen Ursprung über einen verteilten Rückkehrknoten zur Form, in der substantielle Vermittlung ihre Differenzen als eigene Bestimmungen organisiert.","refs":["MC_GB18_L1_12:XD-07","MC_GB18_L1_13:BSD-04","MC_GB18_L1_14:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-10","text":"Zufälligkeit kehrt ihre Valenz vom Defizit der Notwendigkeit zu deren positiver Erscheinungsform um und bereitet dadurch die Umcodierung von Notwendigkeit in Freiheit vor.","refs":["MC_GB18_L1_14:GA-05","MC_GB18_L1_14:RMD-05","MC_GB18_L1_14:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-11","text":"Ding und Materie verschwinden als tragende Kategorien, nachdem sie die Unhaltbarkeit eines eigenschaftslosen Trägers und die Abhängigkeit jeder Substanz von ihrer Manifestation freigelegt haben.","refs":["MC_GB18_L1_12:GA-08","MC_GB18_L1_12:RMD-06","MC_GB18_L1_14:GA-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L2_04:CGD-01","text":"Dinggrenze, Porosität und materielle Zusammensetzung bleiben lokale Demontageformen; auf aktueller Ebene skaliert ihr Ergebnis zur allgemeinen Ablösung der Substratontologie durch Selbstmanifestation.","refs":["MC_GB18_L1_12:CGD-04","MC_GB18_L1_14:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-02","text":"Teilbarkeit, Ganzes, Teile und Solicitation bleiben lokale Mechaniken; nach oben skaliert allein ihre Transformation äußerlicher Zusammensetzung in operative und rekursive Einheit.","refs":["MC_GB18_L1_13:CGD-01","MC_GB18_L1_13:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-03","text":"Das Gesetz bleibt eine lokale Stabilisierung der Erscheinung; aktuell relevant ist seine Ablösung durch Kraft und Kausalität als bewegte Formen immanenter Notwendigkeit.","refs":["MC_GB18_L1_12:GA-11","MC_GB18_L1_13:RMD-03","MC_GB18_L1_14:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-04","text":"Einzelne Modalitäten und konkrete Bedingungen bleiben lokal exponiert; auf dieser Ebene trägt ihre Reklassifikation als Phasen einer rückwirkenden Selbstbegründung.","refs":["MC_GB18_L1_13:CGD-04","MC_GB18_L1_14:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-05","text":"Geist und Attribut bleiben terminale Funktionsfiguren der unteren Ebene; aktuell werden sie in das umfassendere Problem einer positiven, aber nichtäußerlichen Begriffsform absorbiert.","refs":["MC_GB18_L1_13:CGD-05","MC_GB18_L1_13:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-06","text":"Gewalt und einzelne kausale Anlässe bleiben lokale Expositionsformen; ihre höherstufige Funktion liegt in der Umkehrung von Aktivität, Passivität, Bedingung und Gegenwirkung.","refs":["MC_GB18_L1_14:CGD-05","MC_GB18_L1_14:FL-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-07","text":"Erst auf aktueller Ebene werden Substratverlust, operative Kraft, modale Selbstvoraussetzung und kausale Wechselwirkung zu einer einzigen Architektur der Transformation von Substanz in Subjektivität.","refs":["MC_GB18_L1_12:MME-01","MC_GB18_L1_13:AS-04","MC_GB18_L1_14:GA-11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L2_04:GNX-01","text":"Ausgeschlossen ist jeder unvermittelte Anfang oder Endzustand, der nicht als Resultat und Moment seiner eigenen Genesis rekonstruiert werden kann.","refs":["MC_GB18_L1_12:GNX-01","MC_GB18_L1_14:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-02","text":"Ausgeschlossen sind eigenschaftslose Substrate und Zweiweltenmodelle, in denen Wesen, Substanz oder Absolutes ihren Manifestationen als fertige Träger gegenüberstehen.","refs":["MC_GB18_L1_12:GNX-03","MC_GB18_L1_13:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-03","text":"Ausgeschlossen ist ein souveränes Subjekt oder äußerer Erkenntnisstandpunkt, der die Bewegung bestimmt, ohne selbst als eines ihrer Momente bestimmt zu werden.","refs":["MC_GB18_L1_12:GNX-04","MC_GB18_L1_13:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-04","text":"Ausgeschlossen ist lineare Kausalität mit einem ersten Anstoß, unveränderter Ursache und endgültig abtrennbarer Wirkung.","refs":["MC_GB18_L1_13:GNX-02","MC_GB18_L1_14:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-05","text":"Ausgeschlossen sind sowohl differenzlose Einheit als auch eine Vielheit, deren Glieder einen von ihrer erzeugenden Totalität unabhängigen Bestand besitzen.","refs":["MC_GB18_L1_14:DBN-03","MC_GB18_L1_13:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-06","text":"Ausgeschlossen sind Zufälligkeit als Rest außerhalb der Notwendigkeit und Freiheit als bedingungslose Unterbrechung des vermittelten Zusammenhangs.","refs":["MC_GB18_L1_14:GNX-03","MC_GB18_L1_14:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-07","text":"Ausgeschlossen ist eine positive absolute Form, die bestimmt erscheinen könnte, ohne Äußerlichkeit, Selbstaufhebung oder erneute Vermittlung hervorzubringen.","refs":["MC_GB18_L1_13:GNX-05","MC_GB18_L1_13:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L2_04:DBN-01","text":"Falsch sein muss ein Modell fertiger Relata, denen Beziehungen, Eigenschaften und kausale Rollen erst nachträglich hinzugefügt werden.","refs":["MC_GB18_L1_12:DBN-01","MC_GB18_L1_14:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:DBN-02","text":"Falsch sein muss ein Verständnis von Negation als bloßer Zerstörung, weil das System sie als Produktivkraft von Bestimmtheit, Wirklichkeit und Selbstgliederung benötigt.","refs":["MC_GB18_L1_12:DBN-02","MC_GB18_L1_14:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:DBN-03","text":"Falsch sein muss die Annahme, Äußerlichkeit könne entweder autonom bestehen oder restlos verschwinden; sie muss internalisiert und zugleich als reale Vollzugsdifferenz erhalten werden.","refs":["MC_GB18_L1_12:FL-02","MC_GB18_L1_13:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:DBN-04","text":"Falsch sein muss eine Totalität als Aggregat oder vorausgesetztes Ganzes, weil Einheit erst durch die gegenseitige Erzeugung und Entselbstständigung ihrer Momente entsteht.","refs":["MC_GB18_L1_13:GA-04","MC_GB18_L1_13:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:DBN-05","text":"Falsch sein muss Erkenntnis als Repräsentation fertiger Gegenstände, da Erklärung die Genesis der Bestimmungen und ihre Rücknahme in den Gegenstand vollziehen muss.","refs":["MC_GB18_L1_14:DBN-04","MC_GB18_L1_14:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:DBN-06","text":"Falsch sein muss eine terminale Form, die von der Mutationssequenz unabhängig wäre; Freiheit und Begriff sind nur als Resultate der durchlaufenen kausalen Umkehrungen rekonstruierbar.","refs":["MC_GB18_L1_14:CGD-06","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L2_04:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist ein Außen gegenüber der Totalität, von dem aus ihre Grenzen, Ursachen oder Bestimmungen unabhängig festgestellt werden könnten.","refs":["MC_GB18_L1_12:BSA-04","MC_GB18_L1_14:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSA-02","text":"Nicht verfügbar ist ein letzter Ursprung, der wirken könnte, ohne durch Wirkung, Bedingung und Rückkehr selbst bestimmt zu werden.","refs":["MC_GB18_L1_12:BSA-01","MC_GB18_L1_14:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSA-03","text":"Nicht verfügbar ist eine Identität, die ihr Anderes nicht hervorbringen müsste und dennoch konkrete Bestimmtheit beanspruchen könnte.","refs":["MC_GB18_L1_12:BSA-03","MC_GB18_L1_14:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSA-04","text":"Die Architektur umkreist die unmögliche absolute Form, die vollständig bestimmt erscheinen und dennoch weder äußerlich noch selbstaufhebend sein könnte.","refs":["MC_GB18_L1_13:BSA-03","MC_GB18_L1_13:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSA-05","text":"Unzulässig ist eine Freiheit außerhalb der Notwendigkeit; verfügbar bleibt nur die Selbstgegenwart eines Zusammenhangs, der seine Bedingungen als eigene Wirksamkeit organisiert.","refs":["MC_GB18_L1_14:BSA-04","MC_GB18_L1_14:MME-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L2_04:XD-01","text":"Das Verschwinden des äußeren Grundes und die rückwirkende Setzung der Voraussetzung erzeugen eine grundlose Begründungsmaschine, deren Grund ausschließlich im Vollzug ihres Begründeten besteht.","refs":["MC_GB18_L2_04:GA-01","MC_GB18_L2_04:GA-06","MC_GB18_L1_12:XD-01","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-02","text":"Weil Erscheinung bereits Wahrheit vermittelter Existenz und Selbstoffenbarung der Wirklichkeit ist, wird Externalisierung zu einer ontologischen Operation statt zu einem nachträglichen Außen.","refs":["MC_GB18_L2_04:GA-04","MC_GB18_L2_04:GA-07","MC_GB18_L2_04:GA-09","MC_GB18_L1_12:GA-09","MC_GB18_L1_13:GA-07","MC_GB18_L1_14:GA-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-03","text":"Die Krise ruhiger Gesetzlichkeit, die operative Äußerung der Kraft und die Reversibilität kausaler Rollen bilden eine Eskalation von statischer Regelmäßigkeit zu rekursiver Notwendigkeit.","refs":["MC_GB18_L2_04:GA-08","MC_GB18_L2_04:GA-11","MC_GB18_L1_12:GA-11","MC_GB18_L1_13:RMD-03","MC_GB18_L1_14:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-04","text":"Die Verselbstständigung von Eigenschaft, die Verteilung von Kraft und die Selbstsetzung von Passivität zeigen gemeinsam, dass Wirksamkeit nur als organisierte Abhängigkeit entstehen kann.","refs":["MC_GB18_L2_04:GA-05","MC_GB18_L2_04:GA-08","MC_GB18_L2_04:GA-12","MC_GB18_L1_12:GA-07","MC_GB18_L1_13:AS-04","MC_GB18_L1_14:RMD-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-05","text":"Die begriffliche Schließung transformiert das Problem der absoluten Form, löst es aber nicht vollständig, weil innere Gliederung weiterhin eine positive Vermittlung von Differenz und Einheit voraussetzt.","refs":["MC_GB18_L2_04:GA-10","MC_GB18_L2_04:GA-14","MC_GB18_L2_04:GA-15","MC_GB18_L1_12:FL-07","MC_GB18_L1_13:BSA-03","MC_GB18_L1_14:RLE-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-06","text":"Das Subjekt wird weder vorausgesetzt noch lediglich entfernt, sondern entsteht aus der Verbindung dezentrierter Reflexion, verteilter Rückkehr und substantieller Selbstorganisation.","refs":["MC_GB18_L2_04:GA-12","MC_GB18_L2_04:GA-13","MC_GB18_L2_04:GA-14","MC_GB18_L1_12:XD-07","MC_GB18_L1_13:BSD-04","MC_GB18_L1_14:BSD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-07","text":"Wirklichkeit und Möglichkeit sind keine getrennten Regionen: Wirklichkeit manifestiert ihre Voraussetzungen, während Möglichkeit als rückwirkend gesetztes Bedingungsfeld in ihr fortbesteht.","refs":["MC_GB18_L2_04:GA-06","MC_GB18_L2_04:GA-09","MC_GB18_L2_04:GA-11","MC_GB18_L1_13:GA-07","MC_GB18_L1_14:GA-04","MC_GB18_L1_14:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-08","text":"Die Kombination retrospektiver Vermittlung, rekursiver Rückkehr und rückwirkender Kausalität erzeugt eine Resultatszeit, in der Späteres die Wahrheit und Wirksamkeit seines Anfangs bestimmt.","refs":["MC_GB18_L2_04:GA-01","MC_GB18_L2_04:GA-06","MC_GB18_L2_04:GA-08","MC_GB18_L1_12:BSD-05","MC_GB18_L1_13:BSD-03","MC_GB18_L1_14:BSD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-09","text":"Der Ausschluss eines souveränen Subjekts und eines äußeren Erkenntnisstandpunkts erzwingt eine immanente Methode, in der Erklärung als Artikulation der Sache selbst auftritt.","refs":["MC_GB18_L2_04:GA-12","MC_GB18_L2_04:GA-13","MC_GB18_L1_12:GNX-04","MC_GB18_L1_13:GNX-04","MC_GB18_L1_14:GA-13"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-10","text":"Sobald Zufälligkeit als Manifestationsform der Notwendigkeit gilt, kann Freiheit nicht länger deren Gegensatz sein, sondern muss die reflektierte Organisation notwendiger Bedingtheit bezeichnen.","refs":["MC_GB18_L2_04:GA-11","MC_GB18_L2_04:GA-14","MC_GB18_L1_14:GA-05","MC_GB18_L1_14:GA-06","MC_GB18_L1_14:GA-12"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L2_04:BSD-01","text":"Ontologisch primär sind rekursive Produktionsfelder, in denen Dinge, Kräfte, Modalitäten und Substanzen als vorläufige Verdichtungen einer grundlosen Selbstbegründung entstehen.","refs":["MC_GB18_L1_12:BSD-01","MC_GB18_L1_13:BSD-01","MC_GB18_L1_14:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-02","text":"Zeit ist weder lineare Folge noch bloßer Kreis, sondern eine spiralförmige Resultatsordnung, in der Umschlag und Rückkehr den Anfang transformieren.","refs":["MC_GB18_L1_12:BSD-05","MC_GB18_L1_13:BSD-03","MC_GB18_L1_14:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-03","text":"Kausalität wird zur Selbstkonditionierung eines Zusammenhangs, der Ursachen durch Wirkungen verwirklicht, seine Bedingungen erzeugt und den endlichen Regress in Wechselwirkung überführt.","refs":["MC_GB18_L1_12:BSD-02","MC_GB18_L1_13:BSD-02","MC_GB18_L1_14:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-04","text":"Das Subjekt ist das späte Organisationsformat einer Vermittlung, die zunächst objektiv verteilt ist und ihre Differenzen schließlich als eigene Bestimmungen erkennt.","refs":["MC_GB18_L1_12:BSD-04","MC_GB18_L1_13:BSD-04","MC_GB18_L1_14:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-05","text":"Handlungsmacht besteht in der selektiven Aneignung und Umbildung von Bedingungen, nicht in unvermitteltem Anfangen oder der Flucht aus Abhängigkeit.","refs":["MC_GB18_L1_12:BSD-06","MC_GB18_L1_13:HSI-04","MC_GB18_L1_14:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-06","text":"Erklärung wird genetisch: Sie ist wahr, wenn sie den Übergang rekonstruiert, durch den ein Gegenstand seine Kategorien, Voraussetzungen und Grenzen selbst hervorbringt.","refs":["MC_GB18_L1_12:BSD-03","MC_GB18_L1_13:BSD-05","MC_GB18_L1_14:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-07","text":"Systemische Schließung bedeutet keine Stillstellung, sondern die Transformation äußerer Notwendigkeit in eine begrifflich organisierte Selbstbewegung, deren Stabilität von fortgesetzter Differenzierung abhängt.","refs":["MC_GB18_L1_12:FL-06","MC_GB18_L1_14:AS-07","MC_GB18_L1_14:GA-12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L2_04:RLE-01","text":"Die Grundschleife lautet: Vermittlung erzeugt Bestimmtheit, Bestimmtheit erzeugt ihre Grenze, die Grenze externalisiert Negation, und deren Rücknahme erzeugt konkretere Identität.","refs":["MC_GB18_L1_12:RLE-01","MC_GB18_L1_13:RLE-01","MC_GB18_L1_14:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-02","text":"Äußerlichkeit zirkuliert zwischen Fremdheit und Eigenmoment, bis jede Internalisierung einen neuen äußeren Rest hervorbringt und dadurch die nächste Vermittlungsstufe erzwingt.","refs":["MC_GB18_L1_12:RLE-03","MC_GB18_L1_13:RLE-04","MC_GB18_L1_14:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-03","text":"Der Begründungskreislauf setzt Bedingungen, externalisiert sich in ihnen und gewinnt sie als eigene Voraussetzungen zurück; Grund ist daher das Resultat seines Wirkens.","refs":["MC_GB18_L1_12:RLE-02","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-04","text":"Erscheinung stabilisiert sich als Gesetz, Gesetz operationalisiert sich als Kraft, und Kraft eskaliert zur Kausalität, sobald ihre Äußerung Bedingungen und Gegenwirkungen selbst erzeugt.","refs":["MC_GB18_L1_12:RLE-05","MC_GB18_L1_13:AS-05","MC_GB18_L1_14:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-05","text":"Die Modalitätsschleife führt von realer Möglichkeit über den Widerspruch ihrer Bedingungen zur Wirklichkeit, die das Bedingungsfeld rückwirkend als eigene Voraussetzung setzt.","refs":["MC_GB18_L1_14:RLE-02","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-06","text":"Substantielle Macht differenziert sich in Ursache und Wirkung, passiviert jede fixierte Ursachposition und kollabiert über Gegenwirkung und Wechselwirkung in organisierte Selbstbestimmung.","refs":["MC_GB18_L1_14:RLE-03","MC_GB18_L1_14:RLE-04","MC_GB18_L1_14:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-07","text":"Totalität ist der dominante Attraktor, weil jede isolierte Bestimmung durch ihre Unzulänglichkeit auf den Zusammenhang verwiesen wird, der sie trägt, differenziert und entselbstständigt.","refs":["MC_GB18_L1_12:RLE-06","MC_GB18_L1_13:RLE-06","MC_GB18_L1_14:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-08","text":"Der Begriff ist der terminale Attraktor, bleibt aber eine offene Schließung, solange die Umwandlung kausaler Wechselwirkung in innere Selbstgliederung nicht eigenständig deduziert ist.","refs":["MC_GB18_L1_12:RLE-07","MC_GB18_L1_14:RLE-06","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L2_04:FGS-B01","text":"Unmittelbare Bestimmung → Freilegung verschwundener Vermittlung → Unmittelbarkeit als gesetztes Resultat.","refs":["MC_GB18_L1_12:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B02","text":"Äußerer Grund → Rückbindung an das Begründete → rückwirkend gesetzte Voraussetzung → Selbstbegründung ohne vorausliegenden Ursprung.","refs":["MC_GB18_L1_12:XD-01","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B03","text":"Ding → Eigenschaft → Materie → Auflösung der Trägergrenze → Erscheinung als manifestierte Vermittlung.","refs":["MC_GB18_L1_12:GA-08","MC_GB18_L1_12:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B04","text":"Erscheinung → Gesetz → Krise ruhiger Identität → Kraft als operative negative Einheit → reziproke Wirksamkeit.","refs":["MC_GB18_L1_12:RLE-05","MC_GB18_L1_13:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B05","text":"Kraft → Selbstäußerung → Rückkehr → Wirklichkeit als Selbstoffenbarung → absolute Selbstauslegung und Formkrise.","refs":["MC_GB18_L1_13:AS-05","MC_GB18_L1_13:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B06","text":"Möglichkeit → widersprüchliches Bedingungsfeld → rückwirkend gesetzte Wirklichkeit → Notwendigkeit → manifestierende Substanz.","refs":["MC_GB18_L1_14:GA-04","MC_GB18_L1_14:GA-06","MC_GB18_L1_14:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B07","text":"Substanz → kausale Differenzierung → Ursache/Wirkung-Umkehrung → Selbstvoraussetzung → Gegenwirkung → Wechselwirkung.","refs":["MC_GB18_L1_14:GA-08","MC_GB18_L1_14:GA-10","MC_GB18_L1_14:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B08","text":"Wechselwirkung → manifestierte Notwendigkeit → Freiheit → Begriff als subjektive Selbstgliederung, deren Form von der vorausgehenden Sequenz getragen bleibt.","refs":["MC_GB18_L1_14:GA-12","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L2_04:AFM-B01","text":"Vermittelte Unmittelbarkeit → dingliche Externalisierung → Verselbstständigung der Eigenschaft → materielle Porosität → Substratverlust.","refs":["MC_GB18_L1_12:AS-07","MC_GB18_L1_12:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AFM-B02","text":"Substratverlust → Erscheinung als Wahrheit → Gesetz als Stabilisierung → Aufnahme der negativen Bewegung.","refs":["MC_GB18_L1_12:AS-04","MC_GB18_L1_12:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AFM-B03","text":"Wesentliches Verhältnis → Teil-Ganzes-Antinomie → Kraft → reziproke Wirksamkeit → Wirklichkeit als Selbstoffenbarung.","refs":["MC_GB18_L1_13:AS-03","MC_GB18_L1_13:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AFM-B04","text":"Wirklichkeit → immanente Auslegung → Absolutes → attributive Form → Selbstaufhebung der Form → erneuter Äußerlichkeitsrest.","refs":["MC_GB18_L1_13:AS-06","MC_GB18_L1_13:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AFM-B05","text":"Reale Möglichkeit → widersprüchliche Bedingungen → absolute Notwendigkeit → Substanz als manifestierende Macht.","refs":["MC_GB18_L1_14:RLE-02","MC_GB18_L1_14:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AFM-B06","text":"Substantielle Macht → Ursache und Wirkung → kausaler Regress → Selbstvoraussetzung → Gegenwirkung → Wechselwirkung → Freiheit → Begriff.","refs":["MC_GB18_L1_14:XD-03","MC_GB18_L1_14:GA-11","MC_GB18_L1_14:GA-12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L2_04:MME-01","text":"Das Begriffsfeld wird von Dingen, Substraten und hierarchischen Gründen zu rekursiven Produktionsfeldern umkartiert, in denen Träger aus ihren Relationen hervorgehen.","refs":["MC_GB18_L1_12:MME-01","MC_GB18_L1_13:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-02","text":"Innen und Außen bilden keine ontologische Alternative mehr; Äußerlichkeit wird zur notwendigen, wiederholt zu internalisierenden Vollzugsdifferenz.","refs":["MC_GB18_L1_12:MME-02","MC_GB18_L1_13:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-03","text":"Erscheinung und Wahrheit wechseln ihre Rangordnung: Erscheinung wird zum Ort, an dem vermittelte Realität ihre Genesis und Selbstoffenbarung vollzieht.","refs":["MC_GB18_L1_12:MME-04","MC_GB18_L1_13:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-04","text":"Möglichkeit, Zufälligkeit und Notwendigkeit werden von getrennten Modalbereichen zu ineinandergreifenden Phasen einer sich selbst voraussetzenden Wirklichkeit.","refs":["MC_GB18_L1_14:MME-02","MC_GB18_L1_14:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-05","text":"Ursache und Wirkung werden von Entitäten oder festen Ereignispositionen zu reversiblen Funktionsstellen eines rekursiven Wirkungszusammenhangs reklassifiziert.","refs":["MC_GB18_L1_13:MME-03","MC_GB18_L1_14:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-06","text":"Notwendigkeit und Freiheit bilden keinen Gegensatz mehr; Freiheit bezeichnet die begrifflich organisierte Manifestation notwendiger Bedingtheit.","refs":["MC_GB18_L1_14:MME-06","MC_GB18_L1_14:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-07","text":"Subjekt und Objekt werden zu asymmetrischen Momenten einer immanenten Rekonstruktion, in der Erkenntnis weder äußere Prädikation noch souveräne Hervorbringung ist.","refs":["MC_GB18_L1_12:MME-03","MC_GB18_L1_13:MME-05","MC_GB18_L1_14:GA-13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L2_04:ALT-B01","text":"Auf der Surface level erscheinen Ding, Erscheinung, Gesetz, Kraft, Wirklichkeit, Modalität, Substanz, Kausalität, Freiheit und Begriff als sukzessiv instabile Gegenstände.","refs":["MC_GB18_L1_12:ALT-B01","MC_GB18_L1_14:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:ALT-B02","text":"Auf der Structural level organisieren Negation, Setzung, Externalisierung, Rückkehr, Umkehrung und Selbstvoraussetzung alle Gegenstände als Phasen einer Vermittlungslogik.","refs":["MC_GB18_L1_13:ALT-B02","MC_GB18_L1_14:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:ALT-B03","text":"Auf der Metastrategic level ersetzt die Rekonstruktion gegenseitiger Erzeugung sowohl die Wahl zwischen Gegensatzseiten als auch die Suche nach äußeren Gründen.","refs":["MC_GB18_L1_13:ALT-B03","MC_GB18_L1_14:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:ALT-B04","text":"Auf der Ontological / Temporal level ist Realität selbstwirkende Vermittlung, während Zeit die rekursive Ordnung rückwirkend gesetzter Anfänge und verwirklichter Ursachen bildet.","refs":["MC_GB18_L1_12:ALT-B04","MC_GB18_L1_14:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:ALT-B05","text":"Auf der Methodological / Performative level vollzieht die Darstellung ihre Ontologie, indem sie jede feste Bestimmung in Grenze, Gegenbestimmung und vermittelte Rückkehr überführt.","refs":["MC_GB18_L1_12:ALT-B05","MC_GB18_L1_14:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L2_04:FL-01","text":"Vermittlung muss verschwinden, um Unmittelbarkeit hervorzubringen, und fortbestehen, um deren Wahrheit zu tragen; ihre Wirksamkeit besitzt daher die Form einer operativen Abwesenheit.","refs":["MC_GB18_L1_12:FL-01","MC_GB18_L1_12:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-02","text":"Äußerlichkeit darf weder autonome Fremdsphäre noch bloßer Schein sein, muss aber in jeder Selbstbeziehung als reale Bedingung und Vollzugsdifferenz erhalten bleiben.","refs":["MC_GB18_L1_12:FL-02","MC_GB18_L1_13:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-03","text":"Differenz muss wirksam bleiben und zugleich jeden unabhängigen Seinsgrund verlieren; Bewahrung und Entmächtigung lassen sich nicht vollständig zur Deckung bringen.","refs":["MC_GB18_L1_13:FL-02","MC_GB18_L1_14:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-04","text":"Das Absolute soll vollendet sein und wird dennoch durch Auslegung, Manifestation und Rückkehr als operative Selbsterzeugung dargestellt.","refs":["MC_GB18_L1_13:FL-03","MC_GB18_L1_13:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-05","text":"Eine absolute Form soll den ganzen Inhalt ausdrücken, verliert jedoch gerade durch diese Totalisierung ihren selbstständigen Bestand; Ausdruckskraft und ontologische Nichtigkeit fallen zusammen.","refs":["MC_GB18_L1_13:FL-04","MC_GB18_L1_13:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-06","text":"Kausale Selbstbestimmung benötigt andere Kräfte, Bedingungen und Wirkungen, sodass Autonomie nur als konstitutiv bedingte Abhängigkeit formulierbar bleibt.","refs":["MC_GB18_L1_13:FL-01","MC_GB18_L1_14:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-07","text":"Der Übergang von Wechselwirkung zum Begriff setzt voraus, dass Übergehen in Anderes bereits Reflexion in sich ist, ohne diese Gleichsetzung vollständig abzuleiten.","refs":["MC_GB18_L1_14:FL-06","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-08","text":"Die Architektur erzeugt die Form konkreter Selbstvermittlung zuverlässiger als deren bestimmten Inhalt; die Genesis vollständiger Bedingungsfelder bleibt unterbestimmt.","refs":["MC_GB18_L1_14:FL-02","MC_GB18_L1_14:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MP-01","text":"Erscheinung mutiert von der Diagnose substratloser Dingheit zur positiven Wahrheit, zum transparenten Schein und zur Selbstoffenbarung der Wirklichkeit.","refs":["MC_GB18_L1_12:MP-04","MC_GB18_L1_13:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MP-02","text":"Äußerlichkeit mutiert vom unabhängigen Außen über gesetzte Bedingung und eigene Äußerung zur passiven Innenstelle organisierter Selbstwirksamkeit.","refs":["MC_GB18_L1_13:MP-01","MC_GB18_L1_14:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MP-03","text":"Kausalität mutiert von lokaler Ursache über reziproke Kraft zur Selbstvoraussetzung und verliert in der Wechselwirkung ihre feste Zweiheit.","refs":["MC_GB18_L1_13:MP-03","MC_GB18_L1_14:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MP-04","text":"Notwendigkeit mutiert von der Aufhebung isolierter Modalitäten zur manifesten Bedingtheit, deren reflektierte Gestalt Freiheit heißt.","refs":["MC_GB18_L1_14:GA-06","MC_GB18_L1_14:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MP-05","text":"Substanz mutiert von manifestierender Macht zu Subjektivität, sobald ihre kausalen Differenzen als innere Gliederungen statt als äußere Rollen organisiert werden.","refs":["MC_GB18_L1_14:MP-03","MC_GB18_L1_14:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L2_04:HSI-01","text":"Realität erscheint als selbstdifferenzierende Vermittlungsmaschine, die ihre Träger, Bedingungen, Außenseiten und Relationen erzeugt, externalisiert und als innere Organisationsformen zurücknimmt.","refs":["MC_GB18_L1_12:HSI-01","MC_GB18_L1_13:HSI-01","MC_GB18_L1_14:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:HSI-02","text":"Das Subjekt ist kein Betreiber außerhalb der Maschine, sondern ihre späte Rückkehrform, in der verteilte Differenzen als eigene Bestimmungen organisiert werden.","refs":["MC_GB18_L1_12:HSI-02","MC_GB18_L1_13:HSI-02","MC_GB18_L1_14:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:HSI-03","text":"Zeit ist eine spiralförmige Rückkehrszeit, in der Resultate ihre Anfänge setzen, Wirkungen Ursachen verwirklichen und Wiederkehr nur als Transformation möglich ist.","refs":["MC_GB18_L1_12:HSI-03","MC_GB18_L1_13:HSI-03","MC_GB18_L1_14:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:HSI-04","text":"Mögliche Navigation besteht weder in Flucht noch Ursprungssuche, sondern in der immanenten Umbildung von Bedingungen, Rollen und Externalisierungen zu Formen organisierter Selbstbestimmung.","refs":["MC_GB18_L1_12:HSI-04","MC_GB18_L1_13:HSI-04","MC_GB18_L1_14:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L2_04:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von vermittelter Existenz über Erscheinung, Kraft und Wirklichkeit bis zu Modalität, Kausalität, Freiheit und Begriff zu rekonstruieren.","refs":["MC_GB18_L1_12:MRT-B01","MC_GB18_L1_13:MRT-B01","MC_GB18_L1_14:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MRT-B02","text":"Die Architektur ist am stärksten in der wiederholten Umwandlung äußerlicher Andersheit in produktive Selbstunterscheidung und rückwirkende Selbstvoraussetzung.","refs":["MC_GB18_L1_12:MRT-B04","MC_GB18_L1_14:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MRT-B03","text":"Das System bleibt kohärent, sofern Aufhebung als bewahrende Entselbstständigung, Notwendigkeit als manifestierte Bedingtheit und Begriff als Resultat rekursiver Vermittlung gelesen werden.","refs":["MC_GB18_L1_13:MRT-B03","MC_GB18_L1_14:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MRT-B04","text":"Unterbestimmt bleiben die Genesis konkreter Inhaltsbestimmtheit, die positive Form des Absoluten sowie die Übergänge von Gesetz zu Kraft, von Wechselwirkung zu Begriff und von dezentrierter Reflexion zu Geist.","refs":["MC_GB18_L1_12:MRT-B02","MC_GB18_L1_13:MRT-B02","MC_GB18_L1_14:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MRT-B05","text":"Irreduzibel bleibt die konkrete Mutationssequenz: Isolierte Axiome können die Maschine nicht rekonstruieren, wenn sie deren rekursive Rückkehr, produktive Spannung und kategoriale Folge verlieren.","refs":["MC_GB18_L1_12:MRT-B05","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T124439647766Z_75b95fda","language_code":"en","language_name":"English","title":"Gb18 L2 04","source_sha256":"996ac4f449490e5e24414b55dee55067841165e8c38c2649bdb9c4b031688b9c","sha256":"a34aa3df3d643ec964460c6e507d5b5aaa083bfc75ef1f0403f7191486cc97cf","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:44:39.649629+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L2_04:AS-01","text":"The system reconstructs how determinate existence can advance to conceptual self-organization without assuming a substrate, external origin, or antecedent absolute identity.","refs":["MC_GB18_L1_12:AS-01","MC_GB18_L1_14:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-02","text":"Its global thesis is that immanent negativity does not destroy fixed determinations, but transforms them into the differentiated self-relation of concrete identity.","refs":["MC_GB18_L1_12:AS-02","MC_GB18_L1_14:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-03","text":"Independence and externality are preserved as necessary forms of enactment, yet lose every claim to a subsistence independent of the producing totality.","refs":["MC_GB18_L1_13:GA-01","MC_GB18_L1_14:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-04","text":"The movement leads from mediated immediacy through thing, appearance, law, force, and actuality to modality, substance, causality, freedom, and concept.","refs":["MC_GB18_L1_12:AS-07","MC_GB18_L1_13:AS-06","MC_GB18_L1_14:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-05","text":"The argument is genetic and recursive, because every posited independence brings forth its counter-determination and every result retroactively changes the meaning of its beginning.","refs":["MC_GB18_L1_12:AS-06","MC_GB18_L1_14:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-06","text":"The progress proceeds spirally, cumulatively, and mutation-driven: the productive inadequacy of a form generates in each case the mode of mediation through which it is surpassed and preserved.","refs":["MC_GB18_L1_13:AS-07","MC_GB18_L1_14:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-07","text":"The terminal closure determines freedom as manifested conditionedness and the concept as the inner articulation of a substance transformed into subjectivity.","refs":["MC_GB18_L1_14:AS-07","MC_GB18_L1_14:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AS-08","text":"This closure remains unstable because the transitions to spiritual or conceptual unity are functionally required, but are not fully deduced either in their positive form or in their concrete consequence.","refs":["MC_GB18_L1_12:FL-07","MC_GB18_L1_13:MRT-B04","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L2_04:GA-01","text":"[Persistent] Immediacy is neither origin nor end state, but the result-form of a mediation that disappears in its product and remains efficacious.","refs":["MC_GB18_L1_12:GA-01","MC_GB18_L1_13:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-02","text":"[Attractor] Immanent negativity is the universal transformation operator through which limits, counter-determinations, and externality become conditions of more concrete identity.","refs":["MC_GB18_L1_12:GA-02","MC_GB18_L1_14:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-03","text":"[Persistent] Identity consists as self-preservation in becoming-other; difference is not subsequently added, but produces and sustains self-relation.","refs":["MC_GB18_L1_12:GA-10","MC_GB18_L1_13:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-04","text":"[Mutating] Externality mutates from alien counterpart into the proper form of appearance, condition, and passivity of a movement relating back to itself.","refs":["MC_GB18_L1_12:GA-04","MC_GB18_L1_13:RMD-04","MC_GB18_L1_14:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-05","text":"[Persistent] Independence denotes not isolated autonomy, but the mediated preservation of a determination within the context that produces and limits it.","refs":["MC_GB18_L1_12:GA-06","MC_GB18_L1_13:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-06","text":"[Mutating] Ground, condition, and cause lose the status of antecedent foundations and become retroactively posited functions of recursive self-presupposition.","refs":["MC_GB18_L1_12:GA-05","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-07","text":"[Mutating] Appearance develops from the truth of substrate-less existence through self-revelation into the necessary form of manifestation of actuality and substance.","refs":["MC_GB18_L1_12:GA-09","MC_GB18_L1_13:GA-07","MC_GB18_L1_14:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-08","text":"[Mutating] Causality arises from the crisis of tranquil lawfulness, becomes operative through force, and ends as a reversible distribution of roles among cause, effect, activity, and passivity.","refs":["MC_GB18_L1_12:GA-11","MC_GB18_L1_13:RMD-03","MC_GB18_L1_14:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-09","text":"[Emergent] Actuality is not a given domain of objects, but the enacted unity of essence, existence, appearance, and retroactively posited conditions.","refs":["MC_GB18_L1_13:GA-07","MC_GB18_L1_14:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-10","text":"[Attractor] Totality is neither aggregate nor rigid unity, but the self-organization of differentiated moments to which it grants efficacy and from which it withdraws independent ground of being.","refs":["MC_GB18_L1_12:GA-12","MC_GB18_L1_13:GA-04","MC_GB18_L1_14:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-11","text":"[Mutating] Necessity absorbs contingency as its own movement of manifestation and transforms into freedom once its conditionedness becomes transparent as self-determination.","refs":["MC_GB18_L1_14:GA-05","MC_GB18_L1_14:GA-06","MC_GB18_L1_14:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-12","text":"[Emergent] Substance exists only in the production, sublation, and reorganization of its manifestations and thereby becomes the basis of a non-presupposed subjectivity.","refs":["MC_GB18_L1_14:GA-07","MC_GB18_L1_14:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-13","text":"[Emergent] Form of cognition and form of being converge because valid explanation must reconstruct the genesis of categories as the self-movement of its object.","refs":["MC_GB18_L1_12:BSD-03","MC_GB18_L1_13:GA-08","MC_GB18_L1_14:GA-13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-14","text":"[Terminal] The concept is the form in which causally distributed roles become, as universality, particularity, and singularity, inner articulations of a subjective totality.","refs":["MC_GB18_L1_14:GA-11","MC_GB18_L1_14:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GA-15","text":"[Terminal] Conceptual closure remains dependent on the concrete mutation sequence and can replace neither its transitions by pure form nor by an immediate spiritual unity.","refs":["MC_GB18_L1_12:FL-07","MC_GB18_L1_13:FL-05","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L2_04:RMD-01","text":"Immediacy retains the function of positive presence, but recurs at every level as the posited result of an already enacted mediation.","refs":["MC_GB18_L1_12:RMD-01","MC_GB18_L1_13:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-02","text":"Externality migrates from thingly alienness through condition and self-expression to the internal position of passivity, and after every internalization remains as a new need for mediation.","refs":["MC_GB18_L1_12:GA-04","MC_GB18_L1_13:RMD-04","MC_GB18_L1_14:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-03","text":"Ground loses its antecedent position, becomes the withdrawal of expression, and ends as a presupposition that is posited only through the movement dependent on it.","refs":["MC_GB18_L1_12:RMD-02","MC_GB18_L1_13:RMD-05","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-04","text":"Property and form preserve the task of bearing determinacy, but are recoded from independent matter through form of appearance to de-autonomized articulation of totality.","refs":["MC_GB18_L1_12:RMD-04","MC_GB18_L1_13:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-05","text":"Appearance reverses its valence several times: it becomes from the dissolution of thingly stability the truth of mediated existence, then transparent semblance, and finally the self-revelation of actuality.","refs":["MC_GB18_L1_12:RMD-07","MC_GB18_L1_13:RMD-01","MC_GB18_L1_13:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-06","text":"Law, force, and causality do not form an identical category, but a functional mutation from tranquil stabilization through operative self-expression to the recursive production of causal roles.","refs":["MC_GB18_L1_12:RMD-09","MC_GB18_L1_13:RMD-03","MC_GB18_L1_14:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-07","text":"Totality expands from negative unity through the Absolute to conceptual self-articulation; in so doing, it mutates from the attractor of all sublations into the terminal organizational form.","refs":["MC_GB18_L1_13:RMD-07","MC_GB18_L1_13:GA-10","MC_GB18_L1_14:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-08","text":"Cause migrates from a provisional shape of self-preservation through recursive self-conditioning to a reversible functional position and disappears as privileged origin.","refs":["MC_GB18_L1_12:CGD-05","MC_GB18_L1_13:GA-06","MC_GB18_L1_14:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-09","text":"The subject mutates from the excluded origin through a distributed node of return into the form in which substantial mediation organizes its differences as its own determinations.","refs":["MC_GB18_L1_12:XD-07","MC_GB18_L1_13:BSD-04","MC_GB18_L1_14:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-10","text":"Contingency reverses its valence from the deficit of necessity to its positive form of appearance and thereby prepares the recoding of necessity into freedom.","refs":["MC_GB18_L1_14:GA-05","MC_GB18_L1_14:RMD-05","MC_GB18_L1_14:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RMD-11","text":"Thing and matter disappear as supporting categories after they have exposed the untenability of a propertyless bearer and the dependence of every substance on its manifestation.","refs":["MC_GB18_L1_12:GA-08","MC_GB18_L1_12:RMD-06","MC_GB18_L1_14:GA-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L2_04:CGD-01","text":"Thing-boundary, porosity, and material composition remain local forms of dismantling; at the current level, their result scales into the general replacement of substrate ontology by self-manifestation.","refs":["MC_GB18_L1_12:CGD-04","MC_GB18_L1_14:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-02","text":"Divisibility, whole, parts, and Solicitation remain local mechanics; what alone scales upward is their transformation of external composition into operative and recursive unity.","refs":["MC_GB18_L1_13:CGD-01","MC_GB18_L1_13:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-03","text":"Law remains a local stabilization of appearance; currently relevant is its replacement by force and causality as moving forms of immanent necessity.","refs":["MC_GB18_L1_12:GA-11","MC_GB18_L1_13:RMD-03","MC_GB18_L1_14:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-04","text":"Individual modalities and concrete conditions remain locally exposed; at this level, their reclassification as phases of a retroactive self-grounding is determinative.","refs":["MC_GB18_L1_13:CGD-04","MC_GB18_L1_14:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-05","text":"Spirit and attribute remain terminal functional figures of the lower level; currently they are absorbed into the more comprehensive problem of a positive, yet non-external conceptual form.","refs":["MC_GB18_L1_13:CGD-05","MC_GB18_L1_13:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-06","text":"Violence and individual causal occasions remain local forms of exposition; their higher-level function lies in the reversal of activity, passivity, condition, and counteraction.","refs":["MC_GB18_L1_14:CGD-05","MC_GB18_L1_14:FL-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:CGD-07","text":"Only at the current level do loss of substrate, operative force, modal self-presupposition, and causal interaction become a single architecture of the transformation of substance into subjectivity.","refs":["MC_GB18_L1_12:MME-01","MC_GB18_L1_13:AS-04","MC_GB18_L1_14:GA-11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L2_04:GNX-01","text":"Excluded is every unmediated beginning or end state that cannot be reconstructed as result and moment of its own genesis.","refs":["MC_GB18_L1_12:GNX-01","MC_GB18_L1_14:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-02","text":"Excluded are propertyless substrates and two-world models in which essence, substance, or Absolute stand opposed to their manifestations as finished bearers.","refs":["MC_GB18_L1_12:GNX-03","MC_GB18_L1_13:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-03","text":"Excluded is a sovereign subject or external standpoint of cognition that determines the movement without itself being determined as one of its moments.","refs":["MC_GB18_L1_12:GNX-04","MC_GB18_L1_13:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-04","text":"Excluded is linear causality with a first impulse, unaltered cause, and definitively separable effect.","refs":["MC_GB18_L1_13:GNX-02","MC_GB18_L1_14:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-05","text":"Excluded are both difference-less unity and a multiplicity whose members possess a subsistence independent of their producing totality.","refs":["MC_GB18_L1_14:DBN-03","MC_GB18_L1_13:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-06","text":"Excluded are contingency as a remainder outside necessity and freedom as an unconditional interruption of the mediated connection.","refs":["MC_GB18_L1_14:GNX-03","MC_GB18_L1_14:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:GNX-07","text":"Excluded is a positive absolute form that could appear determinate without bringing forth externality, self-sublation, or renewed mediation.","refs":["MC_GB18_L1_13:GNX-05","MC_GB18_L1_13:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L2_04:DBN-01","text":"False must be a model of finished relata to which relations, properties, and causal roles are added only subsequently.","refs":["MC_GB18_L1_12:DBN-01","MC_GB18_L1_14:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:DBN-02","text":"False must be an understanding of negation as mere destruction, because the system requires it as the productive force of determinacy, actuality, and self-articulation.","refs":["MC_GB18_L1_12:DBN-02","MC_GB18_L1_14:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:DBN-03","text":"False must be the assumption that externality can either subsist autonomously or disappear without remainder; it must be internalized and simultaneously preserved as a real difference of enactment.","refs":["MC_GB18_L1_12:FL-02","MC_GB18_L1_13:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:DBN-04","text":"False must be totality as aggregate or presupposed whole, because unity arises only through the reciprocal production and de-autonomization of its moments.","refs":["MC_GB18_L1_13:GA-04","MC_GB18_L1_13:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:DBN-05","text":"False must be cognition as representation of finished objects, since explanation must enact the genesis of determinations and their withdrawal into the object.","refs":["MC_GB18_L1_14:DBN-04","MC_GB18_L1_14:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:DBN-06","text":"False must be a terminal form independent of the mutation sequence; freedom and concept are reconstructible only as results of the traversed causal reversals.","refs":["MC_GB18_L1_14:CGD-06","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L2_04:BSA-01","text":"The deepest excluded possibility is an outside in relation to totality, from which its limits, causes, or determinations could be established independently.","refs":["MC_GB18_L1_12:BSA-04","MC_GB18_L1_14:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSA-02","text":"Unavailable is a final origin that could act without itself being determined through effect, condition, and return.","refs":["MC_GB18_L1_12:BSA-01","MC_GB18_L1_14:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSA-03","text":"Unavailable is an identity that would not have to bring forth its other and could nevertheless claim concrete determinacy.","refs":["MC_GB18_L1_12:BSA-03","MC_GB18_L1_14:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSA-04","text":"The architecture circles around the impossible absolute form that could appear fully determinate and yet be neither external nor self-sublating.","refs":["MC_GB18_L1_13:BSA-03","MC_GB18_L1_13:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSA-05","text":"Impermissible is a freedom outside necessity; what remains available is only the self-presence of a connection that organizes its conditions as its own efficacy.","refs":["MC_GB18_L1_14:BSA-04","MC_GB18_L1_14:MME-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L2_04:XD-01","text":"The disappearance of external ground and the retroactive positing of presupposition produce a groundless machine of grounding whose ground consists exclusively in the enactment of what it grounds.","refs":["MC_GB18_L2_04:GA-01","MC_GB18_L2_04:GA-06","MC_GB18_L1_12:XD-01","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-02","text":"Because appearance is already the truth of mediated existence and the self-revelation of actuality, externalization becomes an ontological operation rather than a subsequently added outside.","refs":["MC_GB18_L2_04:GA-04","MC_GB18_L2_04:GA-07","MC_GB18_L2_04:GA-09","MC_GB18_L1_12:GA-09","MC_GB18_L1_13:GA-07","MC_GB18_L1_14:GA-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-03","text":"The crisis of tranquil lawfulness, the operative expression of force, and the reversibility of causal roles form an escalation from static regularity to recursive necessity.","refs":["MC_GB18_L2_04:GA-08","MC_GB18_L2_04:GA-11","MC_GB18_L1_12:GA-11","MC_GB18_L1_13:RMD-03","MC_GB18_L1_14:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-04","text":"The autonomization of property, the distribution of force, and the self-positing of passivity jointly show that efficacy can arise only as organized dependence.","refs":["MC_GB18_L2_04:GA-05","MC_GB18_L2_04:GA-08","MC_GB18_L2_04:GA-12","MC_GB18_L1_12:GA-07","MC_GB18_L1_13:AS-04","MC_GB18_L1_14:RMD-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-05","text":"Conceptual closure transforms the problem of absolute form, but does not fully resolve it, because inner articulation still presupposes a positive mediation of difference and unity.","refs":["MC_GB18_L2_04:GA-10","MC_GB18_L2_04:GA-14","MC_GB18_L2_04:GA-15","MC_GB18_L1_12:FL-07","MC_GB18_L1_13:BSA-03","MC_GB18_L1_14:RLE-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-06","text":"The subject is neither presupposed nor merely removed, but arises from the conjunction of decentered reflection, distributed return, and substantial self-organization.","refs":["MC_GB18_L2_04:GA-12","MC_GB18_L2_04:GA-13","MC_GB18_L2_04:GA-14","MC_GB18_L1_12:XD-07","MC_GB18_L1_13:BSD-04","MC_GB18_L1_14:BSD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-07","text":"Actuality and possibility are not separate regions: actuality manifests its presuppositions, while possibility persists within it as a retroactively posited field of conditions.","refs":["MC_GB18_L2_04:GA-06","MC_GB18_L2_04:GA-09","MC_GB18_L2_04:GA-11","MC_GB18_L1_13:GA-07","MC_GB18_L1_14:GA-04","MC_GB18_L1_14:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-08","text":"The combination of retrospective mediation, recursive return, and retroactive causality produces a result-time in which what comes later determines the truth and efficacy of its beginning.","refs":["MC_GB18_L2_04:GA-01","MC_GB18_L2_04:GA-06","MC_GB18_L2_04:GA-08","MC_GB18_L1_12:BSD-05","MC_GB18_L1_13:BSD-03","MC_GB18_L1_14:BSD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-09","text":"The exclusion of a sovereign subject and an external standpoint of cognition compels an immanent method in which explanation appears as articulation of the matter itself.","refs":["MC_GB18_L2_04:GA-12","MC_GB18_L2_04:GA-13","MC_GB18_L1_12:GNX-04","MC_GB18_L1_13:GNX-04","MC_GB18_L1_14:GA-13"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L2_04:XD-10","text":"Once contingency counts as a form of manifestation of necessity, freedom can no longer be its opposite, but must denote the reflected organization of necessary conditionedness.","refs":["MC_GB18_L2_04:GA-11","MC_GB18_L2_04:GA-14","MC_GB18_L1_14:GA-05","MC_GB18_L1_14:GA-06","MC_GB18_L1_14:GA-12"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L2_04:BSD-01","text":"Ontologically primary are recursive fields of production in which things, forces, modalities, and substances arise as provisional condensations of a groundless self-grounding.","refs":["MC_GB18_L1_12:BSD-01","MC_GB18_L1_13:BSD-01","MC_GB18_L1_14:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-02","text":"Time is neither linear succession nor mere circle, but a spiral result-order in which reversal and return transform the beginning.","refs":["MC_GB18_L1_12:BSD-05","MC_GB18_L1_13:BSD-03","MC_GB18_L1_14:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-03","text":"Causality becomes the self-conditioning of a connection that actualizes causes through effects, produces its conditions, and transfers infinite regress into interaction.","refs":["MC_GB18_L1_12:BSD-02","MC_GB18_L1_13:BSD-02","MC_GB18_L1_14:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-04","text":"The subject is the late organizational format of a mediation that is initially objectively distributed and ultimately recognizes its differences as its own determinations.","refs":["MC_GB18_L1_12:BSD-04","MC_GB18_L1_13:BSD-04","MC_GB18_L1_14:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-05","text":"Agency consists in the selective appropriation and transformation of conditions, not in unmediated beginning or escape from dependence.","refs":["MC_GB18_L1_12:BSD-06","MC_GB18_L1_13:HSI-04","MC_GB18_L1_14:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-06","text":"Explanation becomes genetic: it is true when it reconstructs the transition through which an object itself brings forth its categories, presuppositions, and limits.","refs":["MC_GB18_L1_12:BSD-03","MC_GB18_L1_13:BSD-05","MC_GB18_L1_14:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:BSD-07","text":"Systemic closure means not immobilization, but the transformation of external necessity into a conceptually organized self-movement whose stability depends on continued differentiation.","refs":["MC_GB18_L1_12:FL-06","MC_GB18_L1_14:AS-07","MC_GB18_L1_14:GA-12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L2_04:RLE-01","text":"The basic loop is: mediation produces determinacy, determinacy produces its limit, the limit externalizes negation, and its withdrawal produces more concrete identity.","refs":["MC_GB18_L1_12:RLE-01","MC_GB18_L1_13:RLE-01","MC_GB18_L1_14:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-02","text":"Externality circulates between alienness and proper moment until every internalization produces a new external remainder and thereby compels the next level of mediation.","refs":["MC_GB18_L1_12:RLE-03","MC_GB18_L1_13:RLE-04","MC_GB18_L1_14:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-03","text":"The cycle of grounding posits conditions, externalizes itself in them, and regains them as its own presuppositions; ground is therefore the result of its efficacy.","refs":["MC_GB18_L1_12:RLE-02","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-04","text":"Appearance stabilizes itself as law, law operationalizes itself as force, and force escalates into causality once its expression itself produces conditions and counteractions.","refs":["MC_GB18_L1_12:RLE-05","MC_GB18_L1_13:AS-05","MC_GB18_L1_14:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-05","text":"The modality loop leads from real possibility through the contradiction of its conditions to actuality, which retroactively posits the field of conditions as its own presupposition.","refs":["MC_GB18_L1_14:RLE-02","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-06","text":"Substantial power differentiates itself into cause and effect, renders every fixed causal position passive, and collapses through counteraction and interaction into organized self-determination.","refs":["MC_GB18_L1_14:RLE-03","MC_GB18_L1_14:RLE-04","MC_GB18_L1_14:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-07","text":"Totality is the dominant attractor because every isolated determination is referred by its inadequacy to the connection that sustains, differentiates, and de-autonomizes it.","refs":["MC_GB18_L1_12:RLE-06","MC_GB18_L1_13:RLE-06","MC_GB18_L1_14:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:RLE-08","text":"The concept is the terminal attractor, but remains an open closure as long as the transformation of causal interaction into inner self-articulation is not independently deduced.","refs":["MC_GB18_L1_12:RLE-07","MC_GB18_L1_14:RLE-06","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L2_04:FGS-B01","text":"Immediate determination → disclosure of vanished mediation → immediacy as posited result.","refs":["MC_GB18_L1_12:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B02","text":"External ground → reconnection to what is grounded → retroactively posited presupposition → self-grounding without antecedent origin.","refs":["MC_GB18_L1_12:XD-01","MC_GB18_L1_14:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B03","text":"Thing → property → matter → dissolution of the bearer-boundary → appearance as manifested mediation.","refs":["MC_GB18_L1_12:GA-08","MC_GB18_L1_12:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B04","text":"Appearance → law → crisis of tranquil identity → force as operative negative unity → reciprocal efficacy.","refs":["MC_GB18_L1_12:RLE-05","MC_GB18_L1_13:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B05","text":"Force → self-expression → return → actuality as self-revelation → absolute self-interpretation and crisis of form.","refs":["MC_GB18_L1_13:AS-05","MC_GB18_L1_13:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B06","text":"Possibility → contradictory field of conditions → retroactively posited actuality → necessity → manifesting substance.","refs":["MC_GB18_L1_14:GA-04","MC_GB18_L1_14:GA-06","MC_GB18_L1_14:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B07","text":"Substance → causal differentiation → cause/effect reversal → self-presupposition → counteraction → interaction.","refs":["MC_GB18_L1_14:GA-08","MC_GB18_L1_14:GA-10","MC_GB18_L1_14:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FGS-B08","text":"Interaction → manifested necessity → freedom → concept as subjective self-articulation, whose form remains borne by the preceding sequence.","refs":["MC_GB18_L1_14:GA-12","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L2_04:AFM-B01","text":"Mediated immediacy → thingly externalization → autonomization of property → material porosity → loss of substrate.","refs":["MC_GB18_L1_12:AS-07","MC_GB18_L1_12:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AFM-B02","text":"Loss of substrate → appearance as truth → law as stabilization → incorporation of negative movement.","refs":["MC_GB18_L1_12:AS-04","MC_GB18_L1_12:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AFM-B03","text":"Essential relation → part-whole antinomy → force → reciprocal efficacy → actuality as self-revelation.","refs":["MC_GB18_L1_13:AS-03","MC_GB18_L1_13:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AFM-B04","text":"Actuality → immanent interpretation → Absolute → attributive form → self-sublation of form → renewed remainder of externality.","refs":["MC_GB18_L1_13:AS-06","MC_GB18_L1_13:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AFM-B05","text":"Real possibility → contradictory conditions → absolute necessity → substance as manifesting power.","refs":["MC_GB18_L1_14:RLE-02","MC_GB18_L1_14:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:AFM-B06","text":"Substantial power → cause and effect → causal regress → self-presupposition → counteraction → interaction → freedom → concept.","refs":["MC_GB18_L1_14:XD-03","MC_GB18_L1_14:GA-11","MC_GB18_L1_14:GA-12"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L2_04:MME-01","text":"The conceptual field is remapped from things, substrates, and hierarchical grounds to recursive fields of production in which bearers arise from their relations.","refs":["MC_GB18_L1_12:MME-01","MC_GB18_L1_13:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-02","text":"Inside and outside no longer form an ontological alternative; externality becomes a necessary difference of enactment to be repeatedly internalized.","refs":["MC_GB18_L1_12:MME-02","MC_GB18_L1_13:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-03","text":"Appearance and truth exchange their rank: appearance becomes the place in which mediated reality enacts its genesis and self-revelation.","refs":["MC_GB18_L1_12:MME-04","MC_GB18_L1_13:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-04","text":"Possibility, contingency, and necessity are transformed from separate modal domains into interlocking phases of a self-presupposing actuality.","refs":["MC_GB18_L1_14:MME-02","MC_GB18_L1_14:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-05","text":"Cause and effect are reclassified from entities or fixed event-positions into reversible functional positions of a recursive nexus of effects.","refs":["MC_GB18_L1_13:MME-03","MC_GB18_L1_14:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-06","text":"Necessity and freedom no longer form an opposition; freedom denotes the conceptually organized manifestation of necessary conditionedness.","refs":["MC_GB18_L1_14:MME-06","MC_GB18_L1_14:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MME-07","text":"Subject and object become asymmetrical moments of an immanent reconstruction in which cognition is neither external predication nor sovereign production.","refs":["MC_GB18_L1_12:MME-03","MC_GB18_L1_13:MME-05","MC_GB18_L1_14:GA-13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L2_04:ALT-B01","text":"At the Surface level, thing, appearance, law, force, actuality, modality, substance, causality, freedom, and concept appear as successively unstable objects.","refs":["MC_GB18_L1_12:ALT-B01","MC_GB18_L1_14:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:ALT-B02","text":"At the Structural level, negation, positing, externalization, return, reversal, and self-presupposition organize all objects as phases of a logic of mediation.","refs":["MC_GB18_L1_13:ALT-B02","MC_GB18_L1_14:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:ALT-B03","text":"At the Metastrategic level, the reconstruction of reciprocal production replaces both the choice between opposing sides and the search for external grounds.","refs":["MC_GB18_L1_13:ALT-B03","MC_GB18_L1_14:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:ALT-B04","text":"At the Ontological / Temporal level, reality is self-effecting mediation, while time forms the recursive order of retroactively posited beginnings and actualized causes.","refs":["MC_GB18_L1_12:ALT-B04","MC_GB18_L1_14:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:ALT-B05","text":"At the Methodological / Performative level, the exposition enacts its ontology by converting every fixed determination into limit, counter-determination, and mediated return.","refs":["MC_GB18_L1_12:ALT-B05","MC_GB18_L1_14:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L2_04:FL-01","text":"Mediation must disappear in order to produce immediacy, and persist in order to sustain its truth; its efficacy therefore has the form of an operative absence.","refs":["MC_GB18_L1_12:FL-01","MC_GB18_L1_12:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-02","text":"Externality may be neither an autonomous alien sphere nor mere semblance, but must be preserved in every self-relation as a real condition and difference of enactment.","refs":["MC_GB18_L1_12:FL-02","MC_GB18_L1_13:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-03","text":"Difference must remain efficacious and at the same time lose every independent ground of being; preservation and disempowerment cannot be fully brought into coincidence.","refs":["MC_GB18_L1_13:FL-02","MC_GB18_L1_14:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-04","text":"The Absolute is supposed to be complete and is nevertheless presented through interpretation, manifestation, and return as operative self-production.","refs":["MC_GB18_L1_13:FL-03","MC_GB18_L1_13:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-05","text":"An absolute form is supposed to express the entire content, yet precisely through this totalization loses its independent subsistence; expressive force and ontological nullity coincide.","refs":["MC_GB18_L1_13:FL-04","MC_GB18_L1_13:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-06","text":"Causal self-determination requires other forces, conditions, and effects, so that autonomy remains formulable only as constitutively conditioned dependence.","refs":["MC_GB18_L1_13:FL-01","MC_GB18_L1_14:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-07","text":"The transition from interaction to concept presupposes that passing-over into otherness is already reflection into itself, without fully deriving this equation.","refs":["MC_GB18_L1_14:FL-06","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:FL-08","text":"The architecture produces the form of concrete self-mediation more reliably than its determinate content; the genesis of complete fields of conditions remains underdetermined.","refs":["MC_GB18_L1_14:FL-02","MC_GB18_L1_14:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MP-01","text":"Appearance mutates from the diagnosis of substrate-less thinghood into positive truth, transparent semblance, and the self-revelation of actuality.","refs":["MC_GB18_L1_12:MP-04","MC_GB18_L1_13:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MP-02","text":"Externality mutates from the independent outside through posited condition and proper expression into the passive interior position of organized self-efficacy.","refs":["MC_GB18_L1_13:MP-01","MC_GB18_L1_14:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MP-03","text":"Causality mutates from local cause through reciprocal force to self-presupposition and loses its fixed duality in interaction.","refs":["MC_GB18_L1_13:MP-03","MC_GB18_L1_14:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MP-04","text":"Necessity mutates from the sublation of isolated modalities into manifest conditionedness, whose reflected shape is called freedom.","refs":["MC_GB18_L1_14:GA-06","MC_GB18_L1_14:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MP-05","text":"Substance mutates from manifesting power into subjectivity once its causal differences are organized as inner articulations rather than external roles.","refs":["MC_GB18_L1_14:MP-03","MC_GB18_L1_14:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L2_04:HSI-01","text":"Reality appears as a self-differentiating machine of mediation that produces, externalizes, and withdraws its bearers, conditions, outer sides, and relations as inner organizational forms.","refs":["MC_GB18_L1_12:HSI-01","MC_GB18_L1_13:HSI-01","MC_GB18_L1_14:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:HSI-02","text":"The subject is not an operator outside the machine, but its late form of return, in which distributed differences are organized as its own determinations.","refs":["MC_GB18_L1_12:HSI-02","MC_GB18_L1_13:HSI-02","MC_GB18_L1_14:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:HSI-03","text":"Time is a spiral time of return in which results posit their beginnings, effects actualize causes, and recurrence is possible only as transformation.","refs":["MC_GB18_L1_12:HSI-03","MC_GB18_L1_13:HSI-03","MC_GB18_L1_14:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:HSI-04","text":"Possible navigation consists neither in escape nor in a search for origins, but in the immanent transformation of conditions, roles, and externalizations into forms of organized self-determination.","refs":["MC_GB18_L1_12:HSI-04","MC_GB18_L1_13:HSI-04","MC_GB18_L1_14:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L2_04:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from mediated existence through appearance, force, and actuality to modality, causality, freedom, and concept.","refs":["MC_GB18_L1_12:MRT-B01","MC_GB18_L1_13:MRT-B01","MC_GB18_L1_14:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MRT-B02","text":"The architecture is strongest in the repeated transformation of external otherness into productive self-distinction and retroactive self-presupposition.","refs":["MC_GB18_L1_12:MRT-B04","MC_GB18_L1_14:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MRT-B03","text":"The system remains coherent provided that sublation is read as preserving de-autonomization, necessity as manifested conditionedness, and concept as the result of recursive mediation.","refs":["MC_GB18_L1_13:MRT-B03","MC_GB18_L1_14:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MRT-B04","text":"Underdetermined remain the genesis of concrete determinacy of content, the positive form of the Absolute, and the transitions from law to force, from interaction to concept, and from decentered reflection to spirit.","refs":["MC_GB18_L1_12:MRT-B02","MC_GB18_L1_13:MRT-B02","MC_GB18_L1_14:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L2_04:MRT-B05","text":"Irreducible remains the concrete mutation sequence: isolated axioms cannot reconstruct the machine if they lose its recursive return, productive tension, and categorial sequence.","refs":["MC_GB18_L1_12:MRT-B05","MC_GB18_L1_14:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L2_04@R001","source_variant_id":"canonical:MC_GB18_L2_04:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L2 04","context":"Chapters 133–167 · c. Hervorgang der Sache in die Existenz. · Zweiter Abschnitt. Die Erscheinung. · A. Das Ding und seine Eigenschaften. · a. Ding an sich und Existenz. · b. Die Eigenschaft. · Anmerkung. · c. Die Wechselwirkung der Dinge. · B. Das Bestehen des Dings aus Materien. · C. Die Auflösung des Dings. · Anmerkung. · A. Das Gesetz der Erscheinung. · B. Die erscheinende und die an-sich-seynede Welt. · C. Auflösung der Erscheinung. · A. Das Verhältniß des Ganzen und der Theile. · Anmerkung. · B. Das Verhältniß der Kraft und ihrer Äußerung. · a. Das Bedingtseyn der Kraft. · b. Die Sollicitation der Kraft. · c. Die Unendlichkeit der Kraft. · C. Verhältniß des Äußern und Innern. · Anmerkung. · Dritter Abschnitt. Die Wirklichkeit. · A. Die Auslegung des Absoluten. · B. Das absolute Attribut. · C. Der Modus des Absoluten. · Anmerkung. · A. Zufälligkeit oder formelle Wirklichkeit, Möglichkeit und Nothwendigkeit. · B. Relative Nothwendigkeit oder reale Wirklichkeit, Möglichkeit und Nothwendigkeit. · C. Absolute Nothwendigkeit. · A. Das Verhältniß der Substantialität. · B. Das Kausalitäts-Verhältniß. · a. Die formelle Kausalität. · b. Das bestimmte Kausalitätsverhältniß. · c. Wirkung und Gegenwirkung. · C. Die Wechselwirkung."},"title_language_code":"en"},{"id":"MC_GB18_L1_05","layer":"MC","title":"Gb18 L1 05","order":5,"parents":["CL_GB18_17","CL_GB18_18","CL_GB18_19","CL_GB18_20"],"revision":"MC_GB18_L1_05@R001","sha256":"11ce989b4c6192ab04c930853e90335523c35b4fb432bb7bed28aeadab0d5a29","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_05:AS-01","text":"Das leitende Problem besteht darin, Einheit, Vielheit, Materie und quantitative Bestimmtheit ohne vorausgesetzte selbständige Träger oder äußerliche Verknüpfungsinstanzen zu erzeugen.","refs":["CL_GB18_17:AS-B01","CL_GB18_18:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-02","text":"Die vermeintlich selbständige Einheit setzt in ihrer Ausschließung das Andere voraus und verwandelt dadurch isolierende Negation in ein gemeinsames Beziehungsfeld.","refs":["CL_GB18_17:AS-B02","CL_GB18_18:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-03","text":"Repulsion geht nicht in eine äußerlich hinzutretende Gegenkraft über, sondern erzeugt durch ihre eigene Selbstaufhebung Attraktion, vermittelte Einheit und kontinuierlichen Zusammenhang.","refs":["CL_GB18_17:AS-B04","CL_GB18_19:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-04","text":"Quantität entsteht als vermittelte Externalisierung qualitativer Einheit und konkretisiert sich als untrennbare Einheit von Kontinuität und Diskretion.","refs":["CL_GB18_18:GA-05","CL_GB18_19:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-05","text":"Die Grenze mutiert von einer scheinbar äußerlichen Schranke zur Selbstbeziehung der Quantität und realisiert diese als bestimmtes Quantum.","refs":["CL_GB18_20:AS-B04","CL_GB18_20:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-06","text":"Die Zahl vollendet die bestimmte quantitative Einheit, erzeugt aber gerade durch ihre Selbstbegrenzung eine innere Äußerlichkeit gegenüber anderen Zahlen.","refs":["CL_GB18_20:AS-B06","CL_GB18_20:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-07","text":"Methodisch wird jede Erklärung ausgeschlossen, die den zu erzeugenden Gegenstand bereits voraussetzt; gültig ist nur die immanente Rekonstruktion seiner Voraussetzungen und Übergänge.","refs":["CL_GB18_18:AS-04","CL_GB18_19:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-08","text":"Die Bewegung ist rekursiv, spiralförmig und eskalativ: Jede erreichte Einheit setzt ihre verdrängte Differenz erneut frei, sodass Schließung nur als Übergang in quantitative Unendlichkeit und erneute qualitative Bestimmung möglich ist.","refs":["CL_GB18_17:AS-B06","CL_GB18_19:BAS-08","CL_GB18_20:AS-B08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_05:GA-01","text":"[Persistent] Keine selbständige Einheit besteht vor ihrer Beziehung; Selbstständigkeit ist eine durch negative Beziehung erzeugte und erhaltene Form.","refs":["CL_GB18_17:GA-01","CL_GB18_18:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-02","text":"[Persistent] Negation erhält das Ausgeschlossene als Bedingung ihrer eigenen Wirksamkeit und kann deshalb niemals reine Beziehungslosigkeit erzeugen.","refs":["CL_GB18_17:GA-02","CL_GB18_18:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-03","text":"[Mutating] Repulsion mutiert durch ihre immanente Beziehung auf das Ausgeschlossene in Attraktion und schließlich in kontinuierlichen Zusammenhang.","refs":["CL_GB18_17:GA-06","CL_GB18_18:GA-03","CL_GB18_19:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-04","text":"[Persistent] Einheit besteht nur, indem sie Vielheit negiert, erhält und als innere Differenz reproduziert.","refs":["CL_GB18_17:GA-08","CL_GB18_19:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-05","text":"[Emergent] Quantität ist die vermittelte Externalisierung qualitativer Bestimmung, in der die Grenze erhalten bleibt, aber dem Sein gleichgültig wird.","refs":["CL_GB18_18:GA-05","CL_GB18_20:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-06","text":"[Persistent] Quantität besitzt nur als konkrete Einheit von Kontinuität und Diskretion begriffliche Realität.","refs":["CL_GB18_19:GA-01","CL_GB18_20:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-07","text":"[Mutating] Grenze mutiert von qualitativer Wesensbestimmung über quantitative Äußerlichkeit zur immanenten Selbstbeziehung des Quantums.","refs":["CL_GB18_18:RMD-04","CL_GB18_20:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-08","text":"[Emergent] Die Zahl ist keine äußerlich addierte Menge, sondern eine selbstbegrenzende Totalität, in der Einheit und Anzahl gemeinsam die Grenze bilden.","refs":["CL_GB18_20:GA-07","CL_GB18_20:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-09","text":"[Attractor] Quantitative Selbstbestimmung erzeugt unvermeidlich innere Äußerlichkeit; der Widerspruch von Selbstbegrenzung und Vergleichbarkeit treibt die Bewegung weiter.","refs":["CL_GB18_20:GA-09","CL_GB18_20:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-10","text":"[Attractor] Erklärung und Beweis sind nur gültig, wenn sie ihre Voraussetzungen aus der immanenten Bewegung des Gegenstands erzeugen.","refs":["CL_GB18_18:GA-10","CL_GB18_19:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-11","text":"[Attractor] Widerspruch ist die objektive Form, in der eine isolierte Bestimmung ihre Einseitigkeit offenlegt und in ihr Gegenmoment übergeht.","refs":["CL_GB18_19:GA-08","CL_GB18_20:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-12","text":"[Terminal] Quantitative Unendlichkeit ist kein fertiger Abschluss, sondern die Selbstaufhebung gleichgültiger Begrenzung und die Wiederkehr qualitativer Bestimmung.","refs":["CL_GB18_18:GA-09","CL_GB18_20:XD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_05:RMD-01","text":"Das Eins wandert von unmittelbarer Einzelheit über das vermittelte Eine Eins und das aufgehobene Moment der Quantität zur Einheit der Zahl; seine Funktion bleibt, seine Selbstständigkeit verschwindet.","refs":["CL_GB18_17:RMD-01","CL_GB18_19:RMD-01","CL_GB18_20:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-02","text":"Repulsion wiederkehrt zunächst als Ausschließung, dann als negative Beziehung, kontinuierliche Vermittlung und schließlich als produktive Operation der quantitativen Differenzierung.","refs":["CL_GB18_17:RMD-02","CL_GB18_18:RMD-02","CL_GB18_19:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-03","text":"Attraktion verliert ihre scheinbare Identität als Gegenkraft, realisiert die Idealität der Repulsion und wird danach in Kontinuität und quantitative Einheit absorbiert.","refs":["CL_GB18_17:AS-B04","CL_GB18_18:RMD-03","CL_GB18_19:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-04","text":"Vielheit mutiert von äußerlich vorausgesetzten Anderen zur erhaltenen Materie der Einheit, zur inneren Diskretion der Quantität und schließlich zur Anzahl der Zahl.","refs":["CL_GB18_17:RMD-03","CL_GB18_19:RMD-05","CL_GB18_20:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-05","text":"Kontinuität wandert vom Resultat der Attraktion zur allgemeinen Struktur quantitativer Einheit und weiter zur Kraft, welche jede gesetzte Grenze überschreitet.","refs":["CL_GB18_19:RMD-03","CL_GB18_20:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-06","text":"Diskretion mutiert vom inneren Moment der Kontinuität über ihre atomistische Verselbstständigung zur begrenzten Vielheit gleicher, in einer Einheit aufgehobener Eins.","refs":["CL_GB18_19:GA-04","CL_GB18_19:RMD-04","CL_GB18_20:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-07","text":"Grenze eskaliert von qualitativer Bestimmtheit über äußerliche quantitative Begrenzung zur immanenten Struktur von Quantum und Zahl.","refs":["CL_GB18_18:RMD-04","CL_GB18_20:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-08","text":"Quantität mutiert von vermittelter Externalität zur unbegrenzten Einheit von Kontinuität und Diskretion und danach zum durch Grenze bestimmten Quantum.","refs":["CL_GB18_18:GA-05","CL_GB18_19:BAS-04","CL_GB18_20:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-09","text":"Widerspruch wandert von der impliziten Selbstzerstörung isolierter Selbstständigkeit über die Antinomie zur ausdrücklichen Entwicklungsqualität des Quantums.","refs":["CL_GB18_19:RMD-06","CL_GB18_19:MP-04","CL_GB18_20:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-10","text":"Materie und Kraft verschwinden als selbständige ontologische Träger, nachdem sie die Zirkularität äußerlicher Erklärung sichtbar gemacht haben.","refs":["CL_GB18_18:RMD-06","CL_GB18_18:MP-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_05:CGD-01","text":"Versöhnung und Freiheit bleiben lokale Darstellungsformen; auf der aktuellen Ebene skaliert nur die Struktur, nach der Selbstbeziehung das zunächst ausgeschlossene Andere als eigene Bedingung anerkennen muss.","refs":["CL_GB18_17:CGD-03","CL_GB18_17:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-02","text":"Die Prüfung einzelner Kraftbegriffe bleibt lokal; global trägt sie das Kriterium, dass eine Erklärung ihren Gegenstand nicht als fertige Voraussetzung importieren darf.","refs":["CL_GB18_18:CGD-01","CL_GB18_18:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-03","text":"Flächenkraft, Durchdringung, Berührung und einzelne Bewegungsmodelle bleiben regionale Figuren; auf der aktuellen Ebene werden Kraft, Materie und Raum zu Symptomen nichtimmanenter Erklärung umcodiert.","refs":["CL_GB18_18:CGD-02","CL_GB18_18:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-04","text":"Raum, Zeit, Materie und Ich bleiben Manifestationen der quantitativen Vermittlungsstruktur und begründen diese Struktur nicht selbst.","refs":["CL_GB18_19:CGD-02","CL_GB18_19:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-05","text":"Die einzelnen Fehleranalysen antinomischer Beweise bleiben lokal; global skaliert die Antinomie zur Diagnose jeder isolierten Begriffsbestimmung.","refs":["CL_GB18_19:CGD-03","CL_GB18_19:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-06","text":"Die Einheit von Kontinuität und Diskretion skaliert zur allgemeinen Architektur, in der scheinbar unabhängige Gegensätze als Funktionen derselben Selbstvermittlung lesbar werden.","refs":["CL_GB18_19:CGD-04","CL_GB18_20:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-07","text":"Die Übergänge zum Quantum, zum Verhältnis und zum Maß verbinden die Architektur, bleiben aber gegenüber der starken Ableitung von Repulsion, Kontinuität und Grenze unterbestimmt.","refs":["CL_GB18_19:CGD-05","CL_GB18_18:FL-03","CL_GB18_20:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_05:GNX-01","text":"Ausgeschlossen ist eine Ontologie vollständig bestimmter Substanzen, denen Beziehungen erst nachträglich äußerlich hinzutreten.","refs":["CL_GB18_17:DBN-01","CL_GB18_18:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GNX-02","text":"Ausgeschlossen sind selbständige Kräfte und jede Konstruktion, die Materie, Raum oder Bewegung bereits voraussetzt, um deren Genesis zu erklären.","refs":["CL_GB18_18:GNX-01","CL_GB18_18:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GNX-03","text":"Ausgeschlossen sind sowohl unabhängige Atome als auch eine differenzlose Kontinuität, weil jede Seite das in ihr wirksame Gegenmoment unterschlägt.","refs":["CL_GB18_19:GNX-01","CL_GB18_20:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GNX-04","text":"Ausgeschlossen ist eine Grenze, die entweder vollständig innerlich oder als fremde Schranke äußerlich wäre.","refs":["CL_GB18_18:DBN-03","CL_GB18_20:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GNX-05","text":"Ausgeschlossen ist eine Vollendung, die Vermittlung beendet, ebenso wie eine unendliche Progression ohne qualitative Rückkehr.","refs":["CL_GB18_17:BSA-03","CL_GB18_18:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GNX-06","text":"Ausgeschlossen sind formale Beweisgültigkeit ohne immanent erzeugte Prämissen und ein äußerer Erkenntnisstandpunkt jenseits der begrifflichen Bewegung.","refs":["CL_GB18_19:DBN-03","CL_GB18_19:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_05:DBN-01","text":"Damit das System Bestand hat, muss jede vorrelationale Selbstständigkeit falsch sein; andernfalls könnten Beziehung, Negation und Vermittlung keine konstitutive Funktion besitzen.","refs":["CL_GB18_17:DBN-01","CL_GB18_18:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:DBN-02","text":"Ein Gegenstand darf nicht zugleich Resultat einer Genesis und deren ungeprüft vorausgesetzter Träger sein, weil dies Konstruktion in analytische Rückprojektion verwandelt.","refs":["CL_GB18_18:DBN-02","CL_GB18_19:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:DBN-03","text":"Negation darf ihr Negiertes nicht vollständig vernichten, weil sie damit ihre eigene Bedingung und die Möglichkeit bestimmter Einheit beseitigte.","refs":["CL_GB18_17:DBN-02","CL_GB18_18:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:DBN-04","text":"Keine Seite eines Gegensatzes darf für sich die Wahrheit besitzen; Wahrheit muss als Aufhebung ihrer wechselseitigen Immanenz entstehen.","refs":["CL_GB18_19:GA-10","CL_GB18_19:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:DBN-05","text":"Das System darf keine ruhende Endbestimmung zulassen, weil vollendete Einheit und endgültige Grenze die Bewegung ihrer eigenen Hervorbringung aufheben würden.","refs":["CL_GB18_17:DBN-03","CL_GB18_20:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_05:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist ein ursprüngliches Eins oder eine ursprüngliche Materie, die vor Differenz, Beziehung und Selbstsetzung bestünde.","refs":["CL_GB18_17:BSA-01","CL_GB18_18:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSA-02","text":"Nicht verfügbar ist ein reines Außen, von dem aus Beziehung hergestellt, Widerspruch neutralisiert oder quantitative Vermittlung überblickt werden könnte.","refs":["CL_GB18_17:BSA-02","CL_GB18_19:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSA-03","text":"Nicht verfügbar ist eine widerspruchsfreie letzte Identität; ihre Abwesenheit zwingt jede Bestimmung zur Aufnahme ihres ausgeschlossenen Gegenmoments.","refs":["CL_GB18_19:BSA-03","CL_GB18_20:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSA-04","text":"Unzulässig ist eine endgültige Einheit, die keine Differenz oder Äußerlichkeit mehr hervorbringt, weil sie weder Quantität noch weitere Bestimmung erzeugen könnte.","refs":["CL_GB18_17:BSA-03","CL_GB18_20:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_05:XD-01","text":"Die Umwendung der Repulsion in Attraktion liefert die dynamische Genesis jener Kontinuität, in der Diskretion nicht verschwindet, sondern als innere Vielheit fortbesteht.","refs":["MC_GB18_L1_05:GA-03","MC_GB18_L1_05:GA-06","CL_GB18_17:AS-B04","CL_GB18_18:RMD-02","CL_GB18_19:BAS-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-02","text":"Die in der vermittelten Einheit erhaltene Vielheit mutiert zur inneren Diskretion der Quantität und schließlich zur Anzahl als selbstgebildeter Grenze der Zahl.","refs":["MC_GB18_L1_05:GA-04","MC_GB18_L1_05:GA-06","MC_GB18_L1_05:GA-08","CL_GB18_17:AS-B05","CL_GB18_19:GA-04","CL_GB18_20:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-03","text":"Äußerliche Krafttheorie und ontologische Atomistik reproduzieren dieselbe Fehlstruktur, weil beide voraussetzen, was sie als Resultat einer Erklärung oder Zusammensetzung ausgeben.","refs":["MC_GB18_L1_05:GA-01","MC_GB18_L1_05:GA-10","CL_GB18_18:GA-04","CL_GB18_19:XD-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-04","text":"Grenze ist weder bloß äußerlich noch unmittelbar innerlich: Ihre Mutation von gleichgültiger Bestimmbarkeit zu quantitativer Selbstbeziehung erzeugt erst die Spannung des Quantums.","refs":["MC_GB18_L1_05:GA-07","MC_GB18_L1_05:GA-09","CL_GB18_18:GA-07","CL_GB18_19:GA-06","CL_GB18_20:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-05","text":"Das Eins kann Einheit, Grenze und Zahl organisieren, ohne als Atom fortzubestehen; seine operative Persistenz setzt den Verlust ontologischer Selbstständigkeit voraus.","refs":["MC_GB18_L1_05:GA-01","MC_GB18_L1_05:GA-08","CL_GB18_17:GA-07","CL_GB18_19:GA-07","CL_GB18_20:GA-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-06","text":"Quantitative Äußerlichkeit ist die transformierte Gestalt negativer Beziehung: Sie ermöglicht gleichgültige Veränderung, erzeugt aber durch ihre Selbstbegrenzung quantitative Unendlichkeit.","refs":["MC_GB18_L1_05:GA-05","MC_GB18_L1_05:GA-09","MC_GB18_L1_05:GA-12","CL_GB18_18:GA-05","CL_GB18_20:GA-09","CL_GB18_20:XD-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-07","text":"Gegenstand und Methode besitzen dieselbe generative Form: Beide werden nur wahr, indem ihre Voraussetzungen immanent erzeugt und ihre isolierten Bestimmungen in Gegenmomente überführt werden.","refs":["MC_GB18_L1_05:GA-10","MC_GB18_L1_05:GA-11","CL_GB18_18:BSD-02","CL_GB18_19:XD-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-08","text":"Die Schließung bleibt notwendig nichtterminal, weil jede vermittelte Einheit durch ihre eigene Grenze ein neues Außen und damit die Bedingungen weiterer Vermittlung erzeugt.","refs":["MC_GB18_L1_05:GA-09","MC_GB18_L1_05:GA-12","CL_GB18_17:AS-B07","CL_GB18_18:AS-05","CL_GB18_20:FL-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_05:BSD-01","text":"Ontologisch werden Entitäten zu stabilisierten Phasen reproduktiver Vermittlung, deren Bestand von der fortgesetzten Erzeugung und Aufnahme ihrer Differenz abhängt.","refs":["CL_GB18_17:BSD-01","CL_GB18_18:BSD-01","CL_GB18_19:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-02","text":"Kausalität wird zur immanenten Produktion von Bedingungen: Eine Bestimmung verursacht ihren Übergang, indem sie durch ihre eigene Operation das Gegenmoment erzeugt.","refs":["CL_GB18_17:BSD-03","CL_GB18_18:BSD-02","CL_GB18_19:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-03","text":"Das Subjekt verliert den Status eines souveränen Eins und wird zu einem Grenzmodus, der Allgemeinheit nur durch Anderswerden und vermittelte Selbstbeziehung erhält.","refs":["CL_GB18_17:HSI-02","CL_GB18_19:BSD-03","CL_GB18_20:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-04","text":"Zeit ist kein neutrales Nacheinander, sondern rekursive Selbstüberschreitung, in der jedes Resultat seine verdrängte Voraussetzung wiederherstellt und transformiert.","refs":["CL_GB18_17:HSI-03","CL_GB18_18:BSD-03","CL_GB18_20:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-05","text":"Erkenntnis ist keine Abbildung fertiger Gegenstände, sondern die genetische Rekonstruktion der Operationen, durch die Bestimmungen entstehen, kippen und sich erhalten.","refs":["CL_GB18_17:BSD-04","CL_GB18_19:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-06","text":"Mathematik verliert den Status eines voraussetzungslosen Fundaments und wird als entwickelte Form quantitativer Selbstbegrenzung und äußerlicher Vergleichbarkeit reklassifiziert.","refs":["CL_GB18_18:BSD-04","CL_GB18_20:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-07","text":"Negation und Widerspruch werden zu produktiven Entwicklungsoperationen: Negation erhält ihr Anderes, während Widerspruch die Unhaltbarkeit isolierter Identität in Übergang übersetzt.","refs":["CL_GB18_17:MME-03","CL_GB18_19:GA-08","CL_GB18_20:MME-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_05:RLE-01","text":"Die Grundschleife lautet: Ausschließung setzt Andere voraus, das vorausgesetzte Andere macht Ausschließung zur Beziehung, und diese Beziehung verwandelt Repulsion in Attraktion.","refs":["CL_GB18_17:RLE-01","CL_GB18_18:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-02","text":"Attraktion negiert die unmittelbare Vielheit, erhält sie im vermittelten Einen und reproduziert sie als Bedingung ihres eigenen Fortbestehens.","refs":["CL_GB18_17:RLE-02","CL_GB18_19:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-03","text":"Kontinuität ermöglicht Teilung, Teilung setzt gleiche Eins, und deren Gleichheit stellt Kontinuität innerhalb der Diskretion wieder her.","refs":["CL_GB18_19:RLE-02","CL_GB18_20:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-04","text":"Das Eins erzeugt Grenze, die Grenze umfasst Vielheit, und die Vielheit bildet als Anzahl erneut die Grenze; Selbstbegrenzung wird zur rekursiven Organisationsform.","refs":["CL_GB18_20:RLE-02","CL_GB18_20:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-05","text":"Die Zahl schließt sich gegen anderes ab, erzeugt dadurch Vergleichbarkeit und treibt ihre endliche Selbstbegrenzung in quantitative Unendlichkeit.","refs":["CL_GB18_20:AS-B07","CL_GB18_20:XD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-06","text":"Die pathologische Schleife äußerlicher Erklärung zerlegt vorausgesetzte Gegenstände in Kräfte oder Atome, deren Definition wiederum dieselben Gegenstände voraussetzt.","refs":["CL_GB18_18:RLE-02","CL_GB18_19:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-07","text":"Der übergreifende Attraktor ist immanente Vermittlung: Jede isolierte Bestimmung wird zur Aufnahme des ausgeschlossenen Anderen und jede äußere Voraussetzung zur Selbstvoraussetzung zurückgeführt.","refs":["CL_GB18_17:RLE-03","CL_GB18_18:RLE-04","CL_GB18_20:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_05:FGS-B01","text":"Unmittelbares Eins plus Ausschließung des Anderen → vorausgesetzte Vielheit → Ausschließung wird Beziehung → isolierte Selbstständigkeit hebt sich auf.","refs":["CL_GB18_17:AS-B01","CL_GB18_17:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B02","text":"Negative Beziehung plus Identität des Ausgeschlossenen → Attraktion → vermitteltes Eines → Vielheit wird als innere Bedingung der Einheit erhalten.","refs":["CL_GB18_17:AS-B04","CL_GB18_17:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B03","text":"Erhaltene Vielheit plus Gleichheit der Eins → Kontinuität mit innerer Diskretion → reine Quantität als Einheit beider Momente.","refs":["CL_GB18_19:GA-03","CL_GB18_19:GA-04","CL_GB18_20:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B04","text":"Vermittelte Externalisierung qualitativer Grenze → reine Quantität → immanente Begrenzung → Quantum als bestimmtes quantitatives Dasein.","refs":["CL_GB18_18:GA-05","CL_GB18_20:AS-B04","CL_GB18_20:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B05","text":"Quantum plus gleiche Eins → Einheit und Anzahl → Zahl als selbstgebildete Grenze und bestimmte Totalität.","refs":["CL_GB18_20:AS-B06","CL_GB18_20:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B06","text":"Selbstbegrenzte Zahl plus innere Äußerlichkeit → Vergleichbarkeit → quantitative Unendlichkeit → Selbstaufhebung gleichgültiger Quantität und Rückkehr qualitativer Bestimmung.","refs":["CL_GB18_20:GA-09","CL_GB18_20:XD-06","CL_GB18_18:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B07","text":"Isolierung von Diskretion oder Kontinuität → Atomismus oder unendliche Teilbarkeit → Antinomie → Freilegung der immanenten Gegenwart des jeweils ausgeschlossenen Moments.","refs":["CL_GB18_19:BAS-05","CL_GB18_19:BAS-06","CL_GB18_19:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B08","text":"Äußerliche Voraussetzung → Schein von Erklärung → Diagnose der Zirkularität → immanente Erzeugung der Prämissen → methodische Homologie von Gegenstand und Beweis.","refs":["CL_GB18_18:AS-04","CL_GB18_19:GA-09","CL_GB18_19:XD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_05:AFM-B01","text":"Unmittelbares Eins → Ausschließung → vorausgesetzte Vielheit → negative Beziehung → Attraktion → vermitteltes Eines.","refs":["CL_GB18_17:RMD-01","CL_GB18_17:RMD-02","CL_GB18_17:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AFM-B02","text":"Erhaltene Vielheit → Gleichheit der Eins → Kontinuität mit innerer Diskretion → reine Quantität.","refs":["CL_GB18_19:GA-02","CL_GB18_19:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AFM-B03","text":"Reine Quantität → immanente Grenze → Quantum → Einheit und Anzahl → Zahl → innere Äußerlichkeit → quantitative Unendlichkeit.","refs":["CL_GB18_20:AS-B04","CL_GB18_20:AS-B06","CL_GB18_20:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AFM-B04","text":"Äußerliche Erklärung → Rückkehr ungeprüfter Voraussetzungen → Antinomie → immanente Prämissenerzeugung → begriffliche Rekonstruktion.","refs":["CL_GB18_18:AS-04","CL_GB18_19:BAS-06","CL_GB18_19:GA-09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_05:MME-01","text":"Selbständige Relata werden aus der Grundkarte entfernt und als Resultate der Beziehungen reklassifiziert, durch die sie bestimmt werden.","refs":["CL_GB18_18:GA-01","CL_GB18_17:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-02","text":"Kräfte verlieren den Status physikalischer Grundursachen und werden zu logischen Figuren von Selbstunterscheidung, Übergang und fehlerhafter äußerlicher Erklärung.","refs":["CL_GB18_18:MME-01","CL_GB18_18:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-03","text":"Einheit und Vielheit sowie Kontinuität und Diskretion werden von ausschließenden Alternativen zu Binnenmomenten einer selbstproduzierenden Struktur umkartiert.","refs":["CL_GB18_17:MME-01","CL_GB18_19:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-04","text":"Atom und Teil wechseln vom Status ontologischer Bestandteile zum Status aufgehobener, modaler oder funktionaler Momente des Kontinuums.","refs":["CL_GB18_19:MME-02","CL_GB18_19:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-05","text":"Grenze wird von einer äußeren Trennlinie zur immanenten Operation der Individuation, Selbstbeziehung und Selbstüberschreitung.","refs":["CL_GB18_20:MME-03","CL_GB18_20:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-06","text":"Zahl wird von einer Summe fertiger Einheiten zu einer selbstbegrenzenden Totalität umkartiert, deren Anzahl die Gestalt ihrer Grenze bildet.","refs":["CL_GB18_20:MME-04","CL_GB18_20:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-07","text":"Widerspruch wird vom Defekt kohärenter Bestimmung zum Mechanismus reklassifiziert, der einseitige Formen in ihre notwendige Fortentwicklung treibt.","refs":["CL_GB18_20:MME-06","CL_GB18_19:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-08","text":"Die Grenze zwischen Analyse und Konstruktion wird neu gezogen: Entscheidend ist nicht die äußere Form eines Beweises, sondern die immanente Herkunft seiner Voraussetzungen.","refs":["CL_GB18_18:MME-02","CL_GB18_19:MME-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_05:ALT-B01","text":"Auf der Oberflächenebene erscheinen Eins, Repulsion, Attraktion, Materie, Kontinuität, Diskretion, Grenze, Quantum und Zahl als aufeinander folgende Gegenstände.","refs":["CL_GB18_18:ALT-B01","CL_GB18_19:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:ALT-B02","text":"Auf der strukturellen Ebene organisiert eine reproduktive Selbstvermittlung sämtliche Übergänge: Einheit erzeugt Differenz, Differenz erzeugt Grenze, und Grenze rekonstruiert bestimmte Einheit.","refs":["CL_GB18_18:ALT-B02","CL_GB18_19:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:ALT-B03","text":"Auf der metastrategischen Ebene ersetzt das System äußere Ursachen, Addition und Seitenwahl durch die Rekonstruktion dessen, was jede Bestimmung selbst voraussetzt und erzeugt.","refs":["CL_GB18_18:ALT-B03","CL_GB18_19:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:ALT-B04","text":"Auf der ontologischen und temporalen Ebene ist Realität ein Werden, dessen Stabilität aus rekursiver Selbstunterscheidung, Begrenzung und Rückkehr hervorgeht.","refs":["CL_GB18_17:ALT-B04","CL_GB18_18:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:ALT-B05","text":"Auf der methodologischen und performativen Ebene vollzieht die Darstellung ihre These, indem sie jeden fixierten Begriff in seinen immanenten Übergang überführt.","refs":["CL_GB18_17:ALT-B05","CL_GB18_18:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_05:FL-01","text":"Die Kritik vorausgesetzter Materie ist stärker entwickelt als deren positive Genesis; die Architektur erklärt die Ungültigkeit äußerlicher Konstruktion präziser als die Hervorbringung ihres materiellen Gegenstands.","refs":["CL_GB18_18:FL-01","CL_GB18_18:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FL-02","text":"Kontinuität und Diskretion sollen gleichrangige Momente sein, doch die Genese privilegiert zunächst Kontinuität; diese Asymmetrie wird produktiv genutzt, aber nicht vollständig aufgehoben.","refs":["CL_GB18_19:FL-01","CL_GB18_20:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FL-03","text":"Der Übergang von reiner Quantität zum begrenzten Quantum bleibt schwächer vermittelt als die anschließende Bestimmung von Grenze und Zahl.","refs":["CL_GB18_19:FL-02","CL_GB18_20:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FL-04","text":"Quantitative Grenze muss dem Sein gleichgültig und zugleich für dessen Bestimmtheit konstitutiv sein; diese Unvereinbarkeit kann nicht beseitigt werden, ohne die Entwicklungsbewegung zu stoppen.","refs":["CL_GB18_18:FL-02","CL_GB18_20:FL-03","CL_GB18_20:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FL-05","text":"Die Rückkehr von quantitativer Unendlichkeit zu qualitativer Bestimmung, Verhältnis und Maß wird angezeigt, aber nicht mit derselben Notwendigkeit wie die vorausgehende Entstehung des Quantums entwickelt.","refs":["CL_GB18_18:FL-03","CL_GB18_18:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FL-06","text":"Die Verallgemeinerung der quantitativen Antinomie auf jeden Begriff überschreitet die ausdrücklich geleistete lokale Ableitung und bleibt eine produktive, aber ungesicherte Eskalation.","refs":["CL_GB18_19:XD-06","CL_GB18_19:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-01","text":"Das Eins mutiert vom selbständigen Ausgangspunkt zum vermittelten Resultat, danach zum aufgehobenen quantitativen Moment und schließlich zur Funktion von Grenze und Zahl.","refs":["CL_GB18_17:RMD-01","CL_GB18_19:MP-01","CL_GB18_20:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-02","text":"Repulsion mutiert vom äußeren Ausschließen zur Selbstbeziehung und anschließend zur produktiven Operation, die Attraktion, Kontinuität und quantitative Differenz erzeugt.","refs":["CL_GB18_17:MP-01","CL_GB18_19:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-03","text":"Quantität mutiert von der externalisierten Qualität zur Einheit von Kontinuität und Diskretion und durch immanente Begrenzung zum Quantum.","refs":["CL_GB18_18:GA-05","CL_GB18_19:GA-01","CL_GB18_20:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-04","text":"Grenze mutiert von wesentlicher qualitativer Bestimmung über äußerliche Veränderlichkeit zur umschließenden Selbstbeziehung des Quantums.","refs":["CL_GB18_18:RMD-04","CL_GB18_20:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-05","text":"Antinomie und Widerspruch mutieren vom vermeintlichen Erkenntnisdefekt zur objektiven Form immanenter Begriffsbewegung.","refs":["CL_GB18_19:MP-04","CL_GB18_20:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-06","text":"Die terminale Mutation vollzieht sich in der Zahl, wo Grenze nicht länger einer Vielheit gegenübersteht, sondern aus der Anzahl selbst hervorgeht und dadurch neue Äußerlichkeit erzeugt.","refs":["CL_GB18_20:MP-03","CL_GB18_20:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_05:HSI-01","text":"Realität erscheint als rekursive Differenzierungsmaschine, in der jede Trennung die Beziehung erzeugt, jede Einheit ihre Vielheit erhält und jede Grenze ein neues Außen freisetzt.","refs":["CL_GB18_17:HSI-01","CL_GB18_18:HSI-01","CL_GB18_19:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:HSI-02","text":"Das Subjekt ist kein souveränes Zentrum, sondern eine prekäre Selbstbeziehung und ein Grenzmodus, der sich nur durch die Aufnahme seiner Andersheit erhält.","refs":["CL_GB18_17:HSI-02","CL_GB18_19:HSI-02","CL_GB18_20:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:HSI-03","text":"Zeit ist eine spiralförmige Dauer, in der Begrenzung Fortgang erzeugt und jedes Resultat seine Voraussetzung auf veränderter Stufe reproduziert.","refs":["CL_GB18_17:HSI-03","CL_GB18_19:HSI-03","CL_GB18_20:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:HSI-04","text":"Navigation bleibt nur als immanente Verfolgung von Umschlagspunkten möglich; ein äußerer Standort oder die Wahl einer isolierten Seite kann die Bewegung nicht erfassen.","refs":["CL_GB18_19:HSI-04","CL_GB18_20:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_05:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung vom abstrakten Eins über Repulsion, Attraktion und vermittelte Vielheit zur Quantität, Grenze, Zahl und quantitativen Unendlichkeit zu rekonstruieren.","refs":["CL_GB18_17:MRT-B01","CL_GB18_18:MRT-B01","CL_GB18_19:MRT-B01","CL_GB18_20:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MRT-B02","text":"Die Architektur ist am stärksten in der Ableitung, dass isolierte Bestimmungen ihre Gegenmomente selbst erzeugen und Einheit nur als Erhaltung vermittelter Differenz bestehen kann.","refs":["CL_GB18_17:MRT-B02","CL_GB18_19:MRT-B02","CL_GB18_20:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MRT-B03","text":"Unterbestimmt bleiben die positive Genesis der Materie, die genaue Setzung des Quantums, die Ableitung einzelner Existenzweisen und der Übergang von quantitativer Unendlichkeit zu Maß.","refs":["CL_GB18_17:MRT-B03","CL_GB18_18:MRT-B02","CL_GB18_19:MRT-B03","CL_GB18_20:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MRT-B04","text":"Das System bleibt kohärent, sofern Negation als Erhaltung des Negierten, Widerspruch als Übergangsmechanismus und Grenze als zugleich immanente und überschreitbare Bestimmung gelesen werden.","refs":["CL_GB18_17:MRT-B04","CL_GB18_18:MRT-B03","CL_GB18_20:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MRT-B05","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung nur, wenn sie Sequenzierung als rekursive Mutation und nicht als äußerliche Folge fertiger Kategorien behandelt.","refs":["CL_GB18_17:MRT-B05","CL_GB18_19:MRT-B04","CL_GB18_19:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MRT-B06","text":"Der axiomatischen Reduktion widersteht die produktive Doppelstellung der Grenze: Sie muss die quantitative Einheit vollständig bestimmen und gerade dadurch deren Gleichgültigkeit, Vergleichbarkeit und Überschreitung erzeugen.","refs":["CL_GB18_20:MRT-B05","CL_GB18_17:FL-01","CL_GB18_18:FL-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123545812918Z_777417ea","language_code":"en","language_name":"English","title":"Gb18 L1 05","source_sha256":"11ce989b4c6192ab04c930853e90335523c35b4fb432bb7bed28aeadab0d5a29","sha256":"bbc4b3aaea0ddb550f6893ce37850bbc77c38a4677f689923f631a1f1168619a","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:35:45.813881+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_05:AS-01","text":"The guiding problem consists in generating unity, plurality, matter, and quantitative determinacy without presupposed independent bearers or external connecting instances.","refs":["CL_GB18_17:AS-B01","CL_GB18_18:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-02","text":"The supposedly independent unity presupposes the other in its exclusion and thereby transforms isolating negation into a shared relational field.","refs":["CL_GB18_17:AS-B02","CL_GB18_18:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-03","text":"Repulsion does not pass into an externally added counterforce but, through its own self-sublation, generates attraction, mediated unity, and continuous connection.","refs":["CL_GB18_17:AS-B04","CL_GB18_19:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-04","text":"Quantity arises as the mediated externalization of qualitative unity and becomes concrete as the inseparable unity of continuity and discreteness.","refs":["CL_GB18_18:GA-05","CL_GB18_19:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-05","text":"The limit mutates from an apparently external barrier into the self-relation of quantity and realizes this as determinate quantum.","refs":["CL_GB18_20:AS-B04","CL_GB18_20:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-06","text":"Number completes determinate quantitative unity, yet precisely through its self-limitation produces an inner externality in relation to other numbers.","refs":["CL_GB18_20:AS-B06","CL_GB18_20:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-07","text":"Methodologically, every explanation that already presupposes the object to be generated is excluded; valid is only the immanent reconstruction of its presuppositions and transitions.","refs":["CL_GB18_18:AS-04","CL_GB18_19:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AS-08","text":"The movement is recursive, spiral-shaped, and escalating: every attained unity releases its repressed difference anew, such that closure is possible only as transition into quantitative infinity and renewed qualitative determination.","refs":["CL_GB18_17:AS-B06","CL_GB18_19:BAS-08","CL_GB18_20:AS-B08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_05:GA-01","text":"[Persistent] No independent unity exists prior to its relation; independence is a form produced and sustained by negative relation.","refs":["CL_GB18_17:GA-01","CL_GB18_18:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-02","text":"[Persistent] Negation preserves what is excluded as the condition of its own efficacy and can therefore never generate pure relationlessness.","refs":["CL_GB18_17:GA-02","CL_GB18_18:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-03","text":"[Mutating] Through its immanent relation to what is excluded, repulsion mutates into attraction and ultimately into continuous connection.","refs":["CL_GB18_17:GA-06","CL_GB18_18:GA-03","CL_GB18_19:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-04","text":"[Persistent] Unity exists only by negating plurality, preserving it, and reproducing it as inner difference.","refs":["CL_GB18_17:GA-08","CL_GB18_19:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-05","text":"[Emergent] Quantity is the mediated externalization of qualitative determination, in which the limit is preserved but becomes indifferent to being.","refs":["CL_GB18_18:GA-05","CL_GB18_20:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-06","text":"[Persistent] Quantity possesses conceptual reality only as the concrete unity of continuity and discreteness.","refs":["CL_GB18_19:GA-01","CL_GB18_20:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-07","text":"[Mutating] Limit mutates from qualitative essential determination, through quantitative externality, into the immanent self-relation of quantum.","refs":["CL_GB18_18:RMD-04","CL_GB18_20:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-08","text":"[Emergent] Number is not an externally added aggregate, but a self-limiting totality in which unity and number jointly constitute the limit.","refs":["CL_GB18_20:GA-07","CL_GB18_20:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-09","text":"[Attractor] Quantitative self-determination inevitably produces inner externality; the contradiction between self-limitation and comparability drives the movement onward.","refs":["CL_GB18_20:GA-09","CL_GB18_20:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-10","text":"[Attractor] Explanation and proof are valid only if they generate their presuppositions from the immanent movement of the object.","refs":["CL_GB18_18:GA-10","CL_GB18_19:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-11","text":"[Attractor] Contradiction is the objective form in which an isolated determination discloses its one-sidedness and passes into its counter-moment.","refs":["CL_GB18_19:GA-08","CL_GB18_20:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GA-12","text":"[Terminal] Quantitative infinity is not a finished conclusion but the self-sublation of indifferent limitation and the return of qualitative determination.","refs":["CL_GB18_18:GA-09","CL_GB18_20:XD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_05:RMD-01","text":"The one migrates from immediate singularity through the mediated one and the sublated moment of quantity to the unity of number; its function remains, its independence disappears.","refs":["CL_GB18_17:RMD-01","CL_GB18_19:RMD-01","CL_GB18_20:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-02","text":"Repulsion recurs first as exclusion, then as negative relation, continuous mediation, and finally as a productive operation of quantitative differentiation.","refs":["CL_GB18_17:RMD-02","CL_GB18_18:RMD-02","CL_GB18_19:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-03","text":"Attraction loses its apparent identity as a counterforce, realizes the ideality of repulsion, and is subsequently absorbed into continuity and quantitative unity.","refs":["CL_GB18_17:AS-B04","CL_GB18_18:RMD-03","CL_GB18_19:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-04","text":"Plurality mutates from externally presupposed others into the preserved matter of unity, into the inner discreteness of quantity, and finally into the number of number.","refs":["CL_GB18_17:RMD-03","CL_GB18_19:RMD-05","CL_GB18_20:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-05","text":"Continuity migrates from the result of attraction to the general structure of quantitative unity and further to the force that surpasses every posited limit.","refs":["CL_GB18_19:RMD-03","CL_GB18_20:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-06","text":"Discreteness mutates from the inner moment of continuity, through its atomistic self-subsistence, into the limited plurality of equal ones sublated in a unity.","refs":["CL_GB18_19:GA-04","CL_GB18_19:RMD-04","CL_GB18_20:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-07","text":"Limit escalates from qualitative determinacy through external quantitative limitation to the immanent structure of quantum and number.","refs":["CL_GB18_18:RMD-04","CL_GB18_20:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-08","text":"Quantity mutates from mediated externality to the unlimited unity of continuity and discreteness, and thereafter to quantum determined by limit.","refs":["CL_GB18_18:GA-05","CL_GB18_19:BAS-04","CL_GB18_20:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-09","text":"Contradiction migrates from the implicit self-destruction of isolated independence, through antinomy, to the explicit developmental quality of quantum.","refs":["CL_GB18_19:RMD-06","CL_GB18_19:MP-04","CL_GB18_20:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RMD-10","text":"Matter and force disappear as independent ontological bearers after having made visible the circularity of external explanation.","refs":["CL_GB18_18:RMD-06","CL_GB18_18:MP-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_05:CGD-01","text":"Reconciliation and freedom remain local forms of presentation; at the current level, only the structure scales according to which self-relation must acknowledge the initially excluded other as its own condition.","refs":["CL_GB18_17:CGD-03","CL_GB18_17:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-02","text":"The examination of individual concepts of force remains local; globally, it bears the criterion that an explanation may not import its object as a finished presupposition.","refs":["CL_GB18_18:CGD-01","CL_GB18_18:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-03","text":"Surface force, interpenetration, contact, and individual models of motion remain regional figures; at the current level, force, matter, and space are recoded as symptoms of non-immanent explanation.","refs":["CL_GB18_18:CGD-02","CL_GB18_18:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-04","text":"Space, time, matter, and the I remain manifestations of the structure of quantitative mediation and do not themselves ground this structure.","refs":["CL_GB18_19:CGD-02","CL_GB18_19:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-05","text":"The individual analyses of errors in antinomic proofs remain local; globally, antinomy scales into the diagnosis of every isolated conceptual determination.","refs":["CL_GB18_19:CGD-03","CL_GB18_19:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-06","text":"The unity of continuity and discreteness scales into the general architecture in which apparently independent opposites become legible as functions of the same self-mediation.","refs":["CL_GB18_19:CGD-04","CL_GB18_20:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:CGD-07","text":"The transitions to quantum, ratio, and measure connect the architecture but remain underdetermined in comparison with the strong derivation of repulsion, continuity, and limit.","refs":["CL_GB18_19:CGD-05","CL_GB18_18:FL-03","CL_GB18_20:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_05:GNX-01","text":"Excluded is an ontology of fully determinate substances to which relations are only subsequently and externally added.","refs":["CL_GB18_17:DBN-01","CL_GB18_18:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GNX-02","text":"Excluded are independent forces and every construction that already presupposes matter, space, or motion in order to explain their genesis.","refs":["CL_GB18_18:GNX-01","CL_GB18_18:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GNX-03","text":"Excluded are both independent atoms and a differentiationless continuity, because each side suppresses the counter-moment operative within it.","refs":["CL_GB18_19:GNX-01","CL_GB18_20:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GNX-04","text":"Excluded is a limit that would be either wholly internal or external as an alien barrier.","refs":["CL_GB18_18:DBN-03","CL_GB18_20:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GNX-05","text":"Excluded is a completion that ends mediation, as is an infinite progression without qualitative return.","refs":["CL_GB18_17:BSA-03","CL_GB18_18:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:GNX-06","text":"Excluded are formal validity of proof without immanently generated premises and an external standpoint of cognition beyond conceptual movement.","refs":["CL_GB18_19:DBN-03","CL_GB18_19:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_05:DBN-01","text":"For the system to hold, every pre-relational independence must be false; otherwise relation, negation, and mediation could possess no constitutive function.","refs":["CL_GB18_17:DBN-01","CL_GB18_18:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:DBN-02","text":"An object may not simultaneously be the result of a genesis and its unexaminedly presupposed bearer, because this transforms construction into analytic retroprojection.","refs":["CL_GB18_18:DBN-02","CL_GB18_19:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:DBN-03","text":"Negation may not completely annihilate what it negates, because it would thereby eliminate its own condition and the possibility of determinate unity.","refs":["CL_GB18_17:DBN-02","CL_GB18_18:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:DBN-04","text":"No side of an opposition may possess truth for itself; truth must arise as the sublation of their reciprocal immanence.","refs":["CL_GB18_19:GA-10","CL_GB18_19:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:DBN-05","text":"The system may permit no resting final determination, because completed unity and definitive limit would sublate the movement of their own production.","refs":["CL_GB18_17:DBN-03","CL_GB18_20:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_05:BSA-01","text":"The most deeply excluded possibility is an original one or an original matter that would exist prior to difference, relation, and self-positing.","refs":["CL_GB18_17:BSA-01","CL_GB18_18:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSA-02","text":"Unavailable is a pure outside from which relation could be established, contradiction neutralized, or quantitative mediation surveyed.","refs":["CL_GB18_17:BSA-02","CL_GB18_19:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSA-03","text":"Unavailable is a contradiction-free final identity; its absence compels every determination to take up its excluded counter-moment.","refs":["CL_GB18_19:BSA-03","CL_GB18_20:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSA-04","text":"Impermissible is a final unity that produces no further difference or externality, because it could generate neither quantity nor further determination.","refs":["CL_GB18_17:BSA-03","CL_GB18_20:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_05:XD-01","text":"The reversal of repulsion into attraction provides the dynamic genesis of that continuity in which discreteness does not disappear but persists as inner plurality.","refs":["MC_GB18_L1_05:GA-03","MC_GB18_L1_05:GA-06","CL_GB18_17:AS-B04","CL_GB18_18:RMD-02","CL_GB18_19:BAS-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-02","text":"The plurality preserved in mediated unity mutates into the inner discreteness of quantity and finally into number as the self-formed limit of number.","refs":["MC_GB18_L1_05:GA-04","MC_GB18_L1_05:GA-06","MC_GB18_L1_05:GA-08","CL_GB18_17:AS-B05","CL_GB18_19:GA-04","CL_GB18_20:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-03","text":"External theory of force and ontological atomism reproduce the same faulty structure, because both presuppose what they present as the result of an explanation or composition.","refs":["MC_GB18_L1_05:GA-01","MC_GB18_L1_05:GA-10","CL_GB18_18:GA-04","CL_GB18_19:XD-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-04","text":"Limit is neither merely external nor immediately internal: its mutation from indifferent determinability to quantitative self-relation first generates the tension of quantum.","refs":["MC_GB18_L1_05:GA-07","MC_GB18_L1_05:GA-09","CL_GB18_18:GA-07","CL_GB18_19:GA-06","CL_GB18_20:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-05","text":"The one can organize unity, limit, and number without persisting as an atom; its operative persistence presupposes the loss of ontological independence.","refs":["MC_GB18_L1_05:GA-01","MC_GB18_L1_05:GA-08","CL_GB18_17:GA-07","CL_GB18_19:GA-07","CL_GB18_20:GA-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-06","text":"Quantitative externality is the transformed form of negative relation: it enables indifferent alteration, yet through its self-limitation generates quantitative infinity.","refs":["MC_GB18_L1_05:GA-05","MC_GB18_L1_05:GA-09","MC_GB18_L1_05:GA-12","CL_GB18_18:GA-05","CL_GB18_20:GA-09","CL_GB18_20:XD-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-07","text":"Object and method possess the same generative form: both become true only by having their presuppositions generated immanently and their isolated determinations transformed into counter-moments.","refs":["MC_GB18_L1_05:GA-10","MC_GB18_L1_05:GA-11","CL_GB18_18:BSD-02","CL_GB18_19:XD-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_05:XD-08","text":"Closure necessarily remains non-terminal, because every mediated unity generates through its own limit a new outside and thereby the conditions of further mediation.","refs":["MC_GB18_L1_05:GA-09","MC_GB18_L1_05:GA-12","CL_GB18_17:AS-B07","CL_GB18_18:AS-05","CL_GB18_20:FL-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_05:BSD-01","text":"Ontologically, entities become stabilized phases of reproductive mediation, whose persistence depends on the continued production and uptake of their difference.","refs":["CL_GB18_17:BSD-01","CL_GB18_18:BSD-01","CL_GB18_19:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-02","text":"Causality becomes the immanent production of conditions: a determination causes its transition by generating the counter-moment through its own operation.","refs":["CL_GB18_17:BSD-03","CL_GB18_18:BSD-02","CL_GB18_19:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-03","text":"The subject loses the status of a sovereign one and becomes a limiting mode that preserves universality only through becoming-other and mediated self-relation.","refs":["CL_GB18_17:HSI-02","CL_GB18_19:BSD-03","CL_GB18_20:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-04","text":"Time is not a neutral succession but recursive self-transcendence, in which every result restores and transforms its repressed presupposition.","refs":["CL_GB18_17:HSI-03","CL_GB18_18:BSD-03","CL_GB18_20:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-05","text":"Cognition is not a representation of finished objects but the genetic reconstruction of the operations through which determinations arise, overturn themselves, and preserve themselves.","refs":["CL_GB18_17:BSD-04","CL_GB18_19:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-06","text":"Mathematics loses the status of a presuppositionless foundation and is reclassified as a developed form of quantitative self-limitation and external comparability.","refs":["CL_GB18_18:BSD-04","CL_GB18_20:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:BSD-07","text":"Negation and contradiction become productive operations of development: negation preserves its other, while contradiction translates the untenability of isolated identity into transition.","refs":["CL_GB18_17:MME-03","CL_GB18_19:GA-08","CL_GB18_20:MME-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_05:RLE-01","text":"The basic loop is as follows: exclusion presupposes others, the presupposed other makes exclusion into relation, and this relation transforms repulsion into attraction.","refs":["CL_GB18_17:RLE-01","CL_GB18_18:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-02","text":"Attraction negates immediate plurality, preserves it in the mediated one, and reproduces it as the condition of its own persistence.","refs":["CL_GB18_17:RLE-02","CL_GB18_19:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-03","text":"Continuity enables division, division presupposes equal ones, and their equality restores continuity within discreteness.","refs":["CL_GB18_19:RLE-02","CL_GB18_20:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-04","text":"The one generates limit, limit encompasses plurality, and plurality once again constitutes the limit as number; self-limitation becomes a recursive form of organization.","refs":["CL_GB18_20:RLE-02","CL_GB18_20:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-05","text":"Number closes itself off against otherness, thereby produces comparability, and drives its finite self-limitation into quantitative infinity.","refs":["CL_GB18_20:AS-B07","CL_GB18_20:XD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-06","text":"The pathological loop of external explanation decomposes presupposed objects into forces or atoms, whose definition in turn presupposes the same objects.","refs":["CL_GB18_18:RLE-02","CL_GB18_19:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:RLE-07","text":"The overarching attractor is immanent mediation: every isolated determination is led back to the uptake of the excluded other and every external presupposition to self-presupposition.","refs":["CL_GB18_17:RLE-03","CL_GB18_18:RLE-04","CL_GB18_20:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_05:FGS-B01","text":"Immediate one plus exclusion of the other → presupposed plurality → exclusion becomes relation → isolated independence sublates itself.","refs":["CL_GB18_17:AS-B01","CL_GB18_17:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B02","text":"Negative relation plus identity of the excluded → attraction → mediated one → plurality is preserved as the inner condition of unity.","refs":["CL_GB18_17:AS-B04","CL_GB18_17:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B03","text":"Preserved plurality plus equality of the ones → continuity with inner discreteness → pure quantity as the unity of both moments.","refs":["CL_GB18_19:GA-03","CL_GB18_19:GA-04","CL_GB18_20:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B04","text":"Mediated externalization of qualitative limit → pure quantity → immanent limitation → quantum as determinate quantitative existence.","refs":["CL_GB18_18:GA-05","CL_GB18_20:AS-B04","CL_GB18_20:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B05","text":"Quantum plus equal ones → unity and number → number as self-formed limit and determinate totality.","refs":["CL_GB18_20:AS-B06","CL_GB18_20:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B06","text":"Self-limited number plus inner externality → comparability → quantitative infinity → self-sublation of indifferent quantity and return of qualitative determination.","refs":["CL_GB18_20:GA-09","CL_GB18_20:XD-06","CL_GB18_18:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B07","text":"Isolation of discreteness or continuity → atomism or infinite divisibility → antinomy → disclosure of the immanent presence of the respectively excluded moment.","refs":["CL_GB18_19:BAS-05","CL_GB18_19:BAS-06","CL_GB18_19:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FGS-B08","text":"External presupposition → semblance of explanation → diagnosis of circularity → immanent generation of premises → methodological homology of object and proof.","refs":["CL_GB18_18:AS-04","CL_GB18_19:GA-09","CL_GB18_19:XD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_05:AFM-B01","text":"Immediate one → exclusion → presupposed plurality → negative relation → attraction → mediated one.","refs":["CL_GB18_17:RMD-01","CL_GB18_17:RMD-02","CL_GB18_17:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AFM-B02","text":"Preserved plurality → equality of the ones → continuity with inner discreteness → pure quantity.","refs":["CL_GB18_19:GA-02","CL_GB18_19:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AFM-B03","text":"Pure quantity → immanent limit → quantum → unity and number → number → inner externality → quantitative infinity.","refs":["CL_GB18_20:AS-B04","CL_GB18_20:AS-B06","CL_GB18_20:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:AFM-B04","text":"External explanation → return of unexamined presuppositions → antinomy → immanent generation of premises → conceptual reconstruction.","refs":["CL_GB18_18:AS-04","CL_GB18_19:BAS-06","CL_GB18_19:GA-09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_05:MME-01","text":"Independent relata are removed from the basic map and reclassified as results of the relations through which they are determined.","refs":["CL_GB18_18:GA-01","CL_GB18_17:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-02","text":"Forces lose the status of physical fundamental causes and become logical figures of self-differentiation, transition, and faulty external explanation.","refs":["CL_GB18_18:MME-01","CL_GB18_18:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-03","text":"Unity and plurality, as well as continuity and discreteness, are remapped from mutually exclusive alternatives into internal moments of a self-producing structure.","refs":["CL_GB18_17:MME-01","CL_GB18_19:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-04","text":"Atom and part shift from the status of ontological components to the status of sublated, modal, or functional moments of the continuum.","refs":["CL_GB18_19:MME-02","CL_GB18_19:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-05","text":"Limit is transformed from an external dividing line into the immanent operation of individuation, self-relation, and self-transcendence.","refs":["CL_GB18_20:MME-03","CL_GB18_20:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-06","text":"Number is remapped from a sum of finished units into a self-limiting totality whose number constitutes the form of its limit.","refs":["CL_GB18_20:MME-04","CL_GB18_20:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-07","text":"Contradiction is reclassified from the defect of coherent determination into the mechanism that drives one-sided forms into their necessary further development.","refs":["CL_GB18_20:MME-06","CL_GB18_19:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MME-08","text":"The boundary between analysis and construction is redrawn: decisive is not the external form of a proof but the immanent origin of its presuppositions.","refs":["CL_GB18_18:MME-02","CL_GB18_19:MME-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_05:ALT-B01","text":"At the surface level, one, repulsion, attraction, matter, continuity, discreteness, limit, quantum, and number appear as successive objects.","refs":["CL_GB18_18:ALT-B01","CL_GB18_19:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:ALT-B02","text":"At the structural level, a reproductive self-mediation organizes all transitions: unity generates difference, difference generates limit, and limit reconstructs determinate unity.","refs":["CL_GB18_18:ALT-B02","CL_GB18_19:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:ALT-B03","text":"At the meta-strategic level, the system replaces external causes, addition, and the choosing of sides with the reconstruction of what every determination itself presupposes and generates.","refs":["CL_GB18_18:ALT-B03","CL_GB18_19:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:ALT-B04","text":"At the ontological and temporal level, reality is a becoming whose stability emerges from recursive self-differentiation, limitation, and return.","refs":["CL_GB18_17:ALT-B04","CL_GB18_18:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:ALT-B05","text":"At the methodological and performative level, the presentation enacts its thesis by transforming every fixed concept into its immanent transition.","refs":["CL_GB18_17:ALT-B05","CL_GB18_18:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_05:FL-01","text":"The critique of presupposed matter is more strongly developed than its positive genesis; the architecture explains the invalidity of external construction more precisely than the production of its material object.","refs":["CL_GB18_18:FL-01","CL_GB18_18:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FL-02","text":"Continuity and discreteness are meant to be coequal moments, yet the genesis initially privileges continuity; this asymmetry is used productively but not fully sublated.","refs":["CL_GB18_19:FL-01","CL_GB18_20:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FL-03","text":"The transition from pure quantity to limited quantum remains more weakly mediated than the subsequent determination of limit and number.","refs":["CL_GB18_19:FL-02","CL_GB18_20:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FL-04","text":"Quantitative limit must be indifferent to being and yet constitutive of its determinacy; this incompatibility cannot be eliminated without stopping the developmental movement.","refs":["CL_GB18_18:FL-02","CL_GB18_20:FL-03","CL_GB18_20:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FL-05","text":"The return from quantitative infinity to qualitative determination, ratio, and measure is indicated but not developed with the same necessity as the preceding emergence of quantum.","refs":["CL_GB18_18:FL-03","CL_GB18_18:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:FL-06","text":"The generalization of quantitative antinomy to every concept exceeds the explicitly achieved local derivation and remains a productive but unsecured escalation.","refs":["CL_GB18_19:XD-06","CL_GB18_19:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-01","text":"The one mutates from an independent starting point into a mediated result, thereafter into a sublated quantitative moment, and finally into the function of limit and number.","refs":["CL_GB18_17:RMD-01","CL_GB18_19:MP-01","CL_GB18_20:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-02","text":"Repulsion mutates from external exclusion into self-relation and subsequently into the productive operation that generates attraction, continuity, and quantitative difference.","refs":["CL_GB18_17:MP-01","CL_GB18_19:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-03","text":"Quantity mutates from externalized quality into the unity of continuity and discreteness and, through immanent limitation, into quantum.","refs":["CL_GB18_18:GA-05","CL_GB18_19:GA-01","CL_GB18_20:AS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-04","text":"Limit mutates from essential qualitative determination, through external alterability, into the encompassing self-relation of quantum.","refs":["CL_GB18_18:RMD-04","CL_GB18_20:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-05","text":"Antinomy and contradiction mutate from the supposed defect of cognition into the objective form of immanent conceptual movement.","refs":["CL_GB18_19:MP-04","CL_GB18_20:MME-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MP-06","text":"The terminal mutation takes place in number, where limit no longer stands opposed to a plurality but proceeds from number itself and thereby generates new externality.","refs":["CL_GB18_20:MP-03","CL_GB18_20:AS-B07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_05:HSI-01","text":"Reality appears as a recursive machine of differentiation in which every separation generates relation, every unity preserves its plurality, and every limit releases a new outside.","refs":["CL_GB18_17:HSI-01","CL_GB18_18:HSI-01","CL_GB18_19:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:HSI-02","text":"The subject is not a sovereign center but a precarious self-relation and a limiting mode that sustains itself only through the uptake of its otherness.","refs":["CL_GB18_17:HSI-02","CL_GB18_19:HSI-02","CL_GB18_20:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:HSI-03","text":"Time is a spiral-shaped duration in which limitation generates continuation and every result reproduces its presupposition at an altered level.","refs":["CL_GB18_17:HSI-03","CL_GB18_19:HSI-03","CL_GB18_20:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:HSI-04","text":"Navigation remains possible only as the immanent tracking of points of reversal; an external position or the choice of an isolated side cannot grasp the movement.","refs":["CL_GB18_19:HSI-04","CL_GB18_20:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_05:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from the abstract one through repulsion, attraction, and mediated plurality to quantity, limit, number, and quantitative infinity.","refs":["CL_GB18_17:MRT-B01","CL_GB18_18:MRT-B01","CL_GB18_19:MRT-B01","CL_GB18_20:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MRT-B02","text":"The architecture is strongest in the derivation that isolated determinations themselves generate their counter-moments and that unity can exist only as the preservation of mediated difference.","refs":["CL_GB18_17:MRT-B02","CL_GB18_19:MRT-B02","CL_GB18_20:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MRT-B03","text":"Underdetermined remain the positive genesis of matter, the precise positing of quantum, the derivation of individual modes of existence, and the transition from quantitative infinity to measure.","refs":["CL_GB18_17:MRT-B03","CL_GB18_18:MRT-B02","CL_GB18_19:MRT-B03","CL_GB18_20:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MRT-B04","text":"The system remains coherent provided negation is read as preservation of what is negated, contradiction as a mechanism of transition, and limit as a determination that is at once immanent and surpassable.","refs":["CL_GB18_17:MRT-B04","CL_GB18_18:MRT-B03","CL_GB18_20:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MRT-B05","text":"The reconstruction preserves the actual movement only if it treats sequencing as recursive mutation and not as an external succession of finished categories.","refs":["CL_GB18_17:MRT-B05","CL_GB18_19:MRT-B04","CL_GB18_19:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_05:MRT-B06","text":"What resists axiomatic reduction is the productive double status of limit: it must completely determine quantitative unity and precisely thereby generate its indifference, comparability, and transcendence.","refs":["CL_GB18_20:MRT-B05","CL_GB18_17:FL-01","CL_GB18_18:FL-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_05@R001","source_variant_id":"canonical:MC_GB18_L1_05:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 05","context":"Chapters 49–60 · a. Ausschließen des Eins. · Anmerkung. · b. Das Eine Eins der Attraktion. · c. Die Beziehung der Repulsion und Attraktion. · Anmerkung. · Anmerkung. · A. Die reine Quantität. · Anmerkung 1. · Anmerkung 2. · B. Kontinuirliche und diskrete Größe. · C. Begrenzung der Quantität. · A. Die Zahl."},"title_language_code":"en"},{"id":"MC_GB18_L1_06","layer":"MC","title":"Gb18 L1 06","order":6,"parents":["CL_GB18_21","CL_GB18_22","CL_GB18_23","CL_GB18_24"],"revision":"MC_GB18_L1_06@R001","sha256":"9e964cc5071bdc9a17e96321a9429eab7cc5ae8ba829a385959bf9ba55622dc8","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_06:AS-01","text":"Das System muss erklären, wie quantitative Bestimmtheit durch Zahl und Grenze zustande kommt, obwohl keine Grenze ruht und keine numerische Form die Wahrheit ihres Gegenstands vollständig enthält.","refs":["CL_GB18_21:AS-01","CL_GB18_23:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-02","text":"Extensive und intensive Größe werden als wechselnde Setzungen desselben Quantums rekonstruiert, dessen innere Einheit nur durch äußere Vielheit, Skala und Wirkung bestimmt ist.","refs":["CL_GB18_22:AS-02","CL_GB18_22:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-03","text":"Äußerlichkeit mutiert von begriffloser Aggregation über notwendige Vermittlung und selbstreproduzierende Negativität zur zurückgenommenen Bedingung relationaler Selbstbestimmung.","refs":["CL_GB18_21:GA-04","CL_GB18_24:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-04","text":"Die Grenze wird zur generativen Maschine, weil sie das Quantum bestimmt, ihr eigenes Jenseits erzeugt und dieses Jenseits als neue quantitative Grenze zurückerhält.","refs":["CL_GB18_23:GA-02","CL_GB18_24:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-05","text":"Der schlechte unendliche Progress ist zunächst die Dauerform des ungelösten Grenzwiderspruchs, wird jedoch zum notwendigen Durchgang, sobald seine Äußerlichkeit selbst begrenzt und vermittelt wird.","refs":["CL_GB18_23:GA-07","CL_GB18_24:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-06","text":"Qualität entsteht nicht durch Abbruch der quantitativen Bewegung, sondern durch die negative und relationale Reorganisation von Einheit, Vielheit und äußerer Bestimmtheit.","refs":["CL_GB18_22:AS-05","CL_GB18_24:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-07","text":"Die Reichweite dieser Transformation endet am Geist: Er ist weder höhere Intensität noch quantitativ stabilisiertes Substrat, sondern die geforderte Fähigkeit, den Widerspruch ohne Dingkategorien aufzuheben.","refs":["CL_GB18_22:GA-07","CL_GB18_24:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-08","text":"Die Gesamtbewegung ist spiralförmig und mutationsgetrieben: Quantitative Vermittlung erzeugt Qualität, äußere Rekursion erzeugt schlechte Unendlichkeit, und deren immanente Rücknahme erzeugt relationale Schließung, ohne die positive Genese des Geistes auszuführen.","refs":["CL_GB18_22:AS-08","CL_GB18_24:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_06:GA-01","text":"[Persistent] Keine quantitative Bestimmtheit ist unmittelbar; sie verlangt die Vermittlung von Einheit und Vielheit, Kontinuität und Diskretion, Grenze und Außersichsein.","refs":["CL_GB18_21:GA-01","CL_GB18_22:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-02","text":"[Mutating] Äußerlichkeit ist zunächst Defizit äußerer Aggregation, dann Bedingung intensiver Bestimmtheit, danach Form rekursiver Grenzreproduktion und schließlich eigenes Moment vermittelter Identität.","refs":["CL_GB18_21:RMD-02","CL_GB18_24:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-03","text":"[Attractor] Die Grenze organisiert die Gesamtarchitektur, weil sie Zahl bestimmt, Vielheit in Grad vermittelt, das Jenseits hervorbringt und dessen Rückkehr als Selbstbeziehung ermöglicht.","refs":["CL_GB18_21:GA-05","CL_GB18_23:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-04","text":"[Persistent] Extensive und intensive Größe sind keine getrennten Quantitätsarten, sondern reziproke Stellungen derselben Anzahl, von denen keine ohne die Vermittlung der anderen bestimmt werden kann.","refs":["CL_GB18_22:GA-01","CL_GB18_22:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-05","text":"[Persistent] Der Grad ist einfache Grenze nur durch seine Relation zu ausgeschlossener Vielheit, anderen Graden, Reihe und kontinuierlicher Skala.","refs":["CL_GB18_21:GA-06","CL_GB18_22:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-06","text":"[Mutating] Die Selbstnegation der quantitativen Grenze erzeugt zunächst Veränderung und Kontinuität, verfestigt sich aber im unendlichen Progress zur Wiederholung, die wirkliche Aufhebung verhindert.","refs":["CL_GB18_23:GA-02","CL_GB18_23:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-07","text":"[Terminal] Äußerer quantitativer Progress kann keine positive Unendlichkeit erzeugen, weil jedes erreichte Jenseits erneut die Form einer Grenze annimmt.","refs":["CL_GB18_23:GA-07","CL_GB18_24:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-08","text":"[Emergent] Negation der Negation bezeichnet die Rücknahme des Jenseits in die Bestimmtheit, wodurch Äußerlichkeit nicht verschwindet, sondern als eigenes Moment der Einheit fortbesteht.","refs":["CL_GB18_24:GA-06","CL_GB18_24:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-09","text":"[Emergent] Qualität ist weder vorausgesetztes Substrat noch Gegenprinzip zur Quantität, sondern die relationale Selbstbestimmung, die aus der negativen Identität quantitativer Unterschiede hervorgeht.","refs":["CL_GB18_22:AS-05","CL_GB18_24:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-10","text":"[Persistent] Begriffliche Wahrheit verlangt immanente Beziehung und Selbstbewegung; formale Exaktheit, Rechenleistung und symbolische Darstellbarkeit begründen sie nicht.","refs":["CL_GB18_21:GA-03","CL_GB18_21:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-11","text":"[Terminal] Quantitative Kategorien besitzen begrenzte Geltung für unmittelbares Sein, verlieren aber ihre Zuständigkeit, sobald Geist als nicht-dingliche Hervorbringung von Dasein, Bewusstsein und Endlichkeit bestimmt werden soll.","refs":["CL_GB18_22:GA-07","CL_GB18_22:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-12","text":"[Attractor] Widerspruch ist produktiv, wenn seine äußeren Pole als Momente einer Selbstbeziehung vermittelt werden; bloßes Erleiden, Verlegen oder Konservieren des Widerspruchs reproduziert ihn.","refs":["CL_GB18_24:GA-09","CL_GB18_24:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-13","text":"[Persistent] Identität ist nur als in sich unterschiedene und durch Selbstverschiedenheit vermittelte Einheit möglich.","refs":["CL_GB18_21:GA-09","CL_GB18_24:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_06:RMD-01","text":"Zahl bewahrt ihre Identität als Quantitätsbestimmung, mutiert aber von äußerlich gesetzter Anzahl zur aufgehobenen Vielheit des Grades und wird anschließend in die allgemeinere Vermittlungslogik des Quantums absorbiert.","refs":["CL_GB18_21:RMD-01","CL_GB18_22:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-02","text":"Äußerlichkeit kehrt funktional in allen Einheiten wieder, wechselt jedoch von negativer Begrifflosigkeit über reale Vermittlungsbedingung und rekursive Entfremdung zur immanenten Bedingung von Selbstbestimmung.","refs":["CL_GB18_21:RMD-02","CL_GB18_24:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-03","text":"Die Grenze erweitert ihren Geltungsbereich von Zahl und Grad über quantitative Selbstnegation und kosmologische Totalität bis zur rekursiv wiedergesetzten Grenze des Unendlichen.","refs":["CL_GB18_23:RMD-01","CL_GB18_24:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-04","text":"Der Grad bleibt innerhalb der Quantität relationale Einheit, wird am Übergang zum Geist jedoch nicht gesteigert, sondern kategorial suspendiert.","refs":["CL_GB18_21:GA-06","CL_GB18_22:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-05","text":"Kontinuität mutiert von der Vermittlung diskreter Einheiten zur Skala intensiver Unterschiede und weiter zum Mechanismus, der die Flucht zwischen Grenze und Jenseits zusammenhält.","refs":["CL_GB18_21:RMD-03","CL_GB18_23:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-06","text":"Unendlichkeit mutiert von der immanenten Negation endlicher Grenze zur schlechten Wiederholungsform und schließlich zur Selbstaufhebung der fixierten Opposition von Endlichem und Unendlichem.","refs":["CL_GB18_23:RMD-03","CL_GB18_24:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-07","text":"Qualität verschiebt sich von einem aus quantitativer Negation freigesetzten Etwas zu der durch quantitative Relation erzeugten Selbstbestimmung.","refs":["CL_GB18_22:AS-05","CL_GB18_24:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-08","text":"Das Subjekt mutiert vom quantitativ graduierbaren Seelending und abstrakten reinen Ich zur nicht-dinglichen, widerspruchsfähigen Instanz; quantitative Bestimmung wird dabei nicht erweitert, sondern umgekehrt.","refs":["CL_GB18_22:AS-07","CL_GB18_24:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-09","text":"Der Widerspruch wandert von einer verlagerten Schwierigkeit über die immanente Negativität des Quantums zur operativen Bedingung begrifflicher Aufhebung.","refs":["CL_GB18_24:RMD-05","CL_GB18_24:XD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_06:CGD-01","text":"Einzelne Rechnungsarten, Zahlformen und symbolische Verfahren bleiben lokale Ordnungen; auf der aktuellen Ebene zählen sie nur als Instanzen der Differenz zwischen äußerer Operation und immanenter Selbstbewegung.","refs":["CL_GB18_21:RMD-05","CL_GB18_21:FGS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:CGD-02","text":"Druck, Temperatur, Ton, Farbe und einzelne Gradfolgen bleiben lokale Beispiele; aufwärts skaliert allein die Regel, dass Intensität durch extensive Wirksamkeit lesbar und Bestimmtheit relational ist.","refs":["CL_GB18_22:CGD-02","CL_GB18_22:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:CGD-03","text":"Die Auflösbarkeit oder Beharrlichkeit eines Seelendings bleibt ein lokaler Grenztest; aktuell tragend ist die Selbstbegrenzung quantitativer Kategorien gegenüber nicht-dinglichem Geist.","refs":["CL_GB18_22:CGD-03","CL_GB18_22:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:CGD-04","text":"Unendlich-Großes, Unendlich-Kleines sowie räumliche und zeitliche Antinomien bleiben lokale Erscheinungsformen; global werden sie Träger derselben Struktur von vorausgesetzter Grenze, Resultat und erneuter Begrenzung.","refs":["CL_GB18_23:CGD-03","CL_GB18_24:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:CGD-05","text":"Pädagogische Kritik, moralisches Streben und kosmologische Polemik bleiben lokale Einsatzfelder; die aktuelle Ebene absorbiert sie in die Differenz zwischen mechanischer Wiederholung und immanenter Vermittlung.","refs":["CL_GB18_21:CGD-05","CL_GB18_24:XD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_06:GNX-01","text":"Ausgeschlossen ist die Gleichsetzung formaler Exaktheit oder numerischer Bestimmtheit mit begrifflicher Wahrheit.","refs":["CL_GB18_21:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GNX-02","text":"Ausgeschlossen ist die Annahme, äußere Aggregation könne durch Wiederholung aus sich heraus innere Einheit oder Selbstbestimmung erzeugen.","refs":["CL_GB18_21:GNX-02","CL_GB18_23:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GNX-03","text":"Ausgeschlossen ist reine Intensität als isolierte Innengröße, weil jeder Grad nur durch ausgeschlossene Vielheit, Äußerung und Skala bestimmt ist.","refs":["CL_GB18_21:GNX-03","CL_GB18_22:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GNX-04","text":"Ausgeschlossen ist die Quantifizierung des Geistes als Ding, Substrat oder abschwächbarer Grad von Realität.","refs":["CL_GB18_22:GNX-04","CL_GB18_22:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GNX-05","text":"Ausgeschlossen ist Fortschritt als kumulative Annäherung an eine positive Unendlichkeit, solange jede Überschreitung lediglich eine neue Grenze setzt.","refs":["CL_GB18_23:GNX-03","CL_GB18_24:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GNX-06","text":"Ausgeschlossen ist die subjektive Verlagerung des Widerspruchs, sofern sie dessen objektive Bewegungsform unangetastet lässt.","refs":["CL_GB18_24:GNX-02","CL_GB18_24:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_06:DBN-01","text":"Damit das System trägt, darf keine Bestimmtheit als unmittelbar gegeben gelten; jede Einheit muss ihre Geltung aus einer bestimmten Vermittlungsordnung empfangen.","refs":["CL_GB18_22:DBN-01","CL_GB18_21:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:DBN-02","text":"Unzulässig ist eine Ontologie selbständiger Entitäten, denen Grenze, Beziehung oder Äußerung erst nachträglich hinzugefügt werden.","refs":["CL_GB18_24:DBN-04","CL_GB18_22:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:DBN-03","text":"Unzulässig ist die Versöhnung von Endlichkeit und Unendlichkeit durch quantitative Akkumulation, da Akkumulation die Grenzform reproduziert, die sie überwinden soll.","refs":["CL_GB18_23:DBN-03","CL_GB18_24:XD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:DBN-04","text":"Unzulässig ist ein einheitliches Kategorienregime, unter dem quantitative Dinge, Kräfte, Seele und Geist auf dieselbe Weise erklärbar wären.","refs":["CL_GB18_22:BSA-02","CL_GB18_22:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:DBN-05","text":"Unzulässig ist eine widerspruchsfreie und fertige Welt- oder Begriffstotalität, deren Grenzen nicht aus ihrem eigenen Vollzug hervorgehen.","refs":["CL_GB18_24:DBN-02","CL_GB18_24:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_06:BSA-01","text":"Die tiefste organisierende Abwesenheit ist die eines äußersten Jenseits: Kein Außen darf der Begrenzung, Relation und Rücknahme dauerhaft entzogen bleiben.","refs":["CL_GB18_24:BSA-01","CL_GB18_24:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:BSA-02","text":"Nicht verfügbar ist unmittelbare Selbstidentität, weil jede bestimmte Einheit ihre ausgeschlossene Vielheit und Andersheit als Bedingung ihrer Einheit bewahren muss.","refs":["CL_GB18_21:BSA-01","CL_GB18_24:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:BSA-03","text":"Nicht verfügbar ist positive Unendlichkeit als gegenwärtiger Gegenstand innerhalb des quantitativen Feldes; verfügbar ist nur die Selbstaufhebung der Form, die Endlichkeit und Unendlichkeit äußerlich fixiert.","refs":["CL_GB18_23:BSA-01","CL_GB18_24:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:BSA-04","text":"Nicht verfügbar ist ein letzter Standpunkt, von dem Einheit, Vielheit, Qualität und Geist als unabhängig vorhandene positive Wesenheiten bestimmt werden könnten.","refs":["CL_GB18_22:BSA-01","CL_GB18_23:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_06:XD-01","text":"Äußerlichkeit ist nicht an sich defizitär oder produktiv; ihr Status hängt davon ab, ob sie als fremde Setzung fixiert bleibt oder in die Selbstbestimmung des Gegenstands zurückkehrt.","refs":["MC_GB18_L1_06:GA-02","MC_GB18_L1_06:GA-08","CL_GB18_21:RMD-02","CL_GB18_24:GA-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-02","text":"Die Relation anderer Grade ist bereits die elementare Form jener vermittelten Identität, die auf höherer Stufe das Jenseits nicht beseitigt, sondern als Bedingung des Bei-sich-Seins integriert.","refs":["MC_GB18_L1_06:GA-05","MC_GB18_L1_06:GA-08","MC_GB18_L1_06:GA-13","CL_GB18_21:GA-06","CL_GB18_24:AS-B08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-03","text":"Der schlechte unendliche Progress ist notwendig, weil er die Äußerlichkeit der Grenze vollständig exponiert, aber unzureichend, solange seine Wiederholung nicht selbst zum Gegenstand der Negation wird.","refs":["MC_GB18_L1_06:GA-06","MC_GB18_L1_06:GA-07","MC_GB18_L1_06:GA-08","CL_GB18_24:AS-B05","CL_GB18_24:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-04","text":"Dass quantitative Vermittlung Qualität erzeugt, berechtigt nicht zur Quantifizierung des Geistes; die erste Transformation bleibt innerhalb einer bestimmten Logik des Quantums, die zweite verlangt deren kategoriale Begrenzung.","refs":["MC_GB18_L1_06:GA-09","MC_GB18_L1_06:GA-11","CL_GB18_22:GA-05","CL_GB18_22:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-05","text":"Mathematische Formen und Antinomiebeweise unterliegen demselben Geltungstest: Entscheidend ist nicht ihre formale Geschlossenheit, sondern ob sie die von ihnen benötigten Voraussetzungen im eigenen Vollzug vermitteln.","refs":["MC_GB18_L1_06:GA-10","MC_GB18_L1_06:GA-12","CL_GB18_21:AS-06","CL_GB18_24:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-06","text":"Widerspruch wird produktiv, wenn die Differenz seiner Pole nicht nivelliert, sondern als Selbstverschiedenheit der Einheit bewahrt wird.","refs":["MC_GB18_L1_06:GA-12","MC_GB18_L1_06:GA-13","CL_GB18_24:XD-03","CL_GB18_24:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-07","text":"Die Architektur unterscheidet drei Zeitformen: mechanische Wiederholung äußerer Operation, perennierende Wiedereinsetzung der Grenze und vermittelte Rückkehr aus eigener Äußerlichkeit.","refs":["MC_GB18_L1_06:GA-02","MC_GB18_L1_06:GA-07","MC_GB18_L1_06:GA-08","CL_GB18_21:BSD-04","CL_GB18_23:HSI-03","CL_GB18_24:BSD-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-08","text":"Handlungsmacht besteht nicht im abstrakten Überschreiten einer Grenze, sondern in der Fähigkeit, deren Widerspruch so zu vermitteln, dass äußeres Fortschreiten in begriffliche Selbstbestimmung umschlägt.","refs":["MC_GB18_L1_06:GA-11","MC_GB18_L1_06:GA-12","CL_GB18_24:GA-09","CL_GB18_24:HSI-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_06:BSD-01","text":"Realität wird als Vermittlungsmaschine rekonstituiert, in der Grenzen ihre Außenseite erzeugen und durch deren Rückkehr ihre bestimmte Einheit gewinnen.","refs":["MC_GB18_L1_06:GA-02","MC_GB18_L1_06:GA-03","MC_GB18_L1_06:GA-13","CL_GB18_22:HSI-01","CL_GB18_24:HSI-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:BSD-02","text":"Zeit ist weder ein neutraler Behälter noch einheitlicher Fortschritt, sondern die Differenz zwischen mechanischer Wiederholung, negativer Perennierung und reflexiver Rückkehr.","refs":["MC_GB18_L1_06:GA-06","MC_GB18_L1_06:GA-07","MC_GB18_L1_06:GA-08","CL_GB18_21:BSD-04","CL_GB18_23:HSI-03","CL_GB18_24:HSI-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:BSD-03","text":"Erkenntnis wird nach Geltungssphären geordnet: Technische Beherrschung und formale Rechtfertigung bleiben legitime lokale Verfahren, erhalten philosophische Autorität aber nur durch logische Selbstbestimmung.","refs":["MC_GB18_L1_06:GA-10","CL_GB18_21:GA-08","CL_GB18_24:MME-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:BSD-04","text":"Das Subjekt spaltet sich in inkompatible Figuren: als Seele ist es quantitativ behandelbares Substrat, als Geist eine widerspruchsfähige, nicht-dingliche Quelle endlicher Bestimmungen.","refs":["MC_GB18_L1_06:GA-11","MC_GB18_L1_06:GA-12","CL_GB18_22:BSD-02","CL_GB18_24:MP-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:BSD-05","text":"Kausalität verschiebt sich von linearer Wirkung eines inneren Bestands zur reziproken Bestimmung und schließlich zur offenen genetischen Frage, wie endliche Bestimmungen ohne vorausgesetzte Dingursache hervorgehen.","refs":["MC_GB18_L1_06:GA-04","MC_GB18_L1_06:GA-11","CL_GB18_22:BSD-03","CL_GB18_22:MME-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:BSD-06","text":"Strategische und begriffliche Handlungsmacht entsteht erst, wenn das Subjekt den Widerspruch nicht durch Flucht verlängert, sondern die Bedingungen seiner Äußerlichkeit transformiert.","refs":["MC_GB18_L1_06:GA-08","MC_GB18_L1_06:GA-12","CL_GB18_24:BSD-03","CL_GB18_24:HSI-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_06:RLE-01","text":"Kontinuität und Diskretion treiben zur Zahl, die Zahl hebt Vielheit in Einheit auf, die Einheit wird zum Grad, und die Gradrelation stellt Kontinuität als Skala wieder her.","refs":["CL_GB18_21:RLE-01","CL_GB18_21:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-02","text":"Die negative Grenzschleife lautet: bestimmte Grenze erzeugt Jenseits, Jenseits wird anderes Quantum, anderes Quantum wird neue Grenze, und die Negation beginnt erneut.","refs":["CL_GB18_23:RLE-02","CL_GB18_24:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-03","text":"Die positive Gegenschleife setzt ein, wenn die Bewegung ihre eigene Äußerlichkeit zurücknimmt und dadurch serielle Wiederholung in Selbstvermittlung transformiert.","refs":["CL_GB18_24:RMD-03","CL_GB18_24:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-04","text":"Der unendliche Progress markiert einen Phasenwechsel: Als äußere Serie verhindert er Aufhebung, als erkannte Darstellung seiner eigenen Äußerlichkeit wird er zum Durchgang der Negation der Negation.","refs":["CL_GB18_23:GA-06","CL_GB18_24:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-05","text":"Der Eskalationspfad Zahl → Grad → Qualität → Unendlichkeit endet nicht in einem größeren Quantum, sondern in der Selbstbegrenzung des Quantums und der relationalen Rekonstruktion von Bestimmtheit.","refs":["CL_GB18_22:RLE-03","CL_GB18_24:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-06","text":"Widerspruch ist ein Attraktor, weil quantitative, kosmologische und subjektive Problemstellungen auf die Frage konvergieren, ob äußere Differenz vermittelt oder lediglich verlagert wird.","refs":["CL_GB18_24:GA-09","CL_GB18_24:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-07","text":"Die vermittelte Identität ist der terminale Attraktor: Ein Bestimmtes erhält sich nicht trotz, sondern durch die Integration seiner Selbstverschiedenheit.","refs":["CL_GB18_24:RLE-05","CL_GB18_24:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_06:FGS-B01","text":"Kontinuität und Diskretion ohne bestimmte Grenze → unvollständige Abstraktionen → Grenze als Anzahl gleicher Einheiten → extensives Quantum und Zahl.","refs":["CL_GB18_21:GA-01","CL_GB18_21:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B02","text":"Zahl als bestimmte Vielheit → Aufhebung der Anzahl in einfacher Grenze → Grad als intensives Quantum.","refs":["CL_GB18_21:GA-02","CL_GB18_21:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B03","text":"Grad + ausgeschlossene Vielheit + extensive Wirksamkeit → kontinuierliche Skala → qualitative Realität relationaler Intensität.","refs":["CL_GB18_21:FGS-B06","CL_GB18_22:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B04","text":"Quantitative Grenze + immanente Selbstnegation → anderes Quantum → Erhaltung der Quantität in ihrem Anderssein.","refs":["CL_GB18_23:GA-02","CL_GB18_23:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B05","text":"Anderes Quantum + erneute Begrenzung + fortgesetzte Kontinuität → unendlicher Progress → Dauerform des ungelösten Grenzwiderspruchs.","refs":["CL_GB18_23:GA-06","CL_GB18_23:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B06","text":"Erkenntnis, dass das Jenseits selbst Quantum ist → Begrenzbarkeit des Jenseits → Zusammenbruch seiner behaupteten Selbständigkeit.","refs":["CL_GB18_24:AS-B06","CL_GB18_24:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B07","text":"Begrenzung des Jenseits → Negation der Negation → Äußerlichkeit als eigenes Moment → qualitative Einheit der Relation.","refs":["CL_GB18_24:FGS-B05","CL_GB18_24:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B08","text":"Relationale Qualität → Prüfung des kategorialen Geltungsbereichs → Aufhebung des Quantums für Geist → offene genetische Erklärung von Endlichkeit.","refs":["CL_GB18_22:GA-07","CL_GB18_22:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_06:AFM-B01","text":"Abstrakte Kontinuität und Diskretion → Zahl als bestimmte Grenze → Aufhebung der Anzahl im Grad → Skala relationaler Intensität → qualitative Selbstüberschreitung des Quantums → selbstnegierende Grenze → schlechte Unendlichkeit → Selbstquantifizierung und Begrenzung des Jenseits → Negation der Negation → relationale Qualität → kategoriale Grenze gegenüber Geist.","refs":["CL_GB18_21:RLE-01","CL_GB18_22:RLE-03","CL_GB18_24:RLE-03","CL_GB18_24:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_06:MME-01","text":"Quantität wird von statischer Größenordnung zu einer prozessualen Form der Selbstdifferenzierung umkartiert.","refs":["CL_GB18_23:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-02","text":"Äußerlichkeit wird nicht mehr einheitlich als Defekt kartiert, sondern als wechselnde Funktion, die von mechanischer Setzung bis zum eigenen Moment der Bestimmtheit reicht.","refs":["CL_GB18_21:RMD-02","CL_GB18_24:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-03","text":"Die Taxonomie extensiver und intensiver Größen kollabiert zugunsten eines Feldes reziproker Formbestimmungen derselben Quantität.","refs":["CL_GB18_22:GA-01","CL_GB18_22:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-04","text":"Qualität und Quantität werden nicht länger als feste Gegensätze behandelt; Qualität erscheint als durch quantitative Negation und Relation erzeugte Selbstbestimmung.","refs":["CL_GB18_24:GA-07","CL_GB18_24:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-05","text":"Endlichkeit und Unendlichkeit verlieren den Status getrennter Regionen und werden zu Momenten einer Bewegungsform, deren Wahrheit in der Aufhebung ihrer äußeren Fixierung liegt.","refs":["CL_GB18_23:MME-03","CL_GB18_24:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-06","text":"Beziehung wird von einer nachträglichen Vergleichsoperation zur ontologischen Form gegenseitiger Bestimmtheit reklassifiziert.","refs":["CL_GB18_24:BSD-05","CL_GB18_24:DBN-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-07","text":"Mathematische Form und Beweis werden von äußerlichen Autoritäten zu diagnostischen Gegenständen, deren Voraussetzungen logisch rekonstruiert werden müssen.","refs":["CL_GB18_24:MME-05","CL_GB18_21:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-08","text":"Das Subjekt wird nicht mehr entlang einer graduellen Intensität kartiert, sondern durch die Differenz zwischen quantitativem Seelending und widerspruchsfähigem Geist.","refs":["CL_GB18_22:MME-03","CL_GB18_24:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_06:ALT-B01","text":"Surface level — Das Feld umfasst Zahl, Grad, extensive Menge, intensive Einheit, Kraft, Seele, Geist, unendliche Zahlen sowie räumliche, zeitliche und kosmologische Grenzen.","refs":["CL_GB18_22:ALT-B01","CL_GB18_24:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:ALT-B02","text":"Structural level — Grenze, Äußerlichkeit und Relation bilden den rekursiven Mechanismus, durch den Einheit ihre ausgeschlossene Vielheit erzeugt, bewahrt und zurücknimmt.","refs":["CL_GB18_21:RLE-04","CL_GB18_24:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:ALT-B03","text":"Metastrategic level — Interpretation und Intervention werden danach unterschieden, ob sie äußere Wiederholung als Fortschritt ausgeben oder den reproduzierten Widerspruch in immanente Vermittlung überführen.","refs":["CL_GB18_23:ALT-B03","CL_GB18_24:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:ALT-B04","text":"Ontological / Temporal level — Realität besteht als vermittelte Selbstverschiedenheit; Zeit reicht von mechanischer Wiederholung über perennierende Grenze bis zur reflexiven Rückkehr, während Geist die quantitative Zeitform kategorial überschreitet.","refs":["CL_GB18_23:BSD-01","CL_GB18_24:HSI-03","CL_GB18_22:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie jeden Begriff durch seine eigene Vermittlung destabilisiert und argumentative Formen auf ihre verdeckten Voraussetzungen zurückführt.","refs":["CL_GB18_22:ALT-B05","CL_GB18_24:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_06:FL-01","text":"Die Zahl gilt zugleich als begriffslose Äußerlichkeit und als notwendige Vermittlung des Grades; die Architektur benötigt ihre Form, während sie deren Anspruch auf begriffliche Wahrheit zurückweist.","refs":["CL_GB18_21:FL-01","CL_GB18_21:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FL-02","text":"Der Grad wird als einfache Selbstbeziehung und zugleich als nur durch andere Grade bestimmte Einheit gefasst; seine Einfachheit ist daher real und nicht selbständig.","refs":["CL_GB18_21:FL-02","CL_GB18_22:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FL-03","text":"Die quantitative Rekursion soll keine positive qualitative Unendlichkeit erreichen können, während ihre immanente Selbstaufhebung zugleich als wahres Unendliches erscheint; die Kohärenz hängt am Wechsel der Bestimmungsform.","refs":["CL_GB18_23:MRT-B02","CL_GB18_24:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FL-04","text":"Quantitative Vermittlung erzeugt Qualität, muss aber für Geist aufgehoben werden; unterbestimmt bleibt, wie beide Übergänge zusammengehören, ohne Geist erneut zu quantifizieren.","refs":["CL_GB18_22:AS-08","CL_GB18_22:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FL-05","text":"Die Welt soll den Widerspruch besitzen, aber nicht tragen können, während der Geist ihn aufheben soll; die Vermittlung zwischen objektiver Negativität und geistiger Auflösung bleibt offen.","refs":["CL_GB18_24:FL-02","CL_GB18_24:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FL-06","text":"Die relationale Einheit droht erneut äußerlich zu werden, sofern nicht gezeigt wird, wie das Verhältnis seine Einheit bewahrt, ohne sich in eine bloße Ordnung selbständiger Quanta zurückzuverwandeln.","refs":["CL_GB18_24:FL-04","CL_GB18_24:DBN-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MP-01","text":"Äußerlichkeit mutiert am Übergang von mechanischer Operation zur Bestimmung der Realität und erneut bei ihrer Rücknahme in vermittelte Einheit.","refs":["CL_GB18_21:MP-02","CL_GB18_24:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MP-02","text":"Die Grenze mutiert von bestimmender Negation zur rekursiv wiedergesetzten Grenze und schließlich zum Medium der Aufhebung des Jenseits.","refs":["CL_GB18_23:RMD-01","CL_GB18_24:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MP-03","text":"Unendlichkeit mutiert von der schlechten Wiederholungsform ohne positive Alternative zur Selbstaufhebung der äußeren Opposition von Endlichem und Unendlichem.","refs":["CL_GB18_23:MP-02","CL_GB18_24:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MP-04","text":"Qualität mutiert vom scheinbaren Gegenprinzip der Quantität zur durch quantitative Relation erzeugten Selbstbestimmung.","refs":["CL_GB18_24:MP-03","CL_GB18_24:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MP-05","text":"Das Subjekt mutiert vom abstrakten Ich und quantitativ bestimmbaren Seelending zur widerspruchsfähigen Instanz, deren positive genetische Struktur unausgeführt bleibt.","refs":["CL_GB18_24:MP-04","CL_GB18_22:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_06:HSI-01","text":"Realität erscheint als Maschine gesetzter Grenzen, die ihre Außenseite produzieren und erst durch die Rückkehr aus dieser Äußerlichkeit bestimmt sind.","refs":["CL_GB18_24:HSI-01","CL_GB18_24:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:HSI-02","text":"Das Subjekt ist weder Rechenmaschine noch abstrakter Überschreiter, sondern eine widerspruchsfähige Instanz, deren Freiheit in vermittelnder Selbstbestimmung liegt.","refs":["CL_GB18_21:HSI-02","CL_GB18_24:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:HSI-03","text":"Zeit erscheint als Dreifachmaschine aus äußerlicher Wiederholung, endloser Wiedereinsetzung der Grenze und reflexiver Aufhebung fester Endpunkte.","refs":["CL_GB18_21:HSI-03","CL_GB18_23:HSI-03","CL_GB18_24:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:HSI-04","text":"Kampf und Navigation bestehen darin, äußeres Überschreiten nicht zu verlängern, sondern Äußerlichkeit als eigenes Moment einer vermittelten Einheit zu transformieren.","refs":["CL_GB18_24:HSI-04","CL_GB18_24:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_06:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von Zahl und Grad über qualitative Vermittlung und schlechte Unendlichkeit bis zur relationalen Selbstbestimmung zu rekonstruieren.","refs":["CL_GB18_22:MRT-B01","CL_GB18_24:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MRT-B02","text":"Die Architektur ist dort am stärksten, wo sie scheinbares Verschwinden als Funktionsmutation rekonstruiert: Anzahl bleibt im Grad, und reproduzierte Äußerlichkeit wird in Selbstvermittlung zurückgenommen.","refs":["CL_GB18_21:MRT-B04","CL_GB18_24:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MRT-B03","text":"Unterbestimmt bleibt die positive genetische Erklärung, wie Geist Dasein, Bewusstsein und Endlichkeit hervorbringt, ohne in quantitative oder dingliche Kategorien zurückzufallen.","refs":["CL_GB18_22:MRT-B03","CL_GB18_24:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MRT-B04","text":"Ebenfalls unterbestimmt bleibt der präzise Umschlag von der schlechten quantitativen Unendlichkeit zur relationalen Form des wahren Unendlichen; seine Kohärenz hängt an der Unterscheidung äußerer Serie und immanenter Rücknahme.","refs":["CL_GB18_23:MRT-B02","CL_GB18_24:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MRT-B05","text":"Das System ist auf dieser Ebene kohärent, sofern Quantum, Qualität, Seele und Geist als gestaffelte Geltungsbereiche behandelt und quantitative Wiederholung, abstrakte Opposition und äußerliche Einheit als Varianten unaufgehobener Negativität erkannt werden.","refs":["CL_GB18_22:MRT-B04","CL_GB18_24:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MRT-B06","text":"Ein unverzichtbarer Rest widersteht der axiomatischen Schließung: Die produktive Verdichtung von Unendlichkeit, Qualität, Fürsichsein und Geist erzeugt die höchste systematische Leistung, bleibt aber zugleich die stärkste Belastungszone.","refs":["CL_GB18_24:MRT-B04","CL_GB18_21:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123625807720Z_c33d527a","language_code":"en","language_name":"English","title":"Gb18 L1 06","source_sha256":"9e964cc5071bdc9a17e96321a9429eab7cc5ae8ba829a385959bf9ba55622dc8","sha256":"90307f0b9139aeae5ed835da2902463d0955df45158ff1511aa2594c6aefbdbf","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:36:25.808647+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_06:AS-01","text":"The system must explain how quantitative determinacy comes about through number and limit, although no limit rests and no numerical form fully contains the truth of its object.","refs":["CL_GB18_21:AS-01","CL_GB18_23:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-02","text":"Extensive and intensive magnitude are reconstructed as alternating positings of the same quantum, whose inner unity is determined only through external multiplicity, scale, and effect.","refs":["CL_GB18_22:AS-02","CL_GB18_22:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-03","text":"Externality mutates from conceptless aggregation, through necessary mediation and self-reproducing negativity, into the withdrawn condition of relational self-determination.","refs":["CL_GB18_21:GA-04","CL_GB18_24:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-04","text":"The limit becomes a generative machine because it determines the quantum, generates its own beyond, and receives this beyond back as a new quantitative limit.","refs":["CL_GB18_23:GA-02","CL_GB18_24:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-05","text":"Bad infinite progress is initially the enduring form of the unresolved contradiction of limit, but becomes a necessary passage once its externality itself is limited and mediated.","refs":["CL_GB18_23:GA-07","CL_GB18_24:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-06","text":"Quality arises not through the interruption of quantitative movement, but through the negative and relational reorganization of unity, multiplicity, and external determinacy.","refs":["CL_GB18_22:AS-05","CL_GB18_24:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-07","text":"The scope of this transformation ends at spirit: it is neither higher intensity nor a quantitatively stabilized substrate, but the required capacity to sublate contradiction without thing-categories.","refs":["CL_GB18_22:GA-07","CL_GB18_24:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:AS-08","text":"The overall movement is spiral-shaped and mutation-driven: quantitative mediation produces quality, external recursion produces bad infinity, and its immanent withdrawal produces relational closure, without elaborating the positive genesis of spirit.","refs":["CL_GB18_22:AS-08","CL_GB18_24:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_06:GA-01","text":"[Persistent] No quantitative determinacy is immediate; it requires the mediation of unity and multiplicity, continuity and discreteness, limit and being-outside-itself.","refs":["CL_GB18_21:GA-01","CL_GB18_22:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-02","text":"[Mutating] Externality is initially the deficit of external aggregation, then the condition of intensive determinacy, thereafter the form of recursive limit-reproduction, and finally its own moment of mediated identity.","refs":["CL_GB18_21:RMD-02","CL_GB18_24:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-03","text":"[Attractor] The limit organizes the overall architecture because it determines number, mediates multiplicity into degree, brings forth the beyond, and enables its return as self-relation.","refs":["CL_GB18_21:GA-05","CL_GB18_23:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-04","text":"[Persistent] Extensive and intensive magnitude are not separate kinds of quantity, but reciprocal positions of the same number, neither of which can be determined without the mediation of the other.","refs":["CL_GB18_22:GA-01","CL_GB18_22:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-05","text":"[Persistent] Degree is a simple limit only through its relation to excluded multiplicity, other degrees, series, and continuous scale.","refs":["CL_GB18_21:GA-06","CL_GB18_22:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-06","text":"[Mutating] The self-negation of the quantitative limit initially generates change and continuity, but solidifies in infinite progress into repetition that prevents actual sublation.","refs":["CL_GB18_23:GA-02","CL_GB18_23:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-07","text":"[Terminal] External quantitative progress cannot generate positive infinity, because every attained beyond once again assumes the form of a limit.","refs":["CL_GB18_23:GA-07","CL_GB18_24:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-08","text":"[Emergent] Negation of negation denotes the withdrawal of the beyond into determinacy, whereby externality does not disappear but persists as its own moment of unity.","refs":["CL_GB18_24:GA-06","CL_GB18_24:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-09","text":"[Emergent] Quality is neither a presupposed substrate nor a counter-principle to quantity, but the relational self-determination arising from the negative identity of quantitative differences.","refs":["CL_GB18_22:AS-05","CL_GB18_24:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-10","text":"[Persistent] Conceptual truth requires immanent relation and self-movement; formal exactitude, computational power, and symbolic representability do not establish it.","refs":["CL_GB18_21:GA-03","CL_GB18_21:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-11","text":"[Terminal] Quantitative categories possess limited validity for immediate being, but lose their competence as soon as spirit is to be determined as the non-thingly production of existence, consciousness, and finitude.","refs":["CL_GB18_22:GA-07","CL_GB18_22:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-12","text":"[Attractor] Contradiction is productive when its external poles are mediated as moments of a self-relation; merely suffering, displacing, or preserving contradiction reproduces it.","refs":["CL_GB18_24:GA-09","CL_GB18_24:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GA-13","text":"[Persistent] Identity is possible only as unity differentiated within itself and mediated through self-difference.","refs":["CL_GB18_21:GA-09","CL_GB18_24:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_06:RMD-01","text":"Number preserves its identity as a determination of quantity, but mutates from externally posited number into the sublated multiplicity of degree and is subsequently absorbed into the more general mediating logic of the quantum.","refs":["CL_GB18_21:RMD-01","CL_GB18_22:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-02","text":"Externality recurs functionally in all units, but shifts from negative conceptlessness through a real condition of mediation and recursive alienation to the immanent condition of self-determination.","refs":["CL_GB18_21:RMD-02","CL_GB18_24:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-03","text":"The limit expands its scope from number and degree through quantitative self-negation and cosmological totality to the recursively re-posited limit of the infinite.","refs":["CL_GB18_23:RMD-01","CL_GB18_24:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-04","text":"Within quantity, degree remains relational unity, but at the transition to spirit it is not intensified but categorically suspended.","refs":["CL_GB18_21:GA-06","CL_GB18_22:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-05","text":"Continuity mutates from the mediation of discrete units into the scale of intensive differences and further into the mechanism that holds together the flight between limit and beyond.","refs":["CL_GB18_21:RMD-03","CL_GB18_23:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-06","text":"Infinity mutates from the immanent negation of finite limit into the bad form of repetition and finally into the self-sublation of the fixed opposition between finite and infinite.","refs":["CL_GB18_23:RMD-03","CL_GB18_24:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-07","text":"Quality shifts from a something released from quantitative negation to the self-determination generated by quantitative relation.","refs":["CL_GB18_22:AS-05","CL_GB18_24:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-08","text":"The subject mutates from the quantitatively gradable soul-thing and abstract pure I into the non-thingly instance capable of contradiction; quantitative determination is thereby not expanded but reversed.","refs":["CL_GB18_22:AS-07","CL_GB18_24:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RMD-09","text":"Contradiction moves from a displaced difficulty through the immanent negativity of the quantum to the operative condition of conceptual sublation.","refs":["CL_GB18_24:RMD-05","CL_GB18_24:XD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_06:CGD-01","text":"Individual modes of calculation, number forms, and symbolic procedures remain local orders; at the current level they count only as instances of the difference between external operation and immanent self-movement.","refs":["CL_GB18_21:RMD-05","CL_GB18_21:FGS-B07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:CGD-02","text":"Pressure, temperature, tone, color, and individual sequences of degrees remain local examples; what alone scales upward is the rule that intensity is legible through extensive efficacy and determinacy is relational.","refs":["CL_GB18_22:CGD-02","CL_GB18_22:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:CGD-03","text":"The dissolvability or persistence of a soul-thing remains a local limit-test; what currently bears the weight is the self-limitation of quantitative categories in relation to non-thingly spirit.","refs":["CL_GB18_22:CGD-03","CL_GB18_22:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:CGD-04","text":"The infinitely large, the infinitely small, and spatial and temporal antinomies remain local manifestations; globally, they become bearers of the same structure of presupposed limit, result, and renewed limitation.","refs":["CL_GB18_23:CGD-03","CL_GB18_24:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:CGD-05","text":"Pedagogical critique, moral striving, and cosmological polemic remain local fields of application; the current level absorbs them into the difference between mechanical repetition and immanent mediation.","refs":["CL_GB18_21:CGD-05","CL_GB18_24:XD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_06:GNX-01","text":"Excluded is the equation of formal exactitude or numerical determinacy with conceptual truth.","refs":["CL_GB18_21:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GNX-02","text":"Excluded is the assumption that external aggregation could generate inner unity or self-determination from itself through repetition.","refs":["CL_GB18_21:GNX-02","CL_GB18_23:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GNX-03","text":"Excluded is pure intensity as an isolated inner magnitude, because every degree is determined only through excluded multiplicity, expression, and scale.","refs":["CL_GB18_21:GNX-03","CL_GB18_22:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GNX-04","text":"Excluded is the quantification of spirit as thing, substrate, or attenuable degree of reality.","refs":["CL_GB18_22:GNX-04","CL_GB18_22:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GNX-05","text":"Excluded is progress as cumulative approximation to a positive infinity, so long as every transcendence merely posits a new limit.","refs":["CL_GB18_23:GNX-03","CL_GB18_24:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:GNX-06","text":"Excluded is the subjective displacement of contradiction insofar as it leaves its objective form of movement untouched.","refs":["CL_GB18_24:GNX-02","CL_GB18_24:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_06:DBN-01","text":"For the system to hold, no determinacy may count as immediately given; every unity must receive its validity from a determinate order of mediation.","refs":["CL_GB18_22:DBN-01","CL_GB18_21:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:DBN-02","text":"An ontology of independent entities to which limit, relation, or expression are added only subsequently is inadmissible.","refs":["CL_GB18_24:DBN-04","CL_GB18_22:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:DBN-03","text":"The reconciliation of finitude and infinity through quantitative accumulation is inadmissible, since accumulation reproduces the form of limit it is supposed to overcome.","refs":["CL_GB18_23:DBN-03","CL_GB18_24:XD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:DBN-04","text":"A unified regime of categories under which quantitative things, forces, soul, and spirit would be explicable in the same manner is inadmissible.","refs":["CL_GB18_22:BSA-02","CL_GB18_22:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:DBN-05","text":"A contradiction-free and completed totality of world or concept, whose limits do not arise from its own enactment, is inadmissible.","refs":["CL_GB18_24:DBN-02","CL_GB18_24:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_06:BSA-01","text":"The deepest organizing absence is that of an ultimate beyond: no outside may remain permanently withdrawn from limitation, relation, and withdrawal.","refs":["CL_GB18_24:BSA-01","CL_GB18_24:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:BSA-02","text":"Immediate self-identity is unavailable, because every determinate unity must preserve its excluded multiplicity and otherness as the condition of its unity.","refs":["CL_GB18_21:BSA-01","CL_GB18_24:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:BSA-03","text":"Positive infinity as a present object within the quantitative field is unavailable; available only is the self-sublation of the form that externally fixes finitude and infinity.","refs":["CL_GB18_23:BSA-01","CL_GB18_24:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:BSA-04","text":"Unavailable is a final standpoint from which unity, multiplicity, quality, and spirit could be determined as independently existing positive entities.","refs":["CL_GB18_22:BSA-01","CL_GB18_23:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_06:XD-01","text":"Externality is not in itself deficient or productive; its status depends on whether it remains fixed as an alien positing or returns into the self-determination of the object.","refs":["MC_GB18_L1_06:GA-02","MC_GB18_L1_06:GA-08","CL_GB18_21:RMD-02","CL_GB18_24:GA-06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-02","text":"The relation of other degrees is already the elementary form of that mediated identity which at a higher level does not eliminate the beyond, but integrates it as a condition of being-with-itself.","refs":["MC_GB18_L1_06:GA-05","MC_GB18_L1_06:GA-08","MC_GB18_L1_06:GA-13","CL_GB18_21:GA-06","CL_GB18_24:AS-B08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-03","text":"Bad infinite progress is necessary because it fully exposes the externality of limit, but insufficient so long as its repetition does not itself become the object of negation.","refs":["MC_GB18_L1_06:GA-06","MC_GB18_L1_06:GA-07","MC_GB18_L1_06:GA-08","CL_GB18_24:AS-B05","CL_GB18_24:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-04","text":"That quantitative mediation produces quality does not authorize the quantification of spirit; the first transformation remains within a determinate logic of the quantum, the second requires its categorical limitation.","refs":["MC_GB18_L1_06:GA-09","MC_GB18_L1_06:GA-11","CL_GB18_22:GA-05","CL_GB18_22:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-05","text":"Mathematical forms and antinomy proofs are subject to the same test of validity: decisive is not their formal closure, but whether they mediate within their own enactment the presuppositions they require.","refs":["MC_GB18_L1_06:GA-10","MC_GB18_L1_06:GA-12","CL_GB18_21:AS-06","CL_GB18_24:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-06","text":"Contradiction becomes productive when the difference of its poles is not leveled but preserved as the self-difference of unity.","refs":["MC_GB18_L1_06:GA-12","MC_GB18_L1_06:GA-13","CL_GB18_24:XD-03","CL_GB18_24:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-07","text":"The architecture distinguishes three temporal forms: mechanical repetition of external operation, perennial repositing of the limit, and mediated return from its own externality.","refs":["MC_GB18_L1_06:GA-02","MC_GB18_L1_06:GA-07","MC_GB18_L1_06:GA-08","CL_GB18_21:BSD-04","CL_GB18_23:HSI-03","CL_GB18_24:BSD-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:XD-08","text":"Agency consists not in the abstract crossing of a limit, but in the capacity to mediate its contradiction such that external progression reverses into conceptual self-determination.","refs":["MC_GB18_L1_06:GA-11","MC_GB18_L1_06:GA-12","CL_GB18_24:GA-09","CL_GB18_24:HSI-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_06:BSD-01","text":"Reality is reconstituted as a machine of mediation in which limits generate their outside and gain their determinate unity through its return.","refs":["MC_GB18_L1_06:GA-02","MC_GB18_L1_06:GA-03","MC_GB18_L1_06:GA-13","CL_GB18_22:HSI-01","CL_GB18_24:HSI-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:BSD-02","text":"Time is neither a neutral container nor uniform progress, but the difference between mechanical repetition, negative perennation, and reflective return.","refs":["MC_GB18_L1_06:GA-06","MC_GB18_L1_06:GA-07","MC_GB18_L1_06:GA-08","CL_GB18_21:BSD-04","CL_GB18_23:HSI-03","CL_GB18_24:HSI-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:BSD-03","text":"Knowledge is ordered according to spheres of validity: technical mastery and formal justification remain legitimate local procedures, but acquire philosophical authority only through logical self-determination.","refs":["MC_GB18_L1_06:GA-10","CL_GB18_21:GA-08","CL_GB18_24:MME-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:BSD-04","text":"The subject divides into incompatible figures: as soul it is a quantitatively treatable substrate; as spirit, an instance capable of contradiction and a non-thingly source of finite determinations.","refs":["MC_GB18_L1_06:GA-11","MC_GB18_L1_06:GA-12","CL_GB18_22:BSD-02","CL_GB18_24:MP-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:BSD-05","text":"Causality shifts from the linear effect of an inner stock to reciprocal determination and finally to the open genetic question of how finite determinations arise without a presupposed thing-cause.","refs":["MC_GB18_L1_06:GA-04","MC_GB18_L1_06:GA-11","CL_GB18_22:BSD-03","CL_GB18_22:MME-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_06:BSD-06","text":"Strategic and conceptual agency arises only when the subject does not prolong contradiction through flight, but transforms the conditions of its externality.","refs":["MC_GB18_L1_06:GA-08","MC_GB18_L1_06:GA-12","CL_GB18_24:BSD-03","CL_GB18_24:HSI-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_06:RLE-01","text":"Continuity and discreteness drive toward number; number sublates multiplicity into unity; unity becomes degree; and the relation of degrees restores continuity as scale.","refs":["CL_GB18_21:RLE-01","CL_GB18_21:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-02","text":"The negative limit-loop runs as follows: determinate limit generates beyond; beyond becomes another quantum; another quantum becomes a new limit; and negation begins anew.","refs":["CL_GB18_23:RLE-02","CL_GB18_24:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-03","text":"The positive counter-loop begins when movement withdraws its own externality and thereby transforms serial repetition into self-mediation.","refs":["CL_GB18_24:RMD-03","CL_GB18_24:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-04","text":"Infinite progress marks a phase transition: as an external series it prevents sublation; as the recognized presentation of its own externality, it becomes a passage of the negation of negation.","refs":["CL_GB18_23:GA-06","CL_GB18_24:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-05","text":"The escalation path number → degree → quality → infinity ends not in a larger quantum, but in the self-limitation of the quantum and the relational reconstruction of determinacy.","refs":["CL_GB18_22:RLE-03","CL_GB18_24:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-06","text":"Contradiction is an attractor because quantitative, cosmological, and subjective problems converge on the question whether external difference is mediated or merely displaced.","refs":["CL_GB18_24:GA-09","CL_GB18_24:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:RLE-07","text":"Mediated identity is the terminal attractor: a determinate preserves itself not despite, but through the integration of its self-difference.","refs":["CL_GB18_24:RLE-05","CL_GB18_24:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_06:FGS-B01","text":"Continuity and discreteness without determinate limit → incomplete abstractions → limit as the number of equal units → extensive quantum and number.","refs":["CL_GB18_21:GA-01","CL_GB18_21:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B02","text":"Number as determinate multiplicity → sublation of number into simple limit → degree as intensive quantum.","refs":["CL_GB18_21:GA-02","CL_GB18_21:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B03","text":"Degree + excluded multiplicity + extensive efficacy → continuous scale → qualitative reality of relational intensity.","refs":["CL_GB18_21:FGS-B06","CL_GB18_22:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B04","text":"Quantitative limit + immanent self-negation → another quantum → preservation of quantity in its otherness.","refs":["CL_GB18_23:GA-02","CL_GB18_23:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B05","text":"Another quantum + renewed limitation + continued continuity → infinite progress → enduring form of the unresolved contradiction of limit.","refs":["CL_GB18_23:GA-06","CL_GB18_23:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B06","text":"Recognition that the beyond is itself quantum → limitability of the beyond → collapse of its asserted independence.","refs":["CL_GB18_24:AS-B06","CL_GB18_24:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B07","text":"Limitation of the beyond → negation of negation → externality as its own moment → qualitative unity of relation.","refs":["CL_GB18_24:FGS-B05","CL_GB18_24:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FGS-B08","text":"Relational quality → examination of the categorical scope of validity → sublation of the quantum for spirit → open genetic explanation of finitude.","refs":["CL_GB18_22:GA-07","CL_GB18_22:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_06:AFM-B01","text":"Abstract continuity and discreteness → number as determinate limit → sublation of number in degree → scale of relational intensity → qualitative self-transcendence of the quantum → self-negating limit → bad infinity → self-quantification and limitation of the beyond → negation of negation → relational quality → categorical limit in relation to spirit.","refs":["CL_GB18_21:RLE-01","CL_GB18_22:RLE-03","CL_GB18_24:RLE-03","CL_GB18_24:FGS-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_06:MME-01","text":"Quantity is remapped from static magnitude into a processual form of self-differentiation.","refs":["CL_GB18_23:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-02","text":"Externality is no longer mapped uniformly as a defect, but as an alternating function extending from mechanical positing to its own moment of determinacy.","refs":["CL_GB18_21:RMD-02","CL_GB18_24:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-03","text":"The taxonomy of extensive and intensive magnitudes collapses in favor of a field of reciprocal form-determinations of the same quantity.","refs":["CL_GB18_22:GA-01","CL_GB18_22:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-04","text":"Quality and quantity are no longer treated as fixed opposites; quality appears as self-determination generated through quantitative negation and relation.","refs":["CL_GB18_24:GA-07","CL_GB18_24:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-05","text":"Finitude and infinity lose the status of separate regions and become moments of a form of movement whose truth lies in the sublation of their external fixation.","refs":["CL_GB18_23:MME-03","CL_GB18_24:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-06","text":"Relation is reclassified from a subsequent operation of comparison into the ontological form of reciprocal determinacy.","refs":["CL_GB18_24:BSD-05","CL_GB18_24:DBN-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-07","text":"Mathematical form and proof are transformed from external authorities into diagnostic objects whose presuppositions must be logically reconstructed.","refs":["CL_GB18_24:MME-05","CL_GB18_21:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MME-08","text":"The subject is no longer mapped along a gradual intensity, but through the difference between quantitative soul-thing and spirit capable of contradiction.","refs":["CL_GB18_22:MME-03","CL_GB18_24:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_06:ALT-B01","text":"Surface level — The field encompasses number, degree, extensive quantity, intensive unity, force, soul, spirit, infinite numbers, and spatial, temporal, and cosmological limits.","refs":["CL_GB18_22:ALT-B01","CL_GB18_24:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:ALT-B02","text":"Structural level — Limit, externality, and relation form the recursive mechanism through which unity generates, preserves, and withdraws its excluded multiplicity.","refs":["CL_GB18_21:RLE-04","CL_GB18_24:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:ALT-B03","text":"Metastrategic level — Interpretation and intervention are distinguished according to whether they present external repetition as progress or transform reproduced contradiction into immanent mediation.","refs":["CL_GB18_23:ALT-B03","CL_GB18_24:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:ALT-B04","text":"Ontological / Temporal level — Reality exists as mediated self-difference; time extends from mechanical repetition through perennial limit to reflective return, while spirit categorically transcends the quantitative form of time.","refs":["CL_GB18_23:BSD-01","CL_GB18_24:HSI-03","CL_GB18_22:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:ALT-B05","text":"Methodological / Performative level — The presentation enacts its thesis by destabilizing every concept through its own mediation and tracing argumentative forms back to their concealed presuppositions.","refs":["CL_GB18_22:ALT-B05","CL_GB18_24:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_06:FL-01","text":"Number counts at once as conceptless externality and as necessary mediation of degree; the architecture requires its form while rejecting its claim to conceptual truth.","refs":["CL_GB18_21:FL-01","CL_GB18_21:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FL-02","text":"Degree is conceived both as simple self-relation and as a unity determined only through other degrees; its simplicity is therefore real and not independent.","refs":["CL_GB18_21:FL-02","CL_GB18_22:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FL-03","text":"Quantitative recursion is supposed to be unable to attain positive qualitative infinity, while its immanent self-sublation simultaneously appears as true infinity; coherence depends on the change in the form of determinacy.","refs":["CL_GB18_23:MRT-B02","CL_GB18_24:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FL-04","text":"Quantitative mediation produces quality, but must be sublated for spirit; it remains underdetermined how the two transitions belong together without quantifying spirit anew.","refs":["CL_GB18_22:AS-08","CL_GB18_22:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FL-05","text":"The world is supposed to possess contradiction but not be able to bear it, whereas spirit is supposed to sublate it; the mediation between objective negativity and spiritual resolution remains open.","refs":["CL_GB18_24:FL-02","CL_GB18_24:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:FL-06","text":"Relational unity threatens to become external once more unless it is shown how the relation preserves its unity without transforming itself back into a mere order of independent quanta.","refs":["CL_GB18_24:FL-04","CL_GB18_24:DBN-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MP-01","text":"Externality mutates at the transition from mechanical operation to the determination of reality and again in its withdrawal into mediated unity.","refs":["CL_GB18_21:MP-02","CL_GB18_24:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MP-02","text":"The limit mutates from determining negation into the recursively re-posited limit and finally into the medium of the sublation of the beyond.","refs":["CL_GB18_23:RMD-01","CL_GB18_24:FGS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MP-03","text":"Infinity mutates from the bad form of repetition without a positive alternative into the self-sublation of the external opposition between finite and infinite.","refs":["CL_GB18_23:MP-02","CL_GB18_24:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MP-04","text":"Quality mutates from the apparent counter-principle of quantity into the self-determination generated through quantitative relation.","refs":["CL_GB18_24:MP-03","CL_GB18_24:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MP-05","text":"The subject mutates from the abstract I and quantitatively determinable soul-thing into the instance capable of contradiction, whose positive genetic structure remains unelaborated.","refs":["CL_GB18_24:MP-04","CL_GB18_22:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_06:HSI-01","text":"Reality appears as a machine of posited limits that produce their outside and are determined only through the return from this externality.","refs":["CL_GB18_24:HSI-01","CL_GB18_24:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:HSI-02","text":"The subject is neither a calculating machine nor an abstract transcender, but an instance capable of contradiction, whose freedom lies in mediating self-determination.","refs":["CL_GB18_21:HSI-02","CL_GB18_24:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:HSI-03","text":"Time appears as a threefold machine of external repetition, endless repositing of the limit, and reflective sublation of fixed endpoints.","refs":["CL_GB18_21:HSI-03","CL_GB18_23:HSI-03","CL_GB18_24:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:HSI-04","text":"Struggle and navigation consist in not prolonging external transcendence, but in transforming externality into its own moment of a mediated unity.","refs":["CL_GB18_24:HSI-04","CL_GB18_24:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_06:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from number and degree through qualitative mediation and bad infinity to relational self-determination.","refs":["CL_GB18_22:MRT-B01","CL_GB18_24:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MRT-B02","text":"The architecture is strongest where it reconstructs apparent disappearance as functional mutation: number remains in degree, and reproduced externality is withdrawn into self-mediation.","refs":["CL_GB18_21:MRT-B04","CL_GB18_24:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MRT-B03","text":"What remains underdetermined is the positive genetic explanation of how spirit brings forth existence, consciousness, and finitude without falling back into quantitative or thingly categories.","refs":["CL_GB18_22:MRT-B03","CL_GB18_24:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MRT-B04","text":"Also underdetermined remains the precise transition from bad quantitative infinity to the relational form of true infinity; its coherence depends on the distinction between external series and immanent withdrawal.","refs":["CL_GB18_23:MRT-B02","CL_GB18_24:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MRT-B05","text":"The system is coherent at this level insofar as quantum, quality, soul, and spirit are treated as stratified spheres of validity and quantitative repetition, abstract opposition, and external unity are recognized as variants of unsublated negativity.","refs":["CL_GB18_22:MRT-B04","CL_GB18_24:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_06:MRT-B06","text":"An indispensable remainder resists axiomatic closure: the productive condensation of infinity, quality, being-for-self, and spirit generates the highest systematic achievement, but simultaneously remains the strongest zone of strain.","refs":["CL_GB18_24:MRT-B04","CL_GB18_21:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_06@R001","source_variant_id":"canonical:MC_GB18_L1_06:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 06","context":"Chapters 61–72 · Anmerkung 1. · Anmerkung 2. · a. Unterschied derselben. · b. Identität der extensiven und intensiven Größe. · Anmerkung 1. · Anmerkung 2. · c. Die Veränderung des Quantums. · a. Begriff derselben. · b. Der quantitative unendliche Progreß. · Anmerkung 1. · Anmerkung 2. · c. Die Unendlichkeit des Quantums."},"title_language_code":"en"},{"id":"MC_GB18_L1_07","layer":"MC","title":"Gb18 L1 07","order":7,"parents":["CL_GB18_25","CL_GB18_26","CL_GB18_27","CL_GB18_28"],"revision":"MC_GB18_L1_07@R001","sha256":"85684da81768bc03566c512e24d75c974796f64642d46336f468437ee85c949b","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_07:AS-01","text":"Das System bearbeitet den Widerspruch, dass quantitative Verfahren exakte oder stabile Resultate hervorbringen, obwohl die qualitative und gegenständliche Legitimität ihrer Operationen zunächst unbestimmt bleibt.","refs":["CL_GB18_25:AS-01","CL_GB18_27:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-02","text":"Seine globale These lautet, dass Quantität nur durch eine qualitative Relation oder Maßstruktur bestimmte Geltung erhält und niemals als selbständiges Erklärungsprinzip ausreicht.","refs":["CL_GB18_25:GA-02","CL_GB18_27:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-03","text":"Die gerichtete Bewegung führt von äußerlichen Quanta und Vergleichungen über Verhältnis, Exponent und Potenz zur selbstvermittelten Maßbestimmung und schließlich zum Übergang in das Wesen.","refs":["CL_GB18_26:BAS-05","CL_GB18_27:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-04","text":"Anwendung und Messung bilden notwendige Prüfstellen, weil erst am bestimmten Gegenstand sichtbar wird, ob eine formale Operation eine immanente Relation erfasst oder lediglich eine äußere Regel überträgt.","refs":["CL_GB18_25:AS-04","CL_GB18_28:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-05","text":"Das Argument verläuft rekursiv und mutationsgetrieben: Jede unzureichende Form erzeugt durch ihren eigenen Mangel die Bestimmung, die sie überschreitet und zugleich bewahrt.","refs":["CL_GB18_25:AS-06","CL_GB18_26:BAS-06","CL_GB18_28:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-06","text":"Die Zeitstruktur verbindet zwei Bewegungen: Schlechte Unendlichkeit verschiebt die Bestimmung endlos, während kumulative Variation eine immanente Grenze freilegt und dadurch qualitativen Umschlag erzeugt.","refs":["CL_GB18_25:BSD-03","CL_GB18_27:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-07","text":"Die kategoriale Schließung liegt im Maß, sofern quantitative Äußerlichkeit darin als qualitative Selbstvermittlung zurückkehrt und ihre unmittelbare Form aufhebt.","refs":["CL_GB18_26:BSD-05","CL_GB18_27:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-08","text":"Diese Schließung bleibt bedingt, weil weder sämtliche Funktionsformen noch konkrete Maßgrenzen und Potenzgesetze aus einer universalen Regel vollständig ableitbar werden.","refs":["CL_GB18_25:AS-08","CL_GB18_27:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_07:GA-01","text":"[Persistent] Ein Quantum besitzt keine vollständige Bestimmtheit unabhängig von der Relation, in der seine Selbständigkeit zu einem vermittelten Moment herabgesetzt wird.","refs":["CL_GB18_26:GA-01","CL_GB18_25:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-02","text":"[Attractor] Der affirmative Grund quantitativer Bestimmtheit ist eine qualitative Relation, durch die Quantität überhaupt erst als bestimmte Größe oder als Maß gilt.","refs":["CL_GB18_25:GA-02","CL_GB18_28:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-03","text":"[Mutating] Äußerlichkeit mutiert vom gleichgültig Gegebenen zur eigenen Entäußerung einer Bestimmung und schließlich zur Gesetzlichkeit, in der diese Bestimmung zu sich zurückkehrt.","refs":["CL_GB18_27:GA-03","CL_GB18_28:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-04","text":"[Mutating] Der Exponent wandelt sich vom gemeinsamen Zahlenwert über Grenze und Produkt zum qualitativen Prinzip, das die Veränderung seiner Seiten organisiert.","refs":["CL_GB18_26:GA-02","CL_GB18_28:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-05","text":"[Persistent] Qualität und Quantität bilden nur durch doppelte Vermittlung eine Totalität; ihre unmittelbare Gleichsetzung oder äußerliche Trennung zerstört die Maßstruktur.","refs":["CL_GB18_26:GA-09","CL_GB18_27:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-06","text":"[Emergent] Maß ist die höhere Architektur, in der Regel, quantitative Variation, qualitative Grenze und gegenständliche Spezifikation als Momente einer einzigen Bestimmung zusammenwirken.","refs":["CL_GB18_28:AS-06","CL_GB18_27:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-07","text":"[Emergent] Formale Erzeugung, Messung und symbolische Darstellung begründen ihre Gegenstandsbedeutung nicht selbst; sie benötigen qualitative Typisierung und gegenständliche Validierung.","refs":["CL_GB18_25:GA-06","CL_GB18_28:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-08","text":"[Persistent] Resultaterfolg, historische Brauchbarkeit und symbolische Verfügbarkeit ersetzen weder begriffliche Notwendigkeit noch den Nachweis des bestimmten Gegenstandsverhältnisses.","refs":["CL_GB18_25:GA-01","CL_GB18_27:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-09","text":"[Mutating] Unendlichkeit mutiert vom äußeren Progress zur immanenten Vollständigkeit einer Relation und wird im Maßlosen zur Negativität, durch die eine unmittelbare Maßform sich selbst überschreitet.","refs":["CL_GB18_25:GA-04","CL_GB18_27:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-10","text":"[Emergent] Arithmetische Wiederholung oder Addition erzeugt qualitative Veränderung nur, wenn sie durch ein immanentes Maßgesetz organisiert und an eine qualitative Grenze geführt wird.","refs":["CL_GB18_27:BSA-03","CL_GB18_28:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-11","text":"[Terminal] Die Selbstvermittlung des Maßes hebt dessen Unmittelbarkeit auf und erzeugt den Übergang in eine reflektierte Wesensstruktur.","refs":["CL_GB18_27:GA-07","CL_GB18_27:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-12","text":"[Attractor] Konkrete Identität besteht in der Stabilität vermittelter Differenz, nicht in unterschiedsloser Einheit oder isolierter Verschiedenheit.","refs":["CL_GB18_27:GA-09","CL_GB18_28:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-13","text":"[Emergent] Quantitative Erklärung besitzt regionale Geltung, deren Reichweite mit der Konkretion des Gegenstands sinkt und die daher keine universale Ontologie begründen kann.","refs":["CL_GB18_27:GA-08","CL_GB18_27:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-14","text":"[Terminal] Infinitesimale Entitäten, äußere Regeln und symbolische Hilfsformen verlieren ihre Grundlegungsfunktion, sobald die von ihnen verdeckte qualitative Vermittlung expliziert ist.","refs":["CL_GB18_25:RMD-08","CL_GB18_27:GA-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_07:RMD-01","text":"Das Quantum kehrt funktional verändert wieder: vom selbständigen Wert über das unselbständige Relationsmoment bis zur auf sich bezogenen Äußerlichkeit innerhalb einer Maßgrenze.","refs":["CL_GB18_25:GA-03","CL_GB18_26:RMD-01","CL_GB18_27:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-02","text":"Das Verhältnis mutiert von einer äußeren Verbindung fertiger Größen zur erzeugenden Struktur ihrer Bestimmtheit; sein Exponent wird dadurch vom Resultat zur Vermittlungsinstanz.","refs":["CL_GB18_26:GA-02","CL_GB18_28:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-03","text":"Die Potenz bewahrt ihre Funktion als qualitative Relationsform, erweitert sich aber vom spezifischen Kalkülgrund zum Modell einer Gesetzlichkeit, die quantitative Reihen qualitativ transformiert.","refs":["CL_GB18_25:GA-05","CL_GB18_28:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-04","text":"Unendlichkeit wird zunächst vom äußeren Progress in relationale Gegenwart zurückgenommen und später funktional durch das Maßlose ersetzt, das nicht Ferne, sondern immanente Selbstnegation bezeichnet.","refs":["CL_GB18_25:GA-04","CL_GB18_27:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-05","text":"Anwendung und Regel erfahren eine parallele Umkehrung: Beide beginnen als nachgeordnete oder äußere Instanzen und werden zu Orten, an denen qualitative Spezifikation sichtbar und prüfbar wird.","refs":["CL_GB18_25:RMD-04","CL_GB18_28:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-06","text":"Reihe und Summation verlieren ihre Erklärungsautonomie; sie bleiben als technische oder phänomenale Ausgangsformen erhalten, werden aber einer qualitativen Gesetzlichkeit untergeordnet.","refs":["CL_GB18_25:RMD-05","CL_GB18_28:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-07","text":"Äußerlichkeit kehrt ihre Valenz um: Sie ist zunächst das Gleichgültige oder Fremde, wird dann als eigene Negation vermittelt und endet als Ort qualitativen Fürsichseins.","refs":["CL_GB18_27:GA-03","CL_GB18_28:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-08","text":"Maß mutiert von der unmittelbaren Einheit von Qualität und Quantität zur selbstreflexiven Bewegung, die ihre Unmittelbarkeit aufhebt und in das Wesen übergeht.","refs":["CL_GB18_27:GA-02","CL_GB18_27:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-09","text":"Symbol, Infinitesimales und äußere Norm verschwinden nicht wirkungslos; sie werden terminal verdrängt, nachdem sie die noch unexplizierte Vermittlungsstelle angezeigt haben.","refs":["CL_GB18_25:GA-08","CL_GB18_28:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_07:CGD-01","text":"Historische Begründungen durch Grenzwerte, Nullen oder Reihen bleiben lokale Kalküldiagnosen; auf die aktuelle Ebene skaliert ihre gemeinsame Unfähigkeit, qualitative Vermittlung aus bloßer Quantität zu erzeugen.","refs":["CL_GB18_25:CGD-01","CL_GB18_25:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-02","text":"Die Abfolge von direktem, umgekehrtem und potenziellem Verhältnis bleibt eine lokale kategoriale Sequenz; global tragend ist die Eskalation von äußerer Verbindung zu relationaler Selbstbestimmung.","refs":["CL_GB18_26:CGD-04","CL_GB18_26:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-03","text":"Geometrische Dimensionsmodelle bleiben gegenstandsspezifisch; nach oben skaliert allein die Forderung, formal gleiche Operationen nach ihrer qualitativen Gegenstandsfunktion zu typisieren.","refs":["CL_GB18_25:CGD-05","CL_GB18_25:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-04","text":"Einzelne Sorites-Figuren und besondere Maßgrenzen bleiben lokale Fälle; aktuell tragend ist die immanente Schwellenstruktur, durch die Variation ihre qualitative Funktion ändert.","refs":["CL_GB18_27:CGD-02","CL_GB18_27:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-05","text":"Die Zerlegung bestimmter Einheiten und die genaue Form einzelner Potenzreihen bleiben untere Mechanismen; global bleibt die Relativierung unmittelbarer Maßeinheiten und arithmetischer Erklärungsautonomie.","refs":["CL_GB18_28:CGD-01","CL_GB18_28:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-06","text":"Die konstitutive Rolle der Anwendung überschreitet den lokalen Kalkülkontext, weil sie auf aktueller Ebene jede formale oder messende Operation an eine gegenständliche Spezifikation bindet.","refs":["CL_GB18_25:GA-07","CL_GB18_28:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-07","text":"Der Übergang in das Wesen ist keine weitere lokale Maßoperation, sondern die aktuelle Schließungsform, in der die gesamte Entwicklung von äußerer Quantität zu reflektierter Selbstvermittlung zusammenläuft.","refs":["CL_GB18_27:GA-07","CL_GB18_27:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_07:GNX-01","text":"Ausgeschlossen ist ein Modell selbständiger Quanta oder Relata, die ihre volle Bestimmtheit vor und unabhängig von ihren Beziehungen besitzen.","refs":["CL_GB18_25:DBN-01","CL_GB18_26:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-02","text":"Ausgeschlossen ist ein sich selbst interpretierender Formalismus, der aus syntaktischer Ableitbarkeit unmittelbar qualitative Bedeutung oder reale Existenz gewinnt.","refs":["CL_GB18_25:GNX-05","CL_GB18_25:GNX-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-03","text":"Ausgeschlossen ist ein universaler äußerer Maßstab, der besondere Gegenstandsmaße erzeugen oder begriffliche Selbstbestimmung ersetzen könnte.","refs":["CL_GB18_27:GNX-03","CL_GB18_27:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-04","text":"Ausgeschlossen ist eine additive Kausalität, in der bloße Wiederholung oder Summation ohne immanente Maßrelation qualitative Veränderung hervorbringt.","refs":["CL_GB18_27:BSA-03","CL_GB18_27:XD-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-05","text":"Ausgeschlossen sind unendlicher Progress, Annäherung und infinitesimale Zwischenentitäten als affirmative Gründe mathematischer oder kategorialer Bestimmtheit.","refs":["CL_GB18_25:GNX-03","CL_GB18_26:GNX-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-06","text":"Ausgeschlossen ist eine unmittelbare Einheit von Qualität und Quantität, die Differenz entweder auslöscht oder als unverbundene Selbständigkeit fortbestehen lässt.","refs":["CL_GB18_26:GNX-05","CL_GB18_27:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-07","text":"Ausgeschlossen ist die Universalisierung quantitativer Gesetzlichkeit zum Modell organischer, geistiger oder ontologischer Wirklichkeit überhaupt.","refs":["CL_GB18_27:GNX-05","CL_GB18_27:GA-08"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-08","text":"Ausgeschlossen ist die ontologische Erzeugung kontinuierlicher Wirklichkeit aus diskreten Elementen, auch wenn diskrete Verfahren ihre Größenbestimmung leisten können.","refs":["CL_GB18_25:GNX-06","CL_GB18_25:CGD-03"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_07:DBN-01","text":"Falsch sein muss jedes atomistische Gesamtmodell, das volle Selbständigkeit der Glieder mit konstitutiver relationaler Bestimmtheit vereinbaren will.","refs":["CL_GB18_26:DBN-01","CL_GB18_28:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:DBN-02","text":"Falsch sein muss jede Erklärung, die einer bereits fertigen quantitativen Bewegung nachträglich Qualität, Zweck oder Bedeutung hinzufügt.","refs":["CL_GB18_26:DBN-02","CL_GB18_25:DBN-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:DBN-03","text":"Nicht zulässig ist ein gemeinsames äußeres Medium, das mathematische Form, Natur, Geist und Begriff ohne kategoriale Transformation kommensurabel macht.","refs":["CL_GB18_27:BSA-01","CL_GB18_25:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:DBN-04","text":"Nicht zulässig ist die Ersetzung begrifflicher Selbstvermittlung durch symbolische Verfügbarkeit, numerische Ordnung oder Zeichenökonomie.","refs":["CL_GB18_27:GNX-02","CL_GB18_27:GA-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:DBN-05","text":"Nicht zulässig ist eine Totalität, die durch einen einzigen Übergang, unmittelbare Identität oder die absolute Selbstgleichheit eines ihrer Momente hergestellt wird.","refs":["CL_GB18_26:DBN-03","CL_GB18_26:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:DBN-06","text":"Nicht zulässig ist die Gleichsetzung operativer Bestimmung mit ontologischer Zusammensetzung; Berechenbarkeit darf die Existenzweise des Gegenstands nicht fingieren.","refs":["CL_GB18_25:XD-07","CL_GB18_25:XD-06"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_07:BSA-01","text":"Das System ist um die Abwesenheit eines äußeren Jenseits organisiert, in das die gesuchte Bestimmung ohne Rückkehr zur immanenten Relation ausgelagert werden könnte.","refs":["CL_GB18_25:BSA-02","CL_GB18_26:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:BSA-02","text":"Die tiefste nicht verfügbare Entität ist ein Mittelwesen, das zugleich selbständiges Quantum, reines Relationsmoment, formale Operation und reale Gegenstandsbestimmung wäre.","refs":["CL_GB18_25:BSA-01","CL_GB18_25:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:BSA-03","text":"Unverfügbar sind sowohl reine Äußerlichkeit ohne immanente Bestimmung als auch reine Immanenz ohne quantitative Entäußerung.","refs":["CL_GB18_28:BSA-04","CL_GB18_26:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:BSA-04","text":"Unmöglich ist ein absolut selbstidentisches Moment, das seine Selbständigkeit vollständig bewahrt und dennoch konstitutiver Teil einer Relation bleibt.","refs":["CL_GB18_26:BSA-04","CL_GB18_26:GA-11"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:BSA-05","text":"Nicht verfügbar ist eine vollständig kommensurable Zahlenordnung, in der qualitative Differenz ohne Rest als quantitative Variation dargestellt werden könnte.","refs":["CL_GB18_28:GNX-05","CL_GB18_27:RMD-04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_07:XD-01","text":"Mathematische Legitimität verlangt, dass eine formal erzeugte Relation als immanente Maßbestimmung des jeweiligen Gegenstands ausgewiesen wird; weder formaler Erfolg noch bloße Immanenzbehauptung genügen allein.","refs":["MC_GB18_L1_07:GA-02","MC_GB18_L1_07:GA-06","MC_GB18_L1_07:GA-07","CL_GB18_25:CGD-02","CL_GB18_27:CGD-04"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-02","text":"Potenzenverhältnis und Maßpotenz bilden eine gemeinsame Transformationslogik: Der Exponent erfasst nicht nur einen Zahlenwert, sondern die qualitative Invariante, nach der quantitative Momente sich verändern.","refs":["MC_GB18_L1_07:GA-02","MC_GB18_L1_07:GA-04","MC_GB18_L1_07:GA-06","CL_GB18_25:GA-05","CL_GB18_26:RMD-02","CL_GB18_28:GA-06"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-03","text":"Die Anwendung liefert qualitative Bestimmtheit nicht von außen, sondern ist der Ort, an dem die behauptete Selbstbestimmung eines Gegenstands erkannt, typisiert und unabhängig validiert werden muss.","refs":["MC_GB18_L1_07:GA-03","MC_GB18_L1_07:GA-07","CL_GB18_25:GA-07","CL_GB18_27:DBN-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:XD-04","text":"Quantitative Veränderung besitzt zwei Zeitformen: arithmetische Sukzession auf der Oberfläche und eine kumulative, potenzielle oder schwellenförmige Bewegung, die ihre qualitative Bedeutung verändert.","refs":["MC_GB18_L1_07:GA-04","MC_GB18_L1_07:GA-10","CL_GB18_27:BSD-02","CL_GB18_28:BSD-04"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-05","text":"Infinitesimales und Maßloses markieren verschiedene Stadien desselben Vermittlungsdefizits: Das erste verdeckt eine qualitative Relation, das zweite legt die Negativität einer bereits bestimmten Maßform frei.","refs":["MC_GB18_L1_07:GA-09","MC_GB18_L1_07:GA-14","CL_GB18_25:XD-03","CL_GB18_27:GA-05"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-06","text":"Ein diskretes oder äußerliches Verfahren kann ein kontinuierliches oder qualitativ bestimmtes Dasein messen, ohne dessen ontologische Zusammensetzung zu erzeugen, sofern seine Abhängigkeit von der Maßrelation explizit bleibt.","refs":["MC_GB18_L1_07:GA-06","MC_GB18_L1_07:GA-07","CL_GB18_25:GA-10","CL_GB18_28:DBN-05"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-07","text":"Exaktheit wird von universaler Reichweite entkoppelt: Ein quantitatives Verfahren kann ein invariantes Moment vollständig erfassen und dennoch nur für einen begrenzten Gegenstandsbereich gelten.","refs":["MC_GB18_L1_07:GA-08","MC_GB18_L1_07:GA-13","CL_GB18_25:BSD-06","CL_GB18_27:GA-08"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-08","text":"Sobald qualitative Vermittlung und Maßgesetz expliziert sind, werden Infinitesimales, Symbol und äußere Regel von Grundlagen zu abgeleiteten Darstellungs- oder Operationsmitteln.","refs":["MC_GB18_L1_07:GA-07","MC_GB18_L1_07:GA-14","CL_GB18_25:RMD-08","CL_GB18_27:GA-06"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_07:BSD-01","text":"Die erzeugte Ontologie ist relational und maßförmig: Bestimmtheiten bestehen nicht vor ihren Beziehungen, sondern werden durch Grenze, Potenz, Gegenstandsbezug und qualitative Vermittlung erzeugt.","refs":["MC_GB18_L1_07:GA-01","MC_GB18_L1_07:GA-02","MC_GB18_L1_07:GA-06","CL_GB18_25:BSD-01","CL_GB18_26:BSD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-02","text":"Erkenntnis wird zu einem gestuften Prozess aus formaler Erzeugung, qualitativer Typisierung, gegenständlicher Prüfung und Reflexion der verwendeten Maß- oder Symbolform.","refs":["MC_GB18_L1_07:GA-07","MC_GB18_L1_07:GA-08","CL_GB18_25:BSD-02","CL_GB18_27:BSD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-03","text":"Zeit ist weder reine Progression noch bloßer Sprung, sondern die Verschränkung gegenwärtiger Relationsvollständigkeit mit kumulativer Veränderung und qualitativer Schwelle.","refs":["MC_GB18_L1_07:GA-09","MC_GB18_L1_07:GA-10","CL_GB18_25:BSD-03","CL_GB18_27:BSD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-04","text":"Kausalität wird nicht-additiv rekonstituiert: Wiederholung wirkt nur durch die immanente Negativität einer Maßstruktur, die an ihrer Grenze eine neue Qualität hervorbringt.","refs":["MC_GB18_L1_07:GA-06","MC_GB18_L1_07:GA-10","CL_GB18_27:BSA-03","CL_GB18_27:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-05","text":"Das erkennende Subjekt wird zur vermittelnden Instanz, die Operation, Typisierung und Gegenstandsbeweis auseinanderhält, ohne sich als souveräner Setzer der Maßbestimmung zu verstehen.","refs":["MC_GB18_L1_07:GA-03","MC_GB18_L1_07:GA-07","CL_GB18_25:HSI-02","CL_GB18_27:HSI-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-06","text":"Methode wird zur Verbindung immanenter Kritik mit retroaktiver Gegenstandsprüfung: Eine Form erzeugt aus ihrem Mangel ihre Nachfolge, während Anwendungen die abstrahierte Relation bestätigen oder korrigieren.","refs":["MC_GB18_L1_07:GA-07","MC_GB18_L1_07:GA-12","CL_GB18_26:BSD-03","CL_GB18_25:RLE-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-07","text":"Der Übergang zum Wesen verändert den Status des Maßes: Es ist nicht länger unmittelbare Einheit, sondern reflektierte Gesetzlichkeit einer Äußerlichkeit, die als eigenes Moment begriffen wurde.","refs":["MC_GB18_L1_07:GA-03","MC_GB18_L1_07:GA-11","CL_GB18_27:GA-07","CL_GB18_28:BSD-06"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_07:RLE-01","text":"Der Rechtfertigungszyklus führt von formalem Erfolg über begriffliche Unterbestimmtheit zur qualitativen Rekonstruktion, von dort zur Anwendung und durch deren Prüfung zurück zur revidierten Theorie.","refs":["CL_GB18_25:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-02","text":"Die Verhältnis-Spirale führt vom vertauschbaren Quotienten über negative Gegenseitigkeit und Produkt zum Potenzexponenten und schließlich zur Maßbestimmung.","refs":["CL_GB18_26:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-03","text":"Die Äußerlichkeitsschleife verläuft von der äußeren Regel über die Beziehung auf ihr Anderes zur qualitativen Spezifikation und endet im Fürsichsein innerhalb der Äußerlichkeit.","refs":["CL_GB18_28:RLE-05","CL_GB18_28:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-04","text":"Die Schwelleneskalation führt von gleichgültiger Variation über Wiederholung und Akkumulation zur Maßgrenze, an der quantitative Fortsetzung ihre qualitative Funktion umkehrt.","refs":["CL_GB18_27:BSD-02","CL_GB18_27:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-05","text":"Die Symbolschleife führt von äußerer Darstellung über die Forderung begrifflicher Ausweisung zur Entbehrlichkeit des Symbols und von dort zur Diagnose jeder erneuten Zeichenersparnis.","refs":["CL_GB18_27:GA-06","CL_GB18_27:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-06","text":"Die Unendlichkeitsschleife verwandelt den endlosen Progress in gegenwärtige Relationsvollständigkeit und verschiebt dessen negative Restfunktion anschließend auf das Maßlose.","refs":["CL_GB18_26:RLE-04","CL_GB18_25:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-07","text":"Der gemeinsame Attraktor ist die selbstbezügliche qualitative Invariante, auf die Potenzenverhältnis, Exponent, Maßgrenze und gegenständliche Typisierung konvergieren.","refs":["CL_GB18_25:RLE-06","CL_GB18_27:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_07:FGS-B01","text":"Exakter oder stabiler Operationserfolg plus begrifflich widersprüchliche Verfahrensform erzeugt ein Rechtfertigungsdefizit.","refs":["CL_GB18_25:FGS-B01","CL_GB18_25:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B02","text":"Die Negation selbständiger Quanta erhält ihre Bestimmtheit als unselbständiges Moment einer Relation, statt sie in kleinen oder isolierten Entitäten zu konservieren.","refs":["CL_GB18_25:FGS-B02","CL_GB18_26:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B03","text":"Das Relationsmoment organisiert sich als Exponent, Grenze oder Potenz und erzeugt dadurch eine qualitative Gesetzlichkeit quantitativer Veränderung.","refs":["CL_GB18_25:FGS-B03","CL_GB18_26:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B04","text":"Die formale Erzeugung liefert zunächst nur ein Verhältnis; Anwendung, Typisierung und Gegenstandsbeweis bestimmen dessen konkrete Geltung.","refs":["CL_GB18_25:FGS-B04","CL_GB18_25:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B05","text":"Äußerliche Vergleichung relativiert ihre eigene Einheit und mutiert durch die Beziehung auf den Gegenstand zur spezifischen Maßbestimmung.","refs":["CL_GB18_28:FGS-B01","CL_GB18_28:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B06","text":"Wiederholte quantitative Variation aktiviert die immanente Maßgrenze und erzeugt eine qualitative Folgereihe, einen Umschlag oder den Untergang der bisherigen Form.","refs":["CL_GB18_27:XD-03","CL_GB18_28:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B07","text":"Das Maß reflektiert seine unmittelbare Einheit, nimmt Äußerlichkeit als eigenes Moment zurück und geht dadurch in das Wesen über.","refs":["CL_GB18_27:GA-07","CL_GB18_28:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B08","text":"Die Maschine schließt relativ durch qualitative Selbstvermittlung, bleibt aber hinsichtlich universaler Funktionsreduktion, konkreter Schwellen und regionaler Geltung offen.","refs":["CL_GB18_25:AS-08","CL_GB18_27:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_07:AFM-B01","text":"Selbständiges Quantum → äußerliche Relation → gemeinsamer Exponent → negative Gegenseitigkeit → Potenzrelation → qualitative Maßbestimmung → reflektierte Gesetzlichkeit → Wesen.","refs":["CL_GB18_26:BAS-07","CL_GB18_27:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AFM-B02","text":"Formaler Erfolg → Rechtfertigungsdefizit → qualitative Typisierung → Anwendung → unabhängiger Gegenstandsbeweis → begrenzte mathematische Geltung.","refs":["CL_GB18_25:AS-01","CL_GB18_25:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AFM-B03","text":"Äußerliche Variation → Wiederholung → Akkumulation → immanente Maßgrenze → qualitative Reaktion → neue Gesetzlichkeit → Aufhebung der unmittelbaren Maßform.","refs":["CL_GB18_27:AS-06","CL_GB18_27:AFM-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_07:MME-01","text":"Der Gegensatz von endlich und unendlich wird durch die Differenz von äußerem Progress, immanenter Relationsvollständigkeit und maßinterner Negativität ersetzt.","refs":["CL_GB18_25:MME-01","CL_GB18_27:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-02","text":"Verhältnis wird von einer Vergleichsoperation zur konstitutiven Form umklassifiziert, durch die ihre Seiten überhaupt bestimmte Geltung erhalten.","refs":["CL_GB18_26:MME-01","CL_GB18_26:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-03","text":"Anwendung und Messung werden von nachgeordneten Vollzügen zu Prüfstellen der qualitativen und gegenständlichen Legitimität formaler Operationen.","refs":["CL_GB18_25:MME-03","CL_GB18_28:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-04","text":"Der Gegensatz von Qualität und Quantität wird als Maßstruktur neu kartiert, in der beide Seiten nur durch reziproke Vermittlung bestehen.","refs":["CL_GB18_26:MME-05","CL_GB18_28:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-05","text":"Der Gegensatz gradueller und sprunghafter Veränderung bricht zusammen, weil der qualitative Umschlag als immanente Funktion kontinuierlicher Akkumulation erscheint.","refs":["CL_GB18_27:MME-02","CL_GB18_27:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-06","text":"Diskretion und Kontinuität werden auf unterschiedliche Ebenen verteilt: Diskrete Verfahren bestimmen Größen, ohne kontinuierliche Existenz ontologisch zusammenzusetzen.","refs":["CL_GB18_25:MME-04","CL_GB18_25:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-07","text":"Mathematische Erklärung wird regionalisiert: Ihre Stärke beruht auf der Erfassung bestimmter Invarianten und nicht auf universaler Übertragbarkeit.","refs":["CL_GB18_27:MME-04","CL_GB18_25:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-08","text":"Inneres und Äußeres bilden keinen statischen Gegensatz mehr; Äußerlichkeit wird zum notwendigen Medium, in dem qualitative Selbstbestimmung erscheint und geprüft wird.","refs":["CL_GB18_27:RMD-02","CL_GB18_28:XD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_07:ALT-B01","text":"Auf der Oberflächenebene erscheinen Kalküloperationen, Verhältnisformen, Maßeinheiten, Reihen, Schwellen und Messungen als explizite Gegenstände.","refs":["CL_GB18_25:ALT-B01","CL_GB18_26:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:ALT-B02","text":"Auf der strukturellen Ebene werden selbständige Quanta in relationale Momente überführt und durch Grenze, Exponent, Maß und qualitative Potenz organisiert.","refs":["CL_GB18_25:ALT-B02","CL_GB18_26:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:ALT-B03","text":"Auf der metastrategischen Ebene wird die Analyse von isolierten Werten und Symbolen auf die Vermittlung verlegt, durch die eine Operation Gegenstandsgeltung erhält.","refs":["CL_GB18_27:ALT-B03","CL_GB18_28:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:ALT-B04","text":"Auf der ontologischen und zeitlichen Ebene ist Realität eine maßförmige Rückkehrstruktur, in der kumulative Äußerlichkeit qualitative Selbstveränderung und reflektierte Identität erzeugt.","refs":["CL_GB18_27:ALT-B04","CL_GB18_27:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:ALT-B05","text":"Auf der methodologischen und performativen Ebene vollzieht die Darstellung ihre These, indem sie jede äußerliche Form aus ihrem eigenen Mangel zur immanenten Vermittlung fortführt.","refs":["CL_GB18_26:ALT-B05","CL_GB18_28:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_07:FL-01","text":"Die spezifische Bindung des Kalküls an Potenzenverhältnisse bleibt in Spannung zur allgemeineren These, jede qualitative Größenbestimmung werde erst durch gegenständliche Typisierung und Maßrelation erzeugt.","refs":["CL_GB18_25:XD-08","CL_GB18_28:GA-06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:FL-02","text":"Die konstitutive Rolle der Anwendung steht in Spannung zur Forderung, Wahrheit müsse vollständig aus der Selbstbestimmung des Gegenstands hervorgehen.","refs":["CL_GB18_25:AS-04","CL_GB18_27:DBN-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:FL-03","text":"Der universale kategoriale Übergang des Maßes zum Wesen steht in Spannung zur regional begrenzten Realisation quantitativer Gesetzlichkeit.","refs":["CL_GB18_27:FL-01","CL_GB18_27:GA-08"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:FL-04","text":"Der qualitative Umschlag wird als notwendig behauptet, doch die konkrete Vermittlung zwischen Akkumulation, Schwelle und neuer Qualität bleibt unterbestimmt.","refs":["CL_GB18_27:FL-02","CL_GB18_28:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:FL-05","text":"Das System disqualifiziert äußere Symbole und Zahlenschemata als Gründe, bleibt für seine eigene Rekonstruktion aber auf mathematische Formen und Potenzdarstellungen angewiesen.","refs":["CL_GB18_27:GNX-02","CL_GB18_26:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:FL-06","text":"Die diskrete Bestimmung des Kontinuierlichen bleibt instabil, weil sie operative Legitimität beansprucht, ohne diskrete Zusammensetzung ontologisch zulassen zu dürfen.","refs":["CL_GB18_25:FL-04","CL_GB18_25:DBN-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:MP-01","text":"Das Quantum mutiert vom selbständigen Wert zum unselbständigen Relationsmoment und schließlich zur auf sich bezogenen Äußerlichkeit eines Maßes.","refs":["CL_GB18_25:MP-01","CL_GB18_27:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:MP-02","text":"Der Exponent mutiert vom Zahlenquotienten über Produkt und negative Grenze zum qualitativen Prinzip einer Potenz- oder Maßgesetzlichkeit.","refs":["CL_GB18_26:MP-01","CL_GB18_28:MP-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:MP-03","text":"Äußerlichkeit mutiert vom Mangel an Bestimmtheit zum notwendigen Medium qualitativer Selbstbeziehung und zum Ort des Fürsichseins.","refs":["CL_GB18_26:MP-04","CL_GB18_28:MP-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:MP-04","text":"Unendlichkeit mutiert vom unbegrenzten Progress zur gegenwärtigen Relationsvollständigkeit; ihre negative Übergangsfunktion wird anschließend vom Maßlosen übernommen.","refs":["CL_GB18_25:MP-05","CL_GB18_27:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:MP-05","text":"Maß mutiert von unmittelbarer Einheit und äußerlicher Regel zur selbstvermittelten Gesetzlichkeit, deren Aufhebung den Übergang in das Wesen bildet.","refs":["CL_GB18_28:GA-02","CL_GB18_27:GA-07"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_07:HSI-01","text":"Die Realität erscheint als rekursive Maßmaschine, in der Größen, Grenzen und Qualitäten nicht vor ihren Relationen bestehen, sondern durch deren Selbstvermittlung hervorgebracht werden.","refs":["CL_GB18_27:HSI-01","CL_GB18_26:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:HSI-02","text":"Das Subjekt ist weder souveräner Setzer noch passiver Betrachter, sondern die Instanz, die formale Operation, qualitative Typisierung und Gegenstandsbeweis vermittelt.","refs":["CL_GB18_25:HSI-02","CL_GB18_28:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:HSI-03","text":"Zeit ist doppelt organisiert: Sie erscheint äußerlich als Reihe oder Progression und innerlich als kumulative, potenzielle und schwellenförmige Transformation.","refs":["CL_GB18_28:HSI-03","CL_GB18_27:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:HSI-04","text":"Möglich bleibt eine Navigation durch qualitative Invarianten und Maßgrenzen; ausgeschlossen bleibt die Flucht in selbständige Quanta, infinitesimale Mittelwesen oder universale äußere Maßstäbe.","refs":["CL_GB18_25:HSI-04","CL_GB18_28:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_07:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von selbständiger Quantität über Relation, Exponent und Potenz zur selbstvermittelten Maßstruktur und zum Wesen zu rekonstruieren.","refs":["CL_GB18_26:MRT-B01","CL_GB18_27:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MRT-B02","text":"Die Architektur ist am stärksten, wo sie quantitative Selbständigkeit in relationale Funktion überführt, formale Erzeugung von Gegenstandsgeltung trennt und Äußerlichkeit als eigenes Moment zurückgewinnt.","refs":["CL_GB18_25:MRT-B02","CL_GB18_28:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MRT-B03","text":"Unterbestimmt bleiben die universale Reichweite des Potenzenverhältnisses, die Ableitung konkreter Maßgrenzen und die exakte mathematische Form der qualitativen Folgereihen.","refs":["CL_GB18_25:MRT-B03","CL_GB18_28:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MRT-B04","text":"Das System ist auf aktueller Ebene kohärent, sofern formale Operation, qualitative Relation, gegenständliche Spezifikation, regionale Geltung und reale Existenz unterschieden bleiben.","refs":["CL_GB18_25:MRT-B04","CL_GB18_27:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MRT-B05","text":"Axiomatischer Reduktion widersteht die produktive Spannung zwischen immanenter Selbstbestimmung und notwendiger Gegenstandsprüfung sowie zwischen spezifischer Potenzform und allgemeiner Maßlogik; ohne sie würde die rekursive Bewegung erstarren.","refs":["CL_GB18_25:MRT-B06","CL_GB18_27:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123708796725Z_c0f0f576","language_code":"en","language_name":"English","title":"Gb18 L1 07","source_sha256":"85684da81768bc03566c512e24d75c974796f64642d46336f468437ee85c949b","sha256":"ddd0567656b2ccb92aff78f97aba9912c6c58721cdf721f6c8cc755fdc59223b","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:37:08.797875+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_07:AS-01","text":"The system addresses the contradiction that quantitative procedures produce exact or stable results although the qualitative and objectual legitimacy of their operations initially remains indeterminate.","refs":["CL_GB18_25:AS-01","CL_GB18_27:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-02","text":"Its global thesis is that quantity receives determinate validity only through a qualitative relation or measure-structure and never suffices as an independent explanatory principle.","refs":["CL_GB18_25:GA-02","CL_GB18_27:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-03","text":"The directed movement leads from external quanta and comparisons through ratio, exponent, and power to self-mediated determination of measure and finally to the transition into essence.","refs":["CL_GB18_26:BAS-05","CL_GB18_27:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-04","text":"Application and measurement constitute necessary testing points, because only in the determinate object does it become visible whether a formal operation grasps an immanent relation or merely transfers an external rule.","refs":["CL_GB18_25:AS-04","CL_GB18_28:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-05","text":"The argument proceeds recursively and in a mutation-driven manner: Every inadequate form generates through its own deficiency the determination that surpasses and simultaneously preserves it.","refs":["CL_GB18_25:AS-06","CL_GB18_26:BAS-06","CL_GB18_28:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-06","text":"The temporal structure connects two movements: bad infinity endlessly displaces determination, while cumulative variation discloses an immanent limit and thereby produces qualitative transition.","refs":["CL_GB18_25:BSD-03","CL_GB18_27:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-07","text":"Categorical closure lies in measure, insofar as quantitative externality returns therein as qualitative self-mediation and sublates its immediate form.","refs":["CL_GB18_26:BSD-05","CL_GB18_27:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AS-08","text":"This closure remains conditioned, because neither all functional forms nor concrete measure-limits and laws of powers can be fully derived from a universal rule.","refs":["CL_GB18_25:AS-08","CL_GB18_27:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_07:GA-01","text":"[Persistent] A quantum possesses no complete determinacy independently of the relation in which its independence is reduced to a mediated moment.","refs":["CL_GB18_26:GA-01","CL_GB18_25:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-02","text":"[Attractor] The affirmative ground of quantitative determinacy is a qualitative relation through which quantity first counts as a determinate magnitude or as measure.","refs":["CL_GB18_25:GA-02","CL_GB18_28:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-03","text":"[Mutating] Externality mutates from what is indifferently given into a determination's own externalization and finally into the lawfulness in which this determination returns to itself.","refs":["CL_GB18_27:GA-03","CL_GB18_28:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-04","text":"[Mutating] The exponent transforms from the common numerical value through limit and product into the qualitative principle that organizes the alteration of its sides.","refs":["CL_GB18_26:GA-02","CL_GB18_28:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-05","text":"[Persistent] Quality and quantity form a totality only through double mediation; their immediate equation or external separation destroys the measure-structure.","refs":["CL_GB18_26:GA-09","CL_GB18_27:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-06","text":"[Emergent] Measure is the higher architecture in which rule, quantitative variation, qualitative limit, and objectual specification cooperate as moments of a single determination.","refs":["CL_GB18_28:AS-06","CL_GB18_27:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-07","text":"[Emergent] Formal generation, measurement, and symbolic representation do not themselves ground their objectual significance; they require qualitative typification and objectual validation.","refs":["CL_GB18_25:GA-06","CL_GB18_28:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-08","text":"[Persistent] Success of results, historical usefulness, and symbolic availability replace neither conceptual necessity nor the demonstration of the determinate object-relation.","refs":["CL_GB18_25:GA-01","CL_GB18_27:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-09","text":"[Mutating] Infinity mutates from external progress into the immanent completeness of a relation and becomes, in the measureless, the negativity through which an immediate form of measure surpasses itself.","refs":["CL_GB18_25:GA-04","CL_GB18_27:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-10","text":"[Emergent] Arithmetic repetition or addition produces qualitative change only when it is organized by an immanent law of measure and led to a qualitative limit.","refs":["CL_GB18_27:BSA-03","CL_GB18_28:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-11","text":"[Terminal] The self-mediation of measure sublates its immediacy and generates the transition into a reflected structure of essence.","refs":["CL_GB18_27:GA-07","CL_GB18_27:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-12","text":"[Attractor] Concrete identity consists in the stability of mediated difference, not in undifferentiated unity or isolated diversity.","refs":["CL_GB18_27:GA-09","CL_GB18_28:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-13","text":"[Emergent] Quantitative explanation possesses regional validity, whose scope declines with the concretion of the object and which therefore cannot ground a universal ontology.","refs":["CL_GB18_27:GA-08","CL_GB18_27:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:GA-14","text":"[Terminal] Infinitesimal entities, external rules, and symbolic auxiliary forms lose their foundational function once the qualitative mediation concealed by them has been explicated.","refs":["CL_GB18_25:RMD-08","CL_GB18_27:GA-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_07:RMD-01","text":"The quantum recurs in functionally altered form: from independent value through the dependent relational moment to self-related externality within a limit of measure.","refs":["CL_GB18_25:GA-03","CL_GB18_26:RMD-01","CL_GB18_27:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-02","text":"Ratio mutates from an external connection of finished magnitudes into the generative structure of their determinacy; its exponent thereby changes from result into an instance of mediation.","refs":["CL_GB18_26:GA-02","CL_GB18_28:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-03","text":"Power preserves its function as a qualitative form of relation, but expands from a specific ground of calculation into the model of a lawfulness that qualitatively transforms quantitative series.","refs":["CL_GB18_25:GA-05","CL_GB18_28:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-04","text":"Infinity is initially withdrawn from external progress into relational presence and later functionally replaced by the measureless, which signifies not remoteness but immanent self-negation.","refs":["CL_GB18_25:GA-04","CL_GB18_27:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-05","text":"Application and rule undergo a parallel reversal: Both begin as subordinate or external instances and become sites at which qualitative specification becomes visible and testable.","refs":["CL_GB18_25:RMD-04","CL_GB18_28:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-06","text":"Series and summation lose their explanatory autonomy; they remain preserved as technical or phenomenal initial forms, but are subordinated to a qualitative lawfulness.","refs":["CL_GB18_25:RMD-05","CL_GB18_28:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-07","text":"Externality reverses its valence: It is initially the indifferent or alien, then becomes mediated as its own negation, and ends as the site of being-for-self.","refs":["CL_GB18_27:GA-03","CL_GB18_28:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-08","text":"Measure mutates from the immediate unity of quality and quantity into the self-reflexive movement that sublates its immediacy and passes into essence.","refs":["CL_GB18_27:GA-02","CL_GB18_27:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RMD-09","text":"Symbol, infinitesimal, and external norm do not disappear without effect; they are terminally displaced after having indicated the still unexplicated point of mediation.","refs":["CL_GB18_25:GA-08","CL_GB18_28:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_07:CGD-01","text":"Historical justifications by means of limits, zeros, or series remain local diagnoses of calculation; at the current level, their shared incapacity to generate qualitative mediation from mere quantity scales upward.","refs":["CL_GB18_25:CGD-01","CL_GB18_25:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-02","text":"The sequence of direct, inverse, and power relation remains a local categorical sequence; globally load-bearing is the escalation from external connection to relational self-determination.","refs":["CL_GB18_26:CGD-04","CL_GB18_26:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-03","text":"Geometrical dimensional models remain object-specific; what alone scales upward is the demand to typify formally identical operations according to their qualitative object-function.","refs":["CL_GB18_25:CGD-05","CL_GB18_25:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-04","text":"Individual Sorites figures and particular limits of measure remain local cases; currently load-bearing is the immanent threshold-structure through which variation changes its qualitative function.","refs":["CL_GB18_27:CGD-02","CL_GB18_27:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-05","text":"The decomposition of determinate units and the exact form of individual power series remain lower mechanisms; globally, the relativization of immediate units of measure and of arithmetic explanatory autonomy remains.","refs":["CL_GB18_28:CGD-01","CL_GB18_28:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-06","text":"The constitutive role of application surpasses the local context of calculation, because at the current level it binds every formal or measuring operation to an objectual specification.","refs":["CL_GB18_25:GA-07","CL_GB18_28:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:CGD-07","text":"The transition into essence is not a further local operation of measure, but the current form of closure in which the entire development from external quantity to reflected self-mediation converges.","refs":["CL_GB18_27:GA-07","CL_GB18_27:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_07:GNX-01","text":"Excluded is a model of independent quanta or relata that possess their full determinacy prior to and independently of their relations.","refs":["CL_GB18_25:DBN-01","CL_GB18_26:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-02","text":"Excluded is a self-interpreting formalism that directly obtains qualitative meaning or real existence from syntactic derivability.","refs":["CL_GB18_25:GNX-05","CL_GB18_25:GNX-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-03","text":"Excluded is a universal external standard that could generate particular object-measures or replace conceptual self-determination.","refs":["CL_GB18_27:GNX-03","CL_GB18_27:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-04","text":"Excluded is an additive causality in which mere repetition or summation produces qualitative change without an immanent relation of measure.","refs":["CL_GB18_27:BSA-03","CL_GB18_27:XD-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-05","text":"Excluded are infinite progress, approximation, and infinitesimal intermediate entities as affirmative grounds of mathematical or categorical determinacy.","refs":["CL_GB18_25:GNX-03","CL_GB18_26:GNX-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-06","text":"Excluded is an immediate unity of quality and quantity that either erases difference or allows it to persist as unconnected independence.","refs":["CL_GB18_26:GNX-05","CL_GB18_27:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-07","text":"Excluded is the universalization of quantitative lawfulness into the model of organic, spiritual, or ontological reality as such.","refs":["CL_GB18_27:GNX-05","CL_GB18_27:GA-08"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:GNX-08","text":"Excluded is the ontological generation of continuous reality from discrete elements, even if discrete procedures can accomplish its determination of magnitude.","refs":["CL_GB18_25:GNX-06","CL_GB18_25:CGD-03"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_07:DBN-01","text":"Every atomistic overall model that seeks to reconcile the full independence of the members with constitutive relational determinacy must be false.","refs":["CL_GB18_26:DBN-01","CL_GB18_28:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:DBN-02","text":"Every explanation that subsequently adds quality, purpose, or meaning to an already finished quantitative movement must be false.","refs":["CL_GB18_26:DBN-02","CL_GB18_25:DBN-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:DBN-03","text":"Not permissible is a common external medium that makes mathematical form, nature, spirit, and concept commensurable without categorical transformation.","refs":["CL_GB18_27:BSA-01","CL_GB18_25:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:DBN-04","text":"Not permissible is the replacement of conceptual self-mediation by symbolic availability, numerical order, or sign economy.","refs":["CL_GB18_27:GNX-02","CL_GB18_27:GA-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:DBN-05","text":"Not permissible is a totality brought about by a single transition, immediate identity, or the absolute self-sameness of one of its moments.","refs":["CL_GB18_26:DBN-03","CL_GB18_26:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:DBN-06","text":"Not permissible is the equation of operative determination with ontological composition; calculability must not feign the mode of existence of the object.","refs":["CL_GB18_25:XD-07","CL_GB18_25:XD-06"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_07:BSA-01","text":"The system is organized around the absence of an external beyond into which the sought determination could be outsourced without return to the immanent relation.","refs":["CL_GB18_25:BSA-02","CL_GB18_26:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:BSA-02","text":"The deepest unavailable entity is an intermediate being that would simultaneously be an independent quantum, a pure relational moment, a formal operation, and a real object-determination.","refs":["CL_GB18_25:BSA-01","CL_GB18_25:BSA-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:BSA-03","text":"Unavailable are both pure externality without immanent determination and pure immanence without quantitative externalization.","refs":["CL_GB18_28:BSA-04","CL_GB18_26:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:BSA-04","text":"Impossible is an absolutely self-identical moment that fully preserves its independence and yet remains a constitutive part of a relation.","refs":["CL_GB18_26:BSA-04","CL_GB18_26:GA-11"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_07:BSA-05","text":"Unavailable is a fully commensurable numerical order in which qualitative difference could be represented without remainder as quantitative variation.","refs":["CL_GB18_28:GNX-05","CL_GB18_27:RMD-04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_07:XD-01","text":"Mathematical legitimacy requires that a formally generated relation be demonstrated as an immanent determination of measure of the respective object; neither formal success nor the mere assertion of immanence suffices alone.","refs":["MC_GB18_L1_07:GA-02","MC_GB18_L1_07:GA-06","MC_GB18_L1_07:GA-07","CL_GB18_25:CGD-02","CL_GB18_27:CGD-04"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-02","text":"Power relation and measure-power form a shared logic of transformation: The exponent grasps not merely a numerical value, but the qualitative invariant according to which quantitative moments alter themselves.","refs":["MC_GB18_L1_07:GA-02","MC_GB18_L1_07:GA-04","MC_GB18_L1_07:GA-06","CL_GB18_25:GA-05","CL_GB18_26:RMD-02","CL_GB18_28:GA-06"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-03","text":"Application does not supply qualitative determinacy from outside, but is the site at which the asserted self-determination of an object must be recognized, typified, and independently validated.","refs":["MC_GB18_L1_07:GA-03","MC_GB18_L1_07:GA-07","CL_GB18_25:GA-07","CL_GB18_27:DBN-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:XD-04","text":"Quantitative change possesses two temporal forms: arithmetic succession on the surface and a cumulative, potential, or threshold-shaped movement that changes its qualitative significance.","refs":["MC_GB18_L1_07:GA-04","MC_GB18_L1_07:GA-10","CL_GB18_27:BSD-02","CL_GB18_28:BSD-04"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-05","text":"The infinitesimal and the measureless mark different stages of the same deficit of mediation: The former conceals a qualitative relation, the latter discloses the negativity of an already determinate form of measure.","refs":["MC_GB18_L1_07:GA-09","MC_GB18_L1_07:GA-14","CL_GB18_25:XD-03","CL_GB18_27:GA-05"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-06","text":"A discrete or external procedure can measure a continuous or qualitatively determinate being-there without generating its ontological composition, provided that its dependence on the relation of measure remains explicit.","refs":["MC_GB18_L1_07:GA-06","MC_GB18_L1_07:GA-07","CL_GB18_25:GA-10","CL_GB18_28:DBN-05"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-07","text":"Exactness is decoupled from universal scope: A quantitative procedure can fully grasp an invariant moment and yet be valid only for a limited domain of objects.","refs":["MC_GB18_L1_07:GA-08","MC_GB18_L1_07:GA-13","CL_GB18_25:BSD-06","CL_GB18_27:GA-08"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_07:XD-08","text":"Once qualitative mediation and the law of measure have been explicated, infinitesimal, symbol, and external rule become derivative means of representation or operation rather than foundations.","refs":["MC_GB18_L1_07:GA-07","MC_GB18_L1_07:GA-14","CL_GB18_25:RMD-08","CL_GB18_27:GA-06"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_07:BSD-01","text":"The generated ontology is relational and measure-formed: Determinacies do not exist prior to their relations, but are generated through limit, power, object-reference, and qualitative mediation.","refs":["MC_GB18_L1_07:GA-01","MC_GB18_L1_07:GA-02","MC_GB18_L1_07:GA-06","CL_GB18_25:BSD-01","CL_GB18_26:BSD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-02","text":"Cognition becomes a graduated process of formal generation, qualitative typification, objectual examination, and reflection on the measure-form or symbol-form employed.","refs":["MC_GB18_L1_07:GA-07","MC_GB18_L1_07:GA-08","CL_GB18_25:BSD-02","CL_GB18_27:BSD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-03","text":"Time is neither pure progression nor mere leap, but the interweaving of present relational completeness with cumulative change and qualitative threshold.","refs":["MC_GB18_L1_07:GA-09","MC_GB18_L1_07:GA-10","CL_GB18_25:BSD-03","CL_GB18_27:BSD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-04","text":"Causality is reconstituted non-additively: Repetition operates only through the immanent negativity of a measure-structure that produces a new quality at its limit.","refs":["MC_GB18_L1_07:GA-06","MC_GB18_L1_07:GA-10","CL_GB18_27:BSA-03","CL_GB18_27:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-05","text":"The cognizing subject becomes the mediating instance that distinguishes operation, typification, and proof of the object without understanding itself as the sovereign positor of the determination of measure.","refs":["MC_GB18_L1_07:GA-03","MC_GB18_L1_07:GA-07","CL_GB18_25:HSI-02","CL_GB18_27:HSI-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-06","text":"Method becomes the connection of immanent critique with retroactive examination of the object: A form generates its successor from its deficiency, while applications confirm or correct the abstracted relation.","refs":["MC_GB18_L1_07:GA-07","MC_GB18_L1_07:GA-12","CL_GB18_26:BSD-03","CL_GB18_25:RLE-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_07:BSD-07","text":"The transition to essence changes the status of measure: It is no longer immediate unity, but the reflected lawfulness of an externality that has been comprehended as its own moment.","refs":["MC_GB18_L1_07:GA-03","MC_GB18_L1_07:GA-11","CL_GB18_27:GA-07","CL_GB18_28:BSD-06"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_07:RLE-01","text":"The cycle of justification leads from formal success through conceptual underdetermination to qualitative reconstruction, thence to application and, through its examination, back to revised theory.","refs":["CL_GB18_25:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-02","text":"The ratio-spiral leads from the interchangeable quotient through negative reciprocity and product to the power-exponent and finally to the determination of measure.","refs":["CL_GB18_26:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-03","text":"The loop of externality proceeds from the external rule through relation to its other to qualitative specification and ends in being-for-self within externality.","refs":["CL_GB18_28:RLE-05","CL_GB18_28:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-04","text":"The threshold escalation leads from indifferent variation through repetition and accumulation to the limit of measure, at which quantitative continuation reverses its qualitative function.","refs":["CL_GB18_27:BSD-02","CL_GB18_27:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-05","text":"The symbol-loop leads from external representation through the demand for conceptual demonstration to the dispensability of the symbol and thence to the diagnosis of every renewed economy of signs.","refs":["CL_GB18_27:GA-06","CL_GB18_27:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-06","text":"The infinity-loop transforms endless progress into present relational completeness and subsequently shifts its negative residual function onto the measureless.","refs":["CL_GB18_26:RLE-04","CL_GB18_25:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:RLE-07","text":"The shared attractor is the self-referential qualitative invariant toward which power relation, exponent, limit of measure, and objectual typification converge.","refs":["CL_GB18_25:RLE-06","CL_GB18_27:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_07:FGS-B01","text":"Exact or stable operational success plus a conceptually contradictory procedural form generates a deficit of justification.","refs":["CL_GB18_25:FGS-B01","CL_GB18_25:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B02","text":"The negation of independent quanta receives its determinacy as a dependent moment of a relation instead of preserving it in small or isolated entities.","refs":["CL_GB18_25:FGS-B02","CL_GB18_26:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B03","text":"The relational moment organizes itself as exponent, limit, or power and thereby generates a qualitative lawfulness of quantitative change.","refs":["CL_GB18_25:FGS-B03","CL_GB18_26:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B04","text":"Formal generation initially supplies only a ratio; application, typification, and proof of the object determine its concrete validity.","refs":["CL_GB18_25:FGS-B04","CL_GB18_25:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B05","text":"External comparison relativizes its own unity and mutates through its relation to the object into specific determination of measure.","refs":["CL_GB18_28:FGS-B01","CL_GB18_28:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B06","text":"Repeated quantitative variation activates the immanent limit of measure and generates a qualitative consequential series, a transition, or the demise of the previous form.","refs":["CL_GB18_27:XD-03","CL_GB18_28:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B07","text":"Measure reflects its immediate unity, takes externality back as its own moment, and thereby passes into essence.","refs":["CL_GB18_27:GA-07","CL_GB18_28:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:FGS-B08","text":"The machine closes relatively through qualitative self-mediation, but remains open with respect to universal functional reduction, concrete thresholds, and regional validity.","refs":["CL_GB18_25:AS-08","CL_GB18_27:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_07:AFM-B01","text":"Independent quantum → external relation → common exponent → negative reciprocity → power relation → qualitative determination of measure → reflected lawfulness → essence.","refs":["CL_GB18_26:BAS-07","CL_GB18_27:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AFM-B02","text":"Formal success → deficit of justification → qualitative typification → application → independent proof of the object → limited mathematical validity.","refs":["CL_GB18_25:AS-01","CL_GB18_25:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:AFM-B03","text":"External variation → repetition → accumulation → immanent limit of measure → qualitative reaction → new lawfulness → sublation of the immediate form of measure.","refs":["CL_GB18_27:AS-06","CL_GB18_27:AFM-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_07:MME-01","text":"The opposition of finite and infinite is replaced by the difference between external progress, immanent relational completeness, and negativity internal to measure.","refs":["CL_GB18_25:MME-01","CL_GB18_27:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-02","text":"Ratio is reclassified from an operation of comparison into the constitutive form through which its sides receive determinate validity at all.","refs":["CL_GB18_26:MME-01","CL_GB18_26:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-03","text":"Application and measurement are transformed from subordinate enactments into testing points of the qualitative and objectual legitimacy of formal operations.","refs":["CL_GB18_25:MME-03","CL_GB18_28:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-04","text":"The opposition of quality and quantity is remapped as a measure-structure in which both sides exist only through reciprocal mediation.","refs":["CL_GB18_26:MME-05","CL_GB18_28:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-05","text":"The opposition of gradual and abrupt change collapses because qualitative transition appears as an immanent function of continuous accumulation.","refs":["CL_GB18_27:MME-02","CL_GB18_27:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-06","text":"Discreteness and continuity are distributed across different levels: Discrete procedures determine magnitudes without ontologically composing continuous existence.","refs":["CL_GB18_25:MME-04","CL_GB18_25:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-07","text":"Mathematical explanation is regionalized: Its strength rests on grasping determinate invariants and not on universal transferability.","refs":["CL_GB18_27:MME-04","CL_GB18_25:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MME-08","text":"Inner and outer no longer form a static opposition; externality becomes the necessary medium in which qualitative self-determination appears and is tested.","refs":["CL_GB18_27:RMD-02","CL_GB18_28:XD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_07:ALT-B01","text":"At the surface level, operations of calculation, forms of relation, units of measure, series, thresholds, and measurements appear as explicit objects.","refs":["CL_GB18_25:ALT-B01","CL_GB18_26:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:ALT-B02","text":"At the structural level, independent quanta are transformed into relational moments and organized through limit, exponent, measure, and qualitative power.","refs":["CL_GB18_25:ALT-B02","CL_GB18_26:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:ALT-B03","text":"At the metastrategic level, analysis is shifted from isolated values and symbols to the mediation through which an operation receives objectual validity.","refs":["CL_GB18_27:ALT-B03","CL_GB18_28:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:ALT-B04","text":"At the ontological and temporal level, reality is a measure-formed structure of return in which cumulative externality produces qualitative self-change and reflected identity.","refs":["CL_GB18_27:ALT-B04","CL_GB18_27:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:ALT-B05","text":"At the methodological and performative level, the presentation enacts its thesis by carrying every external form forward from its own deficiency to immanent mediation.","refs":["CL_GB18_26:ALT-B05","CL_GB18_28:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_07:FL-01","text":"The specific binding of calculation to power relations remains in tension with the more general thesis that every qualitative determination of magnitude is first generated through objectual typification and relation of measure.","refs":["CL_GB18_25:XD-08","CL_GB18_28:GA-06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:FL-02","text":"The constitutive role of application stands in tension with the demand that truth must proceed entirely from the self-determination of the object.","refs":["CL_GB18_25:AS-04","CL_GB18_27:DBN-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:FL-03","text":"The universal categorical transition of measure into essence stands in tension with the regionally limited realization of quantitative lawfulness.","refs":["CL_GB18_27:FL-01","CL_GB18_27:GA-08"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:FL-04","text":"Qualitative transition is asserted as necessary, yet the concrete mediation between accumulation, threshold, and new quality remains underdetermined.","refs":["CL_GB18_27:FL-02","CL_GB18_28:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:FL-05","text":"The system disqualifies external symbols and numerical schemata as grounds, but for its own reconstruction remains dependent on mathematical forms and representations of powers.","refs":["CL_GB18_27:GNX-02","CL_GB18_26:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:FL-06","text":"The discrete determination of the continuous remains unstable because it claims operative legitimacy without being permitted to allow discrete composition ontologically.","refs":["CL_GB18_25:FL-04","CL_GB18_25:DBN-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:MP-01","text":"The quantum mutates from independent value to dependent relational moment and finally to the self-related externality of a measure.","refs":["CL_GB18_25:MP-01","CL_GB18_27:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:MP-02","text":"The exponent mutates from numerical quotient through product and negative limit into the qualitative principle of a lawfulness of power or measure.","refs":["CL_GB18_26:MP-01","CL_GB18_28:MP-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:MP-03","text":"Externality mutates from a lack of determinacy into the necessary medium of qualitative self-relation and the site of being-for-self.","refs":["CL_GB18_26:MP-04","CL_GB18_28:MP-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:MP-04","text":"Infinity mutates from unlimited progress into present relational completeness; its negative transitional function is subsequently assumed by the measureless.","refs":["CL_GB18_25:MP-05","CL_GB18_27:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_07:MP-05","text":"Measure mutates from immediate unity and external rule into self-mediated lawfulness, whose sublation constitutes the transition into essence.","refs":["CL_GB18_28:GA-02","CL_GB18_27:GA-07"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_07:HSI-01","text":"Reality appears as a recursive machine of measure in which magnitudes, limits, and qualities do not exist prior to their relations, but are brought forth through their self-mediation.","refs":["CL_GB18_27:HSI-01","CL_GB18_26:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:HSI-02","text":"The subject is neither sovereign positor nor passive observer, but the instance that mediates formal operation, qualitative typification, and proof of the object.","refs":["CL_GB18_25:HSI-02","CL_GB18_28:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:HSI-03","text":"Time is doubly organized: It appears externally as series or progression and internally as cumulative, potential, and threshold-shaped transformation.","refs":["CL_GB18_28:HSI-03","CL_GB18_27:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:HSI-04","text":"Navigation through qualitative invariants and limits of measure remains possible; excluded remains escape into independent quanta, infinitesimal intermediate beings, or universal external standards.","refs":["CL_GB18_25:HSI-04","CL_GB18_28:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_07:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from independent quantity through relation, exponent, and power to self-mediated measure-structure and essence.","refs":["CL_GB18_26:MRT-B01","CL_GB18_27:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MRT-B02","text":"The architecture is strongest where it transforms quantitative independence into relational function, separates formal generation from objectual validity, and recovers externality as its own moment.","refs":["CL_GB18_25:MRT-B02","CL_GB18_28:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MRT-B03","text":"Underdetermined remain the universal scope of power relation, the derivation of concrete limits of measure, and the exact mathematical form of qualitative consequential series.","refs":["CL_GB18_25:MRT-B03","CL_GB18_28:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MRT-B04","text":"The system is coherent at the current level provided that formal operation, qualitative relation, objectual specification, regional validity, and real existence remain distinguished.","refs":["CL_GB18_25:MRT-B04","CL_GB18_27:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_07:MRT-B05","text":"Axiomatic reduction is resisted by the productive tension between immanent self-determination and necessary examination of the object, as well as between specific power-form and general logic of measure; without it, recursive movement would congeal.","refs":["CL_GB18_25:MRT-B06","CL_GB18_27:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_07@R001","source_variant_id":"canonical:MC_GB18_L1_07:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 07","context":"Chapters 73–84 · Anmerkung 1. Die Begriffsbestimmtheit des mathematischen Unendlichen. · Anmerkung 2.Der Zweck des Differentialkalkuls aus seiner Anwendung abgeleitet. · Anmerkung 3. Noch andere mit der qualitativen Größenbestimmtheit zusammenhängende Formen. · A. Das direkte Verhältniß. · B. Das umgekehrte Verhältniß. · C. Potenzverhältniß. · Anmerkung. · Dritter Abschnitt. Das Maaß. · A. Das specifische Quantum. · B. Specificirendes Maaß. · a. Die Regel. · b. Das specificirende Maaß."},"title_language_code":"en"},{"id":"MC_GB18_L1_08","layer":"MC","title":"Gb18 L1 08","order":8,"parents":["CL_GB18_29","CL_GB18_30","CL_GB18_31","CL_GB18_32"],"revision":"MC_GB18_L1_08@R001","sha256":"e3cf762c41dfd814997818fdde7f680345e87e15f8ec1b3b9f7de77f39bb8adc","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_08:AS-01","text":"Das System muss erklären, wie äußerliche Quantität qualitative Bestimmtheit und reale Selbstständigkeit erzeugen kann, ohne entweder als unabhängiger Grund fortzubestehen oder vollständig getilgt zu werden.","refs":["CL_GB18_29:AS-B02","CL_GB18_31:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-02","text":"Seine globale These lautet, dass Maß die immanente Einheit von Qualität und Quantität ist und Qualität daher nur als relationale Spezifikation quantitativer Verhältnisse Realität besitzt.","refs":["CL_GB18_29:GA-01","CL_GB18_31:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-03","text":"Das Argument transformiert unmittelbare Quanta in Exponenten, Exponenten in relationale Maßmomente und einzelne Relationen in Reihen, deren Ordnungen Selbstständigkeit und Vergleichbarkeit erzeugen.","refs":["CL_GB18_30:BAS-03","CL_GB18_31:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-04","text":"Die Reihenordnung wird durch Maßpunkte und qualitative Sprünge zur Knotenlinie, deren wiederholte Umschläge die einzelnen Maße schließlich zu Zuständen eines fortbestehenden Substrats herabsetzen.","refs":["CL_GB18_32:GA-04","CL_GB18_32:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-05","text":"Die Bewegung ist spiralförmig und rekursiv: Äußerlichkeit wird spezifiziert, als Relation zurückgewonnen, in Reihen vervielfältigt, durch Ausschluss zugespitzt und durch ihre eigene quantitative Vermittlung erneut geöffnet.","refs":["CL_GB18_29:AS-B05","CL_GB18_32:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-06","text":"Jede erreichte Stabilität erzeugt ihre eigene Überschreitung: quantitative Kontinuität bringt qualitative Knoten hervor, Ausschließlichkeit lässt alternative Verbindungen zu, und der Sprung setzt eine neue quantitative Veränderungsreihe frei.","refs":["CL_GB18_30:GA-07","CL_GB18_31:GA-08","CL_GB18_32:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-07","text":"Empirische und mathematische Gesetzlichkeit bleibt gültig, wird aber von begrifflicher Notwendigkeit getrennt, solange Exponenten, Auswahlordnungen und Maßpunkte nicht aus einem immanenten Erzeugungsprinzip hervorgehen.","refs":["CL_GB18_29:GA-07","CL_GB18_31:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-08","text":"Die Schließung besteht weder in einem letzten Maß noch in einem endgültigen Auswahlgesetz, sondern in der terminalen Transformation des Maßes zu einem Moment der negativen, sich durch wechselnde Bestimmungen erhaltenden Einheit.","refs":["CL_GB18_30:GA-08","CL_GB18_32:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_08:GA-01","text":"[Persistent] Maß ist die immanente Einheit von Qualität und Quantität, in der quantitative Bestimmungen qualitative Realität nicht abbilden, sondern mit hervorbringen.","refs":["CL_GB18_29:GA-01","CL_GB18_32:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-02","text":"[Persistent] Qualitative Bestimmtheit besitzt keinen beziehungslosen Träger, sondern entsteht als spezifische Differenz innerhalb geordneter Relationen.","refs":["CL_GB18_30:GA-03","CL_GB18_31:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-03","text":"[Mutating] Das äußerliche Quantum mutiert vom scheinbar selbstständigen Gegebenen zum Exponenten einer Relation und schließlich zum Schwellenparameter qualitativer Transformation.","refs":["CL_GB18_29:GA-02","CL_GB18_30:RMD-03","CL_GB18_32:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-04","text":"[Emergent] Selbstständigkeit ist keine Beziehungsfreiheit, sondern die zeitweilige Stabilität eines relationalen Knotens, der sich durch Repulsion, Reaktion und Veränderung erhält.","refs":["CL_GB18_30:GA-04","CL_GB18_31:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-05","text":"[Attractor] Negative Einheit ist die operative Form, welche Äußerlichkeit und Immanenz, Selbsterhaltung und Veränderung sowie Ausschluss und Beziehung vermittelt.","refs":["CL_GB18_30:GA-06","CL_GB18_30:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-06","text":"[Emergent] Quantitative Kontinuität organisiert sich als Reihe, Reiheninvarianz und Knotenlinie; ihre Wahrheit liegt in den qualitativen Differenzen und Unterbrechungen, die sie trägt.","refs":["CL_GB18_30:GA-07","CL_GB18_31:GA-04","CL_GB18_32:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-07","text":"[Mutating] Ausschließlichkeit entsteht als maßförmige Negativität, mutiert zum diskontinuierlichen Exponenten und wird durch alternative Kombinationen, Mengen und Umstände erneut relativiert.","refs":["CL_GB18_31:GA-08","CL_GB18_31:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-08","text":"[Persistent] Empirische Regelmäßigkeit und mathematische Darstellung besitzen Geltung, erzeugen aber nicht von selbst die begriffliche Notwendigkeit ihrer Gesetzesform.","refs":["CL_GB18_29:GA-07","CL_GB18_31:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-09","text":"[Terminal] Maßlosigkeit ist die produktive Selbstnegation eines Maßes, durch die seine bisherige qualitative Geltung endet und eine neue Maßbestimmung hervortritt.","refs":["CL_GB18_30:GA-08","CL_GB18_32:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-10","text":"[Terminal] Die Vollendung der Maßarchitektur hebt nicht alle Maße in einem höchsten Maß auf, sondern absorbiert ihre Selbstständigkeit in die Kontinuität eines sich durch Zustandswechsel erhaltenden Substrats.","refs":["CL_GB18_32:AS-B06","CL_GB18_32:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-11","text":"[Attractor] Das nicht verfügbare immanente Erzeugungsprinzip für Exponenten, Affinitäten, Mischungen und Maßpunkte organisiert die Architektur als negative Zielgestalt.","refs":["CL_GB18_31:GA-11","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-12","text":"[Attractor] Äußerlichkeit muss als notwendiges Moment erhalten bleiben, darf aber niemals als unabhängiger Grund qualitativer Wahrheit gelten.","refs":["CL_GB18_30:FL-01","CL_GB18_30:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_08:RMD-01","text":"Maß bewahrt seine Identität als Einheit von Qualität und Quantität, mutiert aber von der Spezifikation einzelner Verhältnisse zur Erzeugung relationaler Selbstständigkeit und schließlich zur Übergangsform des Substrats.","refs":["CL_GB18_30:RMD-01","CL_GB18_32:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-02","text":"Das Quantum kehrt funktional als äußere Einwirkung, unmittelbarer Exponent, Serienglied, variable Menge und Schwellenwert wieder; seine Selbstständigkeit nimmt dabei kontinuierlich ab.","refs":["CL_GB18_29:GA-02","CL_GB18_30:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-03","text":"Der Exponent wandert von der Potenzform eines qualitativen Verhältnisses zur Kennzahl relationaler Spezifikation, zum Operator des Ausschlusses und zum veränderlichen Ausdruck von Mischungs- und Schwellenordnungen.","refs":["CL_GB18_29:GA-06","CL_GB18_31:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-04","text":"Selbstständigkeit mutiert vom einzelnen negativen Maßganzen zum Knoten vieler Gegenrelationen und schließlich zum vorübergehenden Zustand einer umfassenderen Einheit.","refs":["CL_GB18_30:RMD-04","CL_GB18_31:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-05","text":"Die Reihe erweitert ihre Funktion von der Darstellung spezifischer Beziehungen über Invarianzen zwischen Gegenreihen zur Knotenlinie qualitativer Umschläge.","refs":["CL_GB18_31:RMD-02","CL_GB18_32:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-06","text":"Neutralität kehrt ihre Valenz um: Sie ermöglicht zunächst relationale Erhaltung, erzeugt dann Ausschließlichkeit und wird schließlich zum Medium alternativer Verbindungen, welche den Ausschluss destabilisieren.","refs":["CL_GB18_31:RMD-04","CL_GB18_31:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-07","text":"Maßlosigkeit mutiert vom scheinbaren Ende der Maßbestimmung zur produktiven Negation, welche neue Maße erzeugt und die Reihe in negative Selbstbeziehung überführt.","refs":["CL_GB18_30:RMD-07","CL_GB18_32:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-08","text":"Das Substrat erscheint erst terminal als Rückkehrinstanz der Knotenlinie und absorbiert die zuvor selbstständig gesetzten Maße als eigene wechselnde Zustände.","refs":["CL_GB18_32:RMD-04","CL_GB18_32:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-09","text":"Das empirische Gesetz behält seine prüfende Funktion, verliert jedoch seinen Anspruch, zugleich das Trägerbild und das immanente Erzeugungsprinzip seiner Relationen festzulegen.","refs":["CL_GB18_31:MME-04","CL_GB18_31:GA-09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_08:CGD-01","text":"Wärmekapazitäten, Bewegungsarten, chemische Reaktionen und musikalische Relationen bleiben lokale Realisierungen; auf Meta-Cluster-Ebene zählt ihre gemeinsame Funktion als Evidenz relationaler Spezifikation.","refs":["CL_GB18_29:CGD-01","CL_GB18_31:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-02","text":"Bestimmte Potenzformen und Proportionszahlen bleiben lokal, während die Umcodierung mathematischer Formen zu qualitativen Funktionsstellen global skaliert.","refs":["CL_GB18_29:CGD-02","CL_GB18_31:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-03","text":"Atomistische, korpuskulare und elektrochemische Modelle bleiben lokale Kritikziele; global gilt das Kriterium, dass kein Trägerbild die zu erklärenden relationalen Differenzen tilgen darf.","refs":["CL_GB18_31:CGD-02","CL_GB18_31:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-04","text":"Einzelne Affinitäts-, Neutralisations- und Mischungsreihen bleiben domänenspezifisch; Reihenbildung und die offene Forderung nach ihrem Erzeugungsgesetz verbinden dagegen die gesamte Architektur.","refs":["CL_GB18_31:CGD-04","CL_GB18_31:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-05","text":"Moralische und staatliche Beispiele liefern keine zusätzliche Ontologie, sondern skalieren nur die Schwellenlogik über Naturverhältnisse hinaus.","refs":["CL_GB18_32:CGD-03","CL_GB18_32:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-06","text":"Konkrete Koeffizienten, Exponenten, Auswahlvorränge und Maßpunkte bleiben auf den unteren Ebenen unterbestimmt; global tragend ist die systematische Kennzeichnung dieser Unterbestimmtheit.","refs":["CL_GB18_30:MRT-B02","CL_GB18_32:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-07","text":"Erst auf der aktuellen Ebene wird sichtbar, dass die lokalen Maßanalysen gemeinsam auf eine terminale Entselbstständigung des Maßes und seine Absorption in das Substrat zulaufen.","refs":["CL_GB18_32:AS-B06","CL_GB18_32:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_08:GNX-01","text":"Ausgeschlossen ist eine reine Quantität oder unmittelbare Qualität, die ohne relationale Spezifikation vollständig bestimmt wäre.","refs":["CL_GB18_29:BSA-01","CL_GB18_31:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:GNX-02","text":"Ausgeschlossen ist ein Modell fertiger Dinge, deren Eigenschaften vor ihren Beziehungen bestehen und durch diese lediglich äußerlich verglichen werden.","refs":["CL_GB18_29:DBN-01","CL_GB18_31:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:GNX-03","text":"Ausgeschlossen ist lineare Kausalität, sofern sie äußere Quantität unverändert überträgt und die qualitative Eigenreaktion der Relata ignoriert.","refs":["CL_GB18_29:GNX-01","CL_GB18_30:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:GNX-04","text":"Ausgeschlossen ist die Gleichsetzung empirischer Bestätigung oder mathematischer Allgemeinheit mit begrifflicher Erzeugung und ontologischer Notwendigkeit.","refs":["CL_GB18_29:GNX-03","CL_GB18_31:DBN-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:GNX-05","text":"Ausgeschlossen ist ein homogenes Kontinuum, das qualitative Neuheit in unendlich kleine Gradunterschiede auflöst und wirkliche Sprünge unkenntlich macht.","refs":["CL_GB18_32:GNX-02","CL_GB18_32:MME-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:GNX-06","text":"Ausgeschlossen ist ein letztes, absolut selbstständiges Maß, das weder veränderbar noch auf eine umfassendere Einheit bezogen wäre.","refs":["CL_GB18_32:DBN-03","CL_GB18_32:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_08:DBN-01","text":"Damit die Architektur Bestand hat, muss jeder nichtrelationale Grund falsch sein; die Bestimmtheit der Dinge darf ihren Maßverhältnissen nicht vorausliegen.","refs":["CL_GB18_30:DBN-01","CL_GB18_31:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:DBN-02","text":"Selbsterhaltung darf nicht als unverändertes Beharren gelten, weil das Maß seine Identität nur durch negative Reaktion und qualitative Selbstmodifikation bewahrt.","refs":["CL_GB18_30:DBN-03","CL_GB18_30:RMD-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:DBN-03","text":"Kontinuität und Diskontinuität dürfen nicht als ausschließende Gesamtmodelle behandelt werden, weil quantitative Fortsetzung die Trägerform qualitativer Unterbrechung bildet.","refs":["CL_GB18_31:DBN-04","CL_GB18_32:MME-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:DBN-04","text":"Eine vollständige begriffliche Deduktion konkreter Zahlen darf nicht stillschweigend vorausgesetzt werden, da empirische Koeffizienten und das gemeinsame Maßgesetz ausdrücklich unverfügbar bleiben.","refs":["CL_GB18_30:DBN-02","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:DBN-05","text":"Das Substrat darf weder als starres Ding außerhalb seiner Zustände noch als bloßer Name ihrer Abfolge gelten; es muss durch die Wechsel hindurch dasselbe und durch sie bestimmt sein.","refs":["CL_GB18_32:DBN-02","CL_GB18_32:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_08:BSA-01","text":"Die tiefste strukturierende Abwesenheit ist ein immanentes Gesetz, das konkrete Exponenten, Affinitätswahlen, Mischungsrelationen und Maßpunkte aus einer einzigen generativen Ordnung ableiten könnte.","refs":["CL_GB18_29:BSA-02","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:BSA-02","text":"Unverfügbar ist sowohl eine schlechthin erste Unmittelbarkeit als auch eine finale Selbstständigkeit, die ihre Beziehungen, Negationen und Veränderungen hinter sich gelassen hätte.","refs":["CL_GB18_30:BSA-01","CL_GB18_30:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:BSA-03","text":"Unmöglich ist eine Außenperspektive, aus der Maße vollständig erfasst werden könnten, ohne dass die Messrelation selbst in das Feld der Spezifikation einträte.","refs":["CL_GB18_29:BSA-03","CL_GB18_32:GA-08"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:BSA-04","text":"Ontologisch unstatthaft bleibt eine Wirklichkeit, deren Veränderung restlos als homogene Skala verfügbar wäre und deshalb weder wirkliche Neuheit noch negative Übergangsarbeit enthielte.","refs":["CL_GB18_32:BSA-01","CL_GB18_32:GA-06"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_08:XD-01","text":"Die qualitative Eigenreaktion eines Relats und die gegenseitige Spezifikation verbundener Maße sind dieselbe Struktur auf verschiedenen Skalen: Äußerlichkeit wird zum Material immanenter Selbstbestimmung.","refs":["MC_GB18_L1_08:GA-01","MC_GB18_L1_08:GA-02","MC_GB18_L1_08:GA-03","MC_GB18_L1_08:GA-12","CL_GB18_29:AS-B04","CL_GB18_30:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-02","text":"Potenzform und Exponentenreihe machen mathematische Formen zu Indizes qualitativer Relationsarchitekturen; gerade deshalb bleibt ihre konkrete Herleitung prekär, wenn der Exponent empirisch gegeben werden muss.","refs":["MC_GB18_L1_08:GA-03","MC_GB18_L1_08:GA-06","MC_GB18_L1_08:GA-08","MC_GB18_L1_08:GA-11","CL_GB18_29:GA-06","CL_GB18_31:RMD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-03","text":"Reiheninvarianz und Knotenlinie bestimmen quantitative Kontinuität gemeinsam als gegliedertes Schwellenfeld, in dem Vergleichbarkeit erhalten bleibt, ohne qualitative Gleichförmigkeit zu erzwingen.","refs":["MC_GB18_L1_08:GA-06","MC_GB18_L1_08:GA-09","CL_GB18_31:GA-04","CL_GB18_32:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-04","text":"Weil Ausschließlichkeit im selben quantitativen Feld entsteht, das alternative Verbindungen ermöglicht, kann sich eine maßbestimmte Einheit nur als veränderliche und bedingte Selbstständigkeit erhalten.","refs":["MC_GB18_L1_08:GA-04","MC_GB18_L1_08:GA-05","MC_GB18_L1_08:GA-07","CL_GB18_30:RMD-05","CL_GB18_31:FL-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-05","text":"Die Autonomie empirischer Proportionsgesetze macht sie zu Prüfmitteln konkurrierender Ontologien, nicht aber zu Ersatzformen des fehlenden immanenten Erzeugungsgesetzes.","refs":["MC_GB18_L1_08:GA-08","MC_GB18_L1_08:GA-11","CL_GB18_31:GA-09","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-06","text":"Die Maßlogik vollendet sich paradox, indem ihre produktive Selbstnegation neue Maße erzeugt, deren unendliche Wiederholung schließlich die Selbstständigkeit des Maßes selbst aufhebt.","refs":["MC_GB18_L1_08:GA-09","MC_GB18_L1_08:GA-10","CL_GB18_32:GA-06","CL_GB18_32:AS-B06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-07","text":"Kausalität muss in relationale Möglichkeit, maßförmige Spezifikation, bedingte Auswahl und schwellenabhängige Aktualisierung gegliedert werden; kein einzelnes Moment erklärt den qualitativen Übergang.","refs":["MC_GB18_L1_08:GA-06","MC_GB18_L1_08:GA-07","MC_GB18_L1_08:GA-09","CL_GB18_31:BSD-02","CL_GB18_32:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_08:BSD-01","text":"Realität wird zu einem rekursiven Netz maßförmiger Knoten und Schwellen, in dem quantitative Relationen qualitative Gestalten erzeugen, stabilisieren und zerstören.","refs":["CL_GB18_30:HSI-01","CL_GB18_31:HSI-01","CL_GB18_32:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-02","text":"Das Seiende besitzt keinen beziehungslosen Kern, sondern ist ein relationales Zentrum und zugleich ein wechselnder Zustand der Einheit, die seine Transformationen trägt.","refs":["CL_GB18_31:BSD-01","CL_GB18_32:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-03","text":"Kausalität ist rekursiv und schwellenförmig: Eine äußere Veränderung wird intern spezifiziert, verändert die Relationsordnung und kann an einem Maßpunkt eine neue qualitative Form aktualisieren.","refs":["CL_GB18_30:BSD-02","CL_GB18_31:BSD-02","CL_GB18_32:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-04","text":"Zeit ist weder linear noch zyklisch, sondern knotig und spiralförmig: Kontinuität trägt Unterbrechungen, Unterbrechungen eröffnen neue Reihen, und Wiederholung führt verändert zur Einheit zurück.","refs":["CL_GB18_30:BSD-04","CL_GB18_31:HSI-03","CL_GB18_32:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-05","text":"Erkenntnis wird hierarchisiert in Beobachtung, formale Gesetzlichkeit und begriffliche Erzeugung; exakte Reihen sind stärker als spekulative Trägerbilder, aber schwächer als die Einsicht in ihr Erzeugungsgesetz.","refs":["CL_GB18_29:BSD-04","CL_GB18_31:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-06","text":"Intervention ist nur innerhalb der Relationsordnung möglich und kann nicht auf bloße Mengensteigerung reduziert werden, weil quantitative Eingriffe an Schwellen die Form des Systems verändern können.","refs":["CL_GB18_30:HSI-04","CL_GB18_32:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-07","text":"Die Übertragbarkeit der Maßlogik auf Natur, Moral und politische Ordnung begründet keine identischen Gesetze, sondern einen gemeinsamen Typus schwellenabhängiger Transformation.","refs":["CL_GB18_32:CGD-03","CL_GB18_32:XD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_08:RLE-01","text":"Die elementare Schleife verläuft vom äußerlichen Quantum über spezifische Aufnahme und Exponentenbildung zur Rückkehr des Quantums als qualitativ bestimmtes Maß.","refs":["CL_GB18_29:RLE-01","CL_GB18_30:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-02","text":"Relationale Individualisierung verläuft von Selbstständigkeit über Beziehung auf Andere zur spezifischen Bestimmung und von dort zu einer erneuerten, aber nicht mehr beziehungslosen Selbstständigkeit.","refs":["CL_GB18_30:GA-09","CL_GB18_31:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-03","text":"Serielle Eskalation führt vom Einzelexponenten zur Gegenreihe, von dort zur Reiheninvarianz, weiter zur Ausschließlichkeit und schließlich zu ihrer kombinatorischen Relativierung.","refs":["CL_GB18_31:RLE-02","CL_GB18_31:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-04","text":"Die Schwellenloop lautet: Maß, quantitative Variation, Gleichgültigkeitsbereich, Maßpunkt, qualitativer Sprung, neues Maß und erneute Variation.","refs":["CL_GB18_32:RLE-01","CL_GB18_32:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-05","text":"Die terminale Eskalation führt von der Vervielfältigung der Maße zur Knotenlinie, vom Maßlosen zur wiederkehrenden Einheit und von dort zur Absorption der Maße in das Substrat.","refs":["CL_GB18_32:RLE-03","CL_GB18_32:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-06","text":"Negative Einheit ist der positive Attraktor, weil jede scheinbar unmittelbare Bestimmung erst durch vermittelte Selbstbeziehung systematische Wahrheit erhält.","refs":["CL_GB18_30:GA-06","CL_GB18_31:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-07","text":"Das fehlende geschlossene Maßsystem ist der negative Attraktor: Jede Domänenerweiterung verlangt es erneut, ohne seine gemeinsame Rechen- und Erzeugungsregel bereitzustellen.","refs":["CL_GB18_31:RMD-08","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_08:FGS-B01","text":"Die Maschine setzt ein äußerliches Quantum, negiert dessen Selbstständigkeit durch qualitative Aufnahme und gewinnt es als Moment eines immanenten Maßverhältnisses zurück.","refs":["CL_GB18_29:FGS-B01","CL_GB18_29:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:FGS-B02","text":"Spezifische Aufnahme codiert das Quantum als Exponenten; dessen Veränderung verändert nicht nur eine Größe, sondern die qualitative Form der Relation.","refs":["CL_GB18_29:FGS-B02","CL_GB18_30:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:FGS-B03","text":"Die Verbindung mehrerer Maße vervielfältigt Exponenten zu Reihen und erzeugt durch Invarianzen eine Vergleichungsordnung zweiter Stufe.","refs":["CL_GB18_30:FGS-B03","CL_GB18_31:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:FGS-B04","text":"Die Reihenordnung produziert Ausschließlichkeit, während Neutralisation, alternative Partner und quantitative Bedingungen denselben Ausschluss erneut öffnen.","refs":["CL_GB18_31:GA-08","CL_GB18_31:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:FGS-B05","text":"Fortgesetzte quantitative Variation durchläuft einen Gleichgültigkeitsbereich, erreicht einen Maßpunkt und setzt durch Maßlosigkeit eine neue Qualität frei.","refs":["CL_GB18_32:AS-B03","CL_GB18_32:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:FGS-B06","text":"Die unendliche Wiederholung der Umschläge führt die Maße auf ein gemeinsames Substrat zurück und verwandelt ihre Selbstständigkeit in die Zustandsform einer übergeordneten Einheit.","refs":["CL_GB18_32:AS-B05","CL_GB18_32:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_08:AFM-B01","text":"Äußerliches Quantum → spezifische Aufnahme → qualitativ bestimmtes Quantum → reales Maß.","refs":["CL_GB18_29:RLE-01","CL_GB18_29:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AFM-B02","text":"Reales Maß → asymmetrische Maßseiten → Exponent → negative Einheit → relationale Selbstständigkeit.","refs":["CL_GB18_29:GA-05","CL_GB18_30:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AFM-B03","text":"Relationale Selbstständigkeit → Verbindung mehrerer Maße → Exponentenreihen → Reiheninvarianz → Vergleichbarkeit.","refs":["CL_GB18_30:CGD-03","CL_GB18_31:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AFM-B04","text":"Vergleichungsordnung → maßförmige Ausschließlichkeit → alternative Neutralisation → Mengen- und Umstandsbedingtheit → relativierter Vorrang.","refs":["CL_GB18_31:GA-08","CL_GB18_31:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AFM-B05","text":"Quantitative Fortsetzung → Gleichgültigkeitsbereich → Maßpunkt → qualitativer Sprung → Maßlosigkeit → neues Maß.","refs":["CL_GB18_32:GA-02","CL_GB18_32:GA-04","CL_GB18_32:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AFM-B06","text":"Wiederholte Knotenbildung → unendliche Maßreihe → Rückkehr der Einheit → Substratkontinuität → Entselbstständigung des Maßes → offene Forderung des immanenten Gesetzes.","refs":["CL_GB18_32:AS-B05","CL_GB18_31:GA-11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_08:MME-01","text":"Qualität und Quantität werden nicht mehr als getrennte Ordnungen kartiert; unterschieden werden nun äußere Menge, maßförmige Spezifikation, qualitative Schwelle und relationale Stabilität.","refs":["CL_GB18_30:MME-01","CL_GB18_31:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-02","text":"Das Ding wird vom Träger fertiger Eigenschaften zum Knoten von Maßverhältnissen und schließlich zum Zustand eines durch Wechsel fortbestehenden Substrats umklassifiziert.","refs":["CL_GB18_30:MME-02","CL_GB18_32:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-03","text":"Empirisches Gesetz und erklärende Ontologie werden entkoppelt, sodass Zahlenreihen Modelle prüfen können, ohne selbst atomistische, elektrische oder andere Trägerbilder zu beweisen.","refs":["CL_GB18_31:MME-04","CL_GB18_31:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-04","text":"Vergleichbarkeit und Auswahl werden getrennt: Eine gemeinsame Reihenordnung ermöglicht Vergleichung, entscheidet aber nicht notwendig über die tatsächliche Aktualisierung einer Verbindung.","refs":["CL_GB18_31:MME-03","CL_GB18_31:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-05","text":"Die Opposition von Kontinuität und Diskontinuität kollabiert, weil das Kontinuum als Trägerstruktur und der Sprung als spezifische Form qualitativen Werdens fungiert.","refs":["CL_GB18_32:MME-03","CL_GB18_32:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-06","text":"Maß verliert den Status einer terminalen Kategorie und wird zur Übergangsmaschine, die qualitative Gestalten erzeugt und zugleich ihre eigene Unterordnung unter das Substrat vorbereitet.","refs":["CL_GB18_32:AS-B06","CL_GB18_32:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-07","text":"Adäquate Lektüre muss Begriffe nach ihrer wechselnden Funktion verfolgen, weil Wiederkehr hier nicht Identität, sondern häufig Mutation, Umkehrung oder Maßstabswechsel bedeutet.","refs":["CL_GB18_31:RMD-05","CL_GB18_32:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_08:ALT-B01","text":"Auf der Oberflächenebene fungieren Temperatur, Bewegung, materielle Verbindung, chemische Affinität, Mischung und Größenwechsel als Prüfstellen derselben Maßproblematik, ohne auf eine einheitliche Sachform reduziert zu werden.","refs":["CL_GB18_29:ALT-B01","CL_GB18_31:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:ALT-B02","text":"Auf der Strukturebene vermittelt Maß äußere Quantität, spezifische Aufnahme, Exponentenbildung, Reihenordnung, Ausschließlichkeit, Schwellen und qualitative Zustandswechsel.","refs":["CL_GB18_30:ALT-B02","CL_GB18_32:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:ALT-B03","text":"Auf der metastrategischen Ebene wird Erklärung zur Rekonstruktion relationaler Erzeugungsbedingungen und zur Prüfung, ob Modelle die empirischen Differenzen bewahren, die sie erklären sollen.","refs":["CL_GB18_30:ALT-B03","CL_GB18_31:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:ALT-B04","text":"Auf der ontologischen und temporalen Ebene ist Realität ein nichtlinearer Prozess aus Kontinuität, Schwelle, negativer Selbstbeziehung und erneuerter Einheit.","refs":["CL_GB18_30:ALT-B04","CL_GB18_32:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:ALT-B05","text":"Auf der methodologischen und performativen Ebene vollzieht die Darstellung ihre These, indem jede zunächst zureichende Bestimmung durch ihre eigenen Konsequenzen destabilisiert und in eine umfassendere Relationsordnung überführt wird.","refs":["CL_GB18_31:ALT-B05","CL_GB18_32:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_08:FL-01","text":"Äußerlichkeit ist notwendiger Ausgangspunkt und bleibendes Moment, darf aber keine unabhängige Erklärungskraft besitzen; die Architektur kann sie weder eliminieren noch ontologisch verselbstständigen.","refs":["CL_GB18_29:FL-01","CL_GB18_30:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:FL-02","text":"Selbstständigkeit soll real sein, obwohl ihre gesamte spezifische Bestimmtheit aus Beziehungen hervorgeht, die jede beziehungslose Identität unterlaufen.","refs":["CL_GB18_30:FL-02","CL_GB18_31:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:FL-03","text":"Der qualitative Sprung muss vollständig quantitativ vermittelt sein und darf dennoch nicht als bloße Verlängerung der vorherigen Qualität erscheinen.","refs":["CL_GB18_32:FL-01","CL_GB18_32:AS-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:FL-04","text":"Exponenten sollen qualitative Notwendigkeit ausdrücken, doch ihre konkreten Werte und die Kriterien der Schwellenbildung bleiben empirisch oder sachlogisch unterbestimmt.","refs":["CL_GB18_29:FL-02","CL_GB18_32:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:FL-05","text":"Das Substrat muss durch qualitative Wechsel bestimmt werden und zugleich als dasselbe fortbestehen; seine Einheit ist daher weder reine Identität noch bloße Abfolge.","refs":["CL_GB18_32:FL-03","CL_GB18_32:MRT-B03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:FL-06","text":"Die methodische Autonomie empirischer Gesetze schützt spezifische Differenzen vor spekulativer Reduktion, lässt aber gerade das positive Prinzip ihrer Erzeugung offen.","refs":["CL_GB18_31:FL-04","CL_GB18_31:MRT-B06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:MP-01","text":"Das Quantum mutiert vom äußeren Medium zum Exponenten und vom Exponenten zum Maßpunkt, ohne seine quantitative Form vollständig zu verlieren.","refs":["CL_GB18_29:MP-01","CL_GB18_32:GA-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:MP-02","text":"Der Exponent mutiert von der Darstellung eines spezifischen Verhältnisses zum diskontinuierlichen Ausschlussoperator und schließlich zum veränderlichen Index bedingter Relationen.","refs":["CL_GB18_30:MP-01","CL_GB18_31:RMD-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:MP-03","text":"Neutralität mutiert von der Bedingung relationaler Erhaltung zur Quelle ausschließender Negativität und weiter zum Mechanismus erneuter Indifferenz.","refs":["CL_GB18_31:MP-02","CL_GB18_31:RMD-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:MP-04","text":"Maßlosigkeit mutiert vom scheinbaren Verlust der Bestimmung zur produktiven Übergangsform und zur Schwelle negativer Unendlichkeit.","refs":["CL_GB18_30:MP-04","CL_GB18_32:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:MP-05","text":"Maß mutiert von der immanenten Einheit qualitativer Selbstständigkeit zur Maschine ihrer Überschreitung und schließlich zum untergeordneten Zustand des Substrats.","refs":["CL_GB18_31:MP-03","CL_GB18_32:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_08:HSI-01","text":"Realität erscheint als verteilte Schwellenmaschine, in der Maßrelationen quantitative Einwirkungen aufnehmen, qualitative Gestalten erzeugen und diese an ihren eigenen Grenzen transformieren.","refs":["CL_GB18_30:HSI-01","CL_GB18_32:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:HSI-02","text":"Das Subjekt oder Ding ist ein temporärer relationaler Knoten und zugleich ein Zustand der Einheit, die seine qualitativen Veränderungen überdauert.","refs":["CL_GB18_30:HSI-02","CL_GB18_32:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:HSI-03","text":"Zeit ist eine Spiralstruktur aus quantitativer Fortsetzung, qualitativer Unterbrechung und rückkehrender Einheit; sie produziert Differenz, statt nur fertige Zustände anzuordnen.","refs":["CL_GB18_30:HSI-03","CL_GB18_32:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:HSI-04","text":"Handlung bleibt als Navigation und Eingriff in Relationsordnungen möglich, nicht jedoch als Verfügung über ein absolutes Auswahl- oder Schwellengesetz.","refs":["CL_GB18_30:HSI-04","CL_GB18_31:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_08:MRT-B01","text":"Die Architektur ist rekonstruierbar, wenn Maß als qualitative Einheit quantitativer Relationen, Selbstständigkeit als relationaler Knoten, Reihe als Vergleichungsordnung, Maßlosigkeit als Übergang und Substrat als Rückkehrinstanz gemeinsam erhalten bleiben.","refs":["CL_GB18_30:MRT-B01","CL_GB18_32:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MRT-B02","text":"Das System ist kohärent, sofern Äußerlichkeit weder beseitigt noch zum unabhängigen Grund gemacht und Widersprüche zwischen Erhaltung und Veränderung als produktive Vermittlungen behandelt werden.","refs":["CL_GB18_30:MRT-B03","CL_GB18_31:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MRT-B03","text":"Seine stärkste Architekturleistung ist die rekursive Umwandlung quantitativer Äußerlichkeit in qualitative Spezifikation, relationale Selbstständigkeit und schwellenabhängige Transformation.","refs":["CL_GB18_30:MRT-B04","CL_GB18_32:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MRT-B04","text":"Unterbestimmt bleiben die konkreten Exponenten, Koeffizienten, Auswahlvorränge, Reihenabgrenzungen, Mischungsregeln und Maßpunkte; ihre systematische Notwendigkeit ersetzt nicht ihre positive Herleitung.","refs":["CL_GB18_30:MRT-B02","CL_GB18_31:MRT-B04","CL_GB18_32:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MRT-B05","text":"Die Rekonstruktion hängt wesentlich von rekursiver Rückkehr und Funktionsmutation ab: Eine lineare Abfolge würde die Umkehrungen von Neutralität, Ausschluss, Maßlosigkeit und Maß selbst zerstören.","refs":["CL_GB18_31:RLE-04","CL_GB18_31:MP-02","CL_GB18_32:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MRT-B06","text":"Der axiomatischen Reduktion widersteht das fehlende immanente Naturgesetz, das konkrete Reihen, Exponenten und Schwellen erzeugen müsste; diese Nichtverfügbarkeit ist keine Randlücke, sondern die terminale Grenze der gesamten Maschine.","refs":["CL_GB18_31:MRT-B06","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123754353221Z_9a307c90","language_code":"en","language_name":"English","title":"Gb18 L1 08","source_sha256":"e3cf762c41dfd814997818fdde7f680345e87e15f8ec1b3b9f7de77f39bb8adc","sha256":"2adccd5bd35c8ea70213f8802825a091d0ed565ed649a1186a3507d4249be106","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:37:54.355118+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_08:AS-01","text":"The system must explain how external quantity can produce qualitative determinacy and real self-subsistence without either persisting as an independent ground or being completely effaced.","refs":["CL_GB18_29:AS-B02","CL_GB18_31:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-02","text":"Its global thesis is that measure is the immanent unity of quality and quantity, and that quality therefore possesses reality only as the relational specification of quantitative relations.","refs":["CL_GB18_29:GA-01","CL_GB18_31:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-03","text":"The argument transforms immediate quanta into exponents, exponents into relational moments of measure, and individual relations into series whose orders produce self-subsistence and comparability.","refs":["CL_GB18_30:BAS-03","CL_GB18_31:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-04","text":"Through measure-points and qualitative leaps, the serial order becomes a nodal line, whose repeated reversals finally reduce the individual measures to states of a persisting substrate.","refs":["CL_GB18_32:GA-04","CL_GB18_32:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-05","text":"The movement is spiral-shaped and recursive: externality is specified, recovered as relation, multiplied into series, intensified through exclusion, and reopened through its own quantitative mediation.","refs":["CL_GB18_29:AS-B05","CL_GB18_32:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-06","text":"Every achieved stability produces its own transcendence: quantitative continuity gives rise to qualitative nodes, exclusivity permits alternative connections, and the leap releases a new series of quantitative change.","refs":["CL_GB18_30:GA-07","CL_GB18_31:GA-08","CL_GB18_32:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-07","text":"Empirical and mathematical lawfulness remains valid, but is separated from conceptual necessity so long as exponents, orders of selection, and measure-points do not arise from an immanent generative principle.","refs":["CL_GB18_29:GA-07","CL_GB18_31:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AS-08","text":"The closure consists neither in a final measure nor in a definitive law of selection, but in the terminal transformation of measure into a moment of negative unity that maintains itself through changing determinations.","refs":["CL_GB18_30:GA-08","CL_GB18_32:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_08:GA-01","text":"[Persistent] Measure is the immanent unity of quality and quantity, in which quantitative determinations do not represent qualitative reality but co-produce it.","refs":["CL_GB18_29:GA-01","CL_GB18_32:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-02","text":"[Persistent] Qualitative determinacy possesses no relationless bearer, but arises as specific difference within ordered relations.","refs":["CL_GB18_30:GA-03","CL_GB18_31:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-03","text":"[Mutating] The external quantum mutates from the seemingly self-subsistent given into the exponent of a relation and finally into the threshold parameter of qualitative transformation.","refs":["CL_GB18_29:GA-02","CL_GB18_30:RMD-03","CL_GB18_32:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-04","text":"[Emergent] Self-subsistence is not freedom from relation, but the temporary stability of a relational node that maintains itself through repulsion, reaction, and change.","refs":["CL_GB18_30:GA-04","CL_GB18_31:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-05","text":"[Attractor] Negative unity is the operative form that mediates externality and immanence, self-maintenance and change, as well as exclusion and relation.","refs":["CL_GB18_30:GA-06","CL_GB18_30:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-06","text":"[Emergent] Quantitative continuity organizes itself as series, serial invariance, and nodal line; its truth lies in the qualitative differences and interruptions that it bears.","refs":["CL_GB18_30:GA-07","CL_GB18_31:GA-04","CL_GB18_32:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-07","text":"[Mutating] Exclusivity arises as measure-shaped negativity, mutates into the discontinuous exponent, and is relativized anew through alternative combinations, quantities, and circumstances.","refs":["CL_GB18_31:GA-08","CL_GB18_31:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-08","text":"[Persistent] Empirical regularity and mathematical representation possess validity, but do not by themselves produce the conceptual necessity of their law-form.","refs":["CL_GB18_29:GA-07","CL_GB18_31:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-09","text":"[Terminal] Measurelessness is the productive self-negation of a measure through which its previous qualitative validity ends and a new determination of measure emerges.","refs":["CL_GB18_30:GA-08","CL_GB18_32:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-10","text":"[Terminal] The completion of the architecture of measure does not sublate all measures into one highest measure, but absorbs their self-subsistence into the continuity of a substrate that maintains itself through changes of state.","refs":["CL_GB18_32:AS-B06","CL_GB18_32:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-11","text":"[Attractor] The unavailable immanent generative principle for exponents, affinities, mixtures, and measure-points organizes the architecture as a negative target-form.","refs":["CL_GB18_31:GA-11","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:GA-12","text":"[Attractor] Externality must remain preserved as a necessary moment, but must never count as an independent ground of qualitative truth.","refs":["CL_GB18_30:FL-01","CL_GB18_30:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_08:RMD-01","text":"Measure preserves its identity as the unity of quality and quantity, but mutates from the specification of individual relations to the production of relational self-subsistence and finally to the transitional form of the substrate.","refs":["CL_GB18_30:RMD-01","CL_GB18_32:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-02","text":"The quantum functionally recurs as external influence, immediate exponent, member of a series, variable quantity, and threshold value; its self-subsistence thereby continuously diminishes.","refs":["CL_GB18_29:GA-02","CL_GB18_30:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-03","text":"The exponent migrates from the power-form of a qualitative relation to the index of relational specification, to the operator of exclusion, and to the variable expression of orders of mixture and thresholds.","refs":["CL_GB18_29:GA-06","CL_GB18_31:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-04","text":"Self-subsistence mutates from the individual negative whole of measure to the node of many counter-relations and finally to the temporary state of a more comprehensive unity.","refs":["CL_GB18_30:RMD-04","CL_GB18_31:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-05","text":"The series expands its function from the representation of specific relations through invariances between counter-series to the nodal line of qualitative reversals.","refs":["CL_GB18_31:RMD-02","CL_GB18_32:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-06","text":"Neutrality reverses its valence: it initially enables relational maintenance, then produces exclusivity, and finally becomes the medium of alternative connections that destabilize exclusion.","refs":["CL_GB18_31:RMD-04","CL_GB18_31:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-07","text":"Measurelessness mutates from the apparent end of the determination of measure to the productive negation that produces new measures and transfers the series into negative self-relation.","refs":["CL_GB18_30:RMD-07","CL_GB18_32:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-08","text":"Only terminally does the substrate appear as the recurring instance of the nodal line and absorb the previously self-subsistently posited measures as its own changing states.","refs":["CL_GB18_32:RMD-04","CL_GB18_32:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RMD-09","text":"The empirical law retains its testing function, but loses its claim to determine at once both the image of the bearer and the immanent generative principle of its relations.","refs":["CL_GB18_31:MME-04","CL_GB18_31:GA-09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_08:CGD-01","text":"Heat capacities, modes of motion, chemical reactions, and musical relations remain local realizations; at the meta-cluster level, their common function as evidence of relational specification counts.","refs":["CL_GB18_29:CGD-01","CL_GB18_31:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-02","text":"Specific power-forms and proportional numbers remain local, while the recoding of mathematical forms into qualitative functional positions scales globally.","refs":["CL_GB18_29:CGD-02","CL_GB18_31:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-03","text":"Atomistic, corpuscular, and electrochemical models remain local targets of critique; globally, the criterion holds that no image of a bearer may efface the relational differences to be explained.","refs":["CL_GB18_31:CGD-02","CL_GB18_31:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-04","text":"Individual series of affinity, neutralization, and mixture remain domain-specific; the formation of series and the open demand for their generative law, by contrast, connect the entire architecture.","refs":["CL_GB18_31:CGD-04","CL_GB18_31:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-05","text":"Moral and political examples supply no additional ontology, but merely scale the logic of thresholds beyond natural relations.","refs":["CL_GB18_32:CGD-03","CL_GB18_32:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-06","text":"Concrete coefficients, exponents, priorities of selection, and measure-points remain underdetermined at lower levels; globally load-bearing is the systematic marking of this underdetermination.","refs":["CL_GB18_30:MRT-B02","CL_GB18_32:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:CGD-07","text":"Only at the current level does it become visible that the local analyses of measure jointly converge on a terminal de-self-subsistence of measure and its absorption into the substrate.","refs":["CL_GB18_32:AS-B06","CL_GB18_32:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_08:GNX-01","text":"Excluded is a pure quantity or immediate quality that would be completely determined without relational specification.","refs":["CL_GB18_29:BSA-01","CL_GB18_31:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:GNX-02","text":"Excluded is a model of finished things whose properties exist prior to their relations and are merely compared externally through them.","refs":["CL_GB18_29:DBN-01","CL_GB18_31:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:GNX-03","text":"Excluded is linear causality insofar as it transmits external quantity unchanged and ignores the qualitative self-reaction of the relata.","refs":["CL_GB18_29:GNX-01","CL_GB18_30:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:GNX-04","text":"Excluded is the equation of empirical confirmation or mathematical universality with conceptual generation and ontological necessity.","refs":["CL_GB18_29:GNX-03","CL_GB18_31:DBN-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:GNX-05","text":"Excluded is a homogeneous continuum that dissolves qualitative novelty into infinitely small differences of degree and renders real leaps unrecognizable.","refs":["CL_GB18_32:GNX-02","CL_GB18_32:MME-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:GNX-06","text":"Excluded is a final, absolutely self-subsistent measure that would be neither changeable nor related to a more comprehensive unity.","refs":["CL_GB18_32:DBN-03","CL_GB18_32:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_08:DBN-01","text":"For the architecture to endure, every non-relational ground must be false; the determinacy of things must not precede their relations of measure.","refs":["CL_GB18_30:DBN-01","CL_GB18_31:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:DBN-02","text":"Self-maintenance must not count as unchanged persistence, because measure preserves its identity only through negative reaction and qualitative self-modification.","refs":["CL_GB18_30:DBN-03","CL_GB18_30:RMD-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:DBN-03","text":"Continuity and discontinuity must not be treated as exclusive total models, because quantitative continuation forms the bearer-form of qualitative interruption.","refs":["CL_GB18_31:DBN-04","CL_GB18_32:MME-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:DBN-04","text":"A complete conceptual deduction of concrete numbers must not be tacitly presupposed, since empirical coefficients and the common law of measure expressly remain unavailable.","refs":["CL_GB18_30:DBN-02","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:DBN-05","text":"The substrate may count neither as a rigid thing outside its states nor as a mere name for their sequence; it must remain the same through the changes and be determined by them.","refs":["CL_GB18_32:DBN-02","CL_GB18_32:FL-03"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_08:BSA-01","text":"The deepest structuring absence is an immanent law that could derive concrete exponents, choices of affinity, relations of mixture, and measure-points from a single generative order.","refs":["CL_GB18_29:BSA-02","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:BSA-02","text":"Unavailable are both an absolutely first immediacy and a final self-subsistence that would have left behind its relations, negations, and changes.","refs":["CL_GB18_30:BSA-01","CL_GB18_30:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:BSA-03","text":"Impossible is an external perspective from which measures could be fully apprehended without the measuring relation itself entering the field of specification.","refs":["CL_GB18_29:BSA-03","CL_GB18_32:GA-08"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_08:BSA-04","text":"Ontologically inadmissible remains a reality whose change would be wholly available as a homogeneous scale and would therefore contain neither real novelty nor negative transitional work.","refs":["CL_GB18_32:BSA-01","CL_GB18_32:GA-06"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_08:XD-01","text":"The qualitative self-reaction of a relatum and the reciprocal specification of connected measures are the same structure at different scales: externality becomes the material of immanent self-determination.","refs":["MC_GB18_L1_08:GA-01","MC_GB18_L1_08:GA-02","MC_GB18_L1_08:GA-03","MC_GB18_L1_08:GA-12","CL_GB18_29:AS-B04","CL_GB18_30:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-02","text":"Power-form and series of exponents make mathematical forms into indices of qualitative architectures of relation; precisely for this reason, their concrete derivation remains precarious when the exponent must be given empirically.","refs":["MC_GB18_L1_08:GA-03","MC_GB18_L1_08:GA-06","MC_GB18_L1_08:GA-08","MC_GB18_L1_08:GA-11","CL_GB18_29:GA-06","CL_GB18_31:RMD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-03","text":"Serial invariance and nodal line jointly determine quantitative continuity as an articulated field of thresholds in which comparability is preserved without enforcing qualitative uniformity.","refs":["MC_GB18_L1_08:GA-06","MC_GB18_L1_08:GA-09","CL_GB18_31:GA-04","CL_GB18_32:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-04","text":"Because exclusivity arises in the same quantitative field that enables alternative connections, a measure-determined unity can maintain itself only as changing and conditioned self-subsistence.","refs":["MC_GB18_L1_08:GA-04","MC_GB18_L1_08:GA-05","MC_GB18_L1_08:GA-07","CL_GB18_30:RMD-05","CL_GB18_31:FL-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-05","text":"The autonomy of empirical laws of proportion makes them means of testing competing ontologies, but not substitute forms for the absent immanent law of generation.","refs":["MC_GB18_L1_08:GA-08","MC_GB18_L1_08:GA-11","CL_GB18_31:GA-09","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-06","text":"The logic of measure completes itself paradoxically by its productive self-negation producing new measures, whose infinite repetition finally sublates the self-subsistence of measure itself.","refs":["MC_GB18_L1_08:GA-09","MC_GB18_L1_08:GA-10","CL_GB18_32:GA-06","CL_GB18_32:AS-B06"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_08:XD-07","text":"Causality must be articulated into relational possibility, measure-shaped specification, conditioned selection, and threshold-dependent actualization; no individual moment explains the qualitative transition.","refs":["MC_GB18_L1_08:GA-06","MC_GB18_L1_08:GA-07","MC_GB18_L1_08:GA-09","CL_GB18_31:BSD-02","CL_GB18_32:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_08:BSD-01","text":"Reality becomes a recursive network of measure-shaped nodes and thresholds in which quantitative relations produce, stabilize, and destroy qualitative forms.","refs":["CL_GB18_30:HSI-01","CL_GB18_31:HSI-01","CL_GB18_32:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-02","text":"Being has no relationless core, but is a relational center and at the same time a changing state of the unity that bears its transformations.","refs":["CL_GB18_31:BSD-01","CL_GB18_32:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-03","text":"Causality is recursive and threshold-shaped: an external change is internally specified, alters the order of relations, and can actualize a new qualitative form at a measure-point.","refs":["CL_GB18_30:BSD-02","CL_GB18_31:BSD-02","CL_GB18_32:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-04","text":"Time is neither linear nor cyclical, but nodal and spiral-shaped: continuity bears interruptions, interruptions open new series, and repetition returns to unity in altered form.","refs":["CL_GB18_30:BSD-04","CL_GB18_31:HSI-03","CL_GB18_32:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-05","text":"Knowledge is hierarchized into observation, formal lawfulness, and conceptual generation; exact series are stronger than speculative images of bearers, but weaker than insight into their generative law.","refs":["CL_GB18_29:BSD-04","CL_GB18_31:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-06","text":"Intervention is possible only within the order of relations and cannot be reduced to a mere increase in quantity, because quantitative interventions at thresholds can change the form of the system.","refs":["CL_GB18_30:HSI-04","CL_GB18_32:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:BSD-07","text":"The transferability of the logic of measure to nature, morality, and political order grounds not identical laws, but a common type of threshold-dependent transformation.","refs":["CL_GB18_32:CGD-03","CL_GB18_32:XD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_08:RLE-01","text":"The elementary loop proceeds from the external quantum through specific reception and exponent-formation to the return of the quantum as a qualitatively determined measure.","refs":["CL_GB18_29:RLE-01","CL_GB18_30:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-02","text":"Relational individualization proceeds from self-subsistence through relation to others to specific determination, and from there to a renewed, but no longer relationless, self-subsistence.","refs":["CL_GB18_30:GA-09","CL_GB18_31:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-03","text":"Serial escalation leads from the individual exponent to the counter-series, thence to serial invariance, further to exclusivity, and finally to its combinatorial relativization.","refs":["CL_GB18_31:RLE-02","CL_GB18_31:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-04","text":"The threshold loop is: measure, quantitative variation, zone of indifference, measure-point, qualitative leap, new measure, and renewed variation.","refs":["CL_GB18_32:RLE-01","CL_GB18_32:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-05","text":"The terminal escalation leads from the multiplication of measures to the nodal line, from the measureless to recurring unity, and thence to the absorption of measures into the substrate.","refs":["CL_GB18_32:RLE-03","CL_GB18_32:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-06","text":"Negative unity is the positive attractor, because every seemingly immediate determination receives systematic truth only through mediated self-relation.","refs":["CL_GB18_30:GA-06","CL_GB18_31:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:RLE-07","text":"The absent closed system of measure is the negative attractor: every domain expansion demands it anew without providing its common rule of calculation and generation.","refs":["CL_GB18_31:RMD-08","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_08:FGS-B01","text":"The machine posits an external quantum, negates its self-subsistence through qualitative reception, and recovers it as a moment of an immanent relation of measure.","refs":["CL_GB18_29:FGS-B01","CL_GB18_29:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:FGS-B02","text":"Specific reception encodes the quantum as exponent; its alteration changes not merely a magnitude but the qualitative form of the relation.","refs":["CL_GB18_29:FGS-B02","CL_GB18_30:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:FGS-B03","text":"The connection of several measures multiplies exponents into series and produces through invariances a second-order order of comparison.","refs":["CL_GB18_30:FGS-B03","CL_GB18_31:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:FGS-B04","text":"The serial order produces exclusivity, while neutralization, alternative partners, and quantitative conditions reopen that same exclusion.","refs":["CL_GB18_31:GA-08","CL_GB18_31:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:FGS-B05","text":"Continued quantitative variation passes through a zone of indifference, reaches a measure-point, and through measurelessness releases a new quality.","refs":["CL_GB18_32:AS-B03","CL_GB18_32:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:FGS-B06","text":"The infinite repetition of reversals leads measures back to a common substrate and transforms their self-subsistence into the state-form of a higher-order unity.","refs":["CL_GB18_32:AS-B05","CL_GB18_32:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_08:AFM-B01","text":"External quantum → specific reception → qualitatively determined quantum → real measure.","refs":["CL_GB18_29:RLE-01","CL_GB18_29:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AFM-B02","text":"Real measure → asymmetric sides of measure → exponent → negative unity → relational self-subsistence.","refs":["CL_GB18_29:GA-05","CL_GB18_30:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AFM-B03","text":"Relational self-subsistence → connection of several measures → series of exponents → serial invariance → comparability.","refs":["CL_GB18_30:CGD-03","CL_GB18_31:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AFM-B04","text":"Order of comparison → measure-shaped exclusivity → alternative neutralization → conditionality by quantity and circumstance → relativized priority.","refs":["CL_GB18_31:GA-08","CL_GB18_31:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AFM-B05","text":"Quantitative continuation → zone of indifference → measure-point → qualitative leap → measurelessness → new measure.","refs":["CL_GB18_32:GA-02","CL_GB18_32:GA-04","CL_GB18_32:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:AFM-B06","text":"Repeated node-formation → infinite series of measures → return of unity → continuity of substrate → de-self-subsistence of measure → open demand for the immanent law.","refs":["CL_GB18_32:AS-B05","CL_GB18_31:GA-11"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_08:MME-01","text":"Quality and quantity are no longer mapped as separate orders; external quantity, measure-shaped specification, qualitative threshold, and relational stability are now distinguished.","refs":["CL_GB18_30:MME-01","CL_GB18_31:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-02","text":"The thing is reclassified from the bearer of finished properties into the node of relations of measure and finally into the state of a substrate persisting through changes.","refs":["CL_GB18_30:MME-02","CL_GB18_32:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-03","text":"Empirical law and explanatory ontology are decoupled, so that numerical series can test models without themselves proving atomistic, electrical, or other images of bearers.","refs":["CL_GB18_31:MME-04","CL_GB18_31:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-04","text":"Comparability and selection are separated: a common serial order enables comparison but does not necessarily decide the actual actualization of a connection.","refs":["CL_GB18_31:MME-03","CL_GB18_31:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-05","text":"The opposition of continuity and discontinuity collapses, because the continuum functions as bearer-structure and the leap as the specific form of qualitative becoming.","refs":["CL_GB18_32:MME-03","CL_GB18_32:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-06","text":"Measure loses the status of a terminal category and becomes a machine of transition that produces qualitative forms while at the same time preparing its own subordination to the substrate.","refs":["CL_GB18_32:AS-B06","CL_GB18_32:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MME-07","text":"Adequate reading must follow concepts according to their changing function, because recurrence here does not mean identity but often mutation, reversal, or change of scale.","refs":["CL_GB18_31:RMD-05","CL_GB18_32:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_08:ALT-B01","text":"At the surface level, temperature, motion, material connection, chemical affinity, mixture, and change of magnitude function as testing sites of the same problematic of measure, without being reduced to a uniform factual form.","refs":["CL_GB18_29:ALT-B01","CL_GB18_31:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:ALT-B02","text":"At the structural level, measure mediates external quantity, specific reception, exponent-formation, serial order, exclusivity, thresholds, and qualitative changes of state.","refs":["CL_GB18_30:ALT-B02","CL_GB18_32:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:ALT-B03","text":"At the meta-strategic level, explanation becomes the reconstruction of relational conditions of generation and the examination of whether models preserve the empirical differences they are supposed to explain.","refs":["CL_GB18_30:ALT-B03","CL_GB18_31:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:ALT-B04","text":"At the ontological and temporal level, reality is a nonlinear process of continuity, threshold, negative self-relation, and renewed unity.","refs":["CL_GB18_30:ALT-B04","CL_GB18_32:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:ALT-B05","text":"At the methodological and performative level, the presentation enacts its thesis by destabilizing every initially sufficient determination through its own consequences and transferring it into a more comprehensive order of relations.","refs":["CL_GB18_31:ALT-B05","CL_GB18_32:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_08:FL-01","text":"Externality is a necessary starting point and enduring moment, but may possess no independent explanatory power; the architecture can neither eliminate it nor render it ontologically self-subsistent.","refs":["CL_GB18_29:FL-01","CL_GB18_30:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:FL-02","text":"Self-subsistence is supposed to be real although its entire specific determinacy arises from relations that undermine every relationless identity.","refs":["CL_GB18_30:FL-02","CL_GB18_31:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:FL-03","text":"The qualitative leap must be fully quantitatively mediated and yet may not appear as a mere extension of the preceding quality.","refs":["CL_GB18_32:FL-01","CL_GB18_32:AS-B04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:FL-04","text":"Exponents are supposed to express qualitative necessity, yet their concrete values and the criteria of threshold-formation remain empirically or materially-logically underdetermined.","refs":["CL_GB18_29:FL-02","CL_GB18_32:MRT-B02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:FL-05","text":"The substrate must be determined through qualitative changes and at the same time persist as the same; its unity is therefore neither pure identity nor mere sequence.","refs":["CL_GB18_32:FL-03","CL_GB18_32:MRT-B03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:FL-06","text":"The methodological autonomy of empirical laws protects specific differences against speculative reduction, but leaves open precisely the positive principle of their generation.","refs":["CL_GB18_31:FL-04","CL_GB18_31:MRT-B06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:MP-01","text":"The quantum mutates from the external medium into the exponent and from the exponent into the measure-point without completely losing its quantitative form.","refs":["CL_GB18_29:MP-01","CL_GB18_32:GA-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:MP-02","text":"The exponent mutates from the representation of a specific relation into the discontinuous operator of exclusion and finally into the variable index of conditioned relations.","refs":["CL_GB18_30:MP-01","CL_GB18_31:RMD-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:MP-03","text":"Neutrality mutates from the condition of relational maintenance into the source of exclusive negativity and further into the mechanism of renewed indifference.","refs":["CL_GB18_31:MP-02","CL_GB18_31:RMD-04"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:MP-04","text":"Measurelessness mutates from the apparent loss of determinacy into the productive transitional form and into the threshold of negative infinity.","refs":["CL_GB18_30:MP-04","CL_GB18_32:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_08:MP-05","text":"Measure mutates from the immanent unity of qualitative self-subsistence into the machine of its transcendence and finally into the subordinate state of the substrate.","refs":["CL_GB18_31:MP-03","CL_GB18_32:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_08:HSI-01","text":"Reality appears as a distributed threshold machine in which relations of measure receive quantitative influences, produce qualitative forms, and transform these at their own limits.","refs":["CL_GB18_30:HSI-01","CL_GB18_32:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:HSI-02","text":"The subject or thing is a temporary relational node and at the same time a state of the unity that outlasts its qualitative changes.","refs":["CL_GB18_30:HSI-02","CL_GB18_32:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:HSI-03","text":"Time is a spiral structure of quantitative continuation, qualitative interruption, and returning unity; it produces difference instead of merely arranging finished states.","refs":["CL_GB18_30:HSI-03","CL_GB18_32:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:HSI-04","text":"Action remains possible as navigation and intervention in orders of relation, but not as disposal over an absolute law of selection or thresholds.","refs":["CL_GB18_30:HSI-04","CL_GB18_31:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_08:MRT-B01","text":"The architecture is reconstructible if measure as the qualitative unity of quantitative relations, self-subsistence as relational node, series as order of comparison, measurelessness as transition, and substrate as recurring instance are jointly preserved.","refs":["CL_GB18_30:MRT-B01","CL_GB18_32:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MRT-B02","text":"The system is coherent insofar as externality is neither removed nor made into the independent ground and contradictions between maintenance and change are treated as productive mediations.","refs":["CL_GB18_30:MRT-B03","CL_GB18_31:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MRT-B03","text":"Its strongest architectural achievement is the recursive transformation of quantitative externality into qualitative specification, relational self-subsistence, and threshold-dependent transformation.","refs":["CL_GB18_30:MRT-B04","CL_GB18_32:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MRT-B04","text":"Concrete exponents, coefficients, priorities of selection, delimitations of series, rules of mixture, and measure-points remain underdetermined; their systematic necessity does not replace their positive derivation.","refs":["CL_GB18_30:MRT-B02","CL_GB18_31:MRT-B04","CL_GB18_32:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MRT-B05","text":"The reconstruction depends essentially on recursive return and functional mutation: a linear sequence would destroy the reversals of neutrality, exclusion, measurelessness, and measure itself.","refs":["CL_GB18_31:RLE-04","CL_GB18_31:MP-02","CL_GB18_32:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_08:MRT-B06","text":"Axiomatic reduction is resisted by the absent immanent law of nature that would have to produce concrete series, exponents, and thresholds; this unavailability is not a marginal gap, but the terminal limit of the entire machine.","refs":["CL_GB18_31:MRT-B06","CL_GB18_31:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_08@R001","source_variant_id":"canonical:MC_GB18_L1_08:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 08","context":"Chapters 85–96 · Anmerkung. · c. Verhältniß beider Seiten als Qualitäten. · Anmerkung. · C. Das Fürsichseyn im Maaße. · A. Das Verhältniß selbstständiger Maaße. · a. Verbindung zweier Maaße. · b. Das Maaß als Reihe von Maaßverhältnissen. · c. Wahlverwandtschaft. · Anmerkung. · B. Knotenlinie von Maaßverhältnissen. · Anmerkung. · C. Das Maaßlose."},"title_language_code":"en"},{"id":"MC_GB18_L1_09","layer":"MC","title":"Gb18 L1 09","order":9,"parents":["CL_GB18_33","CL_GB18_34","CL_GB18_35","CL_GB18_36"],"revision":"MC_GB18_L1_09@R001","sha256":"684db30c445f913af388a7a66ef2bf3f272d6df92d36dfdb52d0e8836a4c7054","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_09:BAS-01","text":"Das System löst das Problem, wie Einheit und Unmittelbarkeit als Anfang auftreten können, obwohl ihre Unterschiede und ihr Anfangsstatus erst durch Vermittlung erzeugt werden.","refs":["CL_GB18_33:AS-01","CL_GB18_36:BAS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-02","text":"Die zunächst vorausgesetzte Indifferenz wird vom passiven Substrat in das Resultat einer Eigenbewegung überführt, die ihre Negation nicht äußerlich empfängt.","refs":["CL_GB18_33:AS-02","CL_GB18_34:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-03","text":"Die Kritik äußerlich quantifizierter Faktoren fungiert als Belastungstest dafür, ob eine Erklärung den qualitativen Übergang ihrer Bestimmungen tatsächlich hervorbringen kann.","refs":["CL_GB18_33:AS-04","CL_GB18_33:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-04","text":"Der Widerspruch der Indifferenz ist kein Enddefekt, sondern die Umschlagstelle, an der negative Totalität zur Reflexion des Wesens mutiert.","refs":["CL_GB18_33:GA-08","CL_GB18_34:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-05","text":"Das aufgehobene Seyn wird weder vernichtet noch als selbständiges Außen bewahrt, sondern kehrt als zeitlos vergangene und scheinbare Unmittelbarkeit innerhalb des Wesens wieder.","refs":["CL_GB18_34:RMD-07","CL_GB18_35:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-06","text":"Reflexion erzeugt ihre Voraussetzung, stellt sie als Vorgefundenes aus und nimmt sie als Funktion derselben Bewegung in sich zurück.","refs":["CL_GB18_35:RMD-05","CL_GB18_36:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-07","text":"Bestimmende Reflexion entsteht, wenn setzende und äußere Reflexion ihre Trennung aufheben und die selbstgesetzte Grundlage als eigenes Resultat begreifen.","refs":["CL_GB18_36:GA-05","CL_GB18_35:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-08","text":"Die Gesamtbewegung ist rekursiv, spiralförmig und retrospektiv; ihre Schließung bleibt instabil, weil die erzeugten Bestimmungen zugleich selbständig erscheinen und vollständig vermittelt sind.","refs":["CL_GB18_34:AS-08","CL_GB18_36:BAS-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_09:GA-01","text":"[Persistent] Konkrete Einheit besteht ausschließlich als Selbstvermittlung einer Differenz, die in der Einheit negiert, bewahrt und relational bestimmt wird.","refs":["CL_GB18_33:GA-01","CL_GB18_35:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-02","text":"[Mutating] Unmittelbarkeit mutiert vom scheinbar ersten Positiven über den aufgehobenen Rest des Seyns zur gesetzten und aufhebbaren Voraussetzung der Reflexion.","refs":["CL_GB18_35:GA-02","CL_GB18_36:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-03","text":"[Persistent] Äußerliche Zusammensetzung und quantitative Selbständigkeit können qualitative Übergänge nicht erklären, weil sie deren relationale Erzeugung voraussetzen.","refs":["CL_GB18_33:CGD-04","CL_GB18_34:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-04","text":"[Mutating] Negativität mutiert von der destruktiven Selbstunverträglichkeit der Indifferenz zur produktiven Reflexion, welche Bestimmtheit aus eigener Selbstdifferenzierung erzeugt.","refs":["CL_GB18_34:GA-02","CL_GB18_35:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-05","text":"[Persistent] Unterschied besitzt keine unabhängige Außenstellung, sondern wird als immanente Selbstunterscheidung und eigene aufgehobene Negation der Einheit bestimmt.","refs":["CL_GB18_34:GA-04","CL_GB18_36:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-06","text":"[Emergent] Schein ist die notwendige Form, in der das Wesen seine aufgehobene Unmittelbarkeit als eigenes Gegenüber exponiert.","refs":["CL_GB18_34:GA-06","CL_GB18_35:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-07","text":"[Emergent] Setzen und Voraussetzen sind gegenläufige Funktionen einer einzigen Reflexionsbewegung, in der das Vorausgesetzte als aufgehobenes Gesetztsein zurückkehrt.","refs":["CL_GB18_36:GA-03","CL_GB18_36:BAS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-08","text":"[Mutating] Grund verliert den Status eines verborgenen Substrats und wird zur Reflexionsoperation, durch welche Wesen sich in Existenz und Erscheinung vermittelt.","refs":["CL_GB18_34:GA-07","CL_GB18_34:DBN-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-09","text":"[Emergent] Reflexionsbestimmungen besitzen Bestand nur als in sich reflektierte Negativität; ihre Stabilität ist deshalb identisch mit ihrer vermittelten Instabilität.","refs":["CL_GB18_36:GA-07","CL_GB18_36:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-10","text":"[Terminal] Bestimmende Reflexion schließt die Bewegung, indem sie ihre selbstgesetzte Voraussetzung als Resultat aufhebt und dadurch ihre Grundlage ausdrücklich selbst produziert.","refs":["CL_GB18_35:AS-05","CL_GB18_35:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-11","text":"[Attractor] Immanente Erklärung verlangt, dass jeder Übergang und jeder vorausgesetzte Grund als Produkt derjenigen Bewegung ausgewiesen wird, die er ermöglichen soll.","refs":["CL_GB18_33:GA-06","CL_GB18_35:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_09:RMD-01","text":"Indifferenz behält zunächst die Funktion vorausgesetzter Einheit, verschwindet aber nach ihrer Umcodierung in Widerspruch und hinterlässt Reflexion als ihre höherstufige Bewegungsform.","refs":["CL_GB18_33:RMD-02","CL_GB18_34:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-02","text":"Quantität wandert von äußerlicher Bestimmbarkeit und Faktorenvergleich zur negativen Diagnose einer Differenz, die nur noch als reflexiv gesetzte Relation Bestand hat.","refs":["CL_GB18_33:RMD-03","CL_GB18_34:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-03","text":"Negation verschiebt sich von der Selbstaufhebung widersprüchlicher Einheit zur produktiven Reflexion, ohne ihre destruktive Funktion vollständig zu verlieren.","refs":["CL_GB18_33:RMD-04","CL_GB18_34:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-04","text":"Unmittelbarkeit bleibt terminologisch persistent, mutiert aber vom Aufhebungsrest über reflektierte Voraussetzung zur wesentlichen Unmittelbarkeit als Resultat vollständiger Vermittlung.","refs":["CL_GB18_35:RMD-01","CL_GB18_36:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-05","text":"Andersheit wird von äußerer Gegenposition über innere Negativität zur eigenen aufgehobenen Negation der Reflexionsbestimmung absorbiert.","refs":["CL_GB18_35:RMD-03","CL_GB18_36:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-06","text":"Das Gegenüber mutiert zum Schein und verliert den Status eines äußerlichen Restphänomens, ohne seine operative Opposition gegen das Wesen einzubüßen.","refs":["CL_GB18_34:RMD-06","CL_GB18_35:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-07","text":"Grund mutiert vom erwarteten Fundament zur erzeugten Voraussetzung und schließlich zur Vermittlungsoperation, deren Bestand nur in ihrer Externalisierung liegt.","refs":["CL_GB18_34:MP-04","CL_GB18_35:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_09:CGD-01","text":"Kräfteanalyse und reflektierende Urteilskraft bleiben lokale Fälle; auf der aktuellen Ebene skalieren sie nur als Prüfungen äußerlicher Erklärung und nachträglicher Bestimmung.","refs":["CL_GB18_36:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:CGD-02","text":"Das Maß und die quantitative Faktorenrelation bleiben lokale diagnostische Gestalten; global tragen sie nur die negative Forderung nach einer immanent vermittelten Einheit qualitativer Differenz.","refs":["CL_GB18_33:GA-09","CL_GB18_33:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:CGD-03","text":"Der Widerspruch einzelner vorausgesetzter Einheiten skaliert zum Organisationsprinzip, nach dem jede Grundlage ihre eigene Vermittlung hervorbringen und als Resultat zurücknehmen muss.","refs":["CL_GB18_34:CGD-02","CL_GB18_36:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:CGD-04","text":"Existenz, Erscheinung und Begriff markieren notwendige Externalisierungen der Reflexion, bleiben auf dieser Ebene aber in ihren positiven Inhalten unterbestimmte Anschlussstrukturen.","refs":["CL_GB18_34:GA-09","CL_GB18_34:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_09:GNX-01","text":"Ausgeschlossen wird jedes passive Substrat, das Bestimmungen trägt, ohne selbst durch deren Bewegung vermittelt zu werden.","refs":["CL_GB18_33:GNX-01","CL_GB18_35:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GNX-02","text":"Ausgeschlossen werden unabhängige quantitative Faktoren und positive Seinsgründe, die qualitative Bestimmtheit von außen absichern sollen.","refs":["CL_GB18_33:GNX-02","CL_GB18_36:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GNX-03","text":"Ausgeschlossen wird eine Reflexion, die einem fertigen Gegenstand Bestimmungen nachträglich zuschreibt und dessen Übergänge bloß voraussetzt.","refs":["CL_GB18_34:GA-08","CL_GB18_36:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GNX-04","text":"Ausgeschlossen werden getrennte Bereiche von Wesen und Erscheinung sowie ein Anderssein, das außerhalb reflexiver Selbstvermittlung fortbesteht.","refs":["CL_GB18_35:GNX-01","CL_GB18_36:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GNX-05","text":"Ausgeschlossen wird eine lineare Ordnung, in der Anfang, Vermittlung und Resultat als zeitlich oder äußerlich aufeinanderfolgende Zustände gelten.","refs":["CL_GB18_34:GNX-04","CL_GB18_36:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_09:DBN-01","text":"Damit das System Bestand hat, muss jeder erste Grund unwahr und jeder ungesetzte Anfang unmöglich sein.","refs":["CL_GB18_35:DBN-01","CL_GB18_36:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:DBN-02","text":"Bestimmtheit darf nicht als unmittelbar gegebener Inhalt auftreten, sondern muss aus Setzung, Voraussetzung und Aufhebung hervorgehen.","refs":["CL_GB18_35:GNX-03","CL_GB18_35:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:DBN-03","text":"Negation darf kein bloßer Verlust sein; sie muss Selbstbeziehung erzeugen und Nichtigkeit als Moment fortbestehender Bestimmung erhalten.","refs":["CL_GB18_34:DBN-03","CL_GB18_35:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:DBN-04","text":"Reine Immanenz darf Andersheit nicht restlos tilgen; sie muss Äußerlichkeit als notwendige Differenzform erzeugen und zugleich internalisieren.","refs":["CL_GB18_36:BSA-02","CL_GB18_36:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_09:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist ein positives Außen, das der Reflexion widersteht, ohne bereits Form ihrer eigenen Negativität zu sein.","refs":["CL_GB18_35:BSA-01","CL_GB18_36:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSA-02","text":"Nicht verfügbar sind ursprüngliche Identität und ein ungesetzter Anfang, weil beides die Rückkehr aus Negativität vorwegnehmen würde.","refs":["CL_GB18_34:BSA-02","CL_GB18_36:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSA-03","text":"Ontologisch unzulässig ist eine Bestimmung, deren Identität ohne Aufhebung des eigenen Gesetztseins und ohne Rückkehr aus Anderssein bestehen könnte.","refs":["CL_GB18_36:BSA-03","CL_GB18_36:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_09:XD-01","text":"Der Erklärungsausfall äußerlicher Kräfte wird zur positiven Bedingung einer Reflexionslogik, in der Bewegung nur als immanente Wahrheit der Bestimmungen erklärbar ist.","refs":["MC_GB18_L1_09:GA-03","MC_GB18_L1_09:GA-04","CL_GB18_33:AS-05","CL_GB18_36:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_09:XD-02","text":"Der Widerspruch der Indifferenz ist nicht bloß deren Widerlegung, sondern erzeugt die negative Totalität, aus der Reflexion als neue Form derselben Einheit hervorgeht.","refs":["MC_GB18_L1_09:GA-01","MC_GB18_L1_09:GA-04","CL_GB18_33:GA-08","CL_GB18_34:AS-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_09:XD-03","text":"Schein und Gegebenheit sind homologe Modi erzeugter Gegenständlichkeit: Beide stellen eine gesetzte Unmittelbarkeit als scheinbar vorausliegendes Gegenüber aus.","refs":["MC_GB18_L1_09:GA-02","MC_GB18_L1_09:GA-06","MC_GB18_L1_09:GA-07","CL_GB18_35:GA-04","CL_GB18_36:XD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_09:XD-04","text":"Die zeitlose Vergangenheit des Seyns und die retrospektive Erzeugung des Anfangs bilden dieselbe logische Zeitstruktur, in der Priorität erst durch Rückkehr bestimmt wird.","refs":["MC_GB18_L1_09:GA-02","MC_GB18_L1_09:GA-07","CL_GB18_34:CGD-05","CL_GB18_36:XD-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_09:XD-05","text":"Die Selbständigkeit der Reflexionsbestimmungen ist konstitutiv prekär, weil gerade ihre Fixierung die Vermittlung internalisiert, von der sie sich unabhängig darstellen.","refs":["MC_GB18_L1_09:GA-09","MC_GB18_L1_09:GA-10","CL_GB18_36:BAS-06","CL_GB18_36:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_09:XD-06","text":"Das Scheitern unabhängiger quantitativer Differenz erzwingt keine Rückkehr zur unterschiedslosen Qualität, sondern die Umcodierung des Unterschieds in reflexive Selbstunterscheidung.","refs":["MC_GB18_L1_09:GA-03","MC_GB18_L1_09:GA-05","CL_GB18_33:GNX-02","CL_GB18_34:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_09:BSD-01","text":"Realität wird zu einer selbstnegativen Maschine, die ihre scheinbaren Materialien, Gegenüber und Grundlagen als Stufen eigener Selbstdifferenzierung produziert.","refs":["CL_GB18_34:HSI-01","CL_GB18_35:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSD-02","text":"Kausalität bezeichnet keine äußere Einwirkung selbständiger Faktoren mehr, sondern die immanente Selbsttransformation wesentlicher Differenzen.","refs":["CL_GB18_33:BSD-01","CL_GB18_36:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSD-03","text":"Zeitlichkeit wird retrospektiv: Bedingung und Resultat erzeugen sich wechselseitig, sodass das Frühere nur als nachträglich gesetzte Voraussetzung gilt.","refs":["CL_GB18_35:BSD-02","CL_GB18_36:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSD-04","text":"Erkenntnis verliert den Rang äußerer Vermittlung und wird zum Vollzug, in dem die Bestimmungen die Selbstbewegung des Gegenstandes artikulieren.","refs":["CL_GB18_34:XD-05","CL_GB18_36:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSD-05","text":"Das Subjekt ist weder Ursprung noch souveräner Träger, sondern die abgeleitete Stelle, an der Setzung, Voraussetzung und Rückkehr als ein Prozess lesbar werden.","refs":["CL_GB18_34:HSI-02","CL_GB18_36:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_09:RLE-01","text":"Die erste Schleife führt von äußerlicher Bestimmung über deren Selbstaufhebung zur immanenten Einheit und erzeugt aus jedem Rückgriff auf Fremdvermittlung einen erneuten Erklärungsausfall.","refs":["CL_GB18_33:RLE-01","CL_GB18_36:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RLE-02","text":"Negativität eskaliert von Selbstunverträglichkeit zur Reflexion und von dort zur Operation, die ihr eigenes Negatives erzeugt und zurücknimmt.","refs":["CL_GB18_34:RMD-03","CL_GB18_35:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RLE-03","text":"Die Voraussetzungsschleife erzeugt reflektierte Unmittelbarkeit, stellt sie als Anfang aus und führt sie durch Aufhebung in bestimmende Reflexion zurück.","refs":["CL_GB18_35:RLE-01","CL_GB18_36:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RLE-04","text":"Die Erscheinungsschleife macht das Gegenüber zur Selbstsetzung des Wesens und den Grund zur Operation, die nur in ihrer Erscheinung bestimmbar wird.","refs":["CL_GB18_34:RMD-06","CL_GB18_34:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RLE-05","text":"Der begriffliche Attraktor liegt in einer Selbstvermittlung, die jede erreichte Einheit erneut zur Externalisierung zwingt und dadurch bestimmende Reflexion über ihre eigene Schließung hinaustreibt.","refs":["CL_GB18_34:RLE-05","CL_GB18_36:GA-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_09:FGS-B01","text":"Unmittelbare Indifferenz + äußerliche quantitative Bestimmung → negative Faktorenrelation ohne immanenten Übergang.","refs":["CL_GB18_33:AS-03","CL_GB18_33:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B02","text":"Negative Faktorenrelation + qualitative Untrennbarkeit → Widerspruch der Indifferenz + Zusammenbruch äußerlicher Erklärung.","refs":["CL_GB18_33:GA-08","CL_GB18_33:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B03","text":"Widerspruch + negative Totalität → Selbstabstoßung → Wesen als Reflexion.","refs":["CL_GB18_34:AS-04","CL_GB18_34:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B04","text":"Reflexion + aufgehobene Unmittelbarkeit → Schein als eigenes Gegenüber + produktive Selbstdifferenzierung.","refs":["CL_GB18_35:GA-04","CL_GB18_35:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B05","text":"Setzen + erzeugte Voraussetzung + Aufhebung der Voraussetzung → bestimmende Reflexion.","refs":["CL_GB18_36:GA-03","CL_GB18_35:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B06","text":"Bestimmende Reflexion + internalisiertes Anderssein → Reflexionsbestimmung als stabilisierte, aber prekäre Negativität.","refs":["CL_GB18_36:GA-07","CL_GB18_36:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B07","text":"Reflexionsbestimmung → Grund als Vermittlungsoperation → Existenz und Erscheinung → Begriff als nicht abgeschlossener Externalisierungsattraktor.","refs":["CL_GB18_34:GA-07","CL_GB18_34:GA-09","CL_GB18_34:GA-10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_09:AFM-B01","text":"Abstrakte Bestimmungslosigkeit → passive Indifferenz → äußerlich aufgenommene quantitative Bestimmung.","refs":["CL_GB18_33:AS-02","CL_GB18_33:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:AFM-B02","text":"Äußerliche Bestimmung → untrennbare Faktoren → negative Gegenseitigkeit → Widerspruch und Erklärungsausfall.","refs":["CL_GB18_33:AS-04","CL_GB18_33:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:AFM-B03","text":"Widerspruch → negative Totalität → Selbstabstoßung → Reflexion des Wesens.","refs":["CL_GB18_34:AS-04","CL_GB18_34:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:AFM-B04","text":"Reflexion → Schein → reflektierte Unmittelbarkeit → erzeugte Voraussetzung → Aufhebung des Anfangsscheins.","refs":["CL_GB18_35:RMD-02","CL_GB18_35:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:AFM-B05","text":"Einheit von Setzen und Voraussetzen → bestimmende Reflexion → Reflexionsbestimmungen → Grund → Existenz und Erscheinung → begriffliche Externalisierung.","refs":["CL_GB18_36:GA-05","CL_GB18_34:GA-07","CL_GB18_34:GA-10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_09:MME-01","text":"Einheit und Identität werden von ursprünglichen Beständen zu Resultaten negierender Selbstvermittlung umkartiert.","refs":["CL_GB18_33:GA-01","CL_GB18_34:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MME-02","text":"Quantität wird von neutraler Vergleichsform zur Erscheinungsform qualitativer Negativität und schließlich zur reflexiven Selbstunterscheidung reklassifiziert.","refs":["CL_GB18_33:MME-01","CL_GB18_34:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MME-03","text":"Der Gegensatz von Wesen und Erscheinung bricht zusammen, weil Erscheinung nicht verhüllt, sondern die gesetzte Äußerlichkeit des Wesens vollzieht.","refs":["CL_GB18_35:GNX-01","CL_GB18_34:DBN-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MME-04","text":"Die Opposition von Gegenstand und Reflexion wird durch die Einsicht ersetzt, dass Gegebenheit eine erzeugte Form interner Selbstvermittlung ist.","refs":["CL_GB18_36:XD-01","CL_GB18_36:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MME-05","text":"Anfang und Grund werden von zeitlich oder ontologisch ersten Beständen zu retrospektiv erzeugten Effekten der Rückkehr umgezeichnet.","refs":["CL_GB18_34:CGD-05","CL_GB18_36:MME-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_09:ALT-B01","text":"Surface level — Indifferenz, quantitative Faktoren, Seyn, Wesen, Schein, Grund, Unmittelbarkeit und Reflexionsbestimmung bilden die sichtbaren Stationen einer einzigen Bewegungslogik.","refs":["CL_GB18_33:ALT-B01","CL_GB18_36:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:ALT-B02","text":"Structural level — Aufhebung, Negation der Negation, Setzen und Voraussetzen bilden eine rekursive Maschine zur Erzeugung und Rücknahme von Bestimmtheit.","refs":["CL_GB18_35:ALT-B02","CL_GB18_36:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:ALT-B03","text":"Metastrategic level — Erklärung und Lektüre werden auf die immanente Erzeugung von Übergängen umgestellt und behandeln jeden gegebenen Grund als noch unreflektierte Voraussetzung.","refs":["CL_GB18_33:ALT-B03","CL_GB18_35:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:ALT-B04","text":"Ontological / Temporal level — Realität besitzt keinen ersten ruhenden Grund; Identität besteht nur als fortgesetzte, retrospektive Rückkehr aus Anderssein.","refs":["CL_GB18_35:ALT-B04","CL_GB18_36:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie jeden äußeren Übergang und jeden scheinbaren Ausgangspunkt auf seine erzeugende Operation zurückführt.","refs":["CL_GB18_34:ALT-B05","CL_GB18_36:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_09:FL-01","text":"Die positive Genesis mannigfaltiger Bestimmtheit bleibt unterbestimmt, weil das System Gegebenheit erfolgreich negiert, ihre inhaltliche Erzeugung aber nicht vollständig ausdifferenziert.","refs":["CL_GB18_35:FL-02","CL_GB18_35:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FL-02","text":"Absolute Selbstvermittlung bleibt darauf angewiesen, ein Anderes als Voraussetzung einzuführen, obwohl sie dessen irreduzible Exteriorität ausschließen muss.","refs":["CL_GB18_35:FL-03","CL_GB18_36:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FL-03","text":"Reflexionsbestimmungen müssen zugleich wesentliche Selbständigkeiten und vollständig vermittelte Momente sein; ihre ontologische Eigenständigkeit bleibt deshalb konstitutiv zweideutig.","refs":["CL_GB18_36:BAS-06","CL_GB18_36:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FL-04","text":"Der Übergang von Reflexionsbestimmungen zu Grund, Existenz, Erscheinung und Begriff komprimiert Vermittlungen, deren positive Inhalte und äußere Form nicht vollständig entwickelt sind.","refs":["CL_GB18_36:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MP-01","text":"Der erste Mutationspunkt liegt im Widerspruch der Indifferenz, an dem passive Einheit zur negativen Totalität und zur Reflexion des Wesens umschlägt.","refs":["CL_GB18_34:MP-01","CL_GB18_34:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MP-02","text":"Der zweite Mutationspunkt verwandelt Negativität von Selbstunverträglichkeit in produktive Reflexion und Selbstdifferenzierung.","refs":["CL_GB18_34:MP-02","CL_GB18_35:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MP-03","text":"Der dritte Mutationspunkt requalifiziert Unmittelbarkeit vom ontologischen Anfang zum gesetzten, vorausgesetzten und schließlich wesentlichen Resultat der Reflexion.","refs":["CL_GB18_35:GA-02","CL_GB18_36:MP-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_09:HSI-01","text":"Realität erscheint als selbstnegative Maschine erzeugter Gegenüber, die keinen äußeren Stoff verarbeitet, sondern ihre Differenzen und Grundlagen intern produziert.","refs":["CL_GB18_34:HSI-01","CL_GB18_36:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:HSI-02","text":"Das Subjekt ist keine vorausgesetzte oder souveräne Instanz, sondern eine abgeleitete Vollzugsstelle der Bewegung von Setzen, Aufheben und Voraussetzen.","refs":["CL_GB18_34:HSI-02","CL_GB18_36:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:HSI-03","text":"Zeit ist eine nicht-chronologische Rückkehrstruktur, in der Bestimmung erst durch Rückkehr aus ihrem Anderssein und durch nachträgliche Erzeugung ihrer Voraussetzung entsteht.","refs":["CL_GB18_34:HSI-03","CL_GB18_36:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:HSI-04","text":"Navigation bleibt möglich als Rekonstruktion der Operationen, durch die scheinbar gegebene Gegenstände, Gründe und Übergänge gesetzt und wieder entzogen werden.","refs":["CL_GB18_34:HSI-04","CL_GB18_35:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_09:MRT-B01","text":"Die Axiome reichen aus, um die Meta-Cluster-Bewegung von äußerlicher Indifferenz über negative Totalität und Schein bis zur bestimmenden Reflexion zu rekonstruieren.","refs":["CL_GB18_34:MRT-B01","CL_GB18_36:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MRT-B02","text":"Unterbestimmt bleiben die positive Genesis mannigfaltiger Inhalte sowie die konkrete Ausarbeitung von Existenz, Erscheinung und Begriff.","refs":["CL_GB18_34:MRT-B02","CL_GB18_35:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MRT-B03","text":"Die Rekonstruktion ist kohärent, sofern vorausgesetzte und resultierende Einheit sowie notwendige und aufzuhebende Unmittelbarkeit als produktive Doppelbestimmungen erhalten bleiben.","refs":["CL_GB18_34:MRT-B04","CL_GB18_36:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MRT-B04","text":"Der irreduzible Rest liegt in der rekursiven Sequenzierung selbst: Die Übergänge sind begrifflich tragfähig, hängen aber an komprimierten Umschlägen zwischen äußerer Form, absoluter Reflexion und positiver Bestimmtheit.","refs":["CL_GB18_34:AS-08","CL_GB18_36:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123826699475Z_f1a9bffc","language_code":"en","language_name":"English","title":"Gb18 L1 09","source_sha256":"684db30c445f913af388a7a66ef2bf3f272d6df92d36dfdb52d0e8836a4c7054","sha256":"fc0e8b333ac762581ea77ce796149ea3093dfdf1950b2a839f0d42562ffbd940","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:38:26.700436+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_09:BAS-01","text":"The system resolves the problem of how unity and immediacy can appear as the beginning, although their differences and their status as beginning are only produced through mediation.","refs":["CL_GB18_33:AS-01","CL_GB18_36:BAS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-02","text":"The initially presupposed indifference is transferred from a passive substrate into the result of a self-movement that does not receive its negation externally.","refs":["CL_GB18_33:AS-02","CL_GB18_34:AS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-03","text":"The critique of externally quantified factors functions as a stress test of whether an explanation can actually produce the qualitative transition of its determinations.","refs":["CL_GB18_33:AS-04","CL_GB18_33:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-04","text":"The contradiction of indifference is not a terminal defect, but the turning point at which negative totality mutates into the reflection of essence.","refs":["CL_GB18_33:GA-08","CL_GB18_34:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-05","text":"The sublated Seyn is neither annihilated nor preserved as an independent externality, but returns as timelessly past and apparent immediacy within essence.","refs":["CL_GB18_34:RMD-07","CL_GB18_35:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-06","text":"Reflection produces its presupposition, presents it as something found, and takes it back into itself as a function of the same movement.","refs":["CL_GB18_35:RMD-05","CL_GB18_36:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-07","text":"Determining reflection arises when positing and external reflection sublate their separation and comprehend the self-posited ground as their own result.","refs":["CL_GB18_36:GA-05","CL_GB18_35:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BAS-08","text":"The overall movement is recursive, spiral-shaped, and retrospective; its closure remains unstable because the produced determinations simultaneously appear independent and are completely mediated.","refs":["CL_GB18_34:AS-08","CL_GB18_36:BAS-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_09:GA-01","text":"[Persistent] Concrete unity exists exclusively as the self-mediation of a difference that is negated, preserved, and relationally determined in unity.","refs":["CL_GB18_33:GA-01","CL_GB18_35:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-02","text":"[Mutating] Immediacy mutates from the seemingly first positive, through the sublated remainder of Seyn, into the posited and sublatable presupposition of reflection.","refs":["CL_GB18_35:GA-02","CL_GB18_36:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-03","text":"[Persistent] External composition and quantitative independence cannot explain qualitative transitions, because they presuppose their relational production.","refs":["CL_GB18_33:CGD-04","CL_GB18_34:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-04","text":"[Mutating] Negativity mutates from the destructive self-incompatibility of indifference into productive reflection, which produces determinacy from its own self-differentiation.","refs":["CL_GB18_34:GA-02","CL_GB18_35:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-05","text":"[Persistent] Difference has no independent external position, but is determined as unity's immanent self-distinction and its own sublated negation.","refs":["CL_GB18_34:GA-04","CL_GB18_36:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-06","text":"[Emergent] Appearance is the necessary form in which essence exposes its sublated immediacy as its own counterpart.","refs":["CL_GB18_34:GA-06","CL_GB18_35:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-07","text":"[Emergent] Positing and presupposing are countervailing functions of a single movement of reflection, in which the presupposed returns as sublated positedness.","refs":["CL_GB18_36:GA-03","CL_GB18_36:BAS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-08","text":"[Mutating] Ground loses the status of a hidden substrate and becomes the operation of reflection through which essence mediates itself into existence and appearance.","refs":["CL_GB18_34:GA-07","CL_GB18_34:DBN-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-09","text":"[Emergent] Determinations of reflection subsist only as negativity reflected into itself; their stability is therefore identical with their mediated instability.","refs":["CL_GB18_36:GA-07","CL_GB18_36:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-10","text":"[Terminal] Determining reflection closes the movement by sublating its self-posited presupposition as a result and thereby expressly producing its own ground.","refs":["CL_GB18_35:AS-05","CL_GB18_35:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GA-11","text":"[Attractor] Immanent explanation requires that every transition and every presupposed ground be shown to be the product of the movement that it is supposed to enable.","refs":["CL_GB18_33:GA-06","CL_GB18_35:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_09:RMD-01","text":"Indifference initially retains the function of presupposed unity, but disappears after its recoding into contradiction and leaves reflection behind as its higher-level form of movement.","refs":["CL_GB18_33:RMD-02","CL_GB18_34:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-02","text":"Quantity migrates from external determinability and comparison of factors to the negative diagnosis of a difference that subsists only as a reflectively posited relation.","refs":["CL_GB18_33:RMD-03","CL_GB18_34:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-03","text":"Negation shifts from the self-sublation of contradictory unity to productive reflection, without completely losing its destructive function.","refs":["CL_GB18_33:RMD-04","CL_GB18_34:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-04","text":"Immediacy remains terminologically persistent, but mutates from the remainder of sublation through reflected presupposition into essential immediacy as the result of complete mediation.","refs":["CL_GB18_35:RMD-01","CL_GB18_36:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-05","text":"Otherness is absorbed from an external counterposition, through internal negativity, into the reflection-determination's own sublated negation.","refs":["CL_GB18_35:RMD-03","CL_GB18_36:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-06","text":"The counterpart mutates into appearance and loses the status of an external residual phenomenon, without forfeiting its operative opposition to essence.","refs":["CL_GB18_34:RMD-06","CL_GB18_35:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RMD-07","text":"Ground mutates from the expected foundation to the produced presupposition and finally to the operation of mediation, whose subsistence lies only in its externalization.","refs":["CL_GB18_34:MP-04","CL_GB18_35:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_09:CGD-01","text":"Analysis of forces and reflective judgment remain local cases; at the current level, they scale only as tests of external explanation and retrospective determination.","refs":["CL_GB18_36:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:CGD-02","text":"Measure and the quantitative relation of factors remain local diagnostic figures; globally, they bear only the negative demand for an immanently mediated unity of qualitative difference.","refs":["CL_GB18_33:GA-09","CL_GB18_33:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:CGD-03","text":"The contradiction of individual presupposed unities scales into the organizational principle according to which every ground must produce its own mediation and take it back as a result.","refs":["CL_GB18_34:CGD-02","CL_GB18_36:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:CGD-04","text":"Existence, appearance, and concept mark necessary externalizations of reflection, but at this level remain connecting structures underdetermined in their positive contents.","refs":["CL_GB18_34:GA-09","CL_GB18_34:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_09:GNX-01","text":"Excluded is every passive substrate that bears determinations without itself being mediated through their movement.","refs":["CL_GB18_33:GNX-01","CL_GB18_35:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GNX-02","text":"Excluded are independent quantitative factors and positive grounds of being that are supposed to secure qualitative determinacy from outside.","refs":["CL_GB18_33:GNX-02","CL_GB18_36:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GNX-03","text":"Excluded is a reflection that retrospectively ascribes determinations to a finished object and merely presupposes its transitions.","refs":["CL_GB18_34:GA-08","CL_GB18_36:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GNX-04","text":"Excluded are separate domains of essence and appearance, as well as an other-being that persists outside reflective self-mediation.","refs":["CL_GB18_35:GNX-01","CL_GB18_36:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:GNX-05","text":"Excluded is a linear order in which beginning, mediation, and result count as temporally or externally successive states.","refs":["CL_GB18_34:GNX-04","CL_GB18_36:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_09:DBN-01","text":"For the system to subsist, every first ground must be untrue and every unposited beginning impossible.","refs":["CL_GB18_35:DBN-01","CL_GB18_36:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:DBN-02","text":"Determinacy must not appear as immediately given content, but must emerge from positing, presupposition, and sublation.","refs":["CL_GB18_35:GNX-03","CL_GB18_35:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:DBN-03","text":"Negation must not be a mere loss; it must produce self-relation and preserve nullity as a moment of persisting determination.","refs":["CL_GB18_34:DBN-03","CL_GB18_35:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:DBN-04","text":"Pure immanence must not erase otherness without remainder; it must produce externality as a necessary form of difference and simultaneously internalize it.","refs":["CL_GB18_36:BSA-02","CL_GB18_36:CGD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_09:BSA-01","text":"The deepest excluded possibility is a positive externality that resists reflection without already being the form of its own negativity.","refs":["CL_GB18_35:BSA-01","CL_GB18_36:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSA-02","text":"Unavailable are original identity and an unposited beginning, because both would anticipate the return from negativity.","refs":["CL_GB18_34:BSA-02","CL_GB18_36:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSA-03","text":"Ontologically inadmissible is a determination whose identity could subsist without sublation of its own positedness and without return from other-being.","refs":["CL_GB18_36:BSA-03","CL_GB18_36:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_09:XD-01","text":"The explanatory failure of external forces becomes the positive condition of a logic of reflection in which movement is explicable only as the immanent truth of determinations.","refs":["MC_GB18_L1_09:GA-03","MC_GB18_L1_09:GA-04","CL_GB18_33:AS-05","CL_GB18_36:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_09:XD-02","text":"The contradiction of indifference is not merely its refutation, but produces the negative totality from which reflection emerges as a new form of the same unity.","refs":["MC_GB18_L1_09:GA-01","MC_GB18_L1_09:GA-04","CL_GB18_33:GA-08","CL_GB18_34:AS-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_09:XD-03","text":"Appearance and givenness are homologous modes of produced objectivity: both present a posited immediacy as a seemingly antecedent counterpart.","refs":["MC_GB18_L1_09:GA-02","MC_GB18_L1_09:GA-06","MC_GB18_L1_09:GA-07","CL_GB18_35:GA-04","CL_GB18_36:XD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_09:XD-04","text":"The timeless past of Seyn and the retrospective production of the beginning form the same logical time-structure, in which priority is determined only through return.","refs":["MC_GB18_L1_09:GA-02","MC_GB18_L1_09:GA-07","CL_GB18_34:CGD-05","CL_GB18_36:XD-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_09:XD-05","text":"The independence of determinations of reflection is constitutively precarious, because precisely their fixation internalizes the mediation from which they present themselves as independent.","refs":["MC_GB18_L1_09:GA-09","MC_GB18_L1_09:GA-10","CL_GB18_36:BAS-06","CL_GB18_36:XD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_09:XD-06","text":"The failure of independent quantitative difference does not compel a return to undifferentiated quality, but rather the recoding of difference into reflective self-distinction.","refs":["MC_GB18_L1_09:GA-03","MC_GB18_L1_09:GA-05","CL_GB18_33:GNX-02","CL_GB18_34:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_09:BSD-01","text":"Reality becomes a self-negative machine that produces its apparent materials, counterparts, and grounds as stages of its own self-differentiation.","refs":["CL_GB18_34:HSI-01","CL_GB18_35:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSD-02","text":"Causality no longer designates an external effect of independent factors, but the immanent self-transformation of essential differences.","refs":["CL_GB18_33:BSD-01","CL_GB18_36:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSD-03","text":"Temporality becomes retrospective: condition and result produce one another reciprocally, so that the earlier counts only as a retrospectively posited presupposition.","refs":["CL_GB18_35:BSD-02","CL_GB18_36:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSD-04","text":"Cognition loses the rank of external mediation and becomes the enactment in which determinations articulate the self-movement of the object.","refs":["CL_GB18_34:XD-05","CL_GB18_36:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:BSD-05","text":"The subject is neither origin nor sovereign bearer, but the derived locus at which positing, presupposition, and return become legible as one process.","refs":["CL_GB18_34:HSI-02","CL_GB18_36:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_09:RLE-01","text":"The first loop leads from external determination through its self-sublation to immanent unity and produces a renewed explanatory failure from every recourse to external mediation.","refs":["CL_GB18_33:RLE-01","CL_GB18_36:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RLE-02","text":"Negativity escalates from self-incompatibility to reflection, and from there to the operation that produces and takes back its own negative.","refs":["CL_GB18_34:RMD-03","CL_GB18_35:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RLE-03","text":"The presupposition loop produces reflected immediacy, presents it as beginning, and returns it through sublation to determining reflection.","refs":["CL_GB18_35:RLE-01","CL_GB18_36:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RLE-04","text":"The appearance loop makes the counterpart into the self-positing of essence and ground into the operation that becomes determinable only in its appearance.","refs":["CL_GB18_34:RMD-06","CL_GB18_34:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:RLE-05","text":"The conceptual attractor lies in a self-mediation that compels every attained unity anew toward externalization and thereby drives determining reflection beyond its own closure.","refs":["CL_GB18_34:RLE-05","CL_GB18_36:GA-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_09:FGS-B01","text":"Immediate indifference + external quantitative determination → negative relation of factors without immanent transition.","refs":["CL_GB18_33:AS-03","CL_GB18_33:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B02","text":"Negative relation of factors + qualitative inseparability → contradiction of indifference + collapse of external explanation.","refs":["CL_GB18_33:GA-08","CL_GB18_33:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B03","text":"Contradiction + negative totality → self-repulsion → essence as reflection.","refs":["CL_GB18_34:AS-04","CL_GB18_34:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B04","text":"Reflection + sublated immediacy → appearance as its own counterpart + productive self-differentiation.","refs":["CL_GB18_35:GA-04","CL_GB18_35:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B05","text":"Positing + produced presupposition + sublation of the presupposition → determining reflection.","refs":["CL_GB18_36:GA-03","CL_GB18_35:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B06","text":"Determining reflection + internalized otherness → determination of reflection as stabilized, yet precarious, negativity.","refs":["CL_GB18_36:GA-07","CL_GB18_36:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FGS-B07","text":"Determination of reflection → ground as operation of mediation → existence and appearance → concept as uncompleted attractor of externalization.","refs":["CL_GB18_34:GA-07","CL_GB18_34:GA-09","CL_GB18_34:GA-10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_09:AFM-B01","text":"Abstract indeterminacy → passive indifference → externally received quantitative determination.","refs":["CL_GB18_33:AS-02","CL_GB18_33:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:AFM-B02","text":"External determination → inseparable factors → negative reciprocity → contradiction and explanatory failure.","refs":["CL_GB18_33:AS-04","CL_GB18_33:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:AFM-B03","text":"Contradiction → negative totality → self-repulsion → reflection of essence.","refs":["CL_GB18_34:AS-04","CL_GB18_34:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:AFM-B04","text":"Reflection → appearance → reflected immediacy → produced presupposition → sublation of the appearance of beginning.","refs":["CL_GB18_35:RMD-02","CL_GB18_35:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:AFM-B05","text":"Unity of positing and presupposing → determining reflection → determinations of reflection → ground → existence and appearance → conceptual externalization.","refs":["CL_GB18_36:GA-05","CL_GB18_34:GA-07","CL_GB18_34:GA-10"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_09:MME-01","text":"Unity and identity are remapped from original holdings into results of negating self-mediation.","refs":["CL_GB18_33:GA-01","CL_GB18_34:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MME-02","text":"Quantity is reclassified from a neutral form of comparison into the form of appearance of qualitative negativity and finally into reflective self-distinction.","refs":["CL_GB18_33:MME-01","CL_GB18_34:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MME-03","text":"The opposition of essence and appearance collapses, because appearance does not conceal but enacts the posited externality of essence.","refs":["CL_GB18_35:GNX-01","CL_GB18_34:DBN-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MME-04","text":"The opposition of object and reflection is replaced by the insight that givenness is a produced form of internal self-mediation.","refs":["CL_GB18_36:XD-01","CL_GB18_36:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MME-05","text":"Beginning and ground are redrawn from temporally or ontologically first holdings into retrospectively produced effects of return.","refs":["CL_GB18_34:CGD-05","CL_GB18_36:MME-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_09:ALT-B01","text":"Surface level — Indifference, quantitative factors, Seyn, essence, appearance, ground, immediacy, and determination of reflection form the visible stations of a single logic of movement.","refs":["CL_GB18_33:ALT-B01","CL_GB18_36:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:ALT-B02","text":"Structural level — Sublation, negation of negation, positing, and presupposing form a recursive machine for producing and taking back determinacy.","refs":["CL_GB18_35:ALT-B02","CL_GB18_36:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:ALT-B03","text":"Metastrategic level — Explanation and reading are redirected toward the immanent production of transitions and treat every given ground as a presupposition not yet reflected upon.","refs":["CL_GB18_33:ALT-B03","CL_GB18_35:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:ALT-B04","text":"Ontological / Temporal level — Reality has no first resting ground; identity exists only as continued, retrospective return from other-being.","refs":["CL_GB18_35:ALT-B04","CL_GB18_36:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:ALT-B05","text":"Methodological / Performative level — The exposition enacts its thesis by tracing every external transition and every apparent point of departure back to its producing operation.","refs":["CL_GB18_34:ALT-B05","CL_GB18_36:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_09:FL-01","text":"The positive genesis of manifold determinacy remains underdetermined, because the system successfully negates givenness but does not fully differentiate its production of content.","refs":["CL_GB18_35:FL-02","CL_GB18_35:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FL-02","text":"Absolute self-mediation remains dependent on introducing an other as presupposition, although it must exclude its irreducible exteriority.","refs":["CL_GB18_35:FL-03","CL_GB18_36:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FL-03","text":"Determinations of reflection must be simultaneously essential independences and completely mediated moments; their ontological self-subsistence therefore remains constitutively ambiguous.","refs":["CL_GB18_36:BAS-06","CL_GB18_36:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:FL-04","text":"The transition from determinations of reflection to ground, existence, appearance, and concept compresses mediations whose positive contents and external form are not fully developed.","refs":["CL_GB18_36:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MP-01","text":"The first mutation point lies in the contradiction of indifference, at which passive unity turns into negative totality and into the reflection of essence.","refs":["CL_GB18_34:MP-01","CL_GB18_34:AS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MP-02","text":"The second mutation point transforms negativity from self-incompatibility into productive reflection and self-differentiation.","refs":["CL_GB18_34:MP-02","CL_GB18_35:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MP-03","text":"The third mutation point requalifies immediacy from ontological beginning into the posited, presupposed, and finally essential result of reflection.","refs":["CL_GB18_35:GA-02","CL_GB18_36:MP-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_09:HSI-01","text":"Reality appears as a self-negative machine of produced counterparts that processes no external material, but internally produces its differences and grounds.","refs":["CL_GB18_34:HSI-01","CL_GB18_36:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:HSI-02","text":"The subject is not a presupposed or sovereign instance, but a derived locus of enactment of the movement of positing, sublating, and presupposing.","refs":["CL_GB18_34:HSI-02","CL_GB18_36:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:HSI-03","text":"Time is a non-chronological structure of return, in which determination arises only through return from its other-being and through the retrospective production of its presupposition.","refs":["CL_GB18_34:HSI-03","CL_GB18_36:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:HSI-04","text":"Navigation remains possible as a reconstruction of the operations through which seemingly given objects, grounds, and transitions are posited and withdrawn again.","refs":["CL_GB18_34:HSI-04","CL_GB18_35:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_09:MRT-B01","text":"The axioms suffice to reconstruct the meta-cluster movement from external indifference through negative totality and appearance to determining reflection.","refs":["CL_GB18_34:MRT-B01","CL_GB18_36:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MRT-B02","text":"The positive genesis of manifold contents, as well as the concrete elaboration of existence, appearance, and concept, remain underdetermined.","refs":["CL_GB18_34:MRT-B02","CL_GB18_35:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MRT-B03","text":"The reconstruction is coherent insofar as presupposed and resultant unity, as well as necessary and sublatable immediacy, remain preserved as productive double determinations.","refs":["CL_GB18_34:MRT-B04","CL_GB18_36:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_09:MRT-B04","text":"The irreducible remainder lies in the recursive sequencing itself: the transitions are conceptually viable, but depend on compressed turns between external form, absolute reflection, and positive determinacy.","refs":["CL_GB18_34:AS-08","CL_GB18_36:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_09@R001","source_variant_id":"canonical:MC_GB18_L1_09:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 09","context":"Chapters 97–108 · A. Die absolute Indifferenz. · B. Die Indifferenz als umgekehrtes Verhältniß ihrer Faktoren. · Anmerkung. · C. Übergang in das Wesen. · Zweites Buch Das Wesen. · Erster Abschnitt. Das Wesen als Reflexion in ihm selbst. · A. Das Wesentliche und das Unwesentliche. · B. Der Schein. · C. Die Reflexion. · 1. Die setzende Reflexion. · 2. Die äußere Reflexion. · 3. Bestimmende Reflexion."},"title_language_code":"en"},{"id":"MC_GB18_L1_10","layer":"MC","title":"Gb18 L1 10","order":10,"parents":["CL_GB18_37","CL_GB18_38","CL_GB18_39","CL_GB18_40"],"revision":"MC_GB18_L1_10@R001","sha256":"ee2a7ea9dcc49f946baa96e7b85999760112ff771d8d419524fe5d36edbd0bf7","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_10:BAS-01","text":"Das System bearbeitet die Unmöglichkeit, Identität als ursprüngliche Selbstgleichheit und Differenz als nachträglich hinzutretende Relation zu begründen.","refs":["CL_GB18_37:AS-B01","CL_GB18_38:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-02","text":"Seine globale These lautet, dass Bestimmtheit ausschließlich als negative Selbstbeziehung besteht und weder einem positiven Substrat noch einer äußerlichen Verneinung entspringt.","refs":["CL_GB18_38:GA-02","CL_GB18_39:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-03","text":"Die Bewegung führt rekursiv von aufgehobener Unmittelbarkeit über Identität, Unterschied, Verschiedenheit und Gegensatz zu einem Grund, der die durchlaufene Negativität bewahrt.","refs":["CL_GB18_37:AS-B04","CL_GB18_39:AS-04","CL_GB18_40:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-04","text":"Das Argument verfährt als immanente Kritik: Gesetz, Satz, Vergleich und Ausschluss werden daran gemessen, ob ihre Vollzüge das von ihnen Abgewiesene selbst erzeugen.","refs":["CL_GB18_37:AS-B03","CL_GB18_40:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-05","text":"Äußerlichkeit wird nicht als unabhängiger Gegenbereich verworfen, sondern als notwendige Phase rekonstruiert, in der immanente Differenz sich als Vergleich, Zeichenrelation und Opposition exponiert.","refs":["CL_GB18_38:AS-06","CL_GB18_40:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-06","text":"Die anfängliche Symmetrie der Gegenbestimmungen schlägt in eine Asymmetrie um, weil nur Negativität Bestimmung erzeugt und Positivität als Resultat ihrer Selbstnegation hervortritt.","refs":["CL_GB18_39:GA-08","CL_GB18_40:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-07","text":"Widerspruch bezeichnet deshalb keinen Randfehler, sondern den operativen Übergang, in dem isolierte Selbstständigkeit zerfällt und ihre immanente Einheit erzeugt.","refs":["CL_GB18_37:GA-08","CL_GB18_40:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-08","text":"Die Schließung ist rückwirkend und nicht ruhend: Der Grund klassifiziert die vorherigen Bestimmungen als seine gesetzten Momente, ohne die negative Bewegung endgültig stillzustellen.","refs":["CL_GB18_40:BSD-03","CL_GB18_40:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_10:GA-01","text":"[Persistent] Negativität ist die immanente Selbstbeziehung, durch die Identität, Unterschied und Bestimmtheit erzeugt werden.","refs":["CL_GB18_37:GA-04","CL_GB18_38:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-02","text":"[Mutating] Identität mutiert vom Ganzen der Reflexion und der abstrakten Selbstgleichheit zu einem gesetzten Moment, das nur innerhalb seiner eigenen Differenz besteht.","refs":["CL_GB18_37:GA-03","CL_GB18_38:RMD-01","CL_GB18_40:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-03","text":"[Persistent] Keine Bestimmung besitzt relationsexterne Selbstständigkeit; ihr Anderes ist konstitutive Bedingung und wird gerade durch seinen Ausschluss gesetzt.","refs":["CL_GB18_39:GA-04","CL_GB18_40:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-04","text":"[Attractor] Die Selbstnegation der Negativität erzeugt Unterschied, Rückkehr, Positivität und schließlich eine Einheit, die ihre negative Genese erhält.","refs":["CL_GB18_37:GA-04","CL_GB18_39:RLE-05","CL_GB18_40:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-05","text":"[Mutating] Äußere Reflexion erscheint nacheinander als Denkgesetz, Vergleich, Zeichenzuschreibung und formale Alternative, wird aber jeweils in die immanente Relation zurückgenommen, die sie veräußerlicht.","refs":["CL_GB18_37:GA-07","CL_GB18_38:RMD-04","CL_GB18_40:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-06","text":"[Emergent] Widerspruch ist der Übergangsoperator, durch den isolierte Bestimmungen ihre Selbstständigkeit verlieren und als Momente des Grundes rekonstruiert werden.","refs":["CL_GB18_37:GA-08","CL_GB18_40:GA-04","CL_GB18_40:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-07","text":"[Mutating] Positivität verliert den Status eines Ursprungs und wird zum Resultat bestimmender Negation, während das Negative die asymmetrische generative Funktion übernimmt.","refs":["CL_GB18_39:RMD-06","CL_GB18_39:BSA-02","CL_GB18_40:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-08","text":"[Emergent] Der Grund ist die rückwirkende Reflexionseinheit, die den anfänglichen Gegensatz nachträglich als ihr eigenes gesetztes Moment ausweist.","refs":["CL_GB18_40:GA-07","CL_GB18_40:BSD-03","CL_GB18_40:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-09","text":"[Persistent] Erkenntnis ist nur als immanente Rekonstruktion der negativen Bewegung möglich; ein äußerer Beobachtungsstandpunkt wiederholt die zu überwindende Trennung.","refs":["CL_GB18_38:ALT-B03","CL_GB18_40:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-10","text":"[Terminal] Die erreichte Einheit ist keine widerspruchsfreie Ruhe, sondern die positive Form, in der aufgehobene Negativität als innere Bestimmung fortbesteht.","refs":["CL_GB18_40:AS-08","CL_GB18_40:GA-08","CL_GB18_40:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_10:RMD-01","text":"Identität kehrt funktional verändert wieder: von abstrakter Selbstgleichheit über selbstunterscheidende Reflexion bis zur gesetzten Identität des Grundes.","refs":["CL_GB18_37:RMD-02","CL_GB18_38:RMD-01","CL_GB18_40:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-02","text":"Unterschied eskaliert von gleichgültiger Verschiedenheit zum absoluten Selbstunterschied, externalisiert sich erneut und verdichtet sich schließlich zur inneren Opposition.","refs":["CL_GB18_37:RMD-03","CL_GB18_38:RMD-02","CL_GB18_39:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-03","text":"Negativität mutiert von implizitem Gehalt der Identität zur Selbstaufhebung äußerlicher Vergleichsformen und schließlich zur positiven Struktur selbstbezüglicher Bestimmtheit.","refs":["CL_GB18_38:RMD-03","CL_GB18_39:RMD-06","CL_GB18_40:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-04","text":"Äußere Reflexion wandert durch Satzform, Vergleich und formale Ausschließung; ihre scheinbare Fremdheit wird jeweils als vom Gegenstand selbst hervorgebrachte Vermittlungsphase absorbiert.","refs":["CL_GB18_37:RMD-04","CL_GB18_39:RMD-03","CL_GB18_40:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-05","text":"Positives und Negatives beginnen als austauschbare Zuschreibungen, verlieren diese Symmetrie und kehren als asymmetrische Funktionen von bestimmender Negation und vermittelter Positivität wieder.","refs":["CL_GB18_39:RMD-04","CL_GB18_39:DBN-04","CL_GB18_40:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-06","text":"Das Dritte mutiert vom vermeintlich zusätzlichen oder neutralen Term zur inneren Einheit der Opposition und wird schließlich als Grund bestimmt.","refs":["CL_GB18_40:RMD-04","CL_GB18_40:MP-03","CL_GB18_40:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-07","text":"Widerspruch wird von einer zu vermeidenden Unvereinbarkeit zur Übergangskraft umcodiert, die Ausschließung, Selbstaufhebung und positive Einheit generiert.","refs":["CL_GB18_37:GA-08","CL_GB18_39:MRT-B04","CL_GB18_40:GA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_10:CGD-01","text":"Satzanalysen, arithmetische Vorzeichen und exemplarische Gegenpaare bleiben lokale Diagnoseflächen; auf der aktuellen Ebene gelten sie nur als verschiedene Vollzugsformen derselben negativen Reflexion.","refs":["CL_GB18_38:CGD-01","CL_GB18_39:AS-08","CL_GB18_40:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:CGD-02","text":"Die Kritik einzelner Denkgesetze skaliert zur allgemeinen These, dass jede äußerlich fixierte Bestimmung ihre verdeckte relationale Erzeugungsstruktur unterschlägt.","refs":["CL_GB18_37:CGD-02","CL_GB18_38:CGD-04","CL_GB18_40:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:CGD-03","text":"Die verschiedenen Bedeutungen von Null und Vorzeichen bleiben lokale Operationsunterscheidungen; nach oben skaliert die Regel, dass Symbolik ihre Bestimmtheit nur aus der qualitativen Relation empfängt.","refs":["CL_GB18_39:CGD-03","CL_GB18_39:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:CGD-04","text":"Die einzelne Opposition wird zur globalen Generationsregel, sobald jede Seite ihr Anderes als eigene Bedingung enthält und jede Alternative ihre gemeinsame Bezugseinheit hervorbringt.","refs":["CL_GB18_39:CGD-04","CL_GB18_40:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:CGD-05","text":"Der Grund gehört ausschließlich zur aktuellen Syntheseebene: Er vereinigt die zuvor lokalen Mechanismen von Identität, Differenz, Vergleich, Opposition, Ausschluss und Widerspruch.","refs":["CL_GB18_40:GA-07","CL_GB18_40:MME-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_10:GNX-01","text":"Ausgeschlossen ist eine Identität, die vor ihrer Differenz als reine Selbstgleichheit bestehen und ihre Negativität äußerlich halten könnte.","refs":["CL_GB18_37:GNX-01","CL_GB18_38:GNX-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:GNX-02","text":"Ausgeschlossen ist ein äußerer Erkenntnis- oder Vergleichsstandpunkt, der Relationen ordnet, ohne selbst in deren negative Bewegung einzugehen.","refs":["CL_GB18_37:GNX-02","CL_GB18_38:GNX-04","CL_GB18_40:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:GNX-03","text":"Ausgeschlossen ist eine Logik der Widerspruchsvermeidung, welche die innere Einheit entgegengesetzter Bestimmungen durch Perspektiventrennung stillstellt.","refs":["CL_GB18_37:GNX-03","CL_GB18_39:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:GNX-04","text":"Ausgeschlossen sind die vollständige Symmetrie von Positivem und Negativem sowie ein absolut erstes Positives vor negativer Vermittlung.","refs":["CL_GB18_39:DBN-04","CL_GB18_40:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:GNX-05","text":"Ausgeschlossen ist eine Aufhebung, die Beziehung in Nullität vernichtet oder die Bewegung in einem endgültigen Ruhezustand beendet.","refs":["CL_GB18_40:GNX-05","CL_GB18_40:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_10:DBN-01","text":"Falsch sein muss ein Substanzmodell, in dem vollständig selbstständige Identitäten vor ihren Beziehungen bereits bestimmt vorliegen.","refs":["CL_GB18_39:DBN-01","CL_GB18_40:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:DBN-02","text":"Falsch sein muss, dass Denken durch ein beziehungsfreies Gesetz begründet werden kann, dessen allgemeine Form seine eigene Veräußerlichung nicht reflektiert.","refs":["CL_GB18_38:DBN-01","CL_GB18_37:GA-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:DBN-03","text":"Falsch sein muss, dass ein formaler Kalkül oder eine Ausschlussregel ihre qualitative Operationsweise aus bloßen Zeichen ableiten und ihre gemeinsame Reflexionsgrundlage verbergen kann.","refs":["CL_GB18_39:DBN-03","CL_GB18_40:GA-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:DBN-04","text":"Falsch sein muss die Verfügbarkeit eines neutralen Dritten oder äußeren Grundes, der Opposition vermittelt, ohne selbst in ihr bestimmt zu werden.","refs":["CL_GB18_38:BSA-02","CL_GB18_40:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_10:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist reine Selbstgegenwart: eine Positivität, die weder innere Negation noch Selbstunterschied benötigt.","refs":["CL_GB18_38:BSA-01","CL_GB18_40:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:BSA-02","text":"Nicht verfügbar ist ein ontologisches Außen der Reflexion, aus dem Identität und Unterschied ihre Einheit empfangen könnten.","refs":["CL_GB18_37:BSA-02","CL_GB18_38:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:BSA-03","text":"Das System organisiert sich um die Abwesenheit eines neutralen Endpunkts, an dem Vermittlung, Negativität und Rückkehr endgültig erlöschen könnten.","refs":["CL_GB18_39:BSA-03","CL_GB18_40:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_10:XD-01","text":"Weil Identität ihr Nichtsein selbst erzeugt und Opposition durch Ausschluss das Andere setzt, ist Selbstdifferenzierung die allgemeine Form jeder Bestimmung.","refs":["MC_GB18_L1_10:GA-01","MC_GB18_L1_10:GA-02","MC_GB18_L1_10:GA-03","CL_GB18_37:GA-04","CL_GB18_38:GA-04","CL_GB18_40:GA-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_10:XD-02","text":"Denkgesetz, Vergleich und formale Alternative bilden keine unabhängigen Fehlertypen, sondern aufeinanderfolgende Morphologien äußerer Reflexion, die ihre immanente Bezugseinheit voraussetzen.","refs":["MC_GB18_L1_10:GA-05","MC_GB18_L1_10:GA-09","CL_GB18_37:GA-07","CL_GB18_38:GA-07","CL_GB18_40:GA-06"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_10:XD-03","text":"Die asymmetrische Generativität des Negativen und die Produktivität des Widerspruchs ergeben zusammen, dass positive Einheit nur als erhaltene Form vollzogener Selbstnegation auftreten kann.","refs":["MC_GB18_L1_10:GA-04","MC_GB18_L1_10:GA-06","MC_GB18_L1_10:GA-07","MC_GB18_L1_10:GA-10","CL_GB18_39:RMD-06","CL_GB18_40:GA-04","CL_GB18_40:GA-08"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_10:XD-04","text":"Die logische Zeit der Bestimmung ist rückwirkend: Erst die erreichte Reflexionseinheit macht den vermeintlichen Anfang als abhängiges Moment seiner eigenen Bewegung lesbar.","refs":["MC_GB18_L1_10:GA-08","MC_GB18_L1_10:GA-10","CL_GB18_37:HSI-03","CL_GB18_38:ALT-B04","CL_GB18_40:BSD-03"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_10:XD-05","text":"Die Aufhebung des äußeren Beobachters ist zugleich epistemische und ontologische Konsequenz: Erkennen wird zur Funktion jener Reflexion, in der der Gegenstand seine Momente vermittelt.","refs":["MC_GB18_L1_10:GA-03","MC_GB18_L1_10:GA-09","CL_GB18_38:ALT-B03","CL_GB18_39:BSD-04","CL_GB18_40:XD-05"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_10:XD-06","text":"Äußere Reflexion bleibt produktiv notwendig, obwohl ihre Selbstständigkeit ausgeschlossen wird; sie ist die instabile Expositionsform, in der immanente Relation sichtbar und rücknehmbar wird.","refs":["MC_GB18_L1_10:GA-05","MC_GB18_L1_10:GA-09","CL_GB18_37:RLE-03","CL_GB18_39:RMD-03","CL_GB18_40:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_10:BSD-01","text":"Realität wird als Prozess selbstnegativer Relationen bestimmt, deren Glieder nicht vor ihrer Vermittlung existieren, sondern aus ihr hervorgehen.","refs":["MC_GB18_L1_10:GA-01","MC_GB18_L1_10:GA-03","MC_GB18_L1_10:GA-06","CL_GB18_37:BSD-01","CL_GB18_38:BSD-02","CL_GB18_40:BSD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_10:BSD-02","text":"Zeit ist keine äußere Sukzession fertiger Zustände, sondern die rekursive und rückwirkende Ordnung, in der Resultate ihre Voraussetzungen umcodieren.","refs":["MC_GB18_L1_10:GA-04","MC_GB18_L1_10:GA-08","CL_GB18_37:HSI-03","CL_GB18_39:HSI-03","CL_GB18_40:HSI-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_10:BSD-03","text":"Das Subjekt verliert den Status eines souveränen Trägers und wird zur Durchgangsfunktion der Reflexion, die in Vergleich, Opposition und Erkenntnis ihre eigene Äußerlichkeit aufhebt.","refs":["MC_GB18_L1_10:GA-05","MC_GB18_L1_10:GA-09","CL_GB18_38:XD-03","CL_GB18_39:BSD-04","CL_GB18_40:HSI-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_10:BSD-04","text":"Formale Gesetze sind keine neutralen Grenzen des Denkens, sondern Symptome der verdeckten Reflexionsbewegung, die sie durch Fixierung ihrer Bestimmungen entstellen.","refs":["MC_GB18_L1_10:GA-05","MC_GB18_L1_10:GA-06","CL_GB18_37:GA-07","CL_GB18_40:BSD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_10:BSD-05","text":"Handlungsmacht besteht weder in äußerer Beherrschung noch in der Wahl eines Pols, sondern in der Rekonstruktion und Transformation der Operationen, welche Gegensätze erzeugen.","refs":["MC_GB18_L1_10:GA-03","MC_GB18_L1_10:GA-09","CL_GB18_39:HSI-04","CL_GB18_40:HSI-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_10:BSD-06","text":"Methodisch erzwingt das System eine Lektüre, die identische Wörter über wechselnde Abstraktionsebenen hinweg nicht gleichsetzt, sondern ihre Funktionsmutationen rekonstruiert.","refs":["MC_GB18_L1_10:GA-02","MC_GB18_L1_10:GA-05","MC_GB18_L1_10:GA-08","CL_GB18_39:ALT-B05","CL_GB18_40:ALT-B05"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_10:RLE-01","text":"Die Hauptschleife lautet: aufgehobene Unmittelbarkeit erzeugt Negativität; Negativität erzeugt Bestimmung; Bestimmung setzt ihr Anderes; der entstehende Widerspruch kehrt als Grund zurück.","refs":["CL_GB18_37:RLE-01","CL_GB18_39:RLE-01","CL_GB18_40:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RLE-02","text":"Die Eskalation der Äußerlichkeit führt von gleichgültiger Verschiedenheit über Vergleich und austauschbare Zeichen zur inneren Opposition, in der die Relation in jede Seite zurückgenommen wird.","refs":["CL_GB18_38:RLE-03","CL_GB18_39:RLE-03","CL_GB18_40:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RLE-03","text":"Negative Einheit und Grund bilden aufeinanderfolgende Attraktoren: Jede versuchte Absonderung wird zunächst in ihre relationale Einheit und schließlich in die Einheit erhaltener Negativität zurückgeführt.","refs":["CL_GB18_38:RLE-04","CL_GB18_40:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RLE-04","text":"Ausschluss bildet eine rekursive Setzungsschleife, weil das Abgewiesene als Bedingung des Ausschließens wiederkehrt und dadurch die ausschließende Bestimmung verändert.","refs":["CL_GB18_38:AS-02","CL_GB18_40:GA-02","CL_GB18_40:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RLE-05","text":"Die Umkehrung von Positivem und Negativem markiert einen Phasenwechsel von äußerlicher Zuschreibung zu objektiver Begriffsbewegung und nicht bloß eine Wiederholung vertauschter Namen.","refs":["CL_GB18_40:RMD-02","CL_GB18_40:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_10:FGS-B01","text":"Vorausgesetzte Identität → Abstraktion von Differenz → Unbestimmtheit des vermeintlich positiven Anfangs.","refs":["CL_GB18_37:GA-01","CL_GB18_38:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B02","text":"Unbestimmte Identität → Selbstnegation → absoluter Unterschied als negative Selbstbeziehung.","refs":["CL_GB18_37:GA-04","CL_GB18_38:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B03","text":"Einheit von Identität und Unterschied → bestimmter Unterschied → Verschiedenheit → Externalisierung als Gleichheit und Ungleichheit.","refs":["CL_GB18_38:AS-05","CL_GB18_38:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B04","text":"Gleichheit und Ungleichheit → ko-konstitutive Verschiedenheit → Positives und Negatives → innere Opposition.","refs":["CL_GB18_39:GA-03","CL_GB18_39:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B05","text":"Opposition → Anspruch selbstständiger Pole → Ausschluss des Anderen → Setzung des Ausgeschlossenen → Selbstwiderspruch.","refs":["CL_GB18_40:GA-02","CL_GB18_40:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B06","text":"Selbstwiderspruch → Aufhebung des bloßen Gesetztseins → positive Reflexionseinheit → Grund als Einheit erhaltener Negativität.","refs":["CL_GB18_40:AS-06","CL_GB18_40:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B07","text":"Grund → rückwirkende Reklassifikation des Anfangs → Wiederaufnahme der Identität als abhängiges Moment des erzeugten Zusammenhangs.","refs":["CL_GB18_40:BSD-03","CL_GB18_40:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_10:AFM-B01","text":"Abstrakte Selbstgleichheit → immanente Negativität → absoluter Unterschied → Verschiedenheit → äußerliche Vergleichung → Gegensatz → ausschließende Selbstständigkeit → Widerspruch → Grund.","refs":["CL_GB18_40:AS-07","CL_GB18_40:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:AFM-B02","text":"Äußere Beschreibung → immanente Rekonstruktion → operative Differenzierung → negative Durchdringung → rückwirkende Bestimmung des Ausgangspunkts.","refs":["CL_GB18_38:ALT-B03","CL_GB18_40:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_10:MME-01","text":"Identität und Unterschied werden von Grundsätzen beziehungsweise Relationen zwischen fertigen Dingen zu aufeinander bezogenen Operationen negativer Reflexion umkartiert.","refs":["CL_GB18_37:MME-01","CL_GB18_38:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MME-02","text":"Der Gegensatz von Selbstständigkeit und Abhängigkeit kollabiert, weil beide als wechselnde Funktionen derselben inneren Reflexionsrelation erscheinen.","refs":["CL_GB18_39:MME-03","CL_GB18_40:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MME-03","text":"Widerspruch wird von der Grenze zulässiger Bestimmung zur produktiven Kartierungs- und Übergangsregel reklassifiziert.","refs":["CL_GB18_37:MME-03","CL_GB18_40:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MME-04","text":"Formale Logik und Symbolik werden dem Begriff ihrer Operation untergeordnet und als abgeleitete Sichtbarkeitsformen einer verdeckten Reflexionsgrundlage gelesen.","refs":["CL_GB18_39:MME-05","CL_GB18_40:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MME-05","text":"Der Grund wird vom vorausgesetzten Fundament zum erzeugten Zusammenhang umkartiert, der seine Voraussetzungen nachträglich als abhängige Momente bestimmt.","refs":["CL_GB18_40:MME-03","CL_GB18_40:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_10:ALT-B01","text":"Surface level — Explizite Gegenstände sind Identität, Unterschied, Verschiedenheit, Gleichheit, Ungleichheit, Positives, Negatives, Widerspruch und Grund sowie ihre Satz-, Vergleichs- und Zeichenformen.","refs":["CL_GB18_39:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:ALT-B02","text":"Structural level — Selbstbeziehung, Negativität, Aufhebung, Ausschließung und Vermittlung organisieren sämtliche Gegenstände als Stufen einer rekursiven Erzeugungsstruktur.","refs":["CL_GB18_37:ALT-B02","CL_GB18_39:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:ALT-B03","text":"Metastrategic level — Interpretation wird von äußerer Widerlegung und Fixierung auf die Rekonstruktion jener Operationen umgestellt, durch die Bestimmungen ihre Grenzen selbst produzieren.","refs":["CL_GB18_38:ALT-B03","CL_GB18_40:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:ALT-B04","text":"Ontological / Temporal level — Wirklichkeit besteht als selbstnegative Übergangsbewegung, deren rückwirkende Zeit den Anfang erst vom Resultat her bestimmt.","refs":["CL_GB18_37:ALT-B04","CL_GB18_40:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie jeden festgehaltenen Begriff in Beziehung, Umkehrung, Selbstaufhebung und veränderte Wiederkehr überführt.","refs":["CL_GB18_37:ALT-B05","CL_GB18_40:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_10:FL-01","text":"Der Übergang von logischer Satzform zu ontologischer Reflexionsstruktur wird operativ vorausgesetzt, aber nicht vollständig als notwendige Vermittlung ausgewiesen.","refs":["CL_GB18_38:FL-01","CL_GB18_38:MRT-B03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:FL-02","text":"Äußere Reflexion wird als unzureichend disqualifiziert und zugleich benötigt, um die immanente Einheit ihrer getrennten Momente sichtbar zu machen.","refs":["CL_GB18_39:FL-01","CL_GB18_40:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:FL-03","text":"Positives und Negatives müssen zunächst symmetrisch austauschbar sein, damit ihre relationale Genese sichtbar wird, und anschließend asymmetrisch werden, damit Negativität Bestimmung erzeugen kann.","refs":["CL_GB18_39:DBN-04","CL_GB18_39:BSD-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:FL-04","text":"Der Grund ist zugleich Resultat der Opposition und ihre rückwirkende Wahrheit; diese konstitutive Zirkularität verhindert eine strikt lineare Begründungsordnung.","refs":["CL_GB18_40:FL-01","CL_GB18_40:BSD-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:MP-01","text":"Identität mutiert an der Schwelle zwischen ganzer Reflexion und bestimmtem Moment von abstrakter Selbstgleichheit zu einer Einheit, die ihre Differenz selbst hervorbringt.","refs":["CL_GB18_37:FL-02","CL_GB18_38:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:MP-02","text":"Unterschied mutiert vom absoluten Selbstunterschied über äußere Verschiedenheit zur Opposition; dieselbe Benennung verdeckt dabei wechselnde Grade der Relationseinlagerung.","refs":["CL_GB18_38:RMD-02","CL_GB18_38:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:MP-03","text":"Positives und Negatives mutieren an der Schwelle zwischen äußerer Zeichenrelation und qualitativer Opposition von austauschbaren Zuschreibungen zu asymmetrischen Bestimmungsfunktionen.","refs":["CL_GB18_39:MP-01","CL_GB18_40:RMD-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:MP-04","text":"Das ausgeschlossene Dritte mutiert vom verbotenen Zusatz zur gemeinsamen Einheit der Pole und schließlich zum Grund ihrer aufgehobenen Opposition.","refs":["CL_GB18_40:RMD-04","CL_GB18_40:MP-03"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_10:HSI-01","text":"Realität erscheint als Reflexionsmaschine, in der jede Einheit ihr Anderes erzeugt, ausschließt, enthält und durch diese Operation zu sich zurückkehrt.","refs":["CL_GB18_37:HSI-01","CL_GB18_39:HSI-01","CL_GB18_40:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:HSI-02","text":"Das Subjekt ist keine steuernde Außeninstanz, sondern die negative Durchgangsfunktion, in der die Maschine ihre Differenzen vergleicht, vollzieht und aufhebt.","refs":["CL_GB18_38:HSI-02","CL_GB18_39:HSI-02","CL_GB18_40:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:HSI-03","text":"Zeit ist eine Spirale transformierter Rückkehr, in der jedes Resultat seine Voraussetzungen erhält, umcodiert und rückwirkend bestimmt.","refs":["CL_GB18_38:HSI-03","CL_GB18_39:HSI-03","CL_GB18_40:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:HSI-04","text":"Navigation bleibt als Arbeit innerhalb der Negativität möglich: nicht durch Flucht aus dem Gegensatz, sondern durch Eingriff in die Operationen seiner Erzeugung und Rücknahme.","refs":["CL_GB18_39:HSI-04","CL_GB18_40:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_10:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Gesamtarchitektur von abstrakter Identität über selbstbezügliche Differenz, Verschiedenheit, Opposition und Widerspruch bis zum Grund zu rekonstruieren.","refs":["CL_GB18_38:MRT-B01","CL_GB18_40:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MRT-B02","text":"Unterbestimmt bleiben die notwendigen Übergänge von Satzform zu Ontologie, von äußerer Zuschreibung zu qualitativer Selbstbestimmung und vom resultierenden Grund zur weiteren Systementwicklung.","refs":["CL_GB18_38:MRT-B03","CL_GB18_39:MRT-B02","CL_GB18_40:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MRT-B03","text":"Die Rekonstruktion bleibt kohärent, sofern wechselnde Abstraktionsebenen streng unterschieden und Identität, Nichtidentität, Positivität und Grund als Funktionsmomente statt als konkurrierende Endbehauptungen gelesen werden.","refs":["CL_GB18_37:MRT-B03","CL_GB18_39:MRT-B03","CL_GB18_40:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MRT-B04","text":"Axiomatischer Reduktion widersteht die performative Operation, dass Ausschluss das Ausgeschlossene setzt; sie muss als Vollzug erhalten bleiben und kann nicht durch eine statische Proposition ersetzt werden.","refs":["CL_GB18_40:AS-05","CL_GB18_40:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123900454448Z_c8a81157","language_code":"en","language_name":"English","title":"Gb18 L1 10","source_sha256":"ee2a7ea9dcc49f946baa96e7b85999760112ff771d8d419524fe5d36edbd0bf7","sha256":"90d2370398a3fdcf26af3633e08516591ec4b0babfbb7be80875f080d8604b90","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:39:00.455418+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_10:BAS-01","text":"The system addresses the impossibility of grounding identity as original self-sameness and difference as a subsequently added relation.","refs":["CL_GB18_37:AS-B01","CL_GB18_38:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-02","text":"Its global thesis is that determinacy exists exclusively as negative self-relation and arises neither from a positive substrate nor from an external negation.","refs":["CL_GB18_38:GA-02","CL_GB18_39:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-03","text":"The movement proceeds recursively from sublated immediacy through identity, difference, diversity, and opposition to a ground that preserves the negativity traversed.","refs":["CL_GB18_37:AS-B04","CL_GB18_39:AS-04","CL_GB18_40:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-04","text":"The argument proceeds as immanent critique: law, proposition, comparison, and exclusion are measured by whether their operations themselves generate what they reject.","refs":["CL_GB18_37:AS-B03","CL_GB18_40:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-05","text":"Externality is not rejected as an independent counter-domain, but reconstructed as a necessary phase in which immanent difference exposes itself as comparison, sign-relation, and opposition.","refs":["CL_GB18_38:AS-06","CL_GB18_40:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-06","text":"The initial symmetry of the counter-determinations turns into an asymmetry because only negativity generates determinacy and positivity emerges as the result of its self-negation.","refs":["CL_GB18_39:GA-08","CL_GB18_40:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-07","text":"Contradiction therefore designates not a marginal error, but the operative transition in which isolated independence disintegrates and its immanent unity is generated.","refs":["CL_GB18_37:GA-08","CL_GB18_40:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:BAS-08","text":"The closure is retroactive and not static: the ground classifies the preceding determinations as its posited moments without definitively arresting the negative movement.","refs":["CL_GB18_40:BSD-03","CL_GB18_40:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_10:GA-01","text":"[Persistent] Negativity is the immanent self-relation through which identity, difference, and determinacy are generated.","refs":["CL_GB18_37:GA-04","CL_GB18_38:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-02","text":"[Mutating] Identity mutates from the whole of reflection and abstract self-sameness into a posited moment that exists only within its own difference.","refs":["CL_GB18_37:GA-03","CL_GB18_38:RMD-01","CL_GB18_40:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-03","text":"[Persistent] No determination possesses relation-external independence; its other is a constitutive condition and is posited precisely through its exclusion.","refs":["CL_GB18_39:GA-04","CL_GB18_40:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-04","text":"[Attractor] The self-negation of negativity generates difference, return, positivity, and finally a unity that retains its negative genesis.","refs":["CL_GB18_37:GA-04","CL_GB18_39:RLE-05","CL_GB18_40:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-05","text":"[Mutating] External reflection appears successively as law of thought, comparison, sign-attribution, and formal alternative, but is in each case taken back into the immanent relation that externalizes it.","refs":["CL_GB18_37:GA-07","CL_GB18_38:RMD-04","CL_GB18_40:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-06","text":"[Emergent] Contradiction is the transition operator through which isolated determinations lose their independence and are reconstructed as moments of the ground.","refs":["CL_GB18_37:GA-08","CL_GB18_40:GA-04","CL_GB18_40:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-07","text":"[Mutating] Positivity loses the status of an origin and becomes the result of determining negation, while the negative assumes the asymmetrical generative function.","refs":["CL_GB18_39:RMD-06","CL_GB18_39:BSA-02","CL_GB18_40:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-08","text":"[Emergent] The ground is the retroactive unity of reflection that subsequently identifies the initial opposition as its own posited moment.","refs":["CL_GB18_40:GA-07","CL_GB18_40:BSD-03","CL_GB18_40:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-09","text":"[Persistent] Cognition is possible only as an immanent reconstruction of the negative movement; an external standpoint of observation repeats the separation to be overcome.","refs":["CL_GB18_38:ALT-B03","CL_GB18_40:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:GA-10","text":"[Terminal] The attained unity is not contradiction-free repose, but the positive form in which sublated negativity persists as inner determination.","refs":["CL_GB18_40:AS-08","CL_GB18_40:GA-08","CL_GB18_40:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_10:RMD-01","text":"Identity recurs in functionally altered form: from abstract self-sameness through self-differentiating reflection to the posited identity of the ground.","refs":["CL_GB18_37:RMD-02","CL_GB18_38:RMD-01","CL_GB18_40:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-02","text":"Difference escalates from indifferent diversity to absolute self-difference, externalizes itself anew, and finally condenses into inner opposition.","refs":["CL_GB18_37:RMD-03","CL_GB18_38:RMD-02","CL_GB18_39:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-03","text":"Negativity mutates from the implicit content of identity into the self-sublation of external forms of comparison and finally into the positive structure of self-relating determinacy.","refs":["CL_GB18_38:RMD-03","CL_GB18_39:RMD-06","CL_GB18_40:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-04","text":"External reflection moves through propositional form, comparison, and formal exclusion; its apparent foreignness is in each case absorbed as a mediating phase produced by the object itself.","refs":["CL_GB18_37:RMD-04","CL_GB18_39:RMD-03","CL_GB18_40:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-05","text":"Positive and negative begin as interchangeable attributions, lose this symmetry, and recur as asymmetrical functions of determining negation and mediated positivity.","refs":["CL_GB18_39:RMD-04","CL_GB18_39:DBN-04","CL_GB18_40:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-06","text":"The third mutates from the supposedly additional or neutral term into the inner unity of opposition and is finally determined as ground.","refs":["CL_GB18_40:RMD-04","CL_GB18_40:MP-03","CL_GB18_40:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RMD-07","text":"Contradiction is recoded from an incompatibility to be avoided into the transitional force that generates exclusion, self-sublation, and positive unity.","refs":["CL_GB18_37:GA-08","CL_GB18_39:MRT-B04","CL_GB18_40:GA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_10:CGD-01","text":"Propositional analyses, arithmetic signs, and exemplary counter-pairs remain local diagnostic surfaces; at the current level they count only as different modes of operation of the same negative reflection.","refs":["CL_GB18_38:CGD-01","CL_GB18_39:AS-08","CL_GB18_40:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:CGD-02","text":"The critique of individual laws of thought scales up to the general thesis that every externally fixed determination suppresses its concealed relational generative structure.","refs":["CL_GB18_37:CGD-02","CL_GB18_38:CGD-04","CL_GB18_40:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:CGD-03","text":"The different meanings of zero and of signs remain local operational distinctions; scaled upward is the rule that symbolism receives its determinacy only from the qualitative relation.","refs":["CL_GB18_39:CGD-03","CL_GB18_39:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:CGD-04","text":"The individual opposition becomes the global rule of generation as soon as each side contains its other as its own condition and each alternative brings forth its common unit of reference.","refs":["CL_GB18_39:CGD-04","CL_GB18_40:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:CGD-05","text":"The ground belongs exclusively to the current level of synthesis: it unifies the previously local mechanisms of identity, difference, comparison, opposition, exclusion, and contradiction.","refs":["CL_GB18_40:GA-07","CL_GB18_40:MME-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_10:GNX-01","text":"Excluded is an identity that could exist before its difference as pure self-sameness and keep its negativity external.","refs":["CL_GB18_37:GNX-01","CL_GB18_38:GNX-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:GNX-02","text":"Excluded is an external standpoint of cognition or comparison that orders relations without itself entering into their negative movement.","refs":["CL_GB18_37:GNX-02","CL_GB18_38:GNX-04","CL_GB18_40:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:GNX-03","text":"Excluded is a logic of contradiction-avoidance that arrests the inner unity of opposed determinations through separation of perspectives.","refs":["CL_GB18_37:GNX-03","CL_GB18_39:DBN-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:GNX-04","text":"Excluded are the complete symmetry of positive and negative and an absolutely first positive prior to negative mediation.","refs":["CL_GB18_39:DBN-04","CL_GB18_40:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:GNX-05","text":"Excluded is a sublation that annihilates relation into nullity or terminates movement in a final state of repose.","refs":["CL_GB18_40:GNX-05","CL_GB18_40:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_10:DBN-01","text":"False must be a model of substance in which fully independent identities are already determined prior to their relations.","refs":["CL_GB18_39:DBN-01","CL_GB18_40:DBN-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:DBN-02","text":"False must be that thought can be grounded through a relation-free law whose general form does not reflect its own externalization.","refs":["CL_GB18_38:DBN-01","CL_GB18_37:GA-07"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:DBN-03","text":"False must be that a formal calculus or a rule of exclusion can derive its qualitative mode of operation from mere signs and conceal its common basis of reflection.","refs":["CL_GB18_39:DBN-03","CL_GB18_40:GA-06"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:DBN-04","text":"False must be the availability of a neutral third or external ground that mediates opposition without itself being determined within it.","refs":["CL_GB18_38:BSA-02","CL_GB18_40:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_10:BSA-01","text":"The deepest excluded possibility is pure self-presence: a positivity requiring neither inner negation nor self-difference.","refs":["CL_GB18_38:BSA-01","CL_GB18_40:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:BSA-02","text":"Unavailable is an ontological outside of reflection from which identity and difference could receive their unity.","refs":["CL_GB18_37:BSA-02","CL_GB18_38:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"MC_GB18_L1_10:BSA-03","text":"The system organizes itself around the absence of a neutral endpoint at which mediation, negativity, and return could finally expire.","refs":["CL_GB18_39:BSA-03","CL_GB18_40:BSA-04"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_10:XD-01","text":"Because identity itself generates its non-being and opposition posits the other through exclusion, self-differentiation is the general form of every determination.","refs":["MC_GB18_L1_10:GA-01","MC_GB18_L1_10:GA-02","MC_GB18_L1_10:GA-03","CL_GB18_37:GA-04","CL_GB18_38:GA-04","CL_GB18_40:GA-02"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_10:XD-02","text":"Law of thought, comparison, and formal alternative do not form independent types of error, but successive morphologies of external reflection that presuppose their immanent unit of reference.","refs":["MC_GB18_L1_10:GA-05","MC_GB18_L1_10:GA-09","CL_GB18_37:GA-07","CL_GB18_38:GA-07","CL_GB18_40:GA-06"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_10:XD-03","text":"The asymmetrical generativity of the negative and the productivity of contradiction together entail that positive unity can appear only as the preserved form of enacted self-negation.","refs":["MC_GB18_L1_10:GA-04","MC_GB18_L1_10:GA-06","MC_GB18_L1_10:GA-07","MC_GB18_L1_10:GA-10","CL_GB18_39:RMD-06","CL_GB18_40:GA-04","CL_GB18_40:GA-08"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_10:XD-04","text":"The logical time of determination is retroactive: only the attained unity of reflection renders the supposed beginning legible as a dependent moment of its own movement.","refs":["MC_GB18_L1_10:GA-08","MC_GB18_L1_10:GA-10","CL_GB18_37:HSI-03","CL_GB18_38:ALT-B04","CL_GB18_40:BSD-03"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_10:XD-05","text":"The sublation of the external observer is at once an epistemic and ontological consequence: cognition becomes a function of that reflection in which the object mediates its moments.","refs":["MC_GB18_L1_10:GA-03","MC_GB18_L1_10:GA-09","CL_GB18_38:ALT-B03","CL_GB18_39:BSD-04","CL_GB18_40:XD-05"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"MC_GB18_L1_10:XD-06","text":"External reflection remains productively necessary although its independence is excluded; it is the unstable form of exposition in which immanent relation becomes visible and retractable.","refs":["MC_GB18_L1_10:GA-05","MC_GB18_L1_10:GA-09","CL_GB18_37:RLE-03","CL_GB18_39:RMD-03","CL_GB18_40:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_10:BSD-01","text":"Reality is determined as a process of self-negative relations whose members do not exist prior to their mediation, but arise from it.","refs":["MC_GB18_L1_10:GA-01","MC_GB18_L1_10:GA-03","MC_GB18_L1_10:GA-06","CL_GB18_37:BSD-01","CL_GB18_38:BSD-02","CL_GB18_40:BSD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_10:BSD-02","text":"Time is not an external succession of finished states, but the recursive and retroactive order in which results recode their presuppositions.","refs":["MC_GB18_L1_10:GA-04","MC_GB18_L1_10:GA-08","CL_GB18_37:HSI-03","CL_GB18_39:HSI-03","CL_GB18_40:HSI-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_10:BSD-03","text":"The subject loses the status of a sovereign bearer and becomes the transitional function of reflection that sublates its own externality in comparison, opposition, and cognition.","refs":["MC_GB18_L1_10:GA-05","MC_GB18_L1_10:GA-09","CL_GB18_38:XD-03","CL_GB18_39:BSD-04","CL_GB18_40:HSI-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_10:BSD-04","text":"Formal laws are not neutral limits of thought, but symptoms of the concealed movement of reflection that they distort by fixing its determinations.","refs":["MC_GB18_L1_10:GA-05","MC_GB18_L1_10:GA-06","CL_GB18_37:GA-07","CL_GB18_40:BSD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_10:BSD-05","text":"Agency consists neither in external mastery nor in the choice of a pole, but in the reconstruction and transformation of the operations that generate opposites.","refs":["MC_GB18_L1_10:GA-03","MC_GB18_L1_10:GA-09","CL_GB18_39:HSI-04","CL_GB18_40:HSI-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_10:BSD-06","text":"Methodologically, the system compels a reading that does not equate identical words across changing levels of abstraction, but reconstructs their functional mutations.","refs":["MC_GB18_L1_10:GA-02","MC_GB18_L1_10:GA-05","MC_GB18_L1_10:GA-08","CL_GB18_39:ALT-B05","CL_GB18_40:ALT-B05"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_10:RLE-01","text":"The main loop is: sublated immediacy generates negativity; negativity generates determinacy; determinacy posits its other; the resulting contradiction returns as ground.","refs":["CL_GB18_37:RLE-01","CL_GB18_39:RLE-01","CL_GB18_40:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RLE-02","text":"The escalation of externality leads from indifferent diversity through comparison and interchangeable signs to inner opposition, in which the relation is taken back into each side.","refs":["CL_GB18_38:RLE-03","CL_GB18_39:RLE-03","CL_GB18_40:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RLE-03","text":"Negative unity and ground form successive attractors: every attempted separation is first led back into its relational unity and finally into the unity of preserved negativity.","refs":["CL_GB18_38:RLE-04","CL_GB18_40:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RLE-04","text":"Exclusion forms a recursive loop of positing because what is rejected returns as the condition of excluding and thereby alters the excluding determination.","refs":["CL_GB18_38:AS-02","CL_GB18_40:GA-02","CL_GB18_40:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:RLE-05","text":"The reversal of positive and negative marks a phase transition from external attribution to objective conceptual movement and not merely a repetition of exchanged names.","refs":["CL_GB18_40:RMD-02","CL_GB18_40:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_10:FGS-B01","text":"Presupposed identity → abstraction from difference → indeterminacy of the supposedly positive beginning.","refs":["CL_GB18_37:GA-01","CL_GB18_38:AS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B02","text":"Indeterminate identity → self-negation → absolute difference as negative self-relation.","refs":["CL_GB18_37:GA-04","CL_GB18_38:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B03","text":"Unity of identity and difference → determinate difference → diversity → externalization as equality and inequality.","refs":["CL_GB18_38:AS-05","CL_GB18_38:AS-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B04","text":"Equality and inequality → co-constitutive diversity → positive and negative → inner opposition.","refs":["CL_GB18_39:GA-03","CL_GB18_39:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B05","text":"Opposition → claim of independent poles → exclusion of the other → positing of the excluded → self-contradiction.","refs":["CL_GB18_40:GA-02","CL_GB18_40:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B06","text":"Self-contradiction → sublation of mere positedness → positive unity of reflection → ground as unity of preserved negativity.","refs":["CL_GB18_40:AS-06","CL_GB18_40:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:FGS-B07","text":"Ground → retroactive reclassification of the beginning → resumption of identity as a dependent moment of the generated nexus.","refs":["CL_GB18_40:BSD-03","CL_GB18_40:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_10:AFM-B01","text":"Abstract self-sameness → immanent negativity → absolute difference → diversity → external comparison → opposition → excluding independence → contradiction → ground.","refs":["CL_GB18_40:AS-07","CL_GB18_40:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:AFM-B02","text":"External description → immanent reconstruction → operative differentiation → negative interpenetration → retroactive determination of the point of departure.","refs":["CL_GB18_38:ALT-B03","CL_GB18_40:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_10:MME-01","text":"Identity and difference are remapped from principles or relations between finished things into mutually related operations of negative reflection.","refs":["CL_GB18_37:MME-01","CL_GB18_38:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MME-02","text":"The opposition between independence and dependence collapses because both appear as changing functions of the same inner relation of reflection.","refs":["CL_GB18_39:MME-03","CL_GB18_40:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MME-03","text":"Contradiction is reclassified from the limit of permissible determination into a productive rule of mapping and transition.","refs":["CL_GB18_37:MME-03","CL_GB18_40:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MME-04","text":"Formal logic and symbolism are subordinated to the concept of their operation and read as derived forms of visibility of a concealed basis of reflection.","refs":["CL_GB18_39:MME-05","CL_GB18_40:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MME-05","text":"The ground is remapped from a presupposed foundation into a generated nexus that subsequently determines its presuppositions as dependent moments.","refs":["CL_GB18_40:MME-03","CL_GB18_40:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_10:ALT-B01","text":"Surface level — Explicit objects are identity, difference, diversity, equality, inequality, positive, negative, contradiction, and ground, together with their propositional, comparative, and sign forms.","refs":["CL_GB18_39:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:ALT-B02","text":"Structural level — Self-relation, negativity, sublation, exclusion, and mediation organize all objects as stages of a recursive generative structure.","refs":["CL_GB18_37:ALT-B02","CL_GB18_39:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:ALT-B03","text":"Metastrategic level — Interpretation is shifted from external refutation and fixation to the reconstruction of those operations through which determinations themselves produce their limits.","refs":["CL_GB18_38:ALT-B03","CL_GB18_40:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:ALT-B04","text":"Ontological / Temporal level — Reality exists as a self-negative movement of transition whose retroactive time determines the beginning only from the result.","refs":["CL_GB18_37:ALT-B04","CL_GB18_40:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:ALT-B05","text":"Methodological / Performative level — The presentation enacts its thesis by transforming every fixed concept into relation, reversal, self-sublation, and altered recurrence.","refs":["CL_GB18_37:ALT-B05","CL_GB18_40:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_10:FL-01","text":"The transition from logical propositional form to ontological structure of reflection is operationally presupposed, but not fully exhibited as necessary mediation.","refs":["CL_GB18_38:FL-01","CL_GB18_38:MRT-B03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:FL-02","text":"External reflection is disqualified as inadequate and simultaneously needed in order to make the immanent unity of its separated moments visible.","refs":["CL_GB18_39:FL-01","CL_GB18_40:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:FL-03","text":"Positive and negative must initially be symmetrically interchangeable so that their relational genesis becomes visible, and subsequently become asymmetrical so that negativity can generate determinacy.","refs":["CL_GB18_39:DBN-04","CL_GB18_39:BSD-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:FL-04","text":"The ground is at once the result of opposition and its retroactive truth; this constitutive circularity prevents a strictly linear order of grounding.","refs":["CL_GB18_40:FL-01","CL_GB18_40:BSD-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:MP-01","text":"Identity mutates at the threshold between whole reflection and determinate moment from abstract self-sameness into a unity that itself generates its difference.","refs":["CL_GB18_37:FL-02","CL_GB18_38:MP-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:MP-02","text":"Difference mutates from absolute self-difference through external diversity into opposition; the same designation thereby conceals changing degrees of relational embedding.","refs":["CL_GB18_38:RMD-02","CL_GB18_38:MP-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:MP-03","text":"Positive and negative mutate at the threshold between external sign-relation and qualitative opposition from interchangeable attributions into asymmetrical functions of determination.","refs":["CL_GB18_39:MP-01","CL_GB18_40:RMD-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"MC_GB18_L1_10:MP-04","text":"The excluded third mutates from the prohibited addition into the common unity of the poles and finally into the ground of their sublated opposition.","refs":["CL_GB18_40:RMD-04","CL_GB18_40:MP-03"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_10:HSI-01","text":"Reality appears as a machine of reflection in which every unity generates, excludes, contains its other, and returns to itself through this operation.","refs":["CL_GB18_37:HSI-01","CL_GB18_39:HSI-01","CL_GB18_40:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:HSI-02","text":"The subject is not a controlling external instance, but the negative transitional function in which the machine compares, enacts, and sublates its differences.","refs":["CL_GB18_38:HSI-02","CL_GB18_39:HSI-02","CL_GB18_40:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:HSI-03","text":"Time is a spiral of transformed return in which every result preserves, recodes, and retroactively determines its presuppositions.","refs":["CL_GB18_38:HSI-03","CL_GB18_39:HSI-03","CL_GB18_40:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:HSI-04","text":"Navigation remains possible as work within negativity: not through escape from opposition, but through intervention in the operations of its generation and retraction.","refs":["CL_GB18_39:HSI-04","CL_GB18_40:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_10:MRT-B01","text":"The extracted axioms suffice to reconstruct the overall architecture from abstract identity through self-relating difference, diversity, opposition, and contradiction to ground.","refs":["CL_GB18_38:MRT-B01","CL_GB18_40:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MRT-B02","text":"What remains underdetermined are the necessary transitions from propositional form to ontology, from external attribution to qualitative self-determination, and from the resulting ground to further system development.","refs":["CL_GB18_38:MRT-B03","CL_GB18_39:MRT-B02","CL_GB18_40:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MRT-B03","text":"The reconstruction remains coherent provided that changing levels of abstraction are strictly distinguished and identity, non-identity, positivity, and ground are read as functional moments rather than as competing final claims.","refs":["CL_GB18_37:MRT-B03","CL_GB18_39:MRT-B03","CL_GB18_40:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_10:MRT-B04","text":"Axiomatic reduction is resisted by the performative operation that exclusion posits the excluded; it must be preserved as enactment and cannot be replaced by a static proposition.","refs":["CL_GB18_40:AS-05","CL_GB18_40:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_10@R001","source_variant_id":"canonical:MC_GB18_L1_10:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 10","context":"Chapters 109–120 · Anmerkung. · A. Die Identität. · Anmerkung 1. · Anmerkung 2. · 1. Der absolute Unterschied. · 2. Die Verschiedenheit. · Anmerkung. · 3. Der Gegensatz. · Anmerkung. · C. Der Widerspruch. · Anmerkung 1. · Anmerkung 2."},"title_language_code":"en"},{"id":"MC_GB18_L1_11","layer":"MC","title":"Gb18 L1 11","order":11,"parents":["CL_GB18_41","CL_GB18_42","CL_GB18_43","CL_GB18_44"],"revision":"MC_GB18_L1_11@R001","sha256":"0dae2a336ea8e358c0bb8acbf00e98f4067bc4281e177f77ec45df82d6224a0a","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_11:AS-01","text":"Das System bestimmt, wie Grund erklären kann, ohne als positiv vorausliegender Ursprung, äußerer Träger oder bloße Verdopplung des Begründeten angesetzt zu werden.","refs":["CL_GB18_41:AS-B01","CL_GB18_43:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-02","text":"Seine globale These lautet, dass Bestimmtheit nur durch immanente Negativität entsteht und Einheit daher als negativer Selbstunterschied statt als ruhende Identität begriffen werden muss.","refs":["CL_GB18_41:AS-B02","CL_GB18_44:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-03","text":"Begründung muss Identität zwischen Grund und Begründetem bewahren und zugleich eine erklärende Differenz erzeugen; jede einseitige Fixierung eines dieser Momente zerstört ihre Zureichendheit.","refs":["CL_GB18_42:GA-05","CL_GB18_43:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-04","text":"Die Flucht aus formaler Inhaltsgleichheit in reale Inhaltsdifferenz erzeugt Äußerlichkeit und zwingt das System, Erklärung als immanente Vermittlung der konkreten Verknüpfung neu zu bestimmen.","refs":["CL_GB18_43:GA-02","CL_GB18_43:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-05","text":"Grund, Form, Inhalt und Bedingung werden deshalb in Funktionen einer Selbstvermittlung überführt, deren Schließung nicht im Auffinden eines ersten Terms, sondern in der Transformation ihrer Relation besteht.","refs":["CL_GB18_44:AS-02","CL_GB18_44:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-06","text":"Die Bewegung ist rekursiv und spiralförmig: Jede erreichte Vermittlung setzt eine neue Differenz frei, deren Krise die vorausgehende Einheit auf höherer Ebene rekonfiguriert.","refs":["CL_GB18_41:AS-B08","CL_GB18_43:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-07","text":"Tautologie eskaliert zu Äußerlichkeit, Äußerlichkeit zu konkurrierenden Gründen und Bedingtheit zum Regress; beide Eskalationen enden nur durch eine Mutation der Grundform selbst.","refs":["CL_GB18_43:RLE-02","CL_GB18_44:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-08","text":"Die Schließung ist doppelt: Das Unbedingte schließt die Grund-Bedingungs-Relation als negative Selbstbewegung, während Begriff und Zweck als noch nicht positiv entwickelte Formen zureichender Einheit offenbleiben.","refs":["CL_GB18_41:BSA-04","CL_GB18_43:AS-B08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_11:GA-01","text":"[Persistent] Unmittelbarkeit besitzt keine ursprüngliche Wahrheit; sie besteht nur als gesetztes, aufgehobenes oder rückwirkend vorausgesetztes Resultat der Vermittlung.","refs":["CL_GB18_41:GA-01","CL_GB18_44:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-02","text":"[Persistent] Identität ist negative Einheit: Sie erhält sich nicht durch Ausschluss, sondern durch Hervorbringung, Negation und Rücknahme ihrer eigenen Differenz.","refs":["CL_GB18_41:GA-03","CL_GB18_44:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-03","text":"[Persistent] Kein Moment trägt seinen Grundcharakter isoliert; Bestimmungen sind ausschließlich als relationale Funktionen einer vermittelten Totalität bestimmt.","refs":["CL_GB18_41:GA-05","CL_GB18_44:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-04","text":"[Mutating] Grund mutiert von der Selbstfundierung des Gesetzten über reversible Formpositionen und partielle Grundlage zur Reflexion, die ihre eigene Voraussetzung als Bedingung setzt.","refs":["CL_GB18_41:GA-04","CL_GB18_43:GA-05","CL_GB18_44:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-05","text":"[Mutating] Form und Materie verlieren ihre Selbständigkeit im Inhalt; der Inhalt verliert anschließend seine Ruhe und wird zur gegenläufigen Form-Inhalt-Bewegung des Grundes.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-04","CL_GB18_44:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-06","text":"[Emergent] Zureichende Erklärung muss sowohl formale Tautologie als auch reale Äußerlichkeit überschreiten, indem sie Identität, Differenz und konkrete Verknüpfung aus derselben Bewegung erzeugt.","refs":["CL_GB18_43:XD-01","CL_GB18_43:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-07","text":"[Persistent] Differenz darf weder getilgt noch verselbständigt werden; sie bleibt als notwendige Restdifferenz oder Selbstunterschied innerhalb der Einheit erhalten.","refs":["CL_GB18_42:RMD-06","CL_GB18_44:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-08","text":"[Attractor] Äußerlichkeit wird wiederholt in immanente Vermittlung umcodiert, bleibt aber als notwendige Erscheinungsform der Selbstentzweiung wirksam.","refs":["CL_GB18_42:GA-06","CL_GB18_44:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-09","text":"[Emergent] Wo konkrete Vielbestimmtheit nicht immanent vermittelt ist, wird Begründung zur selektierenden Praxis, die partielle Inhalte priorisiert und diese Priorisierung als Notwendigkeit stabilisieren kann.","refs":["CL_GB18_43:GA-06","CL_GB18_43:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-10","text":"[Attractor] Begriff und Zweck bezeichnen die geforderte Form zureichender Einheit, dürfen aber nicht als weitere Einzelgründe innerhalb der überwundenen Grundform auftreten.","refs":["CL_GB18_41:GA-08","CL_GB18_43:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-11","text":"[Terminal] Das absolut Unbedingte beendet den Bedingungsregress als negative Selbstbewegung, liefert aber noch keine positive Darstellung des Begriffs oder der Zweckform.","refs":["CL_GB18_44:GA-09","CL_GB18_44:BSA-03","CL_GB18_43:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-12","text":"[Attractor] Erklärung ist zureichend nur als Rekonstruktion der immanenten Verknüpfung einer Sache, nicht als Akkumulation, Benennung oder hierarchische Anordnung isolierter Gründe.","refs":["CL_GB18_43:MME-05","CL_GB18_44:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_11:RMD-01","text":"Unmittelbarkeit kehrt funktional wieder, mutiert jedoch vom unwahren Anfang zum Material der Vermittlung und schließlich zum rückwirkend gesetzten Resultat.","refs":["CL_GB18_41:RMD-03","CL_GB18_44:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-02","text":"Widerspruch bleibt Bewegungsprinzip, wird aber von der expliziten Instabilität endlicher Bestimmungen in die negative Identität der gesamten Grundbewegung absorbiert.","refs":["CL_GB18_41:RMD-02","CL_GB18_44:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-03","text":"Grund verschiebt sich vom erzeugten Selbstgrund über reversible Inhaltsdarstellung und unzureichende Grundlage zur Selbstreflexion, die Bedingtheit als eigenes Moment hervorbringt.","refs":["CL_GB18_41:RMD-05","CL_GB18_43:MP-02","CL_GB18_44:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-04","text":"Form mutiert von bestimmender Tätigkeit zur Reflexionsstruktur des Grundes und verliert dadurch ihre anfängliche Gegenstellung zu Materie, Wesen und Inhalt.","refs":["CL_GB18_42:RMD-01","CL_GB18_42:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-05","text":"Materie wandert von der negativen Grenze der Form über formierte Inhaltsbestimmung zur Bedingung als gesetztem Ansichsein; ein unabhängiger Substratstatus verschwindet vollständig.","refs":["CL_GB18_41:GA-09","CL_GB18_44:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-06","text":"Inhalt entsteht als Rücknahme der Form-Materie-Differenz, wird zur Grundidentität und kehrt schließlich als Restäußerlichkeit wieder, die formale Geschlossenheit von realer Zureichendheit trennt.","refs":["CL_GB18_42:RMD-03","CL_GB18_42:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-07","text":"Zureichendheit kehrt mit umgekehrter Valenz wieder: Formale Inhaltsgleichheit gilt zunächst als Geschlossenheit und wird anschließend gerade wegen fehlender erklärender Differenz zum Defizit.","refs":["CL_GB18_42:GA-08","CL_GB18_42:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-08","text":"Absolute Notwendigkeit, Begriff und Zweck konvergieren als terminale Attraktoren, bleiben jedoch funktional unterschieden: Die erste schließt die Grundbewegung, die anderen benennen ihre noch ausstehende positive Fortbestimmung.","refs":["CL_GB18_41:RMD-07","CL_GB18_43:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_11:CGD-01","text":"Kräfte, Materien, Bewegung, Lebendigkeit und wissenschaftliche Hypothesen bleiben lokale Demonstrationen; auf aktueller Ebene tragen sie nur die Diagnose, dass Benennung und Teilkausalität keine immanente Erklärung erzeugen.","refs":["CL_GB18_43:CGD-01","CL_GB18_41:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:CGD-02","text":"Die speziellen Sequenzen von Wesen, Materie und Inhalt sowie die Zweiheit in der vollständigen Grundbeziehung bleiben lokale Mechaniken; global zählt ihre Umcodierung äußerer Gegenpole in Funktionsstellen einer Einheit.","refs":["CL_GB18_42:CGD-02","CL_GB18_44:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:CGD-03","text":"Nach oben skaliert die reziproke Vermittlung: Grund und Bedingung, Form und Inhalt sowie Grund und Begründetes werden als verschiedene Phasen derselben Selbstbeziehung lesbar.","refs":["CL_GB18_41:CGD-04","CL_GB18_44:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:CGD-04","text":"Die lokale Reversibilität des formellen Grundes skaliert nicht als endgültige Lösung, sondern als eine Seite des globalen Dilemmas zwischen leerer Inhaltsidentität und äußerlicher Inhaltsdifferenz.","refs":["CL_GB18_42:CGD-04","CL_GB18_43:XD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:CGD-05","text":"Die positive Bestimmung des Begriffs und der Zweckform wird nicht auf die aktuelle Ebene übertragen; global wirksam ist ihre negative Funktion als Maßstab einer noch nicht eingelösten Zureichendheit.","refs":["CL_GB18_43:CGD-05","CL_GB18_41:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:CGD-06","text":"Die absolute negative Identität schließt die Grund-Bedingungs-Architektur, darf aber nicht zu einer vollständigen Schließung des umfassenderen Systems hochskaliert werden.","refs":["CL_GB18_44:RMD-05","CL_GB18_44:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_11:GNX-01","text":"Ausgeschlossen ist jede Ontologie, die unmittelbares Sein, Materie oder Bestimmtheit als vor ihrer Vermittlung wahre Gegebenheit fixiert.","refs":["CL_GB18_41:GNX-01","CL_GB18_42:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-02","text":"Ausgeschlossen ist jedes Modell, das unabhängige Terme voraussetzt und ihre Beziehung erst nachträglich konstruiert.","refs":["CL_GB18_41:DBN-01","CL_GB18_42:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-03","text":"Ausgeschlossen ist die Reduktion des Widerspruchs auf eine subjektive oder sprachliche Störung, weil damit das Bewegungsprinzip der Vermittlung entfiele.","refs":["CL_GB18_41:GNX-02","CL_GB18_41:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-04","text":"Ausgeschlossen ist eine starre Form-Materie-Trennung, in der Form von außen bestimmt oder Materie als unabhängiges Substrat fungiert.","refs":["CL_GB18_42:GNX-01","CL_GB18_41:GNX-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-05","text":"Ausgeschlossen ist eine lineare Kausal- oder Grundordnung, deren lokale Ursachen oder feste Rollen die Einheit des Erklärten erschöpfen sollen.","refs":["CL_GB18_41:GNX-05","CL_GB18_42:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-06","text":"Ausgeschlossen ist, dass Umbenennung, Abstraktion oder institutionelle Anerkennung eines Inhalts bereits Erklärung oder ontologische Priorität erzeugt.","refs":["CL_GB18_43:GNX-01","CL_GB18_43:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-07","text":"Ausgeschlossen sind sowohl ein ruhendes Unbedingtes als auch ein Begriff, der lediglich als zusätzlicher Grund in das Feld konkurrierender Gründe eintritt.","refs":["CL_GB18_44:GNX-03","CL_GB18_43:DBN-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_11:DBN-01","text":"Falsch sein muss eine unmittelbare oder absolute Einheit, die keine Entzweiung, Negation und Rückkehr durch ihre eigenen Bestimmungen enthält.","refs":["CL_GB18_42:DBN-01","CL_GB18_44:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:DBN-02","text":"Falsch sein muss die Annahme, ein Grund könne zugleich inhaltsgleich mit dem Begründeten bleiben und dessen konkrete Differenz ohne immanente Vermittlung hervorbringen.","refs":["CL_GB18_43:DBN-01","CL_GB18_43:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:DBN-03","text":"Falsch sein muss ein Grund, der einen erklärenden Überschuss beansprucht, obwohl der eigentümliche Zusatzinhalt des Begründeten außerhalb seiner Hervorbringung liegt.","refs":["CL_GB18_42:GNX-05","CL_GB18_43:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:DBN-04","text":"Falsch sein muss jede endgültige Begründung, deren Rollenverteilung von einem äußerlichen Dritten abhängt, ohne dieses Dritte selbst immanent bestimmen zu können.","refs":["CL_GB18_43:DBN-03","CL_GB18_43:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:DBN-05","text":"Falsch sein muss die Gleichsetzung von Anzahl, Plausibilität oder anerkannter Wesentlichkeit der Gründe mit einer Rekonstruktion der Sache.","refs":["CL_GB18_43:GNX-05","CL_GB18_43:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:DBN-06","text":"Falsch sein muss ein äußerer Standpunkt, von dem aus Grund, Bedingung, Form und Inhalt unabhängig fixiert oder abschließend verteilt werden könnten.","refs":["CL_GB18_42:BSA-02","CL_GB18_44:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_11:BSA-01","text":"Unverfügbar bleibt ein absoluter Anfang, dessen Ursprünglichkeit nicht erst durch die rückkehrende Vermittlung erzeugt wird.","refs":["CL_GB18_41:BSA-01","CL_GB18_44:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSA-02","text":"Unverfügbar bleibt ein Außen der Vermittlung; weder Sache noch Grund noch interpretierende Instanz können sich außerhalb der erzeugenden Relation fundieren.","refs":["CL_GB18_44:BSA-01","CL_GB18_42:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSA-03","text":"Unverfügbar bleibt ein letzter isolierter Grund, weil jede solche Fixierung Umkehrung, konkurrierende Rücksichten oder einen weiteren Bedingungsanspruch hervorruft.","refs":["CL_GB18_43:BSA-02","CL_GB18_43:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSA-04","text":"Die tiefste strukturierende Abwesenheit ist die positive Gestalt immanenter Zureichendheit: Begriff und Zweck wirken als notwendige, aber nicht verfügbare Vollendungsformen.","refs":["CL_GB18_43:BSA-03","CL_GB18_41:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_11:XD-01","text":"Widerspruch erzeugt Grund, statt von ihm beseitigt zu werden: Erst die Selbstaufhebung isolierter Bestimmtheit macht Selbstfundierung als reale Vermittlung möglich.","refs":["MC_GB18_L1_11:GA-02","MC_GB18_L1_11:GA-04","CL_GB18_41:AS-B02","CL_GB18_41:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-02","text":"Die formale Geschlossenheit des Grundes wird durch die Kritik realer Erklärung umgekehrt: Inhaltsgleichheit sichert Reversibilität, beweist aber gerade deshalb noch keine erklärende Zureichendheit.","refs":["MC_GB18_L1_11:GA-06","MC_GB18_L1_11:GA-07","CL_GB18_42:XD-05","CL_GB18_43:XD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-03","text":"Äußerlichkeit besitzt einen doppelten Status: Als erzeugte Erscheinungsform ist sie ein notwendiges Moment negativer Identität; als unerzeugte Kopplung verschiedener Inhalte ist sie der Defekt realer Begründung.","refs":["MC_GB18_L1_11:GA-07","MC_GB18_L1_11:GA-08","CL_GB18_44:XD-03","CL_GB18_43:DBN-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-04","text":"Unendliches Raisonnement und Bedingungsregress sind zwei Eskalationen derselben falschen Voraussetzung selbständiger Terme: Der eine vervielfacht Gründe, der andere Bedingungen, ohne ihre Form zu transformieren.","refs":["MC_GB18_L1_11:GA-03","MC_GB18_L1_11:GA-11","CL_GB18_43:RLE-02","CL_GB18_44:XD-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-05","text":"Die rückwirkende Setzung einer Voraussetzung ist nur dann legitim, wenn sie ihren eigenen Ableitungsweg mitrekonstruiert; andernfalls verkehrt epistemische Nachträglichkeit sich in einen fingierten ontologischen Vorrang.","refs":["MC_GB18_L1_11:GA-01","MC_GB18_L1_11:GA-09","CL_GB18_43:GA-07","CL_GB18_44:BSD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-06","text":"Institutionalisierte oder wissenschaftliche Grundansprüche erscheinen als stabilisierte Selektionsoperationen, sofern ihre Priorisierung weder den Ursprung noch die Reichweite des gewählten Inhalts immanent ausweist.","refs":["MC_GB18_L1_11:GA-09","MC_GB18_L1_11:GA-12","CL_GB18_43:BSD-04","CL_GB18_43:ALT-B03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-07","text":"Das absolut Unbedingte und der Begriff dürfen nicht gleichgesetzt werden: Jenes transformiert die Grund-Bedingungs-Relation in negative Identität, dieser bezeichnet die noch ausstehende Aufhebung isolierender Grundformen.","refs":["MC_GB18_L1_11:GA-10","MC_GB18_L1_11:GA-11","CL_GB18_44:BSA-03","CL_GB18_43:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_11:BSD-01","text":"Ontologisch erscheint Realität als rekursive Selbstvermittlung, in der Bestimmungen nur bestehen, indem sie ihre Selbständigkeit verlieren und als Momente einer erzeugten Einheit zurückkehren.","refs":["CL_GB18_41:BSD-01","CL_GB18_42:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-02","text":"Epistemisch wird Erklärung von der Zuordnung eines Grundes zur Rekonstruktion der Operationen verschoben, durch die Inhalt, Differenz und Verknüpfung gemeinsam hervorgebracht werden.","refs":["CL_GB18_42:BSD-03","CL_GB18_44:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-03","text":"Zeit ist rückläufig und rekursiv: Was als Anfang oder Voraussetzung erscheint, erhält seinen Status erst aus der Bewegung, die auf es zurückkommt und es setzt.","refs":["CL_GB18_41:BSD-03","CL_GB18_44:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-04","text":"Kausalität wird hierarchisiert: Teilursachen behalten lokale Geltung, verlieren aber jeden Anspruch, die Einheit und konkrete Verknüpfung des Erklärten abschließend zu erzeugen.","refs":["CL_GB18_41:BSD-04","CL_GB18_44:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-05","text":"Das Subjekt verliert die Stellung eines souveränen Begründers und erscheint zugleich als Ort spekulativer Vermittlung sowie als Träger selektiver Grundpraktiken.","refs":["CL_GB18_41:HSI-02","CL_GB18_43:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-06","text":"Institutionelle und argumentative Autorität wird als operative Stabilisierung einer Grundverteilung lesbar; Geltung beweist weder ontologischen Vorrang noch immanente Notwendigkeit.","refs":["CL_GB18_43:BSD-04","CL_GB18_43:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-07","text":"Die terminale Position ist asymmetrisch: Negative Identität schließt den Regress der Grundbeziehung, während die positive Einheit von Begriff und Zweck als nächste, nicht vollzogene Transformationsstufe bestehen bleibt.","refs":["CL_GB18_44:RLE-04","CL_GB18_41:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_11:RLE-01","text":"Die Grundschleife lautet: Unmittelbarkeit wird als gesetzt erkannt, erzeugt den Rückgang in den Grund und kehrt als vermittelte Unmittelbarkeit wieder.","refs":["CL_GB18_41:RLE-01","CL_GB18_44:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-02","text":"Form und Materie negieren ihre Selbständigkeit, setzen Inhalt frei, und der Inhalt kehrt als Bestimmtheit des Grundes in die Formbewegung zurück.","refs":["CL_GB18_42:RLE-01","CL_GB18_42:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-03","text":"Der Erklärungszyklus eskaliert von Inhaltsidentität über reale Differenz und Grundlage zu selektierbaren Gründen, deren Konkurrenz das unendliche Raisonnement erzeugt.","refs":["CL_GB18_43:RLE-02","CL_GB18_43:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-04","text":"Grund und Bedingung bilden eine rekursive Erfassungsschleife: Der Grund setzt seine Voraussetzung gegen sich, nimmt sie als eigenes Moment auf und reproduziert die Differenz innerhalb seiner Einheit.","refs":["CL_GB18_44:RLE-01","CL_GB18_44:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-05","text":"Jeder Fluchtversuch aus einem Defekt reproduziert ihn auf höherer Ebene: Tautologie wird Äußerlichkeit, Äußerlichkeit Konkurrenz und äußere Bedingtheit regressierende Voraussetzung.","refs":["CL_GB18_43:RLE-02","CL_GB18_44:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-06","text":"Negative Identität ist der terminale Attraktor, weil sie Differenz weder verselbständigt noch auslöscht, sondern als notwendige Selbstentzweiung der Einheit reproduziert.","refs":["CL_GB18_44:GA-08","CL_GB18_44:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-07","text":"Zureichende Einheit ist der offene Attraktor: Jede mechanische, formale oder partielle Fixierung löst eine neue Vermittlungsstufe aus, ohne Begriff und Zweck bereits positiv zu realisieren.","refs":["CL_GB18_41:RLE-05","CL_GB18_43:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_11:FGS-B01","text":"Unmittelbare Bestimmtheit → Entdeckung ihres Gesetztseins → Verlust ontologischer Ursprünglichkeit.","refs":["CL_GB18_41:GA-01","CL_GB18_44:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B02","text":"Gesetztsein → immanente Negation → Widerspruch → Selbstaufhebung isolierter Bestimmtheit.","refs":["CL_GB18_41:FGS-B02","CL_GB18_41:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B03","text":"Selbstaufhebung → negative Identität → Grund als erzeugte Selbstvermittlung statt positiver Grundlage.","refs":["CL_GB18_41:FGS-B03","CL_GB18_41:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B04","text":"Form-Materie-Differenz → wechselseitige Voraussetzung → Aufhebung ihrer Selbständigkeit → Inhalt als gesetzte Einheit.","refs":["CL_GB18_42:FGS-B03","CL_GB18_42:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B05","text":"Inhalt + reversible Formpositionen → formeller Grund → geschlossene Inhaltsidentität ohne erklärende Differenz.","refs":["CL_GB18_42:GA-05","CL_GB18_43:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B06","text":"Flucht in Inhaltsdifferenz → realer Grund → eigentümlicher Zusatzinhalt → Grundlage statt vollständiger Hervorbringung.","refs":["CL_GB18_43:GA-02","CL_GB18_43:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B07","text":"Grundlage + konkrete Vielbestimmtheit → äußere Rollenzuweisung → reversible und konkurrierende Gründe → unendliches Raisonnement.","refs":["CL_GB18_43:GA-06","CL_GB18_43:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B08","text":"Grund setzt Bedingung voraus → Bedingung wird als eigenes Ansichsein erkannt → äußere Zweiheit wird zum Selbstunterschied.","refs":["CL_GB18_44:XD-01","CL_GB18_44:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B09","text":"Selbstunterschied → negative Identität → absolut Unbedingtes → terminale Aufhebung des Regresses bei fortbestehender Forderung nach Begriff und Zweck.","refs":["CL_GB18_44:FGS-B05","CL_GB18_41:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_11:AFM-B01","text":"Scheinbare Unmittelbarkeit → Nachweis des Gesetztseins → immanente Negativität.","refs":["CL_GB18_41:AFM-B01","CL_GB18_41:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B02","text":"Immanente Negativität → Widerspruch → negative Einheit → Grund als Selbstvermittlung.","refs":["CL_GB18_41:AFM-B02","CL_GB18_41:AFM-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B03","text":"Grundbewegung → Form-Materie-Entgegensetzung → wechselseitige Voraussetzung → Inhalt.","refs":["CL_GB18_42:AFM-B01","CL_GB18_42:AFM-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B04","text":"Inhalt → formeller Grund → reversible Inhaltsidentität → Tautologie der Erklärung.","refs":["CL_GB18_42:AFM-B05","CL_GB18_43:AFM-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B05","text":"Reale Inhaltsdifferenz → Grundlage → nicht erzeugte Mannigfaltigkeit → äußere Grundzuteilung.","refs":["CL_GB18_43:AFM-B03","CL_GB18_43:AFM-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B06","text":"Äußere Grundzuteilung → konkurrierende Rechtfertigungen → Umkehrbarkeit → unabschließbares Raisonnement.","refs":["CL_GB18_43:AFM-B05","CL_GB18_43:AFM-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B07","text":"Krise isolierter Gründe → Rekonstruktion von Bedingung und Voraussetzung → negative Identität des Unbedingten.","refs":["CL_GB18_43:AFM-B07","CL_GB18_44:AFM-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B08","text":"Schließung der Grundform → Begriff und Zweck als nicht realisierte Fortbestimmung zureichender Einheit.","refs":["CL_GB18_43:GA-10","CL_GB18_41:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_11:MME-01","text":"Identität und Widerspruch werden aus einer Opposition in ein Produktionsverhältnis überführt: Identität besteht nur als Einheit einer von ihr hervorgebrachten Negation.","refs":["CL_GB18_41:MME-01","CL_GB18_41:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-02","text":"Grund und Ursache werden getrennt: Ursache bezeichnet lokale Hervorbringung, Grund die immanente Einheit, durch welche Teilbestimmungen überhaupt zusammengehören.","refs":["CL_GB18_41:MME-03","CL_GB18_41:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-03","text":"Form, Materie und Inhalt werden von getrennten Bestandteilen zu Mutationsphasen einer einzigen negativen Vermittlung umkartiert.","refs":["CL_GB18_42:MME-01","CL_GB18_42:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-04","text":"Zureichendheit wird von formaler Geschlossenheit und kausalem Überschuss auf die immanente Erzeugung konkreter Differenz und Verknüpfung umgestellt.","refs":["CL_GB18_42:MME-04","CL_GB18_43:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-05","text":"Das Unbedingte wird von einem jenseitigen Endpunkt zu einer Bewegungsform, die Bedingtheit als eigenen Selbstunterschied produziert und zurücknimmt.","refs":["CL_GB18_44:MME-02","CL_GB18_44:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-06","text":"Begründung wird als Praxis der Auswahl, Priorisierung und möglichen Legitimation sichtbar; ihre Geltung ist von der Wahrheit der Sache zu unterscheiden.","refs":["CL_GB18_43:ALT-B03","CL_GB18_43:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-07","text":"Angemessene Lektüre muss Kategorien als Operationen ihrer Setzung, Negation, Rollenmutation und Rückkehr verfolgen, statt sie als stabile Entitäten zu inventarisieren.","refs":["CL_GB18_41:MME-05","CL_GB18_42:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_11:ALT-B01","text":"Surface level — Explizit operiert das System mit Widerspruch, Grund, Begründetem, Form, Materie, Inhalt, Bedingung, Unbedingtem, Erklärung und Begriff.","refs":["CL_GB18_41:ALT-B01","CL_GB18_44:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:ALT-B02","text":"Structural level — Setzen, Voraussetzen, Negation, Aufhebung und Rückkehr bilden eine Reflexionsmaschine, in der jede Selbständigkeit zur Funktionsstelle einer vermittelten Totalität wird.","refs":["CL_GB18_41:ALT-B02","CL_GB18_44:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:ALT-B03","text":"Metastrategic level — Das System ersetzt die Suche nach stärkeren Einzelgründen durch die Rekonstruktion der Verteilungen und Vermittlungen, die Grundcharakter überhaupt erzeugen.","refs":["CL_GB18_44:ALT-B03","CL_GB18_43:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:ALT-B04","text":"Ontological / Temporal level — Realität besitzt keinen unvermittelten Ursprung; Anfang, Voraussetzung und Priorität werden erst rückwirkend in einer nichtlinearen Selbstbewegung bestimmt.","refs":["CL_GB18_44:ALT-B04","CL_GB18_42:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem jede erreichte Kategorie durch ihren eigenen Erklärungsanspruch destabilisiert und in eine umfassendere Relation überführt wird.","refs":["CL_GB18_44:ALT-B05","CL_GB18_43:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_11:FL-01","text":"Inhaltsidentität ist für die Einheit von Grund und Begründetem notwendig, erzeugt aber Tautologie; Inhaltsdifferenz ist für Erklärung notwendig, erzeugt aber Äußerlichkeit.","refs":["CL_GB18_42:FL-03","CL_GB18_43:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FL-02","text":"Äußerlichkeit ist zugleich zu überwindender Defekt realer Begründung und notwendige Erscheinungsform der Selbstentzweiung negativer Identität.","refs":["CL_GB18_43:AS-B03","CL_GB18_44:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FL-03","text":"Das absolut Unbedingte beansprucht Schließung der Grundbewegung, während Begriff und Zweck als positive Formen zureichender Einheit ausdrücklich unterbestimmt bleiben.","refs":["CL_GB18_44:XD-05","CL_GB18_43:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FL-04","text":"Die Kritik äußerer Grundzuteilung benötigt ein Kriterium legitimer Vermittlung, kann dieses aber weder aus dem ausgewählten Grund noch aus einem zusätzlichen Dritten gewinnen.","refs":["CL_GB18_43:FL-02","CL_GB18_43:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FL-05","text":"Die Totalität muss ihre Bedingung voraussetzen und zugleich als eigenes Moment setzen; eine vollständige Neutralisierung dieser Spannung würde ihre Selbstbewegung aufheben.","refs":["CL_GB18_44:FL-01","CL_GB18_44:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MP-01","text":"Der Grund mutiert von positiver oder formaler Grundlage über unzureichende Grundlage zur Operation, die ihre eigene Bedingtheit hervorbringt.","refs":["CL_GB18_43:MP-02","CL_GB18_44:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MP-02","text":"Inhalt mutiert vom Resultat aufgehobener Form-Materie-Differenz zur Grundidentität und anschließend zum Index einer Restäußerlichkeit, die weitere Vermittlung erzwingt.","refs":["CL_GB18_42:MP-02","CL_GB18_42:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MP-03","text":"Das Unbedingte mutiert von relativer Selbständigkeit der Bedingung zur negativen Identität, welche Relativität als aufgehobenes Moment in sich trägt.","refs":["CL_GB18_44:MP-02","CL_GB18_44:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MP-04","text":"Erklärung mutiert von der Kritik tautologischer Benennung zur Forderung nach immanenter Erzeugung der gesamten konkreten Verknüpfung.","refs":["CL_GB18_43:MP-01","CL_GB18_43:MME-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_11:HSI-01","text":"Realität erscheint als reflexive Maschine, die keine äußeren Fundamente verarbeitet, sondern Voraussetzungen erzeugt, differenziert und als eigene Momente zurücknimmt.","refs":["CL_GB18_44:HSI-01","CL_GB18_41:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:HSI-02","text":"Das Subjekt ist kein souveräner Ursprung, sondern ein Knoten, an dem selektive Grundpraxis und das spekulative Festhalten widersprüchlicher Übergänge zusammentreffen.","refs":["CL_GB18_42:HSI-02","CL_GB18_43:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:HSI-03","text":"Zeit ist eine Spirale rückwirkender Setzung: Das Vorausgesetzte erscheint früher, wird aber erst durch die spätere Vermittlung als Voraussetzung konstituiert.","refs":["CL_GB18_44:HSI-03","CL_GB18_41:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:HSI-04","text":"Strategisch bleibt keine Flucht in einen ersten oder stärkeren Grund; möglich ist nur die Navigation jener Mutationen, durch die Gründe, Bedingungen und Inhalte ihre Funktion wechseln.","refs":["CL_GB18_44:HSI-04","CL_GB18_43:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_11:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von unmittelbarer Bestimmtheit über negative Vermittlung, Form, Inhalt und Grund bis zum absolut Unbedingten zu rekonstruieren.","refs":["CL_GB18_41:MRT-B01","CL_GB18_44:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MRT-B02","text":"Die Architektur ist kohärent, sofern negative Identität nicht als unterschiedslose Gleichheit und Voraussetzung nicht als zeitlich vorliegende Gegebenheit gelesen wird.","refs":["CL_GB18_41:MRT-B03","CL_GB18_44:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MRT-B03","text":"Ihre stärkste Verdichtung liegt in der Verbindung von Widerspruch, Selbstgrund, Kritik formaler und realer Erklärung sowie Internalisierung der Bedingung.","refs":["CL_GB18_41:MRT-B04","CL_GB18_43:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MRT-B04","text":"Unterbestimmt bleiben die positive Gestalt des Begriffs, die Zweckform und das Kriterium, durch das legitime Vermittlung von äußerer Projektion unterschieden werden könnte.","refs":["CL_GB18_43:MRT-B03","CL_GB18_43:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MRT-B05","text":"Die Rekonstruktion bewahrt die wirkliche Bewegung nur, wenn formale Geschlossenheit, reale Äußerlichkeit und absolute negative Identität nicht zu einer einzigen undifferenzierten Lösung zusammengezogen werden.","refs":["CL_GB18_42:MRT-B04","CL_GB18_43:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MRT-B06","text":"Der axiomatischen Reduktion widersteht die produktive Doppelstellung der Äußerlichkeit: Sie ist zugleich Defekt unzureichender Begründung und notwendige Artikulation einer Einheit, die nur durch Selbstentzweiung besteht.","refs":["CL_GB18_44:FL-02","CL_GB18_44:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T123944562284Z_98f93bf4","language_code":"en","language_name":"English","title":"Gb18 L1 11","source_sha256":"0dae2a336ea8e358c0bb8acbf00e98f4067bc4281e177f77ec45df82d6224a0a","sha256":"c8c2e1b7770222f60235022ae0b9d90e3061b008463f2ac199181b623827bde3","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:39:44.563249+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_11:AS-01","text":"The system determines how ground can explain without being posited as a positively pre-existing origin, external bearer, or mere duplication of what is grounded.","refs":["CL_GB18_41:AS-B01","CL_GB18_43:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-02","text":"Its global thesis is that determinacy arises only through immanent negativity and that unity must therefore be conceived as negative self-difference rather than as resting identity.","refs":["CL_GB18_41:AS-B02","CL_GB18_44:AS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-03","text":"Grounding must preserve identity between ground and what is grounded while at the same time producing an explanatory difference; every one-sided fixation of either of these moments destroys its adequacy.","refs":["CL_GB18_42:GA-05","CL_GB18_43:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-04","text":"The flight from formal identity of content into real difference of content produces externality and compels the system to redefine explanation as immanent mediation of the concrete connection.","refs":["CL_GB18_43:GA-02","CL_GB18_43:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-05","text":"Ground, form, content, and condition are therefore transformed into functions of a self-mediation whose closure consists not in finding a first term but in transforming their relation.","refs":["CL_GB18_44:AS-02","CL_GB18_44:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-06","text":"The movement is recursive and spiral-shaped: every mediation attained releases a new difference whose crisis reconfigures the preceding unity at a higher level.","refs":["CL_GB18_41:AS-B08","CL_GB18_43:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-07","text":"Tautology escalates into externality, externality into competing grounds, and conditionedness into regress; both escalations end only through a mutation of the form of ground itself.","refs":["CL_GB18_43:RLE-02","CL_GB18_44:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AS-08","text":"The closure is double: the unconditioned closes the ground-condition relation as negative self-movement, while concept and purpose remain open as forms of adequate unity not yet positively developed.","refs":["CL_GB18_41:BSA-04","CL_GB18_43:AS-B08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_11:GA-01","text":"[Persistent] Immediacy possesses no original truth; it exists only as a posited, sublated, or retroactively presupposed result of mediation.","refs":["CL_GB18_41:GA-01","CL_GB18_44:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-02","text":"[Persistent] Identity is negative unity: it preserves itself not through exclusion, but through the production, negation, and withdrawal of its own difference.","refs":["CL_GB18_41:GA-03","CL_GB18_44:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-03","text":"[Persistent] No moment bears its ground-character in isolation; determinations are determined exclusively as relational functions of a mediated totality.","refs":["CL_GB18_41:GA-05","CL_GB18_44:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-04","text":"[Mutating] Ground mutates from the self-grounding of the posited through reversible form-positions and partial foundation into reflection that posits its own presupposition as condition.","refs":["CL_GB18_41:GA-04","CL_GB18_43:GA-05","CL_GB18_44:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-05","text":"[Mutating] Form and matter lose their independence in content; content subsequently loses its repose and becomes the countervailing form-content movement of ground.","refs":["CL_GB18_42:GA-01","CL_GB18_42:GA-04","CL_GB18_44:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-06","text":"[Emergent] Adequate explanation must surpass both formal tautology and real externality by producing identity, difference, and concrete connection from the same movement.","refs":["CL_GB18_43:XD-01","CL_GB18_43:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-07","text":"[Persistent] Difference may neither be effaced nor rendered independent; it remains preserved as necessary residual difference or self-difference within unity.","refs":["CL_GB18_42:RMD-06","CL_GB18_44:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-08","text":"[Attractor] Externality is repeatedly recoded into immanent mediation, but remains effective as a necessary form of appearance of self-division.","refs":["CL_GB18_42:GA-06","CL_GB18_44:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-09","text":"[Emergent] Where concrete multideterminacy is not immanently mediated, grounding becomes a selective practice that prioritizes partial contents and can stabilize this prioritization as necessity.","refs":["CL_GB18_43:GA-06","CL_GB18_43:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-10","text":"[Attractor] Concept and purpose designate the required form of adequate unity, but may not appear as further individual grounds within the superseded form of ground.","refs":["CL_GB18_41:GA-08","CL_GB18_43:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-11","text":"[Terminal] The absolutely unconditioned ends the regress of conditions as negative self-movement, but does not yet provide a positive presentation of the concept or the form of purpose.","refs":["CL_GB18_44:GA-09","CL_GB18_44:BSA-03","CL_GB18_43:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GA-12","text":"[Attractor] Explanation is adequate only as reconstruction of the immanent connection of a thing, not as accumulation, designation, or hierarchical ordering of isolated grounds.","refs":["CL_GB18_43:MME-05","CL_GB18_44:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_11:RMD-01","text":"Immediacy recurs functionally, but mutates from the untrue beginning into the material of mediation and finally into the retroactively posited result.","refs":["CL_GB18_41:RMD-03","CL_GB18_44:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-02","text":"Contradiction remains the principle of movement, but is absorbed from the explicit instability of finite determinations into the negative identity of the entire movement of ground.","refs":["CL_GB18_41:RMD-02","CL_GB18_44:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-03","text":"Ground shifts from generated self-ground, through reversible presentation of content and inadequate foundation, to self-reflection that produces conditionedness as its own moment.","refs":["CL_GB18_41:RMD-05","CL_GB18_43:MP-02","CL_GB18_44:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-04","text":"Form mutates from determining activity into the structure of reflection of ground and thereby loses its initial opposition to matter, essence, and content.","refs":["CL_GB18_42:RMD-01","CL_GB18_42:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-05","text":"Matter moves from the negative limit of form, through formed determination of content, to condition as posited being-in-itself; an independent substrate-status disappears completely.","refs":["CL_GB18_41:GA-09","CL_GB18_44:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-06","text":"Content arises as the withdrawal of the form-matter difference, becomes ground-identity, and finally recurs as residual externality, separating formal closure from real adequacy.","refs":["CL_GB18_42:RMD-03","CL_GB18_42:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-07","text":"Adequacy recurs with reversed valence: formal identity of content initially counts as closure and subsequently becomes a deficiency precisely because explanatory difference is lacking.","refs":["CL_GB18_42:GA-08","CL_GB18_42:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RMD-08","text":"Absolute necessity, concept, and purpose converge as terminal attractors, yet remain functionally distinct: the first closes the movement of ground, the others designate its still-outstanding positive continuation.","refs":["CL_GB18_41:RMD-07","CL_GB18_43:RMD-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_11:CGD-01","text":"Forces, matters, movement, vitality, and scientific hypotheses remain local demonstrations; at the current level, they support only the diagnosis that designation and partial causality produce no immanent explanation.","refs":["CL_GB18_43:CGD-01","CL_GB18_41:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:CGD-02","text":"The special sequences of essence, matter, and content, as well as the duality in the complete ground-relation, remain local mechanics; globally, what counts is their recoding of external opposites into functional positions of a unity.","refs":["CL_GB18_42:CGD-02","CL_GB18_44:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:CGD-03","text":"Reciprocal mediation scales upward: ground and condition, form and content, as well as ground and what is grounded, become legible as different phases of the same self-relation.","refs":["CL_GB18_41:CGD-04","CL_GB18_44:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:CGD-04","text":"The local reversibility of formal ground does not scale as a final solution, but as one side of the global dilemma between empty identity of content and external difference of content.","refs":["CL_GB18_42:CGD-04","CL_GB18_43:XD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:CGD-05","text":"The positive determination of the concept and the form of purpose is not transferred to the current level; globally effective is their negative function as the measure of an adequacy not yet fulfilled.","refs":["CL_GB18_43:CGD-05","CL_GB18_41:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:CGD-06","text":"Absolute negative identity closes the ground-condition architecture, but may not be scaled up into a complete closure of the more comprehensive system.","refs":["CL_GB18_44:RMD-05","CL_GB18_44:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_11:GNX-01","text":"Excluded is every ontology that fixes immediate being, matter, or determinacy as a true givenness prior to their mediation.","refs":["CL_GB18_41:GNX-01","CL_GB18_42:GNX-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-02","text":"Excluded is every model that presupposes independent terms and constructs their relation only afterward.","refs":["CL_GB18_41:DBN-01","CL_GB18_42:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-03","text":"Excluded is the reduction of contradiction to a subjective or linguistic disturbance, because this would eliminate the principle of movement of mediation.","refs":["CL_GB18_41:GNX-02","CL_GB18_41:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-04","text":"Excluded is a rigid form-matter separation in which form is determined from outside or matter functions as an independent substrate.","refs":["CL_GB18_42:GNX-01","CL_GB18_41:GNX-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-05","text":"Excluded is a linear causal or ground-order whose local causes or fixed roles are supposed to exhaust the unity of what is explained.","refs":["CL_GB18_41:GNX-05","CL_GB18_42:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-06","text":"Excluded is the claim that renaming, abstraction, or institutional recognition of a content already produces explanation or ontological priority.","refs":["CL_GB18_43:GNX-01","CL_GB18_43:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:GNX-07","text":"Excluded are both a resting unconditioned and a concept that merely enters the field of competing grounds as an additional ground.","refs":["CL_GB18_44:GNX-03","CL_GB18_43:DBN-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_11:DBN-01","text":"False must be an immediate or absolute unity that contains no division, negation, and return through its own determinations.","refs":["CL_GB18_42:DBN-01","CL_GB18_44:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:DBN-02","text":"False must be the assumption that a ground can remain identical in content with what is grounded and at the same time produce its concrete difference without immanent mediation.","refs":["CL_GB18_43:DBN-01","CL_GB18_43:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:DBN-03","text":"False must be a ground that claims an explanatory surplus although the peculiar additional content of what is grounded lies outside its production.","refs":["CL_GB18_42:GNX-05","CL_GB18_43:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:DBN-04","text":"False must be every final grounding whose distribution of roles depends on an external third without being able to determine this third itself immanently.","refs":["CL_GB18_43:DBN-03","CL_GB18_43:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:DBN-05","text":"False must be the equation of the number, plausibility, or acknowledged essentiality of grounds with a reconstruction of the thing.","refs":["CL_GB18_43:GNX-05","CL_GB18_43:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:DBN-06","text":"False must be an external standpoint from which ground, condition, form, and content could be fixed independently or distributed conclusively.","refs":["CL_GB18_42:BSA-02","CL_GB18_44:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_11:BSA-01","text":"Unavailable remains an absolute beginning whose originality is not first produced through returning mediation.","refs":["CL_GB18_41:BSA-01","CL_GB18_44:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSA-02","text":"Unavailable remains an outside of mediation; neither thing, ground, nor interpreting instance can ground itself outside the productive relation.","refs":["CL_GB18_44:BSA-01","CL_GB18_42:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSA-03","text":"Unavailable remains a final isolated ground, because every such fixation produces reversal, competing respects, or a further claim of condition.","refs":["CL_GB18_43:BSA-02","CL_GB18_43:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSA-04","text":"The deepest structuring absence is the positive shape of immanent adequacy: concept and purpose operate as necessary but unavailable forms of completion.","refs":["CL_GB18_43:BSA-03","CL_GB18_41:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_11:XD-01","text":"Contradiction produces ground instead of being eliminated by it: only the self-sublation of isolated determinacy makes self-grounding possible as real mediation.","refs":["MC_GB18_L1_11:GA-02","MC_GB18_L1_11:GA-04","CL_GB18_41:AS-B02","CL_GB18_41:GA-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-02","text":"The formal closure of ground is reversed through the critique of real explanation: identity of content secures reversibility, but precisely for that reason does not yet prove explanatory adequacy.","refs":["MC_GB18_L1_11:GA-06","MC_GB18_L1_11:GA-07","CL_GB18_42:XD-05","CL_GB18_43:XD-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-03","text":"Externality possesses a double status: as a produced form of appearance, it is a necessary moment of negative identity; as an unproduced coupling of different contents, it is the defect of real grounding.","refs":["MC_GB18_L1_11:GA-07","MC_GB18_L1_11:GA-08","CL_GB18_44:XD-03","CL_GB18_43:DBN-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-04","text":"Infinite ratiocination and regress of conditions are two escalations of the same false presupposition of independent terms: the one multiplies grounds, the other conditions, without transforming their form.","refs":["MC_GB18_L1_11:GA-03","MC_GB18_L1_11:GA-11","CL_GB18_43:RLE-02","CL_GB18_44:XD-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-05","text":"The retroactive positing of a presupposition is legitimate only if it reconstructs its own path of derivation; otherwise epistemic belatedness turns into a feigned ontological priority.","refs":["MC_GB18_L1_11:GA-01","MC_GB18_L1_11:GA-09","CL_GB18_43:GA-07","CL_GB18_44:BSD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-06","text":"Institutionalized or scientific claims to ground appear as stabilized operations of selection insofar as their prioritization does not immanently demonstrate either the origin or the scope of the selected content.","refs":["MC_GB18_L1_11:GA-09","MC_GB18_L1_11:GA-12","CL_GB18_43:BSD-04","CL_GB18_43:ALT-B03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_11:XD-07","text":"The absolutely unconditioned and the concept may not be equated: the former transforms the ground-condition relation into negative identity, while the latter designates the still-outstanding sublation of isolating forms of ground.","refs":["MC_GB18_L1_11:GA-10","MC_GB18_L1_11:GA-11","CL_GB18_44:BSA-03","CL_GB18_43:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_11:BSD-01","text":"Ontologically, reality appears as recursive self-mediation, in which determinations exist only by losing their independence and returning as moments of a produced unity.","refs":["CL_GB18_41:BSD-01","CL_GB18_42:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-02","text":"Epistemically, explanation is displaced from the assignment of a ground to the reconstruction of the operations through which content, difference, and connection are jointly produced.","refs":["CL_GB18_42:BSD-03","CL_GB18_44:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-03","text":"Time is retrogressive and recursive: what appears as beginning or presupposition receives its status only from the movement that returns to it and posits it.","refs":["CL_GB18_41:BSD-03","CL_GB18_44:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-04","text":"Causality is hierarchized: partial causes retain local validity, but lose every claim to conclusively produce the unity and concrete connection of what is explained.","refs":["CL_GB18_41:BSD-04","CL_GB18_44:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-05","text":"The subject loses the position of a sovereign grounder and appears at once as the locus of speculative mediation and as the bearer of selective practices of grounding.","refs":["CL_GB18_41:HSI-02","CL_GB18_43:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-06","text":"Institutional and argumentative authority becomes legible as the operative stabilization of a distribution of grounds; validity proves neither ontological priority nor immanent necessity.","refs":["CL_GB18_43:BSD-04","CL_GB18_43:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:BSD-07","text":"The terminal position is asymmetrical: negative identity closes the regress of the ground-relation, while the positive unity of concept and purpose remains as the next, unexecuted stage of transformation.","refs":["CL_GB18_44:RLE-04","CL_GB18_41:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_11:RLE-01","text":"The loop of ground is as follows: immediacy is recognized as posited, generates the regress into ground, and returns as mediated immediacy.","refs":["CL_GB18_41:RLE-01","CL_GB18_44:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-02","text":"Form and matter negate their independence, release content, and content returns as the determinacy of ground into the movement of form.","refs":["CL_GB18_42:RLE-01","CL_GB18_42:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-03","text":"The explanatory cycle escalates from identity of content through real difference and foundation to selectable grounds, whose competition produces infinite ratiocination.","refs":["CL_GB18_43:RLE-02","CL_GB18_43:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-04","text":"Ground and condition form a recursive loop of comprehension: ground posits its presupposition over against itself, takes it up as its own moment, and reproduces difference within its unity.","refs":["CL_GB18_44:RLE-01","CL_GB18_44:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-05","text":"Every attempt to flee a defect reproduces it at a higher level: tautology becomes externality, externality competition, and external conditionedness regressing presupposition.","refs":["CL_GB18_43:RLE-02","CL_GB18_44:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-06","text":"Negative identity is the terminal attractor because it neither renders difference independent nor extinguishes it, but reproduces it as the necessary self-division of unity.","refs":["CL_GB18_44:GA-08","CL_GB18_44:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:RLE-07","text":"Adequate unity is the open attractor: every mechanical, formal, or partial fixation triggers a new stage of mediation without already positively realizing concept and purpose.","refs":["CL_GB18_41:RLE-05","CL_GB18_43:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_11:FGS-B01","text":"Immediate determinacy → discovery of its positedness → loss of ontological originality.","refs":["CL_GB18_41:GA-01","CL_GB18_44:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B02","text":"Positedness → immanent negation → contradiction → self-sublation of isolated determinacy.","refs":["CL_GB18_41:FGS-B02","CL_GB18_41:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B03","text":"Self-sublation → negative identity → ground as produced self-mediation rather than positive foundation.","refs":["CL_GB18_41:FGS-B03","CL_GB18_41:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B04","text":"Form-matter difference → reciprocal presupposition → sublation of their independence → content as posited unity.","refs":["CL_GB18_42:FGS-B03","CL_GB18_42:FGS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B05","text":"Content + reversible form-positions → formal ground → closed identity of content without explanatory difference.","refs":["CL_GB18_42:GA-05","CL_GB18_43:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B06","text":"Flight into difference of content → real ground → peculiar additional content → foundation instead of complete production.","refs":["CL_GB18_43:GA-02","CL_GB18_43:AS-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B07","text":"Foundation + concrete multideterminacy → external assignment of roles → reversible and competing grounds → infinite ratiocination.","refs":["CL_GB18_43:GA-06","CL_GB18_43:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B08","text":"Ground presupposes condition → condition is recognized as its own being-in-itself → external duality becomes self-difference.","refs":["CL_GB18_44:XD-01","CL_GB18_44:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FGS-B09","text":"Self-difference → negative identity → absolutely unconditioned → terminal sublation of regress with the continuing demand for concept and purpose.","refs":["CL_GB18_44:FGS-B05","CL_GB18_41:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_11:AFM-B01","text":"Apparent immediacy → demonstration of positedness → immanent negativity.","refs":["CL_GB18_41:AFM-B01","CL_GB18_41:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B02","text":"Immanent negativity → contradiction → negative unity → ground as self-mediation.","refs":["CL_GB18_41:AFM-B02","CL_GB18_41:AFM-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B03","text":"Movement of ground → form-matter opposition → reciprocal presupposition → content.","refs":["CL_GB18_42:AFM-B01","CL_GB18_42:AFM-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B04","text":"Content → formal ground → reversible identity of content → tautology of explanation.","refs":["CL_GB18_42:AFM-B05","CL_GB18_43:AFM-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B05","text":"Real difference of content → foundation → unproduced manifoldness → external allocation of grounds.","refs":["CL_GB18_43:AFM-B03","CL_GB18_43:AFM-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B06","text":"External allocation of grounds → competing justifications → reversibility → unfinishable ratiocination.","refs":["CL_GB18_43:AFM-B05","CL_GB18_43:AFM-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B07","text":"Crisis of isolated grounds → reconstruction of condition and presupposition → negative identity of the unconditioned.","refs":["CL_GB18_43:AFM-B07","CL_GB18_44:AFM-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:AFM-B08","text":"Closure of the form of ground → concept and purpose as unrealized continuation of adequate unity.","refs":["CL_GB18_43:GA-10","CL_GB18_41:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_11:MME-01","text":"Identity and contradiction are transformed from an opposition into a productive relation: identity exists only as unity of a negation produced by it.","refs":["CL_GB18_41:MME-01","CL_GB18_41:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-02","text":"Ground and cause are separated: cause designates local production, ground the immanent unity through which partial determinations belong together in the first place.","refs":["CL_GB18_41:MME-03","CL_GB18_41:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-03","text":"Form, matter, and content are remapped from separate components into mutation-phases of a single negative mediation.","refs":["CL_GB18_42:MME-01","CL_GB18_42:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-04","text":"Adequacy is shifted from formal closure and causal surplus to the immanent production of concrete difference and connection.","refs":["CL_GB18_42:MME-04","CL_GB18_43:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-05","text":"The unconditioned is transformed from a transcendent endpoint into a form of movement that produces and withdraws conditionedness as its own self-difference.","refs":["CL_GB18_44:MME-02","CL_GB18_44:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-06","text":"Grounding becomes visible as a practice of selection, prioritization, and possible legitimation; its validity is to be distinguished from the truth of the thing.","refs":["CL_GB18_43:ALT-B03","CL_GB18_43:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MME-07","text":"An adequate reading must follow categories as operations of their positing, negation, mutation of roles, and return, rather than inventorying them as stable entities.","refs":["CL_GB18_41:MME-05","CL_GB18_42:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_11:ALT-B01","text":"Surface level — The system explicitly operates with contradiction, ground, what is grounded, form, matter, content, condition, the unconditioned, explanation, and concept.","refs":["CL_GB18_41:ALT-B01","CL_GB18_44:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:ALT-B02","text":"Structural level — Positing, presupposing, negation, sublation, and return form a machine of reflection in which every independence becomes a functional position of a mediated totality.","refs":["CL_GB18_41:ALT-B02","CL_GB18_44:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:ALT-B03","text":"Metastrategic level — The system replaces the search for stronger individual grounds with reconstruction of the distributions and mediations that generate ground-character in the first place.","refs":["CL_GB18_44:ALT-B03","CL_GB18_43:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:ALT-B04","text":"Ontological / Temporal level — Reality has no unmediated origin; beginning, presupposition, and priority are determined only retroactively in a nonlinear self-movement.","refs":["CL_GB18_44:ALT-B04","CL_GB18_42:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:ALT-B05","text":"Methodological / Performative level — The presentation enacts its thesis by destabilizing every attained category through its own claim to explanation and transferring it into a more comprehensive relation.","refs":["CL_GB18_44:ALT-B05","CL_GB18_43:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_11:FL-01","text":"Identity of content is necessary for the unity of ground and what is grounded, but produces tautology; difference of content is necessary for explanation, but produces externality.","refs":["CL_GB18_42:FL-03","CL_GB18_43:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FL-02","text":"Externality is at once the defect of real grounding to be overcome and the necessary form of appearance of the self-division of negative identity.","refs":["CL_GB18_43:AS-B03","CL_GB18_44:XD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FL-03","text":"The absolutely unconditioned claims closure of the movement of ground, while concept and purpose explicitly remain underdetermined as positive forms of adequate unity.","refs":["CL_GB18_44:XD-05","CL_GB18_43:FL-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FL-04","text":"The critique of external allocation of grounds requires a criterion of legitimate mediation, but can obtain this neither from the selected ground nor from an additional third.","refs":["CL_GB18_43:FL-02","CL_GB18_43:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:FL-05","text":"The totality must presuppose its condition and at the same time posit it as its own moment; a complete neutralization of this tension would sublate its self-movement.","refs":["CL_GB18_44:FL-01","CL_GB18_44:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MP-01","text":"Ground mutates from positive or formal foundation, through inadequate foundation, into the operation that produces its own conditionedness.","refs":["CL_GB18_43:MP-02","CL_GB18_44:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MP-02","text":"Content mutates from the result of sublated form-matter difference into ground-identity and then into the index of a residual externality that compels further mediation.","refs":["CL_GB18_42:MP-02","CL_GB18_42:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MP-03","text":"The unconditioned mutates from the relative independence of condition into negative identity, which bears relativity within itself as a sublated moment.","refs":["CL_GB18_44:MP-02","CL_GB18_44:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MP-04","text":"Explanation mutates from the critique of tautological designation into the demand for immanent production of the entire concrete connection.","refs":["CL_GB18_43:MP-01","CL_GB18_43:MME-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_11:HSI-01","text":"Reality appears as a reflexive machine that processes no external foundations, but produces, differentiates, and withdraws presuppositions as its own moments.","refs":["CL_GB18_44:HSI-01","CL_GB18_41:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:HSI-02","text":"The subject is not a sovereign origin, but a node at which selective practice of grounding and the speculative retention of contradictory transitions converge.","refs":["CL_GB18_42:HSI-02","CL_GB18_43:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:HSI-03","text":"Time is a spiral of retroactive positing: what is presupposed appears earlier, but is constituted as presupposition only through later mediation.","refs":["CL_GB18_44:HSI-03","CL_GB18_41:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:HSI-04","text":"Strategically, no flight into a first or stronger ground remains; only navigation of those mutations through which grounds, conditions, and contents change their function is possible.","refs":["CL_GB18_44:HSI-04","CL_GB18_43:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_11:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from immediate determinacy through negative mediation, form, content, and ground up to the absolutely unconditioned.","refs":["CL_GB18_41:MRT-B01","CL_GB18_44:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MRT-B02","text":"The architecture is coherent provided that negative identity is not read as undifferentiated equality and presupposition not as a temporally pre-existing givenness.","refs":["CL_GB18_41:MRT-B03","CL_GB18_44:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MRT-B03","text":"Its strongest condensation lies in the connection of contradiction, self-ground, critique of formal and real explanation, and internalization of condition.","refs":["CL_GB18_41:MRT-B04","CL_GB18_43:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MRT-B04","text":"Underdetermined remain the positive shape of the concept, the form of purpose, and the criterion through which legitimate mediation could be distinguished from external projection.","refs":["CL_GB18_43:MRT-B03","CL_GB18_43:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MRT-B05","text":"The reconstruction preserves the actual movement only if formal closure, real externality, and absolute negative identity are not drawn together into a single undifferentiated solution.","refs":["CL_GB18_42:MRT-B04","CL_GB18_43:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_11:MRT-B06","text":"The productive double status of externality resists axiomatic reduction: it is at once the defect of inadequate grounding and the necessary articulation of a unity that exists only through self-division.","refs":["CL_GB18_44:FL-02","CL_GB18_44:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_11@R001","source_variant_id":"canonical:MC_GB18_L1_11:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 11","context":"Chapters 121–132 · Anmerkung 3. · Anmerkung. · a. Form und Wesen. · b. Form und Materie. · c. Form und Inhalt. · a. Der formelle Grund. · Anmerkung. · b. Der reale Grund. · Anmerkung. · c. Der vollständige Grund. · a. Das relativ Unbedingte. · b. Das absolute Unbedingte."},"title_language_code":"en"},{"id":"MC_GB18_L1_12","layer":"MC","title":"Gb18 L1 12","order":12,"parents":["CL_GB18_45","CL_GB18_46","CL_GB18_47","CL_GB18_48"],"revision":"MC_GB18_L1_12@R001","sha256":"1dc26008d60371921e593211d940e5bc58e024c607221fde5e2383db015961c8","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_12:AS-01","text":"Das System löst das Problem, wie Existenz und Bestimmtheit immanent hervorgebracht werden können, ohne einen vorausliegenden Grund, ein eigenschaftsloses Substrat oder eine subjektive Zuschreibung vorauszusetzen.","refs":["CL_GB18_45:AS-B01","CL_GB18_46:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-02","text":"Seine globale Behauptung lautet, dass immanente Negativität sämtliche festen Bestimmungen in Momente einer Selbstvermittlung transformiert und dadurch erst reale Identität erzeugt.","refs":["CL_GB18_45:GA-02","CL_GB18_48:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-03","text":"Äußerlichkeit wird zunächst als fremde Reflexion behandelt, dann in die Bestimmung des Dinges zurückgenommen und schließlich durch die Verselbstständigung der Eigenschaft materiell realisiert.","refs":["CL_GB18_46:RMD-02","CL_GB18_47:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-04","text":"Die Auflösung ursprünglicher Dingheit führt nicht in ontologische Leere, sondern reklassifiziert Erscheinung als Wahrheit einer Existenz, deren Bestand ausschließlich vermittelt ist.","refs":["CL_GB18_47:GA-01","CL_GB18_48:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-05","text":"Das Gesetz stabilisiert den in der Erscheinung erzeugten Inhalt, bleibt aber unwahr, solange es die negative Bewegung seiner eigenen Seiten nicht in sich aufnimmt.","refs":["CL_GB18_48:BAS-03","CL_GB18_48:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-06","text":"Die Argumentform ist dialektisch und rekursiv, weil jede gesetzte Selbstständigkeit ihre Negation erzeugt und als veränderte Vermittlungsform zurückkehrt.","refs":["CL_GB18_45:AS-B06","CL_GB18_48:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-07","text":"Die Bewegung verläuft spiralförmig von vermittelter Unmittelbarkeit über dingliche und materielle Selbstständigkeit zu einer Totalität, die ihre Unterschiede durch Selbstentzweiung erhält.","refs":["CL_GB18_45:AS-B07","CL_GB18_48:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-08","text":"Die Schließung liegt in einer selbstentgegengesetzten Totalität; der Geist bezeichnet deren terminales Kriterium, ohne dass sein Übergang aus der Ding- und Gesetzeslogik vollständig abgeleitet wäre.","refs":["CL_GB18_48:BAS-08","CL_GB18_48:FL-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_12:GA-01","text":"[Persistent] Unmittelbarkeit ist niemals voraussetzungsloser Anfang, sondern die positive Resultatform einer aufgehobenen Vermittlung.","refs":["CL_GB18_45:GA-01","CL_GB18_46:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-02","text":"[Attractor] Immanente Negativität ist der universale Operator, der feste Gestalten auflöst und ihre Auflösung in einen höheren Modus realer Einheit überführt.","refs":["CL_GB18_45:GA-02","CL_GB18_48:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-03","text":"[Persistent] Bestimmtheit besteht nur als Selbstbeziehung durch Anderes; isolierte Identität und äußerlich gleichgültige Differenz sind gleichermaßen unwahr.","refs":["CL_GB18_46:GA-01","CL_GB18_48:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-04","text":"[Mutating] Äußerlichkeit mutiert von scheinbar fremder Sphäre über die eigene Reflexionsbestimmung des Dinges zur wesentlichen Form seines realen Bestehens.","refs":["CL_GB18_45:GA-04","CL_GB18_46:RMD-02","CL_GB18_47:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-05","text":"[Mutating] Grund, Bedingung, Ursache und Gesetz sind keine selbstständigen Fundamente, sondern transitorische Funktionen, die nur durch ihr Verschwinden oder ihre Rückkehr im Begründeten wahr werden.","refs":["CL_GB18_45:GA-03","CL_GB18_48:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-06","text":"[Persistent] Selbstständigkeit bedeutet nicht Unabhängigkeit, sondern negativ vermittelte Erhaltung einer Bestimmung in ihrem Verhältnis zu anderem Bestehen.","refs":["CL_GB18_47:GA-03","CL_GB18_48:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-07","text":"[Mutating] Die Eigenschaft ist das operative Scharnier, an dem relationale Bestimmtheit in selbstständige Materie, gesetzliche Seite und begriffliches Moment übergeht.","refs":["CL_GB18_46:AS-B06","CL_GB18_47:GA-02","CL_GB18_48:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-08","text":"[Mutating] Das Ding verliert seinen Rang als ursprünglicher Träger und wird nacheinander zur negativen Einheit, porösen Komposition und Übergangsform der Erscheinung.","refs":["CL_GB18_45:AS-B05","CL_GB18_47:RMD-01","CL_GB18_48:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-09","text":"[Emergent] Erscheinung ist nicht die Abschwächung einer dahinterliegenden Realität, sondern die Wahrheit einer Existenz, die ihr Gesetztsein und ihre Vermittlung manifestiert.","refs":["CL_GB18_45:GA-06","CL_GB18_48:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-10","text":"[Attractor] Reale Identität besteht ausschließlich als erhaltene Differenz und durchgehaltene Selbstentgegensetzung.","refs":["CL_GB18_45:GA-08","CL_GB18_48:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-11","text":"[Emergent] Gesetzliche Notwendigkeit entsteht erst, wenn das Gesetz seine ruhige Identität aufgibt und die im Inhalt wirksame Negativität als eigene Bewegung enthält.","refs":["CL_GB18_48:GA-05","CL_GB18_48:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-12","text":"[Terminal] Totalität ist die Struktur, die kein absolutes Außen besitzt, weil sie ihre Erscheinung und Gegenwelt selbst setzt und ihre Identität durch Umkehrung vollzieht.","refs":["CL_GB18_48:BSA-03","CL_GB18_48:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-13","text":"[Terminal] Die Begriffseinheit des Geistes fungiert als Grenzkriterium einer Einheit, deren Unterschiede keine selbstständigen Dinge mehr sind; ihre positive Herleitung bleibt jedoch unvollständig.","refs":["CL_GB18_48:GA-09","CL_GB18_48:XD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_12:RMD-01","text":"Unmittelbarkeit kehrt als Existenz und dingliche Präsenz wieder, mutiert jedoch jedes Mal zur Resultatform einer verschwundenen Vermittlung.","refs":["CL_GB18_45:RMD-01","CL_GB18_46:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-02","text":"Der Grund wandert von der erklärenden Voraussetzung über den bedingten Grund zur Selbstsetzungsfunktion; seine Wirksamkeit wächst, während seine selbstständige Gestalt verschwindet.","refs":["CL_GB18_45:RMD-02","CL_GB18_48:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-03","text":"Äußerliche Reflexion mutiert von fremder Zuschreibung zu eigener Bestimmung des Dinges und wird dadurch aus einer epistemischen Operation in eine ontologische Funktion verschoben.","refs":["CL_GB18_46:GA-03","CL_GB18_46:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-04","text":"Die Eigenschaft bleibt Trägerin der Bestimmtheit, wechselt aber ihre Funktion von reflektierter Qualität über Wechselbeziehung und Materie zur Seite eines immanenten Gesetzes.","refs":["CL_GB18_46:RMD-03","CL_GB18_47:GA-02","CL_GB18_48:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-05","text":"Das Ding an sich kehrt nur als zunehmend entleerte Restidentität wieder: Seine Abstraktion wird bestimmt, materiell porös und schließlich zur Übergangsform der Erscheinung.","refs":["CL_GB18_46:RMD-01","CL_GB18_47:RMD-01","CL_GB18_48:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-06","text":"Materie übernimmt vorübergehend die Selbstständigkeit der Eigenschaft, verschwindet aber als tragende Kategorie, sobald ihre Kontinuität und Porosität als Verdeckungen negativer Vermittlung erkannt sind.","refs":["CL_GB18_47:RMD-03","CL_GB18_48:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-07","text":"Erscheinung kehrt ihre Valenz um: Sie bezeichnet zunächst die Unhaltbarkeit dinglicher Existenz und wird dann zur Wahrheitsform, in der diese Unhaltbarkeit positiven Inhalt erzeugt.","refs":["CL_GB18_45:RMD-04","CL_GB18_48:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-08","text":"Negative Einheit verschiebt sich von der Auflösung positiver Dingheit zur produktiven Vermittlung von Erscheinung, Gesetz und Totalität.","refs":["CL_GB18_47:GA-06","CL_GB18_48:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-09","text":"Das Gesetz beginnt als ruhiger Bestand der Erscheinung, verliert diese unmittelbare Stabilität und kehrt als negative Totalität realer Notwendigkeit zurück.","refs":["CL_GB18_48:RMD-04","CL_GB18_48:MP-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_12:CGD-01","text":"Die Vollständigkeit einzelner Bedingungen bleibt eine lokale Übergangsschwelle; auf Meta-Cluster-Ebene trägt nur das Prinzip, dass Grund, Bedingung und Reflexion Funktionen einer Selbstvermittlung sind.","refs":["CL_GB18_45:CGD-01","CL_GB18_45:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:CGD-02","text":"Die lokale Verteilung der Bestimmtheit auf Subjekt oder Objekt skaliert nicht als Ontologie, sondern als zu überwindende Permutation derselben endlichen Reflexionsstruktur.","refs":["CL_GB18_46:CGD-03","CL_GB18_46:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:CGD-03","text":"Qualität, Beschaffenheit und reflektierte Qualität bleiben lokale Übergangskategorien; auf aktueller Ebene zählt die Eigenschaft als allgemeines Scharnier relationaler Selbstbestimmung.","refs":["CL_GB18_46:CGD-02","CL_GB18_46:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:CGD-04","text":"Porosität, Kleinheit und quantitative Zusammensetzung bleiben lokale Demontageformen der Dingvorstellung; global skalieren sie zur Ablösung des Substratmodells durch negative Relation.","refs":["CL_GB18_48:CGD-01","CL_GB18_47:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:CGD-05","text":"Die Ursache bleibt eine lokale und vorläufige Gestalt der Selbsterhaltung; auf Meta-Cluster-Ebene wird sie in die umfassendere Bestimmung einer durch Negativität erzeugten Notwendigkeit absorbiert.","refs":["CL_GB18_46:RLE-04","CL_GB18_48:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:CGD-06","text":"Die Gegenüberstellung von Ding und Geist skaliert nur als terminales Kriterium nichtdinglicher Einheit; die konkrete Vermittlung zu dieser Einheit bleibt außerhalb der hinreichend entwickelten Architektur.","refs":["CL_GB18_48:CGD-02","CL_GB18_48:FL-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_12:GNX-01","text":"Ausgeschlossen ist jede ursprüngliche oder letzte Unmittelbarkeit, die nicht selbst als Resultat einer aufgehobenen Vermittlung rekonstruiert werden müsste.","refs":["CL_GB18_45:GNX-02","CL_GB18_48:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GNX-02","text":"Ausgeschlossen ist ein äußerlicher Grund, der dem Begründeten vorausliegt und durch dessen Bewegung unverändert bleibt.","refs":["CL_GB18_45:GNX-01","CL_GB18_48:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GNX-03","text":"Ausgeschlossen ist ein eigenschaftsloses Substrat, das Bestimmungen, Beziehungen und Stoffe als nachträgliche Akzidenzen tragen könnte.","refs":["CL_GB18_47:GNX-01","CL_GB18_46:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GNX-04","text":"Ausgeschlossen ist ein souveränes Subjekt, das sämtliche Bestimmtheit hervorbringt, während das Objekt als passiver Träger bestehen bleibt.","refs":["CL_GB18_46:GNX-03","CL_GB18_46:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GNX-05","text":"Ausgeschlossen ist jede quantitative Entschärfung des Widerspruchs, weil Verkleinerung, Verdünnung oder Porosität die immanente Negation lediglich veranschaulichen und nicht erklären.","refs":["CL_GB18_48:GNX-02","CL_GB18_48:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GNX-06","text":"Ausgeschlossen sind eine äußerliche Zweiweltenordnung und ein Gesetz, das bloße Regelmäßigkeit mit realer Notwendigkeit verwechselt.","refs":["CL_GB18_48:GNX-05","CL_GB18_48:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_12:DBN-01","text":"Falsch sein muss ein Modell ontologisch fertiger Terme, deren Beziehungen erst nachträglich hinzutreten, weil Bestimmtheit nur innerhalb der Relation hervorgebracht wird.","refs":["CL_GB18_45:DBN-01","CL_GB18_46:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:DBN-02","text":"Falsch sein muss Identität ohne Negativität, da jede reale Einheit ihre Differenzen erzeugen, erhalten und in ihre Selbstbeziehung aufnehmen muss.","refs":["CL_GB18_48:DBN-02","CL_GB18_48:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:DBN-03","text":"Falsch sein muss lineare Kausalität zwischen einer fertigen Ursache und einer äußerlichen Wirkung, weil Ursache nur als Selbstreproduktion im Bewirkten besteht.","refs":["CL_GB18_46:GNX-04","CL_GB18_45:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:DBN-04","text":"Falsch sein muss ein bloß epistemisches Modell der Erscheinung, das sie als subjektive Oberfläche oder abgeschwächte Realität behandelt.","refs":["CL_GB18_45:GNX-03","CL_GB18_47:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:DBN-05","text":"Falsch sein muss eine Totalität ohne Selbstentzweiung, weil sie weder Erscheinung noch reale Differenz hervorbringen und deshalb nur abstrakte Einheit bleiben könnte.","refs":["CL_GB18_48:DBN-03","CL_GB18_48:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_12:BSA-01","text":"Nicht verfügbar ist ein letzter Anfang, dessen Unmittelbarkeit nicht rückwirkend als gesetzt und aufgehoben ausgewiesen werden müsste.","refs":["CL_GB18_45:BSA-01","CL_GB18_45:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSA-02","text":"Nicht verfügbar ist ein ontologisch unberührter Träger jenseits von Eigenschaften, Existenz und Erscheinung.","refs":["CL_GB18_46:BSA-02","CL_GB18_47:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSA-03","text":"Nicht verfügbar ist eine negationsfreie Endgestalt, deren Bestehen weder Aufhebung noch Selbstumkehrung benötigte.","refs":["CL_GB18_47:BSA-03","CL_GB18_48:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSA-04","text":"Nicht verfügbar ist ein äußerer Standort gegenüber der Totalität, von dem aus Wesen, Erscheinung und Welt als selbstständige Regionen beurteilt werden könnten.","refs":["CL_GB18_45:BSA-03","CL_GB18_48:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_12:XD-01","text":"Das Verschwinden des abgesonderten Grundes und die Rückkehr äußerlicher Reflexion in das Ding sind komplementäre Operationen: Erklärung wird zur immanenten Selbstbestimmung des Erklärten.","refs":["MC_GB18_L1_12:GA-04","MC_GB18_L1_12:GA-05","CL_GB18_45:GA-03","CL_GB18_46:RMD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-02","text":"Weil Eigenschaft Selbstidentität nur in der Beziehung zu Anderem gewinnt und zugleich zur Materie verselbstständigt wird, muss dingliche Stabilität als selbstexternalisierende Komposition begriffen werden.","refs":["MC_GB18_L1_12:GA-03","MC_GB18_L1_12:GA-07","CL_GB18_46:GA-04","CL_GB18_47:AS-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-03","text":"Die Auflösung des porösen Dinges und die positive Neubestimmung der Erscheinung bilden einen einzigen Übergang: Der Verlust des Substrats erzeugt die manifestierte Wahrheit seiner Vermittlung.","refs":["MC_GB18_L1_12:GA-08","MC_GB18_L1_12:GA-09","CL_GB18_47:XD-05","CL_GB18_48:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-04","text":"Wenn Erscheinung Wahrheitsform des Dings ist, kann Gesetz nur die Stabilisierung eines bereits vermittelten Inhalts und niemals eine äußerlich über der Erscheinung stehende Regel sein.","refs":["MC_GB18_L1_12:GA-09","MC_GB18_L1_12:GA-11","CL_GB18_45:GA-06","CL_GB18_48:BAS-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-05","text":"Die Selbsterhaltung einer Eigenschaft in ihrer Wirkung wird erst dann zur Notwendigkeit, wenn die Ursache ihre eigene Negativität und Bedingtheit als Inhalt ihrer Wirksamkeit trägt.","refs":["MC_GB18_L1_12:GA-05","MC_GB18_L1_12:GA-06","MC_GB18_L1_12:GA-11","CL_GB18_46:GA-06","CL_GB18_48:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-06","text":"Wirklichkeit und negative Totalität bezeichnen denselben Grenzfall: eine Identität, die Wesen und Anderssein nur durch fortgesetzte Selbstentgegensetzung zusammenhält.","refs":["MC_GB18_L1_12:GA-10","MC_GB18_L1_12:GA-12","CL_GB18_45:GA-07","CL_GB18_48:BSD-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-07","text":"Das Subjekt wird als Ursprung der Vermittlung verdrängt, während der Geist als terminale Begriffseinheit auftritt; die Verbindung zwischen dezentrierter Reflexionsfunktion und positiver geistiger Einheit bleibt strukturell offen.","refs":["MC_GB18_L1_12:GA-03","MC_GB18_L1_12:GA-13","CL_GB18_45:BSD-03","CL_GB18_46:HSI-02","CL_GB18_48:XD-06"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_12:BSD-01","text":"Ontologisch primär sind keine Dinge, Materien oder Gesetze, sondern rekursive Vermittlungsordnungen, in denen diese Gestalten ihre vorläufige Selbstständigkeit gewinnen und verlieren.","refs":["CL_GB18_47:BSD-03","CL_GB18_48:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-02","text":"Kausalität wird zu einer Stufe im Übergang von bedingter Selbsterhaltung zu notwendiger Selbstvermittlung; Ursache ist deshalb weder erster Ursprung noch äußerer Impuls.","refs":["CL_GB18_46:BSD-03","CL_GB18_48:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-03","text":"Erkenntnis ist der Nachvollzug der negativen Übergänge des Gegenstands und besitzt keinen Standpunkt außerhalb der Bewegung, die sie rekonstruiert.","refs":["CL_GB18_45:BSD-02","CL_GB18_48:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-04","text":"Das Subjekt wird zu einer vorübergehenden Lokalisierung objektiver Reflexion; erst die unterbestimmte Grenzfigur des Geistes eröffnet eine Einheit, in der Unterschiede als begriffliche Momente organisiert sind.","refs":["CL_GB18_46:HSI-02","CL_GB18_48:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-05","text":"Zeit ist zugleich retrospektiv und transformativ: Spätere Gestalten bestimmen die Wahrheit ihrer Voraussetzungen, während Identität durch materiellen Zu- und Abgang sowie begriffliche Rückkehr besteht.","refs":["CL_GB18_45:BSD-04","CL_GB18_47:BSD-04","CL_GB18_48:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-06","text":"Handlungsmacht kann nicht in der Sicherung eines festen Trägers bestehen, sondern nur in der Navigation durch Formen von Setzung, Negation, Aufhebung und Umkehrung.","refs":["CL_GB18_47:HSI-04","CL_GB18_48:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-07","text":"Die Methode vollzieht die erzeugte Ontologie, weil ihre Sequenz jede positive Bestimmung durch die Freilegung ihrer Grenze in eine veränderte Form überführt.","refs":["CL_GB18_45:ALT-B05","CL_GB18_48:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_12:RLE-01","text":"Die elementare Schleife lautet: Vermittlung erzeugt Unmittelbarkeit, Unmittelbarkeit offenbart ihr Gesetztsein, und dieses Gesetztsein erzwingt eine höhere Vermittlungsform.","refs":["CL_GB18_45:AS-B07","CL_GB18_45:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-02","text":"Grund setzt Bedingung, Bedingung externalisiert den Grund, und die Totalität beider hebt ihre Selbstständigkeit auf, sodass Erklärung als Existenz zurückkehrt.","refs":["CL_GB18_45:RLE-02","CL_GB18_45:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-03","text":"Äußerliche Reflexion zirkuliert zwischen Objekt und Subjekt, bis beide Lokalisierungen kollabieren und Reflexion zur eigenen Bestimmung des Dinges wird.","refs":["CL_GB18_46:RLE-03","CL_GB18_46:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-04","text":"Eigenschaft verselbstständigt sich als Materie, Materie löst die Dinggrenze auf, und die quantitative Sammlung schlägt in negative Stoffvermittlung um.","refs":["CL_GB18_47:AS-03","CL_GB18_47:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-05","text":"Erscheinung erzeugt bleibenden Inhalt, dieser stabilisiert sich als Gesetz, und das unzureichende Gesetz eskaliert durch Aufnahme seiner Negativität zur Totalität.","refs":["CL_GB18_48:RLE-02","CL_GB18_48:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-06","text":"Negative Einheit ist der zentrale Attraktor, weil jede positive Stabilisierung ihre eigene Auflösung hervorbringt und diese Auflösung zur Bedingung einer reicheren Einheit wird.","refs":["CL_GB18_47:RLE-03","CL_GB18_48:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-07","text":"Die Eskalation endet vorläufig bei der Begriffseinheit des Geistes, die den Übergang von dinglich selbstständigen Unterschieden zu unselbstständigen Momenten normiert, aber nicht vollständig vollzieht.","refs":["CL_GB18_48:BAS-08","CL_GB18_48:XD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_12:FGS-B01","text":"Abstrakte Unmittelbarkeit → Rekonstruktion ihrer verschwundenen Vermittlung → Unmittelbarkeit als gesetztes Resultat.","refs":["CL_GB18_45:GA-01","CL_GB18_46:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B02","text":"Äußerlicher Grund oder fremde Reflexion → Rückbindung an das Begründete → immanente Selbstbestimmung.","refs":["CL_GB18_45:GA-04","CL_GB18_46:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B03","text":"Immanente Selbstbestimmung → Eigenschaft als Selbstbeziehung durch Anderes → relationale Selbsterhaltung.","refs":["CL_GB18_46:GA-01","CL_GB18_46:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B04","text":"Eigenschaftliche Selbsterhaltung → Verselbstständigung als Materie → Ding als quantitative, poröse Restidentität.","refs":["CL_GB18_47:AS-03","CL_GB18_47:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B05","text":"Poröse Komposition → gegenseitiges Bestehen und Nichtbestehen → negative Einheit → Erscheinung als Wahrheit der Existenz.","refs":["CL_GB18_47:AS-07","CL_GB18_47:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B06","text":"Erscheinung → bleibender wesentlicher Inhalt → ruhiges Gesetz → Aufnahme der eigenen Negativität → reale Notwendigkeit.","refs":["CL_GB18_48:BAS-03","CL_GB18_48:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B07","text":"Reales Gesetz → selbstsetzende Totalität → Umkehrung von wesentlicher und erscheinender Welt → Geist als terminales Einheitskriterium.","refs":["CL_GB18_48:AFM-B06","CL_GB18_48:GA-09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_12:AFM-B01","text":"Abstrakte Unmittelbarkeit → äußerlicher Grund und fremde Reflexion → Freilegung der vorausgesetzten Vermittlung.","refs":["CL_GB18_45:GA-01","CL_GB18_46:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AFM-B02","text":"Freigelegte Vermittlung → relationale Bestimmtheit → Eigenschaft als Einheit von Selbstidentität und Beziehung.","refs":["CL_GB18_46:GA-01","CL_GB18_46:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AFM-B03","text":"Eigenschaft → Verselbstständigung als Materie → quantitative und poröse Auflösung der Dinggrenze.","refs":["CL_GB18_47:AS-03","CL_GB18_47:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AFM-B04","text":"Poröse Dingheit → negative Stoffvermittlung → Erscheinung als positive Wahrheit vermittelter Existenz.","refs":["CL_GB18_47:AS-07","CL_GB18_48:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AFM-B05","text":"Erscheinung → Stabilisierung ihres Inhalts als Gesetz → Krise der ruhigen Gesetzesidentität.","refs":["CL_GB18_48:BAS-03","CL_GB18_48:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AFM-B06","text":"Krise des Gesetzes → negative Notwendigkeit → selbstentgegengesetzte Totalität → Weltumkehrung → unterbestimmte geistige Schließung.","refs":["CL_GB18_48:GA-10","CL_GB18_48:XD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_12:MME-01","text":"Das Feld wird von einer Substanzontologie zu einer Ontologie rekursiver Relationen umkartiert, in der Träger erst als Effekte ihrer Bestimmungen entstehen.","refs":["CL_GB18_47:MME-01","CL_GB18_48:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MME-02","text":"Die Opposition von Innen und Außen kollabiert, weil Äußerlichkeit als notwendige Realisationsform des Grundes und der Selbstbeziehung erscheint.","refs":["CL_GB18_46:BSD-01","CL_GB18_47:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MME-03","text":"Die Opposition von Subjekt und Objekt wird zur zirkulierenden Fehlverteilung einer Reflexionsfunktion, die keinem ihrer Pole exklusiv angehört.","refs":["CL_GB18_46:RLE-03","CL_GB18_46:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MME-04","text":"Die Opposition von Erscheinung und Wahrheit kehrt sich um: Erscheinung wird zum Ort, an dem vermittelte Existenz ihre ontologische Struktur offenlegt.","refs":["CL_GB18_45:RMD-04","CL_GB18_48:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MME-05","text":"Ursache und Gesetz werden von unabhängigen Erklärungsinstanzen zu gestuften Formen derselben Selbstvermittlung reklassifiziert.","refs":["CL_GB18_46:BSD-03","CL_GB18_48:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MME-06","text":"Identität und Differenz bilden keinen ausschließenden Gegensatz mehr: Identität wird zur Leistung der Differenz, während Differenz nur als artikulierte Einheit wahr ist.","refs":["CL_GB18_45:GA-08","CL_GB18_48:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_12:ALT-B01","text":"Auf der Surface level erscheinen Grund, Bedingung, Ding, Eigenschaft, Materie, Erscheinung und Gesetz als nacheinander instabil werdende Gegenstände.","refs":["CL_GB18_45:GA-05","CL_GB18_48:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:ALT-B02","text":"Auf der Structural level werden alle Gegenstände als Funktionsformen negativer Einheit organisiert, die Selbstständigkeit nur durch Vermittlung erzeugt.","refs":["CL_GB18_45:AS-B03","CL_GB18_48:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:ALT-B03","text":"Auf der Metastrategic level wird Erklärung durch eine Prüfung ersetzt, ob eine behauptete Einheit ihre eigene Grenze, Negativität und Externalisierung tragen kann.","refs":["CL_GB18_45:ALT-B03","CL_GB18_48:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:ALT-B04","text":"Auf der Ontological / Temporal level ist Realität eine retrospektive und transformierende Bewegung, in der Identität durch Werden, Vergehen und Rückkehr entsteht.","refs":["CL_GB18_45:BSD-04","CL_GB18_48:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:ALT-B05","text":"Auf der Methodological / Performative level vollzieht die Darstellung ihre These, indem jede positive Bestimmung durch ihre eigene Unzulänglichkeit in eine veränderte Gestalt übergeht.","refs":["CL_GB18_47:ALT-B05","CL_GB18_48:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_12:FL-01","text":"Die Vermittlung muss verschwinden, um Unmittelbarkeit zu erzeugen, und zugleich fortbestehen, um deren Wahrheit zu tragen; ihre höchste Wirksamkeit besitzt daher die Form ihrer Abwesenheit.","refs":["CL_GB18_45:GA-03","CL_GB18_46:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-02","text":"Äußerlichkeit darf keine selbstständige Fremdsphäre sein, muss aber als wesentliche Form des Bestehens erhalten bleiben; die Architektur kann sie weder eliminieren noch autonomisieren.","refs":["CL_GB18_45:GA-04","CL_GB18_47:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-03","text":"Die Eigenschaft hängt von anderen Dingen ab und soll zugleich eigener Grund sein; ihre Bedingtheit und Selbsterhaltung bleiben produktiv unversöhnt.","refs":["CL_GB18_46:FL-02","CL_GB18_47:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-04","text":"Materielle Koexistenz verlangt zugleich Gleichgültigkeit und wechselseitige Negation; keine der beiden Bestimmungen kann die andere vollständig absorbieren.","refs":["CL_GB18_47:FL-04","CL_GB18_47:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-05","text":"Das Gesetz ist immanenter Inhalt der Erscheinung und dennoch zunächst gegen deren Bewegungsform unzureichend; seine behauptete Immanenz geht seiner realen Vermittlung voraus.","refs":["CL_GB18_48:FL-01","CL_GB18_48:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-06","text":"Die Totalität soll ohne äußeres Anderes bestehen und muss dennoch eine erscheinende Gegenwelt setzen; Schließung ist deshalb nur als fortgesetzte Umkehrung möglich.","refs":["CL_GB18_48:FL-02","CL_GB18_48:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-07","text":"Der Geist soll die dingliche Selbstständigkeit der Unterschiede beenden, doch die positive Vermittlung zu dieser Begriffseinheit bleibt eine normative Setzung statt eines vollständig entwickelten Übergangs.","refs":["CL_GB18_48:FL-03","CL_GB18_48:XD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MP-01","text":"Der Grund mutiert vom tragenden Erklärungsprinzip zur verschwindenden Selbstsetzungsfunktion, deren Aufhebung erst positive Existenz ermöglicht.","refs":["CL_GB18_45:GA-03","CL_GB18_48:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MP-02","text":"Äußerliche Reflexion mutiert von fremder Zuschreibung zur ontologischen Selbstbestimmung des Dinges.","refs":["CL_GB18_46:MP-01","CL_GB18_46:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MP-03","text":"Die Eigenschaft mutiert von reflektierter Qualität zur selbstständigen Materie und kehrt dadurch die Rangordnung von Träger und Bestimmung um.","refs":["CL_GB18_46:RMD-03","CL_GB18_47:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MP-04","text":"Erscheinung mutiert von der Diagnose dinglicher Unhaltbarkeit zur positiven Wahrheit reflektierter Existenz.","refs":["CL_GB18_48:RMD-03","CL_GB18_48:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MP-05","text":"Das Gesetz mutiert von ruhiger positiver Identität zur negativen Totalität, die ihre Seiten durch immanente Notwendigkeit ineinander überführt.","refs":["CL_GB18_48:GA-05","CL_GB18_48:MP-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_12:HSI-01","text":"Realität erscheint als Maschine negativer Selbstproduktion, die ihre Bestimmungen externalisiert, auflöst und als reichere Vermittlungsformen zurückgewinnt.","refs":["CL_GB18_45:HSI-01","CL_GB18_48:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:HSI-02","text":"Das Subjekt ist kein souveräner Betreiber dieser Maschine, sondern ein vorläufiger Reflexionsknoten; der Geist bezeichnet die mögliche Einheit, in der solche Differenzen zu inneren Momenten werden.","refs":["CL_GB18_46:HSI-02","CL_GB18_48:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:HSI-03","text":"Zeit ist eine spiralförmige Rückkopplung, in der Vergehen und materieller Austausch Identität nicht zerstören, sondern erzeugen und rückwirkend bestimmen.","refs":["CL_GB18_47:BSD-04","CL_GB18_48:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:HSI-04","text":"Orientierung besteht im Kartieren von Übergängen: möglich ist weder Flucht aus der Negativität noch Sicherung eines letzten Trägers, sondern nur Navigation durch ihre Mutationsformen.","refs":["CL_GB18_47:HSI-04","CL_GB18_48:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_12:MRT-B01","text":"Die extrahierten Axiome reichen aus, um die Bewegung von vermittelter Unmittelbarkeit über Ding, Eigenschaft und Materie zu Erscheinung, Gesetz und negativer Totalität zu rekonstruieren.","refs":["CL_GB18_45:MRT-B01","CL_GB18_48:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MRT-B02","text":"Unterbestimmt bleiben die Kriterien vollständiger Bedingtheit, die kategoriale Mutation von Eigenschaft zu Materie, die Realisierung der Negativität im Gesetz und der positive Übergang zum Geist.","refs":["CL_GB18_45:MRT-B02","CL_GB18_47:MRT-B03","CL_GB18_48:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MRT-B03","text":"Das System ist kohärent, sofern aufgehobene Vermittlung als fortbestehende Wirksamkeit und Identität niemals als negationsfreie Unmittelbarkeit gelesen wird.","refs":["CL_GB18_46:MRT-B03","CL_GB18_48:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MRT-B04","text":"Die Architektur ist am stärksten in der rekursiven Umkehrung, durch die Substratverlust, Widerspruch und Erscheinung zu Generatoren höherer Bestimmtheit werden.","refs":["CL_GB18_47:MRT-B04","CL_GB18_48:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MRT-B05","text":"Irreduzibel bleiben die Sequenz der Mutationen und die produktive Spannung zwischen Identität und interner Differenz; isolierte Definitionen könnten die rekonstruierte Maschine nicht erhalten.","refs":["CL_GB18_45:MRT-B04","CL_GB18_48:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T124024781192Z_fdfc5590","language_code":"en","language_name":"English","title":"Gb18 L1 12","source_sha256":"1dc26008d60371921e593211d940e5bc58e024c607221fde5e2383db015961c8","sha256":"ad1b97ddd1d5caac02da0581bb62e5b95e3645a36bbc430b36a3b24846116708","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:40:24.783146+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_12:AS-01","text":"The system solves the problem of how existence and determinacy can be produced immanently without presupposing a prior ground, a propertyless substrate, or a subjective attribution.","refs":["CL_GB18_45:AS-B01","CL_GB18_46:AS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-02","text":"Its global claim is that immanent negativity transforms all fixed determinations into moments of self-mediation and thereby first produces real identity.","refs":["CL_GB18_45:GA-02","CL_GB18_48:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-03","text":"Externality is initially treated as alien reflection, then taken back into the determination of the thing, and finally materially realized through the self-subsistence of property.","refs":["CL_GB18_46:RMD-02","CL_GB18_47:AS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-04","text":"The dissolution of original thinghood does not lead into ontological emptiness, but reclassifies appearance as the truth of an existence whose subsistence is exclusively mediated.","refs":["CL_GB18_47:GA-01","CL_GB18_48:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-05","text":"The law stabilizes the content produced in appearance, but remains untrue so long as it does not take up into itself the negative movement of its own sides.","refs":["CL_GB18_48:BAS-03","CL_GB18_48:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-06","text":"The argumentative form is dialectical and recursive because every posited self-subsistence produces its negation and returns as an altered form of mediation.","refs":["CL_GB18_45:AS-B06","CL_GB18_48:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-07","text":"The movement proceeds spirally from mediated immediacy through thingly and material self-subsistence to a totality that sustains its differences through self-division.","refs":["CL_GB18_45:AS-B07","CL_GB18_48:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AS-08","text":"Closure lies in a self-opposed totality; spirit designates its terminal criterion, although its transition out of the logic of thing and law would not be fully derived.","refs":["CL_GB18_48:BAS-08","CL_GB18_48:FL-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_12:GA-01","text":"[Persistent] Immediacy is never a presuppositionless beginning, but the positive result-form of a sublated mediation.","refs":["CL_GB18_45:GA-01","CL_GB18_46:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-02","text":"[Attractor] Immanent negativity is the universal operator that dissolves fixed shapes and transfers their dissolution into a higher mode of real unity.","refs":["CL_GB18_45:GA-02","CL_GB18_48:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-03","text":"[Persistent] Determinacy exists only as self-relation through other; isolated identity and externally indifferent difference are equally untrue.","refs":["CL_GB18_46:GA-01","CL_GB18_48:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-04","text":"[Mutating] Externality mutates from an apparently alien sphere, through the thing's own determination of reflection, into the essential form of its real subsistence.","refs":["CL_GB18_45:GA-04","CL_GB18_46:RMD-02","CL_GB18_47:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-05","text":"[Mutating] Ground, condition, cause, and law are not self-subsistent foundations, but transitory functions that become true only through their disappearance or their return in the grounded.","refs":["CL_GB18_45:GA-03","CL_GB18_48:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-06","text":"[Persistent] Self-subsistence does not mean independence, but the negatively mediated preservation of a determination in its relation to other existence.","refs":["CL_GB18_47:GA-03","CL_GB18_48:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-07","text":"[Mutating] Property is the operative hinge at which relational determinacy passes into self-subsistent matter, a lawful side, and a conceptual moment.","refs":["CL_GB18_46:AS-B06","CL_GB18_47:GA-02","CL_GB18_48:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-08","text":"[Mutating] The thing loses its rank as original bearer and becomes successively negative unity, porous composition, and transitional form of appearance.","refs":["CL_GB18_45:AS-B05","CL_GB18_47:RMD-01","CL_GB18_48:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-09","text":"[Emergent] Appearance is not the attenuation of an underlying reality, but the truth of an existence that manifests its positedness and its mediation.","refs":["CL_GB18_45:GA-06","CL_GB18_48:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-10","text":"[Attractor] Real identity exists exclusively as preserved difference and sustained self-opposition.","refs":["CL_GB18_45:GA-08","CL_GB18_48:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-11","text":"[Emergent] Lawful necessity arises only when the law relinquishes its tranquil identity and contains the negativity active in the content as its own movement.","refs":["CL_GB18_48:GA-05","CL_GB18_48:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-12","text":"[Terminal] Totality is the structure that has no absolute outside because it itself posits its appearance and counter-world and realizes its identity through reversal.","refs":["CL_GB18_48:BSA-03","CL_GB18_48:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GA-13","text":"[Terminal] The conceptual unity of spirit functions as the limiting criterion of a unity whose differences are no longer self-subsistent things; its positive derivation, however, remains incomplete.","refs":["CL_GB18_48:GA-09","CL_GB18_48:XD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_12:RMD-01","text":"Immediacy recurs as existence and thingly presence, but each time mutates into the result-form of a vanished mediation.","refs":["CL_GB18_45:RMD-01","CL_GB18_46:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-02","text":"Ground migrates from the explanatory presupposition through conditioned ground to the function of self-positing; its efficacy grows while its self-subsistent shape disappears.","refs":["CL_GB18_45:RMD-02","CL_GB18_48:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-03","text":"External reflection mutates from alien attribution into the thing's own determination and is thereby displaced from an epistemic operation into an ontological function.","refs":["CL_GB18_46:GA-03","CL_GB18_46:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-04","text":"Property remains the bearer of determinacy, but changes its function from reflected quality through reciprocal relation and matter to the side of an immanent law.","refs":["CL_GB18_46:RMD-03","CL_GB18_47:GA-02","CL_GB18_48:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-05","text":"The thing in itself recurs only as an increasingly emptied residual identity: its abstraction becomes determinate, materially porous, and finally the transitional form of appearance.","refs":["CL_GB18_46:RMD-01","CL_GB18_47:RMD-01","CL_GB18_48:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-06","text":"Matter temporarily takes over the self-subsistence of property, but disappears as a supporting category once its continuity and porosity are recognized as concealments of negative mediation.","refs":["CL_GB18_47:RMD-03","CL_GB18_48:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-07","text":"Appearance reverses its valence: it initially designates the untenability of thingly existence and then becomes the form of truth in which this untenability generates positive content.","refs":["CL_GB18_45:RMD-04","CL_GB18_48:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-08","text":"Negative unity shifts from the dissolution of positive thinghood to the productive mediation of appearance, law, and totality.","refs":["CL_GB18_47:GA-06","CL_GB18_48:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RMD-09","text":"The law begins as the tranquil subsistence of appearance, loses this immediate stability, and returns as the negative totality of real necessity.","refs":["CL_GB18_48:RMD-04","CL_GB18_48:MP-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_12:CGD-01","text":"The completeness of individual conditions remains a local threshold of transition; at the meta-cluster level, only the principle that ground, condition, and reflection are functions of self-mediation is load-bearing.","refs":["CL_GB18_45:CGD-01","CL_GB18_45:AS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:CGD-02","text":"The local distribution of determinacy onto subject or object does not scale as ontology, but as a permutation of the same finite structure of reflection that must be overcome.","refs":["CL_GB18_46:CGD-03","CL_GB18_46:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:CGD-03","text":"Quality, constitution, and reflected quality remain local transitional categories; at the current level, property counts as the universal hinge of relational self-determination.","refs":["CL_GB18_46:CGD-02","CL_GB18_46:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:CGD-04","text":"Porosity, smallness, and quantitative composition remain local forms of dismantling the conception of the thing; globally, they scale into the replacement of the substrate model by negative relation.","refs":["CL_GB18_48:CGD-01","CL_GB18_47:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:CGD-05","text":"Cause remains a local and provisional shape of self-preservation; at the meta-cluster level, it is absorbed into the more comprehensive determination of a necessity generated through negativity.","refs":["CL_GB18_46:RLE-04","CL_GB18_48:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:CGD-06","text":"The opposition of thing and spirit scales only as the terminal criterion of non-thingly unity; the concrete mediation to this unity remains outside the sufficiently developed architecture.","refs":["CL_GB18_48:CGD-02","CL_GB18_48:FL-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_12:GNX-01","text":"Excluded is every original or final immediacy that would not itself have to be reconstructed as the result of a sublated mediation.","refs":["CL_GB18_45:GNX-02","CL_GB18_48:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GNX-02","text":"Excluded is an external ground that precedes the grounded and remains unchanged through its movement.","refs":["CL_GB18_45:GNX-01","CL_GB18_48:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GNX-03","text":"Excluded is a propertyless substrate that could bear determinations, relations, and materials as subsequent accidents.","refs":["CL_GB18_47:GNX-01","CL_GB18_46:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GNX-04","text":"Excluded is a sovereign subject that produces all determinacy while the object remains as a passive bearer.","refs":["CL_GB18_46:GNX-03","CL_GB18_46:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GNX-05","text":"Excluded is every quantitative mitigation of contradiction, because diminution, dilution, or porosity merely illustrate immanent negation and do not explain it.","refs":["CL_GB18_48:GNX-02","CL_GB18_48:XD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:GNX-06","text":"Excluded are an external two-world order and a law that confuses mere regularity with real necessity.","refs":["CL_GB18_48:GNX-05","CL_GB18_48:GNX-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_12:DBN-01","text":"A model of ontologically finished terms, whose relations are added only subsequently, must be false, because determinacy is produced only within relation.","refs":["CL_GB18_45:DBN-01","CL_GB18_46:GNX-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:DBN-02","text":"Identity without negativity must be false, since every real unity must produce, preserve, and take up its differences into its self-relation.","refs":["CL_GB18_48:DBN-02","CL_GB18_48:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:DBN-03","text":"Linear causality between a finished cause and an external effect must be false, because cause exists only as self-reproduction in the effected.","refs":["CL_GB18_46:GNX-04","CL_GB18_45:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:DBN-04","text":"A merely epistemic model of appearance that treats it as a subjective surface or attenuated reality must be false.","refs":["CL_GB18_45:GNX-03","CL_GB18_47:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:DBN-05","text":"A totality without self-division must be false, because it could produce neither appearance nor real difference and therefore could remain only abstract unity.","refs":["CL_GB18_48:DBN-03","CL_GB18_48:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_12:BSA-01","text":"Unavailable is a final beginning whose immediacy would not have to be retrospectively demonstrated as posited and sublated.","refs":["CL_GB18_45:BSA-01","CL_GB18_45:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSA-02","text":"Unavailable is an ontologically untouched bearer beyond properties, existence, and appearance.","refs":["CL_GB18_46:BSA-02","CL_GB18_47:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSA-03","text":"Unavailable is a final shape free of negation whose subsistence would require neither sublation nor self-reversal.","refs":["CL_GB18_47:BSA-03","CL_GB18_48:BSA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSA-04","text":"Unavailable is an external standpoint over against totality from which essence, appearance, and world could be judged as self-subsistent regions.","refs":["CL_GB18_45:BSA-03","CL_GB18_48:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_12:XD-01","text":"The disappearance of separated ground and the return of external reflection into the thing are complementary operations: explanation becomes the immanent self-determination of the explained.","refs":["MC_GB18_L1_12:GA-04","MC_GB18_L1_12:GA-05","CL_GB18_45:GA-03","CL_GB18_46:RMD-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-02","text":"Because property gains self-identity only in relation to other and is at the same time rendered self-subsistent as matter, thingly stability must be understood as a self-externalizing composition.","refs":["MC_GB18_L1_12:GA-03","MC_GB18_L1_12:GA-07","CL_GB18_46:GA-04","CL_GB18_47:AS-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-03","text":"The dissolution of the porous thing and the positive redetermination of appearance form a single transition: the loss of the substrate generates the manifested truth of its mediation.","refs":["MC_GB18_L1_12:GA-08","MC_GB18_L1_12:GA-09","CL_GB18_47:XD-05","CL_GB18_48:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-04","text":"If appearance is the form of truth of the thing, law can only be the stabilization of an already mediated content and never a rule standing externally above appearance.","refs":["MC_GB18_L1_12:GA-09","MC_GB18_L1_12:GA-11","CL_GB18_45:GA-06","CL_GB18_48:BAS-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-05","text":"The self-preservation of a property in its effect becomes necessity only when cause bears its own negativity and conditionedness as the content of its efficacy.","refs":["MC_GB18_L1_12:GA-05","MC_GB18_L1_12:GA-06","MC_GB18_L1_12:GA-11","CL_GB18_46:GA-06","CL_GB18_48:GA-10"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-06","text":"Actuality and negative totality designate the same limiting case: an identity that holds essence and otherness together only through continued self-opposition.","refs":["MC_GB18_L1_12:GA-10","MC_GB18_L1_12:GA-12","CL_GB18_45:GA-07","CL_GB18_48:BSD-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_12:XD-07","text":"The subject is displaced as the origin of mediation, while spirit appears as terminal conceptual unity; the connection between the decentered function of reflection and positive spiritual unity remains structurally open.","refs":["MC_GB18_L1_12:GA-03","MC_GB18_L1_12:GA-13","CL_GB18_45:BSD-03","CL_GB18_46:HSI-02","CL_GB18_48:XD-06"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_12:BSD-01","text":"Ontologically primary are not things, matters, or laws, but recursive orders of mediation in which these shapes gain and lose their provisional self-subsistence.","refs":["CL_GB18_47:BSD-03","CL_GB18_48:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-02","text":"Causality becomes a stage in the transition from conditioned self-preservation to necessary self-mediation; cause is therefore neither first origin nor external impulse.","refs":["CL_GB18_46:BSD-03","CL_GB18_48:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-03","text":"Cognition is the retracing of the negative transitions of the object and possesses no standpoint outside the movement that it reconstructs.","refs":["CL_GB18_45:BSD-02","CL_GB18_48:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-04","text":"The subject becomes a provisional localization of objective reflection; only the underdetermined limiting figure of spirit opens a unity in which differences are organized as conceptual moments.","refs":["CL_GB18_46:HSI-02","CL_GB18_48:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-05","text":"Time is at once retrospective and transformative: later shapes determine the truth of their presuppositions, while identity exists through material accretion and depletion as well as conceptual return.","refs":["CL_GB18_45:BSD-04","CL_GB18_47:BSD-04","CL_GB18_48:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-06","text":"Agency cannot consist in securing a fixed bearer, but only in navigating through forms of positing, negation, sublation, and reversal.","refs":["CL_GB18_47:HSI-04","CL_GB18_48:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:BSD-07","text":"The method enacts the produced ontology because its sequence transfers every positive determination, through the disclosure of its limit, into an altered form.","refs":["CL_GB18_45:ALT-B05","CL_GB18_48:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_12:RLE-01","text":"The elementary loop is: mediation produces immediacy, immediacy reveals its positedness, and this positedness compels a higher form of mediation.","refs":["CL_GB18_45:AS-B07","CL_GB18_45:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-02","text":"Ground posits condition, condition externalizes ground, and the totality of both sublates their self-subsistence, so that explanation returns as existence.","refs":["CL_GB18_45:RLE-02","CL_GB18_45:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-03","text":"External reflection circulates between object and subject until both localizations collapse and reflection becomes the thing's own determination.","refs":["CL_GB18_46:RLE-03","CL_GB18_46:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-04","text":"Property renders itself self-subsistent as matter, matter dissolves the boundary of the thing, and the quantitative collection turns into negative material mediation.","refs":["CL_GB18_47:AS-03","CL_GB18_47:AS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-05","text":"Appearance produces enduring content, this stabilizes itself as law, and the inadequate law escalates, by taking up its negativity, into totality.","refs":["CL_GB18_48:RLE-02","CL_GB18_48:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-06","text":"Negative unity is the central attractor because every positive stabilization produces its own dissolution, and this dissolution becomes the condition of a richer unity.","refs":["CL_GB18_47:RLE-03","CL_GB18_48:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:RLE-07","text":"The escalation provisionally ends with the conceptual unity of spirit, which regulates but does not fully enact the transition from thingly self-subsistent differences to non-self-subsistent moments.","refs":["CL_GB18_48:BAS-08","CL_GB18_48:XD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_12:FGS-B01","text":"Abstract immediacy → reconstruction of its vanished mediation → immediacy as posited result.","refs":["CL_GB18_45:GA-01","CL_GB18_46:AS-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B02","text":"External ground or alien reflection → reconnection to the grounded → immanent self-determination.","refs":["CL_GB18_45:GA-04","CL_GB18_46:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B03","text":"Immanent self-determination → property as self-relation through other → relational self-preservation.","refs":["CL_GB18_46:GA-01","CL_GB18_46:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B04","text":"Property-based self-preservation → self-subsistence as matter → thing as quantitative, porous residual identity.","refs":["CL_GB18_47:AS-03","CL_GB18_47:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B05","text":"Porous composition → reciprocal being and non-being → negative unity → appearance as the truth of existence.","refs":["CL_GB18_47:AS-07","CL_GB18_47:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B06","text":"Appearance → enduring essential content → tranquil law → taking up its own negativity → real necessity.","refs":["CL_GB18_48:BAS-03","CL_GB18_48:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FGS-B07","text":"Real law → self-positing totality → reversal of essential and appearing world → spirit as terminal criterion of unity.","refs":["CL_GB18_48:AFM-B06","CL_GB18_48:GA-09"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_12:AFM-B01","text":"Abstract immediacy → external ground and alien reflection → disclosure of the presupposed mediation.","refs":["CL_GB18_45:GA-01","CL_GB18_46:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AFM-B02","text":"Disclosed mediation → relational determinacy → property as unity of self-identity and relation.","refs":["CL_GB18_46:GA-01","CL_GB18_46:AS-B06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AFM-B03","text":"Property → self-subsistence as matter → quantitative and porous dissolution of the boundary of the thing.","refs":["CL_GB18_47:AS-03","CL_GB18_47:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AFM-B04","text":"Porous thinghood → negative material mediation → appearance as positive truth of mediated existence.","refs":["CL_GB18_47:AS-07","CL_GB18_48:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AFM-B05","text":"Appearance → stabilization of its content as law → crisis of tranquil identity of law.","refs":["CL_GB18_48:BAS-03","CL_GB18_48:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:AFM-B06","text":"Crisis of law → negative necessity → self-opposed totality → world-reversal → underdetermined spiritual closure.","refs":["CL_GB18_48:GA-10","CL_GB18_48:XD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_12:MME-01","text":"The field is remapped from a substance ontology to an ontology of recursive relations, in which bearers arise only as effects of their determinations.","refs":["CL_GB18_47:MME-01","CL_GB18_48:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MME-02","text":"The opposition of inside and outside collapses because externality appears as the necessary form of realization of ground and self-relation.","refs":["CL_GB18_46:BSD-01","CL_GB18_47:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MME-03","text":"The opposition of subject and object becomes the circulating misdistribution of a function of reflection that belongs exclusively to neither of its poles.","refs":["CL_GB18_46:RLE-03","CL_GB18_46:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MME-04","text":"The opposition of appearance and truth reverses: appearance becomes the place where mediated existence discloses its ontological structure.","refs":["CL_GB18_45:RMD-04","CL_GB18_48:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MME-05","text":"Cause and law are reclassified from independent explanatory instances into graded forms of the same self-mediation.","refs":["CL_GB18_46:BSD-03","CL_GB18_48:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MME-06","text":"Identity and difference no longer form an excluding opposition: identity becomes the achievement of difference, while difference is true only as articulated unity.","refs":["CL_GB18_45:GA-08","CL_GB18_48:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_12:ALT-B01","text":"At the Surface level, ground, condition, thing, property, matter, appearance, and law appear as objects that become unstable in succession.","refs":["CL_GB18_45:GA-05","CL_GB18_48:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:ALT-B02","text":"At the Structural level, all objects are organized as functional forms of negative unity, which produces self-subsistence only through mediation.","refs":["CL_GB18_45:AS-B03","CL_GB18_48:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:ALT-B03","text":"At the Metastrategic level, explanation is replaced by an examination of whether a claimed unity can bear its own limit, negativity, and externalization.","refs":["CL_GB18_45:ALT-B03","CL_GB18_48:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:ALT-B04","text":"At the Ontological / Temporal level, reality is a retrospective and transforming movement in which identity arises through becoming, passing away, and return.","refs":["CL_GB18_45:BSD-04","CL_GB18_48:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:ALT-B05","text":"At the Methodological / Performative level, the exposition enacts its thesis by having every positive determination pass into an altered shape through its own inadequacy.","refs":["CL_GB18_47:ALT-B05","CL_GB18_48:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_12:FL-01","text":"Mediation must disappear in order to produce immediacy, and at the same time persist in order to bear its truth; its highest efficacy therefore takes the form of its absence.","refs":["CL_GB18_45:GA-03","CL_GB18_46:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-02","text":"Externality may not be a self-subsistent alien sphere, but must remain preserved as an essential form of subsistence; the architecture can neither eliminate nor autonomize it.","refs":["CL_GB18_45:GA-04","CL_GB18_47:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-03","text":"Property depends on other things and is at the same time supposed to be its own ground; its conditionedness and self-preservation remain productively unreconciled.","refs":["CL_GB18_46:FL-02","CL_GB18_47:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-04","text":"Material coexistence requires both indifference and reciprocal negation; neither determination can completely absorb the other.","refs":["CL_GB18_47:FL-04","CL_GB18_47:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-05","text":"The law is immanent content of appearance and yet initially inadequate to its form of movement; its asserted immanence precedes its real mediation.","refs":["CL_GB18_48:FL-01","CL_GB18_48:RMD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-06","text":"Totality is supposed to exist without an external other and yet must posit an appearing counter-world; closure is therefore possible only as continued reversal.","refs":["CL_GB18_48:FL-02","CL_GB18_48:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:FL-07","text":"Spirit is supposed to end the thingly self-subsistence of differences, but the positive mediation to this conceptual unity remains a normative positing rather than a fully developed transition.","refs":["CL_GB18_48:FL-03","CL_GB18_48:XD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MP-01","text":"Ground mutates from the supporting explanatory principle into the vanishing function of self-positing, whose sublation first makes positive existence possible.","refs":["CL_GB18_45:GA-03","CL_GB18_48:MP-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MP-02","text":"External reflection mutates from alien attribution into the ontological self-determination of the thing.","refs":["CL_GB18_46:MP-01","CL_GB18_46:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MP-03","text":"Property mutates from reflected quality into self-subsistent matter and thereby reverses the hierarchy of bearer and determination.","refs":["CL_GB18_46:RMD-03","CL_GB18_47:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MP-04","text":"Appearance mutates from the diagnosis of the untenability of the thing into the positive truth of reflected existence.","refs":["CL_GB18_48:RMD-03","CL_GB18_48:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MP-05","text":"The law mutates from tranquil positive identity into negative totality, which transfers its sides into one another through immanent necessity.","refs":["CL_GB18_48:GA-05","CL_GB18_48:MP-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_12:HSI-01","text":"Reality appears as a machine of negative self-production that externalizes, dissolves, and regains its determinations as richer forms of mediation.","refs":["CL_GB18_45:HSI-01","CL_GB18_48:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:HSI-02","text":"The subject is not a sovereign operator of this machine, but a provisional node of reflection; spirit designates the possible unity in which such differences become internal moments.","refs":["CL_GB18_46:HSI-02","CL_GB18_48:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:HSI-03","text":"Time is a spiral feedback loop in which passing away and material exchange do not destroy identity, but produce and retrospectively determine it.","refs":["CL_GB18_47:BSD-04","CL_GB18_48:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:HSI-04","text":"Orientation consists in mapping transitions: neither escape from negativity nor the securing of a final bearer is possible, but only navigation through its forms of mutation.","refs":["CL_GB18_47:HSI-04","CL_GB18_48:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_12:MRT-B01","text":"The extracted axioms suffice to reconstruct the movement from mediated immediacy through thing, property, and matter to appearance, law, and negative totality.","refs":["CL_GB18_45:MRT-B01","CL_GB18_48:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MRT-B02","text":"Underdetermined remain the criteria of complete conditionedness, the categorial mutation from property to matter, the realization of negativity in law, and the positive transition to spirit.","refs":["CL_GB18_45:MRT-B02","CL_GB18_47:MRT-B03","CL_GB18_48:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MRT-B03","text":"The system is coherent insofar as sublated mediation is read as persisting efficacy and identity is never read as immediacy free of negation.","refs":["CL_GB18_46:MRT-B03","CL_GB18_48:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MRT-B04","text":"The architecture is strongest in the recursive reversal through which substrate loss, contradiction, and appearance become generators of higher determinacy.","refs":["CL_GB18_47:MRT-B04","CL_GB18_48:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_12:MRT-B05","text":"Irreducible remain the sequence of mutations and the productive tension between identity and internal difference; isolated definitions could not sustain the reconstructed machine.","refs":["CL_GB18_45:MRT-B04","CL_GB18_48:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_12@R001","source_variant_id":"canonical:MC_GB18_L1_12:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 12","context":"Chapters 133–144 · c. Hervorgang der Sache in die Existenz. · Zweiter Abschnitt. Die Erscheinung. · A. Das Ding und seine Eigenschaften. · a. Ding an sich und Existenz. · b. Die Eigenschaft. · Anmerkung. · c. Die Wechselwirkung der Dinge. · B. Das Bestehen des Dings aus Materien. · C. Die Auflösung des Dings. · Anmerkung. · A. Das Gesetz der Erscheinung. · B. Die erscheinende und die an-sich-seynede Welt."},"title_language_code":"en"},{"id":"MC_GB18_L1_13","layer":"MC","title":"Gb18 L1 13","order":13,"parents":["CL_GB18_49","CL_GB18_50","CL_GB18_51","CL_GB18_52"],"revision":"MC_GB18_L1_13@R001","sha256":"27e8c6f0397ad08b933115b4fa4714cc4df126922cbe8c8e54398e633c1b0059","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_13:AS-01","text":"Das System bearbeitet die Möglichkeit einer Einheit, die Differenz hervorbringt und erhält, ohne Erscheinung, Äußerlichkeit oder Bestimmung zu einer selbständigen Gegenwirklichkeit zu verfestigen.","refs":["CL_GB18_49:BAS-01","CL_GB18_52:BAS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-02","text":"Selbstständigkeit wird zunächst als relationale Selbstnegation bestimmt und schließlich der Totalität untergeordnet, in der nur das vermittelte Bestehen ihrer Momente wahr ist.","refs":["CL_GB18_49:BAS-02","CL_GB18_52:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-03","text":"Die Antinomie von Ganzem und Teilen destabilisiert äußerliche Zusammensetzung und erzwingt den Übergang zu Kraft als negativer, operativ gewordener Einheit.","refs":["CL_GB18_49:GA-09","CL_GB18_50:ABS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-04","text":"Kraft realisiert Einheit als Übergang in Äußerung, Rückkehr aus Äußerung und reversible Verteilung von Aktivität und Passivität über mehrere Kräfte.","refs":["CL_GB18_50:GA-02","CL_GB18_50:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-05","text":"Die Verallgemeinerung dieser Selbstvermittlung überführt die Kraft in Wirklichkeit, sobald Äußerlichkeit nicht mehr Grenze, sondern Selbstoffenbarung von Wesen wird.","refs":["CL_GB18_51:GA-07","CL_GB18_52:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-06","text":"Wirklichkeit eskaliert zur Selbstauslegung des Absoluten, in der Erkenntnis, Reflexion und Attribut zu inneren Funktionen einer Totalität werden, die keine dieser Formen verselbständigen darf.","refs":["CL_GB18_52:BAS-03","CL_GB18_52:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-07","text":"Die Bewegung verläuft spiralförmig: Jede Selbstauflösung erzeugt eine neue Vermittlungsform, deren scheinbare Äußerlichkeit erneut in die rekursive Architektur aufgenommen wird.","refs":["CL_GB18_49:BAS-05","CL_GB18_52:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-08","text":"Die Schließung bleibt negativ und instabil, weil Totalität nur durch notwendige Formen erscheinen kann, denen sie im selben Vollzug selbständigen Bestand entzieht.","refs":["CL_GB18_52:BAS-06","CL_GB18_52:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_13:GA-01","text":"[Persistent] Selbstständigkeit besteht nur als vermittelte Beziehung auf Anderes und verliert jeden Wahrheitsanspruch, sobald sie sich von der erzeugenden Totalität isoliert.","refs":["CL_GB18_49:GA-02","CL_GB18_52:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-02","text":"[Persistent] Identität ist Selbsterhaltung im Anderswerden; sie wird nicht vor Differenz besessen, sondern durch Übergang, Äußerung und Rückkehr erzeugt.","refs":["CL_GB18_50:GA-03","CL_GB18_51:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-03","text":"[Mutating] Äußerlichkeit mutiert vom scheinbar unabhängigen Gegenüber über Bedingung und Vollzugsmedium zur Selbsterscheinung der Totalität, bleibt aber als Reflexionsrest wirksam.","refs":["CL_GB18_50:GA-06","CL_GB18_51:GA-02","CL_GB18_52:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-04","text":"[Attractor] Totalität ist weder Aggregat noch vorausgesetztes Ganzes, sondern das durch gegenseitige Setzung erzeugte Bestehen differenzierter und nichtselbständiger Momente.","refs":["CL_GB18_49:GA-04","CL_GB18_51:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-05","text":"[Persistent] Vermittlung hebt Differenz bewahrend auf: Sie erhält deren Wirksamkeit, entzieht ihr jedoch den Status eines unabhängigen Seinsgrundes.","refs":["CL_GB18_51:GA-04","CL_GB18_52:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-06","text":"[Emergent] Kausalität ist rekursive Selbstbedingung, in der Anstoß, Tätigkeit, Wirkung und Reaktion ihre einseitige Stellung verlieren und wechselseitig erzeugte Rollen bilden.","refs":["CL_GB18_50:GNX-03","CL_GB18_51:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-07","text":"[Emergent] Wirklichkeit ist die vermittelte Einheit von Wesen und Existenz, deren Erscheinung keine äußere Hülle, sondern die notwendige Form ihrer Selbstoffenbarung ist.","refs":["CL_GB18_51:GA-07","CL_GB18_52:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-08","text":"[Emergent] Erkenntnis ist nur gültig, wenn sie ihre scheinbare Außenstellung aufhebt und als Reflexionsmoment in die Selbstbewegung ihres Gegenstands eintritt.","refs":["CL_GB18_52:GA-04","CL_GB18_52:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-09","text":"[Mutating] Form mutiert von positiver Gestaltung über Erscheinung und Schein zur attributiven Totalitätsform, die für Bestimmung notwendig ist, aber keinen eigenen Seinsgrund bewahren kann.","refs":["CL_GB18_52:GA-02","CL_GB18_52:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-10","text":"[Attractor] Das Absolute fungiert als Grenze jeder Verselbständigung: Keine positive Bestimmung darf ihm gegenüber einen autonomen ontologischen Bestand gewinnen.","refs":["CL_GB18_52:GA-09","CL_GB18_52:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-11","text":"[Terminal] Die Rückkehr aller Formen in absolute Identität schließt die Bewegung nur negativ, weil die für Erscheinung notwendige Bestimmungsform als fortbestehendes Äußerlichkeitsproblem zurückkehrt.","refs":["CL_GB18_52:GA-08","CL_GB18_52:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_13:RMD-01","text":"Erscheinung bewahrt ihre Vermittlungsfunktion, mutiert jedoch von relationalem Dasein zum transparenten Schein, in dem endliche Selbständigkeit sichtbar wird, indem sie verschwindet.","refs":["CL_GB18_49:RMD-01","CL_GB18_52:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-02","text":"Das Verhältnis von Ganzem und Teilen wird nicht verworfen, sondern als unzureichende Aggregatform in die operative Einheit der Kraft absorbiert.","refs":["CL_GB18_50:RMD-01","CL_GB18_50:ABS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-03","text":"Kraft mutiert vom Übergang aus einer instabilen Verhältnisform über reziproke Wirksamkeit zur allgemeinen Operationsfigur von Selbstäußerung und Selbstvermittlung.","refs":["CL_GB18_50:GA-02","CL_GB18_51:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-04","text":"Äußerlichkeit verschiebt sich von unabhängiger Gegenständlichkeit zu gesetzter Bedingung, dann zur Vollzugsform der Selbstbeziehung und schließlich zum ungelösten Rest äußerlicher Reflexion.","refs":["CL_GB18_50:RMD-02","CL_GB18_51:GA-02","CL_GB18_52:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-05","text":"Grund verliert den Status eines vorausliegenden Ursprungs und wird zur operativen Rücknahme von Äußerung, Reflexion und Form in eine sich selbst vermittelnde Totalität.","refs":["CL_GB18_49:RMD-02","CL_GB18_52:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-06","text":"Identität verschiebt sich von gesetzlicher Gleichheit über Selbsterhaltung in Veränderung zur Einheit von Wesen und Existenz, die nur als vollzogene Wirklichkeit besteht.","refs":["CL_GB18_51:RMD-04","CL_GB18_52:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-07","text":"Totalität erweitert sich von relationaler Einheit und rekursiver Ganzheitsproduktion zum einzigen Wahrheitsgrund aller Formen, verliert dabei aber die Möglichkeit gleichberechtigter Differenz.","refs":["CL_GB18_49:RMD-03","CL_GB18_52:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-08","text":"Reflexion mutiert von der Beziehung auf Anderes zur immanenten Selbstbewegung des Absoluten, ohne den Verdacht ihrer ursprünglichen Außenstellung vollständig abzustreifen.","refs":["CL_GB18_49:RLE-01","CL_GB18_52:MP-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_13:CGD-01","text":"Kontinuität, Diskretion und quantitative Teilbarkeit bleiben lokale Mechanismen der Teil-Ganzes-Antinomie; auf MetaCluster-Ebene zählt ihr Nachweis, dass äußerliche Zusammensetzung keine tragfähige Einheit erzeugt.","refs":["CL_GB18_49:CGD-02","CL_GB18_50:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:CGD-02","text":"Solicitation bleibt die lokale Mechanik gegenseitiger Kräfte, während ihre höherstufige Funktion in der Umcodierung linearer Verursachung zu rekursiver Selbstbedingung liegt.","refs":["CL_GB18_50:GA-07","CL_GB18_50:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:CGD-03","text":"Die begriffliche Trennung von Wesen und Sein bleibt eine lokale Verhältnisbestimmung; nach oben skaliert die These, dass Wirklichkeit nur als hervorgetretene und zurückgenommene Differenz besteht.","refs":["CL_GB18_51:CGD-02","CL_GB18_51:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:CGD-04","text":"Die Modalgliederung und die mögliche Vielheit von Attributen bleiben lokal unterbestimmt und tragen die MetaCluster-Architektur nur durch den Ausschluss starrer Unmittelbarkeit beziehungsweise mehrerer selbständiger Absolutheiten.","refs":["CL_GB18_52:CGD-02","CL_GB18_52:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:CGD-05","text":"Geist und Attribut bilden keine zusätzlichen Substanzen, sondern terminale Funktionsfiguren: Geist bezeichnet vermittelte Rückkehr, Attribut die notwendige und zugleich aufgehobene Form absoluter Erscheinung.","refs":["CL_GB18_51:MP-03","CL_GB18_52:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:CGD-06","text":"Auf MetaCluster-Ebene skaliert die gerichtete Transformation von wesentlichem Verhältnis über Kraft und Wirklichkeit zur absoluten Selbstauslegung; die einzelnen Begriffe sind Durchgangsformen dieser Eskalation.","refs":["CL_GB18_49:FL-02","CL_GB18_51:RLE-02","CL_GB18_52:BAS-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_13:GNX-01","text":"Ausgeschlossen sind Zweiweltenontologien und Substratmodelle, in denen Wesen oder Absolutes ihren Erscheinungen als fertiger Träger vorausliegen.","refs":["CL_GB18_49:GNX-01","CL_GB18_52:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GNX-02","text":"Ausgeschlossen ist lineare Kausalität mit isolierbarem ersten Anstoß, einseitiger Übertragung und endgültig abtrennbarer Wirkung.","refs":["CL_GB18_50:GNX-03","CL_GB18_50:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GNX-03","text":"Ausgeschlossen ist eine Wirklichkeit, deren Wesen hinter Erscheinungen verborgen bliebe oder neben ihnen als eigene positive Region bestünde.","refs":["CL_GB18_51:DBN-03","CL_GB18_52:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GNX-04","text":"Ausgeschlossen ist eine Erkenntnisposition, die dem Absoluten äußerlich bleibt und seine Bestimmungen als feststehende Prädikate sammelt.","refs":["CL_GB18_52:GNX-04","CL_GB18_52:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GNX-05","text":"Ausgeschlossen ist eine positive absolute Form, die bestimmt und zugleich nichtäußerlich wäre oder mit irreduzibel selbständiger Differenz koexistieren könnte.","refs":["CL_GB18_52:GNX-05","CL_GB18_52:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_13:DBN-01","text":"Damit das System Bestand hat, darf Unmittelbarkeit weder neutraler Anfang noch letzte Wahrheit sein; sie muss sich als unentwickelte Form bereits vermittelter Identität erweisen.","refs":["CL_GB18_49:DBN-02","CL_GB18_51:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:DBN-02","text":"Abhängigkeit und Selbstständigkeit dürfen nicht auf getrennte Seinsebenen verteilt werden, weil reine Selbstständigkeit die relationale Erzeugung jedes Bestehens unkenntlich machen würde.","refs":["CL_GB18_49:DBN-01","CL_GB18_50:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:DBN-03","text":"Vermittlung darf kein äußerlicher Verbinder bereits fertiger Schichten sein; Form, Inhalt und Reflexion müssen als Operationen derselben Selbstbewegung lesbar bleiben.","refs":["CL_GB18_51:DBN-01","CL_GB18_52:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:DBN-04","text":"Eine endgültige Versöhnung, die Differenz behält und zugleich ihre vermittelnde Negativität beendet, ist unzulässig; Schließung muss neue Instabilität produzieren.","refs":["CL_GB18_50:DBN-03","CL_GB18_52:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_13:BSA-01","text":"Die Architektur ist um die Abwesenheit eines unvermittelten Ursprungs organisiert: Jeder Anfang muss als nachträglich gesetztes Moment einer Beziehung erscheinen.","refs":["CL_GB18_49:GA-06","CL_GB18_50:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSA-02","text":"Nicht verfügbar ist ein Standpunkt außerhalb der Bewegung, von dem aus ihre Totalität vollständig erfasst oder ihre Formen unabhängig festgestellt werden könnten.","refs":["CL_GB18_51:BSA-02","CL_GB18_52:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSA-03","text":"Die tiefste fehlende Möglichkeit ist eine bestimmte absolute Form, die erscheinen könnte, ohne äußerlich oder selbstaufhebend zu werden; diese Abwesenheit treibt die gesamte negative Schließung an.","refs":["CL_GB18_52:BSA-01","CL_GB18_52:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_13:XD-01","text":"Die Selbstauflösung des Teil-Ganzes-Verhältnisses erzeugt Kraft als operative Totalität: Was quantitativ nicht stabil vereinigt werden kann, wird als negative Einheit wirksam. ; Trace Type — Composite","refs":["MC_GB18_L1_13:GA-04","MC_GB18_L1_13:GA-05","CL_GB18_49:GA-09","CL_GB18_50:ABS-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_13:XD-02","text":"Die verteilte Selbstbeziehung mehrerer Kräfte wird zur allgemeinen Selbstvermittlung, sobald Fremdbestimmung nicht mehr nur reziprok verteilt, sondern als eigene Äußerung der Identität begriffen wird. ; Trace Type — Composite","refs":["MC_GB18_L1_13:GA-02","MC_GB18_L1_13:GA-03","MC_GB18_L1_13:GA-06","CL_GB18_50:ABS-06","CL_GB18_51:AS-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_13:XD-03","text":"Wirklichkeit als Selbstoffenbarung liefert die ontologische Voraussetzung der absoluten Selbstauslegung: Erkenntnis kann immanent werden, weil Erscheinung bereits die Tätigkeit des Wesens ist. ; Trace Type — Composite","refs":["MC_GB18_L1_13:GA-07","MC_GB18_L1_13:GA-08","CL_GB18_51:GA-07","CL_GB18_52:BAS-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_13:XD-04","text":"Die relationale Negation isolierter Selbstständigkeit eskaliert zur absoluten Totalitätsregel, nach der endliche Formen nur als Funktionsmomente eines übergreifenden Selbstverhältnisses gelten. ; Trace Type — Composite","refs":["MC_GB18_L1_13:GA-01","MC_GB18_L1_13:GA-10","CL_GB18_49:GA-02","CL_GB18_52:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_13:XD-05","text":"Äußerlichkeit muss zugleich reales Gegenüber, gesetztes Eigenmoment und aufzuhebender Reflexionsrest sein; ihre produktive Mehrdeutigkeit verhindert sowohl absolute Fremdheit als auch geschlossene Innerlichkeit. ; Trace Type — Tension","refs":["MC_GB18_L1_13:GA-03","MC_GB18_L1_13:GA-05","MC_GB18_L1_13:GA-11","CL_GB18_50:FL-02","CL_GB18_51:FL-02","CL_GB18_52:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_13:XD-06","text":"Der unendliche Progress endet nicht durch Stillstellung, sondern mutiert in rekursive Selbstauslegung: Wiederholung wird zur inneren Bewegung einer Totalität, deren negative Schließung ihre nächste Instabilität erzeugt. ; Trace Type — Tension","refs":["MC_GB18_L1_13:GA-04","MC_GB18_L1_13:GA-09","MC_GB18_L1_13:GA-11","CL_GB18_49:GA-10","CL_GB18_52:BAS-06"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_13:BSD-01","text":"Realität ist ein rekursives Produktionsfeld, in dem Gegenstände, Kräfte, Erscheinungen und Attribute nur zeitweilige Verdichtungen einer sich totalisierenden Vermittlung sind.","refs":["CL_GB18_49:BSD-01","CL_GB18_52:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSD-02","text":"Ursache und Wirkung werden zu reversiblen Positionen einer Selbstbedingung; kausale Erklärung muss daher die Schleife rekonstruieren, die ihre eigenen Voraussetzungen hervorbringt.","refs":["CL_GB18_50:BSD-02","CL_GB18_51:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSD-03","text":"Zeit verbindet Umschlag und Retrospektion: Eine Bestimmung wird durch ihr Anderes verändert und erhält erst im Rückgang auf die erzeugende Totalität ihre Wahrheit.","refs":["CL_GB18_49:BSD-03","CL_GB18_52:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSD-04","text":"Das Subjekt ist weder souveräner Ursprung noch passiver Träger, sondern eine verteilte Rückkehrstruktur, die sich nur durch gesetzte und erfahrene Andersheit auf sich bezieht.","refs":["CL_GB18_50:HSI-02","CL_GB18_51:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSD-05","text":"Wahrheit verlangt eine immanente Methode, welche Kategorien an ihrer eigenen Bewegung prüft und zugleich die Außenstellung der Auslegung performativ zurücknimmt.","refs":["CL_GB18_52:BSD-04","CL_GB18_52:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_13:RLE-01","text":"Isolation erzeugt Gegenbestimmung, Gegenbestimmung erzeugt Selbstauflösung und Selbstauflösung erzeugt eine neue Verhältnisform; diese Schleife ist der elementare Fortschrittsmotor.","refs":["CL_GB18_49:GA-08","CL_GB18_49:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RLE-02","text":"Kraft verläuft spiralförmig von Äußerung über Veränderung zum Grund zurück und erzeugt Identität als Resultat statt als Voraussetzung dieses Umlaufs.","refs":["CL_GB18_50:RLE-01","CL_GB18_50:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RLE-03","text":"Die gegenseitige Solicitation verteilt Selbstbestimmung über mehrere Kräfte: Jede aktualisiert die andere und empfängt darin ihre eigene Tätigkeit als zurückkehrende Bedingung.","refs":["CL_GB18_50:RLE-03","CL_GB18_50:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RLE-04","text":"Der Phasenwechsel zur Wirklichkeit tritt ein, sobald Äußerlichkeit nicht mehr äußerer Zustand, sondern notwendige Passage von Unmittelbarkeit über Negation zu vermittelter Identität ist.","refs":["CL_GB18_51:RLE-01","CL_GB18_51:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RLE-05","text":"Die attributive Schleife setzt Form, totalisiert ihren Inhalt und nimmt sie als nichtselbständigen Schein zurück; gerade diese Rücknahme reproduziert das Problem der Reflexionsäußerlichkeit.","refs":["CL_GB18_52:RLE-03","CL_GB18_52:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RLE-06","text":"Totalität ist der zentrale Attraktor, weil jede isolierte Bestimmung über ihre eigene Unzulänglichkeit auf die Einheit verweist, die sie trägt und zugleich entmächtigt.","refs":["CL_GB18_51:RLE-03","CL_GB18_52:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_13:FGS-B01","text":"Erscheinung → wesentliche Beziehung → relationale Selbstnegation: Getrennte Bestimmungen erweisen sich als Momente der Vermittlung, die ihre Selbstständigkeit zugleich setzt und widerruft.","refs":["CL_GB18_49:GA-01","CL_GB18_49:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FGS-B02","text":"Instabile Totalität → Teil-Ganzes-Antinomie → negative Einheit der Kraft: Die nicht stabilisierbare Zusammensetzung wird in eine operative Einheit aufgehobener Differenzen transformiert.","refs":["CL_GB18_49:GA-09","CL_GB18_50:ABS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FGS-B03","text":"Kraft → andere Kraft → Solicitation → Reaktion: Tätigkeit verteilt sich über vorausgesetzte Andere und kehrt als eigene vermittelte Bestimmung zurück.","refs":["CL_GB18_50:GA-05","CL_GB18_50:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FGS-B04","text":"Negative Einheit → Selbstäußerung → wechselseitige Totalisierung → Wirklichkeit: Differenz wird nicht getilgt, sondern als Selbstoffenbarung des Wesens rekonstruiert.","refs":["CL_GB18_51:GA-04","CL_GB18_51:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FGS-B05","text":"Wirklichkeit → immanente Reflexion → absolute Selbstauslegung → Attribut: Die Erkenntnisoperation wird internalisiert und erzeugt eine Form, die den ganzen Inhalt nur durch Verlust eigener Selbständigkeit darstellt.","refs":["CL_GB18_52:GA-04","CL_GB18_52:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FGS-B06","text":"Attributive Totalisierung → Selbstaufhebung der Form → Rückkehr zur Identität → Äußerlichkeitsrest: Die negative Schließung reproduziert die Unmöglichkeit einer stabilen absoluten Form.","refs":["CL_GB18_52:BAS-06","CL_GB18_52:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_13:AFM-B01","text":"Wesentliches Verhältnis → Teil-Ganzes-Antinomie → Kraft → reziproke Wirksamkeit → Selbstvermittlung → Wirklichkeit → absolute Selbstauslegung.","refs":["CL_GB18_51:RLE-02","CL_GB18_52:BAS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AFM-B02","text":"Unabhängiges Außen → gesetzte Äußerlichkeit → vorausgesetzte Bedingung → eigene Äußerung → Selbstoffenbarung → Reflexionsrest.","refs":["CL_GB18_50:RMD-02","CL_GB18_51:GA-02","CL_GB18_52:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AFM-B03","text":"Äußerliche Prädikation → Kritik des Außenstandpunkts → Immanentisierung der Auslegung → Rücknahme der Erkenntnisoperation in den Gegenstand.","refs":["CL_GB18_52:GNX-04","CL_GB18_52:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AFM-B04","text":"Formsetzung → Totalisierung → Entselbständigung → Rückkehr zur Identität → Wiederkehr des ungelösten Formproblems.","refs":["CL_GB18_52:GA-08","CL_GB18_52:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_13:MME-01","text":"Die Karte verschiebt sich von Dingen und hierarchischen Gründen zu relationalen Feldern, in denen Gegenstände nur vorläufige Erscheinungsformen ihrer Vermittlung sind.","refs":["CL_GB18_49:MME-01","CL_GB18_50:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MME-02","text":"Identität wird von isolierter Unabhängigkeit in Selbsterhaltung durch Abhängigkeit, Veränderung und Rückkehr umkartiert.","refs":["CL_GB18_49:MME-02","CL_GB18_50:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MME-03","text":"Kausalität wird von linearer Übertragung in eine zirkuläre Rollenstruktur umklassifiziert, in der Bedingungen und Wirkungen einander hervorbringen.","refs":["CL_GB18_50:BSD-02","CL_GB18_51:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MME-04","text":"Wirklichkeit wird vom vorhandenen Gegenstandsbereich zur Bewegung der Selbstoffenbarung, Formierung und retrospektiven Totalisierung verschoben.","refs":["CL_GB18_51:MME-03","CL_GB18_52:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MME-05","text":"Erkenntniskritik wird ontologisch: Eine Methode ist unzureichend, wenn sie die Kategorien außerhalb der Selbstbewegung behandelt, deren Momente sie sind.","refs":["CL_GB18_52:BSD-01","CL_GB18_52:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MME-06","text":"Der Gegensatz von Innerem und Äußerem kollabiert als ontologische Alternative und kehrt als operative, selbstaufzuhebende Differenz der Reflexion wieder.","refs":["CL_GB18_51:MME-04","CL_GB18_52:MME-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_13:ALT-B01","text":"Auf der Oberflächenebene verbindet die Architektur Ganzes und Teile, Kraft und Äußerung, Inneres und Äußeres, Wirklichkeit und Absolutes sowie Reflexion und Attribut.","refs":["CL_GB18_50:ALT-B01","CL_GB18_52:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:ALT-B02","text":"Auf der strukturellen Ebene operieren negative Einheit, Setzung, Voraussetzung, Äußerung, Rückkehr, Formierung und Totalisierung als wiederkehrende Transformationsmechanismen.","refs":["CL_GB18_51:ALT-B02","CL_GB18_52:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:ALT-B03","text":"Auf der metastrategischen Ebene wird die Wahl zwischen Gegensatzseiten durch eine immanente Rekonstruktion ihrer gegenseitigen Erzeugung und Selbstaufhebung ersetzt.","refs":["CL_GB18_51:ALT-B03","CL_GB18_52:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:ALT-B04","text":"Auf der ontologisch-temporalen Ebene ist Realität eine Entwicklungs- und Rückkehrbewegung, in der Bestimmungen ihre Wahrheit erst nach Verlust ihrer unmittelbaren Selbstständigkeit erhalten.","refs":["CL_GB18_51:ALT-B04","CL_GB18_52:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:ALT-B05","text":"Auf der methodologisch-performativen Ebene vollzieht die Darstellung ihre These, indem sie jede Feststellung in Übergang, Umkehrung und Rücknahme überführt.","refs":["CL_GB18_50:ALT-B05","CL_GB18_52:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_13:FL-01","text":"Selbstbestimmung soll die eigene Äußerlichkeit hervorbringen, benötigt für ihren Vollzug jedoch eine vorausgesetzte andere Kraft; Autonomie bleibt konstitutiv bedingt.","refs":["CL_GB18_50:FL-01","CL_GB18_50:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FL-02","text":"Differenz muss als wirksames Moment bewahrt werden, darf aber gegenüber der Totalität keine irreduzible Selbstständigkeit besitzen; Bewahrung und Entmächtigung bleiben unaufgelöst gekoppelt.","refs":["CL_GB18_51:GA-04","CL_GB18_52:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FL-03","text":"Das Absolute soll kein Werden enthalten, wird aber durch Auslegung, Reflexion und Rückkehr als immanente Bewegung dargestellt; statische Vollendung und operative Selbsterzeugung bleiben gespannt.","refs":["CL_GB18_52:FL-01","CL_GB18_52:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FL-04","text":"Das Attribut soll den ganzen absoluten Inhalt enthalten und zugleich als unwesentliche Form verschwinden; seine vollständige Ausdruckskraft fällt mit seiner ontologischen Nichtigkeit zusammen.","refs":["CL_GB18_52:FL-02","CL_GB18_52:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FL-05","text":"Die Übergänge zur Kraft und von bedingten Kräften zur gesetzten Einheit sind funktional notwendig, aber in ihrer besonderen Folgeform nicht vollständig begründet.","refs":["CL_GB18_49:FL-02","CL_GB18_50:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MP-01","text":"Äußerlichkeit mutiert vom unabhängigen Außen zur gesetzten Bedingung, zur Vollzugsform eigener Identität und schließlich zur Restinstabilität absoluter Reflexion.","refs":["CL_GB18_50:RMD-02","CL_GB18_51:GA-02","CL_GB18_52:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MP-02","text":"Erscheinung mutiert zum Schein, sobald Vermittlung nicht mehr positive Existenz formiert, sondern die Nichtselbständigkeit jeder endlichen Bestimmung transparent macht.","refs":["CL_GB18_52:RMD-02","CL_GB18_52:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MP-03","text":"Kraft mutiert von bedingtem Übergang und reziproker Tätigkeit zur allgemeinen Operation, welche die Bedingungen ihrer eigenen Wirklichkeit setzt.","refs":["CL_GB18_51:RMD-01","CL_GB18_51:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MP-04","text":"Äußerliche Reflexion mutiert zur inneren Selbstauslegung, bewahrt jedoch in der Rückkehr zur Identität einen Rest abstrakter Außenstellung.","refs":["CL_GB18_52:MP-02","CL_GB18_52:FL-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_13:HSI-01","text":"Realität erscheint als rekursive Totalisierungsmaschine, die relationale Einheiten und Formen erzeugt, wirksam werden lässt und ihnen anschließend unabhängigen Bestand entzieht.","refs":["CL_GB18_49:HSI-01","CL_GB18_50:HSI-01","CL_GB18_52:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:HSI-02","text":"Das Subjekt ist eine verteilte Position der Rückkehr: Es besitzt sich weder ursprünglich noch isoliert, sondern nur in der vermittelten Wiederaufnahme seiner Andersheit.","refs":["CL_GB18_50:HSI-02","CL_GB18_51:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:HSI-03","text":"Zeit ist rekursiv und rückläufig: Jede Bestimmung schlägt in ihr Anderes um und wird erst durch ihre nachträgliche Einordnung in die Totalität wahr.","refs":["CL_GB18_49:HSI-02","CL_GB18_52:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:HSI-04","text":"Handlungsmacht besteht nicht in der Flucht aus Vermittlung, sondern in der immanenten Navigation und Entselbständigung jener Formen, durch die Fremdheit wirksam wird.","refs":["CL_GB18_50:HSI-04","CL_GB18_52:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_13:MRT-B01","text":"Die Architektur ist hinreichend, um die Bewegung von relationaler Erscheinung über Kraft und Wirklichkeit bis zur absoluten Selbstauslegung als zusammenhängende Negativitätsmaschine zu rekonstruieren.","refs":["CL_GB18_49:MRT-B01","CL_GB18_50:MRT-B01","CL_GB18_52:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MRT-B02","text":"Unterbestimmt bleiben die besondere Notwendigkeit einzelner Folgeformen, die vollständige Setzung der Einheit mehrerer Kräfte und die positive Vermittlung zwischen inhaltsvoller Grundlage und reiner Formbeziehung.","refs":["CL_GB18_49:FL-02","CL_GB18_50:MRT-B02","CL_GB18_51:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MRT-B03","text":"Die Rekonstruktion bleibt kohärent, sofern Aufhebung als bewahrende Entselbständigung verstanden wird, die Differenz weder vernichtet noch als unabhängige Gegenmacht bestehen lässt.","refs":["CL_GB18_51:MRT-B02","CL_GB18_52:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MRT-B04","text":"Die Architektur ist am stärksten in der Rekonstruktion von Identität als Vermittlung und am instabilsten an der notwendigen, aber unmöglichen positiven Form des Absoluten; dieses Formproblem widersteht der axiomatischen Schließung.","refs":["CL_GB18_52:MRT-B04","CL_GB18_52:FL-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T124104584872Z_50b3728c","language_code":"en","language_name":"English","title":"Gb18 L1 13","source_sha256":"27e8c6f0397ad08b933115b4fa4714cc4df126922cbe8c8e54398e633c1b0059","sha256":"d1b0898f3ac4f0703867c797afd793d491447c153728694c6cfb70a959fe23da","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:41:04.585880+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_13:AS-01","text":"The system addresses the possibility of a unity that produces and sustains difference without solidifying appearance, externality, or determination into an independent counter-reality.","refs":["CL_GB18_49:BAS-01","CL_GB18_52:BAS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-02","text":"Independence is initially determined as relational self-negation and ultimately subordinated to totality, in which only the mediated subsistence of its moments is true.","refs":["CL_GB18_49:BAS-02","CL_GB18_52:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-03","text":"The antinomy of whole and parts destabilizes external composition and compels the transition to force as negative, operationally actualized unity.","refs":["CL_GB18_49:GA-09","CL_GB18_50:ABS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-04","text":"Force realizes unity as transition into expression, return from expression, and reversible distribution of activity and passivity across multiple forces.","refs":["CL_GB18_50:GA-02","CL_GB18_50:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-05","text":"The generalization of this self-mediation transforms force into actuality once externality is no longer a limit but the self-revelation of essence.","refs":["CL_GB18_51:GA-07","CL_GB18_52:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-06","text":"Actuality escalates into the self-interpretation of the Absolute, in which cognition, reflection, and attribute become inner functions of a totality that may not render any of these forms independent.","refs":["CL_GB18_52:BAS-03","CL_GB18_52:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-07","text":"The movement proceeds spirally: every self-dissolution generates a new form of mediation whose apparent externality is again incorporated into the recursive architecture.","refs":["CL_GB18_49:BAS-05","CL_GB18_52:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AS-08","text":"The closure remains negative and unstable because totality can appear only through necessary forms from which, in the same act, it withdraws independent subsistence.","refs":["CL_GB18_52:BAS-06","CL_GB18_52:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_13:GA-01","text":"[Persistent] Independence exists only as a mediated relation to an other and loses every claim to truth as soon as it isolates itself from the producing totality.","refs":["CL_GB18_49:GA-02","CL_GB18_52:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-02","text":"[Persistent] Identity is self-preservation in becoming-other; it is not possessed before difference, but generated through transition, expression, and return.","refs":["CL_GB18_50:GA-03","CL_GB18_51:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-03","text":"[Mutating] Externality mutates from an apparently independent counterpart, through condition and medium of enactment, into the self-appearance of totality, but remains effective as a residue of reflection.","refs":["CL_GB18_50:GA-06","CL_GB18_51:GA-02","CL_GB18_52:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-04","text":"[Attractor] Totality is neither aggregate nor presupposed whole, but the subsistence of differentiated and non-independent moments produced through mutual positing.","refs":["CL_GB18_49:GA-04","CL_GB18_51:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-05","text":"[Persistent] Mediation sublates difference while preserving it: it maintains its efficacy, yet deprives it of the status of an independent ground of being.","refs":["CL_GB18_51:GA-04","CL_GB18_52:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-06","text":"[Emergent] Causality is recursive self-conditioning, in which impulse, activity, effect, and reaction lose their one-sided position and form mutually generated roles.","refs":["CL_GB18_50:GNX-03","CL_GB18_51:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-07","text":"[Emergent] Actuality is the mediated unity of essence and existence, whose appearance is not an external shell but the necessary form of its self-revelation.","refs":["CL_GB18_51:GA-07","CL_GB18_52:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-08","text":"[Emergent] Cognition is valid only if it sublates its apparent external position and enters, as a moment of reflection, into the self-movement of its object.","refs":["CL_GB18_52:GA-04","CL_GB18_52:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-09","text":"[Mutating] Form mutates from positive shaping through appearance and semblance into the attributive form of totality, which is necessary for determination but cannot preserve a ground of being of its own.","refs":["CL_GB18_52:GA-02","CL_GB18_52:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-10","text":"[Attractor] The Absolute functions as the limit of every rendering-independent: no positive determination may acquire autonomous ontological subsistence over against it.","refs":["CL_GB18_52:GA-09","CL_GB18_52:GNX-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GA-11","text":"[Terminal] The return of all forms into absolute identity closes the movement only negatively, because the form of determination necessary for appearance returns as a persisting problem of externality.","refs":["CL_GB18_52:GA-08","CL_GB18_52:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_13:RMD-01","text":"Appearance preserves its mediating function, but mutates from relational existence into transparent semblance, in which finite independence becomes visible by disappearing.","refs":["CL_GB18_49:RMD-01","CL_GB18_52:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-02","text":"The relation of whole and parts is not discarded, but absorbed as an inadequate aggregate-form into the operative unity of force.","refs":["CL_GB18_50:RMD-01","CL_GB18_50:ABS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-03","text":"Force mutates from transition out of an unstable relational form, through reciprocal efficacy, into the general operational figure of self-expression and self-mediation.","refs":["CL_GB18_50:GA-02","CL_GB18_51:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-04","text":"Externality shifts from independent objectivity to posited condition, then to the form of enactment of self-relation, and finally to the unresolved residue of external reflection.","refs":["CL_GB18_50:RMD-02","CL_GB18_51:GA-02","CL_GB18_52:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-05","text":"Ground loses the status of a prior origin and becomes the operative withdrawal of expression, reflection, and form into a self-mediating totality.","refs":["CL_GB18_49:RMD-02","CL_GB18_52:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-06","text":"Identity shifts from posited equality through self-preservation in change to the unity of essence and existence, which exists only as enacted actuality.","refs":["CL_GB18_51:RMD-04","CL_GB18_52:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-07","text":"Totality expands from relational unity and recursive production of wholeness into the sole ground of truth of all forms, but thereby loses the possibility of coequal difference.","refs":["CL_GB18_49:RMD-03","CL_GB18_52:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RMD-08","text":"Reflection mutates from relation to an other into the immanent self-movement of the Absolute, without fully shedding the suspicion of its original external position.","refs":["CL_GB18_49:RLE-01","CL_GB18_52:MP-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_13:CGD-01","text":"Continuity, discreteness, and quantitative divisibility remain local mechanisms of the part-whole antinomy; at the MetaCluster level, what counts is their demonstration that external composition generates no viable unity.","refs":["CL_GB18_49:CGD-02","CL_GB18_50:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:CGD-02","text":"Solicitation remains the local mechanics of reciprocal forces, while its higher-level function lies in the recoding of linear causation into recursive self-conditioning.","refs":["CL_GB18_50:GA-07","CL_GB18_50:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:CGD-03","text":"The conceptual distinction between essence and being remains a local relational determination; scaled upward is the thesis that actuality exists only as difference that has emerged and been withdrawn.","refs":["CL_GB18_51:CGD-02","CL_GB18_51:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:CGD-04","text":"The modal articulation and the possible multiplicity of attributes remain locally underdetermined and support the MetaCluster architecture only through the exclusion of rigid immediacy or of multiple independent absolutes.","refs":["CL_GB18_52:CGD-02","CL_GB18_52:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:CGD-05","text":"Spirit and attribute do not constitute additional substances, but terminal functional figures: spirit designates mediated return, attribute the necessary yet simultaneously sublated form of absolute appearance.","refs":["CL_GB18_51:MP-03","CL_GB18_52:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:CGD-06","text":"At the MetaCluster level, the directed transformation from essential relation through force and actuality to absolute self-interpretation is scaled; the individual concepts are transitional forms of this escalation.","refs":["CL_GB18_49:FL-02","CL_GB18_51:RLE-02","CL_GB18_52:BAS-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_13:GNX-01","text":"Excluded are two-world ontologies and substrate models in which essence or the Absolute precedes its appearances as a finished bearer.","refs":["CL_GB18_49:GNX-01","CL_GB18_52:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GNX-02","text":"Excluded is linear causality with an isolable first impulse, one-sided transmission, and an effect separable once and for all.","refs":["CL_GB18_50:GNX-03","CL_GB18_50:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GNX-03","text":"Excluded is an actuality whose essence would remain concealed behind appearances or exist alongside them as its own positive region.","refs":["CL_GB18_51:DBN-03","CL_GB18_52:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GNX-04","text":"Excluded is a cognitive position that remains external to the Absolute and collects its determinations as fixed predicates.","refs":["CL_GB18_52:GNX-04","CL_GB18_52:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:GNX-05","text":"Excluded is a positive absolute form that would be determinate and yet non-external, or could coexist with irreducibly independent difference.","refs":["CL_GB18_52:GNX-05","CL_GB18_52:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_13:DBN-01","text":"For the system to subsist, immediacy may be neither neutral beginning nor final truth; it must prove to be the undeveloped form of already mediated identity.","refs":["CL_GB18_49:DBN-02","CL_GB18_51:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:DBN-02","text":"Dependence and independence may not be distributed across separate levels of being, because pure independence would obscure the relational generation of every subsistence.","refs":["CL_GB18_49:DBN-01","CL_GB18_50:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:DBN-03","text":"Mediation may not be an external connector of already finished layers; form, content, and reflection must remain legible as operations of the same self-movement.","refs":["CL_GB18_51:DBN-01","CL_GB18_52:DBN-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:DBN-04","text":"A final reconciliation that retains difference while ending its mediating negativity is inadmissible; closure must produce new instability.","refs":["CL_GB18_50:DBN-03","CL_GB18_52:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_13:BSA-01","text":"The architecture is organized around the absence of an unmediated origin: every beginning must appear as a retrospectively posited moment of a relation.","refs":["CL_GB18_49:GA-06","CL_GB18_50:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSA-02","text":"Unavailable is a standpoint outside the movement from which its totality could be fully grasped or its forms independently established.","refs":["CL_GB18_51:BSA-02","CL_GB18_52:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSA-03","text":"The deepest missing possibility is a determinate absolute form that could appear without becoming external or self-sublating; this absence drives the entire negative closure.","refs":["CL_GB18_52:BSA-01","CL_GB18_52:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_13:XD-01","text":"The self-dissolution of the part-whole relation generates force as operative totality: what cannot be stably unified quantitatively becomes effective as negative unity. ; Trace Type — Composite","refs":["MC_GB18_L1_13:GA-04","MC_GB18_L1_13:GA-05","CL_GB18_49:GA-09","CL_GB18_50:ABS-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_13:XD-02","text":"The distributed self-relation of multiple forces becomes general self-mediation as soon as external determination is no longer merely reciprocally distributed, but understood as identity's own expression. ; Trace Type — Composite","refs":["MC_GB18_L1_13:GA-02","MC_GB18_L1_13:GA-03","MC_GB18_L1_13:GA-06","CL_GB18_50:ABS-06","CL_GB18_51:AS-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_13:XD-03","text":"Actuality as self-revelation supplies the ontological precondition of absolute self-interpretation: cognition can become immanent because appearance is already the activity of essence. ; Trace Type — Composite","refs":["MC_GB18_L1_13:GA-07","MC_GB18_L1_13:GA-08","CL_GB18_51:GA-07","CL_GB18_52:BAS-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_13:XD-04","text":"The relational negation of isolated independence escalates into the absolute rule of totality, according to which finite forms count only as functional moments of an overarching self-relation. ; Trace Type — Composite","refs":["MC_GB18_L1_13:GA-01","MC_GB18_L1_13:GA-10","CL_GB18_49:GA-02","CL_GB18_52:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_13:XD-05","text":"Externality must simultaneously be a real counterpart, a posited moment of its own, and a residue of reflection to be sublated; its productive ambiguity prevents both absolute foreignness and closed inwardness. ; Trace Type — Tension","refs":["MC_GB18_L1_13:GA-03","MC_GB18_L1_13:GA-05","MC_GB18_L1_13:GA-11","CL_GB18_50:FL-02","CL_GB18_51:FL-02","CL_GB18_52:GA-08"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_13:XD-06","text":"Infinite progress ends not through immobilization, but mutates into recursive self-interpretation: repetition becomes the inner movement of a totality whose negative closure generates its next instability. ; Trace Type — Tension","refs":["MC_GB18_L1_13:GA-04","MC_GB18_L1_13:GA-09","MC_GB18_L1_13:GA-11","CL_GB18_49:GA-10","CL_GB18_52:BAS-06"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_13:BSD-01","text":"Reality is a recursive field of production in which objects, forces, appearances, and attributes are only temporary condensations of a self-totalizing mediation.","refs":["CL_GB18_49:BSD-01","CL_GB18_52:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSD-02","text":"Cause and effect become reversible positions of a self-conditioning; causal explanation must therefore reconstruct the loop that generates its own presuppositions.","refs":["CL_GB18_50:BSD-02","CL_GB18_51:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSD-03","text":"Time joins reversal and retrospection: a determination is altered by its other and receives its truth only in returning to the producing totality.","refs":["CL_GB18_49:BSD-03","CL_GB18_52:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSD-04","text":"The subject is neither sovereign origin nor passive bearer, but a distributed structure of return that relates to itself only through posited and experienced otherness.","refs":["CL_GB18_50:HSI-02","CL_GB18_51:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:BSD-05","text":"Truth demands an immanent method that tests categories in their own movement and simultaneously performatively withdraws the external position of interpretation.","refs":["CL_GB18_52:BSD-04","CL_GB18_52:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_13:RLE-01","text":"Isolation generates counter-determination, counter-determination generates self-dissolution, and self-dissolution generates a new relational form; this loop is the elementary engine of progress.","refs":["CL_GB18_49:GA-08","CL_GB18_49:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RLE-02","text":"Force proceeds spirally from expression through alteration back to ground, generating identity as result rather than presupposition of this circuit.","refs":["CL_GB18_50:RLE-01","CL_GB18_50:FGS-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RLE-03","text":"Mutual Solicitation distributes self-determination across multiple forces: each actualizes the other and thereby receives its own activity as a returning condition.","refs":["CL_GB18_50:RLE-03","CL_GB18_50:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RLE-04","text":"The phase transition to actuality occurs as soon as externality is no longer an external state, but the necessary passage from immediacy through negation to mediated identity.","refs":["CL_GB18_51:RLE-01","CL_GB18_51:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RLE-05","text":"The attributive loop posits form, totalizes its content, and withdraws it as non-independent semblance; precisely this withdrawal reproduces the problem of the externality of reflection.","refs":["CL_GB18_52:RLE-03","CL_GB18_52:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:RLE-06","text":"Totality is the central attractor because every isolated determination refers, through its own inadequacy, to the unity that bears it and simultaneously disempowers it.","refs":["CL_GB18_51:RLE-03","CL_GB18_52:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_13:FGS-B01","text":"Appearance → essential relation → relational self-negation: Separate determinations prove to be moments of mediation, which simultaneously posits and revokes their independence.","refs":["CL_GB18_49:GA-01","CL_GB18_49:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FGS-B02","text":"Unstable totality → part-whole antinomy → negative unity of force: The composition that cannot be stabilized is transformed into an operative unity of sublated differences.","refs":["CL_GB18_49:GA-09","CL_GB18_50:ABS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FGS-B03","text":"Force → other force → Solicitation → reaction: Activity distributes itself across presupposed others and returns as its own mediated determination.","refs":["CL_GB18_50:GA-05","CL_GB18_50:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FGS-B04","text":"Negative unity → self-expression → reciprocal totalization → actuality: Difference is not obliterated, but reconstructed as the self-revelation of essence.","refs":["CL_GB18_51:GA-04","CL_GB18_51:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FGS-B05","text":"Actuality → immanent reflection → absolute self-interpretation → attribute: The operation of cognition is internalized and generates a form that presents the entire content only by losing its own independence.","refs":["CL_GB18_52:GA-04","CL_GB18_52:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FGS-B06","text":"Attributive totalization → self-sublation of form → return to identity → residue of externality: Negative closure reproduces the impossibility of a stable absolute form.","refs":["CL_GB18_52:BAS-06","CL_GB18_52:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_13:AFM-B01","text":"Essential relation → part-whole antinomy → force → reciprocal efficacy → self-mediation → actuality → absolute self-interpretation.","refs":["CL_GB18_51:RLE-02","CL_GB18_52:BAS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AFM-B02","text":"Independent externality → posited externality → presupposed condition → own expression → self-revelation → residue of reflection.","refs":["CL_GB18_50:RMD-02","CL_GB18_51:GA-02","CL_GB18_52:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AFM-B03","text":"External predication → critique of the external standpoint → immanentization of interpretation → withdrawal of the operation of cognition into the object.","refs":["CL_GB18_52:GNX-04","CL_GB18_52:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:AFM-B04","text":"Positing of form → totalization → deprivation of independence → return to identity → recurrence of the unresolved problem of form.","refs":["CL_GB18_52:GA-08","CL_GB18_52:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_13:MME-01","text":"The map shifts from things and hierarchical grounds to relational fields in which objects are only provisional forms of appearance of their mediation.","refs":["CL_GB18_49:MME-01","CL_GB18_50:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MME-02","text":"Identity is remapped from isolated independence into self-preservation through dependence, alteration, and return.","refs":["CL_GB18_49:MME-02","CL_GB18_50:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MME-03","text":"Causality is reclassified from linear transmission into a circular role-structure in which conditions and effects generate one another.","refs":["CL_GB18_50:BSD-02","CL_GB18_51:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MME-04","text":"Actuality is displaced from the existing domain of objects to the movement of self-revelation, formation, and retrospective totalization.","refs":["CL_GB18_51:MME-03","CL_GB18_52:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MME-05","text":"Critique of cognition becomes ontological: a method is inadequate if it treats categories outside the self-movement of which they are moments.","refs":["CL_GB18_52:BSD-01","CL_GB18_52:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MME-06","text":"The opposition of inner and outer collapses as an ontological alternative and returns as an operative, self-sublating difference of reflection.","refs":["CL_GB18_51:MME-04","CL_GB18_52:MME-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_13:ALT-B01","text":"At the surface level, the architecture connects whole and parts, force and expression, inner and outer, actuality and Absolute, as well as reflection and attribute.","refs":["CL_GB18_50:ALT-B01","CL_GB18_52:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:ALT-B02","text":"At the structural level, negative unity, positing, presupposition, expression, return, formation, and totalization operate as recurring mechanisms of transformation.","refs":["CL_GB18_51:ALT-B02","CL_GB18_52:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:ALT-B03","text":"At the metastrategic level, choosing between opposing sides is replaced by an immanent reconstruction of their mutual generation and self-sublation.","refs":["CL_GB18_51:ALT-B03","CL_GB18_52:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:ALT-B04","text":"At the ontological-temporal level, reality is a movement of development and return in which determinations receive their truth only after losing their immediate independence.","refs":["CL_GB18_51:ALT-B04","CL_GB18_52:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:ALT-B05","text":"At the methodological-performative level, the exposition enacts its thesis by transforming every assertion into transition, reversal, and withdrawal.","refs":["CL_GB18_50:ALT-B05","CL_GB18_52:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_13:FL-01","text":"Self-determination is supposed to produce its own externality, yet requires for its enactment a presupposed other force; autonomy remains constitutively conditioned.","refs":["CL_GB18_50:FL-01","CL_GB18_50:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FL-02","text":"Difference must be preserved as an effective moment, yet may possess no irreducible independence over against totality; preservation and disempowerment remain unresolvedly coupled.","refs":["CL_GB18_51:GA-04","CL_GB18_52:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FL-03","text":"The Absolute is supposed to contain no becoming, yet is presented through interpretation, reflection, and return as immanent movement; static completion and operative self-generation remain in tension.","refs":["CL_GB18_52:FL-01","CL_GB18_52:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FL-04","text":"The attribute is supposed to contain the entire absolute content and simultaneously disappear as inessential form; its complete expressive power coincides with its ontological nullity.","refs":["CL_GB18_52:FL-02","CL_GB18_52:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:FL-05","text":"The transitions to force and from conditioned forces to posited unity are functionally necessary, but not fully grounded in their particular consequential form.","refs":["CL_GB18_49:FL-02","CL_GB18_50:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MP-01","text":"Externality mutates from independent exteriority to posited condition, to the form of enactment of its own identity, and finally to the residual instability of absolute reflection.","refs":["CL_GB18_50:RMD-02","CL_GB18_51:GA-02","CL_GB18_52:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MP-02","text":"Appearance mutates into semblance as soon as mediation no longer forms positive existence, but renders transparent the non-independence of every finite determination.","refs":["CL_GB18_52:RMD-02","CL_GB18_52:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MP-03","text":"Force mutates from conditioned transition and reciprocal activity into the general operation that posits the conditions of its own actuality.","refs":["CL_GB18_51:RMD-01","CL_GB18_51:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MP-04","text":"External reflection mutates into inner self-interpretation, yet preserves in the return to identity a residue of abstract external position.","refs":["CL_GB18_52:MP-02","CL_GB18_52:FL-03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_13:HSI-01","text":"Reality appears as a recursive machine of totalization that generates relational unities and forms, lets them become effective, and subsequently deprives them of independent subsistence.","refs":["CL_GB18_49:HSI-01","CL_GB18_50:HSI-01","CL_GB18_52:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:HSI-02","text":"The subject is a distributed position of return: it possesses itself neither originally nor in isolation, but only in the mediated reappropriation of its otherness.","refs":["CL_GB18_50:HSI-02","CL_GB18_51:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:HSI-03","text":"Time is recursive and retrogressive: every determination reverses into its other and becomes true only through its retrospective placement within totality.","refs":["CL_GB18_49:HSI-02","CL_GB18_52:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:HSI-04","text":"Agency does not consist in fleeing mediation, but in the immanent navigation and deprivation of independence of those forms through which foreignness becomes effective.","refs":["CL_GB18_50:HSI-04","CL_GB18_52:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_13:MRT-B01","text":"The architecture is sufficient to reconstruct the movement from relational appearance through force and actuality to absolute self-interpretation as a coherent machine of negativity.","refs":["CL_GB18_49:MRT-B01","CL_GB18_50:MRT-B01","CL_GB18_52:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MRT-B02","text":"What remains underdetermined are the particular necessity of individual consequential forms, the complete positing of the unity of multiple forces, and the positive mediation between contentful ground and pure formal relation.","refs":["CL_GB18_49:FL-02","CL_GB18_50:MRT-B02","CL_GB18_51:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MRT-B03","text":"The reconstruction remains coherent insofar as sublation is understood as preserving deprivation of independence, which neither destroys difference nor allows it to persist as an independent counterforce.","refs":["CL_GB18_51:MRT-B02","CL_GB18_52:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_13:MRT-B04","text":"The architecture is strongest in reconstructing identity as mediation and most unstable at the necessary yet impossible positive form of the Absolute; this problem of form resists axiomatic closure.","refs":["CL_GB18_52:MRT-B04","CL_GB18_52:FL-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_13@R001","source_variant_id":"canonical:MC_GB18_L1_13:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 13","context":"Chapters 145–156 · C. Auflösung der Erscheinung. · A. Das Verhältniß des Ganzen und der Theile. · Anmerkung. · B. Das Verhältniß der Kraft und ihrer Äußerung. · a. Das Bedingtseyn der Kraft. · b. Die Sollicitation der Kraft. · c. Die Unendlichkeit der Kraft. · C. Verhältniß des Äußern und Innern. · Anmerkung. · Dritter Abschnitt. Die Wirklichkeit. · A. Die Auslegung des Absoluten. · B. Das absolute Attribut."},"title_language_code":"en"},{"id":"MC_GB18_L1_14","layer":"MC","title":"Gb18 L1 14","order":14,"parents":["CL_GB18_53","CL_GB18_54","CL_GB18_55","CL_GB18_56"],"revision":"MC_GB18_L1_14@R001","sha256":"099a7f9936b3e73225c8dc7352d272ab71ebdb7f2cf65324b14db770af3de673","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_14:AS-01","text":"Das zentrale Problem besteht darin, ein Absolutes zu rekonstruieren, das weder ruhender Grund noch äußerer Ursprung ist, sondern seine Modalitäten, Bedingungen und kausalen Unterschiede selbst erzeugt und vermittelt.","refs":["CL_GB18_53:ABS-B01","CL_GB18_56:BAS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-02","text":"Die globale These lautet, daß absolute Identität nur als selbstbezügliche Negativität besteht und ihre entwickelte Gestalt im Begriff erreicht, der Differenz nicht tilgt, sondern als eigene Gliederung organisiert.","refs":["CL_GB18_53:GA-01","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-03","text":"Die Grundlage dieser Bewegung ist die Regel, daß jede Bestimmung nur gilt, wenn ihre scheinbare Voraussetzung rückwirkend als Setzung derselben Bewegung ausgewiesen werden kann.","refs":["CL_GB18_53:GA-04","CL_GB18_54:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-04","text":"Die gerichtete Bewegung führt von bestimmter Identität über Modalität, absolute Notwendigkeit und Substanz zur Kausalität und von deren Umkehrung über Wechselwirkung zu Freiheit und Begriff.","refs":["CL_GB18_54:AS-B06","CL_GB18_56:BAS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-05","text":"Das Argument verfährt durch produktive Unzulänglichkeit: Jede Kategorie eskaliert, weil sie ihre ausgeschlossene Gegenbestimmung selbst hervorbringt und dadurch in eine umfassendere Vermittlungsform übergeht.","refs":["CL_GB18_54:RLE-04","CL_GB18_56:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-06","text":"Die Bewegung ist rekursiv und spiralförmig, weil das Resultat den Anfang rückwirkend bestimmt, Wirkungen Ursachen verwirklichen und gesetzte Bedingungen als Voraussetzungen zurückkehren.","refs":["CL_GB18_53:BSD-03","CL_GB18_55:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-07","text":"Die Schließung besteht nicht in Ruhe oder Unbedingtheit, sondern in Freiheit als manifester Bedingtheit und im Begriff als Selbstgliederung der zur Subjektivität gewordenen Substanz.","refs":["CL_GB18_56:BAS-07","CL_GB18_56:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_14:GA-01","text":"[Attractor] Das Absolute ist nur als Identität tragfähig, die ihre Unterschiede durch Selbstnegation hervorbringt, exponiert und in entwickelter Form auf sich zurückbezieht.","refs":["CL_GB18_53:GA-01","CL_GB18_54:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-02","text":"[Persistent] Äußerlichkeit und Andersheit besitzen keinen unabhängigen ontologischen Bestand; sie sind notwendige, zugleich erhaltene und aufgehobene Formen der Selbstvermittlung.","refs":["CL_GB18_53:GA-03","CL_GB18_56:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-03","text":"[Emergent] Eine Voraussetzung besitzt nur insofern Wahrheit, als die von ihr scheinbar abhängige Bewegung sie rückwirkend setzt und dadurch Selbstvoraussetzung wird.","refs":["CL_GB18_54:GA-04","CL_GB18_55:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-04","text":"[Mutating] Möglichkeit mutiert vom abstrakten Ansichsein zur realen Bedingungsmannigfaltigkeit und schließlich zum selbstgesetzten Bedingungsfeld einer notwendigen Wirklichkeit.","refs":["CL_GB18_53:GA-06","CL_GB18_54:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-05","text":"[Mutating] Zufälligkeit mutiert vom Mangel der Notwendigkeit zu deren Bewegungsform und schließlich zu ihrer manifesten Bestimmtheit.","refs":["CL_GB18_54:GA-06","CL_GB18_56:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-06","text":"[Mutating] Notwendigkeit entwickelt sich von der aufgehobenen Selbständigkeit der Modalitäten über substantielle Selbstmacht zur manifesten Identität der Bedingtheit, die Freiheit heißt.","refs":["CL_GB18_53:GA-07","CL_GB18_56:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-07","text":"[Emergent] Substanz ist nicht das hinter Erscheinungen ruhende Substrat, sondern die nur in ihrer Accidentalität existierende Organisation von Manifestation, Hervorbringen und Aufheben.","refs":["CL_GB18_54:GA-07","CL_GB18_54:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-08","text":"[Mutating] Kausalität ist die notwendige Differenzierung substantieller Macht und wird wirklich, indem sie gesetzte Wirkungen, Bedingungen und Rückkehr auf sich erzeugt.","refs":["CL_GB18_54:GA-09","CL_GB18_56:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-09","text":"[Persistent] Ursache und Wirkung sowie Aktivität und Passivität sind keine selbständigen Entitäten oder Eigenschaften, sondern reversible Funktionsstellen eines einzigen Vermittlungsprozesses.","refs":["CL_GB18_55:GA-05","CL_GB18_56:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-10","text":"[Attractor] Jede einseitige Ursachposition erzeugt durch ihre Bestimmtheit ihre eigene Passivierung und zwingt den kausalen Fortgang in rekursive Umkehrung.","refs":["CL_GB18_55:GA-07","CL_GB18_56:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-11","text":"[Terminal] Wechselwirkung hebt nicht nur eine äußere Relation auf, sondern überführt die verteilten kausalen Rollen in die Selbstunterscheidung des Begriffs.","refs":["CL_GB18_56:RMD-05","CL_GB18_56:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-12","text":"[Terminal] Freiheit und Begriff bilden die Schließung der Architektur: Freiheit ist manifestierte Notwendigkeit, während der Begriff diese Manifestation als Allgemeinheit, Besonderheit und Einzelheit gliedert.","refs":["CL_GB18_56:GA-07","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-13","text":"[Emergent] Erkenntnisform und Seinsform fallen in der immanenten Rekonstruktion zusammen, weil Kategorien nicht auf fertige Realität angewandt werden, sondern deren Selbstbewegung artikulieren.","refs":["CL_GB18_53:XD-01","CL_GB18_56:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_14:RMD-01","text":"Identität kehrt funktional wieder, mutiert jedoch von unmittelbarer Gleichheit über notwendige Selbstbeziehung und substantielle Macht zur begrifflich gegliederten Selbstidentität.","refs":["CL_GB18_53:RMD-01","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-02","text":"Negation verschiebt sich von der Grenze einer Bestimmung zur Produktivkraft, die Modalität, Substanz, Kausalität und begriffliche Selbstunterscheidung erzeugt.","refs":["CL_GB18_53:RMD-02","CL_GB18_56:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-03","text":"Äußerlichkeit wandert vom Modus des Absoluten über Bedingung und Substrat zur gesetzten Passivität und wird schließlich als interne Vermittlungsstelle absorbiert.","refs":["CL_GB18_53:RMD-03","CL_GB18_56:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-04","text":"Möglichkeit verliert schrittweise ihre Selbständigkeit: Als reales Bedingungsfeld erzeugt sie ihren Widerspruch und wird zur rückwirkend gesetzten Voraussetzung der Wirklichkeit.","refs":["CL_GB18_54:RMD-02","CL_GB18_54:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-05","text":"Zufälligkeit bewahrt ihren Inhalt als Bestimmtheit, kehrt aber ihre Valenz um, indem sie von der Grenze der Notwendigkeit zu deren Erscheinungs- und Freiheitsform wird.","refs":["CL_GB18_54:RMD-04","CL_GB18_56:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-06","text":"Wirklichkeit und Substanz mutieren von modal reflektierter Einheit zur Macht, die nur in der Erzeugung, Vernichtung und Reorganisation ihrer Gestalten besteht.","refs":["CL_GB18_54:RMD-05","CL_GB18_55:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-07","text":"Kausalität wird weder bewahrt noch einfach aufgehoben: Ihre formelle Zweiheit erlischt, kehrt als endliche Äußerlichkeit wieder und wird durch Selbstvoraussetzung und Wechselwirkung transformiert.","refs":["CL_GB18_55:RMD-05","CL_GB18_56:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-08","text":"Passivität mutiert vom fremden Erleiden zur selbstgesetzten Bedingung der Aktivität; aus dieser Umkehrung geht Subjektivität als organisierte Selbstbestimmung hervor.","refs":["CL_GB18_56:RMD-03","CL_GB18_56:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_14:CGD-01","text":"Die lokalen Sequenzen von Substanz, Attribut, Modus und einzelnen Modalitäten skalieren nur als allgemeine Regel, daß jede Bestimmung aus immanenter Selbstvermittlung hervorgehen muß.","refs":["CL_GB18_53:CGD-01","CL_GB18_55:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:CGD-02","text":"Die vorhandene Mannigfaltigkeit realer Bedingungen bleibt eine lokale Exposition; auf der aktuellen Ebene trägt ihre Umcodierung in einen rückwirkend erzeugten Grund.","refs":["CL_GB18_54:CGD-01","CL_GB18_54:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:CGD-03","text":"Die formelle Einheit von Substanz und Accidenzen bleibt eine Übergangsbestimmung; global relevant ist ihr produktives Defizit, das substantielle Macht zur Kausalität differenziert.","refs":["CL_GB18_54:CGD-04","CL_GB18_54:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:CGD-04","text":"Einzelne Ereignisse, Anlässe und endliche Reihen bleiben lokale Diagnosefiguren; auf der aktuellen Ebene zeigen sie die Instabilität jeder fixierten Ursachrolle.","refs":["CL_GB18_55:CGD-03","CL_GB18_55:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:CGD-05","text":"Gewalt bleibt eine lokale Expositionsform äußerlicher Einwirkung; auf der aktuellen Ebene wird sie in die allgemeinere Umkehrung von Aktivität, Passivität und Bedingtheit absorbiert.","refs":["CL_GB18_56:RMD-04","CL_GB18_56:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:CGD-06","text":"Die Einheit von Allgemeinheit, Besonderheit und Einzelheit ist eine terminale Bestimmung der aktuellen Ebene, bleibt aber von der vorausgehenden Eskalation abhängig und nicht selbständig deduziert.","refs":["CL_GB18_56:CGD-05","CL_GB18_56:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_14:GNX-01","text":"Ausgeschlossen ist ein Absolutes, dessen Identität vor Selbstunterscheidung, Manifestation und Rückkehr vollständig wäre.","refs":["CL_GB18_53:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GNX-02","text":"Ausgeschlossen ist jede Erklärung, die Bedingungen, Ursachen oder Relationen als äußerlich hinzukommende Verbindungen unabhängiger Dinge behandelt.","refs":["CL_GB18_54:GNX-02","CL_GB18_56:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GNX-03","text":"Ausgeschlossen sind Möglichkeit und Zufälligkeit als selbständige Gegenbereiche der Wirklichkeit oder als eliminierbare Reste vollendeter Notwendigkeit.","refs":["CL_GB18_54:GNX-01","CL_GB18_54:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GNX-04","text":"Ausgeschlossen ist ein erster endlicher Grund oder unmittelbarer Ursprung, der nicht selbst als Wirkung, Bedingung und gesetzte Voraussetzung vermittelt wäre.","refs":["CL_GB18_55:GNX-04","CL_GB18_56:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GNX-05","text":"Ausgeschlossen sind Freiheit als Unbedingtheit und logische Form als bloß äußerliches Schema einer ontologisch getrennten Wirklichkeit.","refs":["CL_GB18_56:GNX-04","CL_GB18_56:DBN-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_14:DBN-01","text":"Falsch sein muß, daß Wahrheit mit einem unmittelbaren Anfang zusammenfallen kann; andernfalls könnte das Resultat den Anfang nicht als eigenes Moment rekonstruieren.","refs":["CL_GB18_53:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:DBN-02","text":"Unzulässig ist ein Modell, in dem Relata ihrer Relation vorausgehen, weil dadurch Ursache, Wirkung, Aktivität und Passivität zu unbeweglichen Trägern erstarren würden.","refs":["CL_GB18_56:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:DBN-03","text":"Unzulässig ist sowohl autonome Vielheit als auch differenzlose Einheit; Differenz muß real wirksam sein, ohne einen von der Totalität unabhängigen Bestand zu gewinnen.","refs":["CL_GB18_53:DBN-02","CL_GB18_54:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:DBN-04","text":"Unzulässig ist eine Erkenntnis, die fertige Gegenstände repräsentiert, ohne die Genesis ihrer Bestimmungen als dieselbe Bewegung von Denken und Sein nachzuvollziehen.","refs":["CL_GB18_53:XD-01","CL_GB18_56:DBN-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:DBN-05","text":"Die terminale Begriffsform kann kein verbleibendes Außen zulassen, weil ein unabhängiger Grund die Rückführung kausaler Differenz in Selbstunterscheidung widerrufen würde.","refs":["CL_GB18_56:BSA-02","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_14:BSA-01","text":"Die tiefste ausgeschlossene Möglichkeit ist eine Außenposition gegenüber dem Absoluten, von der aus seine Unterschiede erkannt, verursacht oder begrenzt werden könnten.","refs":["CL_GB18_53:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSA-02","text":"Unverfügbar ist ein absoluter Anfang vor aller Vermittlung, weil das Selbst, das setzen soll, erst durch das Aufheben seiner Voraussetzungen hervorgeht.","refs":["CL_GB18_54:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSA-03","text":"Nicht verfügbar ist ein letzter Ursprung, der seine Wirkung hervorbringt, ohne durch sie Wirklichkeit, Grenze und Rückbeziehung zu erhalten.","refs":["CL_GB18_55:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSA-04","text":"Unzulässig ist eine Freiheit, die Nichtidentität und Bedingungslosigkeit bewahrt; das System kennt Freiheit nur als bewußte Selbstgegenwart vermittelter Notwendigkeit.","refs":["CL_GB18_56:BSA-03","CL_GB18_56:GA-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_14:XD-01","text":"Die Selbstaufhebung realer Bedingungen erzeugt nicht nur Notwendigkeit, sondern den Übergang zu einer Substanz, deren unentwickelte Identität sich notwendig als Kausalität differenzieren muß.","refs":["MC_GB18_L1_14:GA-04","MC_GB18_L1_14:GA-06","MC_GB18_L1_14:GA-07","MC_GB18_L1_14:GA-08","CL_GB18_54:AS-B05","CL_GB18_54:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_14:XD-02","text":"Die fehlende reale Differenz zwischen Substanz und Accidentalität erzwingt die Unterscheidung von Ursache und Wirkung, ohne diesen Rollen ontologische Selbständigkeit verleihen zu können.","refs":["MC_GB18_L1_14:GA-07","MC_GB18_L1_14:GA-08","MC_GB18_L1_14:GA-09","CL_GB18_54:FL-03","CL_GB18_55:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_14:XD-03","text":"Der unendliche Regreß endlicher Ursachen wird zur Übergangsmaschine: Weil jede Ursache Wirkung ist, muß der Kausalzusammenhang sein Bedingungsfeld selbst setzen und in Wechselwirkung zurückkehren.","refs":["MC_GB18_L1_14:GA-03","MC_GB18_L1_14:GA-10","MC_GB18_L1_14:GA-11","CL_GB18_55:RLE-03","CL_GB18_56:RLE-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_14:XD-04","text":"Die Umcodierung von Zufälligkeit in die Erscheinungsform der Notwendigkeit liefert die modale Voraussetzung dafür, Bedingtheit nicht als Freiheitsverlust, sondern als Freiheit in manifester Gestalt zu bestimmen.","refs":["MC_GB18_L1_14:GA-05","MC_GB18_L1_14:GA-06","MC_GB18_L1_14:GA-12","CL_GB18_56:BAS-06","CL_GB18_56:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_14:XD-05","text":"Die wiederholte Internalisierung von Äußerlichkeit schließt sowohl einen unabhängigen Modus als auch einen endgültig äußeren Grund aus und macht Gegenwirkung zur letzten kausalen Form der Rücknahme des Außen.","refs":["MC_GB18_L1_14:GA-02","MC_GB18_L1_14:GA-09","MC_GB18_L1_14:GA-11","CL_GB18_53:GNX-02","CL_GB18_56:BSA-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_14:XD-06","text":"Erklärung wird operativ identisch mit der Sache, sobald sie nicht äußere Ursachen auflistet, sondern die Umschläge rekonstruiert, durch welche die Sache ihre Bedingungen, Rollen und Voraussetzungen erzeugt.","refs":["MC_GB18_L1_14:GA-03","MC_GB18_L1_14:GA-08","MC_GB18_L1_14:GA-13","CL_GB18_54:BSD-05","CL_GB18_56:BSD-05"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_14:BSD-01","text":"Realität wird zu einer grundlosen Begründungsmaschine, deren Grund nicht vorausliegt, sondern als aufgehobene Voraussetzung ihres eigenen Vollzugs entsteht.","refs":["CL_GB18_53:BSD-01","CL_GB18_56:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSD-02","text":"Zeit ist rekursive Resultatszeit: Möglichkeit wird rückwirkend zur Voraussetzung, Wirkung verwirklicht Ursache, und das Resultat bestimmt den Sinn des Anfangs.","refs":["CL_GB18_53:BSD-03","CL_GB18_56:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSD-03","text":"Das Subjekt verliert den Status eines vorausgesetzten Zentrums und entsteht als Form, in der substantielle Selbstvermittlung ihre Differenzen als eigene Bestimmungen erkennt.","refs":["CL_GB18_53:BSD-02","CL_GB18_56:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSD-04","text":"Handlungsmacht besteht nicht im unvermittelten Anfangen, sondern in der Fähigkeit organisierter Einheiten, Bedingungen selektiv anzueignen, umzubilden und als eigene Wirksamkeit zu manifestieren.","refs":["CL_GB18_55:BSD-04","CL_GB18_56:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSD-05","text":"Erkenntnis wird von Repräsentation zur genetischen Rekonstruktion transformiert; wahr ist eine Erklärung nur, wenn sie das Vorausgesetzte als Ergebnis der Sache ausweist.","refs":["CL_GB18_53:MME-03","CL_GB18_54:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_14:RLE-01","text":"Die Grundschleife lautet: Identität setzt Bestimmtheit, Bestimmtheit erzeugt Negation, Negation exponiert Äußerlichkeit, und deren Rücknahme erzeugt konkretere Identität.","refs":["CL_GB18_53:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RLE-02","text":"Die Modalitätsschleife führt von realer Möglichkeit über den Widerspruch ihres Bedingungsfeldes zur Wirklichkeit, die ihre Möglichkeit rückwirkend als eigene Voraussetzung setzt.","refs":["CL_GB18_54:RLE-01","CL_GB18_54:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RLE-03","text":"Die Eskalation von Notwendigkeit zu Substanz und Kausalität entsteht, weil absolute Identität ihre Negativität als reale Differenz artikulieren muß.","refs":["CL_GB18_54:RLE-04","CL_GB18_54:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RLE-04","text":"Die endliche Kausalschleife verläuft von Ursache zu Wirkung und zurück zur Ursache als Wirkung; ihr schlechter Fortgang kollabiert erst in Selbstvoraussetzung.","refs":["CL_GB18_55:RLE-03","CL_GB18_55:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RLE-05","text":"Die Aktivitäts-Passivitäts-Schleife führt von gesetzter Bedingung über Einwirkung und Gegenwirkung zur Passivierung der ersten Ursache und damit zur Wechselwirkung.","refs":["CL_GB18_56:RLE-01","CL_GB18_56:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RLE-06","text":"Der terminale Attraktor ist der Begriff, weil die Eskalation von Kausalität, Wechselwirkung und Freiheit dort als innere Gliederung einer subjektiven Totalität konvergiert.","refs":["CL_GB18_56:RLE-05","CL_GB18_56:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_14:FGS-B01","text":"Unmittelbare Identität → verborgene Bestimmtheit → Negation → Selbstunterscheidung als Bedingung konkreter Identität.","refs":["CL_GB18_53:ABS-B02","CL_GB18_53:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FGS-B02","text":"Selbstunterscheidung → Äußerlichkeit → Möglichkeit als Bedingungsfeld → immanenter Widerspruch des Vorausgesetzten.","refs":["CL_GB18_54:GA-02","CL_GB18_54:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FGS-B03","text":"Selbstaufhebung der Bedingungen → rückwirkende Setzung der Voraussetzung → absolute Notwendigkeit → Identität von Sein und Wesen.","refs":["CL_GB18_54:GA-04","CL_GB18_54:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FGS-B04","text":"Absolute Notwendigkeit → Substanz als Manifestation → Accidentalität → substantielle Macht des Hervorbringens und Aufhebens.","refs":["CL_GB18_54:GA-07","CL_GB18_54:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FGS-B05","text":"Substantielle Macht → Ursache und Wirkung → endliche Rollenfixierung → Regreß → selbstgesetzte Voraussetzung der Kausalität.","refs":["CL_GB18_55:GA-05","CL_GB18_55:GA-07","CL_GB18_55:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FGS-B06","text":"Selbstgesetzte Bedingung → Gegenwirkung → Wechselwirkung → manifestierte Notwendigkeit → Freiheit → Begriff als subjektive Selbstgliederung.","refs":["CL_GB18_56:GA-04","CL_GB18_56:GA-07","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_14:AFM-B01","text":"Unmittelbare Identität → bestimmte Negation → gesetzte Äußerlichkeit → Wirklichkeit als selbstbezügliche Manifestation.","refs":["CL_GB18_53:RMD-01","CL_GB18_53:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AFM-B02","text":"Reale Möglichkeit → widersprüchliches Bedingungsfeld → rückwirkende Selbstbegründung → absolute Notwendigkeit → Substanz.","refs":["CL_GB18_54:RMD-02","CL_GB18_54:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AFM-B03","text":"Substantielle Macht → Ursache/Wirkung-Asymmetrie → endliche Umkehrung → kausaler Regreß → Selbstvoraussetzung.","refs":["CL_GB18_55:GA-01","CL_GB18_55:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AFM-B04","text":"Selbstvoraussetzung → Gegenwirkung → Wechselwirkung → manifeste Notwendigkeit → Freiheit → Begriff.","refs":["CL_GB18_56:BAS-05","CL_GB18_56:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_14:MME-01","text":"Einheit und Vielheit werden nicht mehr als Alternativen kartiert; Vielheit ist die notwendige Manifestations- und Differenzierungsform einer Einheit, die nur in ihr konkret ist.","refs":["CL_GB18_53:MME-01","CL_GB18_54:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MME-02","text":"Möglichkeit, Zufälligkeit und Notwendigkeit werden von getrennten Modalbereichen zu Phasen der Erzeugung, Bestimmung und Manifestation derselben Wirklichkeit umgeordnet.","refs":["CL_GB18_53:MME-04","CL_GB18_54:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MME-03","text":"Der Gegensatz von Substanz und Accidenz zerfällt; beide werden als unterschiedliche Vollzugsformen einer einzigen manifestierenden Macht lesbar.","refs":["CL_GB18_54:MME-03","CL_GB18_54:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MME-04","text":"Ursache und Wirkung werden von Dingen oder Ereignispositionen zu reversiblen Statusformen eines Wirkungszusammenhangs reklassifiziert.","refs":["CL_GB18_55:MME-01","CL_GB18_56:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MME-05","text":"Lineare Zeit und schlechte Unendlichkeit werden durch rekursive Rückkehr ersetzt, in der Wirkungen Ursachen bestimmen und Übergänge ihre eigenen Voraussetzungen erzeugen.","refs":["CL_GB18_55:BSD-02","CL_GB18_56:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MME-06","text":"Freiheit wird von der Negation der Bedingtheit zur expliziten Selbstgegenwart eines vermittelten Zusammenhangs umkartiert.","refs":["CL_GB18_56:BSD-04","CL_GB18_56:MME-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_14:ALT-B01","text":"Surface level — Die expliziten Gegenstände sind Absolutes, Wirklichkeit, Möglichkeit, Zufälligkeit, Notwendigkeit, Substanz, Accidentalität, Ursache, Wirkung, Wechselwirkung, Freiheit und Begriff.","refs":["CL_GB18_53:ALT-B01","CL_GB18_56:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:ALT-B02","text":"Structural level — Alle Gegenstände werden durch Setzung, Negation, Bedingung, Umkehrung, Rückkehr und Selbstvoraussetzung als Phasen einer einzigen Vermittlungslogik organisiert.","refs":["CL_GB18_53:ALT-B02","CL_GB18_56:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:ALT-B03","text":"Metastrategic level — Erklärung wird als Prüfung reformuliert, ob vermeintlich äußere Ursachen, Gründe und Bedingungen als Momente immanenter Selbsttätigkeit rekonstruierbar sind.","refs":["CL_GB18_54:ALT-B03","CL_GB18_55:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:ALT-B04","text":"Ontological / Temporal level — Sein ist selbstwirkende Macht, und Zeit ist die rekursive Ordnung, in der Setzungen durch ihre Resultate als Voraussetzungen zurückkehren.","refs":["CL_GB18_55:ALT-B04","CL_GB18_56:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:ALT-B05","text":"Methodological / Performative level — Die Darstellung vollzieht ihre These, indem sie jede feste Bestimmung in deren Grenze, Gegenbestimmung und vermittelte Rückkehr überführt.","refs":["CL_GB18_53:ALT-B05","CL_GB18_56:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_14:FL-01","text":"Negation muß zunächst als äußerliche Reflexion erscheinen, obwohl ihre produktive Wirksamkeit nur verständlich ist, wenn sie bereits immanente Selbstnegation ist.","refs":["CL_GB18_53:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FL-02","text":"Die Vollständigkeit des Bedingungsfeldes wird benötigt, ohne daß die Genesis seines konkreten Inhalts vollständig ausgewiesen wird.","refs":["CL_GB18_54:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FL-03","text":"Die Substanz soll keinen realen Unterschied zu ihren Accidenzen besitzen, muß aber reale Differenz erzeugen, damit Kausalität entstehen kann.","refs":["CL_GB18_54:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FL-04","text":"Die Ursache beansprucht Ursprünglichkeit, erhält Wirklichkeit jedoch ausschließlich durch die Wirkung, die ihren Vorrang zugleich vermittelt und begrenzt.","refs":["CL_GB18_55:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FL-05","text":"Gewalt bleibt zwischen äußerlicher Einwirkung und Verwirklichung einer im Erleidenden liegenden Bestimmung gespannt; ihre Internalisierung beseitigt diese Doppelvalenz nicht vollständig.","refs":["CL_GB18_56:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FL-06","text":"Der Übergang von Wechselwirkung zu Begriff beruht auf der Gleichsetzung des Übergehens in Anderes mit Reflexion in sich, ohne diese Gleichsetzung selbständig zu deduzieren.","refs":["CL_GB18_56:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MP-01","text":"Zufälligkeit mutiert von Grundlosigkeit und Begrenzung zur positiven Bewegungs- und Manifestationsform der Notwendigkeit.","refs":["CL_GB18_53:MP-02","CL_GB18_54:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MP-02","text":"Die Bedingung mutiert vom vorausgesetzten fremden Umstand zur selbstgesetzten Passivität, durch welche Wirksamkeit sich auf sich bezieht.","refs":["CL_GB18_54:MP-01","CL_GB18_56:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MP-03","text":"Accidentalität mutiert vom bloßen Schein zur für sich seienden Negativität und eröffnet dadurch den Übergang von Substantialität zu Kausalität.","refs":["CL_GB18_54:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MP-04","text":"Freiheit mutiert vom Gegenbegriff der Notwendigkeit zu deren manifester Form und bereitet damit die Umwandlung von Substanz in Begriff vor.","refs":["CL_GB18_56:MP-03","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_14:HSI-01","text":"Realität erscheint als selbstdifferenzierende Vermittlungsmaschine, die keine äußeren Daten verarbeitet, sondern ihre Bedingungen, Außenseiten und Relationen als eigene Momente erzeugt.","refs":["CL_GB18_53:HSI-01","CL_GB18_56:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:HSI-02","text":"Das Subjekt ist keine ursprüngliche Entität, sondern die Form, in der Substanz ihre Differenzen als eigene Bestimmungen organisiert und manifestiert.","refs":["CL_GB18_56:BSD-02","CL_GB18_56:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:HSI-03","text":"Zeit ist Rückkehrszeit: Das Resultat setzt seinen Anfang, die Wirkung verwirklicht ihre Ursache, und Wirklichkeit fällt in Möglichkeit zurück, ohne bloß wiederholt zu werden.","refs":["CL_GB18_54:HSI-03","CL_GB18_56:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:HSI-04","text":"Handlung und Navigation bleiben als immanente Transformation möglich, die zwischen Anlaß, Bedingung, Wirkung und Selbstbestimmung unterscheidet, statt nach einem isolierten Ursprung zu suchen.","refs":["CL_GB18_55:HSI-04","CL_GB18_56:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_14:MRT-B01","text":"Die Axiome reichen aus, um die Bewegung von unmittelbarer Identität über Modalität, Notwendigkeit, Substanz und Kausalität bis zu Wechselwirkung, Freiheit und Begriff zu rekonstruieren.","refs":["CL_GB18_53:MRT-B01","CL_GB18_56:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MRT-B02","text":"Die stärkste Achse der Architektur ist die fortgesetzte Umwandlung äußerlicher Andersheit in produktive Selbstunterscheidung, ohne Differenz auf bloßen Schein zu reduzieren.","refs":["CL_GB18_54:MRT-B03","CL_GB18_56:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MRT-B03","text":"Unterbestimmt bleiben die Genesis konkreter Inhaltsbestimmtheit und die Notwendigkeit jener substantiellen Identität, auf der die Rückkehr von Kausalität in Begriff beruht.","refs":["CL_GB18_54:MRT-B02","CL_GB18_56:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MRT-B04","text":"Das System ist kohärent, sofern Notwendigkeit nicht als erster Grund und Begriff nicht als äußerlich angefügtes Resultat, sondern beide als terminale Formen rekursiver Selbstvermittlung gelesen werden.","refs":["CL_GB18_53:MRT-B04","CL_GB18_56:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MRT-B05","text":"Ein unverzichtbares Element widersteht vollständiger axiomatischer Reduktion: Die terminale Begriffsstruktur bleibt auf die konkrete Sequenz von Kausalität, Gegenwirkung, Wechselwirkung und Freiheit angewiesen.","refs":["CL_GB18_55:MRT-B02","CL_GB18_56:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T124141938844Z_d1e38099","language_code":"en","language_name":"English","title":"Gb18 L1 14","source_sha256":"099a7f9936b3e73225c8dc7352d272ab71ebdb7f2cf65324b14db770af3de673","sha256":"beb6274ede934d97cc034a5dd94693377e323f683ac5afeb36ac2ce2a4dd12af","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:41:41.941100+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"MC_GB18_L1_14:AS-01","text":"The central problem consists in reconstructing an Absolute that is neither resting ground nor external origin, but itself generates and mediates its modalities, conditions, and causal differences.","refs":["CL_GB18_53:ABS-B01","CL_GB18_56:BAS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-02","text":"The global thesis is that absolute identity exists only as self-relating negativity and attains its developed shape in the Concept, which does not efface difference but organizes it as its own articulation.","refs":["CL_GB18_53:GA-01","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-03","text":"The basis of this movement is the rule that every determination is valid only if its apparent presupposition can retrospectively be shown to be a positing of the same movement.","refs":["CL_GB18_53:GA-04","CL_GB18_54:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-04","text":"The directed movement leads from determinate identity through modality, absolute necessity, and substance to causality, and from its reversal through reciprocal action to freedom and the Concept.","refs":["CL_GB18_54:AS-B06","CL_GB18_56:BAS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-05","text":"The argument proceeds through productive inadequacy: each category escalates because it itself produces its excluded counter-determination and thereby passes into a more comprehensive form of mediation.","refs":["CL_GB18_54:RLE-04","CL_GB18_56:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-06","text":"The movement is recursive and spiral-shaped because the result retrospectively determines the beginning, effects actualize causes, and posited conditions return as presuppositions.","refs":["CL_GB18_53:BSD-03","CL_GB18_55:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AS-07","text":"Closure consists not in repose or unconditionedness, but in freedom as manifest conditionedness and in the Concept as the self-articulation of substance become subjectivity.","refs":["CL_GB18_56:BAS-07","CL_GB18_56:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"MC_GB18_L1_14:GA-01","text":"[Attractor] The Absolute is sustainable as identity only if it brings forth, exposes, and relates back to itself its differences through self-negation in developed form.","refs":["CL_GB18_53:GA-01","CL_GB18_54:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-02","text":"[Persistent] Externality and otherness possess no independent ontological subsistence; they are necessary forms of self-mediation that are at once preserved and sublated.","refs":["CL_GB18_53:GA-03","CL_GB18_56:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-03","text":"[Emergent] A presupposition possesses truth only insofar as the movement apparently dependent upon it retrospectively posits it and thereby becomes self-presupposition.","refs":["CL_GB18_54:GA-04","CL_GB18_55:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-04","text":"[Mutating] Possibility mutates from abstract being-in-itself to the manifold of real conditions and finally to the self-posited field of conditions of a necessary actuality.","refs":["CL_GB18_53:GA-06","CL_GB18_54:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-05","text":"[Mutating] Contingency mutates from the deficiency of necessity into its form of movement and finally into its manifest determinacy.","refs":["CL_GB18_54:GA-06","CL_GB18_56:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-06","text":"[Mutating] Necessity develops from the sublated independence of the modalities through substantial self-power to the manifest identity of conditionedness called freedom.","refs":["CL_GB18_53:GA-07","CL_GB18_56:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-07","text":"[Emergent] Substance is not the substrate resting behind appearances, but the organization of manifestation, production, and sublation that exists only in its accidentality.","refs":["CL_GB18_54:GA-07","CL_GB18_54:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-08","text":"[Mutating] Causality is the necessary differentiation of substantial power and becomes actual by generating posited effects, conditions, and return to itself.","refs":["CL_GB18_54:GA-09","CL_GB18_56:GA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-09","text":"[Persistent] Cause and effect, as well as activity and passivity, are not independent entities or properties, but reversible functional positions of a single process of mediation.","refs":["CL_GB18_55:GA-05","CL_GB18_56:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-10","text":"[Attractor] Every one-sided causal position produces, through its determinacy, its own passivation and compels causal progression into recursive reversal.","refs":["CL_GB18_55:GA-07","CL_GB18_56:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-11","text":"[Terminal] Reciprocal action not only sublates an external relation, but transfers the distributed causal roles into the self-differentiation of the Concept.","refs":["CL_GB18_56:RMD-05","CL_GB18_56:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-12","text":"[Terminal] Freedom and the Concept constitute the closure of the architecture: freedom is manifested necessity, while the Concept articulates this manifestation as universality, particularity, and singularity.","refs":["CL_GB18_56:GA-07","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GA-13","text":"[Emergent] Form of cognition and form of being coincide in immanent reconstruction, because categories are not applied to a finished reality but articulate its self-movement.","refs":["CL_GB18_53:XD-01","CL_GB18_56:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"MC_GB18_L1_14:RMD-01","text":"Identity functionally recurs, yet mutates from immediate sameness through necessary self-relation and substantial power to conceptually articulated self-identity.","refs":["CL_GB18_53:RMD-01","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-02","text":"Negation shifts from the limit of a determination to the productive force that generates modality, substance, causality, and conceptual self-differentiation.","refs":["CL_GB18_53:RMD-02","CL_GB18_56:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-03","text":"Externality migrates from the mode of the Absolute through condition and substrate to posited passivity, and is finally absorbed as an internal site of mediation.","refs":["CL_GB18_53:RMD-03","CL_GB18_56:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-04","text":"Possibility gradually loses its independence: as a real field of conditions, it generates its contradiction and becomes the retrospectively posited presupposition of actuality.","refs":["CL_GB18_54:RMD-02","CL_GB18_54:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-05","text":"Contingency preserves its content as determinacy but reverses its valence by becoming, from the limit of necessity, its form of appearance and freedom.","refs":["CL_GB18_54:RMD-04","CL_GB18_56:RMD-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-06","text":"Actuality and substance mutate from modally reflected unity into the power that exists only in the production, destruction, and reorganization of its shapes.","refs":["CL_GB18_54:RMD-05","CL_GB18_55:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-07","text":"Causality is neither preserved nor simply sublated: its formal duality expires, returns as finite externality, and is transformed through self-presupposition and reciprocal action.","refs":["CL_GB18_55:RMD-05","CL_GB18_56:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RMD-08","text":"Passivity mutates from alien suffering into the self-posited condition of activity; from this reversal subjectivity emerges as organized self-determination.","refs":["CL_GB18_56:RMD-03","CL_GB18_56:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"MC_GB18_L1_14:CGD-01","text":"The local sequences of substance, attribute, mode, and individual modalities scale only as the general rule that every determination must arise from immanent self-mediation.","refs":["CL_GB18_53:CGD-01","CL_GB18_55:CGD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:CGD-02","text":"The existing manifold of real conditions remains a local exposition; at the current level, its recoding into a retrospectively generated ground is decisive.","refs":["CL_GB18_54:CGD-01","CL_GB18_54:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:CGD-03","text":"The formal unity of substance and accidents remains a transitional determination; globally relevant is its productive deficit, which differentiates substantial power into causality.","refs":["CL_GB18_54:CGD-04","CL_GB18_54:XD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:CGD-04","text":"Individual events, occasions, and finite series remain local diagnostic figures; at the current level, they show the instability of every fixed causal role.","refs":["CL_GB18_55:CGD-03","CL_GB18_55:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:CGD-05","text":"Violence remains a local form of exposition of external influence; at the current level, it is absorbed into the more general reversal of activity, passivity, and conditionedness.","refs":["CL_GB18_56:RMD-04","CL_GB18_56:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:CGD-06","text":"The unity of universality, particularity, and singularity is a terminal determination of the current level, but remains dependent on the preceding escalation and is not independently deduced.","refs":["CL_GB18_56:CGD-05","CL_GB18_56:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"MC_GB18_L1_14:GNX-01","text":"Excluded is an Absolute whose identity would be complete prior to self-differentiation, manifestation, and return.","refs":["CL_GB18_53:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GNX-02","text":"Excluded is every explanation that treats conditions, causes, or relations as externally added connections among independent things.","refs":["CL_GB18_54:GNX-02","CL_GB18_56:GNX-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GNX-03","text":"Excluded are possibility and contingency as independent counter-domains of actuality or as eliminable remnants of completed necessity.","refs":["CL_GB18_54:GNX-01","CL_GB18_54:BSA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GNX-04","text":"Excluded is a first finite ground or immediate origin that would not itself be mediated as effect, condition, and posited presupposition.","refs":["CL_GB18_55:GNX-04","CL_GB18_56:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:GNX-05","text":"Excluded are freedom as unconditionedness and logical form as a merely external schema of an ontologically separate actuality.","refs":["CL_GB18_56:GNX-04","CL_GB18_56:DBN-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"MC_GB18_L1_14:DBN-01","text":"It must be false that truth can coincide with an immediate beginning; otherwise, the result could not reconstruct the beginning as its own moment.","refs":["CL_GB18_53:DBN-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:DBN-02","text":"Inadmissible is a model in which relata precede their relation, because this would cause cause, effect, activity, and passivity to solidify into immobile bearers.","refs":["CL_GB18_56:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:DBN-03","text":"Inadmissible are both autonomous multiplicity and difference-less unity; difference must be really efficacious without gaining a subsistence independent of totality.","refs":["CL_GB18_53:DBN-02","CL_GB18_54:DBN-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:DBN-04","text":"Inadmissible is a cognition that represents finished objects without retracing the genesis of their determinations as the same movement of thinking and being.","refs":["CL_GB18_53:XD-01","CL_GB18_56:DBN-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:DBN-05","text":"The terminal conceptual form cannot permit any remaining outside, because an independent ground would revoke the reduction of causal difference to self-differentiation.","refs":["CL_GB18_56:BSA-02","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"MC_GB18_L1_14:BSA-01","text":"The deepest excluded possibility is an external position in relation to the Absolute from which its differences could be cognized, caused, or limited.","refs":["CL_GB18_53:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSA-02","text":"An absolute beginning prior to all mediation is unavailable, because the self that is to posit emerges only through the sublation of its presuppositions.","refs":["CL_GB18_54:BSA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSA-03","text":"Unavailable is a final origin that produces its effect without receiving actuality, limit, and self-relation through it.","refs":["CL_GB18_55:BSA-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSA-04","text":"Inadmissible is a freedom that preserves non-identity and unconditionedness; the system knows freedom only as the conscious self-presence of mediated necessity.","refs":["CL_GB18_56:BSA-03","CL_GB18_56:GA-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"MC_GB18_L1_14:XD-01","text":"The self-sublation of real conditions generates not only necessity but the transition to a substance whose undeveloped identity must necessarily differentiate itself as causality.","refs":["MC_GB18_L1_14:GA-04","MC_GB18_L1_14:GA-06","MC_GB18_L1_14:GA-07","MC_GB18_L1_14:GA-08","CL_GB18_54:AS-B05","CL_GB18_54:GA-09"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_14:XD-02","text":"The absence of real difference between substance and accidentality compels the distinction of cause and effect without being able to confer ontological independence upon these roles.","refs":["MC_GB18_L1_14:GA-07","MC_GB18_L1_14:GA-08","MC_GB18_L1_14:GA-09","CL_GB18_54:FL-03","CL_GB18_55:GA-05"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_14:XD-03","text":"The infinite regress of finite causes becomes the machine of transition: because every cause is an effect, the causal nexus must posit its own field of conditions and return into reciprocal action.","refs":["MC_GB18_L1_14:GA-03","MC_GB18_L1_14:GA-10","MC_GB18_L1_14:GA-11","CL_GB18_55:RLE-03","CL_GB18_56:RLE-01"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_14:XD-04","text":"The recoding of contingency into the form of appearance of necessity provides the modal presupposition for determining conditionedness not as loss of freedom, but as freedom in manifest shape.","refs":["MC_GB18_L1_14:GA-05","MC_GB18_L1_14:GA-06","MC_GB18_L1_14:GA-12","CL_GB18_56:BAS-06","CL_GB18_56:GA-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_14:XD-05","text":"The repeated internalization of externality excludes both an independent mode and a definitively external ground, and makes counteraction the final causal form of the withdrawal of the outside.","refs":["MC_GB18_L1_14:GA-02","MC_GB18_L1_14:GA-09","MC_GB18_L1_14:GA-11","CL_GB18_53:GNX-02","CL_GB18_56:BSA-02"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"MC_GB18_L1_14:XD-06","text":"Explanation becomes operationally identical with the matter itself once it does not list external causes, but reconstructs the reversals through which the matter generates its conditions, roles, and presuppositions.","refs":["MC_GB18_L1_14:GA-03","MC_GB18_L1_14:GA-08","MC_GB18_L1_14:GA-13","CL_GB18_54:BSD-05","CL_GB18_56:BSD-05"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"MC_GB18_L1_14:BSD-01","text":"Reality becomes a groundless machine of grounding whose ground does not precede it, but emerges as the sublated presupposition of its own execution.","refs":["CL_GB18_53:BSD-01","CL_GB18_56:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSD-02","text":"Time is recursive result-time: possibility retrospectively becomes presupposition, effect actualizes cause, and the result determines the meaning of the beginning.","refs":["CL_GB18_53:BSD-03","CL_GB18_56:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSD-03","text":"The subject loses the status of a presupposed center and emerges as the form in which substantial self-mediation recognizes its differences as its own determinations.","refs":["CL_GB18_53:BSD-02","CL_GB18_56:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSD-04","text":"Agency does not consist in unmediated beginning, but in the capacity of organized unities selectively to appropriate, transform, and manifest conditions as their own efficacy.","refs":["CL_GB18_55:BSD-04","CL_GB18_56:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:BSD-05","text":"Cognition is transformed from representation into genetic reconstruction; an explanation is true only if it shows the presupposed as the result of the matter itself.","refs":["CL_GB18_53:MME-03","CL_GB18_54:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"MC_GB18_L1_14:RLE-01","text":"The basic loop is: identity posits determinacy, determinacy generates negation, negation exposes externality, and its withdrawal generates more concrete identity.","refs":["CL_GB18_53:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RLE-02","text":"The modality loop leads from real possibility through the contradiction of its field of conditions to actuality, which retrospectively posits its possibility as its own presupposition.","refs":["CL_GB18_54:RLE-01","CL_GB18_54:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RLE-03","text":"The escalation from necessity to substance and causality arises because absolute identity must articulate its negativity as real difference.","refs":["CL_GB18_54:RLE-04","CL_GB18_54:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RLE-04","text":"The finite causal loop runs from cause to effect and back to cause as effect; its bad progression collapses only in self-presupposition.","refs":["CL_GB18_55:RLE-03","CL_GB18_55:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RLE-05","text":"The activity-passivity loop leads from posited condition through influence and counteraction to the passivation of the first cause and thereby to reciprocal action.","refs":["CL_GB18_56:RLE-01","CL_GB18_56:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:RLE-06","text":"The terminal attractor is the Concept, because the escalation of causality, reciprocal action, and freedom converges there as the inner articulation of a subjective totality.","refs":["CL_GB18_56:RLE-05","CL_GB18_56:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"MC_GB18_L1_14:FGS-B01","text":"Immediate identity → hidden determinacy → negation → self-differentiation as the condition of concrete identity.","refs":["CL_GB18_53:ABS-B02","CL_GB18_53:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FGS-B02","text":"Self-differentiation → externality → possibility as a field of conditions → immanent contradiction of the presupposed.","refs":["CL_GB18_54:GA-02","CL_GB18_54:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FGS-B03","text":"Self-sublation of conditions → retrospective positing of presupposition → absolute necessity → identity of being and essence.","refs":["CL_GB18_54:GA-04","CL_GB18_54:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FGS-B04","text":"Absolute necessity → substance as manifestation → accidentality → substantial power of production and sublation.","refs":["CL_GB18_54:GA-07","CL_GB18_54:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FGS-B05","text":"Substantial power → cause and effect → finite fixation of roles → regress → self-posited presupposition of causality.","refs":["CL_GB18_55:GA-05","CL_GB18_55:GA-07","CL_GB18_55:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FGS-B06","text":"Self-posited condition → counteraction → reciprocal action → manifested necessity → freedom → Concept as subjective self-articulation.","refs":["CL_GB18_56:GA-04","CL_GB18_56:GA-07","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"MC_GB18_L1_14:AFM-B01","text":"Immediate identity → determinate negation → posited externality → actuality as self-relating manifestation.","refs":["CL_GB18_53:RMD-01","CL_GB18_53:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AFM-B02","text":"Real possibility → contradictory field of conditions → retrospective self-grounding → absolute necessity → substance.","refs":["CL_GB18_54:RMD-02","CL_GB18_54:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AFM-B03","text":"Substantial power → cause/effect asymmetry → finite reversal → causal regress → self-presupposition.","refs":["CL_GB18_55:GA-01","CL_GB18_55:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:AFM-B04","text":"Self-presupposition → counteraction → reciprocal action → manifest necessity → freedom → Concept.","refs":["CL_GB18_56:BAS-05","CL_GB18_56:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"MC_GB18_L1_14:MME-01","text":"Unity and multiplicity are no longer mapped as alternatives; multiplicity is the necessary form of manifestation and differentiation of a unity that is concrete only within it.","refs":["CL_GB18_53:MME-01","CL_GB18_54:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MME-02","text":"Possibility, contingency, and necessity are reordered from separate modal domains into phases of the generation, determination, and manifestation of the same actuality.","refs":["CL_GB18_53:MME-04","CL_GB18_54:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MME-03","text":"The opposition of substance and accident disintegrates; both become legible as different forms of execution of a single manifesting power.","refs":["CL_GB18_54:MME-03","CL_GB18_54:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MME-04","text":"Cause and effect are reclassified from things or event-positions into reversible status-forms of a nexus of efficacy.","refs":["CL_GB18_55:MME-01","CL_GB18_56:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MME-05","text":"Linear time and bad infinity are replaced by recursive return, in which effects determine causes and transitions generate their own presuppositions.","refs":["CL_GB18_55:BSD-02","CL_GB18_56:MME-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MME-06","text":"Freedom is remapped from the negation of conditionedness to the explicit self-presence of a mediated nexus.","refs":["CL_GB18_56:BSD-04","CL_GB18_56:MME-05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"MC_GB18_L1_14:ALT-B01","text":"Surface level — The explicit objects are the Absolute, actuality, possibility, contingency, necessity, substance, accidentality, cause, effect, reciprocal action, freedom, and the Concept.","refs":["CL_GB18_53:ALT-B01","CL_GB18_56:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:ALT-B02","text":"Structural level — All objects are organized through positing, negation, condition, reversal, return, and self-presupposition as phases of a single logic of mediation.","refs":["CL_GB18_53:ALT-B02","CL_GB18_56:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:ALT-B03","text":"Metastrategic level — Explanation is reformulated as a test of whether allegedly external causes, grounds, and conditions can be reconstructed as moments of immanent self-activity.","refs":["CL_GB18_54:ALT-B03","CL_GB18_55:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:ALT-B04","text":"Ontological / Temporal level — Being is self-effective power, and time is the recursive order in which positings return through their results as presuppositions.","refs":["CL_GB18_55:ALT-B04","CL_GB18_56:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:ALT-B05","text":"Methodological / Performative level — The exposition performs its thesis by transferring every fixed determination into its limit, counter-determination, and mediated return.","refs":["CL_GB18_53:ALT-B05","CL_GB18_56:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"MC_GB18_L1_14:FL-01","text":"Negation must initially appear as external reflection, although its productive efficacy is intelligible only if it is already immanent self-negation.","refs":["CL_GB18_53:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FL-02","text":"The completeness of the field of conditions is required, without the genesis of its concrete content being fully demonstrated.","refs":["CL_GB18_54:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FL-03","text":"Substance is supposed to possess no real difference from its accidents, but it must generate real difference in order for causality to arise.","refs":["CL_GB18_54:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FL-04","text":"The cause claims originality, yet receives actuality exclusively through the effect, which at once mediates and limits its priority.","refs":["CL_GB18_55:FL-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FL-05","text":"Violence remains suspended between external influence and the actualization of a determination lying in that which suffers; its internalization does not fully eliminate this double valence.","refs":["CL_GB18_56:FL-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:FL-06","text":"The transition from reciprocal action to the Concept rests on equating transition into an other with reflection into itself, without independently deducing this equation.","refs":["CL_GB18_56:FL-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MP-01","text":"Contingency mutates from groundlessness and limitation into the positive form of movement and manifestation of necessity.","refs":["CL_GB18_53:MP-02","CL_GB18_54:MP-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MP-02","text":"The condition mutates from a presupposed alien circumstance into self-posited passivity, through which efficacy relates to itself.","refs":["CL_GB18_54:MP-01","CL_GB18_56:MP-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MP-03","text":"Accidentality mutates from mere semblance into negativity existing for itself and thereby opens the transition from substantiality to causality.","refs":["CL_GB18_54:MP-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MP-04","text":"Freedom mutates from the counter-concept of necessity into its manifest form and thereby prepares the transformation of substance into the Concept.","refs":["CL_GB18_56:MP-03","CL_GB18_56:GA-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"MC_GB18_L1_14:HSI-01","text":"Reality appears as a self-differentiating machine of mediation that processes no external data, but generates its conditions, outer sides, and relations as its own moments.","refs":["CL_GB18_53:HSI-01","CL_GB18_56:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:HSI-02","text":"The subject is not an original entity, but the form in which substance organizes and manifests its differences as its own determinations.","refs":["CL_GB18_56:BSD-02","CL_GB18_56:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:HSI-03","text":"Time is return-time: the result posits its beginning, the effect actualizes its cause, and actuality falls back into possibility without being merely repeated.","refs":["CL_GB18_54:HSI-03","CL_GB18_56:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:HSI-04","text":"Action and navigation remain possible as immanent transformation, which distinguishes among occasion, condition, effect, and self-determination instead of seeking an isolated origin.","refs":["CL_GB18_55:HSI-04","CL_GB18_56:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"MC_GB18_L1_14:MRT-B01","text":"The axioms suffice to reconstruct the movement from immediate identity through modality, necessity, substance, and causality to reciprocal action, freedom, and the Concept.","refs":["CL_GB18_53:MRT-B01","CL_GB18_56:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MRT-B02","text":"The strongest axis of the architecture is the continued transformation of external otherness into productive self-differentiation, without reducing difference to mere semblance.","refs":["CL_GB18_54:MRT-B03","CL_GB18_56:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MRT-B03","text":"The genesis of concrete determinacy of content and the necessity of that substantial identity upon which the return of causality into the Concept rests remain underdetermined.","refs":["CL_GB18_54:MRT-B02","CL_GB18_56:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MRT-B04","text":"The system is coherent insofar as necessity is read not as a first ground and the Concept not as an externally appended result, but both as terminal forms of recursive self-mediation.","refs":["CL_GB18_53:MRT-B04","CL_GB18_56:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"MC_GB18_L1_14:MRT-B05","text":"One indispensable element resists complete axiomatic reduction: the terminal conceptual structure remains dependent on the concrete sequence of causality, counteraction, reciprocal action, and freedom.","refs":["CL_GB18_55:MRT-B02","CL_GB18_56:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"MC_GB18_L1_14@R001","source_variant_id":"canonical:MC_GB18_L1_14:v1","source_language_code":"de"}],"identity":{"layer":"MC","kicker":"Meta-cluster · Science of Logic","title":"Gb18 L1 14","context":"Chapters 157–167 · C. Der Modus des Absoluten. · Anmerkung. · A. Zufälligkeit oder formelle Wirklichkeit, Möglichkeit und Nothwendigkeit. · B. Relative Nothwendigkeit oder reale Wirklichkeit, Möglichkeit und Nothwendigkeit. · C. Absolute Nothwendigkeit. · A. Das Verhältniß der Substantialität. · B. Das Kausalitäts-Verhältniß. · a. Die formelle Kausalität. · b. Das bestimmte Kausalitätsverhältniß. · c. Wirkung und Gegenwirkung. · C. Die Wechselwirkung."},"title_language_code":"en"},{"id":"WB_GB18","layer":"WB","title":"Science of Logic","order":1,"parents":["MC_GB18_L3_01","MC_GB18_L3_02"],"revision":"WB_GB18@R002","sha256":"847d09b0041b62366eaf3aa579be2c1366f6a723a38d8d9955eb7401ffb76345","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"WB_GB18:BAS-01","text":"Das System muss bestimmte Einheit ohne vorausgesetzte Qualität, Quantität, Substrat, äußeren Grund oder souveränen Erkenntnisstandpunkt aus ihrer eigenen Vermittlungsbewegung erzeugen.","refs":["MC_GB18_L3_01:AS-01","MC_GB18_L3_02:BAS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-02","text":"Seine globale These bestimmt Negativität als erhaltende Selbstdifferenzierung, durch die Identität ihre Unterschiede hervorbringt, externalisiert und als eigene Organisationsmomente zurücknimmt.","refs":["MC_GB18_L3_01:AS-02","MC_GB18_L3_02:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-03","text":"Das Argument ist eine genetisch-rekursive Ontologie, deren Kategorien aus der Unhaltbarkeit isolierter Bestimmungen hervorgehen und ihre Voraussetzungen durch ihre Resultate rückwirkend bestimmen.","refs":["MC_GB18_L3_01:AS-03","MC_GB18_L3_02:BAS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-04","text":"Die gerichtete Bewegung führt vom bestimmungslosen Seyn über Qualität, Quantität und Maß zur reflektierten Vermittlung des Wesens und von dort zur subjektiven Organisationsforderung des Begriffs.","refs":["MC_GB18_L3_01:AS-08","MC_GB18_L3_02:BAS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-05","text":"Äußerlichkeit mutiert vom ausgeschlossenen Fremdgrund zur erzeugten Vielheit, zum Medium von Maß und Erscheinung und schließlich zur organisierten Passivitätsform einer sich selbst manifestierenden Totalität.","refs":["MC_GB18_L3_01:AS-06","MC_GB18_L3_02:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-06","text":"Die Bewegung ist rekursiv, spiralförmig und resultatszeitlich: Jede Grenze erzeugt ein neues Vermittlungsregime, das den Status seines Ausgangspunkts rückwirkend verändert.","refs":["MC_GB18_L3_01:AS-07","MC_GB18_L3_02:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-07","text":"Die negative Schließung des Seyns entzieht einzelnen Maßen ihre Selbständigkeit, während die positive Schließung des Wesens Bedingungen, Ursachen und Differenzen als innere Glieder einer Selbstorganisation rekonstruiert.","refs":["MC_GB18_L3_01:XD-09","MC_GB18_L3_02:BAS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-08","text":"Die Schließung ist terminal-transformativ, nicht stillstellend: Maß geht in Wesen und Substanz in Begriff über, doch die positive Erzeugung konkreter Maßgesetze und Begriffsglieder bleibt offen.","refs":["MC_GB18_L3_01:GA-13","MC_GB18_L3_02:GA-13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"WB_GB18:GA-01","text":"[Persistent] Keine Bestimmung besitzt relationsexterne Selbständigkeit; Identität besteht nur als vermittelte Selbsterhaltung innerhalb der Differenzen, die sie erzeugen und begrenzen.","refs":["MC_GB18_L3_01:GA-01","MC_GB18_L3_02:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-02","text":"[Attractor] Immanente Negativität ist der universale Transformationsoperator, sofern sie das Negierte erhält, gegen seine isolierte Form wendet und in konkretere Einheit zurücknimmt.","refs":["MC_GB18_L3_01:GA-02","MC_GB18_L3_02:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-03","text":"[Mutating] Unmittelbarkeit mutiert vom bestimmungslosen Anfang zur sedimentierten Vermittlung und weiter zur gesetzten Erscheinungsform eines Zusammenhangs, dessen Genesis in seinem Resultat zurücktritt.","refs":["MC_GB18_L3_01:GA-04","MC_GB18_L3_02:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-04","text":"[Mutating] Äußerlichkeit ist als ursprünglicher Erklärungsgrund ausgeschlossen, als erzeugte Form von Vielheit, Erscheinung, Bedingung und Passivität jedoch konstitutiv.","refs":["MC_GB18_L3_01:GA-06","MC_GB18_L3_02:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-05","text":"[Persistent] Widerspruch ist kein Defekt, sondern die operative Instabilität, durch die isolierte Bestimmungen ihre Selbständigkeit verlieren und ihre Gegenmomente erzeugen.","refs":["MC_GB18_L3_01:GA-08","MC_GB18_L3_02:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-06","text":"[Emergent] Maß ist das Scharnier zwischen Seyn und Wesen, weil seine Zustände ihre Selbständigkeit verlieren und ihre qualitative Genesis als reflektierte Erscheinung eines Zusammenhangs freigeben.","refs":["MC_GB18_L3_01:GA-11","MC_GB18_L3_02:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-07","text":"[Mutating] Grund, Bedingung und Ursache verlieren ihre vorgängige Stellung und werden zu rückwirkend gesetzten Funktionen einer Bewegung, die ihre eigenen Voraussetzungen erzeugt.","refs":["MC_GB18_L3_01:XD-07","MC_GB18_L3_02:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-08","text":"[Emergent] Wirklichkeit besteht aus relational stabilisierten Phasen, in denen Wesen, Existenz, Erscheinung und Bedingungen als Momente derselben manifestierenden Bewegung wirksam werden.","refs":["MC_GB18_L3_01:BSD-01","MC_GB18_L3_02:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-09","text":"[Attractor] Konkrete Selbstbeziehung und Totalität sind derselbe positive Attraktor: Einheit erhält ihre Differenzen, entzieht ihnen jedoch jede isolierte Selbständigkeit.","refs":["MC_GB18_L3_01:GA-05","MC_GB18_L3_02:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-10","text":"[Terminal] Die objektive Kategorienbewegung schließt sich, indem Maß in reflektierten Grund und substantielle Selbstorganisation in die subjektive Gliederungsforderung des Begriffs übergeht.","refs":["MC_GB18_L3_01:GA-13","MC_GB18_L3_02:GA-13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-11","text":"[Persistent] Erkenntnis- und Seinsform konvergieren, weil Erklärung nur als immanente Rekonstruktion der Operationen gilt, durch die der Gegenstand seine Bestimmungen hervorbringt.","refs":["MC_GB18_L3_01:GA-03","MC_GB18_L3_02:GA-14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-12","text":"[Attractor] Das fehlende Gesetz konkreter Maßordnungen und Begriffsglieder ist der negative Attraktor, der vollständige positive Schließung verhindert und die Mutationssequenz unersetzlich macht.","refs":["MC_GB18_L3_01:GA-15","MC_GB18_L3_02:FL-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"WB_GB18:RMD-01","text":"Unmittelbarkeit bewahrt die Funktion positiver Präsenz, wechselt aber von Inhaltsleere über resultative Ruhe zur Erscheinung einer Vermittlung, die in ihrem Produkt unsichtbar wird.","refs":["MC_GB18_L3_01:RMD-02","MC_GB18_L3_02:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-02","text":"Negativität eskaliert vom abstrakten Nichts über Grenze, Repulsion und Maßlosigkeit zur Produktivkraft von Reflexion, Manifestation, Kausalität und Selbstgliederung.","refs":["MC_GB18_L3_01:RMD-01","MC_GB18_L3_02:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-03","text":"Das Andere wandert aus äußerer Gegenständlichkeit in interne Negation, kehrt als quantitative Äußerlichkeit wieder und erhält in Erscheinung und Bedingung eine konstitutive positive Funktion.","refs":["MC_GB18_L3_01:RMD-04","MC_GB18_L3_02:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-04","text":"Die Grenzfunktion verschiebt sich von qualitativer Konstitution und Maßschwelle zur Bedingungsstruktur: Was zunächst Umschlag erzeugt, wird später als rückwirkend gesetzte Voraussetzung organisiert.","refs":["MC_GB18_L3_01:RMD-03","MC_GB18_L3_02:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-05","text":"Das am Ende der Maßbewegung entstehende Substrat verliert im Wesen erneut den Status eines passiven Trägers und mutiert zur manifestierenden Selbstorganisation der Substanz.","refs":["MC_GB18_L3_01:FGS-B09","MC_GB18_L3_02:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-06","text":"Widerspruch bleibt funktional identisch, obwohl seine explizite Benennung zurücktritt: Als spätere Form destabilisiert er Gesetze, Kräfte und fixierte Kausalrollen.","refs":["MC_GB18_L3_01:RMD-08","MC_GB18_L3_02:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-07","text":"Unendlichkeit verliert ihre Jenseitsform, wird zur gegenwärtigen Selbstvermittlung und wird anschließend in den umfassenderen Attraktor einer differenzierten Totalität absorbiert.","refs":["MC_GB18_L3_01:RMD-06","MC_GB18_L3_02:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-08","text":"Das Subjekt kehrt seine Stellung um: Es ist zunächst als vorausgesetzter Ursprung ausgeschlossen und entsteht terminal als Rückkehrform verteilter objektiver Vermittlung.","refs":["MC_GB18_L3_01:BSD-02","MC_GB18_L3_02:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"WB_GB18:CGD-01","text":"Einzelne Kategorien von Seyn, Zahl, Ding, Gesetz oder Kraft bleiben lokale Durchgangsformen; auf der Gesamtbuchebene zählen sie als Phasen einer Maschine relationeller Entselbständigung.","refs":["MC_GB18_L3_01:CGD-01","MC_GB18_L3_02:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:CGD-02","text":"Naturwissenschaftliche, musikalische und politische Beispiele sowie lokale Trägerkritiken skalieren nur insofern, als sie die Selbstproduktion qualitativer Relationen und ihrer Schwellen prüfen.","refs":["MC_GB18_L3_01:CGD-02","MC_GB18_L3_02:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:CGD-03","text":"Historische Logikkritik, Vergleich und ruhige Gesetzlichkeit bleiben Expositions- oder Demontageformen; global trägt ihre Ablösung durch immanent bewegte Relationsformen.","refs":["MC_GB18_L3_01:CGD-03","MC_GB18_L3_02:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:CGD-04","text":"Konkrete Exponenten, Schwellen und Inhalte bleiben lokal unterbestimmt; auf Gesamtbuchebene bilden ihre Nichtableitbarkeit und die unvollständige Begriffsgliederung eine gemeinsame positive Zureichendheitslücke.","refs":["MC_GB18_L3_01:CGD-05","MC_GB18_L3_02:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:CGD-05","text":"Nicht die Inventarisierung der Kategorien, sondern die konkrete Sequenz ihrer Mutation, Rückkehr und Umkehrung skaliert zur tragenden Architektur des Gesamtbuchs.","refs":["MC_GB18_L3_01:MRT-B05","MC_GB18_L3_02:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"WB_GB18:GNX-01","text":"Ausgeschlossen sind eine äußerlich bereitgestellte Methode und ein souveräner Beobachter, die Kategorien verbinden könnten, ohne selbst der Vermittlungsbewegung zu unterliegen.","refs":["MC_GB18_L3_01:GNX-01","MC_GB18_L3_02:GNX-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:GNX-02","text":"Ausgeschlossen sind ein positiv bestimmter Anfang und ein eigenschaftsloses Substrat, die Bestimmtheit vor Differenz, Relation oder Manifestation tragen könnten.","refs":["MC_GB18_L3_01:GNX-02","MC_GB18_L3_02:GNX-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:GNX-03","text":"Ausgeschlossen sind fertige Substanzen, Relata, Gründe und Ursachen, denen Beziehungen oder Wirkungen erst nachträglich hinzugefügt würden.","refs":["MC_GB18_L3_01:GNX-03","MC_GB18_L3_02:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:GNX-04","text":"Ausgeschlossen sind reine Positivität, differenzlose Selbstgleichheit und vernichtende Negation, weil keine dieser Formen konkrete Identität erzeugen kann.","refs":["MC_GB18_L3_01:GNX-04","MC_GB18_L3_02:GNX-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:GNX-05","text":"Ausgeschlossen sind selbstinterpretierender Formalismus, universale Quantifizierung und Freiheit als bedingungslose Unterbrechung der erzeugenden Bedingungen.","refs":["MC_GB18_L3_01:GNX-06","MC_GB18_L3_02:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:GNX-06","text":"Ausgeschlossen ist eine terminale Geschlossenheit, die ihre konkrete Differenzierung nicht erzeugt und den Übergang in ein neues Operationsregime stillstellt.","refs":["MC_GB18_L3_01:GNX-07","MC_GB18_L3_02:GNX-06"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"WB_GB18:DBN-01","text":"Ein irreduzibles Außen darf kein Erklärungsgrund sein, muss aber als erzeugte Vollzugsdifferenz fortbestehen; seine vollständige Autonomie und seine restlose Auflösung sind gleichermaßen unzulässig.","refs":["MC_GB18_L3_01:DBN-04","MC_GB18_L3_02:DBN-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:DBN-02","text":"Lineare Sukzession und sequenzunabhängige Totalität müssen falsch sein, weil Übergänge nur durch rekursive Rücknahme und Mutation ihrer Voraussetzungen Notwendigkeit gewinnen.","refs":["MC_GB18_L3_01:DBN-03","MC_GB18_L3_02:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:DBN-03","text":"Operative Berechenbarkeit und repräsentationale Erkenntnis dürfen nicht mit begrifflicher Wahrheit zusammenfallen; Erklärung muss die Genesis ihres Gegenstands vollziehen.","refs":["MC_GB18_L3_01:DBN-05","MC_GB18_L3_02:DBN-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:DBN-04","text":"Eine vollständige Ableitung konkreter Naturgesetze oder Begriffsinhalte darf nicht fingiert werden, weil die Architektur zuverlässiger Formen als deren bestimmte Ausfüllung erzeugt.","refs":["MC_GB18_L3_01:DBN-06","MC_GB18_L3_02:FL-07"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"WB_GB18:BSA-01","text":"Die tiefste Abwesenheit ist ein ruhender erster Ursprung, dessen Priorität keiner rückwirkenden Erzeugung durch Grenze, Wirkung und Resultat bedürfte.","refs":["MC_GB18_L3_01:BSA-01","MC_GB18_L3_02:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:BSA-02","text":"Ontologisch unzulässig ist ein unassimilierbares Außen, das Material, Maßstäbe oder Ursachen liefern könnte, ohne als erzeugtes Moment der Totalität zurückzukehren.","refs":["MC_GB18_L3_01:BSA-02","MC_GB18_L3_02:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:BSA-03","text":"Das System umkreist eine vollständig immanente Form konkreter Differenzerzeugung, deren positive Maßgesetze und innere Begriffsgliederung gerade nicht vollständig verfügbar sind.","refs":["MC_GB18_L3_01:BSA-04","MC_GB18_L3_02:BSA-04"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"WB_GB18:XD-01","text":"Der Verfall einzelner Maße erzeugt das Substrat, dessen scheinbare Trägerfunktion die Reflexionsbewegung anschließend negiert und als gesetzte Vermittlung rekonstruiert.","refs":["WB_GB18:GA-06","WB_GB18:GA-07","MC_GB18_L3_01:FGS-B09","MC_GB18_L3_02:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-02","text":"Die Seinslogik erzeugt resultative Unmittelbarkeit; die Wesenslogik legt rückwirkend frei, dass diese Präsenz die verschwundene Wirksamkeit ihrer Vermittlung enthält.","refs":["WB_GB18:GA-03","WB_GB18:GA-07","MC_GB18_L3_01:GA-04","MC_GB18_L3_02:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-03","text":"Quantitative Äußerlichkeit und wesentliche Erscheinung sind aufeinanderfolgende Funktionen derselben erzeugten Differenz: zunächst Medium gleichgültiger Variation, danach reale Exposition immanenter Genesis.","refs":["WB_GB18:GA-04","WB_GB18:GA-08","MC_GB18_L3_01:AS-06","MC_GB18_L3_02:RMD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-04","text":"Ein qualitativer Umschlag ist nicht äußerlich verursacht, sondern reorganisiert die Bedingungen und Rollen eines Zusammenhangs so, dass Wirkung zur Verwirklichung ihrer Ursache beiträgt.","refs":["WB_GB18:GA-05","WB_GB18:GA-07","WB_GB18:GA-08","MC_GB18_L3_01:GA-12","MC_GB18_L3_02:BSD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-05","text":"Wahre Unendlichkeit liefert die relationale Form der Totalität: Eine Einheit ist geschlossen, sofern sie ihre Gegenmomente integriert, nicht sofern sie Differenz beendet.","refs":["WB_GB18:GA-02","WB_GB18:GA-09","MC_GB18_L3_01:XD-04","MC_GB18_L3_02:RLE-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-06","text":"Das fehlende Gesetz konkreter Schwellen und die unvollständige Gliederung des Begriffs bilden dieselbe Schließungslücke auf entgegengesetzten Enden der objektiven Kategorienbewegung.","refs":["WB_GB18:GA-10","WB_GB18:GA-12","MC_GB18_L3_01:GA-15","MC_GB18_L3_02:XD-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-07","text":"Immanente Ableitung und ontologische Manifestation vereinigen Erkennen und Sein in einer genetischen Operation, bleiben aber auf qualitative Typisierung und Reichweitenbegrenzung angewiesen.","refs":["WB_GB18:GA-08","WB_GB18:GA-11","MC_GB18_L3_01:XD-08","MC_GB18_L3_02:XD-08"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"WB_GB18:BSD-01","text":"Realität besteht aus rekursiven Produktionsfeldern, in denen Dinge, Zustände, Substrate und Substanzen als vorläufige Verdichtungen selbstvermittelnder Relationen entstehen.","refs":["MC_GB18_L3_01:BSD-01","MC_GB18_L3_02:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BSD-02","text":"Zeit ist eine Resultatsspirale aus Grenzwiederholung, quantitativer Fortsetzung, qualitativer Unterbrechung und rückwirkender Neukonstitution des Anfangs.","refs":["MC_GB18_L3_01:BSD-03","MC_GB18_L3_02:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BSD-03","text":"Kausalität bezeichnet keine lineare Übertragung zwischen fertigen Dingen, sondern die schwellenförmige Selbstkonditionierung eines Zusammenhangs, der Ursachen durch Wirkungen verwirklicht.","refs":["MC_GB18_L3_01:BSD-04","MC_GB18_L3_02:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BSD-04","text":"Das Subjekt ist weder Ursprung noch bloßer Effekt, sondern die späte Organisationsform einer objektiv verteilten Reflexion, die ihre Unterschiede als eigene Glieder zurücknimmt.","refs":["MC_GB18_L3_01:BSD-02","MC_GB18_L3_02:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BSD-05","text":"Handlungsmacht und Freiheit bestehen in der reflexiven Umbildung erzeugender Bedingungen, Relationen und Rollen, nicht in abstrakter Überschreitung oder voraussetzungsloser Initiative.","refs":["MC_GB18_L3_01:BSD-06","MC_GB18_L3_02:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BSD-06","text":"Erkenntnis wird genetisch und performativ: Sie muss kategoriale Genese, qualitative Geltung, Manifestationsform und gegenständliche Reichweite innerhalb derselben Rekonstruktion bestimmen.","refs":["MC_GB18_L3_01:BSD-05","MC_GB18_L3_02:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"WB_GB18:RLE-01","text":"Die Sedimentationsschleife lautet: Vermittlung erzeugt Unmittelbarkeit, Unmittelbarkeit verdeckt ihre Genesis, und die verdeckte Vermittlung kehrt als neuer Widerspruch zurück.","refs":["MC_GB18_L3_01:RLE-02","MC_GB18_L3_02:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-02","text":"Die Äußerlichkeitsschleife führt von Ausschluss über erzeugte Externalisierung zur Internalisierung; jede Internalisierung setzt jedoch eine neue Außenseite und erzwingt weitere Vermittlung.","refs":["MC_GB18_L3_01:RLE-03","MC_GB18_L3_02:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-03","text":"Die Grenzeskalation führt von Bestimmtheit über Schranke und Maßschwelle zur Bedingung, die erst durch die von ihr ermöglichte Bewegung als Voraussetzung gesetzt wird.","refs":["MC_GB18_L3_01:RLE-04","MC_GB18_L3_02:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-04","text":"Die Rechtfertigungsschleife führt vom voraussetzungslosen Anfang zum Resultat und von dort zur rückwirkenden Bestimmung dessen, was logisch als Grund und Ursache gelten kann.","refs":["MC_GB18_L3_01:RLE-01","MC_GB18_L3_02:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-05","text":"Die Schwelleneskalation führt von gleichgültiger Variation über Akkumulation und qualitativen Sprung zu Erscheinung, Gesetz, Kraft und rekursiver Kausalität.","refs":["MC_GB18_L3_01:RLE-06","MC_GB18_L3_02:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-06","text":"Die terminale Eskalation führt von entselbständigten Maßen über Substrat und substantielle Macht zur Wechselwirkung und schließlich zur subjektiven Organisation eigener Differenzen.","refs":["MC_GB18_L3_01:RLE-07","MC_GB18_L3_02:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-07","text":"Die Gesamtmaschine wird von zwei asymmetrischen Attraktoren organisiert: positiv von immanenter Totalität, negativ vom fehlenden Gesetz ihrer konkreten Differenzierung.","refs":["MC_GB18_L3_01:RLE-08","MC_GB18_L3_02:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"WB_GB18:FGS-B01","text":"Ausschluss äußerer Methode und vorausgesetzter Träger → entleerter Anfang → Selbstwiderspruch passiver Unmittelbarkeit → immanente Kategorienbewegung.","refs":["MC_GB18_L3_01:GNX-01","MC_GB18_L3_02:FGS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B02","text":"Bestimmungslose Präsenz → Negation → Werden → resultative Qualität → Etwas und Anderes → konstitutive Grenze.","refs":["MC_GB18_L3_01:AS-01","MC_GB18_L3_01:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B03","text":"Grenze → Endlichkeit → schlechte Unendlichkeit → affirmative Selbstbeziehung → Eins und Repulsion → gleichartige Vielheit → Quantität.","refs":["MC_GB18_L3_01:GA-09","MC_GB18_L3_01:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B04","text":"Quantum → Relation und Invariante → Maß → Gleichgültigkeitsbereich → Schwelle → qualitativer Umschlag.","refs":["MC_GB18_L3_01:GA-11","MC_GB18_L3_01:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B05","text":"Maßreihe → Entselbständigung einzelner Zustände → Substratkontinuität → reflektierter Grund → Wesen.","refs":["MC_GB18_L3_01:GA-13","MC_GB18_L3_01:FGS-B09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B06","text":"Reflexion → Grund und Bedingung → vermittelte Existenz → Substratverlust → Erscheinung als manifeste Genesis.","refs":["MC_GB18_L3_02:GA-06","MC_GB18_L3_02:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B07","text":"Erscheinung → Wirklichkeit → Substanz → kausale Differenzierung und Wechselwirkung → manifestierte Notwendigkeit → reflektierte Freiheit.","refs":["MC_GB18_L3_02:GA-09","MC_GB18_L3_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B08","text":"Substantielle Selbstorganisation → Subjekt → Begriff als Forderung innerer Gliederung; fehlende konkrete Erzeugungsgesetze → terminal offene Schließung.","refs":["MC_GB18_L3_02:GA-12","MC_GB18_L3_02:GA-15","MC_GB18_L3_01:GA-15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"WB_GB18:AFM-B01","text":"Entleerter Anfang → Qualität → Quantität → Maß → Wesen → Grund → Erscheinung → Wirklichkeit → Substanz → Kausalität → Freiheit → Begriff.","refs":["MC_GB18_L3_01:MRT-B01","MC_GB18_L3_02:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:AFM-B02","text":"Ausgeschlossenes Außen → erzeugte Vielheit → quantitative Äußerlichkeit → Erscheinung und Bedingung → organisierte Passivität → innere Gliederung.","refs":["MC_GB18_L3_01:AS-06","MC_GB18_L3_02:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:AFM-B03","text":"Abstrakte Negation → qualitative Grenze → Repulsion → Maßlosigkeit → Reflexion → Manifestation → kausale Reversibilität → subjektive Selbstbestimmung.","refs":["MC_GB18_L3_01:RMD-01","MC_GB18_L3_02:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:AFM-B04","text":"Grenzwiederholung → quantitative Fortsetzung → qualitativer Umschlag → rückwirkende Voraussetzung → Resultatszeit.","refs":["MC_GB18_L3_01:BSD-03","MC_GB18_L3_02:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:AFM-B05","text":"Entselbständigung des Maßes → negative Schließung des Grundregresses → manifestierte Notwendigkeit → offener Begriff als terminaler Attraktor.","refs":["MC_GB18_L3_01:XD-09","MC_GB18_L3_02:AFM-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"WB_GB18:MME-01","text":"Unmittelbarkeit und Vermittlung werden nicht länger als Gegensätze kartiert; Präsenz erscheint als verdichtete Vermittlung, deren operative Genesis zurückgetreten ist.","refs":["MC_GB18_L3_01:MME-01","MC_GB18_L3_02:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MME-02","text":"Innen und Außen werden zu Funktionsstellen einer Produktionsbewegung: Außen kann defizitäre Kopplung oder notwendige Exposition intern erzeugter Differenz bedeuten.","refs":["MC_GB18_L3_01:MME-03","MC_GB18_L3_02:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MME-03","text":"Qualität, Quantität, Wesen und Erscheinung bilden keine getrennten Regionen mehr; Maß vermittelt Größenvariation, während Erscheinung die reflektierte Wahrheit dieser Vermittlung manifestiert.","refs":["MC_GB18_L3_01:MME-04","MC_GB18_L3_02:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MME-04","text":"Ursache und Wirkung sowie Notwendigkeit und Freiheit verlieren ihre festen Gegensätze und werden zu reversiblen Rollen organisierter Selbstkonditionierung.","refs":["MC_GB18_L3_02:MME-04","MC_GB18_L3_02:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MME-05","text":"Mathematik wird regionalisiert, während kategoriales Lesen auf Mutation, Rückkehr und Funktionswechsel verpflichtet wird; statische Begriffslisten verlieren ihre methodische Autorität.","refs":["MC_GB18_L3_01:MME-06","MC_GB18_L3_02:MME-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"WB_GB18:ALT-B01","text":"Auf dem Surface level bilden Seyn, Qualität, Zahl, Maß, Grund, Erscheinung, Substanz, Kausalität, Freiheit und Begriff die sichtbaren Verdichtungen der Bewegung.","refs":["MC_GB18_L3_01:ALT-B01","MC_GB18_L3_02:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:ALT-B02","text":"Auf dem Structural level erzeugen Negation, Grenze, Externalisierung, Schwelle, Reflexion und Rückkehr vorläufig stabile Gestalten und deren Übergänge.","refs":["MC_GB18_L3_01:ALT-B02","MC_GB18_L3_02:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:ALT-B03","text":"Auf dem Metastrategic level verlagern sich Interpretation und Intervention von der Wahl fertiger Pole auf die Rekonstruktion und Umbildung ihrer Erzeugungsbedingungen.","refs":["MC_GB18_L3_01:ALT-B03","MC_GB18_L3_02:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:ALT-B04","text":"Auf dem Ontological / Temporal level ist Realität selbstwirkende Vermittlung, deren Resultate Voraussetzungen setzen und deren Zeit Wiederholung nur als Transformation zulässt.","refs":["MC_GB18_L3_01:ALT-B04","MC_GB18_L3_02:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:ALT-B05","text":"Auf dem Methodological / Performative level vollzieht die Darstellung ihre Ontologie, indem sie feste Bestimmungen setzt, ihre Ausschlüsse aktiviert und sie mutiert zurückkehren lässt.","refs":["MC_GB18_L3_01:ALT-B05","MC_GB18_L3_02:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"WB_GB18:FL-01","text":"Die Ununterscheidbarkeit des bestimmungslosen Anfangs motiviert Negation, erklärt aber nicht vollständig, weshalb Gleichrangigkeit notwendig Bewegung statt formaler Identität erzeugt.","refs":["MC_GB18_L3_01:FL-01","MC_GB18_L3_02:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:FL-02","text":"Äußerlichkeit muss erzeugt, erhalten und internalisiert werden, darf aber weder unabhängige Erklärungskraft besitzen noch in differenzloser Innerlichkeit verschwinden.","refs":["MC_GB18_L3_01:FL-03","MC_GB18_L3_02:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:FL-03","text":"Der Anspruch vollständiger immanenter Selbstbewegung steht in Spannung zur notwendigen qualitativen Typisierung, Anwendung und gegenständlichen Prüfung konkreter Kategorien.","refs":["MC_GB18_L3_01:FL-04","MC_GB18_L3_02:FL-07"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:FL-04","text":"Maß und Begriff beanspruchen positive Zureichendheit, obwohl weder konkrete Schwellenordnungen noch das Kriterium legitimer innerer Gliederung vollständig deduziert werden.","refs":["MC_GB18_L3_01:FL-05","MC_GB18_L3_02:FL-06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:FL-05","text":"Der universale Übergang zu Wesen und Freiheit kollidiert mit der regionalen Reichweite quantitativer Gesetzlichkeit und der konstitutiven Abhängigkeit jeder Selbstbestimmung.","refs":["MC_GB18_L3_01:FL-06","MC_GB18_L3_02:FL-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:MP-01","text":"Unmittelbarkeit mutiert von der leeren Anfangsform über sedimentierte Vermittlung zur gesetzten Präsenz, in der Vermittlung wirksam bleibt, obwohl sie verschwunden erscheint.","refs":["MC_GB18_L3_01:MP-01","MC_GB18_L3_02:RMD-01"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"WB_GB18:MP-02","text":"Negation mutiert vom abstrakten Gegenpol zur Grenze, zum Maßumschlag, zur Reflexion und schließlich zur manifestierenden Operation der Wirklichkeit.","refs":["MC_GB18_L3_01:MP-02","MC_GB18_L3_02:MP-01"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"WB_GB18:MP-03","text":"Substrat mutiert vom Resultat entselbständigter Maße zum problematischen Trägermodell und danach zur Substanz, die ihre Differenzen selbst manifestiert und organisiert.","refs":["MC_GB18_L3_01:FL-07","MC_GB18_L3_02:MP-06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:MP-04","text":"Kausalität mutiert von äußerer Einwirkung über Wechselwirkung zu manifestierter Notwendigkeit; Substanz wird zum Subjekt, sobald diese Rollen als eigene Glieder organisiert sind.","refs":["MC_GB18_L3_02:MP-04","MC_GB18_L3_02:MP-05","MC_GB18_L3_02:MP-06"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"WB_GB18:HSI-01","text":"Realität erscheint als rekursive Negations-, Maß- und Vermittlungsmaschine, die Unterschiede erzeugt, externalisiert, zu Gestalten stabilisiert und als innere Organisationsformen zurücknimmt.","refs":["MC_GB18_L3_01:HSI-01","MC_GB18_L3_02:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:HSI-02","text":"Das Subjekt ist kein Betreiber dieser Maschine, sondern ihre späte Rückkehrform, in der verteilte Reflexion ihre Unterschiede als eigene Bestimmungen organisiert.","refs":["MC_GB18_L3_01:HSI-02","MC_GB18_L3_02:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:HSI-03","text":"Zeit ist eine Spirale, in der quantitative Fortsetzung Schwellen erreicht, Wirkungen Ursachen verwirklichen und Resultate ihre Anfänge rückwirkend konstituieren.","refs":["MC_GB18_L3_01:HSI-03","MC_GB18_L3_02:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:HSI-04","text":"Navigation besteht in der Verfolgung und Umbildung von Vermittlungen, Bedingungen, Rollen und Umschlagspunkten; ein äußerer Maßstab oder bedingungsloser Fluchtpunkt bleibt ausgeschlossen.","refs":["MC_GB18_L3_01:HSI-04","MC_GB18_L3_02:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"WB_GB18:MRT-B01","text":"Die Architektur ist rekonstruierbar, sofern bestimmungsloser Anfang, erhaltende Negation, Grenze, Quantität, Maß, Reflexion, Erscheinung, Kausalität, Freiheit und Begriff erhalten bleiben.","refs":["MC_GB18_L3_01:MRT-B01","MC_GB18_L3_02:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MRT-B02","text":"Das System bleibt kohärent, sofern Unmittelbarkeit nicht als vermittlungslos, Äußerlichkeit nicht als einheitlich defizitär und Freiheit nicht als Unterbrechung der Notwendigkeit gelesen wird.","refs":["MC_GB18_L3_01:MRT-B02","MC_GB18_L3_02:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MRT-B03","text":"Die stärkste Architektur liegt in der Transformation isolierter Selbständigkeit in relationale Funktion, quantitativer Variation in qualitative Schwellen und fixer Kausalrollen in rekursive Wechselwirkung.","refs":["MC_GB18_L3_01:MRT-B03","MC_GB18_L3_02:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MRT-B04","text":"Unterbestimmt bleiben der erste Übergang, der Umschlag des äußerlich wiederholten schlechten Progresses in immanente Rückkehr, konkrete Maßgesetze, die positive Genesis bestimmter Inhalte und die vollständige Vermittlung von Wechselwirkung, Subjektivität und Begriff.","refs":["MC_GB18_L3_01:MRT-B04","MC_GB18_L3_02:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MRT-B05","text":"Die minimale Rekonstruktion ist nur hinreichend, wenn sie Sequenzierung, rekursive Rückkehr, Funktionsmutation und die produktive Spannung zwischen negativer Schließung und positiver Selbstorganisation bewahrt.","refs":["MC_GB18_L3_01:MRT-B05","MC_GB18_L3_02:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261019T124929781024Z_7689583a","language_code":"en","language_name":"English","title":"Science of Logic","source_sha256":"847d09b0041b62366eaf3aa579be2c1366f6a723a38d8d9955eb7401ffb76345","sha256":"7ef54311b3a73e0df143a01ae0d94a3d1e922272215a90dcbd3f5ee704328004","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-19T12:49:29.782326+00:00","sections":[{"number":"1","name":"Book-Scale Argumental Spine","items":[{"id":"WB_GB18:BAS-01","text":"The system must generate determinate unity without presupposed quality, quantity, substrate, external ground, or sovereign epistemic standpoint from its own movement of mediation.","refs":["MC_GB18_L3_01:AS-01","MC_GB18_L3_02:BAS-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-02","text":"Its global thesis determines negativity as preservative self-differentiation, through which identity brings forth its differences, externalizes them, and reappropriates them as its own organizational moments.","refs":["MC_GB18_L3_01:AS-02","MC_GB18_L3_02:BAS-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-03","text":"The argument is a genetic-recursive ontology whose categories arise from the untenability of isolated determinations and retroactively determine their presuppositions through their results.","refs":["MC_GB18_L3_01:AS-03","MC_GB18_L3_02:BAS-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-04","text":"The directed movement leads from indeterminate Seyn through quality, quantity, and measure to the reflected mediation of essence, and from there to the subjective organizational demand of the concept.","refs":["MC_GB18_L3_01:AS-08","MC_GB18_L3_02:BAS-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-05","text":"Externality mutates from the excluded alien ground into produced multiplicity, into the medium of measure and appearance, and finally into the organized form of passivity of a self-manifesting totality.","refs":["MC_GB18_L3_01:AS-06","MC_GB18_L3_02:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-06","text":"The movement is recursive, spiral-shaped, and result-temporal: every limit generates a new regime of mediation that retroactively alters the status of its point of departure.","refs":["MC_GB18_L3_01:AS-07","MC_GB18_L3_02:BAS-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-07","text":"The negative closure of Seyn deprives individual measures of their independence, while the positive closure of essence reconstructs conditions, causes, and differences as internal members of a self-organization.","refs":["MC_GB18_L3_01:XD-09","MC_GB18_L3_02:BAS-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BAS-08","text":"The closure is terminal-transformative, not immobilizing: measure passes into essence and substance into concept, yet the positive production of concrete laws of measure and members of the concept remains open.","refs":["MC_GB18_L3_01:GA-13","MC_GB18_L3_02:GA-13"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Argumental Spine"},{"number":"2","name":"Global Load-Bearing Axioms","items":[{"id":"WB_GB18:GA-01","text":"[Persistent] No determination possesses relation-external independence; identity exists only as mediated self-preservation within the differences that it produces and limits.","refs":["MC_GB18_L3_01:GA-01","MC_GB18_L3_02:GA-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-02","text":"[Attractor] Immanent negativity is the universal operator of transformation insofar as it preserves what is negated, turns it against its isolated form, and reappropriates it into more concrete unity.","refs":["MC_GB18_L3_01:GA-02","MC_GB18_L3_02:GA-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-03","text":"[Mutating] Immediacy mutates from the indeterminate beginning into sedimented mediation and further into the posited form of appearance of a connection whose genesis recedes in its result.","refs":["MC_GB18_L3_01:GA-04","MC_GB18_L3_02:GA-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-04","text":"[Mutating] Externality is excluded as an original ground of explanation, but constitutive as a produced form of multiplicity, appearance, condition, and passivity.","refs":["MC_GB18_L3_01:GA-06","MC_GB18_L3_02:GA-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-05","text":"[Persistent] Contradiction is not a defect but the operative instability through which isolated determinations lose their independence and produce their counter-moments.","refs":["MC_GB18_L3_01:GA-08","MC_GB18_L3_02:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-06","text":"[Emergent] Measure is the hinge between Seyn and essence because its states lose their independence and release their qualitative genesis as the reflected appearance of a connection.","refs":["MC_GB18_L3_01:GA-11","MC_GB18_L3_02:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-07","text":"[Mutating] Ground, condition, and cause lose their antecedent status and become retroactively posited functions of a movement that produces its own presuppositions.","refs":["MC_GB18_L3_01:XD-07","MC_GB18_L3_02:GA-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-08","text":"[Emergent] Actuality consists of relationally stabilized phases in which essence, existence, appearance, and conditions become effective as moments of the same manifesting movement.","refs":["MC_GB18_L3_01:BSD-01","MC_GB18_L3_02:GA-09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-09","text":"[Attractor] Concrete self-relation and totality are the same positive attractor: unity preserves its differences while depriving them of every isolated independence.","refs":["MC_GB18_L3_01:GA-05","MC_GB18_L3_02:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-10","text":"[Terminal] The objective movement of categories closes by measure passing into reflected ground and substantial self-organization into the subjective demand for articulation of the concept.","refs":["MC_GB18_L3_01:GA-13","MC_GB18_L3_02:GA-13"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-11","text":"[Persistent] Form of cognition and form of being converge because explanation counts only as the immanent reconstruction of the operations through which the object produces its determinations.","refs":["MC_GB18_L3_01:GA-03","MC_GB18_L3_02:GA-14"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:GA-12","text":"[Attractor] The missing law of concrete orders of measure and members of the concept is the negative attractor that prevents complete positive closure and makes the sequence of mutations irreplaceable.","refs":["MC_GB18_L3_01:GA-15","MC_GB18_L3_02:FL-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Global Load-Bearing Axioms"},{"number":"3","name":"Recurrence, Mutation, and Displacement Matrix","items":[{"id":"WB_GB18:RMD-01","text":"Immediacy preserves the function of positive presence, but shifts from emptiness of content through resultant repose to the appearance of a mediation that becomes invisible in its product.","refs":["MC_GB18_L3_01:RMD-02","MC_GB18_L3_02:RMD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-02","text":"Negativity escalates from abstract nothing through limit, repulsion, and measurelessness to the productive force of reflection, manifestation, causality, and self-articulation.","refs":["MC_GB18_L3_01:RMD-01","MC_GB18_L3_02:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-03","text":"The other migrates from external objecthood into internal negation, returns as quantitative externality, and acquires a constitutive positive function in appearance and condition.","refs":["MC_GB18_L3_01:RMD-04","MC_GB18_L3_02:RMD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-04","text":"The function of the limit shifts from qualitative constitution and the threshold of measure to the structure of condition: what initially produces transition is later organized as a retroactively posited presupposition.","refs":["MC_GB18_L3_01:RMD-03","MC_GB18_L3_02:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-05","text":"The substrate arising at the end of the movement of measure once again loses in essence the status of a passive bearer and mutates into the manifesting self-organization of substance.","refs":["MC_GB18_L3_01:FGS-B09","MC_GB18_L3_02:FGS-B05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-06","text":"Contradiction remains functionally identical although its explicit naming recedes: as a later form, it destabilizes laws, forces, and fixed causal roles.","refs":["MC_GB18_L3_01:RMD-08","MC_GB18_L3_02:RMD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-07","text":"Infinity loses its beyond-form, becomes present self-mediation, and is subsequently absorbed into the more comprehensive attractor of a differentiated totality.","refs":["MC_GB18_L3_01:RMD-06","MC_GB18_L3_02:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RMD-08","text":"The subject reverses its position: it is initially excluded as a presupposed origin and arises terminally as the return-form of distributed objective mediation.","refs":["MC_GB18_L3_01:BSD-02","MC_GB18_L3_02:RMD-08"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recurrence, Mutation, and Displacement Matrix"},{"number":"4","name":"Lower-Layer vs Current-Level Distinction","items":[{"id":"WB_GB18:CGD-01","text":"Individual categories of Seyn, number, thing, law, or force remain local transitional forms; at the level of the whole book, they count as phases of a machine of relational de-independence.","refs":["MC_GB18_L3_01:CGD-01","MC_GB18_L3_02:CGD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:CGD-02","text":"Scientific, musical, and political examples, as well as local critiques of bearers, scale only insofar as they test the self-production of qualitative relations and their thresholds.","refs":["MC_GB18_L3_01:CGD-02","MC_GB18_L3_02:CGD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:CGD-03","text":"Historical critique of logic, comparison, and tranquil lawfulness remain forms of exposition or dismantling; globally, their replacement by immanently moving relational forms is load-bearing.","refs":["MC_GB18_L3_01:CGD-03","MC_GB18_L3_02:CGD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:CGD-04","text":"Concrete exponents, thresholds, and contents remain locally underdetermined; at the level of the whole book, their non-derivability and the incomplete articulation of the concept form a shared gap of positive sufficiency.","refs":["MC_GB18_L3_01:CGD-05","MC_GB18_L3_02:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:CGD-05","text":"Not the inventory of categories, but the concrete sequence of their mutation, return, and reversal scales into the supporting architecture of the whole book.","refs":["MC_GB18_L3_01:MRT-B05","MC_GB18_L3_02:CGD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Lower-Layer vs Current-Level Distinction"},{"number":"5","name":"Global Apophatic Structure","items":[{"id":"WB_GB18:GNX-01","text":"Excluded are an externally supplied method and a sovereign observer that could connect the categories without themselves being subject to the movement of mediation.","refs":["MC_GB18_L3_01:GNX-01","MC_GB18_L3_02:GNX-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:GNX-02","text":"Excluded are a positively determined beginning and a propertyless substrate that could bear determinacy prior to difference, relation, or manifestation.","refs":["MC_GB18_L3_01:GNX-02","MC_GB18_L3_02:GNX-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:GNX-03","text":"Excluded are finished substances, relata, grounds, and causes to which relations or effects would only subsequently be added.","refs":["MC_GB18_L3_01:GNX-03","MC_GB18_L3_02:GNX-03"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:GNX-04","text":"Excluded are pure positivity, self-sameness without difference, and annihilating negation, because none of these forms can produce concrete identity.","refs":["MC_GB18_L3_01:GNX-04","MC_GB18_L3_02:GNX-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:GNX-05","text":"Excluded are self-interpreting formalism, universal quantification, and freedom as an unconditional interruption of the conditions that produce it.","refs":["MC_GB18_L3_01:GNX-06","MC_GB18_L3_02:GNX-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:GNX-06","text":"Excluded is a terminal closedness that does not produce its concrete differentiation and immobilizes the transition into a new regime of operation.","refs":["MC_GB18_L3_01:GNX-07","MC_GB18_L3_02:GNX-06"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Global Apophatic Structure"},{"number":"6","name":"Deep Book Apophatics","items":[{"id":"WB_GB18:DBN-01","text":"An irreducible outside may not be a ground of explanation, but must persist as a produced difference of enactment; its complete autonomy and its total dissolution are equally inadmissible.","refs":["MC_GB18_L3_01:DBN-04","MC_GB18_L3_02:DBN-03"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:DBN-02","text":"Linear succession and sequence-independent totality must be false, because transitions acquire necessity only through recursive reappropriation and mutation of their presuppositions.","refs":["MC_GB18_L3_01:DBN-03","MC_GB18_L3_02:DBN-04"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:DBN-03","text":"Operative calculability and representational cognition must not coincide with conceptual truth; explanation must enact the genesis of its object.","refs":["MC_GB18_L3_01:DBN-05","MC_GB18_L3_02:DBN-05"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:DBN-04","text":"A complete derivation of concrete natural laws or conceptual contents must not be feigned, because the architecture produces reliable forms rather than their determinate filling.","refs":["MC_GB18_L3_01:DBN-06","MC_GB18_L3_02:FL-07"],"deep_refs":[],"trace_type":"Negative","passages":[]}],"original_name":"Deep Book Apophatics"},{"number":"7","name":"Super-Apophatics of the Whole","items":[{"id":"WB_GB18:BSA-01","text":"The deepest absence is a resting first origin whose priority would require no retroactive production through limit, effect, and result.","refs":["MC_GB18_L3_01:BSA-01","MC_GB18_L3_02:BSA-02"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:BSA-02","text":"Ontologically inadmissible is an unassimilable outside that could supply material, standards, or causes without returning as a produced moment of totality.","refs":["MC_GB18_L3_01:BSA-02","MC_GB18_L3_02:BSA-01"],"deep_refs":[],"trace_type":"Negative","passages":[]},{"id":"WB_GB18:BSA-03","text":"The system circles around a fully immanent form of concrete production of difference whose positive laws of measure and internal articulation of the concept are precisely not fully available.","refs":["MC_GB18_L3_01:BSA-04","MC_GB18_L3_02:BSA-04"],"deep_refs":[],"trace_type":"Tension","passages":[]}],"original_name":"Super-Apophatics of the Whole"},{"number":"8","name":"Cross-Unit Derivative Propositions","items":[{"id":"WB_GB18:XD-01","text":"The decay of individual measures produces the substrate whose apparent function as bearer the movement of reflection subsequently negates and reconstructs as posited mediation.","refs":["WB_GB18:GA-06","WB_GB18:GA-07","MC_GB18_L3_01:FGS-B09","MC_GB18_L3_02:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-02","text":"The logic of being produces resultant immediacy; the logic of essence retroactively reveals that this presence contains the vanished efficacy of its mediation.","refs":["WB_GB18:GA-03","WB_GB18:GA-07","MC_GB18_L3_01:GA-04","MC_GB18_L3_02:GA-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-03","text":"Quantitative externality and essential appearance are successive functions of the same produced difference: first the medium of indifferent variation, then the real exposition of immanent genesis.","refs":["WB_GB18:GA-04","WB_GB18:GA-08","MC_GB18_L3_01:AS-06","MC_GB18_L3_02:RMD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-04","text":"A qualitative transition is not externally caused, but reorganizes the conditions and roles of a connection such that effect contributes to the realization of its cause.","refs":["WB_GB18:GA-05","WB_GB18:GA-07","WB_GB18:GA-08","MC_GB18_L3_01:GA-12","MC_GB18_L3_02:BSD-03"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-05","text":"True infinity provides the relational form of totality: a unity is closed insofar as it integrates its counter-moments, not insofar as it ends difference.","refs":["WB_GB18:GA-02","WB_GB18:GA-09","MC_GB18_L3_01:XD-04","MC_GB18_L3_02:RLE-04"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-06","text":"The missing law of concrete thresholds and the incomplete articulation of the concept form the same gap of closure at opposite ends of the objective movement of categories.","refs":["WB_GB18:GA-10","WB_GB18:GA-12","MC_GB18_L3_01:GA-15","MC_GB18_L3_02:XD-07"],"deep_refs":[],"trace_type":"From","passages":[]},{"id":"WB_GB18:XD-07","text":"Immanent derivation and ontological manifestation unite cognition and being in a genetic operation, but remain dependent on qualitative typification and delimitation of scope.","refs":["WB_GB18:GA-08","WB_GB18:GA-11","MC_GB18_L3_01:XD-08","MC_GB18_L3_02:XD-08"],"deep_refs":[],"trace_type":"From","passages":[]}],"original_name":"Cross-Unit Derivative Propositions"},{"number":"9","name":"Book-Scale Super-Derivatives","items":[{"id":"WB_GB18:BSD-01","text":"Reality consists of recursive fields of production in which things, states, substrates, and substances arise as provisional condensations of self-mediating relations.","refs":["MC_GB18_L3_01:BSD-01","MC_GB18_L3_02:BSD-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BSD-02","text":"Time is a result-spiral of repetition of limits, quantitative continuation, qualitative interruption, and retroactive reconstitution of the beginning.","refs":["MC_GB18_L3_01:BSD-03","MC_GB18_L3_02:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BSD-03","text":"Causality denotes not a linear transmission between finished things, but the threshold-shaped self-conditioning of a connection that realizes causes through effects.","refs":["MC_GB18_L3_01:BSD-04","MC_GB18_L3_02:BSD-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BSD-04","text":"The subject is neither origin nor mere effect, but the late organizational form of an objectively distributed reflection that reappropriates its differences as its own members.","refs":["MC_GB18_L3_01:BSD-02","MC_GB18_L3_02:BSD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BSD-05","text":"Agency and freedom consist in the reflexive transformation of producing conditions, relations, and roles, not in abstract transcendence or initiative without presuppositions.","refs":["MC_GB18_L3_01:BSD-06","MC_GB18_L3_02:BSD-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:BSD-06","text":"Cognition becomes genetic and performative: it must determine categorical genesis, qualitative validity, form of manifestation, and objective scope within the same reconstruction.","refs":["MC_GB18_L3_01:BSD-05","MC_GB18_L3_02:BSD-06"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Book-Scale Super-Derivatives"},{"number":"10","name":"Recursive Loops, Escalation Paths, and Conceptual Attractors","items":[{"id":"WB_GB18:RLE-01","text":"The sedimentation loop is: mediation produces immediacy, immediacy conceals its genesis, and concealed mediation returns as a new contradiction.","refs":["MC_GB18_L3_01:RLE-02","MC_GB18_L3_02:RLE-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-02","text":"The loop of externality leads from exclusion through produced externalization to internalization; every internalization, however, posits a new outside and compels further mediation.","refs":["MC_GB18_L3_01:RLE-03","MC_GB18_L3_02:RLE-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-03","text":"The escalation of the limit leads from determinacy through restriction and threshold of measure to the condition that is posited as presupposition only through the movement enabled by it.","refs":["MC_GB18_L3_01:RLE-04","MC_GB18_L3_02:RLE-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-04","text":"The loop of justification leads from the presuppositionless beginning to the result and from there to the retroactive determination of what can count logically as ground and cause.","refs":["MC_GB18_L3_01:RLE-01","MC_GB18_L3_02:XD-04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-05","text":"The escalation of thresholds leads from indifferent variation through accumulation and qualitative leap to appearance, law, force, and recursive causality.","refs":["MC_GB18_L3_01:RLE-06","MC_GB18_L3_02:RLE-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-06","text":"The terminal escalation leads from de-independentized measures through substrate and substantial power to reciprocal action, and finally to the subjective organization of its own differences.","refs":["MC_GB18_L3_01:RLE-07","MC_GB18_L3_02:RLE-06"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:RLE-07","text":"The whole machine is organized by two asymmetric attractors: positively by immanent totality, negatively by the missing law of its concrete differentiation.","refs":["MC_GB18_L3_01:RLE-08","MC_GB18_L3_02:RLE-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Recursive Loops, Escalation Paths, and Conceptual Attractors"},{"number":"11","name":"Formal Generative Schema of the Whole Book","items":[{"id":"WB_GB18:FGS-B01","text":"Exclusion of external method and presupposed bearer → emptied beginning → self-contradiction of passive immediacy → immanent movement of categories.","refs":["MC_GB18_L3_01:GNX-01","MC_GB18_L3_02:FGS-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B02","text":"Indeterminate presence → negation → becoming → resultant quality → something and other → constitutive limit.","refs":["MC_GB18_L3_01:AS-01","MC_GB18_L3_01:GA-07"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B03","text":"Limit → finitude → bad infinity → affirmative self-relation → one and repulsion → homogeneous multiplicity → quantity.","refs":["MC_GB18_L3_01:GA-09","MC_GB18_L3_01:GA-10"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B04","text":"Quantum → relation and invariant → measure → range of indifference → threshold → qualitative transition.","refs":["MC_GB18_L3_01:GA-11","MC_GB18_L3_01:GA-12"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B05","text":"Series of measures → de-independence of individual states → continuity of substrate → reflected ground → essence.","refs":["MC_GB18_L3_01:GA-13","MC_GB18_L3_01:FGS-B09"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B06","text":"Reflection → ground and condition → mediated existence → loss of substrate → appearance as manifest genesis.","refs":["MC_GB18_L3_02:GA-06","MC_GB18_L3_02:GA-08"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B07","text":"Appearance → actuality → substance → causal differentiation and reciprocal action → manifested necessity → reflected freedom.","refs":["MC_GB18_L3_02:GA-09","MC_GB18_L3_02:GA-11"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:FGS-B08","text":"Substantial self-organization → subject → concept as demand for internal articulation; missing concrete laws of production → terminally open closure.","refs":["MC_GB18_L3_02:GA-12","MC_GB18_L3_02:GA-15","MC_GB18_L3_01:GA-15"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Formal Generative Schema of the Whole Book"},{"number":"12","name":"Whole-Book Argument Flow Map","items":[{"id":"WB_GB18:AFM-B01","text":"Emptied beginning → quality → quantity → measure → essence → ground → appearance → actuality → substance → causality → freedom → concept.","refs":["MC_GB18_L3_01:MRT-B01","MC_GB18_L3_02:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:AFM-B02","text":"Excluded outside → produced multiplicity → quantitative externality → appearance and condition → organized passivity → internal articulation.","refs":["MC_GB18_L3_01:AS-06","MC_GB18_L3_02:BAS-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:AFM-B03","text":"Abstract negation → qualitative limit → repulsion → measurelessness → reflection → manifestation → causal reversibility → subjective self-determination.","refs":["MC_GB18_L3_01:RMD-01","MC_GB18_L3_02:RMD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:AFM-B04","text":"Repetition of limits → quantitative continuation → qualitative transition → retroactive presupposition → result-time.","refs":["MC_GB18_L3_01:BSD-03","MC_GB18_L3_02:BSD-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:AFM-B05","text":"De-independence of measure → negative closure of regress to the ground → manifested necessity → open concept as terminal attractor.","refs":["MC_GB18_L3_01:XD-09","MC_GB18_L3_02:AFM-B03"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Whole-Book Argument Flow Map"},{"number":"13","name":"Macro Map-Effects","items":[{"id":"WB_GB18:MME-01","text":"Immediacy and mediation are no longer mapped as opposites; presence appears as condensed mediation whose operative genesis has receded.","refs":["MC_GB18_L3_01:MME-01","MC_GB18_L3_02:MME-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MME-02","text":"Inside and outside become functional positions of a movement of production: outside can mean deficient coupling or necessary exposition of internally produced difference.","refs":["MC_GB18_L3_01:MME-03","MC_GB18_L3_02:MME-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MME-03","text":"Quality, quantity, essence, and appearance no longer form separate regions; measure mediates variation in magnitude, while appearance manifests the reflected truth of this mediation.","refs":["MC_GB18_L3_01:MME-04","MC_GB18_L3_02:MME-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MME-04","text":"Cause and effect, as well as necessity and freedom, lose their fixed oppositions and become reversible roles of organized self-conditioning.","refs":["MC_GB18_L3_02:MME-04","MC_GB18_L3_02:MME-05"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MME-05","text":"Mathematics is regionalized, while categorical reading is committed to mutation, return, and functional change; static lists of concepts lose their methodological authority.","refs":["MC_GB18_L3_01:MME-06","MC_GB18_L3_02:MME-07"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Macro Map-Effects"},{"number":"14","name":"Altitude Integration","items":[{"id":"WB_GB18:ALT-B01","text":"At the Surface level, Seyn, quality, number, measure, ground, appearance, substance, causality, freedom, and concept form the visible condensations of the movement.","refs":["MC_GB18_L3_01:ALT-B01","MC_GB18_L3_02:ALT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:ALT-B02","text":"At the Structural level, negation, limit, externalization, threshold, reflection, and return produce provisionally stable configurations and their transitions.","refs":["MC_GB18_L3_01:ALT-B02","MC_GB18_L3_02:ALT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:ALT-B03","text":"At the Metastrategic level, interpretation and intervention shift from the selection of finished poles to the reconstruction and transformation of their conditions of production.","refs":["MC_GB18_L3_01:ALT-B03","MC_GB18_L3_02:ALT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:ALT-B04","text":"At the Ontological / Temporal level, reality is self-effectuating mediation, whose results posit presuppositions and whose time permits repetition only as transformation.","refs":["MC_GB18_L3_01:ALT-B04","MC_GB18_L3_02:ALT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:ALT-B05","text":"At the Methodological / Performative level, the exposition enacts its ontology by positing fixed determinations, activating their exclusions, and allowing them to return in mutated form.","refs":["MC_GB18_L3_01:ALT-B05","MC_GB18_L3_02:ALT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Altitude Integration"},{"number":"15","name":"Internal Tensions, Mutation Points, and Fault Lines","items":[{"id":"WB_GB18:FL-01","text":"The indistinguishability of the indeterminate beginning motivates negation, but does not fully explain why equal rank necessarily produces movement rather than formal identity.","refs":["MC_GB18_L3_01:FL-01","MC_GB18_L3_02:FL-02"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:FL-02","text":"Externality must be produced, preserved, and internalized, but may neither possess independent explanatory force nor disappear into innerness without difference.","refs":["MC_GB18_L3_01:FL-03","MC_GB18_L3_02:FL-01"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:FL-03","text":"The claim of complete immanent self-movement stands in tension with the necessary qualitative typification, application, and objective testing of concrete categories.","refs":["MC_GB18_L3_01:FL-04","MC_GB18_L3_02:FL-07"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:FL-04","text":"Measure and concept claim positive sufficiency, although neither concrete threshold orders nor the criterion of legitimate internal articulation are fully deduced.","refs":["MC_GB18_L3_01:FL-05","MC_GB18_L3_02:FL-06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:FL-05","text":"The universal transition to essence and freedom collides with the regional scope of quantitative lawfulness and the constitutive dependence of every self-determination.","refs":["MC_GB18_L3_01:FL-06","MC_GB18_L3_02:FL-05"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:MP-01","text":"Immediacy mutates from the empty initial form through sedimented mediation to posited presence, in which mediation remains effective although it appears to have vanished.","refs":["MC_GB18_L3_01:MP-01","MC_GB18_L3_02:RMD-01"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"WB_GB18:MP-02","text":"Negation mutates from the abstract counter-pole into limit, transition of measure, reflection, and finally the manifesting operation of actuality.","refs":["MC_GB18_L3_01:MP-02","MC_GB18_L3_02:MP-01"],"deep_refs":[],"trace_type":"Composite","passages":[]},{"id":"WB_GB18:MP-03","text":"Substrate mutates from the result of de-independentized measures into the problematic bearer-model and thereafter into substance, which itself manifests and organizes its differences.","refs":["MC_GB18_L3_01:FL-07","MC_GB18_L3_02:MP-06"],"deep_refs":[],"trace_type":"Tension","passages":[]},{"id":"WB_GB18:MP-04","text":"Causality mutates from external action through reciprocal action to manifested necessity; substance becomes subject as soon as these roles are organized as its own members.","refs":["MC_GB18_L3_02:MP-04","MC_GB18_L3_02:MP-05","MC_GB18_L3_02:MP-06"],"deep_refs":[],"trace_type":"Composite","passages":[]}],"original_name":"Internal Tensions, Mutation Points, and Fault Lines"},{"number":"16","name":"Hidden System Image","items":[{"id":"WB_GB18:HSI-01","text":"Reality appears as a recursive machine of negation, measure, and mediation that produces differences, externalizes them, stabilizes them into configurations, and reappropriates them as internal organizational forms.","refs":["MC_GB18_L3_01:HSI-01","MC_GB18_L3_02:HSI-01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:HSI-02","text":"The subject is not the operator of this machine, but its late return-form, in which distributed reflection organizes its differences as its own determinations.","refs":["MC_GB18_L3_01:HSI-02","MC_GB18_L3_02:HSI-02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:HSI-03","text":"Time is a spiral in which quantitative continuation reaches thresholds, effects realize causes, and results retroactively constitute their beginnings.","refs":["MC_GB18_L3_01:HSI-03","MC_GB18_L3_02:HSI-03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:HSI-04","text":"Navigation consists in tracing and transforming mediations, conditions, roles, and points of transition; an external standard or unconditional vanishing point remains excluded.","refs":["MC_GB18_L3_01:HSI-04","MC_GB18_L3_02:HSI-04"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Hidden System Image"},{"number":"17","name":"Minimal Whole-Book Reconstruction Test","items":[{"id":"WB_GB18:MRT-B01","text":"The architecture is reconstructible provided that indeterminate beginning, preservative negation, limit, quantity, measure, reflection, appearance, causality, freedom, and concept are retained.","refs":["MC_GB18_L3_01:MRT-B01","MC_GB18_L3_02:MRT-B01"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MRT-B02","text":"The system remains coherent provided that immediacy is not read as without mediation, externality not as uniformly deficient, and freedom not as an interruption of necessity.","refs":["MC_GB18_L3_01:MRT-B02","MC_GB18_L3_02:MRT-B02"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MRT-B03","text":"The strongest architecture lies in the transformation of isolated independence into relational function, quantitative variation into qualitative thresholds, and fixed causal roles into recursive reciprocal action.","refs":["MC_GB18_L3_01:MRT-B03","MC_GB18_L3_02:MRT-B03"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MRT-B04","text":"Underdetermined remain the first transition, the reversal of externally repeated bad progress into immanent return, concrete laws of measure, the positive genesis of determinate contents, and the complete mediation of reciprocal action, subjectivity, and concept.","refs":["MC_GB18_L3_01:MRT-B04","MC_GB18_L3_02:MRT-B04"],"deep_refs":[],"trace_type":"","passages":[]},{"id":"WB_GB18:MRT-B05","text":"The minimal reconstruction is sufficient only if it preserves sequencing, recursive return, functional mutation, and the productive tension between negative closure and positive self-organization.","refs":["MC_GB18_L3_01:MRT-B05","MC_GB18_L3_02:MRT-B05"],"deep_refs":[],"trace_type":"","passages":[]}],"original_name":"Minimal Whole-Book Reconstruction Test"}],"revision":"WB_GB18@R002","source_variant_id":"canonical:WB_GB18:WB_GB18@R002","source_language_code":"de","original_title":"Science of Logic"}],"identity":{"layer":"WB","kicker":"Whole book","title":"Science of Logic","context":"","original_title":"Science of Logic"},"original_title":"Science of Logic","title_language_code":"en"}],"seal":"SEAL_GB18_7EFDD2D35BD6106D0254","original_title":"Science of Logic","title_language_code":"en","title_translation":{"schema":"care-title-heading-translation/1","language_code":"en","rendition_type":"machine","originals_preserved":true},"version_work_id":"WORK_STORE_CANON_PG6729","version_label":"Added 16 Oct 2026 · Run 17 Oct 2026 · gpt-5.6-terra / gpt-5.6-sol","version_revision":"aad531f7993873e7f5f67da7c113abaa26ba21994fd548b388af9eccc1411373"}],"fields":[{"id":"FIELD:lateral:32b23876456807","entity_id":"32b23876456807","field":"lateral","item_type":"lateral","title":"The Critique of Pure Reason × A Treatise of Human Nature","author":"Laterals","description":"Diagnosis, reframings, strange child and audit, with their declared sources","year":"","cloth":"#665077","foil":"#eee7d6","has_care":true,"has_source":true,"members":[{"id":"WORK_KANT_PURE_REASON","work_id":"WORK_KANT_PURE_REASON","title":"The Critique of Pure Reason","author":"Immanuel Kant","cloth":"#35442f","foil":"#ba8e54","has_source":true,"layers":["WB","CL","CH","NUMO"],"source_unit_ids":["WB_KPR"],"cover_url":"./assets/covers/beta-73b8664b61f6f07f-e4b1ac743ae9ce7e.png"},{"id":"WORK_A_TREATISE_OF_HUMAN_NATURE_DAVID_HUME","work_id":"WORK_A_TREATISE_OF_HUMAN_NATURE_DAVID_HUME","title":"A Treatise of Human Nature","author":"David Hume","cloth":"#35442f","foil":"#ba8e54","has_source":true,"layers":["WB","MC","CL","CH","NUMO"],"source_unit_ids":["WB_THN"],"cover_url":"./assets/covers/beta-d0138d38bb5ad732-8308e15450bed635.png"}],"member_count":2,"member_titles":["The Critique of Pure Reason","A Treatise of Human Nature"],"layers":["XR"],"cover_url":"","format":"care-beta-fields/1.0","revision":"6a2677acc8e311e399e6984b41c2b90f624712b527a386a0104c647c4659af97","bundle_sha256":"6a2677acc8e311e399e6984b41c2b90f624712b527a386a0104c647c4659af97","bundle_url":"./data/fields/c42a9648b8605e31-6a2677acc8e311e3.json"},{"id":"FIELD:corpus:CB_CORPUS_I_D01E832B","entity_id":"CB_CORPUS_I_D01E832B","field":"corpus","item_type":"corpus","title":"Corpus I","author":"Corpus","description":"14 source books · whole corpus and its member layers","year":"v2","cloth":"#94723f","foil":"#eee7d6","has_care":true,"has_source":true,"members":[{"id":"WORK_STORE_PERSEUS_GREEK_TLG0059_TLG031_PERSEUS_GRC2","work_id":"WORK_STORE_PERSEUS_GREEK_TLG0059_TLG031_PERSEUS_GRC2","title":"Timaeus","author":"Plato","cloth":"#33353c","foil":"#bd8156","has_source":true,"layers":["WB","MC","CL","CH"],"source_unit_ids":["WB_JP8E"],"cover_url":"./assets/covers/beta-8805fe2c663d049f-ba5df89a85e8d5ea.png"},{"id":"WORK_STORE_PERSEUS_GREEK_TLG0086_TLG025_PERSEUS_GRC2","work_id":"WORK_STORE_PERSEUS_GREEK_TLG0086_TLG025_PERSEUS_GRC2","title":"Metaphysica","author":"Aristotle","cloth":"#35442f","foil":"#ba8e54","has_source":true,"layers":["WB","MC","CL","CH"],"source_unit_ids":["WB_DAZY"],"cover_url":"./assets/covers/beta-223fa1fddd7cddd2-8bbd0ab3c2fb0bf2.png"},{"id":"WORK_STORE_PERSEUS_LATIN_PHI0550_PHI001_PERSEUS_LAT1","work_id":"WORK_STORE_PERSEUS_LATIN_PHI0550_PHI001_PERSEUS_LAT1","title":"De Rerum Nat