site","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:DNX7","text":"Kapitalist und Lohnarbeiter sind keine unabhängig gegebenen sozialen Typen, die erst nachträglich in Austausch treten.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:DNX8","text":"Wiederholung auf gleicher Stufenleiter kann nicht mit qualitativer historischer Stillstellung gleichgesetzt werden.","refs":["CH_V4GB_EINR:A4","CH_V4GB_EINR:A5","CH_V4GB_EINR:A9","CH_V4GB_EINR:A10","CH_V4GB_EINR:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_V4GB_EINR:SNX1","text":"Innerhalb der reproduzierten Struktur bleibt die Möglichkeit versperrt, dass der Arbeiter seine Arbeitskraft mit den objektiven Bedingungen ihrer Verwirklichung vereinigt.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX2","text":"Im fortlaufenden Kapital existiert kein dauerhaft isolierbarer, aus eigener Arbeit stammender Wertkern.","refs":["CH_V4GB_EINR:A9","CH_V4GB_EINR:A10","CH_V4GB_EINR:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX3","text":"Eine vollständig kapitalexterne Reproduktion des Arbeiterlebens ist auf gesellschaftlicher Ebene nicht verfügbar.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0029","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0033","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX4","text":"Die Übereinstimmung von rechtlicher Personfreiheit und materieller Selbstverfügung bleibt strukturell ausgeschlossen.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A15","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0037","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0044","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0060","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX5","text":"Die Maschine spezifiziert keinen internen Übergang, durch den die reproduzierte Trennung aus ihrem eigenen Vollzug aufgehoben würde.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX6","text":"Konsumtion als Selbstzweck des Arbeiters besitzt im kapitalistischen Produktivitätsmaßstab keinen positiven produktiven Status.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0034","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0035","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX7","text":"Nichtkapitalistische Reproduktion bleibt Vergleichshorizont, nicht immanent erzeugte Möglichkeit des rekonstruierten Prozesses.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A8","CH_V4GB_EINR:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}]},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_V4GB_EINR:FGS1","text":"Gesellschaftliche Reproduktion: Produktionₜ → Absonderung von Ersatzmitteln → stofflicher Ersatz der verbrauchten Bedingungen → Produktionₜ₊₁.","refs":["CH_V4GB_EINR:A1","CH_V4GB_EINR:A2"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS2","text":"Einfache kapitalistische Reproduktion: Kapitalvorschuss → Kauf von Arbeitskraft und Produktionsmitteln → Verwertung → Mehrwert → vollständige Konsumtion des Mehrwerts → erneuter Vorschuss gleicher Größenordnung.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A4","CH_V4GB_EINR:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS3","text":"Lohnzirkulation: Arbeitskraftₜ → Erzeugung von eigenem Wert und Mehrwert → Aneignung des Produkts durch Kapital → Rückfluss eines Produktteils als Geldlohn.","refs":["CH_V4GB_EINR:A6","CH_V4GB_EINR:A7","CH_V4GB_EINR:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS4","text":"Für den ursprünglichen Kapitalwert K₀ und den periodisch konsumierten Mehrwert mᶜ gilt: n = K₀ ÷ mᶜ; nach n Perioden gilt Σmᶜ = K₀ → Erlöschen der ursprünglichen Wertidentität → fortbestehendes Kapital als materialisierte unbezahlte Arbeit.","refs":["CH_V4GB_EINR:A9","CH_V4GB_EINR:A10","CH_V4GB_EINR:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS5","text":"Klassenrekursion: Trennungₜ → Verkauf der Arbeitskraft → Verwertung → fremdes Produkt als Kapital → individuelle Konsumtion → reproduzierte Arbeitskraft bei fortbestehender Trennungₜ₊₁.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS6","text":"Verdeckungsmechanismus: Geldform + Einzelvertrag + Arbeitgeberwechsel + Preisschwankung → Erscheinung unabhängiger Austauschakte → Unsichtbarkeit der Klassenrekursion.","refs":["CH_V4GB_EINR:A5","CH_V4GB_EINR:A7","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0060","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS7","text":"Gesamtausgabe des Prozesses: Waren + Mehrwert + reproduziertes Kapital + reproduzierter Lohnarbeiter + erneuertes Kapitalverhältnis.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_V4GB_EINR:AF1","text":"Kontinuität der Produktion → allgemeine Reproduktion → kapitalistische Formbestimmung → einfache Reproduktion → zeitliche Aggregation → Auflösung des ursprünglichen Kapitalvorschusses → Reproduktion des Kapitalverhältnisses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:AF2","text":"Geldlohn als Vorschuss → Wechsel zur Klassenperspektive → Lohn als Rückfluss des eigenen Produkts → variables Kapital als historische Erscheinungsform → Zerfall der Vorschussillusion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:AF3","text":"Trennung von Arbeitskraft und Arbeitsbedingungen → Verkauf der Arbeitskraft → Produkt als Kapital → individuelle Konsumtion → erneute Bedürftigkeit und Verkaufsfähigkeit → Kapitalist und Lohnarbeiter als reproduzierte Pole.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0036","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"10","name":"Map-Effects","items":[{"id":"CH_V4GB_EINR:ME1","text":"Der Gegenstand verschiebt sich vom Produktionsakt zum sich selbst erneuernden Reproduktionszusammenhang.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME2","text":"Der Lohn wird vom Kapitalvorschuss zum zirkulierenden Rückfluss eines von der Arbeiterklasse selbst erzeugten Produktteils umklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME3","text":"Variables Kapital wird von einer allgemeinen ökonomischen Kategorie zur historischen Form eines transhistorisch notwendigen Arbeitsfonds.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME4","text":"Einfache Reproduktion wird trotz gleichbleibender Größenordnung als Transformation der Wertprovenienz sichtbar.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME5","text":"Die ursprüngliche Trennung von Arbeit und Arbeitsbedingungen wird von einer äußeren Voraussetzung zu einem inneren Produkt des Prozesses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME6","text":"Individuelle Konsumtion wechselt von der privaten Gegensphäre der Produktion zu einem Moment der Reproduktion der Arbeitskraft für das Kapital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME7","text":"Der freie Warenbesitzer Arbeitskraft wird zugleich als rechtlich unabhängige Person und funktional gebundener Bestandteil des gesellschaftlichen Kapitals klassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0044","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME8","text":"Der Gegensatz von Freiheit und Hörigkeit zerfällt: Formale Freiheit erscheint als Vermittlungsform ökonomischer Bindung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0060","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME9","text":"Der Outputbegriff erweitert sich von Waren und Mehrwert auf die Reproduktion der Klassenpositionen und ihres Verhältnisses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0061","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_V4GB_EINR:ALT1","text":"Surface — Einfache Reproduktion erneuert die Produktion auf gleicher Stufenleiter, während der Kapitalist den periodischen Mehrwert konsumiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ALT2","text":"Structural — Klassenförmige Zirkulation, fortbestehende Trennung und Reproduktion der Arbeitskraft erneuern die Bedingungen von Ausbeutung und Kapitalverwertung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ALT3","text":"Metastrategic — Der Wechsel vom Einzelakt zur gesellschaftlichen Kontinuität entzieht Geldform, Vertrag und Eigentumsursprung ihre erklärende Vorrangstellung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0037","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ALT4","text":"Ontological/Temporal — Soziale Identitäten und Voraussetzungen bestehen nicht statisch, sondern werden rekursiv als Wirkungen des Prozesses erzeugt, den sie ermöglichen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_V4GB_EINR:MRT1","text":"Das Axiomensystem reicht aus, um die Bewegung von allgemeiner Reproduktion über die Auflösung der Vorschussillusion bis zur Reproduktion des Kapitalverhältnisses zu rekonstruieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT2","text":"Unterbestimmt bleiben die historische Entstehung der ursprünglichen Trennung und die konkrete Genesis eines ersten, noch nicht reproduzierten Kapitalvorschusses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0021","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT3","text":"Die Struktur ist intern kohärent, sofern konstante Produktionsgröße und veränderte Wertprovenienz als verschiedene Ebenen auseinandergehalten werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT4","text":"Ihre höchste Beweiskraft erreicht sie durch den Wechsel von Einzelpersonen zu Klassen und von der Einzelperiode zur kumulierten Zeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT5","text":"Die Verwandlung des ursprünglichen Kapitals in kapitalisierten Mehrwert hängt von Wertfungibilität, fortlaufendem Ersatz und der rechnerischen Gleichsetzung kumulierter Konsumtion mit dem ursprünglichen Vorschuss ab.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT6","text":"Die Einordnung der Arbeiterkonsumtion schwankt zwischen notwendiger Reproduktionsbedingung des Kapitals und umfassender funktionaler Vereinnahmung einer nicht vollständig kontrollierten Lebenssphäre.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0026","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0029","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0030","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT7","text":"Die Unterscheidung zwischen juristischer Nicht-Eigentümerschaft und ökonomischem Zubehör bleibt notwendig, wird aber durch die Maschinenmetaphorik teilweise komprimiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0036","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0044","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0052","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT8","text":"Die herangezogene staatliche Festhaltung verfügbarer Arbeitskraft zeigt, dass die automatische Reproduktion des Verhältnisses in Krisen durch außerökonomische Sicherung ergänzt werden kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0040","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0047","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0055","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT9","text":"Die Rekonstruktion bewahrt die tatsächliche Bewegung von der Kontinuität der Produktion über die Entschleierung ihrer Formen zur rekursiven Hervorbringung von Kapitalist und Lohnarbeiter.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261016T211416437808Z_14e9b997","language_code":"en","language_name":"English","title":"a) Simple Reproduction.","source_sha256":"2691fb61a0bf9f4056c3adeadc9e824c95e4999cee72a79e779670a0e8392a2e","sha256":"9476c61a59b373ef05c2825ad92d7ca98b5c1d17e0a41500dd978cd8ad58651e","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-16T21:14:16.439109+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_V4GB_EINR:AS1","text":"The isolated act of production does not explain how the capitalist process continuously renews its own presuppositions and class bearers.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:AS2","text":"Continuous social production is necessarily reproduction of its material conditions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:AS3","text":"Under capitalist form, the process reproduces the advanced value as self-expanding capital; simple reproduction keeps the scale of production constant.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:AS4","text":"The argument proceeds by temporal reconstruction, moving from the individual exchange to the continuous movement of classes and from the periodic process to the cumulative effect.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:AS5","text":"This change of scale reveals wages as the money-form of a portion of the product already produced by the worker and appropriated.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:AS6","text":"The cumulative consumption of surplus-value extinguishes the value identity of the original advance and transforms every continuing capital, as regards its provenance, into capitalized surplus-value.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:AS7","text":"Production and individual consumption jointly reproduce the separation of labour-power from its conditions and thus the worker as a renewed seller of his labour-power.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:AS8","text":"The process of reproduction therefore produces not only commodities and surplus-value, but the capital relation itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0061","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_V4GB_EINR:A1","text":"Every continuous social process of production is at the same time a process of reproduction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A2","text":"Production on an unchanged scale presupposes that one part of the product materially replaces the means of production consumed.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0004","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A3","text":"In capitalist production, the labour process is subordinated to the valorization process, and reproduction to the preservation of value as capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A4","text":"Simple reproduction obtains when the periodically produced surplus-value is consumed and the scale of production is renewed unchanged, other conditions remaining the same.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A5","text":"Only consideration of the process in temporal continuity and on the social scale of classes dissolves the appearances of the isolated act of exchange.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A6","text":"The worker is paid after his labour-power has already produced, in commodities, its own value and surplus-value.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0009","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A7","text":"The money wage is the transformed form of a part of the product previously produced by the working class and appropriated by the capitalist class.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A8","text":"Variable capital is the historically specific phenomenal form of the subsistence and labour fund produced by the workers themselves.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A9","text":"In simple reproduction, the capitalist periodically appropriates surplus-value without equivalent and consumes it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A10","text":"With constant consumed surplus-value, its cumulative sum reaches the amount of the original capital value after a determinable number of reproduction periods.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0018","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A11","text":"Continuous replacement of value preserves no individual value identity of the original constituent parts of capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A12","text":"The separation of labour-power from product and objective conditions of labour is the given basis of capitalist production.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A13","text":"Every production cycle transforms the worker's labour into a product alien to him, which confronts him as capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0022","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A14","text":"The individual consumption of the workers reproduces their labour-power and the working class.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0033","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A15","text":"Since the objective conditions of labour remain withdrawn from the worker, his self-preservation brings him again to market as seller of labour-power.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:A16","text":"Periodic self-sale, changes of individual capitalists, and fluctuations in the price of labour mediate and conceal the economic dependence of the wage-worker.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0060","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_V4GB_EINR:NX1","text":"Social production does not consist of individual acts independent of one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX2","text":"Simple reproduction is not a socially consequence-free repetition of the identical process of production.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX3","text":"Wages are not advanced from a subsistence fund of the capitalist constituted independently of the worker.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX4","text":"Variable capital is not a transhistorically general form of the labour fund.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0012","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX5","text":"Commodity-form and money-form do not render the class transaction transparent, but disguise it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0011","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX6","text":"The consumption of surplus-value does not allow the original capital value to continue as an unchanged stock of value.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX7","text":"Any possible original personal labour of the owner of capital does not secure for continuously reproduced capital a lasting origin in one's own labour.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX8","text":"The recurrent confrontation of capitalist and worker is not an accidental market event.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0057","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX9","text":"The individual consumption of the worker does not, socially, lie outside the reproduction of capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0029","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX10","text":"The reproductive function of workers' consumption requires neither its immediate performance in the labour process nor complete direct control by the capitalist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0029","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX11","text":"Freedom of contract and change of employer do not establish the material independence of the wage-worker.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0037","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0060","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX12","text":"The worker is not the juridical property of the capitalist, although he is functionally treated as an accessory of capital reproduction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0044","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:NX13","text":"The capitalist process of production produces not only commodities and surplus-value.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0061","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_V4GB_EINR:D1","text":"The social product necessarily divides into material replacement of the conditions of production and consumable components.","refs":["CH_V4GB_EINR:A1","CH_V4GB_EINR:A2"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0004","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0005","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:D2","text":"In simple reproduction, consumed surplus-value assumes the form of periodic revenue of capital.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A4","CH_V4GB_EINR:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:D3","text":"The working class produces the fund of its own remuneration before it accrues to it as wages.","refs":["CH_V4GB_EINR:A6","CH_V4GB_EINR:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:D4","text":"The character of variable capital as an advance from the capitalist's own fund proves to be an appearance generated by separation and money-form.","refs":["CH_V4GB_EINR:A5","CH_V4GB_EINR:A7","CH_V4GB_EINR:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0012","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:D5","text":"From the ratio of original capital value to periodically consumed surplus-value, the point in time can be determined at which the sum of surplus-value consumed corresponds to the original advance.","refs":["CH_V4GB_EINR:A9","CH_V4GB_EINR:A10","CH_V4GB_EINR:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:D6","text":"Every capital reproduced for a sufficiently long time becomes, irrespective of its original origin, capitalized surplus-value as regards its value provenance.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A4","CH_V4GB_EINR:A9","CH_V4GB_EINR:A10","CH_V4GB_EINR:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:D7","text":"The presupposed separation of labour-power and conditions of labour is renewed by every cycle as its own result.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:D8","text":"The worker continuously produces objective wealth as an alien power, while the process continuously reproduces him as a propertyless wage-worker.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0023","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:D9","text":"Within necessary limits, the individual consumption of the workers is a moment of the reproduction of capital.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0033","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:D10","text":"The destruction of the means of subsistence maintains the worker and at the same time renews the necessity of selling his labour-power again.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0036","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:D11","text":"The repeated contractual form preserves the appearance of personal independence while mediating economic servitude.","refs":["CH_V4GB_EINR:A5","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0060","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:D12","text":"Capitalist and wage-worker are produced as complementary poles of the same process of reproduction.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0061","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_V4GB_EINR:SD1","text":"An unchanged scale of production is compatible with a qualitative transformation of social value provenance.","refs":["CH_V4GB_EINR:A4","CH_V4GB_EINR:A9","CH_V4GB_EINR:A10","CH_V4GB_EINR:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SD2","text":"Capitalist causality is recursive: the presupposed separation generates a process that produces this separation as a renewed presupposition.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SD3","text":"The possible legitimacy of an original acquisition loses its explanatory force for continuing capital once its reproduction is temporally aggregated.","refs":["CH_V4GB_EINR:A5","CH_V4GB_EINR:A9","CH_V4GB_EINR:A10","CH_V4GB_EINR:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SD4","text":"The boundary of the production process extends to the reproduction of life, without every act of life having to be immediately commanded by capital.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0030","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SD5","text":"Capital delegates the maintenance of its most necessary living means of production to that means' drive for self-preservation and reproduction.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0030","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SD6","text":"Exploitation is independent of permanent attachment to an individual capitalist, because the movement of classes replaces the individual wage-master.","refs":["CH_V4GB_EINR:A5","CH_V4GB_EINR:A15","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0060","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SD7","text":"Legal non-ownership of workers is compatible with a functional claim of disposal over the reproduced worker population.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0044","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SD8","text":"Reproduction produces a subject-object inversion in which the product of labour appears as an acting power and the producer as its reproduced means.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0022","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_V4GB_EINR:DNX1","text":"The phenomenal forms of money advance, wage payment, and individual contract must not be taken as the final level of explanation.","refs":["CH_V4GB_EINR:A5","CH_V4GB_EINR:A7","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:DNX2","text":"The exchange of equivalents in the purchase of labour-power cannot determine the social total transaction as free of exploitation.","refs":["CH_V4GB_EINR:A6","CH_V4GB_EINR:A7","CH_V4GB_EINR:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:DNX3","text":"Present capital ownership cannot be permanently grounded in an original act of acquisition that continues unchanged.","refs":["CH_V4GB_EINR:A9","CH_V4GB_EINR:A10","CH_V4GB_EINR:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:DNX4","text":"The private sphere of consumption cannot be treated as a reproductively autonomous exterior of capital.","refs":["CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0029","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:DNX5","text":"Formal market freedom cannot function as the contrary concept to economic dependence.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A15","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0037","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0060","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:DNX6","text":"The reproduction of domination requires neither personal ownership of the worker nor uninterrupted immediate coercion.","refs":["CH_V4GB_EINR:A14","CH_V4GB_EINR:A15","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0044","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:DNX7","text":"Capitalist and wage-worker are not independently given social types that enter into exchange only subsequently.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:DNX8","text":"Repetition on the same scale cannot be equated with qualitative historical stasis.","refs":["CH_V4GB_EINR:A4","CH_V4GB_EINR:A5","CH_V4GB_EINR:A9","CH_V4GB_EINR:A10","CH_V4GB_EINR:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_V4GB_EINR:SNX1","text":"Within the reproduced structure, the possibility remains barred that the worker unites his labour-power with the objective conditions of its realization.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX2","text":"In continuing capital there exists no permanently isolable core of value originating in one's own labour.","refs":["CH_V4GB_EINR:A9","CH_V4GB_EINR:A10","CH_V4GB_EINR:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0020","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX3","text":"A reproduction of workers' lives wholly external to capital is not available at the social level.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0029","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0033","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX4","text":"The coincidence of juridical personal freedom and material self-disposal remains structurally excluded.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A15","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0037","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0044","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0060","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX5","text":"The machine specifies no internal transition through which the reproduced separation would be superseded by its own operation.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Negative","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX6","text":"Consumption as the worker's end in itself possesses no positive productive status within the capitalist measure of productivity.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0034","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0035","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:SNX7","text":"Non-capitalist reproduction remains a horizon of comparison, not an immanently produced possibility of the reconstructed process.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A8","CH_V4GB_EINR:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0012","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0013","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}]},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_V4GB_EINR:FGS1","text":"Social reproduction: Productionₜ → segregation of replacement means → material replacement of the consumed conditions → Productionₜ₊₁.","refs":["CH_V4GB_EINR:A1","CH_V4GB_EINR:A2"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS2","text":"Simple capitalist reproduction: capital advance → purchase of labour-power and means of production → valorization → surplus-value → complete consumption of surplus-value → renewed advance of the same magnitude.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A4","CH_V4GB_EINR:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS3","text":"Wage circulation: Labour-powerₜ → production of own value and surplus-value → appropriation of the product by capital → return flow of a portion of the product as money wage.","refs":["CH_V4GB_EINR:A6","CH_V4GB_EINR:A7","CH_V4GB_EINR:A8"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS4","text":"For the original capital value K₀ and periodically consumed surplus-value mᶜ: n = K₀ ÷ mᶜ; after n periods Σmᶜ = K₀ → extinction of the original value identity → continuing capital as materialized unpaid labour.","refs":["CH_V4GB_EINR:A9","CH_V4GB_EINR:A10","CH_V4GB_EINR:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS5","text":"Class recursion: Separationₜ → sale of labour-power → valorization → alien product as capital → individual consumption → reproduced labour-power with continuing separationₜ₊₁.","refs":["CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0023","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS6","text":"Mechanism of concealment: money-form + individual contract + change of employer + price fluctuation → appearance of independent acts of exchange → invisibility of class recursion.","refs":["CH_V4GB_EINR:A5","CH_V4GB_EINR:A7","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0060","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:FGS7","text":"Total output of the process: commodities + surplus-value + reproduced capital + reproduced wage-worker + renewed capital relation.","refs":["CH_V4GB_EINR:A3","CH_V4GB_EINR:A12","CH_V4GB_EINR:A13","CH_V4GB_EINR:A14","CH_V4GB_EINR:A15","CH_V4GB_EINR:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_EINR:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_V4GB_EINR:AF1","text":"Continuity of production → general reproduction → capitalist determination of form → simple reproduction → temporal aggregation → dissolution of the original capital advance → reproduction of the capital relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:AF2","text":"Money wage as advance → shift to the class perspective → wage as return flow of one's own product → variable capital as historical phenomenal form → disintegration of the illusion of advance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0009","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0012","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:AF3","text":"Separation of labour-power and conditions of labour → sale of labour-power → product as capital → individual consumption → renewed neediness and capacity to sell → capitalist and wage-worker as reproduced poles.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0023","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0036","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"10","name":"Map-Effects","items":[{"id":"CH_V4GB_EINR:ME1","text":"The object shifts from the act of production to the self-renewing nexus of reproduction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME2","text":"The wage is reclassified from capital advance into the circulating return flow of a portion of the product produced by the working class itself.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0010","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME3","text":"Variable capital shifts from a general economic category to the historical form of a transhistorically necessary labour fund.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0012","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME4","text":"Despite an unchanged magnitude, simple reproduction becomes visible as a transformation of value provenance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME5","text":"The original separation of labour and conditions of labour shifts from an external presupposition to an internal product of the process.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME6","text":"Individual consumption shifts from the private counter-sphere of production to a moment of the reproduction of labour-power for capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0026","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME7","text":"Labour-power, the free owner of commodities, is at once classified as a juridically independent person and a functionally bound component of social capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0044","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME8","text":"The opposition of freedom and servitude disintegrates: formal freedom appears as a mediating form of economic attachment.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0060","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ME9","text":"The concept of output expands from commodities and surplus-value to the reproduction of class positions and their relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0061","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_V4GB_EINR:ALT1","text":"Surface — Simple reproduction renews production on the same scale while the capitalist consumes periodic surplus-value.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ALT2","text":"Structural — Class-formed circulation, continuing separation, and reproduction of labour-power renew the conditions of exploitation and capital valorization.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ALT3","text":"Metastrategic — The shift from the individual act to social continuity deprives money-form, contract, and origin of property of their explanatory priority.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0037","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:ALT4","text":"Ontological/Temporal — Social identities and presuppositions do not exist statically, but are recursively produced as effects of the process they make possible.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_V4GB_EINR:MRT1","text":"The system of axioms suffices to reconstruct the movement from general reproduction through the dissolution of the illusion of advance to the reproduction of the capital relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT2","text":"The historical emergence of the original separation and the concrete genesis of a first capital advance not yet reproduced remain underdetermined.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0021","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT3","text":"The structure is internally coherent provided that constant scale of production and altered value provenance are kept distinct as different levels.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT4","text":"It achieves its highest probative force through the shift from individuals to classes and from the individual period to cumulative time.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT5","text":"The transformation of original capital into capitalized surplus-value depends on value fungibility, continuous replacement, and the arithmetical equation of cumulative consumption with the original advance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0019","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT6","text":"The classification of workers' consumption oscillates between a necessary condition of reproduction for capital and comprehensive functional appropriation of a sphere of life not fully controlled.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0026","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0029","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0030","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT7","text":"The distinction between juridical non-ownership and economic accessory remains necessary, but is partly compressed by the machine metaphorics.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0036","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0044","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0052","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT8","text":"The invoked state retention of available labour-power shows that the automatic reproduction of the relation can be supplemented in crises by extra-economic safeguarding.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0040","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0047","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0055","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_EINR:MRT9","text":"The reconstruction preserves the actual movement from the continuity of production through the unveiling of its forms to the recursive production of capitalist and wage-worker.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_EINR:P0003","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0008","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0011","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0021","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_EINR:P0061","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]}],"revision":"CH_V4GB_EINR@R001","source_variant_id":"canonical:CH_V4GB_EINR:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 18","title":"a) Einfache Reproduktion.","context":"Chapter 18"}},{"id":"CH_V4GB_BVVM","layer":"CH","title":"b) Verwandlung von Mehrwerth in Kapital.","order":19,"parents":["RAW_V4GB_BVVM"],"revision":"CH_V4GB_BVVM@R001","sha256":"b3a9eb9c11ce49ebbf0d4e0e97ac03dd33aa834632116361f473995b72590001","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_V4GB_BVVM:AS1","text":"Zu erklären ist, wie der aus Kapital erzeugte Mehrwerth selbst zur Voraussetzung weiterer Kapitalproduktion wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS2","text":"Accumulation ist die Rückverwandlung eines Teils des Mehrwerths in constantes und variables Kapital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS3","text":"Der individuelle Standpunkt zeigt eine formgleiche Kapitalmetamorphose; der gesellschaftliche Standpunkt enthüllt deren stoffliche und reproduktive Bedingungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS4","text":"Die Folge der Surpluskapitale verwandelt vergangene unbezahlte Arbeit in die Bedingung fortgesetzter Aneignung lebendiger unbezahlter Arbeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS5","text":"Das Argument verfährt rekonstruktiv, dialektisch, systemisch und gegen die apologetischen Kategorien der klassischen und vulgären Ökonomie.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0023","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS6","text":"Die Bewegung führt vom formell gültigen Äquivalententausch über die gesellschaftliche Reproduktion zum Umschlag des Eigentumsgesetzes in kapitalistische Aneignung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS7","text":"Nach Ausschluss von Schatzbildung, bloßer Lohnkonsumtion und Abstinenz erklärt der Text den Accumulationsumfang aus Mehrwerthsmasse, Teilungsverhältnis, elastischen Produktivpotenzen und Konkurrenzzwang.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0067","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0085","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0101","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_V4GB_BVVM:A1","text":"Accumulation ist die Anwendung von Mehrwerth als Kapital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A2","text":"Jeder kapitalisierte Mehrwerth muss in constantes und variables Kapital geteilt werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A3","text":"Soweit Mehrwerth accumuliert wird, muss das ihn verkörpernde Mehrprodukt die stofflichen Elemente des zusätzlichen constanten und variablen Kapitals enthalten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A4","text":"Zusätzliche Arbeit kann durch höhere Ausspannung vorhandener Arbeitskräfte oder durch die Reproduktion der Arbeiterklasse verfügbar werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A5","text":"Sämtliche Bestandteile des Surpluskapitals sind kapitalisierte unbezahlte fremde Arbeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A6","text":"Jedes weitere Surpluskapital wird durch die Verwertung eines vorhergehenden Surpluskapitals erzeugt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A7","text":"Jeder einzelne Kauf und Verkauf von Arbeitskraft kann dem Gesetz des Äquivalententauschs entsprechen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A8","text":"Das auf Waarenaustausch gegründete Eigentumsgesetz schlägt durch seine reproduktive Anwendung in Aneignung ohne Äquivalent um.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A9","text":"Kapitalistische Aneignung trennt das Eigentum am Arbeitsprodukt und an den Produktionsbedingungen von der Arbeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0107","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A10","text":"Der Mehrwerth teilt sich in Konsumtionsfonds und Accumulationsfonds.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0033","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A11","text":"Die Mehrwerthsmasse wird durch Exploitationsgrad, Produktivkraft der Arbeit und Größe des vorgeschossenen Kapitals reguliert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0067","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0085","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0101","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A12","text":"Die Herabsetzung des Arbeitslohns unter den Werth der Arbeitskraft überführt einen Teil des notwendigen Konsumtionsfonds der Arbeiter in den Accumulationsfonds des Kapitals.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0069","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A13","text":"Arbeitskraft, Erde und Wissenschaft wirken innerhalb bestimmter Grenzen als elastische Expansionspotenzen des Kapitals.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A14","text":"Lebendige Arbeit schafft Neuwerth und erhält zugleich den Werth der von ihr verbrauchten Produktionsmittel.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0095","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A15","text":"Die Differenz zwischen angewandtem und konsumiertem fixem Kapital erzeugt einen wachsenden unentgeltlichen Produktivdienst vergangener Arbeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0105","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A16","text":"Die Konkurrenz erzwingt die fortwährende Ausdehnung des individuellen Kapitals als Bedingung seiner Erhaltung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A17","text":"Accumulation um der Accumulation willen entwickelt gesellschaftliche Produktivkräfte und materielle Bedingungen einer höheren Gesellschaftsform.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A18","text":"Erweiterte Reproduktion wird erst dann zu Accumulation von Kapital, wenn Produktionsmittel, Produkt und Lebensmittel den Produzenten als Kapital gegenübertreten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_V4GB_BVVM:NX1","text":"Accumulation ist weder Schatzbildung noch Ausschluss des Geldes aus der Circulation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX2","text":"Kapitalisierung des Mehrwerths ist nicht dessen bloße Konsumtion durch produktive Arbeiter.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX3","text":"Das gesellschaftliche Kapital löst sich nicht vollständig in variables Kapital oder Arbeitslohn auf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0029","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX4","text":"Der Kauf persönlicher Dienste und individueller Konsumtionsmittel verwandelt Mehrwerth nicht in Kapital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0024","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX5","text":"Profit und Accumulation sind keine Vergütung persönlicher Abstinenz des Kapitalisten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0058","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX6","text":"Große Warenlager sind keine Accumulation von Kapital, sondern können Circulationsstockung oder Überproduktion anzeigen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX7","text":"Der Äquivalententausch bildet nicht den gesellschaftlichen Inhalt des reproduzierten Verhältnisses zwischen Kapital und Arbeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX8","text":"Erweiterte Reproduktion ist kein ausschließlich kapitalistischer Vorgang.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0062","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX9","text":"Das gesellschaftliche Kapital und der sogenannte Arbeitsfonds sind keine naturgegebenen fixen Größen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0113","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0115","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX10","text":"Produktionsmittel und vergangene Arbeit sind nicht an sich Kapital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_V4GB_BVVM:D1","text":"Accumulation ist konkret der kapitalistische Reproduktionsprozess auf erweiterter Stufenleiter.","refs":["CH_V4GB_BVVM:A1","CH_V4GB_BVVM:A2","CH_V4GB_BVVM:A3","CH_V4GB_BVVM:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D2","text":"Vergangene unbezahlte Arbeit wird durch die Folge der Surpluskapitale zur wachsenden Voraussetzung gegenwärtiger Aneignung unbezahlter lebendiger Arbeit.","refs":["CH_V4GB_BVVM:A5","CH_V4GB_BVVM:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D3","text":"Das zum Arbeitskraftkauf verwendete Surpluskapital setzt vergegenständlichte fremde Arbeit gegen eine größere Menge lebendiger fremder Arbeit um.","refs":["CH_V4GB_BVVM:A5","CH_V4GB_BVVM:A6","CH_V4GB_BVVM:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D4","text":"Das Eigentumsrecht erscheint auf Seiten des Kapitalisten als Recht auf fremde unbezahlte Arbeit und auf Seiten des Arbeiters als Unmöglichkeit, sich das eigene Produkt anzueignen.","refs":["CH_V4GB_BVVM:A7","CH_V4GB_BVVM:A8","CH_V4GB_BVVM:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D5","text":"Der Accumulationsumfang hängt zugleich von der Mehrwerthsmasse und von deren Teilung zwischen Revenue und Surpluskapital ab.","refs":["CH_V4GB_BVVM:A10","CH_V4GB_BVVM:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0034","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0066","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D6","text":"Die Teilung des Mehrwerths wird zwar durch einen Willensakt des Kapitalisten vermittelt, dessen Spielraum aber durch den Konkurrenzzwang begrenzt ist.","refs":["CH_V4GB_BVVM:A10","CH_V4GB_BVVM:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D7","text":"Die Senkung des Arbeitslohns kann die Accumulation beschleunigen, ohne dass Produktivkraft oder vorgeschossenes Kapital wachsen.","refs":["CH_V4GB_BVVM:A11","CH_V4GB_BVVM:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0069","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0085","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0101","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D8","text":"Steigende Produktivkraft kann die Masse des Mehrprodukts so erhöhen, dass kapitalistische Konsumtion und Accumulationsfonds gleichzeitig wachsen.","refs":["CH_V4GB_BVVM:A10","CH_V4GB_BVVM:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0086","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D9","text":"Die productive Wirksamkeit eines gegebenen Kapitals kann durch intensivere Arbeit, Naturaneignung, Wissenschaft und den Gratisdienst nur teilweise konsumierter Arbeitsmittel expandieren.","refs":["CH_V4GB_BVVM:A13","CH_V4GB_BVVM:A14","CH_V4GB_BVVM:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0081","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0084","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0091","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0105","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D10","text":"Die Wertherhaltungskraft lebendiger Arbeit und ihre gesellschaftlichen Productivkräfte erscheinen infolge ihrer Einverleibung in das Kapital als Selbsterhaltungs- und Selbstverwerthungskräfte des Kapitals.","refs":["CH_V4GB_BVVM:A9","CH_V4GB_BVVM:A13","CH_V4GB_BVVM:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0100","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D11","text":"Das wirklich fungierende Kapital ist ein fluktuierender und elastischer Bruchteil des gesellschaftlichen Reichthums, der als Kapital fungieren kann.","refs":["CH_V4GB_BVVM:A10","CH_V4GB_BVVM:A13","CH_V4GB_BVVM:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0035","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D12","text":"Der Kapitalist erfüllt seine historische Funktion nur, soweit er den durch Konkurrenz erzwungenen Accumulationstrieb personifiziert.","refs":["CH_V4GB_BVVM:A16","CH_V4GB_BVVM:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D13","text":"Die kapitalistische Besonderheit liegt nicht in der Erweiterung der Produktion, sondern in der antagonistischen gesellschaftlichen Form dieser Erweiterung.","refs":["CH_V4GB_BVVM:A9","CH_V4GB_BVVM:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0062","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0108","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_V4GB_BVVM:SD1","text":"Der Accumulationsprozess endogenisiert seine eigene Voraussetzung: Das Originalkapital wird gegenüber dem aus unbezahlter Arbeit hervorgegangenen Kapital zur verschwindenden Größe.","refs":["CH_V4GB_BVVM:A5","CH_V4GB_BVVM:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SD2","text":"Formelle Rechtsgleichheit und systematische Aneignung ohne Äquivalent sind vereinbar, weil sie auf verschiedenen Ebenen operieren: als Einzeltransaktion und als reproduziertes Klassenverhältnis.","refs":["CH_V4GB_BVVM:A7","CH_V4GB_BVVM:A8","CH_V4GB_BVVM:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SD3","text":"Kapital erscheint als automatisches Verwerthungssubjekt, weil es die Kräfte lebendiger Arbeit, vergangener Arbeit, der Natur und der Wissenschaft als eigene Potenzen darstellt.","refs":["CH_V4GB_BVVM:A9","CH_V4GB_BVVM:A13","CH_V4GB_BVVM:A14","CH_V4GB_BVVM:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0084","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0091","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0100","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0105","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SD4","text":"Accumulation erweitert gleichzeitig die gesellschaftlichen Productivkräfte und die Masse der dem Kapital unterworfenen Arbeit.","refs":["CH_V4GB_BVVM:A5","CH_V4GB_BVVM:A16","CH_V4GB_BVVM:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0039","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SD5","text":"Der Kapitalist ist kein souveränes Zentrum des Accumulationsprozesses, sondern dessen willensbegabte und zugleich zum Accumulieren gezwungene Funktion.","refs":["CH_V4GB_BVVM:A10","CH_V4GB_BVVM:A16","CH_V4GB_BVVM:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SD6","text":"Die kapitalistische Form ist historisch transitorisch, weil erweiterte Reproduktion ohne sie möglich ist und sie selbst materielle Bedingungen erzeugt, die über sie hinausweisen.","refs":["CH_V4GB_BVVM:A17","CH_V4GB_BVVM:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0062","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_V4GB_BVVM:DNX1","text":"Die Analyse isolierter Tauschakte kann die gesellschaftliche Reproduktion des Eigentumsverhältnisses nicht erklären.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:DNX2","text":"Die Rechtmäßigkeit eines ursprünglichen Eigentumstitels kann die fortgesetzte Aneignung unbezahlter Arbeit nicht materiell legitimieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:DNX3","text":"Die productive Macht des Kapitals entspringt nicht dem Kapital als selbständiger Substanz.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0084","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0091","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0100","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:DNX4","text":"Die Verteilung gesellschaftlichen Reichthums in Arbeitsfonds, Revenue und Produktionsmittel besitzt keine natürliche oder unveränderliche Grenze.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0035","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0113","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0115","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:DNX5","text":"Individuelle Sparsamkeit, Konsumverzicht und moralische Selbstbeherrschung bilden nicht die generative Ursache der Accumulation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0047","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0058","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:DNX6","text":"Accumulation ist kein geschlossener Geldvorgang; sie setzt die stoffliche Reproduktion der Produktionsmittel und die gesellschaftliche Reproduktion der Arbeitskraft voraus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_V4GB_BVVM:SNX1","text":"Die versperrte Möglichkeit, dass die Produzenten ihr Produkt und ihre Produktionsbedingungen unmittelbar selbst aneignen, bildet die negative Voraussetzung der kapitalistischen Accumulation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0020","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SNX2","text":"Eine unmittelbare, planmäßige und rationelle gesellschaftliche Kombination vorhandener Arbeitskräfte und Produktionsmittel bleibt innerhalb der naturwüchsigen Kapitalform ausgeschlossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0110","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SNX3","text":"Der Ursprung des Originalkapitals bleibt unbegründet; die rekursive Accumulation macht diese unbeantwortete Voraussetzung quantitativ verschwindend, ohne sie genealogisch aufzulösen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SNX4","text":"Die höhere Gesellschaftsform erscheint als durch die Productivkraftentwicklung materiell ermöglichte, aber innerhalb des Arguments nicht vermittelte Aufhebung der Trennung von Arbeit und Eigentum.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}]},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_V4GB_BVVM:FGS1","text":"Geldkapital → Ankauf von constantem Kapital und Arbeitskraft → Produktion von Mehrwerth → Realisierung des Mehrwerths → Teilung in Revenue und Accumulationsfonds → Rückverwandlung des Accumulationsfonds in constantes und variables Kapital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:FGS2","text":"Mehrprodukt in geeigneten Naturalformen + verfügbare zusätzliche Arbeitskraft → stofflich mögliche Erweiterung des Produktionsprozesses → Reproduktion auf erweiterter Stufenleiter.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:FGS3","text":"Originalkapital → Mehrwerth → Surpluskapital I → neuer Mehrwerth → Surpluskapital II → rekursive Vergrößerung der Verfügung über unbezahlte Arbeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:FGS4","text":"Äquivalententausch im Einzelakt → Wiederholung des Arbeitskraftkaufs mit kapitalisiertem Mehrwerth → formelle Fortgeltung des Tauschs → substantielle Aneignung ohne Äquivalent → Umschlag des Eigentumsgesetzes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:FGS5","text":"Accumulationsumfang = kapitalisierter Anteil der Mehrwerthsmasse; Mehrwerthsmasse = Funktion von Exploitationsgrad, Productivkraft und vorgeschossenem Kapital; Wirkungsgrad = elastisch durch Arbeitskraft, Erde, Wissenschaft und Gratisdienst fixen Kapitals.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0034","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0067","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0085","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0101","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0105","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:FGS6","text":"Personifikation des Kapitals → Konkurrenzzwang → Accumulation um der Accumulation willen → Ausdehnung von Productivkräften und Herrschaft → Erzeugung transitorischer materieller Voraussetzungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0039","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_V4GB_BVVM:AF1","text":"Kapital aus Mehrwerth → individueller Geldkreislauf → gesellschaftliches Mehrprodukt → erweiterte Reproduktion → rekursive Surpluskapitalbildung → Umschlag von Äquivalententausch und Eigentum → Ausschluss falscher Accumulationsmodelle → Teilung von Mehrwerth → Bestimmung der Accumulationsgröße → elastische Expansion des Kapitals → Konkurrenzzwang → historische Transitorität.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"10","name":"Map-Effects","items":[{"id":"CH_V4GB_BVVM:ME1","text":"Accumulation wird von persönlichem Sparen und Schatzbildung zur gesellschaftlichen Reproduktion eines Klassenverhältnisses umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME2","text":"Die individuelle Kapitalmetamorphose und die gesellschaftliche Reproduktion werden als verschiedene, nicht aufeinander reduzierbare Analyseebenen getrennt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME3","text":"Äquivalententausch und Privateigentum werden von Gegenprinzipien der Ausbeutung zu deren reproduktiven Rechtsformen reklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME4","text":"Der Mehrwerth erhält zwei voneinander unabhängige Gliederungen: Revenue gegen Surpluskapital und constantes gegen variables Kapital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME5","text":"Der Konsum der Arbeitskraft durch das Kapital wird vom Konsum der Lebensmittel durch den Arbeiter getrennt; damit zerfällt das Dogma, Accumulation sei bloße Lohnkonsumtion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME6","text":"Kapital wird von einem fixen Bestand zu einer elastischen, gesellschaftlich variablen Funktionsgröße umkartiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0035","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME7","text":"Productivkräfte, Naturpotenzen, Wissenschaft und Wertherhaltung werden von Eigenschaften des Kapitals zu angeeigneten Bedingungen seiner Expansion reklassifiziert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0084","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0091","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0095","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0100","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME8","text":"Der moralische Gegensatz von Genuss und Entsagung wird durch den strukturellen Gegensatz von Revenueverwendung und konkurrenzerzwungener Accumulation ersetzt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0036","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0047","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME9","text":"Erweiterte Reproduktion wird von ihrer kapitalistischen Form getrennt; die Formbestimmung liegt im Gegenübertreten der Reproduktionsbedingungen als Kapital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0062","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_V4GB_BVVM:ALT1","text":"Surface — Mehrwerth wird zwischen Revenue und Accumulationsfonds geteilt und als zusätzliches constantes und variables Kapital vorgeschossen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ALT2","text":"Structural — Die Reproduktion verbindet stoffliche Produktionsbedingungen, Reproduktion der Arbeiterklasse, Eigentumstrennung, Konkurrenz und fortgesetzte Aneignung unbezahlter Arbeit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ALT3","text":"Metastrategic — Die Erklärung wird vom isolierten Tauschakt, vom individuellen Sparwillen und von moralischer Abstinenz auf die gesellschaftliche Totalität des Reproduktionsprozesses verschoben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ALT4","text":"Ontological/Temporal — Vergangene unbezahlte Arbeit kommandiert gegenwärtige lebendige Arbeit; der Prozess erzeugt seine eigenen Voraussetzungen und erscheint dadurch als Selbstbewegung des Kapitals.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0100","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_V4GB_BVVM:MRT1","text":"Die Axiome sind für die Rekonstruktion der begrifflichen Bewegung des Kapitels hinreichend.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_V4GB_BVVM:MRT2","text":"Unterbestimmt bleiben die Circulation, Realisierung und proportionale Verteilung des gesellschaftlichen Mehrprodukts zwischen Produktionssphären.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0031","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT3","text":"Der historische Ursprung des Originalkapitals wird ausdrücklich suspendiert und durch seine spätere quantitative Marginalisierung nicht aufgeklärt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT4","text":"Die Struktur ist kohärent, sofern Einzeltransaktion und gesellschaftliche Reproduktion als verschiedene Erklärungsebenen festgehalten werden.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT5","text":"Die stärkste Operation ist der Nachweis, dass die fortgesetzte Geltung des Äquivalententauschs den Umschlag in Aneignung ohne Äquivalent nicht verhindert, sondern formal vermittelt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT6","text":"Eine Spannung bleibt zwischen der Teilung des Mehrwerths als Willensakt des Kapitalisten und ihrer Bestimmung durch den Konkurrenzzwang bestehen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0036","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT7","text":"Eine weitere Spannung besteht zwischen dem Kapitalisten als Personifikation des Accumulationstriebs und seinem wachsenden Genuss- und Repräsentationskonsum.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0041","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0046","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0047","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT8","text":"Die Verbindung zwischen Productivkraftentwicklung und höherer Gesellschaftsform benennt eine materielle Möglichkeit, liefert aber keinen Übergangsmechanismus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT9","text":"Die Grenzen der elastischen Expansion sowie die Vermittlung von Entwertung, Konkurrenz und gesteigerter Exploitation bleiben komprimiert.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0084","trace_type":"Structural","confidence":"low","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0092","trace_type":"Structural","confidence":"low","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Structural","confidence":"low","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT10","text":"Die Rekonstruktion bewahrt die Bewegung von der Definition der Accumulation über die Eigentumsdialektik und die Kritik falscher Modelle bis zur Bestimmung ihrer gesellschaftlichen Expansionsbedingungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]}],"language_code":"de","language_name":"Deutsch","translations":[{"id":"CAREVAR_20261016T211235934632Z_49a31d7b","language_code":"en","language_name":"English","title":"b) Transformation of Surplus Value into Capital.","source_sha256":"b3a9eb9c11ce49ebbf0d4e0e97ac03dd33aa834632116361f473995b72590001","sha256":"7c1ab8b0b968a8bcd8cef1e274090f1d33a95c27c6b636deb3d92478b27d361a","rendition_type":"machine","review_status":"machine","model":"gpt-5.6-terra","created":"2026-10-16T21:12:35.936276+00:00","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_V4GB_BVVM:AS1","text":"What must be explained is how the surplus value generated from capital itself becomes the presupposition of further capital production.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS2","text":"Accumulation is the reconversion of a part of surplus value into constant and variable capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS3","text":"The individual standpoint shows a formally identical metamorphosis of capital; the social standpoint reveals its material and reproductive conditions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS4","text":"The succession of surplus capitals transforms past unpaid labour into the condition of continued appropriation of living unpaid labour.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS5","text":"The argument proceeds reconstructively, dialectically, systemically, and against the apologetic categories of classical and vulgar economy.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0023","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS6","text":"The movement proceeds from the formally valid exchange of equivalents, through social reproduction, to the inversion of the law of property into capitalist appropriation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0013","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0020","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:AS7","text":"After excluding hoard formation, mere wage consumption, and abstinence, the text explains the scale of accumulation from the mass of surplus value, the ratio of division, elastic productive potentials, and competitive compulsion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0067","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0085","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0101","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_V4GB_BVVM:A1","text":"Accumulation is the application of surplus value as capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A2","text":"Every capitalized surplus value must be divided into constant and variable capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A3","text":"Insofar as surplus value is accumulated, the surplus product embodying it must contain the material elements of the additional constant and variable capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A4","text":"Additional labour can become available through greater exertion of the existing labour forces or through the reproduction of the working class.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A5","text":"All components of surplus capital are capitalized unpaid alien labour.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0011","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A6","text":"Every further surplus capital is generated through the valorization of a preceding surplus capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0007","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A7","text":"Each individual purchase and sale of labour-power can conform to the law of exchange of equivalents.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A8","text":"The law of property founded on commodity exchange is inverted, through its reproductive application, into appropriation without equivalent.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A9","text":"Capitalist appropriation separates ownership of the product of labour and of the conditions of production from labour.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0020","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0107","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A10","text":"Surplus value divides into a consumption fund and an accumulation fund.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0033","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A11","text":"The mass of surplus value is regulated by the degree of exploitation, the productive power of labour, and the magnitude of the capital advanced.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0067","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0085","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0101","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A12","text":"The reduction of wages below the value of labour-power transfers a part of the workers' necessary consumption fund into the accumulation fund of capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0069","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A13","text":"Labour-power, land, and science operate, within certain limits, as elastic potentials for the expansion of capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A14","text":"Living labour creates new value and simultaneously preserves the value of the means of production consumed by it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0095","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A15","text":"The difference between fixed capital employed and fixed capital consumed generates a growing gratuitous productive service of past labour.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0105","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A16","text":"Competition compels the continual expansion of individual capital as a condition of its preservation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A17","text":"Accumulation for the sake of accumulation develops social productive forces and the material conditions of a higher social form.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:A18","text":"Expanded reproduction becomes accumulation of capital only when means of production, product, and means of subsistence confront the producers as capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_V4GB_BVVM:NX1","text":"Accumulation is neither hoard formation nor the exclusion of money from circulation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX2","text":"Capitalization of surplus value is not its mere consumption by productive workers.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0027","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX3","text":"Social capital does not resolve itself entirely into variable capital or wages.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0029","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX4","text":"The purchase of personal services and individual means of consumption does not transform surplus value into capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0024","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX5","text":"Profit and accumulation are not remuneration for the capitalist's personal abstinence.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0058","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX6","text":"Large stocks of commodities are not accumulation of capital, but can indicate stagnation of circulation or overproduction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX7","text":"The exchange of equivalents does not constitute the social content of the reproduced relation between capital and labour.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX8","text":"Expanded reproduction is not an exclusively capitalist process.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0062","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX9","text":"Social capital and the so-called labour fund are not naturally given fixed magnitudes.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0113","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0115","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:NX10","text":"Means of production and past labour are not capital in themselves.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_V4GB_BVVM:D1","text":"Concretely, accumulation is the capitalist process of reproduction on an expanded scale.","refs":["CH_V4GB_BVVM:A1","CH_V4GB_BVVM:A2","CH_V4GB_BVVM:A3","CH_V4GB_BVVM:A4"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D2","text":"Through the succession of surplus capitals, past unpaid labour becomes the growing presupposition of the present appropriation of unpaid living labour.","refs":["CH_V4GB_BVVM:A5","CH_V4GB_BVVM:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D3","text":"The surplus capital used to purchase labour-power converts objectified alien labour into a greater quantity of living alien labour.","refs":["CH_V4GB_BVVM:A5","CH_V4GB_BVVM:A6","CH_V4GB_BVVM:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D4","text":"The right of property appears, on the capitalist's side, as a right to the unpaid labour of others and, on the worker's side, as the impossibility of appropriating his own product.","refs":["CH_V4GB_BVVM:A7","CH_V4GB_BVVM:A8","CH_V4GB_BVVM:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D5","text":"The scale of accumulation depends simultaneously on the mass of surplus value and on its division between revenue and surplus capital.","refs":["CH_V4GB_BVVM:A10","CH_V4GB_BVVM:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0034","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0066","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D6","text":"The division of surplus value is indeed mediated by an act of will of the capitalist, but the scope of his discretion is limited by competitive compulsion.","refs":["CH_V4GB_BVVM:A10","CH_V4GB_BVVM:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D7","text":"The reduction of wages can accelerate accumulation without an increase in productive power or capital advanced.","refs":["CH_V4GB_BVVM:A11","CH_V4GB_BVVM:A12"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0069","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0085","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0101","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D8","text":"Rising productive power can increase the mass of the surplus product in such a way that capitalist consumption and the accumulation fund grow simultaneously.","refs":["CH_V4GB_BVVM:A10","CH_V4GB_BVVM:A11"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0086","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D9","text":"The productive efficacy of a given capital can expand through more intensive labour, appropriation of nature, science, and the gratuitous service of means of labour only partially consumed.","refs":["CH_V4GB_BVVM:A13","CH_V4GB_BVVM:A14","CH_V4GB_BVVM:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0081","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0084","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0091","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0105","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D10","text":"The value-preserving power of living labour and its social productive forces appear, as a consequence of their incorporation into capital, as capital's powers of self-preservation and self-valorization.","refs":["CH_V4GB_BVVM:A9","CH_V4GB_BVVM:A13","CH_V4GB_BVVM:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0100","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D11","text":"The actually functioning capital is a fluctuating and elastic fraction of social wealth that can function as capital.","refs":["CH_V4GB_BVVM:A10","CH_V4GB_BVVM:A13","CH_V4GB_BVVM:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0035","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D12","text":"The capitalist fulfils his historical function only insofar as he personifies the drive to accumulate compelled by competition.","refs":["CH_V4GB_BVVM:A16","CH_V4GB_BVVM:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:D13","text":"The capitalist specificity lies not in the expansion of production, but in the antagonistic social form of this expansion.","refs":["CH_V4GB_BVVM:A9","CH_V4GB_BVVM:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0062","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0108","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_V4GB_BVVM:SD1","text":"The accumulation process endogenizes its own presupposition: original capital becomes a vanishing magnitude in relation to the capital arisen from unpaid labour.","refs":["CH_V4GB_BVVM:A5","CH_V4GB_BVVM:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SD2","text":"Formal legal equality and systematic appropriation without equivalent are compatible because they operate at different levels: as an individual transaction and as a reproduced class relation.","refs":["CH_V4GB_BVVM:A7","CH_V4GB_BVVM:A8","CH_V4GB_BVVM:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SD3","text":"Capital appears as an automatic subject of valorization because it presents the forces of living labour, past labour, nature, and science as its own powers.","refs":["CH_V4GB_BVVM:A9","CH_V4GB_BVVM:A13","CH_V4GB_BVVM:A14","CH_V4GB_BVVM:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0084","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0091","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0100","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0105","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SD4","text":"Accumulation simultaneously expands the social productive forces and the mass of labour subordinated to capital.","refs":["CH_V4GB_BVVM:A5","CH_V4GB_BVVM:A16","CH_V4GB_BVVM:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0039","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SD5","text":"The capitalist is not a sovereign centre of the accumulation process, but its function endowed with will and at the same time compelled to accumulate.","refs":["CH_V4GB_BVVM:A10","CH_V4GB_BVVM:A16","CH_V4GB_BVVM:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SD6","text":"The capitalist form is historically transitory because expanded reproduction is possible without it and because it itself produces material conditions pointing beyond it.","refs":["CH_V4GB_BVVM:A17","CH_V4GB_BVVM:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0062","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_V4GB_BVVM:DNX1","text":"The analysis of isolated acts of exchange cannot explain the social reproduction of the property relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:DNX2","text":"The legality of an original title of property cannot materially legitimize the continued appropriation of unpaid labour.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0009","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:DNX3","text":"The productive power of capital does not arise from capital as an independent substance.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0084","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0091","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0100","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:DNX4","text":"The distribution of social wealth into labour fund, revenue, and means of production possesses no natural or immutable limit.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0035","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0113","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0115","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:DNX5","text":"Individual thrift, renunciation of consumption, and moral self-mastery do not constitute the generative cause of accumulation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0025","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0047","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0058","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:DNX6","text":"Accumulation is not a closed monetary process; it presupposes the material reproduction of the means of production and the social reproduction of labour-power.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_V4GB_BVVM:SNX1","text":"The blocked possibility that producers might directly appropriate their own product and their own conditions of production constitutes the negative presupposition of capitalist accumulation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0020","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SNX2","text":"A direct, planned, and rational social combination of the available labour forces and means of production remains excluded within the spontaneously developed form of capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0110","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SNX3","text":"The origin of original capital remains unfounded; recursive accumulation renders this unanswered presupposition quantitatively vanishing without genealogically resolving it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:SNX4","text":"The higher social form appears as a materially enabled abolition of the separation of labour and property through the development of productive power, but one not mediated within the argument.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]}]},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_V4GB_BVVM:FGS1","text":"Money capital → purchase of constant capital and labour-power → production of surplus value → realization of surplus value → division into revenue and accumulation fund → reconversion of the accumulation fund into constant and variable capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:FGS2","text":"Surplus product in suitable natural forms + available additional labour-power → materially possible expansion of the production process → reproduction on an expanded scale.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:FGS3","text":"Original capital → surplus value → surplus capital I → new surplus value → surplus capital II → recursive enlargement of control over unpaid labour.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0007","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0009","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:FGS4","text":"Exchange of equivalents in the individual act → repetition of the purchase of labour-power with capitalized surplus value → formal continued validity of exchange → substantive appropriation without equivalent → inversion of the law of property.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0016","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:FGS5","text":"Scale of accumulation = capitalized share of the mass of surplus value; mass of surplus value = function of degree of exploitation, productive power, and capital advanced; degree of efficacy = elastic through labour-power, land, science, and the gratuitous service of fixed capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0034","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0067","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0085","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0101","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0105","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:FGS6","text":"Personification of capital → competitive compulsion → accumulation for the sake of accumulation → expansion of productive forces and domination → production of transitory material presuppositions.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0039","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"9","name":"Argument Flow Map","items":[{"id":"CH_V4GB_BVVM:AF1","text":"Capital from surplus value → individual monetary circuit → social surplus product → expanded reproduction → recursive formation of surplus capital → inversion of exchange of equivalents and property → exclusion of false models of accumulation → division of surplus value → determination of the magnitude of accumulation → elastic expansion of capital → competitive compulsion → historical transitoriness.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0007","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0033","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0034","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"10","name":"Map-Effects","items":[{"id":"CH_V4GB_BVVM:ME1","text":"Accumulation is remapped from personal saving and hoard formation to the social reproduction of a class relation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME2","text":"The individual metamorphosis of capital and social reproduction are separated as distinct analytical levels irreducible to one another.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME3","text":"Exchange of equivalents and private property are reclassified from counter-principles of exploitation into its reproductive legal forms.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME4","text":"Surplus value receives two independent articulations: revenue versus surplus capital and constant versus variable capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME5","text":"The consumption of labour-power by capital is separated from the consumption of means of subsistence by the worker; thus the dogma that accumulation is mere wage consumption disintegrates.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME6","text":"Capital is remapped from a fixed stock to an elastic, socially variable functional magnitude.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0035","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME7","text":"Productive forces, powers of nature, science, and value preservation are reclassified from properties of capital into appropriated conditions of its expansion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0084","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0091","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0095","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0100","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME8","text":"The moral opposition of enjoyment and renunciation is replaced by the structural opposition between the use of revenue and accumulation compelled by competition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0036","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0047","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ME9","text":"Expanded reproduction is separated from its capitalist form; the determination of form lies in the confrontation of the conditions of reproduction with the producers as capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0062","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0063","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"11","name":"Altitude Levels","items":[{"id":"CH_V4GB_BVVM:ALT1","text":"Surface — Surplus value is divided between revenue and the accumulation fund and advanced as additional constant and variable capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ALT2","text":"Structural — Reproduction connects material conditions of production, reproduction of the working class, separation of property, competition, and continued appropriation of unpaid labour.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0005","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0006","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0019","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ALT3","text":"Metastrategic — The explanation is shifted from the isolated act of exchange, individual willingness to save, and moral abstinence to the social totality of the process of reproduction.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:ALT4","text":"Ontological/Temporal — Past unpaid labour commands present living labour; the process produces its own presuppositions and thereby appears as the self-movement of capital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0015","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0100","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"12","name":"Minimal Reconstruction Test","items":[{"id":"CH_V4GB_BVVM:MRT1","text":"The axioms are sufficient for reconstructing the conceptual movement of the chapter.","refs":[],"deep_refs":[],"trace_type":"","passages":[]},{"id":"CH_V4GB_BVVM:MRT2","text":"What remains underdetermined are circulation, realization, and the proportional distribution of the social surplus product among spheres of production.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0031","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT3","text":"The historical origin of original capital is explicitly suspended and is not clarified by its later quantitative marginalization.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0008","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0021","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT4","text":"The structure is coherent provided that individual transaction and social reproduction are maintained as distinct explanatory levels.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0004","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT5","text":"The strongest operation is the demonstration that the continued validity of the exchange of equivalents does not prevent the inversion into appropriation without equivalent, but formally mediates it.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0018","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT6","text":"A tension remains between the division of surplus value as an act of will of the capitalist and its determination by competitive compulsion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0036","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT7","text":"A further tension exists between the capitalist as personification of the drive to accumulate and his growing consumption of enjoyment and representation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0041","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0046","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0047","trace_type":"Tension","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT8","text":"The connection between the development of productive power and the higher social form identifies a material possibility, but supplies no mechanism of transition.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0020","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0037","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT9","text":"The limits of elastic expansion, as well as the mediation of devaluation, competition, and intensified exploitation, remain compressed.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0084","trace_type":"Structural","confidence":"low","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0092","trace_type":"Structural","confidence":"low","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Structural","confidence":"low","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_BVVM:MRT10","text":"The reconstruction preserves the movement from the definition of accumulation, through the dialectic of property and the critique of false models, to the determination of its social conditions of expansion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_BVVM:P0001","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0017","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0026","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0028","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0038","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0057","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_BVVM:P0109","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]}],"revision":"CH_V4GB_BVVM@R001","source_variant_id":"canonical:CH_V4GB_BVVM:v1","source_language_code":"de"}],"identity":{"layer":"CH","kicker":"Chapter 19","title":"b) Verwandlung von Mehrwerth in Kapital.","context":"Chapter 19"}},{"id":"CH_V4GB_CDAG","layer":"CH","title":"c) Das allgemeine Gesetz der kapitalistischen Accu- mulation. · reading part 1/2","order":20,"parents":["RAW_V4GB_CDAG"],"revision":"CH_V4GB_CDAG@R001","sha256":"3f5ad065bf5ce7ee45baef80559f63ae880c995004b5221f830d620221b6ea5e","sections":[{"number":"1","name":"Argumental Spine","items":[{"id":"CH_V4GB_CDAG:AS1","text":"Zu erklären ist, warum wachsender gesellschaftlicher Reichtum zugleich Abhängigkeit, Arbeitsüberschuss und Pauperismus erzeugt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0128","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0135","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:AS2","text":"Kapitalistische Akkumulation reproduziert das Kapitalverhältnis, verändert die organische Zusammensetzung des Kapitals und erzeugt dadurch eine relative Surpluspopulation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0066","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:AS3","text":"Das Argument verfährt konditional, rekonstruktiv, diagnostisch und polemisch gegen die Naturalisierung kapitalistisch erzeugter Bevölkerungsphänomene.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0002","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0036","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0033","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0074","trace_type":"Structural","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:AS4","text":"Die Analyse beginnt mit der günstigsten Annahme unveränderter technischer Zusammensetzung und zeigt, dass selbst steigende Löhne die Herrschaft des Kapitals nicht aufheben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:AS5","text":"Die Aufhebung dieser Annahme verlagert die Erklärung vom absoluten Bevölkerungswachstum auf Produktivität, organische Zusammensetzung, Konzentration und Arbeiterfreisetzung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0036","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0037","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0061","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0066","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:AS6","text":"Die erzeugte Surpluspopulation wird zur industriellen Reservearmee und damit zur Voraussetzung weiterer Akkumulation, zyklischer Expansion und Lohndisziplin.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0075","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0078","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0108","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:AS7","text":"Der englische Fall dient als empirischer Belastungstest der Kette Reichtumswachstum → Arbeitsverdrängung → Pauperismus → materielle Degradation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0146","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0149","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0272","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0174","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0181","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0190","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"2","name":"Load-Bearing Axioms","items":[{"id":"CH_V4GB_CDAG:A1","text":"Produktion von Mehrwert ist das absolute Gesetz der kapitalistischen Produktionsweise.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0028","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A2","text":"Arbeitskraft wird als Mittel der Kapitalverwertung und als Quelle unbezahlter Arbeit gekauft.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0028","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A3","text":"Das Lohnverhältnis setzt die fortgesetzte Wiederverkäuflichkeit der Arbeitskraft und die Lieferung unbezahlter Arbeit voraus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0029","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A4","text":"Akkumulation ist die fortgesetzte Rückverwandlung von Mehrwert in Kapital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0047","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A5","text":"Erweiterte Reproduktion reproduziert das Kapitalverhältnis auf erweiterter Stufenleiter und vermehrt das Proletariat.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0005","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A6","text":"Bei unveränderter technischer Zusammensetzung wächst die Nachfrage nach Arbeitskraft proportional zum Kapital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0002","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A7","text":"Die Akkumulationsdynamik begrenzt den Arbeitspreis auf ein Niveau, das die erweiterte Reproduktion des Kapitalverhältnisses nicht ernsthaft gefährdet.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0034","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A8","text":"Steigende gesellschaftliche Produktivität vergrößert die Masse der von einer gegebenen Arbeitskraft bewegten Produktionsmittel.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0038","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A9","text":"Die organische Zusammensetzung des Kapitals ist die annähernde wertmäßige Spiegelung seiner technischen Zusammensetzung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0041","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A10","text":"Die Nachfrage nach Arbeit wird durch den variablen Kapitalteil und nicht durch das Gesamtkapital bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0064","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A11","text":"Kapitalakkumulation und spezifisch kapitalistische Produktivkraftentwicklung beschleunigen sich wechselseitig.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0047","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A12","text":"Akkumulation konzentriert Produktionsmittel und Kommando über Arbeit innerhalb wachsender individueller Kapitale.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0048","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A13","text":"Die Attraktion bereits gebildeter Kapitale verteilt vorhandenes Kapital neu und wird durch Konkurrenz und Kredit beschleunigt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0052","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0055","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A14","text":"Wachstum, Attraktion und technologische Umwälzung vermindern den variablen Kapitalteil relativ zum konstanten Kapitalteil.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0058","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0060","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0062","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A15","text":"Das Kapital kann seine Zufuhr an Arbeit durch extensive oder intensive Exploitation und durch Ersetzung von Arbeitskräften rascher steigern als seine Nachfrage nach Arbeitern.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0090","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0092","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A16","text":"Überschüssigkeit von Arbeitskraft ist relativ zu den mittleren Verwertungsbedürfnissen des Kapitals bestimmt.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0066","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A17","text":"Eine disponible industrielle Reservearmee ist Voraussetzung plötzlicher Expansion und der Bewegungsform der modernen Industrie.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0075","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0077","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0080","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:A18","text":"Der Konkurrenzdruck der Reservearmee diszipliniert die aktive Arbeiterarmee und begrenzt ihre Ansprüche.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0108","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"3","name":"Apophatic Structure","items":[{"id":"CH_V4GB_CDAG:NX1","text":"Akkumulation ist nicht mit der vollständigen Konsumtion des kapitalisierten Mehrprodukts durch zusätzliche produktive Arbeiter identisch.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0008","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX2","text":"Ein Proletarier ist nicht jeder Arme, sondern der Lohnarbeiter, der Kapital produziert und bei fehlender Verwertbarkeit freigesetzt wird.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0006","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX3","text":"Steigender Lohn hebt weder Ausbeutung noch Abhängigkeit noch den Zwang zum Wiederverkauf der Arbeitskraft auf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0025","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0029","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX4","text":"Arbeitskraft wird nicht zur Befriedigung persönlicher Bedürfnisse des Käufers erworben.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0028","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX5","text":"Akkumulation ist keine bloß quantitative Vergrößerung des Kapitals.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0062","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX6","text":"Die Wertzusammensetzung ist kein exaktes Maß der technischen Zusammensetzung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0041","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX7","text":"Akkumulationsbedingte Konzentration ist nicht identisch mit der Attraktion und Verschmelzung bereits bestehender Kapitale.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0052","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX8","text":"Wachstum des Gesamtkapitals ist nicht mit proportionalem Wachstum der Arbeitsnachfrage identisch.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0064","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX9","text":"Arbeitskräftemangel und Arbeitskräfteüberschuss entstehen nicht primär aus autonomen Bewegungen der absoluten Arbeiterbevölkerung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0032","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0033","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX10","text":"Expansion und Kontraktion des Kredits sind nicht die Grundursache des industriellen Zyklus.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0081","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX11","text":"Maschinerie setzt nicht Kapital für Arbeiter, sondern Arbeiter für zusätzliches Kapital frei.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0109","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX12","text":"Pauperismus ist weder ein bloßes Resultat von Müßiggang noch eine externe Störung der Akkumulation.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0126","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0188","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:NX13","text":"Ein abstraktes, für alle historischen Produktionsweisen gültiges Populationsgesetz existiert nicht.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0074","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"4","name":"Derivative Propositions","items":[{"id":"CH_V4GB_CDAG:D1","text":"Unter unveränderter technischer Zusammensetzung kann Akkumulation Arbeitsnachfrage und Löhne erhöhen, während sie zugleich das Abhängigkeitsverhältnis erweitert.","refs":["CH_V4GB_CDAG:A4","CH_V4GB_CDAG:A5","CH_V4GB_CDAG:A6"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D2","text":"Vermindert eine Lohnsteigerung den Verwertungsanreiz, schwächt sich die Akkumulation ab, beseitigt den Arbeitskräftemangel und stellt ein kapitalverträgliches Lohnniveau wieder her.","refs":["CH_V4GB_CDAG:A1","CH_V4GB_CDAG:A3","CH_V4GB_CDAG:A7"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0031","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0032","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D3","text":"Akkumulation erzeugt die materielle Basis größerer Produktion, diese steigert die Produktivität und Mehrwertproduktion, und der zusätzliche Mehrwert beschleunigt erneut die Akkumulation.","refs":["CH_V4GB_CDAG:A4","CH_V4GB_CDAG:A8","CH_V4GB_CDAG:A11","CH_V4GB_CDAG:A12","CH_V4GB_CDAG:A13"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0047","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D4","text":"Die wertmäßige Zunahme des konstanten Kapitalteils unterschätzt die technische Verschiebung, weil steigende Produktivität die Produktionsmittel relativ verbilligt.","refs":["CH_V4GB_CDAG:A8","CH_V4GB_CDAG:A9"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0042","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D5","text":"Der variable Kapitalteil kann absolut wachsen und dennoch relativ zum Gesamtkapital und zur Produktionsleiter fallen.","refs":["CH_V4GB_CDAG:A9","CH_V4GB_CDAG:A10","CH_V4GB_CDAG:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0064","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D6","text":"Neues Kapital zieht verhältnismäßig immer weniger Arbeiter an, während technologisch erneuertes altes Kapital bereits beschäftigte Arbeiter abstößt.","refs":["CH_V4GB_CDAG:A10","CH_V4GB_CDAG:A13","CH_V4GB_CDAG:A14"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0061","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D7","text":"Die Menge verfügbarer Arbeit wird teilweise von der Zahl verfügbarer Arbeiter entkoppelt.","refs":["CH_V4GB_CDAG:A10","CH_V4GB_CDAG:A15"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0088","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0091","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D8","text":"Akkumulation erzeugt eine für die durchschnittlichen Verwertungsbedürfnisse überschüssige Arbeiterbevölkerung.","refs":["CH_V4GB_CDAG:A10","CH_V4GB_CDAG:A14","CH_V4GB_CDAG:A15","CH_V4GB_CDAG:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0066","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D9","text":"Die industrielle Reservearmee wird zugleich vom industriellen Zyklus absorbiert, freigesetzt und reproduziert.","refs":["CH_V4GB_CDAG:A11","CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0078","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D10","text":"Absolute Bewegungen des Kapitals erscheinen als relative Bewegungen der Arbeiterbevölkerung und lassen kapitalerzeugte Überzähligkeit als demographische Ursache erscheinen.","refs":["CH_V4GB_CDAG:A7","CH_V4GB_CDAG:A10","CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0033","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0034","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D11","text":"Die allgemeine Lohnbewegung wird durch das wechselnde Verhältnis von aktiver Arbeiterarmee und Reservearmee reguliert.","refs":["CH_V4GB_CDAG:A7","CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0099","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D12","text":"Die relative Surpluspopulation sedimentiert in flüssiger, latenter und stagnanter Form sowie im Pauperismus.","refs":["CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0114","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0125","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D13","text":"Pauperismus bildet das Invalidenhaus der aktiven Arbeiterarmee, das tote Gewicht der Reservearmee und notwendige Nebenkosten kapitalistischer Produktion.","refs":["CH_V4GB_CDAG:A5","CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A17","CH_V4GB_CDAG:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0126","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0127","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D14","text":"Mit wachsendem Reichtum, Kapital, Produktivkraft und Arbeiterbevölkerung wachsen relative Surpluspopulation, konsolidierte Not und offizieller Pauperismus.","refs":["CH_V4GB_CDAG:A1","CH_V4GB_CDAG:A5","CH_V4GB_CDAG:A8","CH_V4GB_CDAG:A10","CH_V4GB_CDAG:A14","CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A17","CH_V4GB_CDAG:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0128","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D15","text":"Frühere Ökonomen erfassen die funktionale Notwendigkeit einer armen Arbeiterklasse, naturalisieren oder moralisieren sie jedoch, statt sie aus dem Akkumulationsmechanismus abzuleiten.","refs":["CH_V4GB_CDAG:A4","CH_V4GB_CDAG:A5","CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0011","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0013","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0141","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:D16","text":"Die englische Evidenz fungiert als Negativtest des demographischen Dogmas, weil verlangsamtes Bevölkerungswachstum mit beschleunigtem Reichtumswachstum, Konzentration, Arbeitsverdrängung, Unterernährung, Wohnungsnot und Pauperismus koexistiert.","refs":["CH_V4GB_CDAG:A10","CH_V4GB_CDAG:A13","CH_V4GB_CDAG:A14","CH_V4GB_CDAG:A16"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0147","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0149","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0153","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0272","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0174","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0181","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0190","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"5","name":"Super-Derivatives","items":[{"id":"CH_V4GB_CDAG:SD1","text":"Das Kapital produziert mit der Reservearmee selbst die Arbeitsmarktbedingung seiner von natürlichem Bevölkerungswachstum unabhängigen Expansion.","refs":["CH_V4GB_CDAG:A14","CH_V4GB_CDAG:A15","CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0075","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0086","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:SD2","text":"Produktivitätssteigerung verwandelt sich unter kapitalistischen Eigentumsverhältnissen nicht primär in freie Zeit, sondern gleichzeitig in Überarbeit der Beschäftigten und erzwungenen Müßiggang der Freigesetzten.","refs":["CH_V4GB_CDAG:A8","CH_V4GB_CDAG:A10","CH_V4GB_CDAG:A15","CH_V4GB_CDAG:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0093","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:SD3","text":"Das Kapital wirkt auf beiden Seiten des Arbeitsmarkts, indem es Arbeitsnachfrage erzeugt und zugleich durch Freisetzung und Überarbeit das Arbeitsangebot formt.","refs":["CH_V4GB_CDAG:A10","CH_V4GB_CDAG:A15","CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0110","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0111","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:SD4","text":"Die Wirkungen der Akkumulation werden zu Bedingungen ihrer Wiederholung, sodass Expansion, Freisetzung, Reservebildung und erneute Expansion eine rekursive Zyklusstruktur bilden.","refs":["CH_V4GB_CDAG:A7","CH_V4GB_CDAG:A11","CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0078","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0081","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:SD5","text":"Kapitalistische Akkumulation privatisiert den erzeugten Reichtum und verlagert die Kosten von Pauperismus, Krankheit und unzureichender Reproduktion auf Arbeiterklasse, kleine Mittelklasse und öffentliche Armenpflege.","refs":["CH_V4GB_CDAG:A1","CH_V4GB_CDAG:A5","CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A17"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0127","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0135","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0174","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0187","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:SD6","text":"Die organisierte Verbindung von Beschäftigten und Unbeschäftigten greift unmittelbar in den Disziplinierungsmechanismus der Reservearmee ein.","refs":["CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A17","CH_V4GB_CDAG:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0112","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:SD7","text":"Wo die spontane Erzeugung einer Reservearmee scheitert, tendiert das Kapital zur Ergänzung des Arbeitsmarktmechanismus durch Zwang.","refs":["CH_V4GB_CDAG:A16","CH_V4GB_CDAG:A17","CH_V4GB_CDAG:A18"],"deep_refs":[],"trace_type":"From","passages":[{"id":"RAW_V4GB_CDAG:P0113","trace_type":"Direct","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"6","name":"Deep Apophatics","items":[{"id":"CH_V4GB_CDAG:DNX1","text":"Arbeitsnachfrage und Arbeitsangebot sind keine voneinander und vom Kapital unabhängigen Größen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0110","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:DNX2","text":"Die Arbeiterbevölkerung ist keine dem Kapital äußerliche, rein natürliche Ursache seiner Bewegungen.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0072","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0100","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:DNX3","text":"Produktivkraftentwicklung besitzt innerhalb kapitalistischer Form keine sozial neutrale Wirkung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0131","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:DNX4","text":"Juristische Freiheit des Lohnarbeiters bedeutet keine materielle Unabhängigkeit vom Kapital.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0011","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0015","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:DNX5","text":"Gesellschaftliches Reichtumswachstum verbessert nicht notwendig die Reproduktionsbedingungen der Produzenten.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0164","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:DNX6","text":"Vollbeschäftigung bildet keinen stabilen Normalzustand der entwickelten kapitalistischen Produktion.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0075","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0078","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0080","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:DNX7","text":"Eigentums- und Rechtsverhältnisse sind keine neutralen Hüllen eines unabhängig von ihnen verlaufenden Produktionsprozesses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0014","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0045","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:DNX8","text":"Zyklische Arbeitslosigkeit ist keine bloße Fehlfunktion, die ohne Veränderung der Akkumulationsweise dauerhaft beseitigt werden kann.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0078","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0081","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:DNX9","text":"Individuelle Sparsamkeit, Mobilität oder Lohnerhöhung lösen das reproduzierte Klassenverhältnis nicht auf.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0010","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0025","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0106","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0107","trace_type":"Composite","confidence":"medium","alignment_provenance":"frozen-grounding"}]}]},{"number":"7","name":"Super-Apophatics","items":[{"id":"CH_V4GB_CDAG:SNX1","text":"Strukturell abwesend ist eine Produktionsordnung, in der der gegenständliche Reichtum den Entwicklungsbedürfnissen der Arbeiter untergeordnet ist.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0035","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:SNX2","text":"Versperrt ist eine dauerhafte Beseitigung der industriellen Reservearmee bei unveränderter zyklischer Expansionsweise des Kapitals.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0078","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0080","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0081","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:SNX3","text":"Ausgeschlossen ist eine nichtantagonistische kapitalistische Akkumulation, in der derselbe Prozess Reichtum vermehrt, ohne Abhängigkeit und Surpluspopulation zu reproduzieren.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0128","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0134","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0135","trace_type":"Structural","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:SNX4","text":"Nicht verfügbar ist die unmittelbare Übersetzung von Arbeitsersparnis in allgemeine Verkürzung der Arbeitszeit und gesicherte freie Entwicklung.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0093","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0097","trace_type":"Negative","confidence":"high","alignment_provenance":"frozen-grounding"}]}]},{"number":"8","name":"Formal Generative Schema","items":[{"id":"CH_V4GB_CDAG:FGS1","text":"Mehrwertproduktion → Kapitalisierung des Mehrwerts → erweiterte Reproduktion des Kapitalverhältnisses.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0028","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0047","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0004","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"}]},{"id":"CH_V4GB_CDAG:FGS2","text":"Unveränderte technische Zusammensetzung → proportionale Arbeitsnachfrage → mögliche Lohnsteigerung → Verwertungsgrenze → akkumulative Gegenkorrektur.","refs":[],"deep_refs":[],"trace_type":"","passages":[{"id":"RAW_V4GB_CDAG:P0002","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0003","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-grounding"},{"id":"RAW_V4GB_CDAG:P0031","trace_type":"Composite","confidence":"high","alignment_provenance":"frozen-gro